# --- Attribute Properties ---
ind:attributionModelId rdf:type rdf:Property ;
    rdfs:label 'Attribution Model Id' ;
    rdfs:comment 'Unique system-generated identifier for the attribution model record. Primary key for the attribution_model data product in the analytics domain.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AttributionModel .

ind:approvedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approved By Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Attribution model approval governance — linking approved_by to employee enables audit trails for marketing attribution decisions affecting sponsorship and broadcast revenue allocation in sports entert' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:dashboardDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Dashboard Definition Id' ;
    rdfs:comment 'Identifier of the executive KPI dashboard or business intelligence report in which this attribution model\'s outputs are surfaced. Links the model to its downstream consumption context for impact assessment and stakeholder communication.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DashboardDefinition .

ind:kpiDashboardDashboardDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Kpi Dashboard Dashboard Definition Id' ;
    rdfs:comment 'Identifier of the executive KPI dashboard or business intelligence report in which this attribution model\'s outputs are surfaced. Links the model to its downstream consumption context for impact assessment and stakeholder communication.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DashboardDefinition .

ind:mediaRightsDealId rdf:type rdf:Property ;
    rdfs:label 'Media Rights Deal Id' ;
    rdfs:comment 'Foreign key linking to broadcast.media_rights_deal. Business justification: Attribution models are configured per rights deal to measure broadcast channel contribution to fan acquisition and subscription conversion — a standard sports media analytics use case. Deal-scoped att' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MediaRightsDeal .

ind:orgUnitId rdf:type rdf:Property ;
    rdfs:label 'Org Unit Id' ;
    rdfs:comment 'Foreign key linking to workforce.org_unit. Business justification: Attribution models are owned by org units (marketing analytics, commercial analytics). Linking to org_unit enables model governance by department, budget accountability for marketing attribution infra' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:revenueStreamId rdf:type rdf:Property ;
    rdfs:label 'Revenue Stream Id' ;
    rdfs:comment 'Foreign key linking to finance.revenue_stream. Business justification: Attribution models in sports entertainment measure marketing channel contribution to specific revenue streams (ticket sales, subscription revenue, merchandise). Finance teams use attribution model con' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RevenueStream .

ind:approvalDate rdf:type rdf:Property ;
    rdfs:label 'Approval Date' ;
    rdfs:comment 'The date on which this attribution model received formal business approval for production deployment. Null for models still in draft or under review. Part of the model governance audit trail.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attributionType rdf:type rdf:Property ;
    rdfs:label 'Attribution Type' ;
    rdfs:comment 'The algorithmic methodology used to allocate conversion credit across marketing touchpoints. Supported types: first_touch (100% credit to first interaction), last_touch (100% credit to last interaction), linear (equal credit across all touchpoints), time_decay (more credit to touchpoints closer to conversion), data_driven (ML-based credit allocation), position_based (configurable U-shaped or W-shaped weighting). [ENUM-REF-CANDIDATE: first_touch|last_touch|linear|time_decay|data_driven|position_based — promote to reference product]' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkModelCode rdf:type rdf:Property ;
    rdfs:label 'Benchmark Model Code' ;
    rdfs:comment 'The model_code of the baseline attribution model against which this model\'s performance and credit allocation outputs are compared. Used in A/B model testing and incremental lift analysis to justify model upgrades or methodology changes.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessUseCase rdf:type rdf:Property ;
    rdfs:label 'Business Use Case' ;
    rdfs:comment 'The primary revenue or conversion objective this attribution model is designed to measure. Ticket_sales: attributing credit for ticket purchase conversions. Sponsorship_influence: measuring marketing touchpoint influence on sponsorship deal closures. Broadcast_subscription: attributing credit for OTT/streaming subscription sign-ups. Merchandise: attributing credit for merchandise and licensing purchases. Fan_acquisition: attributing credit for new fan CRM registrations. PPV_conversion: attributing credit for Pay-Per-View (PPV) purchase events. [ENUM-REF-CANDIDATE: ticket_sales|sponsorship_influence|broadcast_subscription|merchandise|fan_acquisition|ppv_conversion — promote to reference product]' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelWeightingConfig rdf:type rdf:Property ;
    rdfs:label 'Channel Weighting Config' ;
    rdfs:comment 'Human-readable description of the channel weighting rules applied in this model, including any custom weight assignments per marketing channel (e.g., \'Social media 40%, Email 30%, Paid Search 20%, Display 10%\'). Captures the business rationale for non-uniform credit distribution. For data-driven models, describes the feature set used by the ML algorithm.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentRequired rdf:type rdf:Property ;
    rdfs:label 'Consent Required' ;
    rdfs:comment 'Indicates whether fan consent (opt-in) is required before including a fan\'s touchpoint data in this attribution model\'s analysis. True for models processing EU fan data under GDPR or California fan data under CCPA where explicit consent is mandated.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conversionEventType rdf:type rdf:Property ;
    rdfs:label 'Conversion Event Type' ;
    rdfs:comment 'The specific fan or customer action defined as the conversion goal for this attribution model. Determines which downstream event triggers credit allocation across the touchpoint path. [ENUM-REF-CANDIDATE: ticket_purchase|subscription_signup|merchandise_purchase|ppv_purchase|fan_registration|sponsorship_lead — promote to reference product]' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdTimestamp rdf:type rdf:Property ;
    rdfs:label 'Created Timestamp' ;
    rdfs:comment 'The date and time when this attribution model record was first created in the analytics data product. Serves as the audit trail creation marker for data lineage and governance purposes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:crossDeviceEnabled rdf:type rdf:Property ;
    rdfs:label 'Cross Device Enabled' ;
    rdfs:comment 'Indicates whether this attribution model applies cross-device identity resolution to stitch together fan touchpoints across multiple devices (mobile, desktop, smart TV, tablet) into a unified conversion path. When True, requires identity graph integration via Adobe Experience Platform.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSourceSystems rdf:type rdf:Property ;
    rdfs:label 'Data Source Systems' ;
    rdfs:comment 'Comma-separated list of operational source systems whose touchpoint data feeds this attribution model (e.g., \'Adobe Experience Platform, Salesforce CRM, Ticketmaster, Shopify Plus\'). Documents data lineage and system dependencies for the model\'s input pipeline.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deploymentStatus rdf:type rdf:Property ;
    rdfs:label 'Deployment Status' ;
    rdfs:comment 'Current lifecycle state of the attribution model within the marketing analytics pipeline. Draft: under development and not yet deployed. Active: currently running and producing attribution outputs. Paused: temporarily suspended. Deprecated: superseded by a newer model but retained for historical reference. Archived: retired and no longer accessible for new runs.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveEndDate rdf:type rdf:Property ;
    rdfs:label 'Effective End Date' ;
    rdfs:comment 'The date on which this attribution model ceases to be operationally valid. Null for open-ended models with no planned retirement date. When populated, indicates the model has been superseded or retired.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveStartDate rdf:type rdf:Property ;
    rdfs:label 'Effective Start Date' ;
    rdfs:comment 'The date from which this attribution model is considered active and its outputs are used for business decision-making, budget allocation, and KPI reporting. Marks the beginning of the model\'s operational validity period.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstTouchWeightPct rdf:type rdf:Property ;
    rdfs:label 'First Touch Weight Pct' ;
    rdfs:comment 'For position-based (U-shaped or W-shaped) attribution models, the percentage of total conversion credit allocated to the first marketing touchpoint in the path (0.00–100.00). Null for non-position-based attribution types. Combined with last_touch_weight_pct and middle_touch_weight_pct must sum to 100.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicScope rdf:type rdf:Property ;
    rdfs:label 'Geographic Scope' ;
    rdfs:comment 'The geographic market or region for which this attribution model applies (e.g., \'USA\', \'GBR\', \'Global\'). Uses ISO 3166-1 alpha-3 country codes for single-country scope or \'Global\' for worldwide applicability. Relevant for GDPR-compliant models operating in EU markets.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRunTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Run Timestamp' ;
    rdfs:comment 'The date and time when this attribution model was most recently executed to produce attribution credit outputs. Used to monitor model freshness and identify stale models that may be producing outdated attribution results for marketing spend decisions.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastTouchWeightPct rdf:type rdf:Property ;
    rdfs:label 'Last Touch Weight Pct' ;
    rdfs:comment 'For position-based attribution models, the percentage of total conversion credit allocated to the last marketing touchpoint immediately preceding conversion (0.00–100.00). Null for non-position-based attribution types.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lookbackWindowDays rdf:type rdf:Property ;
    rdfs:label 'Lookback Window Days' ;
    rdfs:comment 'The number of days prior to a conversion event within which marketing touchpoints are eligible to receive attribution credit. Defines the retrospective analysis horizon for the model (e.g., 30, 60, 90 days). Touchpoints outside this window are excluded from credit allocation.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxTouchpointsEvaluated rdf:type rdf:Property ;
    rdfs:label 'Max Touchpoints Evaluated' ;
    rdfs:comment 'The maximum number of touchpoints in a conversion path that this model will evaluate when allocating attribution credit. Touchpoints beyond this cap (oldest first) are excluded. Controls computational scope and prevents outlier paths from distorting model outputs.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:middleTouchWeightPct rdf:type rdf:Property ;
    rdfs:label 'Middle Touch Weight Pct' ;
    rdfs:comment 'For position-based attribution models, the percentage of total conversion credit distributed equally across all middle touchpoints between the first and last interactions (0.00–100.00). Null for non-position-based attribution types.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minTouchpointsRequired rdf:type rdf:Property ;
    rdfs:label 'Min Touchpoints Required' ;
    rdfs:comment 'The minimum number of marketing touchpoints a conversion path must contain for this model to assign attribution credit. Conversion paths with fewer touchpoints than this threshold are excluded from the model\'s output or handled by a fallback rule.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mlAlgorithmType rdf:type rdf:Property ;
    rdfs:label 'Ml Algorithm Type' ;
    rdfs:comment 'For data-driven attribution models, the machine learning algorithm used to compute touchpoint credit weights. Logistic_regression: probabilistic conversion modeling. Gradient_boosting: ensemble tree-based credit allocation. Neural_network: deep learning attribution. Markov_chain: probabilistic path analysis. Shapley_value: game-theory-based fair credit distribution. None for rule-based attribution types.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelAccuracyScore rdf:type rdf:Property ;
    rdfs:label 'Model Accuracy Score' ;
    rdfs:comment 'The most recently validated predictive accuracy score for data-driven attribution models, expressed as a value between 0.0000 and 1.0000 (e.g., 0.8750 = 87.50% accuracy). Measured using AUC-ROC or similar validation metric. Null for rule-based attribution types that do not undergo predictive validation.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelCode rdf:type rdf:Property ;
    rdfs:label 'Model Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the attribution model, used in cross-system references, reporting dashboards, and Adobe Experience Platform campaign configurations. Format: ATT- followed by 3-12 uppercase alphanumeric characters.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelDescription rdf:type rdf:Property ;
    rdfs:label 'Model Description' ;
    rdfs:comment 'Detailed narrative description of the attribution model\'s purpose, methodology, scope, and intended audience. Provides business context for analysts and executives reviewing KPI dashboards. Includes information on which marketing channels are in scope and any known limitations.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelName rdf:type rdf:Property ;
    rdfs:label 'Model Name' ;
    rdfs:comment 'Human-readable name of the attribution model as displayed in KPI dashboards and marketing analytics reports (e.g., \'Ticket Sales Last-Touch 90-Day\', \'Broadcast Subscription Linear 60-Day\'). Used by the marketing analytics team to identify and reference the model.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelVersion rdf:type rdf:Property ;
    rdfs:label 'Model Version' ;
    rdfs:comment 'Semantic version number of the attribution model (e.g., \'1.0\', \'2.3\', \'3.1.2\'). Incremented when model logic, weighting configuration, or lookback parameters are materially changed. Enables version-controlled comparison of attribution outputs across model iterations.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notes rdf:type rdf:Property ;
    rdfs:label 'Notes' ;
    rdfs:comment 'Free-text field for additional context, known limitations, special handling instructions, or business caveats associated with this attribution model. Used by the marketing analytics team to document edge cases, seasonal adjustments, or temporary overrides.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offlineTouchpointsIncluded rdf:type rdf:Property ;
    rdfs:label 'Offline Touchpoints Included' ;
    rdfs:comment 'Indicates whether this attribution model incorporates offline marketing touchpoints (e.g., in-venue signage, broadcast TV spots, radio, print) in addition to digital touchpoints. When True, offline channel data from broadcast and venue operations systems is ingested into the model\'s touchpoint path.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:privacyCompliant rdf:type rdf:Property ;
    rdfs:label 'Privacy Compliant' ;
    rdfs:comment 'Indicates whether this attribution model has been reviewed and certified as compliant with applicable fan data privacy regulations including GDPR (EU fan data), CCPA (California fan data), and internal PII handling policies. Models processing fan identity data must be True before production deployment.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:runFrequency rdf:type rdf:Property ;
    rdfs:label 'Run Frequency' ;
    rdfs:comment 'The scheduled execution cadence for this attribution model\'s processing pipeline. Determines how frequently attribution credit is recalculated and refreshed in downstream KPI dashboards and marketing analytics reports.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportLeague rdf:type rdf:Property ;
    rdfs:label 'Sport League' ;
    rdfs:comment 'The sport or professional league for which this attribution model is scoped (e.g., \'NFL\', \'NBA\', \'MLB\', \'NHL\', \'MLS\', \'UFC\', \'All\'). Allows segmentation of attribution models by league or property when Sports Entertainment operates multiple leagues with distinct fan acquisition strategies.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeDecayHalfLifeDays rdf:type rdf:Property ;
    rdfs:label 'Time Decay Half Life Days' ;
    rdfs:comment 'For time-decay attribution models, the number of days that defines the half-life of credit decay. Touchpoints occurring this many days before conversion receive half the credit of a touchpoint occurring on the conversion day. Null for non-time-decay attribution types.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingDatasetEndDate rdf:type rdf:Property ;
    rdfs:label 'Training Dataset End Date' ;
    rdfs:comment 'The most recent date of historical conversion and touchpoint data used to train or calibrate this attribution model. Applicable primarily to data-driven and ML-based attribution types. Defines the upper bound of the training data window.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trainingDatasetStartDate rdf:type rdf:Property ;
    rdfs:label 'Training Dataset Start Date' ;
    rdfs:comment 'The earliest date of historical conversion and touchpoint data used to train or calibrate this attribution model. Applicable primarily to data-driven and ML-based attribution types. Defines the lower bound of the training data window.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:updatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Updated Timestamp' ;
    rdfs:comment 'The date and time when this attribution model record was most recently modified. Updated on any change to model configuration, status, weighting parameters, or metadata. Supports change tracking and audit compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:validationDate rdf:type rdf:Property ;
    rdfs:label 'Validation Date' ;
    rdfs:comment 'The date on which the attribution model was most recently validated against a holdout dataset or business benchmark. Used to assess model staleness and trigger retraining cycles for data-driven models.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attributionResultId rdf:type rdf:Property ;
    rdfs:label 'Attribution Result Id' ;
    rdfs:comment 'Unique surrogate identifier for each attribution result record generated by a marketing attribution model run. Primary key for the attribution_result data product in the analytics domain.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetId rdf:type rdf:Property ;
    rdfs:label 'Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: Content-level conversion attribution: attribution models identify which specific content assets (highlight clips, documentaries, live streams) drove fan conversions (ticket purchases, subscriptions). ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:bonusRedemptionId rdf:type rdf:Property ;
    rdfs:label 'Bonus Redemption Id' ;
    rdfs:comment 'Foreign key linking to gaming.bonus_redemption. Business justification: Bonus redemption is a distinct, high-value conversion event in sportsbook marketing attribution. Linking attribution_result to bonus_redemption allows the marketing analytics team to calculate channel' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BonusRedemption .

ind:broadcastChannelId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Channel Id' ;
    rdfs:comment 'Foreign key linking to broadcast.channel. Business justification: Channel-mix attribution reporting: attribution results must identify which broadcast channel drove fan conversion to enable channel-level ROI analysis and ad spend optimization. attribution_result has' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Channel .

ind:broadcastScheduleId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Schedule Id' ;
    rdfs:comment 'Foreign key linking to broadcast.broadcast_schedule. Business justification: Broadcast exposure attribution: fan conversion journeys (ticket purchase, subscription sign-up) are attributed to specific broadcast events as touchpoints. Linking attribution_result to broadcast_sche' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BroadcastSchedule .

ind:digitalTouchpointId rdf:type rdf:Property ;
    rdfs:label 'Digital Touchpoint Id' ;
    rdfs:comment 'Reference to the specific fan touchpoint interaction (ad impression, email open, venue visit, broadcast exposure) that is receiving attribution credit in this result record.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DigitalTouchpoint .

ind:engagementEventId rdf:type rdf:Property ;
    rdfs:label 'Engagement Event Id' ;
    rdfs:comment 'Reference to the specific conversion event record (ticket purchase, subscription signup, merchandise order) that triggered this attribution result. Provides traceability from credit assignment back to the originating transaction.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EngagementEvent .

ind:eventFixtureId rdf:type rdf:Property ;
    rdfs:label 'Event Fixture Id' ;
    rdfs:comment 'Reference to the specific sports or entertainment event (game, match, concert, PPV event) associated with the conversion. Enables event-level attribution analysis to understand which events drive the highest fan acquisition and conversion activity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fixture .

ind:fanProfileId rdf:type rdf:Property ;
    rdfs:label 'Fan Profile Id' ;
    rdfs:comment 'Reference to the fan or consumer profile in the CRM/fan engagement platform whose conversion event is being attributed. Enables fan-level ROI and lifetime value analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:fixtureId rdf:type rdf:Property ;
    rdfs:label 'Fixture Id' ;
    rdfs:comment 'Reference to the specific sports or entertainment event (game, match, concert, PPV event) associated with the conversion. Enables event-level attribution analysis to understand which events drive the highest fan acquisition and conversion activity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fixture .

ind:franchiseId rdf:type rdf:Property ;
    rdfs:label 'Franchise Id' ;
    rdfs:comment 'Foreign key linking to league.franchise. Business justification: Franchise-level marketing attribution analysis is a standard sports marketing process — teams measure which channels drive ticket sales and merchandise purchases per franchise. A franchise_id FK enabl' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:merchOrderId rdf:type rdf:Property ;
    rdfs:label 'Merch Order Id' ;
    rdfs:comment 'Foreign key linking to merchandise.merch_order. Business justification: Marketing attribution for merchandise purchases is a standard sports-entertainment analytics process. When a merchandise order is the conversion event, linking attribution_result to merch_order enable' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MerchOrder .

ind:modelRunId rdf:type rdf:Property ;
    rdfs:label 'Model Run Id' ;
    rdfs:comment 'Reference to the specific attribution model execution run that produced this result. Links the result back to the batch or scheduled pipeline run for lineage and reproducibility.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ModelRun .

ind:notificationCampaignId rdf:type rdf:Property ;
    rdfs:label 'Notification Campaign Id' ;
    rdfs:comment 'Reference to the marketing campaign associated with the attributed touchpoint. Enables campaign-level ROI measurement and spend efficiency analysis across digital, broadcast, and venue channels.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NotificationCampaign .

ind:promotionId rdf:type rdf:Property ;
    rdfs:label 'Promotion Id' ;
    rdfs:comment 'Foreign key linking to merchandise.promotion. Business justification: Promotion ROI measurement requires linking attribution results to the specific merchandise promotion that drove conversion. Sports-entertainment marketing teams use attribution models to evaluate whic' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Promotion .

ind:seasonTicketPackageId rdf:type rdf:Property ;
    rdfs:label 'Season Ticket Package Id' ;
    rdfs:comment 'Foreign key linking to ticketing.season_ticket_package. Business justification: STH renewal campaign attribution is a named, high-investment marketing analytics process — determining which campaigns drove season ticket renewals at the package level. This FK enables attribution_re' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SeasonTicketPackage .

ind:ticketOrderId rdf:type rdf:Property ;
    rdfs:label 'Ticket Order Id' ;
    rdfs:comment 'Foreign key linking to ticketing.ticket_order. Business justification: Marketing attribution for ticket sales is a core sports entertainment analytics process — determining which campaigns, channels, or touchpoints drove a ticket purchase. The conversion event in ticketi' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TicketOrder .

ind:wagerId rdf:type rdf:Property ;
    rdfs:label 'Wager Id' ;
    rdfs:comment 'Foreign key linking to gaming.wager. Business justification: Wager placement is the primary conversion event in sportsbook marketing attribution. Attribution results must link to the specific wager that constitutes the conversion to calculate channel ROI and co' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Wager .

ind:attributedChannel rdf:type rdf:Property ;
    rdfs:label 'Attributed Channel' ;
    rdfs:comment 'The marketing or engagement channel credited with contributing to the conversion. Covers digital paid media, organic digital, broadcast/RSN (Regional Sports Network), email, social media, venue/in-person, OTT (Over-The-Top Streaming), and direct channels. [ENUM-REF-CANDIDATE: digital_paid|digital_organic|broadcast|email|social_media|venue|ott|direct — promote to reference product]' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributedChannelSubtype rdf:type rdf:Property ;
    rdfs:label 'Attributed Channel Subtype' ;
    rdfs:comment 'Granular sub-classification of the attributed channel (e.g., paid_search, display_banner, connected_tv, stadium_signage, push_notification, influencer_post). Enables detailed channel mix analysis within each top-level channel category.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributedCost rdf:type rdf:Property ;
    rdfs:label 'Attributed Cost' ;
    rdfs:comment 'Portion of the touchpoint marketing cost attributed to this conversion, calculated as touchpoint_cost multiplied by credit_weight. Enables accurate cost-per-conversion and ROAS (Return on Ad Spend) calculation at the channel and campaign level.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributedRevenue rdf:type rdf:Property ;
    rdfs:label 'Attributed Revenue' ;
    rdfs:comment 'Monetary value of conversion revenue attributed to this specific touchpoint, calculated as conversion_revenue multiplied by credit_weight. Expressed in the operating currency. Enables channel-level and campaign-level revenue attribution for marketing ROI analysis.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributionModelType rdf:type rdf:Property ;
    rdfs:label 'Attribution Model Type' ;
    rdfs:comment 'The algorithmic approach used to distribute conversion credit across touchpoints. Supports last-touch, first-touch, linear (equal weight), time-decay (recency-weighted), position-based (U-shaped), and data-driven (ML-based) models.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionRunDate rdf:type rdf:Property ;
    rdfs:label 'Attribution Run Date' ;
    rdfs:comment 'Calendar date on which the attribution model was executed and this result was produced. Used for scheduling, batch tracking, and time-series comparison of attribution outputs across model runs.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentVerified rdf:type rdf:Property ;
    rdfs:label 'Consent Verified' ;
    rdfs:comment 'Indicates whether the fan\'s consent for marketing data processing and attribution tracking has been verified and is on record at the time of this attribution run. Required for GDPR and CCPA compliance in EU and California markets.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conversionRevenue rdf:type rdf:Property ;
    rdfs:label 'Conversion Revenue' ;
    rdfs:comment 'Total gross revenue value of the conversion event before credit weighting is applied (e.g., full ticket purchase amount, full subscription fee, full merchandise order value). Provides the base for calculating attributed_revenue per touchpoint.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:conversionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Conversion Timestamp' ;
    rdfs:comment 'Date and time when the conversion event occurred (e.g., ticket purchase completed, subscription activated, merchandise order placed). Used to calculate days_to_conversion and validate attribution lookback windows. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:creditWeight rdf:type rdf:Property ;
    rdfs:label 'Credit Weight' ;
    rdfs:comment 'Fractional credit weight assigned to this touchpoint for the conversion event, expressed as a value between 0.0000 and 1.0000. The sum of all credit weights across all touchpoints for a single conversion event equals 1.0. Core metric for ROI (Return on Investment) measurement.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currencyCode rdf:type rdf:Property ;
    rdfs:label 'Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the attributed_revenue and conversion_revenue amounts (e.g., USD, GBP, EUR). Required for multi-market operations across global sports entertainment properties.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataProcessingBasis rdf:type rdf:Property ;
    rdfs:label 'Data Processing Basis' ;
    rdfs:comment 'Legal basis under which the fan\'s touchpoint and conversion data was processed for attribution purposes. Required for GDPR Article 6 compliance documentation. Values: consent (fan opted in), legitimate_interest, contract, legal_obligation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysToConversion rdf:type rdf:Property ;
    rdfs:label 'Days To Conversion' ;
    rdfs:comment 'Number of days elapsed between this touchpoint interaction and the conversion event. Key metric for understanding channel influence windows and optimizing time-decay attribution model parameters.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deviceType rdf:type rdf:Property ;
    rdfs:label 'Device Type' ;
    rdfs:comment 'Type of device used by the fan at the attributed touchpoint interaction. Enables device-level attribution analysis to understand cross-device conversion paths and optimize channel spend by device category.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionReason rdf:type rdf:Property ;
    rdfs:label 'Exclusion Reason' ;
    rdfs:comment 'Free-text or coded reason explaining why this touchpoint was excluded or invalidated from the attribution result (e.g., \'outside_lookback_window\', \'bot_traffic_detected\', \'duplicate_touchpoint\', \'consent_withdrawn\'). Populated only when result_status is \'excluded\' or \'invalidated\'.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanSegmentCode rdf:type rdf:Property ;
    rdfs:label 'Fan Segment Code' ;
    rdfs:comment 'Audience segment classification of the fan at the time of conversion (e.g., season_ticket_holder, casual_fan, new_fan, vip_member, lapsed_fan). Enables segment-level attribution analysis to understand which channels drive conversion for different fan cohorts.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isConvertingTouchpoint rdf:type rdf:Property ;
    rdfs:label 'Is Converting Touchpoint' ;
    rdfs:comment 'Indicates whether this touchpoint is the final touchpoint immediately preceding the conversion event (True = last touchpoint / converting touch). Used to distinguish last-touch interactions from assist touchpoints in multi-touch journey analysis.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFirstTouchpoint rdf:type rdf:Property ;
    rdfs:label 'Is First Touchpoint' ;
    rdfs:comment 'Indicates whether this touchpoint is the first recorded interaction in the fan\'s conversion journey (True = first touch). Used to identify awareness-driving channels and support first-touch attribution model analysis.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kpiDashboardFlag rdf:type rdf:Property ;
    rdfs:label 'Kpi Dashboard Flag' ;
    rdfs:comment 'Indicates whether this attribution result record is included in executive KPI (Key Performance Indicator) dashboards and marketing performance reports. Records flagged False may be under review, excluded for data quality reasons, or filtered for specific reporting scopes.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketRegionCode rdf:type rdf:Property ;
    rdfs:label 'Market Region Code' ;
    rdfs:comment 'ISO 3166-1 alpha-2 or alpha-3 country/region code identifying the geographic market in which the conversion occurred. Supports regional attribution analysis and compliance with GDPR (EU markets) and CCPA (California) data handling requirements.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Result Reference Code' ;
    rdfs:comment 'Externally referenceable business identifier for this attribution result record, formatted as ATR-{YYYY}-{YYYYMMDD}-{ALPHANUM6}. Used in reporting, audit trails, and cross-system reconciliation with marketing platforms.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultStatus rdf:type rdf:Property ;
    rdfs:label 'Result Status' ;
    rdfs:comment 'Current lifecycle status of this attribution result record. \'valid\' indicates accepted output; \'invalidated\' indicates the result was voided due to data quality issues or model rerun; \'pending_review\' indicates manual review required; \'excluded\' indicates the touchpoint was filtered out; \'reprocessed\' indicates the record was regenerated.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Code' ;
    rdfs:comment 'Identifier of the operational system of record that provided the touchpoint or conversion event data used in this attribution result (e.g., adobe_aep for Adobe Experience Platform, salesforce_crm, ticketmaster, shopify_plus). Supports data lineage and Silver Layer provenance tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportOrPropertyCode rdf:type rdf:Property ;
    rdfs:label 'Sport Or Property Code' ;
    rdfs:comment 'Code identifying the sports or entertainment property (e.g., NFL, NBA, MLS, UFC, concert_series) associated with the conversion event. Enables property-level attribution analysis to understand which leagues or entertainment verticals drive the highest marketing ROI.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:touchpointCost rdf:type rdf:Property ;
    rdfs:label 'Touchpoint Cost' ;
    rdfs:comment 'Marketing spend cost associated with delivering this specific touchpoint to the fan (e.g., CPM-based ad impression cost, email send cost, broadcast spot cost). Used to calculate cost-per-conversion and ROI (Return on Investment) at the touchpoint level.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:touchpointCountInJourney rdf:type rdf:Property ;
    rdfs:label 'Touchpoint Count In Journey' ;
    rdfs:comment 'Total number of touchpoints recorded in the fan\'s conversion journey path for this conversion event. Used to contextualize the touchpoint_position and validate credit weight distribution across the full journey.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:touchpointPosition rdf:type rdf:Property ;
    rdfs:label 'Touchpoint Position' ;
    rdfs:comment 'Ordinal position of this touchpoint within the fan\'s conversion journey path (1 = first touchpoint, N = last touchpoint before conversion). Used by position-based and time-decay attribution models to weight credit appropriately.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:touchpointTimestamp rdf:type rdf:Property ;
    rdfs:label 'Touchpoint Timestamp' ;
    rdfs:comment 'Date and time when the fan interacted with the attributed touchpoint (e.g., ad impression served, email opened, venue entry scanned). The principal real-world event time for this attribution record. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:audienceDemographicId rdf:type rdf:Property ;
    rdfs:label 'Audience Demographic Id' ;
    rdfs:comment 'Unique surrogate identifier for each audience demographic breakdown record in the Silver Layer lakehouse. Primary key for this data product.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adobeSegmentId rdf:type rdf:Property ;
    rdfs:label 'Adobe Segment Id' ;
    rdfs:comment 'The segment identifier from Adobe Experience Platform (AEP) corresponding to this demographic dimension value. Enables cross-referencing of audience measurement data with fan engagement and personalization segments for DTC content strategy.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Segment .

ind:audienceMeasurementId rdf:type rdf:Property ;
    rdfs:label 'Audience Measurement Id' ;
    rdfs:comment 'Reference to the audience measurement event or panel study session that produced this demographic breakdown record. Links to the parent measurement event.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AudienceMeasurement .

ind:leagueId rdf:type rdf:Property ;
    rdfs:label 'League Id' ;
    rdfs:comment 'Foreign key linking to league.league. Business justification: Sponsor targeting and broadcast rights demographic reporting require league-scoped audience demographic data. sport_league_code is a denormalized plain attribute; a proper FK normalizes this and suppo' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:League .

ind:measurementEventAudienceMeasurementId rdf:type rdf:Property ;
    rdfs:label 'Measurement Event Audience Measurement Id' ;
    rdfs:comment 'Reference to the audience measurement event or panel study session that produced this demographic breakdown record. Links to the parent measurement event.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AudienceMeasurement .

ind:seasonId rdf:type rdf:Property ;
    rdfs:label 'Season Id' ;
    rdfs:comment 'Foreign key linking to league.season. Business justification: Season-level demographic audience reporting is a standard broadcast rights deliverable — rights holders and sponsors require season-scoped demographic breakdowns for campaign planning and rights valua' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Season .

ind:ageBandLabel rdf:type rdf:Property ;
    rdfs:label 'Age Band Label' ;
    rdfs:comment 'Standardized age band label for this demographic record when the dimension type is Age Band (e.g., 18-24, 25-34, 35-44). Follows Nielsen standard age band definitions used in broadcast audience reporting. [ENUM-REF-CANDIDATE: 2-11|12-17|18-24|25-34|35-44|45-54|55-64|65+ — promote to reference product]' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:audienceSharePct rdf:type rdf:Property ;
    rdfs:label 'Audience Share Pct' ;
    rdfs:comment 'The percentage of the total measured audience represented by this demographic dimension value. For example, 34.5% of the audience falls within the 18-34 age band. Used for audience composition analysis in sponsor targeting and content strategy.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageMinuteAudience rdf:type rdf:Property ;
    rdfs:label 'Average Minute Audience' ;
    rdfs:comment 'The average number of viewers or listeners tuned in during any given minute of the measured content for this demographic segment. A standard Nielsen broadcast metric used in CPM rate card calculations and GRP reporting for advertising inventory valuation.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastDate rdf:type rdf:Property ;
    rdfs:label 'Broadcast Date' ;
    rdfs:comment 'The specific date on which the content was broadcast or streamed when this audience demographic measurement was captured. Used for event-level demographic analysis and post-event reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contentType rdf:type rdf:Property ;
    rdfs:label 'Content Type' ;
    rdfs:comment 'The type of sports or entertainment content being consumed by the measured audience (e.g., Live Event, Replay, Highlight, Studio Show, PPV, Documentary). Enables content strategy decisions based on demographic audience composition by content format.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cpmRate rdf:type rdf:Property ;
    rdfs:label 'Cpm Rate' ;
    rdfs:comment 'The Cost Per Mille (CPM) advertising rate associated with reaching 1,000 viewers in this demographic segment. Confidential commercial rate used in broadcast rights negotiations, sponsor targeting proposals, and advertising inventory pricing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataQualityScore rdf:type rdf:Property ;
    rdfs:label 'Data Quality Score' ;
    rdfs:comment 'A numeric score (0-100) assigned during Silver Layer data processing to indicate the quality and completeness of this audience demographic record. Derived from sample size adequacy, measurement source reliability, and completeness of dimension values. Used to filter records for high-confidence analytics.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataReleaseStatus rdf:type rdf:Property ;
    rdfs:label 'Data Release Status' ;
    rdfs:comment 'The publication status of this audience demographic measurement record (Preliminary=initial estimate, Final=confirmed measurement, Revised=corrected post-publication, Embargoed=not yet cleared for external use). Controls data availability for external reporting and rights negotiations.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daypartCode rdf:type rdf:Property ;
    rdfs:label 'Daypart Code' ;
    rdfs:comment 'Television daypart classification for the broadcast window during which the audience was measured (e.g., Prime Time, Daytime, Late Fringe). Standard Nielsen daypart definitions used for CPM rate card and advertising inventory valuation. [ENUM-REF-CANDIDATE: Early Morning|Daytime|Early Fringe|Prime Access|Prime Time|Late News|Late Fringe|Overnight — promote to reference product]' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demographicDimensionType rdf:type rdf:Property ;
    rdfs:label 'Demographic Dimension Type' ;
    rdfs:comment 'The category of demographic dimension being measured in this record (e.g., Age Band, Gender, Household Income Quintile, DMA Region, Ethnicity Index, Platform Device Type). Each record represents one dimension slice of the audience composition. [ENUM-REF-CANDIDATE: Age Band|Gender|Household Income Quintile|DMA Region|Ethnicity Index|Platform Device Type|Education Level|Household Size — promote to reference product]' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dimensionValue rdf:type rdf:Property ;
    rdfs:label 'Dimension Value' ;
    rdfs:comment 'The specific value within the demographic dimension type for this record (e.g., \'18-24\' for Age Band, \'Male\' for Gender, \'Q3\' for Household Income Quintile, \'New York DMA\' for DMA Region, \'Hispanic\' for Ethnicity Index, \'Mobile\' for Platform Device Type).' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dmaRegionCode rdf:type rdf:Property ;
    rdfs:label 'Dma Region Code' ;
    rdfs:comment 'Nielsen Designated Market Area (DMA) numeric code identifying the geographic television market for this demographic record when the dimension type is DMA Region. Used for regional audience analysis, RSN rights valuation, and local sponsor targeting.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmaRegionName rdf:type rdf:Property ;
    rdfs:label 'Dma Region Name' ;
    rdfs:comment 'Human-readable name of the Nielsen Designated Market Area (DMA) geographic television market (e.g., \'New York\', \'Los Angeles\', \'Chicago\'). Complements the DMA code for reporting and dashboard display.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ethnicityIndexLabel rdf:type rdf:Property ;
    rdfs:label 'Ethnicity Index Label' ;
    rdfs:comment 'Ethnicity classification label for this demographic record when the dimension type is Ethnicity Index (e.g., Hispanic/Latino, Black/African American, Asian, White Non-Hispanic, Multiracial). Follows US Census Bureau and Nielsen ethnicity classification standards. Used for diverse audience composition analysis.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderSplitCode rdf:type rdf:Property ;
    rdfs:label 'Gender Split Code' ;
    rdfs:comment 'Standardized gender classification code for this demographic record when the dimension type is Gender (M=Male, F=Female, NB=Non-Binary, U=Unreported/Unknown). Used in audience composition reporting for broadcast rights and sponsor targeting.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicCountryCode rdf:type rdf:Property ;
    rdfs:label 'Geographic Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 three-letter country code identifying the geographic market for this audience demographic measurement (e.g., USA, GBR, CAN). Supports international broadcast rights analysis and global sponsor targeting.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossRatingPoint rdf:type rdf:Property ;
    rdfs:label 'Gross Rating Point' ;
    rdfs:comment 'The Gross Rating Point (GRP) value for this demographic segment, representing the percentage of the target demographic universe reached multiplied by the average frequency of exposure. Used in advertising campaign planning and sponsor ROI measurement.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:householdIncomeQuintile rdf:type rdf:Property ;
    rdfs:label 'Household Income Quintile' ;
    rdfs:comment 'Household income quintile classification for this demographic record when the dimension type is Household Income Quintile (Q1=lowest 20% to Q5=highest 20%). Used for premium audience valuation in sponsorship and broadcast rights negotiations.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ingestionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ingestion Timestamp' ;
    rdfs:comment 'The timestamp when this audience demographic record was first ingested into the Databricks Silver Layer lakehouse. Used for data lineage, pipeline monitoring, and audit trail purposes.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isLiveBroadcastFlag rdf:type rdf:Property ;
    rdfs:label 'Is Live Broadcast Flag' ;
    rdfs:comment 'Boolean flag indicating whether the audience measurement was captured during a live broadcast (True) versus time-shifted or on-demand viewing (False). Live audience demographics are the primary currency for sports broadcast rights negotiations.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimetimeFlag rdf:type rdf:Property ;
    rdfs:label 'Is Primetime Flag' ;
    rdfs:comment 'Boolean flag indicating whether this audience demographic measurement was captured during a prime time broadcast window (typically 8PM-11PM local time). Prime time demographics command premium CPM rates and are critical for broadcast rights valuation.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'The timestamp of the most recent update to this audience demographic record in the Silver Layer, reflecting revisions from the measurement source or data quality corrections. Supports incremental processing and audit trail.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:marginOfError rdf:type rdf:Property ;
    rdfs:label 'Margin Of Error' ;
    rdfs:comment 'The margin of error (expressed as a decimal percentage) associated with the audience share estimate for this demographic record. Used to qualify the precision of demographic data in broadcast rights negotiations and sponsor targeting proposals.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementMethodology rdf:type rdf:Property ;
    rdfs:label 'Measurement Methodology' ;
    rdfs:comment 'The data collection methodology used by the measurement source to derive audience demographics (e.g., Panel-based sampling, Census digital measurement, Automatic Content Recognition). Affects statistical confidence and comparability. [ENUM-REF-CANDIDATE: Panel|Census|Hybrid|Survey|Set-Top Box|Return Path Data|Watermark|ACR — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Period End Date' ;
    rdfs:comment 'The end date of the audience measurement period or panel wave from which this demographic record is derived. Together with the start date, defines the full temporal window of the measurement.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Start Date' ;
    rdfs:comment 'The start date of the audience measurement period or panel wave from which this demographic record is derived. Defines the temporal scope of the measurement for trend analysis and rights negotiation reporting.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Measurement Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric code assigned by the audience measurement provider (e.g., Nielsen, Comscore, Kantar) to uniquely identify this measurement study or panel wave. Used for cross-system reconciliation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementSource rdf:type rdf:Property ;
    rdfs:label 'Measurement Source' ;
    rdfs:comment 'The third-party or internal provider that conducted the audience measurement study from which this demographic record is derived. Determines methodology and credibility weighting. [ENUM-REF-CANDIDATE: Nielsen|Comscore|Kantar|Adobe Analytics|YouGov|Ipsos|Internal Panel|Other — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:platformDeviceType rdf:type rdf:Property ;
    rdfs:label 'Platform Device Type' ;
    rdfs:comment 'The viewing or consumption platform/device type for this demographic record when the dimension type is Platform Device Type (e.g., Linear TV, Connected TV, Mobile, Desktop, OTT Streaming). Critical for OTT and DTC content strategy and digital rights valuation.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationIndex rdf:type rdf:Property ;
    rdfs:label 'Population Index' ;
    rdfs:comment 'Index score comparing the audience composition for this demographic dimension value against the general population baseline (100 = parity with general population; >100 = over-indexed; <100 = under-indexed). Critical for sponsor targeting and broadcast rights negotiations.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedAudienceSize rdf:type rdf:Property ;
    rdfs:label 'Projected Audience Size' ;
    rdfs:comment 'The projected absolute number of viewers or consumers in this demographic dimension value, derived by applying the audience share percentage to the universe estimate. Used in CPM calculations and sponsor reach reporting.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sampleSize rdf:type rdf:Property ;
    rdfs:label 'Sample Size' ;
    rdfs:comment 'The number of panelists or respondents in the measurement sample from which this demographic breakdown was derived. Used to assess statistical reliability and confidence of the demographic estimate.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceSystemName rdf:type rdf:Property ;
    rdfs:label 'Source System Name' ;
    rdfs:comment 'The name of the operational system or data feed from which this audience demographic record was ingested into the Silver Layer (e.g., Nielsen API, Adobe Analytics, Comscore Direct). Supports data lineage tracking and source reconciliation.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorTargetSegmentFlag rdf:type rdf:Property ;
    rdfs:label 'Sponsor Target Segment Flag' ;
    rdfs:comment 'Boolean flag indicating whether this demographic dimension value has been designated as a primary sponsor target segment for the associated broadcast rights deal or sponsorship package. Used to prioritize demographic data in sponsor activation reporting.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statisticalConfidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Statistical Confidence Level' ;
    rdfs:comment 'The statistical confidence level (expressed as a percentage, e.g., 95.00) associated with the demographic estimate for this record. Indicates the reliability of the audience share and population index figures for decision-making.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:universeEstimate rdf:type rdf:Property ;
    rdfs:label 'Universe Estimate' ;
    rdfs:comment 'The estimated total population size (universe) for this demographic dimension value in the measured market. Used as the denominator for audience share calculations and for projecting absolute audience size from percentage figures.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:viewingWindowType rdf:type rdf:Property ;
    rdfs:label 'Viewing Window Type' ;
    rdfs:comment 'The audience measurement viewing window classification (e.g., Live, Live+Same Day, Live+3 days, Live+7 days, VOD, DVR). Nielsen standard viewing windows used to determine the applicable audience figure for advertising and rights valuation purposes.' ;
    rdfs:domain ind:AudienceDemographic ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastRightsWindowId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Window Id' ;
    rdfs:comment 'Foreign key linking to broadcast.broadcast_rights_window. Business justification: Rights compliance measurement: audience measurement must be validated against the licensed rights window to confirm viewership data was captured within authorized distribution periods — a regulatory a' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BroadcastRightsWindow .

ind:broadcastWindowId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Window Id' ;
    rdfs:comment 'Foreign key linking to event.broadcast_window. Business justification: Audience ratings (Nielsen/Kantar) are reported per broadcast window slot. Linking audience_measurement to the event-domain broadcast_window enables broadcast performance reporting against scheduled sl' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BroadcastWindow .

ind:channelId rdf:type rdf:Property ;
    rdfs:label 'Channel Id' ;
    rdfs:comment 'Reference to the broadcast channel (linear TV network, RSN, OTT platform, streaming service) on which the audience was measured. Supports channel-level performance analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Channel .

ind:facilityId rdf:type rdf:Property ;
    rdfs:label 'Facility Id' ;
    rdfs:comment 'Foreign key linking to venue.facility. Business justification: Live broadcast audience measurement is contextualised by the originating facility\'s broadcast production level, capacity, and technical infrastructure. Broadcast rights valuation and audience reportin' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:liveFeedId rdf:type rdf:Property ;
    rdfs:label 'Live Feed Id' ;
    rdfs:comment 'Foreign key linking to broadcast.live_feed. Business justification: Feed-level audience measurement reporting: broadcasters and rights holders correlate live feed delivery quality (CDN, bitrate, redundancy) with concurrent viewer counts to diagnose drop-off events and' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LiveFeed .

ind:platformChannelId rdf:type rdf:Property ;
    rdfs:label 'Platform Channel Id' ;
    rdfs:comment 'Foreign key linking to content.platform_channel. Business justification: OTT platform audience measurement: audience_measurement already links to broadcast.channel for linear TV; digital/OTT platforms are modeled in content.platform_channel. Measuring concurrent streams an' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PlatformChannel .

ind:ppvPackageId rdf:type rdf:Property ;
    rdfs:label 'Ppv Package Id' ;
    rdfs:comment 'Foreign key linking to broadcast.ppv_package. Business justification: PPV audience measurement is a distinct rights-holder reporting requirement: actual concurrent PPV viewers must be reconciled against purchase volumes per package for revenue share calculations and aud' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PpvPackage .

ind:publishEventId rdf:type rdf:Property ;
    rdfs:label 'Publish Event Id' ;
    rdfs:comment 'Foreign key linking to content.publish_event. Business justification: VOD publish event attribution: audience measurement for on-demand content must reference the publish event that made the content available. Rights and distribution teams use this to verify viewership ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PublishEvent .

ind:ama rdf:type rdf:Property ;
    rdfs:label 'Ama' ;
    rdfs:comment 'The average number of viewers watching at any given minute during the measurement window, expressed as an absolute count. AMA (Average Minute Audience) is the primary currency metric for linear TV advertising and broadcast rights valuation in the sports-entertainment industry.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:audienceShare rdf:type rdf:Property ;
    rdfs:label 'Audience Share' ;
    rdfs:comment 'The percentage of televisions in use (HUT — Households Using Television) or persons viewing television (PUT) that were tuned to this broadcast during the measurement window. Expressed as a decimal. Share measures competitive performance relative to other programming airing simultaneously.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Broadcast Duration Minutes' ;
    rdfs:comment 'The total scheduled duration of the broadcast window in minutes. Used as the denominator for AMA (Average Minute Audience) calculations and for normalizing audience engagement metrics across broadcasts of different lengths.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastType rdf:type rdf:Property ;
    rdfs:label 'Broadcast Type' ;
    rdfs:comment 'The distribution channel type for which this audience measurement applies. Linear TV covers traditional scheduled broadcast; OTT (Over-The-Top) streaming covers internet-delivered video; PPV (Pay-Per-View) covers premium event purchases; IPTV (Internet Protocol Television) covers managed IP delivery; RSN (Regional Sports Network) covers regional cable sports channels; digital simulcast covers simultaneous linear and digital broadcast. [ENUM-REF-CANDIDATE: linear_tv|ott_streaming|ppv|iptv|rsn|radio|digital_simulcast — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionRate rdf:type rdf:Property ;
    rdfs:label 'Completion Rate' ;
    rdfs:comment 'The proportion of viewers who watched the broadcast from start to finish, expressed as a decimal (e.g., 0.7200 = 72.00%). Particularly relevant for OTT (Over-The-Top) and DTC (Direct-To-Consumer) streaming platforms. High completion rates indicate strong content engagement and are used in sponsorship ROI reporting.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:countryCode rdf:type rdf:Property ;
    rdfs:label 'Country Code' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code identifying the national market for this audience measurement record. Used for international rights valuation, GDPR jurisdiction determination, and cross-market audience comparison.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demographicSegmentCode rdf:type rdf:Property ;
    rdfs:label 'Demographic Segment Code' ;
    rdfs:comment 'Standardized code identifying the demographic audience segment for which this measurement record applies (e.g., \'A18-49\' for Adults 18-49, \'M25-54\' for Men 25-54, \'F18-34\' for Women 18-34, \'P2+\' for Persons 2 and older). Follows Nielsen and Comscore demographic coding conventions. Enables demographic-specific CPM (Cost Per Mille) pricing and targeted sponsorship reporting.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demographicUniverseSize rdf:type rdf:Property ;
    rdfs:label 'Demographic Universe Size' ;
    rdfs:comment 'The total estimated population size of the demographic segment universe in the measured market, as defined by the measurement provider. Used as the denominator for calculating rating percentages. Sourced from Nielsen or Comscore universe estimates.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geographicMarketCode rdf:type rdf:Property ;
    rdfs:label 'Geographic Market Code' ;
    rdfs:comment 'The geographic market or designated market area (DMA) for which this audience measurement applies. Uses ISO 3166-1 alpha-2 country codes for national markets or Nielsen DMA codes for US sub-national markets (e.g., \'US-NYC\' for New York DMA, \'GBR\' for United Kingdom national). Supports market-level rights valuation and sponsorship ROI analysis.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grp rdf:type rdf:Property ;
    rdfs:label 'Grp' ;
    rdfs:comment 'The sum of all ratings achieved by a broadcast schedule or campaign, calculated as reach multiplied by frequency. GRP (Gross Rating Points) is the standard advertising currency metric used by sponsors and media buyers to evaluate the total weight of a broadcast buy. Critical for sponsorship ROI and CPM (Cost Per Mille) reporting.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:householdRating rdf:type rdf:Property ;
    rdfs:label 'Household Rating' ;
    rdfs:comment 'The percentage of all television households in the measured market that were tuned to this broadcast during the measurement window. Expressed as a decimal (e.g., 0.0850 = 8.50%). The foundational Nielsen linear TV currency metric used in media rights deal negotiations and CPM (Cost Per Mille) calculations.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isLiveEvent rdf:type rdf:Property ;
    rdfs:label 'Is Live Event' ;
    rdfs:comment 'Indicates whether this audience measurement record pertains to a live broadcast of a sports or entertainment event (True) or a recorded/replay/VOD broadcast (False). Live event measurements command premium CPM rates and are treated differently in rights valuation models.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPpv rdf:type rdf:Property ;
    rdfs:label 'Is Ppv' ;
    rdfs:comment 'Indicates whether this audience measurement record is for a PPV (Pay-Per-View) broadcast (True) or a standard broadcast (False). PPV audience measurement uses different methodologies and is reported separately for rights valuation and revenue attribution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:liveViewers rdf:type rdf:Property ;
    rdfs:label 'Live Viewers' ;
    rdfs:comment 'The number of viewers who watched the broadcast live (same-day, same-time as the original airing). Distinct from time-shifted viewers. Live viewership is the primary metric for live sports events and is used in real-time sponsorship exposure calculations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measurementDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Date' ;
    rdfs:comment 'The calendar date on which the audience measurement was recorded or the broadcast window occurred. Used for day-level reporting, trend analysis, and alignment with Nielsen overnight ratings release schedules.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementNotes rdf:type rdf:Property ;
    rdfs:label 'Measurement Notes' ;
    rdfs:comment 'Free-text field for capturing qualitative context about this audience measurement record, such as methodology caveats, data quality flags, extraordinary circumstances affecting viewership (e.g., weather events, competing programming), or notes from the measurement provider regarding revisions.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementStatus rdf:type rdf:Property ;
    rdfs:label 'Measurement Status' ;
    rdfs:comment 'Current lifecycle state of the audience measurement record. Preliminary ratings are released within 24 hours; final ratings are certified after audience panel reconciliation; revised ratings reflect post-publication corrections; disputed records are under review; withdrawn records have been retracted by the measurement provider.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Measurement Timestamp' ;
    rdfs:comment 'The principal real-world date and time at which the audience measurement observation was captured or the measurement window began. Represents the business event time, distinct from record audit timestamps. Stored in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:measurementWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Measurement Window End' ;
    rdfs:comment 'The end date and time of the audience measurement window. Combined with measurement_window_start to define the total measurement duration. Used for AMA (Average Minute Audience) calculation and broadcast window performance analysis.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:measurementWindowStart rdf:type rdf:Property ;
    rdfs:label 'Measurement Window Start' ;
    rdfs:comment 'The start date and time of the audience measurement window. For live events this is the broadcast start time; for time-shifted viewing this is the start of the measurement interval. Used to calculate AMA (Average Minute Audience) and other time-based metrics.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ottConcurrentStreams rdf:type rdf:Property ;
    rdfs:label 'Ott Concurrent Streams' ;
    rdfs:comment 'The number of simultaneous active OTT (Over-The-Top) streaming sessions at the peak measurement point during the broadcast window. Distinct from total unique viewers as one viewer may have multiple device streams. Sourced from internal OTT telemetry or Adobe Experience Platform.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peakConcurrentViewers rdf:type rdf:Property ;
    rdfs:label 'Peak Concurrent Viewers' ;
    rdfs:comment 'The maximum number of viewers simultaneously watching the broadcast at any single point during the measurement window. Critical for OTT (Over-The-Top) infrastructure capacity planning and for reporting record-breaking viewership moments to sponsors and rights holders.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:personsRating rdf:type rdf:Property ;
    rdfs:label 'Persons Rating' ;
    rdfs:comment 'The percentage of all persons in the measured demographic universe who were watching this broadcast during the measurement window. Expressed as a decimal (e.g., 0.0620 = 6.20%). Used alongside household_rating for demographic-specific advertising CPM (Cost Per Mille) pricing.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shareOfVoice rdf:type rdf:Property ;
    rdfs:label 'Share Of Voice' ;
    rdfs:comment 'The proportion of total sports broadcast viewership in the market captured by this event\'s broadcast, expressed as a decimal. Measures competitive dominance of the Sports Entertainment property relative to competing sports and entertainment programming. Key input for sponsorship ROI and media rights valuation.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sportType rdf:type rdf:Property ;
    rdfs:label 'Sport Type' ;
    rdfs:comment 'The sport or entertainment category of the event being broadcast (e.g., \'NFL Football\', \'NBA Basketball\', \'MLB Baseball\', \'NHL Hockey\', \'MLS Soccer\', \'UFC MMA\', \'Concert\', \'Award Show\'). Used for cross-sport audience benchmarking and genre-level rights valuation. [ENUM-REF-CANDIDATE: nfl_football|nba_basketball|mlb_baseball|nhl_hockey|mls_soccer|ufc_mma|concert|award_show|tennis|golf — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeShiftedViewers rdf:type rdf:Property ;
    rdfs:label 'Time Shifted Viewers' ;
    rdfs:comment 'The number of viewers who watched the broadcast on a time-shifted basis (DVR, VOD, catch-up TV) within the standard measurement window (typically C3 or C7 — 3 or 7 days post-broadcast). Time-shifted viewing is included in Nielsen C3/C7 ratings used for advertising currency.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalUniqueViewers rdf:type rdf:Property ;
    rdfs:label 'Total Unique Viewers' ;
    rdfs:comment 'The total count of unduplicated individual viewers who watched any portion of the broadcast during the measurement window. Represents reach — the number of distinct people exposed to the content. Core metric for broadcast rights valuation and sponsorship ROI reporting.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:viewingDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Viewing Duration Minutes' ;
    rdfs:comment 'The average number of minutes that viewers in the measured audience spent watching the broadcast during the measurement window. Expressed in minutes. Used alongside AMA (Average Minute Audience) to assess audience engagement depth and content stickiness.' ;
    rdfs:domain ind:AudienceMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dashboardOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Dashboard Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Dashboard ownership governance in sports entertainment requires linking dashboards to accountable employees for data stewardship reviews, access control audits, and change management. Replaces denorma' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:leagueSeasonId rdf:type rdf:Property ;
    rdfs:label 'League Season Id' ;
    rdfs:comment 'Foreign key linking to league.season. Business justification: Season-scoped dashboards are published for specific league seasons (e.g., 2024-25 season performance dashboard). season_scope is a denormalized plain attribute; a proper FK normalizes this and enables' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Season .

ind:accessLevel rdf:type rdf:Property ;
    rdfs:label 'Access Level' ;
    rdfs:comment 'Data classification and access control level for the dashboard. Determines who can view the dashboard: public (all staff), internal (authenticated employees), restricted (specific roles/teams), confidential (named individuals only).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biPlatform rdf:type rdf:Property ;
    rdfs:label 'Bi Platform' ;
    rdfs:comment 'The BI or analytics platform on which the dashboard is rendered and published (e.g., Tableau, Power BI, Databricks SQL). Determines the tooling required for access and maintenance.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationDate rdf:type rdf:Property ;
    rdfs:label 'Certification Date' ;
    rdfs:comment 'The date on which the dashboard was formally certified by the Data Governance team. Null if the dashboard has not yet been certified.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certifiedBy rdf:type rdf:Property ;
    rdfs:label 'Certified By' ;
    rdfs:comment 'Name or employee identifier of the Data Governance officer or data steward who formally certified the dashboard.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeLogNotes rdf:type rdf:Property ;
    rdfs:label 'Change Log Notes' ;
    rdfs:comment 'Free-text notes documenting the most recent changes made to the dashboard definition, including the reason for change, scope of modification, and approver. Supports audit trail and change management.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dashboardCategory rdf:type rdf:Property ;
    rdfs:label 'Dashboard Category' ;
    rdfs:comment 'High-level classification of the dashboard by its intended use: executive (C-suite KPI summaries), operational (day-to-day monitoring), analytical (deep-dive exploration), regulatory (compliance reporting), self_service (ad-hoc user-built).' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dashboardCode rdf:type rdf:Property ;
    rdfs:label 'Dashboard Code' ;
    rdfs:comment 'Externally-known, human-readable unique code assigned to the dashboard (e.g., DASH-CEO001, DASH-VEN002). Used in cross-system references, documentation, and stakeholder communications.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dashboardDescription rdf:type rdf:Property ;
    rdfs:label 'Dashboard Description' ;
    rdfs:comment 'Detailed narrative describing the business purpose, scope, and intended use of the dashboard. Explains what business questions the dashboard is designed to answer.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dashboardName rdf:type rdf:Property ;
    rdfs:label 'Dashboard Name' ;
    rdfs:comment 'Official human-readable title of the dashboard as displayed in the BI platform (e.g., \'CEO Performance Dashboard\', \'Venue Operations Dashboard\', \'Fan Engagement Scorecard\').' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dashboardUrl rdf:type rdf:Property ;
    rdfs:label 'Dashboard Url' ;
    rdfs:comment 'The canonical URL or deep-link to access the published dashboard in the BI platform. Used for distribution, bookmarking, and embedding in portals.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dashboardVersion rdf:type rdf:Property ;
    rdfs:label 'Dashboard Version' ;
    rdfs:comment 'Semantic version number of the dashboard definition (e.g., \'1.0.0\', \'2.3.1\'). Tracks major redesigns, minor enhancements, and patch fixes to the dashboard layout and logic.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataDomain rdf:type rdf:Property ;
    rdfs:label 'Data Domain' ;
    rdfs:comment 'Primary data domain that the dashboard draws from (e.g., Event, Athlete, Venue, Broadcast, Ticketing, Fan, Sponsorship, Merchandise, League, Content, Finance). Aligns with the Sports Entertainment data domain taxonomy. [ENUM-REF-CANDIDATE: Event|Athlete|Venue|Broadcast|Ticketing|Fan|Sponsorship|Merchandise|League|Content|Finance|Workforce|Compliance|Digital Platform — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveFromDate rdf:type rdf:Property ;
    rdfs:label 'Effective From Date' ;
    rdfs:comment 'The date from which this dashboard definition became or becomes active and available for use. Supports versioning and scheduled go-live of new dashboard designs.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveUntilDate rdf:type rdf:Property ;
    rdfs:label 'Effective Until Date' ;
    rdfs:comment 'The date after which this dashboard definition is no longer active. Null for open-ended dashboards. Used to manage scheduled deprecation and archival.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:embeddingApplication rdf:type rdf:Property ;
    rdfs:label 'Embedding Application' ;
    rdfs:comment 'Name of the application or portal in which the dashboard is embedded (e.g., \'Executive Intranet\', \'Salesforce CRM\', \'Fan Engagement Portal\'). Null if is_embedded is false.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCertified rdf:type rdf:Property ;
    rdfs:label 'Is Certified' ;
    rdfs:comment 'Indicates whether the dashboard has been formally certified by the Data Governance team as meeting data quality, accuracy, and business alignment standards. Certified dashboards are the authoritative source for executive reporting.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEmbedded rdf:type rdf:Property ;
    rdfs:label 'Is Embedded' ;
    rdfs:comment 'Indicates whether the dashboard is embedded within another application or portal (e.g., embedded in the Sports Entertainment fan engagement platform, executive intranet, or Salesforce CRM). Affects deployment and access management.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastDataRefreshTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Data Refresh Timestamp' ;
    rdfs:comment 'The date and time when the underlying data powering the dashboard was last successfully refreshed. Distinct from publication timestamp — data may refresh without republication.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastPublishedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Published Timestamp' ;
    rdfs:comment 'The date and time when the dashboard was most recently published or re-published to its target audience. Used to track recency and SLA compliance.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mobileOptimized rdf:type rdf:Property ;
    rdfs:label 'Mobile Optimized' ;
    rdfs:comment 'Indicates whether the dashboard has been designed and tested for mobile device viewing. Relevant for field staff, venue operations managers, and executives accessing dashboards on mobile devices during live events.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:owningBusinessUnit rdf:type rdf:Property ;
    rdfs:label 'Owning Business Unit' ;
    rdfs:comment 'Name of the Sports Entertainment business unit that owns and is accountable for the dashboard content and accuracy (e.g., \'League Operations\', \'Venue Management\', \'Fan Engagement\', \'Broadcast & Media\', \'Finance\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryKpiReferences rdf:type rdf:Property ;
    rdfs:label 'Primary Kpi References' ;
    rdfs:comment 'Comma-separated list of KPI identifiers or names that are the primary metrics featured on this dashboard (e.g., \'ARPU, NPS, Ticket_Revenue, Broadcast_Ratings\'). Links the dashboard to the KPI catalog.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicationStatus rdf:type rdf:Property ;
    rdfs:label 'Publication Status' ;
    rdfs:comment 'Current lifecycle state of the dashboard within the registry. Controls visibility and access: draft (in development), published (live and accessible), archived (retired but retained), under_review (pending approval), deprecated (scheduled for removal).' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refreshFrequency rdf:type rdf:Property ;
    rdfs:label 'Refresh Frequency' ;
    rdfs:comment 'How frequently the underlying data powering the dashboard is refreshed. Determines data freshness SLA communicated to consumers (e.g., real_time for live event dashboards, daily for financial KPI dashboards).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refreshScheduleCron rdf:type rdf:Property ;
    rdfs:label 'Refresh Schedule Cron' ;
    rdfs:comment 'Cron expression defining the exact schedule for automated data refresh jobs (e.g., \'0 6 * * *\' for daily at 6 AM). Used by the Databricks job scheduler or BI platform refresh engine.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRelevance rdf:type rdf:Property ;
    rdfs:label 'Regulatory Relevance' ;
    rdfs:comment 'Comma-separated list of regulatory frameworks or governing bodies whose reporting requirements this dashboard supports (e.g., \'SOX, GDPR, PCI-DSS, SEC, FCC\'). Flags dashboards used for regulatory compliance reporting.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportType rdf:type rdf:Property ;
    rdfs:label 'Report Type' ;
    rdfs:comment 'Functional type of the dashboard report: scorecard (KPI summary vs targets), tracker (progress over time), monitor (real-time operational), explorer (ad-hoc drill-down), forecast (predictive), benchmark (comparative performance).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rowLevelSecurityEnabled rdf:type rdf:Property ;
    rdfs:label 'Row Level Security Enabled' ;
    rdfs:comment 'Indicates whether row-level security is applied to the dashboard, restricting data visibility based on the viewer\'s organizational role or geography (e.g., a regional venue manager sees only their venue\'s data).' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:silverLayerTables rdf:type rdf:Property ;
    rdfs:label 'Silver Layer Tables' ;
    rdfs:comment 'Comma-separated list of Databricks Lakehouse Silver layer table names that this dashboard queries (e.g., \'analytics.fan_behavior_model, ticketing.ticket_transaction, finance.revenue_summary\'). Supports impact analysis.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagsList rdf:type rdf:Property ;
    rdfs:label 'Tags List' ;
    rdfs:comment 'Comma-separated list of business taxonomy tags applied to the dashboard for discoverability and search (e.g., \'revenue, fan-engagement, live-event, KPI, executive\'). Supports the dashboard catalog search experience.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetAudienceRole rdf:type rdf:Property ;
    rdfs:label 'Target Audience Role' ;
    rdfs:comment 'The primary organizational role or persona for whom the dashboard is designed (e.g., \'CEO\', \'CFO\', \'Venue Operations Manager\', \'Sponsorship Director\', \'Broadcast Analyst\'). Drives access control and distribution lists.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicalOwner rdf:type rdf:Property ;
    rdfs:label 'Technical Owner' ;
    rdfs:comment 'Full name or employee identifier of the data engineer or BI developer responsible for the technical implementation, maintenance, and refresh pipeline of the dashboard.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updateFrequencySlaHours rdf:type rdf:Property ;
    rdfs:label 'Update Frequency Sla Hours' ;
    rdfs:comment 'Maximum acceptable number of hours between data refresh cycles as defined in the dashboard\'s SLA. Used to monitor and alert on data staleness. For example, an executive dashboard may have a 24-hour SLA.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:workspacePath rdf:type rdf:Property ;
    rdfs:label 'Workspace Path' ;
    rdfs:comment 'The folder or workspace path within the BI platform where the dashboard is stored (e.g., \'/Workspaces/Executive/CEO\' in Tableau or \'/Finance/Revenue\' in Power BI). Supports governance and access management.' ;
    rdfs:domain ind:DashboardDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementIndexId rdf:type rdf:Property ;
    rdfs:label 'Engagement Index Id' ;
    rdfs:comment 'Unique surrogate identifier for each periodic fan engagement index record in the Silver Layer analytics table.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EngagementIndex .

ind:capacityConfigId rdf:type rdf:Property ;
    rdfs:label 'Capacity Config Id' ;
    rdfs:comment 'Foreign key linking to venue.capacity_config. Business justification: Engagement index attendance_score is normalised against sellable capacity. Linking to capacity_config enables accurate normalisation against the actual configured capacity in effect for the measuremen' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapacityConfig .

ind:competitionRoundId rdf:type rdf:Property ;
    rdfs:label 'Competition Round Id' ;
    rdfs:comment 'Foreign key linking to event.competition_round. Business justification: Matchweek/round-level fan engagement index is a standard sports marketing KPI. Marketing and commercial teams track engagement trends round-over-round to optimize campaign timing and content strategy ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompetitionRound .

ind:fanSegmentId rdf:type rdf:Property ;
    rdfs:label 'Fan Segment Id' ;
    rdfs:comment 'Reference to the fan segment entity when the index is computed at the fan segment level. Null when entity_type is not fan_segment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SportsEntertainment .

ind:venueId rdf:type rdf:Property ;
    rdfs:label 'Venue Id' ;
    rdfs:comment 'Reference to the venue entity when the index is computed at the venue level. Null when entity_type is not venue.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Venue .

ind:attendanceScore rdf:type rdf:Property ;
    rdfs:label 'Attendance Score' ;
    rdfs:comment 'Normalized sub-score (0.0000–100.0000) representing the attendance frequency dimension of fan engagement. Derived from event attendance recency, frequency, and ticket purchase patterns sourced from Ticketmaster/AXS and Archtics.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attendanceScoreWeight rdf:type rdf:Property ;
    rdfs:label 'Attendance Score Weight' ;
    rdfs:comment 'Weighting coefficient (0.0000–1.0000) applied to the attendance frequency score in the composite index calculation. Sum of all dimension weights must equal 1.0000. Enables model recalibration without reprocessing raw data.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastConsumptionScore rdf:type rdf:Property ;
    rdfs:label 'Broadcast Consumption Score' ;
    rdfs:comment 'Normalized sub-score (0.0000–100.0000) representing fan broadcast and media consumption engagement including live TV viewership, OTT streaming hours, PPV purchases, and RSN viewing frequency. Sourced from broadcast audience rating systems.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastScoreWeight rdf:type rdf:Property ;
    rdfs:label 'Broadcast Score Weight' ;
    rdfs:comment 'Weighting coefficient (0.0000–1.0000) applied to the broadcast consumption score in the composite index calculation. Enables model recalibration without reprocessing raw data.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compositeScore rdf:type rdf:Property ;
    rdfs:label 'Composite Score' ;
    rdfs:comment 'Normalized composite engagement index value (0.0000–100.0000) aggregating all engagement dimension scores into a single health metric. Serves as the primary KPI on executive dashboards for fan engagement health.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:computationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Computation Timestamp' ;
    rdfs:comment 'Exact date and time when the engagement index computation pipeline executed and produced this record. Distinct from the period dates; used for pipeline audit and SLA monitoring.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataClassification rdf:type rdf:Property ;
    rdfs:label 'Data Classification' ;
    rdfs:comment 'Data sensitivity classification for this engagement index record per the enterprise data governance policy. Determines access controls and handling requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataCompletenessPct rdf:type rdf:Property ;
    rdfs:label 'Data Completeness Pct' ;
    rdfs:comment 'Percentage of expected input signals that were successfully received and processed for this index computation (0.00–100.00). Values below threshold may indicate data quality issues and should be flagged for review before publishing.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:digitalActivityScore rdf:type rdf:Property ;
    rdfs:label 'Digital Activity Score' ;
    rdfs:comment 'Normalized sub-score (0.0000–100.0000) representing fan engagement on owned digital platforms including app usage, website visits, OTT streaming sessions, and DTC content consumption. Sourced from Adobe Experience Platform.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:digitalActivityScoreWeight rdf:type rdf:Property ;
    rdfs:label 'Digital Activity Score Weight' ;
    rdfs:comment 'Weighting coefficient (0.0000–1.0000) applied to the digital platform activity score in the composite index calculation. Enables model recalibration without reprocessing raw data.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entityName rdf:type rdf:Property ;
    rdfs:label 'Entity Name' ;
    rdfs:comment 'Human-readable display name of the entity for which the engagement index is computed (e.g., \'NBA Season Ticket Holders\', \'Los Angeles Lakers\', \'Staples Center\'). Denormalized for dashboard readability.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityType rdf:type rdf:Property ;
    rdfs:label 'Entity Type' ;
    rdfs:comment 'Discriminator indicating the type of business entity for which this engagement index is computed. Determines which entity reference FK is populated (fan_segment_id, league_id, venue_id, or event_id).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanPopulationCount rdf:type rdf:Property ;
    rdfs:label 'Fan Population Count' ;
    rdfs:comment 'Number of distinct fans or fan accounts included in the engagement index computation for this entity and period. Provides denominator context for interpreting the composite score magnitude.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:indexCode rdf:type rdf:Property ;
    rdfs:label 'Index Code' ;
    rdfs:comment 'Business-facing unique code identifying this engagement index record, encoding entity type, entity reference, and period (e.g., EI-NBAFAN-2024W12). Used as the externally-known identifier on executive dashboards.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexModelVersion rdf:type rdf:Property ;
    rdfs:label 'Index Model Version' ;
    rdfs:comment 'Version identifier of the engagement index computation model used to produce this record (e.g., \'v2.1.0\'). Enables reproducibility, audit, and comparison across model versions. Links to the fan_behavior_model registry.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexPeriodType rdf:type rdf:Property ;
    rdfs:label 'Index Period Type' ;
    rdfs:comment 'Granularity of the engagement index computation period. Determines whether the index represents a weekly, monthly, seasonal, or annual aggregation window.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexStatus rdf:type rdf:Property ;
    rdfs:label 'Index Status' ;
    rdfs:comment 'Lifecycle status of this engagement index record. \'draft\' indicates computation in progress; \'published\' indicates approved and available for dashboards; \'superseded\' indicates replaced by a revised record; \'retracted\' indicates withdrawn due to data quality issues.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBaselinePeriod rdf:type rdf:Property ;
    rdfs:label 'Is Baseline Period' ;
    rdfs:comment 'Indicates whether this index record represents the designated baseline period against which future engagement scores are benchmarked. True for the reference period established during model calibration.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPublishedToDashboard rdf:type rdf:Property ;
    rdfs:label 'Is Published To Dashboard' ;
    rdfs:comment 'Indicates whether this engagement index record has been approved and published to executive KPI dashboards. False for draft or retracted records.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loyaltyScore rdf:type rdf:Property ;
    rdfs:label 'Loyalty Score' ;
    rdfs:comment 'Normalized sub-score (0.0000–100.0000) representing fan loyalty program engagement including points earned, redemptions, tier progression, and program tenure. Sourced from Salesforce CRM.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loyaltyScoreWeight rdf:type rdf:Property ;
    rdfs:label 'Loyalty Score Weight' ;
    rdfs:comment 'Weighting coefficient (0.0000–1.0000) applied to the loyalty program participation score in the composite index calculation. Enables model recalibration without reprocessing raw data.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:merchandiseScore rdf:type rdf:Property ;
    rdfs:label 'Merchandise Score' ;
    rdfs:comment 'Normalized sub-score (0.0000–100.0000) representing merchandise purchasing engagement based on recency, frequency, and breadth of SKU purchases. Sourced from Shopify Plus e-commerce platform.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:merchandiseScoreWeight rdf:type rdf:Property ;
    rdfs:label 'Merchandise Score Weight' ;
    rdfs:comment 'Weighting coefficient (0.0000–1.0000) applied to the merchandise purchase recency score in the composite index calculation. Enables model recalibration without reprocessing raw data.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:npsScore rdf:type rdf:Property ;
    rdfs:label 'Nps Score' ;
    rdfs:comment 'Net Promoter Score (-100.00 to 100.00) for the entity during the index period, representing fan likelihood to recommend. Sourced from fan survey data in Salesforce CRM and Adobe Experience Platform. Contextualizes the composite engagement index.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodEndDate rdf:type rdf:Property ;
    rdfs:label 'Period End Date' ;
    rdfs:comment 'Last calendar date of the engagement measurement window for this index record. Combined with period_start_date defines the exact aggregation interval.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodStartDate rdf:type rdf:Property ;
    rdfs:label 'Period Start Date' ;
    rdfs:comment 'First calendar date of the engagement measurement window for this index record. Combined with period_end_date defines the exact aggregation interval.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorPeriodCompositeScore rdf:type rdf:Property ;
    rdfs:label 'Prior Period Composite Score' ;
    rdfs:comment 'Composite engagement score from the immediately preceding equivalent period (e.g., prior week, prior month, prior season). Stored to enable period-over-period variance analysis without requiring a self-join.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:publishedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Published Timestamp' ;
    rdfs:comment 'Date and time when this engagement index record was approved and published to executive dashboards. Null if index_status is not \'published\'. Supports audit trail for governance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scoreChangePct rdf:type rdf:Property ;
    rdfs:label 'Score Change Pct' ;
    rdfs:comment 'Percentage change in composite engagement score versus the prior equivalent period. Positive values indicate improvement; negative values indicate decline. Used for trend alerting and executive reporting.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:socialMediaScore rdf:type rdf:Property ;
    rdfs:label 'Social Media Score' ;
    rdfs:comment 'Normalized sub-score (0.0000–100.0000) representing fan social media engagement including mentions, shares, reactions, UGC creation, and hashtag participation related to the entity. Sourced from Adobe Experience Platform social listening.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:socialMediaScoreWeight rdf:type rdf:Property ;
    rdfs:label 'Social Media Score Weight' ;
    rdfs:comment 'Weighting coefficient (0.0000–1.0000) applied to the social media interaction score in the composite index calculation. Enables model recalibration without reprocessing raw data.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trendDirection rdf:type rdf:Property ;
    rdfs:label 'Trend Direction' ;
    rdfs:comment 'Directional indicator comparing the composite engagement score to the prior equivalent period. Derived from the delta between current and prior composite scores and used for executive traffic-light reporting.' ;
    rdfs:domain ind:EngagementIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:experimentId rdf:type rdf:Property ;
    rdfs:label 'Experiment Id' ;
    rdfs:comment 'Unique surrogate identifier for the data science experiment record within the Sports Entertainment MLflow tracking environment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Experiment .

ind:employeeId rdf:type rdf:Property ;
    rdfs:label 'Employee Id' ;
    rdfs:comment 'Reference to the primary data scientist who owns and is accountable for this experiment. Used for workload tracking, knowledge management, and experiment governance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:experimentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Experiment Employee Id' ;
    rdfs:comment 'Reference to the primary data scientist who owns and is accountable for this experiment. Used for workload tracking, knowledge management, and experiment governance.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primarySuccessorExperimentId rdf:type rdf:Property ;
    rdfs:label 'Primary Successor Experiment Id' ;
    rdfs:comment 'Reference to the follow-on experiment spawned when the promotion decision is \'iterate\'. Enables experiment lineage tracking and iterative model development chain reconstruction.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Experiment .

ind:reviewerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Reviewer Employee Id' ;
    rdfs:comment 'Reference to the analytics lead or senior data scientist who reviewed and approved the promotion decision for this experiment. Enforces the four-eyes principle in ML governance.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:reviewerId rdf:type rdf:Property ;
    rdfs:label 'Reviewer Id' ;
    rdfs:comment 'Reference to the analytics lead or senior data scientist who reviewed and approved the promotion decision for this experiment. Enforces the four-eyes principle in ML governance.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:baselineMetricValue rdf:type rdf:Property ;
    rdfs:label 'Baseline Metric Value' ;
    rdfs:comment 'Value of the primary evaluation metric for the baseline or incumbent model against which this experiment is benchmarked. Enables calculation of relative improvement to justify promotion.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bestMetricValue rdf:type rdf:Property ;
    rdfs:label 'Best Metric Value' ;
    rdfs:comment 'Numeric value of the primary evaluation metric achieved by the best run. Provides a quantitative benchmark for promotion decisions and cross-experiment comparison.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:businessDomain rdf:type rdf:Property ;
    rdfs:label 'Business Domain' ;
    rdfs:comment 'Primary Sports Entertainment business domain that this experiment addresses. Aligns with the enterprise data domain taxonomy to enable domain-level experiment portfolio reporting. [ENUM-REF-CANDIDATE: Fan|Athlete|Venue|Broadcast|Ticketing|Sponsorship|Merchandise|League|Content|Finance — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:computeCluster rdf:type rdf:Property ;
    rdfs:label 'Compute Cluster' ;
    rdfs:comment 'Name or identifier of the Databricks compute cluster used to execute experiment runs. Used for cost attribution, infrastructure capacity planning, and performance benchmarking.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:computeCostUsd rdf:type rdf:Property ;
    rdfs:label 'Compute Cost Usd' ;
    rdfs:comment 'Estimated or actual cloud compute cost in US Dollars incurred by all runs within this experiment. Used for ROI analysis, budget tracking, and prioritization of future experiments. Classified confidential as it reflects internal cost structure.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:conclusionSummary rdf:type rdf:Property ;
    rdfs:label 'Conclusion Summary' ;
    rdfs:comment 'Narrative summary of the experiment findings, key learnings, and rationale for the promotion decision. Captured by the owning data scientist and reviewed by the analytics lead. Serves as institutional knowledge for future experiments.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:databricksWorkspace rdf:type rdf:Property ;
    rdfs:label 'Databricks Workspace' ;
    rdfs:comment 'Name of the Databricks workspace in which this experiment is registered. Supports multi-workspace governance and experiment discoverability across the Sports Entertainment lakehouse environment.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endDate rdf:type rdf:Property ;
    rdfs:label 'End Date' ;
    rdfs:comment 'Calendar date on which the experiment was concluded, abandoned, or paused. Null if the experiment is still active. Used to compute experiment duration and throughput KPIs.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:experimentName rdf:type rdf:Property ;
    rdfs:label 'Experiment Name' ;
    rdfs:comment 'Human-readable name of the data science experiment as registered in the MLflow tracking environment. Must be unique within the owning team workspace (e.g., \'fan_churn_xgboost_v3\', \'ticket_demand_forecast_lstm\').' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:experimentStatus rdf:type rdf:Property ;
    rdfs:label 'Experiment Status' ;
    rdfs:comment 'Current lifecycle state of the experiment. \'active\' indicates runs are in progress; \'completed\' indicates the experiment has concluded with a result; \'abandoned\' indicates the experiment was stopped without a conclusion; \'paused\' indicates temporarily halted; \'draft\' indicates not yet started.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:experimentType rdf:type rdf:Property ;
    rdfs:label 'Experiment Type' ;
    rdfs:comment 'Machine learning problem type that characterizes this experiment. Guides model selection, evaluation strategy, and infrastructure provisioning. [ENUM-REF-CANDIDATE: classification|regression|clustering|forecasting|recommendation|nlp|computer_vision|reinforcement_learning|anomaly_detection|ranking — promote to reference product]' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureStoreDataset rdf:type rdf:Property ;
    rdfs:label 'Feature Store Dataset' ;
    rdfs:comment 'Name of the Databricks Feature Store dataset or feature table used as the primary training data source for this experiment. Enables data lineage tracing and reproducibility audits.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gitBranch rdf:type rdf:Property ;
    rdfs:label 'Git Branch' ;
    rdfs:comment 'Name of the Git branch associated with this experiment (e.g., \'feature/fan-churn-v3\'). Together with git_repository, provides full code provenance for reproducibility and audit.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gitRepository rdf:type rdf:Property ;
    rdfs:label 'Git Repository' ;
    rdfs:comment 'URL of the source code repository (e.g., GitHub, Azure DevOps) containing the experiment notebooks and scripts. Enables code reproducibility, peer review, and version-controlled model development.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hypothesisStatement rdf:type rdf:Property ;
    rdfs:label 'Hypothesis Statement' ;
    rdfs:comment 'Formal hypothesis being tested in this experiment, articulating the expected relationship or outcome (e.g., \'Adding venue capacity utilization as a feature will improve fan churn prediction AUC by at least 3%\'). Drives scientific rigor in the ML development process.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:linkedKpi rdf:type rdf:Property ;
    rdfs:label 'Linked Kpi' ;
    rdfs:comment 'Name of the business KPI that this experiment is designed to improve (e.g., \'Fan NPS\', \'Ticket Revenue\', \'Athlete Injury Rate\', \'Broadcast ARPU\'). Connects ML experiments to executive-level business outcomes.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mlflowExperimentReference rdf:type rdf:Property ;
    rdfs:label 'Mlflow Experiment Reference' ;
    rdfs:comment 'Native experiment identifier assigned by the MLflow tracking server. Used to cross-reference this record with the MLflow UI and API for run retrieval and lineage tracing.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelFramework rdf:type rdf:Property ;
    rdfs:label 'Model Framework' ;
    rdfs:comment 'Machine learning framework used to build and train models in this experiment. Informs infrastructure requirements, serialization format, and serving compatibility. [ENUM-REF-CANDIDATE: sklearn|xgboost|lightgbm|tensorflow|pytorch|spark_ml|statsmodels|prophet|catboost|huggingface — promote to reference product]' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:piaReference rdf:type rdf:Property ;
    rdfs:label 'Pia Reference' ;
    rdfs:comment 'Reference identifier of the Privacy Impact Assessment (PIA) conducted for this experiment when PII data is used. Links to the compliance.pia_assessment record for regulatory audit purposes under GDPR Article 35 and CCPA.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryMetric rdf:type rdf:Property ;
    rdfs:label 'Primary Metric' ;
    rdfs:comment 'The principal quantitative metric used to evaluate and compare runs within this experiment (e.g., \'auc_roc\', \'rmse\', \'f1_score\', \'map_at_10\', \'log_loss\'). Determines which run is designated as the best run.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryMetricDirection rdf:type rdf:Property ;
    rdfs:label 'Primary Metric Direction' ;
    rdfs:comment 'Indicates whether the primary evaluation metric should be maximized (e.g., AUC, F1) or minimized (e.g., RMSE, log_loss) to identify the best run. Critical for automated run comparison and model selection logic.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priority rdf:type rdf:Property ;
    rdfs:label 'Priority' ;
    rdfs:comment 'Business priority level assigned to this experiment by the analytics leadership team. Drives resource allocation, compute quota assignment, and sprint planning decisions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promotionDecision rdf:type rdf:Property ;
    rdfs:label 'Promotion Decision' ;
    rdfs:comment 'Outcome decision made by the data science team and stakeholders upon experiment conclusion. \'promote\' triggers model registration and production deployment pipeline; \'abandon\' closes the experiment; \'iterate\' spawns a follow-on experiment; \'pending\' awaits review.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promotionDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Promotion Decision Date' ;
    rdfs:comment 'Date on which the promotion decision was formally recorded. Used for governance audit trails and time-to-decision KPI reporting.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewNotes rdf:type rdf:Property ;
    rdfs:label 'Review Notes' ;
    rdfs:comment 'Free-text notes recorded by the reviewer during the promotion decision review. Captures concerns, conditions, or recommendations that informed the final promotion decision.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startDate rdf:type rdf:Property ;
    rdfs:label 'Start Date' ;
    rdfs:comment 'Calendar date on which the experiment was formally initiated and the first MLflow run was registered. Used for experiment duration tracking and sprint planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetEndDate rdf:type rdf:Property ;
    rdfs:label 'Target End Date' ;
    rdfs:comment 'Planned completion date for the experiment as agreed during sprint or project planning. Compared against actual end_date to measure delivery adherence.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetVariable rdf:type rdf:Property ;
    rdfs:label 'Target Variable' ;
    rdfs:comment 'Name of the dependent variable or label that the model is trained to predict (e.g., \'fan_churn_flag\', \'ticket_demand_units\', \'athlete_injury_risk_score\'). Central to experiment reproducibility and model documentation.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalRuns rdf:type rdf:Property ;
    rdfs:label 'Total Runs' ;
    rdfs:comment 'Count of MLflow runs executed within this experiment. Indicates the breadth of hyperparameter search and computational investment made during the experiment.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingDataEndDate rdf:type rdf:Property ;
    rdfs:label 'Training Data End Date' ;
    rdfs:comment 'Latest date of the historical data window used to train models in this experiment. Together with training_data_start_date, defines the training window and guards against data leakage.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trainingDataStartDate rdf:type rdf:Property ;
    rdfs:label 'Training Data Start Date' ;
    rdfs:comment 'Earliest date of the historical data window used to train models in this experiment. Defines the temporal scope of the training dataset for reproducibility and data freshness assessment.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:usesPii rdf:type rdf:Property ;
    rdfs:label 'Uses Pii' ;
    rdfs:comment 'Indicates whether this experiment uses personally identifiable information (PII) such as fan profiles, purchase history, or behavioral data. Triggers mandatory Privacy Impact Assessment (PIA) review and GDPR/CCPA compliance checks.' ;
    rdfs:domain ind:Experiment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wadaComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Wada Compliance Flag' ;
    rdfs:comment 'Indicates whether this experiment involves athlete performance or biometric data subject to World Anti-Doping Agency (WADA) regulations. When true, additional data handling restrictions and audit requirements apply.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fanBehaviorModelId rdf:type rdf:Property ;
    rdfs:label 'Fan Behavior Model Id' ;
    rdfs:comment 'Unique surrogate identifier for each fan behavioral segmentation or predictive model registered in the Sports Entertainment analytics platform. Serves as the primary key for the model registry.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanBehaviorModel .

ind:modelOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Model Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: ML model governance in sports entertainment requires linking fan behavior model owners to employee records for model risk reviews, data privacy accountability (PIA), and WADA compliance audits. Replac' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:piaAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Pia Assessment Id' ;
    rdfs:comment 'Foreign key linking to compliance.pia_assessment. Business justification: Fan behavior models that process personal fan data for scoring, segmentation, and targeting require a Privacy Impact Assessment (PIA) under GDPR/CCPA. The fan_behavior_model already tracks data_privac' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PiaAssessment .

ind:algorithmFamily rdf:type rdf:Property ;
    rdfs:label 'Algorithm Family' ;
    rdfs:comment 'The primary machine learning algorithm family used to build the model (e.g., \'gradient_boosting\', \'neural_network\'). Informs technical reviewers of computational requirements, interpretability constraints, and regulatory explainability obligations. [ENUM-REF-CANDIDATE: gradient_boosting|random_forest|logistic_regression|neural_network|collaborative_filtering|k_means|linear_regression|svm|naive_bayes — promote to reference product]' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biasAssessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Bias Assessment Status' ;
    rdfs:comment 'Current status of the fairness and bias evaluation for this model. Ensures models do not produce discriminatory predictions across protected fan demographic groups. Required for GDPR Article 22 compliance and Sports Entertainment AI ethics governance.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:challengerTrafficPct rdf:type rdf:Property ;
    rdfs:label 'Challenger Traffic Pct' ;
    rdfs:comment 'The percentage of fan scoring traffic routed to this model when it is deployed as a challenger in an A/B or champion/challenger test (e.g., 10.00 = 10% of traffic). Null when is_challenger is False.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataPrivacyReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Review Status' ;
    rdfs:comment 'Status of the Privacy Impact Assessment (PIA) review for this model, confirming that fan personal data used in training and scoring complies with GDPR, CCPA, and Sports Entertainment data privacy policies.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:explainabilityMethod rdf:type rdf:Property ;
    rdfs:label 'Explainability Method' ;
    rdfs:comment 'The model interpretability technique applied to generate feature-level explanations for predictions (e.g., \'shap\' for SHAP values). Required for regulatory AI transparency obligations and business stakeholder trust in model outputs.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureCount rdf:type rdf:Property ;
    rdfs:label 'Feature Count' ;
    rdfs:comment 'Total number of input features used in the final trained model. Used for model complexity governance, regulatory explainability assessments, and computational resource planning.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:featureSetSummary rdf:type rdf:Property ;
    rdfs:label 'Feature Set Summary' ;
    rdfs:comment 'High-level narrative description of the input feature categories used in the model (e.g., \'Ticket purchase recency/frequency/monetary, content streaming engagement, social media sentiment, venue attendance history, merchandise purchase behavior\'). Not a full feature list — that resides in the feature store.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isChallenger rdf:type rdf:Property ;
    rdfs:label 'Is Challenger' ;
    rdfs:comment 'Indicates whether this model version is currently deployed as a challenger in an A/B or champion/challenger evaluation. True = challenger model receiving a traffic split for comparative evaluation against the champion.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isChampion rdf:type rdf:Property ;
    rdfs:label 'Is Champion' ;
    rdfs:comment 'Indicates whether this model version is the current champion (primary production model) in a champion/challenger evaluation framework. True = champion model actively serving predictions; False = challenger or non-active model. Only one model per category should be champion at any time.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastDeployedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Deployed Timestamp' ;
    rdfs:comment 'The date and time when this model version was most recently promoted to its current deployment environment (staging or production). Used for deployment audit trails and rollback reference.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastTrainedDate rdf:type rdf:Property ;
    rdfs:label 'Last Trained Date' ;
    rdfs:comment 'The date on which the most recent model training run was completed. Used to calculate model age, assess staleness risk, and trigger retraining alerts when the elapsed time exceeds the retraining_frequency threshold.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketSegmentScope rdf:type rdf:Property ;
    rdfs:label 'Market Segment Scope' ;
    rdfs:comment 'The specific sub-scope or segment of the betting market to which this deployment applies. May narrow the deployment to a subset of the market — e.g., applying the churn model only to live in-play markets for NFL fixtures, or only to futures markets above a defined stake threshold. Allows fine-grained deployment targeting within a market definition.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumAcceptableMetric rdf:type rdf:Property ;
    rdfs:label 'Minimum Acceptable Metric' ;
    rdfs:comment 'The minimum acceptable value for the primary performance metric below which the model is flagged for retraining or retirement. Enforces model quality governance and prevents degraded predictions from reaching production.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelApplicationType rdf:type rdf:Property ;
    rdfs:label 'Model Application Type' ;
    rdfs:comment 'The operational purpose for which this fan behavior model is being applied to this betting market scope. Determines how the model output is consumed — e.g., LIABILITY_CALIBRATION uses the model score to adjust max stake limits, PERSONALIZATION uses it to surface or suppress market visibility for specific fan segments.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelArtifactPath rdf:type rdf:Property ;
    rdfs:label 'Model Artifact Path' ;
    rdfs:comment 'The storage path or URI to the serialized model artifact (e.g., MLflow model registry path, S3/ADLS URI). Confidential as it reveals internal infrastructure topology. Used by MLOps pipelines to load the model for scoring.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelCategory rdf:type rdf:Property ;
    rdfs:label 'Model Category' ;
    rdfs:comment 'Business use-case category that classifies the model\'s primary analytical purpose within the Sports Entertainment fan analytics ecosystem. Drives routing to the appropriate business unit and KPI dashboard. [ENUM-REF-CANDIDATE: churn_propensity|upsell_likelihood|attendance_prediction|content_affinity|sponsorship_affinity|merchandise_propensity|loyalty_tier_prediction|sentiment_classification — promote to reference product]' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelType rdf:type rdf:Property ;
    rdfs:label 'Model Type' ;
    rdfs:comment 'Machine learning paradigm used by the model. Classification models predict discrete outcomes (e.g., churn yes/no); regression models predict continuous values (e.g., attendance count); clustering models segment fans into groups; recommendation models suggest content or products.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelVersionApplied rdf:type rdf:Property ;
    rdfs:label 'Model Version Applied' ;
    rdfs:comment 'The specific semantic version of the fan behavior model (e.g., 2.1.0) that was active for this deployment record. Captured at deployment time to preserve a point-in-time audit trail independent of the current model_version on the parent fan_behavior_model registry record, which may have been updated since.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outputScoreLabel rdf:type rdf:Property ;
    rdfs:label 'Output Score Label' ;
    rdfs:comment 'The name of the score or prediction output field produced by this model when applied to fan records (e.g., \'churn_probability_score\', \'upsell_likelihood_score\', \'predicted_attendance_count\'). Used to map model output to downstream CRM and activation systems.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outputScoreRangeMax rdf:type rdf:Property ;
    rdfs:label 'Output Score Range Max' ;
    rdfs:comment 'The maximum possible value of the model\'s output score (e.g., 1.0 for probability scores, 100 for index scores). Used for output validation, dashboard axis configuration, and downstream system integration.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outputScoreRangeMin rdf:type rdf:Property ;
    rdfs:label 'Output Score Range Min' ;
    rdfs:comment 'The minimum possible value of the model\'s output score (e.g., 0.0 for probability scores, -1.0 for sentiment scores). Used for output validation, dashboard axis configuration, and downstream system integration.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:platformEnvironment rdf:type rdf:Property ;
    rdfs:label 'Platform Environment' ;
    rdfs:comment 'The ML platform or compute environment where this model is trained and served (e.g., \'databricks\' for Databricks Lakehouse, \'aep_native\' for Adobe Experience Platform native ML). Informs infrastructure cost allocation and operational support routing.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryMetricValue rdf:type rdf:Property ;
    rdfs:label 'Primary Metric Value' ;
    rdfs:comment 'The numeric score achieved on the primary performance metric during the most recent model evaluation on the holdout/test dataset (e.g., AUC-ROC of 0.847). Used for champion/challenger comparison and model governance thresholds.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryPerformanceMetric rdf:type rdf:Property ;
    rdfs:label 'Primary Performance Metric' ;
    rdfs:comment 'The principal evaluation metric used to assess model quality and compare versions (e.g., \'auc_roc\' for classification, \'rmse\' for regression, \'ndcg\' for recommendation). Drives champion/challenger selection decisions. [ENUM-REF-CANDIDATE: auc_roc|f1_score|precision|recall|rmse|mae|accuracy|silhouette_score|ndcg — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementDate rdf:type rdf:Property ;
    rdfs:label 'Retirement Date' ;
    rdfs:comment 'The date on which this model version was or is scheduled to be retired and removed from active scoring. Null for active models. Required for model lifecycle governance and audit trail completeness.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retrainingFrequency rdf:type rdf:Property ;
    rdfs:label 'Retraining Frequency' ;
    rdfs:comment 'The scheduled cadence at which the model is retrained on fresh data to prevent model drift (e.g., \'monthly\' for churn models, \'quarterly\' for attendance prediction). Drives MLOps pipeline scheduling and data engineering SLAs. [ENUM-REF-CANDIDATE: weekly|monthly|quarterly|semi_annual|annual|event_triggered|on_demand — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoringFrequency rdf:type rdf:Property ;
    rdfs:label 'Scoring Frequency' ;
    rdfs:comment 'How frequently the model generates predictions against the fan population (e.g., \'daily\' batch scoring for churn propensity, \'real_time\' for content recommendation). Drives infrastructure scheduling and SLA commitments.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetFanSegment rdf:type rdf:Property ;
    rdfs:label 'Target Fan Segment' ;
    rdfs:comment 'Description of the fan population this model is designed to score (e.g., \'Season ticket holders with 2+ years tenure\', \'All registered fans in North American markets\', \'OTT streaming subscribers\'). Defines the model\'s applicable audience scope.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingDatasetDescription rdf:type rdf:Property ;
    rdfs:label 'Training Dataset Description' ;
    rdfs:comment 'Narrative description of the dataset(s) used to train the model, including data sources (e.g., Ticketmaster transaction history, Adobe Experience Platform fan profiles, Salesforce CRM engagement data), observation window, and population scope.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingRecordCount rdf:type rdf:Property ;
    rdfs:label 'Training Record Count' ;
    rdfs:comment 'Number of fan records (observations) included in the training dataset. Provides context for model statistical power, generalizability, and minimum data volume compliance checks.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validationMetricValue rdf:type rdf:Property ;
    rdfs:label 'Validation Metric Value' ;
    rdfs:comment 'The numeric score achieved on the primary performance metric during cross-validation or validation dataset evaluation. Compared against primary_metric_value to assess overfitting risk.' ;
    rdfs:domain ind:FanBehaviorModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fanScoreId rdf:type rdf:Property ;
    rdfs:label 'Fan Score Id' ;
    rdfs:comment 'Unique surrogate identifier for each fan score record. One record per fan per model per model run. Primary key of the fan_score data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanScore .

ind:bettorAccountId rdf:type rdf:Property ;
    rdfs:label 'Bettor Account Id' ;
    rdfs:comment 'Foreign key linking to gaming.bettor_account. Business justification: Sportsbook personalization and responsible gaming processes require linking predictive fan scores (churn risk, LTV) directly to the bettor\'s registered account. Gaming operators use these scores for r' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BettorAccount .

ind:fanProfileId rdf:type rdf:Property ;
    rdfs:label 'Fan Fan Profile Id' ;
    rdfs:comment 'Reference to the fan profile record for whom this score was generated. Links to the fan master profile in the CRM and Adobe Experience Platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:seasonTicketAccountId rdf:type rdf:Property ;
    rdfs:label 'Season Ticket Account Id' ;
    rdfs:comment 'Foreign key linking to ticketing.season_ticket_account. Business justification: STH churn risk scoring and renewal propensity modeling is a named, high-priority business process in sports entertainment. The STH retention team uses fan scores to prioritize outreach to at-risk acco' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SeasonTicketAccount .

ind:teamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Team Franchise Id' ;
    rdfs:comment 'Reference to the specific team or franchise for which this score was generated. Enables team-level fan segmentation and supports personalized marketing by team affinity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:activationEligible rdf:type rdf:Property ;
    rdfs:label 'Activation Eligible' ;
    rdfs:comment 'Indicates whether this score record is eligible for use in marketing activation, personalization, or CRM campaign targeting. Set to False when the fan has opted out of marketing communications, is subject to a GDPR/CCPA data processing restriction, or the score is suppressed.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:channelContext rdf:type rdf:Property ;
    rdfs:label 'Channel Context' ;
    rdfs:comment 'The engagement channel scope for which this score was computed. \'all\' = cross-channel holistic score; \'digital\' = OTT/DTC/app behavior; \'in_venue\' = attendance and venue spend; \'broadcast\' = RSN/IPTV/streaming viewership; \'merchandise\' = Shopify Plus e-commerce; \'ticketing\' = Ticketmaster/AXS transactions.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:churnRiskReason rdf:type rdf:Property ;
    rdfs:label 'Churn Risk Reason' ;
    rdfs:comment 'Primary driver or reason code explaining the churn risk score for this fan. Populated when score_type = \'churn_risk\'. Examples: \'declining_attendance\', \'no_recent_purchase\', \'subscription_lapse\', \'team_performance\'. Supports targeted retention campaign design in Salesforce CRM.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceIntervalLower rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Lower' ;
    rdfs:comment 'Lower bound of the 95% confidence interval around the score_value. Indicates the statistical uncertainty of the model prediction. Used by data science teams to assess model reliability and by downstream systems to apply risk-adjusted thresholds.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceIntervalUpper rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Upper' ;
    rdfs:comment 'Upper bound of the 95% confidence interval around the score_value. Used in conjunction with confidence_interval_lower to communicate prediction uncertainty to downstream consumers.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceLevelPct rdf:type rdf:Property ;
    rdfs:label 'Confidence Level Pct' ;
    rdfs:comment 'The statistical confidence level (e.g., 90.00, 95.00, 99.00) associated with the confidence interval bounds. Expressed as a percentage. Allows consumers to understand the interval\'s coverage probability.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contentAffinityGenre rdf:type rdf:Property ;
    rdfs:label 'Content Affinity Genre' ;
    rdfs:comment 'Primary content genre or format this fan shows highest engagement affinity toward, populated when score_type = \'content_engagement\'. Examples: \'live_game\', \'highlights\', \'behind_the_scenes\', \'athlete_profile\', \'analysis\'. Used by content production and digital distribution teams for personalization.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityFlag rdf:type rdf:Property ;
    rdfs:label 'Data Quality Flag' ;
    rdfs:comment 'Assessment of the input data quality used to generate this score. \'clean\' = full feature set available; \'low_signal\' = limited behavioral history; \'sparse_history\' = fewer than minimum required events; \'imputed\' = missing features were imputed; \'excluded\' = fan excluded from scoring due to data quality threshold failure.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanTier rdf:type rdf:Property ;
    rdfs:label 'Fan Tier' ;
    rdfs:comment 'Fan loyalty tier classification at the time of scoring, derived from CRM and ticketing data. Provides behavioral context for score interpretation. VIP and season ticket holder tiers are sourced from Archtics and Ticketmaster/AXS.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureSetVersion rdf:type rdf:Property ;
    rdfs:label 'Feature Set Version' ;
    rdfs:comment 'Version identifier of the feature engineering pipeline and input feature set used to generate this score. Enables reproducibility and supports debugging when score distributions shift unexpectedly.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSeasonTicketHolder rdf:type rdf:Property ;
    rdfs:label 'Is Season Ticket Holder' ;
    rdfs:comment 'Indicates whether the fan held an active season ticket at the time of scoring. Sourced from Archtics venue seating and inventory management. Used as a key behavioral feature context and for segment-level score benchmarking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSubscriber rdf:type rdf:Property ;
    rdfs:label 'Is Subscriber' ;
    rdfs:comment 'Indicates whether the fan held an active OTT/DTC streaming subscription at the time of scoring. Sourced from broadcast streaming subscription records. Relevant context for content_engagement and churn_risk score types.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ltvAmount rdf:type rdf:Property ;
    rdfs:label 'Ltv Amount' ;
    rdfs:comment 'Predicted monetary Lifetime Value (LTV) of the fan expressed in the base currency. Populated only when score_type = \'ltv\'. Represents the expected cumulative revenue from this fan over the scoring horizon. Used for ARPU and LTV KPI reporting and marketing budget allocation.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ltvCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Ltv Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the ltv_amount field (e.g., \'USD\', \'GBP\', \'EUR\'). Required for multi-market operations across global leagues and broadcasting territories.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Model Algorithm' ;
    rdfs:comment 'Name or family of the machine learning algorithm used to produce this score (e.g., \'XGBoost\', \'Logistic Regression\', \'Neural Network\', \'Random Forest\'). Supports model governance, auditability, and comparative analysis across algorithm types. [ENUM-REF-CANDIDATE: xgboost|logistic_regression|neural_network|random_forest|gradient_boosting|linear_regression|ensemble — promote to reference product]' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npsSegment rdf:type rdf:Property ;
    rdfs:label 'Nps Segment' ;
    rdfs:comment 'Fan\'s Net Promoter Score (NPS) segment classification derived from survey data or behavioral inference. Promoters (score 9-10), Passives (7-8), Detractors (0-6). Used alongside predictive scores to prioritize fan engagement and loyalty programs.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:observationWindowDays rdf:type rdf:Property ;
    rdfs:label 'Observation Window Days' ;
    rdfs:comment 'The lookback period in days of fan behavioral data used as input features for this score. Defines the recency of the behavioral signal (e.g., 90-day rolling window of ticket purchases, content views, merchandise transactions).' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:percentileBand rdf:type rdf:Property ;
    rdfs:label 'Percentile Band' ;
    rdfs:comment 'Categorical bucketing of the score percentile into quintile bands for simplified segmentation and CRM audience targeting. P0_20 = bottom quintile, P81_100 = top quintile.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineRunTimestamp rdf:type rdf:Property ;
    rdfs:label 'Pipeline Run Timestamp' ;
    rdfs:comment 'The exact date and time (ISO 8601 with timezone offset) when the scoring pipeline execution that produced this record completed. Supports data lineage, SLA monitoring, and audit trail requirements.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:previousScoreValue rdf:type rdf:Property ;
    rdfs:label 'Previous Score Value' ;
    rdfs:comment 'The score_value from the immediately preceding model run for the same fan and score_type. Enables score delta calculation and trend monitoring without requiring a self-join. Null for first-time scored fans.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreDate rdf:type rdf:Property ;
    rdfs:label 'Score Date' ;
    rdfs:comment 'The calendar date on which this score was generated by the model run. Used for temporal filtering, trend analysis, and determining score freshness in CRM and personalization platforms.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scoreDelta rdf:type rdf:Property ;
    rdfs:label 'Score Delta' ;
    rdfs:comment 'Difference between the current score_value and the previous_score_value (current minus previous). Positive values indicate score improvement; negative values indicate score decline. Used to identify fans with rapidly changing behavioral signals for priority intervention.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Score Expiry Date' ;
    rdfs:comment 'The date after which this score is considered stale and should no longer be used for activation or decision-making. Downstream systems (CRM, personalization) must suppress expired scores. Expiry is model-type-dependent (e.g., churn risk scores may expire sooner than LTV scores).' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scorePercentile rdf:type rdf:Property ;
    rdfs:label 'Score Percentile' ;
    rdfs:comment 'Percentile rank of this fan\'s score relative to the full scored population for the same model run. Expressed as a value between 0.00 and 100.00. Used for relative ranking and audience segmentation in marketing activation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scorePopulationSize rdf:type rdf:Property ;
    rdfs:label 'Score Population Size' ;
    rdfs:comment 'Total number of fan records scored in the same model run. Used to contextualize the percentile rank and validate that the scoring pipeline processed the expected volume of fans.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scoreRank rdf:type rdf:Property ;
    rdfs:label 'Score Rank' ;
    rdfs:comment 'Ordinal rank of this fan\'s score within the scored population for the same model run, ordered from highest to lowest score_value. Rank 1 = highest scoring fan. Used for top-N audience selection in marketing campaigns.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scoreStatus rdf:type rdf:Property ;
    rdfs:label 'Score Status' ;
    rdfs:comment 'Lifecycle status of this score record. \'active\' = current and valid for activation; \'expired\' = past score_expiry_date; \'superseded\' = replaced by a newer run for the same fan/model; \'suppressed\' = excluded from activation due to data quality or compliance hold; \'pending_review\' = flagged for manual review.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreTrend rdf:type rdf:Property ;
    rdfs:label 'Score Trend' ;
    rdfs:comment 'Directional trend classification of the fan\'s score over recent model runs. \'improving\' = score_delta positive and significant; \'stable\' = score_delta within noise threshold; \'declining\' = score_delta negative and significant; \'new\' = no prior score exists for comparison.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreType rdf:type rdf:Property ;
    rdfs:label 'Score Type' ;
    rdfs:comment 'Classification of the behavioral or predictive score produced. Supported types: ltv (Lifetime Value), attendance_propensity, merchandise_affinity, churn_risk, upsell_readiness, content_engagement. Determines how the score is consumed by CRM, personalization, and marketing activation workflows.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreValue rdf:type rdf:Property ;
    rdfs:label 'Score Value' ;
    rdfs:comment 'The raw numeric output of the model for this fan and score type. Scale and range are model-dependent (e.g., 0.0–1.0 probability for propensity models, or a continuous value for LTV models). Consumers must interpret in conjunction with score_type and model_id.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoringHorizonDays rdf:type rdf:Property ;
    rdfs:label 'Scoring Horizon Days' ;
    rdfs:comment 'The forward-looking prediction window in days for which this score is valid (e.g., 30, 60, 90, 365). For propensity scores, this is the window within which the predicted event is expected to occur. For LTV scores, this is the value accumulation horizon.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingCohort rdf:type rdf:Property ;
    rdfs:label 'Training Cohort' ;
    rdfs:comment 'Label identifying the fan population cohort used to train the model that produced this score (e.g., \'NBA_2023_Season\', \'Global_All_Sports_2024\'). Supports model governance and ensures scores are interpreted within the correct population context.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:upsellProductCategory rdf:type rdf:Property ;
    rdfs:label 'Upsell Product Category' ;
    rdfs:comment 'The recommended product or service category for upsell activation when score_type = \'upsell_readiness\'. Examples: \'premium_seating\', \'season_ticket\', \'vip_hospitality\', \'ppv_package\', \'merchandise_bundle\'. Drives personalized offer generation in CRM and DTC platforms.' ;
    rdfs:domain ind:FanScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureStoreEntityId rdf:type rdf:Property ;
    rdfs:label 'Feature Store Entity Id' ;
    rdfs:comment 'Unique surrogate identifier for each ML feature store entity registered in the Sports Entertainment Databricks Feature Store. Primary key for this master registry record.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:metadataTagId rdf:type rdf:Property ;
    rdfs:label 'Metadata Tag Id' ;
    rdfs:comment 'Foreign key linking to content.metadata_tag. Business justification: Content affinity feature engineering: fan behavior models use content metadata tags (sport, athlete, content type) as the basis for content preference features. Data scientists link feature_store_enti' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MetadataTag .

ind:pipelineDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Pipeline Definition Id' ;
    rdfs:comment 'Foreign key linking to analytics.pipeline_definition. Business justification: A feature store entity is owned and produced by a specific analytics pipeline. Adding pipeline_definition_id normalizes the owning_pipeline_name string reference into a proper FK, enabling governance ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PipelineDefinition .

ind:accessControlGroup rdf:type rdf:Property ;
    rdfs:label 'Access Control Group' ;
    rdfs:comment 'Name of the Databricks Unity Catalog access control group or role that is authorized to read this feature (e.g., ml_engineers, data_scientists_fan_domain, athlete_analytics_team). Enforces least-privilege access to sensitive features derived from fan or athlete data.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregationWindow rdf:type rdf:Property ;
    rdfs:label 'Aggregation Window' ;
    rdfs:comment 'Time window over which the feature is aggregated, expressed as an ISO 8601 duration or business description (e.g., \'P30D\' for 30-day rolling window, \'P1Y\' for trailing 12 months, \'season_to_date\'). Null for non-aggregated point-in-time features. Critical for reproducibility of model training.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessJustification rdf:type rdf:Property ;
    rdfs:label 'Business Justification' ;
    rdfs:comment 'Plain-language explanation of the business value this feature provides and the KPI or decision it supports (e.g., \'Supports fan churn prediction to enable targeted retention campaigns, directly impacting ARR and LTV\'). Required for governance approval of new features.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:computationLogicDescription rdf:type rdf:Property ;
    rdfs:label 'Computation Logic Description' ;
    rdfs:comment 'Plain-language description of how the feature value is computed, including the source data, transformation logic, aggregation window, and any business rules applied (e.g., \'Number of days since the fan last attended a live event, computed from ticketing transaction history in Ticketmaster/AXS\'). Supports feature governance and auditability.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consumingModelCount rdf:type rdf:Property ;
    rdfs:label 'Consuming Model Count' ;
    rdfs:comment 'Number of distinct ML models or analytical pipelines currently consuming this feature. Used to assess the blast radius of changes to the feature definition and to prioritize governance reviews for high-impact features.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deprecationDate rdf:type rdf:Property ;
    rdfs:label 'Deprecation Date' ;
    rdfs:comment 'Scheduled or actual date on which this feature was or will be deprecated and removed from active computation. Null for active features. Consuming models must migrate to replacement features before this date to avoid serving failures.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:domain rdf:type rdf:Property ;
    rdfs:label 'Domain' ;
    rdfs:comment 'Primary Sports Entertainment business domain that this feature belongs to, aligning with the enterprise data domain taxonomy. Drives feature discoverability and domain-level governance (e.g., Fan, Athlete, Event, Venue, Broadcast). [ENUM-REF-CANDIDATE: Fan|Athlete|Event|Venue|Broadcast|Sponsorship|Merchandise|Finance|Content|Workforce — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedValueMax rdf:type rdf:Property ;
    rdfs:label 'Expected Value Max' ;
    rdfs:comment 'Maximum expected value for this feature based on business domain knowledge and historical data distributions (e.g., 1.0 for a probability score, 100.0 for a percentage). Used alongside expected_value_min for automated data quality monitoring and drift detection.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedValueMin rdf:type rdf:Property ;
    rdfs:label 'Expected Value Min' ;
    rdfs:comment 'Minimum expected value for this feature based on business domain knowledge and historical data distributions (e.g., 0.0 for a probability score, -1.0 for a normalized index). Used by data quality monitoring pipelines to detect anomalous feature values and trigger alerts.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:featureCategory rdf:type rdf:Property ;
    rdfs:label 'Feature Category' ;
    rdfs:comment 'Semantic category classifying the nature of the feature for discoverability and model design. Behavioral features capture fan/athlete actions; performance features capture on-field metrics; contextual features capture event/environmental conditions; financial features capture revenue signals. [ENUM-REF-CANDIDATE: behavioral|performance|contextual|financial|demographic|temporal|geospatial|operational — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureDataType rdf:type rdf:Property ;
    rdfs:label 'Feature Data Type' ;
    rdfs:comment 'Apache Spark SQL data type of the feature value as stored in the Databricks Feature Store table (e.g., DOUBLE for continuous scores, INT for counts, STRING for categorical labels, BOOLEAN for flags). Used for schema validation and model input contract enforcement. [ENUM-REF-CANDIDATE: INT|BIGINT|DOUBLE|FLOAT|STRING|BOOLEAN|DATE|TIMESTAMP|DECIMAL — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureDisplayName rdf:type rdf:Property ;
    rdfs:label 'Feature Display Name' ;
    rdfs:comment 'Human-readable business label for the feature used in dashboards, data catalogs, and stakeholder communications (e.g., \'Fan Recency (Days Since Last Event)\', \'Athlete Injury Risk Score\'). Distinct from the programmatic feature_name.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureGroupName rdf:type rdf:Property ;
    rdfs:label 'Feature Group Name' ;
    rdfs:comment 'Name of the Databricks Feature Store feature group (table) that contains this feature. Feature groups logically cluster related features (e.g., fan_rfm_features, athlete_performance_features, event_context_features, venue_utilization_features). Enables feature reuse and group-level governance.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureImportanceRank rdf:type rdf:Property ;
    rdfs:label 'Feature Importance Rank' ;
    rdfs:comment 'Ordinal rank of this feature by importance within its owning model (1 = most important). Derived from the latest model training run\'s feature importance scores (e.g., SHAP values, Gini importance). Used by data scientists to prioritize feature maintenance and identify candidates for deprecation.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:featureName rdf:type rdf:Property ;
    rdfs:label 'Feature Name' ;
    rdfs:comment 'Unique programmatic name of the ML feature as registered in the Databricks Feature Store (e.g., fan_recency_days, athlete_injury_risk_score, event_rivalry_score). Must be lowercase snake_case and globally unique within the feature store.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureStatus rdf:type rdf:Property ;
    rdfs:label 'Feature Status' ;
    rdfs:comment 'Current lifecycle state of the feature within the Sports Entertainment ML feature governance framework. Active features are production-ready and reusable; experimental features are under evaluation; deprecated features are scheduled for retirement; retired features are no longer computed.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureStoreTablePath rdf:type rdf:Property ;
    rdfs:label 'Feature Store Table Path' ;
    rdfs:comment 'Full Delta Lake table path or Unity Catalog three-part identifier (catalog.schema.table) where this feature is physically stored in the Databricks Lakehouse (e.g., sports_entertainment.fan_features.fan_rfm_features). Used by model serving and training pipelines to locate and read feature values.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureVersion rdf:type rdf:Property ;
    rdfs:label 'Feature Version' ;
    rdfs:comment 'Semantic version number of the feature definition (e.g., 1.0.0, 2.1.3). Incremented when computation logic, aggregation window, or source data changes in a way that affects feature values. Enables model reproducibility and backward compatibility tracking.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPiiDerived rdf:type rdf:Property ;
    rdfs:label 'Is Pii Derived' ;
    rdfs:comment 'Indicates whether this feature is derived from or contains Personally Identifiable Information (PII) about fans or athletes. When True, the feature is subject to GDPR, CCPA, and Sports Entertainment data privacy policies, including access controls, retention limits, and right-to-erasure obligations.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPointInTimeCorrect rdf:type rdf:Property ;
    rdfs:label 'Is Point In Time Correct' ;
    rdfs:comment 'Indicates whether this feature supports point-in-time correct lookups during model training to prevent data leakage. When True, the feature store will use the timestamp column to retrieve the feature value as it existed at the training label timestamp. Essential for time-series ML models in sports analytics.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReusable rdf:type rdf:Property ;
    rdfs:label 'Is Reusable' ;
    rdfs:comment 'Indicates whether this feature is approved for reuse across multiple ML models and pipelines beyond its original owning model. When True, the feature is catalogued as a shared asset in the Sports Entertainment feature registry, reducing redundant computation and promoting consistency.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastComputedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Computed Timestamp' ;
    rdfs:comment 'Timestamp of the most recent successful computation and write of this feature to the feature store. Used to monitor feature freshness, detect stale features, and enforce SLA compliance for model serving pipelines.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastPipelineRunStatus rdf:type rdf:Property ;
    rdfs:label 'Last Pipeline Run Status' ;
    rdfs:comment 'Outcome status of the most recent execution of the owning pipeline that computes this feature. Enables operational monitoring of feature freshness and triggers alerting when pipelines fail, ensuring model serving is not degraded by stale feature values.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nullHandlingStrategy rdf:type rdf:Property ;
    rdfs:label 'Null Handling Strategy' ;
    rdfs:comment 'Prescribed strategy for handling null or missing values for this feature during model training and inference (e.g., impute_mean for continuous features, impute_zero for count features, forward_fill for time-series features). Ensures consistent preprocessing across all consuming models. [ENUM-REF-CANDIDATE: impute_mean|impute_median|impute_zero|impute_mode|forward_fill|drop|flag_only — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryKeyColumn rdf:type rdf:Property ;
    rdfs:label 'Primary Key Column' ;
    rdfs:comment 'Name of the join key column in the feature store table used to look up feature values for a given entity instance (e.g., fan_id, athlete_id, event_id, venue_id). Critical for point-in-time correct feature retrieval during model training and online serving.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementFeatureName rdf:type rdf:Property ;
    rdfs:label 'Replacement Feature Name' ;
    rdfs:comment 'Programmatic name of the successor feature that replaces this feature upon deprecation. Populated when feature_status is \'deprecated\' or \'retired\' to guide consuming model teams in migrating to the updated feature definition.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Retention Period Days' ;
    rdfs:comment 'Number of days that historical feature values are retained in the feature store Delta table before being purged. Driven by data privacy regulations (GDPR right to erasure, CCPA) and storage cost management. PII-derived features typically have shorter retention periods.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceSystem rdf:type rdf:Property ;
    rdfs:label 'Source System' ;
    rdfs:comment 'Operational system of record from which the raw data for this feature is sourced (e.g., Ticketmaster/AXS, Salesforce CRM, SAP S/4HANA, SportsCode/Hudl, Adobe Experience Platform). Supports data lineage, impact analysis, and SLA dependency tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceTableReference rdf:type rdf:Property ;
    rdfs:label 'Source Table Reference' ;
    rdfs:comment 'Fully qualified Delta Lake or source system table name from which the raw input data for this feature is derived (e.g., silver.ticketing.ticket_transaction, silver.athlete.performance_stat). Enables precise data lineage tracing from feature back to raw source.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tags rdf:type rdf:Property ;
    rdfs:label 'Tags' ;
    rdfs:comment 'Comma-separated free-text tags applied to this feature for discoverability and filtering in the Sports Entertainment data catalog (e.g., \'rfm,fan_engagement,churn_model\', \'injury_risk,athlete_health,predictive\'). Supports self-service feature discovery by data scientists.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timestampColumn rdf:type rdf:Property ;
    rdfs:label 'Timestamp Column' ;
    rdfs:comment 'Name of the timestamp column in the feature store table used for point-in-time correct feature retrieval (e.g., event_timestamp, computed_at). Required when is_point_in_time_correct is True. Null for features that do not support temporal lookups.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updateFrequency rdf:type rdf:Property ;
    rdfs:label 'Update Frequency' ;
    rdfs:comment 'How frequently the feature value is recomputed and written to the feature store. Drives SLA expectations for model freshness and determines whether streaming or batch pipelines are required (e.g., real_time for live fan engagement scores, daily for athlete form index, event_triggered for rivalry score). [ENUM-REF-CANDIDATE: real_time|hourly|daily|weekly|monthly|on_demand|event_triggered — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueUnit rdf:type rdf:Property ;
    rdfs:label 'Value Unit' ;
    rdfs:comment 'Unit of measurement for the feature value where applicable (e.g., \'days\' for recency, \'USD\' for monetary value, \'percent\' for utilization rate, \'score_0_to_1\' for normalized indices, \'count\' for frequency). Null for dimensionless or categorical features.' ;
    rdfs:domain ind:FeatureStoreEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastModelId rdf:type rdf:Property ;
    rdfs:label 'Forecast Model Id' ;
    rdfs:comment 'Unique surrogate identifier for each business forecasting model record deployed across Sports Entertainment. Primary key for the forecast_model entity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ForecastModel .

ind:businessUnitId rdf:type rdf:Property ;
    rdfs:label 'Business Unit Id' ;
    rdfs:comment 'Identifier of the owning business unit responsible for this forecasting model (e.g., Ticketing, Broadcast, Merchandise, Sponsorship, Venue Operations). Links to the organizational hierarchy managed in SAP S/4HANA CO module.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:costCenterId rdf:type rdf:Property ;
    rdfs:label 'Cost Center Id' ;
    rdfs:comment 'Identifier of the owning business unit responsible for this forecasting model (e.g., Ticketing, Broadcast, Merchandise, Sponsorship, Venue Operations). Links to the organizational hierarchy managed in SAP S/4HANA CO module.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:glAccountId rdf:type rdf:Property ;
    rdfs:label 'Gl Account Id' ;
    rdfs:comment 'Foreign key linking to finance.gl_account. Business justification: Financial forecast models predict balances for specific GL accounts (e.g., broadcast rights revenue GL, ticket sales GL). FP&A teams map forecast models to GL accounts so actuals can be automatically ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GlAccount .

ind:jurisdictionId rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Id' ;
    rdfs:comment 'Foreign key linking to gaming.gaming_jurisdiction. Business justification: GGR and handle forecast models are scoped per licensed jurisdiction for financial planning and regulatory submissions. Replacing the plain-text geographic_scope with a FK to gaming_jurisdiction enforc' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Jurisdiction .

ind:accuracyMetricType rdf:type rdf:Property ;
    rdfs:label 'Accuracy Metric Type' ;
    rdfs:comment 'Type of statistical accuracy metric used to evaluate this model\'s forecast performance (e.g., MAPE — Mean Absolute Percentage Error, RMSE — Root Mean Square Error). Standardizes model comparison across business units.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accuracyMetricValue rdf:type rdf:Property ;
    rdfs:label 'Accuracy Metric Value' ;
    rdfs:comment 'Numeric value of the accuracy metric (e.g., MAPE of 0.085 = 8.5% error) measured on the holdout validation dataset at the time of last training. Used by the analytics team to assess model fitness for production deployment.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:algorithm rdf:type rdf:Property ;
    rdfs:label 'Algorithm' ;
    rdfs:comment 'Machine learning or statistical algorithm used by this forecasting model. Drives model interpretability, retraining cadence, and infrastructure requirements on the Databricks Lakehouse platform.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedBy rdf:type rdf:Property ;
    rdfs:label 'Approved By' ;
    rdfs:comment 'Name or identifier of the executive or governance committee that approved this model for production deployment. Required for SOX compliance and model risk governance in financial forecasting contexts.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceIntervalPct rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Pct' ;
    rdfs:comment 'Statistical confidence interval percentage applied to forecast outputs (e.g., 90.00 = 90% confidence interval). Communicated to business stakeholders to convey forecast uncertainty in executive dashboards.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deploymentDate rdf:type rdf:Property ;
    rdfs:label 'Deployment Date' ;
    rdfs:comment 'Date on which this model version was promoted to active production status in the Databricks MLflow Model Registry and began generating live forecasts for business consumption.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:driftDetectionEnabled rdf:type rdf:Property ;
    rdfs:label 'Drift Detection Enabled' ;
    rdfs:comment 'Indicates whether automated model drift detection monitoring is active for this model. When enabled, statistical drift in input feature distributions or prediction accuracy triggers alerts to the model owner.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:driftThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Drift Threshold Pct' ;
    rdfs:comment 'Percentage degradation in accuracy metric value that triggers a model drift alert and initiates a retraining review (e.g., 10.00 = alert when accuracy degrades by more than 10%). Null if drift detection is not enabled.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:featureSetDescription rdf:type rdf:Property ;
    rdfs:label 'Feature Set Description' ;
    rdfs:comment 'Business-level description of the key input features (predictor variables) used by this model (e.g., \'historical ticket sales, event type, day-of-week, opponent ranking, weather, promotional flags\'). Supports model explainability for business stakeholders.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastGranularity rdf:type rdf:Property ;
    rdfs:label 'Forecast Granularity' ;
    rdfs:comment 'Temporal resolution at which this model produces forecast outputs. Event-level granularity is used for individual game/concert forecasts; weekly/monthly for operational planning; seasonal for strategic planning aligned to league calendars.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastHorizonDays rdf:type rdf:Property ;
    rdfs:label 'Forecast Horizon Days' ;
    rdfs:comment 'Number of calendar days into the future this model is designed to forecast. For example, 90 days for quarterly ticket sales forecasts, 365 days for annual sponsorship revenue forecasts. Drives model evaluation and retraining schedules.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:forecastType rdf:type rdf:Property ;
    rdfs:label 'Forecast Type' ;
    rdfs:comment 'Business classification of what this model forecasts. Determines the target variable and applicable KPIs: ticket_sales (Ticketmaster/AXS), broadcast_viewership (Dalet Galaxy/OTT), merchandise_demand (Shopify Plus), sponsorship_revenue (Salesforce CRM), venue_attendance (Archtics).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hyperparameterConfig rdf:type rdf:Property ;
    rdfs:label 'Hyperparameter Config' ;
    rdfs:comment 'JSON-serialized string capturing the key hyperparameters used to configure this model (e.g., \'{"seasonality_mode":"multiplicative","changepoint_prior_scale":0.05}\' for Prophet). Stored as STRING per Silver Layer schema constraints (no MAP/STRUCT types).' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAutomatedRetrain rdf:type rdf:Property ;
    rdfs:label 'Is Automated Retrain' ;
    rdfs:comment 'Indicates whether this model is configured for automated retraining via Databricks pipelines (True) or requires manual intervention for each retraining cycle (False). Drives operational SLA commitments for forecast freshness.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isChampionModel rdf:type rdf:Property ;
    rdfs:label 'Is Champion Model' ;
    rdfs:comment 'Indicates whether this model version is the current champion (primary production) model for its forecast type and business unit. Supports champion-challenger model governance frameworks used in analytics operations.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastRetrainDate rdf:type rdf:Property ;
    rdfs:label 'Last Retrain Date' ;
    rdfs:comment 'Calendar date on which the model was most recently retrained against updated historical data. Used to monitor model staleness and trigger automated retraining pipelines in Databricks.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mlflowRunReference rdf:type rdf:Property ;
    rdfs:label 'Mlflow Run Reference' ;
    rdfs:comment 'Unique identifier of the MLflow experiment run that produced this model version in the Databricks Lakehouse. Enables direct traceability to training artifacts, hyperparameters, and evaluation metrics stored in the MLflow Model Registry.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextScheduledRetrainDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Retrain Date' ;
    rdfs:comment 'Planned calendar date for the next model retraining cycle. Supports proactive model governance and ensures forecasts remain aligned with current business conditions (e.g., post-season roster changes, new broadcast deals).' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outputTablePath rdf:type rdf:Property ;
    rdfs:label 'Output Table Path' ;
    rdfs:comment 'Fully qualified path to the Delta Lake table in the Databricks Lakehouse where this model writes its forecast output records (e.g., \'analytics.gold.ticket_sales_forecast_output\'). Used by downstream BI tools and Workday Adaptive Planning integrations.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetVariableUnit rdf:type rdf:Property ;
    rdfs:label 'Target Variable Unit' ;
    rdfs:comment 'Unit of measurement for the forecast target variable (e.g., \'count\', \'USD\', \'millions_viewers\', \'units\'). Required for correct interpretation of forecast outputs in dashboards and executive reporting.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingDataSource rdf:type rdf:Property ;
    rdfs:label 'Training Data Source' ;
    rdfs:comment 'Identifies the primary operational system(s) from which training data was sourced (e.g., \'Ticketmaster/AXS\', \'Dalet Galaxy\', \'Shopify Plus\', \'Salesforce CRM\', \'Archtics\'). Critical for data lineage, audit, and model reproducibility.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingEndDate rdf:type rdf:Property ;
    rdfs:label 'Training End Date' ;
    rdfs:comment 'Most recent date of historical data included in the model training dataset. Defines the upper bound of the training window. Used to assess data freshness and staleness risk.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trainingStartDate rdf:type rdf:Property ;
    rdfs:label 'Training Start Date' ;
    rdfs:comment 'Earliest date of historical data included in the model training dataset. Defines the lower bound of the training window used to fit the forecasting algorithm.' ;
    rdfs:domain ind:ForecastModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastOutputId rdf:type rdf:Property ;
    rdfs:label 'Forecast Output Id' ;
    rdfs:comment 'Unique surrogate identifier for each forecast output record produced by a deployed forecasting model. Primary key for the forecast_output table in the analytics Silver layer.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ForecastOutput .

ind:budgetId rdf:type rdf:Property ;
    rdfs:label 'Budget Id' ;
    rdfs:comment 'Foreign key linking to finance.budget. Business justification: Forecast outputs are compared against approved budgets in the standard FP&A budget vs. forecast vs. actuals (BFA) reporting cycle. Sports entertainment finance teams require direct linkage between for' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Budget .

ind:collectionId rdf:type rdf:Property ;
    rdfs:label 'Collection Id' ;
    rdfs:comment 'Foreign key linking to content.collection. Business justification: Collection-level OTT revenue forecasting: curated content collections (playoff packages, season archives) are forecast as commercial units for PPV and subscription pricing. Linking forecast_output to ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Collection .

ind:kpiDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Kpi Definition Id' ;
    rdfs:comment 'Reference to the KPI definition record that identifies the business metric being forecasted (e.g., ticket revenue, attendance, viewership, merchandise units). Aligns forecast outputs to the enterprise KPI framework.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:KpiDefinition .

ind:loyaltyProgramId rdf:type rdf:Property ;
    rdfs:label 'Loyalty Program Id' ;
    rdfs:comment 'Foreign key linking to fan.loyalty_program. Business justification: Loyalty program liability and redemption forecasting is a core finance process in sports entertainment. Forecast outputs for points liability, enrollment growth, and redemption rates must reference th' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LoyaltyProgram .

ind:matchResultId rdf:type rdf:Property ;
    rdfs:label 'Match Result Id' ;
    rdfs:comment 'Foreign key linking to event.match_result. Business justification: Forecast vs. actuals variance reporting uses the confirmed match_result as the authoritative actuals source for attendance and scores. This link enables automated actuals loading into forecast_output ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MatchResult .

ind:matterId rdf:type rdf:Property ;
    rdfs:label 'Matter Id' ;
    rdfs:comment 'Foreign key linking to legal.legal_matter. Business justification: Litigation reserve forecasting: Finance and legal teams produce matter-level forecasts of litigation reserves and legal spend. Linking forecast_output to legal_matter enables reserve adequacy reportin' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Matter .

ind:priceTierId rdf:type rdf:Property ;
    rdfs:label 'Price Tier Id' ;
    rdfs:comment 'Foreign key linking to ticketing.price_tier. Business justification: Price-tier-level revenue forecasting is a named ticketing analytics process — forecasting sell-through and revenue by premium vs. general admission tiers. A pricing analyst running tier-level forecast' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PriceTier .

ind:profitCenterId rdf:type rdf:Property ;
    rdfs:label 'Profit Center Id' ;
    rdfs:comment 'Foreign key linking to finance.profit_center. Business justification: Forecast outputs for segment-level financial metrics (league P&L, venue revenue) must be linked to profit centers for segment reporting. Sports entertainment organizations report forecast vs. actuals ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProfitCenter .

ind:retailLocationId rdf:type rdf:Property ;
    rdfs:label 'Retail Location Id' ;
    rdfs:comment 'Foreign key linking to merchandise.retail_location. Business justification: Location-level merchandise demand forecasting drives store-level inventory planning for stadium shops and retail outlets. Sports-entertainment merchandising teams forecast sales per retail location fo' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RetailLocation .

ind:skuCatalogId rdf:type rdf:Property ;
    rdfs:label 'Sku Catalog Id' ;
    rdfs:comment 'Foreign key linking to merchandise.sku_catalog. Business justification: SKU-level merchandise demand forecasting is a core inventory planning process in sports-entertainment. Merchandising analysts forecast sales by SKU for event-day stock replenishment and seasonal plann' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SkuCatalog .

ind:actualValue rdf:type rdf:Property ;
    rdfs:label 'Actual Value' ;
    rdfs:comment 'The observed actual value of the business metric for the forecast period, populated once the period has closed and actuals are available from source systems (e.g., SAP S/4HANA, Ticketmaster). Null until actuals are loaded. Enables forecast vs. actual variance tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualsLoadedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actuals Loaded Timestamp' ;
    rdfs:comment 'The date and time when the actual realized value was loaded into this forecast output record from the source system of record. Null until actuals are available. Used to track the latency between period close and variance availability for FP&A reporting.' ;
    rdfs:domain ind:ForecastOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualsSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Actuals Source System' ;
    rdfs:comment 'Name of the operational system of record from which the actual realized value was sourced (e.g., \'SAP S/4HANA\', \'Ticketmaster\', \'Shopify Plus\', \'Adobe Experience Platform\'). Supports data lineage and audit traceability for variance analysis.' ;
    rdfs:domain ind:ForecastOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:algorithmType rdf:type rdf:Property ;
    rdfs:label 'Algorithm Type' ;
    rdfs:comment 'The statistical or machine learning algorithm used by the model to generate this forecast output (e.g., \'ARIMA\', \'Prophet\', \'XGBoost\', \'Linear Regression\', \'LSTM\'). Supports model transparency, governance review, and algorithm performance benchmarking. [ENUM-REF-CANDIDATE: ARIMA|Prophet|XGBoost|Linear_Regression|LSTM|Random_Forest|Exponential_Smoothing|Ensemble — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approval Timestamp' ;
    rdfs:comment 'The date and time when this forecast output was formally approved by the authorized business owner. Null until approval is granted. Supports SOX audit trail and forecast governance documentation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:forecastOutputStatus rdf:type rdf:Property ;
    rdfs:label 'Forecast Output Status' ;
    rdfs:comment 'Current lifecycle state of this forecast output record. \'draft\' indicates preliminary output not yet approved; \'published\' indicates approved and distributed to consumers; \'superseded\' indicates replaced by a newer run; \'archived\' indicates retained for historical reference; \'under_review\' indicates pending validation.' ;
    rdfs:domain ind:ForecastOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Period End Date' ;
    rdfs:comment 'The last calendar date of the time period covered by this forecast output. Defines the upper boundary of the forecast window. Must be greater than or equal to forecast_period_start_date.' ;
    rdfs:domain ind:ForecastOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Period Start Date' ;
    rdfs:comment 'The first calendar date of the time period covered by this forecast output. Combined with forecast_period_end_date, defines the exact window for which the point forecast and confidence intervals apply.' ;
    rdfs:domain ind:ForecastOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastRunCode rdf:type rdf:Property ;
    rdfs:label 'Forecast Run Code' ;
    rdfs:comment 'Human-readable business identifier for the forecast run that produced this output (e.g., FCR-2024Q3-TICK-001). Used by FP&A and commercial teams to reference specific forecast cycles in reports and communications.' ;
    rdfs:domain ind:ForecastOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastScenarioLabel rdf:type rdf:Property ;
    rdfs:label 'Forecast Scenario Label' ;
    rdfs:comment 'Descriptive label for the planning scenario under which this forecast was produced (e.g., \'Base Case\', \'Optimistic\', \'Pessimistic\', \'COVID-Impact\', \'Stadium-Expansion\'). Populated primarily for scenario-type forecasts to distinguish multiple concurrent scenario runs.' ;
    rdfs:domain ind:ForecastOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isActualsAvailable rdf:type rdf:Property ;
    rdfs:label 'Is Actuals Available' ;
    rdfs:comment 'Boolean flag indicating whether the actual realized value has been loaded for this forecast output record. True when actual_value is populated; False when the forecast period has not yet closed or actuals have not yet been ingested.' ;
    rdfs:domain ind:ForecastOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isApproved rdf:type rdf:Property ;
    rdfs:label 'Is Approved' ;
    rdfs:comment 'Boolean flag indicating whether this forecast output has been reviewed and approved by an authorized business owner (e.g., FP&A lead, VP of Finance). Approved forecasts are eligible for distribution to executive dashboards and external reporting.' ;
    rdfs:domain ind:ForecastOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lowerConfidenceInterval rdf:type rdf:Property ;
    rdfs:label 'Lower Confidence Interval' ;
    rdfs:comment 'The lower bound of the statistical confidence interval around the point forecast. Represents the pessimistic scenario boundary at the specified confidence level (e.g., 80% or 95%). Used by FP&A for downside risk planning.' ;
    rdfs:domain ind:ForecastOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementUnit rdf:type rdf:Property ;
    rdfs:label 'Measurement Unit' ;
    rdfs:comment 'The unit of measure in which the forecast values (point forecast, confidence intervals, actuals) are expressed (e.g., \'USD\', \'GBP\', \'headcount\', \'thousands_viewers\', \'units\'). Critical for correct interpretation and aggregation of forecast outputs across different metric types.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricCategory rdf:type rdf:Property ;
    rdfs:label 'Metric Category' ;
    rdfs:comment 'High-level classification of the forecasted business metric. Supports cross-domain aggregation and dashboard filtering across FP&A, venue operations, and commercial teams. [ENUM-REF-CANDIDATE: revenue|attendance|viewership|merchandise|sponsorship|digital_engagement|broadcast|concessions — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricName rdf:type rdf:Property ;
    rdfs:label 'Metric Name' ;
    rdfs:comment 'Human-readable name of the business metric being forecasted (e.g., \'Ticket Revenue\', \'Event Attendance\', \'Viewership\', \'Merchandise Units Sold\'). Denormalized from the KPI definition for direct consumption by reporting tools without requiring a join.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointForecastValue rdf:type rdf:Property ;
    rdfs:label 'Point Forecast Value' ;
    rdfs:comment 'The central (best-estimate) forecast value for the business metric over the defined forecast period. Represents the model\'s single-point prediction (e.g., expected ticket revenue in USD, expected attendance headcount, expected viewership in thousands).' ;
    rdfs:domain ind:ForecastOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:upperConfidenceInterval rdf:type rdf:Property ;
    rdfs:label 'Upper Confidence Interval' ;
    rdfs:comment 'The upper bound of the statistical confidence interval around the point forecast. Represents the optimistic scenario boundary at the specified confidence level. Used by commercial teams for upside opportunity planning.' ;
    rdfs:domain ind:ForecastOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variancePct rdf:type rdf:Property ;
    rdfs:label 'Variance Pct' ;
    rdfs:comment 'Percentage difference between the actual realized value and the point forecast value, calculated as (actual_value - point_forecast_value) / point_forecast_value * 100. Populated once actuals are available. Used by FP&A for KPI reporting and model performance benchmarking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceValue rdf:type rdf:Property ;
    rdfs:label 'Variance Value' ;
    rdfs:comment 'Absolute difference between the actual realized value and the point forecast value (actual_value minus point_forecast_value). Populated once actuals are available. Positive values indicate the actuals exceeded the forecast; negative values indicate underperformance. Used for model accuracy assessment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insightRequestId rdf:type rdf:Property ;
    rdfs:label 'Insight Request Id' ;
    rdfs:comment 'Unique system-generated identifier for each analytics insight request submitted within Sports Entertainment. Serves as the primary key for this record.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:afterActionReportId rdf:type rdf:Property ;
    rdfs:label 'After Action Report Id' ;
    rdfs:comment 'Foreign key linking to security.after_action_report. Business justification: Post-Event Security Analytics process: analytics insight requests are routinely triggered by security after-action reports (e.g., crowd density pattern analysis, screening throughput optimization). Li' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AfterActionReport .

ind:requestorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Requestor Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Insight requests in sports entertainment are submitted by named employees (scouts, analysts, marketing leads). Linking requestor to employee enables SLA tracking by department, analytics demand report' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:requestorOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Requestor Org Unit Id' ;
    rdfs:comment 'Foreign key linking to workforce.org_unit. Business justification: Insight request demand analysis by org unit — linking requestor\'s org unit enables analytics team capacity planning, chargeback/budget allocation for analytics services, and demand forecasting by depa' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:actualDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Actual Delivery Date' ;
    rdfs:comment 'The date on which the completed insight deliverable was actually delivered to the requestor. Used to measure SLA adherence and analyst performance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualEffortHours rdf:type rdf:Property ;
    rdfs:label 'Actual Effort Hours' ;
    rdfs:comment 'Actual number of hours logged by the analyst(s) to complete the insight request. Compared against estimated effort for capacity model calibration.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalRequired rdf:type rdf:Property ;
    rdfs:label 'Approval Required' ;
    rdfs:comment 'Indicates whether the insight request requires formal sign-off from a senior stakeholder or data governance committee before work commences. Applies to requests involving restricted data or significant resource commitment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignedAnalystName rdf:type rdf:Property ;
    rdfs:label 'Assigned Analyst Name' ;
    rdfs:comment 'Full name of the data analyst or data scientist assigned to fulfill the insight request. Supports workload balancing and performance tracking.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedAnalystTeam rdf:type rdf:Property ;
    rdfs:label 'Assigned Analyst Team' ;
    rdfs:comment 'The analytics team or squad responsible for delivering the request (e.g., Fan Analytics, Revenue Analytics, Performance Science, Broadcast Intelligence). Enables team-level capacity reporting.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationReason rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason' ;
    rdfs:comment 'Free-text explanation of why the insight request was cancelled. Populated only when request_status is \'cancelled\'. Supports demand pattern analysis and process improvement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committedDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Committed Delivery Date' ;
    rdfs:comment 'The delivery date formally committed by the analytics team after scoping. May differ from the requested delivery date if the original timeline was not feasible.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:confidentialityLevel rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Level' ;
    rdfs:comment 'Data classification level assigned to the insight request and its deliverable output. Governs access controls, distribution restrictions, and retention policies per GDPR, CCPA, and internal data governance policy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:containsPii rdf:type rdf:Property ;
    rdfs:label 'Contains Pii' ;
    rdfs:comment 'Indicates whether the insight request or its deliverable involves or exposes personally identifiable information about fans, athletes, or employees. Triggers mandatory GDPR/CCPA compliance review.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSourcesRequired rdf:type rdf:Property ;
    rdfs:label 'Data Sources Required' ;
    rdfs:comment 'Free-text or comma-delimited list of data sources, systems, or domains required to fulfill the request (e.g., Ticketmaster, Salesforce CRM, Adobe Experience Platform, SAP S/4HANA). Informs data access and pipeline preparation.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliverableLocation rdf:type rdf:Property ;
    rdfs:label 'Deliverable Location' ;
    rdfs:comment 'URL, file path, or system reference (e.g., Databricks dashboard link, SharePoint path, Adobe Experience Platform segment ID) where the completed insight deliverable is stored and accessible.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionList rdf:type rdf:Property ;
    rdfs:label 'Distribution List' ;
    rdfs:comment 'Comma-delimited list of names or email addresses of stakeholders authorized to receive the completed insight deliverable. Enforces need-to-know access controls.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedEffortHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Effort Hours' ;
    rdfs:comment 'Analyst-estimated number of hours required to complete the insight request. Used for capacity planning and resource allocation across the analytics team.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:kpiFocusArea rdf:type rdf:Property ;
    rdfs:label 'Kpi Focus Area' ;
    rdfs:comment 'The primary KPI or metric category the insight request is intended to inform (e.g., NPS, ARPU, attendance rate, broadcast ratings, sponsorship ROI, merchandise revenue). Aligns requests to executive KPI dashboards.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outputFormat rdf:type rdf:Property ;
    rdfs:label 'Output Format' ;
    rdfs:comment 'Specifies the expected deliverable format for the completed insight request. Determines the production workflow and tooling required by the assigned analyst.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:piaRequired rdf:type rdf:Property ;
    rdfs:label 'Pia Required' ;
    rdfs:comment 'Indicates whether a Privacy Impact Assessment is required before the insight request can be fulfilled, based on the sensitivity of data involved. Aligns with GDPR Article 35 Data Protection Impact Assessment obligations.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorityLevel rdf:type rdf:Property ;
    rdfs:label 'Priority Level' ;
    rdfs:comment 'Business-assigned urgency classification for the insight request. Drives analyst queue prioritization and SLA commitment selection.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrenceEndDate rdf:type rdf:Property ;
    rdfs:label 'Recurrence End Date' ;
    rdfs:comment 'The date on which a recurring insight request series is scheduled to terminate. Null for open-ended recurring requests or one-time requests.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recurrenceFrequency rdf:type rdf:Property ;
    rdfs:label 'Recurrence Frequency' ;
    rdfs:comment 'For recurring insight requests, specifies how often the deliverable is to be refreshed and redistributed. Null or \'one_time\' for ad-hoc requests.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestDescription rdf:type rdf:Property ;
    rdfs:label 'Request Description' ;
    rdfs:comment 'Detailed narrative describing the business question, analytical objective, and scope of the insight request. Captures the full context provided by the requesting stakeholder.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestNumber rdf:type rdf:Property ;
    rdfs:label 'Request Number' ;
    rdfs:comment 'Externally-visible, human-readable business identifier for the insight request (e.g., IR-2024-000123). Used in stakeholder communications, SLA tracking, and audit trails.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestStatus rdf:type rdf:Property ;
    rdfs:label 'Request Status' ;
    rdfs:comment 'Current workflow lifecycle state of the insight request. Tracks progression from initial submission through delivery or cancellation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestTitle rdf:type rdf:Property ;
    rdfs:label 'Request Title' ;
    rdfs:comment 'Short, descriptive title summarizing the analytical request (e.g., \'Pre-Event Fan Behavior Brief – Super Bowl LX\'). Used in dashboards and request queues.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestType rdf:type rdf:Property ;
    rdfs:label 'Request Type' ;
    rdfs:comment 'Indicates whether the request is a one-time ad-hoc analysis, a recurring periodic deliverable, or a pre-scheduled standing report.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Requested Delivery Date' ;
    rdfs:comment 'The date by which the requestor requires the completed insight deliverable. Used to set SLA targets and prioritize analyst workload.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestorFeedback rdf:type rdf:Property ;
    rdfs:label 'Requestor Feedback' ;
    rdfs:comment 'Free-text qualitative feedback provided by the requestor upon delivery of the insight. Captures commentary on quality, relevance, and actionability of the output.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorSatisfactionScore rdf:type rdf:Property ;
    rdfs:label 'Requestor Satisfaction Score' ;
    rdfs:comment 'Post-delivery satisfaction rating provided by the requestor on a 1–5 scale. Feeds into analytics team NPS and service quality KPI reporting.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaMet rdf:type rdf:Property ;
    rdfs:label 'Sla Met' ;
    rdfs:comment 'Indicates whether the insight request was delivered on or before the committed delivery date, satisfying the applicable SLA. Drives analytics team KPI reporting.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:submittedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Submitted Timestamp' ;
    rdfs:comment 'Date and time when the insight request was formally submitted by the business stakeholder. Serves as the start point for SLA measurement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:toolPlatform rdf:type rdf:Property ;
    rdfs:label 'Tool Platform' ;
    rdfs:comment 'The analytics tool or platform used to produce the deliverable (e.g., Databricks, Adobe Experience Platform, Tableau, Power BI, Python, SportsCode/Hudl). Supports tooling governance and license utilization tracking.' ;
    rdfs:domain ind:InsightRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataStewardEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Data Steward Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: KPI governance in sports entertainment requires a named data steward employee responsible for KPI accuracy, threshold reviews, and regulatory compliance (e.g., league-mandated KPIs). Enables stewardsh' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supersededByKpiKpiDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Kpi Kpi Definition Id' ;
    rdfs:comment 'Reference to the kpi_definition_id of the newer KPI definition that replaces this one when a KPI is deprecated or retired. Null if this KPI has not been superseded. Enables forward navigation of KPI version history.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:KpiDefinition .

ind:aggregationMethod rdf:type rdf:Property ;
    rdfs:label 'Aggregation Method' ;
    rdfs:comment 'The mathematical aggregation method used when rolling up this KPI across time periods or organizational hierarchies (e.g., Sum for revenue KPIs, Average for rate/percentage KPIs, Count for volume KPIs, Ratio for efficiency KPIs, Index for composite scores). Critical for correct dashboard aggregation. [ENUM-REF-CANDIDATE: Sum|Average|Count|Ratio|Index|Maximum|Minimum — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkSource rdf:type rdf:Property ;
    rdfs:label 'Benchmark Source' ;
    rdfs:comment 'The external or internal source used to establish the KPI\'s target threshold and benchmark values (e.g., \'NFL League Average\', \'FIFA Industry Benchmark\', \'Internal Historical Baseline\', \'Nielsen Sports Audience Measurement\', \'Deloitte Sports Industry Report\'). Provides context for how targets were set.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessUnitOwner rdf:type rdf:Property ;
    rdfs:label 'Business Unit Owner' ;
    rdfs:comment 'Name of the Sports Entertainment business unit or department that owns and is accountable for this KPI definition, its target thresholds, and its governance approval (e.g., \'Ticketing & Revenue Management\', \'Broadcast & Media Rights\', \'Fan Engagement & Experience\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationMethodology rdf:type rdf:Property ;
    rdfs:label 'Calculation Methodology' ;
    rdfs:comment 'Detailed narrative description of how this KPI is calculated, including the formula, numerator, denominator, inclusion/exclusion rules, and any business logic applied. This is the authoritative definition of measurement — not the computed value itself. Example: \'Total net ticket revenue divided by the number of ticketed events in the reporting period, excluding complimentary tickets and internal allocations.\'' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalThreshold rdf:type rdf:Property ;
    rdfs:label 'Critical Threshold' ;
    rdfs:comment 'The numeric floor value below which KPI performance is classified as critical, requiring immediate executive escalation and remediation action. Expressed in the KPI\'s unit_of_measure. Distinct from warning_threshold which is a softer alert level.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dashboardDisplayOrder rdf:type rdf:Property ;
    rdfs:label 'Dashboard Display Order' ;
    rdfs:comment 'Numeric sequence value controlling the display order of this KPI within its business domain section on the executive KPI dashboard. Lower values appear first. Enables business stakeholders to prioritize the most critical KPIs at the top of their domain view.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataRefreshLagHours rdf:type rdf:Property ;
    rdfs:label 'Data Refresh Lag Hours' ;
    rdfs:comment 'The expected maximum number of hours between the real-world business event occurring and the KPI value being updated in the analytics layer. Defines the data freshness Service Level Agreement (SLA) for this KPI. For example, a real-time broadcast audience KPI may have a lag of 1 hour, while a monthly financial KPI may have a lag of 48 hours.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataSourceDomain rdf:type rdf:Property ;
    rdfs:label 'Data Source Domain' ;
    rdfs:comment 'The primary operational system or data domain from which the raw data feeding this KPI is sourced (e.g., \'Ticketmaster/AXS\', \'Adobe Experience Platform\', \'Salesforce CRM\', \'Dalet Galaxy\', \'SAP S/4HANA FI\', \'Shopify Plus\'). Used for data lineage tracking and pipeline dependency management.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governanceApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Governance Approval Status' ;
    rdfs:comment 'Current lifecycle state of the KPI definition within the Sports Entertainment data governance process. Only \'Approved\' KPIs may be used in official executive reporting and regulatory submissions. \'Draft\' and \'Pending Review\' KPIs are in development. \'Deprecated\' KPIs have been superseded. \'Retired\' KPIs are no longer in use.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRegulatoryKpi rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Kpi' ;
    rdfs:comment 'Indicates whether this KPI is required for regulatory reporting or compliance submissions (e.g., SEC financial disclosures, FCC broadcast compliance, GDPR data processing metrics, PCI-DSS security metrics). True = regulatory obligation; False = internal management KPI only.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kpiCategory rdf:type rdf:Property ;
    rdfs:label 'Kpi Category' ;
    rdfs:comment 'High-level classification of the KPI by its measurement perspective. Financial KPIs measure monetary outcomes (e.g., EBITDA, ARR). Operational KPIs measure process efficiency. Customer KPIs measure fan/sponsor experience (e.g., NPS, ARPU). People KPIs measure workforce metrics. Compliance KPIs measure regulatory adherence. Strategic KPIs measure long-term objectives.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kpiCode rdf:type rdf:Property ;
    rdfs:label 'Kpi Code' ;
    rdfs:comment 'Externally-known, human-readable unique code assigned to the KPI (e.g., KPI-TKT-0001 for Ticketing Revenue per Event). Used as the business identifier across dashboards, reports, and governance documentation. Follows the pattern KPI-<DOMAIN>-<SEQUENCE>.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kpiDescription rdf:type rdf:Property ;
    rdfs:label 'Kpi Description' ;
    rdfs:comment 'Plain-language business description of what this KPI measures, why it matters to Sports Entertainment, and how it supports strategic decision-making. Intended for business users, executives, and new team members who need to understand the KPI\'s purpose without technical detail.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kpiName rdf:type rdf:Property ;
    rdfs:label 'Kpi Name' ;
    rdfs:comment 'Full descriptive name of the KPI as recognized by business stakeholders (e.g., \'Broadcast Audience Share\', \'Fan Engagement Rate\', \'Sponsorship Return on Investment (ROI)\'). This is the primary human-readable label used in executive dashboards and KPI catalogs.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kpiOwnerEmail rdf:type rdf:Property ;
    rdfs:label 'Kpi Owner Email' ;
    rdfs:comment 'Business email address of the KPI owner or primary point of contact within the owning business unit. Used for governance notifications, approval workflows, and escalation communications. Classified as confidential as it is an internal business contact.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kpiShortName rdf:type rdf:Property ;
    rdfs:label 'Kpi Short Name' ;
    rdfs:comment 'Abbreviated or shortened display name for the KPI used in space-constrained UI elements such as dashboard tiles, report column headers, and mobile views (e.g., \'Audience Share\', \'Fan Eng. Rate\').' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kpiType rdf:type rdf:Property ;
    rdfs:label 'Kpi Type' ;
    rdfs:comment 'Indicates whether the KPI is a leading indicator (predictive, forward-looking, e.g., ticket pre-sales velocity), a lagging indicator (outcome-based, historical, e.g., season revenue), or a diagnostic indicator (explains why a result occurred, e.g., broadcast churn rate).' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:polarity rdf:type rdf:Property ;
    rdfs:label 'Polarity' ;
    rdfs:comment 'Indicates the business sentiment of the KPI value direction. Positive polarity means an increase in value is favorable (e.g., fan engagement rate, ticket revenue). Negative polarity means an increase is unfavorable (e.g., athlete injury rate, broadcast churn rate). Neutral applies to informational KPIs without a directional preference.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryBody rdf:type rdf:Property ;
    rdfs:label 'Regulatory Body' ;
    rdfs:comment 'Name of the governing or regulatory body that mandates this KPI for compliance reporting, if applicable (e.g., \'SEC\', \'FCC\', \'GDPR\', \'WADA\', \'FIFA\', \'NFL\', \'NBA\'). Null if is_regulatory_kpi is False. Supports compliance tracking and regulatory filing management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedKpiCodes rdf:type rdf:Property ;
    rdfs:label 'Related Kpi Codes' ;
    rdfs:comment 'Comma-separated list of KPI codes that are logically related to this KPI (e.g., complementary KPIs, component KPIs that feed into a composite index, or KPIs that should be analyzed together). For example, \'Broadcast Audience Share\' may be related to \'CPM Revenue\' and \'OTT Subscriber Growth\'. Supports KPI navigation in the catalog.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingFrequency rdf:type rdf:Property ;
    rdfs:label 'Reporting Frequency' ;
    rdfs:comment 'How often this KPI is measured, computed, and reported to stakeholders. Drives scheduling of data pipelines and dashboard refresh cycles. \'Per Event\' applies to event-specific KPIs such as ticketing revenue per event or broadcast audience share per broadcast. [ENUM-REF-CANDIDATE: Daily|Weekly|Monthly|Quarterly|Annually|Per Event|Real-Time — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingLevel rdf:type rdf:Property ;
    rdfs:label 'Reporting Level' ;
    rdfs:comment 'The organizational level at which this KPI is primarily reported and consumed. Executive KPIs appear in C-suite and board dashboards. Business Unit KPIs are reported to division heads. Operational KPIs are used by managers. Team KPIs are used at the working level.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strategicObjective rdf:type rdf:Property ;
    rdfs:label 'Strategic Objective' ;
    rdfs:comment 'The high-level Sports Entertainment strategic objective or pillar that this KPI supports (e.g., \'Maximize Fan Lifetime Value (LTV)\', \'Grow Broadcast Audience Share\', \'Optimize Venue Revenue per Seat\', \'Increase Sponsorship Return on Investment (ROI)\'). Links KPI measurement to corporate strategy.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetThreshold rdf:type rdf:Property ;
    rdfs:label 'Target Threshold' ;
    rdfs:comment 'The numeric target or benchmark value that the KPI should meet or exceed to be considered on-track. Expressed in the KPI\'s unit_of_measure. For example, a fan engagement rate target of 35.00 (%) or a sponsorship ROI target of 3.50 (ratio). This is the governance-approved performance expectation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdDirection rdf:type rdf:Property ;
    rdfs:label 'Threshold Direction' ;
    rdfs:comment 'Indicates the direction of performance improvement for this KPI. \'Higher Is Better\' applies to revenue, engagement, and audience metrics. \'Lower Is Better\' applies to cost, churn, and incident metrics. \'Target Range\' applies to KPIs with both a floor and ceiling (e.g., athlete body weight index). Drives correct RAG (Red-Amber-Green) status calculation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Unit Of Measure' ;
    rdfs:comment 'The unit in which the KPI value is expressed (e.g., \'USD\', \'Percentage (%)\', \'Count\', \'Index Score\', \'Rating Points\', \'Minutes\', \'Impressions\'). Defines how the KPI value should be interpreted and displayed in reports and dashboards.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionNumber rdf:type rdf:Property ;
    rdfs:label 'Version Number' ;
    rdfs:comment 'Semantic version number of this KPI definition (e.g., \'1.0\', \'2.3\'). Incremented when the calculation methodology, threshold, or unit of measure changes materially. Enables historical comparison of KPI definitions and supports audit trails for governance reviews.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warningThreshold rdf:type rdf:Property ;
    rdfs:label 'Warning Threshold' ;
    rdfs:comment 'The numeric value at which the KPI triggers a warning alert, indicating performance is approaching but has not yet breached the minimum acceptable level. Enables proactive management before a KPI falls below the critical threshold. Expressed in the KPI\'s unit_of_measure.' ;
    rdfs:domain ind:KpiDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:kpiTargetId rdf:type rdf:Property ;
    rdfs:label 'Kpi Target Id' ;
    rdfs:comment 'Unique surrogate identifier for each KPI target record in the analytics domain. Primary key for the kpi_target data product.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:athleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Athlete Profile Id' ;
    rdfs:comment 'Foreign key linking to athlete.athlete_profile. Business justification: Athlete performance incentive management: KPI targets are set at athlete level to govern contract performance bonus triggers and cap accounting. Sports analytics and finance teams need athlete-scoped ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:fiscalPeriodId rdf:type rdf:Property ;
    rdfs:label 'Fiscal Period Id' ;
    rdfs:comment 'Reference to the fiscal period (quarter, half-year, or full fiscal year) to which this KPI target applies. Aligns with the financial planning calendar in Workday Adaptive Planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FiscalPeriod .

ind:regulatoryLicenseId rdf:type rdf:Property ;
    rdfs:label 'Regulatory License Id' ;
    rdfs:comment 'Foreign key linking to legal.regulatory_license. Business justification: License condition target-setting: KPI targets are set to meet specific regulatory license thresholds (e.g., broadcast license audience reach minimums, wagering license responsible gambling KPI targets' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryLicense .

ind:benchmarkValue rdf:type rdf:Property ;
    rdfs:label 'Benchmark Value' ;
    rdfs:comment 'The specific numeric value from the external benchmark source that informed the target setting. Enables traceability between the set target and the market reference point. Null when target_basis is not \'market_benchmark\'.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isBoardApproved rdf:type rdf:Property ;
    rdfs:label 'Is Board Approved' ;
    rdfs:comment 'Indicates whether this KPI target was formally approved at board level (True) or only at executive/management level (False). Relevant for SOX-controlled financial KPIs and public company reporting obligations.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPublicCommitment rdf:type rdf:Property ;
    rdfs:label 'Is Public Commitment' ;
    rdfs:comment 'Indicates whether this KPI target has been disclosed publicly (e.g., in investor relations materials, earnings calls, or league governance filings). True = publicly committed; False = internal only. Drives data access controls and disclosure management.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRevised rdf:type rdf:Property ;
    rdfs:label 'Is Revised' ;
    rdfs:comment 'Indicates whether this KPI target record has been revised from its original approved value. True = at least one revision has occurred; False = original target unchanged. Enables quick filtering of revised vs. original targets in variance analysis.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Minimum Threshold Value' ;
    rdfs:comment 'The floor value below which performance is considered unacceptable and triggers escalation or corrective action. Used in KPI dashboard alerting and executive reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorTargetValue rdf:type rdf:Property ;
    rdfs:label 'Prior Target Value' ;
    rdfs:comment 'The target value from the immediately preceding revision, retained for audit and trend analysis. Enables comparison between the current approved target and the previously approved target without querying history tables.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorYearActualValue rdf:type rdf:Property ;
    rdfs:label 'Prior Year Actual Value' ;
    rdfs:comment 'The actual achieved value for this KPI in the equivalent prior-year period, captured at target-setting time as the baseline reference. Used when target_basis = \'prior_year_actuals\'. Stored here to preserve the planning-time baseline even if source actuals are later restated.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisionNumber rdf:type rdf:Property ;
    rdfs:label 'Revision Number' ;
    rdfs:comment 'Sequential integer indicating how many times this KPI target has been revised since initial approval. Version 0 = original; increments with each approved revision. Supports target revision history tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revisionReason rdf:type rdf:Property ;
    rdfs:label 'Revision Reason' ;
    rdfs:comment 'Free-text explanation for why the KPI target was revised (e.g., \'Mid-season broadcast rights renegotiation\', \'COVID-19 event cancellation impact\', \'Board mandate following Q1 underperformance\'). Populated only when is_revised = True.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stretchTargetValue rdf:type rdf:Property ;
    rdfs:label 'Stretch Target Value' ;
    rdfs:comment 'Aspirational above-plan target value representing best-case performance. Used in executive incentive compensation and bonus calculations. Typically 10-20% above the committed target_value.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetBasis rdf:type rdf:Property ;
    rdfs:label 'Target Basis' ;
    rdfs:comment 'Methodology or rationale used to derive the target value. \'prior_year_actuals\' = based on last year\'s performance; \'board_mandate\' = top-down directive from board; \'market_benchmark\' = benchmarked against industry peers (e.g., NFL, NBA league averages); \'zero_based\' = built from zero; \'negotiated\' = agreed between BU and finance; \'statistical_model\' = derived from predictive analytics pipeline.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCode rdf:type rdf:Property ;
    rdfs:label 'Target Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for this KPI target record, used in planning documents, board presentations, and cross-system references. Format: KT- followed by 4-12 uppercase alphanumeric characters.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDirection rdf:type rdf:Property ;
    rdfs:label 'Target Direction' ;
    rdfs:comment 'Indicates whether higher or lower values represent better performance. \'maximize\' = higher is better (e.g., revenue, NPS, viewership); \'minimize\' = lower is better (e.g., CAC, injury rate, churn); \'maintain\' = value should stay within a defined band (e.g., compliance rate).' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Target Period End Date' ;
    rdfs:comment 'The calendar date on which the KPI target period ends. Defines the close boundary for variance analysis. May align with fiscal year-end, season end, or event date.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Target Period Start Date' ;
    rdfs:comment 'The calendar date on which the KPI target period begins. Defines the start boundary for variance analysis between actuals and this plan.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetSettingDate rdf:type rdf:Property ;
    rdfs:label 'Target Setting Date' ;
    rdfs:comment 'The business date on which this KPI target was formally established and recorded. Distinct from the system audit timestamp; represents the business event of target-setting.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetStatus rdf:type rdf:Property ;
    rdfs:label 'Target Status' ;
    rdfs:comment 'Current lifecycle state of this KPI target record. \'draft\' = under construction; \'pending_approval\' = submitted for sign-off; \'approved\' = formally approved but period not yet started; \'active\' = current operative target; \'superseded\' = replaced by a revised target; \'cancelled\' = withdrawn.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetType rdf:type rdf:Property ;
    rdfs:label 'Target Type' ;
    rdfs:comment 'Broad classification of the KPI target by business function. \'financial\' = revenue, EBITDA, ARR, ARPU; \'operational\' = venue utilization, broadcast uptime; \'fan_engagement\' = NPS, LTV, CAC; \'compliance\' = regulatory adherence rates; \'sustainability\' = ISO 20121 metrics; \'workforce\' = headcount, retention.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetValue rdf:type rdf:Property ;
    rdfs:label 'Target Value' ;
    rdfs:comment 'The planned or committed target value for the KPI for the specified business unit and period. This is the primary performance expectation against which actuals will be compared in variance analysis. No actuals are stored here.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceTolerancePct rdf:type rdf:Property ;
    rdfs:label 'Variance Tolerance Pct' ;
    rdfs:comment 'Acceptable percentage deviation from the target_value before the KPI is flagged as off-track in dashboards and reports. Expressed as a decimal (e.g., 0.05 = 5% tolerance). Enables nuanced variance analysis without false alerts.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:initiatedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Initiated By User Employee Id' ;
    rdfs:comment 'Reference to the data science engineer or system service account that triggered this model run. Supports accountability and access auditing.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:inputDatasetId rdf:type rdf:Property ;
    rdfs:label 'Input Dataset Id' ;
    rdfs:comment 'Reference to the versioned input dataset snapshot used as the scoring or training input for this model run. Enables data lineage and reproducibility auditing.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Dataset .

ind:parentRunModelRunId rdf:type rdf:Property ;
    rdfs:label 'Parent Run Model Run Id' ;
    rdfs:comment 'Reference to the original model run that this run is retrying or reprocessing. Null for initial executions. Enables lineage tracing across retry chains and backfill sequences.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ModelRun .

ind:pipelineDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Pipeline Pipeline Definition Id' ;
    rdfs:comment 'Reference to the orchestration pipeline or workflow definition that triggered this model run. Enables lineage tracing from pipeline schedule to execution.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PipelineDefinition .

ind:businessUnit rdf:type rdf:Property ;
    rdfs:label 'Business Unit' ;
    rdfs:comment 'The Sports Entertainment business unit that owns or commissioned this model run. Used for cost chargeback, KPI dashboard segmentation, and executive reporting across business divisions. [ENUM-REF-CANDIDATE: fan_engagement|broadcast|ticketing|sponsorship|athlete_management|venue_operations|merchandise|league_governance|content|finance — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:computeClusterReference rdf:type rdf:Property ;
    rdfs:label 'Compute Cluster Reference' ;
    rdfs:comment 'Identifier of the Databricks compute cluster or serverless compute pool used to execute this model run. Enables infrastructure cost attribution and cluster utilization analysis.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:computeNodeType rdf:type rdf:Property ;
    rdfs:label 'Compute Node Type' ;
    rdfs:comment 'Cloud instance or node type used for the model run (e.g., \'Standard_DS3_v2\', \'i3.xlarge\'). Supports infrastructure optimization and cost benchmarking across run configurations.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dbuConsumed rdf:type rdf:Property ;
    rdfs:label 'Dbu Consumed' ;
    rdfs:comment 'Total Databricks Units (DBU) consumed by this model run, representing the compute resource usage. Primary cost driver for ML pipeline cost tracking and chargeback to business units.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environment rdf:type rdf:Property ;
    rdfs:label 'Environment' ;
    rdfs:comment 'The deployment environment in which this model run was executed. Ensures production run metrics are isolated from development and staging test runs in cost and performance reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorCode rdf:type rdf:Property ;
    rdfs:label 'Error Code' ;
    rdfs:comment 'Standardized error code returned when a model run fails or completes partially. Used for automated alerting, incident classification, and root cause analysis. Null for successful runs.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorMessage rdf:type rdf:Property ;
    rdfs:label 'Error Message' ;
    rdfs:comment 'Human-readable error or exception message captured when a model run fails or encounters a partial processing condition. Supports triage and debugging by data science engineers.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCostUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Usd' ;
    rdfs:comment 'Estimated monetary cost in US dollars for this model run based on DBU consumption and cloud infrastructure pricing. Used for ML pipeline cost tracking, budget forecasting, and FinOps reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:featureStoreVersion rdf:type rdf:Property ;
    rdfs:label 'Feature Store Version' ;
    rdfs:comment 'Version identifier of the feature store snapshot consumed by this model run. Ensures reproducibility of model predictions and supports feature drift detection over time.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inputDataSnapshotDate rdf:type rdf:Property ;
    rdfs:label 'Input Data Snapshot Date' ;
    rdfs:comment 'The business date of the input dataset snapshot used for this model run. Distinguishes the data currency from the run execution date, enabling temporal analysis of model predictions.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outputDatasetPath rdf:type rdf:Property ;
    rdfs:label 'Output Dataset Path' ;
    rdfs:comment 'Full path to the output dataset location in the Databricks lakehouse (Delta table path or Unity Catalog table reference) where model scores or predictions were written. Essential for downstream pipeline consumption and lineage auditing.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outputRecordCount rdf:type rdf:Property ;
    rdfs:label 'Output Record Count' ;
    rdfs:comment 'Number of records written to the output dataset location upon run completion. Validated against records_scored to confirm output integrity and detect write failures.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outputSchemaVersion rdf:type rdf:Property ;
    rdfs:label 'Output Schema Version' ;
    rdfs:comment 'Version of the output dataset schema produced by this model run. Tracks schema evolution to prevent downstream pipeline breakage when model outputs change structure.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordsFailed rdf:type rdf:Property ;
    rdfs:label 'Records Failed' ;
    rdfs:comment 'Number of input records that could not be scored due to data quality issues, schema mismatches, or processing errors. Used to assess partial run completeness and trigger data remediation.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordsInput rdf:type rdf:Property ;
    rdfs:label 'Records Input' ;
    rdfs:comment 'Total number of records in the input dataset snapshot submitted to the model for this run. Compared against records_scored to identify data quality drop-off or partial processing.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordsScored rdf:type rdf:Property ;
    rdfs:label 'Records Scored' ;
    rdfs:comment 'Total number of fan, athlete, or event records processed and scored by the model during this run. Key metric for throughput monitoring and cost-per-record analysis.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retryAttemptNumber rdf:type rdf:Property ;
    rdfs:label 'Retry Attempt Number' ;
    rdfs:comment 'Sequential retry attempt number for this run, starting at 0 for the initial execution. Values greater than 0 indicate this is a retry of a previously failed run. Supports retry policy monitoring.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:runDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Run Duration Seconds' ;
    rdfs:comment 'Total elapsed wall-clock time in seconds from run start to run end. Used for SLA compliance tracking, performance benchmarking across model versions, and infrastructure cost estimation.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:runEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Run End Timestamp' ;
    rdfs:comment 'The precise date and time when the model run execution completed, failed, or was cancelled. Null if the run is still in progress.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:runReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Run Reference Code' ;
    rdfs:comment 'Externally visible alphanumeric business identifier for this model run, used in KPI dashboards, audit reports, and cross-system references. Distinct from the surrogate primary key.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Run Start Timestamp' ;
    rdfs:comment 'The precise date and time when the model run execution began. Principal business event timestamp for this transaction. Used for SLA monitoring, scheduling analysis, and cost attribution.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:runStatus rdf:type rdf:Property ;
    rdfs:label 'Run Status' ;
    rdfs:comment 'Current lifecycle status of the model run execution. \'partial\' indicates the run completed but with a subset of records scored due to data quality or resource constraints.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runType rdf:type rdf:Property ;
    rdfs:label 'Run Type' ;
    rdfs:comment 'Indicates how this model run was initiated: scheduled (automated cadence), manual (engineer-initiated), triggered (event-driven pipeline), backfill (historical reprocessing), or rerun (retry of a failed execution).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runtimeVersion rdf:type rdf:Property ;
    rdfs:label 'Runtime Version' ;
    rdfs:comment 'Version of the Databricks Runtime (DBR) or ML Runtime used for this model run (e.g., \'13.3 LTS ML\'). Critical for reproducibility, dependency auditing, and upgrade impact analysis.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleName rdf:type rdf:Property ;
    rdfs:label 'Schedule Name' ;
    rdfs:comment 'Name of the scheduled job or cron definition that triggered this run, if applicable. Null for manually or event-triggered runs. Supports operational monitoring of scheduled ML pipelines.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerSource rdf:type rdf:Property ;
    rdfs:label 'Trigger Source' ;
    rdfs:comment 'The mechanism that initiated this model run: scheduler (cron-based), api (programmatic call), event_stream (real-time trigger), manual (engineer UI action), or upstream_pipeline (dependency-driven).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workerNodeCount rdf:type rdf:Property ;
    rdfs:label 'Worker Node Count' ;
    rdfs:comment 'Number of worker nodes in the compute cluster allocated for this model run. Used alongside DBU consumption for infrastructure scaling analysis and cost optimization.' ;
    rdfs:domain ind:ModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:performanceAnalyticsSnapshotId rdf:type rdf:Property ;
    rdfs:label 'Performance Analytics Snapshot Id' ;
    rdfs:comment 'Unique surrogate identifier for each performance analytics snapshot record in the Silver Layer analytical store. Serves as the primary key for this entity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PerformanceAnalyticsSnapshot .

ind:athleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Athlete Athlete Profile Id' ;
    rdfs:comment 'Reference to the athlete whose performance metrics are captured in this snapshot. Null when the snapshot represents team-level rather than individual-level analytics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:gameResultId rdf:type rdf:Property ;
    rdfs:label 'Game Result Id' ;
    rdfs:comment 'Foreign key linking to league.game_result. Business justification: Post-game performance analytics reporting requires linking athlete/team metric snapshots to certified game results for win/loss correlation analysis, officiating review, and competitive intelligence r' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GameResult .

ind:opponentTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Opponent Team Franchise Id' ;
    rdfs:comment 'Reference to the opposing team in the fixture for which this performance snapshot was computed. Enables opponent-adjusted metric analysis (e.g., DVOA — Defense-adjusted Value Over Average) and strength-of-schedule contextualization.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:performanceStatId rdf:type rdf:Property ;
    rdfs:label 'Performance Stat Id' ;
    rdfs:comment 'The native record identifier from the originating source system (SportsCode, Hudl, Statcast, Opta, etc.) that was used to compute this snapshot. Enables bi-directional traceability between the Silver Layer analytical record and the raw source system event.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PerformanceStat .

ind:pipelineRunId rdf:type rdf:Property ;
    rdfs:label 'Pipeline Run Id' ;
    rdfs:comment 'Identifier of the data science pipeline execution run that produced this snapshot record. Enables batch-level reprocessing, data quality audits, and lineage tracing within the Databricks Lakehouse Silver Layer pipeline.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PipelineRun .

ind:primaryPerformanceFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Primary Performance Franchise Id' ;
    rdfs:comment 'Reference to the team whose aggregate performance metrics are captured in this snapshot. Null when the snapshot represents individual athlete-level analytics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:competitionPhase rdf:type rdf:Property ;
    rdfs:label 'Competition Phase' ;
    rdfs:comment 'The phase of the competitive calendar during which this performance snapshot was recorded — regular season, playoffs, preseason, postseason, finals, or tournament. Enables phase-specific performance benchmarking and trend analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Confidence Level' ;
    rdfs:comment 'Qualitative confidence classification for the metric value based on sample size, data completeness, and source system reliability. \'high\' — statistically robust; \'medium\' — acceptable for most use cases; \'low\' — use with caution; \'insufficient\' — below minimum sample threshold for reliable interpretation.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Data Source System' ;
    rdfs:comment 'The operational system or data provider from which the raw performance data was ingested to compute this metric snapshot. Supports data lineage tracing, source system SLA monitoring, and cross-source reconciliation in the Silver Layer pipeline. [ENUM-REF-CANDIDATE: sportscode|hudl|statcast|second_spectrum|hawk_eye|opta|stats_perform|manual|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fixtureDate rdf:type rdf:Property ;
    rdfs:label 'Fixture Date' ;
    rdfs:comment 'The calendar date on which the game or fixture referenced by this snapshot was played. Null for season-level snapshots. Supports time-series analysis and in-season performance trend tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isHomeFixture rdf:type rdf:Property ;
    rdfs:label 'Is Home Fixture' ;
    rdfs:comment 'Indicates whether the athlete or team was playing at their home venue (True) or as the away side (False) during the fixture referenced by this snapshot. Enables home/away performance differential analysis.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isInjuryAdjusted rdf:type rdf:Property ;
    rdfs:label 'Is Injury Adjusted' ;
    rdfs:comment 'Indicates whether the metric value has been adjusted to account for games missed or reduced performance due to documented injury. Injury-adjusted metrics provide a more accurate baseline for contract valuation, WAR (Wins Above Replacement) projections, and salary cap analysis.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOfficial rdf:type rdf:Property ;
    rdfs:label 'Is Official' ;
    rdfs:comment 'Indicates whether this performance metric snapshot has been certified as official by the governing league body (True) or is a proprietary/third-party computed estimate (False). Official metrics are used for regulatory reporting and CBA compliance; unofficial metrics are used for internal scouting and AI/ML pipelines.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueCode rdf:type rdf:Property ;
    rdfs:label 'League Code' ;
    rdfs:comment 'Standardized code identifying the professional league or governing body under whose competition framework this performance snapshot was generated. Enables cross-league benchmarking and percentile rank contextualization. [ENUM-REF-CANDIDATE: NFL|NBA|MLB|NHL|MLS|FIFA|ATP|UFC|OTHER — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricLeagueAvg rdf:type rdf:Property ;
    rdfs:label 'Metric League Avg' ;
    rdfs:comment 'The league-wide average value of this metric for the same season, position group, and sport discipline at the time of snapshot computation. Provides the baseline reference for interpreting the athlete\'s or team\'s relative performance.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:metricLeagueHigh rdf:type rdf:Property ;
    rdfs:label 'Metric League High' ;
    rdfs:comment 'The highest recorded value of this metric across all athletes or teams in the same league, season, and position group at the time of snapshot computation. Used to contextualize elite performance thresholds in scouting and coaching dashboards.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:metricLeagueLow rdf:type rdf:Property ;
    rdfs:label 'Metric League Low' ;
    rdfs:comment 'The lowest recorded value of this metric across all athletes or teams in the same league, season, and position group at the time of snapshot computation. Supports full distribution analysis and outlier detection in performance intelligence workflows.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:metricPercentileRank rdf:type rdf:Property ;
    rdfs:label 'Metric Percentile Rank' ;
    rdfs:comment 'Percentile rank of the athlete\'s or team\'s metric value relative to all peers within the same league, season, and position group (0.00–100.00). Enables scouting platforms and coaching dashboards to contextualize absolute metric values against the competitive population.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:metricTrendDirection rdf:type rdf:Property ;
    rdfs:label 'Metric Trend Direction' ;
    rdfs:comment 'Directional trend classification for the metric value relative to the athlete\'s or team\'s recent performance trajectory (last 5 games or rolling 28-day window). Supports at-a-glance performance health indicators in coaching staff dashboards and executive KPI (Key Performance Indicator) reporting.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricUnit rdf:type rdf:Property ;
    rdfs:label 'Metric Unit' ;
    rdfs:comment 'Unit of measure for the metric value (e.g., \'wins\', \'points\', \'goals\', \'index\', \'percentage\', \'rating\', \'runs\'). Enables correct interpretation and dimensional analysis of metric values across heterogeneous sport disciplines.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricValue rdf:type rdf:Property ;
    rdfs:label 'Metric Value' ;
    rdfs:comment 'The computed numeric value of the performance metric for the athlete or team in the specified fixture or season period. Precision of 6 decimal places accommodates advanced statistical metrics such as WAR (Wins Above Replacement), xG (Expected Goals), and EPA (Expected Points Added).' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:metricVersion rdf:type rdf:Property ;
    rdfs:label 'Metric Version' ;
    rdfs:comment 'Version identifier of the metric computation algorithm or model used to produce this snapshot value (e.g., v1.0, v2.3). Enables reproducibility, model governance, and impact analysis when metric definitions are updated in the analytics pipeline.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricZScore rdf:type rdf:Property ;
    rdfs:label 'Metric Z Score' ;
    rdfs:comment 'Standardized Z-score of the metric value relative to the league population mean and standard deviation for the same season and position group. Supports AI/ML feature engineering and cross-metric normalization in predictive performance models.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionGroup rdf:type rdf:Property ;
    rdfs:label 'Position Group' ;
    rdfs:comment 'The playing position or positional group of the athlete at the time of this snapshot (e.g., Quarterback, Wide Receiver, Point Guard, Center Forward, Pitcher, Goalkeeper). Percentile ranks and league averages are computed within this position group. [ENUM-REF-CANDIDATE: quarterback|wide_receiver|point_guard|center_forward|pitcher|goalkeeper|defenseman|midfielder — promote to reference product]' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorSeasonMetricValue rdf:type rdf:Property ;
    rdfs:label 'Prior Season Metric Value' ;
    rdfs:comment 'The value of the same metric for the same athlete or team in the immediately preceding competitive season. Stored denormalized in the snapshot to enable year-over-year performance delta computation without requiring a self-join in downstream analytics and coaching dashboards.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:seasonYear rdf:type rdf:Property ;
    rdfs:label 'Season Year' ;
    rdfs:comment 'The calendar year (or starting year for multi-year seasons such as 2024-25) of the competitive season to which this performance snapshot belongs. Enables year-over-year trend analysis without requiring a join to the season reference table.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:snapshotCode rdf:type rdf:Property ;
    rdfs:label 'Snapshot Code' ;
    rdfs:comment 'Externally-known business identifier for this snapshot record, used for cross-system referencing between SportsCode/Hudl, coaching dashboards, and scouting platforms. Format: PAS-{ENTITY_CODE}-{YYYYMMDD}.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snapshotComputedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Snapshot Computed Timestamp' ;
    rdfs:comment 'The precise date and time at which this performance analytics snapshot record was computed and written to the Silver Layer. Serves as the principal business event timestamp for data lineage, freshness SLA monitoring, and pipeline audit trails.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:snapshotGranularity rdf:type rdf:Property ;
    rdfs:label 'Snapshot Granularity' ;
    rdfs:comment 'Temporal granularity of the performance snapshot — whether metrics represent a single game/fixture, a full season, or a rolling window period. Drives correct interpretation of metric values by analytics consumers.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snapshotLevel rdf:type rdf:Property ;
    rdfs:label 'Snapshot Level' ;
    rdfs:comment 'Indicates whether this performance analytics snapshot captures individual athlete-level metrics or team-level aggregate metrics, determining which reference fields are populated.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snapshotStatus rdf:type rdf:Property ;
    rdfs:label 'Snapshot Status' ;
    rdfs:comment 'Current lifecycle status of this performance analytics snapshot record. \'active\' — current authoritative record; \'superseded\' — replaced by a later recomputation; \'provisional\' — computed from incomplete game data (e.g., live in-game); \'rejected\' — failed data quality validation.' ;
    rdfs:domain ind:PerformanceAnalyticsSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportDiscipline rdf:type rdf:Property ;
    rdfs:label 'Sport Discipline' ;
    rdfs:comment 'The sport or athletic discipline to which this performance snapshot applies (e.g., American Football, Basketball, Baseball, Ice Hockey, Soccer, Tennis, MMA). Determines which metric taxonomy is applicable. [ENUM-REF-CANDIDATE: american_football|basketball|baseball|ice_hockey|soccer|tennis|mma|athletics|cycling|golf — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Pipeline Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Data pipeline ownership in sports entertainment data operations — pipeline owners are employees accountable for SLA adherence, incident response, and change approvals. Enables on-call roster managemen' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:alertOnFailure rdf:type rdf:Property ;
    rdfs:label 'Alert On Failure' ;
    rdfs:comment 'When True, automated alerts are sent to the notification_email and on-call channel upon pipeline failure. When False, failures are logged only (used for low-priority exploratory pipelines).' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alertOnSlaBreach rdf:type rdf:Property ;
    rdfs:label 'Alert On Sla Breach' ;
    rdfs:comment 'When True, an automated alert is triggered if the pipeline does not complete within the sla_window_minutes threshold. Supports proactive SLA management for KPI dashboards and executive reporting pipelines.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approved Timestamp' ;
    rdfs:comment 'Timestamp when this pipeline definition received formal approval for production deployment from the data governance or architecture review process. Null for draft pipelines pending approval.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:backfillSupported rdf:type rdf:Property ;
    rdfs:label 'Backfill Supported' ;
    rdfs:comment 'Indicates whether this pipeline supports historical backfill execution (True = backfill capable). Relevant for audience measurement ingestion and performance analytics pipelines that may need to reprocess historical seasons or broadcast windows.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clusterPolicy rdf:type rdf:Property ;
    rdfs:label 'Cluster Policy' ;
    rdfs:comment 'Name of the Databricks cluster policy governing compute configuration for this pipeline (e.g., analytics-standard, ml-gpu-large, streaming-autoscale). Controls cost allocation and resource governance.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:computeSize rdf:type rdf:Property ;
    rdfs:label 'Compute Size' ;
    rdfs:comment 'Standardized compute size tier for the pipeline\'s Databricks cluster (xs through xl for CPU workloads, gpu_sm/gpu_lg for ML training pipelines). Used for capacity planning and cloud cost forecasting in Workday Adaptive Planning. [ENUM-REF-CANDIDATE: xs|sm|md|lg|xl|gpu_sm|gpu_lg — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataFreshnessRequirement rdf:type rdf:Property ;
    rdfs:label 'Data Freshness Requirement' ;
    rdfs:comment 'Business-defined data freshness requirement for the pipeline\'s output: real_time (sub-second, streaming), near_real_time (< 5 min), hourly, daily, weekly, or monthly. Drives architecture decisions between streaming and batch approaches.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:databricksJobReference rdf:type rdf:Property ;
    rdfs:label 'Databricks Job Reference' ;
    rdfs:comment 'Unique identifier assigned by the Databricks Jobs service to the deployed job corresponding to this pipeline definition. Used to correlate pipeline registry records with Databricks run history, monitoring dashboards, and cost attribution.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveFrom rdf:type rdf:Property ;
    rdfs:label 'Effective From' ;
    rdfs:comment 'Date from which this pipeline definition is considered active and authoritative in the production environment. Supports temporal versioning of pipeline configurations and audit trail for regulatory compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveUntil rdf:type rdf:Property ;
    rdfs:label 'Effective Until' ;
    rdfs:comment 'Date on which this pipeline definition is scheduled to be decommissioned or superseded by a newer version. Null for indefinitely active pipelines. Used for deprecation planning and capacity management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Expected Duration Minutes' ;
    rdfs:comment 'Baseline expected runtime in minutes for a normal execution of this pipeline, used for anomaly detection (e.g., if actual runtime exceeds 2x expected, trigger alert). Established from historical p95 run durations.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gdprLawfulBasis rdf:type rdf:Property ;
    rdfs:label 'Gdpr Lawful Basis' ;
    rdfs:comment 'GDPR Article 6 lawful basis under which this pipeline processes personal data of EU-based fans or athletes. Required for pipelines where pii_flag is True and data subjects are in EU/EEA jurisdictions. \'not_applicable\' for pipelines with no PII. [ENUM-REF-CANDIDATE: consent|contract|legal_obligation|vital_interests|public_task|legitimate_interests|not_applicable — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gitRepositoryUrl rdf:type rdf:Property ;
    rdfs:label 'Git Repository Url' ;
    rdfs:comment 'URL of the source code repository (GitHub/GitLab/Azure DevOps) containing the pipeline implementation code. Enables traceability from the pipeline registry to the authoritative code version for audit and incident response.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isIdempotent rdf:type rdf:Property ;
    rdfs:label 'Is Idempotent' ;
    rdfs:comment 'Indicates whether the pipeline is designed to be safely re-run without producing duplicate or inconsistent results (True = idempotent). Critical for pipelines writing to Delta Lake tables where re-runs must not create duplicate fan scores or KPI records.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lakehouseLayer rdf:type rdf:Property ;
    rdfs:label 'Lakehouse Layer' ;
    rdfs:comment 'The Databricks Medallion Architecture layer that this pipeline targets: bronze (raw ingestion), silver (cleansed/conformed), gold (aggregated/business-ready), or platinum (executive/AI-ready). Determines data quality expectations and SLA tier.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastModifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Modified Timestamp' ;
    rdfs:comment 'Timestamp of the most recent update to this pipeline definition record, including configuration changes, status updates, or schedule modifications. Used for change tracking and compliance audit.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:maxRetries rdf:type rdf:Property ;
    rdfs:label 'Max Retries' ;
    rdfs:comment 'Maximum number of automatic retry attempts configured for this pipeline upon failure before escalating to the on-call team. Balances resilience with resource consumption on the Databricks cluster.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationEmail rdf:type rdf:Property ;
    rdfs:label 'Notification Email' ;
    rdfs:comment 'Distribution list or team email address that receives pipeline failure alerts, SLA breach notifications, and scheduled run summaries. Typically a team alias (e.g., analytics-ops@sportsentertainment.com).' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:piiFlag rdf:type rdf:Property ;
    rdfs:label 'Pii Flag' ;
    rdfs:comment 'Indicates whether this pipeline processes Personally Identifiable Information (PII) such as fan profiles, purchase history, or athlete personal data. When True, pipeline must comply with GDPR, CCPA data processing requirements and must be registered in the data processing record.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pipelineCode rdf:type rdf:Property ;
    rdfs:label 'Pipeline Code' ;
    rdfs:comment 'Externally-known short alphanumeric code used to reference the pipeline in change management tickets, SLA contracts, and cross-team communications (e.g., FAN-00142, KPI-00031).' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineDefinitionDescription rdf:type rdf:Property ;
    rdfs:label 'Pipeline Definition Description' ;
    rdfs:comment 'Free-text business description of the pipeline\'s purpose, the business problem it solves, and the key outputs it produces (e.g., \'Computes fan churn propensity scores from Adobe Experience Platform behavioral data and Ticketmaster purchase history for CRM-driven retention campaigns\').' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineName rdf:type rdf:Property ;
    rdfs:label 'Pipeline Name' ;
    rdfs:comment 'Human-readable, unique business name for the pipeline (e.g., fan_churn_scoring_pipeline, kpi_dashboard_etl, audience_measurement_ingestion). Used as the primary identity label in operational dashboards and runbooks.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineStatus rdf:type rdf:Property ;
    rdfs:label 'Pipeline Status' ;
    rdfs:comment 'Current lifecycle state of the pipeline definition: active (running on schedule), inactive (disabled), paused (temporarily suspended), deprecated (scheduled for decommission), or draft (under development, not yet promoted to production).' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineType rdf:type rdf:Property ;
    rdfs:label 'Pipeline Type' ;
    rdfs:comment 'Classifies the pipeline by its execution paradigm: batch (scheduled bulk processing), streaming (Spark Structured Streaming / real-time), ml_training (model training runs), ml_inference (model scoring/prediction), or kpi_computation (KPI aggregation and dashboard refresh). [ENUM-REF-CANDIDATE: batch|streaming|ml_training|ml_inference|kpi_computation|dbt_transform — promote to reference product if additional types emerge]' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retryIntervalMinutes rdf:type rdf:Property ;
    rdfs:label 'Retry Interval Minutes' ;
    rdfs:comment 'Wait time in minutes between consecutive retry attempts after a pipeline failure. Prevents thundering-herd issues on shared Databricks clusters during peak event-day processing.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduleCron rdf:type rdf:Property ;
    rdfs:label 'Schedule Cron' ;
    rdfs:comment 'Standard Unix cron expression defining the pipeline\'s execution schedule (e.g., \'0 2 * * *\' for daily at 02:00 UTC). Null for event-triggered or streaming pipelines. Used by Databricks Jobs scheduler and Airflow DAG configuration.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleTimezone rdf:type rdf:Property ;
    rdfs:label 'Schedule Timezone' ;
    rdfs:comment 'IANA timezone identifier for interpreting the cron schedule (e.g., America/New_York, UTC, Europe/London). Critical for pipelines supporting global Sports Entertainment markets where event timing is timezone-sensitive.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaTier rdf:type rdf:Property ;
    rdfs:label 'Sla Tier' ;
    rdfs:comment 'Business criticality tier assigned to this pipeline\'s SLA: critical (executive KPI dashboards, real-time fan scoring), high (daily reporting, ML inference), medium (weekly analytics), low (exploratory or archival pipelines). Determines incident response priority.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaWindowMinutes rdf:type rdf:Property ;
    rdfs:label 'Sla Window Minutes' ;
    rdfs:comment 'Maximum allowable elapsed time in minutes from scheduled trigger to successful pipeline completion, as defined in the data SLA contract. Breach of this window triggers automated alerting and escalation to the owning team.' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceDomain rdf:type rdf:Property ;
    rdfs:label 'Source Domain' ;
    rdfs:comment 'Comma-separated list of source data domains from which this pipeline ingests or reads data (e.g., Fan, Ticketing, Broadcast, Athlete, Venue). Supports data lineage tracking and impact analysis across the lakehouse. [ENUM-REF-CANDIDATE: Event|Athlete|Venue|Broadcast|Ticketing|Fan|Sponsorship|Merchandise|League|Content|Finance|Workforce|Compliance|Digital Platform — promote to reference product]' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDomain rdf:type rdf:Property ;
    rdfs:label 'Target Domain' ;
    rdfs:comment 'The primary data domain into which this pipeline writes its output (e.g., Analytics, Fan, Finance). Identifies the downstream consumer domain for lineage and governance purposes. [ENUM-REF-CANDIDATE: Event|Athlete|Venue|Broadcast|Ticketing|Fan|Sponsorship|Merchandise|League|Content|Finance|Workforce|Compliance|Digital Platform|Analytics — 15 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetTable rdf:type rdf:Property ;
    rdfs:label 'Target Table' ;
    rdfs:comment 'Fully qualified Databricks Unity Catalog table name (catalog.schema.table) that this pipeline writes its output to (e.g., sports_ent.analytics_silver.fan_churn_scores). Used for lineage, impact analysis, and data contract validation.' ;
    rdfs:domain ind:Analytics ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technologyStack rdf:type rdf:Property ;
    rdfs:label 'Technology Stack' ;
    rdfs:comment 'Primary technology or orchestration framework used to implement this pipeline (e.g., Databricks, dbt, Spark Structured Streaming, Delta Live Tables). Informs infrastructure provisioning, support routing, and upgrade planning. [ENUM-REF-CANDIDATE: Databricks|dbt|Spark Structured Streaming|Delta Live Tables|Apache Kafka|Azure Data Factory|Airflow|Fivetran — promote to reference product]' ;
    rdfs:domain ind:PipelineDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerType rdf:type rdf:Property ;
    rdfs:label 'Trigger Type' ;
    rdfs:comment 'Mechanism that initiates pipeline execution: scheduled (cron-based), event_driven (file arrival, Kafka message, CDC event), manual (on-demand by operator), continuous (always-on streaming), or api_triggered (invoked via REST API call from upstream system).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:version rdf:type rdf:Property ;
    rdfs:label 'Version' ;
    rdfs:comment 'Semantic version number of the pipeline definition (e.g., 2.1.0). Tracks major/minor/patch changes to pipeline logic, schema, or configuration. Used for change management, rollback planning, and audit trail.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeredByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Triggered By Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Pipeline run audit trails in sports entertainment data operations require knowing which employee triggered a manual run, for incident investigation, change management compliance, and SOX/data governan' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:clusterConfigReference rdf:type rdf:Property ;
    rdfs:label 'Cluster Config Reference' ;
    rdfs:comment 'Reference to the Databricks cluster configuration profile used for this pipeline run (e.g., node type, autoscaling policy, Spark version, runtime configuration). Enables cost attribution by cluster tier and performance benchmarking across configuration variants.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clusterReference rdf:type rdf:Property ;
    rdfs:label 'Cluster Reference' ;
    rdfs:comment 'Native Databricks cluster instance identifier for the compute resource that executed this pipeline run. Used for cross-referencing with Databricks cluster utilization logs and cloud infrastructure cost reports.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataIntervalEnd rdf:type rdf:Property ;
    rdfs:label 'Data Interval End' ;
    rdfs:comment 'End of the business data time window processed by this pipeline run (e.g., the latest event timestamp included in the batch). Used with data_interval_start to define the processing window for incremental load auditing and SLA compliance.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataIntervalStart rdf:type rdf:Property ;
    rdfs:label 'Data Interval Start' ;
    rdfs:comment 'Start of the business data time window processed by this pipeline run (e.g., the earliest event timestamp included in the batch). Distinct from run start_timestamp; used for data completeness validation and late-arriving data detection.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:databricksJobRunReference rdf:type rdf:Property ;
    rdfs:label 'Databricks Job Run Reference' ;
    rdfs:comment 'Native Databricks platform job run identifier assigned by the Databricks Jobs API for this execution. Used for cross-referencing with Databricks audit logs, cost reports, and cluster utilization dashboards.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dqCheckPassed rdf:type rdf:Property ;
    rdfs:label 'Dq Check Passed' ;
    rdfs:comment 'Boolean flag indicating whether all configured data quality checks (completeness, uniqueness, referential integrity, range validation) passed for this pipeline run. False triggers downstream alerting and may block Silver-to-Gold promotion.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dqRulesEvaluated rdf:type rdf:Property ;
    rdfs:label 'Dq Rules Evaluated' ;
    rdfs:comment 'Total number of data quality rules evaluated against the output dataset during this pipeline run. Provides denominator context for interpreting dq_rules_failed and the overall dq_check_passed flag.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dqRulesFailed rdf:type rdf:Property ;
    rdfs:label 'Dq Rules Failed' ;
    rdfs:comment 'Number of data quality rules that did not pass during this pipeline run. A value greater than zero sets dq_check_passed to False and initiates the data quality remediation workflow.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:durationSeconds rdf:type rdf:Property ;
    rdfs:label 'Duration Seconds' ;
    rdfs:comment 'Elapsed wall-clock time in seconds from run start to run end. Populated upon completion or failure. Used for SLA threshold comparison, performance trending, and capacity planning across the analytics platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endTimestamp rdf:type rdf:Property ;
    rdfs:label 'End Timestamp' ;
    rdfs:comment 'UTC timestamp marking the moment this pipeline execution completed, failed, or was cancelled. Null if the run is still in progress. Used with start_timestamp to compute elapsed duration for SLA compliance and cost attribution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:gitCommitSha rdf:type rdf:Property ;
    rdfs:label 'Git Commit Sha' ;
    rdfs:comment 'Full 40-character Git commit hash of the pipeline source code executed in this run. Provides exact code provenance for audit trails, reproducibility of analytics outputs, and compliance with data lineage requirements.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxRetriesAllowed rdf:type rdf:Property ;
    rdfs:label 'Max Retries Allowed' ;
    rdfs:comment 'Maximum number of automatic retry attempts configured for this pipeline at the time of execution. Captured at run time to provide context for interpreting retry_attempt values and evaluating pipeline resilience configuration.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nodeType rdf:type rdf:Property ;
    rdfs:label 'Node Type' ;
    rdfs:comment 'Cloud compute instance type used for the driver and worker nodes during this run (e.g., \'Standard_DS3_v2\', \'i3.xlarge\'). Captured at run time for cost attribution and performance analysis independent of the cluster configuration record.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notebookPath rdf:type rdf:Property ;
    rdfs:label 'Notebook Path' ;
    rdfs:comment 'Databricks workspace path or Repos path of the primary notebook or script executed in this pipeline run (e.g., \'/Repos/analytics/fan_behavior/fan_scoring_v2\'). Provides direct code traceability for audit and reproducibility purposes.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numWorkers rdf:type rdf:Property ;
    rdfs:label 'Num Workers' ;
    rdfs:comment 'Number of worker nodes allocated to the Databricks cluster at the time of this pipeline run. Used for cost attribution (DBU consumption) and capacity planning for peak analytics workloads such as post-event fan engagement scoring.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pipelineVersion rdf:type rdf:Property ;
    rdfs:label 'Pipeline Version' ;
    rdfs:comment 'Version identifier of the pipeline code or notebook that was executed in this run (e.g., semantic version \'2.3.1\' or Git commit SHA). Enables reproducibility auditing, regression analysis, and rollback decisions when pipeline behavior changes.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordsInserted rdf:type rdf:Property ;
    rdfs:label 'Records Inserted' ;
    rdfs:comment 'Number of net-new records written to the target Silver layer table during this run. Distinguishes new data from updates for change data capture (CDC) auditing and incremental load verification.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordsProcessed rdf:type rdf:Property ;
    rdfs:label 'Records Processed' ;
    rdfs:comment 'Total number of input records successfully read and processed by the pipeline during this run. Used for throughput benchmarking, cost-per-record attribution, and data volume trend analysis.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordsRejected rdf:type rdf:Property ;
    rdfs:label 'Records Rejected' ;
    rdfs:comment 'Number of input records that failed validation or transformation rules and were excluded from the output dataset during this run. High rejection rates trigger data quality investigations and upstream source system reviews.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordsUpdated rdf:type rdf:Property ;
    rdfs:label 'Records Updated' ;
    rdfs:comment 'Number of existing records modified (upserted or merged) in the target Silver layer table during this run. Used alongside records_inserted to validate merge/upsert logic correctness.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retryAttempt rdf:type rdf:Property ;
    rdfs:label 'Retry Attempt' ;
    rdfs:comment 'Zero-based count of how many times this pipeline run has been retried following a failure. A value of 0 indicates the initial execution attempt. Used to distinguish first-attempt runs from retries in SLA calculations and reliability KPI reporting.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:runName rdf:type rdf:Property ;
    rdfs:label 'Run Name' ;
    rdfs:comment 'Human-readable display name for this specific pipeline execution, typically auto-generated or user-assigned at trigger time (e.g., \'fan_engagement_model_2024-06-01_scheduled\').' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runNumber rdf:type rdf:Property ;
    rdfs:label 'Run Number' ;
    rdfs:comment 'Sequential monotonically increasing run number scoped to the parent pipeline definition. Enables ordered tracking of successive executions of the same pipeline.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runTags rdf:type rdf:Property ;
    rdfs:label 'Run Tags' ;
    rdfs:comment 'Comma-separated key-value metadata tags applied to this pipeline run for operational classification (e.g., \'cost_center=analytics,project=fan_360,season=2024\'). Enables flexible cost attribution, project tracking, and ad-hoc filtering in analytics platform dashboards.' ;
    rdfs:domain ind:PipelineRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Timestamp' ;
    rdfs:comment 'UTC timestamp at which this pipeline run was originally scheduled to begin. Null for manual or event-driven triggers. Comparing this to start_timestamp reveals scheduling lag and SLA drift.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:slaBreach rdf:type rdf:Property ;
    rdfs:label 'Sla Breach' ;
    rdfs:comment 'Boolean flag indicating whether this pipeline run exceeded its configured SLA duration threshold. True triggers escalation notifications to the analytics platform operations team and is reported in executive KPI dashboards for platform reliability.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaThresholdSeconds rdf:type rdf:Property ;
    rdfs:label 'Sla Threshold Seconds' ;
    rdfs:comment 'Configured maximum allowable duration in seconds for this pipeline run before it is considered an SLA breach. Captured at run time from the pipeline definition to enable point-in-time SLA compliance assessment independent of configuration changes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:startTimestamp rdf:type rdf:Property ;
    rdfs:label 'Start Timestamp' ;
    rdfs:comment 'UTC timestamp marking the moment this pipeline execution began processing. Used as the principal business event time for SLA measurement, cost attribution window start, and operational reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:agentRelationshipId rdf:type rdf:Property ;
    rdfs:label 'Agent Relationship Id' ;
    rdfs:comment 'Unique surrogate identifier for the agent-athlete relationship record in the lakehouse silver layer. Primary key for this association entity.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agencyId rdf:type rdf:Property ;
    rdfs:label 'Agency Id' ;
    rdfs:comment 'Reference to the sports agency or firm through which the agent operates. An agent may be affiliated with a larger agency entity.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agency .

ind:agentId rdf:type rdf:Property ;
    rdfs:label 'Agent Id' ;
    rdfs:comment 'Reference to the certified agent who represents the athlete. Links to the agent master record.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:governingBodyId rdf:type rdf:Property ;
    rdfs:label 'Governing Body Id' ;
    rdfs:comment 'Foreign key linking to compliance.governing_body. Business justification: Agent relationships store certifying_association as denormalized text. The governing body that certifies and regulates agents (NFLPA, FIFA, etc.) is authoritative in compliance.governing_body. Agent c' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GoverningBody .

ind:ndaId rdf:type rdf:Property ;
    rdfs:label 'Nda Id' ;
    rdfs:comment 'Foreign key linking to legal.nda. Business justification: Agent representation agreements require NDAs covering athlete personal data, contract negotiation strategies, and salary information. The agent_relationship already tracks agreement_document_ref as a ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Nda .

ind:agentLicenseJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Agent License Jurisdiction' ;
    rdfs:comment 'The country or state/province jurisdiction in which the agent holds a valid sports agent license or registration, where required by law (e.g., US state athlete agent acts, EU member state regulations). Stored as ISO 3166-1 alpha-2 or alpha-3 country code.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Agreement Document Ref' ;
    rdfs:comment 'Reference identifier or URL pointing to the executed representation agreement document stored in the digital asset management (DAM) or document management system. Enables retrieval of the signed contract for compliance audits.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Certification Expiry Date' ;
    rdfs:comment 'The date on which the agent\'s players association certification expires and must be renewed. Used to trigger compliance alerts and prevent unauthorized representation activity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationNumber rdf:type rdf:Property ;
    rdfs:label 'Certification Number' ;
    rdfs:comment 'Official certification or license number issued by the relevant players association (e.g., NFLPA, NBPA, MLBPA, NHLPA) confirming the agent is authorized to represent athletes in contract negotiations. Required for league compliance validation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionBasis rdf:type rdf:Property ;
    rdfs:label 'Commission Basis' ;
    rdfs:comment 'Defines the income base upon which the agent\'s commission rate is applied. Determines whether commission is calculated on gross salary, net salary, signing bonus, endorsement income, NIL (Name Image and Likeness) income, or all income streams.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionRatePct rdf:type rdf:Property ;
    rdfs:label 'Commission Rate Pct' ;
    rdfs:comment 'The contractually agreed commission rate (expressed as a decimal fraction, e.g., 0.0300 = 3%) that the agent earns on the athlete\'s compensation under this representation agreement. Subject to CBA (Collective Bargaining Agreement) maximum commission caps per league.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Date' ;
    rdfs:comment 'The date of the most recent compliance review of this agent-athlete relationship, verifying that the agent\'s certification is current, commission rates comply with CBA caps, and no conflicts of interest exist.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceReviewOutcome rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Outcome' ;
    rdfs:comment 'Result of the most recent compliance review of this agent-athlete relationship. Passed indicates all requirements met; failed indicates one or more violations identified; pending indicates review in progress; waived indicates review exempted by league authority.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictOfInterestFlag rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Flag' ;
    rdfs:comment 'Indicates whether a potential or confirmed conflict of interest has been identified for this agent-athlete relationship (e.g., agent also represents opposing team management, or represents multiple athletes competing for the same roster position). Triggers compliance review workflow.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conflictOfInterestNotes rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Notes' ;
    rdfs:comment 'Free-text description of the nature of any identified conflict of interest associated with this agent-athlete relationship. Populated only when conflict_of_interest_flag is True. Used by compliance and legal teams.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractNegotiationAuthority rdf:type rdf:Property ;
    rdfs:label 'Contract Negotiation Authority' ;
    rdfs:comment 'Indicates whether this agent is authorized to negotiate the athlete\'s playing contract (salary, bonuses, incentives) with team management on the athlete\'s behalf. Core authority granted under standard player representation agreements.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crmRecordReference rdf:type rdf:Property ;
    rdfs:label 'Crm Record Reference' ;
    rdfs:comment 'The unique identifier of the corresponding agent-athlete relationship record in Salesforce CRM, used for system-of-record traceability and bi-directional synchronization between the lakehouse and the CRM platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveDate rdf:type rdf:Property ;
    rdfs:label 'Effective Date' ;
    rdfs:comment 'The date on which the agent-athlete representation relationship becomes legally binding and operative. Aligns with the signed representation agreement commencement date.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endorsementRepresentation rdf:type rdf:Property ;
    rdfs:label 'Endorsement Representation' ;
    rdfs:comment 'Indicates whether this agent relationship includes authority to negotiate commercial endorsement deals on behalf of the athlete, separate from the athlete\'s playing contract.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryAgent rdf:type rdf:Property ;
    rdfs:label 'Is Primary Agent' ;
    rdfs:comment 'Indicates whether this agent is the athlete\'s primary (lead) representative when the athlete has multiple agents covering different representation scopes. Only one agent relationship per athlete should be flagged as primary at any given time.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueApprovalDate rdf:type rdf:Property ;
    rdfs:label 'League Approval Date' ;
    rdfs:comment 'The date on which the relevant league office or players association formally approved the agent-athlete representation agreement, authorizing the agent to act on the athlete\'s behalf.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leagueFilingDate rdf:type rdf:Property ;
    rdfs:label 'League Filing Date' ;
    rdfs:comment 'The date on which the agent-athlete representation agreement was formally filed with the relevant league office or players association for approval and registration.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leagueFilingStatus rdf:type rdf:Property ;
    rdfs:label 'League Filing Status' ;
    rdfs:comment 'Status of the agent relationship filing with the relevant league office or players association. Leagues require formal notification and approval of agent-athlete representation agreements before the agent may negotiate on the athlete\'s behalf.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalRepresentation rdf:type rdf:Property ;
    rdfs:label 'Legal Representation' ;
    rdfs:comment 'Indicates whether this relationship includes legal representation authority (e.g., grievance filings, arbitration proceedings, disciplinary hearings). May require the agent to also be a licensed attorney depending on jurisdiction.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nilRepresentation rdf:type rdf:Property ;
    rdfs:label 'Nil Representation' ;
    rdfs:comment 'Indicates whether this agent relationship includes authority to negotiate NIL (Name Image and Likeness) deals on behalf of the athlete. NIL representation may be scoped separately from contract negotiation authority.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:powerOfAttorney rdf:type rdf:Property ;
    rdfs:label 'Power Of Attorney' ;
    rdfs:comment 'Indicates whether the athlete has granted the agent a formal power of attorney, authorizing the agent to execute contracts and legal documents on the athlete\'s behalf without requiring the athlete\'s direct signature.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:powerOfAttorneyScope rdf:type rdf:Property ;
    rdfs:label 'Power Of Attorney Scope' ;
    rdfs:comment 'Describes the specific scope and limitations of the power of attorney granted to the agent, if applicable. May specify which transaction types, dollar thresholds, or legal actions are covered. Null if power_of_attorney is False. [ENUM-REF-CANDIDATE: full|contract_only|endorsement_only|financial_only|limited — promote to reference product]' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Email' ;
    rdfs:comment 'Primary email address used to contact the agent for contract negotiation communications, league notifications, and official correspondence related to this athlete representation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Phone' ;
    rdfs:comment 'Primary phone number for reaching the agent regarding this athlete representation relationship. Stored in E.164 international format.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipNumber rdf:type rdf:Property ;
    rdfs:label 'Relationship Number' ;
    rdfs:comment 'Externally-known business identifier for this agent-athlete relationship, used in correspondence, contract filings, and league submissions. Format: AR-YYYYNNNN.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipStatus rdf:type rdf:Property ;
    rdfs:label 'Relationship Status' ;
    rdfs:comment 'Current lifecycle state of the agent-athlete representation relationship. Active indicates a current, binding representation agreement; pending indicates awaiting league certification approval; suspended indicates temporarily inactive due to compliance hold; terminated indicates ended by either party; expired indicates the agreement term lapsed without renewal.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Renewal Notice Days' ;
    rdfs:comment 'Number of calendar days prior to the termination_date by which either party must provide written notice of intent not to renew the representation agreement. Null if renewal_option is False.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalOption rdf:type rdf:Property ;
    rdfs:label 'Renewal Option' ;
    rdfs:comment 'Indicates whether the representation agreement contains an automatic renewal clause or a mutual option to extend the relationship beyond the initial term without executing a new agreement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:representationAgreementDate rdf:type rdf:Property ;
    rdfs:label 'Representation Agreement Date' ;
    rdfs:comment 'The date on which the formal representation agreement between the athlete and agent was executed (signed by both parties). May differ from the effective_date if there is a delayed commencement clause.' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:representationScope rdf:type rdf:Property ;
    rdfs:label 'Representation Scope' ;
    rdfs:comment 'Defines the scope of authority granted to the agent under this relationship. Typical values include contract_negotiation, endorsements, nil_agreements, legal, media, financial_advisory, full_service. [ENUM-REF-CANDIDATE: contract_negotiation|endorsements|nil_agreements|legal|media|financial_advisory|full_service — promote to reference product]' ;
    rdfs:domain ind:AgentRelationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationDate rdf:type rdf:Property ;
    rdfs:label 'Termination Date' ;
    rdfs:comment 'The date on which the agent-athlete representation relationship was formally terminated or is scheduled to expire. Null if the relationship is currently active or open-ended.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:terminationReason rdf:type rdf:Property ;
    rdfs:label 'Termination Reason' ;
    rdfs:comment 'Reason code explaining why the agent-athlete representation relationship was terminated. Used for compliance reporting and league audit trails. Null if relationship is still active. [ENUM-REF-CANDIDATE: athlete_request|agent_request|mutual_agreement|certification_revoked|cba_violation|contract_expiry|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamId rdf:type rdf:Property ;
    rdfs:label 'Team Id' ;
    rdfs:comment 'FK to league.team' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Team .

ind:athleteType rdf:type rdf:Property ;
    rdfs:label 'Athlete Type' ;
    rdfs:comment 'Classification of the individual\'s role within the sports organization. Distinguishes active players from coaching staff, officials, prospects, and support personnel for roster management and credentialing.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bio rdf:type rdf:Property ;
    rdfs:label 'Bio' ;
    rdfs:comment 'Official short-form biographical narrative for the athlete, approved for public use in broadcast, digital platforms, and media guides. Managed through the content production workflow.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careerStatus rdf:type rdf:Property ;
    rdfs:label 'Career Status' ;
    rdfs:comment 'Current lifecycle status of the athlete\'s professional career. Drives roster eligibility, broadcast availability, contract activation, and league reporting. [ENUM-REF-CANDIDATE: active|retired|suspended|injured_reserve|deceased|inactive — promote to reference product]' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryOfBirthCode rdf:type rdf:Property ;
    rdfs:label 'Country Of Birth Code' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code for the country where the athlete was born. Distinct from nationality; used for eligibility determinations, international federation registration, and demographic analytics.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Date Of Birth' ;
    rdfs:comment 'Athlete\'s date of birth in ISO 8601 format (yyyy-MM-dd). Used for age eligibility verification, draft classification, CBA compliance, and league registration.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dominantFoot rdf:type rdf:Property ;
    rdfs:label 'Dominant Foot' ;
    rdfs:comment 'The athlete\'s dominant foot for sports where foot preference is analytically significant (e.g., soccer, rugby). Used in performance analytics, tactical planning, and broadcast commentary.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dominantHand rdf:type rdf:Property ;
    rdfs:label 'Dominant Hand' ;
    rdfs:comment 'The athlete\'s dominant hand (throwing, batting, or shooting hand). Critical for performance analytics, matchup strategy, broadcast commentary, and scouting reports.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:draftPickNumber rdf:type rdf:Property ;
    rdfs:label 'Draft Pick Number' ;
    rdfs:comment 'The overall pick number at which the athlete was selected in the league draft. Used for historical analytics, contract benchmarking, and scouting model validation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:draftRound rdf:type rdf:Property ;
    rdfs:label 'Draft Round' ;
    rdfs:comment 'The round number in which the athlete was selected during the league draft. Used for contract tier classification, scouting evaluation benchmarking, and CBA (Collective Bargaining Agreement) rookie scale assignment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:draftYear rdf:type rdf:Property ;
    rdfs:label 'Draft Year' ;
    rdfs:comment 'The calendar year in which the athlete was selected in the league draft. Used for career tenure analytics, contract eligibility windows, CBA (Collective Bargaining Agreement) rookie scale calculations, and historical reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eligibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Eligibility Status' ;
    rdfs:comment 'Current league eligibility status of the athlete, reflecting compliance with CBA (Collective Bargaining Agreement), anti-doping (WADA), and disciplinary rules. Distinct from career_status — an athlete may be active but temporarily ineligible.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headshotImageUrl rdf:type rdf:Property ;
    rdfs:label 'Headshot Image Url' ;
    rdfs:comment 'URL reference to the athlete\'s official headshot photograph stored in the Digital Asset Management (DAM) system. Used for broadcast overlays, fan-facing platforms, merchandise, and media kits.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:heightCm rdf:type rdf:Property ;
    rdfs:label 'Height Cm' ;
    rdfs:comment 'Athlete\'s official measured height in centimetres as recorded at league registration or combine. Used for scouting analytics, broadcast graphics, merchandise sizing, and physical eligibility assessments.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:injuryStatus rdf:type rdf:Property ;
    rdfs:label 'Injury Status' ;
    rdfs:comment 'Current injury designation for the athlete as reported to the league. Drives roster availability, broadcast commentary, fantasy sports data feeds, and medical staff workflows. [ENUM-REF-CANDIDATE: healthy|day_to_day|injured_reserve|physically_unable|out_for_season — promote to reference product]' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jerseyNumber rdf:type rdf:Property ;
    rdfs:label 'Jersey Number' ;
    rdfs:comment 'The official jersey/squad number assigned to the athlete on their current roster. Used for broadcast graphics, merchandise production, ticketing displays, and fan engagement content.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leagueRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'League Registration Number' ;
    rdfs:comment 'Externally-known unique identifier assigned by the governing league or federation upon official registration (e.g., NFL Player ID, FIFA Registration Number). Used for inter-system reconciliation, transfer clearances, and regulatory filings.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalFirstName rdf:type rdf:Property ;
    rdfs:label 'Legal First Name' ;
    rdfs:comment 'Athlete\'s legal given name as recorded on government-issued identification documents. Used for contract execution, league registration, and regulatory compliance filings.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalLastName rdf:type rdf:Property ;
    rdfs:label 'Legal Last Name' ;
    rdfs:comment 'Athlete\'s legal family/surname as recorded on government-issued identification documents. Used for contract execution, league registration, and regulatory compliance filings.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalMiddleName rdf:type rdf:Property ;
    rdfs:label 'Legal Middle Name' ;
    rdfs:comment 'Athlete\'s legal middle name or initial as recorded on government-issued identification. May be required for full legal name matching in contract and compliance contexts.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nationalityCode rdf:type rdf:Property ;
    rdfs:label 'Nationality Code' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code representing the athlete\'s nationality as declared on their passport or official registration. Governs international transfer eligibility, work permit requirements, and national team selection.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilAgreementActive rdf:type rdf:Property ;
    rdfs:label 'Nil Agreement Active' ;
    rdfs:comment 'Indicates whether the athlete currently has one or more active NIL (Name, Image, and Likeness) agreements in force. Used to trigger compliance checks, sponsorship conflict reviews, and revenue tracking workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferredName rdf:type rdf:Property ;
    rdfs:label 'Preferred Name' ;
    rdfs:comment 'The name the athlete prefers to be publicly known by, such as a nickname or shortened name (e.g., \'LeBron\' or \'Messi\'). Used in broadcast graphics, merchandise, and fan-facing content.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPosition rdf:type rdf:Property ;
    rdfs:label 'Primary Position' ;
    rdfs:comment 'The athlete\'s primary playing position as designated by the league or team (e.g., \'Quarterback\', \'Center Forward\', \'Pitcher\', \'Point Guard\'). Critical for performance analytics, WAR/ERA/QBR calculations, and broadcast commentary.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proDebutDate rdf:type rdf:Property ;
    rdfs:label 'Pro Debut Date' ;
    rdfs:comment 'The date on which the athlete made their first official professional appearance. Used for career tenure calculations, milestone tracking, broadcast storytelling, and eligibility determinations.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Created Timestamp' ;
    rdfs:comment 'The timestamp when this athlete profile record was first created in the Databricks Silver Layer data product. Used for data lineage, audit trails, and GDPR data subject request processing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Updated Timestamp' ;
    rdfs:comment 'The timestamp when this athlete profile record was most recently modified in the Databricks Silver Layer data product. Used for change data capture, incremental processing, and audit compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:secondaryPosition rdf:type rdf:Property ;
    rdfs:label 'Secondary Position' ;
    rdfs:comment 'An alternate playing position the athlete is qualified to fill, enabling flexible roster deployment. Used in lineup planning, injury substitution scenarios, and performance analytics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialMediaHandleInstagram rdf:type rdf:Property ;
    rdfs:label 'Social Media Handle Instagram' ;
    rdfs:comment 'Athlete\'s official Instagram social media handle. Used for fan engagement campaigns, NIL (Name, Image, and Likeness) tracking, digital partnership activations, and influencer analytics.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialMediaHandleTwitter rdf:type rdf:Property ;
    rdfs:label 'Social Media Handle Twitter' ;
    rdfs:comment 'Athlete\'s official X (formerly Twitter) social media handle. Used for fan engagement campaigns, NIL (Name, Image, and Likeness) tracking, digital partnership activations, and social media analytics.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemAthleteCode rdf:type rdf:Property ;
    rdfs:label 'Source System Athlete Code' ;
    rdfs:comment 'The native identifier for this athlete in the originating operational system of record (e.g., SAP SuccessFactors Employee ID, league registration system player ID). Used for cross-system reconciliation and data lineage tracing.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportCode rdf:type rdf:Property ;
    rdfs:label 'Sport Code' ;
    rdfs:comment 'Standardized code identifying the primary sport the athlete competes in (e.g., \'SOCCER\', \'BASKETBALL\', \'BASEBALL\', \'FOOTBALL\', \'HOCKEY\'). Used for cross-sport analytics, content tagging, and league routing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wadaRegisteredTestingPool rdf:type rdf:Property ;
    rdfs:label 'Wada Registered Testing Pool' ;
    rdfs:comment 'Indicates whether the athlete is enrolled in the WADA (World Anti-Doping Agency) Registered Testing Pool (RTP), requiring whereabouts reporting and out-of-competition testing. Critical for anti-doping compliance management.' ;
    rdfs:domain ind:AthleteProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weightKg rdf:type rdf:Property ;
    rdfs:label 'Weight Kg' ;
    rdfs:comment 'Athlete\'s official measured weight in kilograms as recorded at league registration or combine. Used for scouting analytics, broadcast graphics, health monitoring, and physical eligibility assessments.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:awardHonorId rdf:type rdf:Property ;
    rdfs:label 'Award Honor Id' ;
    rdfs:comment 'Unique surrogate identifier for each award, honor, milestone, or recognition record in the athlete achievement registry.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AwardHonor .

ind:broadcastMediaAssetId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Media Asset Id' ;
    rdfs:comment 'Foreign key linking to broadcast.media_asset. Business justification: Award highlight broadcasts are a named production process in sports entertainment — award ceremonies, career milestone segments, and Hall of Fame inductions are produced as broadcast media assets. Thi' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MediaAsset .

ind:contentAssetId rdf:type rdf:Property ;
    rdfs:label 'Content Asset Id' ;
    rdfs:comment 'Reference to the broadcast highlight, video clip, or digital asset in the Digital Asset Management (DAM) system associated with this achievement moment. Supports broadcast storytelling and content production workflows in Dalet Galaxy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:nilAgreementId rdf:type rdf:Property ;
    rdfs:label 'Nil Agreement Id' ;
    rdfs:comment 'Reference to the NIL agreement that was triggered, amended, or commercially activated as a result of this award or achievement. Links achievement to commercial contract lifecycle.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NilAgreement .

ind:sanctionId rdf:type rdf:Property ;
    rdfs:label 'Sanction Id' ;
    rdfs:comment 'Foreign key linking to compliance.sanction. Business justification: Awards are revoked when athletes receive doping or conduct sanctions. award_honor stores wada_compliance_status and revocation_reason as plain fields. Linking to compliance.sanction enables the award ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Sanction .

ind:sponsorId rdf:type rdf:Property ;
    rdfs:label 'Sponsor Id' ;
    rdfs:comment 'Foreign key linking to sponsorship.sponsor. Business justification: Award sponsorship commercial process: in sports entertainment, awards are routinely presented by named sponsors (e.g., \'MVP presented by Brand X\'). Tracking the presenting sponsor on award_honor enabl' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Sponsor .

ind:achievementType rdf:type rdf:Property ;
    rdfs:label 'Achievement Type' ;
    rdfs:comment 'High-level classification of the achievement: award (formal recognition voted or selected), milestone (career statistical threshold), record (all-time or league record), induction (Hall of Fame or equivalent), career_event (debut, retirement, trade milestone, contract extension).' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:awardCategory rdf:type rdf:Property ;
    rdfs:label 'Award Category' ;
    rdfs:comment 'Functional category grouping the award for analytics and reporting (e.g., individual performance, team achievement, sportsmanship, fan vote, media recognition, career milestone, all-star selection, defensive, offensive). [ENUM-REF-CANDIDATE: individual_performance|team_achievement|sportsmanship|fan_vote|media_recognition|career_milestone|all_star|defensive|offensive|special_teams — promote to reference product]' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:awardDate rdf:type rdf:Property ;
    rdfs:label 'Award Date' ;
    rdfs:comment 'The official date on which the award was conferred, the milestone was achieved, or the career event occurred. Principal business event date for timeline analytics and broadcast storytelling.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:awardName rdf:type rdf:Property ;
    rdfs:label 'Award Name' ;
    rdfs:comment 'Official name of the award, honor, or recognition as designated by the awarding body (e.g., Most Valuable Player (MVP), Cy Young Award, Ballon d\'Or, All-Star, All-Pro, Rookie of the Year, Hall of Fame Induction, Wins Above Replacement (WAR) Record).' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:awardRank rdf:type rdf:Property ;
    rdfs:label 'Award Rank' ;
    rdfs:comment 'Ordinal rank or placement of the athlete in the award selection (e.g., 1 for winner, 2 for runner-up, 3 for third place). Null for binary win/no-win awards. Supports finalist and runner-up tracking.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:awardSeasonYear rdf:type rdf:Property ;
    rdfs:label 'Award Season Year' ;
    rdfs:comment 'The four-digit calendar or competition year associated with the award (e.g., 2024 for the 2023-24 season). Supports year-over-year reporting independent of season ID.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:awardStatus rdf:type rdf:Property ;
    rdfs:label 'Award Status' ;
    rdfs:comment 'Current lifecycle status of the award record: active (confirmed and standing), revoked (stripped due to doping, eligibility, or conduct violation), under_review (under investigation), reinstated (restored after appeal), pending (nomination or selection in progress).' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:awardingBodyName rdf:type rdf:Property ;
    rdfs:label 'Awarding Body Name' ;
    rdfs:comment 'Name of the organization, league office, governing body, media outlet, or fan platform that conferred or certified this award or recognition (e.g., NFL League Office, FIFA, WADA, Basketball Writers Association, fan vote platform).' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:awardingBodyType rdf:type rdf:Property ;
    rdfs:label 'Awarding Body Type' ;
    rdfs:comment 'Classification of the entity that conferred the award: league_office (official league body), governing_body (FIFA, IOC, WADA), media (press association, broadcaster), fan_vote (fan-selected), peer_vote (player-selected), independent (third-party organization).' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careerLifecycleStage rdf:type rdf:Property ;
    rdfs:label 'Career Lifecycle Stage' ;
    rdfs:comment 'Stage of the athlete\'s professional career at the time of the achievement: debut (first season), active (mid-career), peak (prime performance years), veteran (late career), retirement (final season), post_career (after retirement, e.g., Hall of Fame induction).' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbaEligibilityConfirmed rdf:type rdf:Property ;
    rdfs:label 'Cba Eligibility Confirmed' ;
    rdfs:comment 'Indicates whether the athlete\'s eligibility for this award was confirmed as compliant with the applicable Collective Bargaining Agreement (CBA) at the time of conferral. Critical for league governance and dispute resolution.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalReferenceCode rdf:type rdf:Property ;
    rdfs:label 'External Reference Code' ;
    rdfs:comment 'Externally-known identifier or code assigned by the awarding body, league office, or governing organization (e.g., FIFA award registry ID, NFL league office reference number). Enables cross-system reconciliation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hallOfFameClassYear rdf:type rdf:Property ;
    rdfs:label 'Hall Of Fame Class Year' ;
    rdfs:comment 'The induction class year for Hall of Fame achievements (e.g., 2024). Null for non-induction achievement types. Supports historical archive and broadcast storytelling for induction ceremonies.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hallOfFameInstitution rdf:type rdf:Property ;
    rdfs:label 'Hall Of Fame Institution' ;
    rdfs:comment 'Name of the Hall of Fame or equivalent institution into which the athlete was inducted (e.g., Pro Football Hall of Fame, Naismith Memorial Basketball Hall of Fame, Baseball Hall of Fame, Hockey Hall of Fame, FIFA World Football Museum). Null for non-induction records.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBroadcastFeatured rdf:type rdf:Property ;
    rdfs:label 'Is Broadcast Featured' ;
    rdfs:comment 'Indicates whether this achievement has been featured or scheduled for broadcast storytelling segments, highlight reels, or OTT content packages (True). Supports content production scheduling in Dalet Galaxy.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCareerFirst rdf:type rdf:Property ;
    rdfs:label 'Is Career First' ;
    rdfs:comment 'Indicates whether this achievement represents the athlete\'s first occurrence of this award or milestone in their career (True). Critical for debut and first-achievement storytelling in broadcast and fan engagement platforms.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNominee rdf:type rdf:Property ;
    rdfs:label 'Is Nominee' ;
    rdfs:comment 'Indicates whether this record represents a nomination rather than a final award. True when the athlete was nominated but the award outcome is pending or was not won. Supports nomination tracking for commercial valuation and fan engagement.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWinner rdf:type rdf:Property ;
    rdfs:label 'Is Winner' ;
    rdfs:comment 'Indicates whether the athlete was the primary winner/recipient of the award (True) or a finalist, nominee, or runner-up (False). Enables filtering of winners vs. nominees in reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jerseyNumberAtTime rdf:type rdf:Property ;
    rdfs:label 'Jersey Number At Time' ;
    rdfs:comment 'The athlete\'s jersey number worn at the time of the award or milestone. Supports merchandise licensing, broadcast graphics, and historical archive accuracy.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nilCommercialValueUsd rdf:type rdf:Property ;
    rdfs:label 'Nil Commercial Value Usd' ;
    rdfs:comment 'Estimated commercial valuation uplift in USD attributed to this award or achievement for Name Image and Likeness (NIL) agreement pricing, athlete endorsement negotiations, and merchandise licensing. Supports athlete commercial valuation in Salesforce CRM.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:occurrenceNumber rdf:type rdf:Property ;
    rdfs:label 'Occurrence Number' ;
    rdfs:comment 'Sequential count of how many times this athlete has received this specific award or achieved this milestone (e.g., 3 for a three-time MVP winner, 100 for 100th international cap). Supports multi-winner tracking and career narrative.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:positionAtTime rdf:type rdf:Property ;
    rdfs:label 'Position At Time' ;
    rdfs:comment 'The athlete\'s playing position at the time the award was received (e.g., Quarterback, Forward, Pitcher, Center, Midfielder). Preserves historical positional context for analytics and broadcast content.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:previousRecordValue rdf:type rdf:Property ;
    rdfs:label 'Previous Record Value' ;
    rdfs:comment 'The prior record or threshold value that was surpassed when this record-breaking achievement was set. Null for non-record achievements. Enables broadcast storytelling of record-breaking moments.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revocationReason rdf:type rdf:Property ;
    rdfs:label 'Revocation Reason' ;
    rdfs:comment 'Reason for award revocation or suspension if award_status is revoked or under_review (e.g., Performance Enhancing Drug (PED) violation, eligibility breach, conduct violation, statistical correction). Null for active awards.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selectionMethod rdf:type rdf:Property ;
    rdfs:label 'Selection Method' ;
    rdfs:comment 'Method by which the award recipient was determined: media_vote (sports writers/journalists), player_vote (peer selection), fan_vote (public voting), committee (selection panel), statistical (objective metric threshold), automatic (rule-based, e.g., consecutive games streak).' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statMetricValue rdf:type rdf:Property ;
    rdfs:label 'Stat Metric Value' ;
    rdfs:comment 'Numeric value of the primary statistical metric at the time of the achievement (e.g., WAR = 8.2, ERA = 1.74, QBR = 94.5, consecutive games = 2,632). Supports record-tracking and historical analytics.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statisticalContext rdf:type rdf:Property ;
    rdfs:label 'Statistical Context' ;
    rdfs:comment 'Free-text or structured description of the key performance statistics that supported or defined this achievement (e.g., \'45 TDs, 4,800 passing yards, QBR 92.3\', \'0.342 BA, 52 HR, 1.2 WAR\', \'38 goals, 12 assists, Ballon d\'Or\'). Supports broadcast storytelling and content production.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalVotesCast rdf:type rdf:Property ;
    rdfs:label 'Total Votes Cast' ;
    rdfs:comment 'Total number of votes cast in the award selection process. Used to calculate vote share percentage for analytics and broadcast storytelling. Null for non-voting selection methods.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:voteCountReceived rdf:type rdf:Property ;
    rdfs:label 'Vote Count Received' ;
    rdfs:comment 'Number of votes received by the athlete in the award selection process where voting applies (media vote, player vote, fan vote). Null for non-voting selection methods. Supports voting analytics and fan engagement reporting.' ;
    rdfs:domain ind:AwardHonor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:wadaComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Wada Compliance Status' ;
    rdfs:comment 'Anti-doping compliance status of the athlete at the time of the award as verified against World Anti-Doping Agency (WADA) records. Disqualified status triggers award revocation workflows. Critical for league governance and regulatory reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:combineResultId rdf:type rdf:Property ;
    rdfs:label 'Combine Result Id' ;
    rdfs:comment 'Unique surrogate identifier for each combine evaluation result record in the athlete domain. Primary key for the combine_result data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CombineResult .

ind:combineComplianceDopingTestId rdf:type rdf:Property ;
    rdfs:label 'Combine Compliance Doping Test Id' ;
    rdfs:comment 'Foreign key linking to compliance.doping_test. Business justification: Pre-draft combine drug testing results must be traceable to the authoritative compliance.doping_test record. combine_result stores drug_test_status as denormalized text. Role prefix \'combine_\' disting' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DopingTest .

ind:combineEventId rdf:type rdf:Property ;
    rdfs:label 'Combine Event Id' ;
    rdfs:comment 'Reference to the combine event (e.g., NFL Scouting Combine, NBA Draft Combine, MLB Draft Combine) at which this evaluation was conducted.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CombineEvent .

ind:draftId rdf:type rdf:Property ;
    rdfs:label 'Draft Id' ;
    rdfs:comment 'Foreign key linking to league.draft. Business justification: Combine results are produced specifically for a draft class and directly inform draft board rankings, pick valuations, and salary slot assignments. Linking to league.draft enables draft-day analytics,' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Draft .

ind:prospectId rdf:type rdf:Property ;
    rdfs:label 'Prospect Id' ;
    rdfs:comment 'Reference to the prospective athlete (draft-eligible player) who participated in the combine evaluation. Links to the athlete/prospect master record.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Prospect .

ind:scoutEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Scout Employee Id' ;
    rdfs:comment 'Reference to the scout or evaluator who conducted or oversaw this combine evaluation session.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:armLengthInches rdf:type rdf:Property ;
    rdfs:label 'Arm Length Inches' ;
    rdfs:comment 'Measured arm length of the prospect in inches from the shoulder to the tip of the middle finger. Used in NFL combine evaluations for offensive and defensive linemen, cornerbacks, and wide receivers.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:athleticismGrade rdf:type rdf:Property ;
    rdfs:label 'Athleticism Grade' ;
    rdfs:comment 'Qualitative athleticism grade assigned by the evaluating scout based on the overall combine performance. Provides a standardized categorical assessment used in draft board discussions and scouting reports.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchPressReps rdf:type rdf:Property ;
    rdfs:label 'Bench Press Reps' ;
    rdfs:comment 'Number of repetitions the prospect completed on the bench press at the standard combine weight (225 lbs for NFL). Measures upper-body strength and muscular endurance.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bodyFatPct rdf:type rdf:Property ;
    rdfs:label 'Body Fat Pct' ;
    rdfs:comment 'Measured body fat percentage of the prospect at the time of the combine. Used in conditioning assessments and positional fit analysis. Classified as confidential due to sensitivity of health-related physical data.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadJumpInches rdf:type rdf:Property ;
    rdfs:label 'Broad Jump Inches' ;
    rdfs:comment 'Measured distance of the prospect\'s standing broad jump in inches. Evaluates lower-body power and explosiveness in a horizontal plane, complementing the vertical jump measurement.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drillsCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Drills Completed Flag' ;
    rdfs:comment 'Indicates whether the prospect completed all required drills and measurements for their position group at this combine event. True = all required drills completed; False = one or more drills were skipped or not completed.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eligibilityConfirmed rdf:type rdf:Property ;
    rdfs:label 'Eligibility Confirmed' ;
    rdfs:comment 'Indicates whether the prospect\'s draft eligibility has been formally confirmed by the league governing body at the time of this combine evaluation. True = eligibility confirmed; False = eligibility pending or under review.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evaluationStatus rdf:type rdf:Property ;
    rdfs:label 'Evaluation Status' ;
    rdfs:comment 'Current lifecycle status of the combine result record. \'pending\' = scheduled but not yet conducted; \'in_progress\' = partially completed; \'completed\' = all measurements and drills finalized; \'voided\' = invalidated due to injury, protest, or administrative error; \'incomplete\' = prospect withdrew or was unable to finish.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fortyYardDashSec rdf:type rdf:Property ;
    rdfs:label 'Forty Yard Dash Sec' ;
    rdfs:comment 'Electronically timed result of the prospect\'s 40-yard dash in seconds. The primary speed and acceleration metric at the NFL Scouting Combine; also used in other league combines. Lower values indicate greater speed.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:handSizeInches rdf:type rdf:Property ;
    rdfs:label 'Hand Size Inches' ;
    rdfs:comment 'Measured hand size of the prospect in inches (tip of thumb to tip of pinky with hand spread). Particularly relevant for NFL quarterbacks and NBA players; influences ball-handling and grip assessments.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:heightInches rdf:type rdf:Property ;
    rdfs:label 'Height Inches' ;
    rdfs:comment 'Measured height of the prospect in inches at the time of the combine, recorded without shoes per standard combine protocol. Critical physical measurement used in position eligibility assessments and draft grade calculations.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hudlEvaluationReference rdf:type rdf:Property ;
    rdfs:label 'Hudl Evaluation Reference' ;
    rdfs:comment 'External identifier assigned by the SportsCode/Hudl performance analytics platform to this combine evaluation session. Used for cross-referencing video analysis, drill footage, and evaluation reports in the source system.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryDescription rdf:type rdf:Property ;
    rdfs:label 'Injury Description' ;
    rdfs:comment 'Brief description of any injury or physical limitation the prospect was managing at the time of the combine. Populated only when injury_flag is True. Classified as confidential due to health-related sensitivity.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryFlag rdf:type rdf:Property ;
    rdfs:label 'Injury Flag' ;
    rdfs:comment 'Indicates whether the prospect was performing under a known injury or physical limitation at the time of the combine evaluation. True = prospect had a documented injury or limitation; False = no known injury. Affects interpretation of test results and draft risk assessment.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laneAgilitySec rdf:type rdf:Property ;
    rdfs:label 'Lane Agility Sec' ;
    rdfs:comment 'Timed result of the lane agility drill in seconds, administered at the NBA Draft Combine. Measures lateral quickness, defensive footwork, and change-of-direction speed specific to basketball.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxVerticalJumpInches rdf:type rdf:Property ;
    rdfs:label 'Max Vertical Jump Inches' ;
    rdfs:comment 'Measured height of the prospect\'s maximum vertical jump with a running approach (max vertical) in inches, as administered at the NBA Draft Combine. Distinct from the standing vertical jump.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionDrillNotes rdf:type rdf:Property ;
    rdfs:label 'Position Drill Notes' ;
    rdfs:comment 'Free-text evaluator notes describing the prospect\'s performance in position-specific drills. Captures qualitative observations not reflected in numeric scores, such as technique, football IQ, and coachability.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionDrillScore rdf:type rdf:Property ;
    rdfs:label 'Position Drill Score' ;
    rdfs:comment 'Normalized score (0–100 scale) derived from position-specific drills administered during the combine (e.g., route running for WR, ball-handling for PG, fielding for SS). Scored by evaluators using SportsCode/Hudl platform rubrics.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prospectPosition rdf:type rdf:Property ;
    rdfs:label 'Prospect Position' ;
    rdfs:comment 'The primary playing position of the prospect at the time of the combine evaluation (e.g., QB, WR, PG, SF, SP, C, LW). Determines which position-specific drills are administered and which composite scoring weights apply. [ENUM-REF-CANDIDATE: QB|RB|WR|TE|OL|DL|LB|DB|K|P|PG|SG|SF|PF|C|SP|RP|C|1B|2B|3B|SS|OF|LW|RW|D|G — promote to reference product]' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoutOverallGrade rdf:type rdf:Property ;
    rdfs:label 'Scout Overall Grade' ;
    rdfs:comment 'Overall draft round grade assigned by the evaluating scout based on the combine performance and physical profile. Represents the scout\'s projection of where the prospect should be selected in the draft. Feeds draft board rankings and contract slot value calculations.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shuttleDrillSec rdf:type rdf:Property ;
    rdfs:label 'Shuttle Drill Sec' ;
    rdfs:comment 'Timed result of the 5-10-5 short shuttle drill (also known as the pro agility shuttle) in seconds. Measures lateral quickness, change of direction, and body control.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sixtyYardDashSec rdf:type rdf:Property ;
    rdfs:label 'Sixty Yard Dash Sec' ;
    rdfs:comment 'Timed result of the 60-yard dash in seconds, the primary speed metric used at the MLB Draft Combine for position players. Measures straight-line speed relevant to baserunning and outfield range.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:skippedDrills rdf:type rdf:Property ;
    rdfs:label 'Skipped Drills' ;
    rdfs:comment 'Comma-separated list of drill names that the prospect did not complete during the combine (e.g., \'40_yard_dash, bench_press\'). Populated only when drills_completed_flag is False. Used to flag incomplete records in draft analysis.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standingReachInches rdf:type rdf:Property ;
    rdfs:label 'Standing Reach Inches' ;
    rdfs:comment 'Measured standing reach of the prospect in inches (highest point reachable with one arm fully extended while standing flat-footed). Key measurement for NBA Draft Combine positional evaluation.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tenYardSplitSec rdf:type rdf:Property ;
    rdfs:label 'Ten Yard Split Sec' ;
    rdfs:comment 'Electronically timed split at the 10-yard mark during the 40-yard dash, measured in seconds. Indicates initial burst and explosion off the line, a key metric for evaluating first-step quickness.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:threeConeDrillSec rdf:type rdf:Property ;
    rdfs:label 'Three Cone Drill Sec' ;
    rdfs:comment 'Timed result of the L-shaped 3-cone drill in seconds. Evaluates a prospect\'s ability to change direction at speed, hip flexibility, and body control. Key metric for skill position players.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:verticalJumpInches rdf:type rdf:Property ;
    rdfs:label 'Vertical Jump Inches' ;
    rdfs:comment 'Measured height of the prospect\'s vertical jump in inches (standing vertical leap). Assesses lower-body explosiveness and athleticism. Used across NFL, NBA, and MLB combines.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:videoSessionReference rdf:type rdf:Property ;
    rdfs:label 'Video Session Reference' ;
    rdfs:comment 'Identifier for the video recording session in SportsCode/Hudl capturing the prospect\'s combine drills and measurements. Enables retrieval of drill footage for review by scouts, coaches, and front office personnel.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightLbs rdf:type rdf:Property ;
    rdfs:label 'Weight Lbs' ;
    rdfs:comment 'Measured body weight of the prospect in pounds at the time of the combine. Used in position fit analysis, injury risk modeling, and contract slot value calculations.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wingspanInches rdf:type rdf:Property ;
    rdfs:label 'Wingspan Inches' ;
    rdfs:comment 'Measured wingspan (fingertip to fingertip with arms fully extended) of the prospect in inches. Key physical attribute for basketball and football positional evaluation, particularly for defensive backs, wide receivers, and forwards.' ;
    rdfs:domain ind:CombineResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:athleteContractId rdf:type rdf:Property ;
    rdfs:label 'Athlete Contract Id' ;
    rdfs:comment 'Unique surrogate identifier for the athlete contract record in the lakehouse silver layer. Primary key for the athlete.contract data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteContract .

ind:cbaAgreementId rdf:type rdf:Property ;
    rdfs:label 'Cba Agreement Id' ;
    rdfs:comment 'Foreign key linking to league.cba_agreement. Business justification: Every player contract is governed by a specific CBA version — salary minimums, cap hit calculations, grievance procedures, and option rules all derive from the governing CBA. Compliance audits and arb' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CbaAgreement .

ind:corporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Corporate Entity Id' ;
    rdfs:comment 'Foreign key linking to legal.corporate_entity. Business justification: Athlete contracts are executed between the athlete and a specific corporate entity (franchise holding company, league subsidiary). The contract has franchise_id but the legal contracting party is the ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:insurancePolicyId rdf:type rdf:Property ;
    rdfs:label 'Insurance Policy Id' ;
    rdfs:comment 'Foreign key linking to legal.insurance_policy. Business justification: High-value athlete contracts are backed by contract-specific insurance policies (career-ending injury, disability, key-man coverage). Legal and risk teams must link contracts to their insurance polici' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsurancePolicy .

ind:policyId rdf:type rdf:Property ;
    rdfs:label 'Policy Id' ;
    rdfs:comment 'Foreign key linking to compliance.policy. Business justification: Athlete contracts reference CBA version and compliance requirements. Linking to compliance.policy enables contract compliance audits, CBA version tracking, and regulatory obligation mapping — a named ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:successfactorsPositionId rdf:type rdf:Property ;
    rdfs:label 'Successfactors Position Id' ;
    rdfs:comment 'The position identifier in SAP SuccessFactors HCM corresponding to the roster slot filled by this contract. Links payroll processing, benefits administration, and talent management workflows.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Position .

ind:taxJurisdictionId rdf:type rdf:Property ;
    rdfs:label 'Tax Jurisdiction Id' ;
    rdfs:comment 'Foreign key linking to finance.tax_jurisdiction. Business justification: Athlete contracts require jock tax withholding calculations by jurisdiction. The tax_jurisdiction table has jock_tax_rate_pct and athlete_compensation_taxable_flag. Finance and payroll teams link cont' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TaxJurisdiction .

ind:aav rdf:type rdf:Property ;
    rdfs:label 'Aav' ;
    rdfs:comment 'The Annual Average Value (AAV) of the contract, calculated as total contract value divided by contract years. Industry-standard metric used for salary cap comparisons, market benchmarking, and broadcast commentary.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseSalaryYear1 rdf:type rdf:Property ;
    rdfs:label 'Base Salary Year1' ;
    rdfs:comment 'The base salary amount for the first year of the contract term. Used for payroll processing in SAP SuccessFactors and salary cap hit calculation in year one.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capHit rdf:type rdf:Property ;
    rdfs:label 'Cap Hit' ;
    rdfs:comment 'The amount of the team\'s salary cap consumed by this contract in the current league year, calculated per CBA rules (base salary + prorated signing bonus + likely incentives). Critical for roster construction and financial planning.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractNumber rdf:type rdf:Property ;
    rdfs:label 'Contract Number' ;
    rdfs:comment 'Externally-known, league-assigned or organization-assigned unique contract reference number used in official filings, league submissions, and SAP S/4HANA SD sales contract documents.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractStatus rdf:type rdf:Property ;
    rdfs:label 'Contract Status' ;
    rdfs:comment 'Current lifecycle state of the contract. Active: currently in force. Expired: term has concluded. Voided: nullified due to breach, failed physical, or mutual agreement. Restructured: terms modified via amendment. Suspended: temporarily inactive due to disciplinary action or league sanction.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractType rdf:type rdf:Property ;
    rdfs:label 'Contract Type' ;
    rdfs:comment 'Classification of the contract by CBA-defined category. Rookie contracts apply to newly drafted players; veteran contracts apply to experienced players; max contracts represent the maximum allowable salary under the CBA; minimum contracts are the league-mandated floor; two-way contracts span both the primary league and a developmental league. [ENUM-REF-CANDIDATE: rookie|veteran|max|minimum|two_way|10_day|exhibit_10|rest_of_season — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deadCapAmount rdf:type rdf:Property ;
    rdfs:label 'Dead Cap Amount' ;
    rdfs:comment 'The salary cap charge that remains against the team\'s cap after the athlete is released or traded, representing unearned prorated signing bonus and guaranteed money. Used for financial planning and roster management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:freeAgencyClass rdf:type rdf:Property ;
    rdfs:label 'Free Agency Class' ;
    rdfs:comment 'The athlete\'s free agency classification upon contract expiration. UFA (Unrestricted Free Agent): no team rights retained. RFA (Restricted Free Agent): team retains right of first refusal. ERFA (Exclusive Rights Free Agent): team holds exclusive negotiating rights. Franchise tag and transition tag are team-applied designations preventing free agency.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:freeAgencyOpenDate rdf:type rdf:Property ;
    rdfs:label 'Free Agency Open Date' ;
    rdfs:comment 'The date on which the athlete becomes eligible to negotiate with other teams as a free agent, as defined by the league calendar and CBA provisions.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:guaranteedAmount rdf:type rdf:Property ;
    rdfs:label 'Guaranteed Amount' ;
    rdfs:comment 'The portion of the total contract value that is fully guaranteed regardless of injury, performance, or termination. Critical for salary cap dead money calculations and financial liability reporting.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:negotiationStatus rdf:type rdf:Property ;
    rdfs:label 'Negotiation Status' ;
    rdfs:comment 'Current status of free agency or contract renewal negotiations for this athlete. Tracks the negotiation lifecycle from initial contact through signing or expiration of negotiating rights.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Nil Agreement Flag' ;
    rdfs:comment 'Indicates whether this contract includes or is associated with a Name, Image and Likeness (NIL) agreement granting the team or league rights to use the athlete\'s identity for commercial purposes.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noCutClause rdf:type rdf:Property ;
    rdfs:label 'No Cut Clause' ;
    rdfs:comment 'Indicates whether the contract contains a no-cut clause preventing the team from releasing the athlete. True = no-cut clause present; False = standard release provisions apply.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noTradeClause rdf:type rdf:Property ;
    rdfs:label 'No Trade Clause' ;
    rdfs:comment 'Indicates whether the contract contains a no-trade clause (NTC) preventing the team from trading the athlete without their consent. True = NTC present; False = no restriction. Critical for roster transaction processing.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optionDeadline rdf:type rdf:Property ;
    rdfs:label 'Option Deadline' ;
    rdfs:comment 'The deadline date by which the option-holding party must notify the other party of their intent to exercise or decline the option year(s). Missing this deadline typically results in automatic option declination.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:optionType rdf:type rdf:Property ;
    rdfs:label 'Option Type' ;
    rdfs:comment 'Specifies which party holds the right to exercise the option year(s): team option (team decides), player option (athlete decides), mutual option (both parties must agree), or vesting option (automatically vests upon meeting performance thresholds).' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optionYears rdf:type rdf:Property ;
    rdfs:label 'Option Years' ;
    rdfs:comment 'Number of option years appended to the base contract term. Option years may be exercisable by the team, the player, or mutually, as specified in the contract. Zero if no option years exist.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:performanceBonusEligible rdf:type rdf:Property ;
    rdfs:label 'Performance Bonus Eligible' ;
    rdfs:comment 'Indicates whether the contract includes performance-based incentive bonuses (e.g., statistical thresholds, award bonuses, playoff bonuses). True = performance bonuses are included in the contract terms.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performanceBonusMax rdf:type rdf:Property ;
    rdfs:label 'Performance Bonus Max' ;
    rdfs:comment 'The maximum total amount the athlete can earn in performance-based incentive bonuses over the life of the contract. Used for salary cap likely/unlikely incentive classification per CBA rules.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:physicalDate rdf:type rdf:Property ;
    rdfs:label 'Physical Date' ;
    rdfs:comment 'The date on which the athlete underwent the pre-contract medical examination. Used for compliance tracking and contract contingency resolution.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:physicalPassed rdf:type rdf:Property ;
    rdfs:label 'Physical Passed' ;
    rdfs:comment 'Indicates whether the athlete successfully passed the team\'s pre-contract medical examination. Contracts are typically contingent on passing the physical; failure may result in contract voiding or restructuring.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualifyingOfferAmount rdf:type rdf:Property ;
    rdfs:label 'Qualifying Offer Amount' ;
    rdfs:comment 'The one-year salary amount tendered to a Restricted Free Agent (RFA) as a qualifying offer, which preserves the team\'s right of first refusal. Calculated per CBA formula based on prior year salary.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightOfFirstRefusal rdf:type rdf:Property ;
    rdfs:label 'Right Of First Refusal' ;
    rdfs:comment 'Indicates whether the team retains the Right of First Refusal (ROFR) to match any offer sheet signed by the athlete with another team. Applicable to Restricted Free Agents (RFA). True = ROFR applies.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rosterStatus rdf:type rdf:Property ;
    rdfs:label 'Roster Status' ;
    rdfs:comment 'The athlete\'s current roster designation under this contract, which affects salary cap treatment and payroll processing. [ENUM-REF-CANDIDATE: active_roster|practice_squad|injured_reserve|suspended|exempt|waived|non_football_injury|physically_unable_to_perform|reserve — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapContractDocNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Contract Doc Number' ;
    rdfs:comment 'The document number assigned to this contract in SAP S/4HANA SD module for financial obligation tracking, payroll integration with SAP SuccessFactors, and accounts payable processing. Serves as the cross-system integration key.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signingBonus rdf:type rdf:Property ;
    rdfs:label 'Signing Bonus' ;
    rdfs:comment 'One-time bonus paid to the athlete upon contract execution. For salary cap purposes, signing bonuses are typically prorated across the contract years. Processed via SAP SuccessFactors Payroll and recorded in SAP S/4HANA FI.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signingDate rdf:type rdf:Property ;
    rdfs:label 'Signing Date' ;
    rdfs:comment 'The calendar date on which the athlete and team executed (signed) the contract. This is the principal business event timestamp for the contract lifecycle, distinct from the effective start date.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:signingDeadline rdf:type rdf:Property ;
    rdfs:label 'Signing Deadline' ;
    rdfs:comment 'The deadline by which the athlete must sign a new contract or tender to remain with the team or enter free agency. Defined by CBA and league calendar (e.g., franchise tag signing deadline).' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalValue rdf:type rdf:Property ;
    rdfs:label 'Total Value' ;
    rdfs:comment 'The gross total compensation value of the contract across all years, including base salary, signing bonus, and performance incentives as stated in the contract. Expressed in the contract currency. Used for salary cap accounting and financial obligation reporting in SAP S/4HANA FI/CO.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wadaCompliant rdf:type rdf:Property ;
    rdfs:label 'Wada Compliant' ;
    rdfs:comment 'Indicates whether the contract includes WADA anti-doping compliance clauses and the athlete has acknowledged their obligations under the World Anti-Doping Agency (WADA) code. True = WADA compliance clause present and acknowledged.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:years rdf:type rdf:Property ;
    rdfs:label 'Years' ;
    rdfs:comment 'Total number of years covered by the contract term, including option years if exercised. Used for AAV calculation, salary cap projection, and roster planning.' ;
    rdfs:domain ind:AthleteContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:draftSelectionId rdf:type rdf:Property ;
    rdfs:label 'Draft Selection Id' ;
    rdfs:comment 'Unique surrogate identifier for each draft selection record in the lakehouse silver layer. Primary key for the draft_selection data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DraftSelection .

ind:announcementAssetId rdf:type rdf:Property ;
    rdfs:label 'Announcement Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: Draft pick broadcast announcement: each draft selection generates an official broadcast asset (commissioner announcement clip, pick card video). draft_selection.broadcast_pick_announced_by is a denorm' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:contractTemplateId rdf:type rdf:Property ;
    rdfs:label 'Contract Template Id' ;
    rdfs:comment 'Foreign key linking to legal.contract_template. Business justification: Draft selections trigger standard rookie contracts drafted from CBA-mandated legal templates with slot values. Legal compliance requires tracking which template version governed each draft signing for' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContractTemplate .

ind:draftClassDraftId rdf:type rdf:Property ;
    rdfs:label 'Draft Class Draft Id' ;
    rdfs:comment 'Reference to the draft class cohort record grouping all athletes eligible for a specific draft year and league. Supports draft class analytics and historical comparisons.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Draft .

ind:originalTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Original Team Franchise Id' ;
    rdfs:comment 'Reference to the team that originally owned this draft pick before any trade. Null if the pick was never traded. Critical for trade history and compensatory pick tracking.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:primaryDraftFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Primary Draft Franchise Id' ;
    rdfs:comment 'Reference to the franchise or club that exercised this draft pick and holds the rights to the selected athlete. May differ from original_team_id if the pick was traded.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:wbsElementId rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Id' ;
    rdfs:comment 'Foreign key linking to finance.wbs_element. Business justification: Draft signing bonuses (actual_signing_bonus, signing_slot_value on draft_selection) are capitalized and tracked via WBS elements in SAP for capital expenditure reporting. Finance teams assign each dra' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WbsElement .

ind:actualSigningBonus rdf:type rdf:Property ;
    rdfs:label 'Actual Signing Bonus' ;
    rdfs:comment 'The actual signing bonus amount in USD agreed upon in the athlete\'s rookie contract. May differ from signing_slot_value due to negotiations within CBA-permitted ranges. Used for salary cap accounting and financial reporting.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:athleteCollege rdf:type rdf:Property ;
    rdfs:label 'Athlete College' ;
    rdfs:comment 'Name of the college, university, or prior professional club from which the athlete was drafted. Used for draft class analytics, alumni tracking, and broadcast storytelling content.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:athleteNationality rdf:type rdf:Property ;
    rdfs:label 'Athlete Nationality' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code representing the athlete\'s nationality at the time of the draft. Relevant for international player rules, visa requirements, and global broadcast analytics.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:athletePosition rdf:type rdf:Property ;
    rdfs:label 'Athlete Position' ;
    rdfs:comment 'The primary playing position of the athlete at the time of the draft (e.g., QB, WR, PG, SP, ST). Position is sport-specific and drives positional scarcity analytics and roster construction. [ENUM-REF-CANDIDATE: QB|WR|RB|TE|OL|DL|LB|DB|K|P|PG|SG|SF|PF|C|SP|RP|SS|GK|DEF|MID|FWD — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionalPickTerms rdf:type rdf:Property ;
    rdfs:label 'Conditional Pick Terms' ;
    rdfs:comment 'Free-text description of the conditions governing a conditional pick (e.g., \'Becomes 1st round if team makes playoffs; otherwise 2nd round\'). Populated only when is_conditional_pick is True.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractOptionYears rdf:type rdf:Property ;
    rdfs:label 'Contract Option Years' ;
    rdfs:comment 'Number of team option years available beyond the base rookie contract term (e.g., 5th-year option in NFL for 1st-round picks). Null if no option applies under the CBA.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractYears rdf:type rdf:Property ;
    rdfs:label 'Contract Years' ;
    rdfs:comment 'Number of years in the standard rookie contract associated with this draft selection as defined by the applicable CBA (e.g., 4-year rookie deal in NFL, 2+2 in NBA). Drives roster planning and cap projection.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:draftDate rdf:type rdf:Property ;
    rdfs:label 'Draft Date' ;
    rdfs:comment 'Calendar date on which this specific pick was made during the draft event. Multi-day drafts (e.g., NFL Draft spans 3 days) require day-level precision for scheduling and broadcast.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityYear rdf:type rdf:Property ;
    rdfs:label 'Eligibility Year' ;
    rdfs:comment 'The year in which the athlete first became eligible for the draft under league rules (e.g., 3 years post-high school for NFL, 1 year post-high school for NBA). Used for eligibility compliance and age-based analytics.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isCompensatoryPick rdf:type rdf:Property ;
    rdfs:label 'Is Compensatory Pick' ;
    rdfs:comment 'Indicates whether this pick was awarded as a compensatory selection by the league office, typically for losing qualifying free agents. Compensatory picks have specific CBA rules on tradability.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isConditionalPick rdf:type rdf:Property ;
    rdfs:label 'Is Conditional Pick' ;
    rdfs:comment 'Indicates whether this pick was subject to conditions (e.g., round changes based on player performance or team standings) at the time of the trade agreement.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTradedPick rdf:type rdf:Property ;
    rdfs:label 'Is Traded Pick' ;
    rdfs:comment 'Indicates whether this draft pick was acquired through a trade from another team. True when selecting_team_id differs from original_team_id. Critical for trade value analytics and salary cap management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalClearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Medical Clearance Status' ;
    rdfs:comment 'Medical clearance status resulting from the team\'s pre-draft physical examination. \'cleared\' = fully fit; \'conditional\' = cleared with noted conditions; \'not_cleared\' = failed physical; \'pending\' = exam not yet completed. Impacts signing decision and contract terms.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallPickNumber rdf:type rdf:Property ;
    rdfs:label 'Overall Pick Number' ;
    rdfs:comment 'The absolute sequential pick number across all rounds of the draft (e.g., pick 33 is the first pick of round 2 in a 32-team league). Primary ranking metric for draft analytics and historical comparisons.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pickNumberInRound rdf:type rdf:Property ;
    rdfs:label 'Pick Number In Round' ;
    rdfs:comment 'The sequential pick number within the specific round (e.g., pick 3 in round 2). Combined with round_number to identify the pick within its round context.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pickType rdf:type rdf:Property ;
    rdfs:label 'Pick Type' ;
    rdfs:comment 'Classification of the draft pick by its origin. \'standard\' = regular draft order pick; \'compensatory\' = awarded by league for losing free agents; \'supplemental\' = special draft outside normal cycle; \'conditional\' = pick contingent on performance conditions; \'traded\' = pick acquired via trade.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preDraftGrade rdf:type rdf:Property ;
    rdfs:label 'Pre Draft Grade' ;
    rdfs:comment 'Numerical scouting grade assigned to the athlete prior to the draft on a standardized scale (e.g., 0.00–100.00 or 1.00–8.00 per NFL scouting convention). Reflects overall prospect evaluation by the team\'s scouting department.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preDraftRanking rdf:type rdf:Property ;
    rdfs:label 'Pre Draft Ranking' ;
    rdfs:comment 'The consensus pre-draft ranking of the athlete among all eligible prospects, as published by the league or a recognized scouting service prior to the draft. Used to measure draft value (reach vs. value picks) and scouting accuracy analytics.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:roundNumber rdf:type rdf:Property ;
    rdfs:label 'Round Number' ;
    rdfs:comment 'The round within the draft in which this selection was made (e.g., 1 for first round, 7 for seventh round in NFL Draft). Determines salary slot value per CBA and signing bonus expectations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:selectionCode rdf:type rdf:Property ;
    rdfs:label 'Selection Code' ;
    rdfs:comment 'Externally-known business identifier for this draft pick in the format LEAGUE-YEAR-ROUND-PICK (e.g., NFL-2024-R1-P01). Used in league communications, broadcast graphics, and official records.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selectionStatus rdf:type rdf:Property ;
    rdfs:label 'Selection Status' ;
    rdfs:comment 'Current lifecycle status of the draft selection. \'announced\' = pick made but contract not yet signed; \'signed\' = athlete under contract; \'unsigned\' = deadline passed without signing; \'voided\' = selection invalidated; \'traded_rights\' = negotiating rights traded post-draft; \'forfeited\' = pick forfeited due to league penalty.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Selection Timestamp' ;
    rdfs:comment 'Precise date and time when the pick was officially announced and recorded during the draft event. Used for broadcast sequencing, official league records, and audit trail.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:signedDate rdf:type rdf:Property ;
    rdfs:label 'Signed Date' ;
    rdfs:comment 'The date on which the athlete officially signed the rookie contract with the selecting team. Null if unsigned. Triggers salary cap activation and roster registration.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:signingSlotValue rdf:type rdf:Property ;
    rdfs:label 'Signing Slot Value' ;
    rdfs:comment 'The CBA-mandated signing bonus slot value in USD assigned to this pick based on its round and overall pick number. Governs the maximum signing bonus a team may offer without penalty. Critical for salary cap management and EBITDA reporting.' ;
    rdfs:domain ind:DraftSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wadaClearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Wada Clearance Status' ;
    rdfs:comment 'Anti-doping clearance status of the athlete at the time of the draft per World Anti-Doping Agency (WADA) and league anti-doping program requirements. \'cleared\' = no violations; \'pending\' = under review; \'suspended\' = serving ban; \'ineligible\' = permanently ineligible.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityStatusId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Status Id' ;
    rdfs:comment 'Unique surrogate identifier for each eligibility status record in the athlete domain. Primary key for the eligibility_status data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EligibilityStatus .

ind:exemptionId rdf:type rdf:Property ;
    rdfs:label 'Exemption Id' ;
    rdfs:comment 'Foreign key linking to compliance.exemption. Business justification: Therapeutic Use Exemptions (TUEs) directly determine athlete eligibility for competition. eligibility_status must reference compliance.exemption to confirm an active TUE permits otherwise-prohibited s' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Exemption .

ind:incidentReportId rdf:type rdf:Property ;
    rdfs:label 'Incident Report Id' ;
    rdfs:comment 'Chain-of-custody reference to the originating doping test, conduct violation, or disciplinary incident that triggered this eligibility event. Null for non-disciplinary eligibility types.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IncidentReport .

ind:litigationCaseId rdf:type rdf:Property ;
    rdfs:label 'Litigation Case Id' ;
    rdfs:comment 'Foreign key linking to legal.litigation_case. Business justification: Eligibility rulings (doping bans, transfer denials, age disputes) are frequently challenged in litigation or arbitration. Linking eligibility_status to litigation_case enables legal teams to track act' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LitigationCase .

ind:suspensionRecordId rdf:type rdf:Property ;
    rdfs:label 'Suspension Record Id' ;
    rdfs:comment 'Foreign key linking to athlete.suspension_record. Business justification: An eligibility status change is frequently triggered by a disciplinary suspension. The eligibility_status table currently stores denormalized suspension data (suspension_type, suspension_length, viola' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SuspensionRecord .

ind:ageEligibilityVerified rdf:type rdf:Property ;
    rdfs:label 'Age Eligibility Verified' ;
    rdfs:comment 'Indicates whether the athlete\'s age has been formally verified against the minimum or maximum age requirements of the applicable competition or governing body (e.g., FIFA U-17 age verification, NBA draft age rule).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amateurProfessionalStatus rdf:type rdf:Property ;
    rdfs:label 'Amateur Professional Status' ;
    rdfs:comment 'Indicates whether the athlete holds amateur, professional, student-athlete, or Name Image and Likeness (NIL) eligible status under the applicable governing body rules. Drives eligibility for specific competitions and NIL agreement compliance.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealFiledDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Date' ;
    rdfs:comment 'Date on which the athlete or governing body formally filed an appeal against this eligibility determination. Null if no appeal has been filed.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealOutcomeDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Outcome Date' ;
    rdfs:comment 'Date on which the appellate body (CAS, league arbitration panel) issued its final ruling on the appeal. Null if appeal is still pending or no appeal was filed.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealOutcomeNotes rdf:type rdf:Property ;
    rdfs:label 'Appeal Outcome Notes' ;
    rdfs:comment 'Summary of the appellate body\'s ruling, including any modification to the original sanction (e.g., reduction in suspension length, fine adjustment, full exoneration). Null if no appeal or outcome not yet determined.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealStatus rdf:type rdf:Property ;
    rdfs:label 'Appeal Status' ;
    rdfs:comment 'Current status of any appeal filed against this eligibility determination. Tracks the appeal lifecycle from filing through final outcome at CAS or relevant appellate body.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastClearanceFlag rdf:type rdf:Property ;
    rdfs:label 'Broadcast Clearance Flag' ;
    rdfs:comment 'Indicates whether this athlete\'s eligibility status has been cleared for broadcast rights purposes. Ineligible or suspended athletes may require content redaction or rights clearance review for broadcast and OTT distribution.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:decisionDate rdf:type rdf:Property ;
    rdfs:label 'Decision Date' ;
    rdfs:comment 'Date on which the governing body or issuing authority formally rendered the eligibility determination or disciplinary decision. Distinct from effective_date, which is when the restriction begins.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eligibilityReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Eligibility Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned by the governing body or league office to uniquely identify this eligibility determination. Used for cross-system reconciliation and official correspondence.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityType rdf:type rdf:Property ;
    rdfs:label 'Eligibility Type' ;
    rdfs:comment 'Classification of the eligibility event. Covers all participation-granting and participation-restricting categories including registration, amateur/professional status, visa and work permit, age eligibility, and all disciplinary actions. [ENUM-REF-CANDIDATE: registration|amateur_status|professional_status|visa_work_permit|age_eligibility|disciplinary_suspension|doping_suspension|conduct_violation|game_misconduct_ban|cba_disciplinary|transfer_clearance|reinstatement — promote to reference product]' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expiryDate rdf:type rdf:Property ;
    rdfs:label 'Expiry Date' ;
    rdfs:comment 'The date on which this eligibility status expires or the restriction is lifted. Null for indefinite suspensions or open-ended eligibility grants. Critical for automated reinstatement workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financialPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Financial Penalty Amount' ;
    rdfs:comment 'Monetary fine levied against the athlete as part of the disciplinary action, expressed in the currency defined by penalty_currency_code. Zero or null for eligibility events with no financial penalty.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gameDayEligible rdf:type rdf:Property ;
    rdfs:label 'Game Day Eligible' ;
    rdfs:comment 'Real-time flag indicating whether the athlete is eligible to participate in the next scheduled game or event as of the current date. Derived from effective_date, expiry_date, and eligibility_status for operational game-day roster verification.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gamesRemaining rdf:type rdf:Property ;
    rdfs:label 'Games Remaining' ;
    rdfs:comment 'Number of games still to be served in a game-based suspension as of the last update. Decremented each time the athlete sits out a qualifying game. Null for day-based or indefinite suspensions.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:issuingAuthority rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority' ;
    rdfs:comment 'Name of the specific authority, panel, or office that issued the eligibility determination or disciplinary decision (e.g., \'NFL Commissioner Office\', \'WADA Independent Tribunal\', \'FIFA Disciplinary Committee\', \'CAS Panel\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Penalty Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the financial penalty amount (e.g., USD, EUR, GBP). Null when no financial penalty applies.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyPaid rdf:type rdf:Property ;
    rdfs:label 'Penalty Paid' ;
    rdfs:comment 'Indicates whether the athlete has satisfied the financial penalty associated with this disciplinary eligibility event. True when payment is confirmed; False when outstanding. Null when no financial penalty applies.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:registrationDate rdf:type rdf:Property ;
    rdfs:label 'Registration Date' ;
    rdfs:comment 'Date on which the athlete was formally registered with the league or governing body under this eligibility record.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registrationNumber rdf:type rdf:Property ;
    rdfs:label 'Registration Number' ;
    rdfs:comment 'Official registration number assigned by the league or governing body confirming the athlete\'s registration as a professional or amateur competitor. Required for roster submission and game-day eligibility verification.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementConditions rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Conditions' ;
    rdfs:comment 'Free-text description of the specific conditions the athlete must satisfy to be reinstated to eligibility (e.g., completion of drug treatment program, payment of fine, community service hours, counselling). Null when no conditions are required.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Date' ;
    rdfs:comment 'Actual date on which the athlete was formally reinstated to eligible status following completion of a suspension or satisfaction of reinstatement conditions. Null if not yet reinstated.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:restrictionScope rdf:type rdf:Property ;
    rdfs:label 'Restriction Scope' ;
    rdfs:comment 'Defines the competitive scope of an eligibility restriction — whether the athlete is banned from all competitions globally, only league competitions, only international fixtures, a specific event, or is subject to a training ban.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleCollectionDate rdf:type rdf:Property ;
    rdfs:label 'Sample Collection Date' ;
    rdfs:comment 'Date on which the biological sample (urine, blood) was collected from the athlete as part of the anti-doping testing process. Establishes chain of custody for WADA adjudication. Null for non-doping eligibility events.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transferClearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Transfer Clearance Status' ;
    rdfs:comment 'Status of the international transfer certificate (ITC) or transfer clearance required for athletes moving between clubs or leagues across national associations. Applicable for FIFA-governed sports and international transfers.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visaExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Visa Expiry Date' ;
    rdfs:comment 'Expiry date of the athlete\'s visa or work permit. Triggers compliance alerts when approaching expiry to prevent inadvertent ineligibility due to lapsed immigration documentation.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:visaIssuingCountry rdf:type rdf:Property ;
    rdfs:label 'Visa Issuing Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the nation that issued the visa or work permit. Used for international transfer compliance and immigration tracking.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visaPermitNumber rdf:type rdf:Property ;
    rdfs:label 'Visa Permit Number' ;
    rdfs:comment 'Official visa or work permit document number issued by the relevant immigration authority, applicable when eligibility_type is visa_work_permit. Required for international athlete transfers and cross-border competition clearance.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:whereaboutsCompliant rdf:type rdf:Property ;
    rdfs:label 'Whereabouts Compliant' ;
    rdfs:comment 'Indicates whether the athlete is currently compliant with WADA whereabouts filing requirements under the Registered Testing Pool (RTP). False triggers a whereabouts failure flag that may lead to a doping violation.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:whereaboutsFailureCount rdf:type rdf:Property ;
    rdfs:label 'Whereabouts Failure Count' ;
    rdfs:comment 'Cumulative count of whereabouts filing failures or missed tests within the rolling 12-month window. Three failures within 12 months constitutes an anti-doping rule violation under WADA Code Article 2.4.' ;
    rdfs:domain ind:EligibilityStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:freeAgencyStatusId rdf:type rdf:Property ;
    rdfs:label 'Free Agency Status Id' ;
    rdfs:comment 'Unique surrogate identifier for the free agency status record. Primary key for the athlete.free_agency_status data product in the Databricks Silver Layer.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FreeAgencyStatus .

ind:primaryFreeAthleteContractId rdf:type rdf:Property ;
    rdfs:label 'Primary Free Athlete Contract Id' ;
    rdfs:comment 'Reference to the athlete\'s most recently expired or expiring contract that triggered this free agency status record.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteContract .

ind:primaryFreeFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Primary Free Franchise Id' ;
    rdfs:comment 'Reference to the team that last held the athlete\'s rights prior to free agency. Used to determine right of first refusal and tender obligations.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:signingTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Signing Team Franchise Id' ;
    rdfs:comment 'Reference to the team that ultimately signed the athlete upon conclusion of free agency. Null until negotiation_status reaches \'signed\'. Used for transaction reporting and broadcast ticker updates.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:transactionWindowId rdf:type rdf:Property ;
    rdfs:label 'Transaction Window Id' ;
    rdfs:comment 'Foreign key linking to league.transaction_window. Business justification: Free agency signings must occur within valid transaction windows. Linking free_agency_status to the applicable transaction_window enables signing deadline enforcement, window compliance validation, an' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransactionWindow .

ind:accruedSeasons rdf:type rdf:Property ;
    rdfs:label 'Accrued Seasons' ;
    rdfs:comment 'The number of CBA-qualifying seasons the athlete has accrued with the league. Determines free agency eligibility tier (e.g., UFA vs RFA vs ERFA) and vesting rights. Calculated per CBA accrued season definition.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:arbitrationEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Arbitration Eligible Flag' ;
    rdfs:comment 'Indicates whether the athlete is eligible for salary arbitration in lieu of free agency, based on years of service and CBA thresholds. Particularly relevant in MLB where Super Two eligibility applies.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:arbitrationFilingDeadline rdf:type rdf:Property ;
    rdfs:label 'Arbitration Filing Deadline' ;
    rdfs:comment 'The deadline by which the athlete or team must file for salary arbitration. Null when arbitration_eligible_flag is False. Governed by the applicable CBA calendar.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capHoldAmount rdf:type rdf:Property ;
    rdfs:label 'Cap Hold Amount' ;
    rdfs:comment 'The salary cap charge held against the original team\'s cap space while the athlete remains unsigned as a free agent. Calculated per CBA formula based on qualifying offer or prior contract value. Expressed in USD. Relevant for roster and cap planning.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capHoldReleasedFlag rdf:type rdf:Property ;
    rdfs:label 'Cap Hold Released Flag' ;
    rdfs:comment 'Indicates whether the original team has formally renounced the athlete\'s rights, releasing the associated salary cap hold. Once renounced, the athlete becomes an unrestricted free agent and the team loses all rights.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:compensationTier rdf:type rdf:Property ;
    rdfs:label 'Compensation Tier' ;
    rdfs:comment 'The draft pick compensation tier assigned to this free agent based on prior contract value and performance metrics. Determines the round and value of compensatory draft picks owed. None: no compensation required; Tier 1-3: graduated compensation levels; Qualifying: qualifying offer compensation applies.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:draftPickCompensationFlag rdf:type rdf:Property ;
    rdfs:label 'Draft Pick Compensation Flag' ;
    rdfs:comment 'Indicates whether the signing team is required to provide draft pick compensation to the original team upon signing this athlete. Applicable in leagues with compensatory pick systems (e.g., NFL compensatory picks, MLB Type A/B free agents).' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:faOpenDate rdf:type rdf:Property ;
    rdfs:label 'Fa Open Date' ;
    rdfs:comment 'The calendar date on which the athlete\'s free agency period officially opens and the athlete becomes eligible to negotiate with other teams. Governed by the applicable CBA calendar.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:faReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Fa Reference Number' ;
    rdfs:comment 'Externally-known business identifier for this free agency transaction, formatted as FA-{LEAGUE}-{YEAR}-{SEQUENCE}. Used in league transaction reporting, broadcast transaction tickers, and CBA compliance filings.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:faType rdf:type rdf:Property ;
    rdfs:label 'Fa Type' ;
    rdfs:comment 'Classification of the athlete\'s free agency designation under the applicable CBA. Unrestricted Free Agent (UFA) may sign with any team; Restricted Free Agent (RFA) allows original team right of first refusal; Exclusive Rights Free Agent (ERFA) may only negotiate with original team; Franchise Tag and Transition Tag are one-year designations applied by the original team; Waiver indicates release via waiver wire. [ENUM-REF-CANDIDATE: unrestricted|restricted|exclusive_rights|franchise_tag|transition_tag|waiver — promote to reference product]' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:franchiseTagAmount rdf:type rdf:Property ;
    rdfs:label 'Franchise Tag Amount' ;
    rdfs:comment 'The one-year salary value assigned to the athlete under a franchise tag designation. Calculated as the average of the top-N salaries at the athlete\'s position or a percentage of the salary cap, per CBA formula. Expressed in USD.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:injuryReserveFlag rdf:type rdf:Property ;
    rdfs:label 'Injury Reserve Flag' ;
    rdfs:comment 'Indicates whether the athlete was on the injured reserve list at the time of contract expiration. May affect free agency timeline, qualifying offer calculations, and salary cap treatment under CBA provisions.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueFilingTimestamp rdf:type rdf:Property ;
    rdfs:label 'League Filing Timestamp' ;
    rdfs:comment 'The precise date and time at which the free agency transaction was officially filed with the league office. Used for compliance verification, transaction ordering, and broadcast reporting. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:offerSheetReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Offer Sheet Received Flag' ;
    rdfs:comment 'Indicates whether the athlete has received and signed an offer sheet from a team other than the original team. Triggers the original team\'s right of first refusal window when right_of_first_refusal_flag is True.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optOutDeadline rdf:type rdf:Property ;
    rdfs:label 'Opt Out Deadline' ;
    rdfs:comment 'The deadline by which the athlete must formally notify the team of their decision to exercise or decline their player option. Null when player_option_flag is False.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:playerOptionFlag rdf:type rdf:Property ;
    rdfs:label 'Player Option Flag' ;
    rdfs:comment 'Indicates whether the athlete holds a player option on their contract for the upcoming season. If the athlete opts out, they enter free agency; if they exercise the option, they remain under contract.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorTeamOptionFlag rdf:type rdf:Property ;
    rdfs:label 'Prior Team Option Flag' ;
    rdfs:comment 'Indicates whether the original team holds a club option or team option on the athlete\'s services for the upcoming season, which if exercised would prevent free agency. Distinct from franchise and transition tag designations.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renouncementDate rdf:type rdf:Property ;
    rdfs:label 'Renouncement Date' ;
    rdfs:comment 'The date on which the original team formally renounced the athlete\'s rights, releasing the cap hold and converting the athlete to an unrestricted free agent. Null when cap_hold_released_flag is False.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rightOfFirstRefusalFlag rdf:type rdf:Property ;
    rdfs:label 'Right Of First Refusal Flag' ;
    rdfs:comment 'Indicates whether the original team retains the right of first refusal to match any offer sheet signed by the athlete with another team. True for restricted free agents where the original team has tendered a qualifying offer. Governed by CBA provisions.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rofrExercisedFlag rdf:type rdf:Property ;
    rdfs:label 'Rofr Exercised Flag' ;
    rdfs:comment 'Indicates whether the original team formally exercised its right of first refusal to match the offer sheet and retain the athlete. Null or False when no offer sheet was received or ROFR was waived.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rofrResponseDeadline rdf:type rdf:Property ;
    rdfs:label 'Rofr Response Deadline' ;
    rdfs:comment 'The date by which the original team must exercise or waive its right of first refusal after receiving a signed offer sheet from the athlete. Null when offer_sheet_received_flag is False.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tagDesignationDeadline rdf:type rdf:Property ;
    rdfs:label 'Tag Designation Deadline' ;
    rdfs:comment 'The deadline by which the original team must formally apply a franchise tag or transition tag designation to the athlete. Applicable only when fa_type is franchise_tag or transition_tag.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tenderAmount rdf:type rdf:Property ;
    rdfs:label 'Tender Amount' ;
    rdfs:comment 'The one-year salary amount tendered by the original team for an exclusive rights or restricted free agent. Distinct from the qualifying offer amount; represents the minimum the team must offer to retain rights. Expressed in USD.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tenderDeadline rdf:type rdf:Property ;
    rdfs:label 'Tender Deadline' ;
    rdfs:comment 'The date by which the original team must submit a qualifying offer or tender to retain restricted free agency rights over the athlete. Failure to tender by this date converts the athlete to an unrestricted free agent.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transitionTagAmount rdf:type rdf:Property ;
    rdfs:label 'Transition Tag Amount' ;
    rdfs:comment 'The one-year salary value assigned to the athlete under a transition tag designation. Typically lower than the franchise tag amount and calculated as the average of the top-N salaries at the athlete\'s position per CBA formula. Expressed in USD.' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yearsOfService rdf:type rdf:Property ;
    rdfs:label 'Years Of Service' ;
    rdfs:comment 'Total years of professional service credited to the athlete across all teams in the league. Used alongside accrued seasons for salary arbitration eligibility and pension vesting. Expressed as a decimal (e.g., 3.17 years).' ;
    rdfs:domain ind:FreeAgencyStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:injuryRecordId rdf:type rdf:Property ;
    rdfs:label 'Injury Record Id' ;
    rdfs:comment 'Unique surrogate identifier for each athlete injury or medical event record in the system. Primary key for the injury_record data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InjuryRecord .

ind:insuranceClaimId rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Id' ;
    rdfs:comment 'Foreign key linking to legal.insurance_claim. Business justification: Athlete injuries trigger insurance claims (workers compensation, disability, liability). The injury_record has workers_comp_claim_number as a denormalized string and insurance_reserve_amount but no FK' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuranceClaim .

ind:priorInjuryRecordId rdf:type rdf:Property ;
    rdfs:label 'Prior Injury Record Id' ;
    rdfs:comment 'Self-referencing identifier linking this recurrent injury to the original injury record for the same body part. Populated only when is_recurrence is True. Enables injury recurrence chain analysis and longitudinal athlete health tracking.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InjuryRecord .

ind:securityIncidentId rdf:type rdf:Property ;
    rdfs:label 'Security Incident Id' ;
    rdfs:comment 'Foreign key linking to security.security_incident. Business justification: When an athlete injury is caused by or concurrent with a security incident (on-field assault, crowd intrusion, altercation), medical and security teams must cross-reference records for insurance claim' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SecurityIncident .

ind:actualRtpDate rdf:type rdf:Property ;
    rdfs:label 'Actual Rtp Date' ;
    rdfs:comment 'Actual date on which the athlete was medically cleared and returned to full competitive play. Distinct from expected_rtp_date; the variance between these dates is a key metric for medical staff performance and recovery protocol effectiveness.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bodyPart rdf:type rdf:Property ;
    rdfs:label 'Body Part' ;
    rdfs:comment 'Standardized anatomical body part or region affected by the injury (e.g., \'left_knee\', \'right_shoulder\', \'lumbar_spine\', \'hamstring_right\'). Used for injury pattern analytics, performance risk modeling, and broadcast injury reporting. [ENUM-REF-CANDIDATE: promote to reference product with full anatomical taxonomy]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bodySide rdf:type rdf:Property ;
    rdfs:label 'Body Side' ;
    rdfs:comment 'Laterality of the injured body part indicating which side of the body is affected. \'bilateral\' applies when both sides are involved; \'central\' for midline structures (spine, head); \'not_applicable\' for systemic conditions or illnesses.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastDisclosureApproved rdf:type rdf:Property ;
    rdfs:label 'Broadcast Disclosure Approved' ;
    rdfs:comment 'Indicates whether the athlete and team have approved disclosure of this injury for broadcast and media communications. When True, injury status and expected RTP may be shared with broadcast partners and media. Supports DTC fan engagement and broadcast content production.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastInjuryNote rdf:type rdf:Property ;
    rdfs:label 'Broadcast Injury Note' ;
    rdfs:comment 'Approved public-facing injury description for use in broadcast, media, and fan communications. Sanitized version of the clinical description that omits protected health information. Populated only when broadcast_disclosure_approved is True. Used by Dalet Galaxy broadcast workflow for on-air injury reporting.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseNumber rdf:type rdf:Property ;
    rdfs:label 'Case Number' ;
    rdfs:comment 'Externally-known alphanumeric case reference assigned by the team medical staff system at the time of injury intake. Used for cross-referencing with insurance claims, OSHA logs, and league medical reporting. Format: INJ-YYYY-NNNNNN.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concussionProtocolTriggered rdf:type rdf:Property ;
    rdfs:label 'Concussion Protocol Triggered' ;
    rdfs:comment 'Indicates whether the league\'s mandatory concussion evaluation and graduated return-to-play protocol was triggered for this injury. Drives specific compliance tracking requirements distinct from standard injury management. Required for league concussion protocol reporting.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:daysLostActual rdf:type rdf:Property ;
    rdfs:label 'Days Lost Actual' ;
    rdfs:comment 'Actual number of calendar days the athlete was unavailable for competition, calculated upon return to play or case closure. Used for OSHA recordkeeping (days away from work), insurance settlement, and injury analytics benchmarking.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysLostEstimated rdf:type rdf:Property ;
    rdfs:label 'Days Lost Estimated' ;
    rdfs:comment 'Physician-estimated number of calendar days the athlete is expected to be unavailable for competition due to the injury. Used for roster planning, insurance claim valuation, and broadcast availability reporting. Distinct from actual days lost which is calculated from actual RTP date.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expectedRtpDate rdf:type rdf:Property ;
    rdfs:label 'Expected Rtp Date' ;
    rdfs:comment 'Physician-projected date on which the athlete is expected to return to full competitive play (Return-to-Play / RTP). Used for roster management, broadcast scheduling, and fan communications. May be updated as recovery progresses.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:icd10Code rdf:type rdf:Property ;
    rdfs:label 'Icd10 Code' ;
    rdfs:comment 'International Classification of Diseases, 10th Revision (ICD-10-CM) diagnosis code assigned by the treating physician. Standardizes injury classification for insurance claims, OSHA reporting, league medical databases, and cross-team analytics. Required for workers\' compensation and insurance claim processing.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryDate rdf:type rdf:Property ;
    rdfs:label 'Injury Date' ;
    rdfs:comment 'Calendar date on which the injury or medical event was first sustained or identified. Principal business event date for the injury lifecycle. Used for OSHA recordkeeping, insurance claim filing windows, and roster eligibility calculations.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:injuryLocation rdf:type rdf:Property ;
    rdfs:label 'Injury Location' ;
    rdfs:comment 'Setting or context in which the injury occurred. Distinguishes game-time injuries from practice, training facility, or travel-related incidents. Affects OSHA recordability determination, workers\' compensation eligibility, and league reporting obligations.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryMechanism rdf:type rdf:Property ;
    rdfs:label 'Injury Mechanism' ;
    rdfs:comment 'Mechanism by which the injury was sustained. \'contact\' indicates collision with another player or object; \'non_contact\' indicates injury without external contact (e.g., ACL tear during cutting); \'overexertion\' indicates fatigue or training load-related; \'environmental\' indicates field/court surface or weather-related cause. Critical for OSHA incident classification and injury prevention analytics.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryType rdf:type rdf:Property ;
    rdfs:label 'Injury Type' ;
    rdfs:comment 'High-level clinical classification of the injury or medical event. \'acute\' refers to sudden-onset traumatic injuries; \'chronic\' refers to long-standing conditions; \'overuse\' refers to repetitive stress injuries; \'concussion\' is tracked separately per league concussion protocol requirements. [ENUM-REF-CANDIDATE: acute|chronic|overuse|illness|concussion|fracture|laceration|dislocation|sprain|strain — promote to reference product]' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Insurance Reserve Amount' ;
    rdfs:comment 'Financial reserve amount (in USD) set aside by the team\'s insurance carrier for this injury claim. Represents the estimated total cost of the claim including medical treatment, salary continuation, and rehabilitation. Used for financial planning and SAP S/4HANA FI/CO reserve posting.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:irDesignation rdf:type rdf:Property ;
    rdfs:label 'Ir Designation' ;
    rdfs:comment 'Formal league roster designation for the injured athlete per Collective Bargaining Agreement (CBA) rules. \'ir_standard\' = standard Injured Reserve placement; \'ir_return_designated\' = IR with designation to return (allows one return per season); \'ir_non_football\' = injury unrelated to sport; \'pup_list\' = Physically Unable to Perform list (pre-season). Drives roster count compliance and salary cap implications.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isOshaRecordable rdf:type rdf:Property ;
    rdfs:label 'Is Osha Recordable' ;
    rdfs:comment 'Indicates whether this injury meets OSHA recordability criteria under 29 CFR 1904 (i.e., results in days away from work, restricted duty, medical treatment beyond first aid, loss of consciousness, or diagnosis of a significant condition). Required for OSHA 300 Log annual reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRecurrence rdf:type rdf:Property ;
    rdfs:label 'Is Recurrence' ;
    rdfs:comment 'Indicates whether this injury is a recurrence of a previously documented injury to the same body part. Recurrent injuries are tracked separately for medical analytics, contract risk assessment, and insurance underwriting purposes.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWadaReportable rdf:type rdf:Property ;
    rdfs:label 'Is Wada Reportable' ;
    rdfs:comment 'Indicates whether this medical event requires reporting to the World Anti-Doping Agency (WADA), typically when treatment involves substances on the WADA Prohibited List requiring a Therapeutic Use Exemption (TUE). Critical for anti-doping compliance.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWorkersCompClaim rdf:type rdf:Property ;
    rdfs:label 'Is Workers Comp Claim' ;
    rdfs:comment 'Indicates whether a workers\' compensation insurance claim has been filed for this injury. Triggers coordination with the insurance and finance teams for claim processing and reserve setting.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalStaffNotes rdf:type rdf:Property ;
    rdfs:label 'Medical Staff Notes' ;
    rdfs:comment 'Confidential clinical notes from the team\'s medical staff including athletic trainers, physical therapists, and team physicians documenting daily progress, treatment adjustments, and rehabilitation milestones. Restricted to authorized medical personnel per HIPAA and CBA medical privacy provisions.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedDate rdf:type rdf:Property ;
    rdfs:label 'Reported Date' ;
    rdfs:comment 'Date on which the injury was formally reported to team medical staff or league operations. May differ from injury_date for delayed-onset conditions or injuries initially unreported. Critical for OSHA recordkeeping compliance windows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rtpClearanceStage rdf:type rdf:Property ;
    rdfs:label 'Rtp Clearance Stage' ;
    rdfs:comment 'Current stage in the graduated Return-to-Play (RTP) protocol as defined by league medical standards and CBA. Tracks progression from initial rest through limited activity, non-contact practice, full practice, and final medical clearance. Critical for concussion protocol compliance.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityGrade rdf:type rdf:Property ;
    rdfs:label 'Severity Grade' ;
    rdfs:comment 'Clinical severity classification of the injury based on expected time loss and functional impact. \'minor\' = <7 days; \'moderate\' = 7-28 days; \'severe\' = >28 days; \'career_threatening\' = potential permanent impact on playing career. Used for insurance valuation, roster planning, and broadcast communications.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surgeryDate rdf:type rdf:Property ;
    rdfs:label 'Surgery Date' ;
    rdfs:comment 'Date on which surgical procedure was performed, if applicable. Null when surgery_required is False. Used as a key milestone in recovery timeline planning and insurance claim documentation.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surgeryRequired rdf:type rdf:Property ;
    rdfs:label 'Surgery Required' ;
    rdfs:comment 'Indicates whether surgical intervention is required or has been performed as part of the treatment protocol. Surgical cases typically have significantly longer recovery timelines and higher insurance claim values.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:treatingPhysicianReference rdf:type rdf:Property ;
    rdfs:label 'Treating Physician Reference' ;
    rdfs:comment 'Reference to the licensed medical professional (team physician, orthopedic surgeon, or specialist) who diagnosed and is managing the athlete\'s treatment protocol.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:treatmentProtocol rdf:type rdf:Property ;
    rdfs:label 'Treatment Protocol' ;
    rdfs:comment 'Structured description of the prescribed medical treatment plan including surgical intervention, physical therapy regimen, medication management, and rehabilitation milestones as documented by the treating physician. Supports medical staff coordination and insurance documentation.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tueReference rdf:type rdf:Property ;
    rdfs:label 'Tue Reference' ;
    rdfs:comment 'Reference number for the WADA Therapeutic Use Exemption (TUE) application or approval associated with this injury\'s treatment protocol. Populated when is_wada_reportable is True and treatment involves a prohibited substance. Required for anti-doping compliance documentation.' ;
    rdfs:domain ind:InjuryRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalCapId rdf:type rdf:Property ;
    rdfs:label 'International Cap Id' ;
    rdfs:comment 'Unique surrogate identifier for each international cap appearance record in the athlete talent management system. Primary key for the international_cap data product.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:competitionTournamentId rdf:type rdf:Property ;
    rdfs:label 'Competition Tournament Id' ;
    rdfs:comment 'Reference to the sanctioned international competition in which this cap was earned (e.g., FIFA World Cup Qualifier, Olympic Games, Six Nations, FIBA World Cup).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Tournament .

ind:internationalFederationId rdf:type rdf:Property ;
    rdfs:label 'International Federation Id' ;
    rdfs:comment 'Foreign key linking to league.international_federation. Business justification: International caps are governed by the relevant international federation (FIFA, FIBA, World Rugby). Federation FK enables release window management, eligibility verification under federation rules, an' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InternationalFederation .

ind:matchFixtureId rdf:type rdf:Property ;
    rdfs:label 'Match Fixture Id' ;
    rdfs:comment 'Reference to the specific match or fixture record in the event domain for which this international cap was awarded.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fixture .

ind:nationalTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'National Team Franchise Id' ;
    rdfs:comment 'Reference to the national team or international representative squad the athlete appeared for during this cap.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:tournamentId rdf:type rdf:Property ;
    rdfs:label 'Tournament Id' ;
    rdfs:comment 'Reference to the sanctioned international competition in which this cap was earned (e.g., FIFA World Cup Qualifier, Olympic Games, Six Nations, FIBA World Cup).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Tournament .

ind:whereaboutsFilingId rdf:type rdf:Property ;
    rdfs:label 'Whereabouts Filing Id' ;
    rdfs:comment 'Foreign key linking to compliance.whereabouts_filing. Business justification: WADA whereabouts compliance requires that competition locations in whereabouts filings match actual international cap records. This FK enables reconciliation between reported competition locations and' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WhereaboutsFiling .

ind:ageAtCap rdf:type rdf:Property ;
    rdfs:label 'Age At Cap' ;
    rdfs:comment 'Age of the athlete in whole years at the time of this international cap appearance. Derived at ingestion from athlete date of birth and match date; stored for analytics efficiency and age-eligibility compliance checks (e.g., U21, U23 tournament eligibility).' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assistsRecorded rdf:type rdf:Property ;
    rdfs:label 'Assists Recorded' ;
    rdfs:comment 'Number of goal assists or scoring assists credited to the athlete in this international match. Sport-specific definition applies (e.g., final pass before goal in football, assist in basketball). Used for performance analytics and broadcast content.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capNumber rdf:type rdf:Property ;
    rdfs:label 'Cap Number' ;
    rdfs:comment 'Sequential cap number representing the athletes cumulative count of international appearances for this national team at the time of this match. Cap number 1 denotes debut. Used for milestone tracking and broadcast content.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capStatus rdf:type rdf:Property ;
    rdfs:label 'Cap Status' ;
    rdfs:comment 'Current lifecycle status of this international cap record. \'confirmed\' indicates the governing body has officially ratified the appearance; \'provisional\' indicates the match result is pending official confirmation; \'disputed\' indicates an eligibility challenge is under review; \'withdrawn\' indicates the cap was rescinded (e.g., due to doping violation or eligibility fraud); \'pending_ratification\' indicates awaiting governing body sign-off.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitionName rdf:type rdf:Property ;
    rdfs:label 'Competition Name' ;
    rdfs:comment 'Full official name of the international competition or tournament in which this cap was earned (e.g., \'FIFA World Cup 2026 Qualifier\', \'Paris 2024 Olympic Games\', \'Six Nations Championship 2024\', \'International Friendly\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitionType rdf:type rdf:Property ;
    rdfs:label 'Competition Type' ;
    rdfs:comment 'Classification of the international competition category. Determines cap eligibility weight and official recognition by governing bodies. [ENUM-REF-CANDIDATE: world_cup_qualifier|world_cup|olympic_games|continental_championship|regional_qualifier|friendly|invitational — promote to reference product]' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goalsScored rdf:type rdf:Property ;
    rdfs:label 'Goals Scored' ;
    rdfs:comment 'Number of goals scored by the athlete in this international match. Applicable to football (FIFA), hockey, and other goal-based sports. Zero if no goals scored. Used for career statistics and broadcast content.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:homeAwayIndicator rdf:type rdf:Property ;
    rdfs:label 'Home Away Indicator' ;
    rdfs:comment 'Indicates whether the athletes national team played as the home side, away side, or at a neutral venue for this international match. Relevant for performance analytics and scheduling.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCaptain rdf:type rdf:Property ;
    rdfs:label 'Is Captain' ;
    rdfs:comment 'Indicates whether the athlete served as captain of the national team during this match (True = captained the side). Used for leadership tracking, broadcast content, and career milestone reporting.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDebut rdf:type rdf:Property ;
    rdfs:label 'Is Debut' ;
    rdfs:comment 'Indicates whether this cap represents the athletes first-ever international appearance for this national team (True = debut cap). Used for milestone tracking, broadcast content, and historical records.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchDate rdf:type rdf:Property ;
    rdfs:label 'Match Date' ;
    rdfs:comment 'Calendar date on which the international match was played. Used for eligibility age calculations, career timeline analysis, and historical reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:matchNotes rdf:type rdf:Property ;
    rdfs:label 'Match Notes' ;
    rdfs:comment 'Free-text field for recording notable events, context, or annotations related to this international cap appearance (e.g., \'Scored winning penalty in shootout\', \'Played despite injury\', \'Match abandoned due to weather — cap ratified by FIFA\'). Used by talent management staff and broadcast content teams.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchResult rdf:type rdf:Property ;
    rdfs:label 'Match Result' ;
    rdfs:comment 'Outcome of the international match from the perspective of the athletes national team (win, loss, draw, or no_result for abandoned/voided matches). Used for win/loss record tracking and performance analytics.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minutesPlayed rdf:type rdf:Property ;
    rdfs:label 'Minutes Played' ;
    rdfs:comment 'Total number of minutes the athlete was on the field of play during this international match. Used for workload management, performance analytics (SportsCode/Hudl), and injury risk modelling.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nationalityBasis rdf:type rdf:Property ;
    rdfs:label 'Nationality Basis' ;
    rdfs:comment 'The legal or regulatory basis under which the athlete was eligible to represent this national team (e.g., birth nationality, parentage, naturalisation, residency qualification, or governing body association eligibility rule). Critical for eligibility compliance and dispute resolution.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opponentCountryCode rdf:type rdf:Property ;
    rdfs:label 'Opponent Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 three-letter country code of the opposing national team (e.g., BRA, DEU, NZL). Enables standardised geographic analysis and cross-sport reporting.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opponentScore rdf:type rdf:Property ;
    rdfs:label 'Opponent Score' ;
    rdfs:comment 'Final score (goals, points, or runs as applicable to the sport) achieved by the opposing national team in this match. Used for match result analysis and historical records.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:opponentTeamName rdf:type rdf:Property ;
    rdfs:label 'Opponent Team Name' ;
    rdfs:comment 'Official name of the opposing national team or international representative side in this match (e.g., \'Brazil\', \'Germany\', \'New Zealand All Blacks\'). Used for historical match records and broadcast content.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointsScored rdf:type rdf:Property ;
    rdfs:label 'Points Scored' ;
    rdfs:comment 'Total points scored by the athlete in this international match. Applicable to points-based sports such as rugby (tries, conversions, penalties), basketball (FIBA), American football (NFL/international), and athletics. Null for sports where goals_scored is the primary metric.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionPlayed rdf:type rdf:Property ;
    rdfs:label 'Position Played' ;
    rdfs:comment 'The playing position the athlete occupied during this international match (e.g., \'Goalkeeper\', \'Centre-Back\', \'Quarterback\', \'Point Guard\', \'Fly-Half\'). Position naming is sport-specific. Used for performance analytics via SportsCode/Hudl and broadcast content.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redCards rdf:type rdf:Property ;
    rdfs:label 'Red Cards' ;
    rdfs:comment 'Number of red cards or dismissals received by the athlete during this international match. A red card typically results in suspension for subsequent matches. Used for disciplinary tracking and CBA/governing body compliance.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shirtNumber rdf:type rdf:Property ;
    rdfs:label 'Shirt Number' ;
    rdfs:comment 'Jersey or shirt number worn by the athlete during this international match. Used for broadcast graphics, historical records, and fan engagement content.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceSystemReference rdf:type rdf:Property ;
    rdfs:label 'Source System Reference' ;
    rdfs:comment 'The identifier or record reference from the originating operational system of record (e.g., SportsCode/Hudl performance record ID, SAP SuccessFactors talent record reference, or governing body official match report reference number). Used for data lineage and reconciliation in the Databricks Silver Layer.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substitutionMinute rdf:type rdf:Property ;
    rdfs:label 'Substitution Minute' ;
    rdfs:comment 'The match minute at which the athlete was substituted on or off the field. Null if the athlete was a starter who played the full match or did not participate. Used for precise minutes-played calculation and performance analytics.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:substitutionType rdf:type rdf:Property ;
    rdfs:label 'Substitution Type' ;
    rdfs:comment 'Indicates the athletes participation role in the match: whether they started, came on as a substitute, were substituted off, were named but unused, or did not participate. Affects minutes played calculation and cap eligibility rules in some governing bodies.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamScore rdf:type rdf:Property ;
    rdfs:label 'Team Score' ;
    rdfs:comment 'Final score (goals, points, or runs as applicable to the sport) achieved by the athletes national team in this match. Used for match result analysis and historical records.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:venueCountryCode rdf:type rdf:Property ;
    rdfs:label 'Venue Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 three-letter country code of the country where the match venue is located. Used for travel compliance, tax jurisdiction, and geographic reporting.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venueName rdf:type rdf:Property ;
    rdfs:label 'Venue Name' ;
    rdfs:comment 'Name of the stadium or arena where this international match was played (e.g., \'Wembley Stadium\', \'Maracanã\', \'Madison Square Garden\'). Used for venue operations reporting and broadcast content.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wadaTestConducted rdf:type rdf:Property ;
    rdfs:label 'Wada Test Conducted' ;
    rdfs:comment 'Indicates whether the athlete was subject to a WADA-compliant anti-doping test in connection with this international match (True = test conducted). Used for anti-doping compliance tracking and regulatory reporting to WADA and governing bodies.' ;
    rdfs:domain ind:InternationalCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:yellowCards rdf:type rdf:Property ;
    rdfs:label 'Yellow Cards' ;
    rdfs:comment 'Number of yellow cards or cautions received by the athlete during this international match. Used for disciplinary tracking, suspension management, and compliance with governing body regulations.' ;
    rdfs:domain ind:Athlete ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brandPartnerSponsorId rdf:type rdf:Property ;
    rdfs:label 'Brand Partner Sponsor Id' ;
    rdfs:comment 'Reference to the brand, company, or sponsor entity entering into the NIL or endorsement agreement with the athlete.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Sponsor .

ind:dealId rdf:type rdf:Property ;
    rdfs:label 'Deal Id' ;
    rdfs:comment 'Foreign key linking to sponsorship.deal. Business justification: NIL compliance and conflict management: NIL agreements must be cross-referenced against the sponsor\'s master league/team deal to enforce league_sponsor_conflict_flag and category exclusivity. Complian' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Deal .

ind:ipPortfolioId rdf:type rdf:Property ;
    rdfs:label 'Ip Portfolio Id' ;
    rdfs:comment 'Foreign key linking to legal.ip_portfolio. Business justification: NIL agreements grant commercial usage rights over athlete IP (name, image, likeness) registered in the IP portfolio. Legal teams must link NIL deals to the specific IP portfolio entry to enforce usage' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IpPortfolio .

ind:agreementNumber rdf:type rdf:Property ;
    rdfs:label 'Agreement Number' ;
    rdfs:comment 'Externally-known business identifier for the agreement, used in correspondence with athletes, agents, brand partners, and compliance bodies. Follows the format NIL-{YEAR}-{SEQUENCE}.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementStatus rdf:type rdf:Property ;
    rdfs:label 'Agreement Status' ;
    rdfs:comment 'Current lifecycle state of the NIL or endorsement agreement. Drives compliance reporting, broadcast rights clearance, and commercial valuation workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualValueAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Value Amount' ;
    rdfs:comment 'Annualized value of the agreement used for ARR (Annual Recurring Revenue) reporting, athlete commercial valuation, and financial planning in Workday Adaptive Planning.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appearanceCount rdf:type rdf:Property ;
    rdfs:label 'Appearance Count' ;
    rdfs:comment 'Number of personal appearances (events, activations, media days) the athlete is contractually obligated to make for the brand partner over the agreement term.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvalStatus rdf:type rdf:Property ;
    rdfs:label 'Approval Status' ;
    rdfs:comment 'Current approval state of this specific SKU under the NIL agreement. Tracks the per-SKU approval workflow independently of the master agreement status — a single agreement may have some SKUs approved and others pending review.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoRenewalFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Flag' ;
    rdfs:comment 'Indicates whether the agreement contains an automatic renewal clause that extends the term unless either party provides notice of non-renewal before the expiration date.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastUsageRights rdf:type rdf:Property ;
    rdfs:label 'Broadcast Usage Rights' ;
    rdfs:comment 'Indicates whether the brand partner has rights to use the athlete\'s name, image, or likeness in broadcast advertising (TV, OTT, RSN). Critical for broadcast rights clearance workflows in Dalet Galaxy.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cbaComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Cba Compliance Status' ;
    rdfs:comment 'Status of the agreement\'s compliance with the applicable CBA (Collective Bargaining Agreement) endorsement and sponsor conflict provisions. Not applicable for amateur/collegiate NIL deals.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealCategory rdf:type rdf:Property ;
    rdfs:label 'Deal Category' ;
    rdfs:comment 'Classification of the agreement type. NIL-amateur and NIL-collegiate are subject to NCAA/conference NIL policies; professional endorsement and licensing deals are governed by CBA and league sponsor conflict rules.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealValueAmount rdf:type rdf:Property ;
    rdfs:label 'Deal Value Amount' ;
    rdfs:comment 'Total gross contractual value of the NIL or endorsement agreement in the agreed currency. Represents the full deal value over the contract term before any performance incentives.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:digitalUsageRights rdf:type rdf:Property ;
    rdfs:label 'Digital Usage Rights' ;
    rdfs:comment 'Indicates whether the brand partner has rights to use the athlete\'s name, image, or likeness in digital advertising (web, OTT streaming, DTC platforms, IPTV).' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disclosureDate rdf:type rdf:Property ;
    rdfs:label 'Disclosure Date' ;
    rdfs:comment 'The date on which the NIL agreement was formally disclosed to the applicable governing body (NCAA, conference office, or league). Required for compliance reporting.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disclosureStatus rdf:type rdf:Property ;
    rdfs:label 'Disclosure Status' ;
    rdfs:comment 'Compliance disclosure status of the agreement with applicable governing bodies (NCAA, conference, league). Tracks whether the required disclosure has been filed, is pending, or is overdue.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeResolutionMechanism rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Mechanism' ;
    rdfs:comment 'Contractually agreed mechanism for resolving disputes arising from the agreement. CAS arbitration applies to international sports disputes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusivityScope rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Scope' ;
    rdfs:comment 'Defines the exclusivity terms of the agreement. Category-exclusive prevents the athlete from endorsing competing brands in the same product category. League-exclusive restricts endorsements conflicting with official league sponsors.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusivityTerritory rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Territory' ;
    rdfs:comment 'Comma-separated list of ISO 3166-1 alpha-3 country codes defining the geographic territory in which exclusivity applies. Supports global multi-market rights management.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionDate rdf:type rdf:Property ;
    rdfs:label 'Execution Date' ;
    rdfs:comment 'The date on which all parties formally signed and executed the agreement. May differ from the effective date if the agreement is backdated or post-dated.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'The date on which the NIL or endorsement agreement expires. Null for open-ended agreements. Used for renewal tracking and compliance monitoring.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:governingLawCountry rdf:type rdf:Property ;
    rdfs:label 'Governing Law Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction whose laws govern the agreement. Determines applicable privacy regulations (GDPR, CCPA) and dispute resolution forums.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inVenueUsageRights rdf:type rdf:Property ;
    rdfs:label 'In Venue Usage Rights' ;
    rdfs:comment 'Indicates whether the brand partner has rights to use the athlete\'s name, image, or likeness in venue signage, jumbotron displays, or in-venue activations.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incentiveValueAmount rdf:type rdf:Property ;
    rdfs:label 'Incentive Value Amount' ;
    rdfs:comment 'Total potential value of performance-based incentives included in the agreement (e.g., bonuses tied to statistical milestones, award wins, or social media engagement thresholds).' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internalNotes rdf:type rdf:Property ;
    rdfs:label 'Internal Notes' ;
    rdfs:comment 'Free-text field for internal legal, compliance, or commercial team notes regarding the agreement. Not shared externally. Supports deal management and audit workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leagueSponsorConflictFlag rdf:type rdf:Property ;
    rdfs:label 'League Sponsor Conflict Flag' ;
    rdfs:comment 'Indicates whether this agreement has been flagged as potentially conflicting with an official league or team sponsor in the same product category. Triggers a sponsorship conflict-of-interest review.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:merchandiseUsageRights rdf:type rdf:Property ;
    rdfs:label 'Merchandise Usage Rights' ;
    rdfs:comment 'Indicates whether the brand partner has rights to use the athlete\'s name, image, or likeness on licensed merchandise and retail products (SKU-level). Relevant for Shopify Plus merchandise operations.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:moralityClauseIncluded rdf:type rdf:Property ;
    rdfs:label 'Morality Clause Included' ;
    rdfs:comment 'Indicates whether the agreement contains a morality clause allowing the brand partner to terminate the deal if the athlete engages in conduct deemed harmful to the brand\'s reputation.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:moralityClauseTerms rdf:type rdf:Property ;
    rdfs:label 'Morality Clause Terms' ;
    rdfs:comment 'Textual description of the specific morality clause terms and triggering conditions included in the agreement. Populated only when morality_clause_included is True.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentStructure rdf:type rdf:Property ;
    rdfs:label 'Payment Structure' ;
    rdfs:comment 'Defines how the deal value is paid to the athlete: as a single lump sum, periodic installments, milestone-triggered payments, royalty-based (percentage of sales), or a hybrid combination.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productCategory rdf:type rdf:Property ;
    rdfs:label 'Product Category' ;
    rdfs:comment 'The product or service category of the brand partner\'s offering covered by this agreement (e.g., athletic footwear, sports nutrition, financial services, automotive, apparel). Used for league sponsor conflict-of-interest checks. [ENUM-REF-CANDIDATE: athletic_footwear|apparel|sports_nutrition|financial_services|automotive|technology|beverage|healthcare|gaming|media — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyRate rdf:type rdf:Property ;
    rdfs:label 'Royalty Rate' ;
    rdfs:comment 'Royalty percentage rate applied to brand partner net sales for royalty-based or hybrid payment structures. Expressed as a decimal (e.g., 0.0500 = 5%). Null for non-royalty payment structures.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:royaltyRateOverride rdf:type rdf:Property ;
    rdfs:label 'Royalty Rate Override' ;
    rdfs:comment 'Per-SKU royalty rate expressed as a decimal fraction that overrides the master agreement\'s deal value terms for this specific SKU. Enables differentiated royalty structures within a single NIL deal (e.g., higher rate for autographed memorabilia vs. standard apparel).' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:socialMediaPostCount rdf:type rdf:Property ;
    rdfs:label 'Social Media Post Count' ;
    rdfs:comment 'Number of sponsored social media posts the athlete is contractually obligated to publish for the brand partner over the agreement term. Relevant for NCAA NIL social media deal tracking.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:socialMediaUsageRights rdf:type rdf:Property ;
    rdfs:label 'Social Media Usage Rights' ;
    rdfs:comment 'Indicates whether the brand partner has rights to use the athlete\'s name, image, or likeness in social media campaigns. Relevant for NCAA NIL social media deal compliance.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:territoryRestriction rdf:type rdf:Property ;
    rdfs:label 'Territory Restriction' ;
    rdfs:comment 'Comma-separated list of ISO 3166-1 alpha-3 country codes defining the geographic scope for this specific SKU authorization. May be narrower than the master agreement\'s exclusivity_territory — for example, a jersey SKU may only be authorized for US and CAN markets even if the master deal covers global rights.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageRightsScope rdf:type rdf:Property ;
    rdfs:label 'Usage Rights Scope' ;
    rdfs:comment 'Defines which specific usage rights (broadcast, digital, social, in-venue, merchandise) apply to this SKU under this NIL agreement. May be a subset of the master agreement\'s usage rights flags, allowing per-SKU restriction of rights.' ;
    rdfs:domain ind:NilAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorId rdf:type rdf:Property ;
    rdfs:label 'Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: Sports organizations procure official stats data from vendors (e.g., Sportradar, Stats Perform). Linking each stat record to its supplying vendor enables data quality audits, vendor contract complianc' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:aggregationMethodOverride rdf:type rdf:Property ;
    rdfs:label 'Aggregation Method Override' ;
    rdfs:comment 'An optional override to the KPI definition\'s default aggregation method, applied specifically when this stat record contributes to this KPI. Allows governance teams to specify non-standard aggregation for edge-case stat-KPI combinations without altering the master KPI definition.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assists rdf:type rdf:Property ;
    rdfs:label 'Assists' ;
    rdfs:comment 'Number of assists credited to the athlete — passes or actions directly leading to a goal or score. Applicable across soccer, hockey, basketball, and other team sports. Key metric for broadcast overlays and fantasy sports scoring.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:battingAverage rdf:type rdf:Property ;
    rdfs:label 'Batting Average' ;
    rdfs:comment 'Baseball-specific metric representing the ratio of hits to official at-bats (H/AB), expressed as a three-decimal fraction (e.g., 0.315). Null for non-baseball records. Foundational hitting metric for broadcast overlays, fantasy sports, and contract evaluation.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:blocks rdf:type rdf:Property ;
    rdfs:label 'Blocks' ;
    rdfs:comment 'Number of blocked shots or blocked passes credited to the athlete. Applicable to basketball (NBA shot blocks) and soccer/hockey (blocked shots). Null for non-applicable sport/position combinations.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Certification Timestamp' ;
    rdfs:comment 'The date and time at which the statistical record was officially certified by the league or governing body. Formatted as yyyy-MM-ddTHH:mm:ss.SSSXXX. Null for provisional or pending records. Required for official standings calculations and regulatory reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:contributionWeight rdf:type rdf:Property ;
    rdfs:label 'Contribution Weight' ;
    rdfs:comment 'The numeric weight (e.g., 0.0 to 1.0 or a raw multiplier) applied to this performance stat record when computing the target KPI value. Belongs to the relationship because the same stat may carry different weights for different KPIs.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:era rdf:type rdf:Property ;
    rdfs:label 'Era' ;
    rdfs:comment 'Earned Run Average (ERA) — baseball-specific pitching metric representing the average number of earned runs allowed per nine innings pitched. Null for non-baseball records. Primary pitching performance indicator for broadcast overlays, fantasy sports, and contract evaluation.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldGoalPercentage rdf:type rdf:Property ;
    rdfs:label 'Field Goal Percentage' ;
    rdfs:comment 'Ratio of successful field goals made to field goals attempted. Applicable to basketball (NBA) and American football (NFL kickers). Null for non-applicable sport/position combinations. Key shooting efficiency metric for broadcast overlays.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:foulsCommitted rdf:type rdf:Property ;
    rdfs:label 'Fouls Committed' ;
    rdfs:comment 'Total number of fouls committed by the athlete in this statistical period. Applicable to basketball (NBA personal fouls), soccer (FIFA/MLS), and hockey (NHL penalties). Tracks disciplinary and gameplay conduct for compliance and broadcast context.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gamesPlayed rdf:type rdf:Property ;
    rdfs:label 'Games Played' ;
    rdfs:comment 'Number of games in which the athlete appeared and was credited with participation. For game-level records this is always 1; for season or career records this represents the cumulative count. Used in rate-stat calculations and eligibility determinations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gamesStarted rdf:type rdf:Property ;
    rdfs:label 'Games Started' ;
    rdfs:comment 'Number of games in which the athlete was in the starting lineup. Distinguishes starter versus substitute contributions for roster management, contract incentive tracking, and broadcast narrative context.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:goals rdf:type rdf:Property ;
    rdfs:label 'Goals' ;
    rdfs:comment 'Number of goals scored by the athlete in this statistical period. Applicable to soccer (MLS/FIFA), ice hockey (NHL), and other goal-scoring sports. Null for sports where goals are not a primary scoring unit.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hudlStatRecordReference rdf:type rdf:Property ;
    rdfs:label 'Hudl Stat Record Reference' ;
    rdfs:comment 'The native record identifier assigned by the SportsCode/Hudl performance analytics platform for this statistical entry. Used for source system traceability and reconciliation against the operational system of record.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inningsPitched rdf:type rdf:Property ;
    rdfs:label 'Innings Pitched' ;
    rdfs:comment 'Total innings pitched by a baseball pitcher in this statistical period, expressed in thirds of an inning (e.g., 6.2 = 6 innings and 2 outs). Null for non-pitcher or non-baseball records. Denominator for ERA and other rate-based pitching metrics.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isHomeGame rdf:type rdf:Property ;
    rdfs:label 'Is Home Game' ;
    rdfs:comment 'Indicates whether the athlete\'s team was the home team during this game. True = home team; False = away team. Null for season or career aggregate records. Enables home/away performance split analysis for broadcast storytelling and scouting.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryInput rdf:type rdf:Property ;
    rdfs:label 'Is Primary Input' ;
    rdfs:comment 'Indicates whether this performance stat record is the primary driver of the KPI value (true) or a secondary/supplementary input (false). Used by reporting systems to prioritise which stat to surface in broadcast overlays and governance dashboards.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onBasePercentage rdf:type rdf:Property ;
    rdfs:label 'On Base Percentage' ;
    rdfs:comment 'Baseball-specific metric measuring how frequently a batter reaches base per plate appearance, including hits, walks, and hit-by-pitch. Null for non-baseball records. Advanced hitting metric used alongside batting average for comprehensive offensive evaluation.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:passingYards rdf:type rdf:Property ;
    rdfs:label 'Passing Yards' ;
    rdfs:comment 'Total passing yards accumulated by the athlete in this statistical period. NFL-specific metric for quarterbacks and passing plays. Null for non-football records or non-passing positions. Key broadcast overlay and fantasy sports metric.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:plusMinus rdf:type rdf:Property ;
    rdfs:label 'Plus Minus' ;
    rdfs:comment 'The plus/minus differential representing the net score differential when the athlete was on the ice or court. Applicable to ice hockey (NHL) and basketball (NBA). Positive values indicate the team outscored opponents during the athlete\'s time on the field. Key advanced analytics input.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qbr rdf:type rdf:Property ;
    rdfs:label 'Qbr' ;
    rdfs:comment 'Quarterback Rating (QBR) — NFL-specific composite passing efficiency metric scaled 0–100 measuring a quarterback\'s overall performance including passing, rushing, and situational adjustments. Null for non-quarterback or non-football records. Used for broadcast overlays and fantasy sports feeds.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebounds rdf:type rdf:Property ;
    rdfs:label 'Rebounds' ;
    rdfs:comment 'Total number of rebounds (offensive plus defensive) credited to the athlete. Basketball-specific metric (NBA). Null for non-basketball records. Used in broadcast overlays, fantasy sports feeds, and player valuation models.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:receivingYards rdf:type rdf:Property ;
    rdfs:label 'Receiving Yards' ;
    rdfs:comment 'Total receiving yards accumulated by the athlete in this statistical period. NFL-specific metric for wide receivers, tight ends, and running backs. Null for non-football records. Key fantasy sports and broadcast overlay metric.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rushingYards rdf:type rdf:Property ;
    rdfs:label 'Rushing Yards' ;
    rdfs:comment 'Total rushing yards accumulated by the athlete in this statistical period. NFL-specific metric for running backs, quarterbacks, and other ball carriers. Null for non-football records. Used in broadcast overlays and fantasy sports scoring.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:saves rdf:type rdf:Property ;
    rdfs:label 'Saves' ;
    rdfs:comment 'Number of saves recorded by the athlete. Applicable to goalkeepers in soccer and hockey, and to relief pitchers in baseball (MLB save rule). Null for non-applicable sport/position combinations.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sluggingPercentage rdf:type rdf:Property ;
    rdfs:label 'Slugging Percentage' ;
    rdfs:comment 'Baseball-specific advanced hitting metric measuring total bases per at-bat, reflecting extra-base hit power. Null for non-baseball records. Combined with on-base percentage to produce OPS (On-Base Plus Slugging) for comprehensive offensive evaluation.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statDate rdf:type rdf:Property ;
    rdfs:label 'Stat Date' ;
    rdfs:comment 'The calendar date on which the game was played or the date representing the end of the aggregation period for season/career records. Formatted as yyyy-MM-dd per enterprise data standards.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Stat Period End Date' ;
    rdfs:comment 'The end date of the window over which this performance stat record is considered a valid input to the KPI calculation. Together with stat_period_start_date, defines the contribution scope for this specific mapping.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Stat Period Start Date' ;
    rdfs:comment 'The start date of the window over which this performance stat record is considered a valid input to the KPI calculation. Scopes the contribution temporally without altering the stat record or the KPI definition.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statStatus rdf:type rdf:Property ;
    rdfs:label 'Stat Status' ;
    rdfs:comment 'Current lifecycle status of the statistical record. Official records are certified by the league; provisional records are pending official certification; revised records have been corrected post-certification; voided records are invalidated due to forfeit, protest, or data error; pending_review records are under investigation.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statType rdf:type rdf:Property ;
    rdfs:label 'Stat Type' ;
    rdfs:comment 'Classifies whether this record represents a single-game statistical line, a season-level aggregate, a career-level aggregate, a playoff period, or a tournament-specific accumulation. Drives how the record is consumed by broadcast overlays, fantasy feeds, and standings engines.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:steals rdf:type rdf:Property ;
    rdfs:label 'Steals' ;
    rdfs:comment 'Number of steals credited to the athlete. Primarily a basketball (NBA) defensive metric. Also applicable to baseball (stolen bases). Null for non-applicable sport/position combinations.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:strikeouts rdf:type rdf:Property ;
    rdfs:label 'Strikeouts' ;
    rdfs:comment 'Number of strikeouts recorded. For pitchers (MLB), this is the count of batters struck out. For batters, this is the count of times struck out. Null for non-baseball records. Key pitching and batting evaluation metric.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tackles rdf:type rdf:Property ;
    rdfs:label 'Tackles' ;
    rdfs:comment 'Number of tackles made by the athlete. Applicable to American football (NFL) defensive players and soccer (FIFA/MLS) players. Null for sports or positions where tackles are not a tracked metric.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:touchdowns rdf:type rdf:Property ;
    rdfs:label 'Touchdowns' ;
    rdfs:comment 'Total touchdowns scored or thrown by the athlete in this statistical period. NFL-specific metric covering passing touchdowns, rushing touchdowns, and receiving touchdowns. Null for non-football records.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:war rdf:type rdf:Property ;
    rdfs:label 'War' ;
    rdfs:comment 'Wins Above Replacement (WAR) — a composite advanced metric estimating the total number of additional wins the athlete contributed to their team compared to a replacement-level player. Sourced from SportsCode/Hudl analytics engine. Used for contract valuation, trade analysis, and broadcast storytelling.' ;
    rdfs:domain ind:PerformanceStat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rosterId rdf:type rdf:Property ;
    rdfs:label 'Roster Id' ;
    rdfs:comment 'Unique surrogate identifier for each roster record. Serves as the primary key for the athlete-team-season affiliation record in the Silver Layer lakehouse. Entity role: MASTER_AGREEMENT — this record represents a binding registration/affiliation between an athlete and a team within a league season.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Roster .

ind:loanedFromTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Loaned From Team Franchise Id' ;
    rdfs:comment 'Reference to the originating team from which the athlete is on loan to the current roster. Applicable in soccer (MLS, FIFA) and hockey (NHL) loan/conditioning assignment scenarios. Null if the athlete is not on loan.' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:primaryRosterFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Primary Roster Franchise Id' ;
    rdfs:comment 'Reference to the team or franchise master record to which the athlete is currently rostered. Establishes the athlete-team affiliation for the given season.' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:rosterFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Roster Franchise Id' ;
    rdfs:comment 'FK to league.franchise.franchise_id — Roster-to-franchise linkage — must know which franchise a roster belongs to for cap compliance, trade eligibility, and league governance.' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:rosterLoanedFromTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Roster Loaned From Team Franchise Id' ;
    rdfs:comment 'Reference to the originating team from which the athlete is on loan to the current roster. Applicable in soccer (MLS, FIFA) and hockey (NHL) loan/conditioning assignment scenarios. Null if the athlete is not on loan.' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:activationDate rdf:type rdf:Property ;
    rdfs:label 'Activation Date' ;
    rdfs:comment 'The date on which the athlete was officially activated onto this roster slot. Marks the effective start of the athlete-team affiliation for this record. Critical for CBA compliance, salary cap calculations, and eligibility verification.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capHitCurrency rdf:type rdf:Property ;
    rdfs:label 'Cap Hit Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the salary cap hit amount (e.g., USD, CAD, EUR, GBP). Required for multi-league international operations where cap values may be denominated in different currencies.' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deactivationDate rdf:type rdf:Property ;
    rdfs:label 'Deactivation Date' ;
    rdfs:comment 'The date on which the athlete was removed from this roster slot (via trade, waiver, release, retirement, or season end). Null if the roster record is currently active. Enables point-in-time roster reconstruction for any historical date.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:depthChartRank rdf:type rdf:Property ;
    rdfs:label 'Depth Chart Rank' ;
    rdfs:comment 'The athlete\'s positional depth chart ranking within the team (1 = starter, 2 = first backup, etc.). Used for game-day roster decisions, broadcast graphics, and performance analytics. Updated by coaching staff via SportsCode/Hudl.' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:internationalSlotFlag rdf:type rdf:Property ;
    rdfs:label 'International Slot Flag' ;
    rdfs:comment 'Indicates whether this roster slot is designated as an international player slot under league rules (e.g., MLS international roster designation, NHL Entry Level Contract international provisions). Affects roster construction compliance and salary cap treatment.' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:positionCode rdf:type rdf:Property ;
    rdfs:label 'Position Code' ;
    rdfs:comment 'Standardized league-defined code for the athlete\'s primary playing position (e.g., QB, WR, C, PG, SG, SP, RP, LW, RW, FWD, MID, DEF, GK). Used in performance analytics, broadcast overlays, and roster compliance checks. [ENUM-REF-CANDIDATE: QB|WR|RB|TE|OL|DL|LB|DB|K|P|PG|SG|SF|PF|C|SP|RP|CP|1B|2B|3B|SS|OF|LW|RW|FWD|MID|DEF|GK — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionName rdf:type rdf:Property ;
    rdfs:label 'Position Name' ;
    rdfs:comment 'Human-readable full name of the athlete\'s primary playing position (e.g., \'Quarterback\', \'Point Guard\', \'Starting Pitcher\', \'Left Wing\', \'Goalkeeper\'). Used in broadcast graphics, fan-facing content, and reporting.' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceSquadElevationFlag rdf:type rdf:Property ;
    rdfs:label 'Practice Squad Elevation Flag' ;
    rdfs:comment 'Indicates whether the athlete has been temporarily elevated from the practice squad to the active roster for a specific game week, per NFL and other league rules allowing short-term elevations without permanently activating the player.' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rosterNumber rdf:type rdf:Property ;
    rdfs:label 'Roster Number' ;
    rdfs:comment 'Externally-known business identifier for this roster record, typically assigned by the league operations system. Used in official league communications, broadcast graphics, and regulatory filings. Example: \'NFL-2024-KC-0042\'.' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryCapHit rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Hit' ;
    rdfs:comment 'The annual salary cap charge attributed to this athlete\'s roster slot for the current season, expressed in USD. Used for cap compliance reporting, trade analysis, and financial planning. Governed by CBA salary cap rules.' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceYears rdf:type rdf:Property ;
    rdfs:label 'Service Years' ;
    rdfs:comment 'Accumulated years of professional service for the athlete within the league, calculated per CBA rules. Determines eligibility for free agency, arbitration rights, minimum salary tiers, and pension benefits. Expressed as a decimal (e.g., 3.172 years).' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slotType rdf:type rdf:Property ;
    rdfs:label 'Slot Type' ;
    rdfs:comment 'Classification of the roster slot category as defined by league rules. Determines salary cap implications, game eligibility, and CBA compliance. \'active_roster\' = primary game-day roster; \'practice_squad\' = developmental; \'injured_reserve\' = IR designation; \'reserve\' = non-IR reserve list; \'taxi_squad\' = NHL-specific developmental designation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Date' ;
    rdfs:comment 'The official date on which the roster transaction (signing, trade, waiver, draft, transfer) was executed and reported to the league. May differ from activation_date if there is a processing lag.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionType rdf:type rdf:Property ;
    rdfs:label 'Transaction Type' ;
    rdfs:comment 'The type of transaction that created this roster record. Indicates how the athlete came to be on this roster slot. Used for league transaction reporting, broadcast graphics, and historical analysis. [ENUM-REF-CANDIDATE: signed|traded|waived|released|drafted|transferred|loaned|retired — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visaType rdf:type rdf:Property ;
    rdfs:label 'Visa Type' ;
    rdfs:comment 'Type of work visa or immigration authorization held by the athlete for the jurisdiction in which they are rostered (e.g., P-1A for internationally recognized athletes in the USA, O-1 for extraordinary ability). Required for international roster compliance and HR onboarding. [ENUM-REF-CANDIDATE: P-1A|O-1|TN|H-1B|J-1|work_permit|citizen|permanent_resident — promote to reference product]' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wadaLastTestDate rdf:type rdf:Property ;
    rdfs:label 'Wada Last Test Date' ;
    rdfs:comment 'Date of the athlete\'s most recent WADA-compliant anti-doping test. Used to verify testing frequency compliance and support league anti-doping audit trails.' ;
    rdfs:domain ind:Roster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:salaryCapEntryId rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Entry Id' ;
    rdfs:comment 'Unique surrogate identifier for each athlete-level salary cap accounting record within the Silver Layer lakehouse. Primary key for this product.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryFilingId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Id' ;
    rdfs:comment 'Foreign key linking to compliance.regulatory_filing. Business justification: Salary cap entries must be reported to the league governing body as regulatory filings. Linking salary_cap_entry to compliance.regulatory_filing enables cap compliance reporting, audit trail maintenan' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryFiling .

ind:salaryCapId rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Id' ;
    rdfs:comment 'Foreign key linking to league.salary_cap. Business justification: Each salary_cap_entry (individual player cap hit) must be validated against the franchise\'s total salary_cap record for the season. Linking enables cap space remaining calculations, luxury tax liabili' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SalaryCap .

ind:baseSalary rdf:type rdf:Property ;
    rdfs:label 'Base Salary' ;
    rdfs:comment 'The athlete\'s annual base salary for this cap year as defined in the contract. This is the cash compensation component before bonuses or restructuring. Feeds directly into SAP S/4HANA FI/CO payroll cost centers.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capAccelerationDate rdf:type rdf:Property ;
    rdfs:label 'Cap Acceleration Date' ;
    rdfs:comment 'The date on which remaining prorated bonuses were accelerated into the current cap year due to a release or trade. Triggers the dead cap charge. Null if no acceleration has occurred.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capEntryReference rdf:type rdf:Property ;
    rdfs:label 'Cap Entry Reference' ;
    rdfs:comment 'Externally-known business identifier for this salary cap entry record, used in cross-system reconciliation with SAP S/4HANA FI/CO and Workday Adaptive Planning. Format typically includes league code, team code, cap year, and sequence (e.g., NFL-DAL-2024-0042).' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capRelief rdf:type rdf:Property ;
    rdfs:label 'Cap Relief' ;
    rdfs:comment 'The reduction in cap hit achieved through a contract restructure, typically by converting base salary into a signing bonus that is then prorated. Represents the net cap space freed in the current year as a result of the restructure.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capYear rdf:type rdf:Property ;
    rdfs:label 'Cap Year' ;
    rdfs:comment 'The league-defined fiscal/competitive year (e.g., 2024) to which this salary cap entry applies. Cap years may not align with calendar years depending on the league\'s CBA definition.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capYearEndDate rdf:type rdf:Property ;
    rdfs:label 'Cap Year End Date' ;
    rdfs:comment 'The last date of the league-defined cap year period during which this entry is active. Marks the boundary for cap accounting obligations in this record.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capYearStartDate rdf:type rdf:Property ;
    rdfs:label 'Cap Year Start Date' ;
    rdfs:comment 'The first date of the league-defined cap year period during which this entry is active. Used for proration calculations and cap forecasting in Workday Adaptive Planning.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractTotalYears rdf:type rdf:Property ;
    rdfs:label 'Contract Total Years' ;
    rdfs:comment 'Total number of years in the underlying contract. Used as the denominator for signing bonus proration calculations across cap years.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractYearNumber rdf:type rdf:Property ;
    rdfs:label 'Contract Year Number' ;
    rdfs:comment 'The sequential year number within the multi-year contract that this cap entry represents (e.g., Year 1, Year 2, Year 3 of a 5-year deal). Used to track proration schedules and contract progression.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deadCapValue rdf:type rdf:Property ;
    rdfs:label 'Dead Cap Value' ;
    rdfs:comment 'The remaining prorated bonus and other accelerated cap charges that count against the team\'s cap after an athlete is released, traded, or their contract is terminated. Represents the cap penalty for parting ways with the athlete before contract expiry.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entryStatus rdf:type rdf:Property ;
    rdfs:label 'Entry Status' ;
    rdfs:comment 'Current lifecycle state of this salary cap entry. \'active\' = currently counting against cap; \'restructured\' = contract has been restructured, new entry supersedes; \'voided\' = contract voided/nullified; \'dead_cap\' = player released but cap charge remains; \'cap_hold\' = restricted free agent tender hold; \'historical\' = prior year closed record.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryType rdf:type rdf:Property ;
    rdfs:label 'Entry Type' ;
    rdfs:comment 'Classification of the cap entry by contract category per CBA rules. Determines applicable cap calculation methodology. [ENUM-REF-CANDIDATE: standard|rookie_scale|veteran_minimum|franchise_tag|transition_tag|cap_hold|two_way|10_day|rest_of_season — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incentiveEarnedPriorYear rdf:type rdf:Property ;
    rdfs:label 'Incentive Earned Prior Year' ;
    rdfs:comment 'Indicates whether the athlete earned incentives in the prior cap year that were classified as \'unlikely\' at the time, triggering a cap charge carryover into this cap year. True = prior year unlikely incentive was earned and creates a charge in this year.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCapHold rdf:type rdf:Property ;
    rdfs:label 'Is Cap Hold' ;
    rdfs:comment 'Indicates whether this entry is a cap hold for a restricted free agent or unsigned draft pick rather than an active contract. True = cap hold; False = active contract cap entry.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDeadCap rdf:type rdf:Property ;
    rdfs:label 'Is Dead Cap' ;
    rdfs:comment 'Indicates whether this entry represents a dead cap charge (athlete has been released or traded but remaining prorated bonuses still count against the team\'s cap). True = athlete is no longer on roster but cap charge persists.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRestructured rdf:type rdf:Property ;
    rdfs:label 'Is Restructured' ;
    rdfs:comment 'Indicates whether this cap entry reflects a contract restructure that converted base salary to prorated bonus, generating cap relief in the current year. True = restructure has been applied to this entry.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueReportedDate rdf:type rdf:Property ;
    rdfs:label 'League Reported Date' ;
    rdfs:comment 'The date on which this cap entry was officially reported to and acknowledged by the league office. Required for compliance with league transaction reporting deadlines under CBA rules.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:likelyIncentiveAmount rdf:type rdf:Property ;
    rdfs:label 'Likely Incentive Amount' ;
    rdfs:comment 'Total value of performance incentives classified as \'likely to be earned\' per CBA rules based on the athlete\'s prior year performance. Likely incentives count against the current cap year. Per CBA definition, an incentive is \'likely\' if the athlete achieved the same threshold in the prior season.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:optionBonusProrated rdf:type rdf:Property ;
    rdfs:label 'Option Bonus Prorated' ;
    rdfs:comment 'The prorated portion of any option bonus (e.g., option year exercise bonus, void year bonus) allocated to this cap year. Option bonuses are prorated over remaining contract years when exercised.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perGameRosterBonus rdf:type rdf:Property ;
    rdfs:label 'Per Game Roster Bonus' ;
    rdfs:comment 'Bonus amount earned on a per-game-active basis for each game the athlete is on the active roster. Common in NFL contracts. Total potential value for the cap year is tracked here for cap forecasting purposes.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorYearIncentiveCarryover rdf:type rdf:Property ;
    rdfs:label 'Prior Year Incentive Carryover' ;
    rdfs:comment 'The dollar amount of incentives earned in the prior cap year (classified as \'unlikely\') that carry over as an additional cap charge in this cap year per CBA rules. Distinct from current-year incentive amounts.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:restructureDate rdf:type rdf:Property ;
    rdfs:label 'Restructure Date' ;
    rdfs:comment 'The date on which the contract restructure was executed, converting base salary to prorated signing bonus and generating cap relief. Null if no restructure has occurred for this entry.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rosterBonus rdf:type rdf:Property ;
    rdfs:label 'Roster Bonus' ;
    rdfs:comment 'Bonus amount payable to the athlete for being on the active roster on a specified date in this cap year. Counts fully against the cap in the year it is earned per CBA rules.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signingBonusProrated rdf:type rdf:Property ;
    rdfs:label 'Signing Bonus Prorated' ;
    rdfs:comment 'The portion of the total signing bonus allocated to this specific cap year after proration across the contract length per CBA rules. This amount is included in the cap hit calculation.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signingBonusTotal rdf:type rdf:Property ;
    rdfs:label 'Signing Bonus Total' ;
    rdfs:comment 'Total signing bonus paid to the athlete at contract execution. This amount is prorated across the contract years for cap purposes per CBA rules. Stored as the full contract-level total for reference.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unlikelyIncentiveAmount rdf:type rdf:Property ;
    rdfs:label 'Unlikely Incentive Amount' ;
    rdfs:comment 'Total value of performance incentives classified as \'unlikely to be earned\' per CBA rules. Unlikely incentives do NOT count against the current cap year but create a cap charge in the following year if earned. Per CBA definition, an incentive is \'unlikely\' if the athlete did NOT achieve the threshold in the prior season.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voidYearFlag rdf:type rdf:Property ;
    rdfs:label 'Void Year Flag' ;
    rdfs:comment 'Indicates whether this cap year is a void year — a contract year that automatically voids, causing all remaining prorated bonuses to accelerate into the final non-void year. Common NFL cap management technique. True = this is a void year.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workdayPlanReference rdf:type rdf:Property ;
    rdfs:label 'Workday Plan Reference' ;
    rdfs:comment 'Reference identifier linking this cap entry to the corresponding cap forecast scenario in Workday Adaptive Planning. Enables reconciliation between actual cap accounting records and forward-looking cap projections.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workoutBonus rdf:type rdf:Property ;
    rdfs:label 'Workout Bonus' ;
    rdfs:comment 'Bonus amount payable to the athlete for attending and completing mandatory off-season workout programs. Cap treatment varies by league CBA — may be fully or partially counted.' ;
    rdfs:domain ind:SalaryCapEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoutingReportId rdf:type rdf:Property ;
    rdfs:label 'Scouting Report Id' ;
    rdfs:comment 'Unique surrogate identifier for the scouting report record in the athlete domain Silver layer. Primary key for this data product.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:draftPickId rdf:type rdf:Property ;
    rdfs:label 'Draft Pick Id' ;
    rdfs:comment 'Foreign key linking to the draft pick being evaluated' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DraftPick .

ind:evaluatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Evaluator Employee Id' ;
    rdfs:comment 'Reference to the scout or evaluator who authored this report. Links to the workforce/staff master record.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:characterGrade rdf:type rdf:Property ;
    rdfs:label 'Character Grade' ;
    rdfs:comment 'Scout\'s letter-grade assessment of the prospect\'s character, coachability, work ethic, and off-field conduct. Confidential evaluation used in draft risk management and CBA compliance screening. Influences draft recommendation and contract structure.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:combineEventLocation rdf:type rdf:Property ;
    rdfs:label 'Combine Event Location' ;
    rdfs:comment 'City and venue where the combine or pro day event was held (e.g., Indianapolis, IN - Lucas Oil Stadium for NFL Combine). Used for event logistics and historical benchmarking.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:combineEventName rdf:type rdf:Property ;
    rdfs:label 'Combine Event Name' ;
    rdfs:comment 'Name of the official combine or evaluation event at which measurables were recorded (e.g., NFL Scouting Combine, NBA Draft Combine, MLB Draft, Pro Day - University of Alabama). Null for video analysis or scout assessment evaluations.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comparablePlayer rdf:type rdf:Property ;
    rdfs:label 'Comparable Player' ;
    rdfs:comment 'Scout-assigned comparable professional player whose career trajectory and skill set most closely mirrors the prospect\'s projected development. Used in broadcast content, fan engagement narratives, and internal draft communication.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dopingConcernFlag rdf:type rdf:Property ;
    rdfs:label 'Doping Concern Flag' ;
    rdfs:comment 'Indicates whether the prospect has any documented or suspected Performance Enhancing Drug (PED) use or anti-doping violations flagged during the evaluation process. Confidential field subject to WADA and league anti-doping compliance protocols.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:draftEligibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Draft Eligibility Status' ;
    rdfs:comment 'Current eligibility determination for the prospect to participate in the draft. Reflects CBA rules, age requirements, amateur status, and any hardship waiver or international player designations.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:draftRecommendation rdf:type rdf:Property ;
    rdfs:label 'Draft Recommendation' ;
    rdfs:comment 'Evaluator\'s recommended draft round or action for this prospect. Feeds the organization\'s draft board and informs contract slot value calculations under the CBA. Do Not Draft flags prospects with disqualifying concerns.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Date' ;
    rdfs:comment 'The calendar date on which the evaluation event (combine, pro day, scout visit, video session) took place. Principal real-world event date for this transaction record.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evaluationType rdf:type rdf:Property ;
    rdfs:label 'Evaluation Type' ;
    rdfs:comment 'Classification of the evaluation methodology used to produce this report. Distinguishes combine measurables (NFL Scouting Combine, NBA Draft Combine, MLB Draft), scout assessment, video analysis via SportsCode/Hudl, pro day, or medical evaluation.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryHistoryFlag rdf:type rdf:Property ;
    rdfs:label 'Injury History Flag' ;
    rdfs:comment 'Indicates whether the prospect has a documented injury history that was reviewed as part of this evaluation. True triggers mandatory medical evaluation review before draft selection. Supports WADA and league medical compliance processes.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ovrGrade rdf:type rdf:Property ;
    rdfs:label 'Ovr Grade' ;
    rdfs:comment 'Overall (OVR) scout grade assigned to the prospect on the standard scouting scale (e.g., 40-80 NFL scale, 1-10 NBA scale). Represents the evaluator\'s holistic assessment of the prospect\'s projected professional value. Principal quantitative fact for this evaluation record.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectionTier rdf:type rdf:Property ;
    rdfs:label 'Projection Tier' ;
    rdfs:comment 'Scout\'s qualitative projection of the prospect\'s ceiling as a professional player. Drives draft round targeting, contract slot value calculations, and roster construction strategy. Franchise player represents top-tier franchise-altering talent.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prospectPositionSecondary rdf:type rdf:Property ;
    rdfs:label 'Prospect Position Secondary' ;
    rdfs:comment 'Secondary or versatility position the prospect can play, used for positional flexibility analysis in draft targeting and roster construction. Follows same position code taxonomy as prospect_position.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportCode rdf:type rdf:Property ;
    rdfs:label 'Report Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the scouting report, used in draft boards, trade evaluation workflows, and SportsCode/Hudl platform references. Format: SCT-{SPORT}-{YEAR}-{SEQUENCE}.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportStatus rdf:type rdf:Property ;
    rdfs:label 'Report Status' ;
    rdfs:comment 'Current lifecycle state of the scouting report within the evaluation workflow. Draft reports are in progress; submitted reports await review; approved reports feed draft boards and contract slot calculations; superseded reports have been replaced by a newer evaluation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strengthsNarrative rdf:type rdf:Property ;
    rdfs:label 'Strengths Narrative' ;
    rdfs:comment 'Scout\'s qualitative narrative describing the prospect\'s key strengths, standout skills, and competitive advantages. Confidential proprietary evaluation content sourced from SportsCode/Hudl platform. Critical for draft board presentations and trade evaluation.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weaknessesNarrative rdf:type rdf:Property ;
    rdfs:label 'Weaknesses Narrative' ;
    rdfs:comment 'Scout\'s qualitative narrative describing the prospect\'s developmental areas, limitations, and risk factors. Confidential proprietary evaluation content. Used in draft risk assessment and contract negotiation strategy.' ;
    rdfs:domain ind:ScoutingReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dopingViolationId rdf:type rdf:Property ;
    rdfs:label 'Doping Violation Id' ;
    rdfs:comment 'Foreign key linking to compliance.doping_violation. Business justification: Doping-triggered suspensions must reference the underlying compliance.doping_violation for CAS appeals, results disqualification processing, and WADA reporting. Legal and compliance teams require this' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DopingViolation .

ind:announcementDate rdf:type rdf:Property ;
    rdfs:label 'Announcement Date' ;
    rdfs:comment 'Date on which the suspension was publicly announced by the league or issuing authority. Null if the suspension has not been publicly announced or is confidential.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealBody rdf:type rdf:Property ;
    rdfs:label 'Appeal Body' ;
    rdfs:comment 'The body or tribunal that is hearing or heard the appeal (e.g., CAS (Court of Arbitration for Sport), WADA, League Appeals Panel, Arbitration, Federal Court). Null or \'None\' if no appeal was filed.' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Resolution Date' ;
    rdfs:comment 'Date on which the appeal was formally resolved by the appellate body (e.g., CAS, league appeals panel). Null if the appeal is still pending or no appeal was filed.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:broadcastRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Broadcast Restriction Flag' ;
    rdfs:comment 'Indicates whether the suspension includes restrictions on the athlete\'s appearance in broadcast content, media, or promotional materials during the suspension period. Relevant for broadcast rights compliance and content production scheduling.' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Case Reference Number' ;
    rdfs:comment 'Externally-known disciplinary case number or docket identifier assigned by the issuing authority (e.g., league office, WADA, CAS). Used for cross-referencing with legal and compliance systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitionScope rdf:type rdf:Property ;
    rdfs:label 'Competition Scope' ;
    rdfs:comment 'Defines the scope of competitions from which the athlete is suspended. Some suspensions apply to all competitions (including international), while others are limited to specific competition types (e.g., league games only, international fixtures only).' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hearingDate rdf:type rdf:Property ;
    rdfs:label 'Hearing Date' ;
    rdfs:comment 'Date on which the formal disciplinary hearing was conducted before the suspension was issued. Null if no formal hearing was held (e.g., automatic suspensions for certain violations).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hearingOfficer rdf:type rdf:Property ;
    rdfs:label 'Hearing Officer' ;
    rdfs:comment 'Name or title of the independent arbitrator, hearing officer, or disciplinary panel chair who presided over the disciplinary hearing. Null if no formal hearing was held.' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentDescription rdf:type rdf:Property ;
    rdfs:label 'Incident Description' ;
    rdfs:comment 'Narrative description of the incident or conduct that led to the suspension. Contains factual summary of the violation as documented by the issuing authority. Classified confidential due to sensitive legal and disciplinary nature.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isIndefinite rdf:type rdf:Property ;
    rdfs:label 'Is Indefinite' ;
    rdfs:comment 'Indicates whether the suspension is indefinite with no fixed end date. True when the athlete is banned until further review or reinstatement conditions are met. When True, effective_end_date will be null.' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLifetimeBan rdf:type rdf:Property ;
    rdfs:label 'Is Lifetime Ban' ;
    rdfs:comment 'Indicates whether the suspension constitutes a permanent lifetime ban from the sport or league. Typically applied for second PED (Performance Enhancing Drug) violations under WADA or severe integrity violations such as match fixing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPublicAnnouncement rdf:type rdf:Property ;
    rdfs:label 'Is Public Announcement' ;
    rdfs:comment 'Indicates whether the suspension has been publicly announced by the league or issuing authority. Some suspensions (particularly early-stage PED violations) may be kept confidential until the appeals process is exhausted.' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSuspensionStayed rdf:type rdf:Property ;
    rdfs:label 'Is Suspension Stayed' ;
    rdfs:comment 'Indicates whether the suspension has been temporarily stayed (paused) pending the outcome of an appeal. When True, the athlete may continue to participate while the appeal is resolved.' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuedDate rdf:type rdf:Property ;
    rdfs:label 'Issued Date' ;
    rdfs:comment 'The date on which the suspension decision was formally issued or announced by the issuing authority. Represents the principal real-world business event timestamp (BUSINESS_EVENT_TIMESTAMP category).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nilAgreementImpact rdf:type rdf:Property ;
    rdfs:label 'Nil Agreement Impact' ;
    rdfs:comment 'Status of the athlete\'s NIL (Name, Image, and Likeness) agreements during the suspension period. Indicates whether NIL deals are suspended, terminated by sponsors, unaffected, or under review. Critical for commercial and sponsorship compliance tracking.' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorViolationCount rdf:type rdf:Property ;
    rdfs:label 'Prior Violation Count' ;
    rdfs:comment 'Number of prior disciplinary violations of the same type on the athlete\'s record at the time this suspension was issued. Used to determine escalating penalty tiers under WADA and league policies (e.g., first offense vs. second offense).' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prohibitedSubstanceCode rdf:type rdf:Property ;
    rdfs:label 'Prohibited Substance Code' ;
    rdfs:comment 'WADA-assigned code or name of the prohibited substance detected in the anti-doping violation (e.g., \'S1.1 — Testosterone\', \'S6.A — Stimulants\'). Null for non-PED (Performance Enhancing Drug) suspensions. Classified confidential due to sensitive health-adjacent nature.' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryWithheldAmount rdf:type rdf:Property ;
    rdfs:label 'Salary Withheld Amount' ;
    rdfs:comment 'Total salary amount withheld from the athlete during the suspension period as a consequence of the disciplinary action, expressed in the applicable currency. Distinct from financial_penalty_amount which is a separate fine. Tracked for payroll and CBA compliance.' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:suspensionLengthDays rdf:type rdf:Property ;
    rdfs:label 'Suspension Length Days' ;
    rdfs:comment 'Number of calendar days the athlete is suspended, as specified in the suspension ruling. Null if the suspension is measured in games or is indefinite. Common in WADA anti-doping cases and FIFA disciplinary proceedings.' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:suspensionLengthGames rdf:type rdf:Property ;
    rdfs:label 'Suspension Length Games' ;
    rdfs:comment 'Number of games the athlete is suspended from participating in, as specified in the suspension ruling. Null if the suspension is measured in days or is indefinite. Used for game-based suspensions common in NFL, NBA, MLB, NHL.' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:suspensionStatus rdf:type rdf:Property ;
    rdfs:label 'Suspension Status' ;
    rdfs:comment 'Current lifecycle state of the suspension record. \'Active\' means the athlete is currently serving the suspension; \'Served\' means the suspension period has been completed; \'Appealed\' means the athlete has filed an appeal and the suspension may be stayed; \'Overturned\' means the suspension was reversed on appeal; \'Reduced\' means the original penalty was reduced; \'Pending\' means the suspension has been issued but not yet commenced.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspensionType rdf:type rdf:Property ;
    rdfs:label 'Suspension Type' ;
    rdfs:comment 'Classification of the disciplinary action by the nature of the violation. PED (Performance Enhancing Drug) violations are governed by WADA; conduct violations relate to personal conduct policies; game misconduct covers in-game rule infractions; league discipline covers CBA-governed actions; match fixing and financial breach are integrity-related. [ENUM-REF-CANDIDATE: ped_violation|conduct_violation|game_misconduct|league_discipline|match_fixing|financial_breach|eligibility_violation|anti-doping — promote to reference product]' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testingAuthority rdf:type rdf:Property ;
    rdfs:label 'Testing Authority' ;
    rdfs:comment 'Name of the anti-doping organization (ADO) or testing authority that conducted the drug test resulting in the violation (e.g., USADA, UKAD, WADA, NADO). Null for non-PED suspensions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionGrievanceNumber rdf:type rdf:Property ;
    rdfs:label 'Union Grievance Number' ;
    rdfs:comment 'The formal grievance or arbitration case number filed by the players\' union (e.g., NFLPA, NBPA, MLBPA) on behalf of the athlete under the CBA (Collective Bargaining Agreement) grievance procedures. Null if no union grievance was filed.' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationCategory rdf:type rdf:Property ;
    rdfs:label 'Violation Category' ;
    rdfs:comment 'Specific sub-category or rule code of the violation that triggered the suspension (e.g., \'Prohibited Substance — S1 Anabolic Agents\', \'Domestic Violence\', \'Gambling\', \'Unsportsmanlike Conduct\'). Provides granular classification beyond suspension_type for compliance reporting. [ENUM-REF-CANDIDATE: promote to reference product given large enumeration across leagues]' ;
    rdfs:domain ind:SuspensionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adPlacementId rdf:type rdf:Property ;
    rdfs:label 'Ad Placement Id' ;
    rdfs:comment 'Unique surrogate identifier for each advertising placement transaction executed within a broadcast window. Primary key for the ad_placement data product.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adInventorySlotBroadcastAdInventoryId rdf:type rdf:Property ;
    rdfs:label 'Ad Inventory Slot Broadcast Ad Inventory Id' ;
    rdfs:comment 'Reference to the specific ad inventory slot within the broadcast window that was allocated for this placement, defining the break position, pod number, and slot duration.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BroadcastAdInventory .

ind:advertiserId rdf:type rdf:Property ;
    rdfs:label 'Advertiser Id' ;
    rdfs:comment 'Reference to the advertiser (brand or agency) who purchased this ad placement. Links to the sponsorship/CRM domain for brand-level reporting and sponsor relationship management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Advertiser .

ind:broadcastAdInventoryId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Ad Inventory Id' ;
    rdfs:comment 'Reference to the specific ad inventory slot within the broadcast window that was allocated for this placement, defining the break position, pod number, and slot duration.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BroadcastAdInventory .

ind:creativeAssetId rdf:type rdf:Property ;
    rdfs:label 'Creative Asset Id' ;
    rdfs:comment 'Reference to the specific creative asset (video spot, audio tag, graphic overlay) delivered during this placement, managed within the Digital Asset Management (DAM) system.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:originalPlacementAdPlacementId rdf:type rdf:Property ;
    rdfs:label 'Original Placement Ad Placement Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the original ad placement that this make-good placement is compensating for. Populated only when make_good_flag is True. Enables make-good chain tracking and fulfilment reconciliation.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AdPlacement .

ind:sponsorshipDealId rdf:type rdf:Property ;
    rdfs:label 'Sponsorship Deal Id' ;
    rdfs:comment 'Reference to the parent sponsorship or media rights deal under which this placement was contracted. Enables brand-level revenue roll-up and deal fulfilment tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Deal .

ind:actualDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Actual Duration Seconds' ;
    rdfs:comment 'Actual on-air duration of the advertisement in seconds as measured by the broadcast playout system. Compared against spot_duration_seconds to identify truncation or overrun events.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adBreakPosition rdf:type rdf:Property ;
    rdfs:label 'Ad Break Position' ;
    rdfs:comment 'Sequential position number of the ad break within the broadcast program (e.g., 1 = pre-show, 2 = first in-game break). Used for pod sequencing, premium positioning pricing, and break-level performance analysis.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adServerConfirmationCode rdf:type rdf:Property ;
    rdfs:label 'Ad Server Confirmation Code' ;
    rdfs:comment 'Unique confirmation or transaction ID returned by the ad server upon successful delivery of the placement. Used for third-party verification, discrepancy resolution, and audit trail.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Agency Commission Amount' ;
    rdfs:comment 'Commission amount payable to the advertising agency for brokering this placement, typically a percentage of gross revenue. Deducted to arrive at net revenue for financial reporting.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:audienceDemographicTarget rdf:type rdf:Property ;
    rdfs:label 'Audience Demographic Target' ;
    rdfs:comment 'The target audience demographic segment specified in the media buy (e.g., Adults 18-49, Males 25-54). Used for audience guarantee tracking, make-good eligibility, and demographic-level yield reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blackoutApplied rdf:type rdf:Property ;
    rdfs:label 'Blackout Applied' ;
    rdfs:comment 'Indicates whether a geographic blackout rule was applied to this placement, restricting delivery in specific territories per broadcast rights agreements. Aligns with blackout rules defined in the broadcast schedule.' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cdnDeliveryProfile rdf:type rdf:Property ;
    rdfs:label 'Cdn Delivery Profile' ;
    rdfs:comment 'The CDN (Content Delivery Network) profile code used to deliver this ad creative to the end platform. Relevant for OTT and digital streaming placements; used for CDN cost allocation and delivery performance monitoring.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitiveSeparationFlag rdf:type rdf:Property ;
    rdfs:label 'Competitive Separation Flag' ;
    rdfs:comment 'Indicates whether competitive separation rules were applied to this placement, preventing direct competitor advertisements from appearing in the same ad pod. Required for premium advertiser contract compliance.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cpmAchieved rdf:type rdf:Property ;
    rdfs:label 'Cpm Achieved' ;
    rdfs:comment 'The actual CPM (Cost Per Mille) rate achieved for this placement based on verified impressions delivered. May differ from cpm_contracted due to audience delivery variances, make-good adjustments, or programmatic clearing prices.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cpmContracted rdf:type rdf:Property ;
    rdfs:label 'Cpm Contracted' ;
    rdfs:comment 'The agreed CPM (Cost Per Mille — cost per 1,000 impressions) rate as specified in the media buy contract. Used as the billing baseline and compared against cpm_achieved for yield analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drmPolicyApplied rdf:type rdf:Property ;
    rdfs:label 'Drm Policy Applied' ;
    rdfs:comment 'Indicates whether a Digital Rights Management (DRM) policy was enforced during delivery of this placement, relevant for OTT and IPTV platforms where content protection rules govern ad insertion.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grossRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Revenue Amount' ;
    rdfs:comment 'Gross revenue value of this ad placement before agency commissions, discounts, or adjustments, calculated as (impressions_delivered / 1000) × cpm_achieved. Core revenue transaction amount for broadcast advertising monetization.' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grpDelivered rdf:type rdf:Property ;
    rdfs:label 'Grp Delivered' ;
    rdfs:comment 'Gross Rating Points (GRP) delivered by this placement, representing reach multiplied by frequency within the target demographic. Standard broadcast advertising currency for campaign delivery measurement and make-good calculations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impressionsDelivered rdf:type rdf:Property ;
    rdfs:label 'Impressions Delivered' ;
    rdfs:comment 'Total number of audience impressions delivered by this ad placement as measured or estimated by the audience measurement system. Core metric for CPM (Cost Per Mille) billing and campaign performance reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:languageCode rdf:type rdf:Property ;
    rdfs:label 'Language Code' ;
    rdfs:comment 'BCP 47 language code of the ad creative delivered (e.g., en-US, es-MX, fr-CA). Required for multi-language broadcast markets and localization compliance reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:makeGoodFlag rdf:type rdf:Property ;
    rdfs:label 'Make Good Flag' ;
    rdfs:comment 'Indicates whether this placement is a make-good (compensatory) spot issued to replace a previously failed, pre-empted, or under-delivered placement. Make-good placements are tracked separately for billing and fulfilment reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Net Revenue Amount' ;
    rdfs:comment 'Net revenue recognized for this placement after deducting agency commissions and applicable discounts from gross_revenue_amount. Used for P&L reporting and EBITDA calculation.' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:placementDatetime rdf:type rdf:Property ;
    rdfs:label 'Placement Datetime' ;
    rdfs:comment 'The actual real-world timestamp at which the advertisement began airing within the broadcast window. This is the principal business event timestamp for the placement transaction, recorded in ISO 8601 format with timezone offset.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:placementEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Placement End Datetime' ;
    rdfs:comment 'The actual timestamp at which the advertisement finished airing. Used with placement_datetime to calculate actual on-air duration and verify against contracted spot length.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:placementReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Placement Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric trafficking confirmation code assigned by the ad server or traffic management system (e.g., Dalet Galaxy or third-party ad server) uniquely identifying this placement for reconciliation with agency and advertiser systems.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementStatus rdf:type rdf:Property ;
    rdfs:label 'Placement Status' ;
    rdfs:comment 'Current lifecycle state of the ad placement transaction. \'make_good\' indicates a compensatory placement issued to replace a previously failed or pre-empted spot. [ENUM-REF-CANDIDATE: scheduled|confirmed|delivered|failed|cancelled|make_good — promote to reference product if additional states are required]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementType rdf:type rdf:Property ;
    rdfs:label 'Placement Type' ;
    rdfs:comment 'Classification of the advertising placement format. Distinguishes standard spots from sponsorship billboards, product integrations, lower-third overlays, ticker sponsorships, and interstitial placements. [ENUM-REF-CANDIDATE: spot|sponsorship_billboard|product_integration|lower_third|ticker|interstitial — promote to reference product if additional types are required]' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:podPosition rdf:type rdf:Property ;
    rdfs:label 'Pod Position' ;
    rdfs:comment 'Sequential position of this advertisement within its ad pod (break). First position (1) and last position command premium pricing. Used for competitive separation enforcement and yield management.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regionCode rdf:type rdf:Property ;
    rdfs:label 'Region Code' ;
    rdfs:comment 'Sub-national or market region code (e.g., DMA code, RSN footprint region) within the territory where the placement aired. Supports regional sports network (RSN) audience segmentation and local advertiser reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salesChannel rdf:type rdf:Property ;
    rdfs:label 'Sales Channel' ;
    rdfs:comment 'The sales channel through which this placement was transacted. Distinguishes direct sales, programmatic (automated auction), agency-brokered, house (internal promotional), and trade/barter placements for revenue mix reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledPlacementDatetime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Placement Datetime' ;
    rdfs:comment 'The originally scheduled timestamp for the advertisement to air as defined in the traffic order. Compared against placement_datetime to identify pre-emptions, delays, or make-good scenarios.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:spotDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Spot Duration Seconds' ;
    rdfs:comment 'Contracted length of the advertisement spot in seconds (e.g., 15, 30, 60). Used for inventory valuation, billing reconciliation, and compliance with break duration limits.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:territoryCode rdf:type rdf:Property ;
    rdfs:label 'Territory Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code identifying the geographic territory in which the advertisement was distributed. Critical for rights compliance, blackout enforcement, and territory-level revenue reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:traffickingOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Trafficking Order Number' ;
    rdfs:comment 'The traffic order number from the broadcast traffic management system (e.g., Dalet Galaxy) authorizing this placement. Used for operational reconciliation between sales, traffic, and finance systems.' ;
    rdfs:domain ind:AdPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:audienceRatingId rdf:type rdf:Property ;
    rdfs:label 'Audience Rating Id' ;
    rdfs:comment 'Unique surrogate identifier for each audience rating measurement record in the broadcast domain. Primary key for the audience_rating data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AudienceRating .

ind:mediaAssetId rdf:type rdf:Property ;
    rdfs:label 'Media Asset Id' ;
    rdfs:comment 'Foreign key linking to broadcast.media_asset. Business justification: audience_rating has asset_id → content.asset (cross-domain) but no FK to broadcast.media_asset. The in-domain media_asset contains broadcast-specific metadata (resolution, format, rights) needed for a' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MediaAsset .

ind:vendorContractId rdf:type rdf:Property ;
    rdfs:label 'Vendor Contract Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor_contract. Business justification: Audience measurement data is provided by third-party measurement vendors (e.g., Nielsen) under specific contracts. Linking enables contract-based data quality SLA enforcement, invoice validation, and ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VendorContract .

ind:amaViewers rdf:type rdf:Property ;
    rdfs:label 'Ama Viewers' ;
    rdfs:comment 'Average Minute Audience — the average number of viewers watching at any given minute during the broadcast window. The industry-standard linear TV metric used for GRP (Gross Rating Point) calculation and advertiser CPM (Cost Per Mille) pricing.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:audienceGuaranteeTarget rdf:type rdf:Property ;
    rdfs:label 'Audience Guarantee Target' ;
    rdfs:comment 'Contractually committed minimum audience size (total viewers) for this broadcast window as specified in the media rights or advertising agreement. Used for contractual audience guarantee reconciliation against actual total_viewers. Confidential as it reflects negotiated contract terms.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:avgViewingDurationMins rdf:type rdf:Property ;
    rdfs:label 'Avg Viewing Duration Mins' ;
    rdfs:comment 'Average number of minutes each viewer spent watching the broadcast during the measurement window. Used for audience engagement analysis, content scheduling optimization, and streaming platform retention reporting.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contentGenre rdf:type rdf:Property ;
    rdfs:label 'Content Genre' ;
    rdfs:comment 'Genre classification of the broadcast content (e.g., Live Sport, Sports News, Sports Documentary, Concert, Esports, Magazine Show). Used for scheduling optimization and audience segmentation analysis. [ENUM-REF-CANDIDATE: Live Sport|Sports News|Sports Documentary|Concert|Esports|Magazine Show|Highlights|Other — promote to reference product]' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demoAgeBand rdf:type rdf:Property ;
    rdfs:label 'Demo Age Band' ;
    rdfs:comment 'Age band of the primary target demographic for this audience measurement record. Standard age groupings used by Nielsen and BARB for advertiser targeting and rate card segmentation (e.g., Adults 18-49 is the primary US broadcast demographic).' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demoGender rdf:type rdf:Property ;
    rdfs:label 'Demo Gender' ;
    rdfs:comment 'Gender segment of the audience demographic breakdown for this measurement record. Used for targeted advertising rate card differentiation and sponsor demographic guarantee reporting.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demoIncomeBand rdf:type rdf:Property ;
    rdfs:label 'Demo Income Band' ;
    rdfs:comment 'Household income band of the measured audience segment (e.g., Under $50K, $50K-$100K, $100K-$150K, $150K+). Used for premium advertiser targeting and sponsorship package valuation. [ENUM-REF-CANDIDATE: Under $50K|$50K-$100K|$100K-$150K|$150K-$200K|$200K+ — promote to reference product]' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demoViewersCount rdf:type rdf:Property ;
    rdfs:label 'Demo Viewers Count' ;
    rdfs:comment 'Number of viewers within the specific demographic segment (age band, gender, income band) defined for this record. Enables granular demographic reporting for advertiser guarantee reconciliation.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drmProtected rdf:type rdf:Property ;
    rdfs:label 'Drm Protected' ;
    rdfs:comment 'Indicates whether the broadcast content was delivered with DRM (Digital Rights Management) protection active during the measurement window. Relevant for OTT and IPTV platform compliance and piracy impact assessment on audience figures.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:frequency rdf:type rdf:Property ;
    rdfs:label 'Frequency' ;
    rdfs:comment 'Average number of times a unique viewer was exposed to the broadcast during the measurement period. Used alongside reach to calculate GRP (Gross Rating Point) and assess advertising campaign effectiveness.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grpValue rdf:type rdf:Property ;
    rdfs:label 'Grp Value' ;
    rdfs:comment 'Gross Rating Point value for this broadcast window, representing the sum of ratings across the target audience. Calculated as rating_pct multiplied by frequency. Primary currency for advertising inventory pricing and sponsorship valuation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:guaranteeMet rdf:type rdf:Property ;
    rdfs:label 'Guarantee Met' ;
    rdfs:comment 'Indicates whether the actual audience (total_viewers) met or exceeded the contractual audience guarantee target for this broadcast window. Drives make-good advertising inventory decisions and rights agreement penalty calculations.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketName rdf:type rdf:Property ;
    rdfs:label 'Market Name' ;
    rdfs:comment 'Name of the designated market area (DMA) or broadcast market within the territory (e.g., New York DMA, London ITV Region, Sydney Metro). Used for sub-national audience reporting and RSN rate card justification.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingPct rdf:type rdf:Property ;
    rdfs:label 'Rating Pct' ;
    rdfs:comment 'Percentage of the total universe of TV households or individuals that watched the broadcast, regardless of whether their TV was on. Distinct from share_pct which is based only on those actively viewing. Used for GRP (Gross Rating Point) calculation.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingType rdf:type rdf:Property ;
    rdfs:label 'Rating Type' ;
    rdfs:comment 'Classification of the audience measurement metric captured in this record. GRP (Gross Rating Point) represents total delivery; CPM (Cost Per Mille) supports advertiser rate card justification; Reach measures unique audience; Frequency measures average exposures; AMA (Average Minute Audience) is the standard linear TV metric; Share is the percentage of viewing universe. [ENUM-REF-CANDIDATE: GRP|CPM|Reach|Frequency|Viewership|AMA|Share — promote to reference product]' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reach rdf:type rdf:Property ;
    rdfs:label 'Reach' ;
    rdfs:comment 'Total number of unique individuals who viewed at least one minute of the broadcast during the measured window. Distinct from total_viewers which may count repeat viewing. Used for unduplicated audience reporting to sponsors and rights holders.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingPeriodType rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Type' ;
    rdfs:comment 'Defines the time-shifted viewing window included in this measurement record per Nielsen and BARB standards. Live = real-time only; Live+1 includes same-day DVR; Live+3 includes 3-day playback; Live+7 includes 7-day playback; Live+35 is the C35 standard; VOD is on-demand only.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sharePct rdf:type rdf:Property ;
    rdfs:label 'Share Pct' ;
    rdfs:comment 'Percentage of the total viewing universe (all households/individuals with TV/streaming access) that watched this broadcast during the window. Expressed as a decimal percentage (e.g., 12.500 = 12.5%). Core metric for competitive scheduling analysis.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalViewers rdf:type rdf:Property ;
    rdfs:label 'Total Viewers' ;
    rdfs:comment 'Total number of individual viewers who watched the broadcast during the measured window. The primary headline metric used in media rights negotiations, advertiser rate cards, and contractual audience guarantees.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:universeSize rdf:type rdf:Property ;
    rdfs:label 'Universe Size' ;
    rdfs:comment 'Total size of the viewing universe (total TV households or individuals) used as the denominator for rating_pct and share_pct calculations in the given territory and demographic. Provided by the measurement source.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:windowEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Window End Timestamp' ;
    rdfs:comment 'The precise date and time when the measured broadcast window ended. Combined with window_start_timestamp to define the exact measurement interval for AMA and share calculations.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:windowStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Window Start Timestamp' ;
    rdfs:comment 'The precise date and time when the measured broadcast window began, in ISO 8601 format with timezone offset. Used as the principal business event timestamp for scheduling optimization and rights valuation.' ;
    rdfs:domain ind:AudienceRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:blackoutRuleId rdf:type rdf:Property ;
    rdfs:label 'Blackout Rule Id' ;
    rdfs:comment 'Unique surrogate identifier for the blackout rule record in the broadcast rights management system.' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BlackoutRule .

ind:broadcastDrmPolicyId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Drm Policy Id' ;
    rdfs:comment 'Foreign key linking to broadcast.broadcast_drm_policy. Business justification: blackout_rule has drm_policy_id → content.drm_policy (cross-domain) but no FK to broadcast.broadcast_drm_policy. The broadcast DRM policy is the technical enforcement mechanism for blackout rules (geo' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BroadcastDrmPolicy .

ind:rightsAgreementId rdf:type rdf:Property ;
    rdfs:label 'Rights Agreement Id' ;
    rdfs:comment 'Reference to the media rights agreement that mandates or authorizes this blackout rule. Links the rule to its contractual basis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RightsAgreement .

ind:rightsHolderId rdf:type rdf:Property ;
    rdfs:label 'Rights Holder Id' ;
    rdfs:comment 'Foreign key linking to broadcast.rights_holder. Business justification: Blackout rules are contractual obligations mandated by rights holders to protect territorial exclusivity and ticket sales. Every blackout rule must identify which rights holder mandated the restrictio' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RightsHolder .

ind:appliesToHighlights rdf:type rdf:Property ;
    rdfs:label 'Applies To Highlights' ;
    rdfs:comment 'Indicates whether this blackout rule also restricts distribution of highlight clips and short-form content derived from the blacked-out event.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToReplay rdf:type rdf:Property ;
    rdfs:label 'Applies To Replay' ;
    rdfs:comment 'Indicates whether this blackout rule extends to replay, VOD (Video on Demand), and time-shifted viewing of the event content, in addition to the live broadcast.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:blackoutLiftCondition rdf:type rdf:Property ;
    rdfs:label 'Blackout Lift Condition' ;
    rdfs:comment 'Narrative description of the condition(s) under which this blackout rule is automatically lifted or deactivated (e.g., \'Blackout lifted when 85% of venue capacity is sold 72 hours prior to event start\').' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blackoutType rdf:type rdf:Property ;
    rdfs:label 'Blackout Type' ;
    rdfs:comment 'Classification of the blackout scope: \'local\' (home market territory), \'national\' (entire country), \'international\' (cross-border), \'rsn_exclusivity\' (Regional Sports Network exclusive window), \'ppv\' (Pay-Per-View event blackout), \'ott\' (Over-The-Top streaming platform blackout).' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blackoutWindowHours rdf:type rdf:Property ;
    rdfs:label 'Blackout Window Hours' ;
    rdfs:comment 'Number of hours before and/or after the event start time during which the blackout is enforced. Defines the temporal scope of the blackout window around the event.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:distributionPlatform rdf:type rdf:Property ;
    rdfs:label 'Distribution Platform' ;
    rdfs:comment 'The delivery platform type on which the blackout is enforced: \'linear_tv\' (traditional broadcast), \'ott\' (Over-The-Top streaming), \'iptv\' (Internet Protocol Television), \'rsn\' (Regional Sports Network), \'ppv\' (Pay-Per-View), \'dtc\' (Direct-To-Consumer), \'cable\', \'satellite\'. [ENUM-REF-CANDIDATE: linear_tv|ott|iptv|rsn|ppv|dtc|cable|satellite — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementMechanism rdf:type rdf:Property ;
    rdfs:label 'Enforcement Mechanism' ;
    rdfs:comment 'Technical method used to enforce the blackout rule: \'geo_ip_block\' (IP geolocation blocking), \'drm_token\' (DRM token restriction), \'cdn_restriction\' (CDN-level content blocking), \'access_control\' (platform access control list), \'manual\' (manual operator action), \'api_enforcement\' (API-level enforcement).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geoPrecisionLevel rdf:type rdf:Property ;
    rdfs:label 'Geo Precision Level' ;
    rdfs:comment 'Granularity of geographic enforcement for this blackout rule: \'country\', \'state\', \'dma\' (Designated Market Area), \'zip_code\', \'city\'. Determines how precisely the blackout territory is defined and enforced.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReviewedDate rdf:type rdf:Property ;
    rdfs:label 'Last Reviewed Date' ;
    rdfs:comment 'The most recent date on which this blackout rule was reviewed for accuracy, compliance alignment, and continued applicability by the rights management team.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mandateSource rdf:type rdf:Property ;
    rdfs:label 'Mandate Source' ;
    rdfs:comment 'The originating source of the blackout mandate: \'league_cba\' (Collective Bargaining Agreement), \'rights_contract\' (media rights deal terms), \'regulatory\' (FCC or government regulation), \'venue_agreement\' (venue exclusivity clause), \'network_policy\' (broadcaster internal policy).' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationLeadHours rdf:type rdf:Property ;
    rdfs:label 'Notification Lead Hours' ;
    rdfs:comment 'Number of hours in advance that notification must be submitted to the relevant authority before the blackout rule is activated or lifted. Applicable when notification_required is True.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationRequired rdf:type rdf:Property ;
    rdfs:label 'Notification Required' ;
    rdfs:comment 'Indicates whether advance notification to the league office, rights holder, or regulatory body is required before activating or lifting this blackout rule.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideAuthority rdf:type rdf:Property ;
    rdfs:label 'Override Authority' ;
    rdfs:comment 'The organizational role or body authorized to approve an override of this blackout rule: \'league_office\', \'rights_holder\', \'network_ops\' (Network Operations), \'legal\', \'executive\'. Applicable only when override_eligible is True.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideEligible rdf:type rdf:Property ;
    rdfs:label 'Override Eligible' ;
    rdfs:comment 'Indicates whether this blackout rule can be overridden under specific conditions (e.g., emergency broadcast, league waiver, special event designation). True = override is permissible with authorization.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyClause rdf:type rdf:Property ;
    rdfs:label 'Penalty Clause' ;
    rdfs:comment 'Description of contractual or regulatory penalties applicable if this blackout rule is violated or improperly enforced, as defined in the rights agreement or league mandate.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postEventBlackoutHours rdf:type rdf:Property ;
    rdfs:label 'Post Event Blackout Hours' ;
    rdfs:comment 'Number of hours after event conclusion during which the blackout remains enforced. Protects replay and VOD rights windows for RSN and rights holders.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preEventBlackoutHours rdf:type rdf:Property ;
    rdfs:label 'Pre Event Blackout Hours' ;
    rdfs:comment 'Number of hours prior to event start time during which the blackout is enforced. Used to protect live gate attendance and RSN exclusivity windows.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rsnExclusivity rdf:type rdf:Property ;
    rdfs:label 'Rsn Exclusivity' ;
    rdfs:comment 'Indicates whether this blackout rule is driven by RSN exclusivity rights. True = an RSN holds exclusive broadcast rights in the territory, triggering the blackout on competing platforms.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rsnPartnerName rdf:type rdf:Property ;
    rdfs:label 'Rsn Partner Name' ;
    rdfs:comment 'Name of the RSN partner holding exclusive broadcast rights that trigger this blackout (e.g., \'Bally Sports\', \'MSG Network\', \'ROOT Sports\'). Populated when rsn_exclusivity is True.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleCode rdf:type rdf:Property ;
    rdfs:label 'Rule Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this blackout rule, used in league governance documents, RSN contracts, and broadcast operations systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleDescription rdf:type rdf:Property ;
    rdfs:label 'Rule Description' ;
    rdfs:comment 'Detailed narrative description of the blackout rule, including its business rationale, contractual basis, and operational scope.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleName rdf:type rdf:Property ;
    rdfs:label 'Rule Name' ;
    rdfs:comment 'Human-readable name describing the blackout rule (e.g., \'NFL Home Market Local Blackout\', \'RSN Exclusivity Window - Pacific Northwest\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleStatus rdf:type rdf:Property ;
    rdfs:label 'Rule Status' ;
    rdfs:comment 'Current lifecycle state of the blackout rule: \'active\' (currently enforced), \'inactive\' (not enforced), \'pending\' (awaiting activation), \'suspended\' (temporarily halted), \'expired\' (past effective period), \'draft\' (under review).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryRegion rdf:type rdf:Property ;
    rdfs:label 'Territory Region' ;
    rdfs:comment 'Sub-national region, DMA (Designated Market Area), or RSN coverage zone within the territory where the blackout applies (e.g., \'New York DMA\', \'Pacific Northwest RSN Zone\'). Complements territory_code for granular geographic enforcement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketSalesThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Ticket Sales Threshold Pct' ;
    rdfs:comment 'The minimum percentage of venue capacity that must be sold for the blackout to be lifted (e.g., 85.00 means 85% of tickets must be sold). Applicable when trigger_condition is \'ticket_sales_threshold\' or \'sellout_rule\'.' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:triggerCondition rdf:type rdf:Property ;
    rdfs:label 'Trigger Condition' ;
    rdfs:comment 'The business condition that activates this blackout rule: \'ticket_sales_threshold\' (blackout lifted when ticket sales meet threshold), \'rsn_exclusivity\' (RSN holds exclusive rights), \'league_mandate\' (governing body requirement), \'rights_agreement\' (contractual obligation), \'ppv_purchase\' (PPV event requiring purchase), \'sellout_rule\' (event sold out). [ENUM-REF-CANDIDATE: ticket_sales_threshold|rsn_exclusivity|league_mandate|rights_agreement|ppv_purchase|sellout_rule|capacity_threshold|broadcast_window — promote to reference product]' ;
    rdfs:domain ind:BlackoutRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorshipActivationId rdf:type rdf:Property ;
    rdfs:label 'Sponsorship Activation Id' ;
    rdfs:comment 'Foreign key linking to sponsorship.activation. Business justification: Broadcast ad inventory slots are the physical delivery mechanism for sponsorship activations. Linking connects the broadcast-side slot record to the sponsorship activation it fulfills, enabling cross-' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SponsorshipActivation .

ind:sponsorshipAdInventoryId rdf:type rdf:Property ;
    rdfs:label 'Sponsorship Ad Inventory Id' ;
    rdfs:comment 'Foreign key linking to sponsorship.sponsorship_ad_inventory. Business justification: Broadcast ad inventory slots correspond to sponsorship ad inventory assets in the catalog. Linking connects the sold broadcast slot to the sponsorship asset it represents, enabling cross-domain invent' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SponsorshipAdInventory .

ind:actualAirTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Air Timestamp' ;
    rdfs:comment 'The confirmed date and time when this advertising slot actually aired, as recorded by the broadcast playout system. May differ from scheduled_air_timestamp due to live event overruns or schedule changes. Null until slot has aired.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualCpmAchieved rdf:type rdf:Property ;
    rdfs:label 'Actual Cpm Achieved' ;
    rdfs:comment 'The realized Cost Per Mille (CPM) rate in USD for this slot after execution, reflecting the contracted or programmatically cleared rate. Null until slot is sold. Used for revenue reporting and yield optimization analysis.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adCategory rdf:type rdf:Property ;
    rdfs:label 'Ad Category' ;
    rdfs:comment 'IAB content taxonomy category of the advertiser\'s product or service (e.g., \'Automotive\', \'Financial Services\', \'Consumer Electronics\'). Used for competitive separation enforcement and category exclusivity validation. [ENUM-REF-CANDIDATE: automotive|financial-services|consumer-electronics|food-beverage|retail|telecom|healthcare|entertainment|sports|travel — promote to reference product]' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyCommissionPct rdf:type rdf:Property ;
    rdfs:label 'Agency Commission Pct' ;
    rdfs:comment 'Percentage of gross revenue payable to the advertising agency as commission for placing the buy. Standard industry rate is 15%. Used to calculate net revenue and accounts payable to agencies.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:blackoutApplicable rdf:type rdf:Property ;
    rdfs:label 'Blackout Applicable' ;
    rdfs:comment 'Indicates whether broadcast blackout rules apply to this ad slot in the specified territory, restricting distribution based on media rights agreements. True = blackout rules apply; False = no blackout restriction. Critical for rights compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:breakNumber rdf:type rdf:Property ;
    rdfs:label 'Break Number' ;
    rdfs:comment 'Sequential number of the commercial break within the broadcast window to which this slot belongs (e.g., Break 1, Break 2). Used for scheduling and trafficking coordination.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cdnDeliveryEndpoint rdf:type rdf:Property ;
    rdfs:label 'Cdn Delivery Endpoint' ;
    rdfs:comment 'The Content Delivery Network (CDN) endpoint URL or identifier used to serve the ad creative for OTT and streaming platform delivery. Null for linear TV slots. Used by ad operations for trafficking and delivery verification.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentRating rdf:type rdf:Property ;
    rdfs:label 'Content Rating' ;
    rdfs:comment 'Audience content rating of the broadcast window in which this ad slot appears, used to enforce advertiser brand safety requirements and regulatory compliance. Restricts certain ad categories from appearing in age-restricted content.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cpmFloorRate rdf:type rdf:Property ;
    rdfs:label 'Cpm Floor Rate' ;
    rdfs:comment 'Minimum acceptable Cost Per Mille (CPM) rate in USD for this advertising slot, below which the slot will not be sold. Set by revenue management based on platform, slot type, and audience reach. Used as the baseline for programmatic and direct sales negotiations.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impressionsGuaranteed rdf:type rdf:Property ;
    rdfs:label 'Impressions Guaranteed' ;
    rdfs:comment 'The number of audience impressions contractually guaranteed to the advertiser for this slot, based on audience ratings projections (GRP-based). Used for make-good calculations if delivery falls short.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isMakegood rdf:type rdf:Property ;
    rdfs:label 'Is Makegood' ;
    rdfs:comment 'Indicates whether this slot is a make-good placement issued to compensate an advertiser for under-delivery of impressions on a previously aired slot. True = make-good; False = standard placement. Tracked for liability management and client relations.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isProgrammatic rdf:type rdf:Property ;
    rdfs:label 'Is Programmatic' ;
    rdfs:comment 'Indicates whether this slot was sold via programmatic advertising technology (e.g., programmatic direct, private marketplace) rather than direct sales. True = programmatic; False = direct/manual sale. Used for channel mix analysis and yield optimization.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSold rdf:type rdf:Property ;
    rdfs:label 'Is Sold' ;
    rdfs:comment 'Indicates whether this advertising slot has been sold to an advertiser. True = sold; False = available or unsold inventory. Primary flag for inventory availability dashboards and yield management reporting.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSponsorshipExclusive rdf:type rdf:Property ;
    rdfs:label 'Is Sponsorship Exclusive' ;
    rdfs:comment 'Indicates whether this slot carries a sponsorship exclusivity restriction, preventing competing brands in the same product category from advertising within the same broadcast window. True = exclusive; False = non-exclusive. Governed by sponsorship partnership agreements.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketRegion rdf:type rdf:Property ;
    rdfs:label 'Market Region' ;
    rdfs:comment 'Broadcast market or designated market area (DMA) name for this ad slot (e.g., \'New York DMA\', \'Los Angeles DMA\', \'UK National\'). Used for regional sales targeting and RSN-specific inventory management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Order Reference Number' ;
    rdfs:comment 'The externally-known sales order or insertion order (IO) number from the advertiser or agency, as recorded in SAP S/4HANA SD. Links this slot to the commercial sales transaction for billing and revenue recognition.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Placement Timestamp' ;
    rdfs:comment 'Date and time when the advertiser creative was formally trafficked and placed into this slot by the ad operations team. Marks the transition from sold to trafficked status.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledAirTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Air Timestamp' ;
    rdfs:comment 'The planned broadcast date and time when this advertising slot is scheduled to air, expressed in ISO 8601 format with timezone offset. Principal business event timestamp for scheduling and trafficking workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:slotCode rdf:type rdf:Property ;
    rdfs:label 'Slot Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for this advertising inventory slot, used in trafficking systems, sales orders, and agency communications (e.g., \'SLOT-ESPN-MR-001\'). Unique within a broadcast schedule.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slotDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Slot Duration Seconds' ;
    rdfs:comment 'Length of the advertising slot in seconds. Standard broadcast durations include 15, 30, 60, and 90 seconds. Used for scheduling, pricing, and trafficking validation.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slotPosition rdf:type rdf:Property ;
    rdfs:label 'Slot Position' ;
    rdfs:comment 'Ordinal position of this ad slot within its commercial break or content block (e.g., 1 = first position, 2 = second position). First and last positions typically command premium CPM rates.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slotStatus rdf:type rdf:Property ;
    rdfs:label 'Slot Status' ;
    rdfs:comment 'Current lifecycle state of the advertising inventory slot. Drives revenue recognition, trafficking workflows, and inventory availability reporting. Values: available (open for sale), reserved (held pending contract), sold (contracted), trafficked (creative assigned and scheduled), aired (broadcast confirmed), cancelled (removed from schedule).' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:traffickingConfirmationCode rdf:type rdf:Property ;
    rdfs:label 'Trafficking Confirmation Code' ;
    rdfs:comment 'Unique confirmation code issued by the ad trafficking system (e.g., Dalet Galaxy or third-party ad server) upon successful scheduling of the creative asset into this slot. Serves as the operational proof of trafficking completion.' ;
    rdfs:domain ind:BroadcastAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentPolicyBroadcastDrmPolicyId rdf:type rdf:Property ;
    rdfs:label 'Parent Policy Broadcast Drm Policy Id' ;
    rdfs:comment 'Reference to a parent DRM policy from which this policy inherits base settings. Supports hierarchical policy structures where sport-specific or event-specific policies extend a master DRM policy template.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BroadcastDrmPolicy .

ind:analyticsTrackingEnabled rdf:type rdf:Property ;
    rdfs:label 'Analytics Tracking Enabled' ;
    rdfs:comment 'Indicates whether playback analytics and DRM license event tracking are enabled for content governed by this policy. Supports ARPU analysis, concurrent stream monitoring, and rights compliance reporting in Adobe Experience Platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:blackoutRuleEnabled rdf:type rdf:Property ;
    rdfs:label 'Blackout Rule Enabled' ;
    rdfs:comment 'Indicates whether local or regional blackout rules are enforced under this DRM policy. Blackout rules restrict live event streaming in local broadcast markets to protect RSN and linear TV rights agreements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cdnProfileCode rdf:type rdf:Property ;
    rdfs:label 'Cdn Profile Code' ;
    rdfs:comment 'Identifier of the CDN delivery profile associated with this DRM policy. CDN profiles define token authentication, signed URL parameters, and edge caching rules that complement DRM enforcement.' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceStandard rdf:type rdf:Property ;
    rdfs:label 'Compliance Standard' ;
    rdfs:comment 'Regulatory or industry compliance standard that this DRM policy is designed to satisfy (e.g., \'GDPR\', \'CCPA\', \'PCI-DSS\', \'FCC\'). Supports compliance reporting and audit trail requirements for content protection governance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concurrentStreamLimit rdf:type rdf:Property ;
    rdfs:label 'Concurrent Stream Limit' ;
    rdfs:comment 'Maximum number of simultaneous active streams permitted per subscriber entitlement under this DRM policy. Enforced at the CDN and streaming platform level to prevent credential sharing and protect media rights revenue.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contentTier rdf:type rdf:Property ;
    rdfs:label 'Content Tier' ;
    rdfs:comment 'Content access tier to which this DRM policy applies, aligning with subscription or entitlement levels. VIP tiers may include exclusive live events or athlete content; PPV tiers apply to pay-per-view events such as UFC or boxing matches.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceAuthenticationRequired rdf:type rdf:Property ;
    rdfs:label 'Device Authentication Required' ;
    rdfs:comment 'Indicates whether device-level authentication and registration is required before DRM license issuance. When true, only registered and authenticated devices may receive license keys for protected content.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:downloadPermitted rdf:type rdf:Property ;
    rdfs:label 'Download Permitted' ;
    rdfs:comment 'Indicates whether offline download of protected content is permitted under this DRM policy. When true, download-to-own or rental download workflows are enabled subject to license expiry rules.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drmTechnology rdf:type rdf:Property ;
    rdfs:label 'Drm Technology' ;
    rdfs:comment 'The DRM technology stack applied to enforce content protection. Widevine is used for Android/Chrome, FairPlay for Apple devices, PlayReady for Microsoft/Smart TVs, and multi_drm indicates a combined approach for cross-platform delivery.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encryptionStandard rdf:type rdf:Property ;
    rdfs:label 'Encryption Standard' ;
    rdfs:comment 'Cryptographic encryption standard applied to protected content streams. AES-128 and AES-256 are common for HLS, CENC (Common Encryption) is used for DASH multi-DRM, and CBCS is the Apple FairPlay encryption scheme.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geoBlockedTerritories rdf:type rdf:Property ;
    rdfs:label 'Geo Blocked Territories' ;
    rdfs:comment 'Comma-separated list of ISO 3166-1 alpha-3 country codes explicitly blocked from content playback under this DRM policy. Supports blackout rules for RSN exclusivity and international rights restrictions.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geoPermittedTerritories rdf:type rdf:Property ;
    rdfs:label 'Geo Permitted Territories' ;
    rdfs:comment 'Comma-separated list of ISO 3166-1 alpha-3 country codes (e.g., \'USA,CAN,GBR\') where content playback is permitted under this DRM policy. Used to enforce broadcast rights territorial restrictions for RSN, OTT, and DTC platforms.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geoRestrictionEnabled rdf:type rdf:Property ;
    rdfs:label 'Geo Restriction Enabled' ;
    rdfs:comment 'Indicates whether geographic access restrictions are enforced under this DRM policy. When true, content playback is limited to permitted territories defined in the geo_permitted_territories and geo_blocked_territories fields.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hdcpVersionRequired rdf:type rdf:Property ;
    rdfs:label 'Hdcp Version Required' ;
    rdfs:comment 'Minimum HDCP version required on the display output for content playback under this DRM policy. HDCP 2.2 or higher is typically required for 4K UHD premium sports content.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseDurationHours rdf:type rdf:Property ;
    rdfs:label 'License Duration Hours' ;
    rdfs:comment 'Duration in hours for which a DRM license key is valid after issuance to a device. After expiry, the device must re-request a license from the license server. Controls content access windows for rental and PPV models.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:licenseRenewalRequired rdf:type rdf:Property ;
    rdfs:label 'License Renewal Required' ;
    rdfs:comment 'Indicates whether the DRM license must be renewed (re-fetched from the license server) during active playback sessions. When true, the player must periodically contact the license server to maintain uninterrupted playback.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseServerUrl rdf:type rdf:Property ;
    rdfs:label 'License Server Url' ;
    rdfs:comment 'HTTPS endpoint URL of the DRM license server responsible for issuing and validating license keys for content governed by this policy. Must use HTTPS. Configured per DRM technology (Widevine, FairPlay, PlayReady).' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxRegisteredDevices rdf:type rdf:Property ;
    rdfs:label 'Max Registered Devices' ;
    rdfs:comment 'Maximum number of devices a subscriber may register for DRM license delivery under this policy. Limits credential sharing and protects media rights revenue across OTT and DTC platforms.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:offlinePlaybackDurationHours rdf:type rdf:Property ;
    rdfs:label 'Offline Playback Duration Hours' ;
    rdfs:comment 'Maximum number of hours a downloaded content item may be played back offline before the DRM license expires and re-authentication is required. Null when download is not permitted.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outputProtectionRequired rdf:type rdf:Property ;
    rdfs:label 'Output Protection Required' ;
    rdfs:comment 'Indicates whether HDCP (High-bandwidth Digital Content Protection) or equivalent output protection is required on connected display outputs. Enforced for premium and PPV content to prevent unauthorized recording.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:platformType rdf:type rdf:Property ;
    rdfs:label 'Platform Type' ;
    rdfs:comment 'Delivery platform category to which this DRM policy applies. OTT (Over-The-Top), IPTV (Internet Protocol Television), DTC (Direct-To-Consumer), linear TV broadcast, mobile app, or web browser. Determines applicable DRM technology and encryption requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyCode rdf:type rdf:Property ;
    rdfs:label 'Policy Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the DRM policy, used in rights agreements, vendor contracts, and system integrations with Dalet Galaxy and CDN platforms. Format: DRM- followed by 4-20 uppercase alphanumeric characters.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyDescription rdf:type rdf:Property ;
    rdfs:label 'Policy Description' ;
    rdfs:comment 'Free-text description of the DRM policy\'s purpose, scope, and any special enforcement conditions. Used by rights management and broadcast operations teams for policy governance and documentation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyName rdf:type rdf:Property ;
    rdfs:label 'Policy Name' ;
    rdfs:comment 'Human-readable name of the DRM policy used for identification in broadcast operations, rights management workflows, and reporting dashboards (e.g., \'NFL Sunday Ticket PPV Standard\', \'OTT Premium Tier FairPlay\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyStatus rdf:type rdf:Property ;
    rdfs:label 'Policy Status' ;
    rdfs:comment 'Current lifecycle state of the DRM policy. Active policies are enforced on streaming platforms; deprecated policies are retained for historical audit and compliance purposes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyType rdf:type rdf:Property ;
    rdfs:label 'Policy Type' ;
    rdfs:comment 'Classification of the DRM policy by monetization model: subscription (SVOD), pay-per-view (PPV), rental (TVOD), download-to-own (EST), free ad-supported (AVOD), or preview. Drives entitlement logic and revenue reporting. [ENUM-REF-CANDIDATE: subscription|ppv|rental|download_to_own|free_ad_supported|preview — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyVersion rdf:type rdf:Property ;
    rdfs:label 'Policy Version' ;
    rdfs:comment 'Version number of the DRM policy definition, following semantic versioning (e.g., \'1.0\', \'2.1.3\'). Enables tracking of policy changes over time and supports rollback in case of compliance issues.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionRestriction rdf:type rdf:Property ;
    rdfs:label 'Resolution Restriction' ;
    rdfs:comment 'Maximum video resolution permitted for playback under this DRM policy. Resolution restrictions may be applied based on device capability, subscription tier, or rights agreement terms (e.g., SD-only for non-authenticated devices).' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsAgreementRef rdf:type rdf:Property ;
    rdfs:label 'Rights Agreement Ref' ;
    rdfs:comment 'External reference code or contract number of the media rights agreement that mandates this DRM policy. Links DRM enforcement requirements back to the contractual obligation with leagues (NFL, NBA, FIFA) or broadcast partners.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsWindowType rdf:type rdf:Property ;
    rdfs:label 'Rights Window Type' ;
    rdfs:comment 'Type of content rights window governed by this DRM policy: live (real-time broadcast), VOD (video on demand), replay (post-event catch-up), archive (long-term library), or preview (short promotional clip). Determines applicable DRM enforcement rules.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:robustnessLevel rdf:type rdf:Property ;
    rdfs:label 'Robustness Level' ;
    rdfs:comment 'Widevine/PlayReady robustness level required for license issuance, defining the security tier of the decryption environment. HW_SECURE_ALL requires hardware-level TEE (Trusted Execution Environment) and is mandated for 4K UHD premium sports content.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screenCaptureBlocked rdf:type rdf:Property ;
    rdfs:label 'Screen Capture Blocked' ;
    rdfs:comment 'Indicates whether screen capture and screen recording are blocked on supported platforms under this DRM policy. Enforced via OS-level DRM APIs on Android (Widevine) and iOS (FairPlay) to prevent unauthorized content capture.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tokenAuthRequired rdf:type rdf:Property ;
    rdfs:label 'Token Auth Required' ;
    rdfs:comment 'Indicates whether a signed authentication token (e.g., JWT) is required when requesting a DRM license. Token authentication prevents unauthorized license acquisition and is standard for premium and PPV content.' ;
    rdfs:domain ind:BroadcastDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tokenExpirySeconds rdf:type rdf:Property ;
    rdfs:label 'Token Expiry Seconds' ;
    rdfs:comment 'Duration in seconds after which the authentication token used for DRM license requests expires. Short expiry windows reduce the risk of token replay attacks on premium sports content.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:watermarkType rdf:type rdf:Property ;
    rdfs:label 'Watermark Type' ;
    rdfs:comment 'Type of watermarking applied to protected content: forensic (invisible, embedded in bitstream for piracy tracing), visible (on-screen overlay), both, or none. Forensic watermarking is standard for live PPV and premium sports events.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watermarkingRequired rdf:type rdf:Property ;
    rdfs:label 'Watermarking Required' ;
    rdfs:comment 'Indicates whether forensic or visible watermarking must be applied to content streams under this DRM policy. Watermarking enables source tracing of unauthorized redistribution and piracy detection.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contentCategoryId rdf:type rdf:Property ;
    rdfs:label 'Content Category Id' ;
    rdfs:comment 'Reference to the content category classification governing what type of content is covered by this rights window (e.g., live match, highlight reel, documentary, PPV event).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContentCategory .

ind:licenseeId rdf:type rdf:Property ;
    rdfs:label 'Licensee Id' ;
    rdfs:comment 'Reference to the broadcaster, OTT platform, or network entity that has been granted the rights for this window (e.g., RSN, DTC streaming service, IPTV provider).' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Licensee .

ind:primaryBroadcastCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Primary Broadcast Corporate Entity Id' ;
    rdfs:comment 'Reference to the organisation or party that holds the broadcast rights for this window (e.g., league, federation, production company). Supports rights enforcement and royalty attribution.' ;
    rdfs:domain ind:BroadcastRightsWindow ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:advertisingRightsIncluded rdf:type rdf:Property ;
    rdfs:label 'Advertising Rights Included' ;
    rdfs:comment 'Indicates whether the licensee has the right to sell advertising inventory (e.g., CPM-based ad slots) within the broadcast under this rights window. Impacts revenue share calculations and sponsorship conflict management.' ;
    rdfs:domain ind:BroadcastRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastWindowType rdf:type rdf:Property ;
    rdfs:label 'Broadcast Window Type' ;
    rdfs:comment 'Classifies the role of this rights window within the overall broadcast schedule. Primary windows cover live or first-run broadcasts; secondary covers repeat broadcasts; catch-up covers time-shifted viewing; archive covers library content; preview covers promotional clips.' ;
    rdfs:domain ind:BroadcastRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catchupWindowDays rdf:type rdf:Property ;
    rdfs:label 'Catchup Window Days' ;
    rdfs:comment 'Number of days after the original broadcast during which the licensee may make the content available for catch-up or time-shifted viewing. Zero or null indicates no catch-up rights are granted.' ;
    rdfs:domain ind:BroadcastRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:conflictResolutionStatus rdf:type rdf:Property ;
    rdfs:label 'Conflict Resolution Status' ;
    rdfs:comment 'Current status of any rights conflict resolution process for this window. Populated only when rights_conflict_flag is True. Tracks progression from detection through resolution or escalation to CAS arbitration.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusivityFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Flag' ;
    rdfs:comment 'Indicates whether the rights granted in this window are exclusive to the licensee within the defined territory and platform. True = exclusive; False = non-exclusive. Exclusive windows command premium rights fees and restrict sublicensing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxBroadcastCount rdf:type rdf:Property ;
    rdfs:label 'Max Broadcast Count' ;
    rdfs:comment 'The maximum number of times the content may be broadcast under this rights window. Null indicates unlimited broadcasts within the window period. Enforced by the DRM and broadcast scheduling systems.' ;
    rdfs:domain ind:BroadcastRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minLeadTimeHours rdf:type rdf:Property ;
    rdfs:label 'Min Lead Time Hours' ;
    rdfs:comment 'The minimum number of hours before the scheduled broadcast that the licensee must notify the rights holder or activate the content feed. Supports SLA (Service Level Agreement) compliance and OB (Outside Broadcast) logistics.' ;
    rdfs:domain ind:BroadcastRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentScheduleType rdf:type rdf:Property ;
    rdfs:label 'Payment Schedule Type' ;
    rdfs:comment 'Defines the payment cadence for the rights fee associated with this window. Drives accounts receivable scheduling in SAP S/4HANA and cash flow forecasting in Workday Adaptive Planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionTier rdf:type rdf:Property ;
    rdfs:label 'Resolution Tier' ;
    rdfs:comment 'The maximum video resolution permitted for broadcast under this rights window (SD, HD, 4K, 8K). Higher resolution tiers typically command premium rights fees and require specific CDN and DRM capabilities.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueSharePct rdf:type rdf:Property ;
    rdfs:label 'Revenue Share Pct' ;
    rdfs:comment 'The percentage of broadcast revenue (e.g., subscription, PPV, advertising) that the licensee must remit to the rights holder under this window. Drives financial settlement and EBITDA reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightsCategory rdf:type rdf:Property ;
    rdfs:label 'Rights Category' ;
    rdfs:comment 'Broad classification of the rights type granted in this window. Distinguishes domestic broadcast rights from international, digital, mobile, radio, PPV (Pay-Per-View), and archive rights. [ENUM-REF-CANDIDATE: domestic|international|digital|mobile|radio|ppv|archive — promote to reference product]' ;
    rdfs:domain ind:BroadcastRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsConflictFlag rdf:type rdf:Property ;
    rdfs:label 'Rights Conflict Flag' ;
    rdfs:comment 'Indicates whether a rights conflict has been detected for this window (e.g., overlapping exclusivity with another window for the same content, platform, and territory). Triggers review workflow in the rights management system.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rightsFeeAllocationPct rdf:type rdf:Property ;
    rdfs:label 'Rights Fee Allocation Pct' ;
    rdfs:comment 'The percentage of the total parent deal rights fee allocated to this specific window. Enables proportional revenue recognition and financial reporting across multiple windows derived from a single deal.' ;
    rdfs:domain ind:BroadcastRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightsFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Rights Fee Amount' ;
    rdfs:comment 'The monetary value of the rights fee allocated to this specific window from the parent rights deal. Represents the portion of the total deal value attributable to this platform-territory-period combination. Used for revenue recognition and financial reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightsFeeCurrency rdf:type rdf:Property ;
    rdfs:label 'Rights Fee Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the rights fee amount (e.g., USD, GBP, EUR). Required for multi-currency rights deals across global markets.' ;
    rdfs:domain ind:BroadcastRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sublicensingPermitted rdf:type rdf:Property ;
    rdfs:label 'Sublicensing Permitted' ;
    rdfs:comment 'Indicates whether the licensee is contractually permitted to sublicense the broadcast rights to third parties within this window. Drives downstream rights conflict detection and IP (Intellectual Property) protection enforcement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:territoryScope rdf:type rdf:Property ;
    rdfs:label 'Territory Scope' ;
    rdfs:comment 'Indicates the geographic breadth of the rights window beyond a single country code. Supports multi-territory deal structures where a single window covers a defined group of markets.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windowEnd rdf:type rdf:Property ;
    rdfs:label 'Window End' ;
    rdfs:comment 'The precise date and time (exclusive) after which the licensee\'s broadcast rights under this window expire. Nullable for perpetual or open-ended windows. Critical for automated rights expiry enforcement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windowReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Window Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for this rights window, used in contracts, invoices, and rights management systems. Enables cross-system reconciliation with SAP S/4HANA and Dalet Galaxy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windowStart rdf:type rdf:Property ;
    rdfs:label 'Window Start' ;
    rdfs:comment 'The precise date and time (inclusive) from which the licensee is permitted to broadcast content under this rights window. Used for real-time rights enforcement at the CDN and DRM layer.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windowStatus rdf:type rdf:Property ;
    rdfs:label 'Window Status' ;
    rdfs:comment 'Current lifecycle state of the broadcast rights window. Drives rights enforcement logic: only \'active\' windows permit broadcast. Transitions follow deal negotiation and regulatory approval workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentDrmPolicyId rdf:type rdf:Property ;
    rdfs:label 'Content Drm Policy Id' ;
    rdfs:comment 'Reference to the Digital Rights Management (DRM) policy applied to this broadcast schedule entry for content protection across OTT, IPTV, and DTC platforms. Ensures compliance with rights agreements and prevents unauthorized redistribution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContentDrmPolicy .

ind:leagueScheduleId rdf:type rdf:Property ;
    rdfs:label 'League Schedule Id' ;
    rdfs:comment 'Foreign key linking to league.schedule. Business justification: Broadcast operations teams map air schedules to the league\'s official game schedule for rights compliance, production planning, and blackout enforcement. A sports-entertainment domain expert would exp' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LeagueSchedule .

ind:playoffBracketId rdf:type rdf:Property ;
    rdfs:label 'Playoff Bracket Id' ;
    rdfs:comment 'Foreign key linking to league.playoff_bracket. Business justification: Playoff broadcasts require scheduling tied to specific bracket rounds and matchups for rights compliance, PPV pricing, and production planning. Broadcast schedulers must know which playoff bracket slo' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PlayoffBracket .

ind:productionTeamId rdf:type rdf:Property ;
    rdfs:label 'Production Team Id' ;
    rdfs:comment 'Reference to the production crew or outside broadcast (OB) unit assigned to produce this broadcast schedule entry. Links to workforce and production assignment records for resource planning.' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProductionTeam .

ind:actualEndTime rdf:type rdf:Property ;
    rdfs:label 'Actual End Time' ;
    rdfs:comment 'Actual timestamp at which the broadcast feed concluded. Used alongside actual_start_time to compute true broadcast duration for rights compliance and billing reconciliation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualStartTime rdf:type rdf:Property ;
    rdfs:label 'Actual Start Time' ;
    rdfs:comment 'Actual timestamp at which the broadcast feed went live or playback commenced. Compared against scheduled_start_time for on-time performance reporting and SLA compliance tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:adBreakCount rdf:type rdf:Property ;
    rdfs:label 'Ad Break Count' ;
    rdfs:comment 'Number of planned commercial advertisement breaks within this broadcast schedule entry. Used for sponsorship inventory management, ad sales planning, and revenue forecasting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adBreakDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Ad Break Duration Minutes' ;
    rdfs:comment 'Total planned duration of all commercial advertisement breaks in minutes for this broadcast schedule entry. Used for ad inventory capacity planning and sponsor commitment fulfillment tracking.' ;
    rdfs:domain ind:BroadcastSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:airDate rdf:type rdf:Property ;
    rdfs:label 'Air Date' ;
    rdfs:comment 'Calendar date on which the broadcast is scheduled to air. Used for day-level scheduling, program guide publication, and rights window validation.' ;
    rdfs:domain ind:BroadcastSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:audioDescriptionRequired rdf:type rdf:Property ;
    rdfs:label 'Audio Description Required' ;
    rdfs:comment 'Indicates whether audio description (video description for visually impaired viewers) is required for this broadcast. Driven by FCC accessibility mandates and ADA compliance requirements for broadcast content.' ;
    rdfs:domain ind:BroadcastSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closedCaptionRequired rdf:type rdf:Property ;
    rdfs:label 'Closed Caption Required' ;
    rdfs:comment 'Indicates whether closed captioning is required for this broadcast schedule entry. Mandatory for FCC compliance under the Twenty-First Century Communications and Video Accessibility Act (CVAA) and ADA accessibility requirements.' ;
    rdfs:domain ind:BroadcastSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commentaryLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Commentary Language Code' ;
    rdfs:comment 'ISO 639-1/639-2 language code for the commentary/play-by-play audio track, which may differ from the primary broadcast language. Relevant for international feed distribution and multi-language OTT packaging.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedFormat rdf:type rdf:Property ;
    rdfs:label 'Feed Format' ;
    rdfs:comment 'Technical broadcast feed format specifying the video quality standard for this schedule entry (e.g., HD, 4K, SD, HDR, VR). Used for CDN capacity planning, encoder assignment, and viewer experience reporting.' ;
    rdfs:domain ind:BroadcastSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalFeed rdf:type rdf:Property ;
    rdfs:label 'International Feed' ;
    rdfs:comment 'Indicates whether this broadcast schedule entry uses an international feed (world feed) as opposed to a domestic production feed. Relevant for FIFA, IOC, and other international governing body rights distribution.' ;
    rdfs:domain ind:BroadcastSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:obUnitCode rdf:type rdf:Property ;
    rdfs:label 'Ob Unit Code' ;
    rdfs:comment 'Identifier for the Outside Broadcast (OB) truck or mobile production unit assigned to this broadcast schedule entry. Used for equipment scheduling, logistics coordination, and production cost allocation.' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppvEvent rdf:type rdf:Property ;
    rdfs:label 'Ppv Event' ;
    rdfs:comment 'Indicates whether this broadcast schedule entry is a Pay-Per-View (PPV) event requiring individual purchase or access authorization. When True, triggers PPV pricing, access control, and revenue tracking workflows.' ;
    rdfs:domain ind:BroadcastSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ppvPrice rdf:type rdf:Property ;
    rdfs:label 'Ppv Price' ;
    rdfs:comment 'Retail price charged to consumers for access to this Pay-Per-View (PPV) broadcast event. Applicable only when ppv_event is True. Used for revenue forecasting, pricing strategy analysis, and consumer billing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Program Duration Minutes' ;
    rdfs:comment 'Planned duration of the broadcast program in minutes as scheduled in the program guide. Used for slot allocation, ad break planning, and rights window compliance verification.' ;
    rdfs:domain ind:BroadcastSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ratingClassification rdf:type rdf:Property ;
    rdfs:label 'Rating Classification' ;
    rdfs:comment 'Content rating classification assigned to this broadcast as per the TV Parental Guidelines system (e.g., TV-G, TV-PG, TV-14, TV-MA). Required for FCC compliance, parental control enforcement, and OTT platform content filtering.' ;
    rdfs:domain ind:BroadcastSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceCode rdf:type rdf:Property ;
    rdfs:label 'Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric code assigned by Dalet Galaxy to uniquely identify this broadcast schedule entry across systems. Used for cross-system reconciliation and operational communication with broadcast partners.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rsnAffiliateCode rdf:type rdf:Property ;
    rdfs:label 'Rsn Affiliate Code' ;
    rdfs:comment 'Code identifying the Regional Sports Network (RSN) affiliate carrying this broadcast. Applicable for regional distribution entries. Used for affiliate rights tracking, revenue sharing calculations, and regional audience reporting.' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Schedule Status' ;
    rdfs:comment 'Current lifecycle state of the broadcast schedule entry within the Dalet Galaxy workflow. Drives operational readiness and downstream distribution actions. [ENUM-REF-CANDIDATE: draft|confirmed|on_air|completed|cancelled|postponed — promote to reference product if additional states are required]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledEndTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Time' ;
    rdfs:comment 'Precise date and timestamp at which the broadcast window is scheduled to conclude, including timezone offset. Used for slot duration calculation, back-to-back scheduling, and CDN resource planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledStartTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Time' ;
    rdfs:comment 'Precise date and timestamp at which the broadcast window is scheduled to begin, including timezone offset. Principal real-world event time for this schedule entry. Stored in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:simulcastFlag rdf:type rdf:Property ;
    rdfs:label 'Simulcast Flag' ;
    rdfs:comment 'Indicates whether this broadcast schedule entry is a simultaneous multi-platform broadcast (simulcast) airing on multiple channels or platforms at the same time. Used for rights management and audience deduplication in ratings reporting.' ;
    rdfs:domain ind:BroadcastSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timeZone rdf:type rdf:Property ;
    rdfs:label 'Time Zone' ;
    rdfs:comment 'IANA time zone identifier for the primary broadcast market (e.g., \'America/New_York\', \'Europe/London\'). Required for accurate local air time display in program guides and blackout rule enforcement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:title rdf:type rdf:Property ;
    rdfs:label 'Title' ;
    rdfs:comment 'Human-readable title of the broadcast schedule entry as it appears in the Dalet Galaxy workflow and on-air program guides. Typically includes event name, league, and broadcast type (e.g., \'NFL Sunday Night Football — Live\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributorId rdf:type rdf:Property ;
    rdfs:label 'Distributor Id' ;
    rdfs:comment 'Foreign key linking to broadcast.distributor. Business justification: Broadcast channels are operated and distributed by distributors (cable operators, satellite providers, OTT platforms). Adding distributor_id enables tracking which distributor operates each channel. T' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Distributor .

ind:adInsertionEnabled rdf:type rdf:Property ;
    rdfs:label 'Ad Insertion Enabled' ;
    rdfs:comment 'Indicates whether dynamic ad insertion (DAI) is enabled for this channel. When True, the channel supports server-side or client-side ad insertion for CPM (Cost Per Mille) based advertising revenue. Critical for sponsorship and advertising revenue planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:audioFormat rdf:type rdf:Property ;
    rdfs:label 'Audio Format' ;
    rdfs:comment 'Audio encoding format delivered by this channel (e.g., stereo, 5.1 surround, Dolby Atmos). Used for broadcast technical compliance, production scheduling, and premium tier packaging.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bitrateKbps rdf:type rdf:Property ;
    rdfs:label 'Bitrate Kbps' ;
    rdfs:comment 'Target or maximum video bitrate for this channel measured in kilobits per second (Kbps). Used for CDN bandwidth capacity planning, SLA definition, and quality tier differentiation between SD, HD, and 4K tiers.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blackoutRuleCode rdf:type rdf:Property ;
    rdfs:label 'Blackout Rule Code' ;
    rdfs:comment 'Code identifying the blackout restriction rule set applied to this channel. Blackout rules restrict broadcast of specific events in defined geographic territories per league agreements (e.g., NFL, NBA, MLB local blackout policies). Enforced at the channel level for linear and OTT distribution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastFormat rdf:type rdf:Property ;
    rdfs:label 'Broadcast Format' ;
    rdfs:comment 'Primary content delivery format of this channel. Live = real-time event broadcast; Replay = time-shifted full event replay; VOD (Video on Demand) = on-demand library content; Simulcast = simultaneous broadcast across multiple platforms; Highlights = short-form curated content.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelCode rdf:type rdf:Property ;
    rdfs:label 'Channel Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the channel, used in rights agreements, scheduling systems, and Dalet Galaxy media asset management workflows. Serves as the natural key across operational systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelName rdf:type rdf:Property ;
    rdfs:label 'Channel Name' ;
    rdfs:comment 'Official human-readable name of the broadcast channel or distribution outlet (e.g., \'ESPN Regional Sports Network East\', \'Sports Entertainment OTT HD\'). Used in scheduling, rights contracts, and fan-facing interfaces.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelNumber rdf:type rdf:Property ;
    rdfs:label 'Channel Number' ;
    rdfs:comment 'Logical channel number assigned by the platform operator or cable/satellite provider for linear channel lineup placement (e.g., channel 720 on DirecTV). Used for EPG (Electronic Program Guide) integration and subscriber navigation.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:channelStatus rdf:type rdf:Property ;
    rdfs:label 'Channel Status' ;
    rdfs:comment 'Current operational lifecycle status of the channel. Active = currently distributing content; Inactive = temporarily off-air; Suspended = distribution halted due to rights or compliance issue; Pending Launch = configured but not yet live; Decommissioned = permanently retired.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelType rdf:type rdf:Property ;
    rdfs:label 'Channel Type' ;
    rdfs:comment 'Categorical classification of the channel\'s distribution model. Linear = traditional scheduled broadcast; OTT (Over-The-Top) = internet streaming; IPTV (Internet Protocol Television) = managed IP delivery; DTC (Direct-To-Consumer) = owned streaming service; PPV (Pay-Per-View) = event-based purchase; RSN (Regional Sports Network) = regional linear affiliate.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedCaptionSupported rdf:type rdf:Property ;
    rdfs:label 'Closed Caption Supported' ;
    rdfs:comment 'Indicates whether this channel supports closed captioning for accessibility compliance. Required for ADA (Americans with Disabilities Act) and FCC closed captioning mandates for broadcast channels serving US audiences.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contentCategory rdf:type rdf:Property ;
    rdfs:label 'Content Category' ;
    rdfs:comment 'Primary content category classification for this channel. Used for audience segmentation, advertising targeting, rights categorization, and regulatory classification with the FCC.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decommissionDate rdf:type rdf:Property ;
    rdfs:label 'Decommission Date' ;
    rdfs:comment 'Calendar date on which this channel was or is scheduled to be permanently decommissioned and removed from distribution. Nullable for active channels. Used for rights wind-down planning and regulatory notification.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:distributionTerritory rdf:type rdf:Property ;
    rdfs:label 'Distribution Territory' ;
    rdfs:comment 'The geographic territory or market in which this vendor is authorized to distribute the channel under this agreement. A single channel may have different vendors authorized for different territories (e.g., US West, EMEA, APAC).' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encodingStandard rdf:type rdf:Property ;
    rdfs:label 'Encoding Standard' ;
    rdfs:comment 'Video encoding/compression standard used for this channel\'s stream (e.g., H.264/AVC, H.265/HEVC, AV1). Determines device compatibility, CDN efficiency, and streaming quality at given bitrates.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:epgCode rdf:type rdf:Property ;
    rdfs:label 'Epg Code' ;
    rdfs:comment 'External identifier used by Electronic Program Guide (EPG) data providers (e.g., Tribune Media, Gracenote) to reference this channel in scheduling and guide data feeds. Enables automated schedule ingestion and viewer guide population.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frameRate rdf:type rdf:Property ;
    rdfs:label 'Frame Rate' ;
    rdfs:comment 'Video frame rate specification for this channel (e.g., 25fps for PAL markets, 30fps for NTSC markets, 60fps for premium sports HD). Impacts production compatibility, CDN bandwidth, and broadcast technical standards compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicCoverage rdf:type rdf:Property ;
    rdfs:label 'Geographic Coverage' ;
    rdfs:comment 'Textual description or structured list of geographic markets, regions, or territories this channel is licensed to serve (e.g., \'Northeast USA\', \'Western Europe\', \'Global excluding China\'). Distinct from country_code which captures the registration country; this field captures the full distribution footprint for rights enforcement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:launchDate rdf:type rdf:Property ;
    rdfs:label 'Launch Date' ;
    rdfs:comment 'Calendar date on which this channel was officially launched and made available to audiences. Used for channel lifecycle tracking, anniversary reporting, and rights agreement effective date alignment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maxConcurrentStreams rdf:type rdf:Property ;
    rdfs:label 'Max Concurrent Streams' ;
    rdfs:comment 'Maximum number of simultaneous viewer streams permitted on this channel as defined by rights agreements or platform capacity constraints. Used for CDN capacity planning and rights compliance enforcement during peak events.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:monthlyRightsFee rdf:type rdf:Property ;
    rdfs:label 'Monthly Rights Fee' ;
    rdfs:comment 'Monthly fee paid to or received from the platform operator or rights holder for distribution of this channel, expressed in the channel\'s billing currency. Confidential commercial term used for revenue management and EBITDA reporting.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:multiviewSupported rdf:type rdf:Property ;
    rdfs:label 'Multiview Supported' ;
    rdfs:comment 'Indicates whether this channel supports simultaneous multi-angle or multi-game viewing (multiview) for premium subscribers. A differentiating feature for OTT and DTC channels used in fan engagement and premium tier upsell strategies.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:obUnitRequired rdf:type rdf:Property ;
    rdfs:label 'Ob Unit Required' ;
    rdfs:comment 'Indicates whether this channel requires an OB (Outside Broadcast) unit for live event production. When True, triggers OB unit scheduling and resource allocation workflows in the broadcast operations team.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentalRating rdf:type rdf:Property ;
    rdfs:label 'Parental Rating' ;
    rdfs:comment 'Content parental advisory rating assigned to this channel per FCC and TV Parental Guidelines standards (e.g., TV-G, TV-PG, TV-14, TV-MA). Used for parental control enforcement, platform compliance, and audience targeting restrictions.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppvEnabled rdf:type rdf:Property ;
    rdfs:label 'Ppv Enabled' ;
    rdfs:comment 'Indicates whether this channel supports PPV (Pay-Per-View) event packaging and transactional purchase by viewers. When True, the channel can be used to distribute PPV events with individual purchase requirements rather than subscription access.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rsnAffiliateName rdf:type rdf:Property ;
    rdfs:label 'Rsn Affiliate Name' ;
    rdfs:comment 'Name of the RSN (Regional Sports Network) affiliate associated with this channel, where applicable. Populated only for channels of type \'RSN\' or \'linear\' with regional affiliation agreements. Used for RSN rights revenue allocation and affiliate relationship management.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signalType rdf:type rdf:Property ;
    rdfs:label 'Signal Type' ;
    rdfs:comment 'Technical signal delivery mechanism for this channel. Determines infrastructure requirements, regulatory classification, and distribution partner compatibility. [ENUM-REF-CANDIDATE: digital|analog|IP|satellite|cable|terrestrial|fiber|microwave — promote to reference product]' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streamUrl rdf:type rdf:Property ;
    rdfs:label 'Stream Url' ;
    rdfs:comment 'Primary ingest or origin stream URL for OTT, IPTV, or DTC channel types. Confidential as it represents a direct access endpoint to live feed infrastructure. Used by broadcast operations and CDN configuration teams.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriberCount rdf:type rdf:Property ;
    rdfs:label 'Subscriber Count' ;
    rdfs:comment 'Current number of active subscribers or authorized viewers for this channel. For OTT/DTC/IPTV channels, reflects platform subscription count. For linear channels, reflects reported household reach. Used for ARPU (Average Revenue Per User) calculation and rights fee negotiations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:uptimeSlaPct rdf:type rdf:Property ;
    rdfs:label 'Uptime Sla Pct' ;
    rdfs:comment 'Contractually committed uptime percentage for this channel as defined in the SLA (Service Level Agreement) with the platform operator or CDN provider (e.g., 99.95). Used for operational performance monitoring and penalty clause management.' ;
    rdfs:domain ind:Channel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:backupFeedId rdf:type rdf:Property ;
    rdfs:label 'Backup Feed Id' ;
    rdfs:comment 'Reference to the designated backup or failover live feed that will be activated if this primary feed fails. Enables automated failover management and redundancy tracking in broadcast operations.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LiveFeed .

ind:broadcastProductionId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Production Id' ;
    rdfs:comment 'Foreign key linking to broadcast.production. Business justification: A live feed is the technical output of a broadcast production. Linking live_feed to production enables crew, equipment, and production metadata to be associated with the feed. This supports post-event' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Production .

ind:contentRightsWindowId rdf:type rdf:Property ;
    rdfs:label 'Content Rights Window Id' ;
    rdfs:comment 'Foreign key linking to content.content_rights_window. Business justification: Live feed activation for a territory/platform must be validated against the content rights window to confirm live streaming rights are active. Feed operations teams perform this rights check before en' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContentRightsWindow .

ind:daletAssetId rdf:type rdf:Property ;
    rdfs:label 'Dalet Asset Id' ;
    rdfs:comment 'Identifier of the corresponding media asset record in the Dalet Galaxy Media Asset Management (MAM) system. Enables traceability between the operational live feed record and the media asset management workflow for ingest, archiving, and content repurposing.' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:slaPolicyId rdf:type rdf:Property ;
    rdfs:label 'Sla Policy Id' ;
    rdfs:comment 'Foreign key linking to platform.sla_policy. Business justification: Live feeds during events are governed by SLA policies defining uptime targets, CDN failover thresholds, and latency SLAs. Operations teams reference the SLA policy to trigger failover and report SLA c' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SlaPolicy .

ind:aspectRatio rdf:type rdf:Property ;
    rdfs:label 'Aspect Ratio' ;
    rdfs:comment 'Width-to-height ratio of the video frame for this live feed. 16:9 is the standard widescreen format for HD and 4K broadcast; 4:3 is legacy SD format. Determines display compatibility across linear TV and OTT (Over-The-Top) platforms.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:audioTrackCount rdf:type rdf:Property ;
    rdfs:label 'Audio Track Count' ;
    rdfs:comment 'Total number of discrete audio tracks embedded in the live feed. Multiple tracks support stereo, 5.1 surround, and separate commentary language channels. Relevant for multi-language broadcast distribution and accessibility compliance.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blackoutRuleApplied rdf:type rdf:Property ;
    rdfs:label 'Blackout Rule Applied' ;
    rdfs:comment 'Indicates whether a territorial blackout restriction is currently applied to this live feed, preventing distribution in specific geographic markets per media rights agreements. Critical for rights compliance and RSN (Regional Sports Network) exclusivity enforcement.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:blackoutTerritory rdf:type rdf:Property ;
    rdfs:label 'Blackout Territory' ;
    rdfs:comment 'Comma-separated list of ISO 3166-1 alpha-3 country codes or designated market area codes where this live feed is blacked out per media rights agreements. Null if no blackout applies. Used for geo-fencing enforcement on DTC (Direct-To-Consumer) and OTT (Over-The-Top) platforms.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdnOriginEndpoint rdf:type rdf:Property ;
    rdfs:label 'Cdn Origin Endpoint' ;
    rdfs:comment 'Primary CDN (Content Delivery Network) origin ingest URL or endpoint address from which the live feed is distributed to downstream delivery nodes and OTT (Over-The-Top) platforms. Core operational field for live distribution monitoring.' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commentaryLanguage rdf:type rdf:Property ;
    rdfs:label 'Commentary Language' ;
    rdfs:comment 'ISO 639-1 or ISO 639-2 language code for the primary commentary audio track on this live feed (e.g., \'en\' for English, \'es\' for Spanish, \'fr\' for French). Drives regional distribution routing and RSN (Regional Sports Network) assignment.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionTier rdf:type rdf:Property ;
    rdfs:label 'Distribution Tier' ;
    rdfs:comment 'Geographic scope of distribution authorized for this live feed under the applicable media rights agreement. Global feeds are distributed worldwide; regional feeds are limited to a geographic zone; national feeds are country-specific; local feeds are limited to a designated market area (DMA).' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encodingFormat rdf:type rdf:Property ;
    rdfs:label 'Encoding Format' ;
    rdfs:comment 'Video codec standard used to compress and encode the live feed signal. H.264 (AVC) and H.265 (HEVC) are the dominant standards for broadcast and OTT (Over-The-Top) streaming delivery. Impacts bandwidth, quality, and platform compatibility.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failoverActivated rdf:type rdf:Property ;
    rdfs:label 'Failover Activated' ;
    rdfs:comment 'Indicates whether the backup or redundancy failover mechanism was triggered during this live feed\'s transmission. Used for post-event incident analysis, SLA (Service Level Agreement) reporting, and broadcast reliability KPI (Key Performance Indicator) tracking.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:failoverTimestamp rdf:type rdf:Property ;
    rdfs:label 'Failover Timestamp' ;
    rdfs:comment 'Date and time (UTC) when the failover mechanism was activated for this live feed. Null if failover_activated is false. Used for incident root cause analysis and SLA (Service Level Agreement) breach assessment.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:feedCode rdf:type rdf:Property ;
    rdfs:label 'Feed Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this live feed within broadcast operations and Dalet Galaxy media asset management workflows. Used for signal routing, scheduling, and inter-system reference.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedName rdf:type rdf:Property ;
    rdfs:label 'Feed Name' ;
    rdfs:comment 'Human-readable descriptive name for the live feed, typically including event name, feed type, and language (e.g., \'NFL Championship - World Feed - English\'). Used in operational dashboards and scheduling systems.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedStatus rdf:type rdf:Property ;
    rdfs:label 'Feed Status' ;
    rdfs:comment 'Current operational lifecycle status of the live feed. Active indicates the feed is live and distributing; standby is ready but not transmitting; failed indicates a signal loss or error condition; backup indicates a redundancy feed has taken over; scheduled indicates pre-event readiness; terminated indicates the feed has ended.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedType rdf:type rdf:Property ;
    rdfs:label 'Feed Type' ;
    rdfs:comment 'Classification of the live feed by its production and distribution purpose. World feed is the primary international signal; clean feed has no graphics; ISO feed is an isolated camera angle; PPV (Pay-Per-View) and OTT (Over-The-Top) feeds are platform-specific variants. [ENUM-REF-CANDIDATE: world_feed|clean_feed|commentary_feed|iso_feed|backup_feed|ppv_feed|ott_feed — promote to reference product]' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hdrFormat rdf:type rdf:Property ;
    rdfs:label 'Hdr Format' ;
    rdfs:comment 'High Dynamic Range (HDR) format applied to the live feed for enhanced color and brightness reproduction. HDR10 and HLG (Hybrid Log-Gamma) are the broadcast standards; Dolby Vision is a premium streaming format. None indicates standard dynamic range (SDR).' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isIptvEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Iptv Enabled' ;
    rdfs:comment 'Indicates whether this live feed is authorized and configured for distribution via IPTV (Internet Protocol Television) networks, including managed IPTV services provided by telecommunications operators.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLinearTvEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Linear Tv Enabled' ;
    rdfs:comment 'Indicates whether this live feed is authorized and configured for distribution via traditional linear television broadcast channels, including RSN (Regional Sports Network) and national broadcast network affiliates.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOttEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Ott Enabled' ;
    rdfs:comment 'Indicates whether this live feed is authorized and technically configured for distribution via OTT (Over-The-Top) streaming platforms, including DTC (Direct-To-Consumer) services and third-party streaming partners.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:latencyMode rdf:type rdf:Property ;
    rdfs:label 'Latency Mode' ;
    rdfs:comment 'Configured latency mode for this live feed delivery. Ultra-low latency (sub-3 seconds) is required for interactive and betting-adjacent use cases; low latency (3-10 seconds) for OTT (Over-The-Top) sports streaming; standard (10-30 seconds) for traditional broadcast; high for archive-quality delivery.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionRegion rdf:type rdf:Property ;
    rdfs:label 'Production Region' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the primary production region where this live feed is originated and managed. Used for regulatory compliance, rights territory management, and broadcast operations routing.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redundancyConfig rdf:type rdf:Property ;
    rdfs:label 'Redundancy Config' ;
    rdfs:comment 'Redundancy architecture configured for this live feed to ensure continuity in case of primary signal failure. 1+1 means one active and one standby path; N+1 means N active feeds with one shared backup. Critical for broadcast SLA (Service Level Agreement) compliance.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replayEnabled rdf:type rdf:Property ;
    rdfs:label 'Replay Enabled' ;
    rdfs:comment 'Indicates whether this live feed is authorized and configured to generate replay or catch-up content after the live event concludes. Drives post-event content ingest workflows in Dalet Galaxy and DRM (Digital Rights Management) policy application for replay windows.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:replayWindowHours rdf:type rdf:Property ;
    rdfs:label 'Replay Window Hours' ;
    rdfs:comment 'Number of hours after the live event ends during which replay content derived from this feed is available to authorized viewers. Defined by the media rights agreement and DRM (Digital Rights Management) policy. Null if replay_enabled is false.' ;
    rdfs:domain ind:LiveFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resolution rdf:type rdf:Property ;
    rdfs:label 'Resolution' ;
    rdfs:comment 'Video resolution tier of the live feed. SD (Standard Definition) is 480p/576p; HD (High Definition) is 720p; FHD (Full HD) is 1080p/1080i; 4K is 2160p; 8K is 4320p. Determines bandwidth requirements, CDN (Content Delivery Network) capacity planning, and platform delivery eligibility.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsClearanceId rdf:type rdf:Property ;
    rdfs:label 'Rights Clearance Id' ;
    rdfs:comment 'Foreign key linking to content.rights_clearance. Business justification: Media asset distribution requires verified rights clearance. The rights_clearance_status plain attribute on media_asset is a denormalized copy of content.rights_clearance data. Linking to rights_clear' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RightsClearance .

ind:archiveLocation rdf:type rdf:Property ;
    rdfs:label 'Archive Location' ;
    rdfs:comment 'Physical or logical storage path/URI where the media asset master file is archived (e.g., cloud object storage bucket path, SAN mount point, tape library reference). Used by the Dalet Galaxy DAM for asset retrieval and restore operations.' ;
    rdfs:domain ind:MediaAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:archiveTier rdf:type rdf:Property ;
    rdfs:label 'Archive Tier' ;
    rdfs:comment 'Storage tier classification for the media asset based on access frequency and retention requirements. Hot: frequently accessed active assets; Warm: recent but less active; Cold: infrequently accessed; Deep Archive: long-term preservation. Drives storage cost allocation and retrieval SLA.' ;
    rdfs:domain ind:MediaAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetStatus rdf:type rdf:Property ;
    rdfs:label 'Asset Status' ;
    rdfs:comment 'Current state of the media asset within the Dalet Galaxy broadcast workflow lifecycle. Controls downstream distribution eligibility and archive processing. Values: draft (being created), ingest (being ingested), qc_review (under quality control review), approved (cleared for distribution), archived (moved to long-term storage), deleted (logically removed).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetType rdf:type rdf:Property ;
    rdfs:label 'Asset Type' ;
    rdfs:comment 'Classification of the media asset by its production and editorial purpose within the broadcast workflow. Drives rights clearance rules, distribution eligibility, and archive retention policies. [ENUM-REF-CANDIDATE: live_recording|highlight_reel|replay|promo|interstitial|documentary|clip|raw_feed|press_conference|interview — promote to reference product if additional types are required]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:audioChannels rdf:type rdf:Property ;
    rdfs:label 'Audio Channels' ;
    rdfs:comment 'Number of audio channels in the media asset (e.g., 2 for stereo, 6 for 5.1 surround, 8 for 7.1 surround). Required for broadcast playout compatibility and OTT audio track configuration.' ;
    rdfs:domain ind:MediaAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blackoutRuleApplicable rdf:type rdf:Property ;
    rdfs:label 'Blackout Rule Applicable' ;
    rdfs:comment 'Indicates whether broadcast blackout rules apply to this media asset. When True, the asset is subject to geographic blackout restrictions per league media rights agreements (e.g., NFL local market blackouts, RSN territorial restrictions). Drives CDN geo-blocking logic.' ;
    rdfs:domain ind:MediaAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cdnDeliveryUrl rdf:type rdf:Property ;
    rdfs:label 'Cdn Delivery Url' ;
    rdfs:comment 'Primary CDN-hosted URL for streaming or downloading this media asset. Used by OTT, IPTV, and DTC platforms to serve content to end users. May be a signed or tokenized URL depending on DRM policy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checksum rdf:type rdf:Property ;
    rdfs:label 'Checksum' ;
    rdfs:comment 'SHA-256 cryptographic checksum of the media asset master file. Used to verify file integrity during ingest, transfer, and archive operations. Ensures no corruption or unauthorized modification of broadcast master content.' ;
    rdfs:domain ind:MediaAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codec rdf:type rdf:Property ;
    rdfs:label 'Codec' ;
    rdfs:comment 'Video codec used to encode the media asset (e.g., H.264, H.265/HEVC, AVC, ProRes 422). Critical for transcoding decisions, CDN delivery optimization, and OTT/IPTV platform compatibility.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionChannel rdf:type rdf:Property ;
    rdfs:label 'Distribution Channel' ;
    rdfs:comment 'Primary distribution channel for which this media asset is packaged or cleared. Drives platform-specific encoding, DRM policy selection, and rights window application. [ENUM-REF-CANDIDATE: linear_tv|ott|iptv|dtc|rsn|ppv|social_media|vod|syndication — promote to reference product if additional channels required]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileSizeMb rdf:type rdf:Property ;
    rdfs:label 'File Size Mb' ;
    rdfs:comment 'Physical file size of the media asset in megabytes. Used for storage capacity planning, archive cost allocation, and CDN transfer cost estimation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:format rdf:type rdf:Property ;
    rdfs:label 'Format' ;
    rdfs:comment 'Technical container or wrapper format of the media asset file (e.g., MXF for broadcast master, MP4 for OTT/DTC delivery, HLS for adaptive streaming). Determines compatibility with CDN delivery and playout systems. [ENUM-REF-CANDIDATE: MP4|MXF|MOV|HLS|DASH|ProRes|DNxHD — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ingestSource rdf:type rdf:Property ;
    rdfs:label 'Ingest Source' ;
    rdfs:comment 'Origin source from which the media asset was ingested into the Dalet Galaxy DAM system. OB (Outside Broadcast) truck, studio feed, satellite uplink, file transfer, API ingest, or third-party delivery. Used for provenance tracking and quality control routing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ingestTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ingest Timestamp' ;
    rdfs:comment 'Date and time when the media asset was first ingested into the Dalet Galaxy DAM system. Marks the start of the asset lifecycle and is used for SLA tracking, audit trails, and archive retention calculations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isLiveRecording rdf:type rdf:Property ;
    rdfs:label 'Is Live Recording' ;
    rdfs:comment 'Indicates whether this media asset is a live or near-live recording captured during an active broadcast event, as opposed to a pre-produced or post-produced asset. Drives priority ingest workflows and real-time CDN distribution rules.' ;
    rdfs:domain ind:MediaAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:metadataTags rdf:type rdf:Property ;
    rdfs:label 'Metadata Tags' ;
    rdfs:comment 'Comma-separated free-text metadata tags applied to the media asset for search, discovery, and content classification purposes within the Dalet Galaxy DAM (e.g., \'playoffs,overtime,game-winner,fourth-quarter\'). Supports AI/ML content recommendation and editorial search.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppvEligible rdf:type rdf:Property ;
    rdfs:label 'Ppv Eligible' ;
    rdfs:comment 'Indicates whether this media asset is eligible for Pay-Per-View (PPV) packaging and monetization. When True, the asset may be included in PPV event bundles and premium access tiers.' ;
    rdfs:domain ind:MediaAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rightsExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Rights Expiry Date' ;
    rdfs:comment 'Date on which the media rights clearance for this asset expires. After this date, the asset must be withheld from distribution pending rights renewal. Critical for automated rights enforcement and compliance with media rights agreements.' ;
    rdfs:domain ind:MediaAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rightsTerritory rdf:type rdf:Property ;
    rdfs:label 'Rights Territory' ;
    rdfs:comment 'Geographic territory or territories in which this media asset is cleared for distribution, expressed as ISO 3166-1 alpha-3 country codes or a named territory group (e.g., \'USA\', \'GBR\', \'WORLDWIDE\', \'EMEA\'). Drives blackout rule enforcement and regional RSN assignment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subtitleAvailable rdf:type rdf:Property ;
    rdfs:label 'Subtitle Available' ;
    rdfs:comment 'Indicates whether closed captions or subtitles are available for this media asset. Required for ADA (Americans with Disabilities Act) compliance for broadcast content and OTT platform accessibility standards.' ;
    rdfs:domain ind:MediaAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceObligationId rdf:type rdf:Property ;
    rdfs:label 'Compliance Obligation Id' ;
    rdfs:comment 'Foreign key linking to compliance.obligation. Business justification: Media rights deals create specific compliance obligations (anti-piracy, content quotas, watershed rules, data privacy requirements per territory). Compliance teams must map each rights deal to its gov' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Obligation .

ind:rightsHolderCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Rights Holder Corporate Entity Id' ;
    rdfs:comment 'Foreign key linking to legal.corporate_entity. Business justification: The rights_holder_name plain text field denormalizes the corporate entity that holds the broadcast rights. Legal entity management requires a proper FK to corporate_entity for entity hierarchy reporti' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:annualRightsFeeUsd rdf:type rdf:Property ;
    rdfs:label 'Annual Rights Fee Usd' ;
    rdfs:comment 'Annual rights fee payable by the licensee in US Dollars. Used for ARR (Annual Recurring Revenue) tracking, financial planning in Workday Adaptive Planning, and year-over-year revenue comparison.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:blackoutRulesApplicable rdf:type rdf:Property ;
    rdfs:label 'Blackout Rules Applicable' ;
    rdfs:comment 'Indicates whether geographic or platform-based blackout rules apply to content distributed under this deal. When true, the CDN and streaming platform must enforce territory-based content restrictions.' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:blackoutTerritoryCodes rdf:type rdf:Property ;
    rdfs:label 'Blackout Territory Codes' ;
    rdfs:comment 'Comma-separated list of ISO 3166-1 alpha-3 country or market codes where content blackout restrictions apply under this deal. Used by CDN geo-restriction and OTT/IPTV platform access control engines.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdnProviderName rdf:type rdf:Property ;
    rdfs:label 'Cdn Provider Name' ;
    rdfs:comment 'Name of the CDN provider responsible for delivering digital content under this deal (e.g., Akamai, Fastly, Cloudflare). Relevant for OTT/IPTV and DTC streaming deals. Supports SLA monitoring and CDN cost allocation.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daletContractRef rdf:type rdf:Property ;
    rdfs:label 'Dalet Contract Ref' ;
    rdfs:comment 'External reference identifier from Dalet Galaxy Media Asset Management system linking this deal to the corresponding rights contract object in the broadcast workflow system. Supports data lineage from source system.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPrivacyComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Compliance Flag' ;
    rdfs:comment 'Indicates whether the deal includes contractual data privacy compliance obligations (GDPR, CCPA) governing fan data collected through the licensee\'s broadcast and streaming platforms.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dealCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Deal Created Timestamp' ;
    rdfs:comment 'Timestamp when this media rights deal record was first created in the system. Audit trail field for data governance and SOX compliance. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dealName rdf:type rdf:Property ;
    rdfs:label 'Deal Name' ;
    rdfs:comment 'Human-readable descriptive name of the media rights deal (e.g., \'NFL Sunday Ticket RSN Agreement FY2025\'). Used for identification in reporting and dashboards.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealNumber rdf:type rdf:Property ;
    rdfs:label 'Deal Number' ;
    rdfs:comment 'Externally-known alphanumeric contract reference number assigned by the rights management system (Dalet Galaxy or Salesforce CRM) and used in all correspondence with broadcast partners. Serves as the BUSINESS_IDENTIFIER for this agreement.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealStatus rdf:type rdf:Property ;
    rdfs:label 'Deal Status' ;
    rdfs:comment 'Current lifecycle state of the media rights deal. Drives rights enforcement and blackout rule activation. Values: draft, pending_approval, active, suspended, expired, terminated.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealType rdf:type rdf:Property ;
    rdfs:label 'Deal Type' ;
    rdfs:comment 'Classification of the deal by distribution channel or platform type. Values: linear_tv (traditional broadcast), rsn (Regional Sports Network), ott (Over-The-Top Streaming), iptv (Internet Protocol Television), ppv (Pay-Per-View), dtc (Direct-To-Consumer). [ENUM-REF-CANDIDATE: linear_tv|rsn|ott|iptv|ppv|dtc — promote to reference product if additional types emerge]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Deal Updated Timestamp' ;
    rdfs:comment 'Timestamp when this media rights deal record was most recently modified. Supports change data capture (CDC) in the Databricks Silver Layer and audit trail requirements. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dealValueUsd rdf:type rdf:Property ;
    rdfs:label 'Deal Value Usd' ;
    rdfs:comment 'Total gross contract value of the media rights deal in US Dollars over the full contract term. Represents the headline financial commitment. Used for EBITDA reporting and ARR calculations.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:digitalStreamingRightsIncluded rdf:type rdf:Property ;
    rdfs:label 'Digital Streaming Rights Included' ;
    rdfs:comment 'Indicates whether OTT/IPTV digital streaming rights are included in this deal, permitting distribution via internet-based platforms (e.g., DTC apps, OTT services).' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusivityType rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Type' ;
    rdfs:comment 'Defines whether the rights granted are exclusive to the licensee within the territory, non-exclusive (shared with other licensees), first-window (first broadcast rights before others), or co-exclusive (shared exclusivity with a limited number of partners).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingLawCountryCode rdf:type rdf:Property ;
    rdfs:label 'Governing Law Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction whose laws govern this media rights agreement (e.g., USA, GBR, CHE). Determines applicable regulatory frameworks and dispute resolution venue.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:highlightsRightsIncluded rdf:type rdf:Property ;
    rdfs:label 'Highlights Rights Included' ;
    rdfs:comment 'Indicates whether rights to produce and distribute short-form highlight clips are included in this deal. Relevant for social media, news broadcasts, and digital platform distribution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:liveRightsIncluded rdf:type rdf:Property ;
    rdfs:label 'Live Rights Included' ;
    rdfs:comment 'Indicates whether live broadcast rights for events are included in this deal. Drives live feed distribution scheduling and OB (Outside Broadcast) resource allocation.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxEventsPerSeason rdf:type rdf:Property ;
    rdfs:label 'Max Events Per Season' ;
    rdfs:comment 'Maximum number of events the licensee may broadcast per season under this deal. Caps the licensee\'s broadcast entitlement and protects rights holder\'s ability to distribute remaining events to other partners.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minGuaranteedEvents rdf:type rdf:Property ;
    rdfs:label 'Min Guaranteed Events' ;
    rdfs:comment 'Contractually guaranteed minimum number of live events the licensee is entitled to broadcast under this deal per contract year. Triggers make-good provisions if not met.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ppvRightsIncluded rdf:type rdf:Property ;
    rdfs:label 'Ppv Rights Included' ;
    rdfs:comment 'Indicates whether Pay-Per-View event packaging rights are included in this deal, allowing the licensee to offer individual event purchases to consumers.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalOptionType rdf:type rdf:Property ;
    rdfs:label 'Renewal Option Type' ;
    rdfs:comment 'Type of renewal option included in the deal. Automatic renewal triggers without action; mutual_agreement requires both parties to agree; right_of_first_refusal gives the licensee priority to match competing offers; none means no renewal option exists.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replayRightsIncluded rdf:type rdf:Property ;
    rdfs:label 'Replay Rights Included' ;
    rdfs:comment 'Indicates whether replay/rebroadcast rights are included in this deal, allowing the licensee to air recorded versions of events after the live window closes.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rightsCategories rdf:type rdf:Property ;
    rdfs:label 'Rights Categories' ;
    rdfs:comment 'Comma-separated list of rights categories included in this deal. Typical values: live, replay, highlights, ppv, clip_licensing, archive, digital_streaming, radio. Captures the full scope of content rights granted. [ENUM-REF-CANDIDATE: live|replay|highlights|ppv|clip_licensing|archive|digital_streaming|radio — promote to reference product]' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsWindowCount rdf:type rdf:Property ;
    rdfs:label 'Rights Window Count' ;
    rdfs:comment 'Total number of distinct rights windows (time-period/platform/territory entitlement combinations) defined under this deal. Supports rights window enforcement and deal complexity classification.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:salesforceOpportunityReference rdf:type rdf:Property ;
    rdfs:label 'Salesforce Opportunity Reference' ;
    rdfs:comment 'External reference identifier from Salesforce CRM linking this media rights deal record to the originating CRM opportunity or contract object. Supports data lineage and system-of-record traceability.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportName rdf:type rdf:Property ;
    rdfs:label 'Sport Name' ;
    rdfs:comment 'Name of the sport covered by this media rights deal (e.g., American Football, Basketball, Soccer, Baseball, Hockey). Supports multi-sport deal classification and rights analytics.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationForCausePermitted rdf:type rdf:Property ;
    rdfs:label 'Termination For Cause Permitted' ;
    rdfs:comment 'Indicates whether either party may terminate the deal early for cause (e.g., breach of contract, regulatory non-compliance, PED violations affecting league integrity). Relevant for compliance and legal risk management.' ;
    rdfs:domain ind:MediaRightsDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:syndicationDealId rdf:type rdf:Property ;
    rdfs:label 'Syndication Deal Id' ;
    rdfs:comment 'Reference to the syndication deal governing third-party distribution of this PPV package to external broadcast partners, RSN affiliates, or OTT sub-licensees.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SyndicationDeal .

ind:approvedDate rdf:type rdf:Property ;
    rdfs:label 'Approved Date' ;
    rdfs:comment 'Calendar date on which this PPV package received formal business approval for commercial distribution. Required for SOX financial controls and internal audit trails.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:broadcastLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Broadcast Language Code' ;
    rdfs:comment 'ISO 639 language code for the primary audio commentary track included in this PPV package (e.g., \'en\' for English, \'es\' for Spanish). Relevant for multi-language broadcast rights and international distribution.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bundleDescription rdf:type rdf:Property ;
    rdfs:label 'Bundle Description' ;
    rdfs:comment 'Narrative description of the bundling options available with this PPV package, including any companion products, subscription tiers, or merchandise inclusions offered at point of sale.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bundleFlag rdf:type rdf:Property ;
    rdfs:label 'Bundle Flag' ;
    rdfs:comment 'Indicates whether this PPV package is offered as part of a bundled product (e.g., combined with a streaming subscription or merchandise package). True when bundling options are active for this package.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consumerPrice rdf:type rdf:Property ;
    rdfs:label 'Consumer Price' ;
    rdfs:comment 'Standard retail price charged to end consumers (fans) for purchasing this PPV package on DTC and OTT platforms. Expressed in the currency defined by currency_code.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Distribution Window End' ;
    rdfs:comment 'Date and time when consumer access to the PPV package expires. After this timestamp, purchased access tokens are invalidated and replay content is no longer served.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:distributionWindowStart rdf:type rdf:Property ;
    rdfs:label 'Distribution Window Start' ;
    rdfs:comment 'Date and time when the PPV package becomes available for consumer access and streaming. Defines the opening of the distribution window aligned with the live broadcast schedule.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:internationalPrice rdf:type rdf:Property ;
    rdfs:label 'International Price' ;
    rdfs:comment 'Price applicable to consumers purchasing the PPV package in international markets outside the primary domestic territory. Reflects regional pricing strategy and currency parity adjustments.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isPpvExclusive rdf:type rdf:Property ;
    rdfs:label 'Is Ppv Exclusive' ;
    rdfs:comment 'Indicates whether this event is exclusively available as a PPV purchase and is not broadcast on any free-to-air, subscription, or RSN channel. True signals exclusive PPV-only distribution.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueOrOrgCode rdf:type rdf:Property ;
    rdfs:label 'League Or Org Code' ;
    rdfs:comment 'Short code identifying the league or organizing body whose event is featured in this PPV package (e.g., NFL, NBA, UFC, FIFA, MLB). Used for rights attribution, governance compliance, and revenue allocation.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxPurchaseCapacity rdf:type rdf:Property ;
    rdfs:label 'Max Purchase Capacity' ;
    rdfs:comment 'Maximum number of individual purchases permitted for this PPV package across all platforms. Null indicates unlimited capacity. Used for capacity-constrained PPV events or exclusive access packages.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:packageCode rdf:type rdf:Property ;
    rdfs:label 'Package Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the PPV package used in commercial communications, billing systems, and distribution partner integrations. Follows the format PPV-[ALPHANUMERIC].' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packageDescription rdf:type rdf:Property ;
    rdfs:label 'Package Description' ;
    rdfs:comment 'Long-form marketing and operational description of the PPV package content, including featured bouts, performers, pre-show details, and any exclusive content inclusions. Used in consumer-facing storefronts and internal catalog management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packageName rdf:type rdf:Property ;
    rdfs:label 'Package Name' ;
    rdfs:comment 'Human-readable commercial title of the PPV package as displayed to consumers on OTT platforms, linear TV guides, and DTC storefronts (e.g., \'UFC 300 Championship Night\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packageStatus rdf:type rdf:Property ;
    rdfs:label 'Package Status' ;
    rdfs:comment 'Current lifecycle state of the PPV package governing whether it is available for purchase. Draft indicates pre-release configuration; active indicates live and purchasable; on_sale indicates promotional pricing active; sold_out indicates capacity reached; expired indicates distribution window closed; cancelled indicates package withdrawn.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packageType rdf:type rdf:Property ;
    rdfs:label 'Package Type' ;
    rdfs:comment 'Classification of the PPV package by content scope. Single_event covers one live broadcast; multi_event_bundle covers a curated set of events; season_pass covers all events in a league season; replay_only covers post-event on-demand access without live rights.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:platformAvailability rdf:type rdf:Property ;
    rdfs:label 'Platform Availability' ;
    rdfs:comment 'Comma-separated list of distribution platforms on which this PPV package is available (e.g., OTT app, IPTV, linear TV, DTC web, mobile). Drives platform-specific fulfillment routing. [ENUM-REF-CANDIDATE: ott|iptv|linear_tv|dtc_web|mobile_app|cable|satellite — promote to reference product]' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppvCategory rdf:type rdf:Property ;
    rdfs:label 'Ppv Category' ;
    rdfs:comment 'Content category classification of the PPV package used for catalog organization, rights management, and audience targeting. Drives platform merchandising and recommendation algorithms.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promotionalDiscountPct rdf:type rdf:Property ;
    rdfs:label 'Promotional Discount Pct' ;
    rdfs:comment 'Percentage discount applied to the consumer price during promotional campaigns (e.g., early-bird pricing, loyalty member discounts). Zero indicates no active promotion. Used in revenue reporting and campaign analytics.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:purchaseEligibilityRule rdf:type rdf:Property ;
    rdfs:label 'Purchase Eligibility Rule' ;
    rdfs:comment 'Business rule expression or rule code defining which consumer segments are eligible to purchase this PPV package (e.g., subscribers only, age-verified users, specific membership tiers, geographic restrictions).' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replayAccessHours rdf:type rdf:Property ;
    rdfs:label 'Replay Access Hours' ;
    rdfs:comment 'Number of hours after the live event broadcast ends during which purchasers retain on-demand replay access to the PPV content. Zero indicates live-only access with no replay entitlement.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rightsTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Rights Territory Code' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code identifying the primary territory in which this PPV package holds broadcast rights. Governs geographic access controls and blackout enforcement.' ;
    rdfs:domain ind:Broadcast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saleEndDate rdf:type rdf:Property ;
    rdfs:label 'Sale End Date' ;
    rdfs:comment 'Calendar date after which the PPV package can no longer be purchased. Typically aligned with the distribution window end or a defined post-event replay cutoff.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:saleStartDate rdf:type rdf:Property ;
    rdfs:label 'Sale Start Date' ;
    rdfs:comment 'Calendar date on which the PPV package becomes available for purchase by consumers and distribution partners. Enables pre-sale revenue capture ahead of the live event.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sportOrGenre rdf:type rdf:Property ;
    rdfs:label 'Sport Or Genre' ;
    rdfs:comment 'Sport or entertainment genre associated with this PPV package (e.g., Boxing, MMA/UFC, NFL Football, NBA Basketball, Concert). Used for audience segmentation, rights categorization, and analytics reporting. [ENUM-REF-CANDIDATE: boxing|mma|nfl_football|nba_basketball|mlb_baseball|nhl_hockey|mls_soccer|concert|esports|other — promote to reference product]' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:videoResolution rdf:type rdf:Property ;
    rdfs:label 'Video Resolution' ;
    rdfs:comment 'Maximum video resolution tier available for this PPV package. Drives CDN bandwidth provisioning, platform compatibility checks, and consumer-facing product descriptions.' ;
    rdfs:domain ind:PpvPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wholesalePrice rdf:type rdf:Property ;
    rdfs:label 'Wholesale Price' ;
    rdfs:comment 'Price charged to distribution partners (cable operators, RSN affiliates, IPTV providers) for carrying the PPV package. Typically lower than consumer price to accommodate partner margin.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ppvTransactionId rdf:type rdf:Property ;
    rdfs:label 'Ppv Transaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each individual PPV purchase transaction record in the Silver layer lakehouse. Serves as the primary key for all downstream joins and lineage tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PpvTransaction .

ind:accessEntitlementId rdf:type rdf:Property ;
    rdfs:label 'Access Entitlement Id' ;
    rdfs:comment 'Foreign key linking to ticketing.access_entitlement. Business justification: Dual-entitlement reconciliation for PPV events: a PPV purchase creates both an access_entitlement (venue/digital gate access in ticketing) and a ppv_transaction (streaming rights in broadcast). Linkin' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccessEntitlement .

ind:arInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Ar Invoice Id' ;
    rdfs:comment 'Foreign key linking to finance.ar_invoice. Business justification: B2B wholesale PPV transactions (cable operators, distributors) generate AR invoices in finance for receivables management and revenue reconciliation. Finance needs the AR invoice linkage to track coll' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ArInvoice .

ind:buyerFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Buyer Fan Profile Id' ;
    rdfs:comment 'Reference to the consumer or wholesale distributor who purchased the PPV package. Links to the fan or partner account record in the CRM or fan engagement platform.' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:dataProcessingRecordId rdf:type rdf:Property ;
    rdfs:label 'Data Processing Record Id' ;
    rdfs:comment 'Foreign key linking to compliance.data_processing_record. Business justification: PPV transactions process sensitive personal data (payment info, geo-location, device registration, IP address) under PCI-DSS and GDPR, requiring formal data processing records. The ppv_transaction has' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DataProcessingRecord .

ind:deviceRegistrationId rdf:type rdf:Property ;
    rdfs:label 'Device Registration Id' ;
    rdfs:comment 'The unique identifier of the device on which the PPV purchase was initiated or the content is authorized to stream. Used for device-binding DRM enforcement, fraud detection, and concurrent stream limiting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DeviceRegistration .

ind:fanPaymentMethodId rdf:type rdf:Property ;
    rdfs:label 'Fan Payment Method Id' ;
    rdfs:comment 'Foreign key linking to fan.payment_method. Business justification: PPV transactions require a reference to the fan\'s stored payment method for refund processing, fraud analysis, and PCI compliance. ppv_transaction has payment_method (text, denormalized type only) and' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentMethod .

ind:merchPromotionId rdf:type rdf:Property ;
    rdfs:label 'Merch Promotion Id' ;
    rdfs:comment 'Foreign key linking to merchandise.promotion. Business justification: Cross-domain promotional redemption: a PPV transaction may redeem a merchandise promotion (e.g., promo code entitles buyer to a merch discount). Linking ppv_transaction to the merchandise promotion en' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Promotion .

ind:paymentId rdf:type rdf:Property ;
    rdfs:label 'Payment Id' ;
    rdfs:comment 'The unique transaction identifier returned by the external PCI-DSS compliant payment gateway or processor for this PPV purchase. Used for payment reconciliation, chargeback management, and audit trails. Not the card number or sensitive cardholder data.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payment .

ind:paymentTransactionPaymentId rdf:type rdf:Property ;
    rdfs:label 'Payment Transaction Payment Id' ;
    rdfs:comment 'The unique transaction identifier returned by the external PCI-DSS compliant payment gateway or processor for this PPV purchase. Used for payment reconciliation, chargeback management, and audit trails. Not the card number or sensitive cardholder data.' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payment .

ind:accessToken rdf:type rdf:Property ;
    rdfs:label 'Access Token' ;
    rdfs:comment 'The unique cryptographic token issued to the buyer upon successful payment, granting authenticated access to the PPV content stream. Tied to DRM policy enforcement and device binding. Must be treated as confidential and not exposed in public-facing reports.' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessTokenExpiry rdf:type rdf:Property ;
    rdfs:label 'Access Token Expiry' ;
    rdfs:comment 'The date and time at which the PPV content access token expires and the buyer\'s viewing rights are revoked. Enforces time-limited access windows per the PPV package terms and DRM policy.' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:accessWindowHours rdf:type rdf:Property ;
    rdfs:label 'Access Window Hours' ;
    rdfs:comment 'The number of hours the buyer is entitled to access the PPV content from the time of first playback or purchase, as defined by the PPV package terms. Supports replay and catch-up viewing rights management.' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:arpuSegment rdf:type rdf:Property ;
    rdfs:label 'Arpu Segment' ;
    rdfs:comment 'The ARPU-based segmentation tier assigned to the buyer at the time of this transaction, derived from historical spend patterns. Used for targeted marketing, pricing strategy, and LTV (Lifetime Value) analytics. Not a calculated metric — this is a pre-assigned segment label from the CRM.' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buyerType rdf:type rdf:Property ;
    rdfs:label 'Buyer Type' ;
    rdfs:comment 'Classification of the purchasing party indicating whether the buyer is an individual consumer (Direct-To-Consumer / DTC), a wholesale distributor (e.g., cable operator, IPTV provider), a corporate account, or a reseller. Drives revenue reporting segmentation and rights management.' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdnProvider rdf:type rdf:Property ;
    rdfs:label 'Cdn Provider' ;
    rdfs:comment 'The name or identifier of the Content Delivery Network (CDN) provider used to deliver the PPV stream to the buyer. Used for CDN cost allocation, SLA monitoring, and quality-of-service reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceCode rdf:type rdf:Property ;
    rdfs:label 'Device Code' ;
    rdfs:comment 'The unique identifier of the device on which the PPV purchase was initiated or the content is authorized to stream. Used for device-binding DRM enforcement, fraud detection, and concurrent stream limiting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountAmount rdf:type rdf:Property ;
    rdfs:label 'Discount Amount' ;
    rdfs:comment 'The monetary value of any promotional discount, coupon, or loyalty reward applied to this PPV transaction. Subtracted from gross_amount to derive net_amount. Zero if no promotion was applied.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fulfillmentStatus rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Status' ;
    rdfs:comment 'Current lifecycle state of the PPV transaction indicating whether the purchase has been processed, content access has been granted, or the transaction has been reversed. Drives operational workflows and revenue recognition. [ENUM-REF-CANDIDATE: pending|fulfilled|failed|refunded|cancelled|expired — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gdprConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Gdpr Consent Flag' ;
    rdfs:comment 'Indicates whether the buyer has provided explicit consent for personal data processing in accordance with GDPR requirements at the time of this PPV transaction. Mandatory for transactions involving EU-resident buyers.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geoCountryCode rdf:type rdf:Property ;
    rdfs:label 'Geo Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the buyer\'s geographic location at the time of purchase, derived from IP geolocation or account registration. Used to enforce broadcast blackout rules, regional rights restrictions, and tax jurisdiction determination.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Amount' ;
    rdfs:comment 'The full list price of the PPV package before any promotional discounts or adjustments are applied. Expressed in the transaction currency. Used as the base for revenue reporting and discount analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ipAddress rdf:type rdf:Property ;
    rdfs:label 'Ip Address' ;
    rdfs:comment 'The IP address of the buyer\'s device at the time of the PPV purchase. Used for geographic blackout rule enforcement, fraud detection, and regulatory compliance with broadcast rights restrictions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isReplayPurchase rdf:type rdf:Property ;
    rdfs:label 'Is Replay Purchase' ;
    rdfs:comment 'Indicates whether this PPV transaction is for replay or on-demand catch-up access to a previously broadcast event, as opposed to a live event purchase. Replay transactions may have different pricing and rights windows.' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netAmount rdf:type rdf:Property ;
    rdfs:label 'Net Amount' ;
    rdfs:comment 'The final amount charged to the buyer after all promotional discounts have been applied (gross_amount minus discount_amount). This is the recognized revenue amount for this transaction.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentMethod rdf:type rdf:Property ;
    rdfs:label 'Payment Method' ;
    rdfs:comment 'The payment instrument used by the buyer to complete the PPV purchase (e.g., credit card, debit card, digital wallet such as PayPal or Apple Pay, direct carrier billing, voucher/gift card, bank transfer). Used for payment reconciliation and fraud analysis. [ENUM-REF-CANDIDATE: credit_card|debit_card|digital_wallet|direct_billing|voucher|bank_transfer|crypto — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Status' ;
    rdfs:comment 'The current status of the payment associated with this PPV transaction as reported by the payment gateway. Distinct from fulfillment_status which tracks content delivery. Used for financial reconciliation and dispute management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pciTokenizedFlag rdf:type rdf:Property ;
    rdfs:label 'Pci Tokenized Flag' ;
    rdfs:comment 'Indicates whether the payment card data for this transaction has been tokenized by the PCI-DSS compliant payment processor, confirming that no raw cardholder data is stored in this record. Required for PCI DSS compliance attestation.' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:promoCode rdf:type rdf:Property ;
    rdfs:label 'Promo Code' ;
    rdfs:comment 'The alphanumeric promotional or discount code entered by the buyer at the time of purchase, if applicable. Used to track campaign effectiveness, redemption rates, and discount attribution in marketing analytics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseChannel rdf:type rdf:Property ;
    rdfs:label 'Purchase Channel' ;
    rdfs:comment 'The interface or touchpoint through which the buyer completed the PPV purchase (e.g., web browser, mobile app, set-top box UI, call center agent, retail kiosk). Distinct from platform_type which describes the delivery medium. Used for conversion funnel and channel attribution analytics.' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Purchase Timestamp' ;
    rdfs:comment 'The exact date and time (with timezone offset) at which the consumer or distributor completed the PPV purchase transaction. This is the principal business event time used for revenue recognition and reporting. Conforms to ISO 8601 format yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:refundReason rdf:type rdf:Property ;
    rdfs:label 'Refund Reason' ;
    rdfs:comment 'The business reason code for the refund issued on this PPV transaction. Used for root cause analysis, fraud detection, and consumer experience improvement. Null if no refund was issued.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundTimestamp rdf:type rdf:Property ;
    rdfs:label 'Refund Timestamp' ;
    rdfs:comment 'The date and time at which a refund was processed for this PPV transaction, if applicable. Null if no refund has been issued. Used for financial reconciliation and consumer protection compliance.' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:streamQuality rdf:type rdf:Property ;
    rdfs:label 'Stream Quality' ;
    rdfs:comment 'The video quality tier selected or delivered for this PPV transaction (Standard Definition, High Definition, 4K Ultra HD, or 8K). Affects pricing tiers, CDN bandwidth costs, and consumer experience reporting.' ;
    rdfs:domain ind:PpvTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Amount' ;
    rdfs:comment 'The tax amount levied on this PPV transaction, calculated based on applicable jurisdiction tax rules. Included in the total charged to the buyer and reported separately for tax compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Reference Number' ;
    rdfs:comment 'Externally visible alphanumeric reference number assigned to this PPV purchase, used in consumer receipts, customer service lookups, and payment reconciliation. Sourced from the payment processing or ticketing platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionId rdf:type rdf:Property ;
    rdfs:label 'Production Id' ;
    rdfs:comment 'Primary key for production' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Production .

ind:directorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Director Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Broadcast production crew scheduling, union call-sheet compliance, and payroll differential processing require linking the production director and technical producer to their workforce employee record' ;
    rdfs:domain ind:Production ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual End Timestamp' ;
    rdfs:comment 'Actual date and time the broadcast production concluded. Used for rights window compliance, overtime cost tracking, and post-event reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Start Timestamp' ;
    rdfs:comment 'Actual date and time the broadcast production went on-air or began active production. Compared against scheduled_start_timestamp for SLA compliance and post-event reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:broadcastLanguage rdf:type rdf:Property ;
    rdfs:label 'Broadcast Language' ;
    rdfs:comment 'Primary language of the broadcast commentary and production, expressed as an IETF BCP 47 language tag (e.g., \'en\', \'es\', \'fr\', \'pt-BR\'). Drives market designation and rights distribution.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:colorAnalystName rdf:type rdf:Property ;
    rdfs:label 'Color Analyst Name' ;
    rdfs:comment 'Full name of the color analyst (expert commentator) assigned to this production\'s commentary team. Tracked for talent scheduling, contract compliance, and broadcast quality.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentManifestReference rdf:type rdf:Property ;
    rdfs:label 'Equipment Manifest Reference' ;
    rdfs:comment 'Reference code or document identifier for the equipment manifest associated with this production, listing all cameras, audio rigs, transmission equipment, and OB unit inventory. Sourced from Dalet Galaxy asset tracking.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:graphicsPackageVersion rdf:type rdf:Property ;
    rdfs:label 'Graphics Package Version' ;
    rdfs:comment 'Version identifier of the on-screen graphics package (lower thirds, scoreboards, transitions, sponsor overlays) deployed for this production. Critical for brand consistency and sponsor compliance.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketDesignation rdf:type rdf:Property ;
    rdfs:label 'Market Designation' ;
    rdfs:comment 'Geographic market or territory for which this production is designated (e.g., \'US-National\', \'RSN-Northeast\', \'UK\', \'LATAM-Spanish\'). Governs blackout rules, rights windows, and distribution platform routing. [ENUM-REF-CANDIDATE: promote to reference product for standardized market codes]' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obUnitIdentifier rdf:type rdf:Property ;
    rdfs:label 'Ob Unit Identifier' ;
    rdfs:comment 'Identifier of the Outside Broadcast (OB) truck or mobile production unit deployed for remote productions. Null for studio-based productions. Critical for equipment logistics and vendor billing.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:playByPlayAnnouncer rdf:type rdf:Property ;
    rdfs:label 'Play By Play Announcer' ;
    rdfs:comment 'Full name of the primary play-by-play announcer assigned to this production\'s commentary team. Key talent assignment tracked for scheduling, NIL compliance, and audience analytics.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postshowDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Postshow Duration Minutes' ;
    rdfs:comment 'Planned duration in minutes of the post-show segment following the main event broadcast. Used for crew scheduling, sponsor slot allocation, and runsheet planning.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preshowDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Preshow Duration Minutes' ;
    rdfs:comment 'Planned duration in minutes of the pre-show segment preceding the main event broadcast. Used for crew scheduling, sponsor slot allocation, and runsheet planning.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:productionCode rdf:type rdf:Property ;
    rdfs:label 'Production Code' ;
    rdfs:comment 'Externally-known alphanumeric code assigned by Dalet Galaxy to uniquely identify this broadcast production instance across systems and workflows. Used in runsheets, crew calls, and equipment manifests.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionStatus rdf:type rdf:Property ;
    rdfs:label 'Production Status' ;
    rdfs:comment 'Current lifecycle state of the broadcast production instance within the Dalet Galaxy workflow. \'draft\' = initial planning; \'confirmed\' = crew and equipment locked; \'in_production\' = active pre-show or live execution; \'on_air\' = currently broadcasting; \'completed\' = post-production wrap; \'cancelled\' = production cancelled.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionType rdf:type rdf:Property ;
    rdfs:label 'Production Type' ;
    rdfs:comment 'Classification of the broadcast production method. \'live\' = real-time event coverage; \'studio\' = studio-based production; \'remote_ob\' = Outside Broadcast (OB) unit at venue; \'tape_delay\' = recorded and broadcast later; \'highlight\' = post-event highlight package. [ENUM-REF-CANDIDATE: live|studio|remote_ob|tape_delay|highlight|ppv — promote to reference product if additional types emerge]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replayAvailabilityTimestamp rdf:type rdf:Property ;
    rdfs:label 'Replay Availability Timestamp' ;
    rdfs:comment 'Date and time when replay or VOD content for this production becomes available to viewers on designated platforms. Null if replay_content_available is false. Governs rights window compliance.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:replayContentAvailable rdf:type rdf:Property ;
    rdfs:label 'Replay Content Available' ;
    rdfs:comment 'Indicates whether replay/VOD content will be made available following the live broadcast of this production. Drives post-production workflow initiation and rights window activation in the content domain.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Timestamp' ;
    rdfs:comment 'Planned date and time when the broadcast production is scheduled to conclude, including post-show segments. Used for rights window management and crew scheduling.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sidelineReporterName rdf:type rdf:Property ;
    rdfs:label 'Sideline Reporter Name' ;
    rdfs:comment 'Full name of the sideline reporter assigned to this production. May be null for studio-only productions. Tracked for talent scheduling and credential management.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signalFormat rdf:type rdf:Property ;
    rdfs:label 'Signal Format' ;
    rdfs:comment 'Technical broadcast signal format used for this production (e.g., HD, 4K, 8K, SD, HDR). Determines equipment requirements, CDN bandwidth allocation, and platform delivery specifications.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorBillboardCount rdf:type rdf:Property ;
    rdfs:label 'Sponsor Billboard Count' ;
    rdfs:comment 'Number of sponsor billboard/branding slots allocated within this production\'s broadcast runsheet. Used for sponsorship fulfillment tracking and CPM reporting.' ;
    rdfs:domain ind:Production ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rightsRoyaltyId rdf:type rdf:Property ;
    rdfs:label 'Rights Royalty Id' ;
    rdfs:comment 'Unique surrogate identifier for each royalty or rights fee payment record under a media rights deal or sublicense agreement. Primary key for the rights_royalty transactional entity.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:apInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Ap Invoice Id' ;
    rdfs:comment 'Reference to the accounts receivable or accounts payable invoice generated for this royalty payment in the SAP S/4HANA FI module. Links the royalty record to the formal billing document.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApInvoice .

ind:contentLicenseId rdf:type rdf:Property ;
    rdfs:label 'Content License Id' ;
    rdfs:comment 'Foreign key linking to content.license. Business justification: Royalty calculations are governed by content license terms (royalty_rate, revenue_share_pct, fee_structure). Finance teams need to link royalty records to the content license for accurate royalty comp' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContentLicense .

ind:payerLicenseeId rdf:type rdf:Property ;
    rdfs:label 'Payer Licensee Id' ;
    rdfs:comment 'Foreign key linking to broadcast.licensee. Business justification: Rights royalty payments are typically paid by licensees who are using the licensed content. Adding payer_licensee_id (labeled to indicate the paying party) enables tracking which licensee is responsib' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Licensee .

ind:sublicenseAgreementId rdf:type rdf:Property ;
    rdfs:label 'Sublicense Agreement Id' ;
    rdfs:comment 'Reference to the sublicense agreement if this royalty is generated under a sublicensed rights arrangement rather than a primary deal. Null when the royalty is directly under the primary rights deal.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SublicenseAgreement .

ind:sublicenseAgreementId rdf:type rdf:Property ;
    rdfs:label 'Sublicense Sublicense Agreement Id' ;
    rdfs:comment 'Reference to the sublicense agreement if this royalty is generated under a sublicensed rights arrangement rather than a primary deal. Null when the royalty is directly under the primary rights deal.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SublicenseAgreement .

ind:adjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Amount' ;
    rdfs:comment 'Net value of all adjustments applied to the calculated royalty, including credits, deductions, make-goods, or corrections from prior periods. Negative values represent deductions; positive values represent additions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditTrailNotes rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Notes' ;
    rdfs:comment 'Free-text field capturing material adjustments, manual overrides, reconciliation comments, or compliance notes associated with this royalty record. Supports SOX audit trail requirements and internal review processes.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculatedRoyaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Calculated Royalty Amount' ;
    rdfs:comment 'Gross royalty amount computed per the contractual formula for the payment period, before any adjustments, deductions, or withholding tax. This is the base amount used for invoicing and revenue recognition.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeReference rdf:type rdf:Property ;
    rdfs:label 'Dispute Reference' ;
    rdfs:comment 'Reference number or identifier for any formal dispute raised against this royalty record by either party. Populated when reconciliation_status is \'exception\' or royalty_status is \'disputed\'. Links to the dispute management workflow.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeRate rdf:type rdf:Property ;
    rdfs:label 'Exchange Rate' ;
    rdfs:comment 'Foreign exchange rate applied to convert the royalty amount from the contract currency to the functional reporting currency (USD) at the time of calculation or payment. Sourced from SAP FI exchange rate tables.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:functionalCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Functional Currency Amount' ;
    rdfs:comment 'Net royalty amount converted to the company functional currency (USD) using the applicable exchange rate. Used for consolidated financial reporting and GL posting in the finance domain.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:latePaymentPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Late Payment Penalty Amount' ;
    rdfs:comment 'Penalty amount assessed for late payment of the royalty, calculated per the contractual penalty clause. Zero if payment was made on or before the due date. Feeds into partner settlement and dispute management.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumGuaranteeAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Guarantee Amount' ;
    rdfs:comment 'Contractual minimum royalty floor amount for the payment period, regardless of actual performance metrics. If the calculated royalty falls below this threshold, the minimum guarantee applies. Null if no minimum guarantee is stipulated.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netRoyaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Net Royalty Amount' ;
    rdfs:comment 'Final net amount due or received after applying adjustments and withholding tax deductions to the calculated royalty amount. This is the amount posted to the general ledger and used for partner settlement.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDirection rdf:type rdf:Property ;
    rdfs:label 'Payment Direction' ;
    rdfs:comment 'Indicates whether this royalty record represents an amount owed TO Sports Entertainment (receivable, e.g., from a sublicensee) or an amount owed BY Sports Entertainment (payable, e.g., to a rights holder). Critical for GL posting logic.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Payment Due Date' ;
    rdfs:comment 'Contractually agreed date by which the royalty payment must be received or remitted. Drives accounts receivable aging and late-payment penalty calculations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Payment Period End Date' ;
    rdfs:comment 'Last day of the royalty calculation period for which this payment obligation is computed. Together with payment_period_start_date defines the billing window.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Payment Period Start Date' ;
    rdfs:comment 'First day of the royalty calculation period (e.g., monthly, quarterly) for which this payment obligation is computed. Used for revenue recognition period alignment.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Payment Received Date' ;
    rdfs:comment 'Actual date on which the royalty payment was received and cleared in the financial system. Null if payment has not yet been received. Used for days-outstanding and cash flow reporting.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Status' ;
    rdfs:comment 'Status of the reconciliation process between the calculated royalty amount and the actual payment received. Supports the broadcast rights revenue reconciliation workflow and partner settlement sign-off.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodLabel rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Label' ;
    rdfs:comment 'Human-readable label for the financial reporting period covered by this royalty (e.g., Q1-2025, JAN-2025, FY2025). Used for financial reporting, EBITDA analysis, and regulatory filings.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyBasisValue rdf:type rdf:Property ;
    rdfs:label 'Royalty Basis Value' ;
    rdfs:comment 'The underlying metric value on which the royalty is calculated, such as total subscriber count, gross revenue, PPV buy rate, or viewership impressions for the payment period. Provides audit trail for royalty computation.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:royaltyRateUnit rdf:type rdf:Property ;
    rdfs:label 'Royalty Rate Unit' ;
    rdfs:comment 'Unit of measure for the royalty rate, indicating how the rate is applied to the basis value. Determines the calculation formula used in the royalty engine.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Royalty Reference Number' ;
    rdfs:comment 'Externally-known business identifier for this royalty payment record, used in partner settlement communications, remittance advices, and reconciliation with counterparty systems. Follows the format RR-YYYY-NNNNNN.' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyStatus rdf:type rdf:Property ;
    rdfs:label 'Royalty Status' ;
    rdfs:comment 'Current lifecycle state of the royalty payment record. Drives workflow routing, collections activity, and financial reporting. [ENUM-REF-CANDIDATE: calculated|invoiced|disputed|paid|overdue|cancelled|written_off — promote to reference product]' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyType rdf:type rdf:Property ;
    rdfs:label 'Royalty Type' ;
    rdfs:comment 'Classification of the royalty calculation methodology as defined in the rights agreement. Determines how the royalty amount is computed. [ENUM-REF-CANDIDATE: flat_fee|revenue_share|per_subscriber|per_view|minimum_guarantee|overage — promote to reference product]' ;
    rdfs:domain ind:RightsRoyalty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withholdingTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Amount' ;
    rdfs:comment 'Amount of withholding tax deducted from the royalty payment as required by applicable tax treaties or local tax regulations for cross-border rights payments. Zero for domestic transactions where withholding does not apply.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightsViolationId rdf:type rdf:Property ;
    rdfs:label 'Rights Violation Id' ;
    rdfs:comment 'Unique surrogate identifier for each detected or reported media rights violation record in the broadcast domain.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:broadcastEventBroadcastScheduleId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Event Broadcast Schedule Id' ;
    rdfs:comment 'Reference to the specific broadcast event (e.g., live match, PPV event, scheduled broadcast) that was subject to the rights violation.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BroadcastSchedule .

ind:ipEnforcementActionId rdf:type rdf:Property ;
    rdfs:label 'Ip Enforcement Action Id' ;
    rdfs:comment 'Foreign key linking to legal.ip_enforcement_action. Business justification: Broadcast rights violations (unauthorized streaming, piracy) directly trigger IP enforcement actions managed by the legal team. The ip_enforcement_action product has a broadcast_rights_related flag co' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IpEnforcementAction .

ind:penaltyApInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Penalty Ap Invoice Id' ;
    rdfs:comment 'Foreign key linking to finance.ap_invoice. Business justification: Rights violations resulting in financial penalties generate AP invoices for penalty payments to rights holders. Finance needs the AP invoice linkage to track penalty payables and match violation enfor' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApInvoice .

ind:counterNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Counter Notice Date' ;
    rdfs:comment 'Date on which the DMCA counter-notice was received from the infringing party. Starts the statutory waiting period clock under DMCA Section 512(g)(2).' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:counterNoticeReceived rdf:type rdf:Property ;
    rdfs:label 'Counter Notice Received' ;
    rdfs:comment 'Indicates whether the infringing party filed a DMCA counter-notice disputing the takedown. Triggers a mandatory 10-14 business day waiting period before content may be restored.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detected Timestamp' ;
    rdfs:comment 'The date and time when the rights violation was first detected or reported, representing the principal real-world event time. Critical for calculating response SLA and legal notice windows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:detectionMethod rdf:type rdf:Property ;
    rdfs:label 'Detection Method' ;
    rdfs:comment 'Method by which the rights violation was identified. Automated monitoring includes Content Delivery Network (CDN) and watermarking tools; third-party reports come from rights monitoring vendors; partner notifications from licensees.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionTool rdf:type rdf:Property ;
    rdfs:label 'Detection Tool' ;
    rdfs:comment 'Name of the automated tool, monitoring service, or third-party vendor that identified the violation (e.g., Audible Magic, Vobile, MarkMonitor, internal CDN monitoring). Supports vendor performance tracking.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementAction rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action' ;
    rdfs:comment 'Type of enforcement action taken in response to the rights violation. DMCA takedown is the primary tool for online infringement; cease-and-desist and financial penalties apply to commercial infringers.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementActionDate rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Date' ;
    rdfs:comment 'Date on which the enforcement action (e.g., DMCA takedown notice, cease-and-desist letter) was formally initiated or submitted against the infringing party.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estimatedAudienceReach rdf:type rdf:Property ;
    rdfs:label 'Estimated Audience Reach' ;
    rdfs:comment 'Estimated number of viewers or users who accessed the infringing content. Used to assess the commercial impact of the violation and inform penalty calculations.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedRevenueImpact rdf:type rdf:Property ;
    rdfs:label 'Estimated Revenue Impact' ;
    rdfs:comment 'Estimated monetary value of revenue lost or at risk due to this rights violation, used for rights deal enforcement reporting and EBITDA impact analysis. Expressed in the currency of the associated rights agreement.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:evidenceReference rdf:type rdf:Property ;
    rdfs:label 'Evidence Reference' ;
    rdfs:comment 'Reference identifier or storage path to the evidence package associated with this violation, including screenshots, stream captures, and recording samples stored in the Digital Asset Management (DAM) system.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gdprDataSubjectNotified rdf:type rdf:Property ;
    rdfs:label 'Gdpr Data Subject Notified' ;
    rdfs:comment 'Indicates whether the data subject (infringing individual) has been notified in accordance with GDPR requirements when personal data was processed during the investigation of this violation. Applicable for EU-territory violations.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:infringingContentDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Infringing Content Duration Seconds' ;
    rdfs:comment 'Duration in seconds of the infringing content that was broadcast or streamed without authorization. Used to assess severity of the violation and calculate proportional penalties.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:infringingPartyName rdf:type rdf:Property ;
    rdfs:label 'Infringing Party Name' ;
    rdfs:comment 'Name of the individual, organization, or platform identified as the infringing party responsible for the rights violation. May be a broadcaster, streaming service, social media account, or individual user.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infringingPartyType rdf:type rdf:Property ;
    rdfs:label 'Infringing Party Type' ;
    rdfs:comment 'Classification of the infringing party responsible for the violation. Distinguishes between individuals, broadcasters, Over-The-Top (OTT) platforms, social media accounts, Internet Protocol Television (IPTV) providers, and Regional Sports Networks (RSN).' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infringingUrl rdf:type rdf:Property ;
    rdfs:label 'Infringing Url' ;
    rdfs:comment 'The URL or URI of the infringing content as identified at the time of detection. Used as primary evidence in DMCA takedown notices and cease-and-desist correspondence.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRepeatInfringer rdf:type rdf:Property ;
    rdfs:label 'Is Repeat Infringer' ;
    rdfs:comment 'Indicates whether the infringing party has been identified as a repeat infringer with prior violations on record. Repeat infringer status triggers escalated enforcement under DMCA repeat infringer policy.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:platformName rdf:type rdf:Property ;
    rdfs:label 'Platform Name' ;
    rdfs:comment 'Name of the digital platform or channel on which the rights violation was detected (e.g., YouTube, Facebook, Twitch, unauthorized IPTV service, pirate streaming site).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingSource rdf:type rdf:Property ;
    rdfs:label 'Reporting Source' ;
    rdfs:comment 'Identifies the source that originally reported or flagged the rights violation. Distinguishes between internal monitoring systems, rights holders, licensees, third-party monitoring vendors, regulatory bodies, or public tips.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionDate rdf:type rdf:Property ;
    rdfs:label 'Resolution Date' ;
    rdfs:comment 'Date on which the rights violation was fully resolved, meaning infringing content was removed, penalties were paid, or the case was formally closed.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityLevel rdf:type rdf:Property ;
    rdfs:label 'Severity Level' ;
    rdfs:comment 'Business-assessed severity classification of the rights violation based on factors such as audience reach, commercial impact, and violation type. Drives prioritization of enforcement response.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:takedownResponseDate rdf:type rdf:Property ;
    rdfs:label 'Takedown Response Date' ;
    rdfs:comment 'Date on which the infringing platform or party responded to the enforcement action, such as confirming content removal or filing a counter-notice. Used to measure platform compliance SLA.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:violationReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Violation Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned to this violation for use in legal correspondence, DMCA filings, cease-and-desist letters, and enforcement tracking. Format: RV-YYYY-NNNNNN.' ;
    rdfs:domain ind:RightsViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationStatus rdf:type rdf:Property ;
    rdfs:label 'Violation Status' ;
    rdfs:comment 'Current lifecycle status of the rights violation record, tracking progression from initial detection through enforcement action to resolution or closure.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationType rdf:type rdf:Property ;
    rdfs:label 'Violation Type' ;
    rdfs:comment 'Classification of the type of media rights violation detected. Covers unauthorized rebroadcasts, geo-restriction breaches, DRM circumvention, blackout non-compliance, unauthorized clip usage on social platforms, and Pay-Per-View (PPV) signal theft.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streamingSubscriptionId rdf:type rdf:Property ;
    rdfs:label 'Streaming Subscription Id' ;
    rdfs:comment 'Unique surrogate identifier for each streaming subscription record. Primary key for the streaming_subscription data product within the broadcast domain.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StreamingSubscription .

ind:digitalSubscriptionId rdf:type rdf:Property ;
    rdfs:label 'Digital Subscription Id' ;
    rdfs:comment 'Reference to the subscription plan/tier definition record that governs the entitlements, pricing, and features associated with this subscription.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DigitalSubscription .

ind:planId rdf:type rdf:Property ;
    rdfs:label 'Plan Id' ;
    rdfs:comment 'Reference to the subscription plan/tier definition record that governs the entitlements, pricing, and features associated with this subscription.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SubscriptionPlan .

ind:acquisitionChannel rdf:type rdf:Property ;
    rdfs:label 'Acquisition Channel' ;
    rdfs:comment 'The marketing or distribution channel through which the subscriber was acquired. Used for CAC (Customer Acquisition Cost) attribution, ROI (Return on Investment) analysis, and channel performance reporting in Adobe Experience Platform. [ENUM-REF-CANDIDATE: organic|paid_search|social_media|email|partner|in_app|referral — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCycle rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle' ;
    rdfs:comment 'The recurring billing frequency for the subscription. Determines how often the subscriber is charged and when renewal events are triggered in the billing system.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCycleDay rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Day' ;
    rdfs:comment 'The day of the month (1–28) on which the recurring billing charge is processed. Used by the billing engine to schedule charge attempts and generate invoices.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blackoutRegionCode rdf:type rdf:Property ;
    rdfs:label 'Blackout Region Code' ;
    rdfs:comment 'ISO country or region code identifying the geographic blackout restriction applied to this subscription. Enforces broadcast rights agreements and RSN (Regional Sports Network) territorial exclusivity. Null if no blackout applies.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Date' ;
    rdfs:comment 'The date on which the subscriber initiated cancellation of the subscription. Distinct from end_date (which is the access expiry). Null if subscription has not been cancelled. Used for churn analysis and GDPR Article 17 right-to-erasure workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentDataSharingFlag rdf:type rdf:Property ;
    rdfs:label 'Consent Data Sharing Flag' ;
    rdfs:comment 'Indicates whether the subscriber has consented to their viewing and behavioral data being shared with third-party analytics partners, sponsors, or league data programs. Required for GDPR Article 6 lawful basis and CCPA opt-out compliance.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentMarketingFlag rdf:type rdf:Property ;
    rdfs:label 'Consent Marketing Flag' ;
    rdfs:comment 'Indicates whether the subscriber has provided explicit consent to receive marketing communications related to their subscription and associated sports/entertainment content. Mandatory for GDPR and CCPA compliance in fan engagement workflows.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Consent Timestamp' ;
    rdfs:comment 'The timestamp at which the subscriber\'s consent preferences (marketing and data sharing) were last captured or updated. Required for GDPR audit trail and proof-of-consent obligations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:downloadEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Download Enabled Flag' ;
    rdfs:comment 'Indicates whether the subscriber\'s plan tier permits offline content downloads to their device. True = downloads permitted subject to DRM expiry rules; False = streaming only. Governed by content rights windows.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drmProfileCode rdf:type rdf:Property ;
    rdfs:label 'Drm Profile Code' ;
    rdfs:comment 'Reference to the DRM (Digital Rights Management) policy profile assigned to this subscription tier. Governs content protection, concurrent stream limits, download rights, and device binding rules enforced by the CDN (Content Delivery Network) and streaming platform.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxVideoQuality rdf:type rdf:Property ;
    rdfs:label 'Max Video Quality' ;
    rdfs:comment 'The highest video resolution quality tier permitted under this subscription plan. Governs CDN (Content Delivery Network) stream quality caps and is a key differentiator between subscription tiers.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextBillingDate rdf:type rdf:Property ;
    rdfs:label 'Next Billing Date' ;
    rdfs:comment 'The upcoming date on which the next recurring charge will be attempted for this subscription. Used for billing forecasting, dunning management, and subscriber communications.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:partnerBundleCode rdf:type rdf:Property ;
    rdfs:label 'Partner Bundle Code' ;
    rdfs:comment 'Identifier of the third-party partner bundle or distribution agreement through which this subscription was provisioned (e.g., IPTV carrier bundle, telco partnership, OTT aggregator). Null for direct DTC subscriptions. Used for partner revenue share reporting.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentMethodType rdf:type rdf:Property ;
    rdfs:label 'Payment Method Type' ;
    rdfs:comment 'The type of payment instrument used for recurring billing of this subscription. Stored as a tokenized reference type only — no raw card data is held in this product in compliance with PCI-DSS.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planTier rdf:type rdf:Property ;
    rdfs:label 'Plan Tier' ;
    rdfs:comment 'The commercial tier of the streaming subscription defining the level of content access and features available to the subscriber. Tiers range from basic (limited content) to all-access (full DTC/OTT catalog including PPV events).' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppvAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Ppv Access Flag' ;
    rdfs:comment 'Indicates whether this subscription tier includes access to PPV (Pay-Per-View) events as part of the base plan entitlement. True = PPV events included; False = PPV requires separate purchase. Critical for revenue recognition and event packaging decisions.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:promotionalRate rdf:type rdf:Property ;
    rdfs:label 'Promotional Rate' ;
    rdfs:comment 'The discounted charge amount applied during a promotional period (e.g., introductory offer, bundle discount, loyalty reward). When populated, this rate overrides the standard subscription_charge for the promotional duration.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:promotionalRateEndDate rdf:type rdf:Property ;
    rdfs:label 'Promotional Rate End Date' ;
    rdfs:comment 'The date on which the promotional pricing expires and the subscriber reverts to the standard subscription_charge. Null if no promotion is active.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceType rdf:type rdf:Property ;
    rdfs:label 'Service Type' ;
    rdfs:comment 'Classifies the streaming service model under which this subscription operates. DTC (Direct-To-Consumer) = owned platform; OTT (Over-The-Top Streaming) = third-party app distribution; IPTV (Internet Protocol Television) = carrier-delivered; RSN (Regional Sports Network) = regional broadcast bundle; PPV (Pay-Per-View) = single-event purchase.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriptionCharge rdf:type rdf:Property ;
    rdfs:label 'Subscription Charge' ;
    rdfs:comment 'The gross recurring charge amount billed to the subscriber per billing cycle before any discounts or promotional adjustments. Expressed in the subscription currency.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subscriptionNumber rdf:type rdf:Property ;
    rdfs:label 'Subscription Number' ;
    rdfs:comment 'Externally-visible, human-readable subscription reference number used in customer communications, billing statements, and support interactions. Sourced from the DTC/OTT platform billing system.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriptionStatus rdf:type rdf:Property ;
    rdfs:label 'Subscription Status' ;
    rdfs:comment 'Current lifecycle state of the streaming subscription. Drives entitlement enforcement, billing actions, and fan engagement workflows. Active = currently billable and entitled; Trialing = within a free trial window; Suspended = temporarily paused; Cancelled = subscriber-initiated termination; Expired = end date passed without renewal.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspensionDate rdf:type rdf:Property ;
    rdfs:label 'Suspension Date' ;
    rdfs:comment 'The date on which the subscription was placed into a suspended state (e.g., due to payment failure, voluntary pause, or compliance hold). Null if subscription has never been suspended.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:suspensionReason rdf:type rdf:Property ;
    rdfs:label 'Suspension Reason' ;
    rdfs:comment 'The reason the subscription was placed into a suspended state. Used for operational triage, dunning management, and compliance reporting. Null if subscription has never been suspended.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trialEndDate rdf:type rdf:Property ;
    rdfs:label 'Trial End Date' ;
    rdfs:comment 'The date on which the free trial period ends and the first paid billing cycle commences. Null if trial_flag is False. Critical for churn prediction and trial-to-paid conversion tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trialFlag rdf:type rdf:Property ;
    rdfs:label 'Trial Flag' ;
    rdfs:comment 'Indicates whether the subscription is currently within a free trial period. True = subscriber has not yet been charged; False = paid subscription. Used to distinguish trial cohorts from paying subscribers in ARPU (Average Revenue Per User) and LTV (Lifetime Value) analytics.' ;
    rdfs:domain ind:StreamingSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sublicenseeLicenseeId rdf:type rdf:Property ;
    rdfs:label 'Sublicensee Licensee Id' ;
    rdfs:comment 'Foreign key linking to broadcast.licensee. Business justification: Sublicense agreements grant rights to sublicensees (who are licensees in the broader rights ecosystem). The sublicensee is the party receiving the sublicensed rights. Adding sublicensee_licensee_id (l' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Licensee .

ind:agreementReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Agreement Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to this sublicense agreement, used in correspondence with the sublicensee and in SAP S/4HANA SD contract documents.' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementTitle rdf:type rdf:Property ;
    rdfs:label 'Agreement Title' ;
    rdfs:comment 'Descriptive title of the sublicense agreement, typically including the sublicensee name, territory, and content scope (e.g., \'RSN West Coast NFL Package 2024-2026\').' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementType rdf:type rdf:Property ;
    rdfs:label 'Agreement Type' ;
    rdfs:comment 'Classification of the sublicense arrangement by distribution channel. Distinguishes RSN affiliates, international broadcasters, Over-The-Top (OTT) platforms, Internet Protocol Television (IPTV) distributors, Pay-Per-View (PPV) packagers, and cable operators. [ENUM-REF-CANDIDATE: rsn_affiliate|international_broadcast|ott_platform|iptv_distributor|ppv_packager|cable_operator|dtc_streaming|free_to_air — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:antiPiracyObligations rdf:type rdf:Property ;
    rdfs:label 'Anti Piracy Obligations' ;
    rdfs:comment 'Indicates whether the sublicense agreement includes specific anti-piracy and Intellectual Property (IP) protection obligations binding on the sublicensee, such as watermarking, geo-blocking, and DRM enforcement.' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contentRightsType rdf:type rdf:Property ;
    rdfs:label 'Content Rights Type' ;
    rdfs:comment 'Classification of the content rights granted: live broadcast, replay/time-shifted, highlights packages, all rights, or video-on-demand (VOD) only. Determines permissible use by the sublicensee.' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentScopeDescription rdf:type rdf:Property ;
    rdfs:label 'Content Scope Description' ;
    rdfs:comment 'Narrative description of the specific content rights granted under this sublicense, including leagues, sports, events, or content packages covered (e.g., \'All regular season NFL games excluding playoffs\').' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Fee Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the sublicense fee and revenue share amounts (e.g., USD, GBP, EUR). Required for multi-territory international sublicense agreements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feePaymentSchedule rdf:type rdf:Property ;
    rdfs:label 'Fee Payment Schedule' ;
    rdfs:comment 'Frequency or structure of sublicense fee payments from the sublicensee. Drives accounts receivable scheduling in SAP S/4HANA and financial planning in Workday Adaptive Planning.' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:platformRights rdf:type rdf:Property ;
    rdfs:label 'Platform Rights' ;
    rdfs:comment 'Distribution platforms on which the sublicensee is authorized to broadcast content. Covers linear TV, Over-The-Top (OTT), Internet Protocol Television (IPTV), mobile, or combinations thereof.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sublicenseFee rdf:type rdf:Property ;
    rdfs:label 'Sublicense Fee' ;
    rdfs:comment 'Total contracted sublicense fee payable by the sublicensee to Sports Entertainment for the rights granted under this agreement. Represents the gross rights fee before any revenue share adjustments.' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sublicenseFeePaidToDate rdf:type rdf:Property ;
    rdfs:label 'Sublicense Fee Paid To Date' ;
    rdfs:comment 'Cumulative sublicense fee amount received from the sublicensee as of the most recent payment posting in SAP S/4HANA AR. Supports revenue recognition and accounts receivable monitoring.' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sublicenseNotes rdf:type rdf:Property ;
    rdfs:label 'Sublicense Notes' ;
    rdfs:comment 'Free-text field for capturing material deal-specific terms, special conditions, side letters, or compliance obligations not captured in structured fields. Reviewed during contract audits.' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sublicenseTermYears rdf:type rdf:Property ;
    rdfs:label 'Sublicense Term Years' ;
    rdfs:comment 'Duration of the sublicense agreement expressed in years. Supports rights portfolio planning, renewal forecasting, and Workday Adaptive Planning financial projections.' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sublicenseeReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Sublicensee Reporting Required' ;
    rdfs:comment 'Indicates whether the sublicensee is contractually obligated to provide viewership, ratings, or revenue reports to Sports Entertainment. Drives compliance monitoring workflows.' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sublicensorEntityCode rdf:type rdf:Property ;
    rdfs:label 'Sublicensor Entity Code' ;
    rdfs:comment 'SAP company code identifying the Sports Entertainment legal entity acting as sublicensor under this agreement. Required for intercompany settlement and SOX financial controls.' ;
    rdfs:domain ind:SublicenseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adaAccommodationId rdf:type rdf:Property ;
    rdfs:label 'Ada Accommodation Id' ;
    rdfs:comment 'Unique surrogate identifier for each ADA accommodation request and fulfillment record. Primary key for the ada_accommodation data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AdaAccommodation .

ind:accessibilityFeatureId rdf:type rdf:Property ;
    rdfs:label 'Accessibility Feature Id' ;
    rdfs:comment 'Foreign key linking to venue.accessibility_feature. Business justification: ADA accommodation fulfillment depends on specific physical accessibility features (lifts, hearing loops, accessible routes). Linking the accommodation request to the feature used enables operational t' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccessibilityFeature .

ind:arbitrationCaseId rdf:type rdf:Property ;
    rdfs:label 'Arbitration Case Id' ;
    rdfs:comment 'Foreign key linking to compliance.arbitration_case. Business justification: ADA accommodation disputes can escalate to arbitration proceedings. While ada_accommodation already has legal_case_id → legal.litigation_case (cross-domain), an in-domain link to arbitration_case capt' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ArbitrationCase .

ind:parentAccommodationAdaAccommodationId rdf:type rdf:Property ;
    rdfs:label 'Parent Accommodation Ada Accommodation Id' ;
    rdfs:comment 'Self-referencing identifier linking a recurring or follow-up accommodation record to its original parent request. Enables tracking of accommodation history and recurrence chains for season-long or multi-event arrangements.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AdaAccommodation .

ind:parkingLotId rdf:type rdf:Property ;
    rdfs:label 'Parking Lot Id' ;
    rdfs:comment 'Foreign key linking to venue.parking_lot. Business justification: ADA accommodation requests frequently include accessible parking assignments. ada_accommodation.parking_space_assigned is a denormalized text field; a FK to parking_lot enables structured tracking of ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ParkingLot .

ind:primaryAdaEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Ada Employee Id' ;
    rdfs:comment 'Identifier of the internal staff member or ADA coordinator assigned to manage and fulfill this accommodation request. Supports workload tracking and accountability.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:seatingSectionId rdf:type rdf:Property ;
    rdfs:label 'Seating Section Id' ;
    rdfs:comment 'Foreign key linking to venue.seating_section. Business justification: ADA accommodation requests specify seating section placement. ada_accommodation.seat_section is a denormalized text field; a proper FK to seating_section enables structured ADA seating inventory manag' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SeatingSection .

ind:ticketInventoryId rdf:type rdf:Property ;
    rdfs:label 'Ticket Inventory Id' ;
    rdfs:comment 'Foreign key linking to ticketing.ticket_inventory. Business justification: ADA accommodation fulfillment requires tracking which specific ADA-accessible seat inventory record was assigned. Compliance audits under ADA Title III verify that accessible inventory was actually al' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TicketInventory .

ind:accommodationDetail rdf:type rdf:Property ;
    rdfs:label 'Accommodation Detail' ;
    rdfs:comment 'Free-text description providing additional specifics about the accommodation need beyond the primary type classification (e.g., companion seat required, specific interpreter language, power wheelchair dimensions). Supports nuanced fulfillment planning.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accommodationOutcome rdf:type rdf:Property ;
    rdfs:label 'Accommodation Outcome' ;
    rdfs:comment 'Final recorded outcome of the accommodation at the time of the event or service delivery. Distinct from fulfillment_status (workflow state) — this captures the actual real-world result. Used for ADA compliance reporting and continuous improvement.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accommodationType rdf:type rdf:Property ;
    rdfs:label 'Accommodation Type' ;
    rdfs:comment 'Primary category of accessibility accommodation requested. Covers the six core accommodation types tracked for ADA Title II/III compliance: wheelchair seating, hearing loop, sign language interpreter, accessible parking, service animal area, and sensory room.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adaTitleApplicability rdf:type rdf:Property ;
    rdfs:label 'Ada Title Applicability' ;
    rdfs:comment 'Identifies which title of the Americans with Disabilities Act governs this accommodation: Title I (employment), Title II (public entities/government programs), or Title III (public accommodations and commercial facilities such as venues).' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:advanceNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Advance Notice Days' ;
    rdfs:comment 'Number of calendar days between the request submission date and the event date. Used to assess whether sufficient advance notice was provided for complex accommodations and to measure compliance with ADA advance notice policies.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:companionSeatsRequired rdf:type rdf:Property ;
    rdfs:label 'Companion Seats Required' ;
    rdfs:comment 'Number of companion or attendant seats requested adjacent to the accessible seating position. ADA regulations require companion seating to be provided at no additional charge. Used for inventory allocation in Archtics.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complaintFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Complaint Filed Flag' ;
    rdfs:comment 'Indicates whether the requestor filed a formal ADA complaint related to this accommodation request. True = complaint filed. Triggers escalation workflow and legal review. Critical for compliance risk management.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complaintReference rdf:type rdf:Property ;
    rdfs:label 'Complaint Reference' ;
    rdfs:comment 'Reference number of the formal ADA complaint filed with the DOJ, HHS, or internal grievance process, if applicable. Nullable when no complaint has been filed. Links accommodation record to legal case management.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinatorName rdf:type rdf:Property ;
    rdfs:label 'Coordinator Name' ;
    rdfs:comment 'Full name of the ADA coordinator assigned to this request. Captured as a denormalized field for audit trail integrity and compliance reporting independent of workforce system changes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Amount' ;
    rdfs:comment 'Actual cost incurred to fulfill the accommodation (e.g., interpreter fees, equipment rental, parking space reservation). Used for ADA program budget tracking and financial reporting in SAP S/4HANA CO module.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCenterCode rdf:type rdf:Property ;
    rdfs:label 'Cost Center Code' ;
    rdfs:comment 'SAP S/4HANA CO cost center code to which the accommodation fulfillment cost is allocated. Enables financial tracking of ADA compliance program expenditure by venue, event, or business unit.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Cost Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the accommodation cost amount (e.g., USD, GBP, EUR). Supports multi-currency financial reporting for global venue operations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crmContactCode rdf:type rdf:Property ;
    rdfs:label 'Crm Contact Code' ;
    rdfs:comment 'Salesforce CRM contact identifier for the requestor, enabling linkage of accommodation history to the fan or stakeholder\'s CRM profile for personalized engagement and repeat accommodation management.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:denialReason rdf:type rdf:Property ;
    rdfs:label 'Denial Reason' ;
    rdfs:comment 'Documented reason when an accommodation request is denied or only partially fulfilled. Required for ADA compliance documentation and potential CAS arbitration or legal challenge. Nullable when fulfillment_status is not denied or partial.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disabilityCategory rdf:type rdf:Property ;
    rdfs:label 'Disability Category' ;
    rdfs:comment 'Broad classification of the disability type driving the accommodation need. Classified as restricted PHI/PII. Used for aggregate compliance reporting and accommodation inventory planning. Individual-level data is protected under GDPR, CCPA, and ADA. [ENUM-REF-CANDIDATE: mobility|hearing|vision|cognitive|sensory|other — promote to reference product]' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfillmentDate rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Date' ;
    rdfs:comment 'Calendar date on which the accommodation was confirmed as fulfilled or the event date for which it was arranged. Used for SLA compliance measurement and post-event reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fulfillmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Timestamp' ;
    rdfs:comment 'Precise date and time when the accommodation was confirmed as fulfilled by the assigned coordinator. Used for precise SLA measurement and audit trail.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:interpreterLanguage rdf:type rdf:Property ;
    rdfs:label 'Interpreter Language' ;
    rdfs:comment 'Specific sign language or communication language required for interpreter accommodations (e.g., ASL, BSL, PSE). Nullable for non-interpreter accommodation types. Uses ISO 639-3 language codes where applicable.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRecurring rdf:type rdf:Property ;
    rdfs:label 'Is Recurring' ;
    rdfs:comment 'Indicates whether this accommodation is a standing/recurring arrangement for a season ticket holder, employee, or athlete rather than a one-time event request. True = recurring. Supports proactive accommodation planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outcomeNotes rdf:type rdf:Property ;
    rdfs:label 'Outcome Notes' ;
    rdfs:comment 'Free-text field capturing coordinator observations about the accommodation outcome, including any issues encountered during fulfillment, requestor feedback, or follow-up actions required.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parkingSpaceAssigned rdf:type rdf:Property ;
    rdfs:label 'Parking Space Assigned' ;
    rdfs:comment 'Designated accessible parking space identifier assigned to fulfill a parking accommodation request. Nullable for non-parking accommodation types.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestDate rdf:type rdf:Property ;
    rdfs:label 'Request Date' ;
    rdfs:comment 'Calendar date on which the accommodation request was formally submitted by the requestor. Used for SLA tracking, advance notice compliance, and reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Request Reference Number' ;
    rdfs:comment 'Externally visible, human-readable reference number assigned to the accommodation request at intake. Used in correspondence with requestors, coordinators, and compliance auditors. Format: ADA-YYYY-NNNNNN.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestTimestamp rdf:type rdf:Property ;
    rdfs:label 'Request Timestamp' ;
    rdfs:comment 'Precise date and time when the accommodation request was received in the system. Used for SLA measurement, audit trail, and time-sensitive fulfillment workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:requestorEmail rdf:type rdf:Property ;
    rdfs:label 'Requestor Email' ;
    rdfs:comment 'Primary email address of the requestor used for accommodation confirmation, status updates, and coordinator communication. Restricted PII under GDPR and CCPA.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorName rdf:type rdf:Property ;
    rdfs:label 'Requestor Name' ;
    rdfs:comment 'Full legal name of the individual requesting the accommodation. Classified as restricted PII under GDPR and CCPA. Used for case management, correspondence, and audit trail.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorPhone rdf:type rdf:Property ;
    rdfs:label 'Requestor Phone' ;
    rdfs:comment 'Contact phone number for the requestor, used for coordinator follow-up and confirmation of accommodation arrangements. Restricted PII.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorType rdf:type rdf:Property ;
    rdfs:label 'Requestor Type' ;
    rdfs:comment 'Category of the individual submitting the accommodation request. Distinguishes between fans (Title III), athletes (CBA/league rules), employees (Title I), media personnel, vendors, and other parties. Drives applicable compliance framework and SLA. [ENUM-REF-CANDIDATE: fan|athlete|employee|media|vendor|other — promote to reference product]' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatNumber rdf:type rdf:Property ;
    rdfs:label 'Seat Number' ;
    rdfs:comment 'Specific seat number assigned for the accessible seating accommodation. Sourced from Archtics venue inventory. Nullable for non-seating accommodation types.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatRow rdf:type rdf:Property ;
    rdfs:label 'Seat Row' ;
    rdfs:comment 'Row designation within the assigned section for the accessible seat. Sourced from Archtics. Nullable for non-seating accommodation types.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaMetFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Met Flag' ;
    rdfs:comment 'Indicates whether the accommodation request was responded to and fulfilled within the defined SLA target hours. True = SLA met; False = SLA breached. Key compliance KPI for ADA program management.' ;
    rdfs:domain ind:AdaAccommodation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaTargetHours rdf:type rdf:Property ;
    rdfs:label 'Sla Target Hours' ;
    rdfs:comment 'Target number of hours within which the accommodation request should receive an initial coordinator response, as defined by the organization\'s ADA SLA policy. Used for SLA compliance monitoring.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionChannel rdf:type rdf:Property ;
    rdfs:label 'Submission Channel' ;
    rdfs:comment 'Channel through which the accommodation request was submitted. Supports channel analytics, process improvement, and ensures all intake pathways are ADA-compliant. Aligns with Adobe Experience Platform fan engagement tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:companyCodeId rdf:type rdf:Property ;
    rdfs:label 'Company Code Id' ;
    rdfs:comment 'Foreign key linking to finance.company_code. Business justification: Arbitration cases carry estimated_liability_amount and settlement_amount that must be accrued against a specific legal entity. Finance requires company_code to book contingent liabilities and settleme' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompanyCode .

ind:internalCounselEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Internal Counsel Employee Id' ;
    rdfs:comment 'Reference to the internal legal counsel or compliance officer responsible for managing this case within Sports Entertainment. Links to the workforce/employee master for matter ownership and escalation routing.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:outsideCounselId rdf:type rdf:Property ;
    rdfs:label 'Outside Counsel Id' ;
    rdfs:comment 'Foreign key linking to legal.outside_counsel. Business justification: Arbitration cases require outside counsel engagement. The compliance arbitration_case record must reference the outside counsel firm handling the matter for billing, conflict checks, and performance t' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OutsideCounsel .

ind:primaryArbitrationPolicyId rdf:type rdf:Property ;
    rdfs:label 'Primary Arbitration Policy Id' ;
    rdfs:comment 'Reference to the internal compliance policy, code of conduct, or regulatory framework that was allegedly violated or is at issue in this case. Links to the compliance policy master for policy enforcement tracking.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:relatedIncidentIncidentReportId rdf:type rdf:Property ;
    rdfs:label 'Related Incident Incident Report Id' ;
    rdfs:comment 'Reference to the originating compliance incident, event incident, or regulatory investigation record that gave rise to this arbitration or legal case. Enables traceability from incident to case outcome.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IncidentReport .

ind:appealDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Deadline Date' ;
    rdfs:comment 'Statutory or contractual deadline by which an appeal must be filed. Critical for legal calendar management and risk mitigation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealFiled rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed' ;
    rdfs:comment 'Indicates whether an appeal has been filed against the initial award or judgment. Triggers escalation workflow and updated financial provisioning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:awardAmount rdf:type rdf:Property ;
    rdfs:label 'Award Amount' ;
    rdfs:comment 'Monetary amount awarded or ordered by the arbitral tribunal or court in the final award or judgment. Positive value indicates amount payable by Sports Entertainment; negative indicates amount receivable. Null if case is not yet resolved or resolved without monetary award.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:awardSummary rdf:type rdf:Property ;
    rdfs:label 'Award Summary' ;
    rdfs:comment 'Concise narrative summary of the final award, judgment, or decision rendered by the tribunal or court, including key findings, relief granted, and any conditions or obligations imposed.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:casePriority rdf:type rdf:Property ;
    rdfs:label 'Case Priority' ;
    rdfs:comment 'Internal priority classification assigned by the legal and compliance team based on financial exposure, reputational risk, and regulatory significance. Drives resource allocation and executive escalation thresholds.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseStatus rdf:type rdf:Property ;
    rdfs:label 'Case Status' ;
    rdfs:comment 'Current lifecycle state of the arbitration or dispute case. Drives workflow routing, reporting dashboards, and escalation triggers. [ENUM-REF-CANDIDATE: filed|pending|active|hearing|deliberation|awarded|settled|appealed|closed|withdrawn — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseType rdf:type rdf:Property ;
    rdfs:label 'Case Type' ;
    rdfs:comment 'Classification of the dispute proceeding by legal forum and nature. Determines applicable procedural rules and governing body oversight. [ENUM-REF-CANDIDATE: sports_arbitration|civil_litigation|regulatory_investigation|criminal_referral|ip_infringement|employment_dispute|cba_grievance — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimantName rdf:type rdf:Property ;
    rdfs:label 'Claimant Name' ;
    rdfs:comment 'Full legal name of the claimant (arbitration) or plaintiff (litigation) initiating the dispute. May be an individual athlete, organization, league, or regulatory body. Classified confidential as it is a party to active legal proceedings.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimantType rdf:type rdf:Property ;
    rdfs:label 'Claimant Type' ;
    rdfs:comment 'Categorical classification of the claimant party. Enables segmentation of dispute proceedings by party type for governance reporting and trend analysis. [ENUM-REF-CANDIDATE: athlete|club|league|broadcaster|sponsor|employee|regulatory_body|third_party — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveryStatus rdf:type rdf:Property ;
    rdfs:label 'Discovery Status' ;
    rdfs:comment 'Current status of the evidence discovery or document production phase of the proceedings. Tracks compliance with discovery obligations and deadlines.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementStatus rdf:type rdf:Property ;
    rdfs:label 'Enforcement Status' ;
    rdfs:comment 'Current status of enforcement of the award, judgment, or settlement terms. Tracks whether obligations have been satisfied, are being contested, or are pending enforcement action.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedLiabilityAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Liability Amount' ;
    rdfs:comment 'Internal legal team estimate of the maximum financial exposure or liability associated with this case, expressed in the base currency. Used for financial provisioning, SOX contingent liability disclosures, and executive risk reporting.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Expected Resolution Date' ;
    rdfs:comment 'Projected date by which a final award, judgment, or settlement is expected. Used for financial provisioning, regulatory reporting timelines, and executive risk dashboards.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingDate rdf:type rdf:Property ;
    rdfs:label 'Filing Date' ;
    rdfs:comment 'The date on which the case, claim, or complaint was formally filed with the adjudicating forum. Serves as the principal business event date for statute of limitations tracking and SLA measurement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstHearingDate rdf:type rdf:Property ;
    rdfs:label 'First Hearing Date' ;
    rdfs:comment 'Scheduled or actual date of the first formal hearing, oral argument, or trial session. Used for calendar management, counsel preparation tracking, and SLA compliance.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forum rdf:type rdf:Property ;
    rdfs:label 'Forum' ;
    rdfs:comment 'The adjudicating forum or tribunal where the case is being heard. CAS (Court of Arbitration for Sport) is the primary sports arbitration body; other forums include civil courts, regulatory agencies, and labor boards.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingBody rdf:type rdf:Property ;
    rdfs:label 'Governing Body' ;
    rdfs:comment 'The primary industry or regulatory governing body whose rules, codes, or regulations are at issue in the case (e.g., WADA for anti-doping, FIFA for football governance, FCC for broadcast regulation). [ENUM-REF-CANDIDATE: FIFA|IOC|NFL|NBA|MLB|NHL|MLS|WADA|CAS|FCC|SEC|OSHA|ADA|GDPR|CCPA|PCI_SSC|SOX — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interimMeasuresDescription rdf:type rdf:Property ;
    rdfs:label 'Interim Measures Description' ;
    rdfs:comment 'Narrative description of any interim or provisional measures ordered, including scope, duration, and conditions. Populated only when interim_measures_granted is True.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interimMeasuresGranted rdf:type rdf:Property ;
    rdfs:label 'Interim Measures Granted' ;
    rdfs:comment 'Indicates whether interim or provisional measures (e.g., injunctions, stay of eligibility suspension, asset freezes) have been granted by the tribunal or court during the pendency of the case.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdiction rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction' ;
    rdfs:comment 'Legal jurisdiction governing the case proceedings (e.g., Switzerland for CAS, specific US state for civil litigation, EU for GDPR regulatory matters). Expressed as ISO 3166-1 alpha-3 country code or named jurisdiction where country code is insufficient.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latestHearingDate rdf:type rdf:Property ;
    rdfs:label 'Latest Hearing Date' ;
    rdfs:comment 'Date of the most recent hearing, session, or proceeding. Tracks case progression and supports scheduling of subsequent hearings.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leadExternalCounsel rdf:type rdf:Property ;
    rdfs:label 'Lead External Counsel' ;
    rdfs:comment 'Name of the primary external law firm or lead attorney representing Sports Entertainment in the proceedings. Used for matter management, conflict-of-interest checks, and outside counsel spend tracking.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matterManagementRef rdf:type rdf:Property ;
    rdfs:label 'Matter Management Ref' ;
    rdfs:comment 'Reference identifier from the enterprise legal matter management system (e.g., SAP S/4HANA legal module or external e-billing platform) linking this case record to the full matter file, billing records, and document repository.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outsideCounselSpend rdf:type rdf:Property ;
    rdfs:label 'Outside Counsel Spend' ;
    rdfs:comment 'Cumulative legal fees and disbursements paid to external counsel for this case to date. Used for matter budget management, ROI (Return on Investment) analysis of legal spend, and EBITDA (Earnings Before Interest Taxes Depreciation and Amortization) impact reporting.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:panelComposition rdf:type rdf:Property ;
    rdfs:label 'Panel Composition' ;
    rdfs:comment 'Names and roles of arbitrators, panel members, or presiding judge(s) assigned to the case. Stored as a structured text description (e.g., \'Sole Arbitrator: J. Smith; Appointed by CAS\'). Classified confidential due to sensitivity of judicial assignment information.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required' ;
    rdfs:comment 'Indicates whether this case requires mandatory disclosure or reporting to a regulatory body (e.g., SEC material litigation disclosure, WADA anti-doping result notification, FCC license compliance report).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:respondentName rdf:type rdf:Property ;
    rdfs:label 'Respondent Name' ;
    rdfs:comment 'Full legal name of the respondent (arbitration) or defendant (litigation) against whom the dispute is brought. May be Sports Entertainment entity, an athlete, club, or third party. Classified confidential as it is a party to active legal proceedings.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:respondentType rdf:type rdf:Property ;
    rdfs:label 'Respondent Type' ;
    rdfs:comment 'Categorical classification of the respondent or defendant party. Enables segmentation of dispute proceedings by party type for governance reporting and trend analysis. [ENUM-REF-CANDIDATE: athlete|club|league|broadcaster|sponsor|employee|regulatory_body|third_party — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementAmount rdf:type rdf:Property ;
    rdfs:label 'Settlement Amount' ;
    rdfs:comment 'Agreed monetary settlement amount if the case was resolved through negotiated settlement rather than a formal award or judgment. Null if no settlement was reached.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementTerms rdf:type rdf:Property ;
    rdfs:label 'Settlement Terms' ;
    rdfs:comment 'Summary of the key terms and conditions of any negotiated settlement agreement, including confidentiality obligations, non-disparagement clauses, and performance requirements. Distinct from award_summary which covers tribunal-rendered decisions.' ;
    rdfs:domain ind:ArbitrationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportOrLeague rdf:type rdf:Property ;
    rdfs:label 'Sport Or League' ;
    rdfs:comment 'The specific sport, league, or competition context to which this case relates (e.g., NFL, NBA, FIFA, UFC, ATP). Enables domain-specific reporting and governing body alignment for multi-sport enterprises.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectMatter rdf:type rdf:Property ;
    rdfs:label 'Subject Matter' ;
    rdfs:comment 'Concise description of the primary legal or regulatory subject matter at issue (e.g., PED (Performance Enhancing Drug) violation, NIL (Name Image and Likeness) contract breach, broadcast IP (Intellectual Property) infringement, GDPR data privacy violation, ADA accessibility non-compliance, CBA grievance).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditEngagementId rdf:type rdf:Property ;
    rdfs:label 'Audit Engagement Id' ;
    rdfs:comment 'Unique surrogate identifier for each audit engagement record in the compliance lakehouse. Primary key for the audit_engagement data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditEngagement .

ind:auditScheduleId rdf:type rdf:Property ;
    rdfs:label 'Audit Schedule Id' ;
    rdfs:comment 'Foreign key linking to compliance.audit_schedule. Business justification: An audit engagement is the execution record spawned from a planned audit schedule. The audit_schedule defines the planned calendar entry; the audit_engagement records the actual lifecycle. This parent' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditSchedule .

ind:bmsSystemId rdf:type rdf:Property ;
    rdfs:label 'Bms System Id' ;
    rdfs:comment 'Foreign key linking to venue.bms_system. Business justification: BMS systems (HVAC, fire suppression, access control) are in scope for cybersecurity and safety compliance audits. audit_engagement.system_in_scope is a denormalized text field; a FK to bms_system enab' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BmsSystem .

ind:internalAuditOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Internal Audit Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Internal audit ownership assignment is a core audit management process. Linking audit engagements to the responsible employee enables escalation workflows, workload reporting, and accountability track' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:linkedComplianceObligationId rdf:type rdf:Property ;
    rdfs:label 'Linked Compliance Obligation Id' ;
    rdfs:comment 'Reference to the regulatory or contractual obligation record that triggered or mandates this audit engagement. Links the audit to the compliance obligation register for traceability.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Obligation .

ind:linkedObligationId rdf:type rdf:Property ;
    rdfs:label 'Linked Obligation Id' ;
    rdfs:comment 'Reference to the regulatory or contractual obligation record that triggered or mandates this audit engagement. Links the audit to the compliance obligation register for traceability.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Obligation .

ind:priorEngagementAuditEngagementId rdf:type rdf:Property ;
    rdfs:label 'Prior Engagement Audit Engagement Id' ;
    rdfs:comment 'Reference to the immediately preceding audit engagement of the same type and scope, enabling year-over-year comparison, trend analysis, and tracking of repeat findings across audit cycles.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditEngagement .

ind:soxControlId rdf:type rdf:Property ;
    rdfs:label 'Sox Control Id' ;
    rdfs:comment 'Foreign key linking to finance.sox_control. Business justification: Internal SOX audit engagements test specific financial controls. Linking audit_engagement to sox_control enables tracking of which control was in scope for each engagement — required for SOX Section 3' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SoxControl .

ind:actualEndDate rdf:type rdf:Property ;
    rdfs:label 'Actual End Date' ;
    rdfs:comment 'Date on which audit fieldwork or inspection actually concluded. Used to calculate actual engagement duration and compare against planned timeline.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualStartDate rdf:type rdf:Property ;
    rdfs:label 'Actual Start Date' ;
    rdfs:comment 'Date on which audit fieldwork or inspection actually commenced. Compared against scheduled_start_date to measure planning accuracy and identify scheduling slippage.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attestationOfComplianceIssued rdf:type rdf:Property ;
    rdfs:label 'Attestation Of Compliance Issued' ;
    rdfs:comment 'Indicates whether a formal Attestation of Compliance (AOC) or equivalent compliance certificate has been issued as an output of this audit engagement. Particularly relevant for PCI-DSS QSA audits and ISO certification audits.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditFirm rdf:type rdf:Property ;
    rdfs:label 'Audit Firm' ;
    rdfs:comment 'Name of the external audit firm, Qualified Security Assessor (QSA) organisation, or internal audit function conducting the engagement (e.g., Deloitte, KPMG, PCI-certified QSA firm). Null for purely internal audits.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditReportReference rdf:type rdf:Property ;
    rdfs:label 'Audit Report Reference' ;
    rdfs:comment 'Document reference number or DAM (Digital Asset Management) identifier for the formal audit report stored in the content management system. Enables retrieval of the full report for regulatory review, legal proceedings, or CAS arbitration.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditSubtype rdf:type rdf:Property ;
    rdfs:label 'Audit Subtype' ;
    rdfs:comment 'Further classification within the audit type (e.g., for PCI-DSS: QSA on-site, SAQ-D self-assessment; for SOX: internal controls over financial reporting, IT general controls; for OSHA: routine inspection, incident-triggered). Provides granular categorisation for analytics and benchmarking.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditType rdf:type rdf:Property ;
    rdfs:label 'Audit Type' ;
    rdfs:comment 'Classification of the audit engagement by governing framework or regulatory program. Determines the applicable standards, scope templates, and reporting obligations. [ENUM-REF-CANDIDATE: PCI_DSS|SOX|OSHA|ADA|GDPR|WADA|ISO_20121|CCPA|internal — promote to reference product]' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditorType rdf:type rdf:Property ;
    rdfs:label 'Auditor Type' ;
    rdfs:comment 'Classification of the auditing party as internal (in-house audit team), external (independent audit firm or QSA), regulatory (government or governing body inspector), or third_party (vendor/partner audit). Affects independence requirements and report distribution.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Critical Findings Count' ;
    rdfs:comment 'Number of audit findings classified as critical or high severity, requiring immediate remediation. Subset of total_findings_count. Drives escalation protocols and executive reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cycleFrequency rdf:type rdf:Property ;
    rdfs:label 'Cycle Frequency' ;
    rdfs:comment 'Recurrence cadence of this audit engagement type as mandated by the governing framework or internal policy (e.g., PCI-DSS QSA annual, OSHA routine quarterly, WADA ad_hoc). Drives scheduling and forward pipeline planning.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPrivacyInScope rdf:type rdf:Property ;
    rdfs:label 'Data Privacy In Scope' ;
    rdfs:comment 'Indicates whether personal data processing activities (fan data, athlete data, employee data) are within the scope of this audit engagement, triggering GDPR/CCPA-specific audit procedures and data protection officer involvement.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:engagementReference rdf:type rdf:Property ;
    rdfs:label 'Engagement Reference' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to the audit engagement at initiation (e.g., AUD-2024-00123). Used in correspondence with auditors, regulators, and management. Aligns with the BUSINESS_IDENTIFIER canonical category for TRANSACTION_HEADER role.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementRiskRating rdf:type rdf:Property ;
    rdfs:label 'Engagement Risk Rating' ;
    rdfs:comment 'Pre-audit risk rating assigned during planning to prioritise audit resources and determine scope depth. Based on inherent risk of the business unit, regulatory exposure, and prior audit history. Aligns with risk-based audit planning methodology.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementStatus rdf:type rdf:Property ;
    rdfs:label 'Engagement Status' ;
    rdfs:comment 'Current lifecycle state of the audit engagement, progressing from scheduled through in_progress to completed. Enables forward-looking pipeline management and historical audit trail reporting. Aligns with LIFECYCLE_STATUS canonical category.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedRemediationCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Remediation Cost' ;
    rdfs:comment 'Estimated financial cost in USD to remediate all open findings identified during the audit engagement. Used for budgeting, EBITDA impact assessment, and prioritisation of remediation investments. Populated post-report issuance.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalDisposition rdf:type rdf:Property ;
    rdfs:label 'Final Disposition' ;
    rdfs:comment 'Ultimate resolution outcome of the audit engagement after all findings have been addressed. Indicates whether the engagement was fully closed with remediation, risk accepted by management, escalated to senior leadership, or referred to a regulatory body.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalAuditOwner rdf:type rdf:Property ;
    rdfs:label 'Internal Audit Owner' ;
    rdfs:comment 'Name or identifier of the internal audit manager or compliance officer responsible for coordinating and owning this audit engagement on behalf of Sports Entertainment. Accountable for scheduling, evidence collection, and management response coordination.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadAuditorName rdf:type rdf:Property ;
    rdfs:label 'Lead Auditor Name' ;
    rdfs:comment 'Full name of the lead auditor responsible for conducting and signing off the audit engagement. May be an internal audit manager or an external QSA/firm representative. Retained for accountability and regulatory record-keeping.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementResponseDueDate rdf:type rdf:Property ;
    rdfs:label 'Management Response Due Date' ;
    rdfs:comment 'Deadline by which management must submit formal responses to audit findings, including remediation plans and corrective action commitments. Tracked for SLA compliance and escalation management.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:managementResponseReceived rdf:type rdf:Property ;
    rdfs:label 'Management Response Received' ;
    rdfs:comment 'Indicates whether management has submitted their formal response to audit findings within the required timeframe. Tracks SLA adherence for the management response process and triggers escalation when overdue.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:openFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Open Findings Count' ;
    rdfs:comment 'Number of audit findings that remain open and unresolved at the time of record update. Tracks remediation progress and supports KPI reporting on compliance posture.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overallOpinion rdf:type rdf:Property ;
    rdfs:label 'Overall Opinion' ;
    rdfs:comment 'The auditor\'s formal overall opinion or conclusion on the subject matter of the audit engagement. For PCI-DSS: compliant/non_compliant; for SOX: unqualified/qualified/adverse/disclaimer; for OSHA/ADA: pass/fail mapped to compliant/non_compliant. Null until report is issued.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentSystemsInScope rdf:type rdf:Property ;
    rdfs:label 'Payment Systems In Scope' ;
    rdfs:comment 'Indicates whether payment card processing systems (POS terminals, e-commerce platforms, ticketing payment flows) are within the scope of this audit, triggering PCI-DSS specific audit procedures and QSA involvement.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatorySubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Submission Date' ;
    rdfs:comment 'Date on which the audit report or compliance attestation was formally submitted to the relevant regulatory authority or governing body. Null when regulatory_submission_required is false or submission is pending.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatorySubmissionRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Submission Required' ;
    rdfs:comment 'Indicates whether the audit report or findings must be formally submitted to a regulatory authority or governing body (e.g., SEC filing for SOX, FCC for broadcast compliance, WADA for anti-doping program results). Drives submission workflow and deadline tracking.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportIssuanceDate rdf:type rdf:Property ;
    rdfs:label 'Report Issuance Date' ;
    rdfs:comment 'Date on which the formal audit report was issued to management and relevant stakeholders. Triggers the management response clock and regulatory submission deadlines.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledEndDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Date' ;
    rdfs:comment 'Planned date on which the audit fieldwork or inspection is scheduled to conclude. Used alongside scheduled_start_date for duration planning and resource scheduling.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledStartDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Date' ;
    rdfs:comment 'Planned date on which the audit fieldwork or inspection is scheduled to commence. Used for forward-looking audit pipeline management and resource allocation. Aligns with BUSINESS_EVENT_TIMESTAMP canonical category (planned dimension).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scopeDescription rdf:type rdf:Property ;
    rdfs:label 'Scope Description' ;
    rdfs:comment 'Narrative description of the audit scope, defining the boundaries of the engagement including systems, processes, locations, time periods, and populations in scope. Documented at planning stage and may be refined during execution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetBusinessUnit rdf:type rdf:Property ;
    rdfs:label 'Target Business Unit' ;
    rdfs:comment 'The organisational business unit, division, or department that is the primary subject of this audit engagement (e.g., Venue Operations, Broadcast & Media Rights, Ticketing, Fan Engagement, Finance). Enables domain-level compliance reporting and resource planning.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Total Findings Count' ;
    rdfs:comment 'Total number of audit findings, observations, or deficiencies identified during the engagement across all severity levels. Provides a headline metric for management reporting and trend analysis.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:wadaProgramInScope rdf:type rdf:Property ;
    rdfs:label 'Wada Program In Scope' ;
    rdfs:comment 'Indicates whether the WADA anti-doping program, including testing pools, whereabouts compliance, and Therapeutic Use Exemption (TUE) administration, is within the scope of this audit engagement.' ;
    rdfs:domain ind:AuditEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditFindingId rdf:type rdf:Property ;
    rdfs:label 'Audit Finding Id' ;
    rdfs:comment 'Unique system-generated identifier for each individual audit finding or observation raised during a compliance audit engagement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditFinding .

ind:assignedOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Audit finding remediation assignment is a core audit management process. Linking findings to the responsible employee enables remediation SLA tracking, overdue escalation, and management reporting — r' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:capComplianceId rdf:type rdf:Property ;
    rdfs:label 'Cap Compliance Id' ;
    rdfs:comment 'Foreign key linking to league.cap_compliance. Business justification: Audit findings frequently identify cap compliance violations (over-cap positions, improper exceptions, luxury tax miscalculations). Linking audit_finding to cap_compliance enables direct traceability ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapCompliance .

ind:investigationId rdf:type rdf:Property ;
    rdfs:label 'Investigation Id' ;
    rdfs:comment 'Foreign key linking to compliance.investigation. Business justification: Critical or repeat audit findings often trigger formal investigations. This is a standard compliance escalation path. audit_finding currently has incident_report_id but no investigation_id. Adding thi' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investigation .

ind:acceptedRiskApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Accepted Risk Approved By' ;
    rdfs:comment 'Name or identifier of the senior executive or risk committee member who formally approved the risk acceptance decision. Required for audit trail integrity under SOX and PCI-DSS.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acceptedRiskExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Accepted Risk Expiry Date' ;
    rdfs:comment 'Date on which the risk acceptance decision expires and must be reviewed and re-approved. Ensures time-bounded risk acceptance in line with PCI-DSS and SOX governance requirements.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:acceptedRiskRationale rdf:type rdf:Property ;
    rdfs:label 'Accepted Risk Rationale' ;
    rdfs:comment 'Documented management rationale for formally accepting the residual risk associated with this finding rather than remediating it. Required when finding_status is \'accepted-risk\'. Must be approved by an authorised risk owner per governance policy.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualRemediationDate rdf:type rdf:Property ;
    rdfs:label 'Actual Remediation Date' ;
    rdfs:comment 'Date on which remediation was actually completed and confirmed by the finding owner. Null if remediation is not yet complete. Used to calculate remediation cycle time and SLA adherence.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:affectedBusinessProcess rdf:type rdf:Property ;
    rdfs:label 'Affected Business Process' ;
    rdfs:comment 'Core business process impacted by the finding (e.g., Ticket Sales and Revenue Management, Fan Engagement, Broadcast Rights Distribution, Venue Operations). Aligns findings to the business process taxonomy for operational risk reporting.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedSystem rdf:type rdf:Property ;
    rdfs:label 'Affected System' ;
    rdfs:comment 'Name of the operational system, application, or platform where the non-conformance was identified (e.g., SAP S/4HANA FI, Ticketmaster, Salesforce CRM, Shopify Plus POS). Enables system-level risk aggregation.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedOwner rdf:type rdf:Property ;
    rdfs:label 'Assigned Owner' ;
    rdfs:comment 'Name or identifier of the individual or team accountable for remediating this finding. Typically a business unit leader or compliance officer responsible for the affected control area.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Audit Period End' ;
    rdfs:comment 'End date of the audit period during which this finding was identified. Together with audit_period_start, defines the scope window for the audit engagement.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Audit Period Start' ;
    rdfs:comment 'Start date of the audit period during which this finding was identified. Enables temporal scoping of findings to specific fiscal or compliance review periods.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditorName rdf:type rdf:Property ;
    rdfs:label 'Auditor Name' ;
    rdfs:comment 'Name of the lead auditor (internal or external) who identified and documented this finding. Required for audit trail accountability and regulatory reporting.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlDomain rdf:type rdf:Property ;
    rdfs:label 'Control Domain' ;
    rdfs:comment 'Functional control area to which the finding belongs (e.g., Access Control, Data Privacy, Financial Reporting, Venue Safety, Anti-Doping, Payment Processing). Enables domain-level aggregation of findings for risk reporting. [ENUM-REF-CANDIDATE: Access Control|Data Privacy|Financial Reporting|Venue Safety|Anti-Doping|Payment Processing|Broadcast Compliance|Athlete Eligibility — promote to reference product]' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlReference rdf:type rdf:Property ;
    rdfs:label 'Control Reference' ;
    rdfs:comment 'Specific control identifier from the applicable regulatory framework or internal control catalogue that was found to be non-conformant (e.g., PCI-DSS Req 8.2.1, SOX ITGC-04, GDPR Art.32). Enables traceability to the control library.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationDate rdf:type rdf:Property ;
    rdfs:label 'Escalation Date' ;
    rdfs:comment 'Date on which the finding was formally escalated to senior management, the audit committee, or a regulatory authority. Null if no escalation has occurred.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escalationRequired rdf:type rdf:Property ;
    rdfs:label 'Escalation Required' ;
    rdfs:comment 'Indicates whether this finding requires escalation to senior management, the audit committee, or a regulatory body due to its severity, regulatory implications, or overdue remediation status.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:findingCategory rdf:type rdf:Property ;
    rdfs:label 'Finding Category' ;
    rdfs:comment 'Severity classification of the finding per standard audit grading: critical (immediate risk/breach), major (significant non-conformance), minor (limited non-conformance), or observation (improvement opportunity with no current non-conformance).' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingReference rdf:type rdf:Property ;
    rdfs:label 'Finding Reference' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to this finding for cross-system tracking and regulatory correspondence (e.g., PCI-2024-F0012). Serves as the business identifier communicated to auditors and regulators.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingStatus rdf:type rdf:Property ;
    rdfs:label 'Finding Status' ;
    rdfs:comment 'Current lifecycle state of the finding: open (identified, not yet actioned), in-remediation (remediation underway), closed (remediation verified complete), or accepted-risk (risk formally accepted by management with documented rationale).' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingTitle rdf:type rdf:Property ;
    rdfs:label 'Finding Title' ;
    rdfs:comment 'Short, human-readable title summarising the nature of the audit finding (e.g., \'Inadequate access control review for POS terminals\'). Used in executive dashboards and regulatory reports.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifiedDate rdf:type rdf:Property ;
    rdfs:label 'Identified Date' ;
    rdfs:comment 'Calendar date on which the finding was formally identified and documented during the audit fieldwork. Represents the principal business event date for this finding.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:managementResponse rdf:type rdf:Property ;
    rdfs:label 'Management Response' ;
    rdfs:comment 'Formal written response from management acknowledging the finding and committing to a remediation approach. Captured as part of the audit report finalisation process and required for SOX and PCI-DSS audit documentation.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonConformanceDescription rdf:type rdf:Property ;
    rdfs:label 'Non Conformance Description' ;
    rdfs:comment 'Detailed narrative describing the specific non-conformance or gap identified during the audit. Includes what was observed, what was expected per the control requirement, and the evidence reviewed.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerDepartment rdf:type rdf:Property ;
    rdfs:label 'Owner Department' ;
    rdfs:comment 'Business department or organisational unit responsible for remediating the finding (e.g., Finance, IT Security, Venue Operations, Fan Engagement). Enables departmental accountability reporting.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorFindingReference rdf:type rdf:Property ;
    rdfs:label 'Prior Finding Reference' ;
    rdfs:comment 'Reference number of the original finding from a prior audit cycle if this is a repeat finding. Enables lineage tracking of recurring control deficiencies across audit periods.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendedRemediation rdf:type rdf:Property ;
    rdfs:label 'Recommended Remediation' ;
    rdfs:comment 'Auditor-recommended corrective or preventive action to address the non-conformance and prevent recurrence. Forms the basis of the remediation plan agreed with the finding owner.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFramework rdf:type rdf:Property ;
    rdfs:label 'Regulatory Framework' ;
    rdfs:comment 'Primary regulatory or governance framework implicated by this finding (e.g., PCI-DSS, SOX, GDPR, CCPA, OSHA, ADA, WADA). Drives reporting obligations and remediation urgency. [ENUM-REF-CANDIDATE: PCI-DSS|SOX|GDPR|CCPA|OSHA|ADA|WADA|ISO-20121|CAS|FCC — promote to reference product]' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Date' ;
    rdfs:comment 'Date on which the mandatory regulatory notification was submitted to the relevant governing body. Null if notification is not required or not yet submitted. Critical for GDPR 72-hour deadline compliance tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Required' ;
    rdfs:comment 'Indicates whether this finding triggers a mandatory notification obligation to a regulatory body (e.g., GDPR data breach notification to supervisory authority, PCI-DSS breach notification to card brands, OSHA incident reporting).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediationPlan rdf:type rdf:Property ;
    rdfs:label 'Remediation Plan' ;
    rdfs:comment 'Management\'s documented plan for addressing the finding, including specific actions, milestones, and resources committed. May differ from the auditor\'s recommendation where management has chosen an alternative approach.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repeatFinding rdf:type rdf:Property ;
    rdfs:label 'Repeat Finding' ;
    rdfs:comment 'Indicates whether this finding is a recurrence of a previously identified finding from a prior audit cycle. Repeat findings signal systemic control failures and trigger escalated remediation requirements under PCI-DSS and SOX.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskImpactDescription rdf:type rdf:Property ;
    rdfs:label 'Risk Impact Description' ;
    rdfs:comment 'Narrative description of the potential business, financial, legal, or reputational impact if this finding is not remediated. Supports risk-based prioritisation and executive reporting.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskRating rdf:type rdf:Property ;
    rdfs:label 'Risk Rating' ;
    rdfs:comment 'Risk-based severity rating assigned to the finding reflecting the potential business impact if not remediated: high (material financial, legal, or reputational exposure), medium (moderate impact), low (limited impact), or informational (no current risk).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCause rdf:type rdf:Property ;
    rdfs:label 'Root Cause' ;
    rdfs:comment 'Documented root cause of the non-conformance as determined through analysis (e.g., process gap, technology failure, training deficiency, policy absence). Supports corrective action planning and recurrence prevention.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCauseCategory rdf:type rdf:Property ;
    rdfs:label 'Root Cause Category' ;
    rdfs:comment 'High-level classification of the root cause to enable trend analysis across findings: process (workflow/procedure gap), technology (system/tool failure), people (training/awareness), policy (missing/inadequate policy), third-party (vendor/partner failure), or environmental (external factor).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetRemediationDate rdf:type rdf:Property ;
    rdfs:label 'Target Remediation Date' ;
    rdfs:comment 'Agreed target date by which the remediation action must be completed and verified. Used for SLA tracking and regulatory deadline management.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verificationDate rdf:type rdf:Property ;
    rdfs:label 'Verification Date' ;
    rdfs:comment 'Date on which the auditor or compliance team independently verified that the remediation action was effectively implemented and the control gap closed. Required for formal finding closure.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verifiedBy rdf:type rdf:Property ;
    rdfs:label 'Verified By' ;
    rdfs:comment 'Name or identifier of the auditor or compliance officer who independently verified the effectiveness of the remediation action and authorised closure of the finding.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadAuditorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Lead Auditor Employee Id' ;
    rdfs:comment 'Reference to the individual assigned as the lead auditor responsible for executing and reporting on this audit engagement.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:priorAuditScheduleId rdf:type rdf:Property ;
    rdfs:label 'Prior Audit Schedule Id' ;
    rdfs:comment 'Self-referencing identifier linking this audit to the immediately preceding audit in the same cycle, enabling year-over-year comparison and tracking of remediation progress from prior findings.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditSchedule .

ind:actualCost rdf:type rdf:Property ;
    rdfs:label 'Actual Cost' ;
    rdfs:comment 'Actual incurred cost for the audit engagement in USD upon completion. Compared against estimated_cost to track compliance budget variance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditCategory rdf:type rdf:Property ;
    rdfs:label 'Audit Category' ;
    rdfs:comment 'Indicates whether the audit is conducted by internal compliance staff, an external independent auditor (e.g., QSA for PCI-DSS), a third-party assessor, or a direct regulatory body inspection.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditCycleFrequency rdf:type rdf:Property ;
    rdfs:label 'Audit Cycle Frequency' ;
    rdfs:comment 'The recurrence cadence at which this type of audit is mandated or scheduled (e.g., annual for PCI-DSS QSA, quarterly for SOX controls testing, ad_hoc for incident-triggered reviews).' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditName rdf:type rdf:Property ;
    rdfs:label 'Audit Name' ;
    rdfs:comment 'Descriptive name of the audit engagement (e.g., \'FY2025 PCI-DSS QSA Annual Assessment\', \'Q2 OSHA Venue Safety Inspection – Allegiant Stadium\').' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditNotes rdf:type rdf:Property ;
    rdfs:label 'Audit Notes' ;
    rdfs:comment 'Free-text field for compliance team annotations, special instructions, auditor communications, or contextual information relevant to the planning and execution of this audit.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Audit Reference Number' ;
    rdfs:comment 'Externally-known unique alphanumeric reference code assigned to this audit engagement, used in correspondence with auditors, regulators, and governing bodies. Format: AUD-YYYY-NNNNNN.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditStatus rdf:type rdf:Property ;
    rdfs:label 'Audit Status' ;
    rdfs:comment 'Current lifecycle state of the audit engagement within the compliance pipeline.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditorCertification rdf:type rdf:Property ;
    rdfs:label 'Auditor Certification' ;
    rdfs:comment 'Professional certification held by the lead auditor relevant to this audit type (e.g., QSA for PCI-DSS, CISA for IT controls, CIA for internal audit, CPA for SOX, ISO Lead Auditor for ISO 20121). [ENUM-REF-CANDIDATE: QSA|CISA|CIA|CPA|CISSP|ISO_LA|none — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditorFirmName rdf:type rdf:Property ;
    rdfs:label 'Auditor Firm Name' ;
    rdfs:comment 'Name of the external audit firm or Qualified Security Assessor (QSA) organization engaged to conduct the audit. Null for internal audits.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictDescription rdf:type rdf:Property ;
    rdfs:label 'Conflict Description' ;
    rdfs:comment 'Narrative description of the identified scheduling conflict, including the conflicting audit reference, event, or resource constraint. Populated only when scheduling_conflict_flag is True.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deferralReason rdf:type rdf:Property ;
    rdfs:label 'Deferral Reason' ;
    rdfs:comment 'Documented justification for deferring or rescheduling this audit from its originally planned date. Required when audit_status is \'deferred\' for governance accountability.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost' ;
    rdfs:comment 'Budgeted cost for the audit engagement in USD, covering external auditor fees, travel, and internal resource allocation. Used for compliance budget planning in Workday Adaptive Planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedDurationDays rdf:type rdf:Property ;
    rdfs:label 'Estimated Duration Days' ;
    rdfs:comment 'Planned number of business days allocated for the audit fieldwork phase, used for resource scheduling and conflict detection in the audit calendar.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsCount rdf:type rdf:Property ;
    rdfs:label 'Findings Count' ;
    rdfs:comment 'Total number of audit findings, observations, or non-conformances identified during the audit engagement. Used for risk trending and remediation workload planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geographicRegion rdf:type rdf:Property ;
    rdfs:label 'Geographic Region' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code representing the primary geographic jurisdiction of the audit, relevant for GDPR (EU), CCPA (USA), and other jurisdiction-specific compliance requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRegulatoryMandated rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Mandated' ;
    rdfs:comment 'Indicates whether this audit is mandated by an external regulatory body or governing authority (True) versus being a voluntary internal compliance initiative (False).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overallAuditResult rdf:type rdf:Property ;
    rdfs:label 'Overall Audit Result' ;
    rdfs:comment 'The high-level outcome of the completed audit engagement indicating whether the organization met compliance requirements, passed with noted exceptions, or failed the assessment.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationDueDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Due Date' ;
    rdfs:comment 'The deadline by which all identified audit findings must be remediated and evidence of corrective action submitted to the compliance team or governing body.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remediationStatus rdf:type rdf:Property ;
    rdfs:label 'Remediation Status' ;
    rdfs:comment 'Current status of corrective action activities addressing findings from this audit. Tracks progress from identification through closure.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportDueDate rdf:type rdf:Property ;
    rdfs:label 'Report Due Date' ;
    rdfs:comment 'The deadline by which the final audit report must be issued to the relevant stakeholders, regulators, or governing bodies.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportIssuedDate rdf:type rdf:Property ;
    rdfs:label 'Report Issued Date' ;
    rdfs:comment 'The actual date on which the final audit report was formally issued and distributed to stakeholders.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:schedulingConflictFlag rdf:type rdf:Property ;
    rdfs:label 'Scheduling Conflict Flag' ;
    rdfs:comment 'Indicates whether this audit has a detected scheduling conflict with another audit, major event, or resource constraint in the compliance calendar. Enables proactive conflict resolution.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scopeType rdf:type rdf:Property ;
    rdfs:label 'Scope Type' ;
    rdfs:comment 'Indicates whether the audit covers the full control environment, a partial subset of controls, a targeted area of concern, or is a follow-up to a prior audit finding.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemInScopeCode rdf:type rdf:Property ;
    rdfs:label 'System In Scope Code' ;
    rdfs:comment 'Reference to the information system or technology platform in scope for this audit (e.g., Ticketmaster POS for PCI-DSS, SAP S/4HANA for SOX). Null if the audit is not system-specific.' ;
    rdfs:domain ind:AuditSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breachNotificationId rdf:type rdf:Property ;
    rdfs:label 'Breach Notification Id' ;
    rdfs:comment 'Unique surrogate identifier for each formal data breach notification record within the compliance domain.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BreachNotification .

ind:dpoEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Dpo Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: GDPR breach notifications must be filed by the Data Protection Officer. Linking breach_notification to the DPO employee enables regulatory accountability tracking and supports the named 72-hour notifi' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:originalNotificationBreachNotificationId rdf:type rdf:Property ;
    rdfs:label 'Original Notification Breach Notification Id' ;
    rdfs:comment 'Reference to the initial breach notification record when this record is a supplementary or amended notification. Null for original notifications.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BreachNotification .

ind:ticketPaymentId rdf:type rdf:Property ;
    rdfs:label 'Ticket Payment Id' ;
    rdfs:comment 'Foreign key linking to ticketing.ticket_payment. Business justification: PCI DSS breach notifications (to card networks, regulators) must identify the specific payment transactions compromised. breach_notification.pci_dss_scope_flag indicates payment system scope; a direct' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TicketPayment .

ind:affectedDataCategories rdf:type rdf:Property ;
    rdfs:label 'Affected Data Categories' ;
    rdfs:comment 'Comma-separated list of personal data categories involved in the breach (e.g., name, email, payment card data, health data, national ID, fan account credentials). Required disclosure per GDPR Article 33(3)(b).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedDataSubjectTypes rdf:type rdf:Property ;
    rdfs:label 'Affected Data Subject Types' ;
    rdfs:comment 'Categories of data subjects affected by the breach (e.g., fans, athletes, employees, sponsors, broadcast subscribers). Informs the scope of data subject notification obligations.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedDataSubjectsCount rdf:type rdf:Property ;
    rdfs:label 'Affected Data Subjects Count' ;
    rdfs:comment 'Estimated or confirmed number of distinct individuals (data subjects) whose personal data was involved in the breach. Distinct from records count as one individual may have multiple records.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedRecordsCount rdf:type rdf:Property ;
    rdfs:label 'Affected Records Count' ;
    rdfs:comment 'Estimated or confirmed number of individual personal data records compromised in the breach. Required for regulatory notification and risk assessment under GDPR Article 33(3)(b).' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedSpecialCategoryFlag rdf:type rdf:Property ;
    rdfs:label 'Affected Special Category Flag' ;
    rdfs:comment 'Indicates whether the breach involves special category personal data as defined under GDPR Article 9 (e.g., health data, biometric data, racial or ethnic origin). Triggers heightened notification obligations.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:affectedSystems rdf:type rdf:Property ;
    rdfs:label 'Affected Systems' ;
    rdfs:comment 'Comma-separated list of operational systems or platforms involved in the breach (e.g., Adobe Experience Platform, Ticketmaster, Salesforce CRM). Supports technical remediation tracking and PCI-DSS audit trail.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityAcknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Authority Acknowledgment Date' ;
    rdfs:comment 'Date on which the supervisory authority formally acknowledged receipt of the breach notification.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorityAcknowledgmentReference rdf:type rdf:Property ;
    rdfs:label 'Authority Acknowledgment Reference' ;
    rdfs:comment 'Reference number or confirmation code issued by the supervisory authority upon receipt of the breach notification. Used for tracking and follow-up correspondence.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityInvestigationReference rdf:type rdf:Property ;
    rdfs:label 'Authority Investigation Reference' ;
    rdfs:comment 'Case or investigation reference number assigned by the supervisory authority if a formal investigation was opened following the breach notification.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachCategory rdf:type rdf:Property ;
    rdfs:label 'Breach Category' ;
    rdfs:comment 'Classification of the breach type per GDPR Article 4(12): confidentiality breach (unauthorised disclosure), integrity breach (unauthorised alteration), availability breach (accidental loss or destruction), or a combination.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachCause rdf:type rdf:Property ;
    rdfs:label 'Breach Cause' ;
    rdfs:comment 'Root cause category of the data breach (e.g., cyber attack, human error, system failure, physical theft). Used for trend analysis and preventive controls reporting. [ENUM-REF-CANDIDATE: cyber_attack|human_error|system_failure|physical_theft|unauthorised_access|third_party|other — promote to reference product]' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachDescription rdf:type rdf:Property ;
    rdfs:label 'Breach Description' ;
    rdfs:comment 'Narrative description of the nature of the personal data breach, including how it occurred, the systems or processes involved, and the circumstances of the incident as reported to the authority.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachDetectedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Breach Detected Timestamp' ;
    rdfs:comment 'Date and time when the organization first became aware of the personal data breach. This is the principal business event timestamp that starts the regulatory notification clock (e.g., GDPR 72-hour window).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataProtectionOfficerContact rdf:type rdf:Property ;
    rdfs:label 'Data Protection Officer Contact' ;
    rdfs:comment 'Contact details (email or phone) of the Data Protection Officer (DPO) for the notifying entity, as required to be disclosed in the notification to the supervisory authority.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataProtectionOfficerName rdf:type rdf:Property ;
    rdfs:label 'Data Protection Officer Name' ;
    rdfs:comment 'Name of the Data Protection Officer (DPO) responsible for overseeing the breach notification process and serving as the point of contact with the supervisory authority.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSubjectNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Data Subject Notification Date' ;
    rdfs:comment 'Date on which affected data subjects were notified of the breach. Required when the breach is likely to result in high risk to individuals under GDPR Article 34.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataSubjectNotificationMethod rdf:type rdf:Property ;
    rdfs:label 'Data Subject Notification Method' ;
    rdfs:comment 'Channel used to notify affected data subjects of the breach (e.g., email, postal mail, in-app notification, public notice). Applicable when risk level is high or critical per GDPR Article 34.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gdpr72hrDeadlineTimestamp rdf:type rdf:Property ;
    rdfs:label 'Gdpr 72hr Deadline Timestamp' ;
    rdfs:comment 'Calculated deadline timestamp representing 72 hours after the breach was detected, as mandated by GDPR Article 33(1) for notification to the supervisory authority without undue delay.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:internalCaseReference rdf:type rdf:Property ;
    rdfs:label 'Internal Case Reference' ;
    rdfs:comment 'Internal legal or compliance case management reference number linking this breach notification to the organisation\'s internal incident and legal case tracking system.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSupplementaryNotification rdf:type rdf:Property ;
    rdfs:label 'Is Supplementary Notification' ;
    rdfs:comment 'Indicates whether this notification is a supplementary or updated submission providing additional information to the authority after an initial notification was filed (GDPR Article 33(4) phased notification).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWithin72hrDeadline rdf:type rdf:Property ;
    rdfs:label 'Is Within 72hr Deadline' ;
    rdfs:comment 'Indicates whether the notification was submitted within the GDPR-mandated 72-hour window from breach detection. True = compliant; False = late notification requiring documented justification.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lateNotificationReason rdf:type rdf:Property ;
    rdfs:label 'Late Notification Reason' ;
    rdfs:comment 'Documented justification for why the notification was submitted after the applicable regulatory deadline (e.g., GDPR 72-hour window). Required by GDPR Article 33(1) when notification is delayed.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:likelyConsequences rdf:type rdf:Property ;
    rdfs:label 'Likely Consequences' ;
    rdfs:comment 'Description of the probable consequences of the personal data breach for affected individuals, such as identity theft, financial loss, reputational damage, or discrimination. Required under GDPR Article 33(3)(c).' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measuresTaken rdf:type rdf:Property ;
    rdfs:label 'Measures Taken' ;
    rdfs:comment 'Description of the technical and organisational measures taken or proposed to address the breach and mitigate its adverse effects, as required under GDPR Article 33(3)(d).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationOutcome rdf:type rdf:Property ;
    rdfs:label 'Notification Outcome' ;
    rdfs:comment 'Final or current outcome of the breach notification as determined by the supervisory authority (e.g., accepted, rejected, investigation opened, further information requested). [ENUM-REF-CANDIDATE: accepted|rejected|under_review|further_info_requested|investigation_opened|closed_no_action — promote to reference product]' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Notification Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to this notification for tracking with supervisory authorities and internal case management (e.g., BN-2024-000123).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationStatus rdf:type rdf:Property ;
    rdfs:label 'Notification Status' ;
    rdfs:comment 'Current lifecycle state of the breach notification record, tracking progress from initial drafting through submission, acknowledgment by the authority, and final closure.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationSubmittedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Submitted Timestamp' ;
    rdfs:comment 'Date and time when the formal breach notification was actually submitted to the supervisory authority or dispatched to affected data subjects.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:notificationType rdf:type rdf:Property ;
    rdfs:label 'Notification Type' ;
    rdfs:comment 'Indicates whether this notification is directed to a supervisory authority (e.g., EU Data Protection Authority), to affected data subjects, or both, as required under applicable privacy regulations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notifiedAuthorityJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Notified Authority Jurisdiction' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction in which the notified supervisory authority operates (e.g., IRL for Ireland, USA for United States, GBR for United Kingdom).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notifiedAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Notified Authority Name' ;
    rdfs:comment 'Full name of the supervisory authority or regulatory body notified of the breach (e.g., Irish Data Protection Commission, California Attorney General, UK ICO).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pciDssScopeFlag rdf:type rdf:Property ;
    rdfs:label 'Pci Dss Scope Flag' ;
    rdfs:comment 'Indicates whether the breach involves systems or data within the Payment Card Industry Data Security Standard (PCI-DSS) cardholder data environment, triggering additional notification obligations to card brands and acquiring banks.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryPenaltyRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Penalty Risk Flag' ;
    rdfs:comment 'Indicates whether the breach notification circumstances present a risk of regulatory fines or sanctions (e.g., GDPR Article 83 administrative fines up to €20M or 4% of global annual turnover).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskLevel rdf:type rdf:Property ;
    rdfs:label 'Risk Level' ;
    rdfs:comment 'Assessed risk level of the breach to the rights and freedoms of affected data subjects. Determines whether data subject notification is required (high/critical) and the urgency of remediation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyProcessorInvolved rdf:type rdf:Property ;
    rdfs:label 'Third Party Processor Involved' ;
    rdfs:comment 'Indicates whether a third-party data processor (e.g., ticketing vendor, broadcast partner, merchandise platform) was involved in or contributed to the breach, affecting controller-processor notification obligations.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thirdPartyProcessorName rdf:type rdf:Property ;
    rdfs:label 'Third Party Processor Name' ;
    rdfs:comment 'Name of the third-party data processor involved in the breach, if applicable. Required for controller accountability and processor notification chain documentation.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Processing Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: GDPR Article 30 records of processing activities require a named responsible owner. Linking data_processing_record to the employee owner enables DPO oversight, DPIA scheduling, and supervisory authori' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assessmentOutcome rdf:type rdf:Property ;
    rdfs:label 'Assessment Outcome' ;
    rdfs:comment 'Final outcome of the DPIA/PIA review process. \'Approved\' indicates processing may proceed; \'Approved with conditions\' requires specific mitigations before go-live; \'Rejected\' prohibits processing; \'Not required\' indicates no formal assessment was needed.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentType rdf:type rdf:Property ;
    rdfs:label 'Assessment Type' ;
    rdfs:comment 'Type of privacy impact assessment conducted for this processing activity. \'dpia\' = Data Protection Impact Assessment (mandatory under GDPR Article 35 for high-risk processing); \'pia\' = Privacy Impact Assessment (broader scope); \'screening\' = pre-DPIA threshold assessment; \'none\' = no assessment required.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ccpaApplicable rdf:type rdf:Property ;
    rdfs:label 'Ccpa Applicable' ;
    rdfs:comment 'Indicates whether this processing activity is subject to the California Consumer Privacy Act (CCPA) / CPRA, applicable to fan data processing for California residents. Triggers additional consumer rights obligations including opt-out of sale.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:controllerProcessorRole rdf:type rdf:Property ;
    rdfs:label 'Controller Processor Role' ;
    rdfs:comment 'Designates whether Sports Entertainment acts as a Data Controller, Data Processor, Joint Controller, or Sub-Processor for this processing activity, as defined under GDPR Article 4. Determines the applicable compliance obligations.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crossBorderTransferFlag rdf:type rdf:Property ;
    rdfs:label 'Cross Border Transfer Flag' ;
    rdfs:comment 'Indicates whether personal data is transferred to a country outside the European Economic Area (EEA) or to an international organisation. Triggers mandatory documentation of transfer mechanisms under GDPR Chapter V.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSubjectCategories rdf:type rdf:Property ;
    rdfs:label 'Data Subject Categories' ;
    rdfs:comment 'Categories of individuals whose personal data is processed (e.g., \'Fans/Ticket Holders\', \'Athletes\', \'Employees\', \'Minors under 16\'). Pipe-delimited list. Mandatory field under GDPR Article 30(1)(c). [ENUM-REF-CANDIDATE: fans|athletes|employees|minors|sponsors|media_partners|venue_staff|contractors — promote to reference product]' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dpiaRequired rdf:type rdf:Property ;
    rdfs:label 'Dpia Required' ;
    rdfs:comment 'Indicates whether a formal Data Protection Impact Assessment (DPIA) is mandatory for this processing activity under GDPR Article 35 (e.g., large-scale processing of special category data, systematic monitoring, biometric identification for ticketing).' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dpoConsultationDate rdf:type rdf:Property ;
    rdfs:label 'Dpo Consultation Date' ;
    rdfs:comment 'Date on which the Data Protection Officer (DPO) was formally consulted regarding this processing activity or DPIA. Provides an audit trail for GDPR Article 35(2) compliance.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dpoConsulted rdf:type rdf:Property ;
    rdfs:label 'Dpo Consulted' ;
    rdfs:comment 'Indicates whether the Data Protection Officer (DPO) was formally consulted during the DPIA/PIA process, as required under GDPR Article 35(2). Mandatory for all high-risk processing activities.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:identifiedRisks rdf:type rdf:Property ;
    rdfs:label 'Identified Risks' ;
    rdfs:comment 'Narrative description of privacy risks identified during the DPIA/PIA assessment (e.g., \'Unauthorised access to fan biometric data\', \'Re-identification of pseudonymised athlete health records\', \'Cross-border transfer of minors\' data without adequate safeguards\').' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:includesSpecialCategoryData rdf:type rdf:Property ;
    rdfs:label 'Includes Special Category Data' ;
    rdfs:comment 'Indicates whether this processing activity involves special category personal data as defined under GDPR Article 9 (e.g., health data, biometric data, racial/ethnic origin). Triggers additional safeguards and explicit consent requirements.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalBasis rdf:type rdf:Property ;
    rdfs:label 'Legal Basis' ;
    rdfs:comment 'The lawful basis under GDPR Article 6 (and Article 9 for special category data) that authorises this processing activity. For example, \'consent\' for fan marketing, \'contract\' for ticketing, \'legal_obligation\' for anti-doping compliance under WADA.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legitimateInterestDescription rdf:type rdf:Property ;
    rdfs:label 'Legitimate Interest Description' ;
    rdfs:comment 'Where legal basis is \'legitimate_interests\', documents the specific legitimate interest pursued and the balancing test outcome. Required to demonstrate compliance with GDPR Article 6(1)(f) and to evidence the three-part test (purpose, necessity, balancing).' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Date' ;
    rdfs:comment 'Scheduled date for the next periodic review of this processing activity record and associated DPIA/PIA. GDPR Article 35(11) requires DPIAs to be reviewed when there is a change in risk. Typically annual for high-risk activities.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pciDssApplicable rdf:type rdf:Property ;
    rdfs:label 'Pci Dss Applicable' ;
    rdfs:comment 'Indicates whether this processing activity involves payment card data and is therefore subject to PCI-DSS requirements. Applicable to ticketing (Ticketmaster/AXS), merchandise (Shopify Plus), and POS transactions at venues.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:personalDataCategories rdf:type rdf:Property ;
    rdfs:label 'Personal Data Categories' ;
    rdfs:comment 'Categories of personal data processed, including special category data under GDPR Article 9 (e.g., \'Fan PII: name, email, purchase history\', \'Athlete health data: injury records, biometrics\', \'Payment data: PCI-DSS card data\', \'Biometric data: facial recognition for ticketing\'). Mandatory under GDPR Article 30(1)(c).' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingActivityName rdf:type rdf:Property ;
    rdfs:label 'Processing Activity Name' ;
    rdfs:comment 'Human-readable name of the personal data processing activity (e.g., \'Biometric Ticketing Enrollment\', \'Fan CRM Profiling\', \'Athlete Health Monitoring\'). Serves as the primary identity label for the record in the RoPA register.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingActivityReference rdf:type rdf:Property ;
    rdfs:label 'Processing Activity Reference' ;
    rdfs:comment 'Externally-known unique reference code assigned to this processing activity in the official RoPA register (e.g., \'RoPA-FAN-20240001\'). Used for cross-referencing in regulatory filings and supervisory authority correspondence.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingEndDate rdf:type rdf:Property ;
    rdfs:label 'Processing End Date' ;
    rdfs:comment 'Date on which this personal data processing activity ceased or is scheduled to cease. Null for ongoing processing activities. Represents the effective-until date for the processing activity\'s lifecycle.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:processingOwner rdf:type rdf:Property ;
    rdfs:label 'Processing Owner' ;
    rdfs:comment 'Business owner responsible for this processing activity (e.g., \'VP Fan Engagement\', \'Head of Athlete Performance\', \'Director of Ticketing Operations\'). Accountable for ensuring ongoing compliance with the documented controls and review schedule.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingPurpose rdf:type rdf:Property ;
    rdfs:label 'Processing Purpose' ;
    rdfs:comment 'Detailed description of the specific purpose(s) for which personal data is processed (e.g., \'Fan personalization and targeted marketing via Adobe Experience Platform\', \'Athlete health monitoring for injury prevention\'). Must be specific and explicit per GDPR Article 5(1)(b) purpose limitation principle.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingStartDate rdf:type rdf:Property ;
    rdfs:label 'Processing Start Date' ;
    rdfs:comment 'Date on which this personal data processing activity commenced or is scheduled to commence. Represents the effective-from date for the processing activity\'s lifecycle.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:processingStatus rdf:type rdf:Property ;
    rdfs:label 'Processing Status' ;
    rdfs:comment 'Current lifecycle state of the processing activity record within the RoPA register. \'Active\' indicates live processing; \'Suspended\' indicates temporarily halted; \'Retired\' indicates decommissioned processing.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordLastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Last Updated Timestamp' ;
    rdfs:comment 'Timestamp when this RoPA/DPIA record was most recently modified. Supports audit trail requirements and change management tracking for GDPR Article 30 register maintenance.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:retentionBasis rdf:type rdf:Property ;
    rdfs:label 'Retention Basis' ;
    rdfs:comment 'Legal or business justification for the defined retention period (e.g., \'SOX 7-year financial record requirement\', \'WADA anti-doping sample retention 10 years\', \'PCI-DSS transaction log 1 year\', \'GDPR consent withdrawal\'). Documents the regulatory driver for the retention schedule.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewFrequency rdf:type rdf:Property ;
    rdfs:label 'Review Frequency' ;
    rdfs:comment 'Scheduled frequency for periodic review of this processing activity record and DPIA/PIA. High-risk activities (e.g., biometric ticketing, athlete health systems) typically require annual or biannual review.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskMitigationMeasures rdf:type rdf:Property ;
    rdfs:label 'Risk Mitigation Measures' ;
    rdfs:comment 'Specific technical and organisational measures implemented or planned to mitigate identified privacy risks (e.g., \'Biometric data encrypted with hardware security module\', \'Athlete health data access restricted to medical staff via SAP SuccessFactors role-based controls\', \'DRM applied to broadcast content containing athlete biometrics\').' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityMeasures rdf:type rdf:Property ;
    rdfs:label 'Security Measures' ;
    rdfs:comment 'Description of technical and organisational measures implemented to protect personal data (e.g., \'AES-256 encryption at rest, TLS 1.3 in transit, role-based access control, PCI-DSS tokenisation for payment data, pseudonymisation of fan analytics data\'). Mandatory under GDPR Article 32 and Article 30(1)(g).' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialCategoryDataType rdf:type rdf:Property ;
    rdfs:label 'Special Category Data Type' ;
    rdfs:comment 'Specific type of special category data processed under GDPR Article 9, where applicable. For Sports Entertainment, common types include \'health\' (athlete injury/medical records), \'biometric\' (facial recognition ticketing), and \'genetic\' (anti-doping testing under WADA). [ENUM-REF-CANDIDATE: health|biometric|genetic|racial_ethnic|religious|political|trade_union|sexual_orientation|criminal_offence|none — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supervisoryAuthorityConsultationDate rdf:type rdf:Property ;
    rdfs:label 'Supervisory Authority Consultation Date' ;
    rdfs:comment 'Date on which the supervisory authority was formally consulted under GDPR Article 36. Null if consultation was not required or has not yet occurred.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supervisoryAuthorityConsultationRequired rdf:type rdf:Property ;
    rdfs:label 'Supervisory Authority Consultation Required' ;
    rdfs:comment 'Indicates whether prior consultation with the relevant supervisory authority (e.g., ICO, CNIL) is required before commencing this processing activity, as mandated by GDPR Article 36 when residual risk remains high after mitigation.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thirdPartyRecipients rdf:type rdf:Property ;
    rdfs:label 'Third Party Recipients' ;
    rdfs:comment 'Names and categories of third parties to whom personal data is disclosed (e.g., \'Ticketmaster/AXS — ticketing processor\', \'Salesforce CRM — fan relationship management\', \'WADA — anti-doping authority\', \'Adobe Experience Platform — fan analytics\'). Mandatory under GDPR Article 30(1)(d).' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferDestinationCountries rdf:type rdf:Property ;
    rdfs:label 'Transfer Destination Countries' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country codes of countries to which personal data is transferred outside the EEA (e.g., \'USA|CAN|AUS\'). Pipe-delimited. Required for GDPR Article 30 RoPA documentation and supervisory authority reporting.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferMechanism rdf:type rdf:Property ;
    rdfs:label 'Transfer Mechanism' ;
    rdfs:comment 'Legal mechanism used to legitimise cross-border personal data transfers where applicable (e.g., \'standard_contractual_clauses\' for transfers to US-based Salesforce CRM or Adobe Experience Platform, \'adequacy_decision\' for transfers to UK post-Brexit). Mandatory under GDPR Article 46.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wadaApplicable rdf:type rdf:Property ;
    rdfs:label 'Wada Applicable' ;
    rdfs:comment 'Indicates whether this processing activity involves athlete anti-doping data subject to WADA Code requirements, including whereabouts data, biological passport data, and anti-doping test results. Triggers specific data sharing obligations with WADA and national anti-doping organisations.' ;
    rdfs:domain ind:DataProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dopingTestId rdf:type rdf:Property ;
    rdfs:label 'Doping Test Id' ;
    rdfs:comment 'Primary key for doping_test' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DopingTest .

ind:competitionEventFixtureId rdf:type rdf:Property ;
    rdfs:label 'Competition Event Fixture Id' ;
    rdfs:comment 'Reference to the sanctioned competition event during which an in-competition test was conducted. Null for out-of-competition tests and whereabouts records.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fixture .

ind:adamsReference rdf:type rdf:Property ;
    rdfs:label 'Adams Reference' ;
    rdfs:comment 'Unique reference number assigned within the WADA Anti-Doping Administration and Management System (ADAMS) for cross-system traceability of the test or whereabouts filing.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bSampleAnalysisRequested rdf:type rdf:Property ;
    rdfs:label 'B Sample Analysis Requested' ;
    rdfs:comment 'Indicates whether the athlete has formally requested analysis of the B-sample to contest an Adverse Analytical Finding (AAF) on the A-sample.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bSampleResultStatus rdf:type rdf:Property ;
    rdfs:label 'B Sample Result Status' ;
    rdfs:comment 'Outcome of the B-sample confirmatory analysis. A confirmed result corroborates the A-sample AAF; a not-confirmed result may lead to case withdrawal.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:casCaseReference rdf:type rdf:Property ;
    rdfs:label 'Cas Case Reference' ;
    rdfs:comment 'Reference number of any Court of Arbitration for Sport (CAS) appeal or arbitration proceeding arising from this doping test result.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chainOfCustodyStatus rdf:type rdf:Property ;
    rdfs:label 'Chain Of Custody Status' ;
    rdfs:comment 'Current integrity status of the sample chain of custody from collection through laboratory receipt. A broken chain may invalidate the test result.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionCountryCode rdf:type rdf:Property ;
    rdfs:label 'Collection Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction where the sample was collected, used for jurisdictional reporting and WADA regional authority assignment.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionDate rdf:type rdf:Property ;
    rdfs:label 'Collection Date' ;
    rdfs:comment 'Calendar date on which the biological sample was collected from the athlete by the Doping Control Officer (DCO). Null for whereabouts-only records.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectionLocation rdf:type rdf:Property ;
    rdfs:label 'Collection Location' ;
    rdfs:comment 'Descriptive name or address of the facility or venue where the sample was collected (e.g., doping control station at stadium, athlete hotel, training facility).' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Collection Timestamp' ;
    rdfs:comment 'Precise date and time at which the biological sample was collected, used for chain-of-custody sequencing and time-sensitive analysis windows.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dcoIdentifier rdf:type rdf:Property ;
    rdfs:label 'Dco Identifier' ;
    rdfs:comment 'Unique identifier of the certified Doping Control Officer (DCO) who conducted the sample collection, used for chain-of-custody accountability and DCO performance auditing.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laboratoryAccreditationNumber rdf:type rdf:Property ;
    rdfs:label 'Laboratory Accreditation Number' ;
    rdfs:comment 'WADA-issued accreditation number of the testing laboratory, confirming its authorization to conduct anti-doping analyses.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laboratoryReference rdf:type rdf:Property ;
    rdfs:label 'Laboratory Reference' ;
    rdfs:comment 'Identifier or name of the WADA-accredited laboratory to which the sample was dispatched for analysis.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:missedFilingCount rdf:type rdf:Property ;
    rdfs:label 'Missed Filing Count' ;
    rdfs:comment 'Cumulative count of missed or incomplete whereabouts filings within the rolling 12-month window. Three strikes within 12 months constitutes an anti-doping rule violation under WADA Code Article 2.4.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:missedTestCount rdf:type rdf:Property ;
    rdfs:label 'Missed Test Count' ;
    rdfs:comment 'Cumulative count of missed doping tests (failure to be present at declared whereabouts location) within the rolling 12-month window, contributing to the Article 2.4 violation threshold.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overnightLocation rdf:type rdf:Property ;
    rdfs:label 'Overnight Location' ;
    rdfs:comment 'Address or description of the athlete\'s regular overnight accommodation as declared in the whereabouts filing, used by DCOs to locate the athlete for unannounced testing.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prohibitedSubstance rdf:type rdf:Property ;
    rdfs:label 'Prohibited Substance' ;
    rdfs:comment 'Name of the prohibited substance or method detected in the sample, as listed on the WADA Prohibited List. Null for negative results or whereabouts records.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prohibitedSubstanceCategory rdf:type rdf:Property ;
    rdfs:label 'Prohibited Substance Category' ;
    rdfs:comment 'WADA Prohibited List category of the detected substance or method (e.g., S1 Anabolic Agents, S2 Peptide Hormones, M1 Blood Manipulation). [ENUM-REF-CANDIDATE: S0|S1|S2|S3|S4|S5|S6|S7|S8|S9|P1|M1|M2|M3 — promote to reference product]' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordType rdf:type rdf:Property ;
    rdfs:label 'Record Type' ;
    rdfs:comment 'Discriminator indicating whether this record represents a physical doping test event or a whereabouts filing submission. Drives which subset of fields are populated.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredTestingPool rdf:type rdf:Property ;
    rdfs:label 'Registered Testing Pool' ;
    rdfs:comment 'Indicates the Registered Testing Pool (RTP) tier to which the athlete belongs at the time of the test or filing, determining the applicable whereabouts and testing obligations.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Result Notification Date' ;
    rdfs:comment 'Date on which the test result was formally communicated to the athlete and relevant Anti-Doping Organization (ADO), triggering any applicable provisional suspension timelines.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sampleCodeA rdf:type rdf:Property ;
    rdfs:label 'Sample Code A' ;
    rdfs:comment 'Unique barcode or identifier assigned to the primary (A) sample container at the point of collection, used for laboratory tracking and chain-of-custody verification.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleCodeB rdf:type rdf:Property ;
    rdfs:label 'Sample Code B' ;
    rdfs:comment 'Unique barcode or identifier assigned to the reserve (B) sample container, retained for confirmatory analysis if the A-sample returns an Adverse Analytical Finding (AAF).' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleType rdf:type rdf:Property ;
    rdfs:label 'Sample Type' ;
    rdfs:comment 'Biological matrix collected during the test. Values include urine, blood, Athlete Biological Passport (ABP) longitudinal blood sample, or dried blood spot. Null for whereabouts-only records.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionEndDate rdf:type rdf:Property ;
    rdfs:label 'Sanction End Date' ;
    rdfs:comment 'Date on which the period of ineligibility or sanction is scheduled to end, after which the athlete may apply for reinstatement of eligibility.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sanctionStartDate rdf:type rdf:Property ;
    rdfs:label 'Sanction Start Date' ;
    rdfs:comment 'Date on which the formal period of ineligibility or sanction commenced, used to calculate eligibility reinstatement dates.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sanctionStatus rdf:type rdf:Property ;
    rdfs:label 'Sanction Status' ;
    rdfs:comment 'Current disciplinary sanction status resulting from this test record. Tracks progression from provisional suspension through formal sanction or appeal outcome.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Test Reference Number' ;
    rdfs:comment 'Externally assigned unique identifier for the doping test event, issued by the Doping Control Officer (DCO) or testing authority at the point of sample collection. Null for whereabouts-only records.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testType rdf:type rdf:Property ;
    rdfs:label 'Test Type' ;
    rdfs:comment 'Classification of the doping test as in-competition (conducted during or around a sanctioned event) or out-of-competition (conducted outside of event periods), per WADA definitions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapeuticUseExemptionGranted rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Use Exemption Granted' ;
    rdfs:comment 'Indicates whether a valid Therapeutic Use Exemption (TUE) was in place for the athlete at the time of the test, which may negate an Adverse Analytical Finding (AAF) for an otherwise prohibited substance.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trainingLocation rdf:type rdf:Property ;
    rdfs:label 'Training Location' ;
    rdfs:comment 'Address or name of the primary training facility declared in the whereabouts filing, including scheduled training hours for the filing period.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:whereaboutsComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Whereabouts Compliance Status' ;
    rdfs:comment 'Compliance classification for the whereabouts filing submission. A missed or incomplete filing may count toward the three-strike threshold for an Article 2.4 anti-doping rule violation.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:whereaboutsSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Whereabouts Submission Date' ;
    rdfs:comment 'Date on which the athlete submitted their whereabouts filing for the applicable quarter. Used to determine compliance with the quarterly submission deadline.' ;
    rdfs:domain ind:DopingTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:therapeuticUseExemptionId rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Use Exemption Id' ;
    rdfs:comment 'Reference identifier of the Therapeutic Use Exemption (TUE) granted to the athlete for the prohibited substance, if applicable. Used to cross-reference the TUE registry and validate the exemption claim.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Exemption .

ind:aSampleResult rdf:type rdf:Property ;
    rdfs:label 'A Sample Result' ;
    rdfs:comment 'Result of the analysis of the A-sample (primary sample) by the WADA-accredited laboratory. An Adverse Analytical Finding (AAF) triggers the ADRV process; an Atypical Finding (ATF) requires further investigation.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bSampleRequestedFlag rdf:type rdf:Property ;
    rdfs:label 'B Sample Requested Flag' ;
    rdfs:comment 'Indicates whether the athlete exercised their right to request analysis of the B-sample (confirmation sample) to verify the A-sample result. True if B-sample analysis was requested.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bSampleResult rdf:type rdf:Property ;
    rdfs:label 'B Sample Result' ;
    rdfs:comment 'Result of the B-sample analysis confirming or refuting the A-sample Adverse Analytical Finding (AAF). Confirmed means the ADRV is substantiated; not_confirmed may lead to case withdrawal. Null if B-sample was not requested.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:banDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Ban Duration Months' ;
    rdfs:comment 'Length of the period of ineligibility (ban) imposed on the athlete, expressed in months. Standard WADA Code sanctions are 12, 24, or 48 months depending on substance category and aggravating/mitigating factors. Zero if no ineligibility was imposed.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:banEndDate rdf:type rdf:Property ;
    rdfs:label 'Ban End Date' ;
    rdfs:comment 'Date on which the period of ineligibility (ban) is scheduled to expire, calculated from ban_start_date plus ban_duration_months. Null if the ban is indefinite or pending final determination.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:banStartDate rdf:type rdf:Property ;
    rdfs:label 'Ban Start Date' ;
    rdfs:comment 'Date on which the period of ineligibility (ban) officially commenced. May be backdated to the date of provisional suspension or sample collection per WADA Code Article 10.11.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:casDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Cas Decision Date' ;
    rdfs:comment 'Date on which the Court of Arbitration for Sport (CAS) issued its final arbitral award on the appeal. Null if CAS proceedings are ongoing or no appeal was filed.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:casOutcome rdf:type rdf:Property ;
    rdfs:label 'Cas Outcome' ;
    rdfs:comment 'Outcome of the Court of Arbitration for Sport (CAS) arbitral award: whether the original sanction was upheld, reduced, increased, overturned, remanded for rehearing, or the appeal was withdrawn. Null if no CAS appeal was filed.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:casReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Cas Reference Number' ;
    rdfs:comment 'Official Court of Arbitration for Sport (CAS) case reference number assigned when the violation decision is appealed to CAS arbitration (e.g., CAS 2023/A/9876). Null if no CAS appeal has been filed.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseNotes rdf:type rdf:Property ;
    rdfs:label 'Case Notes' ;
    rdfs:comment 'Free-text field for compliance officers to record case-specific notes, mitigating or aggravating circumstances, legal observations, or procedural annotations relevant to the Anti-Doping Rule Violation (ADRV) case management.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disqualificationEndDate rdf:type rdf:Property ;
    rdfs:label 'Disqualification End Date' ;
    rdfs:comment 'End date of the period for which competition results are disqualified. Null if disqualification is open-ended or covers all results from the start date forward.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disqualificationStartDate rdf:type rdf:Property ;
    rdfs:label 'Disqualification Start Date' ;
    rdfs:comment 'Start date of the period for which competition results are disqualified. Typically the date of the sample collection or the date of the non-analytical violation.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:governingBodyCode rdf:type rdf:Property ;
    rdfs:label 'Governing Body Code' ;
    rdfs:comment 'Code identifying the sports governing body or anti-doping organisation (ADO) that issued and manages this Anti-Doping Rule Violation (ADRV) case (e.g., FIFA, NFL, WADA, USADA). [ENUM-REF-CANDIDATE: FIFA|IOC|NFL|NBA|MLB|NHL|MLS|WADA|UFC|ATP|ITF|FIBA|IAAF|USADA|UKAD — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hearingBody rdf:type rdf:Property ;
    rdfs:label 'Hearing Body' ;
    rdfs:comment 'Name of the tribunal, panel, or disciplinary body that conducted the hearing (e.g., FIFA Disciplinary Committee, NFL Anti-Doping Program Panel, WADA Independent Hearing Panel).' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inCompetitionFlag rdf:type rdf:Property ;
    rdfs:label 'In Competition Flag' ;
    rdfs:comment 'Indicates whether the sample or violation occurred during an in-competition period (True) or out-of-competition (False). Relevant for determining which prohibited substances apply under the WADA Prohibited List.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laboratoryName rdf:type rdf:Property ;
    rdfs:label 'Laboratory Name' ;
    rdfs:comment 'Name of the WADA-accredited laboratory that performed the analysis of the biological sample and issued the Adverse Analytical Finding (AAF) or Atypical Finding (ATF). Null for non-analytical violations.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationDate rdf:type rdf:Property ;
    rdfs:label 'Notification Date' ;
    rdfs:comment 'Date on which the athlete was formally notified of the Anti-Doping Rule Violation (ADRV) by the anti-doping organisation (ADO) or governing body. Triggers the provisional suspension clock under WADA Code.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:prohibitedMethod rdf:type rdf:Property ;
    rdfs:label 'Prohibited Method' ;
    rdfs:comment 'Description of the prohibited method used (e.g., blood doping, gene doping, manipulation of samples), where the violation involves a prohibited method rather than a substance. Null when not applicable.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:provisionalSuspensionDate rdf:type rdf:Property ;
    rdfs:label 'Provisional Suspension Date' ;
    rdfs:comment 'Date on which the provisional suspension of the athlete took effect, pending the outcome of the hearing process. Null if no provisional suspension was imposed.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicDisclosureDate rdf:type rdf:Property ;
    rdfs:label 'Public Disclosure Date' ;
    rdfs:comment 'Date on which the Anti-Doping Rule Violation (ADRV) and sanction were publicly disclosed on the governing body\'s or WADA\'s official website per mandatory publication requirements. Null if not yet disclosed or exempt from disclosure.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicDisclosureFlag rdf:type rdf:Property ;
    rdfs:label 'Public Disclosure Flag' ;
    rdfs:comment 'Indicates whether the Anti-Doping Rule Violation (ADRV) and sanction have been publicly disclosed per WADA Code Article 14.3 mandatory publication requirements. False if the case involves a minor athlete or is subject to confidentiality provisions.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementEligibilityDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Eligibility Date' ;
    rdfs:comment 'Date from which the athlete is eligible to apply for reinstatement and return to competition following completion of the period of ineligibility and satisfaction of all reinstatement conditions (e.g., whereabouts compliance, return-to-competition testing).' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resultsDisqualifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Results Disqualified Flag' ;
    rdfs:comment 'Indicates whether the athlete\'s competition results from the relevant period have been automatically disqualified as a consequence of the Anti-Doping Rule Violation (ADRV), including forfeiture of medals, points, and prizes.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revisedBanDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Revised Ban Duration Months' ;
    rdfs:comment 'Revised period of ineligibility in months as determined by the appellate body (CAS or other). Populated only when the appeal resulted in a modification of the original sanction. Null if no revision occurred.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sanctionType rdf:type rdf:Property ;
    rdfs:label 'Sanction Type' ;
    rdfs:comment 'Type of sanction imposed following the hearing decision. Ineligibility (ban) is the primary sanction; others include reprimand, disqualification of results, financial fine, warning, or conditional suspension.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapeuticUseExemptionFlag rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Use Exemption Flag' ;
    rdfs:comment 'Indicates whether the athlete held a valid Therapeutic Use Exemption (TUE) for the detected substance at the time of the sample collection. A valid TUE may result in the ADRV charge being withdrawn.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:violationReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Violation Reference Code' ;
    rdfs:comment 'Externally-known unique alphanumeric reference code assigned to this Anti-Doping Rule Violation (ADRV) by the governing body or anti-doping organisation (ADO) for case tracking and correspondence.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wadaAdamsCaseReference rdf:type rdf:Property ;
    rdfs:label 'Wada Adams Case Reference' ;
    rdfs:comment 'Case identifier assigned within the WADA Anti-Doping Administration and Management System (ADAMS), the global platform for managing doping control information. Used for cross-organisational case tracking and mandatory WADA reporting.' ;
    rdfs:domain ind:DopingViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityCertificationId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Certification Id' ;
    rdfs:comment 'Unique surrogate identifier for each eligibility certification or exemption record within the compliance domain. Primary key for this data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EligibilityCertification .

ind:staffPlanId rdf:type rdf:Property ;
    rdfs:label 'Staff Plan Id' ;
    rdfs:comment 'Reference to the venue when the certified or exempt entity is a facility (e.g., ADA accessibility certification, event safety permit). Null when the record pertains to an athlete.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StaffPlan .

ind:adaAccommodationRequirements rdf:type rdf:Property ;
    rdfs:label 'Ada Accommodation Requirements' ;
    rdfs:comment 'Detailed description of specific accessibility accommodations required or certified under ADA Title III for venue certifications or ADA undue hardship exemptions. Includes wheelchair access, assistive listening systems, accessible seating, and service animal provisions. Null for non-ADA certification types.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationDate rdf:type rdf:Property ;
    rdfs:label 'Application Date' ;
    rdfs:comment 'Date on which the certification or exemption application was formally submitted to the issuing authority. Used for SLA tracking, regulatory deadline compliance, and audit trail.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedSubstance rdf:type rdf:Property ;
    rdfs:label 'Approved Substance' ;
    rdfs:comment 'Name of the specific prohibited substance or method for which a Therapeutic Use Exemption (TUE) has been granted under WADA Code Article 4.4. Null for non-TUE certification types. Must reference the WADA Prohibited List substance name.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Broadcast Territory Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country or territory code for which a broadcast territorial exemption applies. Used for FCC content exemptions and RSN blackout rule overrides. Null for non-broadcast exemption types.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbaProvisionReference rdf:type rdf:Property ;
    rdfs:label 'Cba Provision Reference' ;
    rdfs:comment 'Reference to the specific Collective Bargaining Agreement (CBA) article or provision that governs this eligibility certification (e.g., drug testing protocols, medical clearance requirements, grievance procedures). Null when CBA is not applicable.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationStatus rdf:type rdf:Property ;
    rdfs:label 'Certification Status' ;
    rdfs:comment 'Current lifecycle state of the certification or exemption record. Drives competition gating for athletes and operational permit status for venues. \'Pending\' indicates under review; \'Approved\' confirms active compliance; \'Denied\' records rejection; \'Suspended\' indicates temporary hold; \'Revoked\' indicates withdrawal; \'Expired\' indicates lapse past effective period.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationType rdf:type rdf:Property ;
    rdfs:label 'Certification Type' ;
    rdfs:comment 'Specific category of certification or exemption. Examples include: league_eligibility, amateur_status, age_nationality_eligibility, anti_doping_clearance, medical_clearance, ada_venue_accessibility, event_safety, therapeutic_use_exemption (TUE), broadcast_territorial_exemption, ada_undue_hardship, fcc_content_exemption. [ENUM-REF-CANDIDATE: league_eligibility|amateur_status|age_nationality_eligibility|anti_doping_clearance|medical_clearance|ada_venue_accessibility|event_safety|therapeutic_use_exemption|broadcast_territorial_exemption|ada_undue_hardship|fcc_content_exemption — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifiedEntityName rdf:type rdf:Property ;
    rdfs:label 'Certified Entity Name' ;
    rdfs:comment 'Human-readable name of the certified or exempt entity (athlete full name, venue name, event name, or organization name) at the time of certification issuance. Preserved for audit and historical reporting independent of master record changes.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifiedEntityType rdf:type rdf:Property ;
    rdfs:label 'Certified Entity Type' ;
    rdfs:comment 'Classification of the entity to which this certification or exemption applies. Determines which domain FK (athlete_id, venue_id, event_id) is populated and governs applicable regulatory framework.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitionEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Competition Eligibility Flag' ;
    rdfs:comment 'Derived operational flag indicating whether the certified entity is currently cleared for competition or operational use based on the current certification status and effective/expiry dates. True = eligible; False = ineligible. Used as the primary gate in athlete rostering and event participation systems.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceFramework rdf:type rdf:Property ;
    rdfs:label 'Compliance Framework' ;
    rdfs:comment 'Primary regulatory or governance framework under which this certification or exemption is issued. Enables framework-specific reporting, audit scheduling, and policy enforcement. [ENUM-REF-CANDIDATE: WADA|ADA|FCC|GDPR|CCPA|PCI_DSS|OSHA|FIFA|IOC|CBA|SOX|ISO_20121 — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionsRestrictions rdf:type rdf:Property ;
    rdfs:label 'Conditions Restrictions' ;
    rdfs:comment 'Free-text description of any conditions, limitations, or restrictions attached to this certification or exemption (e.g., \'valid only for regular season competition\', \'subject to quarterly medical review\', \'restricted to home venue only\'). Null if unconditional.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRetroactive rdf:type rdf:Property ;
    rdfs:label 'Is Retroactive' ;
    rdfs:comment 'Indicates whether this certification or exemption was granted retroactively (True) or prospectively (False). Particularly relevant for WADA Therapeutic Use Exemptions (TUEs) where retroactive approval is permitted under specific circumstances per WADA Code Article 4.4.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuingAuthorityReference rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority Reference' ;
    rdfs:comment 'Official reference number, case number, or docket identifier assigned by the issuing authority for this certification or exemption (e.g., WADA ADAMS TUE reference ID, CAS case number, FCC docket number). Enables direct cross-referencing with external regulatory systems.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalJustification rdf:type rdf:Property ;
    rdfs:label 'Medical Justification' ;
    rdfs:comment 'Clinical rationale and medical necessity statement supporting a Therapeutic Use Exemption (TUE) or medical clearance certification. Documents the diagnosed condition, treatment necessity, and absence of performance-enhancing effect. Classified confidential due to sensitive health information context at the organizational compliance level.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prohibitedListVersion rdf:type rdf:Property ;
    rdfs:label 'Prohibited List Version' ;
    rdfs:comment 'Version identifier of the WADA Prohibited List in effect at the time of TUE application or anti-doping clearance certification (format: YYYY-MM, e.g., 2024-01). Ensures traceability to the correct annual prohibited substance list. Null for non-anti-doping certification types.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalDueDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Due Date' ;
    rdfs:comment 'Date by which a renewal application must be submitted to maintain continuous certification or exemption coverage. Typically set prior to expiry_date to allow processing time. Null when renewal_required is False.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalRequired rdf:type rdf:Property ;
    rdfs:label 'Renewal Required' ;
    rdfs:comment 'Indicates whether this certification or exemption requires periodic renewal (True) or is granted on a permanent basis (False). Drives automated renewal reminder workflows and compliance calendar scheduling.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewingOfficer rdf:type rdf:Property ;
    rdfs:label 'Reviewing Officer' ;
    rdfs:comment 'Name or identifier of the compliance officer, medical officer, or regulatory representative responsible for reviewing and processing this certification or exemption application within the organization. Used for internal accountability and audit trail.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Reference' ;
    rdfs:comment 'Reference identifier or URL pointing to supporting documentation stored in the DAM or document management system (e.g., medical certificates, physician letters, venue inspection reports, legal opinions). Enables audit trail linkage without embedding documents in the data product.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wadaAdamsTueReference rdf:type rdf:Property ;
    rdfs:label 'Wada Adams Tue Reference' ;
    rdfs:comment 'Unique reference identifier assigned by the WADA Anti-Doping Administration and Management System (ADAMS) for this Therapeutic Use Exemption (TUE) record. Enables direct cross-referencing with WADA\'s global anti-doping database. Null for non-TUE records.' ;
    rdfs:domain ind:EligibilityCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicantAthleteAthleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Applicant Athlete Athlete Profile Id' ;
    rdfs:comment 'Reference to the athlete or individual who submitted the exemption application. Applicable primarily for WADA Therapeutic Use Exemption (TUE) and eligibility-related exemptions.' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:renewalOfExemptionId rdf:type rdf:Property ;
    rdfs:label 'Renewal Of Exemption Id' ;
    rdfs:comment 'Reference to the prior exemption record that this application renews or extends. Null for initial applications. Enables tracking of exemption renewal history and continuity of care.' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Exemption .

ind:adamsTueReference rdf:type rdf:Property ;
    rdfs:label 'Adams Tue Reference' ;
    rdfs:comment 'The official WADA ADAMS system reference number for a Therapeutic Use Exemption (TUE). Populated only for WADA TUE exemption types. Critical for WADA Code Article 4.4 compliance and cross-body verification.' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedSubstanceOrMethod rdf:type rdf:Property ;
    rdfs:label 'Approved Substance Or Method' ;
    rdfs:comment 'The specific prohibited substance, prohibited method, or restricted activity that has been granted exemption. For WADA TUEs, this maps to the WADA Prohibited List substance/method name. For broadcast exemptions, this is the territorial or content restriction being waived.' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitionLevel rdf:type rdf:Property ;
    rdfs:label 'Competition Level' ;
    rdfs:comment 'The level of competition at which the exemption applies. Determines the applicable anti-doping authority and TUE review body (e.g., international-level athletes require WADA-level TUE approval).' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionsAttached rdf:type rdf:Property ;
    rdfs:label 'Conditions Attached' ;
    rdfs:comment 'Any specific conditions, restrictions, or monitoring requirements attached to a conditionally approved exemption (e.g., mandatory periodic medical review, dosage limits, reporting obligations to the governing body).' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionRationale rdf:type rdf:Property ;
    rdfs:label 'Decision Rationale' ;
    rdfs:comment 'Formal written rationale provided by the reviewing authority explaining the basis for approval, conditional approval, or rejection of the exemption application.' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dosageAndRoute rdf:type rdf:Property ;
    rdfs:label 'Dosage And Route' ;
    rdfs:comment 'The specific dosage, frequency, and route of administration (e.g., oral, intravenous, topical) approved under the TUE. Defines the precise scope of the exemption to prevent misuse.' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exemptionStatus rdf:type rdf:Property ;
    rdfs:label 'Exemption Status' ;
    rdfs:comment 'Current lifecycle status of the exemption application. Tracks the workflow from initial submission through review, decision, and expiry. [ENUM-REF-CANDIDATE: pending|approved|conditionally_approved|rejected|withdrawn|expired|revoked|under_appeal — promote to reference product]' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exemptionType rdf:type rdf:Property ;
    rdfs:label 'Exemption Type' ;
    rdfs:comment 'Classification of the exemption category. Values include: wada_tue (WADA Therapeutic Use Exemption for prohibited substance or method), broadcast_territorial (broadcast rights territorial exemption), ada_undue_hardship (ADA undue hardship exemption for venue accessibility), fcc_content (FCC content regulation exemption), cas_procedural (CAS arbitration procedural exemption), other. [ENUM-REF-CANDIDATE: wada_tue|broadcast_territorial|ada_undue_hardship|fcc_content|cas_procedural|league_eligibility|other — promote to reference product]' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEmergencyTue rdf:type rdf:Property ;
    rdfs:label 'Is Emergency Tue' ;
    rdfs:comment 'Indicates whether this TUE was issued under emergency provisions where the athlete required immediate treatment with a prohibited substance and prior approval was not possible.' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionCountry rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the primary jurisdiction under which this exemption is governed and enforced (e.g., USA for ADA/FCC exemptions, CHE for WADA-governed exemptions).' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalDiagnosis rdf:type rdf:Property ;
    rdfs:label 'Medical Diagnosis' ;
    rdfs:comment 'The clinical diagnosis or medical condition justifying the Therapeutic Use Exemption (TUE). Expressed using ICD-10 code or plain clinical description. Applicable only for WADA TUE exemption types. Classified as Protected Health Information (PHI).' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationSentDate rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Date' ;
    rdfs:comment 'The date on which the formal decision notification was sent to the applicant and relevant parties (athlete, team, national anti-doping organization). Required for WADA ISTUE compliance timelines.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:prohibitedListCategory rdf:type rdf:Property ;
    rdfs:label 'Prohibited List Category' ;
    rdfs:comment 'The WADA Prohibited List category code for the substance or method covered by a TUE (e.g., S1=Anabolic Agents, S2=Peptide Hormones, M1=Blood Manipulation). Applicable only for WADA TUE exemption types. [ENUM-REF-CANDIDATE: S0|S1|S2|S3|S4|S5|S6|S7|S8|S9|P1|M1|M2|M3 — promote to reference product]' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Number' ;
    rdfs:comment 'Externally-known unique reference number assigned to this exemption application, used for cross-system tracking and correspondence with governing bodies.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReason rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason' ;
    rdfs:comment 'Specific reason(s) cited by the reviewing authority for rejecting the exemption application. Populated only when exemption_status is \'rejected\'. Used for appeal preparation and compliance audit.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDate rdf:type rdf:Property ;
    rdfs:label 'Review Date' ;
    rdfs:comment 'The date on which the reviewing authority completed its assessment and issued a decision on the exemption application.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewerName rdf:type rdf:Property ;
    rdfs:label 'Reviewer Name' ;
    rdfs:comment 'Name of the individual compliance officer, medical officer, or committee chair who conducted the primary review and issued the exemption decision.' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewingAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Reviewing Authority Name' ;
    rdfs:comment 'Name of the body or committee responsible for reviewing and deciding on the exemption application (e.g., WADA TUE Committee, FIFA Medical Committee, FCC Enforcement Bureau, ADA Compliance Office).' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentCount rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Count' ;
    rdfs:comment 'Number of supporting documents (medical records, physician letters, test results, legal filings) submitted as part of the exemption application package.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:treatingPhysicianLicense rdf:type rdf:Property ;
    rdfs:label 'Treating Physician License' ;
    rdfs:comment 'Medical license or registration number of the treating physician who certified the TUE application. Used to verify physician credentials with the relevant medical board.' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatingPhysicianName rdf:type rdf:Property ;
    rdfs:label 'Treating Physician Name' ;
    rdfs:comment 'Full name of the licensed medical practitioner who provided the medical justification and signed the TUE application on behalf of the athlete.' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validFromDate rdf:type rdf:Property ;
    rdfs:label 'Valid From Date' ;
    rdfs:comment 'The start date from which the approved exemption is effective and the applicant is permitted to use the exempted substance, method, or activity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:validUntilDate rdf:type rdf:Property ;
    rdfs:label 'Valid Until Date' ;
    rdfs:comment 'The expiry date after which the exemption is no longer valid. Null for open-ended exemptions. Critical for eligibility monitoring and WADA Code compliance.' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:wadaRecognitionStatus rdf:type rdf:Property ;
    rdfs:label 'Wada Recognition Status' ;
    rdfs:comment 'Indicates whether WADA has formally recognized this TUE granted by a national anti-doping organization or sport federation. WADA recognition is required for international-level competition eligibility under WADA Code Article 4.4.' ;
    rdfs:domain ind:Exemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalComplianceOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Internal Compliance Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Each governing body relationship (WADA, FCC, league bodies) requires a named internal compliance owner employee for relationship management, filing coordination, and regulatory correspondence. Linking' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:acronym rdf:type rdf:Property ;
    rdfs:label 'Acronym' ;
    rdfs:comment 'Widely recognized abbreviation or acronym for the governing body (e.g., FIFA, WADA, IOC, FCC, SEC, OSHA, PCI SSC).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualMembershipFee rdf:type rdf:Property ;
    rdfs:label 'Annual Membership Fee' ;
    rdfs:comment 'Annual fee or dues payable by Sports Entertainment to this governing body for membership, certification, or regulatory registration (in the denomination of penalty_currency_code).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:antiDopingAuthority rdf:type rdf:Property ;
    rdfs:label 'Anti Doping Authority' ;
    rdfs:comment 'Indicates whether this governing body has anti-doping testing, adjudication, or enforcement authority over Sports Entertainment\'s athletes (e.g., True for WADA, sport-specific anti-doping organizations).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:applicableBusinessDomains rdf:type rdf:Property ;
    rdfs:label 'Applicable Business Domains' ;
    rdfs:comment 'Comma-separated list of Sports Entertainment business domains subject to this governing body\'s authority (e.g., \'Athlete,Broadcast,Fan,Finance\' for GDPR; \'Athlete\' for WADA; \'Broadcast\' for FCC). Drives compliance scope mapping.' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableFramework rdf:type rdf:Property ;
    rdfs:label 'Applicable Framework' ;
    rdfs:comment 'Primary regulatory framework, statute, or standard enforced by this body (e.g., GDPR, CCPA, PCI-DSS, SOX, WADA Code, ADA Title III, ISO 20121, CBA). Used to map compliance obligations to the correct authority.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arbitrationAuthority rdf:type rdf:Property ;
    rdfs:label 'Arbitration Authority' ;
    rdfs:comment 'Indicates whether this body serves as a dispute resolution or arbitration authority for Sports Entertainment\'s legal and regulatory disputes (e.g., True for CAS — Court of Arbitration for Sport).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditCycle rdf:type rdf:Property ;
    rdfs:label 'Audit Cycle' ;
    rdfs:comment 'Frequency at which this governing body conducts or requires compliance audits, inspections, or assessments of Sports Entertainment\'s operations (e.g., annual for SOX/PCI-DSS, event_triggered for WADA testing, continuous for GDPR supervisory monitoring).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bodyType rdf:type rdf:Property ;
    rdfs:label 'Body Type' ;
    rdfs:comment 'Classification of the governing body by its organizational nature: sports_federation (FIFA, IOC, NFL, NBA, MLB, NHL, MLS), regulatory_agency (FCC, SEC, OSHA, ADA), standards_body (PCI SSC, ISO, WADA), arbitration_body (CAS), government_agency, or certification_body.' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastRegulatoryAuthority rdf:type rdf:Property ;
    rdfs:label 'Broadcast Regulatory Authority' ;
    rdfs:comment 'Indicates whether this governing body regulates Sports Entertainment\'s broadcast, OTT streaming, or media rights distribution activities (e.g., True for FCC which governs broadcast licensing and content standards).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataPrivacyAuthority rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Authority' ;
    rdfs:comment 'Indicates whether this governing body is a data protection supervisory authority with jurisdiction over Sports Entertainment\'s fan data processing activities (e.g., True for GDPR supervisory authorities, CCPA enforcement via California AG).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:derecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Derecognition Date' ;
    rdfs:comment 'Date on which Sports Entertainment\'s obligation to or recognition of this governing body ceased. Null if the relationship is still active.' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enforcementAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Enforcement Authority Level' ;
    rdfs:comment 'Indicates the legal enforceability of this body\'s directives on Sports Entertainment: binding (mandatory legal compliance), advisory (recommended best practice), voluntary (opt-in participation), or conditional (binding only under specific circumstances such as event hosting).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingDeadlineMonth rdf:type rdf:Property ;
    rdfs:label 'Filing Deadline Month' ;
    rdfs:comment 'Calendar month (1–12) by which annual regulatory filings, reports, or certifications must be submitted to this governing body (e.g., month 3 for SEC annual 10-K, month 12 for PCI-DSS Report on Compliance).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:foundingYear rdf:type rdf:Property ;
    rdfs:label 'Founding Year' ;
    rdfs:comment 'Calendar year in which the governing body was officially established or chartered (e.g., 1904 for FIFA, 1999 for WADA). Supports historical compliance context and due diligence.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frameworkEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Framework Effective Date' ;
    rdfs:comment 'Date on which the current version of the regulatory framework or standard became effective and binding on Sports Entertainment.' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:frameworkVersion rdf:type rdf:Property ;
    rdfs:label 'Framework Version' ;
    rdfs:comment 'Current version or edition of the regulatory framework, code, or standard enforced by this body that Sports Entertainment is obligated to comply with (e.g., WADA Code 2021, PCI-DSS v4.0, ISO 20121:2012, GDPR 2016/679).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingBodyName rdf:type rdf:Property ;
    rdfs:label 'Governing Body Name' ;
    rdfs:comment 'Full official name of the governing body or regulatory authority (e.g., Fédération Internationale de Football Association, World Anti-Doping Agency).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingBodyStatus rdf:type rdf:Property ;
    rdfs:label 'Governing Body Status' ;
    rdfs:comment 'Current lifecycle status of the governing body record indicating whether Sports Entertainment is actively subject to its authority: active (current compliance obligation), inactive (no current obligation), suspended, dissolved, or under_review.' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hqCity rdf:type rdf:Property ;
    rdfs:label 'Hq City' ;
    rdfs:comment 'City where the governing body\'s principal headquarters is located (e.g., Zurich for FIFA, Montreal for WADA, Lausanne for CAS/IOC, Washington D.C. for FCC).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hqCountry rdf:type rdf:Property ;
    rdfs:label 'Hq Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the country where the governing body\'s principal headquarters is physically located (e.g., CHE for FIFA/WADA/CAS in Switzerland, USA for FCC/SEC/OSHA).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalComplianceOwner rdf:type rdf:Property ;
    rdfs:label 'Internal Compliance Owner' ;
    rdfs:comment 'Name or employee identifier of the Sports Entertainment compliance officer or team lead responsible for managing the relationship and obligations with this governing body.' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalLegalOwner rdf:type rdf:Property ;
    rdfs:label 'Internal Legal Owner' ;
    rdfs:comment 'Name or employee identifier of the Sports Entertainment legal counsel responsible for regulatory correspondence, filings, and dispute management with this governing body.' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionRegion rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Region' ;
    rdfs:comment 'Named geographic region or multi-country jurisdiction where the body\'s authority applies (e.g., European Union for GDPR supervisory authorities, North America for NHL Board of Governors). Complements primary_jurisdiction_country for supra-national bodies.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionScope rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Scope' ;
    rdfs:comment 'Geographic scope of the governing body\'s authority: global (FIFA, IOC, WADA, CAS, PCI SSC), regional (GDPR supervisory authorities), national (FCC, SEC, OSHA, ADA, CCPA), state_provincial, or local.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Audit Date' ;
    rdfs:comment 'Date of the most recently completed compliance audit or assessment conducted by or on behalf of this governing body against Sports Entertainment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastAuditOutcome rdf:type rdf:Property ;
    rdfs:label 'Last Audit Outcome' ;
    rdfs:comment 'Result of the most recently completed compliance audit by this governing body: pass (fully compliant), pass_with_findings (compliant with minor remediation required), fail (non-compliant), in_progress, or not_applicable.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Max Penalty Amount' ;
    rdfs:comment 'Maximum financial penalty (in the currency specified by penalty_currency_code) that this governing body can impose on Sports Entertainment per violation or incident (e.g., GDPR Article 83 up to €20M or 4% of global turnover).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:membershipNumber rdf:type rdf:Property ;
    rdfs:label 'Membership Number' ;
    rdfs:comment 'External membership number, registration code, or license identifier assigned by the governing body to Sports Entertainment (e.g., FIFA club registration number, PCI-DSS merchant ID, FCC license number).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:membershipStatus rdf:type rdf:Property ;
    rdfs:label 'Membership Status' ;
    rdfs:comment 'Sports Entertainment\'s formal membership or affiliation status with this governing body: member (full voting member), associate_member, observer, non_member (subject to regulation but not a member), or applicant.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextAuditDate rdf:type rdf:Property ;
    rdfs:label 'Next Audit Date' ;
    rdfs:comment 'Date of the next scheduled compliance audit, inspection, or assessment by this governing body. Used by the compliance team to prepare documentation and evidence packages.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:officialWebsiteUrl rdf:type rdf:Property ;
    rdfs:label 'Official Website Url' ;
    rdfs:comment 'Official public website URL of the governing body, used for regulatory reference, framework documentation retrieval, and compliance team research.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyAuthority rdf:type rdf:Property ;
    rdfs:label 'Penalty Authority' ;
    rdfs:comment 'Indicates whether this governing body has the authority to impose financial penalties, sanctions, suspensions, or other punitive measures directly on Sports Entertainment or its athletes/operations.' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryContactName rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Name' ;
    rdfs:comment 'Full name of the primary liaison or compliance contact person at the governing body with whom Sports Entertainment\'s compliance team interacts for regulatory matters.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactTitle rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Title' ;
    rdfs:comment 'Official job title of the primary contact at the governing body (e.g., Director of Compliance, Chief Regulatory Officer, Enforcement Counsel).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryJurisdictionCountry rdf:type rdf:Property ;
    rdfs:label 'Primary Jurisdiction Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the primary jurisdiction where the governing body is headquartered or holds primary legal authority (e.g., CHE for Switzerland-based FIFA/WADA/CAS, USA for FCC/SEC/OSHA).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recognitionDate rdf:type rdf:Property ;
    rdfs:label 'Recognition Date' ;
    rdfs:comment 'Date on which Sports Entertainment formally recognized or became subject to this governing body\'s authority, regulations, or standards.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryDomain rdf:type rdf:Property ;
    rdfs:label 'Regulatory Domain' ;
    rdfs:comment 'Primary compliance or regulatory domain this body governs (e.g., anti-doping, data_privacy, broadcast_regulation, financial_reporting, venue_safety, payment_security, sport_governance, labor_relations, accessibility, event_sustainability). [ENUM-REF-CANDIDATE: anti_doping|data_privacy|broadcast_regulation|financial_reporting|venue_safety|payment_security|sport_governance|labor_relations|accessibility|event_sustainability — promote to reference product]' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingObligation rdf:type rdf:Property ;
    rdfs:label 'Reporting Obligation' ;
    rdfs:comment 'Indicates whether Sports Entertainment has a mandatory periodic reporting or filing obligation to this governing body (e.g., True for SEC, SOX, FCC license renewals; False for advisory bodies).' ;
    rdfs:domain ind:GoverningBody ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concessionStandId rdf:type rdf:Property ;
    rdfs:label 'Concession Stand Id' ;
    rdfs:comment 'Foreign key linking to venue.concession_stand. Business justification: Food safety incidents (contamination, health violations) and equipment injuries at concession stands generate compliance incident reports for health authority notification. Linking incident_report to ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConcessionStand .

ind:incidentOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Incident Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Compliance incident ownership is a named business process: the incident owner drives investigation, regulatory notification (GDPR 72hr, OSHA), and corrective action. Linking to employee enables SLA tr' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:affectedPartyCount rdf:type rdf:Property ;
    rdfs:label 'Affected Party Count' ;
    rdfs:comment 'Estimated or confirmed number of individuals or entities affected by the incident. Required for GDPR breach notification to supervisory authority (volume of affected data subjects) and PCI-DSS incident reporting.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedPartyType rdf:type rdf:Property ;
    rdfs:label 'Affected Party Type' ;
    rdfs:comment 'Category of the primary party or parties affected by the incident (e.g., fan/data subject, athlete, employee, sponsor). Drives GDPR data subject notification obligations and WADA athlete notification requirements. [ENUM-REF-CANDIDATE: fan|athlete|employee|sponsor|vendor|broadcast_partner|general_public — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Authority Notification Timestamp' ;
    rdfs:comment 'Date and time when the supervisory authority or regulatory body was formally notified of the incident. Used to verify GDPR 72-hour notification deadline compliance.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:authorityNotified rdf:type rdf:Property ;
    rdfs:label 'Authority Notified' ;
    rdfs:comment 'Name of the supervisory authority or regulatory body formally notified of the incident (e.g., ICO, CNIL, FTC, OSHA, FCC, WADA). Supports breach notification tracking.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Closure Timestamp' ;
    rdfs:comment 'Date and time when the incident was formally closed following completion of all remediation actions, regulatory notifications, and corrective measures.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:correctiveActions rdf:type rdf:Property ;
    rdfs:label 'Corrective Actions' ;
    rdfs:comment 'Description of the corrective and preventive actions planned or implemented to address the root cause and prevent recurrence. Required for regulatory closure and audit evidence.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSubjectNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Data Subject Notification Timestamp' ;
    rdfs:comment 'Date and time when affected data subjects were notified of the personal data breach. Required for GDPR Article 34 compliance tracking and CCPA breach notification records.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataSubjectNotified rdf:type rdf:Property ;
    rdfs:label 'Data Subject Notified' ;
    rdfs:comment 'Indicates whether affected data subjects (fans, athletes, employees) were individually notified of the personal data breach as required under GDPR Article 34 or CCPA. Applicable only to personal data breach incidents.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detection Timestamp' ;
    rdfs:comment 'Date and time when the incident was first detected or became known to the organisation. Critical for calculating GDPR 72-hour supervisory authority notification deadline and other regulatory clock-start obligations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:estimatedFinancialImpact rdf:type rdf:Property ;
    rdfs:label 'Estimated Financial Impact' ;
    rdfs:comment 'Estimated financial impact of the incident in the organisation\'s reporting currency, including potential regulatory fines, remediation costs, and business disruption losses. Used for risk quantification and EBITDA impact assessment.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gdpr72hrDeadlineMet rdf:type rdf:Property ;
    rdfs:label 'Gdpr 72hr Deadline Met' ;
    rdfs:comment 'Indicates whether the supervisory authority was notified within the 72-hour deadline required by GDPR Article 33(1) from the moment the controller became aware of the personal data breach. Null for non-GDPR incidents.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:immediateResponseActions rdf:type rdf:Property ;
    rdfs:label 'Immediate Response Actions' ;
    rdfs:comment 'Description of the immediate containment and response actions taken upon detection of the incident (e.g., system isolation, access revocation, sample collection for anti-doping). Supports GDPR Article 33 notification and WADA reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentOwner rdf:type rdf:Property ;
    rdfs:label 'Incident Owner' ;
    rdfs:comment 'Name or identifier of the compliance officer or team member assigned as the primary owner responsible for managing the incident through to closure.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Incident Reference Number' ;
    rdfs:comment 'Externally-visible, human-readable reference number assigned to the incident at creation (e.g., INC-2024-000123). Used in all regulatory correspondence, breach notifications, and audit trails.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentStatus rdf:type rdf:Property ;
    rdfs:label 'Incident Status' ;
    rdfs:comment 'Current lifecycle state of the incident report from initial detection through closure. Drives workflow routing and SLA monitoring.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentTitle rdf:type rdf:Property ;
    rdfs:label 'Incident Title' ;
    rdfs:comment 'Short, descriptive title summarising the nature of the incident for use in dashboards, reports, and regulatory correspondence.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentType rdf:type rdf:Property ;
    rdfs:label 'Incident Type' ;
    rdfs:comment 'High-level classification of the incident category. Drives the applicable regulatory framework, notification obligations, and workflow routing. [ENUM-REF-CANDIDATE: personal_data_breach|anti_doping_violation|workplace_safety|venue_safety|broadcast_content_violation|regulatory_breach|pci_security_breach|accessibility_violation — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRepeatIncident rdf:type rdf:Property ;
    rdfs:label 'Is Repeat Incident' ;
    rdfs:comment 'Indicates whether this incident is a recurrence of a previously reported incident type at the same location or involving the same system or process. Flags systemic compliance failures for escalated regulatory scrutiny.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueOrSport rdf:type rdf:Property ;
    rdfs:label 'League Or Sport' ;
    rdfs:comment 'Name of the professional league or sport associated with the incident (e.g., NFL, NBA, MLB, NHL, MLS, FIFA). Supports league-specific governance reporting and CBA compliance tracking.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationName rdf:type rdf:Property ;
    rdfs:label 'Location Name' ;
    rdfs:comment 'Name of the venue, facility, broadcast site, or digital platform where the incident occurred (e.g., stadium name, broadcast control room, OTT platform). Supports venue operations and OSHA reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occurrenceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Occurrence Timestamp' ;
    rdfs:comment 'Date and time when the incident actually occurred or is estimated to have begun, which may precede the detection timestamp. Used for root cause analysis and regulatory reporting.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:oshaRecordable rdf:type rdf:Property ;
    rdfs:label 'Osha Recordable' ;
    rdfs:comment 'Indicates whether the workplace or venue safety incident meets OSHA recordability criteria under 29 CFR 1904 (work-related injury or illness requiring medical treatment beyond first aid). Applicable to OSHA incident types.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oshaReportNumber rdf:type rdf:Property ;
    rdfs:label 'Osha Report Number' ;
    rdfs:comment 'Official OSHA report or case number assigned when a workplace incident is formally reported to OSHA. Required for OSHA 300 Log and 301 Incident Report compliance.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedIncidentReference rdf:type rdf:Property ;
    rdfs:label 'Related Incident Reference' ;
    rdfs:comment 'Reference number of a previously reported incident that this incident is related to or is a recurrence of. Enables linkage of related incidents for trend analysis and systemic risk identification.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedBy rdf:type rdf:Property ;
    rdfs:label 'Reported By' ;
    rdfs:comment 'Name or identifier of the individual, team, or system that first reported or raised the incident. May be an employee, automated monitoring system, or external party.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wadaSubstanceOrMethod rdf:type rdf:Property ;
    rdfs:label 'Wada Substance Or Method' ;
    rdfs:comment 'Name of the prohibited substance or method identified in an anti-doping violation, as listed on the WADA Prohibited List. Applicable only to anti-doping incident types.' ;
    rdfs:domain ind:IncidentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licensePermitId rdf:type rdf:Property ;
    rdfs:label 'License Permit Id' ;
    rdfs:comment 'Unique surrogate identifier for each license or permit record in the operational register. Primary key for the license_permit data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LicensePermit .

ind:calendarId rdf:type rdf:Property ;
    rdfs:label 'Calendar Id' ;
    rdfs:comment 'Reference to the specific event associated with this permit, where the license is event-scoped rather than venue-scoped (e.g., one-time event permit, pyrotechnics permit for a specific show).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Calendar .

ind:complianceOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Compliance Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: License and permit management requires a named employee owner responsible for renewal tracking, inspection scheduling, and regulatory compliance. Sports-entertainment operations hold broadcast license' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:applicationReference rdf:type rdf:Property ;
    rdfs:label 'Application Reference' ;
    rdfs:comment 'The reference number assigned by the issuing authority to the original application or renewal application for this license or permit. Used for correspondence and status tracking with the authority.' ;
    rdfs:domain ind:LicensePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:associatedBroadcastStation rdf:type rdf:Property ;
    rdfs:label 'Associated Broadcast Station' ;
    rdfs:comment 'FCC-assigned call sign or broadcast station identifier associated with this license, applicable for FCC broadcast licenses and RSN (Regional Sports Network) operating licenses.' ;
    rdfs:domain ind:LicensePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceConditions rdf:type rdf:Property ;
    rdfs:label 'Compliance Conditions' ;
    rdfs:comment 'Free-text description of specific conditions, restrictions, or obligations attached to this license or permit by the issuing authority (e.g., capacity limits, operating hours, noise restrictions, ADA accessibility requirements).' ;
    rdfs:domain ind:LicensePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentUrl rdf:type rdf:Property ;
    rdfs:label 'Document Url' ;
    rdfs:comment 'URL or path to the digital copy of the license or permit certificate stored in the document management system (e.g., DAM or SharePoint). Enables direct access to the official license document.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isConditional rdf:type rdf:Property ;
    rdfs:label 'Is Conditional' ;
    rdfs:comment 'Indicates whether this license or permit has been issued with specific conditions or restrictions that must be met for it to remain valid. True if conditions apply; False if unconditional.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTransferable rdf:type rdf:Property ;
    rdfs:label 'Is Transferable' ;
    rdfs:comment 'Indicates whether this license or permit can be transferred to another legal entity or venue. Relevant for M&A activity, venue sales, and franchise transfers.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issueDate rdf:type rdf:Property ;
    rdfs:label 'Issue Date' ;
    rdfs:comment 'The date on which the issuing authority formally granted and issued this license or permit. Marks the start of the license\'s binding effective period.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:issuingAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority Name' ;
    rdfs:comment 'Full legal name of the government agency, regulatory body, or authority that issued this license or permit (e.g., \'Federal Communications Commission\', \'California Department of Alcoholic Beverage Control\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionCity rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction City' ;
    rdfs:comment 'City or municipality within which this license or permit is valid, particularly relevant for local operating licenses, event permits, and noise variances.' ;
    rdfs:domain ind:LicensePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseCategory rdf:type rdf:Property ;
    rdfs:label 'License Category' ;
    rdfs:comment 'Broad grouping of the license or permit by compliance domain, enabling portfolio-level reporting across regulatory, operational, safety, environmental, media, and entertainment categories.' ;
    rdfs:domain ind:LicensePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseFeeAmount rdf:type rdf:Property ;
    rdfs:label 'License Fee Amount' ;
    rdfs:comment 'The monetary fee paid to the issuing authority for the issuance or renewal of this license or permit. Used for budget planning and cost allocation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:licenseHolderName rdf:type rdf:Property ;
    rdfs:label 'License Holder Name' ;
    rdfs:comment 'Name of the individual or designated officer listed as the license holder on the permit, where the issuing authority requires a named responsible person (e.g., liquor license responsible manager).' ;
    rdfs:domain ind:LicensePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseName rdf:type rdf:Property ;
    rdfs:label 'License Name' ;
    rdfs:comment 'Human-readable descriptive name of the license or permit as defined by the issuing authority or internal compliance team (e.g., \'State Liquor License – Arena Operations\', \'FCC Broadcast Station License\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseNumber rdf:type rdf:Property ;
    rdfs:label 'License Number' ;
    rdfs:comment 'The externally-assigned unique identifier issued by the licensing authority for this license or permit. Used for regulatory correspondence, audits, and renewal tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseStatus rdf:type rdf:Property ;
    rdfs:label 'License Status' ;
    rdfs:comment 'Current lifecycle state of the license or permit. Drives compliance alerts, renewal workflows, and operational hold decisions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseType rdf:type rdf:Property ;
    rdfs:label 'License Type' ;
    rdfs:comment 'Classification of the license or permit by operational category. [ENUM-REF-CANDIDATE: venue_operating|broadcast|liquor|event_permit|gaming|pyrotechnics|fcc_broadcast|music_performance|food_service|health_safety|building|fire_safety|noise_variance — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Next Inspection Date' ;
    rdfs:comment 'Date of the next scheduled inspection or compliance review by the issuing authority. Used for operational planning and pre-inspection readiness activities.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:penaltyRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Penalty Risk Flag' ;
    rdfs:comment 'Indicates whether this license or permit is currently at risk of penalty, suspension, or revocation due to non-compliance, late renewal, or breach of conditions. Triggers escalation workflows.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalLeadDays rdf:type rdf:Property ;
    rdfs:label 'Renewal Lead Days' ;
    rdfs:comment 'Number of calendar days before the expiry date that the renewal process must be initiated. Drives automated compliance alerts and workflow triggers.' ;
    rdfs:domain ind:LicensePermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalStatus rdf:type rdf:Property ;
    rdfs:label 'Renewal Status' ;
    rdfs:comment 'Current status of the renewal process for this license or permit. Tracks whether a renewal application has been initiated, submitted, approved, or is overdue.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Submission Date' ;
    rdfs:comment 'The date on which the renewal application was formally submitted to the issuing authority. Used to track SLA compliance with renewal lead-time requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:obligationId rdf:type rdf:Property ;
    rdfs:label 'Obligation Id' ;
    rdfs:comment 'Primary key for obligation' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Obligation .

ind:obligationGoverningBodyId rdf:type rdf:Property ;
    rdfs:label 'Obligation Governing Body Id' ;
    rdfs:comment 'The official identifier or article/section reference assigned by the governing body to this obligation (e.g., GDPR Article 17, WADA Code Article 2.1, PCI-DSS Requirement 6.3). Enables precise cross-referencing with official regulatory documentation.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GoverningBody .

ind:obligationGoverningBodyReferenceGoverningBodyId rdf:type rdf:Property ;
    rdfs:label 'Obligation Governing Body Reference Governing Body Id' ;
    rdfs:comment 'FK to compliance.governing_body' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GoverningBody .

ind:applicabilityScope rdf:type rdf:Property ;
    rdfs:label 'Applicability Scope' ;
    rdfs:comment 'The operational scope within Sports Entertainment to which this obligation applies (e.g., global for GDPR, athlete for WADA anti-doping, venue for ADA accessibility, broadcast for FCC regulations, digital for CCPA). Determines which business units and systems are in scope. [ENUM-REF-CANDIDATE: global|regional|national|league|venue|event|athlete|broadcast|digital — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceCategory rdf:type rdf:Property ;
    rdfs:label 'Compliance Category' ;
    rdfs:comment 'High-level thematic category grouping obligations by compliance domain (e.g., data-privacy for GDPR/CCPA, anti-doping for WADA, payment-security for PCI-DSS, accessibility for ADA, financial-reporting for SOX). Enables portfolio-level compliance reporting. [ENUM-REF-CANDIDATE: data-privacy|anti-doping|payment-security|accessibility|financial-reporting|workplace-safety|broadcast-regulation|athlete-eligibility|arbitration|licensing|event-safety — promote to reference product]' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlFrameworkMapping rdf:type rdf:Property ;
    rdfs:label 'Control Framework Mapping' ;
    rdfs:comment 'Reference to the internal or industry control framework control identifier that addresses this obligation (e.g., ISO 27001 control A.18.1, NIST CSF PR.DS-1, COSO control activity). Enables integrated compliance and risk management reporting.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementConsequence rdf:type rdf:Property ;
    rdfs:label 'Enforcement Consequence' ;
    rdfs:comment 'Description of the regulatory, legal, or financial consequences of non-compliance with this obligation (e.g., \'GDPR fine up to 4% of global annual turnover\', \'WADA athlete suspension up to 4 years\', \'PCI-DSS card processing suspension\'). Critical for risk prioritization.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationThresholdDays rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold Days' ;
    rdfs:comment 'Number of days before the next_review_date or reporting deadline at which an automated escalation alert is triggered to senior compliance leadership. Ensures timely intervention before regulatory deadlines are missed.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evidenceRequired rdf:type rdf:Property ;
    rdfs:label 'Evidence Required' ;
    rdfs:comment 'Indicates whether formal documentary evidence (audit logs, test results, certifications, filings) must be collected and retained to demonstrate compliance with this obligation. Drives evidence management workflows in the compliance program.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evidenceRetentionYears rdf:type rdf:Property ;
    rdfs:label 'Evidence Retention Years' ;
    rdfs:comment 'Number of years that compliance evidence and documentation for this obligation must be retained per regulatory or legal requirements. Drives records management policies and data lifecycle governance.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isMandatory rdf:type rdf:Property ;
    rdfs:label 'Is Mandatory' ;
    rdfs:comment 'Indicates whether this obligation is legally or contractually mandatory (True) versus voluntary or best-practice (False). Mandatory obligations trigger formal compliance tracking, audit evidence collection, and regulatory reporting workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:linkedPolicyReference rdf:type rdf:Property ;
    rdfs:label 'Linked Policy Reference' ;
    rdfs:comment 'Internal policy document identifier or title that operationalizes this compliance obligation within Sports Entertainment (e.g., \'POL-PRIV-001 Data Privacy Policy\', \'POL-WADA-003 Anti-Doping Program Policy\'). Links the external obligation to internal governance documentation.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationCode rdf:type rdf:Property ;
    rdfs:label 'Obligation Code' ;
    rdfs:comment 'Externally-known, human-readable unique code assigned to this compliance obligation (e.g., OBL-GDPR-20240001). Used as the business identifier across regulatory filings, audit reports, and cross-system references.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationDescription rdf:type rdf:Property ;
    rdfs:label 'Obligation Description' ;
    rdfs:comment 'Detailed narrative describing the full scope, requirements, and expectations of the compliance obligation as imposed by the governing body or regulation. Provides context for compliance officers and legal counsel.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationStatus rdf:type rdf:Property ;
    rdfs:label 'Obligation Status' ;
    rdfs:comment 'Current lifecycle state of the compliance obligation within the organization\'s compliance program. Active obligations are currently enforceable; expired obligations have passed their end date; waived obligations have been formally exempted by the governing body.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationType rdf:type rdf:Property ;
    rdfs:label 'Obligation Type' ;
    rdfs:comment 'Categorical classification of the obligation by its nature of required action (e.g., reporting, testing, audit, certification, training, disclosure, filing, monitoring). Drives workflow routing and task assignment. [ENUM-REF-CANDIDATE: reporting|testing|audit|certification|training|disclosure|filing|monitoring|policy-enforcement|eligibility-review — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyMaxAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Max Amount' ;
    rdfs:comment 'Maximum monetary penalty that can be imposed for non-compliance with this obligation, expressed in the currency specified by penalty_currency_code. Used for risk quantification, insurance coverage assessment, and executive risk reporting.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryArticleReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Article Reference' ;
    rdfs:comment 'Specific article, section, clause, or requirement number within the regulatory framework that mandates this obligation (e.g., \'GDPR Article 17 - Right to Erasure\', \'PCI-DSS Requirement 3.4\', \'WADA Code Article 2.1\'). Enables precise legal cross-referencing.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingDeadlineDay rdf:type rdf:Property ;
    rdfs:label 'Reporting Deadline Day' ;
    rdfs:comment 'Day of the month (1-31) by which periodic compliance reports or filings must be submitted to the governing body. Combined with reporting_deadline_month to define the annual filing deadline for obligations with fixed calendar deadlines.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingDeadlineMonth rdf:type rdf:Property ;
    rdfs:label 'Reporting Deadline Month' ;
    rdfs:comment 'Month of the year (1-12) by which periodic compliance reports or filings must be submitted to the governing body. Combined with reporting_deadline_day to define the annual filing deadline.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responsibleBusinessUnit rdf:type rdf:Property ;
    rdfs:label 'Responsible Business Unit' ;
    rdfs:comment 'The internal business unit, department, or division that is the primary owner accountable for fulfilling this compliance obligation (e.g., Legal, Finance, IT Security, Athlete Management, Venue Operations). Drives accountability assignment and escalation paths.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyInvolved rdf:type rdf:Property ;
    rdfs:label 'Third Party Involved' ;
    rdfs:comment 'Indicates whether fulfillment of this obligation involves or requires oversight of a third-party vendor, partner, or service provider (True). Triggers third-party risk management workflows and vendor compliance assessment requirements.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thirdPartyName rdf:type rdf:Property ;
    rdfs:label 'Third Party Name' ;
    rdfs:comment 'Name of the primary third-party vendor, partner, or service provider involved in fulfilling this obligation (e.g., WADA-accredited testing laboratory, PCI-DSS Qualified Security Assessor, GDPR data processor). Populated only when third_party_involved is True.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentLeadEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assessment Lead Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Privacy Impact Assessments require a named employee lead for GDPR compliance. Linking pia_assessment to the assessment lead employee enables DPO review scheduling, accountability tracking, and supervi' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:priorAssessmentPiaAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Prior Assessment Pia Assessment Id' ;
    rdfs:comment 'Reference to the previous version of this PIA/DPIA assessment, enabling version lineage tracking when an assessment is updated or re-conducted following a material change to the processing activity.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PiaAssessment .

ind:assessmentLead rdf:type rdf:Property ;
    rdfs:label 'Assessment Lead' ;
    rdfs:comment 'Name or employee identifier of the individual responsible for conducting and coordinating the PIA/DPIA assessment, typically the Privacy Officer, Legal Counsel, or designated compliance team member.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Assessment Reference Number' ;
    rdfs:comment 'Externally-known business identifier for the assessment, used in regulatory correspondence, DPO filings, and supervisory authority submissions. Format: PIA-YYYY-NNNNN.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Start Date' ;
    rdfs:comment 'Date on which the formal PIA/DPIA assessment process was initiated. Used to track assessment duration and compliance with pre-processing assessment requirements.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assessment Status' ;
    rdfs:comment 'Current lifecycle state of the PIA/DPIA record, tracking progression from initial drafting through DPO consultation, supervisory authority consultation if required, final approval or rejection, and archival. [ENUM-REF-CANDIDATE: draft|in_review|dpo_consultation|authority_consultation|approved|rejected|archived — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataCategories rdf:type rdf:Property ;
    rdfs:label 'Data Categories' ;
    rdfs:comment 'Comma-separated list of personal data categories involved in the processing activity, e.g., biometric data, health data, financial data, location data, fan behavioral data, athlete performance data. Informs risk classification.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRetentionPeriod rdf:type rdf:Property ;
    rdfs:label 'Data Retention Period' ;
    rdfs:comment 'Defined retention period for personal data processed under this activity, e.g., \'2 years post-event\', \'7 years for financial records\'. Must be justified as part of necessity and proportionality assessment under GDPR Article 5(1)(e).' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataVolumeEstimate rdf:type rdf:Property ;
    rdfs:label 'Data Volume Estimate' ;
    rdfs:comment 'Estimated number of data subjects or records affected by the processing activity, e.g., \'50,000 fans per event\', \'500 athletes globally\'. Large-scale processing is a key trigger for mandatory DPIA under GDPR Article 35(3)(b).' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dpoAdvice rdf:type rdf:Property ;
    rdfs:label 'Dpo Advice' ;
    rdfs:comment 'Summary of the DPO\'s formal advice and recommendations provided during consultation, including any conditions or additional safeguards recommended. Must be documented per GDPR Article 35(2).' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dpoConsultationRequired rdf:type rdf:Property ;
    rdfs:label 'Dpo Consultation Required' ;
    rdfs:comment 'Indicates whether formal consultation with the Data Protection Officer (DPO) is required for this assessment based on risk level and processing nature. Mandatory for high-risk processing under GDPR Article 35(2).' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:involvesCrossBorderTransfer rdf:type rdf:Property ;
    rdfs:label 'Involves Cross Border Transfer' ;
    rdfs:comment 'Indicates whether the processing activity involves transfer of personal data to third countries outside the EEA. Triggers Transfer Impact Assessment (TIA) requirements under GDPR Chapter V.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:involvesMinors rdf:type rdf:Property ;
    rdfs:label 'Involves Minors' ;
    rdfs:comment 'Indicates whether the processing activity involves personal data of minors (under 16 in EU, under 13 under COPPA). Triggers additional safeguards and parental consent requirements.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:involvesSpecialCategoryData rdf:type rdf:Property ;
    rdfs:label 'Involves Special Category Data' ;
    rdfs:comment 'Indicates whether the processing activity involves special category personal data as defined under GDPR Article 9, including biometric data, health data, or genetic data. Triggers mandatory DPIA requirement.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lawfulBasis rdf:type rdf:Property ;
    rdfs:label 'Lawful Basis' ;
    rdfs:comment 'The GDPR Article 6 lawful basis under which the processing activity is conducted. For special category data (e.g., athlete health, biometrics), an Article 9 condition must also be documented in the assessment narrative.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationMeasures rdf:type rdf:Property ;
    rdfs:label 'Mitigation Measures' ;
    rdfs:comment 'Description of technical and organizational measures proposed or implemented to address identified risks, such as pseudonymization, encryption, access controls, data minimization, consent management, and DRM policies. Required under GDPR Article 35(7)(d).' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:necessityProportionalityAssessment rdf:type rdf:Property ;
    rdfs:label 'Necessity Proportionality Assessment' ;
    rdfs:comment 'Documented evaluation of whether the processing is necessary and proportionate to the stated purpose, as required by GDPR Article 35(7)(b). Includes data minimization analysis and retention justification.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcomeConditions rdf:type rdf:Property ;
    rdfs:label 'Outcome Conditions' ;
    rdfs:comment 'Specific conditions, restrictions, or additional safeguards that must be implemented before or during processing when the assessment outcome is \'approved_with_conditions\'. Includes implementation deadlines.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingActivityDescription rdf:type rdf:Property ;
    rdfs:label 'Processing Activity Description' ;
    rdfs:comment 'Detailed narrative of the data processing activity under assessment, including the nature, scope, context, and purposes of the processing as required by GDPR Article 35(7)(a).' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingCommencedDate rdf:type rdf:Property ;
    rdfs:label 'Processing Commenced Date' ;
    rdfs:comment 'Actual date on which the assessed processing activity commenced operations. Must be on or after the approval date for mandatory DPIAs. Used for compliance audit trail and regulatory reporting.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:residualRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Residual Risk Level' ;
    rdfs:comment 'Residual risk classification after all identified mitigation measures have been applied. If residual risk remains high or very high, supervisory authority consultation is mandatory under GDPR Article 36.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewCycleMonths rdf:type rdf:Property ;
    rdfs:label 'Review Cycle Months' ;
    rdfs:comment 'Frequency in months at which the PIA/DPIA must be reviewed and updated, e.g., 12 for annual review, 6 for semi-annual. Determined by risk level and regulatory requirements under GDPR Article 35(11).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supervisoryAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Supervisory Authority Name' ;
    rdfs:comment 'Name of the competent data protection supervisory authority consulted or notified, e.g., ICO (UK), CNIL (France), BfDI (Germany), or the lead supervisory authority under GDPR one-stop-shop mechanism.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemOrPlatformName rdf:type rdf:Property ;
    rdfs:label 'System Or Platform Name' ;
    rdfs:comment 'Name of the information system, platform, or application that performs the processing activity, e.g., Adobe Experience Platform, Ticketmaster Biometric Access, SAP SuccessFactors, or a custom fan engagement platform.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyProcessors rdf:type rdf:Property ;
    rdfs:label 'Third Party Processors' ;
    rdfs:comment 'Names of external data processors or sub-processors involved in the processing activity, e.g., cloud providers, analytics vendors, ticketing platforms. Relevant for Article 28 processor agreements and transfer impact assessments.' ;
    rdfs:domain ind:PiaAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governanceDocumentId rdf:type rdf:Property ;
    rdfs:label 'Governance Document Id' ;
    rdfs:comment 'Foreign key linking to legal.governance_document. Business justification: Compliance policies implement governance documents (bylaws, CBA provisions, operating agreements). Sports-entertainment compliance teams must trace each policy to the authoritative governance document' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GovernanceDocument .

ind:ownerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Policy lifecycle management requires a named employee owner responsible for review scheduling, updates, and attestation campaigns. Sports-entertainment compliance programs track policy ownership for r' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentPolicyId rdf:type rdf:Property ;
    rdfs:label 'Parent Policy Id' ;
    rdfs:comment 'Self-referencing identifier pointing to a parent policy when this policy is a sub-policy or addendum of a higher-level framework policy (e.g., a regional GDPR addendum referencing the master Data Privacy Policy).' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:primarySupersededByPolicyId rdf:type rdf:Property ;
    rdfs:label 'Primary Superseded By Policy Id' ;
    rdfs:comment 'Identifier of the newer policy version that replaces this record when status is \'superseded\'. Enables version chain traceability for regulatory audit purposes.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:adaSectionRef rdf:type rdf:Property ;
    rdfs:label 'Ada Section Ref' ;
    rdfs:comment 'Specific ADA title and section referenced by this accessibility policy (e.g., \'Title III Section 302 — Public Accommodations\'). Populated only for venue accessibility policies.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicabilityDomain rdf:type rdf:Property ;
    rdfs:label 'Applicability Domain' ;
    rdfs:comment 'Primary data or business domain to which this policy applies, aligned to Sports Entertainment\'s defined data domains. [ENUM-REF-CANDIDATE: event|athlete|venue|broadcast|ticketing|fan|sponsorship|merchandise|league|content|finance|workforce|digital_platform|all — promote to reference product]' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalAuthority rdf:type rdf:Property ;
    rdfs:label 'Approval Authority' ;
    rdfs:comment 'Name or title of the individual, committee, or governing body that has authority to approve this policy (e.g., \'Board of Directors\', \'Chief Legal Officer\', \'Compliance Committee\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestationFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Attestation Frequency Months' ;
    rdfs:comment 'Frequency in months at which in-scope personnel must re-attest compliance with this policy (e.g., 12 for annual attestation). Null if requires_attestation is False.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exceptionProcessDescription rdf:type rdf:Property ;
    rdfs:label 'Exception Process Description' ;
    rdfs:comment 'Description of the formal process by which an exception or waiver to this policy may be requested and approved, including the approving authority and required documentation.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fccRuleRef rdf:type rdf:Property ;
    rdfs:label 'Fcc Rule Ref' ;
    rdfs:comment 'Specific FCC regulation or rule number referenced by this broadcast content policy (e.g., \'47 CFR Part 73 — Broadcast Content Standards\'). Populated only for broadcast content policies.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pciDssRequirementRef rdf:type rdf:Property ;
    rdfs:label 'Pci Dss Requirement Ref' ;
    rdfs:comment 'Specific PCI-DSS requirement number(s) addressed by this policy (e.g., \'Requirement 3.4 — Protect Stored Cardholder Data\'). Populated only for payment security policies.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyDescription rdf:type rdf:Property ;
    rdfs:label 'Penalty Description' ;
    rdfs:comment 'Description of sanctions, fines, or disciplinary consequences for non-compliance with this policy (e.g., \'GDPR fines up to 4% of global annual turnover\', \'WADA 4-year ban\', \'PCI-DSS card brand fines\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyCategory rdf:type rdf:Property ;
    rdfs:label 'Policy Category' ;
    rdfs:comment 'Secondary classification indicating whether the policy is driven by external regulatory mandate, internal governance decision, contractual obligation (e.g., CBA), or voluntary industry standard adoption.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryObligationRef rdf:type rdf:Property ;
    rdfs:label 'Regulatory Obligation Ref' ;
    rdfs:comment 'Specific regulatory article, section, or requirement that mandates this policy (e.g., \'GDPR Article 5\', \'PCI-DSS Requirement 12.1\', \'WADA Code Article 2.1\', \'ADA Title III Section 302\'). Links the policy to its external legal obligation.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedIncidentCount rdf:type rdf:Property ;
    rdfs:label 'Related Incident Count' ;
    rdfs:comment 'Number of compliance incidents or violations recorded against this policy since its effective date. Provides a quick operational indicator of policy adherence challenges without requiring a join to the incident table.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresAttestation rdf:type rdf:Property ;
    rdfs:label 'Requires Attestation' ;
    rdfs:comment 'Indicates whether in-scope employees, athletes, or contractors must formally attest (sign off) that they have read and understood this policy. Drives attestation workflow in SAP SuccessFactors.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trainingRequired rdf:type rdf:Property ;
    rdfs:label 'Training Required' ;
    rdfs:comment 'Indicates whether mandatory training must be completed by in-scope personnel as a condition of policy compliance. Drives training assignment in SAP SuccessFactors.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wadaArticleRef rdf:type rdf:Property ;
    rdfs:label 'Wada Article Ref' ;
    rdfs:comment 'Specific WADA Code article number referenced by this anti-doping policy (e.g., \'Article 2.1 — Presence of Prohibited Substance\'). Populated only for anti-doping policies.' ;
    rdfs:domain ind:Policy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privacyRequestId rdf:type rdf:Property ;
    rdfs:label 'Privacy Request Id' ;
    rdfs:comment 'Unique surrogate identifier for each privacy request or consent record within the unified data subject interaction system. Serves as the primary key for all GDPR, CCPA, and applicable privacy regulation interactions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PrivacyRequest .

ind:aepConsentProfileReference rdf:type rdf:Property ;
    rdfs:label 'Aep Consent Profile Reference' ;
    rdfs:comment 'Identifier of the corresponding consent profile record in Adobe Experience Platform (AEP). Enables bidirectional synchronization between the compliance SSOT and the AEP consent management layer for real-time personalization suppression and marketing activation controls.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentAuthorizationReference rdf:type rdf:Property ;
    rdfs:label 'Agent Authorization Reference' ;
    rdfs:comment 'Reference identifier or document locator for the power of attorney, signed authorization form, or other legal instrument authorizing an agent to act on behalf of the data subject. Populated only when is_authorized_agent = True. Links to the compliance document management system.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableRegulation rdf:type rdf:Property ;
    rdfs:label 'Applicable Regulation' ;
    rdfs:comment 'Primary privacy regulation governing this request or consent record. Determines the applicable deadline, response format, and legal basis requirements. \'BOTH\' applies when the data subject qualifies under both GDPR (EU resident) and CCPA (California resident). \'OTHER\' covers emerging state-level privacy laws (e.g., VCDPA, CPA).' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedTeam rdf:type rdf:Property ;
    rdfs:label 'Assigned Team' ;
    rdfs:comment 'Internal team responsible for processing and fulfilling this privacy request. Supports workload routing, SLA monitoring, and escalation management. Values: privacy_ops (Privacy Operations team), legal (Legal department), dpo_office (Data Protection Officer\'s office), fan_services (Fan Services for consent queries), it_security (IT Security for data deletion execution).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentAction rdf:type rdf:Property ;
    rdfs:label 'Consent Action' ;
    rdfs:comment 'Specific action taken on the consent record. Applicable when interaction_type = \'consent\'. \'granted\' = affirmative consent given; \'withdrawn\' = previously granted consent revoked; \'updated\' = consent scope modified; \'expired\' = consent lapsed per policy version expiry. Null for rights requests.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentGrantedAt rdf:type rdf:Property ;
    rdfs:label 'Consent Granted At' ;
    rdfs:comment 'Date and time when the data subject affirmatively granted consent. Serves as the legal basis timestamp for processing activities relying on consent under GDPR Article 6(1)(a). Null for rights requests or consent withdrawal records.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:consentPolicyVersion rdf:type rdf:Property ;
    rdfs:label 'Consent Policy Version' ;
    rdfs:comment 'Version identifier of the privacy policy or consent notice that was presented to the data subject at the time of consent capture. Enables tracking of consent validity across policy updates and supports re-consent workflows when material policy changes occur. Format: v{major}.{minor}.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentProofReference rdf:type rdf:Property ;
    rdfs:label 'Consent Proof Reference' ;
    rdfs:comment 'Reference identifier or URI pointing to the immutable consent proof artifact stored in the compliance document repository. Captures the exact consent interaction evidence (e.g., screenshot, API payload hash, signed consent token) required to demonstrate lawful basis under GDPR Article 7(1).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentType rdf:type rdf:Property ;
    rdfs:label 'Consent Type' ;
    rdfs:comment 'Category of consent being captured or withdrawn. Applicable when interaction_type = \'consent\'. Values: marketing (promotional communications), analytics (behavioral and performance analytics), third_party_sharing (data sharing with sponsors/partners), cookies (web/app cookie consent), biometric_data (facial recognition or biometric identification at venues). Null for rights requests.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentWithdrawnAt rdf:type rdf:Property ;
    rdfs:label 'Consent Withdrawn At' ;
    rdfs:comment 'Date and time when the data subject withdrew previously granted consent. Upon withdrawal, downstream processing activities relying on this consent must cease. Integrated with Adobe Experience Platform consent management to suppress marketing and analytics processing.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:createdAt rdf:type rdf:Property ;
    rdfs:label 'Created At' ;
    rdfs:comment 'Date and time when this privacy request record was first created in the compliance system. Audit trail field supporting data lineage and regulatory accountability requirements under GDPR Article 5(2).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataCategoriesInScope rdf:type rdf:Property ;
    rdfs:label 'Data Categories In Scope' ;
    rdfs:comment 'Comma-separated list of personal data categories covered by this request or consent record (e.g., \'ticketing_history, fan_profile, payment_data, location_data, biometric_data\'). Derived from the data subject\'s request or the consent scope definition. Used for scoping the fulfillment workflow and data inventory mapping.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSubjectJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Data Subject Jurisdiction' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the jurisdiction of the data subject\'s residence, used to determine the applicable privacy regulation (GDPR for EU/EEA residents, CCPA for California residents, etc.) and the corresponding response obligations. Examples: GBR, DEU, USA, CAN.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dpoReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Dpo Review Required' ;
    rdfs:comment 'Indicates whether this request requires review by the Data Protection Officer (DPO) before fulfillment. Set to True for high-risk erasure requests, requests involving special category data (biometric, health), or requests that may conflict with legal retention obligations.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dpoReviewedAt rdf:type rdf:Property ;
    rdfs:label 'Dpo Reviewed At' ;
    rdfs:comment 'Date and time when the Data Protection Officer (DPO) completed their review of the privacy request. Populated only when dpo_review_required = True. Supports audit trail for high-risk processing decisions.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:extendedDeadline rdf:type rdf:Property ;
    rdfs:label 'Extended Deadline' ;
    rdfs:comment 'Revised response deadline after a formal extension has been granted and the data subject notified. Replaces regulatory_deadline as the operative SLA date when an extension is invoked. Null if no extension was applied.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extensionNotifiedAt rdf:type rdf:Property ;
    rdfs:label 'Extension Notified At' ;
    rdfs:comment 'Date and time when the data subject was notified of a response deadline extension. Under GDPR, organizations may extend the 30-day deadline by a further 60 days for complex requests, but must notify the data subject within the initial 30-day window. Under CCPA, a 45-day extension is permitted with notice.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:identityVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Identity Verification Method' ;
    rdfs:comment 'Method used to verify the identity of the requestor. Supports audit trail requirements and helps assess verification strength. Values: email_confirmation (link-based), account_login (authenticated session), knowledge_based (security questions), document_upload (ID document), two_factor (MFA challenge).' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Identity Verification Status' ;
    rdfs:comment 'Status of the identity verification process for the requestor. \'pending\' = verification initiated but not complete; \'verified\' = identity confirmed; \'failed\' = verification unsuccessful (request cannot proceed); \'waived\' = verification not required per policy (e.g., consent withdrawal). Mandatory step before fulfilling access or erasure requests.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionType rdf:type rdf:Property ;
    rdfs:label 'Interaction Type' ;
    rdfs:comment 'Top-level discriminator indicating whether this record represents a data subject rights request (access, erasure, portability, etc.) or a consent management event (grant, withdrawal, update). Drives downstream processing workflow and regulatory deadline calculation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAuthorizedAgent rdf:type rdf:Property ;
    rdfs:label 'Is Authorized Agent' ;
    rdfs:comment 'Indicates whether the request was submitted by an authorized agent acting on behalf of the data subject rather than the data subject themselves. When True, agent authorization documentation must be collected and linked via agent_authorization_reference. Required for CCPA compliance.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalHoldFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Hold Flag' ;
    rdfs:comment 'Indicates whether the data subject\'s records are subject to a legal hold that prevents erasure or restriction fulfillment. When True, the erasure or restriction request must be suspended pending resolution of the legal matter. Coordinated with the legal case management system.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:processingNotes rdf:type rdf:Property ;
    rdfs:label 'Processing Notes' ;
    rdfs:comment 'Free-text field capturing internal notes, decisions, and observations recorded by the processing team during fulfillment. Includes documentation of exemptions applied, systems searched, and any complexities encountered. Confidential — not shared with the data subject.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryDeadline rdf:type rdf:Property ;
    rdfs:label 'Regulatory Deadline' ;
    rdfs:comment 'Calculated deadline by which the organization must fulfill or respond to the privacy request. Derived from submitted_at plus the applicable regulatory window: 30 calendar days under GDPR (extendable to 90 with notice) or 45 calendar days under CCPA (extendable to 90). Stored as a business date for SLA monitoring and escalation triggers.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestorFullName rdf:type rdf:Property ;
    rdfs:label 'Requestor Full Name' ;
    rdfs:comment 'Full legal name of the individual submitting the privacy request. May differ from the fan record name when submitted by an authorized agent or legal representative on behalf of the data subject.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Response Delivery Method' ;
    rdfs:comment 'Method used to deliver the privacy request response or consent confirmation to the data subject. Must align with the data subject\'s preferred contact channel and regulatory requirements for secure delivery of personal data.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseOutcome rdf:type rdf:Property ;
    rdfs:label 'Response Outcome' ;
    rdfs:comment 'Final outcome of the privacy request fulfillment. \'fulfilled\' = request fully completed; \'partially_fulfilled\' = some data categories actioned, others exempted; \'rejected\' = request denied with legal basis; \'no_data_found\' = no personal data located for the subject; \'extended\' = response period extended per regulatory allowance with notice sent.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedAt rdf:type rdf:Property ;
    rdfs:label 'Submitted At' ;
    rdfs:comment 'Exact date and time (with timezone) when the privacy request was submitted or the consent event was recorded. This is the principal business event timestamp and the anchor for all regulatory deadline calculations (GDPR 30-day, CCPA 45-day).' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:thirdPartyDisclosures rdf:type rdf:Property ;
    rdfs:label 'Third Party Disclosures' ;
    rdfs:comment 'Comma-separated list of third-party organizations to whom the data subject\'s personal data has been disclosed and who must be notified of erasure, restriction, or opt-out requests. Includes sponsors, broadcast partners, and analytics vendors. Required for GDPR Article 17(2) and CCPA opt-out propagation.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedAt rdf:type rdf:Property ;
    rdfs:label 'Updated At' ;
    rdfs:comment 'Date and time when this privacy request record was most recently modified. Supports audit trail requirements and change detection for downstream integrations with Adobe Experience Platform and Salesforce CRM.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:usStateCode rdf:type rdf:Property ;
    rdfs:label 'Us State Code' ;
    rdfs:comment 'Two-letter US state code for data subjects residing in the United States. Used to determine applicability of state-level privacy laws beyond CCPA (e.g., VCDPA for Virginia, CPA for Colorado, CTDPA for Connecticut). Populated only when data_subject_jurisdiction = \'USA\'.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedAt rdf:type rdf:Property ;
    rdfs:label 'Verified At' ;
    rdfs:comment 'Date and time when the requestor\'s identity was successfully verified. Marks the start of the regulatory response clock in jurisdictions where the deadline begins upon verification rather than submission.' ;
    rdfs:domain ind:PrivacyRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:originalFilingRegulatoryFilingId rdf:type rdf:Property ;
    rdfs:label 'Original Filing Regulatory Filing Id' ;
    rdfs:comment 'Reference to the original regulatory filing record that this filing amends or supersedes. Populated only when is_amendment is True.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryFiling .

ind:submitterEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Submitter Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Regulatory filing accountability requires linking each submission to the responsible employee. Compliance auditors and regulators need to identify who submitted filings for OSHA, FCC, GDPR, and league' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:acknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Date' ;
    rdfs:comment 'The date on which the governing body formally acknowledged receipt of the regulatory filing.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:acknowledgmentReference rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Reference' ;
    rdfs:comment 'Official reference number or confirmation code issued by the governing body upon receipt and acknowledgment of the filing.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysOverdue rdf:type rdf:Property ;
    rdfs:label 'Days Overdue' ;
    rdfs:comment 'Number of calendar days the filing is past its due date at the time of last status update. Used for overdue alerting and escalation workflows. Zero or negative indicates on-time or early submission.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'The regulatory deadline by which this filing must be submitted to the governing body. Used for overdue alerting and deadline tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:externalPortalUrl rdf:type rdf:Property ;
    rdfs:label 'External Portal Url' ;
    rdfs:comment 'URL of the governing body\'s electronic filing portal where this submission was made or can be accessed (e.g., SEC EDGAR, WADA ADAMS, FCC Electronic Filing System).' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingCategory rdf:type rdf:Property ;
    rdfs:label 'Filing Category' ;
    rdfs:comment 'High-level business domain category of the filing, enabling cross-domain compliance reporting and portfolio management across WADA, GDPR/CCPA, PCI-DSS, ADA, CAS, and financial regulators. [ENUM-REF-CANDIDATE: anti_doping|data_privacy|financial|broadcast|safety|accessibility|arbitration — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingDescription rdf:type rdf:Property ;
    rdfs:label 'Filing Description' ;
    rdfs:comment 'Detailed narrative description of the regulatory filing\'s scope, content, and purpose, providing context for compliance officers and auditors.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Filing Period End Date' ;
    rdfs:comment 'The end date of the reporting or compliance period covered by this regulatory filing (e.g., fiscal year end, season end).' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Filing Period Start Date' ;
    rdfs:comment 'The start date of the reporting or compliance period covered by this regulatory filing (e.g., fiscal year start, season start).' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Filing Reference Number' ;
    rdfs:comment 'Externally-known unique reference number assigned to this regulatory filing, used for tracking and correspondence with the governing body.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingStatus rdf:type rdf:Property ;
    rdfs:label 'Filing Status' ;
    rdfs:comment 'Current lifecycle state of the regulatory filing, from initial draft through governing body acknowledgment and final disposition. [ENUM-REF-CANDIDATE: draft|submitted|acknowledged|under_review|accepted|rejected|overdue — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingTitle rdf:type rdf:Property ;
    rdfs:label 'Filing Title' ;
    rdfs:comment 'Descriptive title or name of the regulatory filing as it appears on the submission document (e.g., \'Annual Anti-Doping Declaration FY2024\', \'GDPR Article 30 Records of Processing\').' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingType rdf:type rdf:Property ;
    rdfs:label 'Filing Type' ;
    rdfs:comment 'Classification of the regulatory filing by its purpose or mandate. [ENUM-REF-CANDIDATE: annual_report|incident_report|eligibility_certification|anti_doping_declaration|broadcast_license_renewal|financial_disclosure|privacy_impact_assessment|arbitration_submission|waiver_request|audit_response — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingBodyContact rdf:type rdf:Property ;
    rdfs:label 'Governing Body Contact' ;
    rdfs:comment 'Name or identifier of the primary contact person or department at the governing body responsible for receiving and processing this filing.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAmendment rdf:type rdf:Property ;
    rdfs:label 'Is Amendment' ;
    rdfs:comment 'Indicates whether this filing is an amendment or correction to a previously submitted filing. True if this is an amended submission.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount' ;
    rdfs:comment 'Monetary value of the regulatory penalty or fine assessed or at risk for this filing, in the currency specified by penalty_currency_code.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resubmissionDueDate rdf:type rdf:Property ;
    rdfs:label 'Resubmission Due Date' ;
    rdfs:comment 'Deadline by which a corrected or amended filing must be resubmitted following a rejection or request for additional information from the governing body.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Review Deadline Date' ;
    rdfs:comment 'Internal deadline by which the filing must be reviewed and approved before submission to the governing body, supporting pre-submission quality control.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionMethod rdf:type rdf:Property ;
    rdfs:label 'Submission Method' ;
    rdfs:comment 'The channel or method used to submit the filing to the governing body (e.g., electronic portal such as SEC EDGAR or WADA ADAMS, email, postal mail).' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Submission Timestamp' ;
    rdfs:comment 'The exact date and time the filing was formally submitted to the governing body. This is the principal business event timestamp for the filing transaction.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:submittedBy rdf:type rdf:Property ;
    rdfs:label 'Submitted By' ;
    rdfs:comment 'Full name or employee identifier of the internal staff member or authorized representative who submitted the filing on behalf of Sports Entertainment.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterTitle rdf:type rdf:Property ;
    rdfs:label 'Submitter Title' ;
    rdfs:comment 'Official job title of the individual who submitted the filing (e.g., Chief Compliance Officer, Legal Counsel, Data Protection Officer).' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:linkedTestComplianceDopingTestId rdf:type rdf:Property ;
    rdfs:label 'Linked Test Compliance Doping Test Id' ;
    rdfs:comment 'Reference to the anti-doping test record that triggered this sanction, where applicable (e.g., adverse analytical finding or atypical finding). Null for non-analytical violations.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DopingTest .

ind:linkedTestDopingTestId rdf:type rdf:Property ;
    rdfs:label 'Linked Test Doping Test Id' ;
    rdfs:comment 'Reference to the anti-doping test record that triggered this sanction, where applicable (e.g., adverse analytical finding or atypical finding). Null for non-analytical violations.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DopingTest .

ind:aggravatingFactors rdf:type rdf:Property ;
    rdfs:label 'Aggravating Factors' ;
    rdfs:comment 'Documented aggravating circumstances that led to an increased sanction beyond the standard period, such as use of multiple prohibited substances, involvement of minors, or prior violations.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:casReference rdf:type rdf:Property ;
    rdfs:label 'Cas Reference' ;
    rdfs:comment 'The case reference number assigned by the Court of Arbitration for Sport (CAS) if this sanction has been escalated to CAS arbitration. Null if no CAS proceeding has been initiated.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationDays rdf:type rdf:Property ;
    rdfs:label 'Duration Days' ;
    rdfs:comment 'The total length of the sanction period expressed in calendar days. Derived from the governing body decision for reporting and eligibility tracking purposes. For lifetime bans, a conventional large value (e.g., 99999) may be used.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fineAmount rdf:type rdf:Property ;
    rdfs:label 'Fine Amount' ;
    rdfs:comment 'The monetary penalty imposed as part of or in lieu of the sanction, expressed in the currency specified by fine_currency_code. Null if no financial penalty was levied.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fineCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Fine Currency Code' ;
    rdfs:comment 'The ISO 4217 three-letter currency code for the fine amount (e.g., USD, EUR, GBP). Null if no fine was imposed.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finePaymentStatus rdf:type rdf:Property ;
    rdfs:label 'Fine Payment Status' ;
    rdfs:comment 'Current payment status of the monetary fine associated with this sanction. Null if no fine was imposed.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAnalyticalViolation rdf:type rdf:Property ;
    rdfs:label 'Is Analytical Violation' ;
    rdfs:comment 'Indicates whether the Anti-Doping Rule Violation (ADRV) is analytical in nature (i.e., derived from a positive sample test result — adverse or atypical analytical finding). False indicates a non-analytical violation such as whereabouts failure, tampering, refusal, or possession.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPublicDisclosure rdf:type rdf:Property ;
    rdfs:label 'Is Public Disclosure' ;
    rdfs:comment 'Indicates whether this sanction has been publicly disclosed by the issuing governing body per applicable transparency and publication obligations. WADA Code Article 14.3 mandates public reporting of ADRVs.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSanctionStayed rdf:type rdf:Property ;
    rdfs:label 'Is Sanction Stayed' ;
    rdfs:comment 'Indicates whether enforcement of the sanction has been temporarily stayed (suspended) pending the outcome of an appeal or legal challenge. A stayed sanction means the sanctioned entity may continue to participate during the appeal period.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueOrCompetition rdf:type rdf:Property ;
    rdfs:label 'League Or Competition' ;
    rdfs:comment 'The specific league, competition, or tournament context in which the violation occurred or to which the sanction applies (e.g., NFL Regular Season, UEFA Champions League, NBA Season 2024-25).' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigatingFactors rdf:type rdf:Property ;
    rdfs:label 'Mitigating Factors' ;
    rdfs:comment 'Documented mitigating circumstances considered by the adjudicating authority in determining the sanction, such as no significant fault or negligence, substantial assistance, or prompt admission. May result in a reduced sanction period.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointsDeduction rdf:type rdf:Property ;
    rdfs:label 'Points Deduction' ;
    rdfs:comment 'The number of competition points deducted from the sanctioned team or entity as part of the enforcement action. Null if the sanction type does not include a points deduction.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryBasis rdf:type rdf:Property ;
    rdfs:label 'Regulatory Basis' ;
    rdfs:comment 'The specific rule, article, code, or regulation under which the sanction is issued (e.g., \'WADA Code Article 2.1\', \'FIFA Disciplinary Code Article 12\', \'NFL Personal Conduct Policy Section 3\'). Provides the legal foundation for the enforcement action.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionedEntityName rdf:type rdf:Property ;
    rdfs:label 'Sanctioned Entity Name' ;
    rdfs:comment 'The full legal name or registered name of the sanctioned party (athlete, official, team, or organization) at the time the sanction was issued. Retained for historical accuracy independent of master record changes.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionedEntityReference rdf:type rdf:Property ;
    rdfs:label 'Sanctioned Entity Reference' ;
    rdfs:comment 'Identifier of the primary entity subject to the sanction. May reference an athlete, official, team, or the organization depending on sanctioned_entity_type.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sanctionedEntityType rdf:type rdf:Property ;
    rdfs:label 'Sanctioned Entity Type' ;
    rdfs:comment 'Categorizes the type of party subject to the sanction, enabling polymorphic resolution of the sanctioned_entity_id reference.' ;
    rdfs:domain ind:Sanction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationDescription rdf:type rdf:Property ;
    rdfs:label 'Violation Description' ;
    rdfs:comment 'Detailed narrative description of the specific violation, circumstances, and factual basis for the sanction as documented by the issuing authority. Provides the qualitative context required for legal, compliance, and audit purposes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adamsReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Adams Reference Number' ;
    rdfs:comment 'Unique reference number assigned by the WADA ADAMS portal upon submission of the whereabouts filing. Used as the externally-known business identifier for cross-referencing with WADA and national anti-doping organisations.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:athleteResponseDeadline rdf:type rdf:Property ;
    rdfs:label 'Athlete Response Deadline' ;
    rdfs:comment 'Deadline by which the athlete must respond to a missed or incomplete filing notification. Typically 14 days from notification_date per WADA ISTI. Failure to respond within this window may result in the missed filing being confirmed.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorisedRepresentativeName rdf:type rdf:Property ;
    rdfs:label 'Authorised Representative Name' ;
    rdfs:comment 'Full name of the authorised representative (agent, coach, or team official) who submitted the filing on behalf of the athlete, where applicable. Null if the athlete submitted directly.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitionEndDate rdf:type rdf:Property ;
    rdfs:label 'Competition End Date' ;
    rdfs:comment 'End date of the scheduled competition or event during the filing period. Defines the in-competition period boundary for testing jurisdiction and sample classification purposes.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:competitionLocation rdf:type rdf:Property ;
    rdfs:label 'Competition Location' ;
    rdfs:comment 'City and country of the competition venue where the athlete is scheduled to compete during the filing period. Supports in-competition testing logistics and jurisdiction determination.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitionStartDate rdf:type rdf:Property ;
    rdfs:label 'Competition Start Date' ;
    rdfs:comment 'Start date of the scheduled competition or event during the filing period. Used to plan in-competition doping control and to validate athlete availability windows.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceStatus rdf:type rdf:Property ;
    rdfs:label 'Compliance Status' ;
    rdfs:comment 'Regulatory compliance determination for this filing period. COMPLIANT = filed on time and complete; MISSED = not filed by deadline; INCOMPLETE = filed but missing required information; LATE = filed after deadline; UNDER_REVIEW = compliance determination pending adjudication. Three MISSED or INCOMPLETE filings within 12 months trigger a WADA Code Article 2.4 violation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSource rdf:type rdf:Property ;
    rdfs:label 'Data Source' ;
    rdfs:comment 'Origin system or ingestion method through which this whereabouts filing record was loaded into the compliance data platform. ADAMS = direct integration with WADA ADAMS portal; MANUAL_ENTRY = entered by compliance staff; API_INTEGRATION = via anti-doping organisation API; BULK_IMPORT = batch file load.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeReason rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason' ;
    rdfs:comment 'Free-text description of the reason provided by the athlete or their representative for disputing a missed or incomplete filing determination. Relevant for CAS arbitration proceedings and WADA Code Article 2.4 adjudication.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingDeadline rdf:type rdf:Property ;
    rdfs:label 'Filing Deadline' ;
    rdfs:comment 'Regulatory deadline by which the athlete must submit their whereabouts filing for the applicable quarter. Typically the last day of the preceding quarter per WADA ISTI requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingNotes rdf:type rdf:Property ;
    rdfs:label 'Filing Notes' ;
    rdfs:comment 'Free-text notes or comments recorded by the compliance officer or anti-doping administrator regarding this whereabouts filing. May include exceptional circumstances, force majeure events, or administrative observations relevant to compliance adjudication.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingPeriodQuarter rdf:type rdf:Property ;
    rdfs:label 'Filing Period Quarter' ;
    rdfs:comment 'Calendar quarter (1=Q1 Jan-Mar, 2=Q2 Apr-Jun, 3=Q3 Jul-Sep, 4=Q4 Oct-Dec) to which this whereabouts filing applies. Under WADA Code Article 2.4, three missed filings within 12 months constitute a whereabouts failure violation.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:filingPeriodYear rdf:type rdf:Property ;
    rdfs:label 'Filing Period Year' ;
    rdfs:comment 'Calendar year (e.g., 2024) to which this whereabouts filing applies. Combined with filing_period_quarter to uniquely identify the quarterly filing obligation period.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isLateSubmission rdf:type rdf:Property ;
    rdfs:label 'Is Late Submission' ;
    rdfs:comment 'Flag indicating whether the filing was submitted after the regulatory deadline (submission_date > filing_deadline). Late submissions may be treated as incomplete or missed filings depending on the anti-doping organisation\'s rules.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:missedFilingCountRolling12m rdf:type rdf:Property ;
    rdfs:label 'Missed Filing Count Rolling 12m' ;
    rdfs:comment 'Running count of missed or non-compliant whereabouts filings by this athlete within the preceding 12-month rolling window at the time of this filing. When this value reaches 3, a WADA Code Article 2.4 whereabouts failure violation is triggered. Stored as a point-in-time snapshot for audit and adjudication purposes.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationSent rdf:type rdf:Property ;
    rdfs:label 'Notification Sent' ;
    rdfs:comment 'Flag indicating whether the athlete has been formally notified of a missed or incomplete filing determination as required by WADA ISTI. Notification is a prerequisite before a missed filing can be counted toward the Article 2.4 violation threshold.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overnightLocationAddress rdf:type rdf:Property ;
    rdfs:label 'Overnight Location Address' ;
    rdfs:comment 'Full street address where the athlete will be sleeping each night during the filing period. Required field under WADA ISTI for out-of-competition testing. Classified as restricted PII as it reveals the athlete\'s residential or accommodation location.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overnightLocationCity rdf:type rdf:Property ;
    rdfs:label 'Overnight Location City' ;
    rdfs:comment 'City component of the athlete\'s overnight location for the filing period. Supports geographic analysis of testing pool distribution and logistics planning for out-of-competition testing.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overnightLocationCountry rdf:type rdf:Property ;
    rdfs:label 'Overnight Location Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the athlete\'s overnight location during the filing period. Used to coordinate testing jurisdiction between national and international anti-doping organisations.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleOrganisation rdf:type rdf:Property ;
    rdfs:label 'Responsible Organisation' ;
    rdfs:comment 'Name of the Anti-Doping Organisation (ADO) responsible for managing this athlete\'s whereabouts filing obligation for the period (e.g., WADA, USADA, UKAD, or the relevant International Federation). Determines which body adjudicates missed filing violations.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewStatus rdf:type rdf:Property ;
    rdfs:label 'Review Status' ;
    rdfs:comment 'Current status of the compliance review process for this filing. PENDING = awaiting review; IN_REVIEW = under active compliance review; ACCEPTED = compliance determination finalised; DISPUTED = athlete or representative has contested the compliance determination; ESCALATED = referred to CAS or governing body for adjudication.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sixtyMinuteSlotTime rdf:type rdf:Property ;
    rdfs:label 'Sixty Minute Slot Time' ;
    rdfs:comment 'Specific 60-minute daily time window (HH:MM in 24-hour format, representing start of slot) during which the athlete guarantees availability for out-of-competition testing at the declared training venue. This is a mandatory WADA ISTI requirement for Registered Testing Pool athletes.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:submissionDate rdf:type rdf:Property ;
    rdfs:label 'Submission Date' ;
    rdfs:comment 'Calendar date on which the athlete or their authorised representative submitted the whereabouts filing. Used to determine whether the filing was on-time or late relative to the filing_deadline.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testingPoolType rdf:type rdf:Property ;
    rdfs:label 'Testing Pool Type' ;
    rdfs:comment 'Classification of the registered testing pool to which the athlete belongs. RTP = Registered Testing Pool (international-level, managed by International Federation or WADA); NRTP = National Registered Testing Pool (managed by National Anti-Doping Organisation); TP = Testing Pool (lower-tier, no whereabouts filing obligation but tracked for completeness).' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingScheduleEndTime rdf:type rdf:Property ;
    rdfs:label 'Training Schedule End Time' ;
    rdfs:comment 'Scheduled end time of the athlete\'s regular training sessions during the filing period. Together with training_schedule_start_time, defines the daily availability window for doping control officers.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:trainingScheduleStartTime rdf:type rdf:Property ;
    rdfs:label 'Training Schedule Start Time' ;
    rdfs:comment 'Scheduled start time of the athlete\'s regular training sessions during the filing period. Combined with training_schedule_end_time, defines the 60-minute testing slot window required by WADA ISTI.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:trainingVenueAddress rdf:type rdf:Property ;
    rdfs:label 'Training Venue Address' ;
    rdfs:comment 'Full street address of the primary training venue for the filing period. Enables doping control officers to locate the athlete for unannounced out-of-competition testing.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingVenueName rdf:type rdf:Property ;
    rdfs:label 'Training Venue Name' ;
    rdfs:comment 'Name of the primary training facility or venue where the athlete trains during the filing period. Required for out-of-competition testing planning and sample collection logistics.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updateCount rdf:type rdf:Property ;
    rdfs:label 'Update Count' ;
    rdfs:comment 'Number of times this whereabouts filing has been updated or amended after initial submission. Athletes may update filings up to the deadline without penalty; updates after the deadline may be flagged for review.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:violationThresholdReached rdf:type rdf:Property ;
    rdfs:label 'Violation Threshold Reached' ;
    rdfs:comment 'Flag indicating whether this filing caused the athlete\'s missed filing count to reach or exceed the WADA Code Article 2.4 threshold of three missed/incomplete filings within 12 months, triggering a formal whereabouts failure violation.' ;
    rdfs:domain ind:WhereaboutsFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalId rdf:type rdf:Property ;
    rdfs:label 'Approval Id' ;
    rdfs:comment 'Unique system-generated identifier for each content approval workflow record in the Dalet Galaxy DAM approval lifecycle.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Approval .

ind:approvalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approval Employee Id' ;
    rdfs:comment 'Reference to the editorial or legal reviewer responsible for evaluating the content asset at this approval stage.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:approvalEscalatedToReviewerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approval Escalated To Reviewer Employee Id' ;
    rdfs:comment 'Reference to the senior reviewer or executive to whom this approval has been escalated when the decision is \'escalated\', enabling tracking of the escalation chain.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assetVersionId rdf:type rdf:Property ;
    rdfs:label 'Asset Version Id' ;
    rdfs:comment 'Foreign key linking to content.asset_version. Business justification: Approvals are version-specific — a specific rendition of an asset is approved for distribution. approval has content_version_label as a STRING but no FK to the specific asset_version being approved. T' ;
    rdfs:domain ind:Content ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AssetVersion .

ind:compliancePolicyId rdf:type rdf:Property ;
    rdfs:label 'Compliance Policy Id' ;
    rdfs:comment 'Foreign key linking to compliance.policy. Business justification: Content approvals verify compliance with specific policies (WADA athlete portrayal, GDPR, brand safety). The approval record\'s wada_compliance_flag and gdpr_compliance_flag are denormalized; linking t' ;
    rdfs:domain ind:Content ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:editorialBriefId rdf:type rdf:Property ;
    rdfs:label 'Editorial Brief Id' ;
    rdfs:comment 'Foreign key linking to content.editorial_brief. Business justification: Approvals are triggered by editorial briefs — the approval workflow governs whether an editorial brief\'s commissioned content meets editorial and legal standards. Linking approval to editorial_brief e' ;
    rdfs:domain ind:Content ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EditorialBrief .

ind:escalatedToReviewerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Escalated To Reviewer Employee Id' ;
    rdfs:comment 'Reference to the senior reviewer or executive to whom this approval has been escalated when the decision is \'escalated\', enabling tracking of the escalation chain.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:previousApprovalId rdf:type rdf:Property ;
    rdfs:label 'Previous Approval Id' ;
    rdfs:comment 'Reference to the prior approval record for the same content asset at the same stage, enabling tracking of revision cycles and the full iterative approval history chain.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Approval .

ind:brandSafetyVerified rdf:type rdf:Property ;
    rdfs:label 'Brand Safety Verified' ;
    rdfs:comment 'Indicates whether the content asset has been reviewed and confirmed to meet brand safety standards — free from inappropriate, offensive, or reputationally harmful content — prior to distribution.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cdnDistributionAuthorized rdf:type rdf:Property ;
    rdfs:label 'Cdn Distribution Authorized' ;
    rdfs:comment 'Indicates whether Content Delivery Network (CDN) distribution has been explicitly authorized as part of this approval decision, enabling downstream CDN publishing workflows to proceed for OTT and digital platform delivery.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contentSensitivityLevel rdf:type rdf:Property ;
    rdfs:label 'Content Sensitivity Level' ;
    rdfs:comment 'Data classification level of the content asset subject to this approval, aligned with enterprise data governance policy — public, internal, confidential, or restricted — informing access controls during the review workflow.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentVersionLabel rdf:type rdf:Property ;
    rdfs:label 'Content Version Label' ;
    rdfs:comment 'The version label of the content asset at the time of this approval submission (e.g., v1.0, v2.3), ensuring the approval record is tied to a specific asset version and supporting audit traceability across revision cycles.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daletWorkflowTaskReference rdf:type rdf:Property ;
    rdfs:label 'Dalet Workflow Task Reference' ;
    rdfs:comment 'The native task identifier from the Dalet Galaxy Digital Asset Management (DAM) system corresponding to this approval step, enabling bi-directional traceability between the lakehouse silver layer and the operational source system.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decision rdf:type rdf:Property ;
    rdfs:label 'Decision' ;
    rdfs:comment 'The outcome decision made by the reviewer at this approval stage — approved, rejected, revision requested, escalated to a higher authority, or deferred pending additional information.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Decision Timestamp' ;
    rdfs:comment 'The date and time when the reviewer rendered their approval decision (approved, rejected, revision requested, escalated, or deferred), serving as the principal business event timestamp for this approval record.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:drmComplianceVerified rdf:type rdf:Property ;
    rdfs:label 'Drm Compliance Verified' ;
    rdfs:comment 'Indicates whether Digital Rights Management (DRM) compliance has been explicitly verified by the reviewer as part of this approval stage, confirming the content asset is cleared for the intended distribution channel.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dueTimestamp rdf:type rdf:Property ;
    rdfs:label 'Due Timestamp' ;
    rdfs:comment 'The deadline by which the reviewer must render a decision for this approval stage, used for Service Level Agreement (SLA) monitoring and escalation triggering in broadcast and OTT content workflows.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:escalationNotes rdf:type rdf:Property ;
    rdfs:label 'Escalation Notes' ;
    rdfs:comment 'Free-text notes documenting the rationale for escalating this approval to a higher authority, capturing the specific concern or ambiguity that requires senior editorial or legal judgment.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gdprComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Gdpr Compliance Flag' ;
    rdfs:comment 'Indicates whether the content asset has been reviewed for General Data Protection Regulation (GDPR) compliance, particularly for content featuring identifiable individuals in EU markets.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueGoverningBody rdf:type rdf:Property ;
    rdfs:label 'League Governing Body' ;
    rdfs:comment 'The sports league or governing body whose content standards and Intellectual Property (IP) rules apply to this content asset approval — e.g., NFL, NBA, FIFA, NHL, MLB, MLS — determining the applicable rights and compliance framework.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publishGateCleared rdf:type rdf:Property ;
    rdfs:label 'Publish Gate Cleared' ;
    rdfs:comment 'Indicates whether this approval record represents the final publish gate clearance, confirming the content asset has passed all required approval stages and is authorized for distribution to the intended channel.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Code' ;
    rdfs:comment 'Standardized code categorizing the reason for rejection when the approval decision is \'rejected\' — e.g., rights conflict, brand violation, quality failure, legal risk, policy breach, or content inaccuracy. [ENUM-REF-CANDIDATE: rights_conflict|brand_violation|quality_fail|legal_risk|policy_breach|content_inaccuracy|gdpr_violation|wada_violation|drm_conflict — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasonNotes rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Notes' ;
    rdfs:comment 'Free-text narrative provided by the reviewer explaining the specific grounds for rejection, supplementing the standardized rejection reason code with contextual detail for editorial and legal teams.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewComments rdf:type rdf:Property ;
    rdfs:label 'Review Comments' ;
    rdfs:comment 'General free-text commentary provided by the reviewer during the evaluation of the content asset, capturing qualitative feedback, observations, or conditional approval notes not covered by structured fields.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewType rdf:type rdf:Property ;
    rdfs:label 'Review Type' ;
    rdfs:comment 'The nature of the review being performed at this approval stage — editorial quality, legal compliance, Digital Rights Management (DRM) rights compliance, brand safety, or executive approval.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerRole rdf:type rdf:Property ;
    rdfs:label 'Reviewer Role' ;
    rdfs:comment 'The organizational role of the reviewer performing this approval stage — editor, legal counsel, rights manager, brand manager, or executive producer — providing context for the nature of the review and audit accountability.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionCount rdf:type rdf:Property ;
    rdfs:label 'Revision Count' ;
    rdfs:comment 'The number of revision cycles this content asset has undergone at this approval stage, tracking iterative editorial or legal feedback loops before a final decision is reached.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revisionRequestNotes rdf:type rdf:Property ;
    rdfs:label 'Revision Request Notes' ;
    rdfs:comment 'Free-text instructions provided by the reviewer when the decision is \'revision_requested\', detailing the specific changes required before the content asset can be re-submitted for approval.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Breach Flag' ;
    rdfs:comment 'Indicates whether the reviewer exceeded the defined Service Level Agreement (SLA) turnaround time for this approval stage, used for workflow performance monitoring and escalation management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stage rdf:type rdf:Property ;
    rdfs:label 'Stage' ;
    rdfs:comment 'The named stage within the multi-stage content approval workflow at which this record applies — e.g., editorial review, legal clearance, Digital Rights Management (DRM) rights compliance, executive sign-off, or final publish gate.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Stage Sequence Number' ;
    rdfs:comment 'Numeric ordering of this approval stage within the overall workflow, enabling reconstruction of the full sequential review chain (e.g., 1 = editorial, 2 = legal, 3 = executive).' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ugcConsentVerified rdf:type rdf:Property ;
    rdfs:label 'Ugc Consent Verified' ;
    rdfs:comment 'Indicates whether explicit consent has been verified for User-Generated Content (UGC) assets, confirming the original creator has granted rights for the intended use and distribution channel.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workflowInstanceCode rdf:type rdf:Property ;
    rdfs:label 'Workflow Instance Code' ;
    rdfs:comment 'Reference to the parent multi-stage approval workflow instance that this approval record belongs to, enabling tracking of the full review chain for a content asset.' ;
    rdfs:domain ind:Approval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetDescription rdf:type rdf:Property ;
    rdfs:label 'Asset Description' ;
    rdfs:comment 'Free-text editorial description of the asset content, providing context for search, discovery, and editorial use. Includes scene description, key subjects, and contextual notes as entered by the content team in Dalet Galaxy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastChannel rdf:type rdf:Property ;
    rdfs:label 'Broadcast Channel' ;
    rdfs:comment 'Name or identifier of the broadcast or OTT channel for which this asset was primarily produced or first aired (e.g., ESPN, TNT, NBC Sports, league OTT platform). Used for broadcast rights attribution and RSN (Regional Sports Network) distribution tracking.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdnUrl rdf:type rdf:Property ;
    rdfs:label 'Cdn Url' ;
    rdfs:comment 'Primary CDN (Content Delivery Network) delivery URL for the published asset. Used by OTT platforms, digital channels, and social media integrations to stream or download the asset. Null if the asset has not been published to CDN.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:damAssetReference rdf:type rdf:Property ;
    rdfs:label 'Dam Asset Reference' ;
    rdfs:comment 'Native asset identifier assigned by Dalet Galaxy DAM system. Used for cross-system reconciliation and direct lookup within the DAM platform.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmStatus rdf:type rdf:Property ;
    rdfs:label 'Drm Status' ;
    rdfs:comment 'Current rights clearance status of the asset under the DRM framework. Controls whether the asset can be distributed via OTT, broadcast, or social channels. Cleared = fully rights-cleared for distribution; Embargoed = time-restricted; Expired = rights window has lapsed.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileFormat rdf:type rdf:Property ;
    rdfs:label 'File Format' ;
    rdfs:comment 'Technical file format or container format of the primary media file (e.g., MP4, MXF for broadcast video, WAV for audio, JPEG/PNG for photography). Drives transcoding workflow selection and CDN delivery profile assignment. [ENUM-REF-CANDIDATE: MP4|MOV|MXF|WAV|MP3|JPEG|PNG|PDF|XML|JSON — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileName rdf:type rdf:Property ;
    rdfs:label 'File Name' ;
    rdfs:comment 'Original file name of the primary media file as ingested into Dalet Galaxy DAM. Used for file-level traceability, deduplication checks, and storage management.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileSizeBytes rdf:type rdf:Property ;
    rdfs:label 'File Size Bytes' ;
    rdfs:comment 'Size of the primary media file in bytes as stored in Dalet Galaxy DAM. Used for storage capacity planning, CDN bandwidth estimation, and ingest SLA monitoring.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isLiveClip rdf:type rdf:Property ;
    rdfs:label 'Is Live Clip' ;
    rdfs:comment 'Indicates whether this asset was captured or clipped from a live broadcast event (e.g., live match highlight, live concert clip). Drives near-real-time CDN distribution workflows and live rights clearance checks.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPpvRestricted rdf:type rdf:Property ;
    rdfs:label 'Is Ppv Restricted' ;
    rdfs:comment 'Indicates whether this asset is associated with a Pay-Per-View (PPV) event and subject to PPV access restrictions. When true, distribution is gated behind PPV entitlement checks at the OTT and digital platform layer.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isUgc rdf:type rdf:Property ;
    rdfs:label 'Is Ugc' ;
    rdfs:comment 'Indicates whether this asset was submitted as User-Generated Content (UGC) by a fan or external contributor rather than produced by the organisation\'s internal content team. UGC assets require additional rights clearance and moderation workflows.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lifecycleStatus rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Status' ;
    rdfs:comment 'Current state of the asset within the content production and distribution lifecycle managed in Dalet Galaxy. Controls editorial workflow progression, rights enforcement, and CDN availability. [ENUM-REF-CANDIDATE: draft|ingest|review|approved|published|archived|deleted|quarantined — promote to reference product if additional states are required]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsOwner rdf:type rdf:Property ;
    rdfs:label 'Rights Owner' ;
    rdfs:comment 'Name of the entity that holds the intellectual property (IP) rights for this asset (e.g., league name, broadcaster, production company, athlete NIL rights holder). Determines licensing obligations and revenue share arrangements.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsType rdf:type rdf:Property ;
    rdfs:label 'Rights Type' ;
    rdfs:comment 'Classification of the media rights granted for this asset. Determines which distribution channels are permitted. NIL refers to Name, Image, and Likeness rights for athlete-associated content. [ENUM-REF-CANDIDATE: broadcast|ott|social|editorial|all_media|nil|ppv|archive — promote to reference product]' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storagePath rdf:type rdf:Property ;
    rdfs:label 'Storage Path' ;
    rdfs:comment 'Internal storage path or object storage URI (e.g., S3 bucket path, NAS mount path) where the master media file is archived in the DAM storage tier. Used for file retrieval, backup verification, and disaster recovery operations.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subtype rdf:type rdf:Property ;
    rdfs:label 'Subtype' ;
    rdfs:comment 'Secondary classification providing granular categorisation within the asset type (e.g., highlight_clip, press_photo, podcast_episode, match_report, story_reel, fan_submission). Supports editorial workflow segmentation and metadata-driven distribution rules. [ENUM-REF-CANDIDATE: highlight_clip|full_match|press_photo|podcast_episode|match_report|story_reel|fan_submission|interview|promo_spot|behind_scenes — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagsKeywords rdf:type rdf:Property ;
    rdfs:label 'Tags Keywords' ;
    rdfs:comment 'Comma-separated list of editorial metadata tags and keywords associated with the asset (e.g., athlete names, team names, event names, competition rounds). Supports full-text search, AI/ML content recommendation, and Adobe Experience Platform personalisation.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thumbnailUrl rdf:type rdf:Property ;
    rdfs:label 'Thumbnail Url' ;
    rdfs:comment 'URL of the representative thumbnail image for the asset, used in DAM browse interfaces, OTT content catalogues, and digital platform content cards. Auto-generated or manually selected by the editorial team.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetUsageId rdf:type rdf:Property ;
    rdfs:label 'Asset Usage Id' ;
    rdfs:comment 'Unique surrogate identifier for each content asset usage instance recorded in the Dalet Galaxy Digital Asset Management (DAM) system. Primary key for the asset_usage transactional record.' ;
    rdfs:domain ind:AssetUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approverEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approver Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Asset usage approval is a named rights management process requiring employee audit trail for royalty calculations, compliance reporting, and rights holder accountability. The existing \'approved_by\' pl' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:broadcastSegmentId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Segment Id' ;
    rdfs:comment 'Reference to the specific broadcast segment or rundown slot in which this asset was aired. Links to the broadcast scheduling system within Dalet Galaxy to support Outside Broadcast (OB) and live event rights compliance tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Segment .

ind:contestId rdf:type rdf:Property ;
    rdfs:label 'Contest Id' ;
    rdfs:comment 'Foreign key linking to gaming.contest. Business justification: Rights and royalty tracking: content assets (player headshots, highlight clips) used within DFS contest interfaces require usage rights tracking per contest. asset_usage records the specific contest c' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contest .

ind:productionOrderId rdf:type rdf:Property ;
    rdfs:label 'Production Order Id' ;
    rdfs:comment 'Reference to the production order or broadcast workflow job within which this asset was consumed or reused. Applicable when usage context is a broadcast segment or content production workflow managed in Dalet Galaxy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProductionOrder .

ind:socialPostId rdf:type rdf:Property ;
    rdfs:label 'Social Post Id' ;
    rdfs:comment 'Reference to the social media post in which this content asset was published or embedded. Applicable when usage_type is social_post. Enables tracking of asset usage across social channels for rights compliance and fan engagement analytics via Adobe Experience Platform.' ;
    rdfs:domain ind:AssetUsage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Post .

ind:isRightsExpired rdf:type rdf:Property ;
    rdfs:label 'Is Rights Expired' ;
    rdfs:comment 'Indicates whether the Digital Rights Management (DRM) rights window for this usage instance has expired at the time of the record. A True value triggers a compliance alert and may require takedown action. Supports automated rights expiry monitoring.' ;
    rdfs:domain ind:AssetUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rightsClearanceDate rdf:type rdf:Property ;
    rdfs:label 'Rights Clearance Date' ;
    rdfs:comment 'The date on which Digital Rights Management (DRM) clearance was formally granted for this usage instance. Used in rights compliance audit trails and royalty calculation workflows.' ;
    rdfs:domain ind:AssetUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rightsClearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Rights Clearance Status' ;
    rdfs:comment 'Indicates whether Digital Rights Management (DRM) clearance has been obtained for this specific usage instance. Cleared means rights are confirmed; pending_clearance means awaiting licensor approval; not_required means the asset is owned outright or is public domain; blocked means usage is prohibited; expired means the rights window has lapsed.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsHolderName rdf:type rdf:Property ;
    rdfs:label 'Rights Holder Name' ;
    rdfs:comment 'The name of the entity or individual holding the intellectual property (IP) rights for the content asset used in this instance (e.g., league, athlete, broadcaster, music label). Used in royalty payable processing and rights compliance audit trails. Confidential as it reflects contractual counterparty information.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Royalty Amount' ;
    rdfs:comment 'The calculated royalty amount payable to the rights holder for this specific usage instance, expressed in the transaction currency. Feeds the royalty payable ledger in SAP S/4HANA FI/CO. Confidential as it reflects financial obligations under negotiated agreements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:royaltyApplicable rdf:type rdf:Property ;
    rdfs:label 'Royalty Applicable' ;
    rdfs:comment 'Indicates whether this usage instance triggers a royalty obligation to a rights holder (athlete, league, licensor, or music rights body). When True, the usage record feeds the royalty calculation process in SAP S/4HANA FI/CO.' ;
    rdfs:domain ind:AssetUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timecodeIn rdf:type rdf:Property ;
    rdfs:label 'Timecode In' ;
    rdfs:comment 'SMPTE timecode marking the start point of the asset segment used in this instance (format HH:MM:SS:FF). Sourced from Dalet Galaxy DAM and used for precise clip-level rights compliance auditing and broadcast segment identification.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timecodeOut rdf:type rdf:Property ;
    rdfs:label 'Timecode Out' ;
    rdfs:comment 'SMPTE timecode marking the end point of the asset segment used in this instance (format HH:MM:SS:FF). Used in conjunction with timecode_in to define the exact clip range consumed, enabling sub-asset rights compliance validation.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageContextNotes rdf:type rdf:Property ;
    rdfs:label 'Usage Context Notes' ;
    rdfs:comment 'Free-text field capturing additional context about how the content asset was used in this instance — for example, editorial justification, special clearance notes, or sponsor-specific usage instructions. Supports rights compliance audit documentation.' ;
    rdfs:domain ind:AssetUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageDate rdf:type rdf:Property ;
    rdfs:label 'Usage Date' ;
    rdfs:comment 'Calendar date on which the content asset was used or published. Used for day-level reporting, royalty period aggregation, and rights window compliance checks where day-level granularity is sufficient (e.g., social post date, editorial publish date).' ;
    rdfs:domain ind:AssetUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:usageDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Usage Duration Seconds' ;
    rdfs:comment 'The total duration in seconds for which the content asset was used or played in this usage instance. Applicable for video, audio, and broadcast assets. Used for rights compliance validation (e.g., clip length restrictions) and royalty calculation based on time-based licensing.' ;
    rdfs:domain ind:AssetUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:usageEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Usage End Timestamp' ;
    rdfs:comment 'The precise date and time when the content asset usage instance concluded. Used in conjunction with usage_start_timestamp to calculate total usage duration and validate against the licensed rights window expiry.' ;
    rdfs:domain ind:AssetUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:usageReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Usage Reference Number' ;
    rdfs:comment 'Externally-known business identifier for this usage instance, generated by the Dalet Galaxy DAM workflow engine. Used in rights compliance audits, royalty calculation invoices, and cross-system reconciliation with SAP S/4HANA SD module.' ;
    rdfs:domain ind:AssetUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Usage Start Timestamp' ;
    rdfs:comment 'The precise date and time when the content asset usage instance began — i.e., when the asset was first consumed, broadcast, published, or activated in the associated production order, broadcast segment, social post, or sponsorship activation. This is the principal business event timestamp for rights window validation.' ;
    rdfs:domain ind:AssetUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:usageStatus rdf:type rdf:Property ;
    rdfs:label 'Usage Status' ;
    rdfs:comment 'Current lifecycle state of this asset usage record. Drives rights compliance workflow: pending awaits rights clearance, approved is cleared for use, active is currently in distribution, completed is archived, disputed is under rights challenge, revoked indicates a takedown or rights violation.' ;
    rdfs:domain ind:AssetUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageType rdf:type rdf:Property ;
    rdfs:label 'Usage Type' ;
    rdfs:comment 'Classification of how the content asset was used in this instance. Determines applicable royalty rate and rights compliance rules. [ENUM-REF-CANDIDATE: broadcast|social_post|sponsorship_activation|editorial|ugc_reuse|highlight_clip|ott_stream|press_release|merchandise|archive — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ingestJobId rdf:type rdf:Property ;
    rdfs:label 'Ingest Job Id' ;
    rdfs:comment 'Foreign key linking to content.ingest_job. Business justification: An asset version is created as a result of an ingest job. Linking asset_version to the originating ingest_job provides full provenance — which ingest event produced this rendition, enabling quality co' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IngestJob .

ind:qcReviewerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Qc Reviewer Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: QC review of transcoded asset versions is a named operational process in broadcast/content operations. Tracking which employee performed QC review supports compliance audits, SLA reporting, and qualit' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:sourceVersionAssetVersionId rdf:type rdf:Property ;
    rdfs:label 'Source Version Asset Version Id' ;
    rdfs:comment 'Reference to the parent asset version from which this version was derived or transcoded (e.g., a social-cut derived from a broadcast master). Enables version lineage and derivation chain tracking within the DAM.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AssetVersion .

ind:transcodingVendorId rdf:type rdf:Property ;
    rdfs:label 'Transcoding Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: Transcoding and encoding of asset versions is routinely outsourced to specialist vendors (e.g., Harmonic, Telestream). Linking each asset_version to its transcoding vendor enables quality defect attri' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:audioChannelCount rdf:type rdf:Property ;
    rdfs:label 'Audio Channel Count' ;
    rdfs:comment 'Number of discrete audio channels in this asset version (e.g., 1 for mono, 2 for stereo, 6 for 5.1 surround, 8 for 7.1 surround). Required for broadcast playout configuration and OTT audio track routing.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:audioCodec rdf:type rdf:Property ;
    rdfs:label 'Audio Codec' ;
    rdfs:comment 'Audio codec used to encode the audio track(s) within this asset version (e.g., AAC, PCM, MP3, AC-3/Dolby Digital, E-AC-3/Dolby Digital Plus, FLAC). Determines broadcast playout compatibility and OTT audio quality.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:audioSampleRateHz rdf:type rdf:Property ;
    rdfs:label 'Audio Sample Rate Hz' ;
    rdfs:comment 'Audio sampling rate in Hertz (Hz) for this asset version (e.g., 44100 for CD quality, 48000 for broadcast standard). Broadcast and OTT delivery typically require 48,000 Hz per EBU and SMPTE standards.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cdnPath rdf:type rdf:Property ;
    rdfs:label 'Cdn Path' ;
    rdfs:comment 'The Content Delivery Network (CDN) delivery path or URL segment for this asset version, used to construct the public-facing streaming or download URL. Classified confidential as it reveals CDN infrastructure topology and content routing.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checksumMd5 rdf:type rdf:Property ;
    rdfs:label 'Checksum Md5' ;
    rdfs:comment 'MD5 hash checksum of the asset version file used to verify file integrity during ingest, transfer, and archival operations. Enables detection of file corruption or unauthorised modification across the content supply chain.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedCaptionFlag rdf:type rdf:Property ;
    rdfs:label 'Closed Caption Flag' ;
    rdfs:comment 'Indicates whether this asset version contains an embedded closed-caption or subtitle track meeting ADA and FCC accessibility compliance requirements. True = closed captions present; False = no closed captions. Required for broadcast and OTT regulatory compliance.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:containerFormat rdf:type rdf:Property ;
    rdfs:label 'Container Format' ;
    rdfs:comment 'Media container format wrapping the encoded video and audio streams for this asset version (e.g., MP4, MOV, MXF, TS). Determines compatibility with broadcast ingest systems, OTT platforms, and CDN delivery infrastructure.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daletVersionReference rdf:type rdf:Property ;
    rdfs:label 'Dalet Version Reference' ;
    rdfs:comment 'The native version identifier assigned by the Dalet Galaxy Digital Asset Management (DAM) system. Used for cross-system reconciliation and traceability back to the source system of record.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryStatus rdf:type rdf:Property ;
    rdfs:label 'Delivery Status' ;
    rdfs:comment 'Current distribution status of this asset version across its target delivery channels (CDN, OTT, broadcast). Indicates whether the version has been successfully pushed to downstream distribution endpoints or is pending, failed, or recalled.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmScheme rdf:type rdf:Property ;
    rdfs:label 'Drm Scheme' ;
    rdfs:comment 'Digital Rights Management (DRM) encryption scheme applied to this asset version for rights protection during OTT and digital distribution (e.g., Widevine for Android/Chrome, FairPlay for Apple, PlayReady for Microsoft). \'none\' indicates unencrypted internal/proxy versions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encodingProfileCode rdf:type rdf:Property ;
    rdfs:label 'Encoding Profile Code' ;
    rdfs:comment 'Reference to the encoding profile configuration used to transcode this asset version, defining the target codec, bitrate ladder, resolution, and container format parameters. Links to the encoding profile reference product.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hdrStandard rdf:type rdf:Property ;
    rdfs:label 'Hdr Standard' ;
    rdfs:comment 'High Dynamic Range (HDR) standard applied to this asset version (e.g., HDR10, HLG for broadcast, Dolby Vision for premium OTT). \'SDR\' indicates standard dynamic range. Determines compatibility with premium broadcast and OTT delivery tiers.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryVersion rdf:type rdf:Property ;
    rdfs:label 'Is Primary Version' ;
    rdfs:comment 'Indicates whether this version is designated as the primary/canonical version of the parent asset for a given rendition type. True = primary version used for default delivery; False = alternate or superseded version. Supports version selection logic in delivery workflows.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Modified Timestamp' ;
    rdfs:comment 'Date and time when this asset version record was last updated in the Dalet Galaxy DAM system. Used for incremental data pipeline processing, change detection, and audit trail maintenance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:renditionType rdf:type rdf:Property ;
    rdfs:label 'Rendition Type' ;
    rdfs:comment 'Classification of the version rendition purpose within the content delivery chain. Proxy: low-resolution review copy; Mezzanine: intermediate editing master; Broadcast Master: broadcast-quality final; Social Cut: platform-optimised social media version; Thumbnail: still image preview; Audio Only: audio-only extract.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionHeightPx rdf:type rdf:Property ;
    rdfs:label 'Resolution Height Px' ;
    rdfs:comment 'Vertical pixel dimension of the video frame for this asset version (e.g., 1080 for Full HD, 2160 for 4K UHD, 720 for HD, 360 for proxy). Used alongside resolution_width_px to fully qualify the frame resolution for delivery channel routing.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resolutionWidthPx rdf:type rdf:Property ;
    rdfs:label 'Resolution Width Px' ;
    rdfs:comment 'Horizontal pixel dimension of the video frame for this asset version (e.g., 1920 for Full HD, 3840 for 4K UHD, 1280 for HD, 640 for proxy). Used for delivery channel qualification and broadcast compliance.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:storageTier rdf:type rdf:Property ;
    rdfs:label 'Storage Tier' ;
    rdfs:comment 'Storage tier classification for this asset version based on access frequency and retention requirements. Hot: active production use; Warm: recent but less frequent access; Cold: infrequent access; Archive: long-term retention. Drives storage cost optimisation decisions.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageUri rdf:type rdf:Property ;
    rdfs:label 'Storage Uri' ;
    rdfs:comment 'Full storage path or URI pointing to the physical location of this asset version file (e.g., s3://sports-ent-dam/content/2024/highlights/v2/file.mxf, or NAS/SAN path). Classified confidential as it reveals internal infrastructure topology.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subtitleLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Subtitle Language Code' ;
    rdfs:comment 'Language of embedded or associated subtitle/closed-caption track for this asset version, expressed as an IETF BCP 47 language tag. Supports ADA closed-captioning compliance and international OTT distribution requirements.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transcodingCompletedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transcoding Completed Timestamp' ;
    rdfs:comment 'Date and time when the transcoding job for this asset version was successfully completed. Used alongside transcoding_started_timestamp to calculate transcoding duration for SLA compliance and capacity planning.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:transcodingErrorMessage rdf:type rdf:Property ;
    rdfs:label 'Transcoding Error Message' ;
    rdfs:comment 'Error message or failure reason captured when the transcoding job for this asset version fails (transcoding_status = \'failed\'). Used for operational troubleshooting, SLA breach root-cause analysis, and automated retry logic.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transcodingStartedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transcoding Started Timestamp' ;
    rdfs:comment 'Date and time when the transcoding job for this asset version was initiated in the Dalet Galaxy transcoding workflow. Used for SLA monitoring, job queue performance analysis, and delivery timeline tracking.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:transcodingStatus rdf:type rdf:Property ;
    rdfs:label 'Transcoding Status' ;
    rdfs:comment 'Current lifecycle status of the transcoding workflow for this asset version. Tracks the progression from pending job submission through active transcoding to completion, failure, or cancellation. Critical for CDN and OTT delivery readiness monitoring.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionLabel rdf:type rdf:Property ;
    rdfs:label 'Version Label' ;
    rdfs:comment 'Human-readable label identifying this version rendition (e.g., \'v1-broadcast-master\', \'v2-social-cut-instagram\', \'v3-proxy-review\'). Supports editorial workflow communication and delivery tracking.' ;
    rdfs:domain ind:AssetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approved By User Employee Id' ;
    rdfs:comment 'Reference to the internal user (content manager or rights officer) who approved this collection for publication. Supports editorial governance, rights clearance accountability, and SOX audit trail requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:brandSponsorId rdf:type rdf:Property ;
    rdfs:label 'Brand Sponsor Id' ;
    rdfs:comment 'Reference to the sponsoring brand or commercial partner associated with this collection for branded content packages. Supports sponsorship attribution, revenue reporting, and DRM rights enforcement.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Sponsor .

ind:collectionApprovedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Collection Approved By User Employee Id' ;
    rdfs:comment 'Reference to the internal user (content manager or rights officer) who approved this collection for publication. Supports editorial governance, rights clearance accountability, and SOX audit trail requirements.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:collectionEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Collection Employee Id' ;
    rdfs:comment 'Reference to the internal user (editor, producer, or system account) who originally created this collection record in the DAM system. Supports editorial accountability and content governance auditing.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryMetadataTagId rdf:type rdf:Property ;
    rdfs:label 'Primary Metadata Tag Id' ;
    rdfs:comment 'Foreign key linking to content.metadata_tag. Business justification: A collection is classified under a primary taxonomy tag (e.g., \'Premier League Highlights\', \'Tennis\', \'Match Day\'). This FK normalizes the collection\'s primary content classification and gives metadat' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MetadataTag .

ind:targetFanSegmentId rdf:type rdf:Property ;
    rdfs:label 'Target Fan Segment Id' ;
    rdfs:comment 'Foreign key linking to fan.segment. Business justification: Segment-targeted content curation: sports entertainment platforms curate content collections for specific fan segments (e.g., \'VIP members exclusive\', \'lapsed fans re-engagement\'). Linking collection ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SportsEntertainment .

ind:archivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Archived Timestamp' ;
    rdfs:comment 'The date and time at which this collection was moved to archived status, removing it from active distribution channels. Supports rights window enforcement and content lifecycle management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cdnManifestUrl rdf:type rdf:Property ;
    rdfs:label 'Cdn Manifest Url' ;
    rdfs:comment 'The CDN-hosted manifest URL (e.g., HLS/DASH playlist) for streaming delivery of this collection to OTT and digital platforms. Populated upon publication approval.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionDescription rdf:type rdf:Property ;
    rdfs:label 'Collection Description' ;
    rdfs:comment 'Long-form editorial description of the collection\'s content, context, and purpose. Displayed on OTT platforms, digital storefronts, and fan engagement interfaces to drive discovery and engagement.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionType rdf:type rdf:Property ;
    rdfs:label 'Collection Type' ;
    rdfs:comment 'Categorical classification of the collection defining its structural and commercial purpose. [ENUM-REF-CANDIDATE: highlight_reel|playlist|photo_gallery|branded_package|ppv_bundle|editorial_series|audio_album|ugc_compilation — promote to reference product]' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curationMethod rdf:type rdf:Property ;
    rdfs:label 'Curation Method' ;
    rdfs:comment 'Indicates whether the collection was assembled by human editorial staff, an algorithmic recommendation engine, a hybrid of both, or automated business rules. Drives content governance and quality review workflows.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:damCollectionCode rdf:type rdf:Property ;
    rdfs:label 'Dam Collection Code' ;
    rdfs:comment 'Externally-known unique business identifier for the collection as assigned by the Dalet Galaxy DAM system. Used for cross-system reference, API lookups, and CDN manifest identification.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:damVersionNumber rdf:type rdf:Property ;
    rdfs:label 'Dam Version Number' ;
    rdfs:comment 'Incremental version counter for this collection record as tracked in the Dalet Galaxy DAM system. Supports optimistic concurrency control, change history auditing, and rollback capabilities.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isFeatured rdf:type rdf:Property ;
    rdfs:label 'Is Featured' ;
    rdfs:comment 'Indicates whether this collection is designated as a featured or promoted collection on OTT homepages, digital storefronts, or fan engagement platform carousels. Drives editorial merchandising and fan experience design.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:moderationStatus rdf:type rdf:Property ;
    rdfs:label 'Moderation Status' ;
    rdfs:comment 'Current moderation review state for collections containing UGC or community-sourced content. Ensures brand safety and regulatory compliance before publication on fan-facing platforms.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContentFormat rdf:type rdf:Property ;
    rdfs:label 'Primary Content Format' ;
    rdfs:comment 'Dominant media format of assets within the collection. Determines rendering templates, CDN delivery profiles, and platform compatibility requirements.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publishStatus rdf:type rdf:Property ;
    rdfs:label 'Publish Status' ;
    rdfs:comment 'Current lifecycle state of the collection within the content production and distribution workflow. Controls visibility on OTT and digital platforms. [ENUM-REF-CANDIDATE: draft|pending_review|approved|published|scheduled|archived|withdrawn|embargoed — promote to reference product]' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsTerritoryCodes rdf:type rdf:Property ;
    rdfs:label 'Rights Territory Codes' ;
    rdfs:comment 'Pipe-delimited list of ISO 3166-1 alpha-3 country codes defining the geographic territories where this collection is licensed for distribution (e.g., \'USA|CAN|GBR\'). Drives geo-blocking and CDN routing logic.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rsnDistributionFlag rdf:type rdf:Property ;
    rdfs:label 'Rsn Distribution Flag' ;
    rdfs:comment 'Indicates whether this collection is cleared for distribution via Regional Sports Networks (RSN). Governs blackout rules and territorial broadcast rights compliance.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledPublishTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Publish Timestamp' ;
    rdfs:comment 'The planned date and time at which this collection is scheduled to be automatically published to OTT and digital platforms. Supports embargo management and coordinated multi-platform release strategies.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:seoKeywords rdf:type rdf:Property ;
    rdfs:label 'Seo Keywords' ;
    rdfs:comment 'Comma-separated list of SEO keywords and metadata tags associated with this collection for search discoverability on digital platforms, OTT storefronts, and web search engines.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortDescription rdf:type rdf:Property ;
    rdfs:label 'Short Description' ;
    rdfs:comment 'Concise summary (typically 160 characters or fewer) of the collection used for social media previews, push notifications, and mobile platform display cards.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slug rdf:type rdf:Property ;
    rdfs:label 'Slug' ;
    rdfs:comment 'URL-safe, lowercase hyphenated identifier used for deep-linking and SEO-friendly routing on digital platforms and CDN-delivered pages.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialChannelCodes rdf:type rdf:Property ;
    rdfs:label 'Social Channel Codes' ;
    rdfs:comment 'Pipe-delimited list of social media channel identifiers where this collection is approved for distribution (e.g., \'YOUTUBE|INSTAGRAM|TIKTOK|TWITTER\'). Supports social content rights and distribution tracking.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportCategory rdf:type rdf:Property ;
    rdfs:label 'Sport Category' ;
    rdfs:comment 'The sport or entertainment category associated with the collection content (e.g., NFL, NBA, FIFA, UFC, Concert, Esports). Drives taxonomy tagging, rights management, and audience targeting on fan engagement platforms. [ENUM-REF-CANDIDATE: NFL|NBA|MLB|NHL|MLS|FIFA|UFC|ATP|Olympics|Concert|Esports|Other — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thumbnailAssetCode rdf:type rdf:Property ;
    rdfs:label 'Thumbnail Asset Code' ;
    rdfs:comment 'DAM asset code referencing the primary thumbnail or cover image used to represent this collection on OTT platforms, digital storefronts, and social media channels.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Total Duration Seconds' ;
    rdfs:comment 'Aggregate playback duration of all video and audio assets within the collection, expressed in seconds. Used for OTT platform display, broadcast scheduling, and PPV event bundle packaging.' ;
    rdfs:domain ind:Collection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByPolicyContentDrmPolicyId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Policy Content Drm Policy Id' ;
    rdfs:comment 'Reference to the content_drm_policy_id of the newer policy that replaces this one when status is \'deprecated\'. Enables policy lineage tracking and ensures content operations teams can identify the current active replacement policy.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContentDrmPolicy .

ind:allowedDeviceTypes rdf:type rdf:Property ;
    rdfs:label 'Allowed Device Types' ;
    rdfs:comment 'Comma-separated list of device categories permitted for playback under this DRM policy (e.g., \'mobile,tablet,smart_tv,web,stb,gaming_console\'). Null indicates all device types are permitted. Enforces device-level access restrictions per rights agreements and platform licensing terms.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowedTerritoryCodes rdf:type rdf:Property ;
    rdfs:label 'Allowed Territory Codes' ;
    rdfs:comment 'Comma-separated list of ISO 3166-1 alpha-3 country codes where content playback is permitted under this DRM policy (e.g., \'USA,CAN,GBR\'). Null indicates no territory allowlist (use blocked_territory_codes instead). Enforces broadcast rights territorial boundaries for RSN, OTT, and international distribution.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:antiPiracyLevel rdf:type rdf:Property ;
    rdfs:label 'Anti Piracy Level' ;
    rdfs:comment 'Tiered classification of the anti-piracy enforcement intensity applied under this DRM policy. \'standard\' = baseline DRM encryption; \'enhanced\' = DRM + watermarking + CDN token auth; \'maximum\' = all protections including forensic watermarking, screen capture blocking, and real-time piracy monitoring. Aligns with content value and rights holder requirements.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockedTerritoryCodes rdf:type rdf:Property ;
    rdfs:label 'Blocked Territory Codes' ;
    rdfs:comment 'Comma-separated list of ISO 3166-1 alpha-3 country codes where content playback is explicitly blocked under this DRM policy (e.g., \'CHN,PRK\'). Used as a denylist when most territories are permitted but specific markets are excluded due to rights restrictions or regulatory requirements.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdnTokenAuthEnabled rdf:type rdf:Property ;
    rdfs:label 'Cdn Token Auth Enabled' ;
    rdfs:comment 'Indicates whether CDN-level token authentication is required for content delivery under this DRM policy. When True, signed URL tokens are required to access content from the CDN, providing an additional security layer beyond DRM license enforcement.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contentRatingRestriction rdf:type rdf:Property ;
    rdfs:label 'Content Rating Restriction' ;
    rdfs:comment 'Minimum content rating classification that this DRM policy is authorized to protect and distribute. Ensures age-appropriate access controls are enforced alongside DRM protections. Aligns with FCC content rating standards for broadcast and OTT platforms. [ENUM-REF-CANDIDATE: G|PG|PG-13|R|NC-17|TV-Y|TV-G|TV-PG|TV-14|TV-MA — promote to reference product]' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmSystem rdf:type rdf:Property ;
    rdfs:label 'Drm System' ;
    rdfs:comment 'The DRM technology system used to enforce license-based playback protection. \'Widevine\' = Google/Android/Chrome; \'PlayReady\' = Microsoft/Xbox; \'FairPlay\' = Apple/iOS/tvOS; \'multi_drm\' = simultaneous multi-system packaging for cross-platform OTT distribution.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encryptionScheme rdf:type rdf:Property ;
    rdfs:label 'Encryption Scheme' ;
    rdfs:comment 'Cryptographic encryption standard applied to content packages under this DRM policy. \'CENC\' (Common Encryption) and \'CBCS\' are ISO 23001-7 standards used for multi-DRM packaging across Widevine, PlayReady, and FairPlay systems. Governs how content is encrypted at the CDN packaging layer.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geoBlockingEnabled rdf:type rdf:Property ;
    rdfs:label 'Geo Blocking Enabled' ;
    rdfs:comment 'Indicates whether geographic access restrictions are enforced under this DRM policy. When True, the allowed_territory_codes and blocked_territory_codes fields define the geographic enforcement scope. Critical for RSN blackout rules, international broadcast rights, and FIFA/IOC territorial licensing.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'License Duration Seconds' ;
    rdfs:comment 'Maximum duration in seconds for which a DRM license issued under this policy remains valid for playback. Controls license renewal frequency and session persistence. A value of 0 indicates a persistent license with no expiry. Critical for PPV and live event access control.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:licenseRenewalType rdf:type rdf:Property ;
    rdfs:label 'License Renewal Type' ;
    rdfs:comment 'Defines the license persistence and renewal behavior for content playback under this DRM policy. \'persistent\' = license stored on device across sessions; \'session\' = license valid only for current playback session; \'renewable\' = license auto-renews before expiry; \'non_renewable\' = single-use license.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxResolution rdf:type rdf:Property ;
    rdfs:label 'Max Resolution' ;
    rdfs:comment 'Maximum video resolution permitted for playback under this DRM policy. \'SD\' = Standard Definition (up to 480p); \'HD\' = High Definition (720p); \'FHD\' = Full HD (1080p); \'UHD_4K\' = Ultra HD 4K (2160p); \'UHD_8K\' = Ultra HD 8K. Enforces resolution caps based on subscription tier and device security level.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offlineDownloadEnabled rdf:type rdf:Property ;
    rdfs:label 'Offline Download Enabled' ;
    rdfs:comment 'Indicates whether this DRM policy permits subscribers to download content for offline playback on authorized devices. When True, offline_download_expiry_hours governs the download window. Governed by rights agreements and CBA terms for league content.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:offlineDownloadExpiryHours rdf:type rdf:Property ;
    rdfs:label 'Offline Download Expiry Hours' ;
    rdfs:comment 'Number of hours after which an offline downloaded content license expires and the content becomes unplayable without re-authentication. Null when offline_download_enabled is False. Enforces time-limited offline access per rights agreements.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outputProtectionLevel rdf:type rdf:Property ;
    rdfs:label 'Output Protection Level' ;
    rdfs:comment 'Hardware output protection standard required on playback devices under this DRM policy. \'hdcp_1x\' / \'hdcp_2x\' = High-bandwidth Digital Content Protection for HDMI/DisplayPort; \'cgms_a\' = Copy Generation Management System for analog outputs; \'macrovision\' = legacy analog copy protection. Governs content security on connected TV and set-top box devices.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseWindowHours rdf:type rdf:Property ;
    rdfs:label 'Purchase Window Hours' ;
    rdfs:comment 'Number of hours from license issuance within which the subscriber must initiate first playback before the license expires unused. Null for subscription-based policies. Enforces time-to-first-play restrictions on transactional DTC content purchases.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rentalWindowHours rdf:type rdf:Property ;
    rdfs:label 'Rental Window Hours' ;
    rdfs:comment 'Number of hours from first playback initiation during which the content remains accessible under a rental or PPV license. Null for subscription-based or permanent access policies. Applies to PPV event replays and transactional VOD content.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rightsClearanceReference rdf:type rdf:Property ;
    rdfs:label 'Rights Clearance Reference' ;
    rdfs:comment 'Reference number or identifier linking this DRM policy to the underlying rights clearance agreement or contract in the rights management system. Enables audit traceability between DRM enforcement rules and the legal rights instruments that authorize them. Confidential business data.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriberTierRestriction rdf:type rdf:Property ;
    rdfs:label 'Subscriber Tier Restriction' ;
    rdfs:comment 'Minimum subscription tier required to receive a DRM license under this policy. \'all\' = no tier restriction; \'basic\' = entry-level subscription; \'standard\' = mid-tier; \'premium\' = top-tier subscription; \'vip\' = VIP/exclusive access; \'ppv_only\' = Pay-Per-View (PPV) purchase required. Enforced at license issuance by the entitlement system.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watermarkingEnabled rdf:type rdf:Property ;
    rdfs:label 'Watermarking Enabled' ;
    rdfs:comment 'Indicates whether forensic or visible watermarking is applied to content distributed under this DRM policy. Watermarking enables source tracing for piracy detection and leak attribution. Critical for PPV events, premium OTT content, and broadcast feeds.' ;
    rdfs:domain ind:ContentDrmPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creatorProfileId rdf:type rdf:Property ;
    rdfs:label 'Creator Profile Id' ;
    rdfs:comment 'Reference to the party (league, broadcaster, athlete, club, or media company) that holds the intellectual property rights for the content covered by this distribution window. The rights holder is the authorizing party for clearance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CreatorProfile .

ind:primaryContentAssetId rdf:type rdf:Property ;
    rdfs:label 'Primary Content Asset Id' ;
    rdfs:comment 'Reference to the content asset (video highlight, photography, audio, editorial, UGC, or social media asset) for which this rights window is defined. Sourced from Dalet Galaxy DAM asset registry.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:primaryContentCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Primary Content Corporate Entity Id' ;
    rdfs:comment 'Reference to the party (league, broadcaster, athlete, club, or media company) that holds the intellectual property rights for the content covered by this distribution window. The rights holder is the authorizing party for clearance.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:territoryId rdf:type rdf:Property ;
    rdfs:label 'Territory Id' ;
    rdfs:comment 'Reference to the geographic territory or market in which this rights window is valid. Territories are defined per contracted rights and may align with broadcast regions, national boundaries, or league-defined zones.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Territory .

ind:adInsertionPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Ad Insertion Permitted Flag' ;
    rdfs:comment 'Indicates whether dynamic ad insertion (DAI) is contractually permitted for content distributed under this rights window. True = ad insertion allowed; False = ad-free distribution required (e.g., subscription-only OTT tiers or PPV events).' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cdnDeliveryProfileCode rdf:type rdf:Property ;
    rdfs:label 'Cdn Delivery Profile Code' ;
    rdfs:comment 'Code identifying the CDN delivery profile configuration used to distribute content under this rights window. Determines CDN routing, caching rules, and geographic delivery nodes. Sourced from the CDN management platform.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clipRestrictionMinutes rdf:type rdf:Property ;
    rdfs:label 'Clip Restriction Minutes' ;
    rdfs:comment 'Maximum duration in minutes of content clips that may be extracted and distributed (e.g., on social media or editorial platforms) under this rights window. Null indicates no clip duration restriction. Common in league highlight rights agreements.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contentRatingCode rdf:type rdf:Property ;
    rdfs:label 'Content Rating Code' ;
    rdfs:comment 'Age/audience rating classification code applicable to the content in the distribution territory (e.g., TV-G, TV-PG, TV-14, TV-MA for US; BBFC U/PG/12/15/18 for UK). Governs scheduling restrictions and parental control enforcement on distribution platforms.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionStatus rdf:type rdf:Property ;
    rdfs:label 'Distribution Status' ;
    rdfs:comment 'Current operational state of this distribution window record. Tracks whether the asset is actively available, suspended, scheduled, or expired on this channel.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:downloadPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Download Permitted Flag' ;
    rdfs:comment 'Indicates whether offline download of the content is permitted under this rights window. True = download allowed (subject to DRM policy); False = streaming only, no offline download permitted.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:embargoEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Embargo End Datetime' ;
    rdfs:comment 'The datetime until which content distribution is embargoed (blocked) even if the rights window has started. Used for coordinated global release windows, spoiler embargoes, or contractual hold periods. Null if no embargo applies.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:geoRestrictionApplied rdf:type rdf:Property ;
    rdfs:label 'Geo Restriction Applied' ;
    rdfs:comment 'Indicates whether geographic blackout or restriction rules are enforced for this specific asset on this specific digital touchpoint. Overrides or refines the channel-level geo_restriction_enabled flag for this asset pairing.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geoRestrictionType rdf:type rdf:Property ;
    rdfs:label 'Geo Restriction Type' ;
    rdfs:comment 'Specifies whether the territory_code and blackout_territory_codes define an inclusion list (content available ONLY in listed territories) or an exclusion list (content available EVERYWHERE EXCEPT listed territories). \'none\' = no geographic restriction beyond the primary territory.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxStreamResolution rdf:type rdf:Property ;
    rdfs:label 'Max Stream Resolution' ;
    rdfs:comment 'Maximum permitted streaming resolution for content distributed under this rights window. Rights agreements may restrict distribution to SD or HD quality on certain platforms or territories. SD=Standard Definition, HD=High Definition, FHD=Full HD 1080p, 4K=Ultra HD, 8K=Super Hi-Vision.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsFeeCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Rights Fee Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the rights fee amount (e.g., USD, GBP, EUR). Required for multi-currency rights agreements across global markets.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsNotes rdf:type rdf:Property ;
    rdfs:label 'Rights Notes' ;
    rdfs:comment 'Free-text field for additional rights conditions, special contractual provisions, or legal annotations specific to this distribution window that are not captured in structured fields. Classified as confidential due to commercially sensitive contract details.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsWindowCode rdf:type rdf:Property ;
    rdfs:label 'Rights Window Code' ;
    rdfs:comment 'Externally-known business identifier for the rights window, sourced from Dalet Galaxy DAM or the rights management system. Used for cross-system reconciliation and rights clearance tracking.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Rights Window End' ;
    rdfs:comment 'The date on which the distribution rights window closes for this asset on this specific digital touchpoint. After this date the asset must be suppressed from the channel.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rightsWindowStart rdf:type rdf:Property ;
    rdfs:label 'Rights Window Start' ;
    rdfs:comment 'The date on which the asset becomes available for distribution on this specific digital touchpoint. Varies per asset-channel combination and cannot reside on either parent entity alone.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sublicensingPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Sublicensing Permitted Flag' ;
    rdfs:comment 'Indicates whether the rights holder has authorized sublicensing of this content to third-party distributors within this window. True = sublicensing allowed; False = sublicensing prohibited. Critical for IP and rights chain management.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:watermarkingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Watermarking Required Flag' ;
    rdfs:comment 'Indicates whether digital watermarking must be applied to content distributed under this rights window for piracy detection and rights enforcement purposes. True = watermarking mandatory per contract or DRM policy.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:windowEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Window End Datetime' ;
    rdfs:comment 'The precise date and time (exclusive) at which this content rights distribution window expires and content distribution must cease. Null indicates an open-ended window with no defined expiry. Stored in ISO 8601 format with timezone offset.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:windowStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Window Start Datetime' ;
    rdfs:comment 'The precise date and time (inclusive) at which this content rights distribution window becomes effective and content may be distributed on the specified platform and territory. Stored in ISO 8601 format with timezone offset.' ;
    rdfs:domain ind:ContentRightsWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:windowType rdf:type rdf:Property ;
    rdfs:label 'Window Type' ;
    rdfs:comment 'Classification of the rights window by broadcast/distribution run type. \'first_run\' = initial broadcast/distribution; \'repeat\' = subsequent re-broadcast; \'archive\' = historical/library content; \'live\' = live event distribution; \'near_live\' = delayed live (e.g., same-day replay); \'catch_up\' = post-broadcast catch-up window.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Account Manager Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Creator/influencer partnership management in sports entertainment requires tracking the assigned employee account manager for contract negotiations, NIL deal management, and relationship oversight. No' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:fanAccountId rdf:type rdf:Property ;
    rdfs:label 'Fan Account Id' ;
    rdfs:comment 'Foreign key linking to platform.platform_fan_account. Business justification: Creators (UGC contributors, influencers) have fan accounts on the platform. Linking creator_profile to platform_fan_account enables unified identity management, GDPR consent tracking, and creator mone' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SportsEntertainment .

ind:adobeAepProfileReference rdf:type rdf:Property ;
    rdfs:label 'Adobe Aep Profile Reference' ;
    rdfs:comment 'Unique profile identifier for this creator in Adobe Experience Platform (AEP), enabling personalization, audience segmentation, and fan engagement analytics tied to creator-driven content campaigns.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:audienceMetricsRefreshDate rdf:type rdf:Property ;
    rdfs:label 'Audience Metrics Refresh Date' ;
    rdfs:comment 'Date on which the creator\'s audience metrics (follower count, engagement rate, reach) were last refreshed from platform APIs or third-party measurement tools. Indicates data freshness for analytics and partnership decisions.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:averageViewsPerPost rdf:type rdf:Property ;
    rdfs:label 'Average Views Per Post' ;
    rdfs:comment 'Average number of views or impressions per content post on the creator\'s primary platform, based on the most recent measurement period. Used for GRP (Gross Rating Point) estimation and media value calculations in sponsorship proposals.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brandSafetyRating rdf:type rdf:Property ;
    rdfs:label 'Brand Safety Rating' ;
    rdfs:comment 'Brand safety classification assigned to the creator based on content moderation reviews, past conduct, and compliance with Sports Entertainment\'s brand guidelines. Determines eligibility for sponsored content, broadcast-adjacent placements, and VIP activations.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentFormatSpecialization rdf:type rdf:Property ;
    rdfs:label 'Content Format Specialization' ;
    rdfs:comment 'Primary content format the creator specializes in producing. Drives asset ingest workflows in Dalet Galaxy DAM, encoding profile selection, and CDN distribution channel routing for OTT and social platforms. [ENUM-REF-CANDIDATE: video|photography|audio|editorial|social_short_form|live_streaming|mixed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentNiche rdf:type rdf:Property ;
    rdfs:label 'Content Niche' ;
    rdfs:comment 'Primary sports or entertainment content niche the creator specializes in (e.g., NFL analysis, NBA highlights, esports, combat sports, live event coverage). Used for audience targeting, sponsorship matching, and content strategy alignment. [ENUM-REF-CANDIDATE: nfl|nba|mlb|nhl|mls|ufc|fifa|esports|multi_sport|entertainment|lifestyle — promote to reference product]' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentRightsTerritoryCodes rdf:type rdf:Property ;
    rdfs:label 'Content Rights Territory Codes' ;
    rdfs:comment 'Comma-separated ISO 3166-1 alpha-3 territory codes where Sports Entertainment holds rights to distribute content produced by or featuring this creator. Drives geo-blocking rules and CDN distribution policies.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractEndDate rdf:type rdf:Property ;
    rdfs:label 'Contract End Date' ;
    rdfs:comment 'Expiry date of the creator\'s active partnership or managed talent agreement. Triggers renewal workflows, rights window deactivation, and content takedown processes upon expiry.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractStartDate rdf:type rdf:Property ;
    rdfs:label 'Contract Start Date' ;
    rdfs:comment 'Effective start date of the creator\'s active partnership or managed talent agreement with Sports Entertainment. Drives rights window activation, revenue share eligibility, and content distribution permissions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creatorCode rdf:type rdf:Property ;
    rdfs:label 'Creator Code' ;
    rdfs:comment 'Externally-known unique alphanumeric code assigned to the creator for cross-system reference, partnership agreements, and CRM tracking. Used as the business-facing identifier in Salesforce CRM and influencer marketing platforms.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creatorType rdf:type rdf:Property ;
    rdfs:label 'Creator Type' ;
    rdfs:comment 'Categorical classification of the creator\'s role within the Sports Entertainment creator ecosystem. Drives partnership tier eligibility, content rights treatment, and NIL applicability. [ENUM-REF-CANDIDATE: influencer|athlete_creator|journalist|ugc_contributor|brand_ambassador|media_partner — promote to reference product]' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayName rdf:type rdf:Property ;
    rdfs:label 'Display Name' ;
    rdfs:comment 'The publicly known name, handle, or brand name used by the creator across digital platforms (e.g., influencer alias, channel name). This is the primary identity label used in fan-facing and partner-facing contexts.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmRightsTier rdf:type rdf:Property ;
    rdfs:label 'Drm Rights Tier' ;
    rdfs:comment 'Digital rights management tier assigned to content produced by or featuring this creator, governing how their content may be distributed across OTT (Over-The-Top Streaming), DTC (Direct-To-Consumer), and social channels. Aligns with content_drm_policy assignments in Dalet Galaxy.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emailAddress rdf:type rdf:Property ;
    rdfs:label 'Email Address' ;
    rdfs:comment 'Primary email address used for partnership communications, contract delivery, and CRM outreach. Managed in Salesforce CRM as the primary contact channel for influencer marketing operations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementRatePct rdf:type rdf:Property ;
    rdfs:label 'Engagement Rate Pct' ;
    rdfs:comment 'Average engagement rate (likes, comments, shares, saves divided by impressions or followers) expressed as a percentage on the creator\'s primary platform. Critical KPI (Key Performance Indicator) for evaluating content effectiveness and partnership ROI.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flatFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Flat Fee Amount' ;
    rdfs:comment 'Fixed monetary fee agreed for a partnership activation, content production commitment, or campaign deliverable. Recorded in the contract currency and fed into SAP S/4HANA SD for billing and EBITDA (Earnings Before Interest Taxes Depreciation and Amortization) reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:followerCount rdf:type rdf:Property ;
    rdfs:label 'Follower Count' ;
    rdfs:comment 'Total number of followers or subscribers across the creator\'s primary platform at the time of last audience metrics refresh. Key input for partnership tier assignment, CPM (Cost Per Mille) rate negotiation, and influencer marketing ROI (Return on Investment) analysis.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gdprDataSubjectFlag rdf:type rdf:Property ;
    rdfs:label 'Gdpr Data Subject Flag' ;
    rdfs:comment 'Indicates whether this creator is a data subject under GDPR (General Data Protection Regulation) based on their country of residence or content distribution territory. Triggers GDPR-compliant data handling, retention, and erasure workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalName rdf:type rdf:Property ;
    rdfs:label 'Legal Name' ;
    rdfs:comment 'The full legal name of the creator as it appears on contracts, NIL agreements, and tax documentation. Required for compliance with SAP SuccessFactors talent records and legal partnership agreements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilAgreementReference rdf:type rdf:Property ;
    rdfs:label 'Nil Agreement Reference' ;
    rdfs:comment 'Reference number or identifier for the active NIL (Name, Image, and Likeness) agreement governing the creator\'s use of their identity in Sports Entertainment content and sponsorship activations. Links to the formal contract document.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Nil Eligible Flag' ;
    rdfs:comment 'Indicates whether the creator is eligible for NIL (Name, Image, and Likeness) agreements under applicable governing body rules (e.g., NCAA, league-specific CBA provisions). Drives NIL agreement workflow initiation and compliance checks.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onboardingDate rdf:type rdf:Property ;
    rdfs:label 'Onboarding Date' ;
    rdfs:comment 'Date on which the creator was formally onboarded into Sports Entertainment\'s creator management program. Marks the start of the creator lifecycle for LTV (Lifetime Value) and CAC (Customer Acquisition Cost) analytics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:partnershipStatus rdf:type rdf:Property ;
    rdfs:label 'Partnership Status' ;
    rdfs:comment 'Current lifecycle status of the creator\'s partnership or managed relationship with Sports Entertainment. Drives access to content assets, distribution rights, and monetization eligibility. Managed in Salesforce CRM.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partnershipTier rdf:type rdf:Property ;
    rdfs:label 'Partnership Tier' ;
    rdfs:comment 'Commercial tier assigned to the creator based on audience reach, engagement performance, and strategic value to Sports Entertainment. Determines content access levels, revenue share rates, and co-marketing investment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:platformHandle rdf:type rdf:Property ;
    rdfs:label 'Platform Handle' ;
    rdfs:comment 'The creator\'s username or handle on their primary digital platform (e.g., @handle on Instagram, channel URL slug on YouTube). Used for content attribution, social media monitoring, and UGC (User-Generated Content) source tracking.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPlatform rdf:type rdf:Property ;
    rdfs:label 'Primary Platform' ;
    rdfs:comment 'The principal digital platform on which the creator publishes content and commands the largest audience. Used for platform-specific rights clearance, DRM policy assignment, and CDN distribution routing. [ENUM-REF-CANDIDATE: youtube|instagram|tiktok|twitter_x|facebook|twitch|podcast|website — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salesforceContactReference rdf:type rdf:Property ;
    rdfs:label 'Salesforce Contact Reference' ;
    rdfs:comment 'External reference identifier for this creator\'s contact record in Salesforce CRM, used for fan and sponsor relationship management, campaign tracking, and cross-system data reconciliation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryPlatformHandles rdf:type rdf:Property ;
    rdfs:label 'Secondary Platform Handles' ;
    rdfs:comment 'Comma-separated list of platform:handle pairs for additional platforms where the creator is active (e.g., \'tiktok:@handle,twitch:channelname\'). Supports multi-platform rights clearance and cross-channel audience analytics.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportDisciplineCodes rdf:type rdf:Property ;
    rdfs:label 'Sport Discipline Codes' ;
    rdfs:comment 'Comma-separated sport discipline codes representing the sports the creator covers or is associated with (e.g., \'NFL,NBA,UFC\'). Aligns with metadata taxonomy in Dalet Galaxy DAM for content tagging and rights clearance scoping.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ugcConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Ugc Consent Flag' ;
    rdfs:comment 'Indicates whether the creator has provided explicit consent for Sports Entertainment to use, redistribute, or monetize their user-generated content (UGC) across owned and operated platforms. Required for GDPR and CCPA compliance.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ugcConsentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ugc Consent Timestamp' ;
    rdfs:comment 'Timestamp when the creator accepted the current version of the UGC (User-Generated Content) consent agreement. Required for GDPR Article 7 consent audit trail and CCPA compliance documentation.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ugcConsentVersion rdf:type rdf:Property ;
    rdfs:label 'Ugc Consent Version' ;
    rdfs:comment 'Version identifier of the UGC (User-Generated Content) consent agreement accepted by the creator. Tracks consent versioning for GDPR and CCPA compliance audit trails.' ;
    rdfs:domain ind:CreatorProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverId rdf:type rdf:Property ;
    rdfs:label 'Approver Id' ;
    rdfs:comment 'Identifier of the editorial staff member who granted final approval for this brief. Provides accountability and audit trail for content governance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:contingentWorkerId rdf:type rdf:Property ;
    rdfs:label 'Contingent Worker Id' ;
    rdfs:comment 'Identifier of the journalist, producer, or content creator assigned as the primary author or producer responsible for fulfilling this editorial brief. References the workforce or talent roster.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContingentWorker .

ind:damAssetId rdf:type rdf:Property ;
    rdfs:label 'Dam Asset Id' ;
    rdfs:comment 'Reference identifier of the associated digital asset record in the Dalet Galaxy DAM (Digital Asset Management) system. Links the editorial brief to the master content asset record for rights, metadata, and distribution management.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:primaryEditorialEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Editorial Employee Id' ;
    rdfs:comment 'Identifier of the journalist, producer, or content creator assigned as the primary author or producer responsible for fulfilling this editorial brief. References the workforce or talent roster.' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:propBetId rdf:type rdf:Property ;
    rdfs:label 'Prop Bet Id' ;
    rdfs:comment 'Foreign key linking to gaming.prop_bet. Business justification: Betting preview content production: editorial briefs for prop bet analysis articles (e.g., \'Mahomes passing yards over/under breakdown\') are directly commissioned against specific prop bets. This is a' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PropBet .

ind:brandedContentFlag rdf:type rdf:Property ;
    rdfs:label 'Branded Content Flag' ;
    rdfs:comment 'Indicates whether this editorial brief is for branded or sponsored content that requires commercial disclosure labelling per FCC and advertising standards. Triggers compliance review workflow.' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:briefReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Brief Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric code used to identify and reference the editorial brief across production systems, editorial calendars, and commissioning workflows. Format: EB-{SPORT}-{YEAR}-{SEQUENCE}.' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:briefStatus rdf:type rdf:Property ;
    rdfs:label 'Brief Status' ;
    rdfs:comment 'Current lifecycle state of the editorial brief within the content production pipeline, from initial commissioning through publication or cancellation. [ENUM-REF-CANDIDATE: draft|commissioned|in_production|under_review|approved|published|cancelled — promote to reference product]' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:briefTitle rdf:type rdf:Property ;
    rdfs:label 'Brief Title' ;
    rdfs:comment 'Human-readable working title of the editorial brief, describing the story or content piece being commissioned. Used in editorial calendars and production dashboards.' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Commissioned Timestamp' ;
    rdfs:comment 'Date and time when the editorial brief was formally commissioned and entered the production pipeline. Represents the principal business event timestamp for this transaction.' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:contentPriority rdf:type rdf:Property ;
    rdfs:label 'Content Priority' ;
    rdfs:comment 'Editorial priority level assigned to this brief, determining resource allocation, production queue position, and escalation thresholds. Breaking news content receives highest priority.' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmRightsStatus rdf:type rdf:Property ;
    rdfs:label 'Drm Rights Status' ;
    rdfs:comment 'Status of digital rights clearance for the content covered by this editorial brief. Governs whether the content can be distributed across target platforms. DRM (Digital Rights Management) clearance is mandatory before publication.' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationTargetSeconds rdf:type rdf:Property ;
    rdfs:label 'Duration Target Seconds' ;
    rdfs:comment 'Target runtime duration in seconds for audio-visual content (video highlights, podcasts, broadcast segments). Null for text-based content types. Drives production scheduling and CDN (Content Delivery Network) capacity planning.' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:embargoTimestamp rdf:type rdf:Property ;
    rdfs:label 'Embargo Timestamp' ;
    rdfs:comment 'Date and time before which the content must not be published or distributed. Used for coordinated release of exclusive stories, pre-match previews, and league-mandated embargo windows.' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:publicationDeadline rdf:type rdf:Property ;
    rdfs:label 'Publication Deadline' ;
    rdfs:comment 'Target date and time by which the content must be published or broadcast. May differ from submission deadline to allow for editorial review, legal clearance, and CDN distribution lead time.' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:socialChannelTarget rdf:type rdf:Property ;
    rdfs:label 'Social Channel Target' ;
    rdfs:comment 'Specific social media platform(s) targeted for distribution of content produced under this brief (e.g., Instagram, X/Twitter, TikTok, YouTube). Drives format and duration specifications for social-first content.' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storyAngle rdf:type rdf:Property ;
    rdfs:label 'Story Angle' ;
    rdfs:comment 'Narrative perspective, editorial angle, or thematic focus of the content piece. Describes the unique hook or framing that differentiates this story from standard match or event coverage.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDeadline rdf:type rdf:Property ;
    rdfs:label 'Submission Deadline' ;
    rdfs:comment 'Date and time by which the assigned journalist or producer must submit the completed content for editorial review. Critical for time-sensitive sports news and live event coverage.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ugcSourcedFlag rdf:type rdf:Property ;
    rdfs:label 'Ugc Sourced Flag' ;
    rdfs:comment 'Indicates whether this editorial brief incorporates or is based on UGC (User Generated Content) sourced from fan platforms or social channels. Triggers additional rights clearance and GDPR compliance workflows.' ;
    rdfs:domain ind:EditorialBrief ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wordCountTarget rdf:type rdf:Property ;
    rdfs:label 'Word Count Target' ;
    rdfs:comment 'Target word count for written editorial content (articles, long-form, match reports). Null for non-text content types such as video or photo galleries. Used for editorial planning and writer briefing.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:apiIntegrationId rdf:type rdf:Property ;
    rdfs:label 'Api Integration Id' ;
    rdfs:comment 'Foreign key linking to platform.api_integration. Business justification: Ingest jobs are triggered via API integrations (broadcast feed APIs, partner content APIs). Linking to api_integration enables operational tracking of which integration sourced each ingest, supporting' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApiIntegration .

ind:esportsMatchId rdf:type rdf:Property ;
    rdfs:label 'Esports Match Id' ;
    rdfs:comment 'Foreign key linking to gaming.esports_match. Business justification: Esports content ingestion: ingest_job already links to fixture_id for traditional sports, but esports matches are not fixtures. Esports broadcast footage ingestion must reference the specific esports_' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EsportsMatch .

ind:broadcastRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Flag' ;
    rdfs:comment 'Indicates whether the ingested content carries cleared broadcast distribution rights for linear television and RSN (Regional Sports Network) channels. True = broadcast rights confirmed; False = broadcast rights not cleared or not applicable.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cdnDistributionStatus rdf:type rdf:Property ;
    rdfs:label 'Cdn Distribution Status' ;
    rdfs:comment 'Status of the CDN (Content Delivery Network) distribution push for this ingested asset following successful DAM registration. Tracks whether the asset has been propagated to CDN edge nodes for OTT and digital platform delivery.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checksumAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Checksum Algorithm' ;
    rdfs:comment 'The hashing algorithm used to generate the file integrity checksum for this ingest job. Used to verify that files were transferred without corruption from source to DAM storage.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checksumValue rdf:type rdf:Property ;
    rdfs:label 'Checksum Value' ;
    rdfs:comment 'The computed checksum hash value for the primary file or manifest package of this ingest job. Validated against the source-declared checksum to confirm file integrity upon arrival in the DAM.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:completedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Completed Timestamp' ;
    rdfs:comment 'Timestamp recording when the ingest job reached a terminal state (completed, failed, or cancelled). Used alongside ingest_timestamp to calculate ingest_duration_seconds and for SLA compliance reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:contentDate rdf:type rdf:Property ;
    rdfs:label 'Content Date' ;
    rdfs:comment 'The calendar date on which the content was originally captured or created, as declared by the source system or embedded metadata. May differ from ingest_timestamp if content is ingested after the fact (e.g., archival uploads).' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:destinationStoragePath rdf:type rdf:Property ;
    rdfs:label 'Destination Storage Path' ;
    rdfs:comment 'The target storage path or URI in the DAM or cloud storage layer where the ingested content is written upon successful completion. Supports traceability from raw capture to registered DAM asset location.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmClearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Drm Clearance Status' ;
    rdfs:comment 'Rights clearance status for the ingested content under the Digital Rights Management (DRM) framework. Determines whether the asset is cleared for distribution across OTT, broadcast, social, and digital channels.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileCount rdf:type rdf:Property ;
    rdfs:label 'File Count' ;
    rdfs:comment 'Total number of individual files included in this ingest job as declared in the file manifest. Used to validate completeness of ingest against expected file count.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fileManifestPath rdf:type rdf:Property ;
    rdfs:label 'File Manifest Path' ;
    rdfs:comment 'Storage path or URI to the file manifest document listing all individual files included in this ingest job. The manifest captures filenames, sizes, checksums, and sequence information for multi-file ingest packages.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ingestChannel rdf:type rdf:Property ;
    rdfs:label 'Ingest Channel' ;
    rdfs:comment 'The operational channel through which this ingest job was initiated. Distinguishes between manual operator-triggered ingests, fully automated pipeline ingests, scheduled batch ingests, and API-driven ingests from external systems.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ingestDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Ingest Duration Seconds' ;
    rdfs:comment 'Elapsed time in seconds from ingest job initiation to completion or failure. Used for SLA (Service Level Agreement) compliance monitoring, pipeline performance benchmarking, and capacity planning.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ingestPriority rdf:type rdf:Property ;
    rdfs:label 'Ingest Priority' ;
    rdfs:comment 'Business priority level assigned to this ingest job, governing queue position and resource allocation in the DAM ingest pipeline. Critical priority is used for live event highlights requiring immediate OTT/social distribution.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Job Reference Number' ;
    rdfs:comment 'Externally-known business identifier for the ingest job, used by production teams and operations staff to reference and track a specific ingest event across systems. Follows the format INJ-{YEAR}-{SEQUENCE}.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobStatus rdf:type rdf:Property ;
    rdfs:label 'Job Status' ;
    rdfs:comment 'Current lifecycle state of the ingest job within the DAM workflow. Tracks progression from initial queuing through active processing to terminal states (completed, failed, cancelled). [ENUM-REF-CANDIDATE: queued|in_progress|completed|failed|cancelled|on_hold — promote to reference product]' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metadataExtractionStatus rdf:type rdf:Property ;
    rdfs:label 'Metadata Extraction Status' ;
    rdfs:comment 'Status of the automated metadata extraction process that reads technical and descriptive metadata from the ingested files (e.g., EXIF, XMP, embedded timecode, audio levels). Drives DAM catalogue completeness.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metadataProfile rdf:type rdf:Property ;
    rdfs:label 'Metadata Profile' ;
    rdfs:comment 'The metadata schema profile applied during extraction and tagging for this ingest job (e.g., sports_event_video, ugc_social, broadcast_highlight, editorial_photo). Determines which metadata fields are populated in the DAM asset record.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ottRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Ott Rights Flag' ;
    rdfs:comment 'Indicates whether the ingested content carries cleared OTT (Over-The-Top Streaming) distribution rights for DTC (Direct-To-Consumer) streaming platforms. True = OTT rights confirmed; False = OTT rights not cleared.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryFormat rdf:type rdf:Property ;
    rdfs:label 'Primary Format' ;
    rdfs:comment 'The dominant file format or codec of the ingested content (e.g., MXF, MP4, MOV, RAW, JPEG, WAV, MP3). Determines transcoding requirements and DAM storage profile. [ENUM-REF-CANDIDATE: MXF|MP4|MOV|RAW|JPEG|TIFF|WAV|MP3|AIFF|PDF — promote to reference product]' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qcFailureReason rdf:type rdf:Property ;
    rdfs:label 'Qc Failure Reason' ;
    rdfs:comment 'Descriptive reason code or message explaining why the quality check failed. Populated only when qc_status is \'failed\'. Supports remediation workflows and root cause analysis.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qcScore rdf:type rdf:Property ;
    rdfs:label 'Qc Score' ;
    rdfs:comment 'Numeric quality score assigned by the automated QC engine during ingest validation. Expressed as a percentage (0.00–100.00). Scores below threshold trigger QC failure and manual review routing.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qcStatus rdf:type rdf:Property ;
    rdfs:label 'Qc Status' ;
    rdfs:comment 'Result of the automated and/or manual quality check performed on the ingested content. Indicates whether the asset meets technical and editorial standards required for DAM registration and downstream distribution.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retryCount rdf:type rdf:Property ;
    rdfs:label 'Retry Count' ;
    rdfs:comment 'Number of times this ingest job has been retried following a failure or interruption. Tracks pipeline resilience and identifies problematic source feeds or assets requiring manual intervention.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceDeviceIdentifier rdf:type rdf:Property ;
    rdfs:label 'Source Device Identifier' ;
    rdfs:comment 'Unique identifier of the physical device or system that captured or submitted the content (e.g., camera serial number, OB truck unit ID, social feed connector ID). Supports chain-of-custody traceability and device-level quality diagnostics.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceType rdf:type rdf:Property ;
    rdfs:label 'Source Type' ;
    rdfs:comment 'Classification of the physical or digital origin of the content being ingested. Distinguishes between Outside Broadcast (OB) truck feeds, camera card transfers, social media feeds, User-Generated Content (UGC) uploads, broadcast feeds, and API push integrations. [ENUM-REF-CANDIDATE: ob_truck|camera_card|social_feed|ugc_upload|broadcast_feed|api_push|satellite_feed|ftp_transfer — promote to reference product]' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalFileSizeMb rdf:type rdf:Property ;
    rdfs:label 'Total File Size Mb' ;
    rdfs:comment 'Aggregate size in megabytes of all files included in this ingest job as declared in the manifest. Used for storage capacity planning, CDN bandwidth tracking, and ingest throughput reporting.' ;
    rdfs:domain ind:IngestJob ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fixedAssetId rdf:type rdf:Property ;
    rdfs:label 'Fixed Asset Id' ;
    rdfs:comment 'Foreign key linking to finance.fixed_asset. Business justification: Long-term broadcast rights licenses (e.g., multi-year league rights deals) are capitalized as intangible fixed assets in SAP Asset Accounting. Finance teams in sports entertainment routinely capitaliz' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FixedAsset .

ind:licenseeCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Licensee Corporate Entity Id' ;
    rdfs:comment 'Reference to the licensee or media partner entity (broadcaster, OTT platform, social channel, commercial outlet) receiving the licensed content rights.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:managerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Manager Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: License compliance management and renewal tracking requires identifying the responsible employee for each content license. This supports compliance review scheduling, renewal notifications, and regula' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryContentLicenseeVendorId rdf:type rdf:Property ;
    rdfs:label 'Primary Content Licensee Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: Content licensees (broadcasters, OTT platforms, RSNs) are registered as vendors in the procurement system. Linking license to vendor via licensee_vendor_id enables license fee invoicing through vendor' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:revenueRecognitionScheduleId rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Schedule Id' ;
    rdfs:comment 'Foreign key linking to finance.revenue_recognition_schedule. Business justification: Content licenses create performance obligations under ASC 606. Finance creates revenue recognition schedules for multi-period license fees. This link drives the content licensing revenue recognition w' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RevenueRecognitionSchedule .

ind:attributionRequired rdf:type rdf:Property ;
    rdfs:label 'Attribution Required' ;
    rdfs:comment 'Indicates whether the licensee must display a credit or attribution line (e.g., \'Courtesy of Sports Entertainment / League Name\') when publishing or broadcasting the licensed content. True = attribution mandatory.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attributionText rdf:type rdf:Property ;
    rdfs:label 'Attribution Text' ;
    rdfs:comment 'Exact credit line or attribution text the licensee must display when using the licensed content (e.g., \'Photo: Sports Entertainment / John Smith\'). Populated when attribution_required is True.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentScope rdf:type rdf:Property ;
    rdfs:label 'Content Scope' ;
    rdfs:comment 'Breadth of content covered by the license: single_asset (one specific file), collection (curated package), sport (all content for a sport), league (all content for a league), event (all content for a specific event), season (all content for a competition season). Determines which asset_id or collection_id fields are populated.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Contract Document Ref' ;
    rdfs:comment 'Reference identifier or URL to the executed license agreement document stored in the Digital Asset Management (DAM) system or document management repository (e.g., Dalet Galaxy document store, SharePoint). Enables direct access to the legal instrument.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crmOpportunityReference rdf:type rdf:Property ;
    rdfs:label 'Crm Opportunity Reference' ;
    rdfs:comment 'Salesforce CRM Opportunity record identifier associated with the commercial negotiation that resulted in this license. Enables traceability from CRM pipeline to executed license and supports revenue attribution reporting.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daletRightsReference rdf:type rdf:Property ;
    rdfs:label 'Dalet Rights Reference' ;
    rdfs:comment 'Dalet Galaxy Digital Asset Management (DAM) system rights record identifier linked to this license. Provides traceability to the source-of-truth rights metadata and DRM policy configuration in the DAM workflow.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryFormat rdf:type rdf:Property ;
    rdfs:label 'Delivery Format' ;
    rdfs:comment 'Technical mechanism by which licensed content is delivered to the licensee: api_feed (Application Programming Interface automated feed), ftp_transfer (file transfer protocol batch), cdn_push (Content Delivery Network push via CDN), manual_download (portal-based manual retrieval), broadcast_signal (OB/satellite signal), email_package (packaged file via email). [ENUM-REF-CANDIDATE: api_feed|ftp_transfer|cdn_push|manual_download|broadcast_signal|email_package|iptv_stream — promote to reference product]' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmRestrictions rdf:type rdf:Property ;
    rdfs:label 'Drm Restrictions' ;
    rdfs:comment 'Free-text description of specific Digital Rights Management technical restrictions applied to the licensed content (e.g., watermarking required, geo-blocking enforced, no download permitted, time-limited playback window). Sourced from Dalet Galaxy DAM rights metadata.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Amount' ;
    rdfs:comment 'Agreed monetary consideration paid by the vendor to Sports Entertainment for the rights granted under this license. Expressed in the currency defined by license_fee_currency. Belongs to the license agreement, not to the asset or vendor master.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeCurrency rdf:type rdf:Property ;
    rdfs:label 'Fee Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the license_fee_amount is denominated (e.g., USD, GBP, EUR). Required to support multi-currency rights deals with international broadcasters.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeStructure rdf:type rdf:Property ;
    rdfs:label 'Fee Structure' ;
    rdfs:comment 'Commercial model governing how the licensee compensates Sports Entertainment: flat_fee (fixed one-time or periodic payment), royalty (per-use or per-unit fee), revenue_share (percentage of licensee revenue), cpm_based (Cost Per Mille impression-based), subscription (periodic access fee), free (no monetary consideration, e.g., promotional or editorial). Drives invoicing logic in SAP S/4HANA SD.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedFrequency rdf:type rdf:Property ;
    rdfs:label 'Feed Frequency' ;
    rdfs:comment 'Cadence at which content is delivered to the licensee under ongoing syndication or broadcast feed arrangements: real_time, hourly, daily, weekly, on_demand (licensee-initiated pull), event_triggered (delivery upon specific event occurrence). Null for one-off licenses.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastComplianceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Compliance Review Date' ;
    rdfs:comment 'Date on which the most recent compliance audit or review of the license was conducted. Used to schedule periodic compliance checks and track regulatory adherence timelines.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseScope rdf:type rdf:Property ;
    rdfs:label 'License Scope' ;
    rdfs:comment 'Defines the permitted scope of use for this specific IP asset within the license agreement (e.g., broadcast_only, merchandise, digital_streaming). Scope may differ per IP asset within the same license.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxUsageCount rdf:type rdf:Property ;
    rdfs:label 'Max Usage Count' ;
    rdfs:comment 'Maximum number of times the licensee is permitted to use, broadcast, or distribute the licensed content within the license term. Null indicates unlimited usage. Enables usage cap enforcement and royalty calculation.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Payment Frequency' ;
    rdfs:comment 'Cadence at which the licensee is invoiced or remits payment: one_time (single payment), monthly, quarterly, semi_annual, annual. Drives billing schedule generation in SAP S/4HANA SD.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalTermMonths rdf:type rdf:Property ;
    rdfs:label 'Renewal Term Months' ;
    rdfs:comment 'Duration in months of each automatic renewal cycle. Applicable only when auto_renewal_flag is True. Used to project future effective_end_date upon renewal.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sublicensePermitted rdf:type rdf:Property ;
    rdfs:label 'Sublicense Permitted' ;
    rdfs:comment 'Indicates whether the licensee is contractually permitted to sublicense the content to third parties. True = sublicensing allowed (subject to conditions); False = sublicensing prohibited. Critical for IP chain-of-title integrity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:territoryExclusivity rdf:type rdf:Property ;
    rdfs:label 'Territory Exclusivity' ;
    rdfs:comment 'Defines whether the licensee holds exclusive rights in the specified territory (exclusive), shares rights with other licensees (non_exclusive), or holds first-window broadcast priority before other licensees (first_window). Directly impacts RSN and OTT deal structuring.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ugcRightsIncluded rdf:type rdf:Property ;
    rdfs:label 'Ugc Rights Included' ;
    rdfs:comment 'Indicates whether the license grants the licensee rights to use or incorporate User-Generated Content (UGC) associated with the licensed assets (e.g., fan footage, social clips). True = UGC rights included; False = excluded.' ;
    rdfs:domain ind:ContentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:usageRightsGranted rdf:type rdf:Property ;
    rdfs:label 'Usage Rights Granted' ;
    rdfs:comment 'Classification of the media usage rights conveyed to the vendor under this license agreement. Determines which distribution channels and use cases the vendor is permitted to exercise.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watermarkRequired rdf:type rdf:Property ;
    rdfs:label 'Watermark Required' ;
    rdfs:comment 'Indicates whether the licensee is contractually required to apply a visible or forensic watermark to distributed content for IP tracking and anti-piracy enforcement. True = watermark mandatory; False = not required.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:createdByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Created By Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Taxonomy governance requires tracking which employee created each metadata tag for audit trails, IP ownership, and change management. The existing \'created_by\' plain string is a denormalized employee ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:aliasTerms rdf:type rdf:Property ;
    rdfs:label 'Alias Terms' ;
    rdfs:comment 'Pipe-delimited list of alternative names, synonyms, or common misspellings associated with this tag (e.g., \'Football|Footy|Association Football\' for the Soccer tag). Used to enhance search recall, support natural language queries, and map legacy tag names to current controlled vocabulary terms during DAM migration.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoTaggingConfidenceThreshold rdf:type rdf:Property ;
    rdfs:label 'Auto Tagging Confidence Threshold' ;
    rdfs:comment 'Minimum confidence score (0.0000 to 1.0000) required from the auto-tagging AI/ML model before this tag is automatically applied to a content asset without human review. Tags with lower model confidence scores are routed to editorial review queues. Null when auto_tagging_eligible is False.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autoTaggingEligible rdf:type rdf:Property ;
    rdfs:label 'Auto Tagging Eligible' ;
    rdfs:comment 'Indicates whether this tag may be applied automatically by AI/ML-powered auto-tagging engines integrated with Dalet Galaxy DAM (e.g., computer vision for athlete recognition, speech-to-text for topic detection). When False, the tag requires manual editorial application only.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cdnCacheTtlSeconds rdf:type rdf:Property ;
    rdfs:label 'Cdn Cache Ttl Seconds' ;
    rdfs:comment 'Recommended cache Time-To-Live (TTL) in seconds for content assets bearing this tag when served via CDN. Tags associated with live or near-live event content (e.g., breaking news, live match highlights) have shorter TTLs to ensure freshness. Tags for evergreen content have longer TTLs to optimize CDN performance.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Flag' ;
    rdfs:comment 'Indicates whether this tag is associated with regulatory or compliance-sensitive content categories (e.g., PED/doping-related content, gambling-adjacent content, athlete NIL content, GDPR-sensitive fan data content). When True, additional compliance workflows are triggered in the DAM and distribution systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contentTypeAffinity rdf:type rdf:Property ;
    rdfs:label 'Content Type Affinity' ;
    rdfs:comment 'Indicates which content asset types this tag is applicable to within the DAM. Restricts tag availability in editorial workflows to relevant asset types (e.g., a \'mood\' tag may apply to \'video\' and \'photo\' but not \'editorial\'). \'all\' indicates the tag is applicable across all content types. [ENUM-REF-CANDIDATE: video|photo|audio|editorial|social|ugc|all — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:damCategoryPath rdf:type rdf:Property ;
    rdfs:label 'Dam Category Path' ;
    rdfs:comment 'Full category path within Dalet Galaxy DAM where this tag is classified (e.g., \'/Sports/Soccer/Leagues/MLS\'). Used for DAM navigation, bulk asset operations, and workflow routing within the media asset management and broadcast workflow system.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayPriority rdf:type rdf:Property ;
    rdfs:label 'Display Priority' ;
    rdfs:comment 'Numeric ordering weight that controls the display sequence of this tag within its taxonomy type in search facets, editorial tag pickers, and fan-facing discovery interfaces. Lower values indicate higher priority display position. Used by DAM editors and OTT platform UX teams to surface the most relevant tags first.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geoRestrictionScope rdf:type rdf:Property ;
    rdfs:label 'Geo Restriction Scope' ;
    rdfs:comment 'Pipe-delimited list of ISO 3166-1 alpha-3 country codes where content tagged with this tag has distribution restrictions (e.g., \'USA|CAN\' for North American blackout). Used by CDN and OTT platforms to enforce territorial rights. Null indicates no geographic restriction. Aligns with RSN blackout and international broadcast rights agreements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Level' ;
    rdfs:comment 'Numeric depth of the tag within the taxonomy hierarchy tree, starting at 1 for root-level tags (e.g., Sport=1, League=2, Team=3, Athlete=4). Used for hierarchical search faceting, breadcrumb navigation, and roll-up reporting in analytics platforms.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hierarchyPath rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Path' ;
    rdfs:comment 'Full delimited path from root to this tag in the taxonomy tree (e.g., \'sport/soccer/league/mls/team/la_galaxy\'). Enables efficient subtree queries, breadcrumb rendering, and hierarchical filtering in DAM and OTT discovery interfaces without recursive joins.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipOwner rdf:type rdf:Property ;
    rdfs:label 'Ip Owner' ;
    rdfs:comment 'Name of the entity that holds Intellectual Property (IP) rights over content associated with this tag (e.g., \'NFL Properties LLC\', \'FIFA\', \'NBA Properties Inc.\'). Used for rights clearance workflows, licensing fee calculations, and IP compliance reporting. Critical for league-branded and athlete-branded content tags.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPersonalizationEligible rdf:type rdf:Property ;
    rdfs:label 'Is Personalization Eligible' ;
    rdfs:comment 'Indicates whether this tag may be used as a personalization signal in fan preference profiles and recommendation engines within Adobe Experience Platform. When True, the tag contributes to fan interest graphs, content affinity scoring, and targeted content delivery for DTC and OTT platforms.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRightsSensitive rdf:type rdf:Property ;
    rdfs:label 'Is Rights Sensitive' ;
    rdfs:comment 'Indicates whether content assets tagged with this tag are subject to Digital Rights Management (DRM) restrictions, broadcast rights windows, or territorial licensing constraints. When True, downstream distribution systems must perform rights clearance checks before serving content. Critical for OTT and CDN distribution compliance.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSearchable rdf:type rdf:Property ;
    rdfs:label 'Is Searchable' ;
    rdfs:comment 'Indicates whether this tag is exposed as a searchable facet in DAM search interfaces, OTT content discovery, and digital platform search indexes. When False, the tag is used for internal classification and workflow routing only and is not surfaced to end users or search APIs.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isUgcEligible rdf:type rdf:Property ;
    rdfs:label 'Is Ugc Eligible' ;
    rdfs:comment 'Indicates whether this tag may be applied to User-Generated Content (UGC) assets submitted by fans or third parties. When True, the tag is available in fan-facing content submission workflows and UGC moderation queues. When False, the tag is restricted to professionally produced content only.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastModifiedBy rdf:type rdf:Property ;
    rdfs:label 'Last Modified By' ;
    rdfs:comment 'Username or system identifier of the user or automated process that last modified this metadata tag record. Supports editorial accountability and taxonomy governance audits within Dalet Galaxy DAM and the Silver Layer data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilApplicable rdf:type rdf:Property ;
    rdfs:label 'Nil Applicable' ;
    rdfs:comment 'Indicates whether this tag is associated with athlete Name, Image, and Likeness (NIL) rights considerations. When True, content assets bearing this tag must be checked against athlete NIL agreements before commercial use, licensing, or sponsorship activation. Particularly relevant for athlete-specific tags.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ottPlatformEligibility rdf:type rdf:Property ;
    rdfs:label 'Ott Platform Eligibility' ;
    rdfs:comment 'Pipe-delimited list of OTT and DTC platform identifiers where content tagged with this tag is eligible for distribution (e.g., \'nfl_plus|espn_plus|peacock\'). Null indicates no platform-specific restriction. Used by CDN distribution rules and OTT content ingestion pipelines to enforce platform-level rights.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewRequired rdf:type rdf:Property ;
    rdfs:label 'Review Required' ;
    rdfs:comment 'Indicates whether application of this tag to a content asset requires editorial review and approval before the tag association is published. Used for sensitive tags (e.g., athlete injury, disciplinary action, PED-related content) where incorrect tagging carries reputational or legal risk.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rightsRestrictionType rdf:type rdf:Property ;
    rdfs:label 'Rights Restriction Type' ;
    rdfs:comment 'Category of rights restriction applicable to content assets bearing this tag. Territorial restrictions limit distribution by geography; temporal restrictions apply broadcast windows; platform restrictions limit to specific OTT or DTC channels; league blackout enforces RSN blackout rules; PPV exclusive restricts to Pay-Per-View events. Null or \'none\' when is_rights_sensitive is False.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialChannelEligibility rdf:type rdf:Property ;
    rdfs:label 'Social Channel Eligibility' ;
    rdfs:comment 'Pipe-delimited list of social media channel identifiers where content tagged with this tag is approved for distribution (e.g., \'instagram|twitter|tiktok|youtube\'). Null indicates no social channel restriction. Used by social publishing workflows to enforce league and rights holder social media policies.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceTagReference rdf:type rdf:Property ;
    rdfs:label 'Source Tag Reference' ;
    rdfs:comment 'Native identifier of this tag in the originating source system (e.g., Dalet Galaxy internal tag ID, Adobe Experience Platform segment ID). Enables bidirectional synchronization, change detection, and audit tracing between the Silver Layer lakehouse and operational systems.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagCode rdf:type rdf:Property ;
    rdfs:label 'Tag Code' ;
    rdfs:comment 'Externally-known, system-unique alphanumeric code identifying the tag within the DAM and digital platforms (e.g., \'SPORT_SOCCER\', \'LEAGUE_NFL\', \'ATHLETE_LEBRON\'). Used as the stable business key for API lookups, CDN metadata headers, and cross-system integrations. Sourced from Dalet Galaxy tag registry.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagDescription rdf:type rdf:Property ;
    rdfs:label 'Tag Description' ;
    rdfs:comment 'Editorial description of the tag\'s meaning, scope, and intended usage within the controlled vocabulary. Guides content editors and automated tagging systems on correct application. Includes disambiguation notes for tags with similar names (e.g., distinguishing \'MLS\' as Major League Soccer vs. other uses).' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagName rdf:type rdf:Property ;
    rdfs:label 'Tag Name' ;
    rdfs:comment 'Human-readable display label for the metadata tag as shown in the DAM user interface, search facets, and editorial tools (e.g., \'Soccer\', \'National Football League\', \'LeBron James\'). Used for content discovery, faceted search, and personalization surfaces.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagStatus rdf:type rdf:Property ;
    rdfs:label 'Tag Status' ;
    rdfs:comment 'Current lifecycle state of the metadata tag within the controlled vocabulary. Active tags are available for application to content assets. Deprecated tags are retained for historical asset associations but blocked from new tagging. Draft tags are under editorial review before activation.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagType rdf:type rdf:Property ;
    rdfs:label 'Tag Type' ;
    rdfs:comment 'Primary classification category of the tag within the controlled vocabulary taxonomy. Determines which facet the tag belongs to for search, discovery, and rights filtering. [ENUM-REF-CANDIDATE: sport|league|team|athlete|event|topic|mood|content_type|venue|sponsor|geography|season|competition — promote to reference product]' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxonomyDomain rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Domain' ;
    rdfs:comment 'High-level domain grouping within the controlled vocabulary that the tag belongs to. Supports multi-domain tagging strategies across sport classification, editorial categorization, rights management, commercial/sponsorship, audience segmentation, and production metadata.' ;
    rdfs:domain ind:MetadataTag ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daletChannelId rdf:type rdf:Property ;
    rdfs:label 'Dalet Channel Id' ;
    rdfs:comment 'The native channel identifier assigned to this distribution channel within the Dalet Galaxy Media Asset Management (MAM) and broadcast workflow system. Used to correlate platform_channel records with Dalet Galaxy publish destination configurations and workflow routing rules. System-of-record cross-reference key.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Channel .

ind:apiEndpointUrl rdf:type rdf:Property ;
    rdfs:label 'Api Endpoint Url' ;
    rdfs:comment 'The Application Programming Interface (API) endpoint URL for programmatic content submission and metadata exchange with this platform channel\'s operator system. Classified as confidential as it represents proprietary integration infrastructure. Used for automated publish event routing from Dalet Galaxy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdnEndpointUrl rdf:type rdf:Property ;
    rdfs:label 'Cdn Endpoint Url' ;
    rdfs:comment 'The CDN ingest or origin endpoint URL for delivering content to this platform channel. Classified as confidential as it represents proprietary infrastructure routing information. Used by Dalet Galaxy automated publish workflows to push packaged content to the correct CDN origin.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelUrl rdf:type rdf:Property ;
    rdfs:label 'Channel Url' ;
    rdfs:comment 'The public-facing URL of the platform channel accessible to end consumers (e.g., the OTT app store URL, the social media channel page URL, the DTC streaming portal URL). Used for fan engagement linking, marketing campaigns, and digital platform analytics in Adobe Experience Platform.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedCaptioningRequired rdf:type rdf:Property ;
    rdfs:label 'Closed Captioning Required' ;
    rdfs:comment 'Indicates whether closed captioning (CC) is mandatory for all content published to this platform channel. True = closed captions must be included in the content package per ADA or FCC accessibility requirements; False = optional. Drives caption generation and QC steps in the Dalet Galaxy publish workflow.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contentRatingSystem rdf:type rdf:Property ;
    rdfs:label 'Content Rating System' ;
    rdfs:comment 'The content rating classification system applicable to this platform channel\'s territory and regulatory environment (e.g., MPAA for US theatrical, TV Parental Guidelines for US broadcast, BBFC for UK, FSK for Germany). Determines which content rating metadata must be included in publish packages and enforced at the channel level.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmRequired rdf:type rdf:Property ;
    rdfs:label 'Drm Required' ;
    rdfs:comment 'Indicates whether Digital Rights Management (DRM) encryption is mandatory for all content published to this platform channel. True = DRM packaging required before delivery; False = unencrypted delivery permitted (e.g., free-to-air social channels). Used as a gate in the Dalet Galaxy publish workflow.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hdrSupported rdf:type rdf:Property ;
    rdfs:label 'Hdr Supported' ;
    rdfs:comment 'Indicates whether this platform channel supports High Dynamic Range (HDR) video delivery. True = HDR content (HDR10, Dolby Vision, HLG) can be delivered to this channel; False = SDR only. Drives HDR transcoding and packaging decisions in the content production workflow.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:liveStreamingEnabled rdf:type rdf:Property ;
    rdfs:label 'Live Streaming Enabled' ;
    rdfs:comment 'Indicates whether this platform channel is configured and authorized to receive and distribute live streaming content (e.g., live game broadcasts, live PPV events). True = live streaming supported; False = VOD/on-demand only. Critical for live event publish routing decisions.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:metadataStandard rdf:type rdf:Property ;
    rdfs:label 'Metadata Standard' ;
    rdfs:comment 'The metadata schema standard required by this platform channel for content package delivery (e.g., EIDR for entertainment identifier registry, EBUCore for broadcast, Dublin Core for general digital assets, IPTC for news/sports photography). Drives metadata mapping and transformation in Dalet Galaxy export workflows.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publishLeadTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Publish Lead Time Minutes' ;
    rdfs:comment 'Minimum number of minutes required before a scheduled broadcast or rights window start time that content must be submitted to this platform channel for successful ingestion and processing. Used by Dalet Galaxy automated scheduling to trigger publish events with sufficient lead time.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rightsWindowDefaultDays rdf:type rdf:Property ;
    rdfs:label 'Rights Window Default Days' ;
    rdfs:comment 'Default number of days that content rights are valid for distribution on this platform channel, used as a baseline when no specific rights agreement overrides are present. Supports automated rights window calculation in the Dalet Galaxy DRM and rights clearance workflow.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaUptimeTargetPct rdf:type rdf:Property ;
    rdfs:label 'Sla Uptime Target Pct' ;
    rdfs:comment 'The contractually agreed Service Level Agreement (SLA) uptime target percentage for this platform channel, expressed as a percentage (e.g., 99.90 = 99.9% uptime). Used for CDN performance monitoring, operator SLA compliance reporting, and penalty clause evaluation.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:socialHandle rdf:type rdf:Property ;
    rdfs:label 'Social Handle' ;
    rdfs:comment 'The official social media handle or username for this platform channel (e.g., @NBASports, @PremierLeague). Applicable for social_media channel types. Used for content routing, fan engagement tracking, and UGC attribution in Adobe Experience Platform and social analytics.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriptionModel rdf:type rdf:Property ;
    rdfs:label 'Subscription Model' ;
    rdfs:comment 'Business model governing how consumers access content on this platform channel. free = no cost access; subscription = recurring subscription fee (ARR/ARPU driven); ppv = Pay-Per-View (PPV) transactional; freemium = free tier with premium upgrade; ad_supported = free with advertising (CPM-based revenue). Informs rights window configuration and revenue attribution.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportedContentFormats rdf:type rdf:Property ;
    rdfs:label 'Supported Content Formats' ;
    rdfs:comment 'Comma-separated list of content asset formats accepted by this platform channel (e.g., \'MP4,HLS,DASH,MXF,HEVC\'). Defines the technical delivery specifications required when routing publish events from Dalet Galaxy to this channel endpoint. [ENUM-REF-CANDIDATE: MP4|HLS|DASH|MXF|HEVC|H264|H265|ProRes|AAC|MP3|JPEG|PNG|WebM — promote to reference product]' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ugcAccepted rdf:type rdf:Property ;
    rdfs:label 'Ugc Accepted' ;
    rdfs:comment 'Indicates whether this platform channel accepts and distributes User-Generated Content (UGC) from fans and community contributors. True = UGC assets can be routed to this channel after rights clearance; False = professionally produced content only. Relevant for social media channels and fan engagement platforms managed via Adobe Experience Platform.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vodEnabled rdf:type rdf:Property ;
    rdfs:label 'Vod Enabled' ;
    rdfs:comment 'Indicates whether this platform channel supports Video On Demand (VOD) content delivery. True = VOD content (highlights, replays, documentaries) can be published to this channel; False = live-only channel. Used in content routing logic to determine eligible publish targets.' ;
    rdfs:domain ind:PlatformChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissioningEditorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Commissioning Editor Employee Id' ;
    rdfs:comment 'Reference to the editorial manager or commissioning editor who created and approved the production order brief. Distinct from the assigned editor who executes the work. Supports editorial governance and approval chain tracking.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryProductionAssetId rdf:type rdf:Property ;
    rdfs:label 'Primary Production Asset Id' ;
    rdfs:comment 'Reference to the primary source media asset in the Dalet Galaxy DAM from which this production order is derived (e.g., raw match footage, raw interview recording, raw photography). Enables lineage tracing from produced output back to source material.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:primaryProductionCommissioningEditorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Production Commissioning Editor Employee Id' ;
    rdfs:comment 'Reference to the editorial manager or commissioning editor who created and approved the production order brief. Distinct from the assigned editor who executes the work. Supports editorial governance and approval chain tracking.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:billingRate rdf:type rdf:Property ;
    rdfs:label 'Billing Rate' ;
    rdfs:comment 'The rate at which this employee\'s time on this production order is billed against the production cost center, expressed in local currency per hour. May vary by role, production type, or CBA agreement. Belongs to the assignment, not to the employee master record (which holds base salary) or the production order (which does not hold per-person rates).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:briefDescription rdf:type rdf:Property ;
    rdfs:label 'Brief Description' ;
    rdfs:comment 'Short editorial brief or production description summarising the creative intent, story angle, or technical specification of the content to be produced. Provides context for assigned editors, producers, and journalists on the scope and purpose of the work order.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentDomainCode rdf:type rdf:Property ;
    rdfs:label 'Content Domain Code' ;
    rdfs:comment 'Reference to the content domain or channel category this production order belongs to (e.g., OTT platform, social media, broadcast, digital editorial). Determines distribution pathway and rights clearance requirements.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deadline rdf:type rdf:Property ;
    rdfs:label 'Deadline' ;
    rdfs:comment 'Hard deadline by which the production order must be completed and delivered. Drives SLA monitoring, priority escalation, and resource scheduling. For broadcast segments, this is typically tied to the broadcast transmission schedule. For social cuts, it is tied to the event window.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:editorialApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Editorial Approval Status' ;
    rdfs:comment 'Status of the editorial review and approval workflow for this production order. Tracks whether the content has been submitted for editorial review, approved for publication, rejected, or sent back for revision. Distinct from the overall order status — an order may be in_production while editorial approval is pending.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:editorialNotes rdf:type rdf:Property ;
    rdfs:label 'Editorial Notes' ;
    rdfs:comment 'Free-text notes from the commissioning editor or editorial reviewer providing feedback, revision instructions, or approval commentary. Captured during the editorial approval workflow in Dalet Galaxy. Supports iterative content refinement and audit trail for editorial decisions.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hoursAllocated rdf:type rdf:Property ;
    rdfs:label 'Hours Allocated' ;
    rdfs:comment 'The planned number of hours this employee is expected to contribute to this production order in their assigned role. Used for capacity planning, workload balancing, and production cost estimation. This value is specific to the employee-order-role combination and cannot reside on either entity alone.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isSponsoredContent rdf:type rdf:Property ;
    rdfs:label 'Is Sponsored Content' ;
    rdfs:comment 'Indicates whether this production order is for sponsored or branded content produced under a commercial partnership agreement. When true, FCC-mandated sponsored content disclosure labels must be applied to the output asset before distribution.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nilClearanceRequired rdf:type rdf:Property ;
    rdfs:label 'Nil Clearance Required' ;
    rdfs:comment 'Indicates whether Name, Image, and Likeness (NIL) rights clearance is required for this production order due to featured athlete content. When true, the order cannot be delivered without confirmed NIL clearance from the athlete or their representative.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderNumber rdf:type rdf:Property ;
    rdfs:label 'Order Number' ;
    rdfs:comment 'Externally-known, human-readable business identifier for the production order as assigned by Dalet Galaxy. Used by editorial and production teams to reference work orders in communications, scheduling boards, and delivery manifests.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderStatus rdf:type rdf:Property ;
    rdfs:label 'Order Status' ;
    rdfs:comment 'Current lifecycle state of the production order within the Dalet Galaxy workflow. Tracks progression from initial draft through assignment, active production, editorial review, approval, and final delivery or cancellation. [ENUM-REF-CANDIDATE: draft|assigned|in_production|pending_review|approved|delivered|cancelled — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderType rdf:type rdf:Property ;
    rdfs:label 'Order Type' ;
    rdfs:comment 'Classifies the nature of the production work order. Distinguishes between technical production types (video highlight packages, social cuts, broadcast segments, audio packages) and editorial commissioning types (editorial features, commissioned editorial/articles). Drives workflow routing in Dalet Galaxy. [ENUM-REF-CANDIDATE: video_highlight|editorial_feature|social_cut|broadcast_segment|audio_package|commissioned_editorial — promote to reference product]' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionCost rdf:type rdf:Property ;
    rdfs:label 'Production Cost' ;
    rdfs:comment 'Estimated or actual cost incurred to produce the content order, in the operating currency. Includes editor/producer time, freelancer fees, licensing costs, and technical production expenses. Used for content ROI analysis, budget tracking, and EBITDA reporting. Classified as confidential business financial data.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:productionStage rdf:type rdf:Property ;
    rdfs:label 'Production Stage' ;
    rdfs:comment 'Current stage within the content production workflow pipeline. Tracks granular progress within the broader order status. Briefing covers initial creative direction; pre-production covers asset gathering and scripting; production covers active editing/writing; post-production covers finishing and QC; review covers editorial approval; delivery covers CDN publishing.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedDate rdf:type rdf:Property ;
    rdfs:label 'Requested Date' ;
    rdfs:comment 'The principal business event timestamp recording when the production order was formally raised and submitted in Dalet Galaxy. Represents the real-world moment the content production request was initiated, distinct from system audit timestamps.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleOnProduction rdf:type rdf:Property ;
    rdfs:label 'Role On Production' ;
    rdfs:comment 'The specific crew role this employee fulfills on this production order. Determines responsibilities, billing rate applicability, and scheduling requirements. Belongs to the assignment, not to the employee (who may serve different roles on different orders) or the production order (which has multiple roles filled by different people).' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledPublishDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Publish Date' ;
    rdfs:comment 'The planned calendar date on which the produced content asset is scheduled for publication or broadcast. Used for editorial calendar planning and CDN pre-positioning. May differ from the production deadline if content is produced in advance.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ugcFlag rdf:type rdf:Property ;
    rdfs:label 'Ugc Flag' ;
    rdfs:comment 'Indicates whether this production order involves User-Generated Content (UGC) as source material. UGC-sourced orders require additional rights clearance and moderation workflows before publication. Impacts DRM clearance and editorial approval processes.' ;
    rdfs:domain ind:ProductionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bettingMarketId rdf:type rdf:Property ;
    rdfs:label 'Betting Market Id' ;
    rdfs:comment 'Foreign key linking to gaming.betting_market. Business justification: Broadcast-linked wagering: when a live content publish_event goes live (stream activation), it triggers or is associated with the opening of a corresponding betting market — a named operational proces' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BettingMarket .

ind:broadcastRightsAgreementId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Agreement Id' ;
    rdfs:comment 'Reference to the specific broadcast or media rights agreement under which this content distribution is authorized. Ensures every publish event is traceable to a valid rights contract for IP compliance and audit.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RightsAgreement .

ind:cdnVendorId rdf:type rdf:Property ;
    rdfs:label 'Cdn Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: CDN providers (Akamai, Fastly, AWS CloudFront) are vendors in the procurement system. Linking publish_event to the CDN vendor replaces the denormalized cdn_provider text field and enables SLA breach t' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:emergencyActivationId rdf:type rdf:Property ;
    rdfs:label 'Emergency Activation Id' ;
    rdfs:comment 'Foreign key linking to security.emergency_activation. Business justification: Emergency activations set broadcast_interrupted=true and can cause live publish events to be suspended or taken down. Linking the publish_event to the triggering emergency_activation is required for b' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmergencyActivation .

ind:operatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Operator Employee Id' ;
    rdfs:comment 'Reference to the content operations staff member or system account that initiated or approved this publish event. Supports accountability, audit trail, and SOX compliance for content distribution authorization.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:sponsorshipOverlaySponsorshipActivationId rdf:type rdf:Property ;
    rdfs:label 'Sponsorship Overlay Sponsorship Activation Id' ;
    rdfs:comment 'Reference to the sponsorship or advertising overlay package applied to this content distribution event. Links to the sponsorship management record for brand attribution, CPM (Cost Per Mille) reporting, and sponsor compliance.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SponsorshipActivation .

ind:assetDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Asset Duration Seconds' ;
    rdfs:comment 'Duration of the published content asset in seconds. Used for CDN bandwidth estimation, broadcast scheduling slot validation, and platform-specific duration compliance checks (e.g., social media clip length limits).' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetFileSizeMb rdf:type rdf:Property ;
    rdfs:label 'Asset File Size Mb' ;
    rdfs:comment 'File size of the published content asset in megabytes at the time of distribution. Supports CDN cost allocation, bandwidth consumption tracking, and storage capacity planning.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionNotes rdf:type rdf:Property ;
    rdfs:label 'Distribution Notes' ;
    rdfs:comment 'Free-text operational notes recorded by content operations staff regarding this publish event. May include special handling instructions, rights clearance notes, or platform-specific configuration details.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Distribution Reference Number' ;
    rdfs:comment 'Externally-known business identifier for this publish event, sourced from Dalet Galaxy distribution workflow. Used for cross-system reconciliation and audit trail tracking across CDN, OTT, and broadcast systems.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmLicenseUrl rdf:type rdf:Property ;
    rdfs:label 'Drm License Url' ;
    rdfs:comment 'The URL endpoint of the DRM license server used to validate and serve decryption keys for this content distribution. Required for OTT and DTC platform playback authorization and rights enforcement audit.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encodingProfile rdf:type rdf:Property ;
    rdfs:label 'Encoding Profile' ;
    rdfs:comment 'The video/audio encoding specification applied to the content asset for this distribution event (e.g., \'H264_1080p_5Mbps\', \'HEVC_4K_HDR\', \'AAC_128kbps\'). Supports quality assurance, platform compatibility validation, and CDN bandwidth planning.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureReason rdf:type rdf:Property ;
    rdfs:label 'Failure Reason' ;
    rdfs:comment 'Descriptive reason code or message explaining why a publish event failed or required retry. Populated only when distribution_status is \'failed\' or \'retrying\'. Supports root cause analysis and SLA reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geoRestrictionMode rdf:type rdf:Property ;
    rdfs:label 'Geo Restriction Mode' ;
    rdfs:comment 'Defines whether the territory codes in geo_restriction_territory_codes represent an allowlist (content permitted only in listed territories) or a blocklist (content blocked in listed territories). Governs territorial rights enforcement logic.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geoRestrictionTerritoryCodes rdf:type rdf:Property ;
    rdfs:label 'Geo Restriction Territory Codes' ;
    rdfs:comment 'Comma-separated list of ISO 3166-1 alpha-3 country codes defining the territories where this content is permitted or blocked. Supports broadcast rights territorial enforcement and GDPR/CCPA regional compliance. Example: \'USA,CAN,GBR\'.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLiveContent rdf:type rdf:Property ;
    rdfs:label 'Is Live Content' ;
    rdfs:comment 'Indicates whether this publish event distributes live or near-live content (e.g., live match stream, live press conference) as opposed to pre-produced or archived content. Drives latency SLA requirements and CDN live-streaming configuration.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publishInitiatedBy rdf:type rdf:Property ;
    rdfs:label 'Publish Initiated By' ;
    rdfs:comment 'Indicates how the publish event was triggered — manually by a content operator, automatically by a workflow rule, via an API (Application Programming Interface) call from an external system, or by a scheduled distribution job. Supports operational audit and workflow optimization.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publishTimestamp rdf:type rdf:Property ;
    rdfs:label 'Publish Timestamp' ;
    rdfs:comment 'The principal real-world event timestamp recording when the content asset was successfully published and made available on the target platform. Distinct from scheduled or requested times. Conforms to yyyy-MM-ddTHH:mm:ss.SSSXXX format.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:takedownReason rdf:type rdf:Property ;
    rdfs:label 'Takedown Reason' ;
    rdfs:comment 'Reason code explaining why a content asset was taken down from the target platform. Supports IP rights enforcement audit, regulatory compliance reporting, and editorial governance review.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:takedownTimestamp rdf:type rdf:Property ;
    rdfs:label 'Takedown Timestamp' ;
    rdfs:comment 'Timestamp recording when a published content asset was withdrawn or taken down from the target platform. Populated when distribution_status transitions to \'withdrawn\'. Supports rights expiry enforcement and DMCA/IP compliance audit.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ugcSourceFlag rdf:type rdf:Property ;
    rdfs:label 'Ugc Source Flag' ;
    rdfs:comment 'Indicates whether the content asset being distributed originated as User-Generated Content (UGC). UGC assets require additional rights clearance workflows and moderation approval before distribution.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workflowJobReference rdf:type rdf:Property ;
    rdfs:label 'Workflow Job Reference' ;
    rdfs:comment 'The Dalet Galaxy distribution workflow job identifier associated with this publish event. Enables cross-system traceability between the Silver layer record and the source DAM workflow execution for debugging and audit.' ;
    rdfs:domain ind:PublishEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Rights Manager Employee Id' ;
    rdfs:comment 'Reference to the internal staff member or team responsible for managing this rights clearance record, including conflict detection, resolution, and renewal. Aligns with the PARTY_REFERENCE minimum category for MASTER_AGREEMENT role.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:clearanceApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Clearance Approved By' ;
    rdfs:comment 'Name or identifier of the individual or role that formally approved this rights clearance record. Provides an audit trail for rights governance and compliance reporting.' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearanceApprovedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Clearance Approved Timestamp' ;
    rdfs:comment 'The date and time at which the rights clearance was formally approved and the clearance_status transitioned to \'cleared\'. Provides a precise audit timestamp for rights governance. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:clearanceReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Clearance Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier for the rights clearance record, used in communications with rights holders, legal teams, and licensing partners. Sourced from Dalet Galaxy DAM rights management module. Format: RC-{YYYY}-{NNNNNN}.' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearanceSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Clearance Source System' ;
    rdfs:comment 'The operational system of record from which this rights clearance record originated. Used for data lineage, audit, and reconciliation. Values: dalet_galaxy (Dalet Galaxy DAM), salesforce_crm (Salesforce CRM sponsor/partner agreements), manual (manually entered), sap_s4hana (SAP S/4HANA contract module), external_portal (rights holder self-service portal).' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Clearance Status' ;
    rdfs:comment 'Current lifecycle state of the rights clearance record. Governs whether the associated content asset may be distributed. Values: pending (awaiting approval), cleared (fully approved for distribution), expired (past effective end date), revoked (rights withdrawn by holder), disputed (under conflict review), suspended (temporarily blocked pending resolution).' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearanceType rdf:type rdf:Property ;
    rdfs:label 'Clearance Type' ;
    rdfs:comment 'Classification of the usage type for which rights have been cleared. Determines the distribution channel and technical enforcement policy applied. Values: broadcast (traditional TV/RSN), ott (Over-The-Top Streaming), social (social media platforms), ppv (Pay-Per-View), digital_download (DTC download), editorial (press/editorial use). [ENUM-REF-CANDIDATE: broadcast|ott|social|ppv|digital_download|editorial|syndication|archive|licensing — promote to reference product if additional types are required]' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictResolutionAction rdf:type rdf:Property ;
    rdfs:label 'Conflict Resolution Action' ;
    rdfs:comment 'Free-text description of the action taken to resolve the rights conflict. Documents the resolution decision, legal agreement reference, or governing body ruling applied. Populated when conflict_resolution_status is \'resolved\' or \'waived\'.' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictType rdf:type rdf:Property ;
    rdfs:label 'Conflict Type' ;
    rdfs:comment 'Classification of the type of rights conflict detected for this clearance record. Populated when rights_conflict_flag is True. Values: territory_overlap (conflicting territorial grants), platform_overlap (conflicting platform grants), exclusivity_breach (exclusive rights violated), expiry_overlap (conflicting effective date ranges), holder_dispute (competing rights holder claims). Null when no conflict exists.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictingClearanceIds rdf:type rdf:Property ;
    rdfs:label 'Conflicting Clearance Ids' ;
    rdfs:comment 'Comma-separated list of rights_clearance_id values that are in conflict with this clearance record. Populated when rights_conflict_flag is True. Used by the rights manager to identify and resolve overlapping or contradictory rights grants. Null when no conflict exists.' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentRestrictionNotes rdf:type rdf:Property ;
    rdfs:label 'Content Restriction Notes' ;
    rdfs:comment 'Free-text field capturing specific content restrictions, editorial constraints, or usage conditions attached to this rights clearance that are not captured by structured fields. Examples: \'No use in political advertising\', \'Athlete image restricted per NIL agreement\', \'Broadcast blackout within 50-mile radius of venue\'.' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daletRightsRecordReference rdf:type rdf:Property ;
    rdfs:label 'Dalet Rights Record Reference' ;
    rdfs:comment 'The native record identifier from the Dalet Galaxy DAM rights management module corresponding to this clearance record. Used for cross-system reconciliation and traceability back to the source system of record.' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceRestrictionPolicy rdf:type rdf:Property ;
    rdfs:label 'Device Restriction Policy' ;
    rdfs:comment 'Policy governing which device categories are permitted to access the content asset under this rights clearance. Enforced by the DRM system at playback. Values: no_restriction, registered_devices_only, managed_devices_only, operator_certified_only.' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmEncryptionScheme rdf:type rdf:Property ;
    rdfs:label 'Drm Encryption Scheme' ;
    rdfs:comment 'The technical DRM encryption scheme applied to the content asset for this clearance. Governs how the content is protected during CDN delivery and playback. Values: widevine (Google/Android), fairplay (Apple), playready (Microsoft), aes128 (AES-128 encryption), none (unprotected/editorial use).' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseFeeCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'License Fee Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the license fee amount (e.g., USD, GBP, EUR). Required for multi-territory rights agreements involving cross-currency licensing. Part of MONETARY_TRIPLET.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offlineDownloadPermitted rdf:type rdf:Property ;
    rdfs:label 'Offline Download Permitted' ;
    rdfs:comment 'Indicates whether the content asset may be downloaded for offline playback under this rights clearance. When True, the DRM policy layer enables offline download with time-limited licence keys. Relevant for DTC and OTT platforms.' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalNotificationDays rdf:type rdf:Property ;
    rdfs:label 'Renewal Notification Days' ;
    rdfs:comment 'Number of days before the effective_until_date at which an automated renewal notification should be triggered to the responsible rights manager. Supports proactive rights renewal workflows and prevents unintended content distribution lapses.' ;
    rdfs:domain ind:RightsClearance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:royaltyRatePercent rdf:type rdf:Property ;
    rdfs:label 'Royalty Rate Percent' ;
    rdfs:comment 'The percentage royalty rate payable to the rights holder on revenue generated from distribution of the content asset under this clearance. Expressed as a decimal fraction (e.g., 0.1250 = 12.50%). Used in royalty calculation and financial reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightsConflictId rdf:type rdf:Property ;
    rdfs:label 'Rights Conflict Id' ;
    rdfs:comment 'Unique surrogate identifier for each detected rights conflict record in the content domain. Primary key for the rights_conflict data product.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:broadcastPartnerVendorId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Partner Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: Rights conflicts in sports-entertainment frequently arise from overlapping vendor distribution agreements. Linking rights_conflict to the broadcast partner vendor enables automated vendor_incident cre' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:distributionRequestId rdf:type rdf:Property ;
    rdfs:label 'Distribution Request Id' ;
    rdfs:comment 'Reference to the scheduled publish event or distribution request that triggered the rights conflict detection.' ;
    rdfs:domain ind:Content ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DistributionRequest .

ind:priorConflictRightsConflictId rdf:type rdf:Property ;
    rdfs:label 'Prior Conflict Rights Conflict Id' ;
    rdfs:comment 'Self-referencing identifier linking this conflict to the most recent prior conflict for the same asset and rights window, enabling conflict recurrence chain analysis. Null if this is the first occurrence.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RightsConflict .

ind:settlementAgreementId rdf:type rdf:Property ;
    rdfs:label 'Settlement Agreement Id' ;
    rdfs:comment 'Foreign key linking to legal.settlement_agreement. Business justification: Rights conflicts resolved via settlement must reference the settlement_agreement for audit and compliance. rights_conflict has resolution_action and resolution_notes — when resolved by settlement, the' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SettlementAgreement .

ind:ccpaRelevant rdf:type rdf:Property ;
    rdfs:label 'Ccpa Relevant' ;
    rdfs:comment 'Indicates whether this rights conflict involves content distributed in California and therefore triggers CCPA compliance obligations, particularly for UGC assets containing personal data of California residents.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conflictReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Conflict Reference Number' ;
    rdfs:comment 'Externally-known business identifier for the rights conflict, used in communications with rights holders, legal teams, and broadcast partners. Format: RC-{YYYY}-{NNNNNN}.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictSeverity rdf:type rdf:Property ;
    rdfs:label 'Conflict Severity' ;
    rdfs:comment 'Business-assessed severity level of the rights conflict, used to prioritize resolution queues. Critical: immediate legal or financial exposure (e.g., live broadcast exclusivity breach). High: significant rights violation requiring same-day resolution. Medium: non-urgent violation with defined resolution window. Low: minor policy deviation with minimal business impact.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictSource rdf:type rdf:Property ;
    rdfs:label 'Conflict Source' ;
    rdfs:comment 'The mechanism or channel through which the rights conflict was identified. Automated DRM scan: system-detected via DRM policy engine. Manual review: identified by a rights manager during content review. Partner notification: flagged by a broadcast or distribution partner. Legal alert: raised by legal counsel. Broadcast monitoring: detected via OB or RSN broadcast monitoring tools.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictStatus rdf:type rdf:Property ;
    rdfs:label 'Conflict Status' ;
    rdfs:comment 'Current lifecycle state of the rights conflict. Detected: newly identified, awaiting triage. Under review: assigned to rights manager for investigation. Escalated: referred to legal or senior rights governance. Resolved: conflict addressed and distribution decision made. Waived: conflict acknowledged but distribution approved with documented exception. Closed: no further action required.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictingTerritoryCodes rdf:type rdf:Property ;
    rdfs:label 'Conflicting Territory Codes' ;
    rdfs:comment 'Pipe-delimited list of ISO 3166-1 alpha-3 country codes representing the geographic territories where the distribution violates active rights restrictions (e.g., \'GBR|DEU|FRA\'). Populated when conflict_type is territory_restriction.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionSystem rdf:type rdf:Property ;
    rdfs:label 'Detection System' ;
    rdfs:comment 'The operational system that detected and raised the rights conflict. Dalet Galaxy: primary DAM and rights management platform. Adobe Experience Platform: fan engagement and digital distribution monitoring. CDN monitor: Content Delivery Network geo-restriction monitoring. Broadcast monitor: OB/RSN broadcast compliance monitoring. Manual: identified by a human reviewer.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalatedTo rdf:type rdf:Property ;
    rdfs:label 'Escalated To' ;
    rdfs:comment 'The team or body to which the rights conflict was escalated for resolution. Legal counsel: internal or external legal team. Rights governance committee: internal rights oversight body. External arbitration: CAS or equivalent. League office: governing body (e.g., NFL, FIFA, NBA). Broadcast partner: escalated to the affected broadcast rights holder.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Escalation Timestamp' ;
    rdfs:comment 'The date and time when the rights conflict was escalated to legal counsel, senior rights governance, or an external arbitration body. Null if the conflict was not escalated.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:financialExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Financial Exposure Amount' ;
    rdfs:comment 'Estimated monetary exposure (in the operating currency) associated with the rights conflict, representing potential penalty, license fee liability, or damages payable to the rights holder if the conflict is not resolved. Classified as confidential due to contractual and legal sensitivity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gdprRelevant rdf:type rdf:Property ;
    rdfs:label 'Gdpr Relevant' ;
    rdfs:comment 'Indicates whether this rights conflict involves content distributed to EU territories and therefore triggers GDPR compliance obligations (e.g., right to erasure, data minimisation for UGC assets containing personal data of EU data subjects).' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isContentBlocked rdf:type rdf:Property ;
    rdfs:label 'Is Content Blocked' ;
    rdfs:comment 'Indicates whether the content asset has been blocked from distribution as a result of this rights conflict (True) or remains accessible pending resolution (False).' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrePublication rdf:type rdf:Property ;
    rdfs:label 'Is Pre Publication' ;
    rdfs:comment 'Indicates whether the rights conflict was detected before the content was published or distributed (True) or after the content was already live (False). Pre-publication conflicts allow preventive blocking; post-publication conflicts require reactive takedown actions.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRepeatConflict rdf:type rdf:Property ;
    rdfs:label 'Is Repeat Conflict' ;
    rdfs:comment 'Indicates whether this rights conflict is a recurrence of a previously resolved conflict for the same asset and rights window (True), signalling a systemic rights management issue requiring process remediation.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licensedTerritoryCodes rdf:type rdf:Property ;
    rdfs:label 'Licensed Territory Codes' ;
    rdfs:comment 'Pipe-delimited list of ISO 3166-1 alpha-3 country codes representing the territories where distribution is actually licensed under the active rights window, for comparison against the conflicting territories.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionAction rdf:type rdf:Property ;
    rdfs:label 'Resolution Action' ;
    rdfs:comment 'The specific action taken to resolve the rights conflict. Blocked: content distribution was prevented. Geo restricted: distribution restricted to licensed territories only. Takedown issued: content removed from live platforms. License extended: rights window extended to cover the distribution. Exception granted: distribution approved with documented rights holder consent. No action: conflict acknowledged but no intervention required.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionNotes rdf:type rdf:Property ;
    rdfs:label 'Resolution Notes' ;
    rdfs:comment 'Free-text narrative entered by the rights manager documenting the rationale for the resolution action, any communications with rights holders, or special circumstances justifying an exception or waiver.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolution Timestamp' ;
    rdfs:comment 'The date and time when the rights conflict was formally resolved, the resolution action was applied, or the conflict was closed. Null if the conflict is still open.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rightsWindowEndDate rdf:type rdf:Property ;
    rdfs:label 'Rights Window End Date' ;
    rdfs:comment 'The end date of the active rights window that is being violated, denormalized for conflict analysis. Null indicates an open-ended rights window.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rightsWindowStartDate rdf:type rdf:Property ;
    rdfs:label 'Rights Window Start Date' ;
    rdfs:comment 'The start date of the active rights window that is being violated, denormalized from the rights window record for conflict analysis and reporting without requiring a join.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:slaResolutionHours rdf:type rdf:Property ;
    rdfs:label 'Sla Resolution Hours' ;
    rdfs:comment 'The target number of hours within which this rights conflict must be resolved, as defined by the applicable SLA for the conflict severity level. Used to monitor rights governance SLA compliance.' ;
    rdfs:domain ind:RightsConflict ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Contract Owner Employee Id' ;
    rdfs:comment 'Reference to the internal employee or team responsible for managing and owning this syndication deal. Typically a Media Rights Manager or Content Distribution Director. Used for accountability and workflow routing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primarySyndicationVendorId rdf:type rdf:Property ;
    rdfs:label 'Primary Syndication Vendor Id' ;
    rdfs:comment 'Reference to the third-party media partner organisation receiving the syndicated content (e.g., broadcaster, OTT platform, RSN, digital publisher). Links to the partner master record in the CRM or partner registry.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:contentAssetType rdf:type rdf:Property ;
    rdfs:label 'Content Asset Type' ;
    rdfs:comment 'Classification of the content asset types covered by this syndication deal. Defines the scope of digital assets deliverable under the agreement. UGC = User-Generated Content. [ENUM-REF-CANDIDATE: video_highlights|live_stream|photography|audio|editorial|ugc|archive_footage|social_clip|documentary — promote to reference product]' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentEmbargoHours rdf:type rdf:Property ;
    rdfs:label 'Content Embargo Hours' ;
    rdfs:comment 'Number of hours after a live event concludes during which the syndication partner is contractually prohibited from publishing the content. Protects live broadcast exclusivity windows. Zero indicates no embargo.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daletDealRecordReference rdf:type rdf:Property ;
    rdfs:label 'Dalet Deal Record Reference' ;
    rdfs:comment 'The native record identifier for this syndication deal as stored in Dalet Galaxy Media Asset Management system. Enables bi-directional traceability between the lakehouse silver layer and the operational DAM system of record.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Deal Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to the syndication deal, used in partner correspondence, invoicing, and contract documentation. Format: SYN-{PARTNERCODE}-{YEAR}.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealTitle rdf:type rdf:Property ;
    rdfs:label 'Deal Title' ;
    rdfs:comment 'Human-readable descriptive title of the syndication deal, typically including the partner name, content scope, and territory (e.g., \'ESPN Latin America — NFL Highlights Feed 2025\'). Used in reporting and partner communications.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryFrequency rdf:type rdf:Property ;
    rdfs:label 'Delivery Frequency' ;
    rdfs:comment 'Agreed schedule or cadence at which syndicated content is delivered to the partner. Drives automated delivery job scheduling in Dalet Galaxy and CDN workflows.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliverySlaHours rdf:type rdf:Property ;
    rdfs:label 'Delivery Sla Hours' ;
    rdfs:comment 'Maximum number of hours from content availability to partner delivery as stipulated in the syndication agreement SLA. Used to monitor delivery performance and trigger SLA breach alerts.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:feeBillingFrequency rdf:type rdf:Property ;
    rdfs:label 'Fee Billing Frequency' ;
    rdfs:comment 'The contractual billing cycle for the syndication fee. Drives accounts receivable scheduling in SAP S/4HANA SD and financial planning in Workday Adaptive Planning.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxClipDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Max Clip Duration Seconds' ;
    rdfs:comment 'Maximum duration in seconds of any individual content clip the partner is permitted to publish under this syndication deal. Enforces clip-length restrictions common in sports highlight agreements. Nullable if no clip duration limit applies.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:partnerType rdf:type rdf:Property ;
    rdfs:label 'Partner Type' ;
    rdfs:comment 'Classification of the media partner by distribution channel type. Supports segmentation analytics and rights policy enforcement. RSN = Regional Sports Network; OTT = Over-The-Top Streaming platform. [ENUM-REF-CANDIDATE: broadcaster|ott_platform|rsn|digital_publisher|social_platform|news_agency|iptv_operator|podcast_network — promote to reference product]' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalOptionFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Option Flag' ;
    rdfs:comment 'Indicates whether the syndication deal contains a contractual renewal option clause allowing either party to extend the agreement beyond the contract_end_date under pre-agreed terms.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revenueShareBasis rdf:type rdf:Property ;
    rdfs:label 'Revenue Share Basis' ;
    rdfs:comment 'Defines the revenue base on which the revenue_share_percent is calculated. Determines whether the share applies to the partner\'s gross revenue, net revenue after costs, advertising revenue, or subscription revenue from the syndicated content.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueSharePercent rdf:type rdf:Property ;
    rdfs:label 'Revenue Share Percent' ;
    rdfs:comment 'The percentage of the partner\'s downstream revenue from the syndicated content that is remitted back to Sports Entertainment under the revenue share clause. Expressed as a percentage (e.g., 15.00 = 15%). Nullable if the deal is fee-only with no revenue share.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:syndicationFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Syndication Fee Amount' ;
    rdfs:comment 'The fixed periodic fee charged to the syndication partner for access to the content feed, expressed in the deal currency. This is the base contractual fee before revenue share adjustments. Aligns with MONETARY_TRIPLET gross-base amount for MASTER_AGREEMENT.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminationNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Termination Notice Days' ;
    rdfs:comment 'Number of calendar days\' written notice required by either party to terminate the syndication deal prior to the contract_end_date. Drives legal and operational wind-down planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:territoryExclusivityFlag rdf:type rdf:Property ;
    rdfs:label 'Territory Exclusivity Flag' ;
    rdfs:comment 'Indicates whether the syndication deal grants the partner exclusive distribution rights within the specified territory. Exclusive deals prevent concurrent syndication of the same content to competing partners in the same territory.' ;
    rdfs:domain ind:SyndicationDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transcriptId rdf:type rdf:Property ;
    rdfs:label 'Transcript Id' ;
    rdfs:comment 'Unique surrogate identifier for the transcript record. Primary key for the content.transcript data product, serving as the SSOT identity for all closed captions, subtitles, and full transcripts associated with video and audio content assets.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewOperatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Review Operator Employee Id' ;
    rdfs:comment 'Identifier of the human editor or QC operator who reviewed and approved this transcript for compliance and accuracy. Populated when generation_method is asr_human_reviewed or human. Required for audit trail under FCC and ADA compliance frameworks.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:sourceTranscriptId rdf:type rdf:Property ;
    rdfs:label 'Source Transcript Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the previous version of this transcript record when version_number > 1. Enables full version lineage chain reconstruction for compliance audit and editorial review purposes.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Transcript .

ind:accuracyScore rdf:type rdf:Property ;
    rdfs:label 'Accuracy Score' ;
    rdfs:comment 'Word Error Rate (WER)-derived accuracy percentage (0.00–100.00) representing the quality of the transcript relative to the actual spoken audio. FCC regulations require a minimum accuracy threshold for broadcast closed captions. Scores below the compliance threshold trigger human review workflows in Dalet Galaxy.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adaComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Ada Compliance Status' ;
    rdfs:comment 'Compliance status of the transcript against ADA Title III accessibility requirements for digital content. Compliant transcripts meet accuracy, synchronization, completeness, and placement standards. Non-compliant transcripts are blocked from public distribution. Exempt applies to content categories excluded from ADA captioning mandates.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:asrEngine rdf:type rdf:Property ;
    rdfs:label 'Asr Engine' ;
    rdfs:comment 'Name and version of the Automatic Speech Recognition (ASR) engine used to generate or assist in generating the transcript (e.g., AWS Transcribe, Google Speech-to-Text, Microsoft Azure Speech, Verbit, 3Play Media). Populated only when generation_method is asr_automated or asr_human_reviewed. Used for quality benchmarking and vendor performance tracking.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceReviewTimestamp rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Timestamp' ;
    rdfs:comment 'Date and time (ISO 8601 with timezone) when the transcript was formally reviewed and assessed for ADA and FCC compliance. Distinct from the approval timestamp; this records the compliance-specific evaluation event. Required for regulatory audit trails.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:coveragePct rdf:type rdf:Property ;
    rdfs:label 'Coverage Pct' ;
    rdfs:comment 'Percentage of the total content asset duration covered by this transcript (0.00–100.00). A value of 100.00 indicates full coverage. FCC and ADA regulations require full captioning coverage for broadcast and OTT content. Values below 100 trigger compliance review workflows.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daletTranscriptReference rdf:type rdf:Property ;
    rdfs:label 'Dalet Transcript Reference' ;
    rdfs:comment 'Native identifier assigned to this transcript record within the Dalet Galaxy Media Asset Management system. Used for bi-directional synchronization between the lakehouse Silver layer and the operational DAM.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fccComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Fcc Compliance Status' ;
    rdfs:comment 'Compliance status of the transcript against FCC 47 CFR Part 79 closed captioning regulations applicable to broadcast and cable television distribution. FCC-compliant transcripts are required for all broadcast and RSN (Regional Sports Network) distribution channels. Non-compliant status blocks broadcast delivery.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generationMethod rdf:type rdf:Property ;
    rdfs:label 'Generation Method' ;
    rdfs:comment 'Method by which the transcript was produced. Human-generated transcripts are manually authored by professional captioners. ASR (Automatic Speech Recognition) automated transcripts are machine-generated without human review. ASR human-reviewed transcripts are machine-generated then corrected by a human editor. Third-party vendor transcripts are sourced from external captioning service providers. Impacts accuracy score thresholds and ADA/FCC compliance eligibility.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLiveCaption rdf:type rdf:Property ;
    rdfs:label 'Is Live Caption' ;
    rdfs:comment 'Indicates whether this transcript was generated in real-time during a live broadcast or live streaming event (True) versus being produced post-production for a pre-recorded asset (False). Live captions have different FCC accuracy thresholds and are typically ASR-generated. Impacts compliance evaluation criteria.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryTrack rdf:type rdf:Property ;
    rdfs:label 'Is Primary Track' ;
    rdfs:comment 'Indicates whether this transcript is the designated primary text track for the associated content asset and language (True) or a supplementary/alternative track (False). Only one primary track per asset per language code should exist. Used by OTT packaging and broadcast playout systems to select the default caption track.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:soundEffectsFlag rdf:type rdf:Property ;
    rdfs:label 'Sound Effects Flag' ;
    rdfs:comment 'Indicates whether the transcript includes non-speech audio cues and sound effect descriptions (e.g., [CROWD CHEERING], [WHISTLE BLOWS]) required for full ADA closed-caption compliance. Sound effect captioning is mandatory for broadcast closed captions under FCC Part 79.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:speakerIdentificationFlag rdf:type rdf:Property ;
    rdfs:label 'Speaker Identification Flag' ;
    rdfs:comment 'Indicates whether the transcript includes speaker identification labels (e.g., [ANNOUNCER], [ATHLETE NAME]) within the caption text. Speaker identification is a best-practice requirement under WGBH DCMP Captioning Key and enhances accessibility for deaf and hard-of-hearing audiences.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:syncOffsetMs rdf:type rdf:Property ;
    rdfs:label 'Sync Offset Ms' ;
    rdfs:comment 'Timing offset in milliseconds applied to align the transcript text track with the audio/video stream. Positive values indicate the transcript leads the audio; negative values indicate it lags. Critical for broadcast-grade synchronization compliance and viewer experience quality on OTT and live streaming platforms.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transcriptStatus rdf:type rdf:Property ;
    rdfs:label 'Transcript Status' ;
    rdfs:comment 'Current workflow state of the transcript record within the content production and compliance pipeline. Controls eligibility for CDN distribution and OTT platform delivery. Approved and published statuses are required before distribution.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transcriptType rdf:type rdf:Property ;
    rdfs:label 'Transcript Type' ;
    rdfs:comment 'Classification of the text track by its functional purpose. Closed captions include speaker identification and non-speech audio cues for deaf/hard-of-hearing audiences (ADA/FCC compliance). Subtitles are translation-only tracks. Full transcripts are verbatim text representations. Audio descriptions narrate visual content for visually impaired audiences. Forced narratives are mandatory subtitle overlays for foreign-language dialogue.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wordErrorRate rdf:type rdf:Property ;
    rdfs:label 'Word Error Rate' ;
    rdfs:comment 'Raw Word Error Rate (WER) metric expressed as a decimal proportion (0.0000–1.0000) calculated by comparing the transcript against a reference ground-truth text. Lower values indicate higher accuracy. Used by QC workflows to determine whether ASR output meets broadcast-grade quality standards before ADA/FCC compliance certification.' ;
    rdfs:domain ind:Transcript ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ugcSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Ugc Submission Id' ;
    rdfs:comment 'Unique surrogate identifier for each user-generated content submission record in the Sports Entertainment platform. Primary key for the ugc_submission data product.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:campaignId rdf:type rdf:Property ;
    rdfs:label 'Campaign Id' ;
    rdfs:comment 'Reference to the fan engagement or marketing campaign that prompted or is associated with this UGC submission (e.g., a hashtag challenge, photo contest, or fan moment program). Null if submission is organic and not campaign-driven.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SportsEntertainment .

ind:featuredAthleteAthleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Featured Athlete Athlete Profile Id' ;
    rdfs:comment 'Reference to the primary athlete featured in the UGC submission, if identifiable. Supports Name Image and Likeness (NIL) rights management, athlete-specific content programs, and performance analytics integration.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:moderatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Moderator Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: UGC moderation is a named content operations workflow requiring employee assignment tracking for GDPR compliance, platform safety reporting, and workforce scheduling. No current employee FK on ugc_sub' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:broadcastEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Broadcast Eligible Flag' ;
    rdfs:comment 'Indicates whether this UGC submission meets the technical and rights criteria for use in broadcast or Over-The-Top (OTT) streaming distribution. True = eligible for broadcast/OTT; False = not eligible. Determined after DRM clearance and quality assessment.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentVersion rdf:type rdf:Property ;
    rdfs:label 'Consent Version' ;
    rdfs:comment 'Version identifier of the rights consent terms and conditions accepted by the fan at the time of submission. Enables legal audit trail when consent language is updated. Format: v{major}.{minor} (e.g., v2.1).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentQualityScore rdf:type rdf:Property ;
    rdfs:label 'Content Quality Score' ;
    rdfs:comment 'Automated or human-assigned quality score for the submitted content on a 0.00–100.00 scale. Reflects technical quality (resolution, audio clarity) and editorial suitability. Used to prioritise content for DAM ingestion and editorial curation.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:damIntegrationStatus rdf:type rdf:Property ;
    rdfs:label 'Dam Integration Status' ;
    rdfs:comment 'Status of the integration workflow that transfers approved UGC submissions into the Dalet Galaxy Digital Asset Management system. Tracks the pipeline from submission approval to DAM cataloguing. Values: pending, ingesting, ingested, failed, excluded.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:damIntegrationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dam Integration Timestamp' ;
    rdfs:comment 'The date and time at which the UGC submission was successfully ingested into the Dalet Galaxy Digital Asset Management system. Null until ingestion is complete.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:gdprErasureRequestedFlag rdf:type rdf:Property ;
    rdfs:label 'Gdpr Erasure Requested Flag' ;
    rdfs:comment 'Indicates whether the submitting fan has exercised their GDPR Right to Erasure (Right to be Forgotten) for this UGC submission. True = erasure requested; False = no erasure request. Triggers content removal workflow from DAM and CDN.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:moderationDecisionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Moderation Decision Timestamp' ;
    rdfs:comment 'The date and time at which the final moderation decision (approved, rejected, or escalated) was recorded for this UGC submission. Used for SLA tracking and moderation workflow performance reporting.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:moderationRejectionReason rdf:type rdf:Property ;
    rdfs:label 'Moderation Rejection Reason' ;
    rdfs:comment 'Coded reason for rejection when moderation_status is \'rejected\'. Captures the primary policy violation or quality issue (e.g., inappropriate_content, copyright_violation, low_quality, spam, off_topic). Null when not rejected. [ENUM-REF-CANDIDATE: inappropriate_content|copyright_violation|low_quality|spam|off_topic|privacy_violation|other — promote to reference product]' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalFilename rdf:type rdf:Property ;
    rdfs:label 'Original Filename' ;
    rdfs:comment 'The original filename of the content file as submitted by the fan. Retained for provenance tracking and to support fan communications referencing their specific submission.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ottDistributionFlag rdf:type rdf:Property ;
    rdfs:label 'Ott Distribution Flag' ;
    rdfs:comment 'Indicates whether this UGC submission has been approved and distributed via OTT streaming platforms. Distinct from broadcast_eligible_flag which captures eligibility; this flag captures actual distribution status.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rightsConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Rights Consent Flag' ;
    rdfs:comment 'Indicates whether the submitting fan has explicitly granted consent for Sports Entertainment to use, reproduce, and distribute the submitted content. True = consent granted; False = consent not granted or withdrawn. Critical for Digital Rights Management (DRM) compliance and legal clearance.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:submissionDescription rdf:type rdf:Property ;
    rdfs:label 'Submission Description' ;
    rdfs:comment 'Fan-provided free-text description or narrative accompanying the submitted content. Supports metadata enrichment in the DAM and editorial context for content curation programs.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Submission Reference Number' ;
    rdfs:comment 'Human-readable, externally visible reference number assigned to the UGC submission at intake. Used in fan-facing communications, moderation workflows, and rights clearance correspondence. Format: UGC-{YYYY}-{8-digit sequence}.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionTitle rdf:type rdf:Property ;
    rdfs:label 'Submission Title' ;
    rdfs:comment 'Fan-provided title or caption for the submitted content. Used in editorial curation, DAM metadata tagging, and fan-facing display on digital platforms and social channels.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterIpAddress rdf:type rdf:Property ;
    rdfs:label 'Submitter Ip Address' ;
    rdfs:comment 'IP address of the device from which the UGC was submitted. Used for fraud detection, duplicate submission identification, and jurisdictional compliance determination. Classified as confidential PII per GDPR and CCPA guidance.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageRightsExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Usage Rights Expiry Date' ;
    rdfs:comment 'The date on which the granted usage rights for this UGC submission expire. After this date, the content must not be distributed without renewed consent. Null if rights are granted in perpetuity.' ;
    rdfs:domain ind:UgcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attendanceRecordId rdf:type rdf:Property ;
    rdfs:label 'Attendance Record Id' ;
    rdfs:comment 'Unique surrogate identifier for each official attendance record associated with a completed live sports or entertainment event.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occupancySnapshotId rdf:type rdf:Property ;
    rdfs:label 'Occupancy Snapshot Id' ;
    rdfs:comment 'Foreign key linking to security.occupancy_snapshot. Business justification: Attendance reconciliation process compares official ticketing-based attendance_record against security occupancy_snapshot sensor data. Governing body reporting requires formal reconciliation between t' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OccupancySnapshot .

ind:venueManifestId rdf:type rdf:Property ;
    rdfs:label 'Venue Manifest Id' ;
    rdfs:comment 'Foreign key linking to ticketing.venue_manifest. Business justification: attendance_record reconciles approved_capacity, tickets_sold, and turnstile_count. venue_manifest defines the exact sellable capacity configuration (total_sellable_capacity, total_ada_seat_count, kill' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VenueManifest .

ind:verifiedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Verified By Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Attendance verification is a governing body compliance requirement in sports-entertainment; the verifying employee must be traceable for regulatory submission and audit. The existing verified_by plain' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:adaAccessibleAttendance rdf:type rdf:Property ;
    rdfs:label 'Ada Accessible Attendance' ;
    rdfs:comment 'Number of spectators who entered using ADA-designated accessible seating or accommodation tickets. Required for ADA compliance reporting and venue accessibility audits.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amendmentFlag rdf:type rdf:Property ;
    rdfs:label 'Amendment Flag' ;
    rdfs:comment 'Indicates whether this attendance record has been amended after initial submission, for example following a dispute resolution, scanner recount, or governing body correction request.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amendmentReason rdf:type rdf:Property ;
    rdfs:label 'Amendment Reason' ;
    rdfs:comment 'Description of the reason for amending the attendance record after initial submission. Required for audit trail and governing body compliance when figures are revised post-submission.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Amendment Timestamp' ;
    rdfs:comment 'Date and time when the most recent amendment to this attendance record was made. Supports audit trail and version history for compliance and dispute resolution.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:approvedCapacity rdf:type rdf:Property ;
    rdfs:label 'Approved Capacity' ;
    rdfs:comment 'Maximum number of spectators permitted in the venue for this specific event as approved by local authorities and venue management. May differ from total venue capacity due to configuration, ADA requirements, or safety restrictions.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attendanceClassification rdf:type rdf:Property ;
    rdfs:label 'Attendance Classification' ;
    rdfs:comment 'Categorical classification of the event\'s attendance performance relative to approved capacity. Used for league benchmarking, sponsor reporting, and broadcast rights valuation. [ENUM-REF-CANDIDATE: sellout|near_sellout|strong|average|below_average|poor — promote to reference product if additional tiers are required]' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attendanceType rdf:type rdf:Property ;
    rdfs:label 'Attendance Type' ;
    rdfs:comment 'Classification of how the fan attended the fixture — physically in-venue, via PPV stream, virtual broadcast, hospitality package, or complimentary access. Determines loyalty point multipliers and CRM segmentation.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastAnnouncedAttendance rdf:type rdf:Property ;
    rdfs:label 'Broadcast Announced Attendance' ;
    rdfs:comment 'Official attendance figure announced during the live broadcast of the event. May differ from the final verified figure due to timing of announcement versus final gate close. Relevant for broadcast compliance and media reporting.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capacityUtilizationPct rdf:type rdf:Property ;
    rdfs:label 'Capacity Utilization Pct' ;
    rdfs:comment 'Percentage of approved venue capacity represented by the official paid attendance figure. Calculated as (paid_attendance / approved_capacity) * 100. Core KPI for venue operations, sponsorship valuation, and league reporting.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:checkInTimestamp rdf:type rdf:Property ;
    rdfs:label 'Check In Timestamp' ;
    rdfs:comment 'The date and time the fan physically checked in or scanned their ticket at the venue for this fixture. Used for operational reporting, loyalty point triggering, and fan experience analytics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:compTicketsUsed rdf:type rdf:Property ;
    rdfs:label 'Comp Tickets Used' ;
    rdfs:comment 'Number of complimentary (non-revenue) tickets that were scanned and used for entry. Includes sponsor comps, media credentials, VIP passes, and player/staff allocations.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:engagementScore rdf:type rdf:Property ;
    rdfs:label 'Engagement Score' ;
    rdfs:comment 'A computed or captured score representing the fan\'s level of engagement during this specific fixture attendance (e.g., app interactions, social shares, in-venue purchases). Belongs to the attendance instance, not the fan\'s overall profile.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventDate rdf:type rdf:Property ;
    rdfs:label 'Event Date' ;
    rdfs:comment 'Calendar date on which the live event took place. Used as the principal business event date for attendance reporting, season scheduling analysis, and regulatory filings.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gaAttendance rdf:type rdf:Property ;
    rdfs:label 'Ga Attendance' ;
    rdfs:comment 'Number of spectators who entered via General Admission (GA) tickets, representing unreserved standing or open seating areas. Relevant for crowd management, safety compliance, and SRO (Standing Room Only) capacity monitoring.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gatesCloseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Gates Close Timestamp' ;
    rdfs:comment 'Date and time at which venue entry gates were officially closed and final turnstile counts were locked. Represents the principal business event timestamp for attendance finalization.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:governingBodyReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Governing Body Reported Flag' ;
    rdfs:comment 'Indicates whether the official attendance figures for this event have been submitted to the relevant sports governing body (e.g., NFL, NBA, FIFA, NHL, MLS). Required for league compliance and official record-keeping.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:governingBodySubmissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Governing Body Submission Timestamp' ;
    rdfs:comment 'Date and time when the official attendance record was submitted to the relevant sports governing body. Supports compliance audit trails and SLA tracking for post-event reporting obligations.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:groupTicketCount rdf:type rdf:Property ;
    rdfs:label 'Group Ticket Count' ;
    rdfs:comment 'Number of entries attributed to group ticket sales (typically 10+ tickets sold as a block to organizations, schools, or corporate groups). Supports group sales performance reporting.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:loyaltyPointsEarned rdf:type rdf:Property ;
    rdfs:label 'Loyalty Points Earned' ;
    rdfs:comment 'The number of loyalty program points awarded to the fan for attending this specific fixture. Varies by ticket category, attendance type, and event tier. Cannot reside on fan_profile (which holds the running balance) or fixture (which is event-level).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mediaCredentialCount rdf:type rdf:Property ;
    rdfs:label 'Media Credential Count' ;
    rdfs:comment 'Number of credentialed media personnel (press, broadcast, photographers) who accessed the venue for this event. Tracked separately from spectator attendance for accreditation and broadcast compliance.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:noShowCount rdf:type rdf:Property ;
    rdfs:label 'No Show Count' ;
    rdfs:comment 'Number of tickets sold or issued for which no corresponding entry scan was recorded. Calculated as tickets sold plus comp tickets issued minus turnstile count. Key metric for venue operations and fan engagement analysis.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paidAttendance rdf:type rdf:Property ;
    rdfs:label 'Paid Attendance' ;
    rdfs:comment 'Official count of spectators who entered the venue on a paid ticket basis. This is the primary figure reported to governing bodies and used in official league attendance statistics.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Record Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for this attendance record, used in official league submissions, governing body filings, and post-event reconciliation reports.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordStatus rdf:type rdf:Property ;
    rdfs:label 'Record Status' ;
    rdfs:comment 'Current lifecycle status of the attendance record. Tracks progression from initial draft capture through governing body verification and final official publication. [ENUM-REF-CANDIDATE: draft|submitted|verified|disputed|final|amended — promote to reference product if additional statuses are required]' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resaleTicketCount rdf:type rdf:Property ;
    rdfs:label 'Resale Ticket Count' ;
    rdfs:comment 'Number of entries attributed to tickets purchased through secondary market or official resale channels. Supports secondary market analysis and revenue leakage assessment.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonTicketHolderCount rdf:type rdf:Property ;
    rdfs:label 'Season Ticket Holder Count' ;
    rdfs:comment 'Number of entries attributed to season ticket holders for this event. Used to measure season ticket utilization rates and inform renewal and fan engagement strategies.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seatSection rdf:type rdf:Property ;
    rdfs:label 'Seat Section' ;
    rdfs:comment 'The venue section or zone where the fan was seated or stood for this fixture. Belongs to the attendance record, not the fan profile or fixture master, as it varies per attendance instance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selloutFlag rdf:type rdf:Property ;
    rdfs:label 'Sellout Flag' ;
    rdfs:comment 'Indicates whether the event achieved a sellout, defined as paid attendance reaching or exceeding 100% of approved capacity. Used in league marketing, broadcast negotiations, and sponsor reporting.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ticketCategory rdf:type rdf:Property ;
    rdfs:label 'Ticket Category' ;
    rdfs:comment 'The commercial category of the ticket used by the fan for this specific fixture. Determines pricing tier, access rights, and loyalty point earn rate for this attendance instance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketingSystemEventCode rdf:type rdf:Property ;
    rdfs:label 'Ticketing System Event Code' ;
    rdfs:comment 'Native event identifier from the source ticketing platform (Ticketmaster / AXS or Archtics) used to reconcile attendance figures against ticket sales and access control scan records.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketsSold rdf:type rdf:Property ;
    rdfs:label 'Tickets Sold' ;
    rdfs:comment 'Total number of paid tickets sold for the event across all sales channels (box office, online, mobile, resale). Represents the commercial demand figure prior to event day.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:turnstileCount rdf:type rdf:Property ;
    rdfs:label 'Turnstile Count' ;
    rdfs:comment 'Actual number of unique ticket scans recorded at venue entry points via access control systems. Represents the physical headcount of spectators who passed through gates, distinct from paid attendance.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:varianceCount rdf:type rdf:Property ;
    rdfs:label 'Variance Count' ;
    rdfs:comment 'Numerical difference between tickets sold (plus comps issued) and actual turnstile scan count. A non-zero variance triggers reconciliation review. Positive value indicates more tickets issued than scans; negative indicates scan anomalies.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:varianceReason rdf:type rdf:Property ;
    rdfs:label 'Variance Reason' ;
    rdfs:comment 'Free-text or coded explanation for any material variance between tickets issued and turnstile count. Common reasons include scanner malfunction, duplicate scan prevention, late entry, or system outage.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Verification Timestamp' ;
    rdfs:comment 'Date and time when the attendance figures were officially verified and approved by the designated venue or league official. Marks the transition from submitted to verified status.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:vipAttendance rdf:type rdf:Property ;
    rdfs:label 'Vip Attendance' ;
    rdfs:comment 'Number of spectators who entered via VIP hospitality credentials, premium suite access, or club-level passes. Used for premium experience reporting and sponsor hospitality fulfillment tracking.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weatherCondition rdf:type rdf:Property ;
    rdfs:label 'Weather Condition' ;
    rdfs:comment 'Recorded weather condition at the venue during the event. Used to contextualize attendance figures, particularly for outdoor venues where weather materially affects turnout. [ENUM-REF-CANDIDATE: clear|cloudy|rain|heavy_rain|snow|fog|extreme_heat|storm|postponed_weather — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Weather Impact Flag' ;
    rdfs:comment 'Indicates whether adverse weather conditions were recorded as a contributing factor to attendance shortfall or no-show rates for this event. Supports force majeure analysis and insurance claim documentation.' ;
    rdfs:domain ind:AttendanceRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bracketId rdf:type rdf:Property ;
    rdfs:label 'Bracket Id' ;
    rdfs:comment 'Unique surrogate identifier for the tournament bracket record. Primary key for the bracket data product within the event domain.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bracket .

ind:advancementRule rdf:type rdf:Property ;
    rdfs:label 'Advancement Rule' ;
    rdfs:comment 'Rule governing how participants advance from one round to the next within this bracket. Determines winner progression logic used to fill subsequent bracket slots.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageCategory rdf:type rdf:Property ;
    rdfs:label 'Age Category' ;
    rdfs:comment 'Age division classification for the bracket (e.g., youth, junior, senior, masters). Ensures compliance with governing body eligibility rules and CBA age restrictions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bracketCode rdf:type rdf:Property ;
    rdfs:label 'Bracket Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this bracket within the tournament management system. Used in broadcast overlays, fan engagement platforms, and league governance communications.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bracketName rdf:type rdf:Property ;
    rdfs:label 'Bracket Name' ;
    rdfs:comment 'Human-readable display name for the bracket (e.g., \'Men\'s Singles Main Draw\', \'Western Conference Playoffs Bracket\'). Used in broadcast overlays, fan engagement platforms, and digital content.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bracketStatus rdf:type rdf:Property ;
    rdfs:label 'Bracket Status' ;
    rdfs:comment 'Current lifecycle state of the bracket from initial draft through post-event reconciliation. Drives workflow routing in league governance, broadcast scheduling, and fan engagement platforms. [ENUM-REF-CANDIDATE: draft|announced|seeding_complete|in_progress|completed|cancelled|suspended — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bracketType rdf:type rdf:Property ;
    rdfs:label 'Bracket Type' ;
    rdfs:comment 'Classification of the bracket format governing advancement rules. Determines how winners and losers progress through the draw. [ENUM-REF-CANDIDATE: single_elimination|double_elimination|round_robin|swiss|group_stage|repechage — promote to reference product if additional formats are required]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastOverlayEnabled rdf:type rdf:Property ;
    rdfs:label 'Broadcast Overlay Enabled' ;
    rdfs:comment 'Indicates whether real-time bracket visualization data is enabled for broadcast overlay graphics. When true, bracket progression data is streamed to broadcast production systems for on-screen display.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:byeCount rdf:type rdf:Property ;
    rdfs:label 'Bye Count' ;
    rdfs:comment 'Number of bye assignments in the first round of the bracket, granted when total entrants do not fill a power-of-two draw. Byes automatically advance the assigned participant to the next round.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consolationBracket rdf:type rdf:Property ;
    rdfs:label 'Consolation Bracket' ;
    rdfs:comment 'Indicates whether a consolation or losers bracket exists alongside this main bracket, as in double-elimination formats. When true, loser advancement rules apply and a separate bracket reset may be triggered.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:currentRound rdf:type rdf:Property ;
    rdfs:label 'Current Round' ;
    rdfs:comment 'The round number currently in progress within the bracket. Updated in real-time as results are confirmed and participants advance. Drives real-time bracket visualization for broadcast overlays and fan engagement platforms.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drawDate rdf:type rdf:Property ;
    rdfs:label 'Draw Date' ;
    rdfs:comment 'Calendar date on which the official bracket draw ceremony was or is scheduled to be conducted. Marks the transition from seeding_complete to announced status.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:drawTimestamp rdf:type rdf:Property ;
    rdfs:label 'Draw Timestamp' ;
    rdfs:comment 'Precise date and time at which the official bracket draw was executed, including timezone offset. Used for broadcast scheduling and audit trail of bracket creation.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fanEngagementVisible rdf:type rdf:Property ;
    rdfs:label 'Fan Engagement Visible' ;
    rdfs:comment 'Indicates whether this bracket is published and visible on fan engagement platforms (Adobe Experience Platform, DTC apps, OTT services). Controls public-facing bracket display and fan prediction features.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genderCategory rdf:type rdf:Property ;
    rdfs:label 'Gender Category' ;
    rdfs:comment 'Gender classification of the competition bracket as defined by the governing body. Used for scheduling, broadcast rights segmentation, and compliance with IOC and governing body regulations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastResultTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Result Timestamp' ;
    rdfs:comment 'Timestamp of the most recent match result that triggered a bracket slot update. Used for real-time bracket synchronization with broadcast overlays and fan engagement platforms.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:phase rdf:type rdf:Property ;
    rdfs:label 'Phase' ;
    rdfs:comment 'Specific competition phase or stage this bracket represents within the overall tournament structure (e.g., qualifying, group stage, knockout rounds). [ENUM-REF-CANDIDATE: qualifying|group_stage|round_of_64|round_of_32|round_of_16|quarterfinal|semifinal|third_place|final — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:predictionGameEnabled rdf:type rdf:Property ;
    rdfs:label 'Prediction Game Enabled' ;
    rdfs:comment 'Indicates whether fan bracket prediction and pick\'em games are activated for this bracket on fan engagement platforms. Drives fan engagement KPI tracking and NPS measurement.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resetRule rdf:type rdf:Property ;
    rdfs:label 'Reset Rule' ;
    rdfs:comment 'Rule defining whether and how the bracket resets in double-elimination formats when the losers bracket winner faces the undefeated winners bracket champion. Governs whether a grand final reset match is required.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultSource rdf:type rdf:Property ;
    rdfs:label 'Result Source' ;
    rdfs:comment 'Source system or process from which match results are ingested to update bracket slot progression. Includes VAR (Video Assistant Referee) and TMO (Television Match Official) review outcomes for result verification.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seedingLocked rdf:type rdf:Property ;
    rdfs:label 'Seeding Locked' ;
    rdfs:comment 'Indicates whether the seeding assignments for this bracket have been finalized and locked, preventing further modifications. Set to true after the official draw ceremony.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seedingMethod rdf:type rdf:Property ;
    rdfs:label 'Seeding Method' ;
    rdfs:comment 'Method used to assign seeding positions to participants in the bracket draw. Determines competitive fairness and scheduling of top seeds to avoid early high-profile matchups.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slotFillMethod rdf:type rdf:Property ;
    rdfs:label 'Slot Fill Method' ;
    rdfs:comment 'Method by which future bracket slots are populated as results are confirmed. \'Automatic\' fills slots immediately upon result confirmation; \'manual\' requires league office intervention; \'pending_result\' holds slot until result is verified.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPlaceMatch rdf:type rdf:Property ;
    rdfs:label 'Third Place Match' ;
    rdfs:comment 'Indicates whether this bracket includes a third-place playoff match between the two semifinal losers. Relevant for broadcast scheduling and ticketing inventory allocation.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tiebreakerRule rdf:type rdf:Property ;
    rdfs:label 'Tiebreaker Rule' ;
    rdfs:comment 'Description of the tiebreaker rule applied when participants are level on points or score at the end of regulation (e.g., \'away goals\', \'penalty shootout\', \'sudden death overtime\', \'head-to-head record\'). Governs conditional scheduling of additional fixtures. [ENUM-REF-CANDIDATE: promote to reference product for full tiebreaker taxonomy]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalEntrants rdf:type rdf:Property ;
    rdfs:label 'Total Entrants' ;
    rdfs:comment 'Number of teams, athletes, or participants entered into this bracket. May differ from total_slots when byes are assigned to fill power-of-two draw sizes.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalRounds rdf:type rdf:Property ;
    rdfs:label 'Total Rounds' ;
    rdfs:comment 'Total number of rounds in this bracket structure. Defines the depth of the bracket tree and is used to pre-generate slot positions and schedule future fixtures.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalSlots rdf:type rdf:Property ;
    rdfs:label 'Total Slots' ;
    rdfs:comment 'Total number of matchup slots in the bracket across all rounds. Determines the capacity of the draw and is used for seeding assignment and bye allocation.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weightClass rdf:type rdf:Property ;
    rdfs:label 'Weight Class' ;
    rdfs:comment 'Weight class designation for combat sports brackets (e.g., UFC lightweight, heavyweight). Null for non-combat sports. Governs participant eligibility and WADA weigh-in compliance requirements.' ;
    rdfs:domain ind:Bracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adInventorySeconds rdf:type rdf:Property ;
    rdfs:label 'Ad Inventory Seconds' ;
    rdfs:comment 'Total available advertising inventory in seconds within this broadcast window. Used for ad sales, CPM revenue forecasting, and sponsor fulfillment tracking.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alternateCommentaryLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Alternate Commentary Language Code' ;
    rdfs:comment 'ISO 639-1/639-2 language code for a secondary or alternate commentary track (e.g., Spanish-language feed on an English-primary broadcast). Supports multi-language broadcast packages.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Broadcast End Timestamp' ;
    rdfs:comment 'Expected end time of the broadcast window, including post-match coverage, analysis segments, and sign-off. Used for scheduling adjacent programming and managing broadcast slot duration.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:broadcastKickoffTimestamp rdf:type rdf:Property ;
    rdfs:label 'Broadcast Kickoff Timestamp' ;
    rdfs:comment 'The contractually mandated or broadcaster-driven start time for the fixture as required by the broadcast window. May differ from the venue-local scheduled start time due to broadcast scheduling constraints (e.g., network prime-time requirements).' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:broadcastRightsRegion rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Region' ;
    rdfs:comment 'The geographic market or territory in which this digital touchpoint is licensed to distribute this fixture. Belongs to the distribution record because the same fixture may have different licensed regions per touchpoint.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Confirmation Timestamp' ;
    rdfs:comment 'Timestamp when this broadcast window assignment was formally confirmed by the broadcaster and the rights holder. Marks the transition from draft/provisional to confirmed status.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:coverageStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Status' ;
    rdfs:comment 'Operational lifecycle status of this fixture\'s coverage under this deal. Tracks whether the rights coverage is scheduled, confirmed by both parties, currently live, completed post-broadcast, or under dispute.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daletScheduleReference rdf:type rdf:Property ;
    rdfs:label 'Dalet Schedule Reference' ;
    rdfs:comment 'Source system identifier from Dalet Galaxy Media Asset Management and Broadcast Workflow platform for this broadcast window schedule entry. Enables bi-directional reconciliation between the lakehouse and the operational broadcast scheduling system.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalStreamingIncluded rdf:type rdf:Property ;
    rdfs:label 'Digital Streaming Included' ;
    rdfs:comment 'Indicates whether the broadcast window rights package includes simultaneous or catch-up digital/OTT streaming rights in addition to linear broadcast. Drives DTC and OTT platform activation.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drmPolicyCode rdf:type rdf:Property ;
    rdfs:label 'Drm Policy Code' ;
    rdfs:comment 'Code referencing the Digital Rights Management (DRM) policy applied to this broadcast window for digital and OTT distribution. Governs content protection, geo-restriction enforcement, and stream encryption requirements.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedViewership rdf:type rdf:Property ;
    rdfs:label 'Expected Viewership' ;
    rdfs:comment 'Projected audience size (number of viewers) for this broadcast window in the specified territory. Used for CPM pricing, sponsor valuation, and rights fee benchmarking. Sourced from historical ratings and audience research.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geoRestrictionApplicable rdf:type rdf:Property ;
    rdfs:label 'Geo Restriction Applicable' ;
    rdfs:comment 'Indicates whether geographic blackout or content restriction rules are enforced for this specific fixture-touchpoint combination. Distinct from the touchpoint-level geo_restriction_enabled flag, which is a capability indicator rather than a per-fixture enforcement decision.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isExclusive rdf:type rdf:Property ;
    rdfs:label 'Is Exclusive' ;
    rdfs:comment 'Indicates whether this broadcast window grants exclusive rights to the primary broadcaster in the specified territory, preventing simultaneous broadcast by competing networks or platforms.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFreeToAir rdf:type rdf:Property ;
    rdfs:label 'Is Free To Air' ;
    rdfs:comment 'Indicates whether this broadcast window is distributed on a free-to-air (FTA) basis, accessible to all viewers without subscription or pay-per-view purchase. Relevant for regulatory compliance in markets with FTA obligations for major sporting events.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kickoffConstraintReason rdf:type rdf:Property ;
    rdfs:label 'Kickoff Constraint Reason' ;
    rdfs:comment 'Reason code explaining why the broadcast-driven kickoff time was set, particularly when it differs from the venue-preferred or league-default time. Supports scheduling governance and CBA compliance review. [ENUM-REF-CANDIDATE: broadcaster_prime_time|network_scheduling|rights_agreement|league_mandate|venue_curfew|international_window|other — promote to reference product]' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:localKickoffTimestamp rdf:type rdf:Property ;
    rdfs:label 'Local Kickoff Timestamp' ;
    rdfs:comment 'Territory-specific local start time for the broadcast, accounting for the time zone of the target broadcast market. Distinct from the venue-local kickoff and the broadcaster-mandated kickoff timestamp.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:localTimezone rdf:type rdf:Property ;
    rdfs:label 'Local Timezone' ;
    rdfs:comment 'IANA timezone identifier for the target broadcast territory (e.g., \'America/New_York\', \'Europe/London\'). Used to derive local broadcast times for scheduling, EPG (Electronic Programme Guide) listings, and fan-facing communications.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postShowEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Post Show End Timestamp' ;
    rdfs:comment 'Scheduled end time for post-match broadcast coverage (interviews, analysis, highlights recap). Defines the full broadcast slot duration for rights and scheduling purposes.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:preShowStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Pre Show Start Timestamp' ;
    rdfs:comment 'Scheduled start time for pre-match broadcast coverage (warm-up shows, analyst panels, player arrivals). Determines when the broadcast feed must be live ahead of kickoff.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:primaryBroadcasterName rdf:type rdf:Property ;
    rdfs:label 'Primary Broadcaster Name' ;
    rdfs:comment 'Name of the primary broadcaster or network holding the rights to air this fixture in the assigned territory (e.g., \'ESPN\', \'Sky Sports\', \'beIN Sports\'). Operational reference for production coordination and rights management.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightsFeeAllocation rdf:type rdf:Property ;
    rdfs:label 'Rights Fee Allocation' ;
    rdfs:comment 'The portion of the total deal value (in USD) allocated to this specific fixture under this media rights deal. Used for per-fixture revenue recognition, reporting, and rights accounting. Belongs to the fixture-deal combination, not to either entity alone.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleConflictFlag rdf:type rdf:Property ;
    rdfs:label 'Schedule Conflict Flag' ;
    rdfs:comment 'Indicates whether this broadcast window has a detected scheduling conflict with another fixture or broadcast slot on the same channel or in the same territory. Triggers scheduling review workflow.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slotDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Slot Duration Minutes' ;
    rdfs:comment 'Total allocated broadcast slot duration in minutes, including pre-show, match/event, and post-show coverage. Used for EPG scheduling, ad inventory planning, and broadcaster contractual slot compliance.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:territoryCountryCode rdf:type rdf:Property ;
    rdfs:label 'Territory Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code identifying the primary broadcast territory for this window. Governs rights enforcement, blackout rules, and geo-targeted distribution. Use \'WLD\' for worldwide rights.' ;
    rdfs:domain ind:BroadcastWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windowName rdf:type rdf:Property ;
    rdfs:label 'Window Name' ;
    rdfs:comment 'Human-readable label for this broadcast window assignment (e.g., \'Sunday Night Football - Week 12\', \'UEFA Champions League Final - Prime Slot\'). Used in scheduling dashboards and production briefs.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conferenceId rdf:type rdf:Property ;
    rdfs:label 'Conference Id' ;
    rdfs:comment 'Foreign key linking to league.conference. Business justification: Competition rounds are scoped to conferences (e.g., AFC Championship Round). Normalizing conference_scope text to a proper FK supports conference-level scheduling reports, standings calculations, and ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Conference .

ind:fixtureCalendarId rdf:type rdf:Property ;
    rdfs:label 'Fixture Calendar Id' ;
    rdfs:comment 'Foreign key linking to event.fixture_calendar. Business justification: competition_round defines the rounds and phases within a season, and fixture_calendar is the published fixture schedule for that season. A competition_round belongs to a specific fixture_calendar publ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FixtureCalendar .

ind:broadcastWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Broadcast Window End' ;
    rdfs:comment 'End timestamp of the broadcast rights window for this competition round. Marks the expiry of live and near-live broadcast entitlements for OTT, RSN, and linear TV distribution.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:broadcastWindowStart rdf:type rdf:Property ;
    rdfs:label 'Broadcast Window Start' ;
    rdfs:comment 'Start timestamp of the broadcast rights window for this competition round. Used by Dalet Galaxy and broadcast rights management to schedule OTT, RSN, and linear TV distribution slots.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:byeWeekFlag rdf:type rdf:Property ;
    rdfs:label 'Bye Week Flag' ;
    rdfs:comment 'Indicates whether this round is designated as a bye week or rest round in which some or all teams do not compete. Common in NFL scheduling. Affects standings calculation and fixture generation logic.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:completedFixtureCount rdf:type rdf:Property ;
    rdfs:label 'Completed Fixture Count' ;
    rdfs:comment 'Number of fixtures within this round that have been fully played and results confirmed. Used to track round completion progress and trigger standings recalculation workflows.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:externalRoundReference rdf:type rdf:Property ;
    rdfs:label 'External Round Reference' ;
    rdfs:comment 'Identifier for this competition round as assigned by an external governing body or source system (e.g., FIFA round ID, NFL schedule system ID, Ticketmaster event group ID). Used for cross-system reconciliation and API integration.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fixtureCount rdf:type rdf:Property ;
    rdfs:label 'Fixture Count' ;
    rdfs:comment 'Total number of fixtures (matches, games, bouts) scheduled within this competition round. Used for scheduling validation, broadcast slot planning, and venue operations capacity planning.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:neutralVenueFlag rdf:type rdf:Property ;
    rdfs:label 'Neutral Venue Flag' ;
    rdfs:comment 'Indicates whether all fixtures in this round are played at a neutral venue rather than home/away venues (e.g., Super Bowl, FIFA World Cup Final, NBA All-Star Game). Affects ticketing allocation and venue operations planning.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overtimeRule rdf:type rdf:Property ;
    rdfs:label 'Overtime Rule' ;
    rdfs:comment 'Rule governing how drawn or tied fixtures in this round are resolved beyond regulation time (e.g., extra time followed by penalty shootout in FIFA knockout rounds, overtime period in NHL, shootout in NHL regular season). Affects fixture duration planning and broadcast scheduling.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointsForDraw rdf:type rdf:Property ;
    rdfs:label 'Points For Draw' ;
    rdfs:comment 'Number of competition points awarded to each team for a draw/tie in this round. Typically 1 in soccer/football formats; 0 in elimination formats. Drives standings calculation.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pointsForLoss rdf:type rdf:Property ;
    rdfs:label 'Points For Loss' ;
    rdfs:comment 'Number of competition points awarded to a team or athlete for a loss in this round. Typically 0, but some leagues award 1 point for an overtime/shootout loss (e.g., NHL). Drives standings calculation.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pointsForWin rdf:type rdf:Property ;
    rdfs:label 'Points For Win' ;
    rdfs:comment 'Number of competition points awarded to a team or athlete for a win in this round. May vary by stage (e.g., 3 points in group stage, not applicable in knockout). Drives standings calculation.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ppvFlag rdf:type rdf:Property ;
    rdfs:label 'Ppv Flag' ;
    rdfs:comment 'Indicates whether fixtures in this round are distributed as Pay-Per-View (PPV) events rather than included in standard broadcast or subscription packages. Affects revenue recognition and fan access entitlement logic.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roundCode rdf:type rdf:Property ;
    rdfs:label 'Round Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the competition round used in scheduling systems, broadcast feeds, and fixture APIs (e.g., NFL-2024-WK01, FIFA-WC-QF1, NBA-2024-R1). Unique within a season or tournament.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roundName rdf:type rdf:Property ;
    rdfs:label 'Round Name' ;
    rdfs:comment 'Human-readable display name of the competition round as used in broadcast, ticketing, and fan-facing platforms (e.g., \'Week 1\', \'Matchday 3\', \'Quarter-Final\', \'Wild Card Round\', \'Conference Championship\', \'Super Bowl\', \'Group Stage Round 2\').' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roundStatus rdf:type rdf:Property ;
    rdfs:label 'Round Status' ;
    rdfs:comment 'Current lifecycle state of the competition round. Drives fixture scheduling workflows, standings publication, and broadcast planning. Transitions from scheduled → in_progress → completed, or to postponed/cancelled/suspended for disrupted rounds.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roundType rdf:type rdf:Property ;
    rdfs:label 'Round Type' ;
    rdfs:comment 'Format of competition within this round — whether fixtures are single-leg, two-legged (home and away), best-of series (e.g., NBA Playoffs best-of-7), round-robin, or elimination format. Governs fixture generation and advancement rules.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonTicketApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Season Ticket Applicable Flag' ;
    rdfs:comment 'Indicates whether season ticket holders\' entitlements apply to fixtures in this round. Some playoff or special event rounds may require separate ticket purchases even for season ticket holders.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sponsorshipActivationFlag rdf:type rdf:Property ;
    rdfs:label 'Sponsorship Activation Flag' ;
    rdfs:comment 'Indicates whether dedicated sponsorship activations are planned for this competition round (e.g., title sponsorship of a playoff round, naming rights for a championship week). Triggers Salesforce CRM sponsorship workflow.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stageType rdf:type rdf:Property ;
    rdfs:label 'Stage Type' ;
    rdfs:comment 'Classification of the competition stage this round belongs to, distinguishing regular season weeks from playoff brackets, group stages, knockout rounds, and championship finals. Drives standings calculation rules and bracket progression logic. [ENUM-REF-CANDIDATE: regular_season|group_stage|knockout|playoff|final|wildcard|conference_championship|all_star|preseason — promote to reference product]' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketSaleEndDate rdf:type rdf:Property ;
    rdfs:label 'Ticket Sale End Date' ;
    rdfs:comment 'Date on which ticket sales close for fixtures in this competition round. Used by Ticketmaster/AXS and Archtics to manage inventory cutoff and gate access configuration.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ticketSaleStartDate rdf:type rdf:Property ;
    rdfs:label 'Ticket Sale Start Date' ;
    rdfs:comment 'Date on which ticket sales open for fixtures in this competition round. Used by Ticketmaster/AXS and Archtics to configure on-sale windows and dynamic pricing rules.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:varApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Var Applicable Flag' ;
    rdfs:comment 'Indicates whether Video Assistant Referee (VAR) technology is in use for fixtures in this competition round. Relevant for FIFA, MLS, and other football competitions. Affects match officiating logistics and broadcast production planning.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wadaTestingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Wada Testing Required Flag' ;
    rdfs:comment 'Indicates whether WADA-mandated Performance Enhancing Drug (PED) testing is required for athletes competing in this round. Triggers compliance workflows and athlete notification processes per WADA Anti-Doping Code.' ;
    rdfs:domain ind:CompetitionRound ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:calendarGoverningBodyId rdf:type rdf:Property ;
    rdfs:label 'Calendar Governing Body Id' ;
    rdfs:comment 'Reference to the sanctioning or governing body (e.g., FIFA, NFL, NBA, IOC) that has jurisdiction over this season and its fixture calendar.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GoverningBody .

ind:calendarSchedulingAuthorityGoverningBodyId rdf:type rdf:Property ;
    rdfs:label 'Calendar Scheduling Authority Governing Body Id' ;
    rdfs:comment 'Reference to the organisational unit or external body responsible for publishing and maintaining the official fixture schedule for this season.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GoverningBody .

ind:blackoutDates rdf:type rdf:Property ;
    rdfs:label 'Blackout Dates' ;
    rdfs:comment 'Comma-separated list of specific dates on which no fixtures may be scheduled due to regulatory, contractual, or operational constraints (e.g., broadcast blackout windows, public holidays, conflicting major events). Enforced by the scheduling authority.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:byeWeeks rdf:type rdf:Property ;
    rdfs:label 'Bye Weeks' ;
    rdfs:comment 'Comma-separated list of round/week numbers designated as bye weeks (no fixtures scheduled). Relevant primarily for NFL and similar league formats. Used by broadcast schedulers in Dalet Galaxy to fill programming gaps and by venue operations for maintenance windows.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calendarStatus rdf:type rdf:Property ;
    rdfs:label 'Calendar Status' ;
    rdfs:comment 'Current publication status of the fixture calendar. Controls downstream visibility and consumption: \'draft\' is internal only; \'published\' is the official release to broadcast, ticketing, and venue operations; \'amended\' indicates a post-publication revision; \'suspended\' indicates a temporary halt; \'archived\' is end-of-life.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbaApplicable rdf:type rdf:Property ;
    rdfs:label 'Cba Applicable' ;
    rdfs:comment 'Indicates whether the season schedule is governed by an active Collective Bargaining Agreement (CBA) between the league and players\' association. When true, CBA constraints on game counts, rest days, and travel windows must be validated against the fixture calendar.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gdprApplicable rdf:type rdf:Property ;
    rdfs:label 'Gdpr Applicable' ;
    rdfs:comment 'Indicates whether GDPR data privacy obligations apply to fan and participant data collected during this season, based on the host country and market reach. When true, data processing activities must comply with GDPR Articles 5-7 and fan consent management in Adobe Experience Platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasPlayoffStructure rdf:type rdf:Property ;
    rdfs:label 'Has Playoff Structure' ;
    rdfs:comment 'Indicates whether this season includes a post-season playoff or knockout tournament phase beyond the regular season. When true, playoff-specific broadcast rights, ticketing tiers, and venue contracts are activated.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hostCountryCode rdf:type rdf:Property ;
    rdfs:label 'Host Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the primary host nation for this season (e.g., \'USA\', \'GBR\', \'FRA\'). Determines applicable regulatory frameworks (GDPR, CCPA, local tax), venue safety standards (OSHA, ADA), and broadcast licensing requirements (FCC).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalWindowDates rdf:type rdf:Property ;
    rdfs:label 'International Window Dates' ;
    rdfs:comment 'Comma-separated list of date ranges reserved for international competition windows (e.g., FIFA international breaks, Olympic qualifying periods) during which domestic league fixtures are suspended. Critical for fixture scheduling compliance with FIFA and IOC calendars.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isInternationalSeason rdf:type rdf:Property ;
    rdfs:label 'Is International Season' ;
    rdfs:comment 'Indicates whether this season includes fixtures played in multiple countries or international markets. When true, multi-jurisdiction regulatory compliance (GDPR, local broadcast licensing, visa/work permit requirements) is triggered.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:numberOfParticipatingTeams rdf:type rdf:Property ;
    rdfs:label 'Number Of Participating Teams' ;
    rdfs:comment 'Total count of teams, clubs, or acts participating in this season. Used for fixture generation, venue capacity planning in Archtics, and broadcast slot allocation. For concert series, represents the number of performing acts.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:playoffFormatDescription rdf:type rdf:Property ;
    rdfs:label 'Playoff Format Description' ;
    rdfs:comment 'Narrative description of the playoff bracket or knockout structure (e.g., \'Single-elimination 12-team bracket\', \'Best-of-7 series, 16 teams\'). Supports broadcast production planning and fan engagement content in Adobe Experience Platform.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:playoffStartDate rdf:type rdf:Property ;
    rdfs:label 'Playoff Start Date' ;
    rdfs:comment 'Scheduled start date of the post-season playoff phase. Null if has_playoff_structure is false. Used to define the playoff broadcast rights window and premium ticketing on-sale dates in Ticketmaster/AXS.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicationDate rdf:type rdf:Property ;
    rdfs:label 'Publication Date' ;
    rdfs:comment 'The official date on which the fixture calendar was publicly released by the scheduling authority. Triggers downstream on-sale windows in Ticketmaster/AXS and broadcast scheduling in Dalet Galaxy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:seasonCode rdf:type rdf:Property ;
    rdfs:label 'Season Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this season within the league or series (e.g., \'NFL-2024-REG\', \'NBA-2024-25\'). Used as the business key in integrations with SAP S/4HANA, Ticketmaster/AXS, and Archtics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonEndDate rdf:type rdf:Property ;
    rdfs:label 'Season End Date' ;
    rdfs:comment 'Official end date of the competitive or programming season, inclusive of any playoff or championship rounds. Defines the effective-until boundary for broadcast rights, venue contracts, and sponsorship activation periods.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:seasonFormat rdf:type rdf:Property ;
    rdfs:label 'Season Format' ;
    rdfs:comment 'Structural format of the season indicating whether it follows the standard schedule length or a modified format (e.g., shortened due to CBA disputes or COVID, expanded due to league growth). Critical for CBA compliance tracking and broadcast rights valuation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonName rdf:type rdf:Property ;
    rdfs:label 'Season Name' ;
    rdfs:comment 'Human-readable name of the season or programming series (e.g., \'NFL 2024-25 Regular Season\', \'UEFA Champions League 2024-25\', \'Summer Concert Series 2025\'). Serves as the primary display label for downstream broadcast, ticketing, and fan-facing systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonPhase rdf:type rdf:Property ;
    rdfs:label 'Season Phase' ;
    rdfs:comment 'Current active phase of the season lifecycle. Drives phase-specific business rules across ticketing (Ticketmaster/AXS), broadcast (Dalet Galaxy), and venue operations. \'pre_season\' = warm-up fixtures; \'regular_season\' = main competition; \'post_season\' = playoffs/finals; \'off_season\' = between seasons.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonStartDate rdf:type rdf:Property ;
    rdfs:label 'Season Start Date' ;
    rdfs:comment 'Official start date of the competitive or programming season as published by the governing body. Used as the effective-from boundary for broadcast rights windows, ticketing on-sale periods, and venue booking calendars.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:seasonStatus rdf:type rdf:Property ;
    rdfs:label 'Season Status' ;
    rdfs:comment 'Operational lifecycle state of the season itself (distinct from calendar publication status). \'planning\' = pre-season setup; \'active\' = season in progress; \'completed\' = all fixtures concluded; \'cancelled\' = season abandoned; \'suspended\' = temporarily halted (e.g., force majeure, labour dispute).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRecordReference rdf:type rdf:Property ;
    rdfs:label 'Source System Record Reference' ;
    rdfs:comment 'The native primary key or record identifier of this season calendar record in the originating operational system (e.g., SAP S/4HANA season object ID, Archtics season ID). Enables reconciliation and bi-directional traceability between the lakehouse Silver Layer and source systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportEntertainmentType rdf:type rdf:Property ;
    rdfs:label 'Sport Entertainment Type' ;
    rdfs:comment 'High-level classification of the season content type, distinguishing competitive sports leagues from entertainment programming series (e.g., concerts, esports). Drives downstream routing to broadcast, ticketing, and venue operations workflows.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sustainabilityStandard rdf:type rdf:Property ;
    rdfs:label 'Sustainability Standard' ;
    rdfs:comment 'Environmental sustainability standard applied to the management of this season\'s events (e.g., \'ISO_20121\' for ISO 20121 Event Sustainability Management Systems). Supports ESG reporting and venue operations compliance.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tiebreakerRulesReference rdf:type rdf:Property ;
    rdfs:label 'Tiebreaker Rules Reference' ;
    rdfs:comment 'Reference code or document identifier for the official tiebreaker rules applicable to this season\'s standings and playoff qualification (e.g., \'NFL-2024-TIEBREAK-v2\', \'FIFA-RANKING-2024\'). Ensures consistent application of competition governance rules.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalScheduledFixtures rdf:type rdf:Property ;
    rdfs:label 'Total Scheduled Fixtures' ;
    rdfs:comment 'Total number of individual fixtures (games, matches, events, shows) planned across the entire season. Drives capacity planning for ticketing inventory in Archtics and broadcast slot allocation in Dalet Galaxy.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalScheduledRounds rdf:type rdf:Property ;
    rdfs:label 'Total Scheduled Rounds' ;
    rdfs:comment 'Total number of competitive rounds, match weeks, or programming weeks planned for this season. For NFL this represents weeks; for soccer it represents match rounds; for concert series it represents show dates. Used for broadcast slot planning and revenue forecasting in Workday Adaptive Planning.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:varTechnologyEnabled rdf:type rdf:Property ;
    rdfs:label 'Var Technology Enabled' ;
    rdfs:comment 'Indicates whether Video Assistant Referee (VAR) or Television Match Official (TMO) technology is deployed for fixtures in this season. Affects broadcast production requirements, OB (Outside Broadcast) unit specifications, and officiating governance.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wadaComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Wada Compliance Required' ;
    rdfs:comment 'Indicates whether WADA anti-doping testing protocols are mandated for this season. When true, athlete testing schedules and PED (Performance Enhancing Drug) compliance reporting obligations are activated for all participating athletes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventIncidentId rdf:type rdf:Property ;
    rdfs:label 'Event Incident Id' ;
    rdfs:comment 'Unique surrogate identifier for each in-event incident record. Primary key for the event_incident data product in the Silver Layer lakehouse.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EventIncident .

ind:disciplinaryActionId rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Action Id' ;
    rdfs:comment 'Foreign key linking to league.disciplinary_action. Business justification: Incident-to-disciplinary-ruling traceability is a named regulatory requirement. League integrity officers and governing bodies require a direct link from the originating incident record to the resulti' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DisciplinaryAction .

ind:officiatingCrewId rdf:type rdf:Property ;
    rdfs:label 'Officiating Crew Id' ;
    rdfs:comment 'Foreign key linking to league.officiating_crew. Business justification: VAR/TMO incidents and on-field incidents must be linked to the officiating crew responsible for the match. League officiating performance reviews and incident accountability reports require this link ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OfficiatingCrew .

ind:reportedByStaffEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Reported By Staff Employee Id' ;
    rdfs:comment 'Identifier of the workforce member (security officer, medical staff, operations manager, referee, or event coordinator) who first reported or logged the incident. Links to the workforce/employee master data product.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:broadcastDelayMinutes rdf:type rdf:Property ;
    rdfs:label 'Broadcast Delay Minutes' ;
    rdfs:comment 'Duration in minutes that the live broadcast was delayed or interrupted as a result of this incident. Zero if no broadcast delay occurred. Supports RSN and OTT rights holder SLA reporting and FCC compliance.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:broadcastImpact rdf:type rdf:Property ;
    rdfs:label 'Broadcast Impact' ;
    rdfs:comment 'Indicates whether the incident caused a disruption to live broadcast operations (signal loss, unplanned cut-away, OB unit failure, broadcast delay). Triggers notification to broadcast rights holders and Dalet Galaxy media workflow.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectedAt rdf:type rdf:Property ;
    rdfs:label 'Detected At' ;
    rdfs:comment 'Timestamp when the incident was formally detected and logged by operations staff or automated monitoring systems. May differ from occurred_at when there is a reporting lag. Used to measure detection latency for SLA compliance.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fanImpactCount rdf:type rdf:Property ;
    rdfs:label 'Fan Impact Count' ;
    rdfs:comment 'Estimated number of fans directly affected by the incident (e.g., evacuated, medically treated, displaced from seating). Used for post-event fan experience reporting, NPS impact analysis, and insurance liability assessment.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fieldSurfaceCondition rdf:type rdf:Property ;
    rdfs:label 'Field Surface Condition' ;
    rdfs:comment 'Assessed condition of the playing surface or field at the time of the incident. Populated for field/surface condition change incidents and weather delays. Supports governing body match-day inspection reporting and player safety compliance. [ENUM-REF-CANDIDATE: playable|unplayable|waterlogged|frozen|damaged|under_repair|acceptable|not_applicable — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gameDelayDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Game Delay Duration Minutes' ;
    rdfs:comment 'Total duration in minutes that the event or match was delayed or suspended as a direct result of this incident. Zero if no delay occurred. Critical for broadcast scheduling, insurance claims, and governing body reporting.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:insuranceClaimReference rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Reference' ;
    rdfs:comment 'External reference number assigned by the insurance carrier for the claim associated with this incident. Populated once a claim is formally opened. Confidential business data used for financial reconciliation in SAP S/4HANA.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceClaimRequired rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Required' ;
    rdfs:comment 'Indicates whether this incident is expected to generate an insurance claim (event cancellation, liability, workers compensation, medical). Triggers insurance documentation workflow and financial provisioning in SAP S/4HANA FI.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:locationSection rdf:type rdf:Property ;
    rdfs:label 'Location Section' ;
    rdfs:comment 'Specific seating section, gate, or sub-area identifier within the venue zone where the incident occurred. Aligns with Archtics venue seating and inventory management section codes for precise spatial reporting.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationZone rdf:type rdf:Property ;
    rdfs:label 'Location Zone' ;
    rdfs:comment 'Designated zone or area within the venue where the incident occurred (e.g., playing_field, north_stand, concourse_level_2, media_tribune, locker_room, parking_lot, broadcast_compound). Supports venue operations analysis and ADA/OSHA compliance mapping.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchClockTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Match Clock Time Seconds' ;
    rdfs:comment 'Elapsed match or event clock time in seconds at the moment the incident occurred. Enables precise temporal correlation with broadcast footage, VAR/TMO review, and performance analytics in SportsCode/Hudl. Null for non-competition events (concerts, ceremonies).' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:matchPeriod rdf:type rdf:Property ;
    rdfs:label 'Match Period' ;
    rdfs:comment 'Designated period or segment of the event during which the incident occurred. Supports competition governance reporting and broadcast clip indexing. \'full_event\' used for non-segmented live experiences such as concerts. [ENUM-REF-CANDIDATE: pre_match|1st_half|2nd_half|extra_time_1|extra_time_2|penalty_shootout|intermission|post_match|full_event — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Media Coverage Flag' ;
    rdfs:comment 'Indicates whether the incident received external media coverage (broadcast, digital, print). Triggers communications and PR response workflow. Supports reputation management and sponsor impact assessment.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:occurredAt rdf:type rdf:Property ;
    rdfs:label 'Occurred At' ;
    rdfs:comment 'Wall-clock timestamp (ISO 8601 with timezone offset) recording the precise real-world moment the incident was first observed or reported. Principal business event timestamp for the incident lifecycle. Distinct from match clock time.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:pedRelated rdf:type rdf:Property ;
    rdfs:label 'Ped Related' ;
    rdfs:comment 'Indicates whether the incident involves a suspected or confirmed Performance Enhancing Drug (PED) violation or related medical event. Triggers mandatory WADA reporting workflow and CAS arbitration tracking.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:precipitationMm rdf:type rdf:Property ;
    rdfs:label 'Precipitation Mm' ;
    rdfs:comment 'Recorded precipitation level in millimetres at the time of the incident. Supports weather-delay documentation, field/surface condition assessment, and insurance claim substantiation.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportSubmitted rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Submitted' ;
    rdfs:comment 'Indicates whether the required regulatory report has been formally submitted to the relevant governing body or authority. Null when regulatory_reporting_required is False. Supports compliance audit and SLA tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReportSubmittedAt rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Submitted At' ;
    rdfs:comment 'Timestamp when the regulatory report was formally submitted to the governing body or authority. Null if not yet submitted. Used to verify compliance with mandatory reporting deadlines (e.g., OSHA 8-hour fatality reporting window).' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resolvedAt rdf:type rdf:Property ;
    rdfs:label 'Resolved At' ;
    rdfs:comment 'Timestamp when the incident was operationally resolved and normal event operations resumed or the incident was formally closed. Null if incident remains open. Used to calculate response duration and SLA adherence.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responseActionTaken rdf:type rdf:Property ;
    rdfs:label 'Response Action Taken' ;
    rdfs:comment 'Structured description of the primary operational response action executed in reaction to the incident (e.g., medical_evacuation, play_suspended, crowd_dispersal, equipment_replaced, power_restored, venue_section_cleared, VAR_review_initiated). [ENUM-REF-CANDIDATE: medical_evacuation|play_suspended|crowd_dispersal|equipment_replaced|power_restored|venue_section_cleared|var_review_initiated|match_abandoned|emergency_services_called|shelter_in_place — promote to reference product]' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseTeamType rdf:type rdf:Property ;
    rdfs:label 'Response Team Type' ;
    rdfs:comment 'Category of the primary response team deployed to address the incident. Supports post-event resource utilization analysis and emergency preparedness planning. [ENUM-REF-CANDIDATE: medical|security|fire_safety|technical|operations|governing_body|external_emergency_services|broadcast — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:temperatureCelsius rdf:type rdf:Property ;
    rdfs:label 'Temperature Celsius' ;
    rdfs:comment 'Recorded ambient air temperature in degrees Celsius at the venue at the time of the incident. Critical for heat-related medical incidents, weather-delay justification, and OSHA heat illness prevention compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varTmoOutcome rdf:type rdf:Property ;
    rdfs:label 'Var Tmo Outcome' ;
    rdfs:comment 'Result of the Video Assistant Referee (VAR) or Television Match Official (TMO) review triggered by this incident. Null when var_tmo_review_triggered is False. Supports competition governance reporting and post-match analysis.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varTmoReviewTriggered rdf:type rdf:Property ;
    rdfs:label 'Var Tmo Review Triggered' ;
    rdfs:comment 'Indicates whether the incident triggered a Video Assistant Referee (VAR) or Television Match Official (TMO) review process. Applicable to football, rugby, and other sports with video review protocols. Supports competition governance and SportsCode/Hudl video analysis integration.' ;
    rdfs:domain ind:EventIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:windSpeedKmh rdf:type rdf:Property ;
    rdfs:label 'Wind Speed Kmh' ;
    rdfs:comment 'Recorded wind speed in kilometres per hour at the venue at the time of the incident. Used for weather-delay justification, structural safety assessments, and insurance documentation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:participantId rdf:type rdf:Property ;
    rdfs:label 'Participant Id' ;
    rdfs:comment 'Unique surrogate identifier for each event participant record. Primary key for the event_participant data product in the Silver Layer lakehouse.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Participant .

ind:replacementParticipantId rdf:type rdf:Property ;
    rdfs:label 'Replacement Participant Id' ;
    rdfs:comment 'Reference to the event_participant record of the entity that replaced this participant following a withdrawal or disqualification. Enables lineage tracking of substitutions and replacements for broadcast and competition governance.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Participant .

ind:accreditationCode rdf:type rdf:Property ;
    rdfs:label 'Accreditation Code' ;
    rdfs:comment 'Official accreditation or credential code issued to the participant for venue access and event operations purposes. Sourced from the venue access control system (Ticketmaster/AXS). Required for gate access, broadcast zone entry, and VIP area clearance.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appearanceFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Appearance Fee Amount' ;
    rdfs:comment 'Contracted appearance fee or performance guarantee amount payable to the participant for this event, denominated in appearance_fee_currency. Confidential financial data. Used for event cost management, EBITDA reporting, and SAP S/4HANA FI/CO reconciliation.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appearanceFeeCurrency rdf:type rdf:Property ;
    rdfs:label 'Appearance Fee Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the appearance fee or performance guarantee payable to the participant for this event. Confidential financial data. Applicable primarily to entertainment performers and exhibition athletes.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastFeatureFlag rdf:type rdf:Property ;
    rdfs:label 'Broadcast Feature Flag' ;
    rdfs:comment 'Indicates whether this participant has been designated as a featured participant for broadcast production purposes (e.g., pre-match spotlight, in-game feature segment, post-match interview). Consumed by Dalet Galaxy broadcast workflow and content production teams.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:competitionResult rdf:type rdf:Property ;
    rdfs:label 'Competition Result' ;
    rdfs:comment 'Official outcome of the event for this participant as determined by the officiating body. Win, loss, or draw for standard fixtures; no_contest for abandoned events; disqualified for rule violations; walkover for uncontested advancement. Populated post-event.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crmContactReference rdf:type rdf:Property ;
    rdfs:label 'Crm Contact Reference' ;
    rdfs:comment 'Salesforce CRM contact or account identifier for the participant or their management entity. Enables fan engagement, sponsor activation, and NIL campaign targeting through Adobe Experience Platform and Salesforce CRM.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verified Date' ;
    rdfs:comment 'Date on which the participant\'s eligibility for this event was formally verified by the league compliance or event operations team. Supports audit trail requirements under governing body regulations.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:entityReference rdf:type rdf:Property ;
    rdfs:label 'Entity Reference' ;
    rdfs:comment 'Reference to the athlete, team, performer, or competing entity participating in the event. Polymorphic identifier resolved by entity_type.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:entryMethod rdf:type rdf:Property ;
    rdfs:label 'Entry Method' ;
    rdfs:comment 'Method by which the participant qualified or was selected to participate in the event. Direct qualification indicates earned entry through league standings; wildcard indicates discretionary selection; invitation applies to exhibition and all-star events; playoff_seed applies to post-season competition; draft applies to league draft events; bid applies to hosted events. [ENUM-REF-CANDIDATE: direct_qualification|wildcard|invitation|playoff_seed|draft|bid|other — promote to reference product]' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeVenueFlag rdf:type rdf:Property ;
    rdfs:label 'Home Venue Flag' ;
    rdfs:comment 'Indicates whether the event is being held at the participant\'s designated home venue. True for home fixtures; False for away or neutral venue fixtures. Drives ticketing allocation, fan engagement targeting, and revenue attribution.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hudlProfileCode rdf:type rdf:Property ;
    rdfs:label 'Hudl Profile Code' ;
    rdfs:comment 'Unique identifier linking this participant to their performance analytics profile in SportsCode/Hudl. Enables downstream performance video analysis, WAR (Wins Above Replacement), QBR (Quarterback Rating), and ERA (Earned Run Average) metric computation for this event.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCaptainOrLead rdf:type rdf:Property ;
    rdfs:label 'Is Captain Or Lead' ;
    rdfs:comment 'Indicates whether the participant holds the captain designation (sports) or lead performer designation (entertainment) for this specific event. True when the participant is the designated captain or headlining lead.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineupConfirmed rdf:type rdf:Property ;
    rdfs:label 'Lineup Confirmed' ;
    rdfs:comment 'Indicates whether the submitted lineup has been officially confirmed and accepted by the league or event operations team. True when confirmed; False when pending or rejected.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineupSubmissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Lineup Submission Timestamp' ;
    rdfs:comment 'Date and time when the official lineup, roster, or set list was formally submitted by the participant\'s management or coaching staff to the league or event organiser. Critical for compliance with pre-match lineup deadlines mandated by governing bodies.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mediaRightsClearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Media Rights Clearance Status' ;
    rdfs:comment 'Status of media rights clearance for this participant\'s appearance in the event. Cleared indicates full broadcast and digital distribution rights are confirmed; pending indicates rights are under negotiation; restricted indicates partial rights only; blocked indicates no broadcast rights. Consumed by content and broadcast domains for DRM (Digital Rights Management) enforcement.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nationalityCountry rdf:type rdf:Property ;
    rdfs:label 'Nationality Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the nationality of the participant or the country of registration for a team. Used for international competition eligibility, governing body reporting, and broadcast rights geo-targeting.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participantRole rdf:type rdf:Property ;
    rdfs:label 'Participant Role' ;
    rdfs:comment 'Designates the competitive or performance role of the participant within the event. For sports fixtures: home_team or away_team. For concerts and live experiences: headliner, support_act. Wildcard and neutral apply to tournament and exhibition contexts.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationStatus rdf:type rdf:Property ;
    rdfs:label 'Participation Status' ;
    rdfs:comment 'Current lifecycle status of the participant\'s involvement in the event. Confirmed indicates full clearance; withdrawn indicates voluntary or involuntary removal; suspended reflects disciplinary action per league CBA or governing body ruling; TBD (To Be Determined) indicates pending confirmation; disqualified reflects post-event ruling; pending_review indicates an active compliance or eligibility review. [ENUM-REF-CANDIDATE: confirmed|withdrawn|suspended|tbd|disqualified|pending_review — promote to reference product]' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceSlotOrder rdf:type rdf:Property ;
    rdfs:label 'Performance Slot Order' ;
    rdfs:comment 'Sequential order in which the participant is scheduled to perform or compete within the event programme. For concerts: set list order. For multi-bout events: bout sequence. Null for single-match sports fixtures.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rankingPointsEarned rdf:type rdf:Property ;
    rdfs:label 'Ranking Points Earned' ;
    rdfs:comment 'Official ranking or standing points awarded to the participant as a result of their performance in this event. Used to update league tables, world rankings, or tournament standings. Governed by the relevant league or governing body points allocation rules.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:score rdf:type rdf:Property ;
    rdfs:label 'Score' ;
    rdfs:comment 'Final score, points, or goals recorded for this participant in the event. Applicable to sports fixtures. Null for entertainment events. Sourced from official match data systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seedingRank rdf:type rdf:Property ;
    rdfs:label 'Seeding Rank' ;
    rdfs:comment 'Numeric seeding rank assigned to the participant for tournament bracket placement or competition draw purposes. Lower values indicate higher seeding. Null for non-seeded events such as regular season fixtures or concerts.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:travelOriginCountry rdf:type rdf:Property ;
    rdfs:label 'Travel Origin Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the country from which the participant is travelling to the event. Used for logistics planning, visa and work permit compliance, and international governing body reporting.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uniformColorCode rdf:type rdf:Property ;
    rdfs:label 'Uniform Color Code' ;
    rdfs:comment 'Designated uniform or kit color code for the participant in this event (e.g., HOME, AWAY, THIRD, ALTERNATE). Ensures broadcast production and officiating clarity. Governed by league uniform regulations.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withdrawalReason rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Reason' ;
    rdfs:comment 'Categorised reason for participant withdrawal from the event. Populated only when participation_status is withdrawn or disqualified. Supports injury reporting, disciplinary tracking, and force majeure documentation. [ENUM-REF-CANDIDATE: injury|suspension|personal_reasons|scheduling_conflict|disqualification|force_majeure|other — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withdrawalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Timestamp' ;
    rdfs:comment 'Date and time when the participant\'s withdrawal or disqualification was officially recorded. Null when participation_status is not withdrawn or disqualified. Used for downstream broadcast, ticketing, and fan notification workflows.' ;
    rdfs:domain ind:Participant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:pricingId rdf:type rdf:Property ;
    rdfs:label 'Pricing Id' ;
    rdfs:comment 'Unique surrogate identifier for each event pricing configuration record. Primary key for the event_pricing data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Pricing .

ind:baseTicketPrice rdf:type rdf:Property ;
    rdfs:label 'Base Ticket Price' ;
    rdfs:comment 'The floor or reference ticket price for this pricing tier before any multipliers, dynamic adjustments, or promotional discounts are applied. Represents the minimum sellable price per seat in this configuration.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:configCode rdf:type rdf:Property ;
    rdfs:label 'Config Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this pricing configuration within the ticketing system (e.g., Ticketmaster / AXS or Archtics). Used for cross-system reconciliation and audit.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:configName rdf:type rdf:Property ;
    rdfs:label 'Config Name' ;
    rdfs:comment 'Human-readable name describing this pricing configuration (e.g., \'Playoff Tier A Dynamic\', \'Regular Season GA Standard\'). Used in reporting dashboards and operational communications.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dayOfWeek rdf:type rdf:Property ;
    rdfs:label 'Day Of Week' ;
    rdfs:comment 'Day of the week on which the event is scheduled. Day-of-week is a primary demand driver in pricing models — weekend events typically command premium pricing versus midweek fixtures. [ENUM-REF-CANDIDATE: Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandSignalSource rdf:type rdf:Property ;
    rdfs:label 'Demand Signal Source' ;
    rdfs:comment 'The system or data source providing real-time demand signals to the dynamic pricing engine. Determines which platform\'s sales velocity, search interest, or fan engagement data drives price adjustments.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dynamicPricingEnabled rdf:type rdf:Property ;
    rdfs:label 'Dynamic Pricing Enabled' ;
    rdfs:comment 'Indicates whether dynamic (demand-based) pricing is activated for this event pricing configuration. When true, the ticketing platform (Ticketmaster / AXS) will algorithmically adjust prices within the base-to-max range based on real-time demand signals.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dynamicPricingModel rdf:type rdf:Property ;
    rdfs:label 'Dynamic Pricing Model' ;
    rdfs:comment 'The algorithmic model type used when dynamic pricing is enabled. Demand-based adjusts on real-time sales velocity; time-based adjusts based on proximity to event date; inventory-based adjusts on remaining seat availability; hybrid combines multiple signals.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earlyBirdCutoffDate rdf:type rdf:Property ;
    rdfs:label 'Early Bird Cutoff Date' ;
    rdfs:comment 'The last date on which early bird pricing is available for this event. Purchases made on or before this date qualify for the early bird discount rate. Supports advance sales revenue recognition strategy.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:earlyBirdDiscountPct rdf:type rdf:Property ;
    rdfs:label 'Early Bird Discount Pct' ;
    rdfs:comment 'Percentage discount applied to the base ticket price for purchases made on or before the early_bird_cutoff_date. Incentivizes advance ticket purchases to improve cash flow predictability.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventClassification rdf:type rdf:Property ;
    rdfs:label 'Event Classification' ;
    rdfs:comment 'Classification of the event type driving the pricing strategy. Playoff and championship events typically carry higher multipliers. Aligns with fixture classification in the event domain.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Facility Fee Amount' ;
    rdfs:comment 'Per-ticket facility or venue surcharge applied to support venue operations, maintenance, and ADA compliance improvements. Separate from the base ticket price and service fee.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:groupDiscountPct rdf:type rdf:Property ;
    rdfs:label 'Group Discount Pct' ;
    rdfs:comment 'Percentage discount applied to the base ticket price for qualifying group sales purchases. Expressed as a positive value (e.g., 15.00 = 15% discount). Applicable when group_sales_min_qty threshold is met.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:groupSalesMinQty rdf:type rdf:Property ;
    rdfs:label 'Group Sales Min Qty' ;
    rdfs:comment 'Minimum number of tickets required to qualify for group sales pricing under this configuration. Group pricing typically offers a discount to incentivize bulk purchases from organizations, schools, and corporate clients.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inventoryAllocationPct rdf:type rdf:Property ;
    rdfs:label 'Inventory Allocation Pct' ;
    rdfs:comment 'Percentage of total venue capacity allocated to this pricing tier configuration. The sum of all tier allocations for a given fixture should equal 100%. Managed in Archtics seat manifest.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxTicketPrice rdf:type rdf:Property ;
    rdfs:label 'Max Ticket Price' ;
    rdfs:comment 'The ceiling price for this pricing tier. In dynamic pricing models, the ticket price will not exceed this cap regardless of demand signals. Protects against fan price gouging and reputational risk.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxTicketsPerTransaction rdf:type rdf:Property ;
    rdfs:label 'Max Tickets Per Transaction' ;
    rdfs:comment 'Maximum number of tickets a single purchaser may buy in one transaction under this pricing configuration. Limits scalping and ensures equitable fan access. Enforced at point of sale in Ticketmaster / AXS.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:multiplier rdf:type rdf:Property ;
    rdfs:label 'Multiplier' ;
    rdfs:comment 'Multiplicative factor applied to the base ticket price to derive the adjusted price for this configuration. A value of 1.0000 represents no adjustment; values above 1.0 represent a premium uplift (e.g., 1.25 = 25% premium for playoff games).' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offSaleTimestamp rdf:type rdf:Property ;
    rdfs:label 'Off Sale Timestamp' ;
    rdfs:comment 'The exact date and time at which ticket sales under this pricing configuration are closed. After this timestamp, no new purchases are permitted at this price tier. Supports inventory management and gate reconciliation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:onSaleTimestamp rdf:type rdf:Property ;
    rdfs:label 'On Sale Timestamp' ;
    rdfs:comment 'The exact date and time at which tickets under this pricing configuration become available for public purchase. Aligns with Ticketmaster / AXS on-sale event scheduling. Critical for fan communications and marketing campaign timing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:presaleEnabled rdf:type rdf:Property ;
    rdfs:label 'Presale Enabled' ;
    rdfs:comment 'Indicates whether a presale window is activated for this pricing configuration, allowing select fan segments (e.g., CRM loyalty members, credit card holders, season ticket holders) to purchase before the general public on-sale.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:presaleEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Presale End Timestamp' ;
    rdfs:comment 'The exact date and time at which the presale window closes. After this timestamp, remaining presale inventory rolls into the general public on-sale pool.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:presaleStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Presale Start Timestamp' ;
    rdfs:comment 'The exact date and time at which the presale window opens for eligible purchasers. Applicable only when presale_enabled is true. Drives CRM campaign scheduling in Salesforce and Adobe Experience Platform.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:priceAdjustmentCeilingPct rdf:type rdf:Property ;
    rdfs:label 'Price Adjustment Ceiling Pct' ;
    rdfs:comment 'Maximum percentage by which the dynamic pricing engine may increase the base ticket price (e.g., 50.00 means prices may rise up to 50% above base). Caps upward price movement to protect fan experience and brand equity.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceAdjustmentFloorPct rdf:type rdf:Property ;
    rdfs:label 'Price Adjustment Floor Pct' ;
    rdfs:comment 'Minimum percentage by which the dynamic pricing engine may reduce the base ticket price (expressed as a negative-capable percentage, e.g., -20.00 means prices may drop up to 20% below base). Prevents excessive discounting.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pricingStatus rdf:type rdf:Property ;
    rdfs:label 'Pricing Status' ;
    rdfs:comment 'Current lifecycle status of this pricing configuration. Draft indicates pending approval; Active indicates live and applied to ticket inventory; Suspended indicates temporarily halted; Expired indicates past effective window; Cancelled indicates permanently withdrawn.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricingTier rdf:type rdf:Property ;
    rdfs:label 'Pricing Tier' ;
    rdfs:comment 'Categorical tier classification for this pricing configuration. Tiers include General Admission (GA), Standing Room Only (SRO), Standard, Premium, Very Important Person (VIP), and Platinum. Drives seat manifest segmentation in Archtics. [ENUM-REF-CANDIDATE: standard|premium|vip|ga|sro|platinum|hospitality|suite — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rivalryFlag rdf:type rdf:Property ;
    rdfs:label 'Rivalry Flag' ;
    rdfs:comment 'Indicates whether this fixture is designated as a rivalry matchup (e.g., derby, classic, historic rivalry). Rivalry designation typically triggers a positive pricing multiplier uplift in dynamic pricing models.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seasonTicketApplicable rdf:type rdf:Property ;
    rdfs:label 'Season Ticket Applicable' ;
    rdfs:comment 'Indicates whether this event is included in season ticket packages. When true, season ticket holders receive access at their contracted rate rather than the general public pricing tier.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Service Fee Amount' ;
    rdfs:comment 'Fixed service or convenience fee charged per ticket in addition to the face value price. Represents ticketing platform processing charges passed to the consumer. Governed by PCI-DSS for payment processing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:strategyType rdf:type rdf:Property ;
    rdfs:label 'Strategy Type' ;
    rdfs:comment 'The overarching pricing strategy applied to this configuration. Fixed means a static price; Dynamic means algorithmically adjusted; Tiered means structured price bands; Variable means manually adjusted; Promotional means a time-limited discounted offer.' ;
    rdfs:domain ind:Pricing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxRatePct rdf:type rdf:Property ;
    rdfs:label 'Tax Rate Pct' ;
    rdfs:comment 'Applicable tax rate percentage applied to ticket sales under this pricing configuration. Varies by jurisdiction and event type. Used for financial reporting and SAP S/4HANA FI tax determination.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statusHistoryId rdf:type rdf:Property ;
    rdfs:label 'Status History Id' ;
    rdfs:comment 'Unique surrogate identifier for each event lifecycle state transition record. Primary key of the event_status_history audit entity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StatusHistory .

ind:primaryStatusEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Status Employee Id' ;
    rdfs:comment 'Reference to the internal workforce member or system account that initiated the status transition. Supports audit trail and accountability tracking.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:alternateRescheduleDate rdf:type rdf:Property ;
    rdfs:label 'Alternate Reschedule Date' ;
    rdfs:comment 'A secondary proposed reschedule date offered when the primary proposed_reschedule_date is unavailable or under negotiation. Supports multi-option rescheduling decision workflows with venue, broadcast, and governing body stakeholders.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:broadcastImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Broadcast Impact Flag' ;
    rdfs:comment 'Indicates whether this status transition has a material impact on broadcast rights obligations, RSN (Regional Sports Network) schedules, OTT (Over-The-Top Streaming) platform programming, or PPV (Pay-Per-View) commitments. Triggers broadcast partner notification workflows via Dalet Galaxy.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:changeCategory rdf:type rdf:Property ;
    rdfs:label 'Change Category' ;
    rdfs:comment 'High-level business category classifying the nature of the status transition. Enables aggregated reporting on postponement rates, cancellation frequencies, and reinstatement patterns across leagues and event types.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeSource rdf:type rdf:Property ;
    rdfs:label 'Change Source' ;
    rdfs:comment 'Identifies the originating system or process that triggered the status transition — manual operator entry, automated rule engine, governing body data feed, broadcast system, ticketing platform, or API integration. Supports data lineage and audit.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeTimestamp rdf:type rdf:Property ;
    rdfs:label 'Change Timestamp' ;
    rdfs:comment 'The precise date and time (with timezone offset) at which the status transition was recorded in the system. Serves as the EVENT_TIMESTAMP for this log entry and is the authoritative moment of state change for downstream near-real-time reactions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:effectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Timestamp' ;
    rdfs:comment 'The date and time at which the new status becomes operationally effective — which may differ from change_timestamp if the transition is pre-authorized or scheduled in advance (e.g., a cancellation announced 48 hours before the event). Supports bi-temporal data modeling.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:estimatedFinancialImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Financial Impact Amount' ;
    rdfs:comment 'Estimated gross financial impact (in base currency) of this status transition, encompassing projected ticket refunds, sponsor credits, broadcast fee adjustments, and venue cost liabilities. Used for EBITDA (Earnings Before Interest Taxes Depreciation and Amortization) impact forecasting in Workday Adaptive Planning.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalAnnouncementText rdf:type rdf:Property ;
    rdfs:label 'External Announcement Text' ;
    rdfs:comment 'The official public-facing announcement text associated with this status change, as communicated to fans, media, and stakeholders. Stored for audit, brand consistency review, and regulatory record-keeping.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Flag' ;
    rdfs:comment 'Indicates whether this status transition triggers a financial impact requiring downstream action — such as ticketing refund processing, sponsor credit notes, or broadcast rights fee adjustments. True = financial workflows must be initiated.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:forceMajeureDeclared rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Declared' ;
    rdfs:comment 'Indicates whether a force majeure clause has been formally invoked in connection with this status transition. Activates specific contractual protections for broadcast rights, sponsorship agreements, and venue contracts. Critical for legal and insurance claim processing.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:governingBodyApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Governing Body Approval Required' ;
    rdfs:comment 'Indicates whether the status transition requires formal approval from the relevant governing body (e.g., FIFA, NFL League Office, NBA League Office) before it becomes effective. Drives compliance workflow routing.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:governingBodyApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Governing Body Approval Status' ;
    rdfs:comment 'Current approval status from the relevant sports governing body for this status transition. Applicable when governing_body_approval_required is True. Tracks the regulatory sign-off lifecycle.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingBodyReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Governing Body Reference Number' ;
    rdfs:comment 'The official reference or case number assigned by the governing body (FIFA, NFL, NBA, etc.) to the directive or approval associated with this status change. Enables cross-referencing with governing body records for compliance and legal purposes.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceClaimFlag rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Flag' ;
    rdfs:comment 'Indicates whether this status transition has triggered or is expected to trigger an event cancellation or postponement insurance claim. Drives financial reporting workflows in SAP S/4HANA FI/CO and legal documentation processes.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:newStatus rdf:type rdf:Property ;
    rdfs:label 'New Status' ;
    rdfs:comment 'The lifecycle status of the event after this transition was applied. Represents the current state at the time of this history record. [ENUM-REF-CANDIDATE: announced|scheduled|on_sale|postponed|rescheduled|cancelled|completed|suspended — promote to reference product]' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationDispatchTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Dispatch Timestamp' ;
    rdfs:comment 'The date and time at which fan and stakeholder notifications were dispatched for this status change. Null if notification_dispatched is False. Supports SLA compliance measurement for fan communication obligations.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:notificationDispatched rdf:type rdf:Property ;
    rdfs:label 'Notification Dispatched' ;
    rdfs:comment 'Indicates whether fan, sponsor, and broadcast partner notifications were dispatched following this status transition. True = notifications sent; False = notifications pending or suppressed. Drives downstream fan engagement and CRM workflows in Adobe Experience Platform and Salesforce CRM.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:previousStatus rdf:type rdf:Property ;
    rdfs:label 'Previous Status' ;
    rdfs:comment 'The lifecycle status of the event immediately before this transition occurred. Enables before/after comparison and rollback analysis. [ENUM-REF-CANDIDATE: announced|scheduled|on_sale|postponed|rescheduled|cancelled|completed|suspended — promote to reference product]' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedRescheduleDate rdf:type rdf:Property ;
    rdfs:label 'Proposed Reschedule Date' ;
    rdfs:comment 'The first proposed new date for the event following a postponement or cancellation decision. May be null if no reschedule date has been identified at the time of the status change. Supports rescheduling workflow initiation.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reasonCode rdf:type rdf:Property ;
    rdfs:label 'Reason Code' ;
    rdfs:comment 'Standardized code identifying the primary business reason driving the status transition (e.g., weather, force majeure, broadcast conflict, governing body directive). Used for root-cause reporting and insurance/legal documentation. [ENUM-REF-CANDIDATE: weather|force_majeure|broadcast_conflict|governing_body_directive|venue_unavailability|safety_concern|team_request|public_health|logistical_failure — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Free-text narrative providing additional context or detail beyond the reason_code. Captures nuanced circumstances such as specific weather event names, governing body directive reference numbers, or force majeure declarations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundTriggerFlag rdf:type rdf:Property ;
    rdfs:label 'Refund Trigger Flag' ;
    rdfs:comment 'Specific flag indicating whether this status transition activates the ticketing refund workflow in Ticketmaster/AXS. Distinct from the broader financial_impact_flag — isolates the ticket refund obligation for PCI-DSS compliance tracking.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rescheduleDecisionDeadline rdf:type rdf:Property ;
    rdfs:label 'Reschedule Decision Deadline' ;
    rdfs:comment 'The date by which a final rescheduling decision must be made, as mandated by governing body regulations, broadcast contracts, or venue availability windows. Drives escalation workflows if deadline is breached.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reschedulingWorkflowStatus rdf:type rdf:Property ;
    rdfs:label 'Rescheduling Workflow Status' ;
    rdfs:comment 'Current state of the rescheduling decision and coordination workflow triggered by a postponement. Tracks progress from initial postponement through governing body approval, venue confirmation, and broadcast partner alignment. TBD (To Be Determined) indicates stakeholder alignment is ongoing.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Sponsor Impact Flag' ;
    rdfs:comment 'Indicates whether this status transition triggers sponsor and partnership management actions — such as activation cancellations, make-good provisions, or naming rights credit adjustments. Drives Salesforce CRM sponsor notification workflows.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transitionSequence rdf:type rdf:Property ;
    rdfs:label 'Transition Sequence' ;
    rdfs:comment 'Ordinal sequence number of this status transition within the full lifecycle history of the event. Enables chronological ordering of all status changes for a given event_id and supports lifecycle analytics.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:venueImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Venue Impact Flag' ;
    rdfs:comment 'Indicates whether this status transition requires venue operations changes — such as facility hold releases, HVAC (Heating Ventilation and Air Conditioning) schedule adjustments, BMS (Building Management System) updates, or staffing cancellations. Triggers venue operations workflows.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:venueAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Venue Assignment Id' ;
    rdfs:comment 'Unique surrogate identifier for the event-to-venue assignment record. Primary key for this association entity.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emergencyResponsePlanId rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Plan Id' ;
    rdfs:comment 'Foreign key linking to security.emergency_response_plan. Business justification: Venue assignment confirmation for an event — especially neutral sites — triggers selection of the applicable emergency response plan. Regulatory requirements for large public gatherings mandate that t' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmergencyResponsePlan .

ind:namingRightId rdf:type rdf:Property ;
    rdfs:label 'Naming Right Id' ;
    rdfs:comment 'Foreign key linking to sponsorship.naming_right. Business justification: Naming rights compliance at venue assignment: when a venue is assigned to an event, the active naming rights agreement must be referenced to enforce broadcast mention requirements, signage specificati' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NamingRight .

ind:primaryVenueEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Venue Employee Id' ;
    rdfs:comment 'Business user identifier of the person who created this venue assignment record, sourced from the identity management system. Supports accountability and audit trail requirements under SOX financial controls.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryVenueId rdf:type rdf:Property ;
    rdfs:label 'Primary Venue Id' ;
    rdfs:comment 'Reference to the venue facility being assigned to host the event. Links to the venue master record.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Venue .

ind:adaAccessibleSeatCount rdf:type rdf:Property ;
    rdfs:label 'Ada Accessible Seat Count' ;
    rdfs:comment 'Number of ADA-compliant accessible seats allocated for this event at this venue configuration. Used by ticketing domain to configure accessible inventory in Archtics and ensure compliance with ADA minimum accessible seating ratios.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adaCompliant rdf:type rdf:Property ;
    rdfs:label 'Ada Compliant' ;
    rdfs:comment 'Indicates whether ADA accessibility compliance has been formally confirmed for this event at this venue, including accessible seating, ramps, restrooms, and concession access. Required for regulatory compliance reporting and venue operations preparation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignmentCode rdf:type rdf:Property ;
    rdfs:label 'Assignment Code' ;
    rdfs:comment 'Externally-known business identifier for this venue assignment, used in operational communications, venue operations work orders, and ticketing system configuration (e.g., Archtics seating inventory setup). Format: EVA- followed by 4-12 alphanumeric characters.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Effective Date' ;
    rdfs:comment 'Calendar date from which this venue assignment is operationally effective. Venue operations teams use this date to begin facility preparation scheduling, and ticketing teams use it to open inventory configuration in Archtics.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Expiry Date' ;
    rdfs:comment 'Calendar date after which this venue assignment is no longer valid. Used for provisional or alternate assignments that have a defined validity window. Null for confirmed primary assignments with no expiry.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentNotes rdf:type rdf:Property ;
    rdfs:label 'Assignment Notes' ;
    rdfs:comment 'Free-text operational notes related to this venue assignment, capturing special conditions, exceptions, or instructions for venue operations, ticketing, and broadcast teams that are not captured in structured fields.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assignment Status' ;
    rdfs:comment 'Current lifecycle state of the venue assignment. \'proposed\' indicates initial planning stage; \'confirmed\' indicates venue is locked and ticketing/operations may proceed; \'provisional\' indicates conditional confirmation pending contract or regulatory approval; \'cancelled\' indicates the assignment has been voided; \'superseded\' indicates replaced by a newer assignment record.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastInfrastructureReady rdf:type rdf:Property ;
    rdfs:label 'Broadcast Infrastructure Ready' ;
    rdfs:comment 'Indicates whether the venue\'s broadcast infrastructure (OB (Outside Broadcast) unit connections, fiber feeds, camera positions, commentary positions) has been confirmed as ready for this event. Used by broadcast operations and Dalet Galaxy workflow planning.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:changeHistoryFlag rdf:type rdf:Property ;
    rdfs:label 'Change History Flag' ;
    rdfs:comment 'Indicates whether this venue assignment record has been modified or superseded since initial creation, signaling that a prior assignment existed for this event. Used for audit trail tracking and downstream notification to venue operations and ticketing teams of venue changes.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:changeReason rdf:type rdf:Property ;
    rdfs:label 'Change Reason' ;
    rdfs:comment 'Free-text description of the reason for a venue assignment change, such as venue unavailability, weather conditions, safety concerns, league mandate, or contractual renegotiation. Populated when change_history_flag is True.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designationType rdf:type rdf:Property ;
    rdfs:label 'Designation Type' ;
    rdfs:comment 'Indicates whether this venue is the primary assigned venue, an alternate venue held in reserve, a neutral-site venue (neither team\'s home ground, common in playoff or championship contexts), or a backup venue activated only if the primary is unavailable.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldSetupType rdf:type rdf:Property ;
    rdfs:label 'Field Setup Type' ;
    rdfs:comment 'Specifies the physical configuration of the playing surface, court, or stage for this event. Determines sightline mapping, seating kill zones, and production logistics. \'standard\' applies to normal league-regulation field/court layout; concert and stage variants apply to live entertainment events. [ENUM-REF-CANDIDATE: standard|concert_stage|in_the_round|end_stage|thrust_stage|custom|floor_only|half_house — promote to reference product]' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gaSectionEnabled rdf:type rdf:Property ;
    rdfs:label 'Ga Section Enabled' ;
    rdfs:comment 'Indicates whether General Admission (GA) standing sections are enabled for this event at this venue. Affects ticketing inventory configuration, crowd management planning, and OSHA safety compliance for standing areas.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gateOpenTime rdf:type rdf:Property ;
    rdfs:label 'Gate Open Time' ;
    rdfs:comment 'Scheduled date and time when venue gates open to the public for this event. Used by venue operations, security staffing, and access control configuration in Ticketmaster/AXS gate scan systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:loadInDate rdf:type rdf:Property ;
    rdfs:label 'Load In Date' ;
    rdfs:comment 'Date on which production equipment, staging, and event infrastructure begins loading into the venue. Critical for venue operations scheduling, HVAC (Heating Ventilation and Air Conditioning) activation, and BMS (Building Management System) configuration.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:loadOutDate rdf:type rdf:Property ;
    rdfs:label 'Load Out Date' ;
    rdfs:comment 'Date by which all production equipment and event infrastructure must be removed from the venue. Used for venue turnaround scheduling and back-to-back event planning.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mediaRightsZone rdf:type rdf:Property ;
    rdfs:label 'Media Rights Zone' ;
    rdfs:comment 'Geographic media rights zone classification for this venue assignment, determining which RSN (Regional Sports Network), OTT (Over-The-Top Streaming), or broadcast network holds distribution rights for events at this venue. Used in broadcast rights management and content distribution.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:neutralSiteFlag rdf:type rdf:Property ;
    rdfs:label 'Neutral Site Flag' ;
    rdfs:comment 'Indicates whether this venue assignment represents a neutral-site event where neither competing team or performer has a home-ground advantage. Common in playoff games, championship events, bowl games, and international fixtures. Affects revenue-sharing, ticketing allocation, and broadcast rights.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parkingCapacity rdf:type rdf:Property ;
    rdfs:label 'Parking Capacity' ;
    rdfs:comment 'Total number of parking spaces available at or designated for this venue for this event. Used in fan experience planning, transportation logistics, and ancillary revenue forecasting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rentalFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Rental Fee Amount' ;
    rdfs:comment 'Contracted rental fee payable to the venue operator for hosting this event. Used in event P&L (Profit and Loss) analysis and financial planning in Workday Adaptive Planning. Classified as confidential due to commercial sensitivity.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rentalFeeCurrency rdf:type rdf:Property ;
    rdfs:label 'Rental Fee Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the venue rental fee amount (e.g., USD, GBP, EUR). Required for multi-currency financial reporting and SAP S/4HANA FI integration.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatingManifestVersion rdf:type rdf:Property ;
    rdfs:label 'Seating Manifest Version' ;
    rdfs:comment 'Version identifier of the seating manifest (kill zones, accessible sections, GA (General Admission) areas, SRO (Standing Room Only) sections) configured in Archtics for this event-venue assignment. Tracks changes to seating layout between events at the same venue.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityLevel rdf:type rdf:Property ;
    rdfs:label 'Security Level' ;
    rdfs:comment 'Designated security threat level for this event at this venue, driving staffing levels, screening protocols, and law enforcement coordination. Levels align with internal security classification framework and OSHA venue safety requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surfaceType rdf:type rdf:Property ;
    rdfs:label 'Surface Type' ;
    rdfs:comment 'Type of playing surface configured for this event at this venue. Relevant for athlete safety compliance, league regulations (e.g., NFL CBA surface requirements), and broadcast production planning. [ENUM-REF-CANDIDATE: natural_grass|artificial_turf|hardwood|ice|clay|grass|carpet|concrete|synthetic_clay — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sustainabilityCertification rdf:type rdf:Property ;
    rdfs:label 'Sustainability Certification' ;
    rdfs:comment 'ISO 20121 or equivalent sustainability certification status for this venue assignment, documenting environmental management compliance for the event. Supports ESG (Environmental Social Governance) reporting and league sustainability mandates.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketingSystemVenueCode rdf:type rdf:Property ;
    rdfs:label 'Ticketing System Venue Code' ;
    rdfs:comment 'Venue identifier code as configured in the ticketing platform (Ticketmaster/AXS or Archtics) for this specific event assignment. Used to map seating inventory, price tiers, and access control zones to the correct venue configuration.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venueContractReference rdf:type rdf:Property ;
    rdfs:label 'Venue Contract Reference' ;
    rdfs:comment 'Reference number of the venue rental or usage contract governing this assignment. Links to the contract management system for financial terms, liability clauses, and cancellation provisions. Classified as confidential due to commercial sensitivity.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vipHospitalityEnabled rdf:type rdf:Property ;
    rdfs:label 'Vip Hospitality Enabled' ;
    rdfs:comment 'Indicates whether VIP (Very Important Person) hospitality suites, premium clubs, and sponsor hospitality entitlements are activated for this event at this venue. Triggers hospitality operations preparation and sponsor entitlement fulfillment workflows.' ;
    rdfs:domain ind:VenueAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weatherContingencyPlan rdf:type rdf:Property ;
    rdfs:label 'Weather Contingency Plan' ;
    rdfs:comment 'Reference identifier or description of the weather contingency plan applicable to this outdoor or partially-covered venue assignment. Includes rain delay protocols, lightning evacuation procedures, and postponement triggers.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:awayTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Away Team Franchise Id' ;
    rdfs:comment 'Reference to the visiting team or secondary performing entity for this fixture. Nullable for non-competitive events such as concerts or award ceremonies.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:eventTypeId rdf:type rdf:Property ;
    rdfs:label 'Event Type Id' ;
    rdfs:comment 'Foreign key linking to event.event_type. Business justification: Fixture currently has event_type as STRING column. The event_type reference table exists with event_type_id PK and contains code, name, description, category, format attributes. This is a classic refe' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EventType .

ind:fixtureAwayTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Fixture Away Team Franchise Id' ;
    rdfs:comment 'Reference to the visiting team or secondary performing entity for this fixture. Nullable for non-competitive events such as concerts or award ceremonies.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:fixtureFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Fixture Franchise Id' ;
    rdfs:comment 'Reference to the home team or primary performing entity for this fixture. Used for scheduling, standings calculation, and home/away revenue split logic in SAP S/4HANA FI/CO.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:primaryRevenueStreamId rdf:type rdf:Property ;
    rdfs:label 'Primary Revenue Stream Id' ;
    rdfs:comment 'Foreign key linking to finance.revenue_stream. Business justification: Finance teams classify each fixture against a primary revenue stream (gate, broadcast, PPV) for revenue forecasting, actuals tracking, and ARR reporting. Role-prefixed \'primary_\' because fixtures gene' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RevenueStream .

ind:actualAttendance rdf:type rdf:Property ;
    rdfs:label 'Actual Attendance' ;
    rdfs:comment 'Verified count of attendees who physically entered the venue for this fixture, reconciled from gate scan data in Ticketmaster/AXS. Used for KPI reporting, revenue reconciliation, and league governance submissions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:announcedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Announced Timestamp' ;
    rdfs:comment 'Date and time when the fixture was officially announced to the public. Marks the start of the fixture lifecycle and triggers fan engagement and ticketing on-sale countdown workflows in Adobe Experience Platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:attendanceCapacity rdf:type rdf:Property ;
    rdfs:label 'Attendance Capacity' ;
    rdfs:comment 'Maximum approved attendance capacity for this specific fixture, which may differ from the venue\'s total capacity due to configuration, safety restrictions, or event-specific setup. Used for ticketing inventory management in Archtics and ADA compliance reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:awayScore rdf:type rdf:Property ;
    rdfs:label 'Away Score' ;
    rdfs:comment 'Final score or result for the away team or secondary competitor at the conclusion of the fixture. Populated post-event. Nullable for non-competitive events.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cancelledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cancelled Timestamp' ;
    rdfs:comment 'Date and time when the fixture was officially cancelled or abandoned. Triggers refund processing workflows in Ticketmaster/AXS and revenue reversal entries in SAP S/4HANA FI.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:confirmedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Confirmed Timestamp' ;
    rdfs:comment 'Date and time when the fixture was confirmed by the governing body or event organizer, transitioning from announced to confirmed status. Triggers ticketing on-sale activation in Ticketmaster/AXS and broadcast rights activation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:doorsOpenTimestamp rdf:type rdf:Property ;
    rdfs:label 'Doors Open Timestamp' ;
    rdfs:comment 'Scheduled date and time when venue gates open to ticket holders. Critical for access control configuration in Ticketmaster/AXS gate scan systems and fan arrival experience planning.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventTier rdf:type rdf:Property ;
    rdfs:label 'Event Tier' ;
    rdfs:comment 'Competitive tier or significance level of the fixture within its season or tournament structure. Determines pricing strategy, broadcast rights activation, and sponsorship inventory allocation. Drives dynamic pricing rules in Ticketmaster/AXS.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extraTimePlayed rdf:type rdf:Property ;
    rdfs:label 'Extra Time Played' ;
    rdfs:comment 'Indicates whether the fixture required extra time or overtime periods beyond regulation. Affects broadcast window compliance, venue operations scheduling, and revenue reconciliation for extended event durations.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fixtureCode rdf:type rdf:Property ;
    rdfs:label 'Fixture Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the fixture, used in operational systems such as Ticketmaster/AXS, Archtics, and SAP S/4HANA SD. Serves as the cross-system reference key for event scheduling and revenue management workflows.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fixtureName rdf:type rdf:Property ;
    rdfs:label 'Fixture Name' ;
    rdfs:comment 'Official human-readable name of the fixture as published to fans, broadcasters, and sponsors (e.g., \'NBA Finals Game 7\', \'UFC 300\', \'FIFA World Cup Final\'). Used in ticketing, broadcast schedules, and fan engagement platforms.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeScore rdf:type rdf:Property ;
    rdfs:label 'Home Score' ;
    rdfs:comment 'Final score or result for the home team or primary competitor at the conclusion of the fixture. Populated post-event. Used for standings calculation, WAR (Wins Above Replacement) analytics, and league governance reporting.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isBroadcastEligible rdf:type rdf:Property ;
    rdfs:label 'Is Broadcast Eligible' ;
    rdfs:comment 'Indicates whether this fixture is eligible for broadcast distribution under existing media rights agreements. Drives activation of broadcast workflows in Dalet Galaxy and content rights management.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNeutralSite rdf:type rdf:Property ;
    rdfs:label 'Is Neutral Site' ;
    rdfs:comment 'Indicates whether the fixture is played at a neutral venue with no designated home team advantage. Affects revenue sharing agreements, ticketing allocation rules, and broadcast designation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legNumber rdf:type rdf:Property ;
    rdfs:label 'Leg Number' ;
    rdfs:comment 'Leg sequence number for two-legged ties or multi-game series (e.g., Leg 1, Leg 2 of a UEFA tie; Game 3 of an NBA playoff series). Nullable for single-leg fixtures.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:matchdayNumber rdf:type rdf:Property ;
    rdfs:label 'Matchday Number' ;
    rdfs:comment 'Sequential matchday or game week number within the season or competition phase (e.g., Matchday 1, Week 12). Used for fixture calendar display, standings calculation, and broadcast scheduling.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:penaltyShootout rdf:type rdf:Property ;
    rdfs:label 'Penalty Shootout' ;
    rdfs:comment 'Indicates whether the fixture was decided by a penalty shootout or tiebreaker procedure. Used for competition result reporting and broadcast content tagging in Dalet Galaxy.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:varUsed rdf:type rdf:Property ;
    rdfs:label 'Var Used' ;
    rdfs:comment 'Indicates whether Video Assistant Referee (VAR) or equivalent video review technology (e.g., TMO in rugby) was deployed during this fixture. Required for competition governance reporting and broadcast production metadata.' ;
    rdfs:domain ind:Fixture ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:schedulingAuthorityGoverningBodyId rdf:type rdf:Property ;
    rdfs:label 'Scheduling Authority Governing Body Id' ;
    rdfs:comment 'Reference to the organisational unit or governing body responsible for authoring and approving this fixture calendar (e.g., league office, competition committee, touring promoter).' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GoverningBody .

ind:adaComplianceReviewedFlag rdf:type rdf:Property ;
    rdfs:label 'Ada Compliance Reviewed Flag' ;
    rdfs:comment 'Indicates whether the venue accessibility requirements under the Americans with Disabilities Act (ADA) have been reviewed and confirmed for all venues included in this fixture calendar.' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amendmentDate rdf:type rdf:Property ;
    rdfs:label 'Amendment Date' ;
    rdfs:comment 'The date on which the most recent amendment to this fixture calendar was officially approved and re-published. Null for the initial publication version.' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:broadcastSlotsAllocated rdf:type rdf:Property ;
    rdfs:label 'Broadcast Slots Allocated' ;
    rdfs:comment 'The number of broadcast slots (TV windows, OTT streams, PPV events) formally allocated to fixtures within this calendar. Used by broadcast rights and media distribution teams to validate coverage against RSN and DTC agreements.' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:byeWeekCount rdf:type rdf:Property ;
    rdfs:label 'Bye Week Count' ;
    rdfs:comment 'The number of bye weeks (scheduled rest weeks with no fixtures) defined in this fixture calendar. Critical for NFL and other league formats where bye weeks are mandated by the CBA and affect broadcast scheduling.' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendarNotes rdf:type rdf:Property ;
    rdfs:label 'Calendar Notes' ;
    rdfs:comment 'Free-text operational notes associated with this fixture calendar, capturing scheduling caveats, special conditions, or communications to downstream teams (e.g., \'Subject to FIFA international window confirmation\', \'Venue TBD for weeks 14-16\').' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calendarType rdf:type rdf:Property ;
    rdfs:label 'Calendar Type' ;
    rdfs:comment 'Classification of the fixture calendar by competition or event format. Determines scheduling rules, broadcast rights windows, and ticketing configurations applicable to the calendar. [ENUM-REF-CANDIDATE: regular_season|pre_season|post_season|tournament|concert_tour|international_window|friendly — promote to reference product]' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbaCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Cba Compliant Flag' ;
    rdfs:comment 'Indicates whether this fixture calendar has been validated as compliant with the applicable Collective Bargaining Agreement (CBA) constraints, including maximum consecutive game limits, minimum rest days, and travel restrictions for players.' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:homeAwayBalanceFlag rdf:type rdf:Property ;
    rdfs:label 'Home Away Balance Flag' ;
    rdfs:comment 'Indicates whether this fixture calendar enforces a balanced home/away fixture distribution for participating clubs or teams. True = balanced scheduling enforced; False = unbalanced or neutral-venue format.' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internationalWindowCount rdf:type rdf:Property ;
    rdfs:label 'International Window Count' ;
    rdfs:comment 'The number of FIFA or governing-body-mandated international fixture windows embedded in this calendar during which domestic league fixtures are suspended. Relevant for football/soccer leagues operating under FIFA calendar obligations.' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:multiSportFlag rdf:type rdf:Property ;
    rdfs:label 'Multi Sport Flag' ;
    rdfs:comment 'Indicates whether this fixture calendar spans multiple sports disciplines (e.g., an Olympic Games calendar or a multi-sport festival). False for single-sport league calendars.' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ppvEventCount rdf:type rdf:Property ;
    rdfs:label 'Ppv Event Count' ;
    rdfs:comment 'The number of fixtures within this calendar designated as Pay-Per-View (PPV) events. Drives revenue forecasting, broadcast rights negotiations, and fan engagement planning for premium content.' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryTimezone rdf:type rdf:Property ;
    rdfs:label 'Primary Timezone' ;
    rdfs:comment 'The IANA timezone identifier (e.g., \'America/New_York\', \'Europe/London\') used as the reference timezone for all fixture scheduling times published in this calendar. Critical for broadcast scheduling and fan-facing communications.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulingFormat rdf:type rdf:Property ;
    rdfs:label 'Scheduling Format' ;
    rdfs:comment 'The competition or event scheduling format that governs how fixtures are arranged within this calendar. Determines the structural rules for fixture sequencing and progression. [ENUM-REF-CANDIDATE: round_robin|single_elimination|double_elimination|group_stage|league_cup|touring|mixed — promote to reference product]' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemCalendarReference rdf:type rdf:Property ;
    rdfs:label 'Source System Calendar Reference' ;
    rdfs:comment 'The native identifier of this fixture calendar in the originating operational system (e.g., SAP S/4HANA SD scheduling object ID, Archtics calendar reference). Enables lineage tracing and reconciliation with the system of record.' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalFixtureCount rdf:type rdf:Property ;
    rdfs:label 'Total Fixture Count' ;
    rdfs:comment 'The total number of individual fixtures (matches, games, events) scheduled within this calendar. Used for capacity planning, broadcast slot allocation, and ticketing inventory sizing. This is a declared schedule count, not a derived aggregate.' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalMatchweekCount rdf:type rdf:Property ;
    rdfs:label 'Total Matchweek Count' ;
    rdfs:comment 'The total number of matchweeks, game weeks, or scheduling rounds defined in this fixture calendar. Relevant for league formats with round-robin structures. Null for non-league formats such as concert tours.' ;
    rdfs:domain ind:FixtureCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:officialId rdf:type rdf:Property ;
    rdfs:label 'Official Id' ;
    rdfs:comment 'Reference to the primary match official (referee, umpire, or head official) who officiated the match. Used for officiating performance analytics, assignment tracking, and governing body compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Official .

ind:primaryMatchFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Primary Match Franchise Id' ;
    rdfs:comment 'Reference to the home team or home-side participant in the fixture. Used for league standings, head-to-head analytics, and broadcast attribution.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:refereeOfficialId rdf:type rdf:Property ;
    rdfs:label 'Referee Official Id' ;
    rdfs:comment 'Reference to the primary match official (referee, umpire, or head official) who officiated the match. Used for officiating performance analytics, assignment tracking, and governing body compliance.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Official .

ind:tertiaryMatchWinningTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Match Winning Team Franchise Id' ;
    rdfs:comment 'Reference to the team that won the match. Null for draws or no-result outcomes. Used for bracket progression in knockout competitions, playoff seeding, and broadcast winner attribution.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:winningTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Winning Team Franchise Id' ;
    rdfs:comment 'Reference to the team that won the match. Null for draws or no-result outcomes. Used for bracket progression in knockout competitions, playoff seeding, and broadcast winner attribution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:attendance rdf:type rdf:Property ;
    rdfs:label 'Attendance' ;
    rdfs:comment 'Official announced attendance figure (number of spectators present) for the match. Used for venue capacity utilization reporting, revenue reconciliation, and league attendance KPI tracking.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:awayScoreFinal rdf:type rdf:Property ;
    rdfs:label 'Away Score Final' ;
    rdfs:comment 'Official final score (goals, points, runs, etc.) for the away team at the conclusion of regulation and any extra time/overtime/shootout. This is the authoritative scoreline used for standings and wagering settlement.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:awayScoreRegulation rdf:type rdf:Property ;
    rdfs:label 'Away Score Regulation' ;
    rdfs:comment 'Away team score at the end of regulation time only (excluding overtime, extra time, or shootout). Required for sports where regulation draws carry different standings points than overtime losses.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:broadcastMatchReference rdf:type rdf:Property ;
    rdfs:label 'Broadcast Match Reference' ;
    rdfs:comment 'External identifier assigned to this match result by the broadcast or media rights partner (e.g., RSN, OTT platform, Dalet Galaxy MAM system). Used to link match result data to broadcast highlight packages, content rights windows, and CDN distribution metadata.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitionStage rdf:type rdf:Property ;
    rdfs:label 'Competition Stage' ;
    rdfs:comment 'Stage within the competition at which this match was played. Determines standings impact (regular season points) vs. bracket elimination logic (playoffs/knockout). [ENUM-REF-CANDIDATE: regular_season|playoffs|knockout|group_stage|final|semifinal|quarterfinal|round_of_16|round_of_32 — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dopingControlConducted rdf:type rdf:Property ;
    rdfs:label 'Doping Control Conducted' ;
    rdfs:comment 'Indicates whether WADA-mandated PED (Performance Enhancing Drug) doping control testing was conducted in connection with this match. Supports WADA compliance reporting and anti-doping program audit trails.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:homeScoreFinal rdf:type rdf:Property ;
    rdfs:label 'Home Score Final' ;
    rdfs:comment 'Official final score (goals, points, runs, etc.) for the home team at the conclusion of regulation and any extra time/overtime/shootout. This is the authoritative scoreline used for standings and wagering settlement.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:homeScoreRegulation rdf:type rdf:Property ;
    rdfs:label 'Home Score Regulation' ;
    rdfs:comment 'Home team score at the end of regulation time only (excluding overtime, extra time, or shootout). Required for sports where regulation draws carry different standings points than overtime losses (e.g., NHL, MLS).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:kickoffTimestamp rdf:type rdf:Property ;
    rdfs:label 'Kickoff Timestamp' ;
    rdfs:comment 'Precise UTC timestamp of the official match start (kickoff, tip-off, first pitch, puck drop, etc.). Distinct from match_date — provides sub-day precision for broadcast scheduling, SLA measurement, and wagering in-play event sequencing.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:marginOfVictory rdf:type rdf:Property ;
    rdfs:label 'Margin Of Victory' ;
    rdfs:comment 'Absolute difference between the winning and losing team\'s final scores (e.g., 3 goals, 14 points). Null for draws. Used for strength-of-schedule analytics, WAR (Wins Above Replacement) calculations, and wagering handicap settlement.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:matchDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Match Duration Minutes' ;
    rdfs:comment 'Total actual playing time in minutes from kickoff to final whistle, including stoppage time and overtime but excluding pre-match and half-time intervals. Used for broadcast scheduling, venue operations planning, and SLA compliance.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:matchOutcome rdf:type rdf:Property ;
    rdfs:label 'Match Outcome' ;
    rdfs:comment 'Categorical result of the match from the perspective of home vs. away: \'home_win\', \'away_win\', \'draw\', or \'no_result\' (abandoned/forfeited). Primary field for league standings points allocation and wagering market settlement.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:neutralVenue rdf:type rdf:Property ;
    rdfs:label 'Neutral Venue' ;
    rdfs:comment 'Indicates whether the match was played at a neutral venue (neither team\'s home ground). Affects home/away advantage analytics, standings point allocation rules, and ticket revenue attribution.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overtimePlayed rdf:type rdf:Property ;
    rdfs:label 'Overtime Played' ;
    rdfs:comment 'Indicates whether the match required overtime, extra time, or additional periods beyond regulation to determine a winner. Drives standings point allocation logic (e.g., NHL OTL point) and broadcast scheduling overrun management.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:periodScoresAway rdf:type rdf:Property ;
    rdfs:label 'Period Scores Away' ;
    rdfs:comment 'Pipe-delimited string of away team scores by period, quarter, half, set, or inning (e.g., \'7|21|14|3\' for NFL quarters). Enables granular in-game momentum analytics and broadcast segment attribution.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodScoresHome rdf:type rdf:Property ;
    rdfs:label 'Period Scores Home' ;
    rdfs:comment 'Pipe-delimited string of home team scores by period, quarter, half, set, or inning (e.g., \'21|14|7|10\' for NFL quarters, or \'1|0|2\' for NHL periods). Enables granular in-game momentum analytics and broadcast segment attribution.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pitchCondition rdf:type rdf:Property ;
    rdfs:label 'Pitch Condition' ;
    rdfs:comment 'Official assessment of the playing surface condition at the time of the match. Used for player welfare analytics, venue maintenance scheduling, and governing body compliance reporting.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protestReference rdf:type rdf:Property ;
    rdfs:label 'Protest Reference' ;
    rdfs:comment 'Official reference number of any formal protest or appeal lodged against this match result with the governing body or CAS (Court of Arbitration for Sport). Null if no protest filed. Supports legal and compliance tracking.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultConfirmedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Result Confirmed Timestamp' ;
    rdfs:comment 'UTC timestamp at which the governing body or league operations officially confirmed and locked the match result. Triggers downstream processes: standings updates, wagering settlement, broadcast highlights release, and fantasy sports scoring.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resultNotes rdf:type rdf:Property ;
    rdfs:label 'Result Notes' ;
    rdfs:comment 'Free-text field for official notes or annotations related to the match result, such as protest grounds, abandonment reasons, score correction explanations, or governing body directives. Supports compliance documentation and operational context.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Result Source System' ;
    rdfs:comment 'Identifies the originating system or feed from which the match result data was ingested. Supports data lineage, audit trail, and Silver layer quality validation. Values include SportsCode/Hudl performance analytics platform, governing body official data feeds, or manual entry.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shootoutPlayed rdf:type rdf:Property ;
    rdfs:label 'Shootout Played' ;
    rdfs:comment 'Indicates whether the match was decided by a penalty shootout or shootout format (e.g., FIFA penalty shootout, NHL shootout). Distinct from overtime_played — a match can have overtime without a shootout.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shootoutScoreAway rdf:type rdf:Property ;
    rdfs:label 'Shootout Score Away' ;
    rdfs:comment 'Number of successful shootout attempts by the away team during a penalty shootout. Null if shootout_played is false. Used for detailed shootout analytics and historical records.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shootoutScoreHome rdf:type rdf:Property ;
    rdfs:label 'Shootout Score Home' ;
    rdfs:comment 'Number of successful shootout attempts by the home team during a penalty shootout. Null if shootout_played is false. Used for detailed shootout analytics and historical records.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stoppageTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Stoppage Time Minutes' ;
    rdfs:comment 'Total additional stoppage/injury time added by the referee across all periods. Relevant for soccer/football and rugby. Used for broadcast scheduling overrun management and officiating analytics.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:varIntervention rdf:type rdf:Property ;
    rdfs:label 'Var Intervention' ;
    rdfs:comment 'Indicates whether a Video Assistant Referee (VAR) or Television Match Official (TMO) intervention occurred during the match that affected the official result (e.g., goal disallowed, red card issued, try awarded). Supports officiating quality analytics and governing body review processes.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:varInterventionCount rdf:type rdf:Property ;
    rdfs:label 'Var Intervention Count' ;
    rdfs:comment 'Total number of VAR (Video Assistant Referee) or TMO (Television Match Official) review incidents during the match. Supports officiating quality analytics and governing body compliance reporting.' ;
    rdfs:domain ind:MatchResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:officiatingAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Officiating Assignment Id' ;
    rdfs:comment 'Unique surrogate identifier for each officiating assignment record in the Silver layer lakehouse. Primary key for this transactional entity.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:credentialId rdf:type rdf:Property ;
    rdfs:label 'Credential Id' ;
    rdfs:comment 'Foreign key linking to security.credential. Business justification: Officials assigned to fixtures must have valid credentials issued for restricted zone access. Officiating_assignment must reference the credential record to enable pre-match credential verification wo' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Credential .

ind:primaryOfficiatingOfficialId rdf:type rdf:Property ;
    rdfs:label 'Primary Officiating Official Id' ;
    rdfs:comment 'Reference to the match official (referee, linesman, VAR operator, TMO, judge, or scorer) being assigned to the fixture.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Official .

ind:assignmentDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Date' ;
    rdfs:comment 'The calendar date on which the officiating assignment was formally issued by the governing body or league officiating department.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentMethod rdf:type rdf:Property ;
    rdfs:label 'Assignment Method' ;
    rdfs:comment 'The method by which the official was assigned to this fixture — manual selection by officiating coordinator, automated rotation algorithm, rotational schedule, direct appointment by governing body, or emergency replacement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Assignment Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code for this officiating assignment, used in league governance communications, official notifications, and compliance audit trails.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmationDate rdf:type rdf:Property ;
    rdfs:label 'Confirmation Date' ;
    rdfs:comment 'The date on which the assigned official formally confirmed acceptance of the assignment. Null if not yet confirmed.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:crewChiefFlag rdf:type rdf:Property ;
    rdfs:label 'Crew Chief Flag' ;
    rdfs:comment 'Indicates whether this official is designated as the crew chief or lead referee for the fixture. True = crew chief; False = supporting official.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disciplinaryIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Incident Flag' ;
    rdfs:comment 'Indicates whether a disciplinary incident or formal complaint was raised in connection with this officiating assignment. True = incident recorded; False = no incident. Triggers governance review workflow.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expenseAllowanceAmount rdf:type rdf:Property ;
    rdfs:label 'Expense Allowance Amount' ;
    rdfs:comment 'The approved expense allowance payable to the official for travel, accommodation, and per diem costs associated with this assignment, per governing body policy.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fixtureCompetitionTier rdf:type rdf:Property ;
    rdfs:label 'Fixture Competition Tier' ;
    rdfs:comment 'The competition tier of the fixture to which the official is assigned, used to validate that the official\'s certification level meets the minimum requirement for the competition tier. [ENUM-REF-CANDIDATE: international|domestic_top_flight|domestic_second_tier|cup|playoff|friendly|exhibition — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fixtureKickoffTime rdf:type rdf:Property ;
    rdfs:label 'Fixture Kickoff Time' ;
    rdfs:comment 'The scheduled start date and time of the fixture, including timezone offset. Used for official arrival time planning, pre-match briefing scheduling, and SLA compliance.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:notificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Timestamp' ;
    rdfs:comment 'The precise date and time at which the official was notified of the assignment, supporting SLA compliance tracking for officiating notification windows.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:officialRole rdf:type rdf:Property ;
    rdfs:label 'Official Role' ;
    rdfs:comment 'The specific officiating role assigned to the official for this fixture (e.g., Referee, Assistant Referee, Fourth Official, VAR Operator, TMO, Linesman, Judge, Scorer, Video Review Official). [ENUM-REF-CANDIDATE: referee|assistant_referee|fourth_official|var_operator|tmo|linesman|judge|scorer|video_review_official|head_linesman|back_judge|umpire — promote to reference product]' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officiatingCrewSize rdf:type rdf:Property ;
    rdfs:label 'Officiating Crew Size' ;
    rdfs:comment 'The total number of officials assigned to the fixture as part of the officiating crew, including all roles (referee, assistants, VAR, TMO, etc.).' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:officiatingFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Officiating Fee Amount' ;
    rdfs:comment 'The gross fee payable to the official for this assignment, as defined by the governing body\'s officiating pay scale or collective bargaining agreement (CBA). Expressed in the league\'s base currency.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceRating rdf:type rdf:Property ;
    rdfs:label 'Performance Rating' ;
    rdfs:comment 'Numeric performance rating assigned to the official for this fixture by the officiating assessor or governing body evaluator, typically on a standardized scale (e.g., 1.00–10.00). Supports officiating quality management and career development.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postMatchReportDate rdf:type rdf:Property ;
    rdfs:label 'Post Match Report Date' ;
    rdfs:comment 'The date on which the post-match officiating report was submitted by the official. Null if not yet submitted.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:postMatchReportReference rdf:type rdf:Property ;
    rdfs:label 'Post Match Report Reference' ;
    rdfs:comment 'Reference identifier or document number for the post-match officiating report submitted by the lead official after the fixture. Links to the report stored in the DAM or document management system.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postMatchReportSubmittedFlag rdf:type rdf:Property ;
    rdfs:label 'Post Match Report Submitted Flag' ;
    rdfs:comment 'Indicates whether the post-match officiating report has been submitted by the official following the fixture. True = submitted; False = pending. Supports compliance monitoring.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preMatchBriefingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Pre Match Briefing Timestamp' ;
    rdfs:comment 'The scheduled date and time of the pre-match officiating crew briefing, where the lead referee reviews match protocols, VAR/TMO procedures, and competition-specific directives with the crew.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:replacementReason rdf:type rdf:Property ;
    rdfs:label 'Replacement Reason' ;
    rdfs:comment 'The reason an official was replaced or withdrew from this assignment. Populated only when assignment_status is \'replaced\' or \'withdrawn\'. Supports officiating continuity and governance reporting. [ENUM-REF-CANDIDATE: injury|illness|conflict_of_interest|scheduling_conflict|disciplinary|withdrawal|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tmoEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Tmo Enabled Flag' ;
    rdfs:comment 'Indicates whether a Television Match Official (TMO) is active for this fixture, applicable in rugby and other sports using TMO review protocols.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:travelOriginCity rdf:type rdf:Property ;
    rdfs:label 'Travel Origin City' ;
    rdfs:comment 'The city from which the official will travel to the fixture venue, used for logistics planning and travel cost estimation.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:travelRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Travel Required Flag' ;
    rdfs:comment 'Indicates whether the official requires travel arrangements (flights, accommodation) to attend the assigned fixture. Supports logistics and expense management.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:varEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Var Enabled Flag' ;
    rdfs:comment 'Indicates whether Video Assistant Referee (VAR) technology is active for this fixture, determining whether a VAR operator role is required in the officiating crew.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wadaComplianceVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Wada Compliance Verified Flag' ;
    rdfs:comment 'Indicates whether the assigned official\'s WADA compliance status (anti-doping clearance) has been verified prior to the fixture. Applicable for international competitions. True = verified; False = not verified.' ;
    rdfs:domain ind:OfficiatingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postEventReportId rdf:type rdf:Property ;
    rdfs:label 'Post Event Report Id' ;
    rdfs:comment 'Unique surrogate identifier for the post-event reconciliation report record in the Silver Layer lakehouse.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:archivedAssetId rdf:type rdf:Property ;
    rdfs:label 'Archived Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: Post-event reports reference the archived broadcast asset for governing body submission and compliance verification. content_archival_status on post_event_report tracks archival state; a direct FK to ' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:roiReportId rdf:type rdf:Property ;
    rdfs:label 'Roi Report Id' ;
    rdfs:comment 'Foreign key linking to sponsorship.roi_report. Business justification: Post-event financial reconciliation: post_event_report carries sponsorship_fulfillment_status and financial reconciliation fields. Linking to roi_report enables cross-referencing the operational event' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RoiReport .

ind:signoffEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Signoff Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Post-event compliance reporting requires a traceable employee sign-off for governing body submission and internal audit. The existing signoff_official_name is a denormalized text field; replacing it w' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:awayTeamScore rdf:type rdf:Property ;
    rdfs:label 'Away Team Score' ;
    rdfs:comment 'Final official score of the away/visiting team at the conclusion of the event including any overtime or extra time. Null for non-competitive events such as concerts.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:broadcastChannelCount rdf:type rdf:Property ;
    rdfs:label 'Broadcast Channel Count' ;
    rdfs:comment 'Total number of distinct broadcast channels (linear TV, OTT, RSN, IPTV, PPV) on which this event was distributed. Used for media rights compliance and CPM/GRP reporting.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:broadcastViewershipEstimate rdf:type rdf:Property ;
    rdfs:label 'Broadcast Viewership Estimate' ;
    rdfs:comment 'Estimated total broadcast viewership figure across all distribution channels (linear TV, OTT, IPTV, RSN) for this event. Used for CPM calculations, GRP reporting, and broadcast rights valuation.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceChecklistComplete rdf:type rdf:Property ;
    rdfs:label 'Compliance Checklist Complete' ;
    rdfs:comment 'Indicates whether all mandatory compliance checklist items (OSHA safety, ADA accessibility, GDPR data handling, PCI-DSS payment processing, WADA anti-doping protocols) have been completed and signed off for this event.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concessionGrossRevenue rdf:type rdf:Property ;
    rdfs:label 'Concession Gross Revenue' ;
    rdfs:comment 'Total gross food and beverage concession revenue recorded at the event venue via POS systems. Feeds into SAP S/4HANA FI/CO financial reconciliation and venue operations reporting.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contentArchivalStatus rdf:type rdf:Property ;
    rdfs:label 'Content Archival Status' ;
    rdfs:comment 'Status of post-event content archival workflow in Dalet Galaxy Digital Asset Management (DAM) system. Tracks whether broadcast recordings, highlight packages, and UGC have been ingested and archived per DRM and IP rights obligations.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDelayMinutes rdf:type rdf:Property ;
    rdfs:label 'Event Delay Minutes' ;
    rdfs:comment 'Total duration in minutes by which the event start was delayed from the scheduled kick-off/start time. Zero if no delay occurred. Used for broadcast SLA compliance and insurance claims.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event End Timestamp' ;
    rdfs:comment 'Precise date and time the event concluded including any overtime, extra time, or encores. Used for broadcast rights window reconciliation and venue operations closeout.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Start Timestamp' ;
    rdfs:comment 'Precise date and time the event commenced (first whistle, opening act, puck drop, tip-off). Used for broadcast scheduling reconciliation and production debrief.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:finalAttendance rdf:type rdf:Property ;
    rdfs:label 'Final Attendance' ;
    rdfs:comment 'Official final attendance figure representing the total number of spectators present at the event, as certified by venue operations and gate scan reconciliation from Ticketmaster/AXS and Archtics systems.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:financialReconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Financial Reconciliation Status' ;
    rdfs:comment 'Status of the downstream financial reconciliation process in SAP S/4HANA FI/CO triggered by this post-event report sign-off. Tracks gate revenue, merchandise, and F&B revenue close.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossGateRevenue rdf:type rdf:Property ;
    rdfs:label 'Gross Gate Revenue' ;
    rdfs:comment 'Total gross revenue collected from ticket sales at the gate for this event, before deductions for taxes, promoter fees, or revenue sharing. Sourced from Ticketmaster/AXS and SAP S/4HANA SD module. Used in financial reconciliation and EBITDA reporting.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:homeTeamScore rdf:type rdf:Property ;
    rdfs:label 'Home Team Score' ;
    rdfs:comment 'Final official score of the home team at the conclusion of the event including any overtime or extra time. Null for non-competitive events such as concerts.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:incidentCount rdf:type rdf:Property ;
    rdfs:label 'Incident Count' ;
    rdfs:comment 'Total number of security, safety, or operational incidents recorded during the event. Includes crowd management events, medical responses, and facility incidents. Feeds into OSHA compliance reporting and venue safety reviews.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:majorIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Major Incident Flag' ;
    rdfs:comment 'Indicates whether one or more major incidents (requiring escalation, emergency services, or regulatory notification) occurred during the event. Triggers mandatory OSHA and governing body notification workflows.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:merchandiseGrossRevenue rdf:type rdf:Property ;
    rdfs:label 'Merchandise Gross Revenue' ;
    rdfs:comment 'Total gross merchandise sales revenue recorded at the event venue (POS and e-commerce via Shopify Plus), before deductions. Feeds into SAP S/4HANA SD and financial reconciliation.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netGateRevenue rdf:type rdf:Property ;
    rdfs:label 'Net Gate Revenue' ;
    rdfs:comment 'Net gate revenue after deduction of applicable taxes, facility fees, and revenue-sharing obligations per the CBA or league distribution rules. Used in SAP S/4HANA FI/CO financial close.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:officiatingReportReference rdf:type rdf:Property ;
    rdfs:label 'Officiating Report Reference' ;
    rdfs:comment 'Reference identifier linking to the official match officiating report (referee report, VAR/TMO review log). Used for competition governance, disciplinary proceedings, and CAS arbitration.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppvBuys rdf:type rdf:Property ;
    rdfs:label 'Ppv Buys' ;
    rdfs:comment 'Total number of Pay-Per-View (PPV) purchases recorded for this event across all distribution platforms. Applicable for PPV-designated events such as UFC, boxing, and premium sports fixtures.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:productionDebriefNotes rdf:type rdf:Property ;
    rdfs:label 'Production Debrief Notes' ;
    rdfs:comment 'Free-text production debrief narrative capturing key operational observations, technical issues, broadcast production notes, and lessons learned from the event. Sourced from Dalet Galaxy broadcast workflow and event operations teams.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportNumber rdf:type rdf:Property ;
    rdfs:label 'Report Number' ;
    rdfs:comment 'Externally-known business identifier for the post-event report, formatted as PER-{YYYY}-{NNNNNN}. Used in governing body submissions, regulatory filings, and cross-system references.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultSummary rdf:type rdf:Property ;
    rdfs:label 'Result Summary' ;
    rdfs:comment 'Official final result summary of the event (e.g., final score, match outcome, winner declaration). For sports fixtures: final score line. For concerts: set completion status. Sourced from competition governance records.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signoffTimestamp rdf:type rdf:Property ;
    rdfs:label 'Signoff Timestamp' ;
    rdfs:comment 'Timestamp when the authorized official (e.g., General Manager, Event Director) formally signed off on the completed post-event report, triggering downstream financial reconciliation and regulatory submission workflows.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sponsorshipFulfillmentStatus rdf:type rdf:Property ;
    rdfs:label 'Sponsorship Fulfillment Status' ;
    rdfs:comment 'Status of sponsor contractual obligations fulfillment for this event (e.g., signage display, broadcast integrations, hospitality entitlements). Triggers sponsorship ROI reporting and Salesforce CRM updates.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vipHospitalityCount rdf:type rdf:Property ;
    rdfs:label 'Vip Hospitality Count' ;
    rdfs:comment 'Total number of Very Important Person (VIP) hospitality guests hosted at the event, including sponsor hospitality entitlements and premium suite occupants. Used for sponsorship fulfillment verification.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weatherConditionCode rdf:type rdf:Property ;
    rdfs:label 'Weather Condition Code' ;
    rdfs:comment 'Standardized weather condition code at event time for structured analytics and insurance reporting. Complements the free-text weather summary. [ENUM-REF-CANDIDATE: clear|cloudy|rain|snow|fog|extreme_heat|extreme_cold|storm|indoor — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherSummary rdf:type rdf:Property ;
    rdfs:label 'Weather Summary' ;
    rdfs:comment 'Narrative summary of weather conditions during the event (e.g., temperature, precipitation, wind). Relevant for outdoor venues, event delay documentation, and insurance claims.' ;
    rdfs:domain ind:PostEventReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionScheduleId rdf:type rdf:Property ;
    rdfs:label 'Production Schedule Id' ;
    rdfs:comment 'Unique surrogate identifier for the production schedule record. Primary key for the event-day run-of-show execution plan.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProductionSchedule .

ind:briefingId rdf:type rdf:Property ;
    rdfs:label 'Briefing Id' ;
    rdfs:comment 'Foreign key linking to security.security_briefing. Business justification: Production schedule includes a \'security_briefing_time\' cue in the run-of-show. The production coordinator must reference the formal security briefing record to confirm threat level, staffing readines' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Briefing .

ind:crowdManagementPlanId rdf:type rdf:Property ;
    rdfs:label 'Crowd Management Plan Id' ;
    rdfs:comment 'Foreign key linking to security.crowd_management_plan. Business justification: Halftime performer changeovers, gate open times, and post-event venue clearance in the production schedule must be coordinated with the crowd management plan\'s gate activation counts, peak ingress win' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CrowdManagementPlan .

ind:performerAthleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Performer Athlete Profile Id' ;
    rdfs:comment 'Foreign key linking to athlete.athlete_profile. Business justification: Halftime and pre-show performer scheduling requires linking to the athlete/performer\'s profile for NIL agreement verification, broadcast rights clearance, appearance fee processing, and rider fulfillm' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:productionCoordinatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Production Coordinator Employee Id' ;
    rdfs:comment 'Reference to the workforce member designated as the lead production coordinator responsible for owning and executing this run-of-show.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:runOfShowAssetId rdf:type rdf:Property ;
    rdfs:label 'Run Of Show Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: Production schedules reference a run-of-show document stored as a content asset in the DAM. run_of_show_document_url is a denormalized URL; replacing it with a proper FK to content.asset enables versi' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:staffingPlanId rdf:type rdf:Property ;
    rdfs:label 'Staffing Plan Id' ;
    rdfs:comment 'Foreign key linking to security.security_staffing_plan. Business justification: Production schedule gate-open times, ob-truck arrival, and pre-show windows must align with the security staffing deployment timeline. Production coordinators reference the staffing plan to confirm se' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StaffingPlan .

ind:broadcastGoLiveTime rdf:type rdf:Property ;
    rdfs:label 'Broadcast Go Live Time' ;
    rdfs:comment 'Scheduled timestamp at which the broadcast feed goes live to air or OTT (Over-The-Top Streaming) platforms. Coordinated with the OB (Outside Broadcast) truck and network partners. Critical for FCC compliance and RSN (Regional Sports Network) scheduling.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:broadcastNetwork rdf:type rdf:Property ;
    rdfs:label 'Broadcast Network' ;
    rdfs:comment 'Name of the primary broadcast network or OTT (Over-The-Top Streaming) platform carrying the live event (e.g., ESPN, NBC Sports, Amazon Prime Video, DAZN). Drives broadcast coordination and DRM (Digital Rights Management) enforcement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeoverDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Changeover Duration Minutes' ;
    rdfs:comment 'Planned duration in minutes for the changeover of the playing surface or stage between the halftime show and the resumption of competition. Critical for league compliance with CBA timing rules.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:doorsOpenTime rdf:type rdf:Property ;
    rdfs:label 'Doors Open Time' ;
    rdfs:comment 'Scheduled timestamp at which venue doors open to the public. Drives fan ingress planning, concession staffing, and security deployment timelines.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventEndTime rdf:type rdf:Property ;
    rdfs:label 'Event End Time' ;
    rdfs:comment 'Estimated timestamp for the conclusion of the main event. Used for post-event activity planning, venue clearance scheduling, and broadcast window management.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventStartTime rdf:type rdf:Property ;
    rdfs:label 'Event Start Time' ;
    rdfs:comment 'Scheduled timestamp for the official start of the main event (e.g., opening whistle, first pitch, curtain up). The principal real-world business event timestamp for this production schedule.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventType rdf:type rdf:Property ;
    rdfs:label 'Event Type' ;
    rdfs:comment 'Classification of the event being produced. Determines the production template, staffing model, and broadcast requirements. PPV (Pay-Per-View) events carry additional broadcast coordination requirements. [ENUM-REF-CANDIDATE: league_match|playoff_match|cup_final|concert|esports|ppv_event|exhibition — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:halftimeDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Halftime Duration Minutes' ;
    rdfs:comment 'Planned duration in minutes of the halftime or intermission break. Governed by league CBA (Collective Bargaining Agreement) and broadcast commercial break requirements.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:halftimeStageConfig rdf:type rdf:Property ;
    rdfs:label 'Halftime Stage Config' ;
    rdfs:comment 'Stage layout configuration for the halftime or intermission performance. Determines field/court protection requirements, rigging points, and changeover time from competition surface. [ENUM-REF-CANDIDATE: center_stage|end_stage|thrust|in_the_round|field_full|court_full|no_stage — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:halftimeStartTime rdf:type rdf:Property ;
    rdfs:label 'Halftime Start Time' ;
    rdfs:comment 'Scheduled timestamp for the start of the halftime or intermission break. Drives performer cue, stage crew deployment, and sponsor activation window execution.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isBroadcastLive rdf:type rdf:Property ;
    rdfs:label 'Is Broadcast Live' ;
    rdfs:comment 'Indicates whether the event is being broadcast live (True) or is a tape-delayed or pre-recorded production (False). Affects broadcast go-live coordination and OB truck scheduling.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mediaAccreditationDeadline rdf:type rdf:Property ;
    rdfs:label 'Media Accreditation Deadline' ;
    rdfs:comment 'Deadline timestamp by which media representatives must complete accreditation and credential check-in at the venue. Drives press operations and broadcast partner access management.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:nationalAnthemCueTime rdf:type rdf:Property ;
    rdfs:label 'National Anthem Cue Time' ;
    rdfs:comment 'Scheduled timestamp for the national anthem performance cue. Broadcast-critical timing element coordinated with the OB truck director and league operations.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:obTruckArrivalTime rdf:type rdf:Property ;
    rdfs:label 'Ob Truck Arrival Time' ;
    rdfs:comment 'Scheduled timestamp for the OB (Outside Broadcast) truck to arrive at the venue for broadcast setup and signal testing. Drives broadcast production crew scheduling and venue loading dock coordination.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:playerWalkoutTime rdf:type rdf:Property ;
    rdfs:label 'Player Walkout Time' ;
    rdfs:comment 'Scheduled timestamp for the athlete or team walkout onto the field, court, or stage. Broadcast-critical cue that triggers pre-match ceremony sequences and sponsor LED activations.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:postEventStartTime rdf:type rdf:Property ;
    rdfs:label 'Post Event Start Time' ;
    rdfs:comment 'Scheduled timestamp for the commencement of post-event activities including trophy presentations, press conferences, fan meet-and-greet, and sponsor hospitality wrap-up.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:preShowStartTime rdf:type rdf:Property ;
    rdfs:label 'Pre Show Start Time' ;
    rdfs:comment 'Scheduled timestamp for the commencement of pre-show entertainment programming (e.g., opening acts, fan activation zones, national anthem, player warm-up ceremonies).' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduleLockTimestamp rdf:type rdf:Property ;
    rdfs:label 'Schedule Lock Timestamp' ;
    rdfs:comment 'Timestamp at which the production schedule was formally locked and frozen for game-day execution. No further edits are permitted after this point without an approved change request.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduleReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Schedule Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this production schedule across operational systems. Used by event production teams, broadcast partners, and venue operations for cross-system coordination.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleVersion rdf:type rdf:Property ;
    rdfs:label 'Schedule Version' ;
    rdfs:comment 'Monotonically incrementing version number of the production schedule. Incremented each time the schedule is revised and re-issued. Version 1 is the initial approved plan.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:securityBriefingTime rdf:type rdf:Property ;
    rdfs:label 'Security Briefing Time' ;
    rdfs:comment 'Scheduled timestamp for the pre-event security briefing with venue security, law enforcement liaisons, and event safety officers. Required for OSHA and ADA compliance documentation.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sponsorActivationWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Sponsor Activation Window End' ;
    rdfs:comment 'Scheduled end timestamp for sponsor activation activities. Marks the close of the contractual activation window for fulfilment reporting and ROI (Return on Investment) measurement.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sponsorActivationWindowStart rdf:type rdf:Property ;
    rdfs:label 'Sponsor Activation Window Start' ;
    rdfs:comment 'Scheduled start timestamp for sponsor activation activities within the venue (e.g., branded fan zones, product sampling, LED board takeovers). Linked to sponsorship deal fulfilment obligations.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:technicalRiderNotes rdf:type rdf:Property ;
    rdfs:label 'Technical Rider Notes' ;
    rdfs:comment 'Free-text summary of the halftime or pre-show performer\'s technical rider requirements including audio specifications, lighting rigs, pyrotechnics, video wall usage, and power requirements.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venueClearanceTime rdf:type rdf:Property ;
    rdfs:label 'Venue Clearance Time' ;
    rdfs:comment 'Scheduled timestamp by which all fans, non-essential staff, and performers must have vacated the venue. Drives security staffing, transport coordination, and venue handback to facility management.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:venueSetupStartTime rdf:type rdf:Property ;
    rdfs:label 'Venue Setup Start Time' ;
    rdfs:comment 'Scheduled timestamp for the commencement of pre-event venue setup activities including stage rigging, AV installation, field/court preparation, and sponsor activation builds.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:vipHospitalityStartTime rdf:type rdf:Property ;
    rdfs:label 'Vip Hospitality Start Time' ;
    rdfs:comment 'Scheduled timestamp for the opening of VIP (Very Important Person) hospitality suites and premium experience areas. Drives catering, host staffing, and sponsor entertainment obligations.' ;
    rdfs:domain ind:ProductionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scoringEventId rdf:type rdf:Property ;
    rdfs:label 'Scoring Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each individual in-game scoring moment captured in the system. Primary key for the scoring_event data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ScoringEvent .

ind:assistAthleteAthleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Assist Athlete Athlete Profile Id' ;
    rdfs:comment 'Reference to the athlete credited with the primary assist on this scoring event, where applicable (e.g., pass before a goal, assist before a basket). Nullable when no assist is recorded.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:highlightAssetId rdf:type rdf:Property ;
    rdfs:label 'Highlight Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: Scoring events (goals, touchdowns) are directly linked to highlight clips — a core content monetization workflow in sports entertainment. broadcast_clip_reference is a denormalized string; replacing i' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:primaryScoringAthleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Primary Scoring Athlete Profile Id' ;
    rdfs:comment 'Reference to the athlete credited with the scoring event (goal scorer, touchdown passer/rusher, basket maker, run batter, etc.).' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:pushNotificationId rdf:type rdf:Property ;
    rdfs:label 'Push Notification Id' ;
    rdfs:comment 'Foreign key linking to platform.push_notification. Business justification: Scoring events (goals, touchdowns) trigger real-time push notifications to fans. Linking scoring_event to push_notification enables traceability of which score triggered which alert, supporting fan en' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PushNotification .

ind:awayScoreAfter rdf:type rdf:Property ;
    rdfs:label 'Away Score After' ;
    rdfs:comment 'The cumulative score of the away team immediately after this scoring event was recorded. Paired with home_score_after to represent the full score state at the moment of the event.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coordinateX rdf:type rdf:Property ;
    rdfs:label 'Coordinate X' ;
    rdfs:comment 'The X-axis coordinate on the standardised pitch or field coordinate system representing the horizontal position from which the scoring action originated. Used for spatial heatmaps and performance analytics in SportsCode/Hudl.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coordinateY rdf:type rdf:Property ;
    rdfs:label 'Coordinate Y' ;
    rdfs:comment 'The Y-axis coordinate on the standardised pitch or field coordinate system representing the vertical position from which the scoring action originated. Paired with coordinate_x for full spatial positioning.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventStatus rdf:type rdf:Property ;
    rdfs:label 'Event Status' ;
    rdfs:comment 'Current lifecycle status of the scoring event record. Provisional indicates the event is pending official confirmation; confirmed means officially validated; overturned means disallowed after review; amended means corrected post-confirmation; voided means removed from official records.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Timestamp' ;
    rdfs:comment 'The precise real-world date and time at which the scoring event occurred, expressed in ISO 8601 format with timezone offset. Used for broadcast overlays, play-by-play timelines, and content production.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:externalEventCode rdf:type rdf:Property ;
    rdfs:label 'External Event Code' ;
    rdfs:comment 'Externally-known unique code or reference number for this scoring event as assigned by the official league data provider or broadcast system (e.g., Opta event ID, Stats Perform ID, Sportradar event ID). Used for cross-system reconciliation.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeScoreAfter rdf:type rdf:Property ;
    rdfs:label 'Home Score After' ;
    rdfs:comment 'The cumulative score of the home team immediately after this scoring event was recorded. Captures the score state for broadcast overlays, play-by-play reconstruction, and fan engagement platforms.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hudlEventReference rdf:type rdf:Property ;
    rdfs:label 'Hudl Event Reference' ;
    rdfs:comment 'The native event identifier assigned by the SportsCode or Hudl performance analytics platform for this scoring event. Used for cross-system reconciliation between the lakehouse silver layer and the performance analytics system of record.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isConfirmed rdf:type rdf:Property ;
    rdfs:label 'Is Confirmed' ;
    rdfs:comment 'Indicates whether this scoring event has been officially confirmed and validated by the match officials or league data operations team. False for provisional or pending events awaiting VAR review or official confirmation.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLeadChange rdf:type rdf:Property ;
    rdfs:label 'Is Lead Change' ;
    rdfs:comment 'Indicates whether this scoring event resulted in a change of lead between the two competing teams. True when the scoring team overtook the previously leading team. Key metric for broadcast drama and fan engagement analytics.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOwnGoal rdf:type rdf:Property ;
    rdfs:label 'Is Own Goal' ;
    rdfs:comment 'Indicates whether this scoring event was an own goal (scored by a player against their own team). Affects attribution logic and statistical reporting for the credited athlete.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTie rdf:type rdf:Property ;
    rdfs:label 'Is Tie' ;
    rdfs:comment 'Indicates whether this scoring event resulted in a tied score between the two competing teams. True when the score differential after the event equals zero.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchClockSeconds rdf:type rdf:Property ;
    rdfs:label 'Match Clock Seconds' ;
    rdfs:comment 'Elapsed match clock time in seconds at the moment the scoring event occurred within the current period. Enables precise play-by-play positioning and broadcast overlay synchronisation.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:officiatingDecisionCode rdf:type rdf:Property ;
    rdfs:label 'Officiating Decision Code' ;
    rdfs:comment 'Official code or reference assigned by the match officiating team or league operations to document any officiating decision associated with this scoring event (e.g., penalty awarded, foul called, offside check). Supports league governance and compliance reporting.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodNumber rdf:type rdf:Property ;
    rdfs:label 'Period Number' ;
    rdfs:comment 'The period, quarter, half, inning, or round number within the match in which the scoring event occurred (e.g., 1 = first half/quarter/period, 2 = second, etc.). Supports sport-agnostic period-level analytics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:periodType rdf:type rdf:Property ;
    rdfs:label 'Period Type' ;
    rdfs:comment 'Classification of the period in which the scoring event occurred, distinguishing regular play from overtime, extra time, penalty shootout, or sudden death. Critical for statistical integrity and broadcast context.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pitchZone rdf:type rdf:Property ;
    rdfs:label 'Pitch Zone' ;
    rdfs:comment 'The designated zone or area of the playing field from which the scoring action was initiated (e.g., penalty area, midfield, three-point arc, red zone, paint area). Supports spatial analytics and performance analysis in SportsCode/Hudl. [ENUM-REF-CANDIDATE: penalty_area|six_yard_box|outside_box|three_point_arc|paint|mid_range|red_zone|end_zone|infield|outfield — promote to reference product]' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:playPattern rdf:type rdf:Property ;
    rdfs:label 'Play Pattern' ;
    rdfs:comment 'The tactical play pattern or situation from which the scoring event originated (e.g., open play, set piece, counter attack, fast break, corner, free kick). Supports tactical analysis and content production. [ENUM-REF-CANDIDATE: open_play|set_piece|counter_attack|fast_break|corner|free_kick|penalty|throw_in|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointsValue rdf:type rdf:Property ;
    rdfs:label 'Points Value' ;
    rdfs:comment 'The number of points awarded to the scoring team as a result of this scoring event (e.g., 1 for a free throw, 2 for a basket, 3 for a three-pointer, 6 for a touchdown, 1 for a goal in soccer). Core quantitative fact of the scoring event.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scoreDifferentialAfter rdf:type rdf:Property ;
    rdfs:label 'Score Differential After' ;
    rdfs:comment 'The signed score differential (home minus away) immediately after this scoring event. Positive values indicate home team lead; negative values indicate away team lead; zero indicates a tie. Supports win probability and momentum analytics.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scoringMethod rdf:type rdf:Property ;
    rdfs:label 'Scoring Method' ;
    rdfs:comment 'The specific method by which the score was achieved (e.g., penalty kick, free kick, header, slam dunk, three-pointer, home run, touchdown pass, field goal, try, conversion). Sport-specific enumeration managed as a reference product. [ENUM-REF-CANDIDATE: penalty_kick|free_kick|header|open_play|slam_dunk|three_pointer|home_run|touchdown_pass|rushing_touchdown|field_goal|try|conversion|free_throw|layup|own_goal — promote to reference product]' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sequence Number' ;
    rdfs:comment 'Sequential ordinal number of this scoring event within the match, ordered chronologically. The first score of the match is 1, the second is 2, etc. Enables ordered play-by-play reconstruction and broadcast timeline sequencing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:varReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Var Review Flag' ;
    rdfs:comment 'Indicates whether this scoring event was subject to a Video Assistant Referee (VAR) or Television Match Official (TMO) review process. True when a review was initiated. Supports officiating analytics and broadcast commentary.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:varReviewOutcome rdf:type rdf:Property ;
    rdfs:label 'Var Review Outcome' ;
    rdfs:comment 'The outcome of the VAR or TMO review for this scoring event. Upheld means the original decision stands; overturned means the scoring event was disallowed or modified; inconclusive means no definitive determination was reached. Null or not_reviewed when var_review_flag is false.' ;
    rdfs:domain ind:ScoringEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualsAmount rdf:type rdf:Property ;
    rdfs:label 'Actuals Amount' ;
    rdfs:comment 'Actual expenditure or revenue posted against this tournament from this budget line year-to-date. Sourced from detection phase relationship data. Enables tournament-level actuals tracking within the broader budget line.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastRightsType rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Type' ;
    rdfs:comment 'Classification of broadcast rights arrangement for the tournament. Determines distribution channels, geo-restrictions, and revenue sharing models. PPV (Pay-Per-View) and OTT (Over-The-Top Streaming) rights have distinct monetization implications. [ENUM-REF-CANDIDATE: exclusive|non_exclusive|regional|global|ppv|ott|free_to_air — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetType rdf:type rdf:Property ;
    rdfs:label 'Budget Type' ;
    rdfs:comment 'Classification of the budget allocation by expenditure category for this tournament: OPEX (operating expenditure such as staffing, marketing, production) or CAPEX (capital expenditure such as venue infrastructure). Sourced from detection phase relationship data.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetVersion rdf:type rdf:Property ;
    rdfs:label 'Budget Version' ;
    rdfs:comment 'Version label of the budget cycle applicable to this tournament allocation (e.g., Original, Revised, Q1 Reforecast, Q2 Reforecast). Sourced directly from the detection phase relationship data. Allows FP&A to compare allocation amounts across planning cycles for the same tournament.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:editionNumber rdf:type rdf:Property ;
    rdfs:label 'Edition Number' ;
    rdfs:comment 'Sequential edition or iteration number of the tournament (e.g., 23rd FIFA World Cup, 75th NBA Playoffs). Enables historical trend analysis and year-over-year performance comparisons.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:editionYear rdf:type rdf:Property ;
    rdfs:label 'Edition Year' ;
    rdfs:comment 'Calendar year associated with this tournament edition (e.g., 2026 for FIFA World Cup 2026). Used as a human-readable identifier for the edition in reporting and fan-facing content.' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eligibilityCriteria rdf:type rdf:Property ;
    rdfs:label 'Eligibility Criteria' ;
    rdfs:comment 'Narrative description of participant eligibility requirements including nationality restrictions, ranking thresholds, qualification pathway requirements, and CBA compliance conditions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalCode rdf:type rdf:Property ;
    rdfs:label 'External Code' ;
    rdfs:comment 'Externally recognized unique code or identifier assigned by the governing body or data provider (e.g., FIFA tournament ID, Opta competition code). Used for data exchange and integration with third-party systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formatType rdf:type rdf:Property ;
    rdfs:label 'Format Type' ;
    rdfs:comment 'Structural competition format that defines how participants advance through the tournament. Drives bracket logic, scheduling, and elimination rules. [ENUM-REF-CANDIDATE: single_elimination|double_elimination|round_robin|group_stage_knockout|multi_stage|league_playoff|swiss — promote to reference product if additional formats are needed]' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hostRegion rdf:type rdf:Property ;
    rdfs:label 'Host Region' ;
    rdfs:comment 'Geographic region or confederation where the tournament is hosted (e.g., North America, Europe, Asia-Pacific). Used for broadcast rights distribution, regional sponsorship packages, and fan engagement targeting.' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedAmount rdf:type rdf:Property ;
    rdfs:label 'Planned Amount' ;
    rdfs:comment 'The original planned budget amount allocated to this specific tournament from this budget line for the applicable fiscal period. Sourced from detection phase relationship data. Belongs to the allocation relationship, not the tournament or budget record alone.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prizePoolAmount rdf:type rdf:Property ;
    rdfs:label 'Prize Pool Amount' ;
    rdfs:comment 'Total monetary prize pool allocated for distribution to tournament participants and winners, expressed in the tournament\'s base currency. Used for financial planning, sponsor negotiations, and athlete contract compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prizePoolCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Prize Pool Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the prize pool amount (e.g., USD, EUR, GBP). Required for multi-currency financial reporting and SAP S/4HANA FI integration.' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualificationMethod rdf:type rdf:Property ;
    rdfs:label 'Qualification Method' ;
    rdfs:comment 'Primary method by which participants earn entry into the tournament (e.g., direct qualification via league standings, playoff qualifier, wild card selection, invitation by governing body, ranking points accumulation).' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrenceType rdf:type rdf:Property ;
    rdfs:label 'Recurrence Type' ;
    rdfs:comment 'Frequency at which this tournament recurs (e.g., annual for NBA Playoffs, quadrennial for FIFA World Cup, one-time for special events). Supports long-range event planning and broadcast rights negotiation cycles.' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationDeadline rdf:type rdf:Property ;
    rdfs:label 'Registration Deadline' ;
    rdfs:comment 'Final date by which teams or athletes must complete registration and eligibility verification to participate in the tournament. Enforced per governing body regulations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revisedAmount rdf:type rdf:Property ;
    rdfs:label 'Revised Amount' ;
    rdfs:comment 'The most recently approved revised budget amount allocated to this tournament after reforecast cycles. Sourced from detection phase relationship data. Reflects mid-cycle adjustments specific to this tournament-budget pairing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:seedingMethodology rdf:type rdf:Property ;
    rdfs:label 'Seeding Methodology' ;
    rdfs:comment 'Method used to assign seeds and bracket positions to participants (e.g., ranking-based using WAR or QBR metrics, committee selection, random draw). Governs competitive fairness and bracket integrity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortName rdf:type rdf:Property ;
    rdfs:label 'Short Name' ;
    rdfs:comment 'Abbreviated or commonly used name for the tournament used in broadcast graphics, digital platforms, and fan-facing displays (e.g., \'World Cup 2026\', \'NBA Playoffs\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialMediaHashtag rdf:type rdf:Property ;
    rdfs:label 'Social Media Hashtag' ;
    rdfs:comment 'Official social media hashtag designated for the tournament (e.g., #WorldCup2026, #NBAPlayoffs). Used for fan engagement tracking, UGC (User Generated Content) monitoring, and NPS (Net Promoter Score) sentiment analysis.' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sustainabilityCertified rdf:type rdf:Property ;
    rdfs:label 'Sustainability Certified' ;
    rdfs:comment 'Indicates whether the tournament has achieved or is pursuing ISO 20121 Event Sustainability Management System certification. Supports ESG reporting and sponsor sustainability commitments.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ticketSalesEnabled rdf:type rdf:Property ;
    rdfs:label 'Ticket Sales Enabled' ;
    rdfs:comment 'Indicates whether public ticket sales are enabled for this tournament. When false, the tournament may be closed-door, invitation-only, or broadcast-only. Drives Ticketmaster/AXS inventory activation.' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tiebreakerRules rdf:type rdf:Property ;
    rdfs:label 'Tiebreaker Rules' ;
    rdfs:comment 'Description of the rules applied to resolve tied standings or scores within the tournament (e.g., head-to-head record, goal difference, penalty shootout, sudden death overtime). Governed by the sanctioning body.' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalMatchesScheduled rdf:type rdf:Property ;
    rdfs:label 'Total Matches Scheduled' ;
    rdfs:comment 'Total number of matches or games scheduled across all rounds of the tournament (e.g., 64 matches for FIFA World Cup group + knockout stages). Used for venue scheduling, broadcast slot planning, and officiating resource allocation.' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalParticipants rdf:type rdf:Property ;
    rdfs:label 'Total Participants' ;
    rdfs:comment 'Maximum number of teams or individual athletes eligible to compete in the tournament (e.g., 32 teams for FIFA World Cup, 16 teams for NBA Playoffs). Defines bracket size and seeding structure.' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tournamentName rdf:type rdf:Property ;
    rdfs:label 'Tournament Name' ;
    rdfs:comment 'Official full name of the tournament as sanctioned by the governing body (e.g., \'FIFA World Cup 2026\', \'NBA Playoffs 2025\', \'UFC Championship Series Season 3\').' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tournamentStatus rdf:type rdf:Property ;
    rdfs:label 'Tournament Status' ;
    rdfs:comment 'Current lifecycle state of the tournament from announcement through post-event reconciliation. Drives operational workflows, ticketing availability, and broadcast scheduling.' ;
    rdfs:domain ind:Tournament ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varEnabled rdf:type rdf:Property ;
    rdfs:label 'Var Enabled' ;
    rdfs:comment 'Indicates whether VAR (Video Assistant Referee) or TMO (Television Match Official) technology is deployed for officiating decisions during this tournament. Relevant for football, rugby, and other applicable sports.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:varianceExplanation rdf:type rdf:Property ;
    rdfs:label 'Variance Explanation' ;
    rdfs:comment 'Narrative explanation provided by the budget owner describing the reason for planned vs. actual variance for this specific tournament-budget allocation. Sourced from detection phase relationship data. Belongs to the allocation relationship as it contextualizes the financial delta at the tournament level.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherContingencyId rdf:type rdf:Property ;
    rdfs:label 'Weather Contingency Id' ;
    rdfs:comment 'Unique surrogate identifier for a weather contingency planning record associated with an outdoor or weather-sensitive event.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WeatherContingency .

ind:decisionAuthorityEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Decision Authority Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Weather delay and cancellation decisions in sports-entertainment carry significant liability, insurance, and fan communication consequences. The decision authority must be a traceable named employee (' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualDelayDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Actual Delay Duration Minutes' ;
    rdfs:comment 'Actual duration of the weather-related delay in minutes, recorded after the delay is resolved. Used for broadcast SLA reconciliation, insurance claims, and post-event reporting.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contingencyDecisionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Contingency Decision Timestamp' ;
    rdfs:comment 'Date and time at which the formal contingency action decision (delay, suspension, cancellation, etc.) was officially made by the authorized decision-maker.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:contingencyNotes rdf:type rdf:Property ;
    rdfs:label 'Contingency Notes' ;
    rdfs:comment 'Free-text operational notes capturing additional context about the weather contingency event, including on-site observations, decision rationale, and coordination actions taken.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Contingency Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this weather contingency plan record, used in cross-system communications and fan notifications.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyStatus rdf:type rdf:Property ;
    rdfs:label 'Contingency Status' ;
    rdfs:comment 'Current lifecycle state of the weather contingency plan: draft (being prepared), active (monitoring in progress), triggered (contingency action invoked), resolved (event proceeded or concluded), cancelled (plan voided).' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyType rdf:type rdf:Property ;
    rdfs:label 'Contingency Type' ;
    rdfs:comment 'Classification of the contingency action type applicable to this plan: delay (event start pushed), suspension (in-progress event halted), cancellation (event called off), dome_closure (retractable roof closed), venue_change (alternate venue activated), evacuation (fan safety evacuation). [ENUM-REF-CANDIDATE: delay|suspension|cancellation|dome_closure|venue_change|evacuation — promote to reference product if additional types emerge]' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delayTriggerThresholdMinutes rdf:type rdf:Property ;
    rdfs:label 'Delay Trigger Threshold Minutes' ;
    rdfs:comment 'Minimum delay duration in minutes that constitutes a formal weather delay event, used to distinguish brief holds from reportable delays for broadcast, ticketing, and insurance purposes.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:domeClosureApplicable rdf:type rdf:Property ;
    rdfs:label 'Dome Closure Applicable' ;
    rdfs:comment 'Indicates whether the venue has a retractable roof or dome that can be closed as a weather contingency measure, enabling dome closure as a valid contingency action type.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:domeClosureDecisionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dome Closure Decision Timestamp' ;
    rdfs:comment 'Date and time at which the official decision to close the retractable roof or dome was made. Null if dome closure was not applicable or not invoked.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fanCommunicationChannel rdf:type rdf:Property ;
    rdfs:label 'Fan Communication Channel' ;
    rdfs:comment 'Primary channel used to communicate weather contingency status to fans in attendance and ticket holders (e.g., sms, push_notification, pa_announcement, digital_signage, social_media, email).' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanNotificationDispatched rdf:type rdf:Property ;
    rdfs:label 'Fan Notification Dispatched' ;
    rdfs:comment 'Indicates whether a fan-facing weather contingency notification has been dispatched through the designated communication channel.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fanNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Fan Notification Timestamp' ;
    rdfs:comment 'Date and time at which the fan-facing weather contingency notification was dispatched. Null if notification has not yet been sent.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:forecastCondition rdf:type rdf:Property ;
    rdfs:label 'Forecast Condition' ;
    rdfs:comment 'Textual description of the forecasted weather condition at event time (e.g., Clear, Partly Cloudy, Thunderstorm, Heavy Rain, Blizzard, High Winds).' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastLightningProbabilityPct rdf:type rdf:Property ;
    rdfs:label 'Forecast Lightning Probability Pct' ;
    rdfs:comment 'Forecasted probability of lightning activity within the venue radius during the event window, expressed as a percentage (0–100). Lightning is a primary trigger for event suspension under safety protocols.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastPrecipitationMm rdf:type rdf:Property ;
    rdfs:label 'Forecast Precipitation Mm' ;
    rdfs:comment 'Forecasted total precipitation accumulation at the venue during the event window, expressed in millimetres.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastRetrievedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Forecast Retrieved Timestamp' ;
    rdfs:comment 'Date and time at which the most recent weather forecast data was retrieved from the forecast provider for this contingency record.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:forecastSource rdf:type rdf:Property ;
    rdfs:label 'Forecast Source' ;
    rdfs:comment 'Name or identifier of the meteorological data provider supplying forecasts for this contingency plan (e.g., AccuWeather, The Weather Company, National Weather Service).' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Forecast Temperature C' ;
    rdfs:comment 'Forecasted ambient air temperature at the venue at event start time, expressed in degrees Celsius.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastWindGustKmh rdf:type rdf:Property ;
    rdfs:label 'Forecast Wind Gust Kmh' ;
    rdfs:comment 'Forecasted peak wind gust speed at the venue at event time, expressed in kilometres per hour. Gust thresholds may independently trigger contingency actions.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastWindSpeedKmh rdf:type rdf:Property ;
    rdfs:label 'Forecast Wind Speed Kmh' ;
    rdfs:comment 'Forecasted sustained wind speed at the venue at event time, expressed in kilometres per hour. Used to evaluate structural safety and field-of-play conditions.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:governingBodyNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Governing Body Notification Required' ;
    rdfs:comment 'Indicates whether the applicable governing body (e.g., FIFA, NFL, NBA, MLB, NHL) must be formally notified of the weather contingency action per competition rules.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:governingBodyNotifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Governing Body Notified Timestamp' ;
    rdfs:comment 'Date and time at which the governing body was formally notified of the weather contingency action. Null if notification is not required or has not yet been sent.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:insuranceClaimApplicable rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Applicable' ;
    rdfs:comment 'Indicates whether the weather contingency outcome meets the threshold for filing an event cancellation or weather-related insurance claim.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lightningClearanceMinutes rdf:type rdf:Property ;
    rdfs:label 'Lightning Clearance Minutes' ;
    rdfs:comment 'Required wait time in minutes after the last detected lightning strike before event play or fan re-entry is permitted, per venue safety protocol.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:monitoringStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Monitoring Start Timestamp' ;
    rdfs:comment 'Date and time at which active weather monitoring for this event commenced, typically 72–96 hours before scheduled event start.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:planVersion rdf:type rdf:Property ;
    rdfs:label 'Plan Version' ;
    rdfs:comment 'Incremental version number of the weather contingency plan, incremented each time the plan is revised prior to or during the event.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:precipitationThresholdMm rdf:type rdf:Property ;
    rdfs:label 'Precipitation Threshold Mm' ;
    rdfs:comment 'Precipitation accumulation threshold in millimetres per hour at or above which field-of-play conditions are deemed unplayable and contingency action is triggered.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:refundPolicyApplicable rdf:type rdf:Property ;
    rdfs:label 'Refund Policy Applicable' ;
    rdfs:comment 'Indicates whether the weather contingency outcome triggers the applicable ticket refund or exchange policy per the event\'s terms and conditions.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refundTriggerCondition rdf:type rdf:Property ;
    rdfs:label 'Refund Trigger Condition' ;
    rdfs:comment 'Specific condition under which ticket refunds are triggered for this weather contingency event (e.g., cancellation, delay_exceeds_threshold, postponement, partial_completion).' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rescheduleDate rdf:type rdf:Property ;
    rdfs:label 'Reschedule Date' ;
    rdfs:comment 'Proposed or confirmed rescheduled date for the event if the weather contingency results in postponement. Null if cancellation is final or rescheduling has not been determined.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:temperatureMaxThresholdC rdf:type rdf:Property ;
    rdfs:label 'Temperature Max Threshold C' ;
    rdfs:comment 'Maximum ambient temperature in degrees Celsius above which event cancellation, suspension, or heat-safety protocols are triggered per governing body or venue safety policy.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:temperatureMinThresholdC rdf:type rdf:Property ;
    rdfs:label 'Temperature Min Threshold C' ;
    rdfs:comment 'Minimum ambient temperature in degrees Celsius below which event cancellation, suspension, or modified operations are triggered per governing body or venue safety policy.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:windSpeedThresholdKmh rdf:type rdf:Property ;
    rdfs:label 'Wind Speed Threshold Kmh' ;
    rdfs:comment 'Sustained wind speed threshold in kilometres per hour at or above which event cancellation or suspension is mandated per venue and governing body safety protocols.' ;
    rdfs:domain ind:WeatherContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accountId rdf:type rdf:Property ;
    rdfs:label 'Account Id' ;
    rdfs:comment 'Primary key for account' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:acquisitionCampaignId rdf:type rdf:Property ;
    rdfs:label 'Acquisition Campaign Id' ;
    rdfs:comment 'Reference to the marketing campaign that drove the fan\'s initial account registration. Used for Customer Acquisition Cost (CAC) attribution, campaign Return on Investment (ROI) analysis, and cohort performance reporting.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Campaign .

ind:fanClubMembershipId rdf:type rdf:Property ;
    rdfs:label 'Fan Club Membership Id' ;
    rdfs:comment 'Reference to the official fan club membership record associated with this account. Null if the account is not enrolled in a fan club. Enables fan club benefit delivery, exclusive content access, and supporter group governance.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClubMembership .

ind:preferredTeamId rdf:type rdf:Property ;
    rdfs:label 'Preferred Team Id' ;
    rdfs:comment 'Reference to the fan\'s primary supported team or franchise. Used for personalized content delivery, targeted marketing, and team-specific loyalty benefit routing. Sourced from fan registration preference or CRM profile.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Team .

ind:preferredVenueId rdf:type rdf:Property ;
    rdfs:label 'Preferred Venue Id' ;
    rdfs:comment 'Reference to the fan\'s primary home venue for event attendance. Used for venue-specific promotions, parking pre-registration, and in-venue personalization services.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Venue .

ind:accountStatus rdf:type rdf:Property ;
    rdfs:label 'Account Status' ;
    rdfs:comment 'Current lifecycle state of the fan account. Active indicates a fully operational account; suspended indicates temporary restriction (e.g., fraud review); closed indicates permanently deactivated; pending_verification indicates registration awaiting email or identity confirmation; locked indicates security lockout after failed authentication attempts; deactivated indicates voluntary closure by the fan. Serves as LIFECYCLE_STATUS for this MASTER_AGREEMENT entity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountTier rdf:type rdf:Property ;
    rdfs:label 'Account Tier' ;
    rdfs:comment 'Loyalty and service tier assigned to the fan account, determining access to benefits, priority services, and promotional offers. Tiers range from standard (base) through silver, gold, platinum, vip, and elite. Drives CRM segmentation, targeted marketing, and loyalty redemption rules. [ENUM-REF-CANDIDATE: standard|silver|gold|platinum|vip|elite — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountType rdf:type rdf:Property ;
    rdfs:label 'Account Type' ;
    rdfs:comment 'Classification of the account by the nature of the fan relationship. Individual covers single-fan B2C accounts; family covers household multi-fan accounts; corporate_group covers B2B group purchasers; season_ticket_holder denotes dedicated season pass accounts; vip_member covers premium hospitality accounts; fan_club covers organized supporter group accounts. Serves as CLASSIFICATION_OR_TYPE for this MASTER_AGREEMENT entity. [ENUM-REF-CANDIDATE: individual|family|corporate_group|season_ticket_holder|vip_member|fan_club — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardBrand rdf:type rdf:Property ;
    rdfs:label 'Card Brand' ;
    rdfs:comment 'Brand of the default payment card on file (e.g., Visa, Mastercard, Amex). Non-sensitive card metadata retained for display and routing purposes. Does not constitute PAN or sensitive authentication data under PCI-DSS.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Card Expiry Date' ;
    rdfs:comment 'Expiration date of the default payment card on file. Used to proactively notify fans of upcoming card expiry and prompt payment method updates before renewal or purchase failures occur.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cardLastFour rdf:type rdf:Property ;
    rdfs:label 'Card Last Four' ;
    rdfs:comment 'Last four digits of the default payment card on file. Retained as permitted truncated PAN under PCI-DSS for fan-facing display and customer service verification. Does not constitute full PAN.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ccpaOptOutFlag rdf:type rdf:Property ;
    rdfs:label 'Ccpa Opt Out Flag' ;
    rdfs:comment 'Indicates whether the fan has exercised their CCPA right to opt out of the sale or sharing of personal information. True when the fan has submitted a Do Not Sell or Share request. Drives data sharing suppression for California-resident accounts.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closureDate rdf:type rdf:Property ;
    rdfs:label 'Closure Date' ;
    rdfs:comment 'Calendar date on which the fan account was permanently closed or deactivated. Null for accounts that remain open. Serves as EFFECTIVE_UNTIL for this MASTER_AGREEMENT entity. Required for GDPR right-to-erasure audit trails and churn analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentRecordedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Consent Recorded Timestamp' ;
    rdfs:comment 'Timestamp at which the fan\'s most recent consent preferences were recorded or last updated. Used as the audit timestamp for GDPR and CCPA consent records. Required for demonstrating lawful basis of processing under GDPR Article 7.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:crmAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Crm Account Number' ;
    rdfs:comment 'Externally-known alphanumeric account number assigned by Salesforce CRM. Used as the business-facing identifier on correspondence, ticketing portals, and fan-facing digital platforms. Serves as the BUSINESS_IDENTIFIER for this MASTER_AGREEMENT entity.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crmSegmentCode rdf:type rdf:Property ;
    rdfs:label 'Crm Segment Code' ;
    rdfs:comment 'CRM-assigned segmentation code classifying the fan account into a marketing or engagement segment (e.g., HIGH_VALUE, LAPSED, NEW_FAN, REACTIVATED). Used by Salesforce CRM and Adobe Experience Platform for targeted campaign execution and personalization.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currency rdf:type rdf:Property ;
    rdfs:label 'Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code representing the fan\'s preferred transaction currency (e.g., USD, GBP, EUR, AUD). Used for pricing display, ticketing transactions, and merchandise purchases on the fan\'s account.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataResidencyCountry rdf:type rdf:Property ;
    rdfs:label 'Data Residency Country' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code indicating the jurisdiction in which the fan\'s personal data must be stored and processed. Drives data residency enforcement, GDPR adequacy decisions, and cross-border transfer controls.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultPaymentFlag rdf:type rdf:Property ;
    rdfs:label 'Default Payment Flag' ;
    rdfs:comment 'Indicates whether the stored payment instrument is designated as the default payment method for this account. True when this is the primary instrument used for automated renewals, loyalty redemptions, and one-click purchases.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:language rdf:type rdf:Property ;
    rdfs:label 'Language' ;
    rdfs:comment 'BCP 47 language tag representing the fan\'s preferred language for communications and digital platform content (e.g., en-US, es-MX, fr-FR, pt-BR). Used for localized content delivery, email template selection, and multilingual customer service routing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastLoginTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Login Timestamp' ;
    rdfs:comment 'Timestamp of the most recent successful authentication event on the fan account. Used for dormancy detection, re-engagement campaign targeting, and security anomaly detection. Sourced from Salesforce CRM or Adobe Experience Platform session logs.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:loginFailureCount rdf:type rdf:Property ;
    rdfs:label 'Login Failure Count' ;
    rdfs:comment 'Number of consecutive failed login attempts since the last successful authentication. Used to trigger account lockout policies per security standards. Resets to zero upon successful login. Sourced from Salesforce CRM identity management.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:loyaltyPointsBalance rdf:type rdf:Property ;
    rdfs:label 'Loyalty Points Balance' ;
    rdfs:comment 'Current unredeemed loyalty points balance on the fan account at the time of the last update. Raw operational balance used for redemption eligibility checks and tier qualification. Not a calculated aggregate — sourced directly from the CRM loyalty ledger.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:loyaltyPointsYtdEarned rdf:type rdf:Property ;
    rdfs:label 'Loyalty Points Ytd Earned' ;
    rdfs:comment 'Total loyalty points earned by the fan account in the current calendar or fiscal year. Used for annual tier qualification thresholds and year-end loyalty reporting. Resets at the start of each program year.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:marketingEmailOptInFlag rdf:type rdf:Property ;
    rdfs:label 'Marketing Email Opt In Flag' ;
    rdfs:comment 'Indicates whether the fan has opted in to receive marketing and promotional email communications. True when explicit opt-in consent has been recorded. Used by CRM to control email campaign eligibility and suppression lists.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mfaEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Mfa Enabled Flag' ;
    rdfs:comment 'Indicates whether Multi-Factor Authentication (MFA) is currently enabled on the fan account. True when the fan has enrolled a second authentication factor (e.g., SMS OTP, authenticator app). Used for security compliance reporting and risk-based access control.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:npsSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Nps Survey Date' ;
    rdfs:comment 'Date on which the most recent NPS survey response was recorded for this fan account. Used to determine survey recency, control survey frequency, and align NPS scores with event or season context.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:passwordLastChangedDate rdf:type rdf:Property ;
    rdfs:label 'Password Last Changed Date' ;
    rdfs:comment 'Date on which the fan last changed their account password. Used for security policy enforcement, forced password rotation reminders, and breach response workflows. Does not store the password itself — credential metadata only.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pciPaymentToken rdf:type rdf:Property ;
    rdfs:label 'Pci Payment Token' ;
    rdfs:comment 'PCI-DSS compliant tokenized representation of the fan\'s default payment instrument on file. The token is issued by the payment processor and replaces the actual card number (PAN). Never stores raw card data. Used for recurring purchases, loyalty redemptions, and ticketing transactions.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Email' ;
    rdfs:comment 'Primary email address associated with the fan account, used for login authentication, transactional notifications, and marketing communications. Subject to GDPR and CCPA consent requirements. Sourced from Salesforce CRM Account email field.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Phone' ;
    rdfs:comment 'Primary contact phone number for the fan account in E.164 international format. Used for two-factor authentication (2FA), SMS notifications, and customer service outreach. Subject to GDPR and CCPA consent requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pushNotificationOptInFlag rdf:type rdf:Property ;
    rdfs:label 'Push Notification Opt In Flag' ;
    rdfs:comment 'Indicates whether the fan has enabled push notifications on the mobile app. True when the fan has granted notification permissions. Used for real-time event alerts, score updates, and personalized offers via Adobe Experience Platform.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:registrationChannel rdf:type rdf:Property ;
    rdfs:label 'Registration Channel' ;
    rdfs:comment 'The channel through which the fan account was originally created. Web covers desktop/browser self-registration; mobile_app covers iOS/Android app registration; in_venue_kiosk covers on-site registration terminals; call_center covers agent-assisted registration; third_party_partner covers registrations via ticketing or partner platforms; pos covers Point of Sale (POS) terminal registration at venue merchandise or box office. Used for channel attribution and acquisition cost analysis.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonTicketHolderFlag rdf:type rdf:Property ;
    rdfs:label 'Season Ticket Holder Flag' ;
    rdfs:comment 'Indicates whether the fan account holds at least one active season ticket package for the current season. True when one or more season ticket entitlements are linked to this account. Used for priority access, renewal campaigns, and season ticket holder benefit eligibility.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:smsOptInFlag rdf:type rdf:Property ;
    rdfs:label 'Sms Opt In Flag' ;
    rdfs:comment 'Indicates whether the fan has opted in to receive SMS/text message marketing communications. True when explicit opt-in consent has been recorded. Required for TCPA compliance in the US and equivalent regulations in other jurisdictions.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:username rdf:type rdf:Property ;
    rdfs:label 'Username' ;
    rdfs:comment 'Unique login username chosen by the fan for digital platform authentication. Used across web, mobile app, and OTT (Over-The-Top Streaming) platforms. Must be unique across all active accounts. Sourced from Salesforce CRM identity management.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vipFlag rdf:type rdf:Property ;
    rdfs:label 'Vip Flag' ;
    rdfs:comment 'Indicates whether the fan account is designated as a Very Important Person (VIP), qualifying for premium hospitality, dedicated concierge services, and exclusive event access. Set by CRM administrators based on spend thresholds or manual designation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clubMembershipId rdf:type rdf:Property ;
    rdfs:label 'Club Membership Id' ;
    rdfs:comment 'Primary key for club_membership' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClubMembership .

ind:chapterId rdf:type rdf:Property ;
    rdfs:label 'Chapter Id' ;
    rdfs:comment 'Reference to the geographic or organizational chapter of the fan club to which this member is assigned. Fan clubs may be organized into regional chapters (e.g., city, country, or venue-based) to facilitate local events and community activities.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Chapter .

ind:clubId rdf:type rdf:Property ;
    rdfs:label 'Club Id' ;
    rdfs:comment 'Reference to the specific fan club this membership belongs to. Identifies the community, team-affiliated club, or sport-specific fan organization the fan has joined.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Club .

ind:primaryClubFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Primary Club Fan Profile Id' ;
    rdfs:comment 'Reference to the fan profile record that holds this club membership. Links the membership to the fan\'s identity, demographic, and CRM data in the fan_profile product.' ;
    rdfs:domain ind:ClubMembership ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:referredByFanFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Referred By Fan Fan Profile Id' ;
    rdfs:comment 'Fan profile ID of the existing member who referred this fan to the club. Enables member-get-member referral program tracking, referral reward attribution, and network-effect analytics.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:autoRenewalEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Enabled' ;
    rdfs:comment 'Indicates whether the fan has opted into automatic renewal of their membership at the end of each term. When True, the dues payment is processed automatically via the stored payment method on the renewal date.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cardDeliveryStatus rdf:type rdf:Property ;
    rdfs:label 'Card Delivery Status' ;
    rdfs:comment 'Current fulfillment status of the physical membership card. Tracks the card from issuance through delivery to the fan\'s registered address. \'returned\' indicates the card was undeliverable and returned to sender.' ;
    rdfs:domain ind:ClubMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardIssuedDate rdf:type rdf:Property ;
    rdfs:label 'Card Issued Date' ;
    rdfs:comment 'Date on which the current membership card was issued or last reissued to the fan. Used to track card lifecycle, replacement requests, and access control validity.' ;
    rdfs:domain ind:ClubMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentCaptureDate rdf:type rdf:Property ;
    rdfs:label 'Consent Capture Date' ;
    rdfs:comment 'Date on which the fan\'s data processing and marketing consent was most recently captured or updated for this membership record. Required for GDPR and CCPA compliance audit trails.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:duesAmount rdf:type rdf:Property ;
    rdfs:label 'Dues Amount' ;
    rdfs:comment 'Monetary amount charged for the current membership term in the billing currency. Reflects the tier-specific dues schedule and any negotiated or promotional rate applied at enrollment or renewal.' ;
    rdfs:domain ind:ClubMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:duesCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Dues Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the dues_amount (e.g., USD, GBP, EUR). Supports multi-currency operations across global fan club markets.' ;
    rdfs:domain ind:ClubMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duesPaidDate rdf:type rdf:Property ;
    rdfs:label 'Dues Paid Date' ;
    rdfs:comment 'Date on which the membership dues for the current term were confirmed as received and settled. Used for financial reconciliation, access activation, and audit trails.' ;
    rdfs:domain ind:ClubMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:duesPaymentStatus rdf:type rdf:Property ;
    rdfs:label 'Dues Payment Status' ;
    rdfs:comment 'Current payment status of the membership dues for the active term. \'paid\' = dues received and confirmed; \'pending\' = payment initiated but not yet settled; \'overdue\' = payment not received by due date; \'waived\' = dues formally waived (e.g., honorary members); \'refunded\' = dues returned to the fan.' ;
    rdfs:domain ind:ClubMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentChannel rdf:type rdf:Property ;
    rdfs:label 'Enrollment Channel' ;
    rdfs:comment 'Channel through which the fan originally enrolled in the fan club. Used for acquisition attribution, channel ROI (Return on Investment) analysis, and optimizing fan acquisition spend across DTC (Direct-To-Consumer) and partner channels. [ENUM-REF-CANDIDATE: web|mobile_app|venue_kiosk|call_centre|retail|event|partner — promote to reference product if channels expand]' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hasVotingRights rdf:type rdf:Property ;
    rdfs:label 'Has Voting Rights' ;
    rdfs:comment 'Indicates whether this member holds voting rights within the fan club governance structure (e.g., eligible to vote in club elections, rule changes, or fan representative selections). Typically granted to full-dues-paying members above a minimum tenure threshold.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFoundingMember rdf:type rdf:Property ;
    rdfs:label 'Is Founding Member' ;
    rdfs:comment 'Indicates whether the fan was among the original founding cohort of the fan club. Founding members may receive permanent tier upgrades, exclusive merchandise, or lifetime recognition benefits.' ;
    rdfs:domain ind:ClubMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:joinDate rdf:type rdf:Property ;
    rdfs:label 'Join Date' ;
    rdfs:comment 'Calendar date on which the fan officially joined the fan club and the membership became effective for the first time. Used for tenure calculations, anniversary recognition, and founding-member eligibility.' ;
    rdfs:domain ind:ClubMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketingOptIn rdf:type rdf:Property ;
    rdfs:label 'Marketing Opt In' ;
    rdfs:comment 'Indicates whether the fan has consented to receive marketing communications from the fan club, including promotional offers, sponsor messages, and merchandise promotions. Distinct from operational membership communications.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:membershipCardNumber rdf:type rdf:Property ;
    rdfs:label 'Membership Card Number' ;
    rdfs:comment 'Physical or digital membership card number issued to the fan. Used for access control at venues, merchandise discounts, and identity verification at fan club events. Treated as a confidential identifier as it can be used to access member benefits.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:membershipTier rdf:type rdf:Property ;
    rdfs:label 'Membership Tier' ;
    rdfs:comment 'Tier classification within the fan club that governs the level of privileges, benefits, and access rights granted to the member. Higher tiers typically carry greater dues, exclusive content access, priority ticketing, and VIP (Very Important Person) event invitations. [ENUM-REF-CANDIDATE: standard|silver|gold|platinum|founding|vip — promote to reference product if tiers expand beyond 6]' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:membershipType rdf:type rdf:Property ;
    rdfs:label 'Membership Type' ;
    rdfs:comment 'Classification of the membership by the category of fan or account it covers. Determines eligibility rules, dues schedules, and benefit packages. \'family\' allows multiple household members under one membership; \'corporate\' is for business-sponsored fan groups; \'honorary\' is granted without dues to distinguished individuals.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredContactChannel rdf:type rdf:Property ;
    rdfs:label 'Preferred Contact Channel' ;
    rdfs:comment 'Fan\'s preferred communication channel for fan club communications such as renewal reminders, event invitations, and member newsletters. Overrides the global preference on the fan profile for club-specific communications.' ;
    rdfs:domain ind:ClubMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralSourceCode rdf:type rdf:Property ;
    rdfs:label 'Referral Source Code' ;
    rdfs:comment 'Campaign or referral code used at the time of enrollment to attribute the membership acquisition to a specific marketing campaign, partner promotion, or fan referral program. Supports CAC (Customer Acquisition Cost) and LTV (Lifetime Value) analytics.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalCount rdf:type rdf:Property ;
    rdfs:label 'Renewal Count' ;
    rdfs:comment 'Total number of times this membership has been renewed since the original join date. Used to identify long-tenured members for loyalty recognition, retention risk scoring, and anniversary milestone campaigns.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Date' ;
    rdfs:comment 'Scheduled or actual date on which the membership was most recently renewed. Distinct from expiry_date; captures the transactional renewal event date for renewal-rate analytics and CRM (Customer Relationship Management) campaign attribution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:suspensionEndDate rdf:type rdf:Property ;
    rdfs:label 'Suspension End Date' ;
    rdfs:comment 'Date on which the membership suspension is scheduled to end and full benefits are reinstated. Null if the suspension is indefinite or the membership has never been suspended.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:suspensionStartDate rdf:type rdf:Property ;
    rdfs:label 'Suspension Start Date' ;
    rdfs:comment 'Date from which the membership was placed in suspended status, restricting access to benefits and club activities. Null if the membership has never been suspended.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:communicationId rdf:type rdf:Property ;
    rdfs:label 'Communication Id' ;
    rdfs:comment 'Primary key for communication' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bonusOfferId rdf:type rdf:Property ;
    rdfs:label 'Bonus Offer Id' ;
    rdfs:comment 'Foreign key linking to gaming.bonus_offer. Business justification: Bonus offer marketing compliance: communications promoting specific betting bonus offers must reference the bonus_offer record for conversion tracking, regulatory bonus advertising compliance (terms m' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BonusOffer .

ind:segmentId rdf:type rdf:Property ;
    rdfs:label 'Segment Id' ;
    rdfs:comment 'Reference to the fan audience segment or CRM list that this communication was targeted to. Used for communication fatigue management and audience analytics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Segment .

ind:templateId rdf:type rdf:Property ;
    rdfs:label 'Template Id' ;
    rdfs:comment 'Identifier of the content template used to render this communication. References the template version in Salesforce CRM or Adobe Experience Platform. Enables template performance analysis.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommunicationTemplate .

ind:abTestVariant rdf:type rdf:Property ;
    rdfs:label 'Ab Test Variant' ;
    rdfs:comment 'Identifier of the A/B or multivariate test variant assigned to this communication (e.g., \'A\', \'B\', \'control\'). Used to measure the performance of different subject lines, content, or send times in campaign optimisation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bounceType rdf:type rdf:Property ;
    rdfs:label 'Bounce Type' ;
    rdfs:comment 'Classification of the delivery bounce when delivery_status is \'bounced\'. Hard bounce = permanent delivery failure (invalid address); Soft bounce = temporary failure (mailbox full, server unavailable); Block = rejected by receiving server due to spam or policy rules.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:campaignName rdf:type rdf:Property ;
    rdfs:label 'Campaign Name' ;
    rdfs:comment 'Human-readable name of the campaign, journey, or automation workflow that generated this communication. Sourced from Salesforce CRM or Adobe Experience Platform campaign execution logs.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channel rdf:type rdf:Property ;
    rdfs:label 'Channel' ;
    rdfs:comment 'The delivery channel used to send this communication to the fan. Supports omnichannel fan engagement tracking across email, SMS, push notification, in-app message, and direct mail.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clickTimestamp rdf:type rdf:Property ;
    rdfs:label 'Click Timestamp' ;
    rdfs:comment 'The date and time (UTC) at which the fan first clicked a link or call-to-action within the communication. Null if no click was recorded. Used for click-through rate (CTR) and conversion analysis.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:clickUrl rdf:type rdf:Property ;
    rdfs:label 'Click Url' ;
    rdfs:comment 'The specific URL or deep link that the fan clicked within the communication. Captures the primary or first-click URL for conversion attribution and content performance analysis.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationType rdf:type rdf:Property ;
    rdfs:label 'Communication Type' ;
    rdfs:comment 'Classification of the communication by business purpose. Transactional messages are triggered by fan actions (e.g., ticket purchase confirmation); marketing messages are campaign-driven; loyalty messages relate to loyalty program activity; service messages are operational; alerts are time-sensitive notifications.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentBasis rdf:type rdf:Property ;
    rdfs:label 'Consent Basis' ;
    rdfs:comment 'The GDPR lawful basis under which this communication was sent to the fan. Explicit consent = fan actively opted in; Legitimate interest = business interest basis; Contractual = required for contract fulfilment (e.g., ticket confirmation); Vital interest = emergency safety communication.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conversionFlag rdf:type rdf:Property ;
    rdfs:label 'Conversion Flag' ;
    rdfs:comment 'Indicates whether the fan completed the intended conversion action (e.g., ticket purchase, merchandise order, loyalty enrolment) within the attribution window following this communication. True = conversion attributed to this communication.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Delivery Timestamp' ;
    rdfs:comment 'The date and time (UTC) at which delivery of the communication was confirmed by the receiving server or device. Null if delivery has not been confirmed or if the message bounced.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:externalMessageReference rdf:type rdf:Property ;
    rdfs:label 'External Message Reference' ;
    rdfs:comment 'The unique message identifier assigned by the originating system of record (Salesforce CRM, Adobe Experience Platform, or third-party ESP/SMS gateway). Used for deduplication and cross-system traceability.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fatigueScore rdf:type rdf:Property ;
    rdfs:label 'Fatigue Score' ;
    rdfs:comment 'Numeric score representing the fan\'s communication fatigue level at the time this message was sent, calculated from recent communication frequency. Used to enforce fatigue caps and optimise send cadence. Higher values indicate greater fatigue risk.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:loyaltyTier rdf:type rdf:Property ;
    rdfs:label 'Loyalty Tier' ;
    rdfs:comment 'The fan\'s loyalty membership tier at the time this communication was sent (e.g., Bronze, Silver, Gold, Platinum, VIP). Captured as a point-in-time snapshot to support loyalty-segmented communication performance analysis.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npsSurveyFlag rdf:type rdf:Property ;
    rdfs:label 'Nps Survey Flag' ;
    rdfs:comment 'Indicates whether this communication included or was a Net Promoter Score (NPS) survey request. True = NPS survey was embedded or linked in this message. Supports fan satisfaction tracking and NPS programme management.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:openTimestamp rdf:type rdf:Property ;
    rdfs:label 'Open Timestamp' ;
    rdfs:comment 'The date and time (UTC) at which the fan first opened or viewed the communication. Applicable to email (pixel tracking) and in-app messages. Null if the communication was not opened.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:optOutFlag rdf:type rdf:Property ;
    rdfs:label 'Opt Out Flag' ;
    rdfs:comment 'Indicates whether the fan unsubscribed or opted out of future communications as a result of receiving this specific message. True = opt-out action was triggered by this communication. Critical for GDPR suppression compliance and CAN-SPAM adherence.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optOutTimestamp rdf:type rdf:Property ;
    rdfs:label 'Opt Out Timestamp' ;
    rdfs:comment 'The date and time (UTC) at which the fan submitted an opt-out or unsubscribe request linked to this communication. Null if no opt-out was recorded. Required for GDPR and CCPA suppression audit trails.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:personalizationFlag rdf:type rdf:Property ;
    rdfs:label 'Personalization Flag' ;
    rdfs:comment 'Indicates whether this communication was dynamically personalized using fan profile data (e.g., name, favourite team, loyalty tier, purchase history). True = personalized content was applied; False = generic broadcast content.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledSendTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Send Timestamp' ;
    rdfs:comment 'The date and time (UTC) at which the communication was originally scheduled to be sent. May differ from send_timestamp if the send was delayed or rescheduled. Used for send-time optimisation analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sendTimestamp rdf:type rdf:Property ;
    rdfs:label 'Send Timestamp' ;
    rdfs:comment 'The date and time (UTC) at which the communication was dispatched from the sending platform to the delivery provider (ESP, SMS gateway, push service). This is the principal business event timestamp for this transaction.' ;
    rdfs:domain ind:Communication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceRecordReference rdf:type rdf:Property ;
    rdfs:label 'Source Record Reference' ;
    rdfs:comment 'The native record identifier from the originating source system (Salesforce CRM activity ID or Adobe Experience Platform event ID). Enables lineage tracing and reconciliation between the Silver Layer and the operational system.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectLine rdf:type rdf:Property ;
    rdfs:label 'Subject Line' ;
    rdfs:comment 'The subject line or headline of the communication as delivered to the fan. Applicable primarily to email and push notifications. Used for A/B test analysis and engagement reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suppressionFlag rdf:type rdf:Property ;
    rdfs:label 'Suppression Flag' ;
    rdfs:comment 'Indicates whether this communication was suppressed before send due to an active suppression rule (e.g., GDPR opt-out, communication fatigue cap, DNC list, or regulatory restriction). True = suppressed and not delivered.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suppressionReason rdf:type rdf:Property ;
    rdfs:label 'Suppression Reason' ;
    rdfs:comment 'The reason this communication was suppressed and not sent to the fan. Used for compliance audit and communication fatigue management reporting. Populated only when suppression_flag is True.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentPreferenceId rdf:type rdf:Property ;
    rdfs:label 'Consent Preference Id' ;
    rdfs:comment 'Unique surrogate identifier for each consent preference record. Primary key for the consent_preference data product in the fan domain.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authSessionId rdf:type rdf:Property ;
    rdfs:label 'Auth Session Id' ;
    rdfs:comment 'Session identifier from the digital platform (web, mobile app) during which the fan submitted their consent. Links consent capture to the broader fan session for audit and fraud detection purposes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuthSession .

ind:dataControllerCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Data Controller Corporate Entity Id' ;
    rdfs:comment 'Identifier of the legal entity acting as the data controller responsible for this consent record. Supports multi-entity sports organisations where different leagues, clubs, or subsidiaries act as separate data controllers.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:dataProcessorCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Data Processor Corporate Entity Id' ;
    rdfs:comment 'Identifier of the third-party data processor (e.g., Adobe Experience Platform, Salesforce CRM) acting on behalf of the data controller for this consent type. Required for GDPR Article 28 processor accountability.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:parentalGuardianFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Parental Guardian Fan Profile Id' ;
    rdfs:comment 'Fan ID of the parent or legal guardian who provided consent on behalf of a minor fan. Null for adult fans. Links to the guardian\'s fan profile for family account management.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:primaryConsentFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Primary Consent Fan Profile Id' ;
    rdfs:comment 'Identifier of the fan whose consent preference this record captures. Links to the fan master profile as the primary party reference.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:primaryConsentVendorId rdf:type rdf:Property ;
    rdfs:label 'Primary Consent Vendor Id' ;
    rdfs:comment 'Identifier of the third-party data processor (e.g., Adobe Experience Platform, Salesforce CRM) acting on behalf of the data controller for this consent type. Required for GDPR Article 28 processor accountability.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:aepConsentReference rdf:type rdf:Property ;
    rdfs:label 'Aep Consent Reference' ;
    rdfs:comment 'External identifier of the corresponding consent record in Adobe Experience Platform. Supports synchronisation of consent signals to the fan engagement and personalisation platform.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentCategory rdf:type rdf:Property ;
    rdfs:label 'Consent Category' ;
    rdfs:comment 'High-level category grouping for this consent type, aligned with IAB TCF (Transparency and Consent Framework) and cookie consent banner classifications. Supports consent management platform (CMP) integration and reporting.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentDate rdf:type rdf:Property ;
    rdfs:label 'Consent Date' ;
    rdfs:comment 'Timestamp at which the fan actively granted this consent. Represents the principal business event timestamp for the consent lifecycle. Stored in ISO 8601 format with timezone offset.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:consentLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Consent Language Code' ;
    rdfs:comment 'ISO 639-1 language code (optionally with ISO 3166-1 country subtag) of the language in which the consent notice was presented to the fan. Ensures consent was given in the fan\'s understood language, a GDPR requirement.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentNoticeUrl rdf:type rdf:Property ;
    rdfs:label 'Consent Notice Url' ;
    rdfs:comment 'URL of the specific privacy notice or consent form presented to the fan at the time of consent capture. Provides an auditable link to the exact disclosure document the fan reviewed.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Consent Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned to this consent record, used for audit trails, regulatory inquiries, and fan-facing acknowledgement receipts. Generated at point of consent capture.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentRenewalReminderDate rdf:type rdf:Property ;
    rdfs:label 'Consent Renewal Reminder Date' ;
    rdfs:comment 'Date on which a consent renewal reminder should be sent to the fan, typically triggered before the effective_until date. Supports proactive consent lifecycle management to avoid consent lapse.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentSource rdf:type rdf:Property ;
    rdfs:label 'Consent Source' ;
    rdfs:comment 'The channel or touchpoint through which the fan provided or updated their consent. Used for audit purposes and to validate that consent was obtained through an appropriate mechanism. Values: web_form, mobile_app, in_venue_kiosk, call_center, paper_form, third_party.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentStatus rdf:type rdf:Property ;
    rdfs:label 'Consent Status' ;
    rdfs:comment 'Current lifecycle state of this consent record. \'granted\' indicates active consent; \'withdrawn\' indicates the fan has revoked consent; \'pending\' indicates consent request issued but not yet confirmed; \'expired\' indicates consent has lapsed past its validity period.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crmConsentRecordReference rdf:type rdf:Property ;
    rdfs:label 'Crm Consent Record Reference' ;
    rdfs:comment 'External identifier of the corresponding consent record in Salesforce CRM. Enables bi-directional reconciliation between the lakehouse silver layer and the operational CRM system of record.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPortabilityRequested rdf:type rdf:Property ;
    rdfs:label 'Data Portability Requested' ;
    rdfs:comment 'Indicates whether the fan has submitted a Data Portability request under GDPR Article 20, requesting their personal data in a machine-readable format. Triggers data export workflows.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doubleOptInDate rdf:type rdf:Property ;
    rdfs:label 'Double Opt In Date' ;
    rdfs:comment 'Timestamp at which the fan completed the double opt-in confirmation step. Null if double opt-in was not required or not completed. Supports audit evidence for email marketing consent.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:doubleOptInFlag rdf:type rdf:Property ;
    rdfs:label 'Double Opt In Flag' ;
    rdfs:comment 'Indicates whether the fan completed a double opt-in confirmation process (True) for this consent, such as clicking a confirmation link in an email. Provides stronger evidence of consent for email marketing under GDPR.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:erasureRequestDate rdf:type rdf:Property ;
    rdfs:label 'Erasure Request Date' ;
    rdfs:comment 'Timestamp at which the fan submitted their Right to Erasure or CCPA deletion request. Null if no erasure request has been made. Starts the regulatory response clock (30 days under GDPR, 45 days under CCPA).' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:iabTcfPurposeCode rdf:type rdf:Property ;
    rdfs:label 'Iab Tcf Purpose Code' ;
    rdfs:comment 'Numeric identifier of the IAB TCF v2.2 purpose associated with this consent record. Enables interoperability with programmatic advertising and digital media ecosystems for broadcast and OTT platforms.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minorFlag rdf:type rdf:Property ;
    rdfs:label 'Minor Flag' ;
    rdfs:comment 'Indicates whether the fan is a minor (under 16 in EU, under 13 in US) at the time of consent. Triggers parental consent verification workflows and restricts certain processing activities under GDPR Article 8 and COPPA.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optInFlag rdf:type rdf:Property ;
    rdfs:label 'Opt In Flag' ;
    rdfs:comment 'Indicates whether the fan has actively opted in (True) or opted out (False) for this consent type. Provides a direct boolean signal for downstream marketing suppression lists and personalisation engines.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentalConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Parental Consent Flag' ;
    rdfs:comment 'Indicates whether verifiable parental consent has been obtained for a minor fan (True) or not (False). Required for fans identified as minors under GDPR Article 8 and COPPA.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rightToErasureRequested rdf:type rdf:Property ;
    rdfs:label 'Right To Erasure Requested' ;
    rdfs:comment 'Indicates whether the fan has submitted a Right to Erasure (Right to be Forgotten) request under GDPR Article 17 or CCPA deletion request. Triggers downstream data deletion workflows across all processing systems.' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:withdrawalDate rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Date' ;
    rdfs:comment 'Timestamp at which the fan withdrew or revoked this consent. Null if consent has not been withdrawn. Required for GDPR and CCPA audit trails demonstrating timely cessation of processing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withdrawalMethod rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Method' ;
    rdfs:comment 'The channel or mechanism through which the fan withdrew their consent. Null if consent has not been withdrawn. Supports audit trails and ensures withdrawal was as easy as granting consent per GDPR Article 7(3).' ;
    rdfs:domain ind:ConsentPreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessZoneId rdf:type rdf:Property ;
    rdfs:label 'Access Zone Id' ;
    rdfs:comment 'Identifier of the specific in-venue Bluetooth Low Energy (BLE) beacon zone that detected the fan during an in-venue engagement event. Enables micro-location analytics, concession proximity targeting, and crowd flow analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccessZone .

ind:broadcastStreamLiveFeedId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Stream Live Feed Id' ;
    rdfs:comment 'Reference to the live broadcast or OTT (Over-The-Top) stream being watched during a live stream watch engagement event. Nullable for non-broadcast engagement types. Links to broadcast schedule and rights data.' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LiveFeed .

ind:ticketOrderLineId rdf:type rdf:Property ;
    rdfs:label 'Ticket Order Line Id' ;
    rdfs:comment 'Reference to the ticket associated with an attendance check-in engagement event. Links the behavioral engagement record to the ticketing transaction in Ticketmaster/AXS for attendance verification and season ticket holder analytics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TicketOrderLine .

ind:aepExperienceEventReference rdf:type rdf:Property ;
    rdfs:label 'Aep Experience Event Reference' ;
    rdfs:comment 'The source system event identifier assigned by Adobe Experience Platform at the point of behavioral data capture. Used for lineage tracing and deduplication against the AEP raw event stream.' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aepSegmentIds rdf:type rdf:Property ;
    rdfs:label 'Aep Segment Ids' ;
    rdfs:comment 'Pipe-delimited list of Adobe Experience Platform (AEP) audience segment identifiers that the fan belonged to at the time of this engagement event. Captures the real-time segmentation state for personalization attribution and segment performance analysis. Stored as a delimited string per Silver layer no-complex-type convention.' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appVersion rdf:type rdf:Property ;
    rdfs:label 'App Version' ;
    rdfs:comment 'Version number of the mobile or web application from which the engagement event was generated. Used for feature adoption tracking, bug correlation, and release impact analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentAnalytics rdf:type rdf:Property ;
    rdfs:label 'Consent Analytics' ;
    rdfs:comment 'Indicates whether the fan had active analytics and behavioral tracking consent at the time of this engagement event. Governs whether this event can be used in behavioral analytics models and personalization under GDPR and CCPA.' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentMarketing rdf:type rdf:Property ;
    rdfs:label 'Consent Marketing' ;
    rdfs:comment 'Indicates whether the fan had active marketing communications consent at the time of this engagement event, as recorded in the consent management platform. Governs whether this event can be used for personalized marketing activation under GDPR and CCPA.' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contentProgressPct rdf:type rdf:Property ;
    rdfs:label 'Content Progress Pct' ;
    rdfs:comment 'Percentage of a content asset (video, podcast, article) consumed by the fan during a content view or live stream watch engagement event. Ranges from 0.00 to 100.00. Used for content completion rate analytics and personalization model features.' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crmInteractionReference rdf:type rdf:Property ;
    rdfs:label 'Crm Interaction Reference' ;
    rdfs:comment 'The corresponding interaction or activity record identifier in Salesforce CRM, if this engagement event was surfaced or actioned through the CRM platform. Used for cross-system reconciliation between AEP behavioral data and Salesforce CRM fan interaction history.' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceOs rdf:type rdf:Property ;
    rdfs:label 'Device Os' ;
    rdfs:comment 'Operating system of the device used during the engagement event. Used for platform-specific analytics, app version targeting, and technical performance monitoring. [ENUM-REF-CANDIDATE: ios|android|windows|macos|tvos|roku|fire_os|unknown — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementChannel rdf:type rdf:Property ;
    rdfs:label 'Engagement Channel' ;
    rdfs:comment 'The interface or platform through which the fan engagement occurred. Distinguishes mobile app, web, in-venue, broadcast, social, Over-The-Top (OTT) streaming, email, and kiosk interactions for omnichannel analytics. [ENUM-REF-CANDIDATE: mobile_app|web|in_venue|broadcast|social|ott|email|kiosk — promote to reference product]' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementDate rdf:type rdf:Property ;
    rdfs:label 'Engagement Date' ;
    rdfs:comment 'Calendar date of the fan engagement interaction, derived from engagement_timestamp. Used as a partition key and for day-level aggregation in reporting, event-day analysis, and fan attendance correlation. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:engagementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Engagement Timestamp' ;
    rdfs:comment 'The precise real-world date and time when the fan engagement interaction occurred, as recorded by the source system. Principal business event time used for time-series analysis, session stitching, and RFM recency scoring. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:engagementType rdf:type rdf:Property ;
    rdfs:label 'Engagement Type' ;
    rdfs:comment 'Categorical discriminator identifying the kind of fan engagement interaction captured. Drives segmentation, RFM scoring, and personalization model feature engineering. [ENUM-REF-CANDIDATE: attendance_checkin|app_session|content_view|social_share|merchandise_browse|loyalty_redemption|live_stream_watch|beacon_detection|contest_entry|watchlist_action — promote to reference product]' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementValueScore rdf:type rdf:Property ;
    rdfs:label 'Engagement Value Score' ;
    rdfs:comment 'Weighted numeric score representing the business value of this individual engagement interaction, assigned by the AEP scoring model based on engagement type, duration, and channel. Primary input to RFM (Recency, Frequency, Monetary) scoring and fan LTV (Lifetime Value) calculation.' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geoRegionCode rdf:type rdf:Property ;
    rdfs:label 'Geo Region Code' ;
    rdfs:comment 'ISO 3166-2 subdivision code (state, province, or region) of the fan\'s location at the time of engagement. Used for Regional Sports Network (RSN) blackout rule enforcement, regional sponsorship attribution, and market-level reporting.' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAuthenticated rdf:type rdf:Property ;
    rdfs:label 'Is Authenticated' ;
    rdfs:comment 'Indicates whether the fan was authenticated (logged in) at the time of the engagement event. Authenticated events can be linked to a known fan profile; unauthenticated events are anonymous. Critical for identity resolution and GDPR/CCPA consent enforcement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loyaltyPointsRedeemed rdf:type rdf:Property ;
    rdfs:label 'Loyalty Points Redeemed' ;
    rdfs:comment 'Number of loyalty points consumed by the fan during a loyalty redemption engagement event. Zero for non-redemption events. Used for loyalty liability tracking and redemption rate analytics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referralSource rdf:type rdf:Property ;
    rdfs:label 'Referral Source' ;
    rdfs:comment 'The originating source or campaign that drove the fan to this engagement event (e.g., push notification, email campaign, paid social ad, organic search, direct). Used for Customer Acquisition Cost (CAC) attribution and campaign Return on Investment (ROI) analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialPlatform rdf:type rdf:Property ;
    rdfs:label 'Social Platform' ;
    rdfs:comment 'The social media platform on which a social share engagement event occurred. Nullable for non-social engagement types. Used for social channel performance analytics and influencer attribution. [ENUM-REF-CANDIDATE: twitter|instagram|facebook|tiktok|youtube|snapchat|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administratorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Administrator Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Official fan clubs in sports entertainment are administered by a designated workforce employee (e.g., fan engagement coordinator). HR and fan engagement teams need this link for staff accountability, ' ;
    rdfs:domain ind:Club ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:affiliatedAthleteAthleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Affiliated Athlete Athlete Profile Id' ;
    rdfs:comment 'Reference to the individual athlete this fan club is dedicated to, where the club is athlete-specific rather than team-specific (e.g., a player fan club). Nullable for team-based clubs.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:affiliatedTeamId rdf:type rdf:Property ;
    rdfs:label 'Affiliated Team Id' ;
    rdfs:comment 'Reference to the team or franchise this fan club is primarily associated with. Enables fan club segmentation by team for engagement programs and event access privileges.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Team .

ind:homeVenueId rdf:type rdf:Property ;
    rdfs:label 'Home Venue Id' ;
    rdfs:comment 'Foreign key linking to venue.venue. Business justification: Official fan clubs are affiliated with a specific home venue for event ticket allocation, supporter section management, and venue partnership agreements. Role-prefix \'home_\' matches the business conce' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Venue .

ind:parentClubId rdf:type rdf:Property ;
    rdfs:label 'Parent Club Id' ;
    rdfs:comment 'Self-referencing identifier for the parent fan club when this record represents a regional chapter or sub-chapter of a larger national or international fan club organization. Null for top-level clubs.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Club .

ind:sponsorshipPartnerSponsorId rdf:type rdf:Property ;
    rdfs:label 'Sponsorship Partner Sponsor Id' ;
    rdfs:comment 'Reference to the primary commercial sponsor or brand partner associated with the fan club, enabling co-branded engagement programs and sponsorship ROI (Return on Investment) tracking.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Sponsor .

ind:annualRevenueUsd rdf:type rdf:Property ;
    rdfs:label 'Annual Revenue Usd' ;
    rdfs:comment 'Total annual revenue generated by the fan club from membership dues, merchandise sales, and events in USD. Used for financial planning, EBITDA contribution analysis, and sponsorship valuation. Sourced from SAP S/4HANA FI/CO.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:charterDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Charter Document Ref' ;
    rdfs:comment 'Reference identifier or URL to the fan club\'s official charter, constitution, or founding document stored in the Digital Asset Management (DAM) system. Used for governance and compliance audits.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:city rdf:type rdf:Property ;
    rdfs:label 'City' ;
    rdfs:comment 'City where the fan club is headquartered or primarily based. Used for geographic segmentation, event planning, and chapter assignment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clubCode rdf:type rdf:Property ;
    rdfs:label 'Club Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the fan club, used in CRM systems, ticketing platforms, and member communications (e.g., \'MAN-UTD-OSC-NYC\'). Sourced from Salesforce CRM.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clubName rdf:type rdf:Property ;
    rdfs:label 'Club Name' ;
    rdfs:comment 'Official full name of the fan club as registered with the league or governing body (e.g., \'Manchester United Official Supporters Club – New York Chapter\').' ;
    rdfs:domain ind:Club ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clubStatus rdf:type rdf:Property ;
    rdfs:label 'Club Status' ;
    rdfs:comment 'Current lifecycle status of the fan club. \'active\' = fully operational; \'inactive\' = dormant but not dissolved; \'suspended\' = temporarily restricted by governing body; \'pending_approval\' = awaiting official recognition; \'dissolved\' = permanently closed.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clubType rdf:type rdf:Property ;
    rdfs:label 'Club Type' ;
    rdfs:comment 'Classification of the fan club by its organizational structure and affiliation level. \'official\' = league/team-sanctioned club; \'supporters_trust\' = member-owned democratic body; \'regional_chapter\' = geographic sub-chapter of a parent club; \'booster_club\' = fundraising-oriented; \'fan_society\' = informal affinity group.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crmAccountReference rdf:type rdf:Property ;
    rdfs:label 'Crm Account Reference' ;
    rdfs:comment 'External identifier for the fan club record in Salesforce CRM, enabling bi-directional synchronization between the lakehouse silver layer and the CRM system of record for fan and sponsor relationship management.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentMemberCount rdf:type rdf:Property ;
    rdfs:label 'Current Member Count' ;
    rdfs:comment 'Current total number of active enrolled members in the fan club as of the last refresh. Used for capacity monitoring, reporting, and engagement benchmarking. Not a calculated aggregate — sourced directly from the CRM enrollment system.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dissolutionDate rdf:type rdf:Property ;
    rdfs:label 'Dissolution Date' ;
    rdfs:comment 'The date on which the fan club was officially dissolved or deregistered. Null for active clubs. Used for lifecycle reporting and historical record retention.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventTicketAllocation rdf:type rdf:Property ;
    rdfs:label 'Event Ticket Allocation' ;
    rdfs:comment 'Number of event tickets allocated to the fan club per event or season by the team or venue, enabling priority access for members. Managed in coordination with Ticketmaster/AXS and Archtics inventory systems.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:foundingDate rdf:type rdf:Property ;
    rdfs:label 'Founding Date' ;
    rdfs:comment 'The official date on which the fan club was formally established or chartered. Used for anniversary recognition, eligibility calculations, and historical reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:geographicTerritory rdf:type rdf:Property ;
    rdfs:label 'Geographic Territory' ;
    rdfs:comment 'The defined geographic territory or region in which the fan club operates and recruits members (e.g., \'Northeast USA\', \'Greater London\', \'Southeast Asia\'). Used for regional segmentation and chapter management.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isOfficialPartner rdf:type rdf:Property ;
    rdfs:label 'Is Official Partner' ;
    rdfs:comment 'Indicates whether the fan club holds an official partnership or affiliation agreement with the team, league, or governing body, granting access to official branding, event allocations, and co-marketing programs.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxMembershipCapacity rdf:type rdf:Property ;
    rdfs:label 'Max Membership Capacity' ;
    rdfs:comment 'Maximum number of members the fan club is authorized or operationally designed to accommodate. Null indicates no cap. Used for waitlist management and capacity planning.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:membershipFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Membership Fee Amount' ;
    rdfs:comment 'Standard annual membership fee charged to join the fan club, expressed in the club\'s operating currency. Used for revenue tracking, dues management, and tier pricing analysis.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:membershipFeeCurrency rdf:type rdf:Property ;
    rdfs:label 'Membership Fee Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the membership fee (e.g., \'USD\', \'GBP\', \'EUR\'). Required for multi-currency fan club operations across global markets.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:membershipFeeFrequency rdf:type rdf:Property ;
    rdfs:label 'Membership Fee Frequency' ;
    rdfs:comment 'Billing frequency for the fan club membership fee. Determines renewal cycle and dues collection schedule.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:membershipTierStructure rdf:type rdf:Property ;
    rdfs:label 'Membership Tier Structure' ;
    rdfs:comment 'Describes whether the fan club operates a single uniform membership level or a multi-tier structure with differentiated benefits (e.g., standard, premium, VIP). Drives benefit entitlement logic and dues pricing.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:merchandiseDiscountPct rdf:type rdf:Property ;
    rdfs:label 'Merchandise Discount Pct' ;
    rdfs:comment 'Standard percentage discount on official merchandise offered to fan club members as a membership benefit. Applied at point of sale via Shopify Plus or POS systems.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Preferred Language Code' ;
    rdfs:comment 'IETF BCP 47 language tag representing the primary language used for fan club communications and content delivery (e.g., \'en-US\', \'es-MX\', \'pt-BR\'). Used for localization of member communications and digital content.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySport rdf:type rdf:Property ;
    rdfs:label 'Primary Sport' ;
    rdfs:comment 'The sport that the fan club is primarily associated with (e.g., \'Football\', \'Basketball\', \'Baseball\', \'Soccer\'). Used for cross-sport segmentation and content targeting.' ;
    rdfs:domain ind:Club ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialMediaHandle rdf:type rdf:Property ;
    rdfs:label 'Social Media Handle' ;
    rdfs:comment 'Primary social media handle or username for the fan club\'s official social media presence (e.g., \'@MUSC_NewYork\'). Used for digital engagement tracking and fan community management via Adobe Experience Platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:websiteUrl rdf:type rdf:Property ;
    rdfs:label 'Website Url' ;
    rdfs:comment 'Official website URL for the fan club. Used for digital engagement, member self-service, and fan discovery across the sports entertainment platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Preferred Franchise Id' ;
    rdfs:comment 'Foreign key linking to league.franchise. Business justification: Fan CRM segmentation, personalization engines, and targeted marketing campaigns depend on knowing a fan\'s preferred franchise. Sports-entertainment CRM systems universally store preferred team as a FK' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:accessibilityRequirements rdf:type rdf:Property ;
    rdfs:label 'Accessibility Requirements' ;
    rdfs:comment 'Free-text description of any accessibility needs or disability accommodations required by the fan for venue attendance (e.g., wheelchair access, hearing loop, visual impairment assistance). Used by venue operations to fulfill Americans with Disabilities Act (ADA) obligations.' ;
    rdfs:domain ind:FanProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aepProfileReference rdf:type rdf:Property ;
    rdfs:label 'Aep Profile Reference' ;
    rdfs:comment 'Unified profile identifier assigned by Adobe Experience Platform for fan engagement, personalization, and analytics. Enables cross-channel identity resolution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:birthDate rdf:type rdf:Property ;
    rdfs:label 'Birth Date' ;
    rdfs:comment 'Fan\'s date of birth in ISO 8601 format (yyyy-MM-dd). Used for age verification, age-gated content access, birthday promotions, and demographic segmentation.' ;
    rdfs:domain ind:FanProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:communicationOptInEmail rdf:type rdf:Property ;
    rdfs:label 'Communication Opt In Email' ;
    rdfs:comment 'Indicates whether the fan has provided explicit consent to receive marketing and promotional communications via email. Must be True before any commercial email is sent. Governed by GDPR Article 6 and CAN-SPAM Act.' ;
    rdfs:domain ind:FanProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communicationOptInPush rdf:type rdf:Property ;
    rdfs:label 'Communication Opt In Push' ;
    rdfs:comment 'Indicates whether the fan has consented to receive push notifications via the mobile application. Controls delivery of real-time event alerts, score updates, and personalized offers.' ;
    rdfs:domain ind:FanProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communicationOptInSms rdf:type rdf:Property ;
    rdfs:label 'Communication Opt In Sms' ;
    rdfs:comment 'Indicates whether the fan has provided explicit consent to receive marketing and transactional communications via SMS/text message. Governed by GDPR Article 6 and TCPA regulations.' ;
    rdfs:domain ind:FanProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:countryOfResidenceCode rdf:type rdf:Property ;
    rdfs:label 'Country Of Residence Code' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code for the fan\'s current country of residence. Determines applicable privacy regulations (GDPR for EU residents, CCPA for California residents) and geo-targeted content.' ;
    rdfs:domain ind:FanProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSharingConsent rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Consent' ;
    rdfs:comment 'Indicates whether the fan has consented to sharing their personal data with third-party partners, sponsors, and advertisers. Required for sponsor activation and targeted advertising programs.' ;
    rdfs:domain ind:FanProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:email rdf:type rdf:Property ;
    rdfs:label 'Email' ;
    rdfs:comment 'Primary email address used for all fan communications, account authentication, ticketing confirmations, and CRM outreach. Subject to GDPR and CCPA consent requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanType rdf:type rdf:Property ;
    rdfs:label 'Fan Type' ;
    rdfs:comment 'Classification of the fan account type. Determines applicable business rules, pricing tiers, and service levels. \'family_account\' indicates a parent account with linked sub-profiles. \'vip\' denotes Very Important Person (VIP) status with premium service entitlements.' ;
    rdfs:domain ind:FanProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstName rdf:type rdf:Property ;
    rdfs:label 'First Name' ;
    rdfs:comment 'Legal given name of the fan as captured at registration. Used for personalized communications and identity verification.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gender rdf:type rdf:Property ;
    rdfs:label 'Gender' ;
    rdfs:comment 'Self-reported gender identity of the fan. Used for demographic analytics, personalization, and inclusive marketing. Collected with explicit consent per GDPR and CCPA.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFanClubMember rdf:type rdf:Property ;
    rdfs:label 'Is Fan Club Member' ;
    rdfs:comment 'Indicates whether the fan is an active member of an official fan club. Fan club members receive exclusive content, early ticket access, and community engagement opportunities.' ;
    rdfs:domain ind:FanProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isVipMember rdf:type rdf:Property ;
    rdfs:label 'Is Vip Member' ;
    rdfs:comment 'Indicates whether the fan holds active Very Important Person (VIP) membership status, entitling them to premium hospitality, backstage access, and dedicated concierge services.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastEngagementDate rdf:type rdf:Property ;
    rdfs:label 'Last Engagement Date' ;
    rdfs:comment 'Date of the fan\'s most recent engagement activity across any channel (ticket purchase, content view, merchandise order, event attendance, app interaction). Used for recency scoring in CRM segmentation and churn risk models.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastName rdf:type rdf:Property ;
    rdfs:label 'Last Name' ;
    rdfs:comment 'Legal family name or surname of the fan as captured at registration. Used in combination with first_name for full identity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loyaltyEnrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Loyalty Enrollment Date' ;
    rdfs:comment 'Date on which the fan enrolled in the loyalty program. Used to calculate program tenure, anniversary rewards, and cohort-based retention analytics.' ;
    rdfs:domain ind:FanProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:phone rdf:type rdf:Property ;
    rdfs:label 'Phone' ;
    rdfs:comment 'Primary mobile or landline phone number for the fan in E.164 international format. Used for SMS notifications, two-factor authentication, and event alerts.' ;
    rdfs:domain ind:FanProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postalCode rdf:type rdf:Property ;
    rdfs:label 'Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the fan\'s primary residence. Used for geographic market segmentation, venue proximity analysis, regional sponsorship targeting, and local event promotion.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredSport rdf:type rdf:Property ;
    rdfs:label 'Preferred Sport' ;
    rdfs:comment 'The sport or sports property the fan most closely identifies with (e.g., \'NFL Football\', \'NBA Basketball\', \'MLS Soccer\', \'UFC\'). Used for content personalization, targeted promotions, and event recommendations. Free-text to accommodate multi-sport organizations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryEmail rdf:type rdf:Property ;
    rdfs:label 'Secondary Email' ;
    rdfs:comment 'Alternate email address for the fan, used as a fallback contact channel or for family account management. Subject to the same consent requirements as the primary email.' ;
    rdfs:domain ind:FanProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:householdId rdf:type rdf:Property ;
    rdfs:label 'Household Id' ;
    rdfs:comment 'Unique surrogate identifier for the household record in the fan domain. Primary key for the household data product. Entity role: MASTER_PARTY — represents a family/household unit that the business interacts with as a B2C counterparty.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:householdFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Household Fan Profile Id' ;
    rdfs:comment 'Reference to the primary account holder fan profile within this household. The designated head-of-household fan who holds primary contractual and billing responsibility. Used for season ticket holder family accounts and loyalty aggregation. PARTY_REFERENCE category.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:mergedIntoHouseholdId rdf:type rdf:Property ;
    rdfs:label 'Merged Into Household Id' ;
    rdfs:comment 'If this household record was merged into another household (status = \'merged\'), this field references the surviving household_id. Enables data lineage tracking and ensures historical records can be traced to the canonical household.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Household .

ind:primaryFanFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Primary Fan Fan Profile Id' ;
    rdfs:comment 'Reference to the primary account holder fan profile within this household. The designated head-of-household fan who holds primary contractual and billing responsibility. Used for season ticket holder family accounts and loyalty aggregation. PARTY_REFERENCE category.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:acquisitionDate rdf:type rdf:Property ;
    rdfs:label 'Acquisition Date' ;
    rdfs:comment 'Date on which the household was first established as a fan relationship record. Used for cohort analysis, tenure-based loyalty calculations, and LTV (Lifetime Value) trajectory modeling.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line1' ;
    rdfs:comment 'Primary street address line for the household. Used for direct mail campaigns, season ticket holder correspondence, merchandise shipping, and deduplication of household records. Critical for direct mail deduplication per product description.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line2' ;
    rdfs:comment 'Secondary address line for the household (apartment, suite, unit number). Supplements address_line1 for complete postal address resolution and direct mail accuracy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualSpendUsd rdf:type rdf:Property ;
    rdfs:label 'Annual Spend Usd' ;
    rdfs:comment 'Total spend in US dollars attributed to the household across all revenue streams (ticketing, merchandise, concessions, streaming) in the current or most recent fiscal year. Sourced from SAP S/4HANA FI. Used for household-level revenue reporting and tier qualification.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:combinedLtvUsd rdf:type rdf:Property ;
    rdfs:label 'Combined Ltv Usd' ;
    rdfs:comment 'Aggregated Lifetime Value (LTV) in US dollars across all fan members within the household, sourced from SAP S/4HANA SD and Ticketmaster transaction history. Represents total cumulative revenue attributed to the household. Used for household-level spend analysis, VIP qualification, and retention investment prioritization. Note: this is a sourced/loaded value from the operational system, not a real-time calculation.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataEnrichmentSource rdf:type rdf:Property ;
    rdfs:label 'Data Enrichment Source' ;
    rdfs:comment 'Indicates the origin of demographic and enrichment data for this household record. \'self_reported\' means data was provided directly by the household; \'third_party\' means sourced from a data provider; \'inferred\' means derived from behavioral signals; \'crm_import\' means loaded from Salesforce CRM; \'combined\' means multiple sources merged.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deduplicationKey rdf:type rdf:Property ;
    rdfs:label 'Deduplication Key' ;
    rdfs:comment 'Composite hash or normalized key used for direct mail deduplication and household matching across source systems. Typically derived from a normalized combination of household name, address, and postal code. Critical for preventing duplicate mailings and double-counting in household-level spend analysis.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:householdName rdf:type rdf:Property ;
    rdfs:label 'Household Name' ;
    rdfs:comment 'Human-readable display name for the household unit, typically the family surname or a chosen household label (e.g., \'The Johnson Family\'). Used in direct mail, CRM correspondence, and fan engagement communications. IDENTITY_LABEL category per MASTER_PARTY role.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:householdStatus rdf:type rdf:Property ;
    rdfs:label 'Household Status' ;
    rdfs:comment 'Current lifecycle state of the household record. \'active\' indicates an engaged household with at least one active fan member. \'merged\' indicates the household was consolidated into another. \'deceased\' indicates all primary members are deceased. LIFECYCLE_STATUS category per MASTER_PARTY role.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:householdType rdf:type rdf:Property ;
    rdfs:label 'Household Type' ;
    rdfs:comment 'Classification of the household composition. \'family\' denotes a multi-generational unit; \'couple\' denotes a two-adult unit; \'individual\' denotes a single-person household; \'corporate\' denotes a business account grouped as a household; \'fan_club\' denotes an organized fan club treated as a household unit. CLASSIFICATION_OR_TYPE category per MASTER_PARTY role.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incomeBand rdf:type rdf:Property ;
    rdfs:label 'Income Band' ;
    rdfs:comment 'Estimated annual household income range derived from third-party demographic enrichment or self-reported data. Used for premium product targeting (VIP packages, luxury suites, premium season tickets), sponsorship audience profiling, and household-level spend propensity modeling.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketingOptInFlag rdf:type rdf:Property ;
    rdfs:label 'Marketing Opt In Flag' ;
    rdfs:comment 'Indicates whether the household has opted in to receive marketing communications across all channels. Distinct from GDPR consent (which is jurisdiction-specific); this is the operational marketing suppression flag used by Salesforce CRM and Adobe Experience Platform campaign tools.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberCount rdf:type rdf:Property ;
    rdfs:label 'Member Count' ;
    rdfs:comment 'Total number of individual fan profiles currently associated with this household. Used for family ticket package eligibility, loyalty tier aggregation, and household-level capacity planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preferredCommunicationChannel rdf:type rdf:Property ;
    rdfs:label 'Preferred Communication Channel' ;
    rdfs:comment 'Household\'s preferred channel for receiving marketing and operational communications. Drives outbound campaign channel selection in Salesforce CRM and Adobe Experience Platform to maximize engagement and respect household preferences.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredLanguage rdf:type rdf:Property ;
    rdfs:label 'Preferred Language' ;
    rdfs:comment 'BCP 47 language tag representing the household\'s preferred language for communications and digital content (e.g., \'en\', \'es\', \'fr\', \'pt-BR\'). Supports multilingual fan engagement across global markets.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentCode rdf:type rdf:Property ;
    rdfs:label 'Segment Code' ;
    rdfs:comment 'CRM-assigned segmentation code classifying the household into a strategic fan segment (e.g., \'SUPER_FAN\', \'CASUAL_ATTENDEE\', \'LAPSED\', \'HIGH_VALUE\'). Drives targeted marketing campaigns, loyalty tier assignment, and personalization strategies via Adobe Experience Platform. [ENUM-REF-CANDIDATE: promote to reference product as segment codes are business-defined and numerous]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateProvince rdf:type rdf:Property ;
    rdfs:label 'State Province' ;
    rdfs:comment 'State or province of the household\'s primary mailing address. Used for regional compliance (CCPA for California households), tax jurisdiction determination, and geographic fan base analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loyaltyEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Loyalty Enrollment Id' ;
    rdfs:comment 'Unique surrogate identifier for a fan\'s enrollment record in a specific loyalty program. Primary key for this entity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LoyaltyEnrollment .

ind:homeTeamId rdf:type rdf:Property ;
    rdfs:label 'Home Team Id' ;
    rdfs:comment 'Reference to the fan\'s primary affiliated team within the loyalty program context. Used to route team-specific rewards, communications, and event access offers.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Team .

ind:primaryLoyaltyFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Primary Loyalty Fan Profile Id' ;
    rdfs:comment 'Reference to the fan profile record representing the individual enrolled in the loyalty program. Sourced from Salesforce CRM fan master.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:ccpaOptOut rdf:type rdf:Property ;
    rdfs:label 'Ccpa Opt Out' ;
    rdfs:comment 'Indicates whether the fan has exercised their California Consumer Privacy Act (CCPA) right to opt out of the sale or sharing of their personal data associated with this loyalty enrollment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:currentPointsBalance rdf:type rdf:Property ;
    rdfs:label 'Current Points Balance' ;
    rdfs:comment 'The fan\'s current redeemable points balance available for redemption against rewards, merchandise, tickets, or experiences. Reflects earned points minus redeemed and expired points.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:currentTier rdf:type rdf:Property ;
    rdfs:label 'Current Tier' ;
    rdfs:comment 'The fan\'s current membership tier within the loyalty program (e.g., Bronze, Silver, Gold, Platinum, Diamond). Tier determines reward multipliers, exclusive access rights, and benefit eligibility. [ENUM-REF-CANDIDATE: Bronze|Silver|Gold|Platinum|Diamond — promote to reference product if tiers vary by program]' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Date' ;
    rdfs:comment 'Calendar date on which the fan formally enrolled in the loyalty program. Used as the anchor date for anniversary-based rewards, tenure calculations, and cohort analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentNumber rdf:type rdf:Property ;
    rdfs:label 'Enrollment Number' ;
    rdfs:comment 'Externally visible alphanumeric reference code assigned to this enrollment at the time of registration. Used on fan-facing communications, membership cards, and CRM lookups. Format: LYL- followed by 8–16 alphanumeric characters.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentStatus rdf:type rdf:Property ;
    rdfs:label 'Enrollment Status' ;
    rdfs:comment 'Current lifecycle state of the fan\'s enrollment in the loyalty program. \'active\' indicates the fan is in good standing and accruing/redeeming points; \'suspended\' indicates a temporary hold; \'terminated\' indicates the enrollment has been permanently closed; \'pending\' indicates awaiting verification; \'expired\' indicates the enrollment lapsed due to inactivity or tier expiry.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Enrollment Timestamp' ;
    rdfs:comment 'Precise date and time (with timezone offset) at which the fan\'s enrollment was recorded in the source system. Supports intraday analytics and audit trail requirements.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fanClubMember rdf:type rdf:Property ;
    rdfs:label 'Fan Club Member' ;
    rdfs:comment 'Indicates whether the fan is also a registered fan club member in conjunction with this loyalty enrollment. Fan club membership may confer additional points multipliers or exclusive content access.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gdprConsentGiven rdf:type rdf:Property ;
    rdfs:label 'Gdpr Consent Given' ;
    rdfs:comment 'Indicates whether the fan has provided explicit GDPR-compliant consent for the processing of their personal data in connection with this loyalty enrollment. Mandatory for fans in EU jurisdictions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryEnrollment rdf:type rdf:Property ;
    rdfs:label 'Is Primary Enrollment' ;
    rdfs:comment 'Indicates whether this enrollment is the fan\'s primary or preferred loyalty program when the fan holds multiple enrollments. Used for default display, primary benefit application, and CRM segmentation.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lifetimePointsEarned rdf:type rdf:Property ;
    rdfs:label 'Lifetime Points Earned' ;
    rdfs:comment 'Cumulative total of all loyalty points earned by the fan since enrollment inception, regardless of redemptions or expirations. Used as a long-term engagement metric and for Lifetime Value (LTV) analysis.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:membershipCardIssuedDate rdf:type rdf:Property ;
    rdfs:label 'Membership Card Issued Date' ;
    rdfs:comment 'The date on which the loyalty membership card (physical or digital) was issued to the fan. Used for card lifecycle management and replacement tracking.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextTierPointsRequired rdf:type rdf:Property ;
    rdfs:label 'Next Tier Points Required' ;
    rdfs:comment 'Number of additional qualifying points the fan needs to earn to reach the next loyalty tier. Supports personalized upgrade progress communications and fan engagement nudges.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pointsCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Points Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code representing the monetary currency associated with points valuation for programs that peg points to a currency equivalent (e.g., USD, GBP, EUR). Null for pure point-based programs with no currency peg.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointsExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Points Expiry Date' ;
    rdfs:comment 'The date on which the fan\'s current redeemable points balance will expire if not redeemed. Used to trigger expiry warning communications and drive redemption activity.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:preferredRewardCategory rdf:type rdf:Property ;
    rdfs:label 'Preferred Reward Category' ;
    rdfs:comment 'The fan\'s stated or inferred preferred category for loyalty reward redemption (e.g., tickets, merchandise, experiences). Used for personalized reward recommendations and program design analytics.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousTier rdf:type rdf:Property ;
    rdfs:label 'Previous Tier' ;
    rdfs:comment 'The fan\'s loyalty tier immediately prior to the most recent tier change. Used for win-back campaigns, downgrade communications, and tier transition analytics.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonTicketHolder rdf:type rdf:Property ;
    rdfs:label 'Season Ticket Holder' ;
    rdfs:comment 'Indicates whether the fan enrolled in this loyalty program is also a season ticket holder. Season ticket holders typically receive enhanced tier benefits and accelerated points earning rates.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tierChangeReason rdf:type rdf:Property ;
    rdfs:label 'Tier Change Reason' ;
    rdfs:comment 'The business reason for the most recent change to the fan\'s loyalty tier. Supports audit trails, fan communications, and program governance reporting.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Tier Expiry Date' ;
    rdfs:comment 'The date on which the fan\'s current tier status expires if qualifying activity thresholds are not maintained. After this date, the fan may be downgraded to a lower tier per program rules.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tierQualificationDate rdf:type rdf:Property ;
    rdfs:label 'Tier Qualification Date' ;
    rdfs:comment 'The date on which the fan qualified for their current loyalty tier. Used to determine tier anniversary, tier protection windows, and downgrade eligibility assessments.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tierQualifyingPointsYtd rdf:type rdf:Property ;
    rdfs:label 'Tier Qualifying Points Ytd' ;
    rdfs:comment 'Points accumulated within the current qualification period (typically a rolling 12-month or calendar year window) that count toward tier maintenance or upgrade thresholds. Distinct from redeemable balance.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vipStatus rdf:type rdf:Property ;
    rdfs:label 'Vip Status' ;
    rdfs:comment 'Indicates whether the fan holds Very Important Person (VIP) designation within this loyalty enrollment, granting access to premium experiences, hospitality suites, and exclusive events.' ;
    rdfs:domain ind:LoyaltyEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accessTierRequired rdf:type rdf:Property ;
    rdfs:label 'Access Tier Required' ;
    rdfs:comment 'The minimum membership tier within the loyalty program that a fan must hold in order to access this content asset. Belongs to the entitlement, not to the program or asset alone, because the same asset may require different tiers under different programs.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crmProgramReference rdf:type rdf:Property ;
    rdfs:label 'Crm Program Reference' ;
    rdfs:comment 'External identifier for this loyalty program as recorded in Salesforce CRM. Used for cross-system reconciliation between the lakehouse Silver layer and the Salesforce CRM operational system of record. Enables audit traceability back to the source system.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currencyName rdf:type rdf:Property ;
    rdfs:label 'Currency Name' ;
    rdfs:comment 'Branded name of the loyalty currency unit used within this program (e.g., \'Fan Points\', \'Arena Credits\', \'Court Cash\', \'Ice Coins\'). Displayed to fans in all engagement touchpoints and digital wallet interfaces.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currencySymbol rdf:type rdf:Property ;
    rdfs:label 'Currency Symbol' ;
    rdfs:comment 'Short symbol or abbreviation representing the loyalty currency in UI displays and statements (e.g., \'FP\', \'AC\', \'pts\'). Used in fan-facing digital platforms and printed membership materials.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalWalletEnabled rdf:type rdf:Property ;
    rdfs:label 'Digital Wallet Enabled' ;
    rdfs:comment 'Indicates whether loyalty currency balances for this program are accessible via a digital wallet interface in the fan mobile app or OTT platform. Drives integration with Adobe Experience Platform digital wallet features and DTC fan engagement flows.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:earningPeriodType rdf:type rdf:Property ;
    rdfs:label 'Earning Period Type' ;
    rdfs:comment 'Defines the time window used for the max_earning_per_period cap. Season aligns with the sports league calendar; calendar_year resets on January 1; rolling_12_months is a continuous window; monthly resets each calendar month.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earningRulesSummary rdf:type rdf:Property ;
    rdfs:label 'Earning Rules Summary' ;
    rdfs:comment 'Human-readable summary of the rules governing how fans earn loyalty currency (e.g., \'1 point per $1 spent on tickets; 2x points on merchandise; 5x points on PPV purchases\'). Operational detail is managed in the loyalty_earning_rule reference product; this field provides a concise program-level description for reporting and fan communications.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusiveWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Exclusive Window End' ;
    rdfs:comment 'Calendar date on which the exclusivity period for this content asset under this loyalty program ends. After this date the asset may become available more broadly or under other programs.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusiveWindowStart rdf:type rdf:Property ;
    rdfs:label 'Exclusive Window Start' ;
    rdfs:comment 'Calendar date on which this content asset becomes exclusively available to members of this loyalty program. Defines the start of the exclusivity period during which the asset is gated to this program\'s members only.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isAutoEnroll rdf:type rdf:Property ;
    rdfs:label 'Is Auto Enroll' ;
    rdfs:comment 'Indicates whether fans are automatically enrolled in this program upon meeting eligibility criteria (e.g., purchasing a season ticket or subscribing to an OTT streaming service) without requiring an explicit opt-in action. True = automatic enrollment; False = explicit opt-in required.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPaidMembership rdf:type rdf:Property ;
    rdfs:label 'Is Paid Membership' ;
    rdfs:comment 'Indicates whether enrollment in this loyalty program requires a recurring or one-time membership fee. True = fee-based program (e.g., premium fan club subscription); False = free-to-join program. Drives billing integration with SAP S/4HANA SD module.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:launchMarket rdf:type rdf:Property ;
    rdfs:label 'Launch Market' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the primary market in which this loyalty program was launched (e.g., \'USA\', \'GBR\', \'CAN\', \'AUS\'). Used for regulatory compliance scoping, market performance reporting, and multi-market program governance.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loyaltyProgramStatus rdf:type rdf:Property ;
    rdfs:label 'Loyalty Program Status' ;
    rdfs:comment 'Current lifecycle state of the loyalty program. Active programs accept new enrollments and transactions; draft programs are in design/approval; suspended programs are temporarily halted; retired programs are closed to new activity but historical records are preserved.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxEarningPerPeriod rdf:type rdf:Property ;
    rdfs:label 'Max Earning Per Period' ;
    rdfs:comment 'Cap on the total loyalty currency units a fan can earn within a defined period (e.g., per season, per calendar year). Controls program financial liability and prevents gaming. Null if no periodic earning cap is defined.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxEarningPerTransaction rdf:type rdf:Property ;
    rdfs:label 'Max Earning Per Transaction' ;
    rdfs:comment 'Cap on the number of loyalty currency units a fan can earn from a single transaction (e.g., ticket purchase, merchandise order, PPV event). Prevents abuse and controls program liability. Null if no per-transaction cap is defined.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:merchandiseRedemptionEnabled rdf:type rdf:Property ;
    rdfs:label 'Merchandise Redemption Enabled' ;
    rdfs:comment 'Indicates whether fans can redeem loyalty currency for merchandise purchases through the Shopify Plus e-commerce platform. When True, the program is integrated with Shopify Plus SKU catalog for redemption workflows.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minRedemptionThreshold rdf:type rdf:Property ;
    rdfs:label 'Min Redemption Threshold' ;
    rdfs:comment 'Minimum accumulated loyalty currency balance required before a fan is eligible to redeem points or credits. Prevents micro-redemptions and controls operational overhead (e.g., minimum 500 Fan Points before redemption is permitted).' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:npsTrackingEnabled rdf:type rdf:Property ;
    rdfs:label 'Nps Tracking Enabled' ;
    rdfs:comment 'Indicates whether Net Promoter Score (NPS) surveys are triggered for fans enrolled in this loyalty program. When True, NPS survey workflows are activated in Adobe Experience Platform following key engagement events such as event attendance or redemption.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partnerProgramFlag rdf:type rdf:Property ;
    rdfs:label 'Partner Program Flag' ;
    rdfs:comment 'Indicates whether this loyalty program is operated in partnership with an external sponsor or coalition partner (e.g., co-branded credit card loyalty, airline miles partner, retail partner). True = partner-operated or co-branded; False = wholly owned by Sports Entertainment.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pointsCost rdf:type rdf:Property ;
    rdfs:label 'Points Cost' ;
    rdfs:comment 'Number of loyalty currency units a fan must spend to unlock access to this content asset under this specific loyalty program. Belongs to the entitlement because the same asset may carry different points costs across different programs.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pointsExpiryPolicy rdf:type rdf:Property ;
    rdfs:label 'Points Expiry Policy' ;
    rdfs:comment 'Policy governing when accumulated loyalty currency expires for enrolled fans. Rolling policies expire points a fixed period after earning; annual_reset clears balances at a calendar year boundary; event_based expiry ties to specific events such as season end; no_expiry means points never expire.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppvEarningEnabled rdf:type rdf:Property ;
    rdfs:label 'Ppv Earning Enabled' ;
    rdfs:comment 'Indicates whether fans earn loyalty currency on Pay-Per-View (PPV) broadcast purchases. When True, PPV transactions from the broadcast platform are eligible for loyalty point accrual, driving cross-domain fan engagement between broadcast and loyalty.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:programCode rdf:type rdf:Property ;
    rdfs:label 'Program Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the loyalty program used in CRM, ticketing, and digital platform integrations (e.g., \'NBA_FANPTS_2024\', \'ARENA_CREDITS_VIP\'). Sourced from Salesforce CRM program catalog.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programDescription rdf:type rdf:Property ;
    rdfs:label 'Program Description' ;
    rdfs:comment 'Full marketing and operational description of the loyalty program including its value proposition, target fan segment, and key benefits. Used in Adobe Experience Platform content personalization, CRM campaign materials, and fan-facing digital platforms.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programName rdf:type rdf:Property ;
    rdfs:label 'Program Name' ;
    rdfs:comment 'Human-readable marketing name of the loyalty program as displayed to fans across all channels (e.g., \'Fan Points Rewards\', \'Arena Credits Club\', \'Season Ticket Holder Elite\'). Used in Adobe Experience Platform personalization and fan-facing communications.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programType rdf:type rdf:Property ;
    rdfs:label 'Program Type' ;
    rdfs:comment 'Classification of the loyalty program structure. Points-based programs award redeemable points per transaction; tier-based programs unlock benefits at spend thresholds; hybrid combines both; subscription requires recurring fee; coalition programs span multiple partner brands.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programVersion rdf:type rdf:Property ;
    rdfs:label 'Program Version' ;
    rdfs:comment 'Integer version number tracking major structural changes to the loyalty program rules, tier definitions, or earning/redemption rates. Incremented when program terms materially change. Supports historical analysis of program evolution and fan communication of rule changes.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:redemptionCount rdf:type rdf:Property ;
    rdfs:label 'Redemption Count' ;
    rdfs:comment 'Running count of the number of times fans have redeemed this specific program-asset entitlement. Belongs to the entitlement record as an operational metric tracking demand for this content under this program.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:redemptionRate rdf:type rdf:Property ;
    rdfs:label 'Redemption Rate' ;
    rdfs:comment 'Monetary value of one loyalty currency unit when redeemed (e.g., 0.01 means 1 Fan Point = $0.01 USD). Used to calculate redemption value in fan-facing statements and in SAP S/4HANA FI liability accounting for outstanding points balances.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:redemptionRulesSummary rdf:type rdf:Property ;
    rdfs:label 'Redemption Rules Summary' ;
    rdfs:comment 'Human-readable summary of the rules governing how fans redeem accumulated loyalty currency (e.g., \'100 points = $1 off ticket purchase; minimum 500 points to redeem; valid on GA and VIP tickets\'). Operational detail is managed in the loyalty_redemption_rule reference product.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketRedemptionEnabled rdf:type rdf:Property ;
    rdfs:label 'Ticket Redemption Enabled' ;
    rdfs:comment 'Indicates whether fans can redeem loyalty currency toward ticket purchases or upgrades through Ticketmaster/AXS or Archtics. When True, the program is integrated with the ticketing platform redemption API.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tierCount rdf:type rdf:Property ;
    rdfs:label 'Tier Count' ;
    rdfs:comment 'Number of distinct membership tiers defined within this loyalty program (e.g., 3 for Bronze/Silver/Gold; 4 for Standard/Plus/Elite/VIP). Applicable for tier_based and hybrid program types. Zero or null for pure points-based programs with no tier structure.' ;
    rdfs:domain ind:LoyaltyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:loyaltyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Loyalty Transaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each loyalty point transaction record in the ledger. Primary key for the loyalty_transaction data product.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:membershipTierId rdf:type rdf:Property ;
    rdfs:label 'Membership Tier Id' ;
    rdfs:comment 'Reference to the fan\'s loyalty membership tier at the time of this transaction (e.g., Bronze, Silver, Gold, Platinum, VIP). Captures the tier context for point multiplier application and tier-based benefit eligibility at the time of the event.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MembershipTier .

ind:npsSurveyId rdf:type rdf:Property ;
    rdfs:label 'Nps Survey Id' ;
    rdfs:comment 'Reference to an NPS survey completion event that triggered this loyalty transaction, if the activity_type is \'survey_completion\'. Null for all other activity types. Links loyalty incentivization to fan satisfaction measurement programs.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NpsSurvey .

ind:reversalOfTransactionLoyaltyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Reversal Of Transaction Loyalty Transaction Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the original loyalty transaction that this record reverses or corrects. Null for original transactions. Enables full audit chain reconstruction for reversed or adjusted point movements.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LoyaltyTransaction .

ind:rewardId rdf:type rdf:Property ;
    rdfs:label 'Reward Id' ;
    rdfs:comment 'Reference to the specific reward catalog item redeemed in this transaction. Populated only for redemption-type transactions. Enables reward popularity analytics and redemption rate reporting.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Reward .

ind:transferTargetFanFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Transfer Target Fan Fan Profile Id' ;
    rdfs:comment 'For transfer-type transactions, the fan profile ID of the recipient who receives the transferred points. Null for all non-transfer transaction types. Supports family account and fan-to-fan transfer tracking.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:activityChannel rdf:type rdf:Property ;
    rdfs:label 'Activity Channel' ;
    rdfs:comment 'The engagement channel through which the triggering activity was performed. Distinguishes between mobile app, web portal, venue Point of Sale (POS) terminal, call center, or partner system. Supports omnichannel loyalty analytics and channel attribution.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityType rdf:type rdf:Property ;
    rdfs:label 'Activity Type' ;
    rdfs:comment 'The specific fan activity that triggered this loyalty transaction. Identifies the business action that caused the point movement, enabling activity-level analytics and program ROI measurement. [ENUM-REF-CANDIDATE: ticket_purchase|merchandise_purchase|event_check_in|content_view|referral|social_share|survey_completion|app_login|ppv_purchase|subscription_renewal — promote to reference product]' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:basePointsAmount rdf:type rdf:Property ;
    rdfs:label 'Base Points Amount' ;
    rdfs:comment 'The raw points amount calculated before any multiplier, bonus, or promotional adjustment is applied. Together with points_multiplier and points_amount, provides a full audit trail of the points calculation logic.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gdprConsentVerified rdf:type rdf:Property ;
    rdfs:label 'Gdpr Consent Verified' ;
    rdfs:comment 'Indicates whether the fan\'s GDPR consent for loyalty data processing was verified as active at the time of this transaction. True = consent confirmed; False = consent not confirmed or withdrawn. Critical for EU market compliance and data processing lawfulness.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isBonusTransaction rdf:type rdf:Property ;
    rdfs:label 'Is Bonus Transaction' ;
    rdfs:comment 'Indicates whether this transaction represents a bonus points award outside of the standard earn rate (e.g., birthday bonus, milestone bonus, welcome bonus, special event bonus). True = bonus transaction; False = standard transaction. Supports bonus program analytics and cost tracking.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTierQualifying rdf:type rdf:Property ;
    rdfs:label 'Is Tier Qualifying' ;
    rdfs:comment 'Indicates whether the points from this transaction count toward the fan\'s tier qualification threshold (some programs separate qualifying points from total points). True = counts toward tier qualification; False = does not count (e.g., bonus or promotional points). Supports tier progression analytics.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:monetaryValue rdf:type rdf:Property ;
    rdfs:label 'Monetary Value' ;
    rdfs:comment 'The monetary spend amount (in the operating currency) associated with the triggering activity for this transaction. Used to calculate earn rates (points per dollar spent) and to measure the financial value of loyalty-driving purchases. Applicable for purchase-triggered transactions.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pointsAmount rdf:type rdf:Property ;
    rdfs:label 'Points Amount' ;
    rdfs:comment 'The number of loyalty points earned, redeemed, adjusted, expired, or transferred in this transaction. Positive values represent points added to the balance; negative values represent points deducted. Decimal precision supports fractional point awards from multiplier promotions.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pointsBalanceAfter rdf:type rdf:Property ;
    rdfs:label 'Points Balance After' ;
    rdfs:comment 'The fan\'s total loyalty point balance immediately after this transaction was applied. Provides a running ledger balance for audit trail purposes and enables point balance reconstruction at any point in time without aggregation.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pointsMultiplier rdf:type rdf:Property ;
    rdfs:label 'Points Multiplier' ;
    rdfs:comment 'The multiplier factor applied to the base points calculation for this transaction, driven by membership tier, active promotions, or special event bonuses. A value of 1.00 indicates no multiplier; 2.00 indicates double points. Supports audit of why a fan received a specific points amount.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:processingDate rdf:type rdf:Property ;
    rdfs:label 'Processing Date' ;
    rdfs:comment 'The calendar date on which the loyalty transaction was processed and applied to the fan\'s balance by the loyalty management system. May differ from transaction_timestamp for batch-processed or delayed-confirmation transactions (e.g., post-event check-in reconciliation).' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:redemptionValue rdf:type rdf:Property ;
    rdfs:label 'Redemption Value' ;
    rdfs:comment 'The monetary equivalent value of the points redeemed in this transaction, expressed in the operating currency. Populated only for redemption-type transactions. Used for loyalty liability accounting, reward cost tracking, and EBITDA impact analysis.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reversalReason rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason' ;
    rdfs:comment 'Free-text or coded explanation for why a transaction was reversed or adjusted. Populated only when transaction_status is \'reversed\' or transaction_type is \'adjust\'. Supports audit compliance and customer service resolution tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Reference' ;
    rdfs:comment 'The native transaction identifier from the originating source system (e.g., Ticketmaster order number, Shopify order ID, SAP document number). Enables cross-system reconciliation and traceability back to the system of record.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierQualifyingPoints rdf:type rdf:Property ;
    rdfs:label 'Tier Qualifying Points' ;
    rdfs:comment 'The number of points from this transaction that count specifically toward the fan\'s tier qualification balance, which may differ from the total points_amount when bonus or promotional points are excluded from tier calculations.' ;
    rdfs:domain ind:LoyaltyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionStatus rdf:type rdf:Property ;
    rdfs:label 'Transaction Status' ;
    rdfs:comment 'Current workflow state of the loyalty transaction. Pending indicates awaiting confirmation from the triggering system; confirmed indicates points have been applied to the balance; reversed indicates a corrective rollback; failed indicates a processing error; cancelled indicates voided before application.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transaction Timestamp' ;
    rdfs:comment 'The precise date and time at which the loyalty point event occurred in the real world (e.g., when the ticket was purchased, when the check-in was recorded, when the content was viewed). This is the principal business event time, distinct from record audit timestamps.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:membershipId rdf:type rdf:Property ;
    rdfs:label 'Membership Id' ;
    rdfs:comment 'Unique system-generated surrogate key identifying a fan membership record. Primary key for the membership data product within the fan domain.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Membership .

ind:assignedSeatId rdf:type rdf:Property ;
    rdfs:label 'Assigned Seat Id' ;
    rdfs:comment 'Foreign key linking to venue.seat. Business justification: Season ticket membership management requires tracking the specific assigned seat for each member — core to seat manifest reconciliation, ADA compliance reporting, and renewal/relocation workflows. Rol' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Seat .

ind:benefitPackageId rdf:type rdf:Property ;
    rdfs:label 'Benefit Package Id' ;
    rdfs:comment 'Reference to the standardized benefit package definition assigned to this membership, specifying the bundle of entitlements (priority ticketing, parking, merchandise discount, VIP lounge, meet-and-greet, exclusive content). Separates the benefit catalog from the individual membership record.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BenefitPackage .

ind:corporateAccountId rdf:type rdf:Property ;
    rdfs:label 'Corporate Account Id' ;
    rdfs:comment 'Reference to the corporate account record in Salesforce CRM when is_corporate is True. Links individual membership seats to the parent corporate purchaser for consolidated billing and reporting.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:familyAccountId rdf:type rdf:Property ;
    rdfs:label 'Family Account Id' ;
    rdfs:comment 'Reference to the family account grouping record when this membership is part of a family plan. Enables consolidated family membership management, shared benefit pools, and family-level reporting.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:salesRepEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Sales Rep Employee Id' ;
    rdfs:comment 'Reference to the internal sales representative or account manager in Salesforce CRM who sold or manages this membership. Used for commission tracking and sales performance reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accessTier rdf:type rdf:Property ;
    rdfs:label 'Access Tier' ;
    rdfs:comment 'The tier level at which this membership is permitted to access the zone. Determines the scope of privileges within the zone (e.g., a VIP membership may have a higher access tier than a standard season ticket in the same zone). Belongs to the grant, not to the membership or zone alone.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoRenewFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renew Flag' ;
    rdfs:comment 'Indicates whether the membership is configured to automatically renew at the end of the current term without requiring explicit fan action. Drives automated billing cycles in SAP S/4HANA FI and renewal notifications in Adobe Experience Platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:credentialType rdf:type rdf:Property ;
    rdfs:label 'Credential Type' ;
    rdfs:comment 'The credential format required to exercise this specific zone access grant for this membership. May differ from the zone\'s default credential_type_required when a membership tier is granted an override credential method. Belongs to the grant, not to the zone alone.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusiveContentFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusive Content Flag' ;
    rdfs:comment 'Indicates whether this membership grants access to exclusive digital content (behind-the-scenes footage, member-only streams, editorial content) via OTT (Over-The-Top Streaming) or DTC (Direct-To-Consumer) platforms.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fee rdf:type rdf:Property ;
    rdfs:label 'Fee' ;
    rdfs:comment 'Gross fee amount charged to the fan for the membership per payment frequency cycle, in the operating currency. Represents the contractual price before any discounts or waivers. Used in revenue recognition and EBITDA reporting.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grantStatus rdf:type rdf:Property ;
    rdfs:label 'Grant Status' ;
    rdfs:comment 'Current lifecycle status of this zone access grant. Allows individual membership-zone permissions to be suspended or revoked independently of the membership status or zone status — e.g., revoking field-level access for a member under investigation without cancelling their full membership.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCorporate rdf:type rdf:Property ;
    rdfs:label 'Is Corporate' ;
    rdfs:comment 'Indicates whether this membership is held under a corporate account (B2B) rather than an individual fan (B2C). Corporate memberships may have different billing, benefit allocation, and compliance requirements.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isVip rdf:type rdf:Property ;
    rdfs:label 'Is Vip' ;
    rdfs:comment 'Indicates whether this membership grants VIP (Very Important Person) status, entitling the fan to premium hospitality, lounge access, and priority services. Distinct from membership_tier — a flag used operationally for real-time access control at venues.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loungeAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Lounge Access Flag' ;
    rdfs:comment 'Indicates whether this membership grants access to VIP (Very Important Person) lounge facilities at the venue. Operationally consumed by Ticketmaster/AXS access control and venue operations teams.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meetGreetAllotment rdf:type rdf:Property ;
    rdfs:label 'Meet Greet Allotment' ;
    rdfs:comment 'Number of meet-and-greet experiences allocated to this membership per season or membership term. Zero indicates no meet-and-greet benefit. Used for experience inventory management and fan engagement reporting.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:netFee rdf:type rdf:Property ;
    rdfs:label 'Net Fee' ;
    rdfs:comment 'Actual fee payable by the fan after applying discounts and waivers (membership_fee minus discount_amount). Used for revenue recognition, accounts receivable, and fan-facing billing statements.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parkingPassFlag rdf:type rdf:Property ;
    rdfs:label 'Parking Pass Flag' ;
    rdfs:comment 'Indicates whether a parking pass benefit is included in this membership. Drives parking inventory allocation in venue operations and access control at parking facilities.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Flag' ;
    rdfs:comment 'Indicates whether the fan is on an installment payment plan rather than paying the full membership fee upfront. Drives installment schedule management in SAP S/4HANA FI and Ticketmaster/AXS.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorityTicketingFlag rdf:type rdf:Property ;
    rdfs:label 'Priority Ticketing Flag' ;
    rdfs:comment 'Indicates whether this membership grants priority access to ticket purchases before general public on-sale dates. Operationally consumed by Ticketmaster/AXS pre-sale access control.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seatBlockReference rdf:type rdf:Property ;
    rdfs:label 'Seat Block Reference' ;
    rdfs:comment 'Reference to the assigned seat block or seating inventory allocation associated with this membership (e.g., season ticket seat section/row/seat range). Sourced from Archtics venue seating and inventory management system.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validUntil rdf:type rdf:Property ;
    rdfs:label 'Valid Until' ;
    rdfs:comment 'Calendar date on which this zone access grant expires. Enables time-bounded access permissions independent of the membership end date (e.g., field-level access only during playoffs). Belongs to the grant, not to the membership or zone alone.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waitlistFlag rdf:type rdf:Property ;
    rdfs:label 'Waitlist Flag' ;
    rdfs:comment 'Indicates whether this membership record represents a fan on the waitlist for a sold-out membership tier (e.g., season ticket waitlist). Waitlisted records have membership_status of pending_activation until inventory becomes available.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waitlistPosition rdf:type rdf:Property ;
    rdfs:label 'Waitlist Position' ;
    rdfs:comment 'Numeric position of the fan on the membership waitlist when waitlist_flag is True. Lower numbers indicate higher priority for membership offer. Null when not on waitlist.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:zoneAccessLevel rdf:type rdf:Property ;
    rdfs:label 'Zone Access Level' ;
    rdfs:comment 'The specific level of access within the zone granted to this membership — e.g., entry-only vs. full access vs. escorted access only. Varies per membership-zone combination and belongs to the grant record.' ;
    rdfs:domain ind:Membership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validFrom rdf:type rdf:Property ;
    rdfs:label 'Valid From' ;
    rdfs:comment 'Calendar date from which this zone access grant becomes effective. Allows access permissions to be pre-configured before a season or event and activated on a specific date. Belongs to the grant, not to the membership or zone alone.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:membershipBenefitId rdf:type rdf:Property ;
    rdfs:label 'Membership Benefit Id' ;
    rdfs:comment 'Unique surrogate identifier for each membership benefit record in the fan domain. Primary key for the membership_benefit data product.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceOrderId rdf:type rdf:Property ;
    rdfs:label 'Service Order Id' ;
    rdfs:comment 'Foreign key linking to partner.service_order. Business justification: VIP and premium membership benefits (meet-and-greet, hospitality suite, event-day services) are operationally fulfilled via vendor service orders. Linking membership_benefit to service_order enables f' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceOrder .

ind:benefitCategory rdf:type rdf:Property ;
    rdfs:label 'Benefit Category' ;
    rdfs:comment 'High-level grouping of the benefit for reporting and analytics segmentation. Distinguishes between access-based benefits (venue, lounge), discount-based benefits (merchandise, F&B), experiential benefits (meet-and-greet, behind-the-scenes), content benefits (OTT, exclusive digital), physical goods (merchandise packs), and service benefits (concierge, priority support).' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitCode rdf:type rdf:Property ;
    rdfs:label 'Benefit Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying the benefit definition within the benefit catalogue (e.g., PRIO-TKT-001, MERCH-DISC-15, VIP-LOUNGE-ACC). Used for benefit fulfilment lookups and cross-system reconciliation.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitDescription rdf:type rdf:Property ;
    rdfs:label 'Benefit Description' ;
    rdfs:comment 'Detailed narrative description of the benefit, including what is included, any conditions of use, and the fan experience it delivers. Used in fan-facing portals, CRM communications, and VIP experience management documentation.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitGroupCode rdf:type rdf:Property ;
    rdfs:label 'Benefit Group Code' ;
    rdfs:comment 'Code grouping related benefits into a logical bundle or package (e.g., \'VIP-HOSPITALITY-PKG\', \'SEASON-TICKET-BUNDLE\'). Enables package-level reporting, bulk activation/deactivation, and sponsor benefit attribution across grouped entitlements.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitName rdf:type rdf:Property ;
    rdfs:label 'Benefit Name' ;
    rdfs:comment 'Human-readable name of the membership benefit as displayed to fans and staff (e.g., \'Priority Ticket Access\', \'VIP Lounge Pass\', \'15% Merchandise Discount\', \'Exclusive Content Access\'). Used in fan-facing communications and CRM dashboards.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitStatus rdf:type rdf:Property ;
    rdfs:label 'Benefit Status' ;
    rdfs:comment 'Current lifecycle state of the membership benefit record. Controls whether the benefit is available for redemption. \'active\' = available for use; \'suspended\' = temporarily blocked; \'expired\' = past validity window; \'pending\' = awaiting activation; \'cancelled\' = permanently revoked.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitType rdf:type rdf:Property ;
    rdfs:label 'Benefit Type' ;
    rdfs:comment 'Categorical classification of the benefit by its fulfilment domain. Drives routing to the appropriate fulfilment system (e.g., Ticketmaster/AXS for ticketing, Archtics for venue access, Shopify Plus for merchandise, Dalet/Adobe for content). [ENUM-REF-CANDIDATE: ticketing|parking|merchandise|lounge_access|meet_and_greet|content_access|hospitality|discount|experience|other — promote to reference product]' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitValueAmount rdf:type rdf:Property ;
    rdfs:label 'Benefit Value Amount' ;
    rdfs:comment 'The monetary value of the benefit as assessed for financial reporting, sponsor valuation, and VIP package costing (e.g., a meet-and-greet valued at $500, a parking pass valued at $50). Used in ROI analysis for membership programs and sponsor benefit packages. Expressed in the operating currency.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountPercentage rdf:type rdf:Property ;
    rdfs:label 'Discount Percentage' ;
    rdfs:comment 'The percentage discount applied to merchandise, F&B, or other purchases as part of this benefit (e.g., 15.00 for a 15% merchandise discount). Applicable when benefit_type is \'merchandise\' or \'discount\'. Null for non-discount benefit types. Used by Shopify Plus and POS systems to apply the discount at checkout.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fulfilmentChannel rdf:type rdf:Property ;
    rdfs:label 'Fulfilment Channel' ;
    rdfs:comment 'The channel through which the benefit is delivered or redeemed by the fan. \'venue\' = redeemed at the physical venue; \'online\' = redeemed via web portal; \'mobile_app\' = redeemed via fan mobile application; \'mail\' = physically mailed to fan; \'third_party\' = fulfilled by an external partner; \'pos\' = redeemed at a Point of Sale (POS) terminal.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfilmentReference rdf:type rdf:Property ;
    rdfs:label 'Fulfilment Reference' ;
    rdfs:comment 'External reference number or code from the fulfilment system (e.g., Ticketmaster/AXS order reference, Shopify Plus order ID, Archtics credential ID) confirming that the benefit has been provisioned. Used for cross-system reconciliation and fan support queries.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfilmentStatus rdf:type rdf:Property ;
    rdfs:label 'Fulfilment Status' ;
    rdfs:comment 'Current operational status of the benefit fulfilment process, distinct from the benefit lifecycle status. Tracks whether the benefit has been successfully delivered to the fan. \'partially_fulfilled\' applies when only some units of a multi-quantity benefit have been delivered.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAutoRenewed rdf:type rdf:Property ;
    rdfs:label 'Is Auto Renewed' ;
    rdfs:comment 'Indicates whether this benefit is automatically renewed at the start of each new membership period or season (True) or requires manual re-activation (False). Drives automated benefit provisioning workflows in Salesforce CRM and Adobe Experience Platform.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStackable rdf:type rdf:Property ;
    rdfs:label 'Is Stackable' ;
    rdfs:comment 'Indicates whether this benefit can be combined with other benefits or promotions simultaneously (True) or whether it is exclusive and cannot be stacked (False). For example, a merchandise discount benefit may not be stackable with a promotional sale discount. Used by Shopify Plus and POS discount engines.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastRedeemedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Redeemed Timestamp' ;
    rdfs:comment 'The timestamp of the most recent redemption of this benefit by the fan. Used for engagement analytics, benefit utilisation reporting, and identifying dormant benefits for fan re-engagement campaigns in Adobe Experience Platform.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:npsEligible rdf:type rdf:Property ;
    rdfs:label 'Nps Eligible' ;
    rdfs:comment 'Indicates whether redemption of this benefit triggers an NPS survey to the fan for experience feedback collection. Supports fan satisfaction measurement and VIP experience improvement programmes managed via Adobe Experience Platform and Salesforce CRM.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorityRank rdf:type rdf:Property ;
    rdfs:label 'Priority Rank' ;
    rdfs:comment 'Numeric rank indicating the priority order of this benefit relative to other benefits within the same membership tier or membership record. Lower values indicate higher priority. Used to resolve conflicts when multiple benefits apply simultaneously and to order benefit display in fan-facing portals.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quantityAllocated rdf:type rdf:Property ;
    rdfs:label 'Quantity Allocated' ;
    rdfs:comment 'The total number of units of this benefit allocated to the membership or tier (e.g., 4 priority ticket windows, 2 parking passes, 1 meet-and-greet slot). Null or zero indicates unlimited allocation. Used for benefit inventory management and fulfilment tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quantityRedeemed rdf:type rdf:Property ;
    rdfs:label 'Quantity Redeemed' ;
    rdfs:comment 'The number of benefit units that have been redeemed by the fan to date within the current validity period. Used alongside quantity_allocated to determine remaining entitlement and drive fulfilment controls.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:redemptionEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Redemption End Timestamp' ;
    rdfs:comment 'The precise date and time after which the benefit can no longer be redeemed. Provides finer-grained control than effective_until for time-sensitive benefits such as pre-event VIP access windows or flash merchandise discounts.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:redemptionMethod rdf:type rdf:Property ;
    rdfs:label 'Redemption Method' ;
    rdfs:comment 'The technical mechanism by which the fan redeems the benefit. Drives integration with access control and POS systems. \'barcode\' and \'qr_code\' are used with Ticketmaster/AXS; \'rfid\' with Archtics venue access; \'voucher_code\' with Shopify Plus merchandise; \'auto_applied\' for benefits applied automatically at checkout or entry. [ENUM-REF-CANDIDATE: barcode|qr_code|rfid|voucher_code|digital_wallet|manual|auto_applied — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redemptionStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Redemption Start Timestamp' ;
    rdfs:comment 'The precise date and time from which the fan may begin redeeming this benefit. May differ from effective_from when a benefit window opens at a specific time (e.g., priority ticket sales opening at 10:00 AM on a specific date). Used for time-gated benefit activation.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:termsAndConditionsUrl rdf:type rdf:Property ;
    rdfs:label 'Terms And Conditions Url' ;
    rdfs:comment 'URL linking to the full terms and conditions governing the use of this benefit. Required for GDPR and CCPA compliance to ensure fans have access to the conditions under which their benefit entitlements are granted and may be revoked.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageLimitPerEvent rdf:type rdf:Property ;
    rdfs:label 'Usage Limit Per Event' ;
    rdfs:comment 'Maximum number of times this benefit can be redeemed at a single event. For example, a VIP lounge pass may allow entry once per event, or a priority ticket window may allow purchase of up to 4 tickets per event. Null indicates no per-event restriction.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:venueZone rdf:type rdf:Property ;
    rdfs:label 'Venue Zone' ;
    rdfs:comment 'The specific zone or area within the venue where this benefit is applicable or redeemable (e.g., \'VIP Lounge Level 3\', \'Club Concourse\', \'Premium Parking Zone A\'). Used by Archtics for access control configuration and venue operations staff for benefit fulfilment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vipTierLevel rdf:type rdf:Property ;
    rdfs:label 'Vip Tier Level' ;
    rdfs:comment 'The VIP tier classification associated with this benefit, indicating the prestige level of the benefit within the fan loyalty hierarchy. Used for VIP experience management, venue access prioritisation, and fan segmentation in Adobe Experience Platform and Salesforce CRM.' ;
    rdfs:domain ind:MembershipBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npsResponseId rdf:type rdf:Property ;
    rdfs:label 'Nps Response Id' ;
    rdfs:comment 'Unique surrogate identifier for each individual NPS survey response record. Primary key for the nps_response data product within the fan domain.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:followupEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Followup Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: NPS detractor follow-up workflows assign specific CX staff to each response requiring action. Sports entertainment CX managers track employee ownership of follow-up tasks for SLA compliance, coaching,' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:serviceCaseId rdf:type rdf:Property ;
    rdfs:label 'Service Case Id' ;
    rdfs:comment 'Reference to the Salesforce CRM case created for detractor recovery workflow. Populated when follow-up action is initiated for low NPS scores. Null if no case has been opened.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceCase .

ind:sessionId rdf:type rdf:Property ;
    rdfs:label 'Session Id' ;
    rdfs:comment 'Foreign key linking to gaming.gaming_session. Business justification: Post-session NPS measurement: sports betting operators trigger NPS surveys at gaming session end as a standard responsible gaming and CX practice. Linking the NPS response to the specific gaming sessi' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Session .

ind:consentGiven rdf:type rdf:Property ;
    rdfs:label 'Consent Given' ;
    rdfs:comment 'Indicates whether the fan provided explicit consent for their survey response data (including verbatim comments) to be used for analytics, personalization, and CRM purposes at the time of submission.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataRetentionExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Data Retention Expiry Date' ;
    rdfs:comment 'The date after which this NPS response record must be purged or anonymised in accordance with the applicable data retention policy. Supports GDPR right to erasure and CCPA deletion request compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:externalResponseRef rdf:type rdf:Property ;
    rdfs:label 'External Response Ref' ;
    rdfs:comment 'The externally-known unique identifier for this response as assigned by the survey platform (e.g., Adobe Experience Platform response GUID or third-party NPS tool reference). Used for cross-system reconciliation.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanLocaleCountryCode rdf:type rdf:Property ;
    rdfs:label 'Fan Locale Country Code' ;
    rdfs:comment 'The ISO 3166-1 alpha-3 country code representing the fan\'s locale at the time of survey response. Enables geographic segmentation of NPS scores across global markets.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanTenureDays rdf:type rdf:Property ;
    rdfs:label 'Fan Tenure Days' ;
    rdfs:comment 'The number of days the fan has been a registered member as of the response date. Enables cohort analysis of NPS scores by fan tenure and lifecycle stage.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:followUpCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Completed Date' ;
    rdfs:comment 'The actual date on which the follow-up action for this NPS response was completed and resolved. Used to measure SLA adherence and time-to-resolution for detractor recovery.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpDueDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Due Date' ;
    rdfs:comment 'The target date by which the follow-up action for a detractor response must be completed, as defined by the fan engagement Service Level Agreement (SLA). Null if no follow-up is required.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpRequired rdf:type rdf:Property ;
    rdfs:label 'Follow Up Required' ;
    rdfs:comment 'Indicates whether this NPS response requires a follow-up action, typically triggered for detractor scores (0-6) to initiate CRM recovery workflows. True = follow-up action is required; False = no follow-up needed.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpStatus rdf:type rdf:Property ;
    rdfs:label 'Follow Up Status' ;
    rdfs:comment 'Current status of the follow-up action for this NPS response. Tracks the detractor recovery workflow lifecycle from initial identification through resolution. \'not_required\' for passive and promoter responses where no action was triggered.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAnonymous rdf:type rdf:Property ;
    rdfs:label 'Is Anonymous' ;
    rdfs:comment 'Indicates whether the fan opted to submit this NPS response anonymously. True = anonymous submission where fan identity is not linked; False = identified submission linked to fan profile. Impacts GDPR data subject rights applicability.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFirstResponse rdf:type rdf:Property ;
    rdfs:label 'Is First Response' ;
    rdfs:comment 'Indicates whether this is the fan\'s first-ever NPS survey response on record. Used for new fan onboarding analytics and baseline satisfaction benchmarking.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:membershipTierAtResponse rdf:type rdf:Property ;
    rdfs:label 'Membership Tier At Response' ;
    rdfs:comment 'The fan\'s loyalty membership tier at the time of survey response (e.g., standard, silver, gold, platinum, VIP). Captured as a snapshot to enable NPS analysis by membership tier without dependency on current tier status. [ENUM-REF-CANDIDATE: standard|silver|gold|platinum|vip|season_ticket_holder — promote to reference product]' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npsCategory rdf:type rdf:Property ;
    rdfs:label 'Nps Category' ;
    rdfs:comment 'Derived classification of the fan based on their NPS score: \'promoter\' (score 9-10), \'passive\' (score 7-8), or \'detractor\' (score 0-6). Used for CRM segmentation, detractor recovery workflows, and NPS calculation reporting.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryFeedbackTheme rdf:type rdf:Property ;
    rdfs:label 'Primary Feedback Theme' ;
    rdfs:comment 'The dominant topic or theme identified from the verbatim comment through NLP text classification (e.g., \'venue_experience\', \'ticketing\', \'broadcast_quality\', \'athlete_performance\', \'food_beverage\', \'customer_service\'). Used for root cause analysis of NPS drivers. [ENUM-REF-CANDIDATE: venue_experience|ticketing|broadcast_quality|athlete_performance|food_beverage|customer_service|merchandise|parking|app_experience — promote to reference product]' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorNpsScore rdf:type rdf:Property ;
    rdfs:label 'Prior Nps Score' ;
    rdfs:comment 'The fan\'s NPS score from their most recent previous survey response, captured as a snapshot at the time of this response. Enables score delta analysis and trend tracking without requiring a self-join.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responseChannel rdf:type rdf:Property ;
    rdfs:label 'Response Channel' ;
    rdfs:comment 'The channel through which the fan received and submitted the NPS survey. Used to analyze satisfaction scores by engagement channel and optimize survey distribution strategy.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseLatencyMinutes rdf:type rdf:Property ;
    rdfs:label 'Response Latency Minutes' ;
    rdfs:comment 'The elapsed time in minutes between the survey invitation being sent and the fan submitting their response. Used to assess recency bias and optimize survey timing for maximum response quality.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responseStatus rdf:type rdf:Property ;
    rdfs:label 'Response Status' ;
    rdfs:comment 'Current lifecycle status of the NPS response record. \'submitted\' = complete and valid; \'partial\' = survey started but not fully completed; \'withdrawn\' = fan requested removal; \'invalid\' = failed validation rules; \'duplicate\' = identified as a duplicate submission.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Response Timestamp' ;
    rdfs:comment 'The exact date and time when the fan submitted the NPS survey response. Principal business event timestamp representing the moment of fan satisfaction measurement. Stored in ISO 8601 format with timezone offset.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scoreChangeDirection rdf:type rdf:Property ;
    rdfs:label 'Score Change Direction' ;
    rdfs:comment 'Categorical indicator of whether the fan\'s NPS score improved, declined, or remained unchanged compared to their prior response. \'first_response\' when no prior score exists. Supports trend analysis and loyalty program effectiveness measurement.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sentimentLabel rdf:type rdf:Property ;
    rdfs:label 'Sentiment Label' ;
    rdfs:comment 'Categorical sentiment classification derived from NLP analysis of the verbatim comment. Complements the numeric sentiment score for reporting and CRM segmentation purposes.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sentimentScore rdf:type rdf:Property ;
    rdfs:label 'Sentiment Score' ;
    rdfs:comment 'Numeric sentiment polarity score derived from NLP analysis of the verbatim comment, ranging from -1.0000 (most negative) to 1.0000 (most positive). Populated by the Adobe Experience Platform AI/ML sentiment analysis pipeline.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surveyCompletionTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Survey Completion Time Seconds' ;
    rdfs:comment 'The elapsed time in seconds from when the fan opened the survey to when they submitted it. Used to assess survey engagement quality and identify potentially rushed or bot-generated responses.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveyInvitationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Survey Invitation Timestamp' ;
    rdfs:comment 'The date and time when the NPS survey invitation was sent to the fan. Used to calculate response latency (time between invitation and submission) and to assess survey recency bias.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:surveyLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Survey Language Code' ;
    rdfs:comment 'The ISO 639-1 language code (optionally with ISO 3166-1 country subtag) in which the survey was presented and the fan responded. Supports multilingual NPS analysis across global markets.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyTriggerType rdf:type rdf:Property ;
    rdfs:label 'Survey Trigger Type' ;
    rdfs:comment 'The business event or rule that triggered the NPS survey invitation to the fan. Enables analysis of satisfaction scores by trigger context and optimization of survey timing strategy.' ;
    rdfs:domain ind:NpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verbatimComment rdf:type rdf:Property ;
    rdfs:label 'Verbatim Comment' ;
    rdfs:comment 'The free-text open-ended comment provided by the fan explaining their NPS score. Contains qualitative feedback used for sentiment analysis, theme identification, and CRM case management. May contain sensitive personal opinions.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeDate rdf:type rdf:Property ;
    rdfs:label 'Close Date' ;
    rdfs:comment 'The calendar date on which the NPS survey campaign was closed and no longer accepting responses. Defines the end of the survey collection window. Null for open-ended campaigns.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Completion Time Seconds' ;
    rdfs:comment 'Time in seconds taken by the fan to complete the NPS survey from first interaction to submission. Used to assess survey fatigue, optimize survey length, and identify potentially low-quality responses (e.g., unusually fast completions).' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentCaptured rdf:type rdf:Property ;
    rdfs:label 'Consent Captured' ;
    rdfs:comment 'Indicates whether explicit fan consent for processing survey response data (including verbatim comments) was captured at the point of survey submission, in compliance with GDPR and CCPA requirements. True when consent was affirmatively given; False when not captured.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryChannel rdf:type rdf:Property ;
    rdfs:label 'Delivery Channel' ;
    rdfs:comment 'The communication channel through which the NPS survey invitation was delivered to the fan. Drives channel-level response rate analysis and informs omnichannel fan engagement strategy. [ENUM-REF-CANDIDATE: email|in_app|sms|in_venue_kiosk|web|push_notification — promote to reference product]' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followupActionRequired rdf:type rdf:Property ;
    rdfs:label 'Followup Action Required' ;
    rdfs:comment 'Indicates whether this NPS response has triggered a follow-up action, typically for Detractor recovery workflows in Salesforce CRM case management. True when a CRM case or outreach task has been created; False otherwise.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followupStatus rdf:type rdf:Property ;
    rdfs:label 'Followup Status' ;
    rdfs:comment 'Current status of the CRM follow-up action associated with this NPS response. Pending indicates a case has been created but not yet actioned; in_progress means outreach is underway; resolved means the fan concern has been addressed; no_action means no follow-up was warranted.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invitationsSent rdf:type rdf:Property ;
    rdfs:label 'Invitations Sent' ;
    rdfs:comment 'Total number of survey invitations dispatched to fans for this campaign. Used as the denominator in response rate calculation and campaign reach reporting.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:npsBenchmarkVersion rdf:type rdf:Property ;
    rdfs:label 'Nps Benchmark Version' ;
    rdfs:comment 'Version identifier of the NPS benchmarking framework applied to this survey campaign (e.g., \'NPS2_2024\', \'SPORTS_BENCH_V3\'). Ensures consistent year-over-year comparability when benchmark methodologies are updated.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openDate rdf:type rdf:Property ;
    rdfs:label 'Open Date' ;
    rdfs:comment 'The calendar date on which the NPS survey campaign was opened and made available for fan responses. Defines the start of the survey collection window.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reminderSent rdf:type rdf:Property ;
    rdfs:label 'Reminder Sent' ;
    rdfs:comment 'Indicates whether a reminder communication was sent to the fan for this survey invitation. Used to assess the impact of reminders on response rates and to prevent over-communication in compliance with fan communication preferences.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reminderTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reminder Timestamp' ;
    rdfs:comment 'Date and time at which the survey reminder communication was dispatched to the fan. Null when no reminder was sent. Used for communication cadence analysis and deliverability reporting.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:respondentCategory rdf:type rdf:Property ;
    rdfs:label 'Respondent Category' ;
    rdfs:comment 'Classification of the fan respondent based on their NPS score: Promoter (score 9-10), Passive (score 7-8), or Detractor (score 0-6). Drives CRM case management workflows, detractor recovery outreach, and promoter advocacy programs.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseRate rdf:type rdf:Property ;
    rdfs:label 'Response Rate' ;
    rdfs:comment 'Proportion of survey invitations that resulted in a completed response, expressed as a decimal (e.g., 0.2350 = 23.50%). Stored as a raw ratio to support benchmarking and trend analysis without requiring recalculation. Populated at campaign close.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responsesReceived rdf:type rdf:Property ;
    rdfs:label 'Responses Received' ;
    rdfs:comment 'Total number of completed NPS survey responses received for this campaign. Used as the numerator in response rate calculation and for statistical significance assessment.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveyCode rdf:type rdf:Property ;
    rdfs:label 'Survey Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the survey campaign, used in Salesforce CRM and Adobe Experience Platform for cross-system reference and reporting. Format: NPS- followed by 4-20 alphanumeric characters.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyLanguage rdf:type rdf:Property ;
    rdfs:label 'Survey Language' ;
    rdfs:comment 'ISO 639-1 language code (optionally with ISO 3166-1 alpha-2 region subtag) in which the survey was presented to the fan (e.g., \'en\', \'es\', \'fr\', \'pt-BR\'). Supports multilingual fan engagement across global markets.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyName rdf:type rdf:Property ;
    rdfs:label 'Survey Name' ;
    rdfs:comment 'Human-readable name of the NPS survey campaign (e.g., \'Post-Match Fan Experience Survey Q3 2024\', \'Season Ticket Holder Relationship NPS\'). Used for reporting, CRM case management, and stakeholder communications.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyStatus rdf:type rdf:Property ;
    rdfs:label 'Survey Status' ;
    rdfs:comment 'Current lifecycle state of the NPS survey campaign. Draft indicates the survey is being configured; active means it is open for responses; paused means collection is temporarily halted; closed means the survey window has ended; archived means the record is retained for historical analysis only.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyType rdf:type rdf:Property ;
    rdfs:label 'Survey Type' ;
    rdfs:comment 'Classification of the NPS survey by its business trigger or cadence. Post-event surveys are tied to a specific game or concert; post-purchase surveys follow a ticket or merchandise transaction; seasonal surveys are periodic; relationship surveys measure overall fan sentiment; onboarding surveys target new fans.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetSegmentCode rdf:type rdf:Property ;
    rdfs:label 'Target Segment Code' ;
    rdfs:comment 'CRM audience segment code identifying the fan population targeted by this survey campaign (e.g., \'STH_GOLD\', \'VIP_SUITE\', \'GA_CASUAL\'). Sourced from Salesforce CRM segmentation and Adobe Experience Platform audience definitions. Enables segment-level NPS benchmarking.' ;
    rdfs:domain ind:NpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:touchpointType rdf:type rdf:Property ;
    rdfs:label 'Touchpoint Type' ;
    rdfs:comment 'The specific fan experience touchpoint that this NPS survey is measuring (e.g., game_day experience, broadcast/streaming experience, merchandise purchase, ticketing process, mobile app, venue service, fan club membership). Enables touchpoint-level NPS decomposition for targeted improvement initiatives. [ENUM-REF-CANDIDATE: game_day|broadcast|merchandise|ticketing|app|venue_service|fan_club — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentMethodId rdf:type rdf:Property ;
    rdfs:label 'Payment Method Id' ;
    rdfs:comment 'Primary key for payment_method' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:avsResponseCode rdf:type rdf:Property ;
    rdfs:label 'Avs Response Code' ;
    rdfs:comment 'Response code returned by the card issuer\'s Address Verification Service (AVS) during the enrollment authorization. Indicates the degree of match between the billing address provided by the fan and the address on file with the issuer. Used in fraud scoring and risk decisioning.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountLastFour rdf:type rdf:Property ;
    rdfs:label 'Bank Account Last Four' ;
    rdfs:comment 'Last four digits of the bank account number for direct debit payment methods. Displayed to the fan for identification purposes. Applicable only when payment_method_type is \'direct_debit\'. Null for card-based instruments.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankRoutingCode rdf:type rdf:Property ;
    rdfs:label 'Bank Routing Code' ;
    rdfs:comment 'Bank routing number (US ACH) or sort code (UK/EU) associated with a direct debit payment method. Used for ACH or SEPA payment processing. Stored in truncated or tokenized form. Null for non-direct-debit instruments.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Billing Address Line1' ;
    rdfs:comment 'Primary street address line of the billing address associated with this payment instrument. Used for Address Verification Service (AVS) checks during card-not-present transactions on ticketing and merchandise platforms.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Billing Address Line2' ;
    rdfs:comment 'Secondary street address line (apartment, suite, unit number) of the billing address. Optional supplementary address detail for Address Verification Service (AVS) processing.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCity rdf:type rdf:Property ;
    rdfs:label 'Billing City' ;
    rdfs:comment 'City component of the billing address associated with this payment instrument. Used for AVS verification, fraud scoring, and geographic revenue reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCountryCode rdf:type rdf:Property ;
    rdfs:label 'Billing Country Code' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code of the billing address (e.g., USA, GBR, DEU). Determines applicable privacy regulation (GDPR for EU/EEA, CCPA for California), currency routing, and cross-border payment processing rules.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPostalCode rdf:type rdf:Property ;
    rdfs:label 'Billing Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the billing address. Critical input for Address Verification Service (AVS) checks on card-not-present transactions. Also used for geographic segmentation and tax jurisdiction mapping.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingStateProvince rdf:type rdf:Property ;
    rdfs:label 'Billing State Province' ;
    rdfs:comment 'State or province component of the billing address. Used for AVS verification, tax jurisdiction determination, and CCPA/GDPR applicability assessment for fan data privacy compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:binNumber rdf:type rdf:Property ;
    rdfs:label 'Bin Number' ;
    rdfs:comment 'First 6–8 digits of the payment card number identifying the issuing institution and card product type. Used for routing decisions, interchange category determination, and fraud analysis. Stored as a non-sensitive BIN (not the full PAN) per PCI-DSS truncation rules.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardFundingType rdf:type rdf:Property ;
    rdfs:label 'Card Funding Type' ;
    rdfs:comment 'Funding classification of the payment card as determined from BIN lookup. Distinguishes credit, debit, prepaid, and charge cards. Impacts interchange fee rates, refund processing timelines, and eligibility for certain promotional financing offers on season tickets.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardholderName rdf:type rdf:Property ;
    rdfs:label 'Cardholder Name' ;
    rdfs:comment 'Name of the individual as it appears on the payment card or as registered with the payment instrument. Used for display in account management screens and for AVS/identity verification during high-value transactions. Stored only where operationally required per PCI-DSS data minimization principles.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentCaptureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Consent Capture Timestamp' ;
    rdfs:comment 'Date and time when the fan explicitly consented to storing this payment instrument and authorizing recurring charges. Recorded in ISO 8601 format with timezone offset. Required for GDPR Article 6 lawful basis documentation and CCPA compliance audit trails.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:directDebitMandateRef rdf:type rdf:Property ;
    rdfs:label 'Direct Debit Mandate Ref' ;
    rdfs:comment 'Unique mandate reference number assigned for SEPA Direct Debit or ACH authorization agreements. Required for recurring direct debit collections such as installment-based season ticket payment plans. Null for non-direct-debit instruments.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expiryMonth rdf:type rdf:Property ;
    rdfs:label 'Expiry Month' ;
    rdfs:comment 'Two-digit calendar month (1–12) in which the payment card expires. Used in conjunction with expiry_year to determine card validity and trigger pre-expiry notification workflows for membership auto-renewal continuity.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expiryNotificationSent rdf:type rdf:Property ;
    rdfs:label 'Expiry Notification Sent' ;
    rdfs:comment 'Indicates whether a pre-expiry notification has been dispatched to the fan via their preferred communication channel (email, SMS, push) to prompt card update before membership or season ticket auto-renewal fails. Managed by Adobe Experience Platform journey automation.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expiryYear rdf:type rdf:Property ;
    rdfs:label 'Expiry Year' ;
    rdfs:comment 'Four-digit calendar year in which the payment card expires. Combined with expiry_month to assess card validity. Triggers automated pre-expiry fan communications to update payment details and prevent lapsed season ticket or membership renewals.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fraudRiskScore rdf:type rdf:Property ;
    rdfs:label 'Fraud Risk Score' ;
    rdfs:comment 'Numeric risk score (0.00–100.00) assigned to this payment instrument by the fraud detection engine at enrollment or last transaction. Higher scores indicate elevated fraud risk. Used to trigger step-up authentication, manual review, or instrument suspension. Not a calculated KPI — raw score from fraud provider.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:giftCardBalance rdf:type rdf:Property ;
    rdfs:label 'Gift Card Balance' ;
    rdfs:comment 'Current monetary balance remaining on a stored-value gift card payment instrument. Applicable only when payment_method_type is \'gift_card\'. Updated after each redemption transaction. Null for non-gift-card instruments. Denominated in the currency indicated by currency_code.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isDefault rdf:type rdf:Property ;
    rdfs:label 'Is Default' ;
    rdfs:comment 'Indicates whether this payment instrument is the fan\'s designated default method for one-click purchases, membership auto-renewals, and express checkout. Only one payment method per fan account should have this flag set to True at any time.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuerCountryCode rdf:type rdf:Property ;
    rdfs:label 'Issuer Country Code' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code of the financial institution that issued the payment card. Derived from the card BIN (Bank Identification Number). Used for cross-border transaction fee assessment, currency mismatch detection, and regulatory reporting.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUsedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Used Timestamp' ;
    rdfs:comment 'Date and time of the most recent successful transaction processed against this payment instrument. Used to identify dormant payment methods for cleanup workflows and to assess instrument activity for fraud monitoring.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:methodStatus rdf:type rdf:Property ;
    rdfs:label 'Method Status' ;
    rdfs:comment 'Current lifecycle status of the payment instrument. \'active\' — valid and available for transactions; \'expired\' — card expiry date has passed; \'suspended\' — temporarily blocked due to fraud or dispute; \'removed\' — fan has deleted the instrument; \'pending_verification\' — awaiting micro-deposit or 3DS verification.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Network Transaction Reference' ;
    rdfs:comment 'Unique identifier assigned by the card network (Visa, Mastercard) during the initial card-on-file enrollment authorization. Required for subsequent MIT (Merchant-Initiated Transaction) recurring charges such as season ticket auto-renewals, ensuring compliance with card network stored credential mandates.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pciComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Pci Compliance Status' ;
    rdfs:comment 'Indicates the PCI-DSS compliance posture of this payment instrument record. \'compliant\' — token and data handling meet PCI-DSS v4.0 requirements; \'non_compliant\' — a compliance gap has been identified requiring remediation; \'pending_review\' — under compliance assessment. Supports PCI SSC audit reporting.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemTokenRef rdf:type rdf:Property ;
    rdfs:label 'Source System Token Ref' ;
    rdfs:comment 'External reference identifier for this payment token as recorded in the originating operational system (e.g., Ticketmaster/AXS vault ID, Shopify Plus payment method ID, Salesforce CRM payment record ID). Enables cross-system reconciliation and lineage tracing in the Silver Layer.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tokenValue rdf:type rdf:Property ;
    rdfs:label 'Token Value' ;
    rdfs:comment 'Opaque tokenized representation of the underlying payment instrument issued by the tokenization provider (e.g., Braintree, Stripe, Adyen). Replaces the raw PAN in all downstream systems. Never stores the actual card number. Compliant with PCI-DSS tokenization standards.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tokenizationProvider rdf:type rdf:Property ;
    rdfs:label 'Tokenization Provider' ;
    rdfs:comment 'Name of the third-party PCI-DSS compliant tokenization service provider that issued and manages the payment token. Used for routing, reconciliation, and vendor management. [ENUM-REF-CANDIDATE: Braintree|Adyen|Stripe|CyberSource|Worldpay|Checkout.com|Spreedly — promote to reference product if provider list grows beyond 6]' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationMethod rdf:type rdf:Property ;
    rdfs:label 'Verification Method' ;
    rdfs:comment 'Method used to verify the payment instrument at enrollment. \'3ds\' — 3-D Secure authentication (Visa Secure / Mastercard Identity Check); \'avs\' — Address Verification Service; \'micro_deposit\' — two small deposits for bank account verification; \'cvv_check\' — card security code validation; \'none\' — no additional verification performed.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationStatus rdf:type rdf:Property ;
    rdfs:label 'Verification Status' ;
    rdfs:comment 'Outcome of the payment instrument verification process. \'verified\' — successfully authenticated; \'unverified\' — verification not yet completed; \'failed\' — verification attempt was unsuccessful; \'pending\' — verification in progress. Determines eligibility for high-value transactions such as season ticket purchases.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:walletProvider rdf:type rdf:Property ;
    rdfs:label 'Wallet Provider' ;
    rdfs:comment 'Name of the digital wallet service when payment_method_type is \'digital_wallet\'. Identifies the wallet ecosystem for routing, reconciliation, and fan experience analytics. Null for non-wallet payment types.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSegmentId rdf:type rdf:Property ;
    rdfs:label 'Source Segment Id' ;
    rdfs:comment 'Native identifier of this segment in the originating source system (e.g., Adobe Experience Platform audience GUID or Salesforce CRM campaign segment ID). Enables traceability and reconciliation between the lakehouse Silver Layer and the operational CRM/CDP systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SportsEntertainment .

ind:targetTeamId rdf:type rdf:Property ;
    rdfs:label 'Target Team Id' ;
    rdfs:comment 'Identifier of the specific team or franchise associated with this segment. Enables team-level fan segmentation for localized marketing, merchandise promotions, and event-specific campaigns.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Team .

ind:ageBandMax rdf:type rdf:Property ;
    rdfs:label 'Age Band Max' ;
    rdfs:comment 'Maximum age (in years) of fans included in this segment. Used in conjunction with age_band_min to define a demographic age range for targeted campaigns. Nullable if no upper age bound is defined.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageBandMin rdf:type rdf:Property ;
    rdfs:label 'Age Band Min' ;
    rdfs:comment 'Minimum age (in years) of fans included in this segment when demographic segmentation is applied. Used for age-gated content, alcohol sponsorship campaigns, and youth-specific engagement programs. Supports ADA and child privacy compliance.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:channelApplicability rdf:type rdf:Property ;
    rdfs:label 'Channel Applicability' ;
    rdfs:comment 'Comma-separated list of marketing and engagement channels for which this segment is activated (e.g., \'email, push_notification, sms, in_app, paid_social, display\'). Guides campaign execution teams on appropriate activation channels. [ENUM-REF-CANDIDATE: email|push_notification|sms|in_app|paid_social|display|direct_mail — promote to reference product]' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentRequirement rdf:type rdf:Property ;
    rdfs:label 'Consent Requirement' ;
    rdfs:comment 'Specifies the consent basis required for fans to be included in this segment and activated for marketing. Explicit consent is required for GDPR-regulated EU fans; legitimate interest may apply for certain analytics use cases. Ensures compliance with GDPR and CCPA.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:definitionCriteria rdf:type rdf:Property ;
    rdfs:label 'Definition Criteria' ;
    rdfs:comment 'Structured or semi-structured expression of the business rules and logic used to qualify fans into this segment (e.g., SQL predicate, JSON rule set, or natural-language description of inclusion/exclusion criteria). Sourced from Adobe Experience Platform segment builder or Salesforce CRM campaign filter logic.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:definitionFormat rdf:type rdf:Property ;
    rdfs:label 'Definition Format' ;
    rdfs:comment 'Format of the definition_criteria field, indicating how the segment logic is expressed. PQL refers to Adobe Experience Platform Profile Query Language. Enables downstream systems to parse and execute the segment definition correctly.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementScoreMax rdf:type rdf:Property ;
    rdfs:label 'Engagement Score Max' ;
    rdfs:comment 'Maximum fan engagement score for inclusion in this segment. Used in conjunction with engagement_score_min to define a score band for precise audience targeting. Nullable if no upper bound is defined.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:engagementScoreMin rdf:type rdf:Property ;
    rdfs:label 'Engagement Score Min' ;
    rdfs:comment 'Minimum fan engagement score required for inclusion in this segment, as calculated by Adobe Experience Platform. Engagement scores reflect fan interaction frequency, recency, and depth across digital and physical touchpoints.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fanCount rdf:type rdf:Property ;
    rdfs:label 'Fan Count' ;
    rdfs:comment 'Number of fan profiles qualifying for this segment as of the last refresh date. Represents the segment size used for campaign reach estimation, budget planning, and audience reporting. Not a real-time count — reflects the most recent batch evaluation.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isDtcEligible rdf:type rdf:Property ;
    rdfs:label 'Is Dtc Eligible' ;
    rdfs:comment 'Indicates whether this segment is approved for Direct-To-Consumer (DTC) marketing activation, including OTT streaming promotions, DTC merchandise offers, and subscription upsell campaigns. Supports DTC revenue strategy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSuppressionList rdf:type rdf:Property ;
    rdfs:label 'Is Suppression List' ;
    rdfs:comment 'Indicates whether this segment functions as a suppression or exclusion list, identifying fans who should be excluded from specific campaigns (e.g., opted-out fans, recent purchasers, VIP do-not-contact lists). Critical for GDPR and CCPA compliance.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastRefreshTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Refresh Timestamp' ;
    rdfs:comment 'Date and time when the segment membership was most recently evaluated and the fan_count was last updated. Formatted as yyyy-MM-ddTHH:mm:ss.SSSXXX. Critical for assessing data freshness before campaign activation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ltvBand rdf:type rdf:Property ;
    rdfs:label 'Ltv Band' ;
    rdfs:comment 'Lifetime Value (LTV) classification band for fans in this segment, indicating their predicted or historical revenue contribution over their relationship with the organization. High-LTV segments receive premium personalization and VIP treatment. Supports ARPU and LTV analytics.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:membershipTierFilter rdf:type rdf:Property ;
    rdfs:label 'Membership Tier Filter' ;
    rdfs:comment 'Fan loyalty membership tier(s) included in this segment (e.g., \'bronze\', \'silver\', \'gold\', \'platinum\', \'vip\'). Enables tier-specific personalization, exclusive offers, and loyalty program communications. [ENUM-REF-CANDIDATE: bronze|silver|gold|platinum|vip|season_ticket_holder|fan_club — promote to reference product]' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelScoreThreshold rdf:type rdf:Property ;
    rdfs:label 'Model Score Threshold' ;
    rdfs:comment 'Minimum propensity or confidence score from the predictive model required for fan inclusion in this segment. Expressed as a decimal between 0 and 1 (e.g., 0.7500 = 75% confidence). Applicable only when segment_type is \'predictive\'.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextRefreshTimestamp rdf:type rdf:Property ;
    rdfs:label 'Next Refresh Timestamp' ;
    rdfs:comment 'Scheduled date and time for the next segment membership evaluation run. Used by campaign operations teams to plan activation timing and ensure segment data is current before campaign launch.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:npsBand rdf:type rdf:Property ;
    rdfs:label 'Nps Band' ;
    rdfs:comment 'Net Promoter Score (NPS) classification band associated with fans in this segment: promoters (score 9-10), passives (score 7-8), detractors (score 0-6), or unknown if NPS data is unavailable. Enables NPS-driven personalization and retention campaigns.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:owningCampaignId rdf:type rdf:Property ;
    rdfs:label 'Owning Campaign Id' ;
    rdfs:comment 'Identifier of the primary Salesforce CRM campaign or Adobe Experience Platform journey that owns or originated this segment. Links the segment to its marketing campaign context for attribution and ROI reporting.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rfmTier rdf:type rdf:Property ;
    rdfs:label 'Rfm Tier' ;
    rdfs:comment 'RFM (Recency, Frequency, Monetary) tier classification assigned to fans in this segment, applicable when segment_type is \'rfm\'. Champions are high-value frequent buyers; lost fans have not engaged recently. Drives targeted retention and reactivation campaigns.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentDescription rdf:type rdf:Property ;
    rdfs:label 'Segment Description' ;
    rdfs:comment 'Free-text business description of the segment\'s purpose, intended use case, and strategic rationale. Authored by the campaign or analytics team to provide context for downstream users and stakeholders.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentName rdf:type rdf:Property ;
    rdfs:label 'Segment Name' ;
    rdfs:comment 'Human-readable business name of the fan segment (e.g., \'High-Value Season Ticket Holders\', \'Lapsed Casual Fans\', \'Gen-Z Digital Natives\'). Used in campaign targeting, reporting dashboards, and personalization workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentStatus rdf:type rdf:Property ;
    rdfs:label 'Segment Status' ;
    rdfs:comment 'Current lifecycle state of the segment definition. Active segments are available for campaign targeting; draft segments are under construction; archived segments are retained for historical reference but not used in live campaigns.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentType rdf:type rdf:Property ;
    rdfs:label 'Segment Type' ;
    rdfs:comment 'Classification of the segmentation methodology applied: RFM (Recency, Frequency, Monetary), behavioral (engagement actions), demographic (age, gender, location), psychographic (interests, values), predictive (ML-model-driven), or geographic. Drives which analytics model and personalization engine is applied.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetLeague rdf:type rdf:Property ;
    rdfs:label 'Target League' ;
    rdfs:comment 'Name or code of the sports league associated with this segment (e.g., \'NFL\', \'NBA\', \'MLB\', \'NHL\', \'MLS\', \'FIFA\'). Scopes the segment to fans of a specific league for league-specific campaign targeting and personalization.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Segment Assignment Id' ;
    rdfs:comment 'Primary key for segment_assignment' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned By User Employee Id' ;
    rdfs:comment 'Reference to the internal CRM user or analyst who manually created or overrode this segment assignment. Populated only when assignment_method is \'manual\'. Supports accountability and audit trail.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:segmentRuleId rdf:type rdf:Property ;
    rdfs:label 'Segment Rule Id' ;
    rdfs:comment 'Reference to the specific CRM segmentation rule or audience definition that triggered this assignment. Applicable when assignment_method is \'rule_based\'. Supports rule performance analysis and audit.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SegmentRule .

ind:activationDestination rdf:type rdf:Property ;
    rdfs:label 'Activation Destination' ;
    rdfs:comment 'The downstream system or platform to which this segment membership was activated (e.g., \'Adobe Target\', \'Google Ads\', \'Salesforce Marketing Cloud\', \'Meta Ads\'). Supports multi-channel activation tracking and attribution.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activationStatus rdf:type rdf:Property ;
    rdfs:label 'Activation Status' ;
    rdfs:comment 'Indicates whether this segment membership has been activated for downstream use in a campaign, personalization engine, or ad platform. \'activated\' means the membership has been pushed to an activation destination such as Adobe Target or a paid media platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Activation Timestamp' ;
    rdfs:comment 'The date and time when this segment membership was activated and pushed to the downstream destination system. Distinct from assignment_timestamp; supports latency measurement between assignment and activation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignmentChannel rdf:type rdf:Property ;
    rdfs:label 'Assignment Channel' ;
    rdfs:comment 'The system or interface channel through which the assignment was executed. \'crm\' = Salesforce CRM automation; \'aep\' = Adobe Experience Platform (AEP) audience activation; \'api\' = external API call; \'batch\' = scheduled batch job; \'manual_ui\' = CRM analyst via user interface.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentScore rdf:type rdf:Property ;
    rdfs:label 'Assignment Score' ;
    rdfs:comment 'Numeric score or confidence value associated with this assignment, typically produced by an ML model or rule engine. For ML-predicted assignments, this represents the model\'s probability or propensity score (0.0–1.0). For rule-based assignments, this may represent a weighted rule match score.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assignmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assignment Timestamp' ;
    rdfs:comment 'Precise date and time (with timezone) when the fan was assigned to this segment. Supports real-time campaign triggering and audit trail requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataSuppressionFlag rdf:type rdf:Property ;
    rdfs:label 'Data Suppression Flag' ;
    rdfs:comment 'Indicates whether this fan has exercised a right-to-suppress or opt-out request that should prevent this segment assignment from being used in outbound marketing or data sharing. Supports GDPR right to erasure and CCPA opt-out compliance.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:engagementScoreAtAssignment rdf:type rdf:Property ;
    rdfs:label 'Engagement Score At Assignment' ;
    rdfs:comment 'The fan\'s overall engagement score at the time of this segment assignment, as calculated by the CRM or Adobe Experience Platform. Captured as a point-in-time snapshot to support longitudinal analysis of how engagement drives segment membership.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fanTypeAtAssignment rdf:type rdf:Property ;
    rdfs:label 'Fan Type At Assignment' ;
    rdfs:comment 'The fan\'s account classification at the time of this segment assignment. Captured as a point-in-time snapshot to support historical cohort analysis. Values: individual consumer, family account, season ticket holder, VIP member, or fan club member.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicMarket rdf:type rdf:Property ;
    rdfs:label 'Geographic Market' ;
    rdfs:comment 'The geographic market or region associated with this segment assignment (e.g., \'USA\', \'GBR\', \'AUS\'). Uses ISO 3166-1 alpha-3 country codes. Supports geo-targeted campaign execution and regional compliance (GDPR for EU markets, CCPA for California).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimarySegment rdf:type rdf:Property ;
    rdfs:label 'Is Primary Segment' ;
    rdfs:comment 'Indicates whether this segment is the fan\'s primary or highest-priority segment assignment when a fan belongs to multiple segments simultaneously. Used for personalization and communication preference resolution.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastEvaluatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Evaluated Timestamp' ;
    rdfs:comment 'The most recent date and time when the segment rule engine or ML model re-evaluated this fan\'s eligibility for the segment. Supports freshness monitoring and identifies stale assignments that may need re-evaluation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:loyaltyTierAtAssignment rdf:type rdf:Property ;
    rdfs:label 'Loyalty Tier At Assignment' ;
    rdfs:comment 'The fan\'s loyalty program membership tier at the time of this segment assignment. Captured as a point-in-time snapshot to support time-variant analysis of how loyalty tier influences segment membership and campaign response.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:membershipDurationDays rdf:type rdf:Property ;
    rdfs:label 'Membership Duration Days' ;
    rdfs:comment 'The number of days the fan has been (or was) a member of this segment, calculated as the difference between assignment_date and either the current date (for active memberships) or revocation_date/expiry_date. Stored as a business-meaningful snapshot for reporting without requiring real-time calculation.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nextEvaluationDate rdf:type rdf:Property ;
    rdfs:label 'Next Evaluation Date' ;
    rdfs:comment 'The scheduled date for the next automated re-evaluation of this fan\'s segment eligibility. Supports segment refresh scheduling and ensures time-sensitive segments (e.g., event-proximity segments) are kept current.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:npsCohortFlag rdf:type rdf:Property ;
    rdfs:label 'Nps Cohort Flag' ;
    rdfs:comment 'Indicates whether this segment assignment is specifically designated for NPS (Net Promoter Score) survey cohort analysis. When true, the fan is included in NPS measurement campaigns for fan satisfaction tracking.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideReason rdf:type rdf:Property ;
    rdfs:label 'Override Reason' ;
    rdfs:comment 'Free-text justification provided by a CRM analyst when manually assigning or revoking a fan\'s segment membership, overriding automated rule-based or ML-predicted assignment. Populated only when assignment_method is \'manual\'.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationDate rdf:type rdf:Property ;
    rdfs:label 'Revocation Date' ;
    rdfs:comment 'The date on which this fan\'s segment membership was revoked or removed, either by automated rule exit, manual override, or consent withdrawal. Null if the membership has not been revoked.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scoreModelVersion rdf:type rdf:Property ;
    rdfs:label 'Score Model Version' ;
    rdfs:comment 'Version identifier of the ML model or rule engine that produced the assignment_score. Enables model governance, reproducibility, and performance tracking over time. Applicable when assignment_method is \'ml_predicted\'.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentCategory rdf:type rdf:Property ;
    rdfs:label 'Segment Category' ;
    rdfs:comment 'The analytical category of the segment to which the fan is assigned. Denormalized from the segment definition for query performance. Supports filtering and reporting by segment type without joining to the segment master.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentVersion rdf:type rdf:Property ;
    rdfs:label 'Segment Version' ;
    rdfs:comment 'Version label of the segment definition that was active at the time of this assignment. Enables historical analysis of how segment criteria evolved and ensures reproducibility of cohort membership.' ;
    rdfs:domain ind:SegmentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedAgentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned Agent Employee Id' ;
    rdfs:comment 'Reference to the CRM agent or support staff member currently assigned to own and resolve this service case. Used for workload balancing, performance reporting, and escalation routing.' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:relatedCaseServiceCaseId rdf:type rdf:Property ;
    rdfs:label 'Related Case Service Case Id' ;
    rdfs:comment 'Reference to a parent or related service case when this case is part of a case hierarchy (e.g., a sub-case spawned from an escalation, or a duplicate linked to a master case). Null for standalone cases.' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceCase .

ind:returnRequestId rdf:type rdf:Property ;
    rdfs:label 'Return Request Id' ;
    rdfs:comment 'Foreign key linking to merchandise.return_request. Business justification: Customer service cases escalated from merchandise return disputes (e.g., refund denied, return window exception) must reference the originating return_request. Agents need this link to review return s' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReturnRequest .

ind:seatId rdf:type rdf:Property ;
    rdfs:label 'Seat Id' ;
    rdfs:comment 'Foreign key linking to venue.seat. Business justification: Fan service cases for broken seats, obstructed-view disputes, and ADA accommodation requests must reference the specific seat. Venue operations and ADA compliance teams use this link to track seat-lev' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Seat .

ind:accessibilityAccommodationType rdf:type rdf:Property ;
    rdfs:label 'Accessibility Accommodation Type' ;
    rdfs:comment 'Specific type of accessibility accommodation requested or arranged for the fan (e.g., wheelchair seating, hearing loop, visual impairment assistance, companion seating). Populated for cases of type accessibility_accommodation. Supports ADA compliance reporting.' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseCategory rdf:type rdf:Property ;
    rdfs:label 'Case Category' ;
    rdfs:comment 'Secondary classification grouping cases into operational categories for routing and reporting. Complements case_type with a broader operational lens. Corresponds to the Reason field on the Salesforce CRM Case object. [ENUM-REF-CANDIDATE: billing|access_control|fan_experience|safety_security|content_access|merchandise|general — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseDescription rdf:type rdf:Property ;
    rdfs:label 'Case Description' ;
    rdfs:comment 'Full narrative description of the fan\'s issue, request, or complaint as submitted. Captures the complete context of the case including relevant event details, ticket information, or membership concerns. Corresponds to the Description field on the Salesforce CRM Case object.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseReopenCount rdf:type rdf:Property ;
    rdfs:label 'Case Reopen Count' ;
    rdfs:comment 'Number of times this service case has been reopened after a prior resolution or closure. A high reopen count indicates unresolved fan issues and is a key quality metric for support operations.' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:caseSubCategory rdf:type rdf:Property ;
    rdfs:label 'Case Sub Category' ;
    rdfs:comment 'Granular sub-classification within the case_category, providing detailed routing and root-cause analysis capability (e.g., within billing: duplicate_charge, incorrect_tier, failed_payment). Corresponds to a custom sub-reason field in Salesforce CRM.' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseSubject rdf:type rdf:Property ;
    rdfs:label 'Case Subject' ;
    rdfs:comment 'Short, one-line summary of the fan\'s issue or request as entered by the fan or agent. Corresponds to the Subject field on the Salesforce CRM Case object. Used in case list views, dashboards, and agent queues.' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crmCaseSourceReference rdf:type rdf:Property ;
    rdfs:label 'Crm Case Source Reference' ;
    rdfs:comment 'The native Salesforce CRM Case record ID (18-character Salesforce ID) from the source system. Enables traceability and reconciliation between the Silver Layer lakehouse record and the originating Salesforce CRM Case object.' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Flag' ;
    rdfs:comment 'Indicates whether this service case has been formally escalated to a senior agent, supervisor, or management tier. True when the case has been escalated at any point in its lifecycle. Corresponds to the IsEscalated field on the Salesforce CRM Case object.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationReason rdf:type rdf:Property ;
    rdfs:label 'Escalation Reason' ;
    rdfs:comment 'Narrative or coded reason explaining why the case was escalated (e.g., unresolved after SLA breach, fan dissatisfaction, legal threat, media risk, VIP status). Populated when escalation_flag is True.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanSentiment rdf:type rdf:Property ;
    rdfs:label 'Fan Sentiment' ;
    rdfs:comment 'Agent-assessed or AI-derived sentiment classification of the fan\'s tone and emotional state during the case interaction. Used for NPS (Net Promoter Score) correlation analysis and fan experience improvement programs.' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstResponseTimestamp rdf:type rdf:Property ;
    rdfs:label 'First Response Timestamp' ;
    rdfs:comment 'Date and time when the assigned agent first responded to the fan on this case. Used to measure first-response SLA compliance and agent responsiveness KPIs.' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:gdprDataRequestFlag rdf:type rdf:Property ;
    rdfs:label 'Gdpr Data Request Flag' ;
    rdfs:comment 'Indicates whether this service case involves a GDPR data subject request (e.g., right to access, right to erasure, data portability). True when the case is classified as a GDPR-related request. Supports GDPR compliance reporting and regulatory response tracking.' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:npsSurveySentFlag rdf:type rdf:Property ;
    rdfs:label 'Nps Survey Sent Flag' ;
    rdfs:comment 'Indicates whether a post-case NPS satisfaction survey was sent to the fan upon case closure. True when the survey has been dispatched. Supports NPS tracking and fan experience measurement programs.' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originChannel rdf:type rdf:Property ;
    rdfs:label 'Origin Channel' ;
    rdfs:comment 'The channel through which the fan initiated the service case. Used for channel mix analysis, staffing optimization, and omnichannel CRM reporting. Corresponds to the Origin field on the Salesforce CRM Case object. [ENUM-REF-CANDIDATE: phone|email|chat|social|in_venue|web_form|mobile_app — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ServiceCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundAmount rdf:type rdf:Property ;
    rdfs:label 'Refund Amount' ;
    rdfs:comment 'Monetary value of any refund issued to the fan as part of the case resolution. Expressed in the local operating currency. Null if no refund was issued. Used for financial reconciliation and fan compensation reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resolutionType rdf:type rdf:Property ;
    rdfs:label 'Resolution Type' ;
    rdfs:comment 'Standardized classification of the resolution action taken to close the case. Used for resolution outcome analytics, cost-of-service reporting, and fan compensation tracking. [ENUM-REF-CANDIDATE: refund_issued|ticket_replaced|upgrade_offered|apology_sent|information_provided|no_action_required|escalated_to_management|voucher_issued|policy_exception — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceId rdf:type rdf:Property ;
    rdfs:label 'Invoice Id' ;
    rdfs:comment 'Foreign key linking to legal.legal_invoice. Business justification: Outside counsel invoices approved in the legal eBilling system flow into AP for payment. Linking ap_invoice to legal_invoice enables three-way matching (legal approval → AP posting → payment) and outs' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:paymentRunId rdf:type rdf:Property ;
    rdfs:label 'Payment Run Id' ;
    rdfs:comment 'SAP automatic payment program run identifier (F110) that processed this invoice for payment. Links the invoice to the payment batch for reconciliation and audit.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentRun .

ind:purchaseOrderId rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Id' ;
    rdfs:comment 'Reference to the purchase order against which this invoice is matched as part of the three-way match process (PO/GR/IR). Null if invoice is not PO-backed.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PurchaseOrder .

ind:securityContractId rdf:type rdf:Property ;
    rdfs:label 'Security Contract Id' ;
    rdfs:comment 'Foreign key linking to security.security_contract. Business justification: AP invoice three-way match and payment processing against security service contracts. Finance teams reconcile vendor invoices to specific security contracts for spend control, SLA compliance verificat' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SecurityContract .

ind:slaIncidentId rdf:type rdf:Property ;
    rdfs:label 'Sla Incident Id' ;
    rdfs:comment 'Foreign key linking to platform.sla_incident. Business justification: SLA breach penalties against broadcast/platform vendors are processed as AP credit notes or invoice deductions. The AP invoice must reference the triggering SLA incident for audit trail and vendor dis' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SlaIncident .

ind:baselineDate rdf:type rdf:Property ;
    rdfs:label 'Baseline Date' ;
    rdfs:comment 'The reference date from which payment terms are calculated in SAP FI-AP. May differ from invoice date or receipt date depending on payment terms configuration.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expenseCategory rdf:type rdf:Property ;
    rdfs:label 'Expense Category' ;
    rdfs:comment 'Financial classification of the invoice as capital expenditure (CAPEX), operating expenditure (OPEX), prepaid expense, accrual, or intercompany charge. Drives balance sheet vs. P&L treatment and EBITDA impact.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goodsReceiptNumber rdf:type rdf:Property ;
    rdfs:label 'Goods Receipt Number' ;
    rdfs:comment 'The SAP material document number for the goods receipt or service entry sheet that confirms delivery of goods/services from the vendor. Required for three-way match and accrual reversal.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Internal Order Number' ;
    rdfs:comment 'SAP CO internal order number for project-based or event-specific cost tracking (e.g., a specific concert, championship event, or venue renovation). Enables event-level P&L and ROI analysis.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Date' ;
    rdfs:comment 'The date printed on the vendor\'s invoice document. Used as the baseline for payment terms calculation and aging analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceStatus rdf:type rdf:Property ;
    rdfs:label 'Invoice Status' ;
    rdfs:comment 'Current workflow status of the invoice in the AP processing lifecycle. [ENUM-REF-CANDIDATE: RECEIVED|UNDER_REVIEW|APPROVED|POSTED|SCHEDULED|PAID|BLOCKED|CANCELLED — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceType rdf:type rdf:Property ;
    rdfs:label 'Invoice Type' ;
    rdfs:comment 'Classification of the invoice document type. STANDARD: regular vendor invoice; CREDIT_MEMO: vendor credit note; DEBIT_MEMO: debit adjustment; RECURRING: periodic service invoice; PREPAYMENT: advance payment request; INTERCOMPANY: intra-group settlement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:localCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Local Currency Amount' ;
    rdfs:comment 'The net invoice amount translated to the company code\'s local (functional) currency using the exchange rate at posting date. Required for consolidated financial reporting and EBITDA calculation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentBlockReason rdf:type rdf:Property ;
    rdfs:label 'Payment Block Reason' ;
    rdfs:comment 'Reason code explaining why the invoice payment has been blocked in SAP FI-AP. [ENUM-REF-CANDIDATE: MANUAL_HOLD|PRICE_VARIANCE|QUANTITY_VARIANCE|DUPLICATE|MISSING_PO|PENDING_APPROVAL|DISPUTE|NONE — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentDate rdf:type rdf:Property ;
    rdfs:label 'Payment Date' ;
    rdfs:comment 'The actual date on which payment was disbursed to the vendor. Used for DPO (Days Payable Outstanding) calculation, cash flow reporting, and vendor relationship management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Document Number' ;
    rdfs:comment 'SAP FI document number of the outgoing payment that cleared this invoice. Used for bank reconciliation, audit trail, and dispute resolution with vendors.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTermsCode rdf:type rdf:Property ;
    rdfs:label 'Payment Terms Code' ;
    rdfs:comment 'SAP payment terms key (e.g., NT30, 2/10NET30) defining the payment due date calculation, early payment discount percentage, and discount period. Drives cash flow forecasting and working capital management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingDate rdf:type rdf:Property ;
    rdfs:label 'Posting Date' ;
    rdfs:comment 'The date the invoice was posted to the general ledger in SAP FI. Determines the accounting period for revenue recognition and expense allocation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:profitCenterCode rdf:type rdf:Property ;
    rdfs:label 'Profit Center Code' ;
    rdfs:comment 'SAP Controlling profit center to which the invoice cost is attributed. Enables P&L reporting by business unit (e.g., league operations, venue, broadcast, merchandise) for EBITDA segmentation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptDate rdf:type rdf:Property ;
    rdfs:label 'Receipt Date' ;
    rdfs:comment 'The date the invoice was physically or electronically received by the accounts payable department. Determines the start of the payment terms clock and early payment discount eligibility.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sapDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Document Number' ;
    rdfs:comment 'The 10-digit SAP FI document number assigned upon posting of the invoice in SAP S/4HANA. Serves as the system-of-record identifier for audit trail and journal entry cross-reference.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threeWayMatchStatus rdf:type rdf:Property ;
    rdfs:label 'Three Way Match Status' ;
    rdfs:comment 'Result of the three-way match validation between the Purchase Order (PO), Goods Receipt (GR), and Invoice Receipt (IR) in SAP MM-IV. MATCHED: all three documents align within tolerance; PARTIAL_MATCH: partial quantity or price variance; UNMATCHED: significant discrepancy; NOT_APPLICABLE: non-PO invoice.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorCategory rdf:type rdf:Property ;
    rdfs:label 'Vendor Category' ;
    rdfs:comment 'Business classification of the vendor type for spend analytics and category management. [ENUM-REF-CANDIDATE: VENUE_SERVICES|BROADCAST_EQUIPMENT|ATHLETE_AGENT|MERCHANDISE_MFG|MEDIA_RIGHTS|CONTENT_PRODUCTION|FACILITY_MGMT|TECHNOLOGY|PROFESSIONAL_SERVICES|OTHER — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorInvoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Invoice Number' ;
    rdfs:comment 'The invoice number as printed on the vendor\'s source document. Used for three-way match reconciliation and vendor dispute resolution. Must be unique per vendor account.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerAccountId rdf:type rdf:Property ;
    rdfs:label 'Customer Account Id' ;
    rdfs:comment 'Reference to the customer master record (debtor/payer) in the AR sub-ledger. Corresponds to the SAP FI-AR customer (KUNNR) account to whom the invoice is issued — sponsors, broadcast rights licensees, merchandise wholesale buyers, or premium suite holders.' ;
    rdfs:domain ind:ArInvoice ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:groupSaleId rdf:type rdf:Property ;
    rdfs:label 'Group Sale Id' ;
    rdfs:comment 'Foreign key linking to ticketing.group_sale. Business justification: Group sales generate AR invoices for deposits and final payments. Linking ar_invoice to group_sale enables group sales billing reconciliation, payment tracking against negotiated terms, and collection' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GroupSale .

ind:amountPaid rdf:type rdf:Property ;
    rdfs:label 'Amount Paid' ;
    rdfs:comment 'Cumulative amount received from the customer against this invoice to date. Enables partial payment tracking and outstanding balance calculation (net_amount - amount_paid). Updated upon each payment clearing in SAP FI-AR.' ;
    rdfs:domain ind:ArInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingDate rdf:type rdf:Property ;
    rdfs:label 'Billing Date' ;
    rdfs:comment 'The date on which the invoice was issued and sent to the customer. Represents the principal business event date for revenue recognition purposes. Maps to SAP FKDAT (billing date on SD billing document) or BLDAT (document date on FI posting).' ;
    rdfs:domain ind:ArInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:clearingDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Clearing Document Number' ;
    rdfs:comment 'SAP FI clearing document number (AUGBL) assigned when the invoice is fully or partially cleared by a payment, credit memo, or write-off. Null if the invoice remains open. Provides the AR-to-payment audit trail.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deferredRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Deferred Revenue Amount' ;
    rdfs:comment 'Portion of the gross_amount that has been billed but not yet recognized as revenue because the associated performance obligation (e.g., season sponsorship activation, multi-year broadcast rights) has not been fully satisfied. Feeds the deferred revenue liability on the balance sheet.' ;
    rdfs:domain ind:ArInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeReasonCode rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason Code' ;
    rdfs:comment 'Standardized code identifying the reason a customer has disputed this invoice (e.g., pricing discrepancy, delivery shortfall, contract breach). Populated when payment_status = \'disputed\'. Supports AR dispute management workflow in SAP FI-AR Collections Management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dunningBlock rdf:type rdf:Property ;
    rdfs:label 'Dunning Block' ;
    rdfs:comment 'Indicates whether dunning is blocked for this invoice (MANSP in SAP). True = dunning is suppressed (e.g., invoice under dispute or special arrangement). False = dunning proceeds normally.' ;
    rdfs:domain ind:ArInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dunningDate rdf:type rdf:Property ;
    rdfs:label 'Dunning Date' ;
    rdfs:comment 'Date on which the most recent dunning notice was issued to the customer for this invoice (MADAT in SAP). Used to schedule the next dunning run and track collections escalation timeline.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dunningLevel rdf:type rdf:Property ;
    rdfs:label 'Dunning Level' ;
    rdfs:comment 'Current dunning level (MAHNS in SAP, 0–4) indicating how many dunning notices have been sent to the customer for this overdue invoice. Level 0 = no dunning; Level 4 = final notice / legal escalation. Drives collections workflow.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intercompanyFlag rdf:type rdf:Property ;
    rdfs:label 'Intercompany Flag' ;
    rdfs:comment 'Indicates whether this invoice is an intercompany transaction between two Sports Entertainment legal entities (True) or an external customer invoice (False). Intercompany invoices require elimination in consolidated financial statements per SOX and SEC reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:invoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Invoice Number' ;
    rdfs:comment 'Externally-visible, human-readable invoice document number assigned by SAP FI-AR (e.g., AR-202400012345). Used on billing documents sent to sponsors, broadcast licensees, merchandise wholesale buyers, and premium suite holders. Maps to SAP BELNR field on BKPF/VBRK.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentBlock rdf:type rdf:Property ;
    rdfs:label 'Payment Block' ;
    rdfs:comment 'Indicates whether the invoice is blocked from being cleared by an incoming payment (ZLSPR in SAP). True = payment blocked pending resolution (e.g., dispute, credit check). False = payment can be applied.' ;
    rdfs:domain ind:ArInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referenceDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Document Number' ;
    rdfs:comment 'External reference number provided by the customer (e.g., purchase order number, contract reference, deal ID from Salesforce CRM). Maps to SAP XBLNR field. Enables customer-side reconciliation and dispute resolution.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueCategory rdf:type rdf:Property ;
    rdfs:label 'Revenue Category' ;
    rdfs:comment 'Business classification of the revenue stream being billed. Aligns with Sports Entertainment\'s primary revenue lines: sponsorship fees, broadcast rights licensing, merchandise wholesale, premium suite/hospitality, ticketing, and IP licensing. Supports EBITDA reporting by revenue segment. [ENUM-REF-CANDIDATE: sponsorship|broadcast_rights|merchandise_wholesale|premium_suite|ticketing|licensing|other — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueRecognitionStatus rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Status' ;
    rdfs:comment 'Indicates the ASC 606 / IFRS 15 revenue recognition status of this invoice. \'pending\' = performance obligation not yet satisfied; \'recognized\' = revenue fully recognized; \'deferred\' = billed in advance of performance; \'partially_recognized\' = multi-element arrangement partially satisfied.' ;
    rdfs:domain ind:ArInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapDocumentType rdf:type rdf:Property ;
    rdfs:label 'Sap Document Type' ;
    rdfs:comment 'SAP FI document type code (BLART) classifying the accounting document (e.g., \'RV\' = billing document transfer, \'DR\' = customer invoice, \'DG\' = customer credit memo). Preserves source system classification for reconciliation and audit.' ;
    rdfs:domain ind:ArInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffAmount rdf:type rdf:Property ;
    rdfs:label 'Write Off Amount' ;
    rdfs:comment 'Amount of the invoice that has been written off as uncollectable bad debt. Populated when payment_status = \'written_off\'. Feeds the bad debt expense account and allowance for doubtful accounts on the balance sheet.' ;
    rdfs:domain ind:ArInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditTrailId rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Id' ;
    rdfs:comment 'Unique surrogate identifier for each audit trail record in the financial transaction audit log. Primary key for the finance.audit_trail data product.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approverUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approver User Employee Id' ;
    rdfs:comment 'SAP user ID of the final or most recent approver in the approval chain for this financial change. Supports SOX key control testing for approval threshold compliance.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:approverUserId rdf:type rdf:Property ;
    rdfs:label 'Approver User Id' ;
    rdfs:comment 'SAP user ID of the final or most recent approver in the approval chain for this financial change. Supports SOX key control testing for approval threshold compliance.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:holdId rdf:type rdf:Property ;
    rdfs:label 'Hold Id' ;
    rdfs:comment 'Foreign key linking to legal.legal_hold. Business justification: When a legal hold is issued, financial audit trail records must be preserved for eDiscovery. Linking audit_trail to legal_hold enables identification of financial records under legal hold, supporting ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Hold .

ind:primaryAuditEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Audit Employee Id' ;
    rdfs:comment 'The SAP user ID (login name) of the individual who performed the financial record modification. Core SOX accountability field linking the change to a specific authorized user. Sourced from SAP CDHDR USERNAME.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:reviewedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Reviewed By User Employee Id' ;
    rdfs:comment 'User ID of the SOX control tester or internal auditor who reviewed and signed off this audit trail record. Provides evidence of the review procedure required under SOX Section 404 management assessment.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:afterValue rdf:type rdf:Property ;
    rdfs:label 'After Value' ;
    rdfs:comment 'The field value immediately after the change was applied (new value). Stored as STRING to accommodate all field types. Paired with before_value for complete change delta documentation required by SOX.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalChain rdf:type rdf:Property ;
    rdfs:label 'Approval Chain' ;
    rdfs:comment 'Ordered sequence of approver user IDs and timestamps representing the full approval workflow for the audited change (e.g., \'USER_A:2024-03-01T10:00:00Z > USER_B:2024-03-01T11:30:00Z\'). Captures the complete authorization chain required for SOX multi-level approval controls.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditEventNumber rdf:type rdf:Property ;
    rdfs:label 'Audit Event Number' ;
    rdfs:comment 'Externally-visible, human-readable sequential reference number assigned to this audit event (e.g., AUD-2024-0001234). Used for cross-referencing in SOX control documentation and external audit packages.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrailStatus rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Status' ;
    rdfs:comment 'Lifecycle status of this audit trail record within the SOX review workflow. REVIEWED indicates a SOX control tester has examined and signed off the record. ESCALATED indicates a control exception requiring management attention. VOIDED indicates the record was invalidated due to data quality issues.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditedObjectNumber rdf:type rdf:Property ;
    rdfs:label 'Audited Object Number' ;
    rdfs:comment 'The business-facing document or reference number of the audited object (e.g., SAP document number, invoice number, payment run ID). Provides human-readable traceability without requiring a join.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditedObjectReference rdf:type rdf:Property ;
    rdfs:label 'Audited Object Reference' ;
    rdfs:comment 'Surrogate key of the specific financial record that was modified (e.g., the journal_entry_id, ap_invoice_id, or payment_id). Used to join back to the source entity for full context.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditedObjectType rdf:type rdf:Property ;
    rdfs:label 'Audited Object Type' ;
    rdfs:comment 'The type of financial object that was modified and captured in this audit record. Identifies which SAP S/4HANA FI/CO entity class the change applies to. [ENUM-REF-CANDIDATE: JOURNAL_ENTRY|AP_INVOICE|AR_INVOICE|PAYMENT|BUDGET|WBS_ELEMENT|FIXED_ASSET|COST_CENTER|GL_ACCOUNT|REVENUE_RECOGNITION — promote to reference product]' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beforeValue rdf:type rdf:Property ;
    rdfs:label 'Before Value' ;
    rdfs:comment 'The field value immediately before the change was applied (old value). Stored as STRING to accommodate all field types. Essential for SOX before/after comparison and financial restatement investigations.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:changeType rdf:type rdf:Property ;
    rdfs:label 'Change Type' ;
    rdfs:comment 'The nature of the modification captured in this audit record. Distinguishes between initial creation, field-level updates, reversals, approvals, rejections, and posting locks. Critical for SOX segregation-of-duties analysis. [ENUM-REF-CANDIDATE: CREATE|UPDATE|DELETE|REVERSE|APPROVE|REJECT|LOCK|UNLOCK — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changedByRole rdf:type rdf:Property ;
    rdfs:label 'Changed By Role' ;
    rdfs:comment 'The SAP authorization role or job function of the user who made the change at the time of the event (e.g., \'AP_CLERK\', \'GL_ACCOUNTANT\', \'FINANCE_CONTROLLER\'). Used for segregation-of-duties (SOD) analysis in SOX testing.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changedByUserName rdf:type rdf:Property ;
    rdfs:label 'Changed By User Name' ;
    rdfs:comment 'Full display name of the user who performed the modification. Provides human-readable identity for audit reports and SOX control testing packages without requiring a join to HR master data.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changedFieldLabel rdf:type rdf:Property ;
    rdfs:label 'Changed Field Label' ;
    rdfs:comment 'Human-readable business label for the changed field (e.g., \'Posting Date\', \'Transaction Amount\', \'Approval Status\'). Derived from SAP data element text to support non-technical audit reviewers.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changedFieldName rdf:type rdf:Property ;
    rdfs:label 'Changed Field Name' ;
    rdfs:comment 'The technical or business name of the specific field that was modified within the audited financial object (e.g., \'posting_date\', \'transaction_amount\', \'approval_status\'). Sourced from SAP CDPOS field name.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlExceptionFlag rdf:type rdf:Property ;
    rdfs:label 'Control Exception Flag' ;
    rdfs:comment 'Indicates that this audit event represents a deviation from the expected SOX control procedure (e.g., approval bypass, retroactive posting, unauthorized field change). Triggers escalation workflow to the SOX control owner.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionReason rdf:type rdf:Property ;
    rdfs:label 'Exception Reason' ;
    rdfs:comment 'Free-text or coded explanation for why a control exception occurred (e.g., \'Emergency posting — system outage\', \'Approval threshold exceeded without secondary sign-off\'). Required when control_exception_flag is True.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountCode rdf:type rdf:Property ;
    rdfs:label 'Gl Account Code' ;
    rdfs:comment 'The General Ledger account code associated with the audited financial transaction. Enables financial statement impact assessment and supports SOX control mapping to specific P&L or balance sheet line items.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalIndicator rdf:type rdf:Property ;
    rdfs:label 'Reversal Indicator' ;
    rdfs:comment 'Indicates whether the audited financial transaction is a reversal of a previously posted document. Reversals require specific SOX approval controls and are flagged for period-end close review.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason Code' ;
    rdfs:comment 'SAP reversal reason code explaining why the financial document was reversed (e.g., \'01\' = Reversal in current period, \'02\' = Reversal in prior period). Required for SOX journal entry control documentation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewTimestamp rdf:type rdf:Property ;
    rdfs:label 'Review Timestamp' ;
    rdfs:comment 'Date and time when the SOX control tester completed their review of this audit trail record. Used to demonstrate timely review of financial changes as required by SOX 404 control procedures.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sapChangeDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Change Document Number' ;
    rdfs:comment 'The SAP change document number (CDHDR-CHANGENR) that uniquely identifies the change document in the SAP S/4HANA system. Enables direct traceability back to the source system change record for external auditor verification.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapObjectClass rdf:type rdf:Property ;
    rdfs:label 'Sap Object Class' ;
    rdfs:comment 'The SAP change document object class (CDHDR-OBJECTCLAS) identifying the SAP business object type that was changed (e.g., \'BELEG\' for FI documents, \'KAUF\' for purchase orders). Supports precise source-system traceability.' ;
    rdfs:domain ind:AuditTrail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soxRelevant rdf:type rdf:Property ;
    rdfs:label 'Sox Relevant' ;
    rdfs:comment 'Indicates whether this audit event is in scope for Sarbanes-Oxley Section 404 internal control over financial reporting (ICFR). True for changes to key financial statement line items, approval overrides, and period-end adjustments.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transactionAmount rdf:type rdf:Property ;
    rdfs:label 'Transaction Amount' ;
    rdfs:comment 'The monetary value of the audited financial transaction at the time of the change event. Used for approval threshold validation — changes above defined materiality thresholds require additional SOX approval levels.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Budget Employee Id' ;
    rdfs:comment 'Reference to the employee or manager responsible for this budget record, sourced from SAP SuccessFactors HCM. The budget owner is accountable for variance explanations and reforecast submissions.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:budgetName rdf:type rdf:Property ;
    rdfs:label 'Budget Name' ;
    rdfs:comment 'Human-readable descriptive name for the budget record (e.g., \'FY2025 Event Operations OPEX Base Budget\'). Used in FP&A reporting and investor relations presentations.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetNumber rdf:type rdf:Property ;
    rdfs:label 'Budget Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier for the budget record as assigned in Workday Adaptive Planning or SAP CO. Used for cross-system reconciliation and audit traceability.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committedAmount rdf:type rdf:Property ;
    rdfs:label 'Committed Amount' ;
    rdfs:comment 'Amount of the budget that has been legally committed via purchase orders, contracts, or reservations in SAP MM/SD but not yet invoiced. Represents encumbered funds for budget availability control.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costElementCode rdf:type rdf:Property ;
    rdfs:label 'Cost Element Code' ;
    rdfs:comment 'SAP CO cost element code that classifies the nature of the planned expenditure (e.g., salaries, venue hire, broadcast rights fees). Enables cost element-level variance analysis.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveToDate rdf:type rdf:Property ;
    rdfs:label 'Effective To Date' ;
    rdfs:comment 'The end date through which this budget record is effective. Aligns with the fiscal period end date. Used to manage multi-year plan validity windows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastAmount rdf:type rdf:Property ;
    rdfs:label 'Forecast Amount' ;
    rdfs:comment 'Latest rolling forecast amount for the fiscal period as updated in Workday Adaptive Planning. Reflects the most current expectation of financial outcome, incorporating actuals-to-date and revised forward projections.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:functionalArea rdf:type rdf:Property ;
    rdfs:label 'Functional Area' ;
    rdfs:comment 'SAP FI functional area classification for the budget record (e.g., \'Event Operations\', \'Broadcast\', \'Athlete Management\', \'Venue Operations\'). Supports functional P&L and SEC segment reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isIntercompany rdf:type rdf:Property ;
    rdfs:label 'Is Intercompany' ;
    rdfs:comment 'Indicates whether this budget record relates to an intercompany transaction between legal entities within the Sports Entertainment group. True = intercompany; False = third-party. Required for intercompany elimination in consolidated financial reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lockDate rdf:type rdf:Property ;
    rdfs:label 'Lock Date' ;
    rdfs:comment 'Date on which the budget record was locked in SAP CO, preventing further manual adjustments. Ensures integrity of the approved baseline for variance reporting.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodGranularity rdf:type rdf:Property ;
    rdfs:label 'Period Granularity' ;
    rdfs:comment 'Indicates whether the budget record is expressed at monthly, quarterly, or annual granularity. Determines how fiscal_period is interpreted in FP&A reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planType rdf:type rdf:Property ;
    rdfs:label 'Plan Type' ;
    rdfs:comment 'Distinguishes the planning horizon: annual_budget (single fiscal year), multi_year_plan (3–5 year strategic plan), or rolling_forecast (continuous 12–18 month forward view). Supports FP&A and investor relations cycles.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorYearActualAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Year Actual Amount' ;
    rdfs:comment 'Actual amount posted for the equivalent fiscal period in the prior fiscal year. Used as a benchmark for year-over-year variance analysis and budget calibration in FP&A.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Reporting Currency Amount' ;
    rdfs:comment 'Planned amount translated to the group reporting currency (USD) using the exchange_rate. Enables consolidated EBITDA reporting and SEC financial disclosures across multi-currency global operations.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scenarioType rdf:type rdf:Property ;
    rdfs:label 'Scenario Type' ;
    rdfs:comment 'Financial planning scenario classification: base (most likely), upside (optimistic), downside (pessimistic), or stress (extreme adverse). Used for EBITDA projections and investor relations guidance.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashFlowForecastId rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Forecast Id' ;
    rdfs:comment 'Unique surrogate identifier for each cash flow forecast record in the Silver Layer lakehouse. Primary key for this entity.' ;
    rdfs:domain ind:CashFlowForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:counterpartyId rdf:type rdf:Property ;
    rdfs:label 'Counterparty Id' ;
    rdfs:comment 'Foreign key linking to finance.counterparty. Business justification: Cash flow forecasts track expected inflows/outflows by counterparty (customers, vendors, partners). Normalizes counterparty_name and counterparty_type STRING columns by linking to counterparty master.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Counterparty .

ind:actualAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Amount' ;
    rdfs:comment 'The realised cash inflow or outflow amount for the period, sourced from SAP FI actuals. Populated after period close to enable forecast-vs-actual variance analysis and FP&A reporting.' ;
    rdfs:domain ind:CashFlowForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashFlowCategory rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Category' ;
    rdfs:comment 'Directional classification of the cash flow record. Inflow represents projected receipts (ticket sales, broadcast payments, sponsorship instalments, merchandise revenue); outflow represents projected disbursements (payroll, venue operations, content production costs).' ;
    rdfs:domain ind:CashFlowForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashFlowType rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Type' ;
    rdfs:comment 'IAS 7 / ASC 230 classification of the cash flow into operating, investing, or financing activities. Operating covers day-to-day business receipts and payments; investing covers capital expenditure and asset disposals; financing covers debt, equity, and dividend transactions.' ;
    rdfs:domain ind:CashFlowForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastNumber rdf:type rdf:Property ;
    rdfs:label 'Forecast Number' ;
    rdfs:comment 'Externally-known business identifier for the forecast record, formatted as CFF-{YYYY}-{NNNNNN}. Used for cross-system reference and audit trail in SAP S/4HANA Liquidity Planning and Workday Adaptive Planning.' ;
    rdfs:domain ind:CashFlowForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastStatus rdf:type rdf:Property ;
    rdfs:label 'Forecast Status' ;
    rdfs:comment 'Current lifecycle state of the forecast record. Draft indicates work-in-progress; submitted awaits approval; approved is the authorised version; locked is period-closed; superseded is replaced by a newer version; cancelled is voided.' ;
    rdfs:domain ind:CashFlowForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastVersion rdf:type rdf:Property ;
    rdfs:label 'Forecast Version' ;
    rdfs:comment 'Monotonically incrementing version number for the forecast record within a given period and business unit. Enables tracking of iterative revisions and scenario comparisons over the planning cycle.' ;
    rdfs:domain ind:CashFlowForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:probabilityPct rdf:type rdf:Property ;
    rdfs:label 'Probability Pct' ;
    rdfs:comment 'Estimated probability (0–100%) that this projected cash flow will materialise as forecast. Used in risk-weighted cash flow models and scenario analysis, particularly for variable consideration items such as PPV revenue and performance-based sponsorship bonuses.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedAmount rdf:type rdf:Property ;
    rdfs:label 'Projected Amount' ;
    rdfs:comment 'The gross projected cash inflow or outflow amount for the forecast period in the transaction currency. Represents the base forecast before any adjustments or variance calculations.' ;
    rdfs:domain ind:CashFlowForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisedProjectedAmount rdf:type rdf:Property ;
    rdfs:label 'Revised Projected Amount' ;
    rdfs:comment 'Updated projected cash flow amount following a mid-cycle reforecast or management adjustment. Captures the most current forecast estimate when the original projection has been revised.' ;
    rdfs:domain ind:CashFlowForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceAmount rdf:type rdf:Property ;
    rdfs:label 'Variance Amount' ;
    rdfs:comment 'Absolute difference between the projected (or revised projected) amount and the actual amount for the period. Positive variance indicates actuals exceeded forecast (favourable for inflows, unfavourable for outflows); negative indicates shortfall.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:companyCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Company Corporate Entity Id' ;
    rdfs:comment 'SAP S/4HANA company identifier (distinct from company code) used for consolidation purposes in the group financial statements. Links the company code to the consolidation unit in SAP Group Reporting for SEC consolidated financial reporting.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:accountingStandard rdf:type rdf:Property ;
    rdfs:label 'Accounting Standard' ;
    rdfs:comment 'The accounting standard framework applied to the financial statements of this company code. US_GAAP for SEC-registered US entities, IFRS for international subsidiaries, LOCAL_GAAP for statutory reporting in specific jurisdictions.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessArea rdf:type rdf:Property ;
    rdfs:label 'Business Area' ;
    rdfs:comment 'SAP S/4HANA business area code assigned to this company code for cross-company-code segment reporting. Represents a distinct business segment such as League Operations, Broadcast, Venue Management, or Merchandise. Supports EBITDA reporting by business segment per SEC ASC 280.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chartOfAccounts rdf:type rdf:Property ;
    rdfs:label 'Chart Of Accounts' ;
    rdfs:comment 'Four-character SAP S/4HANA chart of accounts key assigned to this company code (e.g., \'SPRT\'). Defines the general ledger account structure, account groups, and account number ranges used for all financial postings. Required for SOX-compliant financial controls and SEC reporting.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:companyCodeCode rdf:type rdf:Property ;
    rdfs:label 'Company Code Code' ;
    rdfs:comment 'The four-character alphanumeric SAP S/4HANA company code that uniquely identifies the legal entity within the enterprise organizational structure. Aligns with the SAP FI company code field (BUKRS). Used in all intercompany postings, chart of accounts assignments, and SEC financial reporting.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:companyCodeStatus rdf:type rdf:Property ;
    rdfs:label 'Company Code Status' ;
    rdfs:comment 'Current lifecycle status of the company code within the SAP S/4HANA organizational structure. Controls whether new financial postings, purchase orders, and sales documents can be created against this entity. \'in_liquidation\' triggers SOX disclosure requirements.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consolidationUnit rdf:type rdf:Property ;
    rdfs:label 'Consolidation Unit' ;
    rdfs:comment 'The consolidation unit identifier in SAP S/4HANA Group Reporting that maps this company code to the group consolidation structure. Used for automated intercompany elimination, minority interest calculation, and SEC consolidated financial statement preparation.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controllingArea rdf:type rdf:Property ;
    rdfs:label 'Controlling Area' ;
    rdfs:comment 'Four-character SAP S/4HANA Controlling (CO) area code to which this company code is assigned. The controlling area is the organizational unit for cost accounting, cost center hierarchies, internal orders, and EBITDA reporting. A single controlling area may span multiple company codes for consolidated management reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditControlArea rdf:type rdf:Property ;
    rdfs:label 'Credit Control Area' ;
    rdfs:comment 'SAP S/4HANA credit control area assigned to this company code, governing credit limit management for sponsorship deals, broadcast rights receivables, and merchandise licensing. Controls credit exposure across the SD (Sales and Distribution) module.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentNumberRange rdf:type rdf:Property ;
    rdfs:label 'Document Number Range' ;
    rdfs:comment 'SAP S/4HANA document number range interval assigned to this company code for financial document numbering. Ensures sequential, gap-free document numbering required for SOX audit trails and SEC financial reporting integrity.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldStatusVariant rdf:type rdf:Property ;
    rdfs:label 'Field Status Variant' ;
    rdfs:comment 'SAP S/4HANA field status variant assigned to this company code, controlling which fields are required, optional, or suppressed during financial document entry. Enforces data quality standards for SOX-compliant financial postings.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalYearVariant rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year Variant' ;
    rdfs:comment 'Two-character SAP S/4HANA fiscal year variant code that defines the fiscal year structure for this company code (e.g., \'K4\' for calendar year, \'V3\' for April–March). Governs period-end closing, financial statement preparation, and FP&A planning cycles in Workday Adaptive Planning.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Functional Currency Code' ;
    rdfs:comment 'ISO 4217 functional currency code as defined under IFRS IAS 21 or US GAAP ASC 830, representing the currency of the primary economic environment in which the entity operates. May differ from local currency for entities with predominantly USD-denominated broadcast rights or sponsorship revenues.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Group Currency Code' ;
    rdfs:comment 'ISO 4217 currency code for the group (parent) reporting currency used in consolidated financial statements (e.g., \'USD\' for the Sports Entertainment parent). All company code financials are translated to this currency for SEC consolidated reporting and EBITDA roll-up.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hardCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Hard Currency Code' ;
    rdfs:comment 'ISO 4217 currency code for the hard currency (index currency) used in high-inflation countries per SAP S/4HANA parallel valuation. Applicable for Sports Entertainment entities operating in hyperinflationary economies per IFRS IAS 29.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incorporationDate rdf:type rdf:Property ;
    rdfs:label 'Incorporation Date' ;
    rdfs:comment 'The date on which the legal entity was formally incorporated or registered with the relevant government authority. Used in SEC filings, SOX attestations, and legal entity lifecycle management.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:intercompanyClearingAccount rdf:type rdf:Property ;
    rdfs:label 'Intercompany Clearing Account' ;
    rdfs:comment 'General ledger account number used for intercompany clearing transactions between Sports Entertainment subsidiaries (e.g., broadcast rights fees from broadcast network entity to league operating company). Critical for SOX-compliant intercompany elimination in consolidated SEC reporting.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageKey rdf:type rdf:Property ;
    rdfs:label 'Language Key' ;
    rdfs:comment 'ISO 639-1 two-letter language code representing the primary business language for this company code in SAP S/4HANA (e.g., \'EN\', \'DE\', \'FR\'). Governs the language used for financial documents, correspondence, and system output for this entity.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityIdentifier rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Identifier' ;
    rdfs:comment '20-character ISO 17442 Legal Entity Identifier (LEI) assigned by a Local Operating Unit (LOU) for publicly traded or regulated Sports Entertainment entities. Required for SEC financial reporting, derivatives reporting under Dodd-Frank, and international regulatory filings.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minorityInterestPct rdf:type rdf:Property ;
    rdfs:label 'Minority Interest Pct' ;
    rdfs:comment 'Percentage of the legal entity\'s equity not owned by the Sports Entertainment parent, representing non-controlling interest. Used in SEC consolidated financial statements for minority interest disclosure and EBITDA attribution. Range 0.00 to 100.00.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parentCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Parent Company Code' ;
    rdfs:comment 'The SAP S/4HANA company code of the immediate parent entity in the legal entity hierarchy. Enables hierarchical traversal of the Sports Entertainment corporate structure for intercompany settlement, consolidation, and segment reporting. Null for the ultimate parent holding company.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingPeriodVariant rdf:type rdf:Property ;
    rdfs:label 'Posting Period Variant' ;
    rdfs:comment 'SAP S/4HANA posting period variant assigned to this company code, controlling which fiscal periods are open or closed for financial postings. Enforces period-end close discipline and SOX-compliant financial controls by preventing backdated entries.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenterStandardHierarchy rdf:type rdf:Property ;
    rdfs:label 'Profit Center Standard Hierarchy' ;
    rdfs:comment 'Name of the SAP S/4HANA profit center standard hierarchy node to which this company code\'s profit centers are assigned. Enables segment-level EBITDA reporting and management accounting roll-ups across league, broadcast, venue, and merchandise business units.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secReportingEntity rdf:type rdf:Property ;
    rdfs:label 'Sec Reporting Entity' ;
    rdfs:comment 'Indicates whether this company code is a registrant or consolidated subsidiary required to be included in SEC financial filings (10-K, 10-Q, 8-K). Drives inclusion in the consolidation perimeter for group financial reporting.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:streetAddress rdf:type rdf:Property ;
    rdfs:label 'Street Address' ;
    rdfs:comment 'Street address of the registered office or principal place of business for the legal entity. Used in SEC filings, regulatory correspondence, and legal notices. Classified as confidential organizational contact data.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Registration Number' ;
    rdfs:comment 'Government-issued tax identification number for the legal entity (e.g., US Employer Identification Number (EIN), EU VAT registration number). Required for tax filings, vendor invoicing, and regulatory reporting. Stored as confidential business data.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vatRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Vat Registration Number' ;
    rdfs:comment 'Value Added Tax (VAT) registration number for entities operating in VAT-applicable jurisdictions (EU, UK, etc.). Used on broadcast rights invoices, sponsorship agreements, and merchandise licensing contracts. Distinct from the domestic tax registration number.' ;
    rdfs:domain ind:CompanyCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCostEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Cost Employee Id' ;
    rdfs:comment 'Reference to the employee or manager accountable for cost center budget adherence and operational performance. Maps to the SAP CO \'Person Responsible\' field and is used for budget approval workflows and variance escalation in Workday Adaptive Planning.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:activityTypeCode rdf:type rdf:Property ;
    rdfs:label 'Activity Type Code' ;
    rdfs:comment 'Primary SAP CO activity type associated with this cost center, representing the unit of output or service provided (e.g., \'BROADCAST_HR\' for broadcast production hours, \'VENUE_DAY\' for venue operating days). Used for activity-based cost allocation and internal service pricing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationMethod rdf:type rdf:Property ;
    rdfs:label 'Allocation Method' ;
    rdfs:comment 'Method used to allocate or settle costs from this cost center to other cost objects at period end: direct (direct activity allocation), assessment (using assessment cycles), distribution (using distribution cycles), activity_based (ABC costing), or statistical (for reporting only, no actual settlement).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetAmount rdf:type rdf:Property ;
    rdfs:label 'Budget Amount' ;
    rdfs:comment 'Total approved annual budget allocated to this cost center for the current fiscal year, expressed in the cost center\'s primary currency. Sourced from Workday Adaptive Planning and loaded into SAP CO for variance reporting. Used in EBITDA forecasting and FP&A dashboards.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:controllingAreaCode rdf:type rdf:Property ;
    rdfs:label 'Controlling Area Code' ;
    rdfs:comment 'SAP CO controlling area to which this cost center belongs. The controlling area defines the organizational unit within which cost accounting is performed and cross-company cost allocations are managed (e.g., \'SE01\' for Sports Entertainment North America).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterCategory rdf:type rdf:Property ;
    rdfs:label 'Cost Center Category' ;
    rdfs:comment 'Single-character or two-character SAP CO cost center category code that controls which activity types and statistical key figures can be posted (e.g., \'A\' = general, \'B\' = production, \'F\' = financial). Determines default allocation rules and reporting groupings.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterDescription rdf:type rdf:Property ;
    rdfs:label 'Cost Center Description' ;
    rdfs:comment 'Free-text description of the cost center\'s business purpose, scope of operations, and cost accountability. Provides context for financial analysts, auditors, and FP&A teams beyond what the name and code convey (e.g., \'Responsible for all operational costs of the home venue including HVAC, BMS, security, and event-day staffing\').' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterName rdf:type rdf:Property ;
    rdfs:label 'Cost Center Name' ;
    rdfs:comment 'Full descriptive name of the cost center as maintained in SAP CO master data (e.g., \'Venue Operations — Staples Center\', \'Broadcast Production — NFL Sunday Package\'). Used in financial reports, budget dashboards, and FP&A outputs.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterStatus rdf:type rdf:Property ;
    rdfs:label 'Cost Center Status' ;
    rdfs:comment 'Current lifecycle status of the cost center in SAP CO: active (accepting postings), inactive (temporarily suspended), locked (blocked for all postings), pending_activation (created but not yet effective), or archived (historical, no postings allowed). Drives period-end close controls and SOX compliance checks.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterType rdf:type rdf:Property ;
    rdfs:label 'Cost Center Type' ;
    rdfs:comment 'SAP CO cost center category classifying the nature of cost incurrence: overhead (administrative/support), production (direct event/broadcast output), service (shared services), profit (revenue-generating unit tracked as cost center), or investment (capital project support). Drives allocation methodology and EBITDA reporting treatment.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costElementGroup rdf:type rdf:Property ;
    rdfs:label 'Cost Element Group' ;
    rdfs:comment 'SAP CO cost element group defining the set of primary cost elements (GL accounts) that can be posted to this cost center. Controls which expense categories are tracked here (e.g., \'VENUE_OPEX\' for venue operating expenses, \'TALENT_COSTS\' for athlete/performer costs).' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentCode rdf:type rdf:Property ;
    rdfs:label 'Department Code' ;
    rdfs:comment 'Organizational department code associated with this cost center, aligned to the SAP SuccessFactors organizational hierarchy. Enables workforce cost attribution and headcount-to-cost analysis across Sports Entertainment business units.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalYear rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year' ;
    rdfs:comment 'Fiscal year to which the budget amount and planning data for this cost center applies (e.g., 2024, 2025). Aligns with the Sports Entertainment fiscal calendar defined in SAP FI company code settings.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalAreaCode rdf:type rdf:Property ;
    rdfs:label 'Functional Area Code' ;
    rdfs:comment 'SAP FI/CO functional area classifying the cost center by business function for cost-of-sales accounting and segment reporting (e.g., \'ADMIN\', \'SALES\', \'PROD\', \'R&D\'). Required for SEC income statement presentation under US GAAP.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountGroup rdf:type rdf:Property ;
    rdfs:label 'Gl Account Group' ;
    rdfs:comment 'SAP FI GL account group associated with this cost center, defining the range of general ledger accounts used for cost postings. Ensures chart-of-accounts alignment and supports automated financial statement mapping for SEC reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planLock rdf:type rdf:Property ;
    rdfs:label 'Plan Lock' ;
    rdfs:comment 'Indicates whether budget/plan postings to this cost center are currently blocked (True = locked). Prevents changes to approved budgets after the planning cycle is closed in Workday Adaptive Planning and SAP CO.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postingLock rdf:type rdf:Property ;
    rdfs:label 'Posting Lock' ;
    rdfs:comment 'Indicates whether actual cost postings to this cost center are currently blocked (True = locked, no postings allowed). Used during period-end close, organizational restructuring, or SOX audit freeze periods to prevent unauthorized cost entries.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sapChangedBy rdf:type rdf:Property ;
    rdfs:label 'Sap Changed By' ;
    rdfs:comment 'SAP user ID of the person who last modified this cost center master record. Required for SOX change management controls and audit trail. Stored as the SAP logon ID.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapCreatedBy rdf:type rdf:Property ;
    rdfs:label 'Sap Created By' ;
    rdfs:comment 'SAP user ID of the person who created this cost center master record in SAP CO. Required for SOX segregation-of-duties controls and audit trail documentation. Stored as the SAP logon ID (not personal name).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validTo rdf:type rdf:Property ;
    rdfs:label 'Valid To' ;
    rdfs:comment 'Date until which this cost center is active and eligible to receive cost postings. After this date, the cost center is locked for new postings. Null indicates an open-ended validity period. Used for fiscal year planning and organizational restructuring.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsibleEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Responsible Employee Id' ;
    rdfs:comment 'SAP SuccessFactors employee identifier for the person responsible for the physical custody and stewardship of the asset (asset custodian). Used for physical inventory verification and SOX internal control accountability.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accumulatedDepreciation rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation' ;
    rdfs:comment 'Total depreciation charged against the asset from the in-service date to the current reporting period. Contra-asset balance used to calculate net book value. Sourced from SAP FI-AA depreciation simulation/posting runs.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acquisitionCost rdf:type rdf:Property ;
    rdfs:label 'Acquisition Cost' ;
    rdfs:comment 'Original historical cost of the fixed asset at the time of acquisition or capitalization, in the company code currency. Includes purchase price, import duties, and directly attributable costs to bring the asset to its intended use. CAPEX SSOT figure.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualDepreciationCharge rdf:type rdf:Property ;
    rdfs:label 'Annual Depreciation Charge' ;
    rdfs:comment 'Planned annual depreciation expense for the current fiscal year as calculated by SAP FI-AA. Used in FP&A budgeting, EBITDA bridge analysis, and Workday Adaptive Planning depreciation forecasts.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetCategory rdf:type rdf:Property ;
    rdfs:label 'Asset Category' ;
    rdfs:comment 'High-level classification distinguishing tangible assets (stadium structures, OB trucks, scoreboards), intangible assets (broadcast rights, software licenses, NIL-related IP), right-of-use assets (IFRS 16 leases), and investment property. Drives balance sheet line-item presentation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetClassCode rdf:type rdf:Property ;
    rdfs:label 'Asset Class Code' ;
    rdfs:comment 'SAP FI-AA asset class code that determines the depreciation area, useful life defaults, and GL account determination (e.g., \'1000\' for Buildings, \'2000\' for Machinery, \'3000\' for Intangible Assets, \'4000\' for Broadcast Rights). Drives CAPEX categorization and balance sheet classification.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetClassName rdf:type rdf:Property ;
    rdfs:label 'Asset Class Name' ;
    rdfs:comment 'Human-readable name of the SAP asset class (e.g., \'Stadium Structures\', \'Broadcast Equipment\', \'OB Trucks\', \'Digital Platform Infrastructure\', \'Acquired Broadcast Rights\', \'Scoreboards & LED Systems\'). Used in financial reporting and CAPEX dashboards.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetLocationCode rdf:type rdf:Property ;
    rdfs:label 'Asset Location Code' ;
    rdfs:comment 'Physical or logical location code where the asset is deployed (e.g., venue code, broadcast facility code, data center identifier). Supports asset tracking, insurance valuation, and ADA/OSHA compliance reporting for venue assets.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Asset Location Description' ;
    rdfs:comment 'Human-readable description of the asset\'s physical location (e.g., \'Main Stadium – East Stand\', \'Broadcast Tower – Roof Level 3\', \'OB Truck Depot – Training Facility\'). Used in physical asset verification and insurance schedules.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetNumber rdf:type rdf:Property ;
    rdfs:label 'Asset Number' ;
    rdfs:comment 'Externally-known SAP FI-AA asset number (main asset number) assigned at capitalization. Used as the primary business identifier on CAPEX reports, depreciation schedules, and audit trails. Format follows SAP company-code-prefixed numbering convention.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetSubnumber rdf:type rdf:Property ;
    rdfs:label 'Asset Subnumber' ;
    rdfs:comment 'SAP FI-AA sub-number identifying a component or addition to the main asset (e.g., a scoreboard upgrade added to the main stadium structure asset). Enables component-level depreciation tracking.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastRightsExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Expiry Date' ;
    rdfs:comment 'For intangible assets representing acquired broadcast rights (e.g., RSN rights, OTT streaming rights, PPV event rights), the contractual expiry date of the rights. Drives amortization end date and rights renewal planning. Null for tangible assets.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capexBudgetCode rdf:type rdf:Property ;
    rdfs:label 'Capex Budget Code' ;
    rdfs:comment 'Reference to the approved CAPEX budget line item or investment program code in Workday Adaptive Planning / SAP IM (Investment Management) that authorized the acquisition of this asset. Supports CAPEX vs. budget variance reporting.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationAreaCode rdf:type rdf:Property ;
    rdfs:label 'Depreciation Area Code' ;
    rdfs:comment 'SAP FI-AA depreciation area identifier representing the valuation basis (e.g., \'01\' for book depreciation per local GAAP, \'15\' for tax depreciation, \'30\' for IFRS). Enables parallel valuation for SEC reporting and tax compliance.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationMethodCode rdf:type rdf:Property ;
    rdfs:label 'Depreciation Method Code' ;
    rdfs:comment 'SAP FI-AA depreciation key/method code defining the calculation method (e.g., \'LINR\' for straight-line, \'DG30\' for declining balance 30%, \'MANU\' for manual, \'UNIT\' for units-of-production). Determines how accumulated depreciation is calculated each period.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposalDate rdf:type rdf:Property ;
    rdfs:label 'Disposal Date' ;
    rdfs:comment 'Date on which the asset was retired, sold, scrapped, or otherwise disposed of. Triggers the derecognition of the asset from the balance sheet and recognition of any gain or loss on disposal in SAP FI-AA.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disposalProceeds rdf:type rdf:Property ;
    rdfs:label 'Disposal Proceeds' ;
    rdfs:comment 'Net proceeds received upon disposal or sale of the asset. Used to calculate the gain or loss on disposal recognized in the income statement. Relevant for stadium asset sales, OB truck fleet disposals, and broadcast rights expirations.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disposalType rdf:type rdf:Property ;
    rdfs:label 'Disposal Type' ;
    rdfs:comment 'Method by which the asset was disposed of. \'sale\' = sold to third party; \'scrap\' = physically scrapped; \'transfer\' = intercompany or intra-company transfer; \'donation\' = donated; \'write_off\' = written off; \'insurance_claim\' = disposed via insurance settlement (e.g., storm-damaged broadcast tower).' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impairmentLoss rdf:type rdf:Property ;
    rdfs:label 'Impairment Loss' ;
    rdfs:comment 'Cumulative impairment loss recognized on the asset where the carrying amount exceeds the recoverable amount (per IAS 36 / ASC 360). Reduces net book value. Relevant for broadcast rights, goodwill-adjacent intangibles, and underperforming venue assets.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inServiceDate rdf:type rdf:Property ;
    rdfs:label 'In Service Date' ;
    rdfs:comment 'Date the asset was placed into active service and depreciation commenced. May differ from acquisition_date for assets under construction. Drives the depreciation start period in SAP FI-AA.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insurancePolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Insurance Policy Number' ;
    rdfs:comment 'Reference number of the insurance policy covering this asset against loss, damage, or liability. Critical for venue assets (stadium structures), broadcast infrastructure (OB trucks, towers), and high-value equipment. Supports risk management and claims processing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredValue rdf:type rdf:Property ;
    rdfs:label 'Insured Value' ;
    rdfs:comment 'Declared insured replacement value of the asset as agreed with the insurer. May differ from net book value (NBV) for high-value venue and broadcast infrastructure assets. Used for insurance adequacy reviews.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isFullyDepreciated rdf:type rdf:Property ;
    rdfs:label 'Is Fully Depreciated' ;
    rdfs:comment 'Indicates whether the asset has been fully depreciated (net book value equals residual value). Fully depreciated assets still in service are flagged for management review and potential useful life extension assessment per IAS 16.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLeased rdf:type rdf:Property ;
    rdfs:label 'Is Leased' ;
    rdfs:comment 'Indicates whether the asset is a right-of-use (ROU) asset recognized under IFRS 16 / ASC 842 (e.g., leased venue, leased OB truck, leased broadcast satellite capacity). Drives separate balance sheet presentation and lease liability linkage.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastPhysicalVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Last Physical Verification Date' ;
    rdfs:comment 'Date of the most recent physical inventory count or asset verification exercise confirming the asset\'s existence and condition. Required for SOX internal controls and annual audit procedures.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:netBookValue rdf:type rdf:Property ;
    rdfs:label 'Net Book Value' ;
    rdfs:comment 'Current carrying amount of the fixed asset: acquisition_cost plus subsequent_acquisition_cost minus accumulated_depreciation minus impairment_loss. Reported on the balance sheet. Refreshed each period-end close from SAP FI-AA.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:purchaseOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Number' ;
    rdfs:comment 'SAP MM purchase order number associated with the acquisition of the asset. Provides the procurement-to-capitalization audit trail required for SOX compliance and CAPEX authorization controls.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualValue rdf:type rdf:Property ;
    rdfs:label 'Residual Value' ;
    rdfs:comment 'Estimated amount the entity expects to recover from the asset at the end of its useful life (salvage value). Deducted from acquisition cost to determine the depreciable base. Reviewed annually per IAS 16.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revaluationAmount rdf:type rdf:Property ;
    rdfs:label 'Revaluation Amount' ;
    rdfs:comment 'Cumulative upward or downward revaluation adjustment to the asset\'s carrying amount under the IAS 16 revaluation model (where adopted). Recorded in the revaluation surplus in equity. Applicable to stadium land and property assets.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serialNumber rdf:type rdf:Property ;
    rdfs:label 'Serial Number' ;
    rdfs:comment 'Manufacturer\'s serial number or unique physical identifier for the asset (e.g., OB truck chassis number, scoreboard controller serial, broadcast transmitter serial). Used for physical verification, warranty claims, and insurance schedules.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subsequentAcquisitionCost rdf:type rdf:Property ;
    rdfs:label 'Subsequent Acquisition Cost' ;
    rdfs:comment 'Cumulative cost of subsequent capital additions or improvements to the asset (e.g., stadium seat upgrades, scoreboard technology refresh, broadcast tower antenna replacement). Added to the asset\'s gross book value.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usefulLifePeriods rdf:type rdf:Property ;
    rdfs:label 'Useful Life Periods' ;
    rdfs:comment 'Estimated useful life expressed in fiscal periods (months) for assets with sub-annual depreciation granularity. Used in SAP FI-AA period-based depreciation calculations alongside useful_life_years.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:usefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Useful Life Years' ;
    rdfs:comment 'Estimated useful economic life of the asset in years, as determined at capitalization and used to calculate straight-line or other depreciation. Reviewed annually per IAS 16 (e.g., 40 years for stadium structures, 5 years for OB trucks, 3 years for broadcast rights).' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:wbsElement rdf:type rdf:Property ;
    rdfs:label 'Wbs Element' ;
    rdfs:comment 'SAP PS Work Breakdown Structure element linked to the asset, used for CAPEX project tracking during the Assets Under Construction (AUC) phase (e.g., stadium renovation project, broadcast tower installation). Populated until the AUC is settled to a final asset.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountChangedBy rdf:type rdf:Property ;
    rdfs:label 'Account Changed By' ;
    rdfs:comment 'SAP user ID of the person who last modified this GL account master record (SKA1.AEDTM user). Required for SOX audit trail, segregation of duties compliance, and internal audit reviews. Supports detection of unauthorized changes to chart of accounts master data.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountChangedDate rdf:type rdf:Property ;
    rdfs:label 'Account Changed Date' ;
    rdfs:comment 'Date on which this GL account master record was last modified (SKA1.LAEDA). Used for change management tracking, SOX compliance, and data lineage in the Databricks Silver Layer. Triggers downstream reprocessing of dependent financial reporting datasets when account attributes change.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountCreatedBy rdf:type rdf:Property ;
    rdfs:label 'Account Created By' ;
    rdfs:comment 'SAP user ID of the person who created this GL account master record (SKA1.ERNAM). Required for SOX audit trail and segregation of duties (SoD) compliance. Enables identification of unauthorized account creation and supports internal audit reviews of chart of accounts governance.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountCreatedDate rdf:type rdf:Property ;
    rdfs:label 'Account Created Date' ;
    rdfs:comment 'Date on which this GL account master record was first created in the chart of accounts (SKA1.ERDAT). Used for audit trail, SOX compliance documentation, and chart of accounts change management reporting. Supports identification of accounts created outside of standard change control processes.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountGroupCode rdf:type rdf:Property ;
    rdfs:label 'Account Group Code' ;
    rdfs:comment 'SAP account group (SKA1.KTOKS) that controls the number range and field selection for the GL account. Groups accounts by business function, e.g., revenue accounts, expense accounts, balance sheet accounts. Determines which fields are required, optional, or suppressed during account maintenance.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountLongName rdf:type rdf:Property ;
    rdfs:label 'Account Long Name' ;
    rdfs:comment 'Extended descriptive name of the GL account (SKAT.TXT50) providing full business context. Used in detailed financial disclosures, audit documentation, and SEC reporting narratives.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountName rdf:type rdf:Property ;
    rdfs:label 'Account Name' ;
    rdfs:comment 'Short descriptive name of the GL account as maintained in SAP S/4HANA (SKAT.TXT20). Used on financial reports, trial balances, and chart of accounts listings. Examples: \'Ticket Revenue\', \'Broadcast Rights Income\', \'Player Salary Expense\', \'Naming Rights Deferred Revenue\'.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountNumber rdf:type rdf:Property ;
    rdfs:label 'Account Number' ;
    rdfs:comment 'The externally-known, human-readable GL account number as defined in the SAP S/4HANA chart of accounts (SKA1.SAKNR). Uniquely identifies the posting target within a chart of accounts. Used on all journal entries, financial statements, and cost element assignments.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternativeAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Alternative Account Number' ;
    rdfs:comment 'Alternative account number used for country-specific or group reporting chart of accounts mapping (SKA1.ALTKT). Enables mapping between the operational chart of accounts and a group consolidation chart of accounts or statutory reporting chart of accounts for international league entities operating under different GAAP/IFRS frameworks.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balanceSheetAccount rdf:type rdf:Property ;
    rdfs:label 'Balance Sheet Account' ;
    rdfs:comment 'Indicates whether this GL account is a balance sheet account (True) or a profit and loss (P&L) income statement account (False) (SKA1.XBILK). Balance sheet accounts carry forward balances at year-end; P&L accounts are closed to retained earnings. Fundamental for period-end close processing and financial statement preparation.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chartOfAccountsCode rdf:type rdf:Property ;
    rdfs:label 'Chart Of Accounts Code' ;
    rdfs:comment 'Four-character SAP chart of accounts key (SKA1.KTOPL) to which this GL account belongs. Sports Entertainment may maintain multiple charts of accounts for different legal entity frameworks (e.g., US GAAP vs IFRS for international leagues). Determines the account structure and financial statement mapping.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentManagement rdf:type rdf:Property ;
    rdfs:label 'Commitment Management' ;
    rdfs:comment 'Indicates whether commitment management (purchase order commitments and funds reservations) is active for this GL account. When True, purchase orders and contracts posted against this account create budget commitments visible in FP&A reporting. Relevant for player contract commitments, venue capital expenditure, and broadcast production cost commitments.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costCenterRequired rdf:type rdf:Property ;
    rdfs:label 'Cost Center Required' ;
    rdfs:comment 'Indicates whether a cost center assignment is mandatory when posting to this GL account. When True, all journal entries must include a valid cost center (e.g., venue operations cost center, broadcast production cost center, athlete management cost center). Enforces cost allocation discipline for EBITDA reporting and FP&A variance analysis.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costElementCategory rdf:type rdf:Property ;
    rdfs:label 'Cost Element Category' ;
    rdfs:comment 'Defines the cost element category in SAP Controlling (CO) module when this GL account is also a primary cost element (SKA1.KATYP). \'primary\' cost elements correspond directly to P&L GL accounts (e.g., player salary expense, venue operating cost, broadcast production cost); \'secondary\' cost elements are used for internal allocations and settlements between cost centers; \'none\' for balance sheet accounts not used in CO. Critical for EBITDA reporting and cost center allocation in FP&A.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deletionFlag rdf:type rdf:Property ;
    rdfs:label 'Deletion Flag' ;
    rdfs:comment 'Indicates whether this GL account has been flagged for deletion from the chart of accounts (SKA1.XLOEV). Accounts flagged for deletion cannot receive new postings and are scheduled for archival after all dependent records are cleared. Supports chart of accounts rationalization and SOX control compliance.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fieldStatusGroup rdf:type rdf:Property ;
    rdfs:label 'Field Status Group' ;
    rdfs:comment 'SAP field status group code assigned to the GL account that controls which fields are required, optional, or suppressed during document entry (SKB1.FSTAG). Ensures data completeness for postings — for example, cost center is required on expense accounts, profit center on revenue accounts, and business area on intercompany settlement accounts.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialStatementItem rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Item' ;
    rdfs:comment 'The financial statement version item code to which this GL account is assigned for external reporting (SKA1.BILKT). Maps the account to a specific line on the income statement, balance sheet, or cash flow statement as required for SEC 10-K/10-Q filings and EBITDA reporting.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:houseBankAccount rdf:type rdf:Property ;
    rdfs:label 'House Bank Account' ;
    rdfs:comment 'Indicates whether this GL account is a house bank account used for cash management and bank reconciliation (SKB1.XINTB). When True, the account is linked to a physical bank account for automated bank statement processing, cash pooling, and treasury operations. Relevant for Sports Entertainment\'s multi-entity cash management across leagues and venues.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:intercompanyAccount rdf:type rdf:Property ;
    rdfs:label 'Intercompany Account' ;
    rdfs:comment 'Indicates whether this GL account is designated for intercompany transactions between Sports Entertainment legal entities (e.g., between the league holding company, individual team entities, broadcast subsidiaries, and venue operating companies). When True, intercompany partner must be specified on postings for automated elimination in consolidated financial statements. Required for SOX-compliant intercompany reconciliation.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestCalculation rdf:type rdf:Property ;
    rdfs:label 'Interest Calculation' ;
    rdfs:comment 'Indicates whether automatic interest calculation is activated for this GL account (SKB1.XINTB for interest indicator). Relevant for intercompany loan accounts, deferred revenue accounts (naming rights, multi-year broadcast deals), and overdue receivable accounts where interest accrual is contractually required.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineItemDisplay rdf:type rdf:Property ;
    rdfs:label 'Line Item Display' ;
    rdfs:comment 'Indicates whether individual line items are stored and displayable for this GL account (SKB1.XKRES). When True, each posting line is retained for drill-down reporting and audit trail purposes. Required for SOX-compliant audit trails on revenue accounts (ticket revenue, broadcast rights income, sponsorship fees) and significant expense accounts (player salaries, venue operating costs).' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:openItemManagement rdf:type rdf:Property ;
    rdfs:label 'Open Item Management' ;
    rdfs:comment 'Indicates whether open item management is activated for this GL account (SKB1.XOPVW). When True, individual line items remain open until explicitly cleared against an offsetting entry (e.g., deferred revenue accounts for naming rights, advance ticket deposits, broadcast rights prepayments). Enables aging analysis and outstanding item tracking for FP&A.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planningLevel rdf:type rdf:Property ;
    rdfs:label 'Planning Level' ;
    rdfs:comment 'Planning level code that controls how this GL account participates in financial planning and budgeting processes in SAP CO and Workday Adaptive Planning integration. Determines the granularity at which budget vs. actual variance analysis is performed — account level, cost center level, or profit center level. Supports FP&A EBITDA budgeting and ARR tracking.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingBlock rdf:type rdf:Property ;
    rdfs:label 'Posting Block' ;
    rdfs:comment 'Flag indicating whether postings to this GL account are currently blocked at the chart of accounts level (SKA1.XSPEA). When True, no journal entries can be posted to this account regardless of company code settings. Used during account restructuring, period-end close, or SOX control enforcement.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:profitCenterRequired rdf:type rdf:Property ;
    rdfs:label 'Profit Center Required' ;
    rdfs:comment 'Indicates whether a profit center assignment is mandatory when posting to this GL account. When True, all postings must include a valid profit center enabling segment-level profitability reporting (e.g., by league, by venue, by broadcast network). Supports SEC segment reporting under GAAP ASC 280 and internal EBITDA reporting by business unit.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationAccountType rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Account Type' ;
    rdfs:comment 'Indicates whether this GL account serves as a reconciliation account for a subledger and, if so, which subledger type (SKA1.MITKZ). \'customer\' reconciliation accounts aggregate accounts receivable subledger balances (e.g., fan ticket receivables, sponsor invoices); \'vendor\' for accounts payable (e.g., venue contractor payables); \'asset\' for fixed asset subledger (e.g., stadium infrastructure); \'none\' for non-reconciliation accounts. Direct postings to reconciliation accounts are blocked.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueRecognitionCategory rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Category' ;
    rdfs:comment 'Classification of the revenue recognition pattern applicable to this GL account under GAAP ASC 606 / IFRS 15. \'point_in_time\' for single-event revenues (e.g., individual ticket sales, PPV events, merchandise sales); \'over_time\' for performance obligations satisfied over a period (e.g., season ticket packages, multi-year broadcast rights, naming rights); \'deferred\' for advance payments not yet earned (e.g., prepaid sponsorship fees, advance broadcast rights payments); \'not_applicable\' for non-revenue accounts. Critical for SEC revenue disclosure and audit compliance.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sortKey rdf:type rdf:Property ;
    rdfs:label 'Sort Key' ;
    rdfs:comment 'Three-digit sort key code that determines the assignment field populated in the allocation field of line items posted to this account (SKB1.ZUAWA). Controls how line items are sorted and grouped in account displays and reports. Common sort keys include posting date, document number, and external document reference for reconciliation purposes.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportsRevenueStream rdf:type rdf:Property ;
    rdfs:label 'Sports Revenue Stream' ;
    rdfs:comment 'Sports Entertainment-specific revenue stream classification for this GL account, enabling industry-specific financial analytics and KPI reporting. Examples: \'ticket_revenue\', \'broadcast_rights_income\', \'naming_rights_revenue\', \'sponsorship_fees\', \'merchandise_licensing\', \'ppv_revenue\', \'concession_revenue\', \'player_transfer_fee\', \'nil_licensing_income\', \'venue_rental\'. Used for EBITDA decomposition, ARR tracking, and league financial reporting. [ENUM-REF-CANDIDATE: ticket_revenue|broadcast_rights_income|naming_rights_revenue|sponsorship_fees|merchandise_licensing|ppv_revenue|concession_revenue|player_transfer_fee|nil_licensing_income|venue_rental — promote to reference product]' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxCategory rdf:type rdf:Property ;
    rdfs:label 'Tax Category' ;
    rdfs:comment 'Tax category assigned to the GL account controlling tax code entry behavior during posting (SKB1.MWSKZ). Determines whether tax codes are required, optional, or not allowed on journal entries to this account. Relevant for VAT/GST on international broadcast rights, ticket sales tax, merchandise sales tax, and venue concession tax compliance.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxRelevant rdf:type rdf:Property ;
    rdfs:label 'Tax Relevant' ;
    rdfs:comment 'Indicates whether this GL account is subject to tax reporting and requires a tax code on postings (SKB1.XMWNO negated). When True, postings must include a valid tax code for VAT, sales tax, or withholding tax compliance. Critical for international broadcast rights distribution, PPV revenue, and merchandise sales across jurisdictions.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:toleranceGroup rdf:type rdf:Property ;
    rdfs:label 'Tolerance Group' ;
    rdfs:comment 'Tolerance group code assigned to the GL account that defines acceptable variance thresholds for payment differences, rounding, and clearing (SKB1.ZUAWA tolerance reference). Controls automatic clearing of small differences on high-volume accounts such as ticket revenue clearing, merchandise POS settlement, and concession cash accounts. Supports SOX-compliant payment processing controls.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validToDate rdf:type rdf:Property ;
    rdfs:label 'Valid To Date' ;
    rdfs:comment 'Date until which this GL account is valid for posting. Null indicates the account has no planned expiry. Used to retire accounts associated with discontinued business lines (e.g., a closed venue, an expired broadcast rights agreement, a divested team entity) while preserving historical posting data for audit and SEC reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:intercompanySettlementId rdf:type rdf:Property ;
    rdfs:label 'Intercompany Settlement Id' ;
    rdfs:comment 'Unique surrogate identifier for each intercompany settlement transaction record in the Sports Entertainment enterprise. Primary key for the silver-layer lakehouse table.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:journalEntryId rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Id' ;
    rdfs:comment 'Foreign key linking to finance.journal_entry. Business justification: Intercompany settlements generate SAP FI journal entry postings. The sap_fi_document_number string field is a denormalized reference to the journal entry document. A typed FK journal_entry_id → journa' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JournalEntry .

ind:sendingCompanyCodeId rdf:type rdf:Property ;
    rdfs:label 'Sending Company Code Id' ;
    rdfs:comment 'Foreign key linking to finance.company_code. Business justification: Intercompany settlements involve a sending legal entity. The sending_company_code string and sending_entity_name are denormalized references to the company_code master. A typed FK sending_company_code' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompanyCode .

ind:sendingCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Sending Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Intercompany settlements originate from a specific cost center on the sending side. The sending_cost_center string field is a denormalized reference that should be replaced with a typed FK sending_cos' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:amountGroupCurrency rdf:type rdf:Property ;
    rdfs:label 'Amount Group Currency' ;
    rdfs:comment 'The settlement amount translated into the Sports Entertainment group reporting currency (typically USD) using the applicable exchange rate at the time of posting. Required for SEC consolidated financial statement preparation and group-level EBITDA reporting.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:armLengthIndicator rdf:type rdf:Property ;
    rdfs:label 'Arm Length Indicator' ;
    rdfs:comment 'Indicates whether the intercompany settlement price has been validated as arm\'s length in accordance with OECD transfer pricing guidelines. True = the price has been confirmed as consistent with what unrelated parties would agree to. Required for transfer pricing documentation and tax compliance.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consolidationGroup rdf:type rdf:Property ;
    rdfs:label 'Consolidation Group' ;
    rdfs:comment 'The consolidation group or reporting unit within the Sports Entertainment corporate structure to which this intercompany settlement belongs. Used to scope elimination entries to the correct consolidation perimeter for SEC group financial reporting (e.g., \'SE_NORTH_AMERICA\', \'SE_BROADCAST_GROUP\').' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Flag' ;
    rdfs:comment 'Indicates whether this intercompany settlement is currently under dispute between the sending and receiving entities. True = the settlement amount or terms are contested. Disputed settlements are excluded from netting runs until resolved and flagged for transfer pricing review.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentDate rdf:type rdf:Property ;
    rdfs:label 'Document Date' ;
    rdfs:comment 'The real-world business event date on which the intercompany transaction was originated or agreed upon, which may differ from the posting date. Used for transfer pricing documentation and contractual reference. Corresponds to the SAP FI document date field.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eliminationFlag rdf:type rdf:Property ;
    rdfs:label 'Elimination Flag' ;
    rdfs:comment 'Indicates whether this intercompany settlement transaction must be eliminated in the preparation of Sports Entertainment\'s consolidated financial statements. True = this transaction is an intercompany transaction that must be eliminated to avoid double-counting in SEC-reported consolidated financials. Required for GAAP ASC 810 consolidation and SEC Regulation S-X compliance.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nettingAgreementRef rdf:type rdf:Property ;
    rdfs:label 'Netting Agreement Ref' ;
    rdfs:comment 'Reference identifier for the intercompany netting agreement under which multiple bilateral settlements between Sports Entertainment entities are offset and settled on a net basis. Enables grouping of transactions for netting cycle processing and reduces cash movement between entities.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nettingStatus rdf:type rdf:Property ;
    rdfs:label 'Netting Status' ;
    rdfs:comment 'Indicates the current netting processing status of this intercompany settlement within its netting agreement cycle. \'included_in_netting\' means the transaction has been selected for the current netting run; \'netted\' means the settlement has been offset and the net cash movement has been executed.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingPeriod rdf:type rdf:Property ;
    rdfs:label 'Posting Period' ;
    rdfs:comment 'The fiscal posting period in YYYY-MM format to which this intercompany settlement is assigned in SAP S/4HANA FI. Determines the accounting period for revenue recognition, expense allocation, and period-end close reporting. Critical for EBITDA reporting and SEC quarterly/annual financial filings.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Receiving Company Code' ;
    rdfs:comment 'The SAP company code of the legal entity receiving the intercompany charge or settlement. Represents the Sports Entertainment subsidiary or division that is the recipient of the transaction (e.g., the league entity receiving a broadcast rights fee charge). Used in consolidated financial statement eliminations.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingCostCenter rdf:type rdf:Property ;
    rdfs:label 'Receiving Cost Center' ;
    rdfs:comment 'The SAP Controlling (CO) cost center within the receiving company code that absorbs the intercompany charge. Enables granular expense allocation and EBITDA reporting at the cost center level for the receiving entity.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Agreement Number' ;
    rdfs:comment 'Identifier of the underlying master agreement, contract, or rights licensing arrangement that authorizes this intercompany settlement. For example, the broadcast rights agreement between the network entity and league entity, or the shared services agreement between corporate and venue subsidiaries.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reversalDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Reversal Document Number' ;
    rdfs:comment 'The SAP S/4HANA FI document number of the reversing entry if this intercompany settlement has been reversed. Populated only when settlement_status = \'reversed\'. Provides audit trail for correcting entries and supports SOX financial controls.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicePeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Service Period End' ;
    rdfs:comment 'The end date of the period during which the underlying service, rights usage, or shared resource was consumed, giving rise to this intercompany settlement. Used for revenue recognition alignment under GAAP ASC 606 and transfer pricing documentation.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:servicePeriodStart rdf:type rdf:Property ;
    rdfs:label 'Service Period Start' ;
    rdfs:comment 'The start date of the period during which the underlying service, rights usage, or shared resource was consumed, giving rise to this intercompany settlement. Used for revenue recognition alignment under GAAP ASC 606 and transfer pricing documentation.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementDescription rdf:type rdf:Property ;
    rdfs:label 'Settlement Description' ;
    rdfs:comment 'Free-text narrative description of the intercompany settlement, providing business context for the transaction. Examples: \'Q3 broadcast rights fee for NFL Sunday package\', \'FY2024 Q2 shared IT services charge — venue operations\', \'NIL licensing fee — athlete endorsement content for streaming platform\'. Required for transfer pricing documentation.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementNumber rdf:type rdf:Property ;
    rdfs:label 'Settlement Number' ;
    rdfs:comment 'Externally-known, human-readable business identifier for the intercompany settlement transaction, formatted as ICT-{YEAR}-{SEQUENCE}. Used in audit trails, transfer pricing documentation, and SEC consolidated financial statement eliminations. Sourced from SAP S/4HANA FI document number.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementStatus rdf:type rdf:Property ;
    rdfs:label 'Settlement Status' ;
    rdfs:comment 'Current workflow lifecycle state of the intercompany settlement transaction. Drives approval routing, netting eligibility, and elimination processing. \'posted\' indicates the entry has been recorded in the general ledger; \'reversed\' indicates a correcting entry has been applied.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxCode rdf:type rdf:Property ;
    rdfs:label 'Tax Code' ;
    rdfs:comment 'The SAP S/4HANA FI tax code applied to this intercompany settlement, determining the applicable VAT/GST treatment for cross-border intercompany transactions. Relevant for Sports Entertainment entities operating across multiple tax jurisdictions globally.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferPriceMethod rdf:type rdf:Property ;
    rdfs:label 'Transfer Price Method' ;
    rdfs:comment 'The OECD-approved transfer pricing methodology used to determine the arm\'s-length price for this intercompany settlement. Required for transfer pricing documentation and tax authority compliance. Examples: Comparable Uncontrolled Price (CUP) for broadcast rights fees, Cost Plus for shared services charges.' ;
    rdfs:domain ind:IntercompanySettlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ledgerId rdf:type rdf:Property ;
    rdfs:label 'Ledger Id' ;
    rdfs:comment 'Two-character identifier of the SAP New GL ledger to which this entry is posted (e.g., \'0L\' = leading ledger GAAP, \'L1\' = IFRS parallel ledger, \'L2\' = local GAAP ledger). Supports parallel accounting for multi-GAAP reporting requirements.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Ledger .

ind:primaryJournalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Journal Employee Id' ;
    rdfs:comment 'SAP user ID of the person or system process that created and posted this journal entry. Critical for SOX audit trail, segregation of duties (SoD) compliance, and fraud detection. Corresponds to BKPF.USNAM. PARTY_REFERENCE category.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:soxApproverUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Sox Approver User Employee Id' ;
    rdfs:comment 'SAP user ID of the individual who approved this journal entry under the SOX internal controls workflow. Null if not yet approved or exempt. Supports segregation of duties (SoD) audit and SOX Section 404 evidence.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:documentNumber rdf:type rdf:Property ;
    rdfs:label 'Document Number' ;
    rdfs:comment 'SAP-assigned ten-digit accounting document number uniquely identifying the journal entry within a company code and fiscal year. This is the externally-known business identifier used in audit trails, reconciliations, and cross-system references. Corresponds to BKPF.BELNR.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentType rdf:type rdf:Property ;
    rdfs:label 'Document Type' ;
    rdfs:comment 'Two-character SAP document type code classifying the nature of the journal entry (e.g., SA=GL posting, KR=vendor invoice, DZ=customer payment, AB=accrual, IC=intercompany, AA=asset posting, ZP=payment run). Drives number range assignment and account type restrictions. [ENUM-REF-CANDIDATE: SA|KR|DZ|AB|IC|AA|ZP|RE|KZ|DR — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Entry Timestamp' ;
    rdfs:comment 'System timestamp recording when this journal entry record was first created in SAP FI. Serves as the RECORD_AUDIT_CREATED field for audit trail and SOX compliance. Corresponds to BKPF.CPUDT + BKPF.CPUTM.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:groupCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Group Currency Amount' ;
    rdfs:comment 'Total amount of the journal entry translated into the group (consolidation) currency (typically USD for Sports Entertainment). Used for consolidated EBITDA reporting, SEC filings, and group-level financial analysis. Corresponds to the aggregate of BSEG.KZBTR.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:headerText rdf:type rdf:Property ;
    rdfs:label 'Header Text' ;
    rdfs:comment 'Free-text description at the journal entry header level providing business context for the posting (e.g., \'Q3 Ticket Revenue Accrual — NFL Season\', \'Broadcast Rights Amortization — RSN Deal\', \'Intercompany Settlement — Venue Ops\'). Corresponds to BKPF.BKTXT.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intercompanyIndicator rdf:type rdf:Property ;
    rdfs:label 'Intercompany Indicator' ;
    rdfs:comment 'Flag indicating whether this journal entry represents an intercompany transaction between two legal entities within the Sports Entertainment group (True) or an external third-party transaction (False). Critical for consolidation elimination and intercompany reconciliation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastChangedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Changed Timestamp' ;
    rdfs:comment 'System timestamp of the most recent modification to this journal entry record. Serves as the RECORD_AUDIT_UPDATED field for change tracking and SOX audit trail. Corresponds to BKPF.AEDAT.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lineItemCount rdf:type rdf:Property ;
    rdfs:label 'Line Item Count' ;
    rdfs:comment 'Total number of accounting line items (debit and credit rows) embedded within this journal entry document. A balanced double-entry posting requires a minimum of two line items. Supports validation of entry completeness and complexity classification.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:localCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Local Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter code for the company code local currency (functional currency) used for statutory reporting. Distinct from transaction currency when cross-currency postings occur. Corresponds to BKPF.HWAER.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingKey rdf:type rdf:Property ;
    rdfs:label 'Posting Key' ;
    rdfs:comment 'SAP two-digit posting key controlling the debit/credit indicator and account type for the primary line item of this journal entry (e.g., \'40\'=GL debit, \'50\'=GL credit, \'01\'=customer debit, \'31\'=vendor credit). Determines how the entry affects account balances. Corresponds to BSEG.BSCHL.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingStatus rdf:type rdf:Property ;
    rdfs:label 'Posting Status' ;
    rdfs:comment 'Current lifecycle state of the journal entry within the SAP FI workflow. \'posted\' = fully committed to GL; \'parked\' = saved but not yet posted pending approval; \'held\' = incomplete draft; \'reversed\' = offset by a reversal document; \'simulated\' = test posting not committed; \'error\' = failed validation. Serves as the LIFECYCLE_STATUS field.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soxApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Sox Approval Status' ;
    rdfs:comment 'Current status of the SOX-mandated approval workflow for this journal entry. \'pending\' = awaiting approver action; \'approved\' = authorized by designated control owner; \'rejected\' = returned for correction; \'escalated\' = routed to senior approver; \'exempt\' = system-generated entry below materiality threshold. Required for SOX Section 404 internal controls over financial reporting.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soxApprovalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sox Approval Timestamp' ;
    rdfs:comment 'Date and time when the SOX approval was granted for this journal entry. Null if pending or exempt. Provides immutable audit evidence for SOX Section 404 compliance and external auditor review.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:tradingPartnerCode rdf:type rdf:Property ;
    rdfs:label 'Trading Partner Code' ;
    rdfs:comment 'Four-character company code of the intercompany trading partner entity when this is an intercompany journal entry. Used for automated intercompany elimination during group consolidation. Null for external transactions. Corresponds to BKPF.VBUND.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountId rdf:type rdf:Property ;
    rdfs:label 'Bank Account Id' ;
    rdfs:comment 'The internal identifier for the Sports Entertainment house bank account used to execute this payment. References the SAP FI bank account master (BNKA/T012K). Determines the bank file format and payment medium for outbound disbursements.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:runId rdf:type rdf:Property ;
    rdfs:label 'Run Id' ;
    rdfs:comment 'Identifier for the SAP FI automatic payment program run (F110) that generated this payment. Groups all payments executed in a single batch payment run for reconciliation and audit. Null for manually posted payments.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentRun .

ind:achTraceNumber rdf:type rdf:Property ;
    rdfs:label 'Ach Trace Number' ;
    rdfs:comment 'The NACHA ACH trace number assigned to this payment entry for ACH transactions. Used for ACH return processing, NOC (Notification of Change) handling, and bank reconciliation. Null for non-ACH payment methods.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankKey rdf:type rdf:Property ;
    rdfs:label 'Bank Key' ;
    rdfs:comment 'The SAP FI house bank key (HBKID) identifying the financial institution through which this payment is routed. Used for bank reconciliation, liquidity planning, and treasury management reporting.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockIndicator rdf:type rdf:Property ;
    rdfs:label 'Block Indicator' ;
    rdfs:comment 'SAP FI payment block code (ZLSPR) indicating whether the payment is blocked from processing and the reason (e.g., manual block, dispute, audit hold, compliance review). Blank/null indicates no block. Critical for AP payment control and SOX compliance.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkNumber rdf:type rdf:Property ;
    rdfs:label 'Check Number' ;
    rdfs:comment 'The physical or electronic check number assigned to this payment when payment_method is \'check\'. Used for check register management, positive pay file submission to banks, and stop-payment processing. Null for non-check payment methods.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:direction rdf:type rdf:Property ;
    rdfs:label 'Direction' ;
    rdfs:comment 'Indicates whether the payment is an outbound disbursement (AP vendor payment) or an inbound receipt (AR customer collection). Fundamental discriminator for cash flow classification and treasury reporting under IAS 7.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentType rdf:type rdf:Property ;
    rdfs:label 'Payment Type' ;
    rdfs:comment 'Business classification of the payment transaction purpose. vendor_disbursement = AP payment to supplier/contractor; customer_receipt = AR collection from ticket buyer, sponsor, or broadcaster; intercompany_settlement = payment between Sports Entertainment legal entities; payroll_disbursement = athlete or staff salary payment; tax_payment = remittance to tax authority; refund = return of funds to customer. [ENUM-REF-CANDIDATE: vendor_disbursement|customer_receipt|intercompany_settlement|payroll_disbursement|tax_payment|refund — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reference rdf:type rdf:Property ;
    rdfs:label 'Reference' ;
    rdfs:comment 'Free-form reference text transmitted with the payment to the beneficiary bank (e.g., invoice number, contract reference, event name). Appears on bank statements and remittance advice. Corresponds to BVTYP/XBLNR in SAP FI. Critical for counterparty cash application.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceAdviceSent rdf:type rdf:Property ;
    rdfs:label 'Remittance Advice Sent' ;
    rdfs:comment 'Indicates whether a remittance advice notification has been sent to the payee or payer detailing the invoices cleared by this payment. Supports vendor and customer communication workflows in SAP FI output management.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialGlIndicator rdf:type rdf:Property ;
    rdfs:label 'Special Gl Indicator' ;
    rdfs:comment 'SAP FI special GL indicator (UMSKZ) classifying non-standard postings such as down payments, guarantees, or security deposits associated with this payment. Blank for standard payment postings. Used for balance sheet sub-classification.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:swiftReference rdf:type rdf:Property ;
    rdfs:label 'Swift Reference' ;
    rdfs:comment 'The SWIFT end-to-end transaction reference (UETR or TRN) for wire transfer payments. Enables real-time payment tracking via SWIFT gpi and bank confirmation matching. Null for non-wire payment methods.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termsCode rdf:type rdf:Property ;
    rdfs:label 'Terms Code' ;
    rdfs:comment 'The SAP FI payment terms key (ZTERM) governing the due date calculation and early payment discount conditions for this transaction (e.g., NT30, 2/10NET30). Inherited from the invoice or vendor/customer master. Drives DSO and DPO analytics.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualCapexBudget rdf:type rdf:Property ;
    rdfs:label 'Annual Capex Budget' ;
    rdfs:comment 'Approved annual capital expenditure budget for this profit center in local currency. Relevant for venue operations and broadcast infrastructure profit centers. Used in FP&A and SEC capital allocation disclosures.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualOpexBudget rdf:type rdf:Property ;
    rdfs:label 'Annual Opex Budget' ;
    rdfs:comment 'Approved annual operating expenditure budget for this profit center in local currency, as set in Workday Adaptive Planning. Includes direct costs and allocated overhead. Used for EBITDA margin planning and cost control.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualRevenueBudget rdf:type rdf:Property ;
    rdfs:label 'Annual Revenue Budget' ;
    rdfs:comment 'Approved annual revenue budget for this profit center in the profit center\'s local currency, as set in Workday Adaptive Planning FP&A. Used for budget vs. actual variance analysis and EBITDA forecasting.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arrTrackingFlag rdf:type rdf:Property ;
    rdfs:label 'Arr Tracking Flag' ;
    rdfs:comment 'Indicates whether this profit center tracks Annual Recurring Revenue (ARR) as a primary financial metric. Applicable to OTT streaming, digital subscription, and DTC platform profit centers where ARR is a key investor KPI.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:businessUnitType rdf:type rdf:Property ;
    rdfs:label 'Business Unit Type' ;
    rdfs:comment 'Classification of the revenue-generating business unit represented by this profit center within Sports Entertainment\'s portfolio. Drives EBITDA reporting structure and profitability analysis by segment. [ENUM-REF-CANDIDATE: league_franchise|venue|ott_platform|broadcast_network|merchandise_line|athlete_management|concert_series|sponsorship_unit|corporate — promote to reference product]' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyNodeCode rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Node Code' ;
    rdfs:comment 'Code of the profit center group/node in the standard hierarchy (SAP EC-PCA hierarchy) to which this profit center belongs. Enables roll-up reporting from individual profit centers to business segments and enterprise level. Maps to SAP field KHINR.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manager rdf:type rdf:Property ;
    rdfs:label 'Manager' ;
    rdfs:comment 'Name or employee ID of the person responsible for the profit center\'s financial performance and budget accountability. Used for management reporting, variance analysis, and SOX control ownership. Maps to SAP field VERAK.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilRevenueEligible rdf:type rdf:Property ;
    rdfs:label 'Nil Revenue Eligible' ;
    rdfs:comment 'Indicates whether this profit center is eligible to record NIL (Name, Image, and Likeness) revenue streams from athlete endorsement and licensing arrangements. Relevant for athlete management and league franchise profit centers under NCAA and professional league NIL rules.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:profitCenterDescription rdf:type rdf:Property ;
    rdfs:label 'Profit Center Description' ;
    rdfs:comment 'Long-form business description of the profit center\'s purpose, scope, and the revenue-generating activities it encompasses. Provides context for financial analysts, auditors, and FP&A teams. Maps to SAP field LTEXT.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenterName rdf:type rdf:Property ;
    rdfs:label 'Profit Center Name' ;
    rdfs:comment 'Full descriptive name of the profit center as defined in SAP CO master data (e.g., \'Los Angeles Lakers Franchise\', \'OTT Streaming Platform - North America\', \'Madison Square Garden Venue Operations\'). Maps to SAP field KTEXT.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenterStatus rdf:type rdf:Property ;
    rdfs:label 'Profit Center Status' ;
    rdfs:comment 'Current lifecycle status of the profit center in SAP CO. \'active\' = postings allowed; \'locked\' = postings blocked (e.g., during restructuring); \'inactive\' = not yet activated; \'archived\' = historical record retained for audit. Maps to SAP field LOCK_IND and activation status.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soxControlOwner rdf:type rdf:Property ;
    rdfs:label 'Sox Control Owner' ;
    rdfs:comment 'Name or employee ID of the designated SOX internal control owner responsible for financial reporting controls associated with this profit center. Required for SOX Section 302/404 compliance documentation and audit evidence.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soxRiskRating rdf:type rdf:Property ;
    rdfs:label 'Sox Risk Rating' ;
    rdfs:comment 'SOX financial reporting risk rating assigned to this profit center based on materiality, transaction volume, and complexity. Determines the frequency and depth of internal control testing required by the external auditor.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetEbitdaMarginPct rdf:type rdf:Property ;
    rdfs:label 'Target Ebitda Margin Pct' ;
    rdfs:comment 'Planned EBITDA margin percentage for this profit center as a target set during annual budgeting in Workday Adaptive Planning. Expressed as a percentage of revenue. Used as the primary KPI for profitability performance management.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recurringRevenueId rdf:type rdf:Property ;
    rdfs:label 'Recurring Revenue Id' ;
    rdfs:comment 'Primary key for recurring_revenue' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:arpuAmount rdf:type rdf:Property ;
    rdfs:label 'Arpu Amount' ;
    rdfs:comment 'The average recurring revenue per active subscriber or partner for this ARR component during the reporting period, derived as MRR divided by subscriber_count. A primary DTC and investor KPI for subscription business performance benchmarking.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arrAmount rdf:type rdf:Property ;
    rdfs:label 'Arr Amount' ;
    rdfs:comment 'The annualized recurring revenue amount for this contract or subscription, calculated as MRR × 12 or the contracted annual value for multi-year agreements. The primary metric for investor relations, board reporting, and SEC financial disclosures. Excludes one-time and non-recurring revenue.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arrComponentType rdf:type rdf:Property ;
    rdfs:label 'Arr Component Type' ;
    rdfs:comment 'Classifies the nature of the recurring revenue stream contributing to ARR. Drives segmentation in investor relations disclosures, board reporting, and DTC subscription KPI dashboards. [ENUM-REF-CANDIDATE: ott_subscription|season_ticket_membership|sponsorship_contract|broadcast_rights|merchandise_subscription|other — promote to reference product]' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingFrequency rdf:type rdf:Property ;
    rdfs:label 'Billing Frequency' ;
    rdfs:comment 'The cadence at which the subscriber or partner is invoiced for this recurring revenue stream. Used to normalize MRR and ARR calculations and to align cash flow forecasting in Workday Adaptive Planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:churnAmount rdf:type rdf:Property ;
    rdfs:label 'Churn Amount' ;
    rdfs:comment 'The ARR value lost during the reporting period due to cancellations, non-renewals, or contract terminations for this revenue stream. A key metric in investor churn disclosures and subscription health reporting. Expressed as a positive value representing lost ARR.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:churnReasonCategory rdf:type rdf:Property ;
    rdfs:label 'Churn Reason Category' ;
    rdfs:comment 'Categorical classification of the primary reason for ARR churn when a subscriber or partner cancels or does not renew. Populated only when churn_amount > 0. Drives churn root-cause analysis and retention strategy reporting.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:churnedSubscriberCount rdf:type rdf:Property ;
    rdfs:label 'Churned Subscriber Count' ;
    rdfs:comment 'The number of subscribers or partners who cancelled or did not renew during the reporting period. Used to compute gross churn rate and validate churn_amount figures in investor disclosures.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Contract Reference Number' ;
    rdfs:comment 'Externally-known contract or agreement number from the source system of record (SAP S/4HANA SD or Salesforce CRM) that uniquely identifies the commercial agreement generating this ARR entry. Used for audit trail and reconciliation.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractTermYears rdf:type rdf:Property ;
    rdfs:label 'Contract Term Years' ;
    rdfs:comment 'The total duration of the underlying commercial agreement in years (e.g., 1.0, 2.5, 5.0). Used for ARR normalization on multi-year deals and for weighted average contract length (WACL) reporting in investor materials.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractedArrAmount rdf:type rdf:Property ;
    rdfs:label 'Contracted Arr Amount' ;
    rdfs:comment 'The total ARR value as explicitly stated in the signed commercial contract, before any adjustments for churn, expansion, or discounts. Used as the baseline for variance analysis against recognized ARR and for multi-year deal tracking.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractionAmount rdf:type rdf:Property ;
    rdfs:label 'Contraction Amount' ;
    rdfs:comment 'The ARR reduction during the reporting period due to downgrades, seat reductions, or renegotiated contract terms for existing subscribers or partners, without full cancellation. Distinct from churn_amount which represents full cancellations.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expansionAmount rdf:type rdf:Property ;
    rdfs:label 'Expansion Amount' ;
    rdfs:comment 'The incremental ARR gained during the reporting period from upsells, upgrades, seat additions, or contract amendments for existing subscribers or partners. Drives net revenue retention (NRR) calculations in investor reporting.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:listPriceArrAmount rdf:type rdf:Property ;
    rdfs:label 'List Price Arr Amount' ;
    rdfs:comment 'The undiscounted ARR value at standard list pricing before any contractual discounts, promotional credits, or negotiated reductions. Used for discount rate analysis and pricing strategy reporting.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mrrAmount rdf:type rdf:Property ;
    rdfs:label 'Mrr Amount' ;
    rdfs:comment 'The normalized monthly recurring revenue amount for this contract or subscription in the reporting period currency. MRR is the foundational metric for subscription business health, used in ARPU calculations and investor KPI dashboards. Excludes one-time fees and variable usage charges.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:multiYearDealFlag rdf:type rdf:Property ;
    rdfs:label 'Multi Year Deal Flag' ;
    rdfs:comment 'Indicates whether this ARR entry is derived from a multi-year contract (e.g., a 3-year broadcast rights agreement or 5-year naming rights sponsorship). Multi-year deals require special ARR normalization and disclosure treatment in SEC filings.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netArrMovement rdf:type rdf:Property ;
    rdfs:label 'Net Arr Movement' ;
    rdfs:comment 'The net change in ARR for this record during the reporting period, calculated as new ARR + expansion ARR − churn ARR − contraction ARR. The primary waterfall metric for ARR bridge reporting in board and investor presentations.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newSubscriberCount rdf:type rdf:Property ;
    rdfs:label 'New Subscriber Count' ;
    rdfs:comment 'The number of net-new subscribers or partners added during the reporting period for this ARR component type. Used in subscriber acquisition analysis and CAC/LTV modeling.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:productTier rdf:type rdf:Property ;
    rdfs:label 'Product Tier' ;
    rdfs:comment 'The subscription or partnership tier level for this recurring revenue entry (e.g., Basic OTT, Premium OTT, VIP Season Membership, Enterprise Sponsorship). Used for ARPU segmentation and upsell/expansion analysis.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalProbabilityPct rdf:type rdf:Property ;
    rdfs:label 'Renewal Probability Pct' ;
    rdfs:comment 'The estimated probability (0.00–100.00) that this contract or subscription will renew at expiry, as assessed by the commercial or FP&A team. Used in ARR forecasting, at-risk ARR identification, and Workday Adaptive Planning pipeline models.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End' ;
    rdfs:comment 'The last day of the fiscal reporting period to which this ARR snapshot applies. Paired with reporting_period_start to define the measurement window for ARR, MRR, churn, and expansion calculations.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start' ;
    rdfs:comment 'The first day of the fiscal reporting period (month or quarter) to which this ARR snapshot applies. Used to align ARR metrics with SEC quarterly and annual financial disclosures.' ;
    rdfs:domain ind:RecurringRevenue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revenueRecognitionMethod rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Method' ;
    rdfs:comment 'The ASC 606-compliant method used to recognize revenue from this recurring stream over the contract term. Distinct from the commercial ARR metric — this field links the ARR tracker to the revenue_recognition_schedule product for accounting treatment alignment.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soxControlFlag rdf:type rdf:Property ;
    rdfs:label 'Sox Control Flag' ;
    rdfs:comment 'Indicates whether this ARR record is subject to SOX internal control review as part of the financial reporting control environment for publicly traded entities. Flagged records require additional audit trail documentation and management sign-off.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recognizedGlAccountId rdf:type rdf:Property ;
    rdfs:label 'Recognized Gl Account Id' ;
    rdfs:comment 'Foreign key linking to finance.gl_account. Business justification: Revenue recognition schedules post recognized revenue to a specific GL account. The gl_account_code string field should be replaced with a typed FK recognized_gl_account_id → gl_account.gl_account_id.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GlAccount .

ind:constraintAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Constraint Applied Flag' ;
    rdfs:comment 'Indicates whether the variable consideration constraint has been applied to limit the recognized amount to the extent it is highly probable (IFRS 15) or probable (ASC 606) that a significant revenue reversal will not occur. Required for ASC 606 / IFRS 15 compliance documentation.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Contract Effective Date' ;
    rdfs:comment 'The date the underlying contract became legally binding and enforceable. Used as the ASC 606 contract inception date for determining transaction price and allocating to performance obligations.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Contract Expiry Date' ;
    rdfs:comment 'The date the underlying contract expires or terminates. For multi-year broadcast rights or naming rights agreements, this may be several years in the future. Nullable for evergreen contracts.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cumulativeRecognizedAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Recognized Amount' ;
    rdfs:comment 'Total revenue recognized to date against this performance obligation since the recognition start date. Equals total_contract_value minus deferred_revenue_balance at any point in time. Used for period-end reconciliation and ASC 606 cumulative catch-up adjustment calculations.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentPeriodRecognitionAmount rdf:type rdf:Property ;
    rdfs:label 'Current Period Recognition Amount' ;
    rdfs:comment 'Revenue amount to be recognized in the current accounting period for this performance obligation. Drives the period-end journal entry generation in SAP S/4HANA FI/CO. For straight-line method, equals total_contract_value divided by total periods; for milestone/event-based, equals the value of the milestone achieved.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredRevenueBalance rdf:type rdf:Property ;
    rdfs:label 'Deferred Revenue Balance' ;
    rdfs:comment 'Current outstanding deferred revenue balance for this performance obligation — the portion of total contract value received or billed but not yet recognized as earned revenue. Drives the deferred revenue waterfall report and balance sheet liability disclosure. Updated each period-end close in SAP S/4HANA FI.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredRevenueGlAccountCode rdf:type rdf:Property ;
    rdfs:label 'Deferred Revenue Gl Account Code' ;
    rdfs:comment 'SAP S/4HANA GL account code for the deferred revenue liability balance sheet account. The deferred revenue balance is carried here until recognized. Required for balance sheet reporting and SOX-compliant financial controls.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountRate rdf:type rdf:Property ;
    rdfs:label 'Discount Rate' ;
    rdfs:comment 'The discount rate (as a decimal, e.g., 0.0450 for 4.50%) used to adjust for the significant financing component in the transaction price. Reflects the rate that would be used in a separate financing transaction between the entity and the counterparty at contract inception. Null when significant_financing_flag is false.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Last Recognition Date' ;
    rdfs:comment 'The date of the most recent revenue recognition posting for this performance obligation. Used to confirm period-end close completion and to identify schedules that have not been processed in the current period.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modificationDate rdf:type rdf:Property ;
    rdfs:label 'Modification Date' ;
    rdfs:comment 'The effective date of the most recent contract modification affecting this recognition schedule. Null when modification_flag is false. Used to determine the prospective or cumulative catch-up adjustment period.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modificationFlag rdf:type rdf:Property ;
    rdfs:label 'Modification Flag' ;
    rdfs:comment 'Indicates whether this recognition schedule reflects a contract modification (e.g., renegotiated broadcast rights fee, amended sponsorship scope). When true, the modification accounting treatment (prospective or cumulative catch-up) per ASC 606-10-25-12 / IFRS 15.18 must be documented.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Next Recognition Date' ;
    rdfs:comment 'The scheduled date for the next revenue recognition posting. Used by the FP&A team in Workday Adaptive Planning for revenue forecasting and by the accounting team to manage period-end close calendars.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceObligationDescription rdf:type rdf:Property ;
    rdfs:label 'Performance Obligation Description' ;
    rdfs:comment 'Narrative description of the distinct performance obligation being recognized, as documented in the contract and required for ASC 606 / IFRS 15 disclosure. Examples: \'Exclusive broadcast rights for NFL regular season games FY2024-FY2026\', \'Naming rights for stadium facade and digital signage\', \'Season ticket package — 41 home games\'.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodsRecognized rdf:type rdf:Property ;
    rdfs:label 'Periods Recognized' ;
    rdfs:comment 'Number of accounting periods for which revenue has been recognized to date against this performance obligation. Used to track progress toward full recognition and to validate cumulative_recognized_amount in period-end reconciliation.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recognitionBasis rdf:type rdf:Property ;
    rdfs:label 'Recognition Basis' ;
    rdfs:comment 'Indicates whether revenue is recognized over time (e.g., broadcast rights delivered continuously over a season) or at a point in time (e.g., a one-time PPV event, a single concert). Fundamental ASC 606 / IFRS 15 classification that determines the recognition pattern.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recognitionEndDate rdf:type rdf:Property ;
    rdfs:label 'Recognition End Date' ;
    rdfs:comment 'The date on which revenue recognition is expected to be fully completed for this performance obligation. For multi-year broadcast rights, this may span several fiscal years. Nullable for open-ended or usage-based obligations without a fixed end date.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recognitionMethod rdf:type rdf:Property ;
    rdfs:label 'Recognition Method' ;
    rdfs:comment 'The accounting method used to recognize revenue over the performance obligation period. Straight-line = equal amounts per period; Milestone = upon achievement of defined deliverables; Usage-based = proportional to actual consumption (e.g., broadcast impressions, CPM); Event-based = upon occurrence of specific events (e.g., game played); Proportional performance = based on percentage of obligation fulfilled.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recognitionStartDate rdf:type rdf:Property ;
    rdfs:label 'Recognition Start Date' ;
    rdfs:comment 'The date on which revenue recognition commences for this performance obligation. Typically aligns with contract effective date or the date the entity begins satisfying the performance obligation (e.g., first broadcast date, season opener, naming rights activation).' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recognitionStatus rdf:type rdf:Property ;
    rdfs:label 'Recognition Status' ;
    rdfs:comment 'Current lifecycle state of the revenue recognition schedule. Draft = under review; Active = currently recognizing revenue; Suspended = temporarily halted (e.g., contract dispute); Completed = fully recognized; Cancelled = contract terminated before full recognition.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule Number' ;
    rdfs:comment 'Externally-visible business identifier for this recognition schedule, formatted as RRS-{YYYY}-{NNNNNN}. Used in SAP S/4HANA FI/CO journal entry references, audit workpapers, and SEC financial reporting disclosures.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:significantFinancingFlag rdf:type rdf:Property ;
    rdfs:label 'Significant Financing Flag' ;
    rdfs:comment 'Indicates whether the contract contains a significant financing component requiring adjustment of the transaction price for the time value of money per ASC 606-10-32-15 / IFRS 15.60. Common in multi-year prepaid broadcast rights deals where cash is received significantly in advance of performance.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalContractValue rdf:type rdf:Property ;
    rdfs:label 'Total Contract Value' ;
    rdfs:comment 'The total transaction price allocated to this performance obligation as determined at contract inception per ASC 606 Step 3 (Determine Transaction Price) and Step 4 (Allocate Transaction Price). Expressed in the contract currency. Used as the basis for deferred revenue waterfall reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalRecognitionPeriods rdf:type rdf:Property ;
    rdfs:label 'Total Recognition Periods' ;
    rdfs:comment 'Total number of accounting periods over which revenue is to be recognized for this performance obligation. Used for straight-line recognition calculations and deferred revenue waterfall projections. For event-based recognition, represents the total number of qualifying events.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:variableConsiderationAmount rdf:type rdf:Property ;
    rdfs:label 'Variable Consideration Amount' ;
    rdfs:comment 'The estimated amount of variable consideration included in the transaction price at the most likely amount or expected value method per ASC 606. Applicable for contracts with performance bonuses, ratings escalators, or PPV revenue share components. Null when variable_consideration_flag is false.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variableConsiderationFlag rdf:type rdf:Property ;
    rdfs:label 'Variable Consideration Flag' ;
    rdfs:comment 'Indicates whether the transaction price includes variable consideration components (e.g., performance bonuses, ratings-based escalators, PPV revenue share, usage-based royalties). When true, the constraint on variable consideration per ASC 606 Step 3 must be applied and reassessed each reporting period.' ;
    rdfs:domain ind:RevenueRecognitionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Budget Amount' ;
    rdfs:comment 'Approved annual revenue budget for this stream in the stream\'s transactional currency, sourced from Workday Adaptive Planning FP&A models. Used as the baseline for variance analysis, EBITDA forecasting, and board-level revenue target reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualGrowthTargetPct rdf:type rdf:Property ;
    rdfs:label 'Annual Growth Target Pct' ;
    rdfs:comment 'Board-approved year-over-year revenue growth target for this stream expressed as a decimal percentage (e.g., 0.1200 = 12.00%). Used in FP&A scenario modeling, investor relations KPI reporting, and ARR growth tracking for subscription-based streams.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cpgApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Cpg Applicable Flag' ;
    rdfs:comment 'Indicates whether Cost Per Mille (CPM) pricing methodology applies to this revenue stream. True for broadcast advertising inventory, digital display sponsorships, and OTT pre-roll ad placements where revenue is calculated on a per-thousand-impressions basis. Drives ad inventory valuation in broadcast ad placement workflows.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drmApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Drm Applicable Flag' ;
    rdfs:comment 'Indicates whether Digital Rights Management (DRM) controls apply to the content or media assets generating this revenue stream. True for OTT, PPV, IPTV, and broadcast rights streams where content protection is mandated by rights agreements. Triggers DRM policy enforcement in Dalet Galaxy and CDN configurations.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ebitdaContributionFlag rdf:type rdf:Property ;
    rdfs:label 'Ebitda Contribution Flag' ;
    rdfs:comment 'Indicates whether this revenue stream is included in the enterprise EBITDA calculation reported to investors, lenders, and the SEC. False for pass-through revenue streams (e.g., league revenue sharing remittances) that are excluded from EBITDA by accounting policy.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ipRightsType rdf:type rdf:Property ;
    rdfs:label 'Ip Rights Type' ;
    rdfs:comment 'Classification of the IP rights position underlying this revenue stream. \'owned\' applies to proprietary league marks and team IP; \'licensed_out\' applies to broadcast rights deals and merchandise licensing; \'licensed_in\' applies to third-party content distribution; \'shared\' applies to co-branded sponsorship activations. Drives DRM policy assignment and IP royalty accounting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pciScopeFlag rdf:type rdf:Property ;
    rdfs:label 'Pci Scope Flag' ;
    rdfs:comment 'Indicates whether this revenue stream involves payment card transactions subject to PCI-DSS compliance requirements. True for ticketing (Ticketmaster/AXS), merchandise e-commerce (Shopify Plus), and venue POS transactions. Triggers PCI-DSS control requirements and quarterly compliance attestation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peakSeasonEndDate rdf:type rdf:Property ;
    rdfs:label 'Peak Season End Date' ;
    rdfs:comment 'Calendar date on which the primary revenue-generating season concludes for this stream (e.g., Super Bowl, NBA Finals, World Series). Paired with peak_season_start_date to define the active revenue window for seasonal cash flow modeling.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:peakSeasonStartDate rdf:type rdf:Property ;
    rdfs:label 'Peak Season Start Date' ;
    rdfs:comment 'Calendar date on which the primary revenue-generating season begins for this stream (e.g., NFL regular season kickoff, NBA opening night, concert tour launch). Used in cash flow forecasting, staffing plans, and venue operations scheduling.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingHierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Reporting Hierarchy Level' ;
    rdfs:comment 'Numeric level of this revenue stream within the enterprise revenue reporting hierarchy (1 = top-level category, 2 = subcategory, 3 = detailed stream). Enables hierarchical roll-up in FP&A dashboards, EBITDA waterfall charts, and SEC segment disclosures.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revenueSharingFlag rdf:type rdf:Property ;
    rdfs:label 'Revenue Sharing Flag' ;
    rdfs:comment 'Indicates whether this revenue stream is subject to league-mandated revenue sharing obligations under the applicable Collective Bargaining Agreement (CBA) or league constitution (e.g., NFL national media revenue pool, NBA Basketball Related Income sharing). Triggers intercompany settlement workflows in SAP S/4HANA.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revenueSharingPct rdf:type rdf:Property ;
    rdfs:label 'Revenue Sharing Pct' ;
    rdfs:comment 'The contractually mandated percentage of gross revenue from this stream that must be shared with the league office or other member clubs under the applicable CBA or revenue sharing agreement (e.g., 0.3400 = 34.00% of national broadcast revenue to league pool). Null when revenue_sharing_flag is False.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueStreamStatus rdf:type rdf:Property ;
    rdfs:label 'Revenue Stream Status' ;
    rdfs:comment 'Current lifecycle state of the revenue stream master record. \'active\' streams are live and generating revenue; \'pending\' are approved but not yet launched; \'seasonal\' are active only during defined event seasons; \'discontinued\' are retired streams retained for historical reporting.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalityPattern rdf:type rdf:Property ;
    rdfs:label 'Seasonality Pattern' ;
    rdfs:comment 'Describes the temporal revenue generation pattern for this stream. \'in_season\' applies to gate receipts and broadcast rights tied to league calendars; \'event_driven\' applies to PPV, concerts, and one-off events; \'year_round\' applies to OTT subscriptions and naming rights; \'quarterly\'/\'monthly\' applies to ratable sponsorship and licensing fees.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soxRelevantFlag rdf:type rdf:Property ;
    rdfs:label 'Sox Relevant Flag' ;
    rdfs:comment 'Indicates whether this revenue stream is within scope for SOX Section 302/404 internal controls over financial reporting. True for all material revenue streams contributing to SEC-reported financials. Triggers mandatory SOX control testing, documentation, and sign-off workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:streamCategory rdf:type rdf:Property ;
    rdfs:label 'Stream Category' ;
    rdfs:comment 'Top-level classification of the revenue stream aligned to Sports Entertainment\'s primary revenue pillars: ticketing (gate receipts, VIP, SRO), broadcast (RSN, OTT, PPV, DTC), sponsorship (naming rights, jersey, digital), merchandise (licensed SKUs, e-commerce), venue_rental (facility hire, HVAC services), gaming (fantasy, wagering), content (UGC licensing, DAM syndication), other. [ENUM-REF-CANDIDATE: ticketing|broadcast|sponsorship|merchandise|venue_rental|gaming|content|other — promote to reference product]' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streamCode rdf:type rdf:Property ;
    rdfs:label 'Stream Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the revenue stream, used in SAP S/4HANA FI/CO chart of accounts mapping, Workday Adaptive Planning budget models, and cross-system reconciliation. Examples: TICK_GA, BCAST_OTT, SPON_NAMING.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streamDescription rdf:type rdf:Property ;
    rdfs:label 'Stream Description' ;
    rdfs:comment 'Free-text business description of the revenue stream, including its commercial rationale, key contractual drivers, and relationship to league or event operations. Used in FP&A narrative reporting, board presentations, and SEC MD&A disclosures.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streamName rdf:type rdf:Property ;
    rdfs:label 'Stream Name' ;
    rdfs:comment 'Human-readable business name of the revenue stream (e.g., \'General Admission Ticketing\', \'OTT Broadcast Subscription\', \'Naming Rights Sponsorship\', \'Licensed Merchandise\'). Used in FP&A dashboards, EBITDA reporting, and SEC financial disclosures.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streamSubcategory rdf:type rdf:Property ;
    rdfs:label 'Stream Subcategory' ;
    rdfs:comment 'Second-level classification providing granular segmentation within the parent category. Examples: within ticketing — \'GA\', \'VIP\', \'SRO\', \'Season Pass\'; within broadcast — \'PPV\', \'OTT\', \'RSN\', \'DTC\'; within sponsorship — \'Naming Rights\', \'Jersey Patch\', \'Digital Activation\'. Supports drill-down analytics in FP&A and EBITDA reporting.' ;
    rdfs:domain ind:RevenueStream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Approval Threshold Amount' ;
    rdfs:comment 'Monetary threshold (in USD) above which the control requires escalated approval. For example, journal entries above $500,000 may require CFO approval. Drives the approval workflow configuration in SAP S/4HANA and is documented in the delegation of authority matrix.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalThresholdCurrency rdf:type rdf:Property ;
    rdfs:label 'Approval Threshold Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the approval_threshold_amount (e.g., USD, EUR, GBP). Required for multinational Sports Entertainment entities operating across global markets with different functional currencies.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverName rdf:type rdf:Property ;
    rdfs:label 'Approver Name' ;
    rdfs:comment 'Full name of the senior officer providing final sign-off, denormalized for inclusion in external auditor evidence packages and management representation letters.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Audit Period End Date' ;
    rdfs:comment 'End date of the period covered by this control instance\'s testing. Aligns to the SEC 10-Q or 10-K reporting period end date. Controls must be tested as of this date for the management assessment to be valid.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Audit Period Start Date' ;
    rdfs:comment 'Start date of the period covered by this control instance\'s testing. For annual controls, this is the first day of the fiscal year; for quarterly controls, the first day of the fiscal quarter. Defines the population from which audit samples are drawn.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:completionDate rdf:type rdf:Property ;
    rdfs:label 'Completion Date' ;
    rdfs:comment 'The actual date on which the control was completed and signed off by the control owner. Compared against due_date to identify late completions that may impact the period-end close timeline and SEC filing readiness.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:controlCategory rdf:type rdf:Property ;
    rdfs:label 'Control Category' ;
    rdfs:comment 'Categorization of the control within the SOX control hierarchy. Entity-level controls address the overall control environment; process-level controls address specific financial processes (e.g., revenue, payroll); IT general controls address IT infrastructure; IT application controls address automated controls within SAP S/4HANA FI/CO.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlCode rdf:type rdf:Property ;
    rdfs:label 'Control Code' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned to the control by the internal audit or compliance function (e.g., SOX-FICO-0042). Used in external auditor evidence packages and management representation letters to uniquely reference a control across reporting periods.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlFrequency rdf:type rdf:Property ;
    rdfs:label 'Control Frequency' ;
    rdfs:comment 'How often the control is performed or evaluated. Continuous controls operate in real-time (e.g., SAP S/4HANA automated posting validations); periodic controls are executed on a defined schedule aligned to the financial close calendar.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlName rdf:type rdf:Property ;
    rdfs:label 'Control Name' ;
    rdfs:comment 'Short, human-readable title of the internal control (e.g., \'Revenue Recognition Approval Gate\', \'Intercompany Elimination Review\'). Used in dashboards, audit reports, and management representation letters.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlObjective rdf:type rdf:Property ;
    rdfs:label 'Control Objective' ;
    rdfs:comment 'Narrative description of the financial reporting assertion or risk the control is designed to address (e.g., completeness of revenue, accuracy of accruals, existence of fixed assets). Maps to COSO/PCAOB financial statement assertions.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlStatus rdf:type rdf:Property ;
    rdfs:label 'Control Status' ;
    rdfs:comment 'Current operational status of the control within the SOX program lifecycle. Active controls are in scope for the current reporting period; under_remediation controls have identified deficiencies being addressed; retired controls have been decommissioned.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlType rdf:type rdf:Property ;
    rdfs:label 'Control Type' ;
    rdfs:comment 'Classification of the control by its timing relative to the risk event. Preventive controls stop errors before they occur (e.g., approval workflows); detective controls identify errors after the fact (e.g., reconciliations); corrective controls remediate identified errors.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyClassification rdf:type rdf:Property ;
    rdfs:label 'Deficiency Classification' ;
    rdfs:comment 'Severity classification of any identified control deficiency per SOX/PCAOB standards. Material weaknesses must be disclosed in the SEC 10-K; significant deficiencies are reported to the audit committee. None indicates no deficiency identified.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyDescription rdf:type rdf:Property ;
    rdfs:label 'Deficiency Description' ;
    rdfs:comment 'Narrative description of the identified control deficiency, including root cause analysis, the financial statement assertion affected, and the potential magnitude of misstatement. Required for SEC disclosure and audit committee reporting.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionMethod rdf:type rdf:Property ;
    rdfs:label 'Execution Method' ;
    rdfs:comment 'Indicates whether the control is performed manually by a human operator, executed automatically by SAP S/4HANA or another system, or is semi-automated (system-generated output reviewed by a human). Drives audit sampling strategy and reliance approach.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialProcessArea rdf:type rdf:Property ;
    rdfs:label 'Financial Process Area' ;
    rdfs:comment 'The SAP S/4HANA FI/CO business process area to which this control belongs (e.g., Financial Close, Revenue Recognition, Accounts Payable, Fixed Assets, Intercompany Settlements, Payroll, Budgeting and FP&A). Aligns controls to the chart of accounts and cost center hierarchy. [ENUM-REF-CANDIDATE: financial_close|revenue_recognition|accounts_payable|accounts_receivable|fixed_assets|intercompany|payroll|budgeting|tax|treasury — promote to reference product]' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalPeriod rdf:type rdf:Property ;
    rdfs:label 'Fiscal Period' ;
    rdfs:comment 'The fiscal quarter (Q1–Q4) or monthly period (P01–P12) within the fiscal year to which this control instance applies. Period-end controls are scoped to specific close periods aligned to SEC 10-Q quarterly and 10-K annual reporting deadlines.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isKeyControl rdf:type rdf:Property ;
    rdfs:label 'Is Key Control' ;
    rdfs:comment 'Indicates whether this control has been designated as a key control in the SOX scoping exercise. Key controls are those whose failure could result in a material misstatement of the financial statements and receive mandatory testing by external auditors.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPeriodEndControl rdf:type rdf:Property ;
    rdfs:label 'Is Period End Control' ;
    rdfs:comment 'Flags controls that are specifically part of the period-end financial close process (e.g., accrual postings, depreciation runs, intercompany eliminations, financial statement preparation, flux analysis). Enables filtering of the close checklist from the broader SOX control universe.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastTestDate rdf:type rdf:Property ;
    rdfs:label 'Last Test Date' ;
    rdfs:comment 'The most recent date on which the control was formally tested for operating effectiveness. Used to determine whether the control has been tested within the required frequency window and to schedule the next test cycle.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastTestedDate rdf:type rdf:Property ;
    rdfs:label 'Last Tested Date' ;
    rdfs:comment 'The most recent date on which this specific control-account pairing was formally tested for operating effectiveness. Sourced from detection-phase relationship data. Distinct from sox_control.last_test_date which reflects the control\'s overall last test, not per-account.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ownerName rdf:type rdf:Property ;
    rdfs:label 'Owner Name' ;
    rdfs:comment 'Full name of the employee responsible for the control, denormalized for audit evidence packages and management representation letters where the employee record may not be directly accessible to external auditors.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerTitle rdf:type rdf:Property ;
    rdfs:label 'Owner Title' ;
    rdfs:comment 'Job title of the control owner (e.g., VP Finance, Controller, CFO). Required for segregation of duties analysis and to validate that the control owner has appropriate authority relative to the financial assertion being controlled.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Completion Date' ;
    rdfs:comment 'Actual date on which remediation activities were completed and the corrective control was implemented. Compared against remediation_due_date to assess timeliness. Required for external auditor evidence package.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sapControlCode rdf:type rdf:Property ;
    rdfs:label 'Sap Control Code' ;
    rdfs:comment 'The native control identifier from SAP S/4HANA GRC (Governance, Risk and Compliance) or SAP Audit Management module, if the control is managed within the SAP ecosystem. Enables traceability between this Silver Layer record and the operational system of record.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segregationOfDutiesFlag rdf:type rdf:Property ;
    rdfs:label 'Segregation Of Duties Flag' ;
    rdfs:comment 'Indicates whether this control specifically addresses segregation of duties (SOD) requirements, such as preventing the same individual from initiating and approving a financial transaction in SAP S/4HANA. SOD controls are a primary focus of SOX Section 404 reviews.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signOffTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sign Off Timestamp' ;
    rdfs:comment 'Precise date and time when the approver provided final sign-off on the control\'s completion for the reporting period. Immutable once set. Required for SOX Section 302 CEO/CFO certification and external auditor evidence packages.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:systemAccessReviewFlag rdf:type rdf:Property ;
    rdfs:label 'System Access Review Flag' ;
    rdfs:comment 'Flags controls that involve periodic review of user access rights in SAP S/4HANA FI/CO or other financial systems. System access reviews are a standing SOX IT general control requirement to prevent unauthorized access to financial data.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:testResult rdf:type rdf:Property ;
    rdfs:label 'Test Result' ;
    rdfs:comment 'Outcome of the most recent operating effectiveness test. An ineffective result triggers deficiency classification and remediation workflow. Not_tested indicates the control is in scope but has not yet been evaluated in the current period.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testingFrequency rdf:type rdf:Property ;
    rdfs:label 'Testing Frequency' ;
    rdfs:comment 'How frequently this specific control-account pairing is tested, which may differ from the control\'s default control_frequency when certain high-risk accounts require more frequent testing. Sourced from detection-phase relationship data.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testingMethod rdf:type rdf:Property ;
    rdfs:label 'Testing Method' ;
    rdfs:comment 'The audit testing procedure applied to evaluate the operating effectiveness of the control. Reperformance and data analytics are preferred for high-risk controls; inquiry alone is insufficient per PCAOB standards. Drives the evidence collection approach.' ;
    rdfs:domain ind:SoxControl ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:athleteCompensationTaxableFlag rdf:type rdf:Property ;
    rdfs:label 'Athlete Compensation Taxable Flag' ;
    rdfs:comment 'Indicates whether athlete compensation (salary, NIL agreements, signing bonuses) earned in this jurisdiction is subject to jock tax or withholding tax. True = taxable; False = exempt. Drives payroll withholding in SAP SuccessFactors for multi-state athlete compensation.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastRightsTaxableFlag rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Taxable Flag' ;
    rdfs:comment 'Indicates whether broadcast and media rights revenue (OTT, RSN, PPV) is subject to tax in this jurisdiction. True = taxable; False = exempt. Relevant for DTC streaming subscription revenue and media rights deal settlements.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cityName rdf:type rdf:Property ;
    rdfs:label 'City Name' ;
    rdfs:comment 'Name of the city or municipality for city-level tax jurisdictions. Relevant for municipal entertainment taxes, amusement taxes, and city-level jock tax obligations (e.g., New York City, Chicago, Los Angeles).' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cityTaxRatePct rdf:type rdf:Property ;
    rdfs:label 'City Tax Rate Pct' ;
    rdfs:comment 'The city or municipal component of the combined tax rate, expressed as a percentage. Null when no city-level tax applies. Critical for venues in high-tax cities such as New York, Chicago, and Los Angeles.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:countyName rdf:type rdf:Property ;
    rdfs:label 'County Name' ;
    rdfs:comment 'Name of the county or parish within the state/province, where applicable. Relevant for county-level sales tax and entertainment tax jurisdictions (e.g., Los Angeles County, Cook County).' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countyTaxRatePct rdf:type rdf:Property ;
    rdfs:label 'County Tax Rate Pct' ;
    rdfs:comment 'The county-level component of the combined tax rate, expressed as a percentage. Null when no county-level tax applies. Used for accurate tax remittance to county taxing authorities.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entertainmentTaxRatePct rdf:type rdf:Property ;
    rdfs:label 'Entertainment Tax Rate Pct' ;
    rdfs:comment 'Specific entertainment or amusement tax rate levied on live event admissions, PPV (Pay-Per-View) transactions, and concert ticket sales. Separate from general sales tax. Applicable in jurisdictions such as Chicago (amusement tax) and New York City.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:filingDueDay rdf:type rdf:Property ;
    rdfs:label 'Filing Due Day' ;
    rdfs:comment 'Day of the month (1–31) by which the tax return and remittance must be submitted to the taxing authority following the close of the filing period. Used to drive automated tax calendar alerts in SAP S/4HANA FI.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:filingFrequency rdf:type rdf:Property ;
    rdfs:label 'Filing Frequency' ;
    rdfs:comment 'Required frequency for tax return filing and remittance to this jurisdiction\'s taxing authority. Event-based applies to jurisdictions requiring per-event filing (common for entertainment taxes on individual concerts or sporting events).' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestRatePct rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Pct' ;
    rdfs:comment 'Annual interest rate applied to unpaid or underpaid tax balances in this jurisdiction. Used in tax liability accrual calculations and EBITDA (Earnings Before Interest, Taxes, Depreciation, and Amortization) impact modeling.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jockTaxRatePct rdf:type rdf:Property ;
    rdfs:label 'Jock Tax Rate Pct' ;
    rdfs:comment 'Non-resident income tax rate applied to athlete compensation earned while performing in this jurisdiction. Calculated based on duty days or games played in the jurisdiction. Critical for multi-state athlete payroll compliance under CBA (Collective Bargaining Agreement) obligations across NFL, NBA, MLB, NHL, and MLS.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jurisdictionCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying the tax jurisdiction, aligned with SAP S/4HANA tax jurisdiction code (field TXJCD). Used as the business key for cross-system lookups and referenced in finance.cost_center.tax_jurisdiction_code, finance.profit_center.tax_jurisdiction_code, and finance.company_code.tax_jurisdiction_code.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionName rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Name' ;
    rdfs:comment 'Full human-readable name of the tax jurisdiction (e.g., \'State of California\', \'New York City\', \'Cook County Illinois\'). Used in financial reports, tax filings, and regulatory disclosures.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionType rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Type' ;
    rdfs:comment 'Classification of the tax jurisdiction level within the governmental hierarchy. Federal covers national-level taxes; state covers US state or equivalent; county covers sub-state regional; city covers municipal; district covers special taxing districts (e.g., stadium districts, entertainment zones); special covers other jurisdictions such as tribal or port authorities.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:merchandiseTaxableFlag rdf:type rdf:Property ;
    rdfs:label 'Merchandise Taxable Flag' ;
    rdfs:comment 'Indicates whether merchandise and licensed product sales (SKU-based) are subject to sales tax in this jurisdiction. True = taxable; False = exempt. Drives tax calculation in Shopify Plus POS (Point of Sale) and e-commerce transactions.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nexusEstablishedFlag rdf:type rdf:Property ;
    rdfs:label 'Nexus Established Flag' ;
    rdfs:comment 'Indicates whether Sports Entertainment has established tax nexus in this jurisdiction and is currently obligated to collect and remit taxes. True = nexus confirmed; False = no nexus or below threshold.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nexusThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Nexus Threshold Amount' ;
    rdfs:comment 'Minimum revenue threshold (in jurisdiction currency) above which Sports Entertainment establishes economic nexus and becomes obligated to collect and remit sales or entertainment tax in this jurisdiction. Post-South Dakota v. Wayfair (2018) economic nexus standard.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nexusThresholdCurrency rdf:type rdf:Property ;
    rdfs:label 'Nexus Threshold Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the nexus threshold amount (e.g., USD, CAD, GBP, EUR). Supports multi-currency international jurisdictions.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nexusTransactionThreshold rdf:type rdf:Property ;
    rdfs:label 'Nexus Transaction Threshold' ;
    rdfs:comment 'Minimum number of transactions above which economic nexus is established in this jurisdiction, independent of revenue amount. Many states use a dual threshold (e.g., 200 transactions OR $100,000 revenue). Null if jurisdiction uses revenue-only threshold.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nilIncomeTaxableFlag rdf:type rdf:Property ;
    rdfs:label 'Nil Income Taxable Flag' ;
    rdfs:comment 'Indicates whether NIL (Name, Image, and Likeness) income earned by athletes in this jurisdiction is subject to state income or withholding tax. True = taxable; False = exempt or not yet legislated. Reflects evolving NIL regulatory landscape post-2021.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyRatePct rdf:type rdf:Property ;
    rdfs:label 'Penalty Rate Pct' ;
    rdfs:comment 'Penalty rate expressed as a percentage of unpaid tax applied for late filing or late remittance in this jurisdiction. Used in tax risk modeling and FP&A (Financial Planning and Analysis) for tax liability forecasting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remittanceMethod rdf:type rdf:Property ;
    rdfs:label 'Remittance Method' ;
    rdfs:comment 'Required or preferred method for remitting tax payments to the taxing authority. EFT (Electronic Funds Transfer) is the most common for large filers; check for smaller jurisdictions; online portal for state-specific web filing; EDI (Electronic Data Interchange) for automated bulk remittance.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapTaxCode rdf:type rdf:Property ;
    rdfs:label 'Sap Tax Code' ;
    rdfs:comment 'SAP S/4HANA FI tax code (field MWSKZ) associated with this jurisdiction, used for tax determination in FI/CO postings, AP invoices, AR invoices, and journal entries. Links this reference record to SAP tax procedure configuration.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialDistrictRatePct rdf:type rdf:Property ;
    rdfs:label 'Special District Rate Pct' ;
    rdfs:comment 'Tax rate for special taxing districts such as stadium financing districts, sports authority districts, or entertainment zones. Null when no special district tax applies. Relevant for venues funded through public stadium bonds.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateProvinceCode rdf:type rdf:Property ;
    rdfs:label 'State Province Code' ;
    rdfs:comment 'ISO 3166-2 sub-national code for the state or province within the country (e.g., CA for California, NY for New York, ON for Ontario). Required for US multi-state jock tax filings and state income tax withholding for athlete compensation.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateTaxRatePct rdf:type rdf:Property ;
    rdfs:label 'State Tax Rate Pct' ;
    rdfs:comment 'The state-level component of the combined tax rate, expressed as a percentage. Enables decomposition of combined rates into state, county, and city components for accurate tax remittance and reporting.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxBasis rdf:type rdf:Property ;
    rdfs:label 'Tax Basis' ;
    rdfs:comment 'The taxable base upon which the tax rate is applied. Gross Receipts includes all revenue; Net Receipts excludes certain deductions; Admission Price is the ticket face value for entertainment tax; Face Value is the printed ticket price excluding fees; Duty Days is the allocation method for jock tax based on days worked in jurisdiction.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxExemptCategories rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Categories' ;
    rdfs:comment 'Comma-separated list of revenue or transaction categories that are explicitly exempt from taxation in this jurisdiction (e.g., \'food_and_beverage,nonprofit_events,youth_sports\'). Null if no exemptions apply. Supports accurate tax calculation by excluding exempt revenue streams.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxJurisdictionStatus rdf:type rdf:Property ;
    rdfs:label 'Tax Jurisdiction Status' ;
    rdfs:comment 'Current lifecycle status of the tax jurisdiction record. Active = currently in use for tax calculations; Inactive = no longer applicable; Pending = approved but not yet effective; Superseded = replaced by a newer version of the same jurisdiction.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxingAuthorityCode rdf:type rdf:Property ;
    rdfs:label 'Taxing Authority Code' ;
    rdfs:comment 'Short code identifying the taxing authority for system integration and SAP S/4HANA FI tax authority configuration. Used in automated tax remittance workflows.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxingAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Taxing Authority Name' ;
    rdfs:comment 'Full legal name of the government agency or taxing authority responsible for administering this jurisdiction\'s taxes (e.g., \'California Department of Tax and Fee Administration\', \'New York State Department of Taxation and Finance\', \'HM Revenue and Customs\').' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketSalesTaxableFlag rdf:type rdf:Property ;
    rdfs:label 'Ticket Sales Taxable Flag' ;
    rdfs:comment 'Indicates whether ticket sales (general admission, VIP, SRO) are subject to sales or entertainment tax in this jurisdiction. True = taxable; False = exempt. Drives tax calculation in Ticketmaster/AXS and Archtics ticketing systems.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vatRatePct rdf:type rdf:Property ;
    rdfs:label 'Vat Rate Pct' ;
    rdfs:comment 'VAT (Value Added Tax) rate applicable in international jurisdictions (e.g., EU member states, UK, Canada GST/HST). Null for US domestic jurisdictions. Required for FIFA, UEFA, and international broadcast rights transactions subject to VAT.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withholdingTaxRatePct rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Rate Pct' ;
    rdfs:comment 'Income tax withholding rate applicable to non-resident athlete and performer compensation paid in this jurisdiction. Used for payroll processing in SAP SuccessFactors and SAP S/4HANA FI/CO for multi-state athlete salary withholding.' ;
    rdfs:domain ind:TaxJurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetUnderConstructionFixedAssetId rdf:type rdf:Property ;
    rdfs:label 'Asset Under Construction Fixed Asset Id' ;
    rdfs:comment 'Reference to the SAP Fixed Asset (Asset Under Construction) number linked to this WBS element for CAPEX projects. Populated when costs are being capitalized to a tangible or intangible asset (e.g., venue construction, broadcast infrastructure).' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FixedAsset .

ind:responsibleManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Responsible Manager Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: WBS elements for capital projects (stadium renovations, broadcast infrastructure) have a responsible project manager who is an employee. This link enables project cost accountability reporting and SOX' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualCostAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Cost Amount' ;
    rdfs:comment 'Total actual costs posted to this WBS element or internal order to date, sourced from SAP CO actual cost line items. Used for budget vs. actual variance reporting and EBITDA analysis.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualFinishDate rdf:type rdf:Property ;
    rdfs:label 'Actual Finish Date' ;
    rdfs:comment 'The date on which work was actually completed on this WBS element. Used for schedule variance analysis, CAPEX capitalization triggers, and project close-out.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Revenue Amount' ;
    rdfs:comment 'Actual revenue recognized against this WBS element from billing documents. Applicable for billing elements. Supports project-level P&L actuals and SEC revenue recognition reporting under ASC 606.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetProfileCode rdf:type rdf:Property ;
    rdfs:label 'Budget Profile Code' ;
    rdfs:comment 'SAP budget profile code controlling budget availability checking behavior for this WBS element (e.g., whether budget overruns trigger warnings or hard errors). Supports financial governance and SOX budget controls.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committedCostAmount rdf:type rdf:Property ;
    rdfs:label 'Committed Cost Amount' ;
    rdfs:comment 'Total value of open purchase orders and commitments posted against this WBS element. Represents future obligations not yet invoiced. Used for available-budget calculations (budget minus actuals minus commitments).' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:elementType rdf:type rdf:Property ;
    rdfs:label 'Element Type' ;
    rdfs:comment 'Discriminator indicating whether this record represents a hierarchical WBS element within a project structure or a standalone internal order (simple cost collector). Drives downstream processing logic and settlement rules.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentProfileCode rdf:type rdf:Property ;
    rdfs:label 'Investment Profile Code' ;
    rdfs:comment 'SAP Investment Management profile code assigned to CAPEX WBS elements, defining capitalization rules, depreciation parameters, and AuC settlement behavior for capital projects (e.g., venue construction, digital platform builds).' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAccountAssignmentElement rdf:type rdf:Property ;
    rdfs:label 'Is Account Assignment Element' ;
    rdfs:comment 'Indicates whether actual costs (purchase orders, goods receipts, time confirmations) can be posted directly to this WBS element. True = direct cost posting allowed. Critical for CAPEX tracking and AuC accounting.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isBillingElement rdf:type rdf:Property ;
    rdfs:label 'Is Billing Element' ;
    rdfs:comment 'Indicates whether this WBS element is designated as a billing element, enabling it to be referenced on customer billing documents (e.g., for sponsored events or broadcast rights invoicing). True = billing element; False = cost collection only.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPlanningElement rdf:type rdf:Property ;
    rdfs:label 'Is Planning Element' ;
    rdfs:comment 'Indicates whether cost and revenue planning is permitted directly on this WBS element. True = planning allowed; False = planning only at subordinate levels. Drives FP&A budget entry controls.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:longDescription rdf:type rdf:Property ;
    rdfs:label 'Long Description' ;
    rdfs:comment 'Extended narrative description of the WBS element scope, objectives, and deliverables. Supports project documentation, audit trails, and business case traceability.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderTypeCode rdf:type rdf:Property ;
    rdfs:label 'Order Type Code' ;
    rdfs:comment 'SAP order type code classifying the internal order category (e.g., \'CAPEX\', \'OPEX\', \'MKTG\', \'EVENT\'). Applicable when element_type is INTERNAL_ORDER. Determines settlement profile, budget profile, and planning parameters.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentWbsCode rdf:type rdf:Property ;
    rdfs:label 'Parent Wbs Code' ;
    rdfs:comment 'The WBS code of the immediate parent element in the project hierarchy. Enables hierarchical traversal and rollup of costs, budgets, and actuals from work packages to project root.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedCostAmount rdf:type rdf:Property ;
    rdfs:label 'Planned Cost Amount' ;
    rdfs:comment 'Total planned (estimated) costs for this WBS element as entered in SAP CO cost planning. Represents the bottom-up cost estimate used for budget comparison and variance analysis.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plannedFinishDate rdf:type rdf:Property ;
    rdfs:label 'Planned Finish Date' ;
    rdfs:comment 'The scheduled completion date for this WBS element as defined in the project plan. Drives milestone tracking, CAPEX capitalization timelines, and project close-out scheduling.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plannedRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Planned Revenue Amount' ;
    rdfs:comment 'Planned revenue associated with this WBS element, applicable for billing elements tied to customer projects (e.g., sponsored event deliverables, broadcast rights packages). Supports project-level P&L planning.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plannedStartDate rdf:type rdf:Property ;
    rdfs:label 'Planned Start Date' ;
    rdfs:comment 'The scheduled start date for work on this WBS element as defined in the project plan. Used for timeline tracking, resource scheduling, and milestone reporting.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planningProfileCode rdf:type rdf:Property ;
    rdfs:label 'Planning Profile Code' ;
    rdfs:comment 'SAP planning profile code defining the cost planning method and parameters for this WBS element (e.g., unit costing, easy cost planning). Governs how FP&A teams enter and manage cost estimates.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectCategory rdf:type rdf:Property ;
    rdfs:label 'Project Category' ;
    rdfs:comment 'Business classification of the project or activity this WBS element supports. Drives CAPEX vs OPEX accounting treatment, asset-under-construction (AuC) tracking, and FP&A reporting. [ENUM-REF-CANDIDATE: CAPEX|OPEX|EVENT_PRODUCTION|MARKETING_CAMPAIGN|ATHLETE_SIGNING|BROADCAST_INFRA|DIGITAL_PLATFORM|VENUE_CONSTRUCTION|LICENSING — promote to reference product]' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectDefinitionCode rdf:type rdf:Property ;
    rdfs:label 'Project Definition Code' ;
    rdfs:comment 'The SAP project definition identifier to which this WBS element belongs, representing the top-level project container (e.g., \'VENUE-CONSTRUCT-2024\'). Links the WBS element to its parent project hierarchy.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseDate rdf:type rdf:Property ;
    rdfs:label 'Release Date' ;
    rdfs:comment 'The date on which this WBS element or internal order was released (status changed to RELEASED) in SAP CO, authorizing actual cost postings. Key milestone for project governance and budget control activation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sapSourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Sap Source System Code' ;
    rdfs:comment 'Identifier of the SAP S/4HANA system instance from which this WBS element record was sourced (e.g., \'S4H_PRD_100\'). Supports multi-system landscapes and data lineage in the Databricks Silver Layer.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementReceiverType rdf:type rdf:Property ;
    rdfs:label 'Settlement Receiver Type' ;
    rdfs:comment 'The type of CO object that receives settled costs from this WBS element. Drives CAPEX capitalization (FIXED_ASSET), overhead absorption (COST_CENTER), or P&L posting (GL_ACCOUNT/PROFITABILITY_SEGMENT).' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementRuleType rdf:type rdf:Property ;
    rdfs:label 'Settlement Rule Type' ;
    rdfs:comment 'Defines how costs accumulated on this WBS element are settled to receivers (e.g., fixed assets, cost centers, profitability segments). FULL = 100% to one receiver; PERCENTAGE = split by percentage; EQUIVALENCE_NUMBERS = proportional split.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicalCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Technical Completion Date' ;
    rdfs:comment 'The date on which this WBS element was set to TECHNICALLY_COMPLETE status in SAP, indicating all work is done and no further cost postings are expected. Triggers CAPEX capitalization and settlement processing.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:userStatusCode rdf:type rdf:Property ;
    rdfs:label 'User Status Code' ;
    rdfs:comment 'Customer-defined status code applied to the WBS element beyond the SAP system status (e.g., \'PENDING_APPROVAL\', \'BUDGET_EXCEEDED\', \'ON_HOLD\'). Supports business-specific workflow controls.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsCode rdf:type rdf:Property ;
    rdfs:label 'Wbs Code' ;
    rdfs:comment 'The externally-known alphanumeric code assigned to the WBS element or internal order in SAP CO/PS (e.g., \'VENUE-2024-001.1.2\' or \'IO-MKT-2024-0045\'). This is the business-facing identifier used in project plans, purchase orders, and financial reports.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsElementStatus rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Status' ;
    rdfs:comment 'Current system status of the WBS element or internal order in SAP CO/PS lifecycle. CREATED: initial setup; RELEASED: approved for cost postings; TECHNICALLY_COMPLETE: work done, no further postings; CLOSED: fully settled and archived; LOCKED: temporarily blocked.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Age Verification Required' ;
    rdfs:comment 'Indicates whether bettors must complete age verification before placing wagers on this market. True = age verification mandatory; False = standard KYC suffices. Driven by jurisdiction-specific regulatory requirements.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:displayOrder rdf:type rdf:Property ;
    rdfs:label 'Display Order' ;
    rdfs:comment 'Numeric ordering value controlling the sequence in which this market is presented within its market category on betting interfaces and odds feeds. Lower values appear first. Supports merchandising and fan engagement optimization.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isFuturesMarket rdf:type rdf:Property ;
    rdfs:label 'Is Futures Market' ;
    rdfs:comment 'Indicates whether this market is a futures wagering product where the outcome is determined at a future date (e.g., season champion, award winner). True = futures market; False = event-specific market. Affects settlement timeline and liability reporting.' ;
    rdfs:domain ind:BettingMarket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLiveInplay rdf:type rdf:Property ;
    rdfs:label 'Is Live Inplay' ;
    rdfs:comment 'Indicates whether this market is offered as a live in-play (in-game) wagering product where odds update in real time during the event. True = live in-play market; False = pre-game market. Drives real-time odds feed routing and latency SLA requirements.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isParlayEligible rdf:type rdf:Property ;
    rdfs:label 'Is Parlay Eligible' ;
    rdfs:comment 'Indicates whether this market can be combined into a parlay or teaser multi-leg wager. True = eligible for parlay inclusion; False = must be wagered as a standalone market. Governs parlay construction rules in the betting platform.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marginPercentage rdf:type rdf:Property ;
    rdfs:label 'Margin Percentage' ;
    rdfs:comment 'The operator\'s built-in margin (overround/vig) applied to this market, expressed as a decimal percentage (e.g., 0.0500 = 5%). Represents the house edge embedded in the odds. Confidential commercial data used for profitability analysis and pricing strategy.' ;
    rdfs:domain ind:BettingMarket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketCategory rdf:type rdf:Property ;
    rdfs:label 'Market Category' ;
    rdfs:comment 'High-level grouping of the market by scope: Game = single-game outcome; Season = full-season result (e.g., division winner); Tournament = multi-round competition outcome; Player = individual athlete performance; Team = team-level statistic; Entertainment = non-sport event (e.g., awards show outcome).' ;
    rdfs:domain ind:BettingMarket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketCloseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Market Close Timestamp' ;
    rdfs:comment 'Date and time when this wagering market was closed and no further wagers were accepted. For pre-game markets this is typically event start time; for live markets it is the point of suspension or event conclusion.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:marketCode rdf:type rdf:Property ;
    rdfs:label 'Market Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this market definition across odds feeds, prop bet catalogs, and regulatory reporting systems. Used as the business key in downstream integrations.' ;
    rdfs:domain ind:BettingMarket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketOpenTimestamp rdf:type rdf:Property ;
    rdfs:label 'Market Open Timestamp' ;
    rdfs:comment 'Date and time when this wagering market was first opened and made available for bet placement. Used for audit trails, regulatory reporting, and market lifecycle analytics.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:marketSourceFeed rdf:type rdf:Property ;
    rdfs:label 'Market Source Feed' ;
    rdfs:comment 'Identifier of the external odds feed provider or internal pricing engine that originates the market definition and odds for this market (e.g., \'SPORTRADAR\', \'GENIUS_SPORTS\', \'INTERNAL_TRADING\'). Supports feed reconciliation and SLA monitoring.' ;
    rdfs:domain ind:BettingMarket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketStatus rdf:type rdf:Property ;
    rdfs:label 'Market Status' ;
    rdfs:comment 'Current operational lifecycle state of the wagering market. Open = accepting wagers; Suspended = temporarily halted (e.g., injury news, VAR review); Closed = no longer accepting wagers; Settled = outcome determined and payouts processed; Voided = market cancelled with stakes returned; Pending = awaiting activation.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketTypeCode rdf:type rdf:Property ;
    rdfs:label 'Market Type Code' ;
    rdfs:comment 'Classification of the wagering market structure. Moneyline = straight win/loss; Spread = point spread handicap; Total = over/under aggregate score; Futures = outcome of future event; Parlay = multi-leg combined bet; Teaser = adjusted spread/total parlay; Prop = proposition/player-specific bet; Live In-Play = real-time in-game market. [ENUM-REF-CANDIDATE: moneyline|spread|total|futures|parlay|teaser|prop|live_inplay — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxLiabilityAmount rdf:type rdf:Property ;
    rdfs:label 'Max Liability Amount' ;
    rdfs:comment 'Maximum total financial exposure the operator accepts across all wagers on this market before triggering automatic suspension or odds adjustment. Expressed in the operating currency. Confidential risk management parameter.' ;
    rdfs:domain ind:BettingMarket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxPayoutAmount rdf:type rdf:Property ;
    rdfs:label 'Max Payout Amount' ;
    rdfs:comment 'Maximum total payout the operator will honor for a single winning wager on this market, expressed in the operating currency. Caps operator liability for high-odds outcomes.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxStakeAmount rdf:type rdf:Property ;
    rdfs:label 'Max Stake Amount' ;
    rdfs:comment 'Maximum wager amount permitted on this market per bet placement, expressed in the operating currency. Enforced to manage operator liability exposure and comply with responsible gaming limits.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minStakeAmount rdf:type rdf:Property ;
    rdfs:label 'Min Stake Amount' ;
    rdfs:comment 'Minimum wager amount permitted on this market per bet placement, expressed in the operating currency. Enforced at point-of-sale to comply with operator risk management and regulatory minimums.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oddsFormat rdf:type rdf:Property ;
    rdfs:label 'Odds Format' ;
    rdfs:comment 'Default odds presentation format for this market. American = moneyline (+/-); Decimal = European multiplier; Fractional = UK traditional; Hong Kong/Indonesian/Malay = regional formats. Drives display logic in betting interfaces and odds feeds.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propBetCategory rdf:type rdf:Property ;
    rdfs:label 'Prop Bet Category' ;
    rdfs:comment 'For proposition (prop) bet markets, classifies the type of proposition: Player Performance = individual athlete stat (e.g., passing yards, points scored); Team Statistic = team-level metric; Game Event = specific in-game occurrence (e.g., first score method); Entertainment = non-sport proposition; None = not a prop bet market.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryMarketCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Market Code' ;
    rdfs:comment 'The market identifier assigned by the relevant gaming regulatory authority for official reporting and audit purposes. Required for regulatory filings in licensed jurisdictions. May differ from internal market_code.' ;
    rdfs:domain ind:BettingMarket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleGamingFlag rdf:type rdf:Property ;
    rdfs:label 'Responsible Gaming Flag' ;
    rdfs:comment 'Indicates whether this market has been flagged for enhanced responsible gaming controls (e.g., lower stake limits, mandatory cooling-off prompts, exclusion from promotional offers). True = enhanced controls active; False = standard controls apply.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementOutcome rdf:type rdf:Property ;
    rdfs:label 'Settlement Outcome' ;
    rdfs:comment 'The official result used to settle this market (e.g., \'HOME_WIN\', \'OVER\', \'PLAYER_A\', \'PUSH\'). Populated after event conclusion and official score confirmation. Null until market is settled. [ENUM-REF-CANDIDATE: HOME_WIN|AWAY_WIN|DRAW|OVER|UNDER|PUSH|VOID|CANCELLED — promote to reference product]' ;
    rdfs:domain ind:BettingMarket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementRuleCode rdf:type rdf:Property ;
    rdfs:label 'Settlement Rule Code' ;
    rdfs:comment 'Code referencing the official settlement rule set applied to determine winning outcomes for this market (e.g., REGULATION_TIME_ONLY, INCLUDING_OT, OFFICIAL_SCORE_AT_CLOSE). Governs how and when the market is settled post-event.' ;
    rdfs:domain ind:BettingMarket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementRuleDescription rdf:type rdf:Property ;
    rdfs:label 'Settlement Rule Description' ;
    rdfs:comment 'Plain-language description of the settlement rules for this market, including conditions for void, push, or partial settlement. Displayed to bettors and referenced in regulatory filings.' ;
    rdfs:domain ind:BettingMarket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Settlement Timestamp' ;
    rdfs:comment 'Date and time when the market outcome was officially determined and winning wagers were settled. Null if market is not yet settled. Critical for financial reconciliation and regulatory reporting.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:spreadValue rdf:type rdf:Property ;
    rdfs:label 'Spread Value' ;
    rdfs:comment 'The handicap value applied to the favored team or participant in a spread market (e.g., -3.5 means the favorite must win by more than 3.5 points). Null for non-spread market types.' ;
    rdfs:domain ind:BettingMarket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalLineValue rdf:type rdf:Property ;
    rdfs:label 'Total Line Value' ;
    rdfs:comment 'The aggregate score or statistical threshold set for an over/under (totals) market (e.g., 47.5 total points in an NFL game). Bettors wager on whether the actual result exceeds or falls below this value. Null for non-totals market types.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:affiliateCode rdf:type rdf:Property ;
    rdfs:label 'Affiliate Code' ;
    rdfs:comment 'Affiliate or partner referral code applied at account registration. Used to attribute the account acquisition to a specific affiliate partner for commission calculation and partnership performance reporting.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageVerified rdf:type rdf:Property ;
    rdfs:label 'Age Verified' ;
    rdfs:comment 'Indicates whether the bettor has passed mandatory age verification confirming they meet the minimum legal gambling age for their registration jurisdiction. Accounts with False status are restricted from wagering activity.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ageVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Age Verified Date' ;
    rdfs:comment 'Date on which the bettor\'s age was successfully verified. Null if age verification has not been completed. Required for regulatory compliance reporting.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:balance rdf:type rdf:Property ;
    rdfs:label 'Balance' ;
    rdfs:comment 'Current real-money balance available in the bettor\'s account for wagering, expressed in the account\'s base currency. Excludes bonus funds. Updated in real time following deposits, withdrawals, wager placements, and settlements.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusBalance rdf:type rdf:Property ;
    rdfs:label 'Bonus Balance' ;
    rdfs:comment 'Current promotional or bonus credit balance in the bettor\'s account. Bonus funds are subject to wagering requirements before withdrawal and are tracked separately from real-money balance per regulatory requirements.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositLimitDaily rdf:type rdf:Property ;
    rdfs:label 'Deposit Limit Daily' ;
    rdfs:comment 'Maximum amount the bettor is permitted to deposit within a rolling 24-hour period. Set by the bettor or operator as a responsible gaming control. Null indicates no limit is set. Enforced at the platform level.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositLimitMonthly rdf:type rdf:Property ;
    rdfs:label 'Deposit Limit Monthly' ;
    rdfs:comment 'Maximum amount the bettor is permitted to deposit within a rolling 30-day period. A responsible gaming control that can be set by the bettor or mandated by the operator or regulator. Null indicates no limit is set.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositLimitWeekly rdf:type rdf:Property ;
    rdfs:label 'Deposit Limit Weekly' ;
    rdfs:comment 'Maximum amount the bettor is permitted to deposit within a rolling 7-day period. A responsible gaming control that can be set by the bettor or mandated by the operator or regulator. Null indicates no limit is set.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fullName rdf:type rdf:Property ;
    rdfs:label 'Full Name' ;
    rdfs:comment 'Full legal name of the bettor as provided during registration and confirmed through KYC. Used for identity matching, regulatory reporting, and tax documentation (e.g., W-2G forms for large winnings).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geolocationVerified rdf:type rdf:Property ;
    rdfs:label 'Geolocation Verified' ;
    rdfs:comment 'Indicates whether the bettor\'s physical location has been verified as within a licensed jurisdiction at the time of account registration or most recent login. Required for compliance with state-level online gaming regulations that restrict wagering to in-state bettors.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:identityDocumentExpiry rdf:type rdf:Property ;
    rdfs:label 'Identity Document Expiry' ;
    rdfs:comment 'Expiry date of the identity document submitted for KYC. Used to trigger re-verification workflows when documents approach or pass expiry, ensuring ongoing KYC compliance.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:identityDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Identity Document Reference' ;
    rdfs:comment 'Tokenized or masked reference to the government-issued identity document number used for KYC verification. The full document number is stored in the secure KYC vault; this field holds only the vault reference token to enable audit linkage without exposing raw PII.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityDocumentType rdf:type rdf:Property ;
    rdfs:label 'Identity Document Type' ;
    rdfs:comment 'Type of government-issued identity document submitted for KYC verification. Determines the applicable document validation rules and expiry tracking requirements.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycStatus rdf:type rdf:Property ;
    rdfs:label 'Kyc Status' ;
    rdfs:comment 'Current status of the Know Your Customer (KYC) identity verification process for this account. Accounts must achieve \'verified\' status before full wagering privileges are granted. \'expired\' indicates previously verified documents have lapsed and re-verification is required.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Kyc Verified Date' ;
    rdfs:comment 'Date on which the bettor\'s identity was successfully verified through the KYC process. Null if KYC has not been completed. Used for compliance audit trails and re-verification scheduling.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossLimitDaily rdf:type rdf:Property ;
    rdfs:label 'Loss Limit Daily' ;
    rdfs:comment 'Maximum net loss the bettor is permitted to incur within a rolling 24-hour period. A responsible gaming control that triggers account suspension when reached. Null indicates no limit is set.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:phoneNumber rdf:type rdf:Property ;
    rdfs:label 'Phone Number' ;
    rdfs:comment 'Primary mobile or landline phone number registered on the bettor account. Used for two-factor authentication, responsible gaming outreach, and account recovery. Classified as restricted PII.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promoCodeUsed rdf:type rdf:Property ;
    rdfs:label 'Promo Code Used' ;
    rdfs:comment 'Promotional or welcome offer code entered by the bettor at account registration. Used to apply welcome bonuses, track promotional campaign effectiveness, and calculate bonus liability.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Registration Jurisdiction' ;
    rdfs:comment 'ISO 3166-1 alpha-2 or alpha-3 code for the jurisdiction (state, province, or country) under which this account was registered and is licensed to operate. Determines applicable regulatory framework, tax obligations, and responsible gaming requirements.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationStateCode rdf:type rdf:Property ;
    rdfs:label 'Registration State Code' ;
    rdfs:comment 'Two-letter US state or Canadian province code where the bettor account was registered. Used for state-level regulatory reporting, tax withholding, and geofencing compliance. Complements registration_jurisdiction for sub-national precision.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleGamingFlagDate rdf:type rdf:Property ;
    rdfs:label 'Responsible Gaming Flag Date' ;
    rdfs:comment 'Date on which the responsible gaming flag was most recently set on this account. Used to track the duration of elevated monitoring and schedule periodic reviews.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:selfExclusionEndDate rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion End Date' ;
    rdfs:comment 'Date on which the bettor\'s self-exclusion period is scheduled to end. Null for indefinite exclusions or accounts with no exclusion. Used to trigger re-activation eligibility workflows.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:selfExclusionStartDate rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion Start Date' ;
    rdfs:comment 'Date on which the bettor\'s self-exclusion period began. Null if no self-exclusion is active or has ever been applied. Required for regulatory compliance and re-activation eligibility calculations.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:selfExclusionStatus rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion Status' ;
    rdfs:comment 'Indicates whether the bettor has enrolled in a self-exclusion program. \'voluntary\' means bettor-initiated exclusion; \'mandatory\' means regulator or operator-imposed exclusion; \'expired\' means a prior exclusion period has ended. Accounts with active exclusion are blocked from wagering.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceChannel rdf:type rdf:Property ;
    rdfs:label 'Source Channel' ;
    rdfs:comment 'Channel through which the bettor account was originally registered. Used for customer acquisition cost (CAC) attribution, affiliate commission calculations, and channel performance analytics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdReference rdf:type rdf:Property ;
    rdfs:label 'Tax Id Reference' ;
    rdfs:comment 'Tokenized reference to the bettor\'s tax identification number (e.g., SSN or ITIN in the US) stored in the secure KYC vault. Required for IRS W-2G tax reporting on winnings exceeding regulatory thresholds. The raw TIN is never stored in this field.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:twoFactorAuthEnabled rdf:type rdf:Property ;
    rdfs:label 'Two Factor Auth Enabled' ;
    rdfs:comment 'Indicates whether the bettor has enabled two-factor authentication (2FA) on their account. Relevant for security posture reporting and may be mandated by certain jurisdictions for high-value accounts.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:w2gThresholdMet rdf:type rdf:Property ;
    rdfs:label 'W2g Threshold Met' ;
    rdfs:comment 'Indicates whether the bettor has met the IRS W-2G reportable winnings threshold ($600 or more at 300:1 odds or greater, or $1,200+ for certain game types) within the current tax year. Triggers tax documentation workflows.' ;
    rdfs:domain ind:BettorAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wagerLimitDaily rdf:type rdf:Property ;
    rdfs:label 'Wager Limit Daily' ;
    rdfs:comment 'Maximum total wager amount the bettor is permitted to place within a rolling 24-hour period. A responsible gaming control. Null indicates no limit is set.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fanSegmentId rdf:type rdf:Property ;
    rdfs:label 'Fan Fan Segment Id' ;
    rdfs:comment 'Foreign key linking to fan.segment. Business justification: CRM-driven bonus targeting: bonus offers are targeted to specific fan segments (lapsed bettors, high-value fans, season ticket holders). Replacing the denormalized eligible_bettor_segment text field w' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Segment .

ind:rewardSkuCatalogId rdf:type rdf:Property ;
    rdfs:label 'Reward Sku Catalog Id' ;
    rdfs:comment 'Foreign key linking to merchandise.sku_catalog. Business justification: Merchandise reward in gaming bonus offers: Bonus offers in Sports Entertainment platforms include physical merchandise rewards (e.g., \'deposit bonus includes free team jersey\'). Linking bonus_offer to' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SkuCatalog .

ind:bonusAmount rdf:type rdf:Property ;
    rdfs:label 'Bonus Amount' ;
    rdfs:comment 'Fixed monetary value of the bonus awarded to the bettor upon offer redemption (e.g., $50 free bet credit). Applicable for fixed-value offer types. Null for percentage-based offers where bonus_percentage applies instead.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusPercentage rdf:type rdf:Property ;
    rdfs:label 'Bonus Percentage' ;
    rdfs:comment 'Percentage of the qualifying deposit or stake that is matched as a bonus (e.g., 100% deposit match). Applicable for percentage-based offer types such as deposit match bonuses. Null for fixed-amount offers.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibleMarketScope rdf:type rdf:Property ;
    rdfs:label 'Eligible Market Scope' ;
    rdfs:comment 'Defines the breadth of betting markets on which the bonus can be applied. Specific_markets requires a companion reference to the betting_market catalog. Drives settlement and wagering contribution calculations.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleSportCodes rdf:type rdf:Property ;
    rdfs:label 'Eligible Sport Codes' ;
    rdfs:comment 'Pipe-delimited list of sport codes (e.g., NFL|NBA|MLB|NHL|MLS|UFC) for which this bonus offer is valid. Null or \'ALL\' indicates no sport restriction. Used to restrict free bets or odds boosts to specific sports.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fantasyLeagueEligible rdf:type rdf:Property ;
    rdfs:label 'Fantasy League Eligible' ;
    rdfs:comment 'Indicates whether this bonus offer is applicable to fantasy sports contest entry fees or fantasy league operations, in addition to or instead of traditional sports wagering markets.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFirstDepositOnly rdf:type rdf:Property ;
    rdfs:label 'Is First Deposit Only' ;
    rdfs:comment 'Indicates whether this offer is exclusively available on a bettor\'s first qualifying deposit. True restricts the offer to first-time depositors; False allows it on any qualifying deposit.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOptInRequired rdf:type rdf:Property ;
    rdfs:label 'Is Opt In Required' ;
    rdfs:comment 'Indicates whether the bettor must explicitly opt in to this offer before it is activated. True = bettor must take an affirmative action; False = offer is automatically applied upon meeting trigger conditions.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionAvailability rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Availability' ;
    rdfs:comment 'Pipe-delimited list of jurisdiction codes (state, province, or country) where this offer is permitted and available (e.g., NJ|PA|CO|MI). Drives geo-targeting and compliance gating at offer display and redemption.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionExclusion rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Exclusion' ;
    rdfs:comment 'Pipe-delimited list of jurisdiction codes explicitly excluded from this offer, even if they fall within a broader availability region. Used for regulatory compliance where specific jurisdictions prohibit certain bonus types.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Kyc Verification Required' ;
    rdfs:comment 'Indicates whether the bettor must have completed full Know Your Customer (KYC) identity verification before this offer can be redeemed. Supports anti-money laundering (AML) compliance in licensed gaming jurisdictions.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxBonusAmount rdf:type rdf:Property ;
    rdfs:label 'Max Bonus Amount' ;
    rdfs:comment 'Upper cap on the bonus value that can be awarded under this offer, regardless of deposit size or percentage calculation (e.g., maximum $500 on a 100% deposit match). Protects the operator from uncapped liability.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxQualifyingStake rdf:type rdf:Property ;
    rdfs:label 'Max Qualifying Stake' ;
    rdfs:comment 'Maximum stake amount that qualifies for bonus calculation under this offer. Stakes above this threshold do not generate additional bonus value. Relevant for deposit match and free bet offers.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxRedemptionsPerBettor rdf:type rdf:Property ;
    rdfs:label 'Max Redemptions Per Bettor' ;
    rdfs:comment 'Maximum number of times a single bettor account can redeem this offer. Typically 1 for welcome bonuses; may be higher for recurring loyalty or reload bonuses.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxRedemptionsTotal rdf:type rdf:Property ;
    rdfs:label 'Max Redemptions Total' ;
    rdfs:comment 'Total number of times this offer can be redeemed across all bettors before it is automatically deactivated. Null indicates unlimited redemptions. Used for limited-supply promotional campaigns.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minDepositTrigger rdf:type rdf:Property ;
    rdfs:label 'Min Deposit Trigger' ;
    rdfs:comment 'Minimum qualifying deposit amount required to activate and receive this bonus offer. Bettors depositing below this threshold are not eligible for the bonus.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minOddsRequirement rdf:type rdf:Property ;
    rdfs:label 'Min Odds Requirement' ;
    rdfs:comment 'Minimum decimal odds that a qualifying wager must carry for it to count toward the wagering requirement. Prevents bettors from fulfilling playthrough on near-certainty bets (e.g., minimum odds of 1.50 decimal / -200 American).' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oddsBoostValue rdf:type rdf:Property ;
    rdfs:label 'Odds Boost Value' ;
    rdfs:comment 'The enhanced odds value applied to a qualifying selection under an odds boost offer (e.g., boosted decimal odds of 3.00 vs. original 2.50). Null for non-odds-boost offer types.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offerCode rdf:type rdf:Property ;
    rdfs:label 'Offer Code' ;
    rdfs:comment 'Externally-known alphanumeric code used by bettors and marketing channels to identify and redeem a promotional bonus offer (e.g., WELCOME100, FREEBETMAY). Business identifier surfaced in CRM campaigns, landing pages, and affiliate channels.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offerDescription rdf:type rdf:Property ;
    rdfs:label 'Offer Description' ;
    rdfs:comment 'Full marketing and compliance-approved description of the bonus offer terms, including eligibility, mechanics, and key conditions. Used for display on the platform and in regulatory disclosures.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offerName rdf:type rdf:Property ;
    rdfs:label 'Offer Name' ;
    rdfs:comment 'Human-readable marketing name of the bonus offer as displayed to bettors on the platform, app, and promotional materials (e.g., \'100% Welcome Deposit Match\', \'NBA Finals Free Bet\').' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offerStatus rdf:type rdf:Property ;
    rdfs:label 'Offer Status' ;
    rdfs:comment 'Current lifecycle state of the bonus offer. Controls whether the offer is visible and redeemable on the platform. Draft = under configuration; Active = live and redeemable; Paused = temporarily suspended; Expired = past validity window; Cancelled = withdrawn before expiry.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offerType rdf:type rdf:Property ;
    rdfs:label 'Offer Type' ;
    rdfs:comment 'Classification of the promotional bonus offer by its structural mechanics. Drives eligibility logic, wagering requirement calculation, and settlement rules. [ENUM-REF-CANDIDATE: welcome_bonus|deposit_match|free_bet|odds_boost|parlay_insurance|loyalty_reward|referral_bonus — promote to reference product]' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parlayMinLegs rdf:type rdf:Property ;
    rdfs:label 'Parlay Min Legs' ;
    rdfs:comment 'Minimum number of legs required in a parlay wager for it to qualify under this offer. Applicable for parlay insurance and parlay-specific bonus offers. Null if the offer does not apply to parlays.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:promoChannel rdf:type rdf:Property ;
    rdfs:label 'Promo Channel' ;
    rdfs:comment 'Primary distribution channel through which this bonus offer is marketed and delivered to bettors. Drives attribution and campaign performance reporting in Adobe Experience Platform and Salesforce CRM. [ENUM-REF-CANDIDATE: email|push_notification|sms|affiliate|in_app|social_media — promote to reference product]' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redemptionDeadlineDays rdf:type rdf:Property ;
    rdfs:label 'Redemption Deadline Days' ;
    rdfs:comment 'Number of days from the date of offer issuance to the bettor within which the bonus must be activated or first used. Distinct from the offer validity window — this is the per-bettor clock that starts at issuance.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryOfferCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Offer Code' ;
    rdfs:comment 'External identifier assigned by the gaming regulatory authority for this bonus offer, required for regulatory reporting and audit submissions in licensed jurisdictions. Maps to the operator\'s compliance filing.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termsVersion rdf:type rdf:Property ;
    rdfs:label 'Terms Version' ;
    rdfs:comment 'Version identifier of the terms and conditions document governing this bonus offer (e.g., v1.0, v2.3). Tracks regulatory-approved T&C versions for compliance audit trails and bettor disclosure requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wageringDeadlineDays rdf:type rdf:Property ;
    rdfs:label 'Wagering Deadline Days' ;
    rdfs:comment 'Number of days from bonus activation within which the bettor must complete the full wagering requirement (playthrough). Bonus funds are forfeited if the requirement is not met within this window.' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:wageringRequirementBasis rdf:type rdf:Property ;
    rdfs:label 'Wagering Requirement Basis' ;
    rdfs:comment 'Defines the base amount to which the wagering requirement multiplier is applied: bonus_only (multiplier applied to bonus amount only), bonus_and_deposit (multiplier applied to bonus plus qualifying deposit), stake_only (multiplier applied to original stake for free bets).' ;
    rdfs:domain ind:BonusOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wageringRequirementMultiplier rdf:type rdf:Property ;
    rdfs:label 'Wagering Requirement Multiplier' ;
    rdfs:comment 'Playthrough multiplier specifying how many times the bonus amount (or bonus + deposit) must be wagered before the bonus funds can be withdrawn (e.g., 10x means a $50 bonus requires $500 in qualifying wagers). Core responsible gaming and financial liability control.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Id' ;
    rdfs:comment 'Reference identifier of the regulatory submission or report in which this bonus redemption was included. Required for traceability to state gaming commission filings and AML suspicious activity reports.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryReport .

ind:ageVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Age Verification Status' ;
    rdfs:comment 'Status of the bettor\'s age verification check at the time of bonus redemption. Regulatory requirement to confirm bettor meets minimum legal gambling age in the applicable jurisdiction.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bonusAmountCredited rdf:type rdf:Property ;
    rdfs:label 'Bonus Amount Credited' ;
    rdfs:comment 'Gross monetary value of the bonus credited to the bettor\'s account at the time of redemption, expressed in the account\'s operating currency. Used for bonus liability tracking and promotional ROI measurement.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusFrequencyCount rdf:type rdf:Property ;
    rdfs:label 'Bonus Frequency Count' ;
    rdfs:comment 'Running count of bonus redemptions by this bettor account within the current calendar month. Used for responsible gaming monitoring and enforcement of per-bettor bonus frequency limits.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bonusStatus rdf:type rdf:Property ;
    rdfs:label 'Bonus Status' ;
    rdfs:comment 'Current lifecycle state of the bonus redemption. \'active\' = credited and available; \'wagering_in_progress\' = bettor is working through wagering requirement; \'completed\' = wagering requirement met; \'expired\' = bonus lapsed before completion; \'forfeited\' = bettor or operator cancelled the bonus.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bonusTypeCode rdf:type rdf:Property ;
    rdfs:label 'Bonus Type Code' ;
    rdfs:comment 'Classification of the bonus offer type redeemed. Determines accounting treatment, wagering requirement calculation, and responsible gaming monitoring rules. [ENUM-REF-CANDIDATE: deposit_match|free_bet|risk_free_bet|reload|referral|loyalty|no_deposit — promote to reference product]' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Completion Timestamp' ;
    rdfs:comment 'Date and time at which the bettor satisfied the full wagering requirement and the bonus was converted to real money. Null if the bonus has not yet reached \'completed\' status.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:convertedAmount rdf:type rdf:Property ;
    rdfs:label 'Converted Amount' ;
    rdfs:comment 'Actual monetary amount successfully converted from bonus funds to real-money balance upon completion of wagering requirements. Zero if forfeited; may be less than bonus_amount_credited for partial conversions.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositTriggerAmount rdf:type rdf:Property ;
    rdfs:label 'Deposit Trigger Amount' ;
    rdfs:comment 'The qualifying deposit amount made by the bettor that triggered eligibility for this bonus offer (applicable for deposit-match and reload bonus types). Zero or null for no-deposit bonuses.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalOutcome rdf:type rdf:Property ;
    rdfs:label 'Final Outcome' ;
    rdfs:comment 'Terminal result of the bonus redemption lifecycle: \'converted\' = bonus successfully converted to real money; \'forfeited\' = bonus lost due to expiry, violation, or cancellation; \'pending\' = lifecycle not yet concluded; \'partially_converted\' = portion converted before forfeiture.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forfeitedAmount rdf:type rdf:Property ;
    rdfs:label 'Forfeited Amount' ;
    rdfs:comment 'Monetary value of the bonus that was forfeited rather than converted to real money, due to expiry, terms violation, or bettor cancellation. Used for promotional ROI and liability release accounting.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forfeitureReasonCode rdf:type rdf:Property ;
    rdfs:label 'Forfeiture Reason Code' ;
    rdfs:comment 'Coded reason explaining why the bonus was forfeited, if applicable. Supports regulatory reporting, customer service resolution, and responsible gaming audit trails.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optInTimestamp rdf:type rdf:Property ;
    rdfs:label 'Opt In Timestamp' ;
    rdfs:comment 'Date and time the bettor explicitly opted into the bonus offer prior to or at the point of redemption. Required for GDPR consent audit and responsible gaming compliance documentation.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:qualifyingWagerIds rdf:type rdf:Property ;
    rdfs:label 'Qualifying Wager Ids' ;
    rdfs:comment 'Comma-delimited list of wager transaction IDs that have contributed toward satisfying the wagering requirement for this bonus redemption. Supports audit trail and dispute resolution.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redemptionReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Redemption Reference Code' ;
    rdfs:comment 'Externally visible alphanumeric reference code assigned to this redemption event, used for customer service inquiries, audit trails, and regulatory reporting.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redemptionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Redemption Timestamp' ;
    rdfs:comment 'The precise date and time (ISO 8601 with timezone offset) at which the bettor claimed and activated the bonus offer on the gaming platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:selfExclusionCheckPassed rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion Check Passed' ;
    rdfs:comment 'Indicates whether the bettor passed the self-exclusion registry check at the time of bonus redemption. A value of False indicates the redemption was flagged or blocked due to self-exclusion status.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wageringRequirementAmount rdf:type rdf:Property ;
    rdfs:label 'Wagering Requirement Amount' ;
    rdfs:comment 'Total monetary amount the bettor must wager to satisfy the bonus wagering requirement, calculated as bonus_amount_credited multiplied by wagering_requirement_multiplier at the time of redemption.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wageringRequirementRemaining rdf:type rdf:Property ;
    rdfs:label 'Wagering Requirement Remaining' ;
    rdfs:comment 'Outstanding monetary amount still required to be wagered before the bonus can be converted to real money. Decremented as qualifying wagers are placed. Used for real-time bonus liability tracking.' ;
    rdfs:domain ind:BonusRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prizeSkuCatalogId rdf:type rdf:Property ;
    rdfs:label 'Prize Sku Catalog Id' ;
    rdfs:comment 'Foreign key linking to merchandise.sku_catalog. Business justification: Gaming contest merchandise prize fulfillment: DFS and gaming contests award merchandise SKUs as prizes. Operations require linking the contest to the specific merchandise SKU for prize inventory reser' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SkuCatalog .

ind:promotionalAssetId rdf:type rdf:Property ;
    rdfs:label 'Promotional Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: DFS contest display operations: each contest references a specific promotional content asset (banner image, preview video) for rendering on platform pages. Role prefix \'promotional_\' distinguishes fro' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:slateId rdf:type rdf:Property ;
    rdfs:label 'Slate Id' ;
    rdfs:comment 'Reference to the game slate (set of real-world sporting events) that defines the player pool and scoring window for this contest.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Slate .

ind:ageRestrictionOverride rdf:type rdf:Property ;
    rdfs:label 'Age Restriction Override' ;
    rdfs:comment 'Jurisdiction-specific minimum age requirement that overrides the platform default for this contest in this jurisdiction. Populated only when the jurisdiction mandates a higher age threshold than the platform standard (e.g., 21 instead of 18). NULL indicates no override — platform default applies.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageRestrictionYears rdf:type rdf:Property ;
    rdfs:label 'Age Restriction Years' ;
    rdfs:comment 'Minimum age in years required to enter this contest. Typically 18 or 21 depending on jurisdiction. Enforced at entry time against bettor_account age verification.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contestName rdf:type rdf:Property ;
    rdfs:label 'Contest Name' ;
    rdfs:comment 'Human-readable display name of the contest as shown to players on the platform (e.g., \'Sunday Million GPP\', \'NFL Week 12 50/50\').' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contestStatus rdf:type rdf:Property ;
    rdfs:label 'Contest Status' ;
    rdfs:comment 'Current lifecycle state of the contest. \'open\' accepts entries; \'locked\' is past entry deadline; \'live\' is in-progress scoring; \'completed\' is final; \'cancelled\' is voided with refunds; \'postponed\' is delayed.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contestType rdf:type rdf:Property ;
    rdfs:label 'Contest Type' ;
    rdfs:comment 'Classification of the contest format. GPP (Guaranteed Prize Pool) tournaments are top-heavy; 50/50 and double-up pay the top half; head-to-head is one-on-one; satellite/qualifier awards entries to larger contests. [ENUM-REF-CANDIDATE: GPP|50_50|HEAD_TO_HEAD|SATELLITE|DOUBLE_UP|QUALIFIER — promote to reference product]' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entriesFilled rdf:type rdf:Property ;
    rdfs:label 'Entries Filled' ;
    rdfs:comment 'Current count of entries submitted to this contest at the time of last update. Used to monitor fill rate and determine overlay exposure for guaranteed prize pools.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:entryFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Entry Fee Amount' ;
    rdfs:comment 'Dollar amount charged per entry into this contest. A value of 0.00 indicates a free-to-play contest. Used for revenue recognition and responsible gaming deposit limit tracking.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entryFeeCurrency rdf:type rdf:Property ;
    rdfs:label 'Entry Fee Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the entry fee (e.g., USD, CAD, GBP). Required for multi-jurisdiction operations.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBeginnerOnly rdf:type rdf:Property ;
    rdfs:label 'Is Beginner Only' ;
    rdfs:comment 'Indicates whether this contest is restricted to new or inexperienced players. Beginner contests are a responsible gaming and player acquisition tool that limits exposure to highly experienced players.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFreeToPlay rdf:type rdf:Property ;
    rdfs:label 'Is Free To Play' ;
    rdfs:comment 'Indicates whether this is a free-to-play (no entry fee) contest. Free contests may offer prizes funded by the operator for promotional or responsible gaming purposes.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isGuaranteed rdf:type rdf:Property ;
    rdfs:label 'Is Guaranteed' ;
    rdfs:comment 'Indicates whether the prize pool is guaranteed by the operator regardless of the number of entries received. True for GPP contests; False for non-guaranteed contests that may be cancelled if underfilled.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionCodes rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Codes' ;
    rdfs:comment 'Pipe-delimited list of jurisdiction or state codes where this contest is available for entry (e.g., \'US-NJ|US-PA|US-CO\'). Used for geo-restriction enforcement at entry time.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionExclusionCodes rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Exclusion Codes' ;
    rdfs:comment 'Pipe-delimited list of jurisdiction or state codes where this contest is explicitly prohibited (e.g., \'US-WA|US-ID\'). Complements jurisdiction_codes for regulatory compliance.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lockTimestamp rdf:type rdf:Property ;
    rdfs:label 'Lock Timestamp' ;
    rdfs:comment 'Date and time after which no new entries or lineup edits are accepted. Typically set to the first game\'s scheduled start time. Regulatory requirement to prevent late entry based on real-world information.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:maxEntriesPerPlayer rdf:type rdf:Property ;
    rdfs:label 'Max Entries Per Player' ;
    rdfs:comment 'Maximum number of lineup entries a single player account may submit to this contest. Limits multi-entry advantage and supports responsible gaming controls. Typically 1 for head-to-head; higher for large GPPs.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minEntriesRequired rdf:type rdf:Property ;
    rdfs:label 'Min Entries Required' ;
    rdfs:comment 'Minimum number of entries required for the contest to run. If not met by lock time, the contest may be cancelled and entry fees refunded. Relevant for head-to-head and small-field contests.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paidPlacesCount rdf:type rdf:Property ;
    rdfs:label 'Paid Places Count' ;
    rdfs:comment 'Number of finishing positions that receive a cash prize payout. Determines the percentage of the field that cashes. Key metric for contest attractiveness and responsible gaming disclosures.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:platformCode rdf:type rdf:Property ;
    rdfs:label 'Platform Code' ;
    rdfs:comment 'Reference to the gaming platform on which this contest is hosted (e.g., DraftKings, FanDuel, proprietary DFS platform).' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prizePoolType rdf:type rdf:Property ;
    rdfs:label 'Prize Pool Type' ;
    rdfs:comment 'Indicates whether the prize pool is guaranteed by the operator regardless of entries filled (GPP), non-guaranteed (scales with entries), or overlay (operator subsidizes shortfall when entries are below guarantee threshold).' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prizeReportingThreshold rdf:type rdf:Property ;
    rdfs:label 'Prize Reporting Threshold' ;
    rdfs:comment 'Jurisdiction-specific monetary threshold above which a prize payout from this contest must be reported to the regulatory authority or tax body. This value is contest-jurisdiction specific because it may vary based on contest type (DFS vs. wagering) and jurisdiction rules. Expressed in the jurisdiction\'s currency_code.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prizeStructureType rdf:type rdf:Property ;
    rdfs:label 'Prize Structure Type' ;
    rdfs:comment 'Describes how prizes are distributed across finishing positions. \'top_heavy\' concentrates prizes at the top; \'flat\' pays equal amounts across a wide range; \'winner_take_all\' awards the full pool to first place; \'tiered\' uses defined payout brackets.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rakePercentage rdf:type rdf:Property ;
    rdfs:label 'Rake Percentage' ;
    rdfs:comment 'Operator\'s take rate expressed as a percentage of total entry fees collected. Represents the platform\'s revenue margin on the contest. Used for financial reporting and EBITDA analysis.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:registrationOpenTimestamp rdf:type rdf:Property ;
    rdfs:label 'Registration Open Timestamp' ;
    rdfs:comment 'Date and time when the contest becomes available for player entry registration. Defines the entry acceptance window start.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:regulatoryContestCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Contest Code' ;
    rdfs:comment 'Identifier assigned by the relevant state or national gaming regulatory authority for this contest. Required for regulatory reporting and audit submissions.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionType rdf:type rdf:Property ;
    rdfs:label 'Restriction Type' ;
    rdfs:comment 'Classification of the type of restriction applied to this contest in this jurisdiction. A full_block means the contest is entirely unavailable; age_gated means players must meet a jurisdiction-specific age threshold; prize_capped means the prize pool is limited by jurisdictional rules.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rosterSize rdf:type rdf:Property ;
    rdfs:label 'Roster Size' ;
    rdfs:comment 'Total number of player slots in a contest entry lineup (e.g., 9 for classic NFL DFS, 6 for showdown). Defines the lineup construction rules for this contest.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:salaryCapAmount rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Amount' ;
    rdfs:comment 'Virtual salary cap budget allocated to each entry for player selection (e.g., $50,000). Entries must construct rosters within this cap. A core DFS contest mechanic.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoringSystemCode rdf:type rdf:Property ;
    rdfs:label 'Scoring System Code' ;
    rdfs:comment 'Code identifying the fantasy scoring ruleset applied to this contest (e.g., STANDARD, PPR, HALF_PPR for NFL; CLASSIC for NBA). Determines how real-world player statistics translate to fantasy points.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalEntriesCap rdf:type rdf:Property ;
    rdfs:label 'Total Entries Cap' ;
    rdfs:comment 'Maximum total number of entries allowed across all players in this contest. Defines the contest capacity. When reached, the contest is closed to new entries.' ;
    rdfs:domain ind:Contest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contestEntryId rdf:type rdf:Property ;
    rdfs:label 'Contest Entry Id' ;
    rdfs:comment 'Unique surrogate identifier for each DFS contest entry record in the Silver layer. Primary key for this transactional entity.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContestEntry .

ind:fantasyRosterId rdf:type rdf:Property ;
    rdfs:label 'Fantasy Roster Id' ;
    rdfs:comment 'Reference to the specific athlete lineup submitted for this contest entry. Links to the lineup/roster detail record capturing athlete selections by position and salary cap usage.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FantasyRoster .

ind:lineupId rdf:type rdf:Property ;
    rdfs:label 'Lineup Id' ;
    rdfs:comment 'Reference to the specific athlete lineup submitted for this contest entry. Links to the lineup/roster detail record capturing athlete selections by position and salary cap usage.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Lineup .

ind:operatorId rdf:type rdf:Property ;
    rdfs:label 'Operator Id' ;
    rdfs:comment 'Reference to the licensed DFS operator or platform entity under whose license this contest entry was accepted. Supports multi-operator platform architectures and regulatory license-level reporting.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Operator .

ind:actualPoints rdf:type rdf:Property ;
    rdfs:label 'Actual Points' ;
    rdfs:comment 'Total actual fantasy points scored by the submitted lineup after all real-world games in the slate have concluded and scores are finalized. Principal quantitative outcome for settlement and ranking.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusAmountApplied rdf:type rdf:Property ;
    rdfs:label 'Bonus Amount Applied' ;
    rdfs:comment 'Promotional or bonus credit amount applied toward the entry fee for this contest entry. Reduces the net cash charged to the bettor. Used for promotion reconciliation and regulatory reporting.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contestSlateDate rdf:type rdf:Property ;
    rdfs:label 'Contest Slate Date' ;
    rdfs:comment 'The primary game-day date of the contest slate this entry is associated with. Used for scheduling, settlement timing, and regulatory reporting period alignment.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:entryNumberInContest rdf:type rdf:Property ;
    rdfs:label 'Entry Number In Contest' ;
    rdfs:comment 'Sequential entry number for this bettor within the same contest (e.g., 1 = first entry, 2 = second entry). Supports multi-entry tracking and regulatory caps on entries per bettor per contest.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:entryReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Entry Reference Number' ;
    rdfs:comment 'Externally visible alphanumeric reference code assigned to this contest entry at submission time. Used for customer support, regulatory reporting, and settlement reconciliation.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalRank rdf:type rdf:Property ;
    rdfs:label 'Final Rank' ;
    rdfs:comment 'Final standing rank of this entry within the contest after all scores are settled. Rank 1 = highest scoring entry. Determines prize eligibility and payout tier.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geolocationState rdf:type rdf:Property ;
    rdfs:label 'Geolocation State' ;
    rdfs:comment 'Two-letter US state code of the bettor\'s verified geolocation at the time of entry submission. Critical for jurisdiction-based DFS legality verification and regulatory reporting.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAutopick rdf:type rdf:Property ;
    rdfs:label 'Is Autopick' ;
    rdfs:comment 'Indicates whether the lineup for this entry was generated automatically by the platform\'s autopick algorithm rather than manually selected by the bettor. Relevant for contest integrity and bettor experience analytics.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLateSwap rdf:type rdf:Property ;
    rdfs:label 'Is Late Swap' ;
    rdfs:comment 'Indicates whether the bettor utilized a late swap to substitute an injured or scratched athlete in the lineup after the initial contest lock but before that athlete\'s game started. Applicable only in contests that permit late swaps.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineupEditCount rdf:type rdf:Property ;
    rdfs:label 'Lineup Edit Count' ;
    rdfs:comment 'Number of times the bettor modified the submitted lineup between initial entry and lineup lock. Supports contest integrity monitoring and late-swap tracking.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineupLockTimestamp rdf:type rdf:Property ;
    rdfs:label 'Lineup Lock Timestamp' ;
    rdfs:comment 'The date and time at which the submitted lineup was locked and no further edits were permitted. Marks the transition from \'active\' to \'locked\' entry status.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:netEntryFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Net Entry Fee Amount' ;
    rdfs:comment 'Actual cash amount charged to the bettor after applying bonus credits (entry_fee_amount minus bonus_amount_applied). Represents the real monetary outlay for regulatory and financial reporting.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payoutStatus rdf:type rdf:Property ;
    rdfs:label 'Payout Status' ;
    rdfs:comment 'Current status of the prize payout for this entry. \'pending\' = prize calculated but not yet disbursed; \'processed\' = funds credited to bettor account; \'failed\' = disbursement error; \'withheld\' = held for tax or compliance review; \'cancelled\' = prize voided.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payoutTimestamp rdf:type rdf:Property ;
    rdfs:label 'Payout Timestamp' ;
    rdfs:comment 'Date and time when the prize payout was successfully credited to the bettor account. Null if payout has not yet been processed.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:percentileRank rdf:type rdf:Property ;
    rdfs:label 'Percentile Rank' ;
    rdfs:comment 'This entry\'s final rank expressed as a percentile within the contest field (e.g., 95.00 = top 5%). Supports bettor performance analytics and DFS platform reporting.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prizeAmount rdf:type rdf:Property ;
    rdfs:label 'Prize Amount' ;
    rdfs:comment 'Gross prize amount won by this entry based on final rank and contest prize structure. Zero if entry did not finish in a paying position. Used for prize distribution and IRS W-2G tax reporting.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prizeTier rdf:type rdf:Property ;
    rdfs:label 'Prize Tier' ;
    rdfs:comment 'Prize tier or payout band this entry qualified for based on final rank (e.g., \'1st Place\', \'Top 10\', \'Top 20%\', \'No Prize\'). Derived from the contest prize structure at settlement. [ENUM-REF-CANDIDATE: 1st_place|2nd_place|3rd_place|top_10|top_20_pct|top_50_pct|no_prize — promote to reference product]' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectedPoints rdf:type rdf:Property ;
    rdfs:label 'Projected Points' ;
    rdfs:comment 'Total projected fantasy points for the submitted lineup at the time of entry lock, based on pre-game statistical projections. Used for contest analytics and bettor decision support.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:promotionCode rdf:type rdf:Property ;
    rdfs:label 'Promotion Code' ;
    rdfs:comment 'Promotional or referral code applied at the time of entry submission. Used for marketing attribution, bonus reconciliation, and campaign performance reporting.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryCapUsed rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Used' ;
    rdfs:comment 'Total salary cap value consumed by the submitted lineup. Must not exceed the contest\'s maximum salary cap limit. Used for lineup validation and contest integrity checks.' ;
    rdfs:domain ind:ContestEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxWithheldAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Withheld Amount' ;
    rdfs:comment 'Amount of federal or state income tax withheld from the prize payout per applicable tax regulations. Relevant for IRS W-2G reporting when prize exceeds statutory thresholds.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voidReason rdf:type rdf:Property ;
    rdfs:label 'Void Reason' ;
    rdfs:comment 'Textual description of the reason this entry was voided or cancelled, if applicable (e.g., \'Contest cancelled due to insufficient entries\', \'Bettor self-exclusion triggered\', \'Geolocation violation\'). Null for non-voided entries.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:w2gReportable rdf:type rdf:Property ;
    rdfs:label 'W2g Reportable' ;
    rdfs:comment 'Indicates whether this contest entry\'s prize winnings meet or exceed the IRS W-2G reporting threshold, requiring issuance of a W-2G tax form to the bettor and reporting to the IRS.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esportsTeamId rdf:type rdf:Property ;
    rdfs:label 'Esports Team Id' ;
    rdfs:comment 'Reference to the first competing team (side A / home side) in this match. Used for team-level performance analytics and standings calculations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EsportsTeam .

ind:primaryEsportsTeamId rdf:type rdf:Property ;
    rdfs:label 'Primary Esports Team Id' ;
    rdfs:comment 'Reference to the first competing team (side A / home side) in this match. Used for team-level performance analytics and standings calculations.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EsportsTeam .

ind:teamBEsportsTeamId rdf:type rdf:Property ;
    rdfs:label 'Team B Esports Team Id' ;
    rdfs:comment 'Reference to the second competing team (side B / away side) in this match. Used for team-level performance analytics and standings calculations.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EsportsTeam .

ind:tertiaryWinningTeamEsportsTeamId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Winning Team Esports Team Id' ;
    rdfs:comment 'Reference to the team that won this match. Null if the match is in progress, cancelled, or resulted in a draw. Drives standings updates, bracket progression, and wagering market settlement.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EsportsTeam .

ind:vodAssetId rdf:type rdf:Property ;
    rdfs:label 'Vod Asset Id' ;
    rdfs:comment 'Internal Digital Asset Management (DAM) identifier for the VOD recording within the Dalet Galaxy media asset management system. Used for rights management, content lifecycle tracking, and CDN distribution.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:dataFeedProvider rdf:type rdf:Property ;
    rdfs:label 'Data Feed Provider' ;
    rdfs:comment 'Name of the official data feed provider supplying real-time match data and statistics (e.g., \'Sportradar\', \'Abios\', \'PandaScore\'). Required for official data mandate compliance in jurisdictions that require licensed data feeds for wagering settlement.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalMatchCode rdf:type rdf:Property ;
    rdfs:label 'External Match Code' ;
    rdfs:comment 'Match identifier as assigned by the external data feed provider or tournament operator platform (e.g., Sportradar match ID, Abios match ID). Used for cross-system reconciliation and data feed ingestion deduplication.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fantasyEligible rdf:type rdf:Property ;
    rdfs:label 'Fantasy Eligible' ;
    rdfs:comment 'Indicates whether player performance statistics from this match are eligible to count toward fantasy sports scoring. False for forfeited, cancelled, or exhibition matches per fantasy league rules.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:forfeitReason rdf:type rdf:Property ;
    rdfs:label 'Forfeit Reason' ;
    rdfs:comment 'Textual description of the reason a match was forfeited or declared no-contest (e.g., \'team_disqualified_cheating\', \'technical_failure\', \'player_eligibility_violation\'). Null when match_result_type is not forfeit or no_contest.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gamePublisher rdf:type rdf:Property ;
    rdfs:label 'Game Publisher' ;
    rdfs:comment 'Name of the video game publisher or developer who owns the intellectual property (IP) for the game title (e.g., \'Valve\', \'Riot Games\', \'EA Sports\', \'Psyonix\'). Required for IP licensing compliance and royalty reporting.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gameTitle rdf:type rdf:Property ;
    rdfs:label 'Game Title' ;
    rdfs:comment 'Name of the video game title being competed on (e.g., \'Counter-Strike 2\', \'League of Legends\', \'Valorant\', \'FIFA 25\', \'Rocket League\'). Core classification dimension for all esports analytics and rights management.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gameVersion rdf:type rdf:Property ;
    rdfs:label 'Game Version' ;
    rdfs:comment 'Software version or patch number of the game title active during the match (e.g., \'14.5\', \'1.08.00\'). Critical for performance analytics integrity — patch changes alter game mechanics and invalidate cross-patch stat comparisons.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrityCaseReference rdf:type rdf:Property ;
    rdfs:label 'Integrity Case Reference' ;
    rdfs:comment 'Reference number of the associated integrity investigation case when integrity_flag is True. Links to the gaming.integrity_alert record for full investigation audit trail. Null when no integrity concern exists.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrityFlag rdf:type rdf:Property ;
    rdfs:label 'Integrity Flag' ;
    rdfs:comment 'Indicates whether this match has been flagged for a sports integrity investigation (e.g., suspected match-fixing, unusual wagering patterns, cheating allegations). True = active integrity concern. Triggers suspension of related wagering markets per gaming.integrity_alert workflow.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLiveBroadcast rdf:type rdf:Property ;
    rdfs:label 'Is Live Broadcast' ;
    rdfs:comment 'Indicates whether this match was broadcast live to audiences. True = live broadcast occurred; False = no live broadcast (e.g., closed qualifier, online match without stream). Drives broadcast rights reporting and OTT audience measurement.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mapNumberInSeries rdf:type rdf:Property ;
    rdfs:label 'Map Number In Series' ;
    rdfs:comment 'Sequential position of this map/game within the overall best-of series (e.g., 1 = first map, 2 = second map). Enables map-by-map analytics and series reconstruction.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mapOrStageName rdf:type rdf:Property ;
    rdfs:label 'Map Or Stage Name' ;
    rdfs:comment 'Name of the in-game map, arena, or stage on which this match was played (e.g., \'Mirage\', \'Summoner\'s Rift\', \'Ascent\'). For best-of series, this represents the specific map within the series. Used for map-level analytics and prop bet settlement.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Match Duration Seconds' ;
    rdfs:comment 'Total elapsed time of the match in seconds from actual start to actual end. Used for broadcast planning, performance benchmarking, and audience engagement analytics.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:matchReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Match Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric identifier for the match as published by the tournament operator, broadcast partner, or governing body (e.g., \'ESL-CS2-2024-QF-001\'). Used for cross-system reconciliation and fan-facing display.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchResultType rdf:type rdf:Property ;
    rdfs:label 'Match Result Type' ;
    rdfs:comment 'Categorical outcome of the match. Distinguishes between competitive wins, draws, forfeits, and administrative no-contest rulings. Required for wagering market settlement and league standings logic.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchStatus rdf:type rdf:Property ;
    rdfs:label 'Match Status' ;
    rdfs:comment 'Current lifecycle state of the match. Drives downstream wagering market settlement, VOD publishing, and fantasy scoring workflows. [ENUM-REF-CANDIDATE: scheduled|live|completed|cancelled|postponed|forfeited — promote to reference product if additional states are required]' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchType rdf:type rdf:Property ;
    rdfs:label 'Match Type' ;
    rdfs:comment 'Classification of the match within the tournament bracket or league structure. Determines prize pool eligibility, seeding impact, and broadcast tier. [ENUM-REF-CANDIDATE: group_stage|play-in|quarterfinal|semifinal|grand_final|regular_season|exhibition|qualifier — promote to reference product]' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seriesFormat rdf:type rdf:Property ;
    rdfs:label 'Series Format' ;
    rdfs:comment 'Best-of series format defining the maximum number of maps/games in the series (e.g., BO1 = Best of 1, BO3 = Best of 3, BO5 = Best of 5). Determines match duration expectations and wagering market structures.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:splitOrSplitName rdf:type rdf:Property ;
    rdfs:label 'Split Or Split Name' ;
    rdfs:comment 'Name of the competitive split or season segment within the year (e.g., \'Spring 2024\', \'Summer 2024\', \'Winter Split\'). Many esports leagues divide the year into multiple splits with separate standings.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamAScore rdf:type rdf:Property ;
    rdfs:label 'Team A Score' ;
    rdfs:comment 'Final score or round/game count achieved by Team A in this match (e.g., rounds won in CS2, kills in a deathmatch, goals in FIFA). The scoring unit is game-title-specific. Used for result settlement and performance analytics.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:teamBScore rdf:type rdf:Property ;
    rdfs:label 'Team B Score' ;
    rdfs:comment 'Final score or round/game count achieved by Team B in this match. The scoring unit is game-title-specific. Used for result settlement and performance analytics.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:venueType rdf:type rdf:Property ;
    rdfs:label 'Venue Type' ;
    rdfs:comment 'Indicates whether the match was played at a physical LAN (Local Area Network) event, fully online, or in a hybrid format. Affects integrity monitoring requirements, broadcast production type, and wagering eligibility rules.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vodUrl rdf:type rdf:Property ;
    rdfs:label 'Vod Url' ;
    rdfs:comment 'Publicly accessible or authenticated URL to the Video on Demand (VOD) recording of the match. Used for content distribution, fan engagement, and post-match analytics via SportsCode / Hudl.' ;
    rdfs:domain ind:EsportsMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wageringEligible rdf:type rdf:Property ;
    rdfs:label 'Wagering Eligible' ;
    rdfs:comment 'Indicates whether this match is eligible for sports wagering market creation under applicable gaming jurisdiction rules. False for exhibition matches, underage player events, or matches under integrity review.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Parent Franchise Id' ;
    rdfs:comment 'Foreign key linking to league.franchise. Business justification: Many esports teams are owned by traditional sports franchises (e.g., NBA teams own NBA 2K League franchises). A parent_franchise_id FK captures this ownership for revenue consolidation reporting, IP l' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:coachingStaffCount rdf:type rdf:Property ;
    rdfs:label 'Coaching Staff Count' ;
    rdfs:comment 'Number of registered coaching and support staff (head coach, analysts, mental performance coaches) associated with the team. Used for workforce management in SAP SuccessFactors and venue credential allocation.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:competitiveRegion rdf:type rdf:Property ;
    rdfs:label 'Competitive Region' ;
    rdfs:comment 'The primary competitive region in which the team participates (e.g., \'NA\' for North America, \'EU\' for Europe, \'APAC\' for Asia-Pacific). Drives league assignment, broadcast rights windows, and gaming jurisdiction compliance for wagering markets. [ENUM-REF-CANDIDATE: NA|EU|APAC|LATAM|MENA|OCE|KR|CN|GLOBAL — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crmAccountCode rdf:type rdf:Property ;
    rdfs:label 'Crm Account Code' ;
    rdfs:comment 'External reference identifier for this team\'s account record in Salesforce CRM, used for sponsor relationship management, fan engagement tracking, and partnership pipeline management. Enables cross-system data reconciliation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erpVendorCode rdf:type rdf:Property ;
    rdfs:label 'Erp Vendor Code' ;
    rdfs:comment 'Vendor or business partner code assigned to this team\'s organization in SAP S/4HANA for financial transactions including prize payments, revenue sharing, and procurement. Used for accounts payable and financial reconciliation.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:franchiseFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Franchise Fee Amount' ;
    rdfs:comment 'Monetary value paid by the organization to acquire the franchise slot or partnership rights, expressed in the designated currency. Used for financial reporting, EBITDA calculations, and asset amortization schedules in SAP S/4HANA.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:franchisePurchaseDate rdf:type rdf:Property ;
    rdfs:label 'Franchise Purchase Date' ;
    rdfs:comment 'Date on which the franchise slot was purchased or the partnership agreement was executed. Applicable for franchised and partnered teams. Used for financial amortization tracking in SAP S/4HANA FI/CO.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:franchiseType rdf:type rdf:Property ;
    rdfs:label 'Franchise Type' ;
    rdfs:comment 'Classification of the team\'s league participation model. \'franchised\' indicates a permanent slot purchased from the league; \'partnered\' indicates a formal partnership agreement; \'open_circuit\' indicates qualification-based participation; \'affiliate\' indicates a developmental/secondary team; \'independent\' indicates no formal league affiliation.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeCountryCode rdf:type rdf:Property ;
    rdfs:label 'Home Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the team\'s primary country of registration or operational base (e.g., \'USA\', \'GBR\', \'KOR\'). Used for regulatory reporting, tax jurisdiction assignment, and international competition eligibility.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeVenueName rdf:type rdf:Property ;
    rdfs:label 'Home Venue Name' ;
    rdfs:comment 'Name of the primary venue or arena where the team hosts home matches and events (e.g., \'Riot Games Arena\', \'Blizzard Arena\'). Used for event scheduling, ticketing operations in Ticketmaster/AXS, and venue operations management.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrityMonitoringFlag rdf:type rdf:Property ;
    rdfs:label 'Integrity Monitoring Flag' ;
    rdfs:comment 'Indicates whether this team is currently subject to enhanced integrity monitoring due to suspicious wagering activity, match-fixing investigations, or regulatory directives. When true, triggers integrity alert workflows and may restrict wagering market availability.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueJoinDate rdf:type rdf:Property ;
    rdfs:label 'League Join Date' ;
    rdfs:comment 'Date on which the team was officially admitted to or began competing in the Sports Entertainment-operated or affiliated league. Marks the effective start of the team\'s league membership for governance and compliance purposes.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leagueTier rdf:type rdf:Property ;
    rdfs:label 'League Tier' ;
    rdfs:comment 'Competitive tier level of the team within the league hierarchy. \'tier1\' represents the top professional division; \'tier2\' and \'tier3\' represent lower professional divisions; \'academy\' represents developmental rosters; \'amateur\' represents non-professional participants. Drives prize pool eligibility, broadcast rights, and fantasy sports inclusion.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:logoUrl rdf:type rdf:Property ;
    rdfs:label 'Logo Url' ;
    rdfs:comment 'URL pointing to the team\'s official logo asset stored in the Digital Asset Management (DAM) system (Dalet Galaxy or CDN). Used for broadcast graphics, fan-facing digital platforms, and merchandise catalog displays in Shopify Plus.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxRosterSize rdf:type rdf:Property ;
    rdfs:label 'Max Roster Size' ;
    rdfs:comment 'Maximum number of players permitted on the team\'s roster as defined by league rules or the CBA for the specific game title. Enforced during roster transactions and fantasy draft eligibility checks.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:merchandiseSkuPrefix rdf:type rdf:Property ;
    rdfs:label 'Merchandise Sku Prefix' ;
    rdfs:comment 'Alphanumeric prefix used to namespace all Stock Keeping Unit (SKU) codes for merchandise associated with this team in the Shopify Plus e-commerce platform. Ensures unique product identification across the merchandise catalog.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilPolicyApplicable rdf:type rdf:Property ;
    rdfs:label 'Nil Policy Applicable' ;
    rdfs:comment 'Indicates whether Name, Image, and Likeness (NIL) agreements are applicable to players on this team\'s roster, based on league rules and player eligibility status. Relevant for athlete contract management and sponsorship attribution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orgLegalEntity rdf:type rdf:Property ;
    rdfs:label 'Org Legal Entity' ;
    rdfs:comment 'Full legal registered name of the corporate entity that owns the esports team franchise. Used for contract execution, financial reporting under SOX, and regulatory filings. Distinct from the brand/marketing name (org_name).' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orgName rdf:type rdf:Property ;
    rdfs:label 'Org Name' ;
    rdfs:comment 'Name of the parent esports organization or franchise entity that owns and operates this team (e.g., \'TSM FTX\', \'Cloud9 LLC\', \'Fnatic Ltd\'). A single organization may own multiple teams across different game titles. Used for sponsorship attribution, financial consolidation, and CRM relationship management.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceAnalyticsCode rdf:type rdf:Property ;
    rdfs:label 'Performance Analytics Code' ;
    rdfs:comment 'Reference code used to identify this team within the SportsCode/Hudl performance analytics and video analysis platform. Enables linkage of match performance data, player statistics, and scouting reports to the master team record.' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryJerseyColor rdf:type rdf:Property ;
    rdfs:label 'Primary Jersey Color' ;
    rdfs:comment 'Hexadecimal color code representing the team\'s primary jersey/brand color (e.g., \'#C89B3C\'). Used for broadcast graphics, digital asset management in Dalet Galaxy, fan engagement personalization in Adobe Experience Platform, and merchandise production.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryJerseyColor rdf:type rdf:Property ;
    rdfs:label 'Secondary Jersey Color' ;
    rdfs:comment 'Hexadecimal color code representing the team\'s secondary jersey/brand color. Used alongside primary_jersey_color for broadcast overlays, merchandise design, and fan engagement platform theming.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streamingPlatformCode rdf:type rdf:Property ;
    rdfs:label 'Streaming Platform Code' ;
    rdfs:comment 'Code identifying the primary OTT or streaming platform where the team\'s matches are broadcast (e.g., \'TWITCH\', \'YOUTUBE\', \'ESPN_PLUS\', \'PRIME_VIDEO\'). Used for broadcast rights management and media rights deal attribution. [ENUM-REF-CANDIDATE: TWITCH|YOUTUBE|ESPN_PLUS|PRIME_VIDEO|FACEBOOK_GAMING|TIKTOK|CUSTOM — promote to reference product]' ;
    rdfs:domain ind:EsportsTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamAbbreviation rdf:type rdf:Property ;
    rdfs:label 'Team Abbreviation' ;
    rdfs:comment 'Short uppercase abbreviation of the team name used in scoreboards, broadcast overlays, and digital displays (e.g., \'TSM\', \'C9\'). Distinct from team_code in that it is display-oriented rather than a system integration key.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamCode rdf:type rdf:Property ;
    rdfs:label 'Team Code' ;
    rdfs:comment 'Externally-known short alphanumeric code uniquely identifying the esports team across leagues, broadcasts, and partner systems (e.g., \'TSM\', \'C9\', \'FNC\'). Used as the business key in integrations with league management platforms and broadcast feeds.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamName rdf:type rdf:Property ;
    rdfs:label 'Team Name' ;
    rdfs:comment 'Full official name of the professional esports team as registered with the governing league or competition body (e.g., \'Team SoloMid\', \'Cloud9\', \'Fnatic\'). Used in fan-facing displays, broadcast graphics, and official league documentation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamStatus rdf:type rdf:Property ;
    rdfs:label 'Team Status' ;
    rdfs:comment 'Current lifecycle status of the esports team within the Sports Entertainment ecosystem. \'active\' indicates the team is currently competing; \'suspended\' indicates a temporary ban or regulatory hold; \'disbanded\' indicates the team has ceased operations; \'pending_approval\' indicates a new franchise application under review.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fantasyDraftId rdf:type rdf:Property ;
    rdfs:label 'Fantasy Draft Id' ;
    rdfs:comment 'Unique surrogate identifier for each fantasy draft event record in the gaming domain. Primary key for the fantasy_draft data product.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fantasyLeagueId rdf:type rdf:Property ;
    rdfs:label 'Fantasy League Id' ;
    rdfs:comment 'Foreign key linking to gaming.fantasy_league. Business justification: A fantasy draft event belongs to a specific fantasy league instance within the gaming domain. fantasy_draft has league_id → league.league (cross-domain reference to the sports league) but no FK to gam' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FantasyLeague .

ind:primaryFantasyTeamId rdf:type rdf:Property ;
    rdfs:label 'Primary Fantasy Team Id' ;
    rdfs:comment 'Reference to the fantasy team making the pick in this draft record. Supports roster allocation and draft grade analytics per team.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FantasyTeam .

ind:adp rdf:type rdf:Property ;
    rdfs:label 'Adp' ;
    rdfs:comment 'The Average Draft Position (ADP) of the selected athlete at the time of the draft, representing the consensus pick position across all platform drafts. Enables reach/value analysis and draft grade computation.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auctionBidAmount rdf:type rdf:Property ;
    rdfs:label 'Auction Bid Amount' ;
    rdfs:comment 'The winning bid amount in fantasy currency units paid for this athlete in an auction-format draft. Null for non-auction draft types. Supports auction draft valuation and budget analytics.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auctionBudgetRemaining rdf:type rdf:Property ;
    rdfs:label 'Auction Budget Remaining' ;
    rdfs:comment 'The fantasy team\'s remaining auction budget (in fantasy currency units) immediately after this pick was made. Null for non-auction draft types. Supports budget pacing and draft strategy analytics.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:draftCode rdf:type rdf:Property ;
    rdfs:label 'Draft Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the draft event, used in fan-facing platforms, CRM communications, and audit references. Distinct from the surrogate primary key.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:draftEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Draft End Timestamp' ;
    rdfs:comment 'The date and time the fantasy draft event concluded. Used to calculate draft duration and support operational reporting.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:draftNotes rdf:type rdf:Property ;
    rdfs:label 'Draft Notes' ;
    rdfs:comment 'Free-text operational notes or commissioner annotations associated with this draft event or pick, such as technical interruptions, disputed picks, or manual overrides. Supports audit and dispute resolution.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:draftOrderPosition rdf:type rdf:Property ;
    rdfs:label 'Draft Order Position' ;
    rdfs:comment 'The assigned draft order slot for the fantasy team in this draft event (e.g., position 1 = first pick in round 1). Determines pick sequencing across all rounds.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:draftPlatform rdf:type rdf:Property ;
    rdfs:label 'Draft Platform' ;
    rdfs:comment 'The digital channel or platform interface through which the draft pick was submitted (e.g., web browser, iOS app, Android app, API integration). Supports platform engagement analytics and technical incident investigation.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:draftScheduledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Draft Scheduled Timestamp' ;
    rdfs:comment 'The originally scheduled date and time for the draft event. Enables comparison against actual start time to measure draft punctuality and scheduling compliance.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:draftStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Draft Start Timestamp' ;
    rdfs:comment 'The actual date and time the fantasy draft event commenced. Principal business event timestamp used for draft history reporting, scheduling analytics, and audit trail.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:draftStatus rdf:type rdf:Property ;
    rdfs:label 'Draft Status' ;
    rdfs:comment 'Current lifecycle state of the fantasy draft event. Tracks progression from scheduling through completion or cancellation to support operational monitoring and audit.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:draftType rdf:type rdf:Property ;
    rdfs:label 'Draft Type' ;
    rdfs:comment 'Classification of the draft format governing pick order mechanics. Snake drafts reverse order each round; auction drafts use bidding; linear drafts maintain consistent order. [ENUM-REF-CANDIDATE: snake|auction|linear|third_round_reversal|autopick|salary_cap — promote to reference product]' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isKeeper rdf:type rdf:Property ;
    rdfs:label 'Is Keeper' ;
    rdfs:comment 'Indicates whether this pick represents a keeper selection carried over from a prior season under keeper or dynasty league rules. Affects draft order compensation and roster continuity analytics.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPaidLeague rdf:type rdf:Property ;
    rdfs:label 'Is Paid League' ;
    rdfs:comment 'Indicates whether this fantasy draft is associated with a paid entry-fee league. Triggers enhanced regulatory reporting, PCI-DSS payment compliance, and responsible gaming controls.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pickClockSeconds rdf:type rdf:Property ;
    rdfs:label 'Pick Clock Seconds' ;
    rdfs:comment 'The configured time limit in seconds allotted to each team manager to make a pick during the draft. Used to assess draft pace settings and compare against actual time used.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pickTimestamp rdf:type rdf:Property ;
    rdfs:label 'Pick Timestamp' ;
    rdfs:comment 'The exact date and time this individual pick selection was made during the draft. Supports pick-level audit, time-on-clock analytics, and draft replay functionality.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:pickValueScore rdf:type rdf:Property ;
    rdfs:label 'Pick Value Score' ;
    rdfs:comment 'A calculated draft value score representing the difference between the athlete\'s ADP and the actual overall pick number. Positive values indicate a value pick; negative values indicate a reach. Supports draft grade analytics.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pickWithinRound rdf:type rdf:Property ;
    rdfs:label 'Pick Within Round' ;
    rdfs:comment 'The ordinal position of this pick within its specific round (e.g., 3rd pick in round 2). Supports snake-draft order validation and round-level pick sequencing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preDraftRank rdf:type rdf:Property ;
    rdfs:label 'Pre Draft Rank' ;
    rdfs:comment 'The platform\'s consensus or algorithmic pre-draft ranking of the selected athlete prior to the draft event. Used for draft grade analytics, reach/value calculations, and pick quality scoring.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rosterSlot rdf:type rdf:Property ;
    rdfs:label 'Roster Slot' ;
    rdfs:comment 'The designated roster slot on the fantasy team to which this athlete was assigned at the time of the draft pick (e.g., FLEX, BENCH, STARTER). Supports roster construction analytics and lineup compliance. [ENUM-REF-CANDIDATE: starter|flex|bench|ir|taxi|reserve — promote to reference product]' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoringFormat rdf:type rdf:Property ;
    rdfs:label 'Scoring Format' ;
    rdfs:comment 'The scoring ruleset applied to this fantasy draft, such as standard, Points Per Reception (PPR), half-PPR, or auction. Determines athlete valuation and draft strategy context for analytics.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeUsedSeconds rdf:type rdf:Property ;
    rdfs:label 'Time Used Seconds' ;
    rdfs:comment 'The actual number of seconds the team manager used before submitting this pick. Enables pick-clock utilization analytics and identification of slow-draft patterns.' ;
    rdfs:domain ind:FantasyDraft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageRestrictionMinimum rdf:type rdf:Property ;
    rdfs:label 'Age Restriction Minimum' ;
    rdfs:comment 'Minimum participant age (in years) required to join this league, as mandated by the applicable gaming jurisdiction. Typically 18 or 21 depending on state/country regulations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auctionBudget rdf:type rdf:Property ;
    rdfs:label 'Auction Budget' ;
    rdfs:comment 'The total virtual currency budget allocated to each team manager for bidding during an auction draft. Applicable only when draft_type is auction. Null for snake or auto-pick drafts.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchSlots rdf:type rdf:Property ;
    rdfs:label 'Bench Slots' ;
    rdfs:comment 'Number of non-scoring reserve player slots on each team\'s roster. Bench players do not contribute to weekly scoring but are held for future use.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:faabBudget rdf:type rdf:Property ;
    rdfs:label 'Faab Budget' ;
    rdfs:comment 'The total Free Agent Acquisition Budget (FAAB) allocated to each team at season start for bidding on waiver wire players. Applicable only when waiver_type is FAAB. Null for non-FAAB leagues.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inviteCode rdf:type rdf:Property ;
    rdfs:label 'Invite Code' ;
    rdfs:comment 'Alphanumeric code required to join a private or corporate league. Distributed by the commissioner to authorized participants. Null for public leagues.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isKeeperLeague rdf:type rdf:Property ;
    rdfs:label 'Is Keeper League' ;
    rdfs:comment 'Indicates whether the league allows managers to retain (keep) a defined number of players from one season to the next. True for keeper and dynasty formats; False for redraft leagues.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPublic rdf:type rdf:Property ;
    rdfs:label 'Is Public' ;
    rdfs:comment 'Indicates whether the league is publicly discoverable and joinable without an invitation code. True for open public leagues; False for private, corporate, or invite-only leagues.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:keeperSlotCount rdf:type rdf:Property ;
    rdfs:label 'Keeper Slot Count' ;
    rdfs:comment 'Number of players each team manager is permitted to retain (keep) from the prior season\'s roster. Applicable only when is_keeper_league is True. Null for redraft leagues.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leagueExternalCode rdf:type rdf:Property ;
    rdfs:label 'League External Code' ;
    rdfs:comment 'Externally-known identifier assigned by the originating platform (e.g., DraftKings league ID, FanDuel league code, or proprietary platform reference). Used for cross-system reconciliation.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leagueStatus rdf:type rdf:Property ;
    rdfs:label 'League Status' ;
    rdfs:comment 'Current lifecycle state of the fantasy league. Forming: accepting members pre-draft; draft_pending: roster locked awaiting draft; active: in-season competition underway; completed: season concluded and prizes awarded; cancelled: league disbanded before completion; suspended: temporarily halted pending review.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leagueType rdf:type rdf:Property ;
    rdfs:label 'League Type' ;
    rdfs:comment 'Classification of the league by access model. Public leagues are open to any participant; private leagues require an invitation code; corporate leagues are employer-sponsored; satellite leagues are sub-leagues of a larger contest; managed leagues are operated by the platform on behalf of sponsors.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxTeamCount rdf:type rdf:Property ;
    rdfs:label 'Max Team Count' ;
    rdfs:comment 'The maximum number of teams permitted to join the league. Once reached, the league is closed to new entrants. May differ from team_count during the forming phase.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:playoffStartWeek rdf:type rdf:Property ;
    rdfs:label 'Playoff Start Week' ;
    rdfs:comment 'The competition week number (within the sport\'s season) at which the fantasy playoff bracket begins. Determines the length of the regular season and playoff scheduling.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:playoffTeamCount rdf:type rdf:Property ;
    rdfs:label 'Playoff Team Count' ;
    rdfs:comment 'Number of teams that qualify for the end-of-season playoff bracket. Determines playoff seeding logic and the number of regular-season weeks required.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prizeStructure rdf:type rdf:Property ;
    rdfs:label 'Prize Structure' ;
    rdfs:comment 'Distribution model for prize pool payouts. Winner-take-all awards the full pool to first place; top_3 distributes across three places; top_half pays all teams finishing in the upper half; custom uses a commissioner-defined payout schedule.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationCloseDate rdf:type rdf:Property ;
    rdfs:label 'Registration Close Date' ;
    rdfs:comment 'The last date on which new team managers may join the league. After this date, the league roster is locked and the draft is scheduled.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registrationOpenDate rdf:type rdf:Property ;
    rdfs:label 'Registration Open Date' ;
    rdfs:comment 'The date on which the league becomes open for new team manager registrations. Relevant for public leagues and marketing campaign alignment.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scoringPeriodType rdf:type rdf:Property ;
    rdfs:label 'Scoring Period Type' ;
    rdfs:comment 'The frequency at which fantasy points are tallied and matchup results are determined. Weekly is standard for NFL; daily is common for NBA and MLB; season_long accumulates points across the full season.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sport rdf:type rdf:Property ;
    rdfs:label 'Sport' ;
    rdfs:comment 'The professional sport governing the fantasy league\'s player pool, scoring rules, and roster positions. Determines which athlete statistics feed into scoring calculations. [ENUM-REF-CANDIDATE: NFL|NBA|MLB|NHL|MLS|PGA|NASCAR|UFC|OTHER — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:starterCount rdf:type rdf:Property ;
    rdfs:label 'Starter Count' ;
    rdfs:comment 'Number of active (starting) roster slots that score points each week. Excludes bench slots. Critical for lineup optimization analytics.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:teamCount rdf:type rdf:Property ;
    rdfs:label 'Team Count' ;
    rdfs:comment 'The configured number of team slots in the league. Determines bracket structure, waiver order, and playoff seeding. Typical values range from 8 to 16 for standard leagues.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tradeDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Trade Deadline Date' ;
    rdfs:comment 'The last calendar date on which team managers may execute player trades between teams. After this date, rosters are locked for the remainder of the season.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tradeReviewType rdf:type rdf:Property ;
    rdfs:label 'Trade Review Type' ;
    rdfs:comment 'The process by which proposed trades are reviewed and approved or vetoed. Commissioner review gives sole authority to the commissioner; league_vote requires a majority of managers to approve; auto_approve processes trades immediately; none disables trading.' ;
    rdfs:domain ind:FantasyLeague ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverType rdf:type rdf:Property ;
    rdfs:label 'Waiver Type' ;
    rdfs:comment 'The mechanism governing how unclaimed free-agent players are acquired during the season. FAAB (Free Agent Acquisition Budget) uses a blind bidding system; rolling assigns priority by last waiver claim; reverse_standings gives priority to lower-ranked teams; none allows immediate free-agent pickups.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fantasyTeamId rdf:type rdf:Property ;
    rdfs:label 'Fantasy Team Id' ;
    rdfs:comment 'Reference to the fantasy team that owns this roster. Links the roster record to the managing team entity within the fantasy league platform.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FantasyTeam .

ind:tradeTransactionId rdf:type rdf:Property ;
    rdfs:label 'Trade Transaction Id' ;
    rdfs:comment 'Reference to the trade transaction record through which this athlete was acquired, applicable when acquisition_type is \'trade\'. Links to the trade history for multi-party trade auditing and commissioner review.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TradeTransaction .

ind:acquisitionType rdf:type rdf:Property ;
    rdfs:label 'Acquisition Type' ;
    rdfs:comment 'The method by which the fantasy team acquired this athlete onto their roster. Supports waiver processing audits, trade history reporting, and draft analytics.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auctionDraftPrice rdf:type rdf:Property ;
    rdfs:label 'Auction Draft Price' ;
    rdfs:comment 'The winning bid amount paid for this athlete during an auction-style fantasy draft, applicable when acquisition_type is \'drafted\' in auction format leagues. Used for auction value analytics and budget management reporting.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionerOverride rdf:type rdf:Property ;
    rdfs:label 'Commissioner Override' ;
    rdfs:comment 'Indicates whether a league commissioner manually overrode the standard roster rules to create or modify this roster record (e.g., reversing an invalid trade, correcting a system error). Supports audit trails for commissioner actions.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionerOverrideNotes rdf:type rdf:Property ;
    rdfs:label 'Commissioner Override Notes' ;
    rdfs:comment 'Free-text notes entered by the league commissioner explaining the rationale for any manual roster override. Populated only when commissioner_override is true. Supports dispute resolution and audit documentation.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dropDate rdf:type rdf:Property ;
    rdfs:label 'Drop Date' ;
    rdfs:comment 'The calendar date on which this athlete was dropped from the fantasy team\'s roster, releasing them to the waiver wire or free agent pool. Null if the athlete is currently rostered. Supports roster history and waiver wire availability tracking.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dropReason rdf:type rdf:Property ;
    rdfs:label 'Drop Reason' ;
    rdfs:comment 'The reason code explaining why this athlete was removed from the fantasy roster. Supports waiver wire analytics, commissioner dispute resolution, and roster management pattern analysis.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isIrEligible rdf:type rdf:Property ;
    rdfs:label 'Is Ir Eligible' ;
    rdfs:comment 'Indicates whether this athlete currently qualifies for placement on the fantasy team\'s Injured Reserve (IR) slot based on their real-world injury designation (e.g., IR, PUP, Out). Enables roster management without dropping injured players.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStartingLineup rdf:type rdf:Property ;
    rdfs:label 'Is Starting Lineup' ;
    rdfs:comment 'Indicates whether this athlete is designated in the active starting lineup (true) or on the bench (false) for the current scoring period. Determines whether the athlete\'s real-world performance scores points for the fantasy team.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:keeperCostRound rdf:type rdf:Property ;
    rdfs:label 'Keeper Cost Round' ;
    rdfs:comment 'The draft round cost assigned to retaining this athlete as a keeper in the subsequent season\'s draft. Applicable in keeper leagues; null for non-keeper acquisitions.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:keeperYear rdf:type rdf:Property ;
    rdfs:label 'Keeper Year' ;
    rdfs:comment 'The season year in which this athlete was designated as a keeper, applicable in keeper or dynasty league formats where acquisition_type is \'keeper\'. Tracks multi-year keeper eligibility and cost escalation rules.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leagueFormat rdf:type rdf:Property ;
    rdfs:label 'League Format' ;
    rdfs:comment 'The format type of the fantasy league governing this roster record. Determines applicable roster rules, keeper eligibility, salary cap applicability, and scoring configurations.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineupChangeCount rdf:type rdf:Property ;
    rdfs:label 'Lineup Change Count' ;
    rdfs:comment 'The number of times this roster slot has been modified (athlete swapped in or out) during the current scoring period prior to roster lock. Used for engagement analytics and lineup activity monitoring.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rosterLockTimestamp rdf:type rdf:Property ;
    rdfs:label 'Roster Lock Timestamp' ;
    rdfs:comment 'The precise date and time at which this roster configuration was locked for the scoring period, preventing further lineup changes. Critical for dispute resolution and lineup integrity enforcement.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rosterReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Roster Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for this roster record, used in API responses, waiver processing confirmations, and fan-facing lineup management interfaces.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rosterSlotPosition rdf:type rdf:Property ;
    rdfs:label 'Roster Slot Position' ;
    rdfs:comment 'The designated roster slot position label assigned to this athlete entry (e.g., QB, RB, WR, TE, FLEX, K, DEF, SP, RP, C, PG, SG, SF, PF, G, F, UTIL). Governs lineup eligibility and scoring rules per slot. [ENUM-REF-CANDIDATE: QB|RB|WR|TE|FLEX|K|DEF|SP|RP|C|PG|SG|SF|PF|G|F|UTIL|BN|IR — promote to reference product]' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryCapValue rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Value' ;
    rdfs:comment 'The salary cap dollar amount assigned to this athlete on the fantasy team\'s roster, applicable in salary cap or auction draft league formats. Contributes to the team\'s total salary cap utilization tracking.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoringPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Scoring Period End Date' ;
    rdfs:comment 'The end date of the fantasy scoring period to which this roster record applies. Together with scoring_period_start_date, defines the exact window for which this roster configuration is valid.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scoringPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Scoring Period Start Date' ;
    rdfs:comment 'The start date of the fantasy scoring period (week, day, or matchup period) to which this roster record applies. Used for period-based scoring calculations and historical roster snapshots.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourcePlatform rdf:type rdf:Property ;
    rdfs:label 'Source Platform' ;
    rdfs:comment 'The platform or channel through which the roster action (acquisition, lineup change, drop) was initiated. Supports fan engagement analytics, platform adoption reporting, and Adobe Experience Platform personalization.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverClaimPriority rdf:type rdf:Property ;
    rdfs:label 'Waiver Claim Priority' ;
    rdfs:comment 'The waiver wire priority order of the fantasy team at the time this athlete was claimed via waiver, applicable when acquisition_type is \'waiver\'. Lower values indicate higher priority. Used for waiver dispute resolution and fairness auditing.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waiverClaimTimestamp rdf:type rdf:Property ;
    rdfs:label 'Waiver Claim Timestamp' ;
    rdfs:comment 'The precise timestamp at which the waiver claim for this athlete was submitted by the fantasy team manager. Applicable when acquisition_type is \'waiver\'. Used for claim ordering and dispute resolution.' ;
    rdfs:domain ind:FantasyRoster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:divisionId rdf:type rdf:Property ;
    rdfs:label 'Division Id' ;
    rdfs:comment 'Reference to the sub-division within the fantasy league to which this team is assigned. Applicable in leagues with divisional structures. Scopes head-to-head scheduling and divisional standings.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Division .

ind:primaryFantasyBettorAccountId rdf:type rdf:Property ;
    rdfs:label 'Primary Fantasy Bettor Account Id' ;
    rdfs:comment 'Reference to the licensed bettor/player account that owns and manages this fantasy team. Links to the registered gaming account for responsible gaming monitoring, KYC compliance, and regulatory reporting.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BettorAccount .

ind:auctionBudgetSpent rdf:type rdf:Property ;
    rdfs:label 'Auction Budget Spent' ;
    rdfs:comment 'The total virtual currency spent by this team during the auction draft. Used to calculate remaining budget and validate draft compliance. Applicable only when draft_type is \'auction\'.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autopickEnabled rdf:type rdf:Property ;
    rdfs:label 'Autopick Enabled' ;
    rdfs:comment 'Indicates whether the platform\'s automated lineup optimization is enabled for this team. When true, the system sets the optimal starting lineup based on projected points if the manager does not manually set it before the deadline.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:draftPosition rdf:type rdf:Property ;
    rdfs:label 'Draft Position' ;
    rdfs:comment 'The pick order assigned to this team in the fantasy league\'s draft. Determines the sequence in which the team selects athletes during the draft event. Lower numbers indicate earlier selection priority.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emailNotificationEnabled rdf:type rdf:Property ;
    rdfs:label 'Email Notification Enabled' ;
    rdfs:comment 'Indicates whether the team owner has opted in to receive email notifications for league events such as waiver results, trade proposals, and scoring updates. Supports GDPR and CCPA consent management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:faabRemaining rdf:type rdf:Property ;
    rdfs:label 'Faab Remaining' ;
    rdfs:comment 'The remaining Free Agent Acquisition Budget (FAAB) balance available for future waiver claims. Decremented with each successful blind-bid claim. Applicable in FAAB waiver leagues.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastActivityTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Activity Timestamp' ;
    rdfs:comment 'The most recent timestamp at which the team owner performed any action (lineup change, waiver claim, trade, login). Used for inactive team detection, responsible gaming monitoring, and engagement analytics.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:losses rdf:type rdf:Property ;
    rdfs:label 'Losses' ;
    rdfs:comment 'Total number of head-to-head matchup losses accumulated by this team in the current season. Used for standings calculation and playoff seeding.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:managerDisplayName rdf:type rdf:Property ;
    rdfs:label 'Manager Display Name' ;
    rdfs:comment 'The public-facing display name of the team owner/manager as shown to other league participants. Distinct from the bettor\'s legal name; may be a username or alias per platform privacy settings.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:playoffQualified rdf:type rdf:Property ;
    rdfs:label 'Playoff Qualified' ;
    rdfs:comment 'Indicates whether this team has clinched a playoff berth in the current season. True when the team meets the league\'s qualification criteria based on record and standings.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:playoffSeed rdf:type rdf:Property ;
    rdfs:label 'Playoff Seed' ;
    rdfs:comment 'The seeding position assigned to this team upon qualifying for the fantasy league playoffs. Null if the team has not yet qualified. Determines bracket placement and bye-week eligibility.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pointsAgainst rdf:type rdf:Property ;
    rdfs:label 'Points Against' ;
    rdfs:comment 'Cumulative fantasy points scored by opponents against this team across all completed scoring periods. Used as a secondary tiebreaker in standings and for strength-of-schedule analytics.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryColorHex rdf:type rdf:Property ;
    rdfs:label 'Primary Color Hex' ;
    rdfs:comment 'Hexadecimal color code representing the team\'s primary brand color. Used for UI theming, scorecard rendering, and personalized fan engagement displays.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pushNotificationEnabled rdf:type rdf:Property ;
    rdfs:label 'Push Notification Enabled' ;
    rdfs:comment 'Indicates whether the team owner has opted in to receive mobile push notifications for real-time scoring updates, injury alerts, and waiver wire activity. Supports GDPR and CCPA consent management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondaryColorHex rdf:type rdf:Property ;
    rdfs:label 'Secondary Color Hex' ;
    rdfs:comment 'Hexadecimal color code representing the team\'s secondary brand color. Complements the primary color for full team branding in UI and broadcast contexts.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standingRank rdf:type rdf:Property ;
    rdfs:label 'Standing Rank' ;
    rdfs:comment 'Current ordinal rank of this team within its division or league based on wins, losses, ties, and points scored. Updated after each scoring period. Used for playoff qualification determination.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:teamSlogan rdf:type rdf:Property ;
    rdfs:label 'Team Slogan' ;
    rdfs:comment 'Optional user-defined tagline or motto for the fantasy team. Displayed on team profile pages and league communications. Subject to content moderation policies.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ties rdf:type rdf:Property ;
    rdfs:label 'Ties' ;
    rdfs:comment 'Total number of head-to-head matchup ties accumulated by this team in the current season. Relevant in leagues where tie-breaking rules apply to standings.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tradeBlockStatus rdf:type rdf:Property ;
    rdfs:label 'Trade Block Status' ;
    rdfs:comment 'Indicates whether the team owner has flagged this team\'s athletes as available for trade negotiations. True signals that the owner is actively seeking trade offers, enabling targeted trade proposals from other managers.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tradesAccepted rdf:type rdf:Property ;
    rdfs:label 'Trades Accepted' ;
    rdfs:comment 'Total number of trade transactions accepted by this team in the current season. Used for trade activity monitoring and collusion detection under responsible gaming compliance.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tradesVetoed rdf:type rdf:Property ;
    rdfs:label 'Trades Vetoed' ;
    rdfs:comment 'Total number of trade proposals involving this team that were vetoed by the league commissioner or league vote. Supports collusion investigation and league integrity monitoring.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waiverClaimsUsed rdf:type rdf:Property ;
    rdfs:label 'Waiver Claims Used' ;
    rdfs:comment 'Total number of waiver wire claims exercised by this team in the current season. Used to enforce per-season claim limits where applicable under league rules.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waiverPriority rdf:type rdf:Property ;
    rdfs:label 'Waiver Priority' ;
    rdfs:comment 'The team\'s current priority position in the waiver wire queue. Lower numbers indicate higher priority for claiming available athletes. Resets or adjusts based on league waiver rules after each claim.' ;
    rdfs:domain ind:FantasyTeam ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:wins rdf:type rdf:Property ;
    rdfs:label 'Wins' ;
    rdfs:comment 'Total number of head-to-head matchup wins accumulated by this team in the current season. Used for standings calculation and playoff seeding.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fantasyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Fantasy Transaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each fantasy roster transaction record in the gaming domain. Primary key for the fantasy_transaction data product.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:droppedAthleteAthleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Dropped Athlete Athlete Profile Id' ;
    rdfs:comment 'Reference to the athlete dropped from the initiating team\'s roster as part of an add/drop transaction. Populated when a team must drop an athlete to make roster space for a waiver claim or free agent pickup. Null for standalone add or trade transactions.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:primaryFantasyAthleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Primary Fantasy Athlete Profile Id' ;
    rdfs:comment 'Reference to the primary athlete involved in this transaction (the athlete being added, dropped, or traded). For multi-athlete trades, this represents the first or primary athlete; additional athletes are captured in child transaction line records.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:receivingTeamFantasyTeamId rdf:type rdf:Property ;
    rdfs:label 'Receiving Team Fantasy Team Id' ;
    rdfs:comment 'Reference to the fantasy team on the receiving end of a trade transaction. Null for non-trade transactions such as waiver claims, free agent pickups, and drops.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FantasyTeam .

ind:commissionerOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Commissioner Override Flag' ;
    rdfs:comment 'Indicates whether the league commissioner manually overrode the standard transaction processing rules to approve, reject, or modify this transaction outside of the automated workflow. True when commissioner intervention occurred.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionerOverrideReason rdf:type rdf:Property ;
    rdfs:label 'Commissioner Override Reason' ;
    rdfs:comment 'Free-text explanation provided by the commissioner when manually overriding a transaction. Required when commissioner_override_flag is True. Supports dispute resolution and league governance audit trails.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:faabAmountSpent rdf:type rdf:Property ;
    rdfs:label 'Faab Amount Spent' ;
    rdfs:comment 'The Free Agent Acquisition Budget (FAAB) dollar amount bid and spent by the initiating team to claim this athlete in a FAAB-based waiver system. Zero for non-FAAB leagues or non-waiver transactions. Represents the gross bid amount before any adjustments.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:faabBalanceAfter rdf:type rdf:Property ;
    rdfs:label 'Faab Balance After' ;
    rdfs:comment 'The initiating team\'s remaining FAAB balance immediately after this transaction was processed. Calculated as faab_balance_before minus faab_amount_spent; stored as a snapshot for audit and responsible gaming compliance reporting.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:faabBalanceBefore rdf:type rdf:Property ;
    rdfs:label 'Faab Balance Before' ;
    rdfs:comment 'The initiating team\'s remaining FAAB balance immediately before this transaction was processed. Enables audit of FAAB spend history and detection of invalid bids exceeding available budget.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lopsidedTradeFlag rdf:type rdf:Property ;
    rdfs:label 'Lopsided Trade Flag' ;
    rdfs:comment 'Indicates whether the system\'s trade fairness algorithm flagged this trade as significantly imbalanced based on the differential between trade_value_score_initiating and trade_value_score_receiving. Triggers automatic commissioner review notification.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:moveLimitExceededFlag rdf:type rdf:Property ;
    rdfs:label 'Move Limit Exceeded Flag' ;
    rdfs:comment 'Indicates whether this transaction was submitted after the initiating team had already reached the league\'s maximum weekly or seasonal roster move limit. Transactions with this flag set to True are typically auto-rejected.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nflWeekNumber rdf:type rdf:Property ;
    rdfs:label 'Nfl Week Number' ;
    rdfs:comment 'The sport season week number during which this transaction was submitted. Used for weekly roster move limits enforcement, trend analytics, and season-over-season comparison reporting. Applicable primarily to NFL and other weekly-schedule sports.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:processingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processing Timestamp' ;
    rdfs:comment 'The date and time when the transaction was fully executed and roster changes took effect. Distinct from transaction_timestamp (submission time); reflects the actual roster update time after waiver processing runs or trade approval.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rosterAction rdf:type rdf:Property ;
    rdfs:label 'Roster Action' ;
    rdfs:comment 'Specific directional roster action applied to the initiating team\'s roster: add (athlete added to roster), drop (athlete removed from roster), add_drop (simultaneous add and drop in a single transaction), trade_send (athlete sent to receiving team), trade_receive (athlete received from receiving team).' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rosterPositionAdded rdf:type rdf:Property ;
    rdfs:label 'Roster Position Added' ;
    rdfs:comment 'The fantasy roster slot designation to which the added athlete was assigned (e.g., QB, RB, WR, TE, FLEX, IR, BN). Reflects the position slot on the initiating team\'s roster. Null for drop-only transactions.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rosterPositionDropped rdf:type rdf:Property ;
    rdfs:label 'Roster Position Dropped' ;
    rdfs:comment 'The fantasy roster slot designation from which the dropped athlete was removed (e.g., QB, RB, WR, TE, FLEX, IR, BN). Reflects the vacated position slot on the initiating team\'s roster. Null for add-only transactions.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeDeadlineFlag rdf:type rdf:Property ;
    rdfs:label 'Trade Deadline Flag' ;
    rdfs:comment 'Indicates whether this transaction was submitted within the final 24-hour window before the league\'s trade deadline. Used for compliance monitoring, commissioner review prioritization, and analytics on late-season roster activity.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tradeReviewDeadline rdf:type rdf:Property ;
    rdfs:label 'Trade Review Deadline' ;
    rdfs:comment 'The date and time by which league members must cast veto votes or the commissioner must act before the trade is automatically approved and processed. Applicable only to trade transactions in leagues with a review window.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:tradeValueScoreInitiating rdf:type rdf:Property ;
    rdfs:label 'Trade Value Score Initiating' ;
    rdfs:comment 'Algorithmic trade fairness score representing the estimated fantasy value of assets sent by the initiating team in a trade, based on player rankings, projected points, and market data at transaction time. Used for lopsided trade detection and commissioner review flagging.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradeValueScoreReceiving rdf:type rdf:Property ;
    rdfs:label 'Trade Value Score Receiving' ;
    rdfs:comment 'Algorithmic trade fairness score representing the estimated fantasy value of assets received by the initiating team in a trade. Compared against trade_value_score_initiating to compute trade imbalance ratio for lopsided trade alerts and commissioner review.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vetoThreshold rdf:type rdf:Property ;
    rdfs:label 'Veto Threshold' ;
    rdfs:comment 'The minimum number of veto votes required to block this transaction in the league\'s democratic veto system. Captured at transaction time to preserve the rule in effect when the transaction was submitted, as league settings may change.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vetoVoteCount rdf:type rdf:Property ;
    rdfs:label 'Veto Vote Count' ;
    rdfs:comment 'Number of veto votes cast against this transaction by league members in leagues using a democratic veto system. Compared against the league\'s veto threshold to determine if the transaction is blocked. Null for non-veto leagues.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waiverPriorityAfter rdf:type rdf:Property ;
    rdfs:label 'Waiver Priority After' ;
    rdfs:comment 'The initiating team\'s waiver wire priority rank after this transaction was processed. Reflects the updated standing following priority consumption or end-of-week reset. Used for audit and fairness compliance reporting.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waiverPriorityUsed rdf:type rdf:Property ;
    rdfs:label 'Waiver Priority Used' ;
    rdfs:comment 'The waiver wire priority rank consumed by the initiating team when claiming an athlete off waivers. Lower numbers indicate higher priority. Null for free agent pickups, drops, and trades where waiver priority is not applicable.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waiverProcessingDay rdf:type rdf:Property ;
    rdfs:label 'Waiver Processing Day' ;
    rdfs:comment 'The scheduled calendar date on which the waiver wire batch run processed this claim. Distinct from transaction_timestamp (submission) and processing_timestamp (exact execution time). Used for weekly waiver cycle reporting and fairness audits.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:weeklyMoveCountAtSubmission rdf:type rdf:Property ;
    rdfs:label 'Weekly Move Count At Submission' ;
    rdfs:comment 'The number of roster moves the initiating team had already made in the current week at the time this transaction was submitted. Used to enforce weekly move limits and detect violations of league roster transaction rules.' ;
    rdfs:domain ind:FantasyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amlReportingThreshold rdf:type rdf:Property ;
    rdfs:label 'Aml Reporting Threshold' ;
    rdfs:comment 'Monetary threshold (in jurisdiction currency) above which a single wagering transaction or cumulative patron activity must be reported to the regulatory authority under Anti-Money Laundering (AML) requirements (e.g., USD 10,000 per FinCEN CTR rules). Null if no statutory threshold applies.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicationSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Application Submission Date' ;
    rdfs:comment 'Date on which Sports Entertainment submitted the initial or renewal license application to the regulatory authority. Used to track application pipeline and regulatory processing timelines.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collegeSportsWageringPermitted rdf:type rdf:Property ;
    rdfs:label 'College Sports Wagering Permitted' ;
    rdfs:comment 'Indicates whether wagering on college and university sporting events is permitted in this jurisdiction. Several jurisdictions prohibit wagering on in-state college teams or all college sports. True = college sports wagering authorized; False = prohibited.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataLocalizationRequired rdf:type rdf:Property ;
    rdfs:label 'Data Localization Required' ;
    rdfs:comment 'Indicates whether the jurisdiction mandates that patron data and wagering transaction records must be stored within the geographic boundaries of the jurisdiction. True = data must remain in-jurisdiction; False = no localization requirement. Impacts cloud infrastructure and data residency architecture.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:depositLimitRequired rdf:type rdf:Property ;
    rdfs:label 'Deposit Limit Required' ;
    rdfs:comment 'Indicates whether the jurisdiction mandates that operators offer or enforce patron deposit limits as part of responsible gaming compliance. True = deposit limits are a regulatory requirement; False = not mandated.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dfsPermitted rdf:type rdf:Property ;
    rdfs:label 'Dfs Permitted' ;
    rdfs:comment 'Indicates whether Daily Fantasy Sports (DFS) contests are legally permitted in this jurisdiction. True = DFS authorized; False = not authorized. Drives DFS product availability and platform configuration.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geolocationRequired rdf:type rdf:Property ;
    rdfs:label 'Geolocation Required' ;
    rdfs:comment 'Indicates whether real-time geolocation verification is required to confirm the patron is physically located within the jurisdiction at the time of wagering. True = geolocation check mandatory; False = not required.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ggrTaxRate rdf:type rdf:Property ;
    rdfs:label 'Ggr Tax Rate' ;
    rdfs:comment 'Statutory tax rate applied to Gross Gaming Revenue (GGR) in this jurisdiction, expressed as a decimal percentage (e.g., 0.1300 = 13%). GGR is defined as total wagers accepted minus winnings paid to players. Used in financial planning, P&L modeling, and tax remittance calculations.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inPlayWageringPermitted rdf:type rdf:Property ;
    rdfs:label 'In Play Wagering Permitted' ;
    rdfs:comment 'Indicates whether in-play (live) wagering on ongoing sporting events is permitted in this jurisdiction. Some jurisdictions restrict wagering to pre-game markets only. True = in-play wagering authorized; False = pre-game only.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:integrityFeeRate rdf:type rdf:Property ;
    rdfs:label 'Integrity Fee Rate' ;
    rdfs:comment 'Rate (expressed as a decimal percentage of handle or GGR) payable to sports leagues or governing bodies as a sports integrity fee or data royalty mandated by the jurisdiction (e.g., 0.0025 = 0.25%). Null if no integrity fee is required. Relevant for NFL, NBA, MLB, NHL, MLS league data agreements.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:kycRequired rdf:type rdf:Property ;
    rdfs:label 'Kyc Required' ;
    rdfs:comment 'Indicates whether Know Your Customer (KYC) identity verification is mandated by the regulatory authority before a patron may place wagers in this jurisdiction. True = KYC mandatory; False = KYC not required.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxSingleWagerLimit rdf:type rdf:Property ;
    rdfs:label 'Max Single Wager Limit' ;
    rdfs:comment 'Maximum monetary amount (in jurisdiction currency) permitted for a single wager as mandated by the regulatory authority. Null if no statutory cap exists. Used to configure wagering platform risk controls and patron-facing bet limits.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minAgeRequirement rdf:type rdf:Property ;
    rdfs:label 'Min Age Requirement' ;
    rdfs:comment 'Minimum legal age (in years) required for a patron to participate in sports wagering or fantasy sports in this jurisdiction (e.g., 18 or 21). Enforced at account registration and KYC verification.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:officialDataMandate rdf:type rdf:Property ;
    rdfs:label 'Official Data Mandate' ;
    rdfs:comment 'Indicates whether the jurisdiction requires operators to use official league-supplied data feeds for in-play wagering markets (as opposed to third-party data providers). True = official data required; False = no mandate. Impacts data vendor contracts and API integration requirements.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onlineWageringPermitted rdf:type rdf:Property ;
    rdfs:label 'Online Wagering Permitted' ;
    rdfs:comment 'Indicates whether online and mobile sports wagering is permitted in this jurisdiction, as distinct from retail (in-person) wagering. True = online/mobile wagering authorized; False = retail only.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:promotionalDeductionAllowed rdf:type rdf:Property ;
    rdfs:label 'Promotional Deduction Allowed' ;
    rdfs:comment 'Indicates whether the jurisdiction permits deduction of promotional credits and free-play bonuses from gross gaming revenue before calculating the taxable GGR base. True = deductions permitted; False = gross revenue taxed without promotional deductions.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:propBetPermitted rdf:type rdf:Property ;
    rdfs:label 'Prop Bet Permitted' ;
    rdfs:comment 'Indicates whether proposition bets (prop bets) on individual player or game-specific outcomes are permitted in this jurisdiction. Some jurisdictions restrict prop bets on college athletes or specific leagues. True = prop bets authorized; False = restricted.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regionOrState rdf:type rdf:Property ;
    rdfs:label 'Region Or State' ;
    rdfs:comment 'Name of the sub-national administrative region, state, or province within the country (e.g., New Jersey, Nevada, Ontario, England). Null for country-level jurisdictions. Supports state-level regulatory mapping.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleGamingMandates rdf:type rdf:Property ;
    rdfs:label 'Responsible Gaming Mandates' ;
    rdfs:comment 'Free-text description of applicable responsible gaming compliance mandates imposed by the regulatory authority in this jurisdiction, including deposit limits, loss limits, session time limits, cooling-off periods, and problem gambling helpline display requirements.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retailWageringPermitted rdf:type rdf:Property ;
    rdfs:label 'Retail Wagering Permitted' ;
    rdfs:comment 'Indicates whether retail in-person sports wagering at licensed physical locations (e.g., sportsbooks at venues or casinos) is permitted in this jurisdiction. True = retail wagering authorized; False = not authorized.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:selfExclusionProgramName rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion Program Name' ;
    rdfs:comment 'Name of the mandatory responsible gaming self-exclusion program administered by the regulatory authority in this jurisdiction (e.g., New Jersey Self-Exclusion Program, GamStop UK). Operators must integrate with this program as a condition of licensure.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportsWageringPermitted rdf:type rdf:Property ;
    rdfs:label 'Sports Wagering Permitted' ;
    rdfs:comment 'Indicates whether fixed-odds sports wagering is legally permitted in this jurisdiction under the current license. True = sports wagering authorized; False = not authorized. Drives product availability configuration.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxRemittanceFrequency rdf:type rdf:Property ;
    rdfs:label 'Tax Remittance Frequency' ;
    rdfs:comment 'Frequency at which GGR tax payments must be remitted to the regulatory authority in this jurisdiction. Drives accounts payable scheduling and cash flow planning in SAP S/4HANA FI/CO.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amlAlertFlag rdf:type rdf:Property ;
    rdfs:label 'Aml Alert Flag' ;
    rdfs:comment 'Indicates whether this gaming session generated an AML behavioral alert based on wagering velocity, amount thresholds, or pattern anomalies. Supports AML compliance monitoring, Suspicious Activity Report (SAR) workflows, and regulatory audit trails.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bonusWageredAmount rdf:type rdf:Property ;
    rdfs:label 'Bonus Wagered Amount' ;
    rdfs:comment 'Portion of total_wagered_amount funded by promotional bonus credits rather than real-money balance during this session. Required for bonus liability accounting, promotional ROI analysis, and regulatory reporting that distinguishes real-money from bonus play.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashoutCount rdf:type rdf:Property ;
    rdfs:label 'Cashout Count' ;
    rdfs:comment 'Number of early cash-out transactions executed by the bettor during this gaming session. Supports cash-out feature engagement analytics and liability management reporting.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deviceFingerprint rdf:type rdf:Property ;
    rdfs:label 'Device Fingerprint' ;
    rdfs:comment 'Hashed or tokenized unique identifier derived from device hardware and software characteristics. Used for multi-account detection, fraud prevention, and AML behavioral profiling across sessions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:freeBetCount rdf:type rdf:Property ;
    rdfs:label 'Free Bet Count' ;
    rdfs:comment 'Number of free bet tokens redeemed by the bettor during this gaming session. Supports promotional campaign performance tracking and bonus liability reporting.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geolocationCountryCode rdf:type rdf:Property ;
    rdfs:label 'Geolocation Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the bettor\'s verified physical location at session start. Supports international regulatory compliance and cross-border AML reporting.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geolocationStateCode rdf:type rdf:Property ;
    rdfs:label 'Geolocation State Code' ;
    rdfs:comment 'Two-letter US state or equivalent sub-national code representing the bettor\'s verified physical location at session start. Used for state-level regulatory reporting and jurisdiction-specific wagering rule enforcement.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inactivitySeconds rdf:type rdf:Property ;
    rdfs:label 'Inactivity Seconds' ;
    rdfs:comment 'Total cumulative seconds of inactivity (no user interaction) recorded during the gaming session. Used to distinguish active engagement time from idle time for responsible gaming session time monitoring and timeout policy enforcement.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:liveInplayWagerCount rdf:type rdf:Property ;
    rdfs:label 'Live Inplay Wager Count' ;
    rdfs:comment 'Number of live in-play (in-game) wagers placed during this session. Supports in-play product engagement reporting, responsible gaming monitoring for high-velocity in-play betting, and AML behavioral analysis.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:loginMethod rdf:type rdf:Property ;
    rdfs:label 'Login Method' ;
    rdfs:comment 'Authentication method used by the bettor to initiate this gaming session. Supports security audit, fraud detection, and compliance with identity verification requirements under gaming regulations.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netSessionResultAmount rdf:type rdf:Property ;
    rdfs:label 'Net Session Result Amount' ;
    rdfs:comment 'Net financial outcome of the gaming session from the bettor\'s perspective (total_payout_amount minus total_wagered_amount). A negative value indicates a net loss; positive indicates a net win. Stored as a raw business field to support responsible gaming loss monitoring and regulatory reporting without requiring recalculation.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatorCode rdf:type rdf:Property ;
    rdfs:label 'Operator Code' ;
    rdfs:comment 'Reference to the licensed gaming operator entity under whose license this session was conducted. Required for multi-operator platform environments and regulatory reporting by operator license.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rgInterventionType rdf:type rdf:Property ;
    rdfs:label 'Rg Intervention Type' ;
    rdfs:comment 'Type of responsible gaming intervention displayed or triggered during this session. Supports RG program effectiveness measurement, regulatory audit, and player harm minimization reporting. Null or \'none\' if no intervention occurred.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selfExclusionTriggered rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion Triggered' ;
    rdfs:comment 'Indicates whether this session resulted in a self-exclusion event being triggered for the bettor account. Distinct from responsible_gaming_flag to enable precise regulatory reporting on self-exclusion program activations.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sessionDate rdf:type rdf:Property ;
    rdfs:label 'Session Date' ;
    rdfs:comment 'Calendar date on which the gaming session started (derived from start_timestamp, stored as a DATE partition key). Supports efficient date-range queries for regulatory reporting, responsible gaming daily monitoring, and platform engagement analytics.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sessionStatus rdf:type rdf:Property ;
    rdfs:label 'Session Status' ;
    rdfs:comment 'Current lifecycle state of the gaming session. Drives responsible gaming workflows, session time monitoring alerts, and AML behavioral analysis. [ENUM-REF-CANDIDATE: active|completed|terminated|timed_out|suspended|self_excluded — promote to reference product if additional states are required]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionType rdf:type rdf:Property ;
    rdfs:label 'Session Type' ;
    rdfs:comment 'Classification of the gaming session by product type: sportsbook (fixed-odds wagering), DFS (Daily Fantasy Sports), casino (if applicable), or mixed. Supports product-line segmentation, regulatory reporting by license type, and responsible gaming controls specific to each product.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportFocusCode rdf:type rdf:Property ;
    rdfs:label 'Sport Focus Code' ;
    rdfs:comment 'Sport code representing the primary sport wagered on during this session (e.g., NFL, NBA, MLB, NHL, MLS, UFC, FIFA). Derived from the plurality of wagers placed; supports sport-level engagement analytics and product mix reporting.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPayoutAmount rdf:type rdf:Property ;
    rdfs:label 'Total Payout Amount' ;
    rdfs:comment 'Gross sum of all winning payouts returned to the bettor during this gaming session, in the account\'s base currency. Used in conjunction with total_wagered_amount to compute net session result for responsible gaming and financial reporting.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalWageredAmount rdf:type rdf:Property ;
    rdfs:label 'Total Wagered Amount' ;
    rdfs:comment 'Gross sum of all stake amounts placed across all wagers during this gaming session, in the account\'s base currency. Used for AML threshold monitoring, responsible gaming loss limit tracking, and session-level revenue reporting.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:w2gThresholdTriggered rdf:type rdf:Property ;
    rdfs:label 'W2g Threshold Triggered' ;
    rdfs:comment 'Indicates whether the session\'s winnings met or exceeded the IRS W-2G reportable threshold for gambling winnings. Triggers downstream tax withholding and reporting workflows in compliance with US federal tax regulations.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wagerCount rdf:type rdf:Property ;
    rdfs:label 'Wager Count' ;
    rdfs:comment 'Total number of individual wagers placed by the bettor during this gaming session. Used for responsible gaming velocity monitoring, AML transaction pattern analysis, and platform engagement reporting.' ;
    rdfs:domain ind:Session ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:walletId rdf:type rdf:Property ;
    rdfs:label 'Wallet Id' ;
    rdfs:comment 'Unique surrogate identifier for the gaming wallet ledger record. Primary key for this entity.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Wallet .

ind:amlRiskRating rdf:type rdf:Property ;
    rdfs:label 'Aml Risk Rating' ;
    rdfs:comment 'Anti-Money Laundering (AML) risk classification assigned to this wallet based on transaction patterns, deposit sources, and bettor profile. Drives enhanced due diligence (EDD) requirements and regulatory reporting thresholds.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bonusCreditBalance rdf:type rdf:Property ;
    rdfs:label 'Bonus Credit Balance' ;
    rdfs:comment 'Current balance of promotional bonus credits awarded to the bettor (e.g., free-bet credits, deposit match bonuses, loyalty rewards). Bonus credits are subject to wagering requirements before conversion to withdrawable funds.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusWageringProgressAmount rdf:type rdf:Property ;
    rdfs:label 'Bonus Wagering Progress Amount' ;
    rdfs:comment 'Cumulative wagering amount applied toward satisfying the current bonus wagering requirement. When this value reaches (bonus_credit_balance × bonus_wagering_requirement_multiplier), the bonus converts to withdrawable funds.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusWageringRequirementMultiplier rdf:type rdf:Property ;
    rdfs:label 'Bonus Wagering Requirement Multiplier' ;
    rdfs:comment 'The rollover multiplier applied to bonus credits before they can be converted to withdrawable real-money funds (e.g., 5x means the bettor must wager 5 times the bonus amount). Drives bonus liability calculations.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dormancyDate rdf:type rdf:Property ;
    rdfs:label 'Dormancy Date' ;
    rdfs:comment 'Date on which the wallet was classified as dormant. Used to calculate escheatment timelines and trigger unclaimed property reporting to state authorities.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dormancyFlag rdf:type rdf:Property ;
    rdfs:label 'Dormancy Flag' ;
    rdfs:comment 'Indicates whether the wallet has been classified as dormant due to inactivity beyond the operator-defined dormancy threshold (typically 12 months with no transactions). Dormant wallets may be subject to inactivity fees or unclaimed property escheatment.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geolocationComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Geolocation Compliance Flag' ;
    rdfs:comment 'Indicates whether the bettor\'s most recent session passed geolocation verification confirming they were physically located within a licensed jurisdiction at the time of wagering. True = compliant; False = geolocation check failed or bypassed.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Kyc Verified Flag' ;
    rdfs:comment 'Indicates whether the bettor\'s identity has been fully verified through the Know Your Customer (KYC) process. True = verified; False = pending or failed. Unverified wallets may have restricted deposit and withdrawal capabilities.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastDepositTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Deposit Timestamp' ;
    rdfs:comment 'Timestamp of the most recent real-money deposit credited to this wallet. Used for dormancy analysis, responsible gaming velocity checks, and AML monitoring.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastTransactionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Transaction Timestamp' ;
    rdfs:comment 'Timestamp of the most recent financial transaction (deposit, withdrawal, wager placement, wager settlement, bonus credit) recorded against this wallet. Used for dormancy detection and responsible gaming monitoring.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastWithdrawalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Withdrawal Timestamp' ;
    rdfs:comment 'Timestamp of the most recent withdrawal processed from this wallet. Used for dormancy analysis and AML monitoring.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lifetimeBonusAwardedAmount rdf:type rdf:Property ;
    rdfs:label 'Lifetime Bonus Awarded Amount' ;
    rdfs:comment 'Cumulative total of all promotional bonus credits ever awarded to this wallet. Used for marketing ROI analysis, bonus liability reporting, and responsible gaming assessments.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lifetimeDepositAmount rdf:type rdf:Property ;
    rdfs:label 'Lifetime Deposit Amount' ;
    rdfs:comment 'Cumulative total of all real-money deposits made into this wallet since account creation. Used for responsible gaming monitoring, AML thresholds, and regulatory reporting.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lifetimeWithdrawalAmount rdf:type rdf:Property ;
    rdfs:label 'Lifetime Withdrawal Amount' ;
    rdfs:comment 'Cumulative total of all real-money withdrawals processed from this wallet since account creation. Used for AML monitoring, tax reporting (e.g., IRS Form W-2G), and responsible gaming analytics.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatorFreezeReason rdf:type rdf:Property ;
    rdfs:label 'Operator Freeze Reason' ;
    rdfs:comment 'Reason code for an operator-initiated wallet freeze or suspension. Required for audit trail and regulatory reporting when wallet_status is \'frozen\' or \'suspended\'. [ENUM-REF-CANDIDATE: aml_investigation|fraud_review|regulatory_order|chargeback_dispute|responsible_gaming|other — promote to reference product]' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pendingHoldAmount rdf:type rdf:Property ;
    rdfs:label 'Pending Hold Amount' ;
    rdfs:comment 'Total amount currently reserved (held) against the real-money balance for open/unsettled wagers. Funds are released back to real_money_balance upon wager settlement or cancellation.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredOddsFormat rdf:type rdf:Property ;
    rdfs:label 'Preferred Odds Format' ;
    rdfs:comment 'Bettor\'s preferred display format for betting odds on this wallet\'s associated platform. Stored at wallet level to support personalized UX across jurisdictions.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:realMoneyBalance rdf:type rdf:Property ;
    rdfs:label 'Real Money Balance' ;
    rdfs:comment 'Current spendable real-money balance in the wallet denominated in currency_code. Represents deposited funds net of withdrawals, settled wager losses, and fees. Excludes bonus credits and pending holds.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reservedWithdrawalAmount rdf:type rdf:Property ;
    rdfs:label 'Reserved Withdrawal Amount' ;
    rdfs:comment 'Amount currently reserved for a pending withdrawal request that has been initiated but not yet processed or cleared by the payment processor. Reduces available withdrawable_balance.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:selfExclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion Flag' ;
    rdfs:comment 'Indicates whether the bettor has voluntarily enrolled in a self-exclusion program, prohibiting all wagering activity on this wallet. True = self-excluded; False = not self-excluded. Triggers immediate wallet suspension.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sessionTimeLimitMinutes rdf:type rdf:Property ;
    rdfs:label 'Session Time Limit Minutes' ;
    rdfs:comment 'Maximum continuous gaming session duration in minutes before the bettor is prompted to take a break or is automatically logged out. Responsible gaming control set by bettor or operator.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taxWithholdingFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Withholding Flag' ;
    rdfs:comment 'Indicates whether federal or state tax withholding is currently applied to winnings paid out from this wallet (e.g., IRS backup withholding for bettors who have not provided a valid TIN). True = withholding active.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:walletStatus rdf:type rdf:Property ;
    rdfs:label 'Wallet Status' ;
    rdfs:comment 'Current operational lifecycle state of the gaming wallet. \'active\' = fully operational; \'suspended\' = temporarily restricted by operator or regulator; \'frozen\' = locked pending investigation or AML review; \'closed\' = permanently deactivated; \'pending_verification\' = KYC/AML checks incomplete.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:walletType rdf:type rdf:Property ;
    rdfs:label 'Wallet Type' ;
    rdfs:comment 'Classification of the wallet by gaming product line. Determines which bet types, markets, and regulatory rules apply. [ENUM-REF-CANDIDATE: sports_wagering|fantasy_sports|casino|poker|combined — promote to reference product if additional types emerge]' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withdrawableBalance rdf:type rdf:Property ;
    rdfs:label 'Withdrawable Balance' ;
    rdfs:comment 'Portion of the real-money balance that has met all wagering requirements and regulatory hold periods and is eligible for withdrawal to the bettor\'s registered payment method. May be less than or equal to real_money_balance.' ;
    rdfs:domain ind:Wallet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:integrityAlertId rdf:type rdf:Property ;
    rdfs:label 'Integrity Alert Id' ;
    rdfs:comment 'Unique system-generated identifier for each sports integrity alert record within the gaming domain. Primary key for the integrity_alert data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IntegrityAlert .

ind:assignedInvestigatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned Investigator Employee Id' ;
    rdfs:comment 'Reference to the internal staff member or investigator assigned to review and investigate this integrity alert. Supports workload management and accountability tracking within the integrity program.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:evidenceAssetId rdf:type rdf:Property ;
    rdfs:label 'Evidence Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: Integrity investigation workflow: investigators review broadcast VOD/highlight clips as evidence when analyzing suspicious betting patterns. Role prefix \'evidence_\' distinguishes this from a general a' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:safetyIncidentId rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Id' ;
    rdfs:comment 'Foreign key linking to venue.safety_incident. Business justification: Sports integrity investigations correlate unusual betting patterns with venue safety incidents (crowd disturbances, power outages, field invasions). Integrity teams and regulators require this link to' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SafetyIncident .

ind:alertCategory rdf:type rdf:Property ;
    rdfs:label 'Alert Category' ;
    rdfs:comment 'Broad category grouping for the integrity alert, used for routing, reporting, and regulatory classification. Distinguishes between market-level anomalies, account-level suspicious behavior, event-level manipulation indicators, and compliance-driven flags.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Alert Reference Number' ;
    rdfs:comment 'Human-readable external reference code for the integrity alert, used in regulatory correspondence, governing body notifications, and investigator communications. Format: IA-YYYY-NNNNNN.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertSource rdf:type rdf:Property ;
    rdfs:label 'Alert Source' ;
    rdfs:comment 'Origin of the integrity alert indicating how it was generated. Distinguishes between system-automated detection, manual flagging by trading staff, external notifications from governing bodies (e.g., FIFA, IOC), third-party integrity feeds, or bettor-submitted reports.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertStatus rdf:type rdf:Property ;
    rdfs:label 'Alert Status' ;
    rdfs:comment 'Current workflow status of the integrity alert through the investigation lifecycle. Tracks progression from initial detection through investigation, escalation, resolution, or referral to a governing body.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertType rdf:type rdf:Property ;
    rdfs:label 'Alert Type' ;
    rdfs:comment 'Classification of the integrity alert by the nature of the suspicious activity detected. [ENUM-REF-CANDIDATE: line_movement|volume_spike|correlated_accounts|match_fixing_indicator|insider_betting|late_money|layoff_pattern — promote to reference product]' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correlatedAccountCount rdf:type rdf:Property ;
    rdfs:label 'Correlated Account Count' ;
    rdfs:comment 'Number of bettor accounts identified as correlated or linked in the suspicious activity pattern associated with this alert. A count greater than one indicates potential syndicate or coordinated betting activity.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:detectionRuleCode rdf:type rdf:Property ;
    rdfs:label 'Detection Rule Code' ;
    rdfs:comment 'Identifier of the specific automated rule or algorithm within the integrity monitoring rules engine that triggered this alert. Used for rules performance analysis, false positive tracking, and model tuning.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionRuleDescription rdf:type rdf:Property ;
    rdfs:label 'Detection Rule Description' ;
    rdfs:comment 'Human-readable description of the detection rule or algorithm that generated this alert, providing context for investigators on the logic that identified the suspicious activity.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventPeriod rdf:type rdf:Property ;
    rdfs:label 'Event Period' ;
    rdfs:comment 'Specific period or segment of the sporting event during which the suspicious activity was detected (e.g., Q1, H1, 1st_inning, 3rd_set). Supports granular integrity analysis and VAR/TMO review correlation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:falsePositiveReason rdf:type rdf:Property ;
    rdfs:label 'False Positive Reason' ;
    rdfs:comment 'Explanation of why this alert was determined to be a false positive during investigation. Populated when resolution_outcome is \'false_positive\'. Used for rules engine tuning and model improvement.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingBodyReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Governing Body Referral Flag' ;
    rdfs:comment 'Indicates whether this integrity alert has been formally referred to a sports governing body (e.g., FIFA, IOC, NFL, NBA, WADA) for further investigation or disciplinary action. True = referred; False = not referred.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:governingBodyReferralTimestamp rdf:type rdf:Property ;
    rdfs:label 'Governing Body Referral Timestamp' ;
    rdfs:comment 'Date and time when the integrity alert was formally submitted to the relevant sports governing body. Required for regulatory audit trails and compliance reporting.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:investigationNotes rdf:type rdf:Property ;
    rdfs:label 'Investigation Notes' ;
    rdfs:comment 'Free-text field capturing investigator observations, findings, and analysis notes during the review of this integrity alert. Classified as confidential due to sensitive investigative content.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isInPlay rdf:type rdf:Property ;
    rdfs:label 'Is In Play' ;
    rdfs:comment 'Indicates whether the suspicious wagering activity that triggered this alert occurred during live in-play betting on the event. True = in-play activity; False = pre-match activity. In-play alerts carry heightened integrity risk.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketSuspensionFlag rdf:type rdf:Property ;
    rdfs:label 'Market Suspension Flag' ;
    rdfs:comment 'Indicates whether the associated betting market was suspended as a result of this integrity alert. True = market suspended; False = market remained open. Supports post-incident market operations review.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketSuspensionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Market Suspension Timestamp' ;
    rdfs:comment 'Date and time when the associated betting market was suspended in response to this integrity alert. Populated only when market_suspension_flag is True.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:priorityScore rdf:type rdf:Property ;
    rdfs:label 'Priority Score' ;
    rdfs:comment 'Numeric score assigned by the integrity monitoring system to prioritize alert investigation workload. Derived from severity, volume, and pattern factors at detection time. Higher scores indicate greater urgency.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Flag' ;
    rdfs:comment 'Indicates whether this integrity alert has been included in a formal regulatory suspicious activity report (SAR) submitted to applicable gaming regulatory authorities. True = included in SAR; False = not reported.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resolutionOutcome rdf:type rdf:Property ;
    rdfs:label 'Resolution Outcome' ;
    rdfs:comment 'Final determination of the integrity alert investigation. Indicates whether the alert was a false positive, confirmed suspicious activity, inconclusive, or resulted in escalation to a governing body or law enforcement. [ENUM-REF-CANDIDATE: false_positive|confirmed_suspicious|inconclusive|referred_to_governing_body|law_enforcement_referral|no_action — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severity rdf:type rdf:Property ;
    rdfs:label 'Severity' ;
    rdfs:comment 'Severity level assigned to the integrity alert indicating urgency and potential impact on sports integrity. Critical alerts require immediate escalation to governing bodies; high alerts require same-day investigator assignment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyAlertReference rdf:type rdf:Property ;
    rdfs:label 'Third Party Alert Reference' ;
    rdfs:comment 'External reference identifier provided by a third-party integrity monitoring service or governing body notification system (e.g., ESSA — European Sports Security Association, IBIA — International Betting Integrity Association). Enables cross-system alert correlation.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeringOddsMovementPct rdf:type rdf:Property ;
    rdfs:label 'Triggering Odds Movement Pct' ;
    rdfs:comment 'The percentage change in odds that triggered or contributed to this integrity alert. Captures the magnitude of line movement that was deemed anomalous by the monitoring system. Expressed as a decimal percentage (e.g., 15.50 = 15.50% movement).' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:triggeringVolumeAmount rdf:type rdf:Property ;
    rdfs:label 'Triggering Volume Amount' ;
    rdfs:comment 'The total monetary value of wagering volume that triggered or contributed to this integrity alert. Represents the abnormal betting volume threshold breach that flagged the alert.' ;
    rdfs:domain ind:IntegrityAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:kycVerificationId rdf:type rdf:Property ;
    rdfs:label 'Kyc Verification Id' ;
    rdfs:comment 'Unique surrogate identifier for each KYC verification record in the gaming domain. Primary key for the kyc_verification data product.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:verifyingAgentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Verifying Agent Employee Id' ;
    rdfs:comment 'Identifier of the compliance agent or system user who performed or approved the manual review of this KYC verification. Populated when verification_method is manual_review or when a human escalation decision is made. Supports audit trail and accountability requirements.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accountRestrictionApplied rdf:type rdf:Property ;
    rdfs:label 'Account Restriction Applied' ;
    rdfs:comment 'Indicates whether a restriction was applied to the bettor account as a direct result of this KYC verification outcome (e.g., deposit limits, withdrawal holds, account suspension). Used to track the operational impact of KYC decisions on account functionality.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amlScreeningStatus rdf:type rdf:Property ;
    rdfs:label 'Aml Screening Status' ;
    rdfs:comment 'Result of the AML sanctions and watchlist screening performed as part of this KYC verification. Checks against OFAC SDN list, PEP (Politically Exposed Persons) databases, and adverse media. Mandatory for gaming license compliance.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biometricMatchScore rdf:type rdf:Property ;
    rdfs:label 'Biometric Match Score' ;
    rdfs:comment 'Numeric confidence score (0.0000 to 1.0000) returned by the biometric verification system indicating the degree of match between the bettor\'s live selfie/liveness check and the submitted identity document photo. Populated when verification_method is biometric. Classified as restricted biometric PII.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bureauProviderCode rdf:type rdf:Property ;
    rdfs:label 'Bureau Provider Code' ;
    rdfs:comment 'Code identifying the third-party identity verification bureau or data provider used for this verification (e.g., Jumio, Onfido, LexisNexis). Populated when verification_method is bureau_check or biometric. Used for vendor performance tracking and regulatory audit.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bureauResponseCode rdf:type rdf:Property ;
    rdfs:label 'Bureau Response Code' ;
    rdfs:comment 'The result or decision code returned by the third-party identity bureau following their verification check (e.g., CLEAR, CONSIDER, CAUTION, FAIL). Used to drive automated approval/rejection workflows and compliance reporting.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bureauTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Bureau Transaction Reference' ;
    rdfs:comment 'The unique transaction or case reference number returned by the third-party identity bureau (e.g., Jumio scan reference, Onfido check ID). Used for reconciliation, dispute resolution, and regulatory audit trail with the external provider.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentAuthenticityScore rdf:type rdf:Property ;
    rdfs:label 'Document Authenticity Score' ;
    rdfs:comment 'Numeric confidence score (0.0000 to 1.0000) from the document verification system indicating the likelihood that the submitted document is genuine and unaltered. Derived from security feature checks, font analysis, and tamper detection by the bureau provider.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:documentExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Document Expiry Date' ;
    rdfs:comment 'The expiration date of the submitted identity document in yyyy-MM-dd format. Used to determine document validity at the time of verification and to flag expired documents that require re-submission.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentIssuingCountry rdf:type rdf:Property ;
    rdfs:label 'Document Issuing Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the authority that issued the submitted identity document. Used for jurisdiction-specific compliance checks and sanctions screening.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Document Reference Number' ;
    rdfs:comment 'The official document number from the submitted identity document (e.g., passport number, national ID number, driver\'s license number). Classified as restricted PII as it directly identifies the individual and is subject to GDPR, CCPA, and gaming regulatory data protection requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isInitialVerification rdf:type rdf:Property ;
    rdfs:label 'Is Initial Verification' ;
    rdfs:comment 'Indicates whether this is the first KYC verification performed for the bettor account (True) or a subsequent periodic re-verification or triggered re-check (False). Used to distinguish onboarding KYC from ongoing monitoring verifications in regulatory reporting.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:livenessCheckPassed rdf:type rdf:Property ;
    rdfs:label 'Liveness Check Passed' ;
    rdfs:comment 'Indicates whether the bettor passed the biometric liveness detection test, confirming the verification was performed by a live person and not a spoofing attempt (e.g., photo replay, deepfake). Populated when verification_method is biometric.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pepFlag rdf:type rdf:Property ;
    rdfs:label 'Pep Flag' ;
    rdfs:comment 'Indicates whether the bettor has been identified as a Politically Exposed Person (PEP) during KYC screening. PEP status triggers enhanced due diligence requirements under FATF guidelines and most gaming regulatory frameworks.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rejectionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Description' ;
    rdfs:comment 'Free-text narrative description of why the KYC verification was rejected or escalated. Complements the rejection_reason_code with additional context for compliance agents and regulatory reporting.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reverificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Reverification Due Date' ;
    rdfs:comment 'The date by which the bettor must complete a new KYC verification cycle. Triggered by document expiry, regulatory periodic review requirements, risk-based re-screening schedules, or changes in bettor risk profile. Null if no re-verification is currently scheduled.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sanctionsHitFlag rdf:type rdf:Property ;
    rdfs:label 'Sanctions Hit Flag' ;
    rdfs:comment 'Indicates whether the bettor matched any entry on a sanctions list (e.g., OFAC SDN, EU Consolidated List, UN Sanctions) during KYC screening. A confirmed sanctions hit requires immediate account restriction and regulatory notification.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verificationAttemptNumber rdf:type rdf:Property ;
    rdfs:label 'Verification Attempt Number' ;
    rdfs:comment 'Sequential count of how many times the bettor has attempted KYC verification for this verification type on their account. Used to enforce maximum attempt limits, detect fraud patterns, and trigger escalation workflows after repeated failures.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:verificationReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Verification Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned to this KYC verification case, used for correspondence with regulators, third-party bureaus (e.g., Jumio, Onfido), and internal audit trails.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationType rdf:type rdf:Property ;
    rdfs:label 'Verification Type' ;
    rdfs:comment 'Category of KYC check being performed. Determines the regulatory obligation being fulfilled: identity confirms who the bettor is, age confirms legal gambling eligibility, address confirms residency, source_of_funds confirms AML compliance, enhanced_due_diligence applies to high-risk or high-value accounts.' ;
    rdfs:domain ind:KycVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketSuspensionId rdf:type rdf:Property ;
    rdfs:label 'Market Suspension Id' ;
    rdfs:comment 'Unique system-generated identifier for each betting market suspension event record. Primary key for the market_suspension data product.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:oddsFeedId rdf:type rdf:Property ;
    rdfs:label 'Odds Feed Id' ;
    rdfs:comment 'Reference to the odds feed record active at the time of suspension. Enables correlation between odds feed anomalies and suspension events for line integrity analysis.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OddsFeed .

ind:primaryMarketEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Market Employee Id' ;
    rdfs:comment 'Identifier of the trader or operations staff member who manually triggered the suspension. Null when suspended_by_type is \'automated_risk_engine\' or \'system_failsafe\'. Supports accountability and audit trail requirements.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:reinstatedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Reinstated By User Employee Id' ;
    rdfs:comment 'Identifier of the trader or operations staff member who manually reinstated the market. Null when reinstated by automated system or when market has not been reinstated.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:integrityAlertFlag rdf:type rdf:Property ;
    rdfs:label 'Integrity Alert Flag' ;
    rdfs:comment 'Indicates whether this suspension was associated with a betting integrity alert, such as suspicious wagering patterns, unusual line movement, or a referral from a sports integrity body. Supports integrity monitoring workflows.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineMovementTrigger rdf:type rdf:Property ;
    rdfs:label 'Line Movement Trigger' ;
    rdfs:comment 'Indicates whether an abnormal or rapid line movement in the odds feed was a contributing trigger for this suspension. Supports line integrity monitoring and trading desk review.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postReinstatementOdds rdf:type rdf:Property ;
    rdfs:label 'Post Reinstatement Odds' ;
    rdfs:comment 'The decimal odds value of the primary selection in the market immediately after reinstatement. Null if the market has not been reinstated. Used to measure odds adjustment resulting from the suspension.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preSuspensionOdds rdf:type rdf:Property ;
    rdfs:label 'Pre Suspension Odds' ;
    rdfs:comment 'The decimal odds value of the primary selection in the market immediately prior to suspension. Captured for audit trail and post-suspension odds comparison analysis.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryAuthorityCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority Code' ;
    rdfs:comment 'Code identifying the regulatory authority that mandated the suspension when regulatory_hold_flag is true (e.g., state gaming commission code, federal body identifier). Null for non-regulatory suspensions.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryHoldFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Hold Flag' ;
    rdfs:comment 'Indicates whether the suspension was mandated by a regulatory authority (e.g., state gaming commission, federal regulator). When true, reinstatement requires explicit regulatory clearance.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReportTimestamp rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Timestamp' ;
    rdfs:comment 'Date and time at which the regulatory report for this suspension was submitted to the relevant authority. Null if regulatory_report_submitted is false.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reinstatedByType rdf:type rdf:Property ;
    rdfs:label 'Reinstated By Type' ;
    rdfs:comment 'Indicates whether the market reinstatement was performed by an automated system or a human actor. Null if the market has not been reinstated.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Timestamp' ;
    rdfs:comment 'The precise date and time at which the suspended betting market was reinstated and reopened for wagering. Null if the market has not yet been reinstated.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:riskEngineRuleCode rdf:type rdf:Property ;
    rdfs:label 'Risk Engine Rule Code' ;
    rdfs:comment 'Identifier of the automated risk engine rule that triggered the suspension when suspended_by_type is \'automated_risk_engine\'. Null for manual suspensions. Enables analysis of which risk rules are most frequently triggered.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:suspendedByType rdf:type rdf:Property ;
    rdfs:label 'Suspended By Type' ;
    rdfs:comment 'Indicates whether the suspension was triggered by an automated risk engine or by a human actor (manual trader, regulatory authority, or integrity officer). Critical for audit trails and operational accountability.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspensionDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Suspension Duration Seconds' ;
    rdfs:comment 'Total elapsed time in seconds between the suspension_timestamp and reinstatement_timestamp. Null if the market has not yet been reinstated. Used for trading desk KPI reporting and SLA monitoring.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:suspensionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Suspension Reason Code' ;
    rdfs:comment 'Standardized code categorizing the primary reason the betting market was suspended. [ENUM-REF-CANDIDATE: injury_news|line_integrity|late_team_news|regulatory_hold|technical_issue|suspicious_activity|weather_event — promote to reference product]' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspensionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Suspension Reason Description' ;
    rdfs:comment 'Free-text narrative providing detailed context for the suspension, supplementing the standardized suspension_reason_code. Used by trading desk and integrity teams for audit documentation.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspensionReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Suspension Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to this suspension event, used by trading desk operations and regulatory audit trails for cross-system traceability.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspensionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Suspension Timestamp' ;
    rdfs:comment 'The precise date and time (with timezone offset) at which the betting market was suspended. This is the principal business event timestamp for this transaction record.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:technicalIssueCode rdf:type rdf:Property ;
    rdfs:label 'Technical Issue Code' ;
    rdfs:comment 'Standardized code identifying the specific technical issue that caused the suspension when suspension_reason_code is \'technical_issue\'. \'none\' when the suspension is non-technical in nature.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidedWagerCount rdf:type rdf:Property ;
    rdfs:label 'Voided Wager Count' ;
    rdfs:comment 'Total number of individual wagers voided as a result of this suspension event. Zero if wager_void_triggered is false. Supports financial reconciliation and regulatory reporting.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:voidedWagerLiabilityAmount rdf:type rdf:Property ;
    rdfs:label 'Voided Wager Liability Amount' ;
    rdfs:comment 'Total monetary liability amount (in the market\'s operating currency) of all wagers voided as a result of this suspension. Zero if no wagers were voided. Used for financial reconciliation and P&L impact assessment.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wagerVoidTriggered rdf:type rdf:Property ;
    rdfs:label 'Wager Void Triggered' ;
    rdfs:comment 'Indicates whether the suspension event triggered automatic voiding of associated open wagers. True when wager void actions were executed as part of this suspension.' ;
    rdfs:domain ind:MarketSuspension ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerId rdf:type rdf:Property ;
    rdfs:label 'Provider Id' ;
    rdfs:comment 'Reference to the third-party odds compiler or data provider (e.g., Sportradar, Kambi) that supplied this odds update.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OddsProvider .

ind:selectionId rdf:type rdf:Property ;
    rdfs:label 'Selection Id' ;
    rdfs:comment 'Reference to the specific selection (outcome) within the betting market for which odds are being updated (e.g., Team A to win, Over 2.5 goals).' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Selection .

ind:americanOdds rdf:type rdf:Property ;
    rdfs:label 'American Odds' ;
    rdfs:comment 'The odds expressed in American moneyline format. Positive values (e.g., +150) indicate profit on a $100 stake; negative values (e.g., -200) indicate the stake required to win $100. Standard format for US sports wagering markets.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:decimalOdds rdf:type rdf:Property ;
    rdfs:label 'Decimal Odds' ;
    rdfs:comment 'The odds expressed in decimal format (European format), representing the total payout per unit staked including the stake (e.g., 2.500000 means a $1 bet returns $2.50). Widely used in European and international markets.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feedChannel rdf:type rdf:Property ;
    rdfs:label 'Feed Channel' ;
    rdfs:comment 'The technical delivery channel through which this odds update was received from the provider. Supports feed reliability monitoring and SLA compliance tracking.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedLatencyMs rdf:type rdf:Property ;
    rdfs:label 'Feed Latency Ms' ;
    rdfs:comment 'The measured latency in milliseconds between the provider_published_timestamp and the received_timestamp for this odds update. Used for SLA monitoring, provider performance benchmarking, and real-time display quality assurance.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:feedReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Feed Reference Code' ;
    rdfs:comment 'Externally-known unique identifier assigned by the odds provider for this specific odds update message. Used for deduplication, reconciliation, and audit trail against the provider\'s own records.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedSourceName rdf:type rdf:Property ;
    rdfs:label 'Feed Source Name' ;
    rdfs:comment 'Human-readable name of the odds data provider or compiler that supplied this update (e.g., \'Sportradar\', \'Kambi\', \'Genius Sports\', \'SBTech\'). Used for provider performance monitoring and SLA tracking.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedVersion rdf:type rdf:Property ;
    rdfs:label 'Feed Version' ;
    rdfs:comment 'Version identifier of the odds feed protocol or API specification used by the provider for this update. Supports backward compatibility management and feed migration tracking.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fractionalOddsDenominator rdf:type rdf:Property ;
    rdfs:label 'Fractional Odds Denominator' ;
    rdfs:comment 'The denominator component of fractional odds (UK format), representing the stake unit (e.g., denominator 1 in 3/1 means $1 staked). Combined with numerator to express the full fractional odds.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fractionalOddsNumerator rdf:type rdf:Property ;
    rdfs:label 'Fractional Odds Numerator' ;
    rdfs:comment 'The numerator component of fractional odds (UK format), representing the profit relative to the denominator stake (e.g., numerator 3 in 3/1 means $3 profit per $1 staked). Used in UK and Irish markets.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:handicapValue rdf:type rdf:Property ;
    rdfs:label 'Handicap Value' ;
    rdfs:comment 'The handicap or point spread value associated with this selection, where applicable (e.g., -1.5 goals, +3.5 points). Null for non-handicap markets. Essential for Asian handicap, European handicap, and point spread markets.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impliedProbability rdf:type rdf:Property ;
    rdfs:label 'Implied Probability' ;
    rdfs:comment 'The probability of the selection winning as implied by the current odds, expressed as a decimal between 0 and 1 (e.g., 0.400000 = 40%). Derived from decimal odds as 1/decimal_odds before margin adjustment. Used for overround analysis and pricing analytics.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isResulted rdf:type rdf:Property ;
    rdfs:label 'Is Resulted' ;
    rdfs:comment 'Indicates whether the betting market has been officially resulted/settled (True) or is still open/pending (False). A resulted market has a confirmed outcome and all bets have been settled.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSuspended rdf:type rdf:Property ;
    rdfs:label 'Is Suspended' ;
    rdfs:comment 'Indicates whether the betting market was suspended at the time of this odds update (True = suspended, False = tradeable). Suspension may be triggered by significant events (e.g., red card, injury, VAR review, TMO decision) or risk management actions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineMovementDirection rdf:type rdf:Property ;
    rdfs:label 'Line Movement Direction' ;
    rdfs:comment 'Indicates the direction of the odds movement relative to the previous update for this selection. \'up\' means odds lengthened (selection less favoured); \'down\' means odds shortened (selection more favoured); \'unchanged\' means no movement; \'open\' is the first price; \'close\' is the final price before event start.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketType rdf:type rdf:Property ;
    rdfs:label 'Market Type' ;
    rdfs:comment 'Classification of the betting market type for this odds update (e.g., match_result, over_under, handicap, first_goalscorer, prop_bet, futures, outright). Supports market-level analytics and regulatory reporting segmentation. [ENUM-REF-CANDIDATE: match_result|over_under|handicap|first_goalscorer|prop_bet|futures|outright — promote to reference product]' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overroundPct rdf:type rdf:Property ;
    rdfs:label 'Overround Pct' ;
    rdfs:comment 'The bookmaker\'s margin (vigorish/vig) expressed as a percentage, calculated as the sum of all implied probabilities for a market minus 100%. Represents the theoretical profit margin built into the odds. Used for pricing analytics and margin monitoring.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousDecimalOdds rdf:type rdf:Property ;
    rdfs:label 'Previous Decimal Odds' ;
    rdfs:comment 'The decimal odds value from the immediately preceding odds update for this selection and market. Enables line movement magnitude calculation and trend analysis without requiring a self-join.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceBoostIndicator rdf:type rdf:Property ;
    rdfs:label 'Price Boost Indicator' ;
    rdfs:comment 'Indicates whether the odds for this selection have been artificially enhanced as part of a promotional price boost offer (True) or reflect standard market pricing (False). Price boosts are a common fan engagement and DTC acquisition tool.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerPublishedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Provider Published Timestamp' ;
    rdfs:comment 'The date and time at which the odds provider published or generated this odds update on their end. Used to calculate feed latency (received_timestamp minus provider_published_timestamp) and for regulatory audit trails.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:receivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Received Timestamp' ;
    rdfs:comment 'The precise date and time (with millisecond precision and timezone offset) at which this odds update message was received from the provider feed. Principal business event timestamp for latency measurement and audit.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:regulatoryReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Flag' ;
    rdfs:comment 'Indicates whether this odds feed record must be included in regulatory filings or reports to gaming authorities in the applicable jurisdiction (True). Supports automated regulatory reporting workflows and SOX/CCPA/GDPR compliance.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultOutcome rdf:type rdf:Property ;
    rdfs:label 'Result Outcome' ;
    rdfs:comment 'The official result outcome for this selection once the market has been resulted. \'win\' = selection won; \'lose\' = selection lost; \'void\' = bet voided; \'push\' = stake returned (tie); \'half_win\'/\'half_lose\' = Asian handicap partial outcomes. Null until market is resulted.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceMarketReference rdf:type rdf:Property ;
    rdfs:label 'Source Market Reference' ;
    rdfs:comment 'The provider\'s own internal market identifier or reference code for this betting market, as supplied in the feed message. Enables direct reconciliation with the provider\'s system without requiring a reverse lookup.' ;
    rdfs:domain ind:OddsFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parlayLegId rdf:type rdf:Property ;
    rdfs:label 'Parlay Leg Id' ;
    rdfs:comment 'Unique system-generated identifier for each individual leg (selection) within a parlay or teaser wager. Serves as the primary key for this entity.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parlayWagerId rdf:type rdf:Property ;
    rdfs:label 'Parlay Wager Id' ;
    rdfs:comment 'Reference to the parent parlay or teaser wager header that this leg belongs to. Establishes the header/detail relationship for multi-leg wager settlement processing.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Wager .

ind:correlatedLegFlag rdf:type rdf:Property ;
    rdfs:label 'Correlated Leg Flag' ;
    rdfs:comment 'Indicates whether this leg has been identified as potentially correlated with one or more other legs in the same parlay (e.g., same-game parlay legs where outcomes are statistically dependent). True = correlation detected; False = no correlation. Operators may restrict or reprice correlated parlays per house rules.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eachWayTerms rdf:type rdf:Property ;
    rdfs:label 'Each Way Terms' ;
    rdfs:comment 'The place terms applicable to an each-way leg, expressed as a fraction of the win odds and number of places (e.g., \'1/4 odds, 4 places\'). Null for non-each-way legs. Required for correct place-part settlement calculation.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inPlayFlag rdf:type rdf:Property ;
    rdfs:label 'In Play Flag' ;
    rdfs:comment 'Indicates whether this leg was placed as an in-play (live) wager after the event had already started. True = in-play; False = pre-match. Critical for responsible gaming monitoring, regulatory reporting of live betting activity, and VAR/TMO rule application.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isBankerLeg rdf:type rdf:Property ;
    rdfs:label 'Is Banker Leg' ;
    rdfs:comment 'Indicates whether this leg has been designated as a \'banker\' — a selection the bettor is highly confident in, which is included in all combinations of a system/accumulator bet. True = banker leg; False = standard leg. Used in system bet combination generation and display.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEachWay rdf:type rdf:Property ;
    rdfs:label 'Is Each Way' ;
    rdfs:comment 'Indicates whether this leg is placed each-way (win and place components). Applicable primarily to horse racing and golf markets. True = each-way; False = win-only. Affects settlement calculation and payout structure for the leg.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legOddsContribution rdf:type rdf:Property ;
    rdfs:label 'Leg Odds Contribution' ;
    rdfs:comment 'The decimal multiplier this leg contributes to the overall combined parlay odds. Calculated as the decimal odds for this leg and stored at placement time. The product of all leg contributions equals the parlay\'s total combined odds. Required for settlement verification and regulatory audit.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:legSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Leg Sequence Number' ;
    rdfs:comment 'Ordinal position of this leg within the parent parlay wager (e.g., 1 = first leg, 2 = second leg). Used for display ordering, settlement sequencing, and regulatory reporting of multi-leg wager structures.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:legStatus rdf:type rdf:Property ;
    rdfs:label 'Leg Status' ;
    rdfs:comment 'Current settlement status of this individual leg. Pending = awaiting event result; Won = selection correct; Lost = selection incorrect; Void = market cancelled/invalid (leg removed from parlay, odds recalculated); Pushed = tie/no-action result; Suspended = market temporarily halted. Drives parlay-level settlement logic.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legType rdf:type rdf:Property ;
    rdfs:label 'Leg Type' ;
    rdfs:comment 'Classification of the leg within the parlay structure. Standard legs carry full odds; teaser legs apply a point-spread adjustment; pleaser legs move the line against the bettor for higher odds; if-bet and reverse legs are conditional. [ENUM-REF-CANDIDATE: standard|teaser|pleaser|if_bet|reverse|round_robin — promote to reference product]' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxPayoutCap rdf:type rdf:Property ;
    rdfs:label 'Max Payout Cap' ;
    rdfs:comment 'The maximum payout amount applicable to this leg as defined by house rules or jurisdiction limits at the time of placement. Null if no cap applies. Used in settlement to enforce payout limits and for regulatory reporting of capped payouts.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oddsAtPlacement rdf:type rdf:Property ;
    rdfs:label 'Odds At Placement' ;
    rdfs:comment 'The American-format moneyline odds for this leg at the exact moment the wager was placed (e.g., -110, +250). Locked at placement time and used for parlay combined-odds calculation, settlement, and regulatory reporting. Immutable after placement.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oddsDecimal rdf:type rdf:Property ;
    rdfs:label 'Odds Decimal' ;
    rdfs:comment 'Decimal (European) representation of the odds for this leg at placement time (e.g., 1.9091 for -110 American). Stored alongside American odds to support international regulatory reporting and multi-jurisdiction compliance without runtime conversion.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oddsFeedProvider rdf:type rdf:Property ;
    rdfs:label 'Odds Feed Provider' ;
    rdfs:comment 'Name or code of the third-party odds data provider that supplied the odds for this leg at placement time (e.g., \'Sportradar\', \'Genius Sports\', \'IMG Arena\'). Required for data lineage, SLA monitoring, and dispute resolution with odds suppliers.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oddsFeedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Odds Feed Timestamp' ;
    rdfs:comment 'Timestamp of the odds feed snapshot from which the odds for this leg were sourced. Used for latency analysis, odds integrity audits, and regulatory compliance verification that odds were current at time of acceptance.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:oddsFractional rdf:type rdf:Property ;
    rdfs:label 'Odds Fractional' ;
    rdfs:comment 'Fractional (UK) representation of the odds for this leg at placement time (e.g., \'10/11\'). Stored for UK/Irish regulatory reporting and display on international-facing platforms. Null for jurisdictions where fractional odds are not required.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorLegRef rdf:type rdf:Property ;
    rdfs:label 'Operator Leg Ref' ;
    rdfs:comment 'External-facing reference number assigned by the sportsbook operator platform to this specific leg. Used for customer-facing ticket display, customer service lookups, and cross-system reconciliation with the operator\'s betting platform.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultScoreOrValue rdf:type rdf:Property ;
    rdfs:label 'Result Score Or Value' ;
    rdfs:comment 'The actual result value used to settle this leg (e.g., final score \'27-24\', total points \'51\', player stat \'312 passing yards\'). Stored as a string to accommodate diverse market types. Provides the evidentiary basis for settlement and supports dispute resolution.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rgFlagReason rdf:type rdf:Property ;
    rdfs:label 'Rg Flag Reason' ;
    rdfs:comment 'Description of the responsible gaming rule or pattern that triggered the responsible_gaming_flag for this leg (e.g., \'high_complexity_parlay\', \'rapid_live_leg_addition\', \'loss_chasing_pattern\'). Null when responsible_gaming_flag is False. Used for compliance reporting and intervention workflows.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sameGameParlayFlag rdf:type rdf:Property ;
    rdfs:label 'Same Game Parlay Flag' ;
    rdfs:comment 'Indicates whether this leg is part of a Same-Game Parlay (SGP) — a parlay where all legs are drawn from markets within a single event. True = SGP leg; False = standard cross-game parlay leg. SGP legs require special pricing and settlement rules distinct from standard parlays.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:selectionDescription rdf:type rdf:Property ;
    rdfs:label 'Selection Description' ;
    rdfs:comment 'Human-readable description of the bettor\'s selection for this leg (e.g., \'Kansas City Chiefs -3.5\', \'Over 48.5 Total Points\', \'Patrick Mahomes Anytime TD Scorer\'). Used for ticket display, customer communications, and regulatory reporting.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selectionSide rdf:type rdf:Property ;
    rdfs:label 'Selection Side' ;
    rdfs:comment 'Structured indicator of which side of the market the bettor selected (home/away for moneyline and spread; over/under for totals; yes/no for props). Complements selection_description with a machine-readable value for automated settlement.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementResult rdf:type rdf:Property ;
    rdfs:label 'Settlement Result' ;
    rdfs:comment 'Final official settlement outcome for this leg after the event result is confirmed. Distinct from leg_status in that it represents the immutable post-settlement record used for financial reconciliation and regulatory reporting, whereas leg_status may be updated during the event lifecycle.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementSource rdf:type rdf:Property ;
    rdfs:label 'Settlement Source' ;
    rdfs:comment 'Indicates how the settlement result was determined: automated via official data feed, manual operator entry, official league/governing body feed, or adjudication following a dispute. Required for audit trail and regulatory compliance.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sgpBoostApplied rdf:type rdf:Property ;
    rdfs:label 'Sgp Boost Applied' ;
    rdfs:comment 'Indicates whether a promotional SGP odds boost was applied to this leg\'s contribution to the parlay. True = boost applied; False = standard pricing. Used for promotional cost tracking, margin analysis, and regulatory reporting of promotional pricing.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:teaserPointAdjustment rdf:type rdf:Property ;
    rdfs:label 'Teaser Point Adjustment' ;
    rdfs:comment 'Number of points added to or subtracted from the original spread or total for teaser and pleaser leg types. Null for standard parlay legs. Used to derive the adjusted handicap for settlement and to validate teaser pricing.' ;
    rdfs:domain ind:ParlayLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payoutId rdf:type rdf:Property ;
    rdfs:label 'Payout Id' ;
    rdfs:comment 'Unique surrogate identifier for each gaming payout disbursement record in the silver layer lakehouse.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amlReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Aml Review Flag' ;
    rdfs:comment 'Indicates whether this payout has been flagged for Anti-Money Laundering review due to threshold triggers (e.g., cash equivalent payouts exceeding $10,000 CTR threshold) or suspicious activity patterns. When true, payout may be held pending compliance review.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bonusAmountIncluded rdf:type rdf:Property ;
    rdfs:label 'Bonus Amount Included' ;
    rdfs:comment 'Portion of the gross payout amount attributable to bonus funds or promotional credits rather than real-money wagering. Used to separate real-money GGR from bonus-funded activity in regulatory reporting and financial reconciliation.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ctrReportable rdf:type rdf:Property ;
    rdfs:label 'Ctr Reportable' ;
    rdfs:comment 'Indicates whether this payout triggers a FinCEN Currency Transaction Report (CTR) requirement, applicable when cash-equivalent payouts to a single bettor exceed $10,000 in a single gaming day. Drives CTR filing workflow.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalWithholdingRate rdf:type rdf:Property ;
    rdfs:label 'Federal Withholding Rate' ;
    rdfs:comment 'Federal income tax withholding rate applied to this payout, expressed as a decimal (e.g., 0.2400 for 24%). Determined by IRS backup withholding rules or regular gambling withholding rates based on payout type and bettor tax status.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ggrPeriod rdf:type rdf:Property ;
    rdfs:label 'Ggr Period' ;
    rdfs:comment 'YYYY-MM formatted reporting period to which this payout is attributed for Gross Gaming Revenue (GGR) calculations and regulatory financial reporting. GGR = Total Wagers - Total Payouts within the period. Supports monthly regulatory submissions.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossPayoutAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Payout Amount' ;
    rdfs:comment 'Total payout amount before any tax withholding deductions, representing the full winning amount owed to the bettor. Used as the basis for W-2G threshold evaluation and Gross Gaming Revenue (GGR) calculations.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isFreeBetPayout rdf:type rdf:Property ;
    rdfs:label 'Is Free Bet Payout' ;
    rdfs:comment 'Indicates whether this payout originated from a free bet promotion where the stake was operator-funded. When true, the stake amount is excluded from the net payout per standard free bet payout rules (profit only, stake not returned). Affects GGR and bonus cost accounting.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netPayoutAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payout Amount' ;
    rdfs:comment 'Final amount disbursed to the bettor after deducting tax_withheld_amount from gross_payout_amount. This is the actual funds received by the bettor and the amount recorded in the payment processor instruction.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oddsAtSettlement rdf:type rdf:Property ;
    rdfs:label 'Odds At Settlement' ;
    rdfs:comment 'Decimal odds value at which the winning wager was settled. Used for W-2G threshold ratio verification (300:1 requirement for sports betting) and audit trail of payout calculation basis.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payoutMethod rdf:type rdf:Property ;
    rdfs:label 'Payout Method' ;
    rdfs:comment 'Disbursement channel used to deliver funds to the bettor. Wallet credit: instant credit to in-app gaming wallet; ACH: Automated Clearing House bank transfer; Check: physical check mailed to bettor; Wire transfer: bank wire for large payouts; PayPal/Venmo: third-party digital wallet. [ENUM-REF-CANDIDATE: wallet_credit|ach|check|wire_transfer|paypal|venmo|prepaid_card — promote to reference product]' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payoutType rdf:type rdf:Property ;
    rdfs:label 'Payout Type' ;
    rdfs:comment 'Classification of the payout by its originating business event. Wager settlement covers standard sportsbook wins; DFS contest prize covers daily fantasy sports contest payouts; fantasy league prize covers season-long league prize distributions; bonus conversion covers wagering requirement completions; promotional credit covers operator-funded promotional payouts; free bet winnings covers winnings from free bet stakes. [ENUM-REF-CANDIDATE: wager_settlement|dfs_contest_prize|fantasy_league_prize|bonus_conversion|promotional_credit|free_bet_winnings — promote to reference product]' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prizeRank rdf:type rdf:Property ;
    rdfs:label 'Prize Rank' ;
    rdfs:comment 'Finishing rank or placement position of the bettor\'s DFS contest entry or fantasy league team that determined the prize payout amount. Null for sportsbook wager payouts. Used for prize structure validation and contest result reconciliation.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:processorName rdf:type rdf:Property ;
    rdfs:label 'Processor Name' ;
    rdfs:comment 'Name of the third-party payment processor or banking network used to execute this payout disbursement (e.g., Worldpay, FIS, PayPal, Venmo, NACHA ACH network). Supports processor performance monitoring and reconciliation routing.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processorReference rdf:type rdf:Property ;
    rdfs:label 'Processor Reference' ;
    rdfs:comment 'Transaction reference number returned by the external payment processor (ACH network, wire transfer system, check issuer, or digital wallet provider) upon submission of the payout instruction. Used for payment reconciliation and dispute resolution.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stakeAmount rdf:type rdf:Property ;
    rdfs:label 'Stake Amount' ;
    rdfs:comment 'The original wager or contest entry fee amount placed by the bettor that generated this payout. Used for W-2G threshold ratio calculation (payout must be 300x stake for sports betting W-2G trigger) and GGR computation.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateWithholdingAmount rdf:type rdf:Property ;
    rdfs:label 'State Withholding Amount' ;
    rdfs:comment 'State income tax withheld from the gross payout amount per the applicable state gaming jurisdiction\'s withholding requirements. Separate from federal withholding. Zero if the jurisdiction does not require state withholding.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:w2gFormReference rdf:type rdf:Property ;
    rdfs:label 'W2g Form Reference' ;
    rdfs:comment 'Reference number of the IRS W-2G tax form issued to the bettor for this payout. Populated only when w2g_reportable is true. Used for tax compliance tracking, bettor tax document retrieval, and IRS filing reconciliation.' ;
    rdfs:domain ind:Payout ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fantasySportType rdf:type rdf:Property ;
    rdfs:label 'Fantasy Sport Type' ;
    rdfs:comment 'Indicates whether this proposition bet is associated with a daily fantasy sports (DFS) contest, a season-long fantasy league, or is a standard sportsbook prop (not_applicable). Used for regulatory classification under UIGEA and state DFS laws.' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLiveBet rdf:type rdf:Property ;
    rdfs:label 'Is Live Bet' ;
    rdfs:comment 'Indicates whether this proposition bet is available for in-play (live) wagering during the event, as opposed to pre-event wagering only. True = live betting enabled.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSameGameParlayEligible rdf:type rdf:Property ;
    rdfs:label 'Is Same Game Parlay Eligible' ;
    rdfs:comment 'Indicates whether this proposition bet is eligible to be combined with other bets from the same game in a same-game parlay (SGP) product. Distinct from general parlay eligibility due to correlated outcome risk controls.' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineUnit rdf:type rdf:Property ;
    rdfs:label 'Line Unit' ;
    rdfs:comment 'The unit of measurement for the proposition bet line value (e.g., touchdowns, points, yards, strikeouts, assists, rebounds, goals). Provides context for interpreting prop_line_value. [ENUM-REF-CANDIDATE: touchdowns|points|yards|strikeouts|assists|rebounds|goals|saves|aces|birdies|rounds|other — 12 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxWagerAmount rdf:type rdf:Property ;
    rdfs:label 'Max Wager Amount' ;
    rdfs:comment 'The maximum single-bet stake amount (in the operating currency) permitted on this proposition bet, as set by the risk management team. Enforced at the platform level to control liability exposure.' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minWagerAmount rdf:type rdf:Property ;
    rdfs:label 'Min Wager Amount' ;
    rdfs:comment 'The minimum single-bet stake amount (in the operating currency) required to place a wager on this proposition bet. Set by the platform operator per regulatory and commercial requirements.' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oddsProviderCode rdf:type rdf:Property ;
    rdfs:label 'Odds Provider Code' ;
    rdfs:comment 'Code identifying the external odds feed provider or trading desk that supplied the opening and current odds for this proposition bet (e.g., \'SPORTRADAR\', \'GENIUS_SPORTS\', \'INTERNAL\').' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overOdds rdf:type rdf:Property ;
    rdfs:label 'Over Odds' ;
    rdfs:comment 'The current decimal odds offered for the \'over\' or \'yes\' selection on this proposition bet. Expressed in decimal format per international sportsbook standards (e.g., 1.9091 for -110 American odds).' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propCategory rdf:type rdf:Property ;
    rdfs:label 'Prop Category' ;
    rdfs:comment 'High-level classification of the proposition bet type: player_prop (individual athlete performance), game_prop (game-level outcome), team_prop (team performance), novelty_prop (non-standard entertainment wagers), entertainment_prop (non-sport entertainment events), series_prop (multi-game series outcome).' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propCode rdf:type rdf:Property ;
    rdfs:label 'Prop Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this proposition bet offering within the gaming platform and across partner sportsbook integrations (e.g., PROP-NFL-TD-ANYTIME-001).' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propDescription rdf:type rdf:Property ;
    rdfs:label 'Prop Description' ;
    rdfs:comment 'Detailed narrative description of the proposition bet, including the specific outcome being wagered on, applicable rules, and any clarifying conditions for settlement.' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propLineValue rdf:type rdf:Property ;
    rdfs:label 'Prop Line Value' ;
    rdfs:comment 'The numeric threshold or line associated with over/under or points-based proposition bets (e.g., 1.5 touchdowns, 24.5 points, 7.5 strikeouts). Null for yes/no or binary props.' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propName rdf:type rdf:Property ;
    rdfs:label 'Prop Name' ;
    rdfs:comment 'Human-readable display name of the proposition bet as shown to bettors on the platform (e.g., \'Anytime Touchdown Scorer - Patrick Mahomes\', \'First Team to Score\').' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propSubcategory rdf:type rdf:Property ;
    rdfs:label 'Prop Subcategory' ;
    rdfs:comment 'Granular classification within the prop category (e.g., \'touchdown_scorer\', \'passing_yards\', \'first_basket\', \'strikeout_total\', \'margin_of_victory\', \'first_team_to_score\'). [ENUM-REF-CANDIDATE: touchdown_scorer|passing_yards|first_basket|strikeout_total|margin_of_victory|first_team_to_score|rushing_yards|receiving_yards|assists|rebounds — promote to reference product]' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryCategory rdf:type rdf:Property ;
    rdfs:label 'Regulatory Category' ;
    rdfs:comment 'Regulatory classification of the proposition bet for licensing, reporting, and compliance purposes as defined by applicable gaming authorities (sports_wagering, daily_fantasy, novelty, entertainment, esports).' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementCriteria rdf:type rdf:Property ;
    rdfs:label 'Settlement Criteria' ;
    rdfs:comment 'Detailed rules and conditions used to determine the winning outcome of the proposition bet (e.g., \'Player must score a touchdown at any point during regulation and overtime\', \'Official league statistics used for settlement within 72 hours of game completion\').' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underOdds rdf:type rdf:Property ;
    rdfs:label 'Under Odds' ;
    rdfs:comment 'The current decimal odds offered for the \'under\' or \'no\' selection on this proposition bet. Expressed in decimal format per international sportsbook standards.' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:winningSelection rdf:type rdf:Property ;
    rdfs:label 'Winning Selection' ;
    rdfs:comment 'The specific outcome or selection that was determined to be the winner upon settlement (e.g., \'Yes\', \'Over\', \'Team A\', player name). Populated after settlement.' ;
    rdfs:domain ind:PropBet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryRegulatoryEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Regulatory Employee Id' ;
    rdfs:comment 'Reference to the internal compliance officer or authorized user who submitted this regulatory report to the governing authority.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:responsibleOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Responsible Org Unit Id' ;
    rdfs:comment 'Foreign key linking to workforce.org_unit. Business justification: Regulatory filings in licensed sports betting must identify the responsible compliance org unit, not just the individual submitter. Regulators and internal audit require organizational accountability.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:acceptedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Accepted Timestamp' ;
    rdfs:comment 'The date and time when the regulatory authority formally accepted and closed the review of this report. Marks the completion of the regulatory filing lifecycle.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:acknowledgementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acknowledgement Timestamp' ;
    rdfs:comment 'The date and time when the regulatory authority formally acknowledged receipt of the submitted report. Distinct from submission_timestamp; marks the start of the regulatory review clock.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:activePlayerCount rdf:type rdf:Property ;
    rdfs:label 'Active Player Count' ;
    rdfs:comment 'Number of unique active registered players who placed at least one wager during the reporting period. Required for responsible gaming program and player activity regulatory disclosures.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amlFlaggedTransactionCount rdf:type rdf:Property ;
    rdfs:label 'Aml Flagged Transaction Count' ;
    rdfs:comment 'Number of transactions flagged for potential Anti-Money Laundering (AML) activity during the reporting period and disclosed in this regulatory filing.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:filingDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Filing Deadline Date' ;
    rdfs:comment 'The regulatory-mandated deadline by which this report must be submitted to the governing authority. Used to monitor compliance with filing timeliness requirements and flag late submissions.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ggrAmount rdf:type rdf:Property ;
    rdfs:label 'Ggr Amount' ;
    rdfs:comment 'Total Gross Gaming Revenue (GGR) reported for the filing period, representing total wagers accepted minus total winnings paid out. Applicable for GGR report type filings. Expressed in the reporting currency.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internalReviewNotes rdf:type rdf:Property ;
    rdfs:label 'Internal Review Notes' ;
    rdfs:comment 'Free-text field capturing internal compliance team notes, review comments, or escalation details associated with the preparation or review of this regulatory report. Not shared externally.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAmended rdf:type rdf:Property ;
    rdfs:label 'Is Amended' ;
    rdfs:comment 'Indicates whether this report is an amendment to a previously submitted filing. True = amended/corrected report; False = original submission. Amended reports must reference the original report number.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLateFiling rdf:type rdf:Property ;
    rdfs:label 'Is Late Filing' ;
    rdfs:comment 'Indicates whether this report was submitted after the regulatory filing deadline. True = filed late; False = filed on time. Used for compliance monitoring and penalty risk assessment.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycVerifiedPlayerCount rdf:type rdf:Property ;
    rdfs:label 'Kyc Verified Player Count' ;
    rdfs:comment 'Number of players who completed Know Your Customer (KYC) identity verification during the reporting period. Required for AML/KYC compliance filings with gaming regulators.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalReportNumber rdf:type rdf:Property ;
    rdfs:label 'Original Report Number' ;
    rdfs:comment 'The report_number of the original filing that this amended report supersedes. Populated only when is_amended = True. Enables audit trail linkage between original and amended submissions.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryBodyName rdf:type rdf:Property ;
    rdfs:label 'Regulatory Body Name' ;
    rdfs:comment 'Full name of the gaming regulatory authority or governing body to which this report is submitted (e.g., Nevada Gaming Control Board, UK Gambling Commission, New Jersey Division of Gaming Enforcement).' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryBodyReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Body Reference Number' ;
    rdfs:comment 'Acknowledgement or reference number assigned by the regulatory authority upon receipt or processing of the submitted report. Used for official correspondence and audit trail.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportFrequency rdf:type rdf:Property ;
    rdfs:label 'Report Frequency' ;
    rdfs:comment 'The required cadence at which this type of regulatory report must be submitted to the governing authority (e.g., monthly GGR reports, annual responsible gaming program reports, ad hoc SARs).' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportVersion rdf:type rdf:Property ;
    rdfs:label 'Report Version' ;
    rdfs:comment 'Sequential version number of this regulatory report, incremented each time an amendment or resubmission is made. Version 1 = original filing; higher values indicate amended filings.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End Date' ;
    rdfs:comment 'The last calendar date of the reporting period covered by this regulatory filing (e.g., end of the monthly GGR reporting window).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start Date' ;
    rdfs:comment 'The first calendar date of the reporting period covered by this regulatory filing (e.g., start of the monthly GGR reporting window).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsibleGamingInterventionCount rdf:type rdf:Property ;
    rdfs:label 'Responsible Gaming Intervention Count' ;
    rdfs:comment 'Number of responsible gaming interventions (e.g., deposit limit alerts, cooling-off period activations, problem gambling referrals) executed during the reporting period. Required for responsible gaming program reports.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sarCount rdf:type rdf:Property ;
    rdfs:label 'Sar Count' ;
    rdfs:comment 'Number of individual Suspicious Activity Reports (SARs) included or referenced in this regulatory filing. Applicable for SAR batch or summary filings to FINCEN or state gaming authorities.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:selfExclusionBreachCount rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion Breach Count' ;
    rdfs:comment 'Number of instances where a self-excluded player was identified as having accessed or attempted to access gaming services during the reporting period. Critical compliance metric for regulatory filings.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:selfExclusionCount rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion Count' ;
    rdfs:comment 'Number of players enrolled in the self-exclusion program during the reporting period. Required for self-exclusion compliance reports submitted to gaming regulators.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalWagersAmount rdf:type rdf:Property ;
    rdfs:label 'Total Wagers Amount' ;
    rdfs:comment 'Aggregate value of all wagers accepted during the reporting period, as reported to the regulatory authority. Used as a component of GGR calculation and regulatory financial disclosure.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalWinningsPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Total Winnings Paid Amount' ;
    rdfs:comment 'Aggregate value of all winnings paid out to bettors during the reporting period, as reported to the regulatory authority. Used as a component of GGR calculation.' ;
    rdfs:domain ind:RegulatoryReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responsibleGamingLimitId rdf:type rdf:Property ;
    rdfs:label 'Responsible Gaming Limit Id' ;
    rdfs:comment 'Unique surrogate identifier for each responsible gaming limit record configured for a bettor account. Primary key for the responsible_gaming_limit data product in the Silver Layer lakehouse.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:setByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Set By Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Operator-initiated responsible gaming limits (e.g., mandatory limits, intervention-triggered limits) require employee accountability for regulatory audit trails. Gaming regulators require documentatio' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supersededByLimitResponsibleGamingLimitId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Limit Responsible Gaming Limit Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the newer responsible_gaming_limit record that replaced this one when a limit was modified or updated. Null if this is the current active limit. Enables full limit history chain reconstruction for regulatory audit.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResponsibleGamingLimit .

ind:activatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Activated Timestamp' ;
    rdfs:comment 'The exact date and time when this responsible gaming limit transitioned to active status and began enforcement. May differ from requested_timestamp due to mandatory regulatory cooling-off periods before limit reductions take effect.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:coolingOffEndDate rdf:type rdf:Property ;
    rdfs:label 'Cooling Off End Date' ;
    rdfs:comment 'The date on which a mandatory regulatory cooling-off period ends, after which a limit increase or self-exclusion reversal may take effect. Null for limit decreases and new limits that take effect immediately.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:interactionChannel rdf:type rdf:Property ;
    rdfs:label 'Interaction Channel' ;
    rdfs:comment 'The platform or interface through which the bettor or operator submitted the responsible gaming limit request. Supports omnichannel analytics and regulatory channel-specific reporting requirements.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPermanent rdf:type rdf:Property ;
    rdfs:label 'Is Permanent' ;
    rdfs:comment 'Indicates whether this responsible gaming limit is designated as permanent with no expiry date. True for lifetime self-exclusions and permanent bans. False for time-bound limits. Drives expiry_date nullability logic and regulatory reporting classification.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:limitAmount rdf:type rdf:Property ;
    rdfs:label 'Limit Amount' ;
    rdfs:comment 'The monetary ceiling or numeric threshold set by the limit. For deposit, loss, and wager limit types this is a currency amount. For session_time limits this field is null and limit_duration_minutes is used instead. For self_exclusion and cooling_off this field is null.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:limitChangeDirection rdf:type rdf:Property ;
    rdfs:label 'Limit Change Direction' ;
    rdfs:comment 'Indicates whether this limit record represents an increase, decrease, new establishment, or reinstatement of a previously revoked limit. Regulators typically require immediate enforcement of limit decreases but allow a cooling-off period before increases take effect.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Limit Duration Minutes' ;
    rdfs:comment 'Duration in minutes applicable to time-based limit types such as session_time, cooling_off, and self_exclusion. For monetary limit types (deposit, loss, wager) this field is null.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:limitPeriod rdf:type rdf:Property ;
    rdfs:label 'Limit Period' ;
    rdfs:comment 'The rolling or fixed time window over which the limit amount or duration is measured and enforced. For example, a daily deposit limit resets every 24 hours, while a lifetime self-exclusion has no reset.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Limit Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to this responsible gaming limit record, used for regulatory reporting, audit trails, and customer-facing communications.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitSource rdf:type rdf:Property ;
    rdfs:label 'Limit Source' ;
    rdfs:comment 'Identifies the originating party that established this responsible gaming limit. Player_initiated means the bettor voluntarily set the limit. Operator_imposed means the gaming operator applied the limit based on internal responsible gaming policies. Regulator_mandated means the applicable gaming regulatory authority required the limit.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitStatus rdf:type rdf:Property ;
    rdfs:label 'Limit Status' ;
    rdfs:comment 'Current lifecycle state of the responsible gaming limit. Pending indicates the limit has been requested but not yet enforced (e.g., awaiting cooling-off period before reduction takes effect). Active means the limit is currently enforced. Suspended means temporarily paused by operator or regulator. Revoked means cancelled. Expired means the limit reached its end date.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitType rdf:type rdf:Property ;
    rdfs:label 'Limit Type' ;
    rdfs:comment 'Classification of the responsible gaming control applied to the bettor account. Defines the nature of the restriction: deposit limits cap funds added, loss limits cap net losses, wager limits cap individual bet amounts, session_time limits cap continuous play duration, cooling_off imposes a temporary break, and self_exclusion is a voluntary or mandated ban from wagering activity.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorNotes rdf:type rdf:Property ;
    rdfs:label 'Operator Notes' ;
    rdfs:comment 'Free-text field for operator-entered notes or justification related to this responsible gaming limit, particularly for operator_imposed or regulator_mandated limits. Used for internal case management and regulatory audit documentation.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:playerAcknowledgementFlag rdf:type rdf:Property ;
    rdfs:label 'Player Acknowledgement Flag' ;
    rdfs:comment 'Indicates whether the bettor has explicitly acknowledged and confirmed the responsible gaming limit through the platform interface. True means the player confirmed; False means acknowledgement is pending. Required for audit and GDPR consent documentation.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:playerAcknowledgementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Player Acknowledgement Timestamp' ;
    rdfs:comment 'The date and time when the bettor explicitly acknowledged and confirmed the responsible gaming limit. Null if player_acknowledgement_flag is False. Critical for GDPR consent audit trails.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:previousLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Previous Limit Amount' ;
    rdfs:comment 'The monetary limit amount that was in effect immediately before the current limit was set. Enables regulators and auditors to assess whether a limit change represents an increase or decrease, which has different cooling-off period implications.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryNotificationSent rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Sent' ;
    rdfs:comment 'Indicates whether the required regulatory notification for this limit event has been transmitted to the applicable gaming authority. True means notification has been sent; False means notification is pending or not yet required.' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Timestamp' ;
    rdfs:comment 'The date and time when the regulatory notification for this responsible gaming limit event was transmitted to the applicable gaming authority. Null if regulatory_notification_sent is False.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:requestedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Requested Timestamp' ;
    rdfs:comment 'The exact date and time (ISO 8601 with timezone offset) when the bettor or operator submitted the request to establish or modify this responsible gaming limit. Serves as the principal business event timestamp for audit and regulatory reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:revocationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Revocation Timestamp' ;
    rdfs:comment 'The date and time when this responsible gaming limit was revoked or cancelled. Null for limits that are active, pending, or expired. Supports regulatory reporting on limit lifecycle events.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:riskTriggerCode rdf:type rdf:Property ;
    rdfs:label 'Risk Trigger Code' ;
    rdfs:comment 'Coded identifier of the responsible gaming risk indicator or algorithm trigger that prompted an operator_imposed or regulator_mandated limit. Examples include spend velocity alerts, session duration thresholds, or self-reported problem gambling indicators. Null for player_initiated limits. [ENUM-REF-CANDIDATE: spend_velocity|session_duration|self_reported|third_party_referral|regulatory_directive|behavioral_pattern — promote to reference product]' ;
    rdfs:domain ind:ResponsibleGamingLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selfExclusionProgram rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion Program' ;
    rdfs:comment 'Identifies the self-exclusion program under which a self_exclusion limit type was registered. Voluntary is operator-level, national_registry and state_registry refer to government-administered exclusion databases, and operator_program refers to multi-operator industry programs.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selfExclusionId rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion Id' ;
    rdfs:comment 'Unique surrogate identifier for each self-exclusion record in the gaming platform. Primary key for the self_exclusion data product.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:processedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Processed By Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Self-exclusion processing in regulated gaming requires employee accountability — compliance staff who process exclusions must be identified for regulatory audits and potential breach investigations. G' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accountSuspensionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Account Suspension Timestamp' ;
    rdfs:comment 'The precise date and time at which the bettor\'s account was technically suspended in the gaming platform following the exclusion election. May differ from exclusion_election_timestamp due to processing lag.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:acknowledgmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Timestamp' ;
    rdfs:comment 'The precise date and time at which the bettor provided formal acknowledgment of the exclusion terms. Provides an audit trail for consent management and regulatory compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:balanceDispositionStatus rdf:type rdf:Property ;
    rdfs:label 'Balance Disposition Status' ;
    rdfs:comment 'Tracks the status of the pending account balance at time of exclusion. Pending indicates funds not yet processed; refunded indicates funds returned to bettor; forfeited indicates funds surrendered per regulatory rule; held_regulatory indicates funds held pending regulatory instruction; transferred indicates funds moved to a responsible gaming fund.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bonusClawbackFlag rdf:type rdf:Property ;
    rdfs:label 'Bonus Clawback Flag' ;
    rdfs:comment 'Indicates whether outstanding bonus balances or promotional credits on the bettor\'s account were clawed back (forfeited) at the time of exclusion, per operator terms and conditions.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:counselingCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Counseling Completion Date' ;
    rdfs:comment 'The date on which the bettor completed the required responsible gaming counseling or assessment program. Null if counseling is not required or not yet completed.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electionChannel rdf:type rdf:Property ;
    rdfs:label 'Election Channel' ;
    rdfs:comment 'The channel through which the exclusion was initiated or submitted. Online indicates self-service via web or mobile app; in_person indicates submission at a physical venue or gaming facility; phone indicates call center submission; mail indicates written submission; regulatory_portal indicates submission via a state gaming authority portal; third_party indicates submission by a guardian or legal representative.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionAcknowledgmentFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusion Acknowledgment Flag' ;
    rdfs:comment 'Indicates whether the bettor formally acknowledged the terms and consequences of the self-exclusion (e.g., via digital signature, checkbox confirmation, or in-person signature). Required for voluntary self-exclusions to establish informed consent.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Exclusion Duration Months' ;
    rdfs:comment 'The elected or imposed duration of the exclusion in whole months, as selected at the time of enrollment. Common regulatory options include 6, 12, 24, 60 months, or lifetime. Null for permanent exclusions.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exclusionElectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Exclusion Election Timestamp' ;
    rdfs:comment 'The precise date and time at which the exclusion was formally elected or imposed, representing the principal real-world business event time. Used for regulatory audit trails and compliance reporting.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:exclusionEndDate rdf:type rdf:Property ;
    rdfs:label 'Exclusion End Date' ;
    rdfs:comment 'The calendar date on which the exclusion period is scheduled to expire. Null if the exclusion is permanent. Must be evaluated in conjunction with is_permanent flag.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Exclusion Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned to this exclusion record, used for regulatory reporting, correspondence with the bettor, and cross-platform reconciliation. Format: SE-{JURISDICTION}-{SEQUENCE}.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionScope rdf:type rdf:Property ;
    rdfs:label 'Exclusion Scope' ;
    rdfs:comment 'Defines the breadth of the exclusion: single_platform restricts the bettor from one specific gaming platform; all_platforms restricts across all operator-owned platforms; statewide applies to all licensed operators in a jurisdiction; nationwide applies across all US jurisdictions; global applies internationally.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionStartDate rdf:type rdf:Property ;
    rdfs:label 'Exclusion Start Date' ;
    rdfs:comment 'The calendar date on which the exclusion becomes effective and the bettor\'s account is suspended from all gaming activities within the defined scope.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusionStatus rdf:type rdf:Property ;
    rdfs:label 'Exclusion Status' ;
    rdfs:comment 'Current lifecycle state of the self-exclusion record. Active indicates the exclusion is in force; expired indicates the exclusion period has lapsed without reinstatement; reinstated indicates the bettor has been approved to resume gaming; pending_review indicates a reinstatement request is under evaluation; revoked indicates the exclusion was cancelled by regulatory authority.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionType rdf:type rdf:Property ;
    rdfs:label 'Exclusion Type' ;
    rdfs:comment 'Categorical classification of the exclusion\'s origin. Voluntary self-exclusion is bettor-initiated; operator exclusion is imposed by the platform; state-mandated exclusion is driven by a state gaming authority or NCPG list; court-ordered exclusion is legally mandated; guardian exclusion is filed on behalf of a minor or incapacitated person. [ENUM-REF-CANDIDATE: voluntary_self_exclusion|operator_exclusion|state_mandated_exclusion|ncpg_exclusion|court_ordered_exclusion|guardian_exclusion — promote to reference product]' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalExclusionListCode rdf:type rdf:Property ;
    rdfs:label 'External Exclusion List Code' ;
    rdfs:comment 'The identifier assigned to this bettor by an external exclusion registry such as the NCPG national list or a state gaming authority exclusion database. Used for cross-referencing and deduplication against external lists.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatedBy rdf:type rdf:Property ;
    rdfs:label 'Initiated By' ;
    rdfs:comment 'Identifies the party that initiated the exclusion action. Bettor indicates voluntary self-exclusion; operator indicates platform-imposed exclusion; state_authority indicates a state gaming commission mandate; court indicates a judicial order; guardian indicates a legal guardian acting on behalf of the bettor; ncpg indicates the National Council on Problem Gambling list submission.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketingSuppressionFlag rdf:type rdf:Property ;
    rdfs:label 'Marketing Suppression Flag' ;
    rdfs:comment 'Indicates whether the bettor\'s account has been suppressed from all marketing communications (email, SMS, push notifications, direct mail) as required during the exclusion period. Must be True for all active exclusions per responsible gaming regulations.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ncpgListMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Ncpg List Match Flag' ;
    rdfs:comment 'Indicates whether this bettor\'s account was matched against the National Council on Problem Gambling (NCPG) national self-exclusion list during onboarding or periodic screening. True indicates a confirmed match requiring mandatory exclusion.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:openWagerCount rdf:type rdf:Property ;
    rdfs:label 'Open Wager Count' ;
    rdfs:comment 'The number of open or unsettled wagers on the bettor\'s account at the time the exclusion was applied. Used to manage wager settlement obligations and regulatory reporting.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:openWagerDisposition rdf:type rdf:Property ;
    rdfs:label 'Open Wager Disposition' ;
    rdfs:comment 'Defines how open wagers are handled upon exclusion activation. void_all cancels all open bets and refunds stakes; settle_then_suspend allows existing bets to settle before account suspension; held_pending holds wagers for regulatory review; regulatory_directed follows specific authority instruction.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorExclusionReason rdf:type rdf:Property ;
    rdfs:label 'Operator Exclusion Reason' ;
    rdfs:comment 'Free-text or coded reason provided by the operator when imposing an operator-initiated exclusion. Examples include suspected problem gambling behavior, bonus abuse, fraud, or regulatory directive. Null for voluntary self-exclusions.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pendingBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Pending Balance Amount' ;
    rdfs:comment 'The bettor\'s account balance at the time of exclusion that is pending disposition. Regulatory requirements in many jurisdictions mandate return of remaining funds to the excluded bettor. Expressed in the jurisdiction\'s base currency.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryNotificationStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Status' ;
    rdfs:comment 'Tracks the status of the mandatory regulatory notification submission to the governing gaming authority. Pending indicates not yet submitted; submitted indicates sent but not confirmed; acknowledged indicates confirmed receipt by authority; failed indicates submission error requiring retry.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Approval Status' ;
    rdfs:comment 'Current status of the bettor\'s reinstatement request. not_requested indicates no request has been filed; pending indicates under review; approved indicates reinstatement granted; denied indicates request rejected; withdrawn indicates bettor withdrew the request.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinstatementApprovedDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Approved Date' ;
    rdfs:comment 'The date on which the reinstatement request was formally approved by the operator and/or regulatory authority, allowing the bettor to resume gaming activities. Null if reinstatement has not been approved.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinstatementCoolingOffDays rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Cooling Off Days' ;
    rdfs:comment 'The mandatory cooling-off period in days that must elapse after a reinstatement request before the bettor can be reinstated. Defined by jurisdictional regulation or operator policy.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinstatementRequestDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Request Date' ;
    rdfs:comment 'The date on which the excluded bettor formally submitted a request to be reinstated to gaming activities. Null if no reinstatement has been requested. Triggers the reinstatement review workflow.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsibleGamingCounselingRequired rdf:type rdf:Property ;
    rdfs:label 'Responsible Gaming Counseling Required' ;
    rdfs:comment 'Indicates whether the bettor is required to complete a responsible gaming counseling or assessment program as a condition of reinstatement. Driven by operator policy or regulatory mandate.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateExclusionListMatchFlag rdf:type rdf:Property ;
    rdfs:label 'State Exclusion List Match Flag' ;
    rdfs:comment 'Indicates whether this bettor was identified via a state-level exclusion list (distinct from NCPG national list). True indicates the exclusion was triggered by a state gaming authority\'s exclusion registry match.' ;
    rdfs:domain ind:SelfExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:affiliateId rdf:type rdf:Property ;
    rdfs:label 'Affiliate Id' ;
    rdfs:comment 'Identifier of the marketing affiliate or partner that referred the bettor to the sportsbook platform. Used for affiliate commission calculations, customer acquisition cost (CAC) tracking, and marketing ROI analysis.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Affiliate .

ind:cashoutAmount rdf:type rdf:Property ;
    rdfs:label 'Cashout Amount' ;
    rdfs:comment 'The monetary amount offered and accepted by the bettor when exercising the early cash-out option. Null if the wager was not cashed out. Represents the sportsbook\'s real-time liability reduction value.' ;
    rdfs:domain ind:Wager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashoutTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cashout Timestamp' ;
    rdfs:comment 'The date and time when the bettor exercised the early cash-out option, if applicable. Null if the wager was not cashed out early. Used for cash-out feature analytics and liability management.' ;
    rdfs:domain ind:Wager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:geolocationCountry rdf:type rdf:Property ;
    rdfs:label 'Geolocation Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code where the bettor was physically located at time of wager placement. Used for international jurisdiction compliance and cross-border wagering restriction enforcement.' ;
    rdfs:domain ind:Wager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFreeBet rdf:type rdf:Property ;
    rdfs:label 'Is Free Bet' ;
    rdfs:comment 'Indicates whether this wager was funded by a promotional free bet credit rather than real money from the bettor\'s account. Free bets are excluded from certain regulatory gross gaming revenue calculations.' ;
    rdfs:domain ind:Wager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legCount rdf:type rdf:Property ;
    rdfs:label 'Leg Count' ;
    rdfs:comment 'The number of individual selections (legs) included in this wager. For straight bets this is 1; for parlays and teasers this is 2 or more. Used for parlay payout validation and risk management.' ;
    rdfs:domain ind:Wager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:potentialPayout rdf:type rdf:Property ;
    rdfs:label 'Potential Payout' ;
    rdfs:comment 'The maximum gross payout amount the bettor would receive if the wager wins, calculated as stake_amount multiplied by odds_at_placement. Captured at placement time for liability management and bettor communication.' ;
    rdfs:domain ind:Wager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:potentialProfit rdf:type rdf:Property ;
    rdfs:label 'Potential Profit' ;
    rdfs:comment 'The net profit the bettor would receive if the wager wins, calculated as potential_payout minus stake_amount. Represents the bettor\'s net gain and is used in responsible gaming exposure monitoring.' ;
    rdfs:domain ind:Wager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:selfExclusionOverride rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion Override' ;
    rdfs:comment 'Indicates whether this wager was placed despite a self-exclusion or cooling-off period being active on the bettor\'s account. Should always be False for compliant operations; True values require immediate regulatory escalation.' ;
    rdfs:domain ind:Wager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ticketTerminalCode rdf:type rdf:Property ;
    rdfs:label 'Ticket Terminal Code' ;
    rdfs:comment 'Identifier of the specific betting terminal, kiosk, or point-of-sale device used to place the wager. Used for terminal-level reconciliation, fraud detection, and equipment audit trails in retail and kiosk channels.' ;
    rdfs:domain ind:Wager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wagerStatus rdf:type rdf:Property ;
    rdfs:label 'Wager Status' ;
    rdfs:comment 'Current lifecycle status of the wager. \'pending\' indicates the event has not yet concluded; \'won\'/\'lost\' reflect settled outcomes; \'void\' indicates cancellation (e.g., event postponed); \'cashed_out\' reflects early cash-out by bettor; \'pushed\' indicates a tie/refund outcome.' ;
    rdfs:domain ind:Wager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wagerType rdf:type rdf:Property ;
    rdfs:label 'Wager Type' ;
    rdfs:comment 'Classification of the wager structure. \'straight\' is a single-selection bet; \'parlay\' combines multiple selections for higher payout; \'teaser\' adjusts point spreads; \'prop\' is a proposition bet on specific in-game events; \'futures\' bets on season-long outcomes; \'round_robin\' is a series of parlays. [ENUM-REF-CANDIDATE: straight|parlay|teaser|prop|futures|round_robin|if_bet|reverse — promote to reference product]' ;
    rdfs:domain ind:Wager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:walletTransactionId rdf:type rdf:Property ;
    rdfs:label 'Wallet Transaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each wallet transaction ledger entry within the gaming platform. Primary key for this table.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bettorAccountId rdf:type rdf:Property ;
    rdfs:label 'Bettor Bettor Account Id' ;
    rdfs:comment 'Identifier of the registered bettor whose gaming wallet is affected by this transaction. Links to the bettor/fan profile in the CRM system.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BettorAccount .

ind:bonusOfferId rdf:type rdf:Property ;
    rdfs:label 'Bonus Bonus Offer Id' ;
    rdfs:comment 'Reference to the promotional bonus or free-bet offer associated with this transaction when the type is bonus_credit or bonus_forfeiture. Enables bonus liability tracking, wagering requirement compliance, and promotional ROI analysis.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BonusOffer .

ind:depositId rdf:type rdf:Property ;
    rdfs:label 'Deposit Id' ;
    rdfs:comment 'Reference to the associated deposit record when the transaction type is a deposit. Links the wallet ledger entry to the originating deposit request for reconciliation and AML source-of-funds tracking. Null for non-deposit transactions.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Deposit .

ind:originalTransactionWalletTransactionId rdf:type rdf:Property ;
    rdfs:label 'Original Transaction Wallet Transaction Id' ;
    rdfs:comment 'Reference to the original wallet transaction that this record reverses, adjusts, or corrects. Null for original transactions. Enables full audit chain reconstruction for reversed, adjusted, or re-processed transactions.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WalletTransaction .

ind:amlFlag rdf:type rdf:Property ;
    rdfs:label 'Aml Flag' ;
    rdfs:comment 'Indicates whether this transaction has been flagged for Anti-Money Laundering review based on automated rules (e.g., transaction exceeds CTR threshold of $10,000, structuring pattern detected, unusual velocity). True = flagged for AML review; False = no AML flag. Triggers Suspicious Activity Report (SAR) workflow.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baseCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Base Currency Amount' ;
    rdfs:comment 'Transaction amount converted to the operator\'s base reporting currency (e.g., USD) using the exchange_rate at transaction time. Used for consolidated financial reporting, AML threshold monitoring in a single currency, and cross-jurisdiction revenue analysis.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:debitCreditIndicator rdf:type rdf:Property ;
    rdfs:label 'Debit Credit Indicator' ;
    rdfs:comment 'Indicates whether this transaction reduces (debit) or increases (credit) the wallet balance. Debit: wager_stake, withdrawal, bonus_forfeiture, negative adjustment. Credit: deposit, wager_settlement win, bonus_credit, positive adjustment. Aligns with double-entry bookkeeping standards.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycVerified rdf:type rdf:Property ;
    rdfs:label 'Kyc Verified' ;
    rdfs:comment 'Indicates whether the bettor\'s identity had been fully verified through the Know Your Customer (KYC) process at the time this transaction was processed. True = KYC complete; False = KYC pending or incomplete. Transactions processed without KYC may be subject to regulatory scrutiny.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentProviderReference rdf:type rdf:Property ;
    rdfs:label 'Payment Provider Reference' ;
    rdfs:comment 'External transaction identifier returned by the payment gateway or processor (e.g., Stripe charge ID, PayPal transaction ID, bank wire reference). Used for reconciliation with the payment provider and chargeback dispute management. Stored as a tokenized or masked reference per PCI DSS.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postTransactionBalance rdf:type rdf:Property ;
    rdfs:label 'Post Transaction Balance' ;
    rdfs:comment 'The bettor\'s wallet balance immediately after this transaction was applied. Used to verify ledger consistency (pre_transaction_balance ± transaction_amount = post_transaction_balance) and for responsible gaming balance monitoring.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preTransactionBalance rdf:type rdf:Property ;
    rdfs:label 'Pre Transaction Balance' ;
    rdfs:comment 'The bettor\'s wallet balance immediately before this transaction was applied. Captured as a point-in-time snapshot for ledger integrity verification, dispute resolution, and responsible gaming spend analysis.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:processingLatencyMs rdf:type rdf:Property ;
    rdfs:label 'Processing Latency Ms' ;
    rdfs:comment 'Time in milliseconds between the transaction initiation timestamp and the completion/failure timestamp. Used for SLA monitoring of payment processing performance and identification of system degradation events affecting bettor experience.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:selfExclusionActive rdf:type rdf:Property ;
    rdfs:label 'Self Exclusion Active' ;
    rdfs:comment 'Indicates whether the bettor had an active self-exclusion or cooling-off period in effect at the time of this transaction. True = self-exclusion was active (transaction should have been blocked — used for compliance breach investigation); False = no active self-exclusion. Critical for responsible gaming regulatory compliance.' ;
    rdfs:domain ind:WalletTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transactionReference rdf:type rdf:Property ;
    rdfs:label 'Transaction Reference' ;
    rdfs:comment 'Externally visible, human-readable reference code assigned to this transaction. Used for customer service inquiries, reconciliation, and regulatory reporting. Sourced from the gaming platform ledger.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activePayrollUsd rdf:type rdf:Property ;
    rdfs:label 'Active Payroll Usd' ;
    rdfs:comment 'Total salary cap charges attributable to players on the active roster at the time of this snapshot. Represents the primary component of the franchise\'s cap utilization, sourced from contract records in SAP S/4HANA SD/FI modules.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditDate rdf:type rdf:Property ;
    rdfs:label 'Audit Date' ;
    rdfs:comment 'Date on which the cap compliance record was formally audited by the league office or designated compliance authority. Distinct from the snapshot date and submission date.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditedBy rdf:type rdf:Property ;
    rdfs:label 'Audited By' ;
    rdfs:comment 'Name or identifier of the league official, compliance officer, or external auditor who reviewed and validated this cap compliance record. Supports audit trail requirements under SOX and CBA governance.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capExceptionAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Cap Exception Amount Usd' ;
    rdfs:comment 'Dollar value of the salary cap exception being utilized by the franchise. Represents the maximum contract value that can be offered under the active exception type. Zero if no exception is in use.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capExceptionType rdf:type rdf:Property ;
    rdfs:label 'Cap Exception Type' ;
    rdfs:comment 'Type of salary cap exception being utilized by the franchise in this snapshot period. Exceptions allow teams to exceed the soft cap under specific CBA-defined conditions (e.g., NBA Mid-Level Exception, Bi-Annual Exception, Disabled Player Exception). \'none\' if no exception is active.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capHoldAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Cap Hold Amount Usd' ;
    rdfs:comment 'Total cap holds applied to the franchise for unsigned draft picks, restricted free agents, and franchise-tagged players whose contracts have not yet been finalized. Cap holds reserve cap space until contracts are executed or players are released.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capPenaltyAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Cap Penalty Amount Usd' ;
    rdfs:comment 'Total cap penalties assessed against the franchise by the league for CBA violations, tampering, or other disciplinary actions that result in cap charges. Distinct from dead cap and luxury tax.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capRolloverAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Cap Rollover Amount Usd' ;
    rdfs:comment 'Unused cap space from the prior season that has been rolled over and added to the current season\'s cap limit, where permitted by the applicable CBA. Increases the effective cap ceiling for the franchise.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capSpaceRemainingUsd rdf:type rdf:Property ;
    rdfs:label 'Cap Space Remaining Usd' ;
    rdfs:comment 'The amount of salary cap space available to the franchise at the time of this snapshot, calculated as the season cap limit minus all cap charges (active payroll, dead cap, cap holds, IR credits, practice squad charges). A negative value indicates a cap violation.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capType rdf:type rdf:Property ;
    rdfs:label 'Cap Type' ;
    rdfs:comment 'Classification of the salary cap structure applicable to this franchise and league. \'hard_cap\' enforces an absolute ceiling; \'soft_cap\' allows exceptions; \'salary_floor\' enforces a minimum spend; \'tax_apron\' is a secondary hard limit above the luxury tax threshold (e.g., NBA second apron).' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceRecordNumber rdf:type rdf:Property ;
    rdfs:label 'Compliance Record Number' ;
    rdfs:comment 'Externally-known business identifier for this cap compliance snapshot, formatted as CAP-{LEAGUE}-{YEAR}-{SEQUENCE}. Used in league submissions, audit trails, and CBA compliance reporting.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consecutiveTaxYears rdf:type rdf:Property ;
    rdfs:label 'Consecutive Tax Years' ;
    rdfs:comment 'Number of consecutive seasons the franchise has been a luxury tax payer. Used to determine escalating repeat-offender luxury tax rates under the NBA CBA, where franchises paying tax in multiple consecutive years face higher tax rates.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveActionDeadline rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Deadline' ;
    rdfs:comment 'The date by which the franchise must resolve a cap compliance violation or warning. Set by the league office upon identification of a violation. Null if no corrective action is required.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deadCapAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Dead Cap Amount Usd' ;
    rdfs:comment 'Total salary cap charges attributable to players no longer on the roster (released, traded, or retired) whose guaranteed money or signing bonus prorations still count against the cap. Dead cap reduces available cap space without active roster benefit.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:franchiseTagChargeUsd rdf:type rdf:Property ;
    rdfs:label 'Franchise Tag Charge Usd' ;
    rdfs:comment 'Total salary cap charges attributable to players designated with a franchise tag. Franchise tag values are set by the league based on position averages and count against the cap until a long-term contract is signed.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:injuredReserveCreditUsd rdf:type rdf:Property ;
    rdfs:label 'Injured Reserve Credit Usd' ;
    rdfs:comment 'Total salary cap credits granted to the franchise for players placed on the Injured Reserve (IR) list. IR credits reduce the effective cap charge for injured players per league rules, providing partial cap relief.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isLuxuryTaxPayer rdf:type rdf:Property ;
    rdfs:label 'Is Luxury Tax Payer' ;
    rdfs:comment 'Indicates whether the franchise\'s total payroll exceeds the luxury tax threshold, making them a luxury tax payer for the current season. Drives luxury tax liability calculations and repeat-offender tax rate escalations.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOverCap rdf:type rdf:Property ;
    rdfs:label 'Is Over Cap' ;
    rdfs:comment 'Indicates whether the franchise\'s total cap charges exceed the season cap limit at the time of this snapshot. True signals a cap violation requiring immediate league review and potential corrective action.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'League Submission Date' ;
    rdfs:comment 'Date on which this cap compliance record was formally submitted to the league office for review and approval. Required for CBA compliance audit trails.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leagueSubmissionStatus rdf:type rdf:Property ;
    rdfs:label 'League Submission Status' ;
    rdfs:comment 'Status of this cap compliance record\'s submission to the league office. \'pending\' means not yet submitted; \'submitted\' means sent to the league; \'acknowledged\' means receipt confirmed; \'approved\' means league has validated compliance; \'disputed\' means the league has raised a question or objection.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:luxuryTaxLiabilityUsd rdf:type rdf:Property ;
    rdfs:label 'Luxury Tax Liability Usd' ;
    rdfs:comment 'The dollar amount of luxury tax owed by the franchise if total payroll exceeds the luxury tax threshold defined in the CBA. Applicable in leagues with soft cap structures (e.g., NBA). Zero if the franchise is below the luxury tax line or if the league uses a hard cap.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:luxuryTaxThresholdUsd rdf:type rdf:Property ;
    rdfs:label 'Luxury Tax Threshold Usd' ;
    rdfs:comment 'The payroll level above which the franchise incurs luxury tax penalties for the current season, as defined by the applicable CBA. Distinct from the hard cap limit; used to calculate luxury tax liability.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceIncentiveChargeUsd rdf:type rdf:Property ;
    rdfs:label 'Performance Incentive Charge Usd' ;
    rdfs:comment 'Total likely and unlikely performance incentive amounts counting against the cap in the current season. Likely incentives (LTBE) count in the current year; unlikely incentives (NLTBE) may roll to the following year per CBA rules.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:practiceSquadChargeUsd rdf:type rdf:Property ;
    rdfs:label 'Practice Squad Charge Usd' ;
    rdfs:comment 'Total salary cap charges attributable to players on the practice squad roster. Practice squad salaries count against the cap at league-mandated minimum rates per the applicable CBA.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rosterCountActive rdf:type rdf:Property ;
    rdfs:label 'Roster Count Active' ;
    rdfs:comment 'Number of players on the active roster at the time of this cap compliance snapshot. Used to validate roster size compliance against league-mandated minimum and maximum roster limits.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rosterCountIr rdf:type rdf:Property ;
    rdfs:label 'Roster Count Ir' ;
    rdfs:comment 'Number of players designated on the Injured Reserve (IR) list at the time of this snapshot. Drives IR cap credit calculations and roster exception eligibility.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rosterCountPracticeSquad rdf:type rdf:Property ;
    rdfs:label 'Roster Count Practice Squad' ;
    rdfs:comment 'Number of players on the practice squad at the time of this snapshot. Used to validate practice squad size compliance and calculate practice squad cap charges.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonCapLimitUsd rdf:type rdf:Property ;
    rdfs:label 'Season Cap Limit Usd' ;
    rdfs:comment 'The total salary cap ceiling (in USD) allocated to the franchise for the current season as defined by the applicable CBA. This is the hard or soft cap maximum against which all payroll charges are measured.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signingBonusProrationUsd rdf:type rdf:Property ;
    rdfs:label 'Signing Bonus Proration Usd' ;
    rdfs:comment 'Total prorated signing bonus amounts counting against the cap in the current season. Signing bonuses are spread over the life of the contract (up to 5 years per CBA rules), and the annual proration is a distinct cap charge component.' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:snapshotDate rdf:type rdf:Property ;
    rdfs:label 'Snapshot Date' ;
    rdfs:comment 'Calendar date of the cap compliance snapshot. Used for day-level reporting, standings, and league-submitted compliance filings distinct from the precise timestamp.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:snapshotTimestamp rdf:type rdf:Property ;
    rdfs:label 'Snapshot Timestamp' ;
    rdfs:comment 'The precise date and time at which this cap compliance position was captured. Compliance positions are updated on roster transactions and contract signings, making the snapshot time critical for point-in-time reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:triggerEventType rdf:type rdf:Property ;
    rdfs:label 'Trigger Event Type' ;
    rdfs:comment 'The type of business event that triggered this cap compliance snapshot update. Captures whether the record was generated by a contract signing, roster move, trade, waiver claim, injury designation, practice squad change, or a scheduled cap adjustment. [ENUM-REF-CANDIDATE: contract_signing|roster_transaction|trade|waiver|injury_designation|practice_squad_change|cap_adjustment|season_open|season_close — promote to reference product]' ;
    rdfs:domain ind:CapCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leagueSignatoryEmployeeId rdf:type rdf:Property ;
    rdfs:label 'League Signatory Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: CBA agreements are executed by a specific league employee (Commissioner or EVP Labor Relations). league_signatory is a plain-text denormalization. CBA governance, legal records, and labor relations re' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:agreementCode rdf:type rdf:Property ;
    rdfs:label 'Agreement Code' ;
    rdfs:comment 'Externally-known short alphanumeric code uniquely identifying the CBA across league systems (e.g., \'NFL-CBA-2021\'). Used as the business key in cross-system references including salary_cap, franchise_agreement, and disciplinary_action.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementName rdf:type rdf:Property ;
    rdfs:label 'Agreement Name' ;
    rdfs:comment 'Official full name of the Collective Bargaining Agreement as ratified by both parties (e.g., \'2021 NFL Collective Bargaining Agreement\'). Used as the primary human-readable identifier in labor relations governance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentCount rdf:type rdf:Property ;
    rdfs:label 'Amendment Count' ;
    rdfs:comment 'Total number of formal amendments, side letters, or memoranda of understanding (MOUs) that have been executed against this CBA since its original ratification. Supports version control and audit.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:arbitrationEligibilityYears rdf:type rdf:Property ;
    rdfs:label 'Arbitration Eligibility Years' ;
    rdfs:comment 'Minimum years of credited service required for a player to file for salary arbitration under this CBA. Governs the arbitration provisions referenced by disciplinary_action and contract dispute resolution.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:arbitrationType rdf:type rdf:Property ;
    rdfs:label 'Arbitration Type' ;
    rdfs:comment 'Method of salary arbitration prescribed by the CBA. \'final_offer\' (each side submits a figure and the arbitrator selects one), \'conventional\' (arbitrator sets any figure), \'expedited\' (streamlined process), or \'none\' if arbitration is not provided.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capYearEnd rdf:type rdf:Property ;
    rdfs:label 'Cap Year End' ;
    rdfs:comment 'Final league year (expressed as a calendar year integer, e.g., 2030) for which the salary cap figures defined in this CBA record apply. Together with cap_year_start defines the cap schedule horizon.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capYearStart rdf:type rdf:Property ;
    rdfs:label 'Cap Year Start' ;
    rdfs:comment 'First league year (expressed as a calendar year integer, e.g., 2021) for which the salary cap figures defined in this CBA record apply. Supports year-over-year cap tracking across multi-year agreements.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:draftEligibilityRules rdf:type rdf:Property ;
    rdfs:label 'Draft Eligibility Rules' ;
    rdfs:comment 'Summary of the player draft eligibility criteria established by the CBA, including age minimums, college attendance requirements, and international player entry rules. Referenced by athlete.draft_selection for rule authority.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugTestingProgram rdf:type rdf:Property ;
    rdfs:label 'Drug Testing Program' ;
    rdfs:comment 'Identifies the drug testing program framework applicable under this CBA. Indicates whether the program is WADA-compliant, a league-administered program, a jointly administered program, or not applicable.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementRole rdf:type rdf:Property ;
    rdfs:label 'Engagement Role' ;
    rdfs:comment 'The specific legal role this outside counsel firm is performing on this CBA engagement. Distinguishes lead labor counsel from antitrust, arbitration, or grievance specialists retained simultaneously on the same CBA. Belongs to the engagement, not to the firm master or the CBA master.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:freeAgencyEligibilityYears rdf:type rdf:Property ;
    rdfs:label 'Free Agency Eligibility Years' ;
    rdfs:comment 'Minimum number of years of credited service a player must accumulate before becoming eligible for unrestricted free agency under this CBA. Core rule referenced by athlete.free_agency_status.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:grievanceProcedureSummary rdf:type rdf:Property ;
    rdfs:label 'Grievance Procedure Summary' ;
    rdfs:comment 'Narrative summary of the multi-step grievance and dispute resolution procedure established by the CBA, including filing deadlines, hearing steps, and final appeal mechanisms. Supports labor relations governance and compliance tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalPlayerProvisions rdf:type rdf:Property ;
    rdfs:label 'International Player Provisions' ;
    rdfs:comment 'Indicates whether the CBA contains specific provisions governing international players, including visa requirements, international transfer rules, and foreign player roster limits.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lockoutProvision rdf:type rdf:Property ;
    rdfs:label 'Lockout Provision' ;
    rdfs:comment 'Indicates whether the CBA contains explicit lockout provisions governing the league\'s right to lock out players in the event of a labor dispute. True if lockout provisions are included.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:luxuryTaxRate rdf:type rdf:Property ;
    rdfs:label 'Luxury Tax Rate' ;
    rdfs:comment 'Dollar-for-dollar or multiplier rate applied to payroll exceeding the luxury tax threshold, expressed as a decimal percentage (e.g., 150.00 for $1.50 per $1.00 over threshold). Governs financial penalties for cap overages.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matterPhase rdf:type rdf:Property ;
    rdfs:label 'Matter Phase' ;
    rdfs:comment 'The phase of the CBA lifecycle for which this outside counsel firm is engaged. A firm may be retained only for the arbitration phase of a CBA while a different firm handles the negotiation phase. Belongs to the engagement record, not to either master.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxAnnualSalaryIncreasePct rdf:type rdf:Property ;
    rdfs:label 'Max Annual Salary Increase Pct' ;
    rdfs:comment 'Maximum percentage by which a player\'s annual salary may increase year-over-year within a multi-year contract under this CBA (e.g., 8.00 for 8%). Governs contract escalation clauses.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxContractYears rdf:type rdf:Property ;
    rdfs:label 'Max Contract Years' ;
    rdfs:comment 'Maximum number of years permitted for a single player contract under this CBA. Governs athlete.contract records and franchise_agreement terms.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumPlayerSalaryUsd rdf:type rdf:Property ;
    rdfs:label 'Minimum Player Salary Usd' ;
    rdfs:comment 'Lowest annual salary that any player on an active roster may be paid under the CBA, expressed in US dollars. Varies by years of service; this field captures the base rookie minimum for the agreement period.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nilRightsProvision rdf:type rdf:Property ;
    rdfs:label 'Nil Rights Provision' ;
    rdfs:comment 'Indicates whether the CBA contains provisions governing players\' Name, Image, and Likeness (NIL) rights, including group licensing arrangements and individual endorsement restrictions.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optOutDate rdf:type rdf:Property ;
    rdfs:label 'Opt Out Date' ;
    rdfs:comment 'Date by which either party (league or union) may exercise an opt-out clause to terminate the CBA early. Null if no opt-out provision exists. Critical for labor relations planning and lockout risk assessment.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:optOutParty rdf:type rdf:Property ;
    rdfs:label 'Opt Out Party' ;
    rdfs:comment 'Identifies which party holds the right to exercise the opt-out clause: the league/management side, the union/players association, either party, or none if no opt-out provision exists.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pedSuspensionGames rdf:type rdf:Property ;
    rdfs:label 'Ped Suspension Games' ;
    rdfs:comment 'Number of regular-season games a player is suspended without pay for a first confirmed PED violation under this CBA. Governs disciplinary_action records for substance violations.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pensionPlanType rdf:type rdf:Property ;
    rdfs:label 'Pension Plan Type' ;
    rdfs:comment 'Type of retirement/pension plan provided to players under the CBA. Defined benefit plans guarantee a fixed payout; defined contribution plans specify employer contributions; hybrid combines both.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pensionVestingYears rdf:type rdf:Property ;
    rdfs:label 'Pension Vesting Years' ;
    rdfs:comment 'Minimum number of credited service years a player must complete to become fully vested in the CBA-mandated pension or retirement plan.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:playerRevenueSharePct rdf:type rdf:Property ;
    rdfs:label 'Player Revenue Share Pct' ;
    rdfs:comment 'Numeric percentage of defined league revenues allocated to players under the revenue sharing formula (e.g., 48.50 for 48.5%). Used in financial planning and EBITDA modeling.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:playerSafetyProvisions rdf:type rdf:Property ;
    rdfs:label 'Player Safety Provisions' ;
    rdfs:comment 'Summary of health, safety, and injury protection provisions mandated by the CBA, including practice limitations, contact restrictions, concussion protocols, and independent medical evaluation rights. Aligns with OSHA and ADA requirements.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceSquadSize rdf:type rdf:Property ;
    rdfs:label 'Practice Squad Size' ;
    rdfs:comment 'Maximum number of players permitted on a team\'s practice squad or developmental roster as defined by the CBA. Applicable to leagues with practice squad provisions (e.g., NFL, MLS).' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ratificationDate rdf:type rdf:Property ;
    rdfs:label 'Ratification Date' ;
    rdfs:comment 'Calendar date on which the CBA was formally ratified by both the league and the players association or union through a membership vote. Distinct from the effective date; may precede or follow it.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratificationStatus rdf:type rdf:Property ;
    rdfs:label 'Ratification Status' ;
    rdfs:comment 'Current lifecycle state of the CBA. Tracks progression from initial draft through ratification vote, active enforcement, expiration, or early termination. Referenced by salary_cap and franchise_agreement to determine rule authority. [ENUM-REF-CANDIDATE: draft|pending_ratification|ratified|active|expired|terminated|suspended — promote to reference product]' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictedFreeAgencyYears rdf:type rdf:Property ;
    rdfs:label 'Restricted Free Agency Years' ;
    rdfs:comment 'Number of years of credited service after which a player qualifies for restricted free agency (RFA), allowing the incumbent team right of first refusal on matching offers. Distinct from unrestricted free agency threshold.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revenueSharingFormula rdf:type rdf:Property ;
    rdfs:label 'Revenue Sharing Formula' ;
    rdfs:comment 'Textual description or formula code defining how total league revenues are split between the league/owners and the players association (e.g., \'Players receive 48.5% of Basketball Related Income\'). Governs the financial relationship between labor and management.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rosterSizeActive rdf:type rdf:Property ;
    rdfs:label 'Roster Size Active' ;
    rdfs:comment 'Maximum number of players permitted on a team\'s active game-day roster as defined by the CBA. Governs athlete.roster records and franchise_agreement compliance.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rosterSizeTotal rdf:type rdf:Property ;
    rdfs:label 'Roster Size Total' ;
    rdfs:comment 'Maximum number of players permitted on a team\'s full roster including practice squad, injured reserve, and developmental designations as defined by the CBA.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:salaryCapCeilingUsd rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Ceiling Usd' ;
    rdfs:comment 'Maximum total player payroll permitted per team per league year as defined in the CBA, expressed in US dollars. The hard or soft cap ceiling enforced by the league office. Referenced by salary_cap product for compliance validation.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salaryCapFloorUsd rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Floor Usd' ;
    rdfs:comment 'Minimum total player payroll that each team must spend per league year as mandated by the CBA, expressed in US dollars. Ensures competitive balance and minimum player compensation standards.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unionSignatory rdf:type rdf:Property ;
    rdfs:label 'Union Signatory' ;
    rdfs:comment 'Name of the players association, officials union, or labor organization that is a signatory to the CBA (e.g., \'NFL Players Association\', \'National Basketball Players Association\'). Identifies the labor side of the agreement.' ;
    rdfs:domain ind:CbaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:abbreviation rdf:type rdf:Property ;
    rdfs:label 'Abbreviation' ;
    rdfs:comment 'Short uppercase alphanumeric code used to identify the conference in standings tables, broadcast graphics, ticketing systems, and digital platforms (e.g., AFC, NFC, AL, NL, EC, WC).' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adaComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Ada Compliance Required' ;
    rdfs:comment 'Indicates whether venues and events under this conference\'s jurisdiction are required to comply with ADA (Americans with Disabilities Act) accessibility standards. Relevant for US-based conferences and venue operations management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastTier rdf:type rdf:Property ;
    rdfs:label 'Broadcast Tier' ;
    rdfs:comment 'Classification of the broadcast rights tier applicable to this conference\'s games and events. Determines whether media rights are distributed nationally, regionally via RSN (Regional Sports Network), internationally, locally, or exclusively via OTT (Over-The-Top Streaming) platforms.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conferenceCode rdf:type rdf:Property ;
    rdfs:label 'Conference Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the conference used in system integrations, API payloads, and data exchange with broadcast partners, ticketing platforms (Ticketmaster/AXS, Archtics), and Salesforce CRM.' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conferenceDescription rdf:type rdf:Property ;
    rdfs:label 'Conference Description' ;
    rdfs:comment 'Free-text narrative description of the conference, including its history, competitive structure, notable championships, and organizational purpose. Used in fan engagement platforms, broadcast content, and digital asset management.' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conferenceName rdf:type rdf:Property ;
    rdfs:label 'Conference Name' ;
    rdfs:comment 'Official full name of the conference as recognized by the governing league body (e.g., American Football Conference, Eastern Conference, American League, Western Conference).' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conferenceStatus rdf:type rdf:Property ;
    rdfs:label 'Conference Status' ;
    rdfs:comment 'Current lifecycle status of the conference. Active indicates the conference is currently operating within a live season. Inactive indicates off-season or dormant. Suspended indicates operations are paused due to regulatory or governance action. Dissolved indicates the conference no longer exists.' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conferenceType rdf:type rdf:Property ;
    rdfs:label 'Conference Type' ;
    rdfs:comment 'Classification of the organizational subdivision type. Distinguishes between a conference (NFL AFC/NFC), association (NBA Eastern/Western), league division (MLB American/National League), group, or pool used in tournament structures.' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divisionCount rdf:type rdf:Property ;
    rdfs:label 'Division Count' ;
    rdfs:comment 'Number of divisions contained within this conference for the current or most recent active season. Used for standings structure validation, playoff seeding logic, and league governance reporting.' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:foundedDate rdf:type rdf:Property ;
    rdfs:label 'Founded Date' ;
    rdfs:comment 'The official date on which the conference was formally established and recognized by its governing league body. Supports historical analytics, anniversary campaigns, and governance documentation.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gamesPerTeam rdf:type rdf:Property ;
    rdfs:label 'Games Per Team' ;
    rdfs:comment 'The standard number of regular season games each team within this conference is scheduled to play per season. Used for fixture calendar generation, broadcast rights valuation, and revenue forecasting in Workday Adaptive Planning.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geographicAlignment rdf:type rdf:Property ;
    rdfs:label 'Geographic Alignment' ;
    rdfs:comment 'Describes the geographic or regional basis for the conference grouping (e.g., East, West, North, South, Central, National, American, International). Used for standings aggregation, broadcast territory mapping (RSN alignment), and fan engagement segmentation.' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersCity rdf:type rdf:Property ;
    rdfs:label 'Headquarters City' ;
    rdfs:comment 'City where the conference administrative headquarters is located. Used for regulatory jurisdiction determination, tax reporting (SAP S/4HANA FI), and governance correspondence.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersCountryCode rdf:type rdf:Property ;
    rdfs:label 'Headquarters Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 three-letter country code for the country where the conference administrative headquarters is registered. Determines applicable regulatory frameworks (GDPR for EU, CCPA for California, SOX for US public entities).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isInternational rdf:type rdf:Property ;
    rdfs:label 'Is International' ;
    rdfs:comment 'Indicates whether this conference operates across multiple countries or is classified as an international competition body (e.g., FIFA international competitions, IOC-governed events). Drives international broadcast rights, GDPR compliance scope, and multi-currency financial reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:iso20121Certified rdf:type rdf:Property ;
    rdfs:label 'Iso 20121 Certified' ;
    rdfs:comment 'Indicates whether this conference has achieved or requires ISO 20121 Event Sustainability Management System certification for its events and operations. Supports ESG reporting and sustainability governance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:playoffBerthCount rdf:type rdf:Property ;
    rdfs:label 'Playoff Berth Count' ;
    rdfs:comment 'Number of playoff berths allocated to this conference per season under current league rules. Drives playoff seeding logic, standings aggregation, and broadcast scheduling for postseason events.' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:playoffFormat rdf:type rdf:Property ;
    rdfs:label 'Playoff Format' ;
    rdfs:comment 'The playoff competition format used by this conference to determine its representative(s) for the league championship. Drives bracket generation logic in event planning systems and broadcast scheduling.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regionName rdf:type rdf:Property ;
    rdfs:label 'Region Name' ;
    rdfs:comment 'Descriptive geographic region name for the conference\'s operational territory (e.g., North America, Europe, Asia-Pacific). Used for international broadcast rights distribution, OTT platform segmentation, and global fan engagement analytics.' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryCapApplicable rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Applicable' ;
    rdfs:comment 'Indicates whether a salary cap rule applies to teams competing within this conference. Drives salary cap compliance validation in athlete contract and roster management workflows.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduleFormat rdf:type rdf:Property ;
    rdfs:label 'Schedule Format' ;
    rdfs:comment 'The game scheduling format used within this conference (e.g., balanced where all teams play each other equally, unbalanced with division-weighted scheduling, interleague with cross-conference games). Drives fixture calendar generation.' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonEndYear rdf:type rdf:Property ;
    rdfs:label 'Season End Year' ;
    rdfs:comment 'The calendar year in which this conference ceased active operations. Null if the conference is currently active. Used for historical reporting, dissolved conference analytics, and governance audit trails.' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonStartYear rdf:type rdf:Property ;
    rdfs:label 'Season Start Year' ;
    rdfs:comment 'The calendar year in which this conference first became active and began competitive operations. Used to calculate conference tenure, historical analytics, and franchise agreement timelines.' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tiebreakerRulesVersion rdf:type rdf:Property ;
    rdfs:label 'Tiebreaker Rules Version' ;
    rdfs:comment 'Version identifier of the official tiebreaker rules document governing standings tie resolution within this conference. Ensures standings calculations and playoff seeding logic reference the correct ruleset for a given season.' ;
    rdfs:domain ind:Conference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tmoEnabled rdf:type rdf:Property ;
    rdfs:label 'Tmo Enabled' ;
    rdfs:comment 'Indicates whether Television Match Official (TMO) review technology is officially enabled for officiating decisions within this conference. Relevant for rugby and other sports using TMO protocols.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:actionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Action Reference Number' ;
    rdfs:comment 'Externally-known, human-readable reference number assigned by the league office to uniquely identify this disciplinary action (e.g., NFL-DISC-2024-00412). Used in official correspondence, press releases, and CBA compliance reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionStatus rdf:type rdf:Property ;
    rdfs:label 'Action Status' ;
    rdfs:comment 'Current lifecycle state of the disciplinary action. Tracks the workflow from initial issuance through appeal resolution and final ruling. Drives CBA compliance dashboards and competitive integrity reporting. [ENUM-REF-CANDIDATE: pending|active|appealed|upheld|overturned|reduced|withdrawn — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealEligible rdf:type rdf:Property ;
    rdfs:label 'Appeal Eligible' ;
    rdfs:comment 'Indicates whether the subject entity is eligible to appeal the disciplinary ruling under the applicable CBA or league rules. Drives appeal workflow initiation in Salesforce CRM case management.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealRulingDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Ruling Date' ;
    rdfs:comment 'The calendar date on which the appeal body (league arbitrator, CAS, or independent panel) issued its final ruling on the appeal. Nullable until appeal is resolved.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cbaArticleReference rdf:type rdf:Property ;
    rdfs:label 'Cba Article Reference' ;
    rdfs:comment 'Specific CBA (Collective Bargaining Agreement) article or section under which the disciplinary action was issued or the appeal is governed. Critical for labor relations compliance and arbitration proceedings.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:draftPickLossRound rdf:type rdf:Property ;
    rdfs:label 'Draft Pick Loss Round' ;
    rdfs:comment 'The draft round of the pick forfeited as part of the disciplinary penalty. Nullable for non-draft-pick-loss penalty types. Supports draft governance and franchise asset tracking.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:draftPickLossYear rdf:type rdf:Property ;
    rdfs:label 'Draft Pick Loss Year' ;
    rdfs:comment 'The draft year in which the forfeited pick applies. Nullable for non-draft-pick-loss penalty types. Used in conjunction with draft_pick_loss_round for franchise asset management.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:finalRulingDescription rdf:type rdf:Property ;
    rdfs:label 'Final Ruling Description' ;
    rdfs:comment 'Narrative summary of the final ruling outcome after all appeal processes are exhausted. Documents any modifications to the original penalty (e.g., reduced from 4 games to 2 games). Used for legal records and CBA compliance audit.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finePaidAmount rdf:type rdf:Property ;
    rdfs:label 'Fine Paid Amount' ;
    rdfs:comment 'Actual monetary amount paid by the subject entity against the assessed fine. Supports accounts receivable tracking in SAP S/4HANA and outstanding balance reporting for league finance.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finePaymentDate rdf:type rdf:Property ;
    rdfs:label 'Fine Payment Date' ;
    rdfs:comment 'Date on which the fine was paid in full or the most recent partial payment was received. Used for financial reconciliation and delinquency tracking.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incidentDate rdf:type rdf:Property ;
    rdfs:label 'Incident Date' ;
    rdfs:comment 'The calendar date on which the disciplinary incident or infraction occurred. Distinct from the ruling date; used for timeline analysis and statute-of-limitations compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incidentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Incident Timestamp' ;
    rdfs:comment 'Precise date and time at which the disciplinary incident occurred, including timezone offset. Used for in-game incident correlation (e.g., ejection time, VAR/TMO review timestamp).' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:infractionCategory rdf:type rdf:Property ;
    rdfs:label 'Infraction Category' ;
    rdfs:comment 'Broader category grouping the nature of the infraction (e.g., on-field conduct, PED violation, gambling, domestic violence, financial misconduct, game integrity). Supports regulatory reporting to WADA, CAS, and league governing bodies. [ENUM-REF-CANDIDATE: on_field_conduct|ped_violation|gambling|domestic_violence|financial_misconduct|game_integrity|social_conduct|equipment_violation — promote to reference product]' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infractionDescription rdf:type rdf:Property ;
    rdfs:label 'Infraction Description' ;
    rdfs:comment 'Detailed narrative description of the specific rule violation or conduct that triggered the disciplinary action, as documented by the league office. Supports legal review, CBA arbitration, and CAS proceedings.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infractionType rdf:type rdf:Property ;
    rdfs:label 'Infraction Type' ;
    rdfs:comment 'Primary classification of the disciplinary penalty imposed. Drives downstream CBA compliance tracking, salary cap impact assessment, and competitive integrity reporting. [ENUM-REF-CANDIDATE: suspension|fine|ejection|probation|draft_pick_loss|warning|roster_restriction|conditional_reinstatement — promote to reference product if additional types are needed]' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isGameIntegrityRelated rdf:type rdf:Property ;
    rdfs:label 'Is Game Integrity Related' ;
    rdfs:comment 'Indicates whether the disciplinary action involves a game integrity violation (e.g., match-fixing, gambling, sign-stealing). Triggers enhanced regulatory reporting to league governing bodies and law enforcement liaisons.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPedRelated rdf:type rdf:Property ;
    rdfs:label 'Is Ped Related' ;
    rdfs:comment 'Indicates whether the disciplinary action is related to a Performance Enhancing Drug (PED) violation. Triggers mandatory WADA reporting obligations and anti-doping compliance workflows.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPubliclyDisclosed rdf:type rdf:Property ;
    rdfs:label 'Is Publicly Disclosed' ;
    rdfs:comment 'Indicates whether the disciplinary action has been publicly disclosed by the league. Some actions (e.g., private reprimands) are not publicly announced. Governs data access and GDPR/CCPA disclosure controls.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorOffenseCount rdf:type rdf:Property ;
    rdfs:label 'Prior Offense Count' ;
    rdfs:comment 'Number of prior disciplinary actions of the same infraction category recorded against the subject entity. Supports escalating penalty calculation per CBA and league disciplinary schedules.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:publicAnnouncementDate rdf:type rdf:Property ;
    rdfs:label 'Public Announcement Date' ;
    rdfs:comment 'The date on which the league publicly announced the disciplinary action. Used for media relations tracking, fan communications, and compliance with league transparency requirements.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:repeatOffender rdf:type rdf:Property ;
    rdfs:label 'Repeat Offender' ;
    rdfs:comment 'Indicates whether the subject entity has a prior disciplinary history for the same or similar infraction category. Used to apply escalating penalty schedules per CBA provisions and league rules.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ruleCodeViolated rdf:type rdf:Property ;
    rdfs:label 'Rule Code Violated' ;
    rdfs:comment 'The specific league rulebook article, section, or CBA provision code that was violated (e.g., NFL Rule 12, Section 2, Article 8; NBA CBA Article XXXV). Enables precise regulatory and compliance cross-referencing.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rulingDate rdf:type rdf:Property ;
    rdfs:label 'Ruling Date' ;
    rdfs:comment 'The calendar date on which the league office issued the formal disciplinary ruling. Used for CBA compliance timelines, appeal window calculation, and regulatory reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subjectEntityName rdf:type rdf:Property ;
    rdfs:label 'Subject Entity Name' ;
    rdfs:comment 'Display name of the player, coach, franchise, official, or staff member against whom the disciplinary action was issued. Stored for reporting and audit purposes without requiring a join.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectEntityRef rdf:type rdf:Property ;
    rdfs:label 'Subject Entity Ref' ;
    rdfs:comment 'Polymorphic reference to the specific entity (player, coach, franchise, official, or staff) against whom the disciplinary action was issued. Resolved in conjunction with subject_entity_type.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:subjectEntityType rdf:type rdf:Property ;
    rdfs:label 'Subject Entity Type' ;
    rdfs:comment 'Classifies the type of entity against whom the disciplinary action was issued. Determines which reference table the subject_entity_id resolves to (player, coach, franchise, official, or staff member).' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspensionGames rdf:type rdf:Property ;
    rdfs:label 'Suspension Games' ;
    rdfs:comment 'Number of games for which the subject entity is suspended as part of the disciplinary action. Nullable for non-suspension penalty types. Used for roster planning, salary cap impact, and CBA compliance.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:suspensionWithPay rdf:type rdf:Property ;
    rdfs:label 'Suspension With Pay' ;
    rdfs:comment 'Indicates whether the subject entity continues to receive salary compensation during the suspension period. Directly impacts salary cap accounting and CBA compliance reporting.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:varTmoReviewed rdf:type rdf:Property ;
    rdfs:label 'Var Tmo Reviewed' ;
    rdfs:comment 'Indicates whether the incident that triggered this disciplinary action was reviewed by VAR (Video Assistant Referee) or TMO (Television Match Official) technology during the game. Supports officiating quality analytics.' ;
    rdfs:domain ind:DisciplinaryAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cbaAgreementCode rdf:type rdf:Property ;
    rdfs:label 'Cba Agreement Code' ;
    rdfs:comment 'Reference code for the Collective Bargaining Agreement (CBA) governing labor relations, player contracts, salary structures, and working conditions for teams within this division. Links to the applicable CBA document version. Classified confidential as it contains sensitive labor negotiation references.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentTeamCount rdf:type rdf:Property ;
    rdfs:label 'Current Team Count' ;
    rdfs:comment 'Actual number of active member franchises/teams currently assigned to this division in the current season. Drives scheduling algorithms and standings table generation.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:divisionCode rdf:type rdf:Property ;
    rdfs:label 'Division Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the division used in system integrations, data exchange with broadcast partners, ticketing systems (Ticketmaster/AXS, Archtics), and ERP (SAP S/4HANA SD) configurations. Distinct from the display abbreviation.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divisionName rdf:type rdf:Property ;
    rdfs:label 'Division Name' ;
    rdfs:comment 'Official full name of the division as designated by the governing league body (e.g., \'NFC East\', \'AL Central\', \'Atlantic Division\', \'Pacific Division\'). Used in standings displays, broadcast graphics, and official publications.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divisionStatus rdf:type rdf:Property ;
    rdfs:label 'Division Status' ;
    rdfs:comment 'Current operational lifecycle status of the division. \'active\' indicates the division is currently competing; \'inactive\' indicates off-season or temporarily dormant; \'suspended\' indicates governance-imposed suspension; \'dissolved\' indicates the division has been permanently disbanded; \'pending\' indicates formation approved but not yet operational.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divisionType rdf:type rdf:Property ;
    rdfs:label 'Division Type' ;
    rdfs:comment 'Classification of the division\'s organizational basis — whether it is structured by geographic region, competitive skill level, age group, or gender category. Informs scheduling logic and playoff qualification criteria.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:draftOrderMethod rdf:type rdf:Property ;
    rdfs:label 'Draft Order Method' ;
    rdfs:comment 'The method used to determine the order in which teams within this division select players in the league draft (e.g., inverse_standings where the worst team picks first, lottery for randomized selection, hybrid combining both). Governs athlete.draft_selection records.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalLeagueRefCode rdf:type rdf:Property ;
    rdfs:label 'External League Ref Code' ;
    rdfs:comment 'The division identifier as assigned by the governing body\'s external data feed or official API (e.g., NFL\'s official data partner code, FIFA\'s competition ID, Stats Perform division code). Used for data reconciliation with third-party broadcast and analytics data providers.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gamesPerTeamRegularSeason rdf:type rdf:Property ;
    rdfs:label 'Games Per Team Regular Season' ;
    rdfs:comment 'The number of regular season games each team within this division is scheduled to play per season (e.g., 17 for NFL, 82 for NBA, 162 for MLB, 82 for NHL). Drives fixture calendar generation and broadcast scheduling.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intraDivisionGames rdf:type rdf:Property ;
    rdfs:label 'Intra Division Games' ;
    rdfs:comment 'Number of games each team plays against other teams within the same division per regular season. Used in fixture scheduling algorithms to enforce divisional rivalry game requirements and scheduling balance rules.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:officiatingStandard rdf:type rdf:Property ;
    rdfs:label 'Officiating Standard' ;
    rdfs:comment 'The officiating technology and review standard applied to matches within this division. Indicates whether Video Assistant Referee (VAR) or Television Match Official (TMO) review protocols are active, or whether standard officiating applies. Drives officiating_assignment configurations in the event domain.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:playoffQualificationSpots rdf:type rdf:Property ;
    rdfs:label 'Playoff Qualification Spots' ;
    rdfs:comment 'Number of teams from this division that qualify for post-season playoff competition. Governs divisional standings cutoff logic and tiebreaker rule application. Critical for competitive integrity and fan engagement communications.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revenueSharingApplicable rdf:type rdf:Property ;
    rdfs:label 'Revenue Sharing Applicable' ;
    rdfs:comment 'Indicates whether league-wide revenue sharing provisions apply to franchises within this division. When True, finance.profit_center and finance.intercompany_settlement records must account for divisional revenue distribution per the CBA and franchise agreement terms.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:salaryCapCurrency rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the salary cap amount (e.g., \'USD\', \'CAD\', \'EUR\'). Required for international leagues (FIFA, MLS) operating across multiple currency jurisdictions.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonEndMonth rdf:type rdf:Property ;
    rdfs:label 'Season End Month' ;
    rdfs:comment 'Calendar month (1–12) in which the division\'s regular season typically concludes. Used for post-season planning, broadcast rights windows, and financial period alignment in SAP S/4HANA FI/CO.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonStartMonth rdf:type rdf:Property ;
    rdfs:label 'Season Start Month' ;
    rdfs:comment 'Calendar month (1–12) in which the division\'s regular season typically begins. Used for season calendar planning, broadcast rights scheduling, and Workday Adaptive Planning financial forecasting cycles.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tiebreakerRuleSet rdf:type rdf:Property ;
    rdfs:label 'Tiebreaker Rule Set' ;
    rdfs:comment 'Identifier or descriptive label for the official tiebreaker rules applied when two or more teams are equal in divisional standings (e.g., \'NFL_2024_TIEBREAKER\', \'NBA_CONF_TIEBREAKER_V3\'). References the league\'s official competition rules document. Drives automated standings calculation logic.' ;
    rdfs:domain ind:Division ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbaVersion rdf:type rdf:Property ;
    rdfs:label 'Cba Version' ;
    rdfs:comment 'Version or effective date identifier of the Collective Bargaining Agreement governing the rules, eligibility criteria, rookie wage scale, and draft procedures for this draft event.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compensatoryPicksAuthorized rdf:type rdf:Property ;
    rdfs:label 'Compensatory Picks Authorized' ;
    rdfs:comment 'Indicates whether compensatory picks have been authorized for this draft event by the league office, awarded to franchises that lost qualifying free agents in the prior season.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:draftName rdf:type rdf:Property ;
    rdfs:label 'Draft Name' ;
    rdfs:comment 'Official human-readable name of the draft event as published by the governing league (e.g., \'2025 NFL Draft\', \'2025 NBA Draft\').' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityClass rdf:type rdf:Property ;
    rdfs:label 'Eligibility Class' ;
    rdfs:comment 'Classification of the athlete pool eligible for this draft, determining applicable eligibility rules, age requirements, and CBA provisions (e.g., college seniors, international prospects, supplemental class). [ENUM-REF-CANDIDATE: college|international|supplemental|developmental|undrafted_free_agent — promote to reference product]' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedAttendance rdf:type rdf:Property ;
    rdfs:label 'Expected Attendance' ;
    rdfs:comment 'Projected number of fans expected to attend the live draft event in person, used for venue capacity planning, security staffing, and sponsorship activation sizing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fanAttendanceAllowed rdf:type rdf:Property ;
    rdfs:label 'Fan Attendance Allowed' ;
    rdfs:comment 'Indicates whether public fan attendance is permitted at the live draft venue, affecting ticketing operations, venue capacity planning, and fan engagement activations.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:forfeitedPicks rdf:type rdf:Property ;
    rdfs:label 'Forfeited Picks' ;
    rdfs:comment 'Number of pick slots forfeited during this draft event due to disciplinary actions, salary cap violations, or clock expiration, as ruled by the league office.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hostCity rdf:type rdf:Property ;
    rdfs:label 'Host City' ;
    rdfs:comment 'Name of the city hosting the live draft event, used for event planning, fan engagement, sponsorship activation, and broadcast production logistics.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrityReviewNotes rdf:type rdf:Property ;
    rdfs:label 'Integrity Review Notes' ;
    rdfs:comment 'Free-text notes documenting the nature and outcome of any competitive integrity review associated with this draft event, maintained by the league compliance office.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrityReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Integrity Review Required' ;
    rdfs:comment 'Indicates whether this draft event or any of its picks are subject to a competitive integrity review by the league office, triggered by suspected rule violations or tanking investigations.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lotteryConducted rdf:type rdf:Property ;
    rdfs:label 'Lottery Conducted' ;
    rdfs:comment 'Indicates whether a draft lottery was conducted to determine the order of top picks for this draft event (True = lottery held; False = order determined by standings or other method).' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lotteryDate rdf:type rdf:Property ;
    rdfs:label 'Lottery Date' ;
    rdfs:comment 'Calendar date on which the draft lottery was conducted to determine pick order, applicable when lottery_conducted is True.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orderMethod rdf:type rdf:Property ;
    rdfs:label 'Order Method' ;
    rdfs:comment 'Method used to determine the order in which franchises make their selections (e.g., lottery for top picks, inverse regular-season standings, coin flip for tied records, or predetermined compensatory formula). [ENUM-REF-CANDIDATE: lottery|inverse_standings|coin_flip|predetermined|compensatory — promote to reference product]' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ottStreamingEnabled rdf:type rdf:Property ;
    rdfs:label 'Ott Streaming Enabled' ;
    rdfs:comment 'Indicates whether the draft event is available for live streaming via OTT/DTC digital platforms in addition to or instead of traditional broadcast, supporting digital fan engagement.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:picksCompleted rdf:type rdf:Property ;
    rdfs:label 'Picks Completed' ;
    rdfs:comment 'Running count of pick selections that have been exercised and confirmed during the draft event, used for real-time progress tracking and broadcast production.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:salaryCapYear rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Year' ;
    rdfs:comment 'The salary cap fiscal year applicable to rookie contracts signed by athletes selected in this draft, governing rookie wage scale calculations and cap hit projections.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supplementalDraft rdf:type rdf:Property ;
    rdfs:label 'Supplemental Draft' ;
    rdfs:comment 'Indicates whether this draft event is a supplemental draft (True) rather than the primary annual draft (False), used for athletes who became eligible after the standard draft deadline.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalPicks rdf:type rdf:Property ;
    rdfs:label 'Total Picks' ;
    rdfs:comment 'Total number of pick slots in this draft event, including standard picks, compensatory picks, and supplemental picks as authorized by the governing league.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tradesExecuted rdf:type rdf:Property ;
    rdfs:label 'Trades Executed' ;
    rdfs:comment 'Total number of pick trade transactions executed during this draft event, used for trade analysis, draft asset management reporting, and competitive intelligence.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:wadaComplianceConfirmed rdf:type rdf:Property ;
    rdfs:label 'Wada Compliance Confirmed' ;
    rdfs:comment 'Indicates whether all athletes in the eligible draft class have been confirmed compliant with WADA anti-doping regulations prior to the draft event commencing.' ;
    rdfs:domain ind:Draft ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:year rdf:type rdf:Property ;
    rdfs:label 'Year' ;
    rdfs:comment 'Calendar year in which the draft event takes place, used as the primary temporal classification for draft class cohort analysis and future pick valuation.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastTradeTransactionId rdf:type rdf:Property ;
    rdfs:label 'Last Trade Transaction Id' ;
    rdfs:comment 'Reference to the most recent trade transaction record in which this pick was transferred. Enables full trade audit trail linkage.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TradeTransaction .

ind:primaryDraftCurrentOwnerFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Primary Draft Current Owner Franchise Id' ;
    rdfs:comment 'Reference to the franchise that currently holds the rights to exercise this draft pick. May differ from the original owning franchise if the pick has been traded.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:selectedAthleteAthleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Selected Athlete Athlete Profile Id' ;
    rdfs:comment 'Reference to the athlete selected with this pick upon exercise. Null until the pick is exercised. Links to the athlete profile for post-draft roster and contract management.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:competitiveIntegrityFlag rdf:type rdf:Property ;
    rdfs:label 'Competitive Integrity Flag' ;
    rdfs:comment 'Indicates whether this pick has been flagged for competitive integrity review by the league office (e.g., suspected tanking, collusion, or improper trade). Triggers compliance investigation workflow.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionDescription rdf:type rdf:Property ;
    rdfs:label 'Condition Description' ;
    rdfs:comment 'Free-text description of the conditions governing a conditional pick (e.g., \'Converts to 1st round if franchise wins division; otherwise 2nd round\'). Populated only when is_conditional is true.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:draftPositionTier rdf:type rdf:Property ;
    rdfs:label 'Draft Position Tier' ;
    rdfs:comment 'Categorical tier classification of this pick\'s position within the draft (e.g., \'lottery\' for NBA lottery picks, \'top_10\', \'first_round\', \'second_round\', \'later_round\'). Used for pick valuation segmentation and trade analysis.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exerciseDate rdf:type rdf:Property ;
    rdfs:label 'Exercise Date' ;
    rdfs:comment 'The date on which this pick was exercised (i.e., used to select an athlete during the draft event). Null until the pick is exercised.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exerciseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Exercise Timestamp' ;
    rdfs:comment 'The precise date and time at which this pick was exercised during the draft event, including timezone offset. Supports real-time draft broadcast and pick clock compliance tracking.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:externalRef rdf:type rdf:Property ;
    rdfs:label 'External Ref' ;
    rdfs:comment 'The externally-known identifier for this pick as published by the league office or official transaction systems (e.g., league transaction ID, official pick number code). Supports system-of-record reconciliation.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forfeitureReason rdf:type rdf:Property ;
    rdfs:label 'Forfeiture Reason' ;
    rdfs:comment 'Description of the reason this pick was forfeited, if applicable (e.g., salary cap violation, tampering penalty, CBA non-compliance). Populated only when pick_status is \'forfeited\'.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forfeitureRulingDate rdf:type rdf:Property ;
    rdfs:label 'Forfeiture Ruling Date' ;
    rdfs:comment 'The date on which the league office issued the ruling to forfeit this pick. Populated only when pick_status is \'forfeited\'.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isLotteryEligible rdf:type rdf:Property ;
    rdfs:label 'Is Lottery Eligible' ;
    rdfs:comment 'Indicates whether this pick is eligible to be determined by a lottery mechanism (e.g., NBA Draft Lottery). Relevant for protected pick valuation and conditional pick resolution.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTradeable rdf:type rdf:Property ;
    rdfs:label 'Is Tradeable' ;
    rdfs:comment 'Indicates whether this pick is currently eligible to be traded under league rules. Some picks (e.g., compensatory picks in certain leagues, picks under CBA restrictions) may be non-tradeable.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastTradeDate rdf:type rdf:Property ;
    rdfs:label 'Last Trade Date' ;
    rdfs:comment 'The date on which this pick was most recently traded to its current owning franchise. Null if the pick has never been traded.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pickAnnouncementName rdf:type rdf:Property ;
    rdfs:label 'Pick Announcement Name' ;
    rdfs:comment 'The official name announced for this pick during the draft broadcast (e.g., \'The Dallas Cowboys select...\'). Used for broadcast production, content, and DAM (Digital Asset Management) workflows.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pickClockSecondsRemaining rdf:type rdf:Property ;
    rdfs:label 'Pick Clock Seconds Remaining' ;
    rdfs:comment 'The number of seconds remaining on the pick clock when the pick was submitted. Used for draft broadcast analytics and compliance with league pick clock rules.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pickNumber rdf:type rdf:Property ;
    rdfs:label 'Pick Number' ;
    rdfs:comment 'The sequential overall pick number within the entire draft event (e.g., pick #1 through #259 in the NFL Draft). Used for pick valuation models and historical analysis.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pickSourceLeagueRule rdf:type rdf:Property ;
    rdfs:label 'Pick Source League Rule' ;
    rdfs:comment 'The specific league rule, CBA article, or governing provision under which this pick was created or awarded (e.g., \'CBA Article 5, Section 3 - Compensatory Pick Formula\', \'Expansion Draft Rule 12\'). Supports compliance and audit.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pickStatus rdf:type rdf:Property ;
    rdfs:label 'Pick Status' ;
    rdfs:comment 'Current lifecycle status of the draft pick. \'available\' = held and ready to use; \'traded\' = transferred to another franchise; \'exercised\' = used to select an athlete; \'forfeited\' = surrendered as penalty; \'voided\' = invalidated by league ruling.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pickValuationScore rdf:type rdf:Property ;
    rdfs:label 'Pick Valuation Score' ;
    rdfs:comment 'Quantitative valuation score assigned to this pick based on the league\'s or franchise\'s draft pick value chart (e.g., NFL Jimmy Johnson Chart, Chase Stuart Chart). Used for trade analysis and asset management. Not a calculated aggregate — represents the chart-assigned value for this pick position.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:protectionLevel rdf:type rdf:Property ;
    rdfs:label 'Protection Level' ;
    rdfs:comment 'The top-N protection threshold for this pick (e.g., 3 = top-3 protected, meaning if the pick falls in the top 3 overall, it does not convey to the trading partner and rolls over). Null if unprotected.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:protectionRolloverYearLimit rdf:type rdf:Property ;
    rdfs:label 'Protection Rollover Year Limit' ;
    rdfs:comment 'The maximum number of years a protected pick can roll over before it must convey regardless of protection status. Governs the expiry of pick protection in multi-year trade agreements.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:salaryCapCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the salary cap slot value (e.g., USD for NFL/NBA/MLB/NHL, EUR for FIFA leagues). Supports multi-league and international operations.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryCapSlotValue rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Slot Value' ;
    rdfs:comment 'The CBA-mandated salary cap slot value associated with this pick position, expressed in the league\'s designated currency. Governs the rookie contract value for the selected athlete. Critical for salary cap compliance reporting.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradeCount rdf:type rdf:Property ;
    rdfs:label 'Trade Count' ;
    rdfs:comment 'Total number of times this pick has been traded between franchises. Used for trade complexity analysis and pick valuation models.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tradeHistory rdf:type rdf:Property ;
    rdfs:label 'Trade History' ;
    rdfs:comment 'Serialized summary of the full trade chain for this pick, recording each franchise that has held the pick in sequence (e.g., \'FranchiseA → FranchiseB → FranchiseC\'). Supports trade analysis and pick provenance auditing.' ;
    rdfs:domain ind:DraftPick ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbaAgreementId rdf:type rdf:Property ;
    rdfs:label 'Cba Cba Agreement Id' ;
    rdfs:comment 'Reference to the governing Collective Bargaining Agreement (CBA) under which this franchise operates, dictating salary cap, player rights, and labor relations.' ;
    rdfs:domain ind:League ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CbaAgreement .

ind:gmEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Gm Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: The General Manager is the primary franchise representative for league transactions, trade approvals, CBA negotiations, and roster decisions. Sports-entertainment operations universally track the GM a' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:activeRosterCount rdf:type rdf:Property ;
    rdfs:label 'Active Roster Count' ;
    rdfs:comment 'Number of players currently on the franchise\'s active roster as of the most recent official roster filing snapshot. Must comply with league-mandated roster size limits under the CBA.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agreementEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Agreement Effective Date' ;
    rdfs:comment 'The date from which the current franchise agreement terms become legally binding and operationally effective.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agreementExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Agreement Execution Date' ;
    rdfs:comment 'The date on which the current version of the franchise agreement was formally executed and signed by both the franchise ownership and the league governing body.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agreementExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Agreement Expiry Date' ;
    rdfs:comment 'The date on which the current franchise agreement expires and must be renewed or renegotiated. Null for perpetual agreements.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agreementVersion rdf:type rdf:Property ;
    rdfs:label 'Agreement Version' ;
    rdfs:comment 'Version identifier of the current franchise agreement governing this franchise\'s league membership (e.g., \'v3.2\', \'2022-Amendment-1\'). Tracks which contractual terms are in force.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentHistoryNotes rdf:type rdf:Property ;
    rdfs:label 'Amendment History Notes' ;
    rdfs:comment 'Free-text notes summarizing the history of amendments made to the franchise agreement since its original execution, including amendment dates and key changes. Full amendment documents are stored in the DAM.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplinarySanctionStatus rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Sanction Status' ;
    rdfs:comment 'Current disciplinary sanction status of the franchise as imposed by the league governing body. Tracks active penalties affecting franchise operations, draft eligibility, or competitive standing. [ENUM-REF-CANDIDATE: none|warning_issued|fined|draft_pick_forfeited|suspended|under_investigation — promote to reference product]' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:draftPickOrderPriority rdf:type rdf:Property ;
    rdfs:label 'Draft Pick Order Priority' ;
    rdfs:comment 'The franchise\'s current draft selection order priority for the upcoming league draft, as determined by the prior season\'s standings and any applicable draft pick trades. Lower number = earlier selection.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expansionFeePaid rdf:type rdf:Property ;
    rdfs:label 'Expansion Fee Paid' ;
    rdfs:comment 'The one-time expansion fee paid by the ownership group upon admission of this franchise to the league. Applicable only to expansion franchises; null for original member franchises.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:franchiseStatus rdf:type rdf:Property ;
    rdfs:label 'Franchise Status' ;
    rdfs:comment 'Current operational lifecycle status of the franchise within the league. \'active\' = currently competing; \'suspended\' = temporarily barred from competition; \'defunct\' = no longer operating; \'expansion_pending\' = approved but not yet competing; \'relocated\' = moved to a new market.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuredReserveCount rdf:type rdf:Property ;
    rdfs:label 'Injured Reserve Count' ;
    rdfs:comment 'Number of players currently designated on the Injured Reserve (IR) list in the most recent official roster filing snapshot. Tracks roster compliance and cap implications of IR designations.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isCbaParticipant rdf:type rdf:Property ;
    rdfs:label 'Is Cba Participant' ;
    rdfs:comment 'Indicates whether this franchise is an active participant in the current Collective Bargaining Agreement (CBA). Relevant for salary cap compliance, player relations, and labor dispute governance.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isExpansionFranchise rdf:type rdf:Property ;
    rdfs:label 'Is Expansion Franchise' ;
    rdfs:comment 'Indicates whether this franchise was admitted to the league as an expansion team (True) as opposed to being an original founding member franchise (False). Affects expansion fee tracking and revenue sharing tiers.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketCity rdf:type rdf:Property ;
    rdfs:label 'Market City' ;
    rdfs:comment 'The primary city or metropolitan area in which the franchise is based and markets itself (e.g., \'Kansas City\', \'Los Angeles\', \'New York\'). Used for territorial rights enforcement and market analysis.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketCountryCode rdf:type rdf:Property ;
    rdfs:label 'Market Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the franchise\'s primary market (e.g., \'USA\', \'CAN\', \'GBR\'). Required for international leagues and cross-border regulatory compliance.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipTransferRulesSummary rdf:type rdf:Property ;
    rdfs:label 'Ownership Transfer Rules Summary' ;
    rdfs:comment 'Summary of the key ownership transfer rules applicable to this franchise under the league agreement, including approval thresholds, right-of-first-refusal provisions, and prohibited ownership structures.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceSquadCount rdf:type rdf:Property ;
    rdfs:label 'Practice Squad Count' ;
    rdfs:comment 'Number of players currently on the franchise\'s practice squad as of the most recent official roster filing snapshot. Practice squad limits are defined by the applicable CBA.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:relocationRestrictionExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Relocation Restriction Expiry Date' ;
    rdfs:comment 'The date on which the relocation restriction clause in the franchise agreement expires, after which the franchise may apply to relocate subject to league approval. Null if no restriction or restriction is permanent.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:relocationRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Relocation Restriction Flag' ;
    rdfs:comment 'Indicates whether the franchise agreement contains an active relocation restriction clause (True) preventing the franchise from moving to a new market without league approval during the restriction period.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revenueSharingTier rdf:type rdf:Property ;
    rdfs:label 'Revenue Sharing Tier' ;
    rdfs:comment 'Classification tier that determines this franchise\'s revenue sharing obligations and entitlements under the league\'s revenue distribution model (e.g., national media rights, gate receipts). Tier definitions vary by league.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rosterComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Roster Compliance Status' ;
    rdfs:comment 'Current compliance status of the franchise\'s official roster filing against league rules and CBA requirements. \'compliant\' = all roster limits met; \'non_compliant\' = violation identified; \'under_review\' = league audit in progress; \'waiver_granted\' = exception approved.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rosterSnapshotDate rdf:type rdf:Property ;
    rdfs:label 'Roster Snapshot Date' ;
    rdfs:comment 'The date on which the most recent official roster filing snapshot was captured and submitted to the league for compliance verification.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:salaryCapAllotment rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Allotment' ;
    rdfs:comment 'The maximum total player salary expenditure permitted for this franchise in the current league season under the applicable CBA salary cap rules. Expressed in USD.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:teamNickname rdf:type rdf:Property ;
    rdfs:label 'Team Nickname' ;
    rdfs:comment 'The publicly recognized team nickname or mascot name (e.g., \'Chiefs\', \'Lakers\', \'Yankees\'). Used in fan-facing communications, broadcasting, and merchandise.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territorialRightsDescription rdf:type rdf:Property ;
    rdfs:label 'Territorial Rights Description' ;
    rdfs:comment 'Narrative description of the exclusive geographic territory granted to this franchise under its league membership agreement, defining the protected market area within which no other franchise may operate.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationEstimate rdf:type rdf:Property ;
    rdfs:label 'Valuation Estimate' ;
    rdfs:comment 'Most recent estimated market valuation of the franchise in USD, as reported by the league or a recognized financial publication (e.g., Forbes). Used for ownership transfer approvals, expansion fee benchmarking, and financial reporting.' ;
    rdfs:domain ind:Franchise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:franchiseAgreementId rdf:type rdf:Property ;
    rdfs:label 'Franchise Agreement Id' ;
    rdfs:comment 'Unique surrogate identifier for the franchise agreement record in the league data domain. Primary key for this entity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FranchiseAgreement .

ind:agreementNotes rdf:type rdf:Property ;
    rdfs:label 'Agreement Notes' ;
    rdfs:comment 'Free-text field for capturing material notes, special conditions, side-letter references, or amendment summaries associated with this franchise agreement. Intended for legal and compliance team use.' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceAuditFrequency rdf:type rdf:Property ;
    rdfs:label 'Compliance Audit Frequency' ;
    rdfs:comment 'The contractually mandated frequency at which the league may conduct compliance audits of the franchise\'s financial records, roster compliance, and CBA adherence under this agreement.' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expansionFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Expansion Fee Amount' ;
    rdfs:comment 'The one-time expansion or entry fee paid by the franchise owner to the league upon admission as a new franchise member, denominated in the currency specified by expansion_fee_currency_code. Applicable only for expansion franchises.' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expansionFeeCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Expansion Fee Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the expansion fee amount (e.g., USD, EUR, GBP). Ensures consistent financial reporting across multi-currency league structures.' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingLawJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Governing Law Jurisdiction' ;
    rdfs:comment 'The legal jurisdiction whose laws govern interpretation and enforcement of this franchise agreement (e.g., US state code or country ISO-3166 alpha-3 code such as USA, GBR, DEU). Relevant for dispute resolution and regulatory compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipOwnershipClause rdf:type rdf:Property ;
    rdfs:label 'Ip Ownership Clause' ;
    rdfs:comment 'Defines the Intellectual Property (IP) ownership arrangement for team marks, logos, and branding assets under this agreement. Determines DRM and licensing rights for merchandise, content, and sponsorship activations.' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAmendmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Amendment Date' ;
    rdfs:comment 'The date on which the most recent formal amendment to this franchise agreement was executed. Used to track amendment recency and trigger compliance review workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nilRightsClause rdf:type rdf:Property ;
    rdfs:label 'Nil Rights Clause' ;
    rdfs:comment 'Specifies the contractual arrangement governing Name, Image, and Likeness (NIL) rights for athletes under this franchise agreement, determining who controls and monetises athlete NIL at the franchise level.' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipTransferApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Ownership Transfer Approval Required' ;
    rdfs:comment 'Indicates whether any transfer of ownership interest in the franchise requires prior written approval from the league under the terms of this agreement. True = league approval required; False = transfer permitted without prior approval.' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ownershipTransferMinApprovalPct rdf:type rdf:Property ;
    rdfs:label 'Ownership Transfer Min Approval Pct' ;
    rdfs:comment 'The minimum percentage of ownership interest that triggers the league approval requirement for an ownership transfer, as specified in this agreement (e.g., 5.00 = any transfer of 5% or more requires approval).' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pciDssComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Pci Dss Compliance Required' ;
    rdfs:comment 'Indicates whether this franchise agreement mandates PCI-DSS (Payment Card Industry Data Security Standard) compliance for all franchise-operated point-of-sale and ticketing payment systems.' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Penalty Clause Flag' ;
    rdfs:comment 'Indicates whether this franchise agreement contains explicit financial penalty clauses for breach of agreement terms (e.g., salary cap violations, territorial infringement, CBA non-compliance). True = penalty clauses present.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalOptionTermYears rdf:type rdf:Property ;
    rdfs:label 'Renewal Option Term Years' ;
    rdfs:comment 'The number of years by which the franchise agreement may be extended if the renewal option is exercised. Nullable when no renewal option exists.' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revenueSharingRate rdf:type rdf:Property ;
    rdfs:label 'Revenue Sharing Rate' ;
    rdfs:comment 'The contractual percentage rate (expressed as a decimal, e.g., 0.3400 = 34%) of league-wide shared revenues allocated to this franchise under the revenue sharing provisions of this agreement. Drives financial planning and CBA compliance.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salaryCapObligation rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Obligation' ;
    rdfs:comment 'The maximum total player salary expenditure permitted for this franchise under the salary cap provisions of this agreement, denominated in the applicable currency. Supports CBA compliance monitoring and roster financial management.' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:territorialExclusivityRadiusKm rdf:type rdf:Property ;
    rdfs:label 'Territorial Exclusivity Radius Km' ;
    rdfs:comment 'The radius in kilometres around the franchise\'s home market within which no competing franchise of the same league may operate, as defined in the territorial rights clause of this agreement.' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:territorialMarket rdf:type rdf:Property ;
    rdfs:label 'Territorial Market' ;
    rdfs:comment 'The designated geographic market (city, metropolitan area, or region) in which the franchise holds exclusive territorial rights under this agreement. Defines the protected territory for ticket sales, local broadcast, and sponsorship.' ;
    rdfs:domain ind:FranchiseAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:losingTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Losing Team Franchise Id' ;
    rdfs:comment 'Reference to the franchise or team entity that lost the game. Null for draws or no-contest results. Used in standings and franchise performance reporting.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:primaryGameFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Primary Game Franchise Id' ;
    rdfs:comment 'Reference to the home franchise or team entity participating in this game. Used for standings calculations and franchise performance reporting.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:protestFilingTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Protest Filing Team Franchise Id' ;
    rdfs:comment 'Reference to the franchise or team entity that filed the formal protest against this result. Null if no protest has been filed. Used in disciplinary case management.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:quaternaryGameLosingTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Quaternary Game Losing Team Franchise Id' ;
    rdfs:comment 'Reference to the franchise or team entity that lost the game. Null for draws or no-contest results. Used in standings and franchise performance reporting.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:quinaryGameProtestFilingTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Quinary Game Protest Filing Team Franchise Id' ;
    rdfs:comment 'Reference to the franchise or team entity that filed the formal protest against this result. Null if no protest has been filed. Used in disciplinary case management.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:tertiaryGameWinningTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Game Winning Team Franchise Id' ;
    rdfs:comment 'Reference to the franchise or team entity that won the game. Null for draws or no-contest results. Primary input for win-loss standings calculations.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:disciplinaryActionFlag rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Action Flag' ;
    rdfs:comment 'Indicates whether any disciplinary action (red card, ejection, fine, suspension) was issued during or as a result of this game (True) or not (False). Triggers downstream disciplinary record creation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gameDate rdf:type rdf:Property ;
    rdfs:label 'Game Date' ;
    rdfs:comment 'Calendar date on which the game was played. Principal business event date used for standings calculations, scheduling, and broadcast rights reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gameEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Game End Timestamp' ;
    rdfs:comment 'Precise date and time (ISO 8601 with timezone offset) when the game officially concluded, including all overtime or shootout periods. Used for broadcast rights reconciliation and venue operations.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:gameStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Game Start Timestamp' ;
    rdfs:comment 'Precise date and time (ISO 8601 with timezone offset) when the game officially commenced. Used for broadcast scheduling, OTT streaming rights windows, and operational reporting.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isDraw rdf:type rdf:Property ;
    rdfs:label 'Is Draw' ;
    rdfs:comment 'Indicates whether the game ended in a draw or tie (True) or produced a winner (False). Applicable in sports that allow draws such as MLS, FIFA, and some NHL regular season formats.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:officialAttendance rdf:type rdf:Property ;
    rdfs:label 'Official Attendance' ;
    rdfs:comment 'Officially certified number of spectators in attendance at the venue as reported to the league office. Used for franchise reporting, venue capacity compliance, and fan engagement analytics.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overtimePeriodsPlayed rdf:type rdf:Property ;
    rdfs:label 'Overtime Periods Played' ;
    rdfs:comment 'Number of overtime or extra-time periods played beyond regulation. Zero if the game was decided in regulation. Used for game duration analytics and broadcast scheduling.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:protestFlag rdf:type rdf:Property ;
    rdfs:label 'Protest Flag' ;
    rdfs:comment 'Indicates whether a formal protest has been filed against this game result by either participating franchise (True) or not (False). Triggers league disciplinary and review workflows.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:protestReason rdf:type rdf:Property ;
    rdfs:label 'Protest Reason' ;
    rdfs:comment 'Brief description of the grounds on which the formal protest was filed (e.g., officiating error, ineligible player, rule violation). Null if no protest filed.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Result Reference Number' ;
    rdfs:comment 'Externally-known official result reference number assigned by the league office. Used for regulatory filings, media distribution, and official record-keeping across NFL, NBA, MLB, NHL, MLS, and FIFA.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultType rdf:type rdf:Property ;
    rdfs:label 'Result Type' ;
    rdfs:comment 'Classification of how the game result was determined. \'regulation\' indicates decided within standard playing time. \'overtime\' indicates decided in extra time/OT periods. \'shootout\' indicates decided by penalty shootout or shootout format (NHL/MLS/FIFA). \'forfeit\' indicates awarded due to a team\'s failure to compete. \'no_contest\' indicates the game was declared void without a winner.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tmoInterventionFlag rdf:type rdf:Property ;
    rdfs:label 'Tmo Intervention Flag' ;
    rdfs:comment 'Indicates whether a Television Match Official (TMO) review was invoked during the game (True) or not (False). Applicable to rugby and other sports using TMO protocols. Supports officiating quality review.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:varInterventionFlag rdf:type rdf:Property ;
    rdfs:label 'Var Intervention Flag' ;
    rdfs:comment 'Indicates whether a Video Assistant Referee (VAR) intervention occurred during the game (True) or not (False). Applicable to sports using VAR technology such as FIFA, MLS, and NFL replay review. Supports officiating quality review and competitive integrity reporting.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:venueCapacity rdf:type rdf:Property ;
    rdfs:label 'Venue Capacity' ;
    rdfs:comment 'Total certified seating and standing capacity of the venue at the time of the game. Used to calculate attendance utilization rate and for regulatory compliance reporting.' ;
    rdfs:domain ind:GameResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentFederationInternationalFederationId rdf:type rdf:Property ;
    rdfs:label 'Parent Federation International Federation Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the parent international federation in the governance hierarchy (e.g., a continental confederation\'s parent is the global federation such as FIFA). Null for apex governing bodies with no parent.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InternationalFederation .

ind:antiDopingProgram rdf:type rdf:Property ;
    rdfs:label 'Anti Doping Program' ;
    rdfs:comment 'Name or description of the federation\'s anti-doping testing and enforcement program (e.g., FIFA Anti-Doping Regulations, IOC Anti-Doping Rules, USADA partnership). Captures the specific program framework governing PED testing for athletes under this federation.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastRightsModel rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Model' ;
    rdfs:comment 'Model governing how broadcast and media rights are sold and distributed for competitions under this federation. Centralized means the federation sells rights collectively; decentralized means clubs/teams sell individually; hybrid is a combination. Drives revenue sharing and OTT/DTC platform strategy.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:casArbitrationAccepted rdf:type rdf:Property ;
    rdfs:label 'Cas Arbitration Accepted' ;
    rdfs:comment 'Indicates whether this federation accepts the Court of Arbitration for Sport (CAS) as the final arbitration authority for disputes, appeals, and disciplinary rulings. Required for IOC-recognized federations and FIFA member associations.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:competitionCycleYears rdf:type rdf:Property ;
    rdfs:label 'Competition Cycle Years' ;
    rdfs:comment 'Frequency in years at which the federation\'s primary championship competition is held (e.g., 4 for FIFA World Cup and Olympic Games, 2 for UEFA European Championship, 1 for annual leagues). Drives broadcast rights deal structuring and revenue planning.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contactEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Email' ;
    rdfs:comment 'Official organizational contact email address for the federation\'s administrative or media relations office. Used for regulatory correspondence, broadcast rights negotiations, and partnership communications. Classified as confidential organizational contact data.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Phone' ;
    rdfs:comment 'Official organizational telephone number for the federation\'s headquarters or administrative office. Used for regulatory correspondence and partnership communications. Classified as confidential organizational contact data.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federationCode rdf:type rdf:Property ;
    rdfs:label 'Federation Code' ;
    rdfs:comment 'Externally-known short alphanumeric code uniquely identifying the federation across systems and partner integrations (e.g., FIFA, IOC, FIBA, ICC, WA). Used as the business key in cross-system references and broadcast rights agreements.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federationStatus rdf:type rdf:Property ;
    rdfs:label 'Federation Status' ;
    rdfs:comment 'Current lifecycle status of the international federation record. Active indicates full governance authority; suspended indicates temporary loss of rights (e.g., due to government interference per FIFA Statutes Article 14); dissolved indicates permanent cessation; provisional indicates conditional membership; observer indicates non-voting participation.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federationType rdf:type rdf:Property ;
    rdfs:label 'Federation Type' ;
    rdfs:comment 'Organizational classification of the federation entity distinguishing governing bodies (FIFA, IOC), confederations (UEFA, CONCACAF), national associations, unions (e.g., rugby unions), committees (Olympic committees), and councils.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialFairPlayApplicable rdf:type rdf:Property ;
    rdfs:label 'Financial Fair Play Applicable' ;
    rdfs:comment 'Indicates whether this federation enforces Financial Fair Play (FFP) or financial sustainability regulations requiring clubs/franchises to balance revenues against expenditures. Applicable primarily to UEFA and FIFA-affiliated competitions.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geographicCoverageRegion rdf:type rdf:Property ;
    rdfs:label 'Geographic Coverage Region' ;
    rdfs:comment 'Primary geographic region or continent under the federation\'s jurisdiction (e.g., Europe for UEFA, North/Central America and Caribbean for CONCACAF, Global for FIFA/IOC). Used for broadcast rights territory mapping and regulatory compliance routing.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governanceAuthorityScope rdf:type rdf:Property ;
    rdfs:label 'Governance Authority Scope' ;
    rdfs:comment 'Narrative description of the federation\'s governance mandate and authority scope, including rule-making powers, competition sanctioning authority, disciplinary jurisdiction, anti-doping oversight, and IP rights management. Captures the breadth of regulatory control.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:iocRecognized rdf:type rdf:Property ;
    rdfs:label 'Ioc Recognized' ;
    rdfs:comment 'Indicates whether this international federation holds official recognition from the International Olympic Committee (IOC), which is required for inclusion in the Olympic Games programme and access to IOC funding and governance frameworks.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ipOwnershipPolicy rdf:type rdf:Property ;
    rdfs:label 'Ip Ownership Policy' ;
    rdfs:comment 'Summary of the federation\'s Intellectual Property (IP) ownership policy covering trademarks, logos, competition names, broadcast footage, and Digital Rights Management (DRM) frameworks. Governs licensing agreements with broadcasters, sponsors, and merchandise partners.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionLevel rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Level' ;
    rdfs:comment 'Hierarchical governance scope of the federation indicating whether it operates at a global (e.g., FIFA, IOC), continental (e.g., UEFA, CONCACAF), regional, national, or sub-national level. Drives hierarchy traversal and authority scope determination.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberAssociationCount rdf:type rdf:Property ;
    rdfs:label 'Member Association Count' ;
    rdfs:comment 'Total number of member associations, national federations, or affiliated bodies currently recognized under this federation\'s governance authority. For FIFA this is 211 member associations. Used for governance scope reporting and voting rights calculations.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:membershipEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Membership Effective Date' ;
    rdfs:comment 'Date on which this federation\'s membership or recognition status became effective within the Sports Entertainment governance hierarchy. Marks the start of the federation\'s active governance relationship for compliance and reporting purposes.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextCongressDate rdf:type rdf:Property ;
    rdfs:label 'Next Congress Date' ;
    rdfs:comment 'Scheduled date of the federation\'s next congress, general assembly, or governing body meeting where rule changes, elections, and major governance decisions are made. Used for event planning, broadcast scheduling, and stakeholder communications.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:officialLanguages rdf:type rdf:Property ;
    rdfs:label 'Official Languages' ;
    rdfs:comment 'Comma-separated list of ISO 639-1 language codes for all official languages recognized by the federation for governance, rulebooks, and official communications (e.g., \'en,fr,es,de,ar,ru\' for FIFA). Supports multilingual content distribution and regulatory compliance.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officialName rdf:type rdf:Property ;
    rdfs:label 'Official Name' ;
    rdfs:comment 'Full legal and official name of the international sports governing body as registered with the relevant national or international authority (e.g., Fédération Internationale de Football Association, International Olympic Committee).' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCompetition rdf:type rdf:Property ;
    rdfs:label 'Primary Competition' ;
    rdfs:comment 'Name of the flagship competition or championship event sanctioned and governed by this federation (e.g., FIFA World Cup, Olympic Games, ICC Cricket World Cup, ATP Finals, UEFA Champions League). Central to broadcast rights and sponsorship valuation.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Primary Language Code' ;
    rdfs:comment 'ISO 639-1 or ISO 639-2 language code for the federation\'s primary official working language (e.g., en for English, fr for French, es for Spanish). Drives localization of broadcast content, official communications, and fan engagement platforms.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recognitionBody rdf:type rdf:Property ;
    rdfs:label 'Recognition Body' ;
    rdfs:comment 'Name of the apex authority that officially recognizes this federation\'s governance legitimacy (e.g., IOC recognition for Olympic sports federations, FIFA recognition for continental confederations). Critical for determining competition sanctioning validity.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryCapPolicy rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Policy' ;
    rdfs:comment 'Federation-level salary cap framework applicable to member leagues and clubs under this federation\'s governance. Hard cap enforces absolute limits; soft cap allows exceptions with penalties; luxury tax applies financial penalties above threshold; none indicates no cap; not_applicable for federations without professional player contracts.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statutesEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Statutes Effective Date' ;
    rdfs:comment 'Date on which the current version of the federation\'s governing statutes or constitution came into force. Used for rule enforcement, disciplinary proceedings, and compliance audit trails.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statutesVersion rdf:type rdf:Property ;
    rdfs:label 'Statutes Version' ;
    rdfs:comment 'Version identifier of the federation\'s current governing statutes or constitution (e.g., \'FIFA Statutes 2023 Edition\', \'IOC Charter 2021\'). Used for compliance tracking, rule enforcement, and disciplinary action referencing.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varTmoPolicy rdf:type rdf:Property ;
    rdfs:label 'Var Tmo Policy' ;
    rdfs:comment 'Federation-level policy governing the use of Video Assistant Referee (VAR) or Television Match Official (TMO) technology in sanctioned competitions. Mandatory indicates all competitions must use VAR/TMO; optional allows competition-level discretion; prohibited bans use; not_applicable for non-applicable sports.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wadaSignatory rdf:type rdf:Property ;
    rdfs:label 'Wada Signatory' ;
    rdfs:comment 'Indicates whether this federation is a signatory to the World Anti-Doping Agency (WADA) Code, obligating it to implement anti-doping programs, testing protocols, and Performance Enhancing Drug (PED) suspension rules across its member associations.' ;
    rdfs:domain ind:InternationalFederation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryGoverningBodyId rdf:type rdf:Property ;
    rdfs:label 'Primary Governing Body Id' ;
    rdfs:comment 'Foreign key linking to compliance.governing_body. Business justification: Every professional sports league operates under a primary regulatory/governing body (e.g., state athletic commissions, FCC for broadcast, anti-doping authorities). Linking league to its primary govern' ;
    rdfs:domain ind:League ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GoverningBody .

ind:antiDopingBody rdf:type rdf:Property ;
    rdfs:label 'Anti Doping Body' ;
    rdfs:comment 'Name of the anti-doping authority responsible for testing and enforcement within this league (e.g., WADA, USADA, UKAD). Determines PED (Performance Enhancing Drug) testing protocols and suspension adjudication processes.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbaExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Cba Expiry Date' ;
    rdfs:comment 'Date on which the current Collective Bargaining Agreement between the league and its players\' association expires. Critical for labor relations planning, salary cap projections, and franchise agreement renewals.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:championshipName rdf:type rdf:Property ;
    rdfs:label 'Championship Name' ;
    rdfs:comment 'Official name of the league\'s championship event or trophy (e.g., \'Super Bowl\', \'NBA Finals\', \'World Series\', \'Stanley Cup Finals\', \'MLS Cup\'). Used in broadcast rights agreements, sponsorship contracts, merchandise licensing, and fan engagement campaigns.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:draftEnabled rdf:type rdf:Property ;
    rdfs:label 'Draft Enabled' ;
    rdfs:comment 'Indicates whether this league conducts an annual player draft for team roster building. Drives draft scheduling, eligibility tracking, and scouting report workflows.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:draftRoundCount rdf:type rdf:Property ;
    rdfs:label 'Draft Round Count' ;
    rdfs:comment 'Total number of rounds in the league\'s annual player draft. Null if draft_enabled is false. Used for draft scheduling, pick tracking, and athlete eligibility management.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expansionTeamCount rdf:type rdf:Property ;
    rdfs:label 'Expansion Team Count' ;
    rdfs:comment 'Number of expansion franchises currently approved but not yet fully operational within the league. Used for franchise agreement tracking, revenue sharing projections, and stadium development planning.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gamesPerTeamPerSeason rdf:type rdf:Property ;
    rdfs:label 'Games Per Team Per Season' ;
    rdfs:comment 'Standard number of regular season games each team plays per season (e.g., 17 for NFL, 82 for NBA, 162 for MLB, 82 for NHL, 34 for MLS). Drives fixture scheduling, broadcast slot allocation, and ticket inventory planning.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ipOwnerEntity rdf:type rdf:Property ;
    rdfs:label 'Ip Owner Entity' ;
    rdfs:comment 'Legal entity name that holds the IP (Intellectual Property) rights for the league\'s brand, marks, and content (e.g., \'NFL Properties LLC\', \'NBA Properties Inc.\'). Critical for DRM (Digital Rights Management) enforcement, licensing agreements, and SOX IP asset reporting.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numConferences rdf:type rdf:Property ;
    rdfs:label 'Num Conferences' ;
    rdfs:comment 'Total number of conferences within the league hierarchy. Relevant for playoff bracket construction, revenue distribution, and broadcast rights packaging.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numDivisions rdf:type rdf:Property ;
    rdfs:label 'Num Divisions' ;
    rdfs:comment 'Total number of competitive divisions within the league structure. Drives standings calculations, playoff qualification rules, and scheduling algorithms.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numTeams rdf:type rdf:Property ;
    rdfs:label 'Num Teams' ;
    rdfs:comment 'Total number of franchised or member teams currently active in the league. Used for scheduling, revenue sharing calculations, playoff seeding, and expansion planning.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:officiatingBody rdf:type rdf:Property ;
    rdfs:label 'Officiating Body' ;
    rdfs:comment 'Name of the organization or department responsible for recruiting, training, assigning, and evaluating match officials within this league (e.g., \'NFL Officiating Department\', \'NBA Referee Operations\', \'FIFA Referees Committee\').' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ottPlatformName rdf:type rdf:Property ;
    rdfs:label 'Ott Platform Name' ;
    rdfs:comment 'Name of the league\'s owned or primary OTT (Over-The-Top Streaming) DTC (Direct-To-Consumer) streaming platform (e.g., \'NFL+\', \'NBA League Pass\', \'MLB.TV\'). Drives digital content distribution, ARPU tracking, and fan engagement analytics.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueSharingModel rdf:type rdf:Property ;
    rdfs:label 'Revenue Sharing Model' ;
    rdfs:comment 'Model used to distribute league-level revenues (broadcast rights, sponsorship, merchandise licensing) among member franchises. Drives financial planning, EBITDA reporting, and franchise valuation analytics.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryCapEnabled rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Enabled' ;
    rdfs:comment 'Indicates whether this league enforces a salary cap on team payrolls. Drives salary cap compliance tracking, CBA enforcement, and athlete contract validation within the athlete.salary_cap_entry domain.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxExemptStatus rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Status' ;
    rdfs:comment 'Indicates whether the league operates as a tax-exempt organization under applicable tax law (e.g., 501(c)(6) in the USA). Impacts financial reporting, SAP FI/CO configuration, and SOX compliance controls.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backgroundCheckDate rdf:type rdf:Property ;
    rdfs:label 'Background Check Date' ;
    rdfs:comment 'Date on which the most recent background check and integrity screening was completed for this official. Used to ensure compliance with league-mandated periodic screening intervals.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:badgeNumber rdf:type rdf:Property ;
    rdfs:label 'Badge Number' ;
    rdfs:comment 'Externally-known unique badge or credential number assigned by the officiating body to identify the official on the field and in league records. Serves as the business-facing identifier across game sheets, broadcast graphics, and disciplinary filings.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationTier rdf:type rdf:Property ;
    rdfs:label 'Certification Tier' ;
    rdfs:comment 'Officiating certification level awarded by the officiating body, reflecting demonstrated competency, experience, and performance evaluations. Determines eligibility for playoff, championship, and international assignments.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplinaryFlag rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Flag' ;
    rdfs:comment 'Indicates whether the official currently has an open disciplinary matter, investigation, or formal review initiated by the officiating bureau or league governance body. When True, assignment eligibility may be restricted pending resolution.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gamesOfficiatedCareer rdf:type rdf:Property ;
    rdfs:label 'Games Officiated Career' ;
    rdfs:comment 'Cumulative total number of professional games officiated across the official\'s entire career. Used for milestone recognition, Hall of Fame eligibility, and historical analytics.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gamesOfficiatedSeason rdf:type rdf:Property ;
    rdfs:label 'Games Officiated Season' ;
    rdfs:comment 'Count of games officiated by this official in the current season. Used for workload management, assignment balancing, and CBA-mandated minimum/maximum game thresholds.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:integrityClearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Integrity Clearance Status' ;
    rdfs:comment 'Current competitive integrity clearance status issued by the league\'s integrity and compliance unit. Reflects background check outcomes, betting prohibition compliance, and conflict-of-interest reviews. Critical for assignment eligibility and regulatory reporting.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalEligible rdf:type rdf:Property ;
    rdfs:label 'International Eligible' ;
    rdfs:comment 'Indicates whether the official is cleared for international competition assignments (e.g., FIFA World Cup, Olympic Games, international friendlies). Requires FIFA/IOC certification and compliance with neutrality rules.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languageCodes rdf:type rdf:Property ;
    rdfs:label 'Language Codes' ;
    rdfs:comment 'Comma-separated ISO 639-1 language codes representing languages spoken by the official. Relevant for international assignment eligibility, player communication in multilingual competitions, and VAR communication protocols.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officialStatus rdf:type rdf:Property ;
    rdfs:label 'Official Status' ;
    rdfs:comment 'Current lifecycle status of the official within the officiating bureau. Drives eligibility for game assignments, payroll processing, and compliance reporting. \'suspended\' indicates a disciplinary or investigative hold; \'probation\' indicates conditional active status under performance review.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceRatingSeason rdf:type rdf:Property ;
    rdfs:label 'Performance Rating Season' ;
    rdfs:comment 'The league season identifier (e.g., \'2024-25\') for which the current performance rating applies. Ensures ratings are interpreted in the correct seasonal context for year-over-year trend analysis.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:playoffEligible rdf:type rdf:Property ;
    rdfs:label 'Playoff Eligible' ;
    rdfs:comment 'Indicates whether the official is currently eligible for postseason, playoff, or championship game assignments based on performance ratings, certification tier, and disciplinary standing. Managed by the officiating bureau\'s assignment committee.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:professionalDebutDate rdf:type rdf:Property ;
    rdfs:label 'Professional Debut Date' ;
    rdfs:comment 'Date on which the official first officiated a professional-level game under the current or a predecessor officiating body. Establishes the official\'s career start point for seniority, pension, and historical record purposes.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:roleType rdf:type rdf:Property ;
    rdfs:label 'Role Type' ;
    rdfs:comment 'Categorical classification of the officiating role performed by this individual. Determines crew position, authority scope, and applicable rule sets. [ENUM-REF-CANDIDATE: referee|umpire|linesman|line_judge|var_operator|tmo|fourth_official|video_review_official — promote to reference product]' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tmoCertified rdf:type rdf:Property ;
    rdfs:label 'Tmo Certified' ;
    rdfs:comment 'Indicates whether the official holds a current TMO (Television Match Official) certification, qualifying them for video review assignments in rugby and other applicable sports.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uniformNumber rdf:type rdf:Property ;
    rdfs:label 'Uniform Number' ;
    rdfs:comment 'Numeric identifier displayed on the official\'s uniform during games, used for broadcast identification, fan-facing graphics, and post-game incident reporting (e.g., \'Official #54 issued the penalty\').' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varCertified rdf:type rdf:Property ;
    rdfs:label 'Var Certified' ;
    rdfs:comment 'Indicates whether the official holds a current VAR (Video Assistant Referee) certification, qualifying them for VAR room assignments in applicable competitions. Governed by FIFA VAR certification protocols and equivalent league standards.' ;
    rdfs:domain ind:Official ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:yearsOfExperience rdf:type rdf:Property ;
    rdfs:label 'Years Of Experience' ;
    rdfs:comment 'Total number of years the official has been actively officiating at any professional or sanctioned level. Used for certification tier assessments, playoff eligibility criteria, and performance benchmarking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryOfficiatingFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Primary Officiating Franchise Id' ;
    rdfs:comment 'Reference to the home team franchise participating in the game for which this crew is assigned. Used in conflict-of-interest screening to verify no crew member has a disqualifying relationship with the home franchise.' ;
    rdfs:domain ind:OfficiatingCrew ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:varOperatorOfficialId rdf:type rdf:Property ;
    rdfs:label 'Var Operator Official Id' ;
    rdfs:comment 'Reference to the certified official designated as the VAR operator for this game. Null when VAR is not enabled. Required for post-game VAR decision audit trails and officiating quality management.' ;
    rdfs:domain ind:OfficiatingCrew ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Official .

ind:broadcastCrewNotified rdf:type rdf:Property ;
    rdfs:label 'Broadcast Crew Notified' ;
    rdfs:comment 'Indicates whether the broadcast production team has been notified of the officiating crew composition for this game. Required for on-air graphics, commentator briefings, and RSN/OTT broadcast compliance.' ;
    rdfs:domain ind:OfficiatingCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conflictOfInterestCleared rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Cleared' ;
    rdfs:comment 'Indicates whether all officials in this crew have passed the conflict-of-interest screening process for this specific game assignment (e.g., no personal or financial ties to participating teams or athletes). Mandatory for competitive integrity compliance.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conflictReviewDate rdf:type rdf:Property ;
    rdfs:label 'Conflict Review Date' ;
    rdfs:comment 'The date on which the conflict-of-interest screening was completed for this crew assignment. Provides audit trail for competitive integrity and league governance compliance.' ;
    rdfs:domain ind:OfficiatingCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:crewCode rdf:type rdf:Property ;
    rdfs:label 'Crew Code' ;
    rdfs:comment 'Externally-known alphanumeric code assigned by the officiating body to uniquely identify this crew unit across seasons and leagues. Used in broadcast graphics, officiating body databases, and CBA compliance reporting.' ;
    rdfs:domain ind:OfficiatingCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewName rdf:type rdf:Property ;
    rdfs:label 'Crew Name' ;
    rdfs:comment 'Human-readable name or designation for the officiating crew, typically derived from the crew chief\'s surname (e.g., \'Johnson Crew\'). Used in scheduling systems, broadcast communications, and officiating quality reports.' ;
    rdfs:domain ind:OfficiatingCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewSize rdf:type rdf:Property ;
    rdfs:label 'Crew Size' ;
    rdfs:comment 'Total number of officials assigned to this crew for the designated game. Varies by sport and competition level (e.g., 7 for NFL, 3 for NBA, 4 for MLB, 4 for NHL, 4 for soccer). Used for scheduling completeness validation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:incidentFlag rdf:type rdf:Property ;
    rdfs:label 'Incident Flag' ;
    rdfs:comment 'Indicates whether a notable officiating incident (e.g., disputed call, ejection, rule misapplication, protest) was recorded during this game assignment. Triggers mandatory review workflow and may initiate disciplinary proceedings.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performanceEvalDate rdf:type rdf:Property ;
    rdfs:label 'Performance Eval Date' ;
    rdfs:comment 'The date on which the post-game performance evaluation was completed for this crew. Used to track evaluation turnaround times and ensure compliance with officiating body SLA requirements.' ;
    rdfs:domain ind:OfficiatingCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceEvalStatus rdf:type rdf:Property ;
    rdfs:label 'Performance Eval Status' ;
    rdfs:comment 'Current status of the post-game performance evaluation for this crew assignment. Drives officiating quality management workflows and informs future assignment eligibility and certification tier reviews.' ;
    rdfs:domain ind:OfficiatingCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceScore rdf:type rdf:Property ;
    rdfs:label 'Performance Score' ;
    rdfs:comment 'Composite numeric score (0.00–100.00) assigned to the crew following post-game evaluation by the officiating body\'s grading panel. Reflects accuracy of calls, game management, and rule application. Used for assignment eligibility and certification tier reviews.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:substitutionFlag rdf:type rdf:Property ;
    rdfs:label 'Substitution Flag' ;
    rdfs:comment 'Indicates whether one or more officials in this crew were substituted after the original assignment was made (e.g., due to injury, conflict-of-interest discovery, or disciplinary action). Triggers substitution audit trail.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:substitutionReason rdf:type rdf:Property ;
    rdfs:label 'Substitution Reason' ;
    rdfs:comment 'Categorical reason for any official substitution within this crew after initial assignment. Populated only when substitution_flag is True. Used in officiating body reporting and CBA compliance audits.' ;
    rdfs:domain ind:OfficiatingCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:travelRequired rdf:type rdf:Property ;
    rdfs:label 'Travel Required' ;
    rdfs:comment 'Indicates whether this crew assignment requires travel outside the crew\'s home geographic region. Triggers travel expense authorization workflows and CBA travel provision compliance checks.' ;
    rdfs:domain ind:OfficiatingCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastRightsPackageMediaRightsDealId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Package Media Rights Deal Id' ;
    rdfs:comment 'Reference to the broadcast and media rights package governing playoff coverage, including OTT, RSN, PPV, and DTC distribution rights for this bracket\'s games.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MediaRightsDeal .

ind:championshipVenueId rdf:type rdf:Property ;
    rdfs:label 'Championship Venue Id' ;
    rdfs:comment 'Reference to the pre-designated venue for the championship game or final series, applicable when neutral_site_final is true. Used for venue operations, ticketing, and broadcast planning.' ;
    rdfs:domain ind:League ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Venue .

ind:mvpAthleteAthleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Mvp Athlete Athlete Profile Id' ;
    rdfs:comment 'Reference to the athlete awarded the Most Valuable Player (MVP) honor for the playoff bracket/championship series. Populated upon bracket completion. Drives NIL, sponsorship, and award management processes.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:primaryPlayoffChampionFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Primary Playoff Champion Franchise Id' ;
    rdfs:comment 'Reference to the franchise that won the championship in this playoff bracket. Populated only upon bracket completion. Used for historical records, trophy management, and league governance reporting.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:bracketEndDate rdf:type rdf:Property ;
    rdfs:label 'Bracket End Date' ;
    rdfs:comment 'Calendar date on which the final championship game is scheduled or was completed. Used for season close-out, financial reporting, and broadcast rights expiry.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bracketNotes rdf:type rdf:Property ;
    rdfs:label 'Bracket Notes' ;
    rdfs:comment 'Free-text field for league administrators to record special circumstances, rule exceptions, force-majeure events, or governance decisions affecting this playoff bracket (e.g., COVID-19 bubble format, relocated games).' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bracketRegion rdf:type rdf:Property ;
    rdfs:label 'Bracket Region' ;
    rdfs:comment 'Geographic or organizational region label for the bracket (e.g., \'AFC\', \'NFC\', \'Eastern Conference\', \'Western Conference\', \'Americas\', \'Europe\'). Used for multi-region league structures and broadcast rights segmentation.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bracketStartDate rdf:type rdf:Property ;
    rdfs:label 'Bracket Start Date' ;
    rdfs:comment 'Calendar date on which the first playoff game in this bracket is scheduled to be played. Used for scheduling, ticketing, and broadcast rights activation.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:byeRoundsCount rdf:type rdf:Property ;
    rdfs:label 'Bye Rounds Count' ;
    rdfs:comment 'Number of first-round byes awarded to top-seeded teams. A value of 0 indicates no byes are granted. Bye rules are defined in the league\'s CBA and playoff format documentation.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:championshipGameName rdf:type rdf:Property ;
    rdfs:label 'Championship Game Name' ;
    rdfs:comment 'Official branded name of the final championship game or series in this bracket (e.g., \'Super Bowl\', \'NBA Finals\', \'Stanley Cup Finals\', \'World Series\'). Used in broadcast, sponsorship, and fan engagement contexts.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conferenceDivisionScope rdf:type rdf:Property ;
    rdfs:label 'Conference Division Scope' ;
    rdfs:comment 'Organizational scope of the bracket indicating whether it covers the full league, a single conference, a division, or a wild-card pool. Drives seeding and matchup logic.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplinaryReviewBody rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Review Body' ;
    rdfs:comment 'Name of the governing body or panel responsible for adjudicating disciplinary actions, appeals, and rule enforcement during this playoff bracket (e.g., \'NFL Commissioner\'s Office\', \'NBA Basketball Operations\', \'CAS\').' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeAdvantageRule rdf:type rdf:Property ;
    rdfs:label 'Home Advantage Rule' ;
    rdfs:comment 'Rule governing which team hosts home games in a series. \'higher_seed\' awards home games to the better-seeded team; \'predetermined\' uses a fixed schedule; \'neutral_site\' applies to championship games; \'alternating\' rotates home games.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:neutralSiteFinal rdf:type rdf:Property ;
    rdfs:label 'Neutral Site Final' ;
    rdfs:comment 'Indicates whether the championship game/series final is played at a pre-selected neutral venue rather than the higher seed\'s home venue. True for events like the Super Bowl, FIFA World Cup Final, and NBA All-Star Game.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ppvApplicable rdf:type rdf:Property ;
    rdfs:label 'Ppv Applicable' ;
    rdfs:comment 'Indicates whether any games in this playoff bracket are distributed under a Pay-Per-View (PPV) model. Drives revenue recognition, fan access controls, and broadcast rights activation.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reseedingRule rdf:type rdf:Property ;
    rdfs:label 'Reseeding Rule' ;
    rdfs:comment 'Defines whether teams are reseeded after each round based on remaining seeds or whether the bracket is fixed at the start. \'fixed_bracket\' locks matchups at bracket publication; \'reseed_each_round\' re-ranks remaining teams each round.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryCapComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Compliance Required' ;
    rdfs:comment 'Indicates whether participating franchises must be in salary cap compliance at the time of bracket entry. True if the league enforces cap compliance as a condition of playoff eligibility, per CBA terms.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seriesGamesPerRound rdf:type rdf:Property ;
    rdfs:label 'Series Games Per Round' ;
    rdfs:comment 'Comma-separated list of maximum games per series for each round in order (e.g., \'7,7,7,7\' for NBA best-of-7 throughout, or \'1,1,1,1\' for NFL single-elimination). Null for single-elimination formats where each round is one game.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketSalesOpenDate rdf:type rdf:Property ;
    rdfs:label 'Ticket Sales Open Date' ;
    rdfs:comment 'Date on which general public ticket sales for playoff games in this bracket open. Used by Ticketmaster/AXS and Archtics for inventory release and revenue management.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalTeams rdf:type rdf:Property ;
    rdfs:label 'Total Teams' ;
    rdfs:comment 'Total number of franchises/teams that qualify and enter the playoff bracket. Determines bracket size and bye-round eligibility.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:varTmoEnabled rdf:type rdf:Property ;
    rdfs:label 'Var Tmo Enabled' ;
    rdfs:comment 'Indicates whether Video Assistant Referee (VAR) or Television Match Official (TMO) technology is mandated for officiating decisions in all games within this playoff bracket. Relevant for FIFA, MLS, and rugby-governed competitions.' ;
    rdfs:domain ind:PlayoffBracket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rosterFilingId rdf:type rdf:Property ;
    rdfs:label 'Roster Filing Id' ;
    rdfs:comment 'Primary key for roster_filing' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certifyingEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Certifying Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Roster compliance officers (league employees) certify and submit roster filings for CBA and league compliance. The existing certified_by is a plain-text denormalization of the certifying employee. Ros' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supersededByRosterFilingId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Roster Filing Id' ;
    rdfs:comment 'Reference to the league_roster_id of the subsequent filing that replaced this one when filing_status = \'superseded\'. Enables point-in-time roster history reconstruction and audit trail.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RosterFiling .

ind:amendmentNumber rdf:type rdf:Property ;
    rdfs:label 'Amendment Number' ;
    rdfs:comment 'Sequential amendment version number for this roster filing. Value of 0 indicates the original filing; values ≥ 1 indicate amended re-submissions for the same roster_date and franchise.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbaCompliant rdf:type rdf:Property ;
    rdfs:label 'Cba Compliant' ;
    rdfs:comment 'Indicates whether this roster filing satisfies all applicable Collective Bargaining Agreement (CBA) requirements including minimum roster sizes, contract types, and player rights provisions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deadlineMet rdf:type rdf:Property ;
    rdfs:label 'Deadline Met' ;
    rdfs:comment 'Indicates whether this roster filing was submitted by the league-mandated deadline for the applicable filing_type and roster_date. False triggers a compliance review and potential fine under league rules.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fortyManRosterCount rdf:type rdf:Property ;
    rdfs:label 'Forty Man Roster Count' ;
    rdfs:comment 'Number of players on the 40-man roster as of the roster_date. Specific to Major League Baseball (MLB) — the 40-man roster includes the 26-man active roster plus players on IL, minor league options, and other designations. Null for non-MLB leagues.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:internationalPlayerCount rdf:type rdf:Property ;
    rdfs:label 'International Player Count' ;
    rdfs:comment 'Number of players on this roster filing who hold international (non-domestic) status, subject to league-specific visa, work permit, and international slot rules (e.g., MLS international roster slots, NBA international player designations).' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reserveListCount rdf:type rdf:Property ;
    rdfs:label 'Reserve List Count' ;
    rdfs:comment 'Number of players on any reserve designation (non-IR) as of the roster_date, including physically unable to perform (PUP), non-football injury (NFI), suspended, or other reserve categories. Captures total reserve depth beyond IR.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rookieCount rdf:type rdf:Property ;
    rdfs:label 'Rookie Count' ;
    rdfs:comment 'Number of first-year (rookie) players on this roster filing as of the roster_date. Relevant for CBA rookie scale contract tracking, draft class reporting, and league development analytics.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rosterDate rdf:type rdf:Property ;
    rdfs:label 'Roster Date' ;
    rdfs:comment 'The official calendar date as of which this roster snapshot is certified and filed with the league. Represents the point-in-time for roster composition — distinct from submission timestamp.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rosterMinimum rdf:type rdf:Property ;
    rdfs:label 'Roster Minimum' ;
    rdfs:comment 'The minimum number of players required on the active roster as mandated by the league rules applicable to this filing. Stored at filing time to capture the rule in effect.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rosterSizeLimit rdf:type rdf:Property ;
    rdfs:label 'Roster Size Limit' ;
    rdfs:comment 'The maximum number of players permitted on the active roster as mandated by the league rules applicable to this filing. Stored at filing time to capture the rule in effect (e.g., NFL = 53, NBA = 15, MLB = 26).' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:salaryCapCompliant rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Compliant' ;
    rdfs:comment 'Indicates whether the franchise\'s total roster salary obligations as of the roster_date are within the league-mandated salary cap ceiling. True = compliant; False = cap violation identified.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:salaryCapSpaceRemaining rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Space Remaining' ;
    rdfs:comment 'The franchise\'s remaining salary cap space as of the roster_date, calculated as the league salary cap ceiling minus total committed salary obligations on this roster. Expressed in the league\'s operating currency. Confidential financial data.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:suspendedPlayerCount rdf:type rdf:Property ;
    rdfs:label 'Suspended Player Count' ;
    rdfs:comment 'Number of players on this roster filing who are currently serving a league-imposed suspension (disciplinary, PED, or conduct-related) as of the roster_date. Suspended players may still count against the roster and salary cap.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taxiSquadCount rdf:type rdf:Property ;
    rdfs:label 'Taxi Squad Count' ;
    rdfs:comment 'Number of players on the taxi squad (NHL-specific developmental roster designation) as of the roster_date. Taxi squad players are not on the active roster but travel with the team. Null for non-applicable leagues.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalRosterCount rdf:type rdf:Property ;
    rdfs:label 'Total Roster Count' ;
    rdfs:comment 'Total number of players under any roster designation (active + IR + practice squad + two-way + reserve + taxi squad) as of the roster_date. Represents the full organizational depth of the franchise\'s player pool.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transactionTrigger rdf:type rdf:Property ;
    rdfs:label 'Transaction Trigger' ;
    rdfs:comment 'The business event that triggered this roster filing submission. Identifies the type of roster transaction that necessitated a new official filing with the league office. [ENUM-REF-CANDIDATE: trade|free_agent_signing|waiver_claim|draft|injury|suspension|contract_termination|elevation|option_exercise|retirement — promote to reference product]' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:twoWayContractCount rdf:type rdf:Property ;
    rdfs:label 'Two Way Contract Count' ;
    rdfs:comment 'Number of players under two-way contracts as of the roster_date. Two-way contracts allow players to move between the NBA and G League (or equivalent developmental league) without occupying a full roster spot. Null for non-applicable leagues.' ;
    rdfs:domain ind:RosterFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activePayrollAmount rdf:type rdf:Property ;
    rdfs:label 'Active Payroll Amount' ;
    rdfs:comment 'The total current payroll charged against the franchise\'s salary cap for all active roster contracts in the cap year. Updated on each roster transaction or contract signing. Expressed in USD.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:apronAmount rdf:type rdf:Property ;
    rdfs:label 'Apron Amount' ;
    rdfs:comment 'The second apron threshold above the luxury tax line, above which franchises face additional CBA restrictions on roster moves (e.g., no trade aggregation, no MLE use). Expressed in USD. Introduced in NBA CBA 2023.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:biAnnualExceptionAmount rdf:type rdf:Property ;
    rdfs:label 'Bi Annual Exception Amount' ;
    rdfs:comment 'The dollar value of the bi-annual exception available to franchises for the cap year, usable once every two years to sign players above the soft cap. Expressed in USD.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capCalculationMethodology rdf:type rdf:Property ;
    rdfs:label 'Cap Calculation Methodology' ;
    rdfs:comment 'Narrative description of the formula or methodology used to derive the hard cap and soft cap amounts from total league revenue, as specified in the CBA. For example, \'BRI (Basketball Related Income) split at 51% player share\' or \'All Revenue multiplied by player cost percentage\'.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Cap Effective Date' ;
    rdfs:comment 'The date on which the salary cap rules for this cap year become legally binding and enforceable for all franchises, as defined in the CBA.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capExceptionNotes rdf:type rdf:Property ;
    rdfs:label 'Cap Exception Notes' ;
    rdfs:comment 'Free-text notes documenting any special cap exceptions, waivers, or league-approved adjustments applied to this franchise\'s cap calculation for the cap year (e.g., COVID-19 cap smoothing, hardship exceptions).' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Cap Expiry Date' ;
    rdfs:comment 'The date on which the salary cap period ends and the cap year closes. After this date, final compliance determinations are made and luxury tax bills are issued.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capFloorAmount rdf:type rdf:Property ;
    rdfs:label 'Cap Floor Amount' ;
    rdfs:comment 'The minimum total payroll a franchise must commit to active player contracts for the cap year. Franchises below the floor may be subject to CBA penalties or required to distribute the shortfall to players. Expressed in USD.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capHoldsAmount rdf:type rdf:Property ;
    rdfs:label 'Cap Holds Amount' ;
    rdfs:comment 'Total cap holds charged against the franchise for unsigned draft picks, restricted free agents, and qualifying offers outstanding. Cap holds reserve space until contracts are signed or rights are renounced. Expressed in USD.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capSpaceRemaining rdf:type rdf:Property ;
    rdfs:label 'Cap Space Remaining' ;
    rdfs:comment 'The amount of salary cap space available to the franchise for additional player signings, calculated as the applicable cap ceiling minus total cap charges. Expressed in USD. Updated in real time on roster transactions.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:draftPickPenaltyFlag rdf:type rdf:Property ;
    rdfs:label 'Draft Pick Penalty Flag' ;
    rdfs:comment 'Indicates whether the franchise has been assessed a draft pick forfeiture as a penalty for a salary cap violation in this cap year.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escrowPercentage rdf:type rdf:Property ;
    rdfs:label 'Escrow Percentage' ;
    rdfs:comment 'The percentage of player salaries withheld in escrow during the season to ensure the players\' share of revenue does not exceed the CBA-defined threshold. Expressed as a decimal (e.g., 0.1000 = 10%). Reconciled at season end.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firstApronAmount rdf:type rdf:Property ;
    rdfs:label 'First Apron Amount' ;
    rdfs:comment 'The first apron threshold above the luxury tax line, above which franchises face initial CBA restrictions on roster moves (e.g., reduced MLE, no sign-and-trade as acquiring team). Expressed in USD.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hardCapAmount rdf:type rdf:Property ;
    rdfs:label 'Hard Cap Amount' ;
    rdfs:comment 'The absolute maximum total player payroll permitted under the league\'s hard cap rule for the cap year. Franchises may not exceed this amount under any circumstance. Expressed in USD.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:injuredReserveCredit rdf:type rdf:Property ;
    rdfs:label 'Injured Reserve Credit' ;
    rdfs:comment 'Cap relief credit granted to a franchise when a player is placed on the injured reserve list, allowing a replacement signing above the normal cap threshold. Expressed in USD. Governed by CBA injured reserve rules.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastTransactionDate rdf:type rdf:Property ;
    rdfs:label 'Last Transaction Date' ;
    rdfs:comment 'The date of the most recent roster transaction (signing, release, trade, IR placement) that triggered an update to this franchise\'s cap compliance snapshot.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:luxuryTaxLiability rdf:type rdf:Property ;
    rdfs:label 'Luxury Tax Liability' ;
    rdfs:comment 'The calculated luxury tax dollar amount owed by the franchise based on the amount by which total payroll exceeds the luxury tax threshold, multiplied by the applicable CBA tax rate. Expressed in USD. Zero if payroll is below threshold.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:luxuryTaxRepeaterFlag rdf:type rdf:Property ;
    rdfs:label 'Luxury Tax Repeater Flag' ;
    rdfs:comment 'Indicates whether the franchise qualifies as a luxury tax repeater under CBA rules, triggering higher incremental tax rates for franchises that have been taxpayers in multiple seasons within a defined lookback window.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:luxuryTaxThreshold rdf:type rdf:Property ;
    rdfs:label 'Luxury Tax Threshold' ;
    rdfs:comment 'The payroll level above which a franchise incurs luxury tax penalties. Franchises exceeding this threshold pay a tax rate per dollar over the threshold as defined in the CBA. Expressed in USD.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:midLevelExceptionAmount rdf:type rdf:Property ;
    rdfs:label 'Mid Level Exception Amount' ;
    rdfs:comment 'The dollar value of the mid-level exception available to franchises for the cap year, allowing teams over the soft cap to sign players up to this amount. Expressed in USD. Applicable in NBA-style soft cap leagues.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:playerSharePercentage rdf:type rdf:Property ;
    rdfs:label 'Player Share Percentage' ;
    rdfs:comment 'The CBA-defined percentage of total league revenue allocated to player salaries and benefits for the cap year. Expressed as a decimal (e.g., 0.5100 = 51%). Drives cap calculation methodology.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:practiceSquadCharges rdf:type rdf:Property ;
    rdfs:label 'Practice Squad Charges' ;
    rdfs:comment 'Total salary cap charges attributable to players on the practice squad roster for the cap year. Expressed in USD. Governed by CBA practice squad rules.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:softCapAmount rdf:type rdf:Property ;
    rdfs:label 'Soft Cap Amount' ;
    rdfs:comment 'The baseline salary cap ceiling above which teams may still sign players using defined CBA exceptions (e.g., mid-level exception, Bird rights). Expressed in USD. Applicable primarily in NBA-style cap structures.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalLeagueRevenueBasis rdf:type rdf:Property ;
    rdfs:label 'Total League Revenue Basis' ;
    rdfs:comment 'The total league-wide revenue figure used as the basis for calculating the salary cap for the cap year, as defined in the CBA. Typically derived from broadcast rights, gate receipts, and other shared revenue streams. Expressed in USD.' ;
    rdfs:domain ind:SalaryCap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryLeagueHomeFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Primary League Home Franchise Id' ;
    rdfs:comment 'Reference to the franchise designated as the home team for this scheduled game. Determines venue assignment, gate revenue allocation, and home/away scheduling balance tracking.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:rescheduledFromLeagueScheduleId rdf:type rdf:Property ;
    rdfs:label 'Rescheduled From League Schedule Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the original schedule record from which this game was rescheduled. Enables rescheduling lineage tracking, broadcast rights re-assignment audit, and ticketing system (Ticketmaster/AXS) rebooking reconciliation. Null for games that have never been rescheduled.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LeagueSchedule .

ind:gameNumber rdf:type rdf:Property ;
    rdfs:label 'Game Number' ;
    rdfs:comment 'Externally-known official league-assigned game identifier (e.g., NFL-2024-001234). Used across ticketing systems (Ticketmaster/AXS), broadcast scheduling (Dalet Galaxy), and fan engagement platforms (Adobe Experience Platform) as the cross-system reference key.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gameType rdf:type rdf:Property ;
    rdfs:label 'Game Type' ;
    rdfs:comment 'Classification of the game within the competitive calendar. Determines standings eligibility, salary cap transaction window compliance, broadcast rights tier, and ticket pricing strategy. [ENUM-REF-CANDIDATE: regular_season|playoff|exhibition|neutral_site|all_star|championship|play_in|wild_card — promote to reference product]' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gateRevenueSplitPct rdf:type rdf:Property ;
    rdfs:label 'Gate Revenue Split Pct' ;
    rdfs:comment 'The contractually agreed percentage of gate revenue allocated to the visiting (away) franchise for this game, as defined in the league\'s revenue sharing agreement. Confidential financial term used by SAP S/4HANA (SD/FI modules) for revenue recognition and intercompany settlement.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internationalBroadcastFlag rdf:type rdf:Property ;
    rdfs:label 'International Broadcast Flag' ;
    rdfs:comment 'Indicates whether this game has international broadcast rights activated beyond the domestic market. Triggers GDPR-compliant geo-restriction logic for OTT/DTC streaming platforms and international media rights window management in Dalet Galaxy.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHomeAwayReversed rdf:type rdf:Property ;
    rdfs:label 'Is Home Away Reversed' ;
    rdfs:comment 'Indicates whether the standard home/away designation has been reversed for this game (e.g., a team plays a \'home\' game at the opponent\'s venue due to facility unavailability or international series). Used for scheduling balance audits and CBA home game count compliance.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchdayLabel rdf:type rdf:Property ;
    rdfs:label 'Matchday Label' ;
    rdfs:comment 'Human-readable label for the scheduling period as published by the league (e.g., \'Matchday 12\', \'Week 7\', \'Round of 16\', \'Wild Card Weekend\', \'Opening Day\'). Used in fan-facing communications, broadcast graphics, and digital content distribution.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Original Scheduled Date' ;
    rdfs:comment 'The initially published league calendar date for this game before any postponement or rescheduling. Retained for audit trail, rescheduling impact analysis, and CBA transaction window compliance verification. Null if the game has never been rescheduled.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalStartTime rdf:type rdf:Property ;
    rdfs:label 'Original Start Time' ;
    rdfs:comment 'The initially published start timestamp for this game before any time change or rescheduling. Retained alongside original_scheduled_date for complete rescheduling audit trail and broadcast rights window compliance tracking.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:postponementReason rdf:type rdf:Property ;
    rdfs:label 'Postponement Reason' ;
    rdfs:comment 'Categorized reason for a game postponement or cancellation. Required for league governance reporting, insurance claims, broadcast rights force majeure provisions, and ISO 20121 event sustainability documentation. Null when scheduling_status is \'confirmed\'. [ENUM-REF-CANDIDATE: weather|facility_issue|public_safety|broadcast_conflict|force_majeure|covid_protocol|labor_dispute|bereavement|other — promote to reference product]' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryCapWindowFlag rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Window Flag' ;
    rdfs:comment 'Indicates whether this game date falls within a salary cap compliance reporting window as defined by the applicable CBA. Used by league finance and compliance teams to trigger cap audit checkpoints aligned to the competitive calendar.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Date' ;
    rdfs:comment 'The official league-published calendar date on which the game is scheduled to be played (yyyy-MM-dd). Used as the primary planning date for event operations, venue staffing, and broadcast scheduling. Represents the current confirmed date (may differ from original_scheduled_date if rescheduled).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:schedulingStatus rdf:type rdf:Property ;
    rdfs:label 'Scheduling Status' ;
    rdfs:comment 'Current lifecycle state of the scheduled game. Drives downstream event operations, broadcast slot management, ticketing refund workflows (Ticketmaster/AXS), and standings calculation eligibility. Confirmed = league-approved and published; Postponed = delayed with new date TBD; Cancelled = permanently removed; Rescheduled = new date assigned; Pending = awaiting league confirmation; Suspended = mid-game stoppage requiring resumption.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seriesGameNumber rdf:type rdf:Property ;
    rdfs:label 'Series Game Number' ;
    rdfs:comment 'The sequential game number within a playoff or regular-season series between the same two franchises (e.g., Game 3 of 7 in an NBA Playoff series, Game 2 of 3 in an MLB series). Null for non-series single-game matchups.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seriesGameTotal rdf:type rdf:Property ;
    rdfs:label 'Series Game Total' ;
    rdfs:comment 'The maximum number of games in the series to which this game belongs (e.g., best-of-7 = 7, best-of-5 = 5, two-game series = 2). Used alongside series_game_number for bracket progression logic and playoff scheduling management.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ticketOnSaleDate rdf:type rdf:Property ;
    rdfs:label 'Ticket On Sale Date' ;
    rdfs:comment 'The date on which tickets for this game become available for public purchase via Ticketmaster/AXS and DTC (Direct-To-Consumer) channels. Drives fan engagement campaign scheduling in Adobe Experience Platform and Salesforce CRM outreach workflows.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:timezone rdf:type rdf:Property ;
    rdfs:label 'Timezone' ;
    rdfs:comment 'IANA timezone identifier for the venue location where the game is played (e.g., \'America/New_York\', \'Europe/London\', \'Asia/Tokyo\'). Required for accurate broadcast scheduling, fan notification timing, and international rights window management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionWindowCompliant rdf:type rdf:Property ;
    rdfs:label 'Transaction Window Compliant' ;
    rdfs:comment 'Indicates whether this game falls within a CBA-defined transaction window (e.g., trade deadline, waiver period, roster freeze). Critical for league compliance officers to validate that no prohibited roster moves occurred in the window surrounding this game.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weekNumber rdf:type rdf:Property ;
    rdfs:label 'Week Number' ;
    rdfs:comment 'The sequential week number within the season calendar (e.g., NFL Week 1 through Week 18). Used for standings calculations, bye week tracking, and scheduling balance analysis. Applicable primarily to weekly-format leagues (NFL, NHL, NBA). Null for round-based or matchday-based competitions.' ;
    rdfs:domain ind:LeagueSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:byeTeams rdf:type rdf:Property ;
    rdfs:label 'Bye Teams' ;
    rdfs:comment 'Number of top-seeded franchises that receive a first-round bye (automatic advancement to the second round without playing). Zero if no byes are granted. Impacts bracket scheduling and revenue from first-round games.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expansionSeasonFlag rdf:type rdf:Property ;
    rdfs:label 'Expansion Season Flag' ;
    rdfs:comment 'Indicates whether this season includes one or more expansion franchises entering the league for the first time. When true, expansion draft rules, schedule adjustments, and revenue sharing modifications apply.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:freeAgencyStartDate rdf:type rdf:Property ;
    rdfs:label 'Free Agency Start Date' ;
    rdfs:comment 'The date on which the free agency signing period opens for this season, allowing franchises to negotiate and sign unrestricted free agents. Anchors contract activity, salary cap management, and roster building timelines.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:neutralSiteChampionshipFlag rdf:type rdf:Property ;
    rdfs:label 'Neutral Site Championship Flag' ;
    rdfs:comment 'Indicates whether the championship game/series is played at a pre-selected neutral venue rather than the higher seed\'s home venue (e.g., Super Bowl, FIFA World Cup Final). Impacts venue booking, ticket allocation, and broadcast production planning.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:officiatingSystem rdf:type rdf:Property ;
    rdfs:label 'Officiating System' ;
    rdfs:comment 'The video review and officiating technology system in use for this season: VAR (Video Assistant Referee) for soccer/football, TMO (Television Match Official) for rugby, challenge_system for MLB/NFL, or standard for traditional officiating without video review. Governs officiating assignment and incident review workflows.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:playoffRounds rdf:type rdf:Property ;
    rdfs:label 'Playoff Rounds' ;
    rdfs:comment 'Total number of rounds in the postseason bracket from first round through championship (e.g., 4 rounds for NBA: First Round, Semifinals, Conference Finals, Finals). Drives bracket position assignments and series scheduling.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:playoffTeams rdf:type rdf:Property ;
    rdfs:label 'Playoff Teams' ;
    rdfs:comment 'Total number of franchises/teams that qualify for the postseason bracket (e.g., 12 for NFL, 16 for NBA, 16 for NHL). Determines seeding slots, bracket size, and bye eligibility.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postseasonEndDate rdf:type rdf:Property ;
    rdfs:label 'Postseason End Date' ;
    rdfs:comment 'Official last date of the postseason including the championship event. Marks the close of the competitive season for all governance and compliance purposes.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:postseasonStartDate rdf:type rdf:Property ;
    rdfs:label 'Postseason Start Date' ;
    rdfs:comment 'Official start date of the postseason/playoff bracket. Triggers playoff ticketing, broadcast rights escalation, and championship merchandise activation.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regularSeasonEndDate rdf:type rdf:Property ;
    rdfs:label 'Regular Season End Date' ;
    rdfs:comment 'Official last date of the regular season schedule before postseason begins. Used to finalize standings, seeding, and playoff bracket assignments.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regularSeasonStartDate rdf:type rdf:Property ;
    rdfs:label 'Regular Season Start Date' ;
    rdfs:comment 'Official start date of the regular season competitive schedule, distinct from preseason. Used to trigger standings calculations, fantasy sports activations, and broadcast rights windows.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rosterFreezeDate rdf:type rdf:Property ;
    rdfs:label 'Roster Freeze Date' ;
    rdfs:comment 'The date by which all franchise rosters must be finalized and submitted to the league for the season. Triggers eligibility locks for regular season and postseason participation.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:salaryCapYearFlag rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Year Flag' ;
    rdfs:comment 'Indicates whether this season constitutes a salary cap year for compliance and roster management purposes. When true, salary cap rules, luxury tax thresholds, and CBA roster limits apply to all franchises for this season.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seasonType rdf:type rdf:Property ;
    rdfs:label 'Season Type' ;
    rdfs:comment 'Classification of the season phase: preseason (training/exhibition games), regular (standard competitive schedule), postseason (playoff/championship bracket), allstar (mid-season showcase event), or exhibition (non-competitive friendly). Drives scheduling, standings, and broadcast rights logic.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seriesGamesFormat rdf:type rdf:Property ;
    rdfs:label 'Series Games Format' ;
    rdfs:comment 'The number of games in each playoff series (e.g., best_of_7 for NBA/NHL Finals, best_of_5 for early rounds, single_game for NFL playoff rounds). Drives game scheduling, broadcast rights windows, and venue booking.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortenedSeasonFlag rdf:type rdf:Property ;
    rdfs:label 'Shortened Season Flag' ;
    rdfs:comment 'Indicates whether this season was shortened from the standard games_per_team count due to labor disputes, pandemic, or other force majeure events. When true, prorated salary cap and adjusted standings rules apply.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:theme rdf:type rdf:Property ;
    rdfs:label 'Theme' ;
    rdfs:comment 'Official marketing theme or campaign name for the season as defined by the league (e.g., \'NBA 75th Anniversary Season\', \'NFL 100\'). Used in fan engagement, merchandise, and content production campaigns.' ;
    rdfs:domain ind:Season ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standingId rdf:type rdf:Property ;
    rdfs:label 'Standing Id' ;
    rdfs:comment 'Unique surrogate identifier for a competitive standing snapshot record within the league data domain.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:awayLosses rdf:type rdf:Property ;
    rdfs:label 'Away Losses' ;
    rdfs:comment 'Total number of losses recorded in away (road) games as of the snapshot date.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:awayTies rdf:type rdf:Property ;
    rdfs:label 'Away Ties' ;
    rdfs:comment 'Total number of ties or draws recorded in away (road) games. Applicable in MLS, FIFA, and NFL regular season formats.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:awayWins rdf:type rdf:Property ;
    rdfs:label 'Away Wins' ;
    rdfs:comment 'Total number of wins recorded in away (road) games as of the snapshot date. Used in tiebreaker resolution.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinchIndicator rdf:type rdf:Property ;
    rdfs:label 'Clinch Indicator' ;
    rdfs:comment 'Standard league clinch/elimination indicator code displayed in standings: x = clinched playoff berth, y = clinched division title, z = clinched best record in conference, e = eliminated from playoff contention, w = clinched best overall record, p = clinched home-field advantage. Null if no clinch or elimination status applies.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conferenceLosses rdf:type rdf:Property ;
    rdfs:label 'Conference Losses' ;
    rdfs:comment 'Total number of losses recorded against conference opponents as of the snapshot date.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:conferenceRank rdf:type rdf:Property ;
    rdfs:label 'Conference Rank' ;
    rdfs:comment 'Ordinal rank of the franchise within its conference as of the snapshot date. Used for playoff seeding and wild card qualification.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:conferenceWins rdf:type rdf:Property ;
    rdfs:label 'Conference Wins' ;
    rdfs:comment 'Total number of wins recorded against conference opponents as of the snapshot date. Used as a tiebreaker criterion in NFL, NBA, and NHL standings.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:currentStreakCount rdf:type rdf:Property ;
    rdfs:label 'Current Streak Count' ;
    rdfs:comment 'Number of consecutive games in the current streak of the same result type (wins, losses, or ties). Combined with current_streak_type to express the full streak.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:currentStreakType rdf:type rdf:Property ;
    rdfs:label 'Current Streak Type' ;
    rdfs:comment 'Type of the franchise\'s current consecutive result streak: W (Win), L (Loss), T (Tie), or D (Draw). Combined with current_streak_count to express the full streak (e.g., W5 = five consecutive wins).' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divisionLosses rdf:type rdf:Property ;
    rdfs:label 'Division Losses' ;
    rdfs:comment 'Total number of losses recorded against divisional opponents as of the snapshot date.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:divisionRank rdf:type rdf:Property ;
    rdfs:label 'Division Rank' ;
    rdfs:comment 'Ordinal rank of the franchise within its division as of the snapshot date. Rank 1 indicates the division leader. Used for playoff seeding and tiebreaker resolution.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:divisionWins rdf:type rdf:Property ;
    rdfs:label 'Division Wins' ;
    rdfs:comment 'Total number of wins recorded against divisional opponents as of the snapshot date. A primary tiebreaker criterion in NFL, NBA, MLB, and NHL standings.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eliminationNumber rdf:type rdf:Property ;
    rdfs:label 'Elimination Number' ;
    rdfs:comment 'Combined number of losses by the trailing team and wins by the leading competitor that would result in mathematical elimination from playoff contention. Null when already eliminated or clinched.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gamesBehind rdf:type rdf:Property ;
    rdfs:label 'Games Behind' ;
    rdfs:comment 'Number of games the franchise trails the division or conference leader in the standings. A value of 0.0 indicates the franchise is tied for or holds the lead. Calculated as ((leader_wins - team_wins) + (team_losses - leader_losses)) / 2.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:homeLosses rdf:type rdf:Property ;
    rdfs:label 'Home Losses' ;
    rdfs:comment 'Total number of losses recorded in home venue games as of the snapshot date.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:homeTies rdf:type rdf:Property ;
    rdfs:label 'Home Ties' ;
    rdfs:comment 'Total number of ties or draws recorded in home venue games. Applicable in MLS, FIFA, and NFL regular season formats.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:homeWins rdf:type rdf:Property ;
    rdfs:label 'Home Wins' ;
    rdfs:comment 'Total number of wins recorded in home venue games as of the snapshot date. Used in tiebreaker resolution and home-field advantage analysis.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:last10Losses rdf:type rdf:Property ;
    rdfs:label 'Last10 Losses' ;
    rdfs:comment 'Number of losses in the franchise\'s most recent 10 official games. Combined with last10_wins to express the last-10 record (e.g., 7-3).' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:last10Wins rdf:type rdf:Property ;
    rdfs:label 'Last10 Wins' ;
    rdfs:comment 'Number of wins in the franchise\'s most recent 10 official games. Used as a recent form indicator in standings displays and playoff race analysis.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leagueRank rdf:type rdf:Property ;
    rdfs:label 'League Rank' ;
    rdfs:comment 'Ordinal rank of the franchise across the entire league as of the snapshot date. Used for draft order determination and overall competitive positioning.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:magicNumber rdf:type rdf:Property ;
    rdfs:label 'Magic Number' ;
    rdfs:comment 'Combined number of wins by the leading team and losses by the closest competitor needed to clinch a division title or playoff berth. Null when not applicable or when already clinched/eliminated.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overtimeLosses rdf:type rdf:Property ;
    rdfs:label 'Overtime Losses' ;
    rdfs:comment 'Total number of games lost in overtime or shootout. Used primarily in NHL standings where an overtime loss earns one point. Null or zero for leagues without overtime loss distinction.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:points rdf:type rdf:Property ;
    rdfs:label 'Points' ;
    rdfs:comment 'Total standings points accumulated by the franchise. Used in NHL (2 pts per win, 1 pt per OTL), MLS, and FIFA competition formats. Null for leagues using winning percentage as the primary ranking metric.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:runDifferential rdf:type rdf:Property ;
    rdfs:label 'Run Differential' ;
    rdfs:comment 'Net difference between total runs/goals/points scored and total runs/goals/points allowed across all games. Positive values indicate the franchise scores more than it concedes. Used as a tiebreaker and competitive health indicator across MLB (runs), NHL/MLS/FIFA (goals), and NBA (points).' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:runsAllowed rdf:type rdf:Property ;
    rdfs:label 'Runs Allowed' ;
    rdfs:comment 'Total runs (MLB), goals (NHL/MLS/FIFA), or points (NBA/NFL) allowed by the franchise across all applicable games as of the snapshot date.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:runsScored rdf:type rdf:Property ;
    rdfs:label 'Runs Scored' ;
    rdfs:comment 'Total runs (MLB), goals (NHL/MLS/FIFA), or points (NBA/NFL) scored by the franchise across all applicable games as of the snapshot date.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standingStatus rdf:type rdf:Property ;
    rdfs:label 'Standing Status' ;
    rdfs:comment 'Current lifecycle status of this standing record: active (season in progress), clinched (playoff berth secured), eliminated (mathematically eliminated from playoff contention), pending (awaiting game result), or final (season concluded).' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standingsType rdf:type rdf:Property ;
    rdfs:label 'Standings Type' ;
    rdfs:comment 'Classification of the standings context: regular season, postseason, preseason, tournament group stage, or playoff bracket. Determines which game results are included in the standing calculation.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strengthOfSchedule rdf:type rdf:Property ;
    rdfs:label 'Strength Of Schedule' ;
    rdfs:comment 'Composite metric representing the combined winning percentage of all opponents faced by the franchise as of the snapshot date. Used as a tiebreaker criterion in NFL standings and for playoff seeding analysis.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wildCardRank rdf:type rdf:Property ;
    rdfs:label 'Wild Card Rank' ;
    rdfs:comment 'Ordinal rank of the franchise among wild card contenders within its conference or league. Null if the franchise has clinched a division title or is eliminated from wild card contention.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:winPct rdf:type rdf:Property ;
    rdfs:label 'Win Pct' ;
    rdfs:comment 'Winning percentage calculated as wins divided by games played (ties count as half a win in applicable leagues). Primary ranking metric in MLB and NBA standings.' ;
    rdfs:domain ind:Standing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leagueApproverEmployeeId rdf:type rdf:Property ;
    rdfs:label 'League Approver Employee Id' ;
    rdfs:comment 'Reference to the league official or commissioner\'s office representative who approved or rejected this transaction. Used for audit trail and governance accountability.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryTradeAcquiringFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Primary Trade Acquiring Franchise Id' ;
    rdfs:comment 'Reference to the franchise receiving the primary asset (player, draft pick, or cash consideration) in this transaction. In waiver claims, this is the claiming franchise.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:tertiaryTradeThirdFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Trade Third Franchise Id' ;
    rdfs:comment 'Reference to the third franchise involved in a three-way trade transaction. Null for bilateral trades, waiver claims, and all other non-three-way transaction types.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:cashConsiderationAmount rdf:type rdf:Property ;
    rdfs:label 'Cash Consideration Amount' ;
    rdfs:comment 'The gross monetary value of cash included in this transaction (e.g., player-for-cash trade, cash balancing payment). Subject to league-mandated cash consideration limits per CBA. Zero if no cash is exchanged.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashConsiderationCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Cash Consideration Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the cash consideration amount (e.g., USD, CAD, EUR). Required when cash_consideration_amount is non-zero.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearingDate rdf:type rdf:Property ;
    rdfs:label 'Clearing Date' ;
    rdfs:comment 'For waiver transactions, the date on which the player clears the waiver wire without being claimed, making them eligible for outright assignment or free agency. Null for non-waiver transaction types.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:competitiveIntegrityReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Competitive Integrity Review Flag' ;
    rdfs:comment 'Indicates whether this transaction was flagged for competitive integrity review by the league office (e.g., suspected tanking, collusion between franchises, or circumvention of salary cap rules). True = flagged for review.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Condition Resolution Date' ;
    rdfs:comment 'The date by which all conditional terms of this transaction must be resolved or triggered. Null for unconditional transactions. Used to monitor outstanding conditional trade obligations.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conditionalTermsDescription rdf:type rdf:Property ;
    rdfs:label 'Conditional Terms Description' ;
    rdfs:comment 'Free-text description of any conditions attached to this transaction (e.g., \'Draft pick converts to 1st round if team makes playoffs\', \'Player option triggers salary escalation\'). Null for unconditional transactions.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noTradeClauseWaived rdf:type rdf:Property ;
    rdfs:label 'No Trade Clause Waived' ;
    rdfs:comment 'Indicates whether the player involved in this transaction had a contractual no-trade clause that was formally waived by the player to allow the transaction to proceed. True = player waived their no-trade clause.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noTradeClauseWaiverDate rdf:type rdf:Property ;
    rdfs:label 'No Trade Clause Waiver Date' ;
    rdfs:comment 'The date on which the player formally waived their no-trade clause to permit this transaction. Null if no no-trade clause existed or was not applicable.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:physicalExamRequired rdf:type rdf:Property ;
    rdfs:label 'Physical Exam Required' ;
    rdfs:comment 'Indicates whether the transaction is contingent upon the acquired player passing a physical examination by the acquiring franchise\'s medical staff. True = physical required before transaction is fully ratified.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:physicalExamStatus rdf:type rdf:Property ;
    rdfs:label 'Physical Exam Status' ;
    rdfs:comment 'Current status of the required physical examination for the acquired player: not_required, pending (scheduled but not completed), passed (cleared), failed (transaction may be voided), waived (franchise waived physical requirement).' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryCapImpactAcquiring rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Impact Acquiring' ;
    rdfs:comment 'The net change to the acquiring franchise\'s salary cap space resulting from this transaction (positive = cap charge added). Used for real-time cap compliance monitoring per CBA salary cap rules.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salaryCapImpactTrading rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Impact Trading' ;
    rdfs:comment 'The net change to the trading franchise\'s salary cap space resulting from this transaction (negative = cap relief received). Used for real-time cap compliance monitoring per CBA salary cap rules.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salaryObligationCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Salary Obligation Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the salary obligation transferred amount (e.g., USD, CAD).' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryObligationTransferredAmount rdf:type rdf:Property ;
    rdfs:label 'Salary Obligation Transferred Amount' ;
    rdfs:comment 'The total remaining salary obligation (base salary plus guaranteed money) transferred from the trading franchise to the acquiring franchise as part of this transaction. Critical for salary cap compliance tracking per CBA.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystemTransactionCode rdf:type rdf:Property ;
    rdfs:label 'Source System Transaction Code' ;
    rdfs:comment 'The native transaction identifier from the originating operational system of record (e.g., SAP S/4HANA SD document number, Salesforce CRM opportunity ID) used for lineage tracing and reconciliation with upstream systems.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeDeadlineExceptionFlag rdf:type rdf:Property ;
    rdfs:label 'Trade Deadline Exception Flag' ;
    rdfs:comment 'Indicates whether this transaction required and received a formal league exception to proceed after the official trade deadline. True = exception granted; False = standard transaction within deadline.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:voidDate rdf:type rdf:Property ;
    rdfs:label 'Void Date' ;
    rdfs:comment 'The date on which this transaction was officially voided or rescinded by the league. Null for non-voided transactions.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverClaimFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Waiver Claim Fee Amount' ;
    rdfs:comment 'The standard waiver claim fee charged to the acquiring franchise by the league upon a successful waiver claim. Amount is defined by the applicable CBA. Zero or null for non-waiver transactions.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waiverPriorityOrder rdf:type rdf:Property ;
    rdfs:label 'Waiver Priority Order' ;
    rdfs:comment 'The league-assigned waiver priority rank of the claiming franchise at the time of the waiver transaction. Lower number indicates higher priority (e.g., 1 = first priority). Null for non-waiver transaction types.' ;
    rdfs:domain ind:TradeTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvalTurnaroundHours rdf:type rdf:Property ;
    rdfs:label 'Approval Turnaround Hours' ;
    rdfs:comment 'Maximum number of hours within which the league office must approve or reject a transaction submitted during this window. Defines the Service Level Agreement (SLA) for transaction processing.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closeTimestamp rdf:type rdf:Property ;
    rdfs:label 'Close Timestamp' ;
    rdfs:comment 'Precise date and time (with timezone) at which the transaction window officially closes. Critical for trade deadline compliance — transactions submitted after this timestamp are invalid.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:competitiveIntegrityReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Competitive Integrity Review Required' ;
    rdfs:comment 'Indicates whether transactions executed during this window are subject to a competitive integrity review by the league office to prevent collusion, tanking, or other violations of fair competition standards.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eligibleTransactionTypes rdf:type rdf:Property ;
    rdfs:label 'Eligible Transaction Types' ;
    rdfs:comment 'Comma-separated list of transaction types authorized during this window (e.g., \'trade,waiver_claim,free_agent_signing,dfa,option_exercise\'). Defines the scope of permissible roster movements for compliance validation of league_trade_transaction and waiver_claim records.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:franchiseParticipationScope rdf:type rdf:Property ;
    rdfs:label 'Franchise Participation Scope' ;
    rdfs:comment 'Defines which franchises are eligible to participate in this transaction window. \'all_franchises\' applies league-wide; other values restrict participation to a subset of franchises.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalTransferRulesApply rdf:type rdf:Property ;
    rdfs:label 'International Transfer Rules Apply' ;
    rdfs:comment 'Indicates whether FIFA Transfer Regulations or equivalent international governing body transfer rules apply to transactions within this window. Relevant for MLS, international soccer, and cross-border athlete movements.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFreeAgencyEligible rdf:type rdf:Property ;
    rdfs:label 'Is Free Agency Eligible' ;
    rdfs:comment 'Indicates whether free agent signings are permitted during this transaction window. Governs whether franchises may negotiate and execute contracts with unrestricted or restricted free agents.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isInternationalSigningEligible rdf:type rdf:Property ;
    rdfs:label 'Is International Signing Eligible' ;
    rdfs:comment 'Indicates whether international player signings are authorized during this window. Relevant for MLB International Signing Period, FIFA transfer windows, and MLS international roster slots.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTradeEligible rdf:type rdf:Property ;
    rdfs:label 'Is Trade Eligible' ;
    rdfs:comment 'Indicates whether player-for-player or player-for-pick trades are permitted during this transaction window. False for windows restricted to free agency or waiver activity only.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWaiverEligible rdf:type rdf:Property ;
    rdfs:label 'Is Waiver Eligible' ;
    rdfs:comment 'Indicates whether waiver claims and waiver wire transactions are permitted during this transaction window. Determines whether waiver_claim records may be anchored to this window.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'League Approval Required' ;
    rdfs:comment 'Indicates whether transactions executed during this window require explicit league office approval before becoming effective. When true, transactions remain pending until the league approves.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxCashConsiderationUsd rdf:type rdf:Property ;
    rdfs:label 'Max Cash Consideration Usd' ;
    rdfs:comment 'Maximum cash consideration in US dollars permitted in a single transaction during this window, as governed by CBA provisions. Null if no cash limit applies. Used for compliance validation of league_trade_transaction records.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxTransactionsPerFranchise rdf:type rdf:Property ;
    rdfs:label 'Max Transactions Per Franchise' ;
    rdfs:comment 'Maximum number of transactions a single franchise may execute during this window, as defined by league rules or CBA provisions. Null indicates no per-franchise limit.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:penaltyDraftPickLoss rdf:type rdf:Property ;
    rdfs:label 'Penalty Draft Pick Loss' ;
    rdfs:comment 'Indicates whether violation of this transaction window\'s rules may result in forfeiture of draft picks as a disciplinary penalty, per CBA or league governance provisions.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyFineAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Fine Amount' ;
    rdfs:comment 'Monetary fine amount imposed on a franchise for executing a transaction outside the authorized window or in violation of window rules. Expressed in the currency defined by currency_code.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltySuspensionEligible rdf:type rdf:Property ;
    rdfs:label 'Penalty Suspension Eligible' ;
    rdfs:comment 'Indicates whether franchise personnel (e.g., general managers, coaches) may be suspended for violations of this transaction window\'s rules.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rosterFreezeApplies rdf:type rdf:Property ;
    rdfs:label 'Roster Freeze Applies' ;
    rdfs:comment 'Indicates whether a roster freeze is in effect during this transaction window, prohibiting certain roster moves. Common during playoff periods or immediately preceding the trade deadline.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:salaryCapApplies rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Applies' ;
    rdfs:comment 'Indicates whether salary cap compliance checks are required for transactions executed during this window. When true, all transactions must be validated against the franchise\'s cap space before league approval.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wadaClearanceRequired rdf:type rdf:Property ;
    rdfs:label 'Wada Clearance Required' ;
    rdfs:comment 'Indicates whether World Anti-Doping Agency (WADA) clearance is required for athletes involved in transactions during this window. Applicable for international transfers and leagues with mandatory anti-doping compliance.' ;
    rdfs:domain ind:League ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:windowNotes rdf:type rdf:Property ;
    rdfs:label 'Window Notes' ;
    rdfs:comment 'Free-text field for league operations staff to record supplementary information about this transaction window, including special conditions, amendments, or exceptions not captured in structured fields.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windowReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Window Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned by the league office to uniquely identify this transaction window for official communications, compliance filings, and franchise notifications.' ;
    rdfs:domain ind:TransactionWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverClaimId rdf:type rdf:Property ;
    rdfs:label 'Waiver Claim Id' ;
    rdfs:comment 'Unique surrogate identifier for each waiver claim transaction record in the league competition governance system.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvingEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approving Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: League operations employees review and approve waiver claims for CBA and salary cap compliance. approving_official_name is a plain-text denormalization of the approving employee. Waiver audit trails a' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:playerAthleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Player Athlete Profile Id' ;
    rdfs:comment 'Reference to the athlete/player who is the subject of this waiver claim transaction.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:primaryWaiverPlacingFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Primary Waiver Placing Franchise Id' ;
    rdfs:comment 'Reference to the franchise that placed the player on waivers (the releasing team).' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:capComplianceVerified rdf:type rdf:Property ;
    rdfs:label 'Cap Compliance Verified' ;
    rdfs:comment 'Indicates whether the league office has verified that the claiming franchise has sufficient salary cap space to absorb the player\'s cap charge before approving the claim.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimCount rdf:type rdf:Property ;
    rdfs:label 'Claim Count' ;
    rdfs:comment 'Total number of franchises that submitted a waiver claim for this player during the waiver window.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimDeadlineTimestamp rdf:type rdf:Property ;
    rdfs:label 'Claim Deadline Timestamp' ;
    rdfs:comment 'The exact date and time by which franchises must submit a claim to acquire the player before the waiver window closes, as defined by league rules.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:claimReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Claim Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned by the league office to uniquely identify this waiver transaction for official correspondence and audit purposes.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimResolutionType rdf:type rdf:Property ;
    rdfs:label 'Claim Resolution Type' ;
    rdfs:comment 'The final resolution outcome of the waiver process: \'claimed\' = acquired by a franchise; \'cleared\' = passed through unclaimed; \'revoked\' = placing franchise withdrew; \'expired\' = window closed; \'contested\' = subject to league dispute resolution.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimStatus rdf:type rdf:Property ;
    rdfs:label 'Claim Status' ;
    rdfs:comment 'Current lifecycle status of the waiver claim. \'pending\' = waiver period active; \'claimed\' = franchise successfully claimed the player; \'unclaimed\' = player cleared waivers with no claim; \'revoked\' = placing franchise withdrew the waiver request; \'expired\' = waiver window closed without resolution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimSubmittedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Claim Submitted Timestamp' ;
    rdfs:comment 'Date and time at which the claiming franchise officially submitted its waiver claim to the league office. Null if no claim was submitted.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:clearedDate rdf:type rdf:Property ;
    rdfs:label 'Cleared Date' ;
    rdfs:comment 'Date on which the player officially cleared waivers — either claimed by a franchise or passed through unclaimed. Null if the waiver process is still active.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:internationalTransferFlag rdf:type rdf:Property ;
    rdfs:label 'International Transfer Flag' ;
    rdfs:comment 'Indicates whether this waiver claim involves an international player transfer requiring additional regulatory clearance (e.g., FIFA transfer window compliance, work permit, visa).' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'League Approval Status' ;
    rdfs:comment 'Status of the league office\'s formal review and approval of the waiver claim transaction, ensuring compliance with roster, cap, and CBA rules.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leagueApprovedTimestamp rdf:type rdf:Property ;
    rdfs:label 'League Approved Timestamp' ;
    rdfs:comment 'Date and time at which the league office formally approved the waiver claim transaction.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:multipleClaimsFlag rdf:type rdf:Property ;
    rdfs:label 'Multiple Claims Flag' ;
    rdfs:comment 'Indicates whether more than one franchise submitted a waiver claim for this player, requiring priority-order resolution by the league office.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:placedDate rdf:type rdf:Property ;
    rdfs:label 'Placed Date' ;
    rdfs:comment 'Calendar date on which the placing franchise officially submitted the player to the waiver wire.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:placedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Placed Timestamp' ;
    rdfs:comment 'Precise date and time (with timezone) at which the waiver placement was officially recorded by the league office system.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:playerContractYear rdf:type rdf:Property ;
    rdfs:label 'Player Contract Year' ;
    rdfs:comment 'The year number within the player\'s current contract at the time of the waiver placement (e.g., year 2 of a 4-year deal), relevant for determining salary obligations and cap charges.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:playerServiceYears rdf:type rdf:Property ;
    rdfs:label 'Player Service Years' ;
    rdfs:comment 'Number of years of professional service accrued by the player at the time of the waiver placement, which may affect waiver priority, salary obligations, and CBA rights.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rosterSpotType rdf:type rdf:Property ;
    rdfs:label 'Roster Spot Type' ;
    rdfs:comment 'The roster designation to which the player is assigned upon being claimed (e.g., active roster, injured reserve, practice squad, taxi squad).' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryCapChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Salary Cap Charge Amount' ;
    rdfs:comment 'The portion of the player\'s salary that counts against the claiming franchise\'s salary cap upon a successful waiver claim, as calculated per CBA rules.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salaryCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Salary Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the salary obligation amount (e.g., USD, CAD, EUR, GBP).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryObligationAmount rdf:type rdf:Property ;
    rdfs:label 'Salary Obligation Amount' ;
    rdfs:comment 'The gross remaining salary obligation (in the applicable currency) that transfers to the claiming franchise upon a successful waiver claim. Represents the player\'s remaining contracted salary assumed by the new team.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salaryObligationTransferred rdf:type rdf:Property ;
    rdfs:label 'Salary Obligation Transferred' ;
    rdfs:comment 'Indicates whether the salary obligation has been formally transferred from the placing franchise to the claiming franchise following a successful waiver claim.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Waiver Period Days' ;
    rdfs:comment 'Number of calendar days the player must remain on waivers before clearing, as defined by league rules and CBA for the applicable waiver type and time of season.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waiverWirePriority rdf:type rdf:Property ;
    rdfs:label 'Waiver Wire Priority' ;
    rdfs:comment 'Numeric priority rank of the claiming franchise on the waiver wire at the time of the claim, typically inverse of current standings (worst record = highest priority). Lower number = higher priority.' ;
    rdfs:domain ind:WaiverClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:boardResolutionId rdf:type rdf:Property ;
    rdfs:label 'Board Resolution Id' ;
    rdfs:comment 'Unique surrogate identifier for each board resolution record in the Sports Entertainment corporate governance system. Primary key for the board_resolution data product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BoardResolution .

ind:authorizedSignatories rdf:type rdf:Property ;
    rdfs:label 'Authorized Signatories' ;
    rdfs:comment 'Comma-separated list of individuals (by name or title) authorized by this resolution to execute agreements, sign documents, or take actions on behalf of the corporate entity. Central to authorized signatory management and contract execution workflows.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boardCommittee rdf:type rdf:Property ;
    rdfs:label 'Board Committee' ;
    rdfs:comment 'The board committee or body that passed this resolution. \'full_board\' indicates the entire board of directors; other values indicate a standing committee acting within its delegated authority. Audit and compensation committee resolutions have specific SOX disclosure implications.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chairpersonName rdf:type rdf:Property ;
    rdfs:label 'Chairperson Name' ;
    rdfs:comment 'The full name of the board chairperson or committee chair who presided over the meeting at which this resolution was passed. Required for governance documentation and board minutes authentication.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:corporateSecretaryName rdf:type rdf:Property ;
    rdfs:label 'Corporate Secretary Name' ;
    rdfs:comment 'The full name of the corporate secretary who certified and recorded this resolution in the official minute book. The corporate secretary\'s certification is the legal attestation of the resolution\'s authenticity.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dissentingDirectors rdf:type rdf:Property ;
    rdfs:label 'Dissenting Directors' ;
    rdfs:comment 'Comma-separated list of director names or identifiers who voted against or formally dissented from the resolution. Required for governance documentation and potential SEC disclosure. Classified as confidential due to sensitivity of individual director voting positions.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentStorageReference rdf:type rdf:Property ;
    rdfs:label 'Document Storage Reference' ;
    rdfs:comment 'The unique path, URI, or identifier pointing to the executed resolution document stored in the corporate document management system (e.g., SharePoint, OpenText, or DAM system path). Enables direct retrieval of the signed original for legal and audit purposes.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Governing Jurisdiction' ;
    rdfs:comment 'The legal jurisdiction (ISO 3166-1 alpha-2 or alpha-3 country/state code) whose corporate law governs the validity and interpretation of this resolution (e.g., US-DE for Delaware, GBR for United Kingdom). Determines applicable corporate law requirements.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMaterialEvent rdf:type rdf:Property ;
    rdfs:label 'Is Material Event' ;
    rdfs:comment 'Indicates whether this resolution constitutes a material event requiring public disclosure under SEC reporting obligations (e.g., Form 8-K). Drives the regulatory filing workflow and investor relations notification process.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWrittenConsent rdf:type rdf:Property ;
    rdfs:label 'Is Written Consent' ;
    rdfs:comment 'Indicates whether this resolution was passed via unanimous written consent of the board without a physical or virtual meeting, as permitted under applicable corporate law. Written consent resolutions have specific execution and record-keeping requirements.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meetingDate rdf:type rdf:Property ;
    rdfs:label 'Meeting Date' ;
    rdfs:comment 'The calendar date on which the board meeting was held. For written consent resolutions, this is the date the last required signature was obtained. May differ from resolution_date if the resolution was formally recorded on a different date.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:meetingReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Meeting Reference Number' ;
    rdfs:comment 'The unique identifier assigned to the board meeting at which this resolution was considered. Used to cross-reference board minutes, agenda items, and other resolutions passed at the same meeting.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meetingType rdf:type rdf:Property ;
    rdfs:label 'Meeting Type' ;
    rdfs:comment 'The type of board meeting or process through which the resolution was passed. \'regular\' is a scheduled board meeting; \'special\' is a called meeting for specific matters; \'annual\' is the annual general meeting; \'written_consent\' is a resolution passed without a physical meeting via unanimous written consent; \'emergency\' is an expedited meeting for urgent matters.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minutesDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Minutes Document Reference' ;
    rdfs:comment 'The unique path, URI, or identifier pointing to the official board meeting minutes document in which this resolution is recorded. Distinct from document_storage_reference which points to the standalone resolution document.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quorumAchieved rdf:type rdf:Property ;
    rdfs:label 'Quorum Achieved' ;
    rdfs:comment 'Indicates whether the required quorum of board members was present or represented at the time of the vote, as defined in the entity\'s articles of incorporation or bylaws. A resolution passed without quorum is legally invalid.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quorumThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Quorum Threshold Pct' ;
    rdfs:comment 'The minimum percentage of board members required to be present or represented to constitute a valid quorum for this meeting, as specified in the entity\'s governing documents. Typically 50% or 51% but may vary by entity and resolution type.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recusedDirectors rdf:type rdf:Property ;
    rdfs:label 'Recused Directors' ;
    rdfs:comment 'Comma-separated list of director names or identifiers who recused themselves from the vote due to a declared conflict of interest. Required for conflict-of-interest governance documentation and audit trail.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Reference' ;
    rdfs:comment 'The reference number or identifier of the regulatory filing submitted as a result of this resolution (e.g., SEC Form 8-K accession number, FCC filing ID). Populated only when regulatory_filing_required is True and the filing has been submitted.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Required' ;
    rdfs:comment 'Indicates whether this resolution triggers a mandatory regulatory filing obligation (e.g., SEC Form 8-K material event disclosure, FCC license transfer notification, FIFA/league governance notification). Drives compliance workflow routing.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relatedResolutionNumber rdf:type rdf:Property ;
    rdfs:label 'Related Resolution Number' ;
    rdfs:comment 'The resolution_number of a prior resolution that this resolution amends, ratifies, supersedes, or is otherwise directly related to. Enables governance lineage tracking across the resolution lifecycle.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionCategory rdf:type rdf:Property ;
    rdfs:label 'Resolution Category' ;
    rdfs:comment 'High-level business category classifying the subject matter of the resolution. Supports governance reporting and analytics. [ENUM-REF-CANDIDATE: financial|legal|operational|governance|personnel|regulatory|strategic|ip_licensing|media_rights|venue|sponsorship — promote to reference product]' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionNumber rdf:type rdf:Property ;
    rdfs:label 'Resolution Number' ;
    rdfs:comment 'Externally-known, human-readable unique identifier assigned to the resolution by the corporate secretary. Follows the entity-year-sequence format (e.g., SE-RES-2024-000123). Used in legal filings, board minutes, and regulatory submissions.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionStatus rdf:type rdf:Property ;
    rdfs:label 'Resolution Status' ;
    rdfs:comment 'Current lifecycle state of the board resolution. \'draft\' indicates preparation; \'pending_vote\' indicates scheduled for vote; \'passed\' indicates approved by required majority; \'failed\' indicates rejected; \'withdrawn\' indicates removed before vote; \'superseded\' indicates replaced by a subsequent resolution.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionSummary rdf:type rdf:Property ;
    rdfs:label 'Resolution Summary' ;
    rdfs:comment 'A concise plain-language summary of the resolution\'s purpose and key provisions, suitable for governance dashboards, board portals, and non-legal stakeholder reporting. Distinct from resolution_text which contains the full legal language.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionText rdf:type rdf:Property ;
    rdfs:label 'Resolution Text' ;
    rdfs:comment 'The complete verbatim text of the resolution as formally adopted by the board, including all WHEREAS recitals and RESOLVED clauses. This is the authoritative legal text of the resolution. Classified as confidential due to sensitive business and legal content.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signingAuthorityLimit rdf:type rdf:Property ;
    rdfs:label 'Signing Authority Limit' ;
    rdfs:comment 'The maximum monetary value (in the entity\'s functional currency) that the authorized signatories named in this resolution are empowered to commit on behalf of the entity. Null if the resolution grants unlimited signing authority or is non-monetary in nature.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalEligibleVoters rdf:type rdf:Property ;
    rdfs:label 'Total Eligible Voters' ;
    rdfs:comment 'The total number of board members eligible to vote on this resolution at the time of the meeting. Used to calculate quorum compliance and majority thresholds for governance audit purposes.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:voteOutcome rdf:type rdf:Property ;
    rdfs:label 'Vote Outcome' ;
    rdfs:comment 'The result of the board vote on this resolution. \'unanimous\' means all voting members approved; \'majority\' means more than half approved; \'split\' means a non-majority result; \'tied\' means equal votes for and against; \'no_vote\' means the resolution was tabled or withdrawn before a vote was taken.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:votesAbstained rdf:type rdf:Property ;
    rdfs:label 'Votes Abstained' ;
    rdfs:comment 'The count of board members who were present but formally abstained from voting on the resolution, typically due to a declared conflict of interest or recusal.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:votesAgainst rdf:type rdf:Property ;
    rdfs:label 'Votes Against' ;
    rdfs:comment 'The count of board member votes cast against the resolution. A non-zero value triggers documentation of dissenting director positions per governance best practices.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:votesFor rdf:type rdf:Property ;
    rdfs:label 'Votes For' ;
    rdfs:comment 'The count of board member votes cast in favor of the resolution. Used to document the precise vote tally in board minutes and governance records.' ;
    rdfs:domain ind:BoardResolution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractObligationId rdf:type rdf:Property ;
    rdfs:label 'Contract Obligation Id' ;
    rdfs:comment 'Unique system-generated identifier for each contract obligation record tracked in the legal domain.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContractObligation .

ind:licensingAgreementId rdf:type rdf:Property ;
    rdfs:label 'Licensing Agreement Id' ;
    rdfs:comment 'Foreign key linking to merchandise.licensing_agreement. Business justification: Merchandise licensing agreements generate contract obligations (royalty payment deadlines, audit submissions, brand compliance certifications). contract_obligation.source_contract_id only covers athle' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LicensingAgreement .

ind:primaryContractLitigationCaseId rdf:type rdf:Property ;
    rdfs:label 'Primary Contract Litigation Case Id' ;
    rdfs:comment 'Reference to an active litigation case if this obligation is subject to dispute or legal proceedings. Links to the litigation_case product in the legal domain.' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LitigationCase .

ind:relatedIpAssetId rdf:type rdf:Property ;
    rdfs:label 'Related Ip Asset Id' ;
    rdfs:comment 'Reference to an intellectual property (IP) portfolio asset if this obligation relates to IP licensing, royalty payments, or IP usage rights (e.g., NIL agreement obligations, broadcast DRM obligations).' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:relatedIpAssetIpPortfolioId rdf:type rdf:Property ;
    rdfs:label 'Related Ip Asset Ip Portfolio Id' ;
    rdfs:comment 'Reference to an intellectual property (IP) portfolio asset if this obligation relates to IP licensing, royalty payments, or IP usage rights (e.g., NIL agreement obligations, broadcast DRM obligations).' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IpPortfolio .

ind:sponsorshipDealTermId rdf:type rdf:Property ;
    rdfs:label 'Sponsorship Deal Term Id' ;
    rdfs:comment 'Foreign key linking to sponsorship.deal_term. Business justification: Sponsorship deal terms generate contractual obligations (payment milestones, activation deliverables, exclusivity enforcement, reporting requirements) tracked by the legal team. Linking contract_oblig' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DealTerm .

ind:advanceAlertDays rdf:type rdf:Property ;
    rdfs:label 'Advance Alert Days' ;
    rdfs:comment 'Number of calendar days before the due date that an automated alert or reminder should be triggered to the responsible owner. Enables proactive compliance management.' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cbaRelated rdf:type rdf:Property ;
    rdfs:label 'Cba Related' ;
    rdfs:comment 'Indicates whether this obligation originates from or is governed by a Collective Bargaining Agreement (CBA) between the league and a players association. Relevant for athlete salary, benefit, and working condition obligations.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:completionStatus rdf:type rdf:Property ;
    rdfs:label 'Completion Status' ;
    rdfs:comment 'Indicates whether the obligation has been fully satisfied (True) or remains outstanding (False). Used in conjunction with obligation_status for compliance dashboards.' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractClauseReference rdf:type rdf:Property ;
    rdfs:label 'Contract Clause Reference' ;
    rdfs:comment 'Section, article, or clause number within the source contract from which this obligation was extracted (e.g., \'Section 4.2(b)\', \'Article 7 — Payment Terms\'). Enables rapid navigation to the source obligation text.' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractDomain rdf:type rdf:Property ;
    rdfs:label 'Contract Domain' ;
    rdfs:comment 'Business domain pointer identifying which operational area the source contract belongs to (e.g., athlete contract, sponsorship deal, broadcast rights deal). Enables cross-domain obligation management. [ENUM-REF-CANDIDATE: athlete|sponsorship|broadcast|venue|merchandise|ticketing|content|workforce|finance|legal|compliance|other — promote to reference product]' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeDescription rdf:type rdf:Property ;
    rdfs:label 'Dispute Description' ;
    rdfs:comment 'Narrative description of the nature of the dispute if the obligation is contested between the obligor and obligee. Populated only when obligation_status is \'disputed\'.' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Evidence Document Reference' ;
    rdfs:comment 'Reference number or URL to the document, receipt, report, or artifact that serves as evidence of obligation fulfillment (e.g., payment confirmation, submitted report, signed acknowledgment).' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingLaw rdf:type rdf:Property ;
    rdfs:label 'Governing Law' ;
    rdfs:comment 'Jurisdiction whose laws govern the interpretation and enforcement of the obligation (e.g., \'New York, USA\', \'England and Wales\', \'California, USA\'). Derived from the source contract.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMaterialObligation rdf:type rdf:Property ;
    rdfs:label 'Is Material Obligation' ;
    rdfs:comment 'Indicates whether this obligation is considered material to the contract such that non-performance could constitute a material breach, trigger termination rights, or require SEC/SOX disclosure.' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionCountryCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the primary legal jurisdiction governing this obligation. Used for regulatory compliance filtering (e.g., GDPR for EU obligations, CCPA for California).' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Notice Period Days' ;
    rdfs:comment 'Number of calendar days of advance notice required before the obligation action must be taken or communicated. Particularly relevant for renewal options, termination rights, and notice obligations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:obligationReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Obligation Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier for the obligation, used in correspondence with counterparties and outside counsel. Format: OBL-[DOMAIN]-[YEAR]-[SEQUENCE].' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationTitle rdf:type rdf:Property ;
    rdfs:label 'Obligation Title' ;
    rdfs:comment 'Short human-readable title summarizing the obligation (e.g., \'Q2 Sponsorship Payment\', \'Annual Compliance Report Submission\', \'Renewal Notice Window\'). Used in dashboards and notifications.' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligeePartyName rdf:type rdf:Property ;
    rdfs:label 'Obligee Party Name' ;
    rdfs:comment 'Name of the party who is entitled to receive the benefit of the obligation (the party to whom performance, payment, or deliverable is owed under the contract).' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligeePartyType rdf:type rdf:Property ;
    rdfs:label 'Obligee Party Type' ;
    rdfs:comment 'Classification of the obligee party to distinguish internal business entities from external counterparties such as athletes, sponsors, broadcasters, or vendors. [ENUM-REF-CANDIDATE: internal_entity|athlete|sponsor|broadcaster|venue_operator|vendor|league|agent|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligorPartyName rdf:type rdf:Property ;
    rdfs:label 'Obligor Party Name' ;
    rdfs:comment 'Name of the party who bears the obligation and must fulfill the commitment (the party who owes the performance, payment, or deliverable under the contract).' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligorPartyType rdf:type rdf:Property ;
    rdfs:label 'Obligor Party Type' ;
    rdfs:comment 'Classification of the obligor party to distinguish internal business entities from external counterparties such as athletes, sponsors, broadcasters, or vendors. [ENUM-REF-CANDIDATE: internal_entity|athlete|sponsor|broadcaster|venue_operator|vendor|league|agent|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Amount' ;
    rdfs:comment 'Monetary value of the obligation for payment-type obligations (e.g., sponsorship fee installment, athlete salary milestone, broadcast rights royalty). Null for non-monetary obligations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recurrencePattern rdf:type rdf:Property ;
    rdfs:label 'Recurrence Pattern' ;
    rdfs:comment 'Frequency at which the obligation repeats. One-time obligations have a single due date; recurring obligations generate new instances per the pattern (e.g., quarterly royalty payments, annual compliance reports). [ENUM-REF-CANDIDATE: one_time|daily|weekly|monthly|quarterly|semi_annual|annual — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleDepartment rdf:type rdf:Property ;
    rdfs:label 'Responsible Department' ;
    rdfs:comment 'Internal business unit or department accountable for fulfilling or monitoring this obligation (e.g., Finance, Legal, Athlete Relations, Broadcast Operations, Sponsorship).' ;
    rdfs:domain ind:ContractObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleOwner rdf:type rdf:Property ;
    rdfs:label 'Responsible Owner' ;
    rdfs:comment 'Name or identifier of the internal business owner accountable for ensuring this obligation is fulfilled on time. Typically a department head, contract manager, or designated employee.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverReason rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason' ;
    rdfs:comment 'Narrative explanation for why this obligation was waived by the obligee party. Populated only when obligation_status is \'waived\'. Required for audit trail and legal defensibility.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentTemplateContractTemplateId rdf:type rdf:Property ;
    rdfs:label 'Parent Template Contract Template Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the predecessor template version from which this version was derived. Enables version lineage tracking and rollback capability. Null for the initial version of a template.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContractTemplate .

ind:primaryContractEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Contract Employee Id' ;
    rdfs:comment 'Identifier of the in-house counsel or legal team member responsible for maintaining, reviewing, and approving this template. Links to the workforce/employee domain for accountability and escalation routing.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primarySupersededByTemplateContractTemplateId rdf:type rdf:Property ;
    rdfs:label 'Primary Superseded By Template Contract Template Id' ;
    rdfs:comment 'Identifier of the newer template version that replaces this one. Populated when a template is deprecated. Enables legal staff to navigate from an old version to the current approved version.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContractTemplate .

ind:approvalWorkflowType rdf:type rdf:Property ;
    rdfs:label 'Approval Workflow Type' ;
    rdfs:comment 'Defines the required approval workflow that must be completed before this template can be used or before a new version is published. Drives routing in the contract management system (e.g., Salesforce CRM contract approval flows).' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arbitrationClauseIncluded rdf:type rdf:Property ;
    rdfs:label 'Arbitration Clause Included' ;
    rdfs:comment 'Indicates whether this template includes a mandatory arbitration clause for dispute resolution. Relevant for athlete contracts (CAS arbitration), international agreements, and high-value commercial deals.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clauseCount rdf:type rdf:Property ;
    rdfs:label 'Clause Count' ;
    rdfs:comment 'Number of distinct clauses or sections in the template. Used for legal complexity scoring, review time estimation, and comparison across template versions.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:confidentialityClauseIncluded rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Clause Included' ;
    rdfs:comment 'Indicates whether this template includes confidentiality and non-disclosure provisions. Distinct from standalone NDA templates — this flag captures whether confidentiality is embedded within a broader agreement template.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractTemplateCategory rdf:type rdf:Property ;
    rdfs:label 'Contract Template Category' ;
    rdfs:comment 'Classification of the contract template by business function and legal category. Drives routing to the appropriate in-house counsel team and approval workflow. [ENUM-REF-CANDIDATE: NIL_AGREEMENT|VENUE_RENTAL|BROADCAST_RIGHTS|SPONSORSHIP|MERCHANDISE_LICENSE|EMPLOYMENT_OFFER|NDA|VENDOR_MSA — promote to reference product]' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartyType rdf:type rdf:Property ;
    rdfs:label 'Counterparty Type' ;
    rdfs:comment 'Classification of the external party type that this template is designed to contract with. Drives counterparty-specific clause libraries and compliance requirements (e.g., WADA clauses for ATHLETE, PCI-DSS clauses for VENDOR). [ENUM-REF-CANDIDATE: ATHLETE|VENUE_OPERATOR|BROADCASTER|SPONSOR|VENDOR|EMPLOYEE|LICENSEE|AGENT — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPrivacyClausesIncluded rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Clauses Included' ;
    rdfs:comment 'Indicates whether this template includes data privacy and protection clauses compliant with applicable regulations (GDPR, CCPA). Required for templates involving fan data, athlete personal data, or any personal data processing by counterparties.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentFormat rdf:type rdf:Property ;
    rdfs:label 'Document Format' ;
    rdfs:comment 'File format of the template document (DOCX for editable Word templates, PDF for locked reference copies, HTML for web-based contract generation, MARKDOWN for API-driven contract assembly).' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forceMajeureIncluded rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Included' ;
    rdfs:comment 'Indicates whether this template includes a force majeure clause covering unforeseeable events (pandemics, natural disasters, government actions) that excuse non-performance. Became critical post-COVID for event and broadcast contracts.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:indemnificationIncluded rdf:type rdf:Property ;
    rdfs:label 'Indemnification Included' ;
    rdfs:comment 'Indicates whether this template includes indemnification provisions protecting Sports Entertainment from third-party claims arising from counterparty actions. Standard in venue rental, vendor MSA, and broadcast rights templates.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceRequirement rdf:type rdf:Property ;
    rdfs:label 'Insurance Requirement' ;
    rdfs:comment 'Minimum insurance coverage type that counterparties must carry when executing contracts based on this template. Relevant for venue rental, vendor MSA, and event production templates. Drives counterparty onboarding requirements.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipRightsIncluded rdf:type rdf:Property ;
    rdfs:label 'Ip Rights Included' ;
    rdfs:comment 'Indicates whether this template includes intellectual property (IP) rights clauses covering ownership, licensing, or assignment of IP (e.g., NIL rights, broadcast IP, merchandise IP). True = IP clauses present; False = no IP provisions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isApprovedForUse rdf:type rdf:Property ;
    rdfs:label 'Is Approved For Use' ;
    rdfs:comment 'Indicates whether this template version has received all required approvals and is currently authorized for use in generating executed contract instances across Sports Entertainment business units. True = approved and active; False = not yet approved or withdrawn.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Review Date' ;
    rdfs:comment 'Date on which this template was most recently reviewed by in-house counsel for legal accuracy, regulatory compliance, and business relevance. Supports scheduled review cadence tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nilProvisionsIncluded rdf:type rdf:Property ;
    rdfs:label 'Nil Provisions Included' ;
    rdfs:comment 'Indicates whether this template contains NIL (Name, Image, and Likeness) specific provisions governing athlete commercial rights. Relevant for athlete endorsement, sponsorship, and licensing templates under NCAA and state NIL regulations.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentTermsIncluded rdf:type rdf:Property ;
    rdfs:label 'Payment Terms Included' ;
    rdfs:comment 'Indicates whether this template includes standard payment terms clauses (e.g., net-30, milestone-based payments, revenue share). Relevant for sponsorship, merchandise licensing, and vendor MSA templates.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiredApproverRole rdf:type rdf:Property ;
    rdfs:label 'Required Approver Role' ;
    rdfs:comment 'The minimum organizational role required to approve this template for use (e.g., \'General Counsel\', \'VP Legal\', \'Chief Legal Officer\'). Ensures appropriate seniority of sign-off relative to contract risk level.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Review Frequency Months' ;
    rdfs:comment 'Mandatory review cycle expressed in months (e.g., 6, 12, 24). Determines how frequently the template must be reviewed and re-approved to remain in active use. Drives automated scheduling of next_review_date.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskTier rdf:type rdf:Property ;
    rdfs:label 'Risk Tier' ;
    rdfs:comment 'Legal risk classification of contracts generated from this template. Drives approval workflow stringency, required approver seniority, and insurance coverage requirements. CRITICAL tier requires CLO sign-off.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Source Document Url' ;
    rdfs:comment 'Secure URL pointing to the authoritative template document stored in the legal document management system (e.g., SharePoint, iManage, or DAM). Provides direct access to the template file for legal staff. Classified confidential as it contains proprietary legal language.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateCode rdf:type rdf:Property ;
    rdfs:label 'Template Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this template across business units (e.g., NIL-ATH-v2, VEN-RNT-v1). Used as the human-readable business identifier in legal workflows and document management systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateLanguage rdf:type rdf:Property ;
    rdfs:label 'Template Language' ;
    rdfs:comment 'ISO 639-1/639-2 language code of the template (e.g., \'en\', \'es\', \'fr\', \'pt-BR\'). Supports multi-language template libraries for international markets (FIFA global operations, MLS, international broadcast deals).' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateName rdf:type rdf:Property ;
    rdfs:label 'Template Name' ;
    rdfs:comment 'Descriptive human-readable name of the contract template (e.g., \'Athlete NIL Agreement Template\', \'Venue Rental Agreement Template\', \'Broadcast Rights Term Sheet\'). Used for display in legal portals and approval workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateStatus rdf:type rdf:Property ;
    rdfs:label 'Template Status' ;
    rdfs:comment 'Current lifecycle state of the contract template. Only templates in APPROVED status may be used to generate executed contract instances. DEPRECATED templates are superseded by newer versions but retained for reference.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationForCauseIncluded rdf:type rdf:Property ;
    rdfs:label 'Termination For Cause Included' ;
    rdfs:comment 'Indicates whether this template includes termination-for-cause provisions (e.g., PED violations, conduct detrimental to the league, breach of CBA). Critical for athlete and broadcast rights templates.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timesUsedCount rdf:type rdf:Property ;
    rdfs:label 'Times Used Count' ;
    rdfs:comment 'Number of executed contract instances that have been generated from this template version. Provides usage analytics to prioritize template maintenance and identify high-impact templates for review.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typicalContractValueTier rdf:type rdf:Property ;
    rdfs:label 'Typical Contract Value Tier' ;
    rdfs:comment 'Indicative financial value tier of contracts typically generated from this template. Used for financial controls routing, approval authority thresholds, and insurance coverage adequacy assessment. Classified confidential as it reveals commercial strategy.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wordCount rdf:type rdf:Property ;
    rdfs:label 'Word Count' ;
    rdfs:comment 'Approximate word count of the template document. Used for complexity assessment, translation cost estimation, and legal review time planning.' ;
    rdfs:domain ind:ContractTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intercompanyTradingPartnerCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Intercompany Trading Partner Corporate Entity Id' ;
    rdfs:comment 'SAP S/4HANA intercompany trading partner identifier assigned to this entity for intercompany elimination and reconciliation in consolidated financial statements. Enables automated intercompany matching in the ERP.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:parentEntityCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Parent Entity Corporate Entity Id' ;
    rdfs:comment 'Reference to the immediate parent legal entity in the corporate ownership hierarchy. Null for the ultimate holding company. Enables traversal of the full corporate structure for consolidation, governance, and intercompany transaction management.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:primaryUltimateParentEntityCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Primary Ultimate Parent Entity Corporate Entity Id' ;
    rdfs:comment 'Reference to the top-level holding company in the corporate ownership chain. Supports consolidated reporting, regulatory group filings (e.g., SEC 10-K), and EBITDA roll-up across the entire Sports Entertainment enterprise.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:annualReportDueDate rdf:type rdf:Property ;
    rdfs:label 'Annual Report Due Date' ;
    rdfs:comment 'Date by which the entity must file its annual report or renewal with the jurisdiction of incorporation to maintain good standing. Drives compliance calendar and legal operations workflow.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:broadcastLicenseHolder rdf:type rdf:Property ;
    rdfs:label 'Broadcast License Holder' ;
    rdfs:comment 'Indicates whether this entity holds broadcast or media rights licenses (e.g., RSN operating subsidiary, OTT platform entity). Drives FCC regulatory compliance obligations and DRM policy applicability.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consolidationMethod rdf:type rdf:Property ;
    rdfs:label 'Consolidation Method' ;
    rdfs:comment 'Accounting consolidation method applied to this entity in group financial statements. \'full\' for wholly/majority-owned subsidiaries, \'proportional\' for jointly controlled entities, \'equity\' for associates, \'none\' for unconsolidated entities.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doingBusinessAs rdf:type rdf:Property ;
    rdfs:label 'Doing Business As' ;
    rdfs:comment 'Trade name or brand name under which the entity operates publicly, if different from the legal name (e.g., \'SE Arena Operations\'). Relevant for marketing, fan-facing communications, and venue signage.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ein rdf:type rdf:Property ;
    rdfs:label 'Ein' ;
    rdfs:comment 'IRS-assigned Employer Identification Number (EIN) / Federal Tax Identification Number for US entities. Used for tax filings, payroll, and intercompany financial transactions. Equivalent to VAT/GST registration number for non-US entities.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityStatus rdf:type rdf:Property ;
    rdfs:label 'Entity Status' ;
    rdfs:comment 'Current lifecycle status of the legal entity. Drives eligibility for intercompany transactions, regulatory filings, and governance workflows. \'dissolved\' indicates the entity has been formally wound up.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entitySubtype rdf:type rdf:Property ;
    rdfs:label 'Entity Subtype' ;
    rdfs:comment 'Functional subclassification of the entity within the Sports Entertainment corporate hierarchy. Distinguishes parent holding companies, league operating entities, franchise LLCs, venue operating companies, broadcast subsidiaries, and joint ventures for governance and reporting purposes. [ENUM-REF-CANDIDATE: holding_company|league_operating|franchise|venue_operating|broadcast_subsidiary|joint_venture|management_company|licensing_entity — promote to reference product]' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalYearEndMonth rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year End Month' ;
    rdfs:comment 'Calendar month (1–12) in which the entity\'s fiscal year ends. Drives financial reporting cycles, SAP S/4HANA FI period configuration, and Workday Adaptive Planning budget calendars.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:formationDate rdf:type rdf:Property ;
    rdfs:label 'Formation Date' ;
    rdfs:comment 'The date on which the legal entity was formally incorporated or organized under the laws of its jurisdiction. Establishes the entity\'s legal existence and is required for regulatory filings and governance records.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:functionalCurrency rdf:type rdf:Property ;
    rdfs:label 'Functional Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code representing the primary currency in which the entity conducts its operations and maintains its books (e.g., \'USD\', \'GBP\', \'EUR\'). Required for intercompany eliminations and consolidated financial reporting.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goodStandingStatus rdf:type rdf:Property ;
    rdfs:label 'Good Standing Status' ;
    rdfs:comment 'Current standing of the entity with its jurisdiction of incorporation, reflecting whether all required filings, fees, and reports are current. \'delinquent\' or \'revoked\' status may restrict the entity\'s ability to conduct business or enter contracts.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goodStandingVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Good Standing Verified Date' ;
    rdfs:comment 'Most recent date on which the entity\'s good standing was verified with the jurisdiction of incorporation. Supports compliance monitoring and annual governance review cycles.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incorporationJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Incorporation Jurisdiction' ;
    rdfs:comment 'ISO 3166-1 alpha-2 country code or US state abbreviation (e.g., \'DE\' for Delaware, \'USA\' for federal) representing the jurisdiction where the entity was legally formed. Determines applicable corporate law and regulatory obligations.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPubliclyTraded rdf:type rdf:Property ;
    rdfs:label 'Is Publicly Traded' ;
    rdfs:comment 'Indicates whether this entity\'s securities are listed on a public stock exchange. Triggers SEC reporting obligations (10-K, 10-Q), SOX internal controls requirements, and enhanced financial disclosure standards.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueAffiliation rdf:type rdf:Property ;
    rdfs:label 'League Affiliation' ;
    rdfs:comment 'Professional sports league or governing body with which this entity is affiliated (e.g., NFL franchise LLC, NBA team operating company). Drives CBA compliance obligations, revenue sharing rules, and league governance requirements. [ENUM-REF-CANDIDATE: NFL|NBA|MLB|NHL|MLS|FIFA|UFC|ATP|independent|none — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilAgreementEligible rdf:type rdf:Property ;
    rdfs:label 'Nil Agreement Eligible' ;
    rdfs:comment 'Indicates whether this entity is authorized to enter into NIL (Name, Image, and Likeness) agreements with athletes. Relevant for franchise LLCs and management company entities operating under NCAA or professional league NIL frameworks.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ownershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Ownership Percentage' ;
    rdfs:comment 'Percentage of the entity owned by its immediate parent entity, expressed as a decimal (e.g., 100.00 for wholly owned, 51.00 for majority-owned JV). Drives consolidation treatment under GAAP/IFRS and intercompany elimination rules.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pciDssScope rdf:type rdf:Property ;
    rdfs:label 'Pci Dss Scope' ;
    rdfs:comment 'Indicates whether this entity is within PCI-DSS scope due to processing, storing, or transmitting payment card data (e.g., ticketing entities, merchandise e-commerce subsidiaries). Drives PCI SSC compliance program requirements.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:principalOfficeAddress rdf:type rdf:Property ;
    rdfs:label 'Principal Office Address' ;
    rdfs:comment 'Full address of the entity\'s principal place of business, which may differ from the registered address. Used for operational correspondence, SEC filings, and venue/league operations coordination.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Registered Address Line1' ;
    rdfs:comment 'Primary street address line of the entity\'s official registered office as filed with the jurisdiction of incorporation. Used in regulatory filings, legal notices, and governance documentation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Registered Address Line2' ;
    rdfs:comment 'Secondary address line (suite, floor, unit) of the entity\'s official registered office. Supplements registered_address_line1 for complete address representation.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAgentName rdf:type rdf:Property ;
    rdfs:label 'Registered Agent Name' ;
    rdfs:comment 'Full legal name of the registered agent designated to receive official legal and regulatory correspondence on behalf of the entity in its jurisdiction of incorporation. Required for maintaining good standing.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredCity rdf:type rdf:Property ;
    rdfs:label 'Registered City' ;
    rdfs:comment 'City of the entity\'s official registered office address as filed with the jurisdiction of incorporation.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredCountry rdf:type rdf:Property ;
    rdfs:label 'Registered Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the entity\'s official registered office (e.g., \'USA\', \'GBR\', \'DEU\'). Drives international regulatory compliance, GDPR applicability, and cross-border tax obligations.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredPostalCode rdf:type rdf:Property ;
    rdfs:label 'Registered Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the entity\'s official registered office address.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredStateProvince rdf:type rdf:Property ;
    rdfs:label 'Registered State Province' ;
    rdfs:comment 'State or province of the entity\'s official registered office. Used for jurisdictional compliance, tax nexus determination, and regulatory filings.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Sap Company Code' ;
    rdfs:comment 'Four-character SAP S/4HANA FI company code assigned to this legal entity. The SSOT identifier used in all financial accounting, controlling, and intercompany transaction postings within the ERP system.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soxReportingEntity rdf:type rdf:Property ;
    rdfs:label 'Sox Reporting Entity' ;
    rdfs:comment 'Indicates whether this entity is included in the SOX Section 302/404 internal controls assessment and financial reporting scope. Applies to publicly traded entities and their material subsidiaries.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stockExchange rdf:type rdf:Property ;
    rdfs:label 'Stock Exchange' ;
    rdfs:comment 'Name of the stock exchange on which the entity\'s securities are listed. Null for private entities. Drives applicable listing standards, disclosure requirements, and investor relations obligations.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stockTicker rdf:type rdf:Property ;
    rdfs:label 'Stock Ticker' ;
    rdfs:comment 'Exchange ticker symbol for publicly traded entities (e.g., \'MSG\' for Madison Square Garden Sports). Null for private entities. Used in SEC filings, investor relations, and financial market data integration.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdNonUs rdf:type rdf:Property ;
    rdfs:label 'Tax Id Non Us' ;
    rdfs:comment 'Tax registration number for entities incorporated outside the United States (e.g., VAT number, GST number, company registration number). Supports international regulatory filings and cross-border intercompany transactions.' ;
    rdfs:domain ind:CorporateEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counselEngagementId rdf:type rdf:Property ;
    rdfs:label 'Counsel Engagement Id' ;
    rdfs:comment 'Unique system-generated identifier for each outside counsel engagement record issued by Sports Entertainment. Serves as the primary key for this transactional entity. Role: TRANSACTION_HEADER.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CounselEngagement .

ind:approvingCounselEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approving Counsel Employee Id' ;
    rdfs:comment 'Reference to the in-house attorney who reviewed and approved this outside counsel engagement. Required for internal authorization controls and legal spend governance.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:outsideCounselFirmOutsideCounselId rdf:type rdf:Property ;
    rdfs:label 'Outside Counsel Firm Outside Counsel Id' ;
    rdfs:comment 'Reference to the external law firm engaged to provide legal services. Used for outside counsel performance tracking, spend analytics, and vendor management reporting.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OutsideCounsel .

ind:actualSpendToDate rdf:type rdf:Property ;
    rdfs:label 'Actual Spend To Date' ;
    rdfs:comment 'Cumulative amount invoiced and approved for payment against this engagement as of the most recent update, expressed in the billing currency. Compared against budget_cap_amount to assess budget utilization and flag overruns.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedBillingRate rdf:type rdf:Property ;
    rdfs:label 'Approved Billing Rate' ;
    rdfs:comment 'The hourly billing rate (in USD) approved by Sports Entertainment for the lead attorney or primary timekeeper on this engagement. Applicable when billing_arrangement_type is \'hourly\' or \'blended_rate\'. Used for invoice validation and legal spend benchmarking.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingArrangementType rdf:type rdf:Property ;
    rdfs:label 'Billing Arrangement Type' ;
    rdfs:comment 'The fee structure agreed upon with outside counsel for this engagement. \'hourly\' charges by time spent; \'flat_fee\' is a fixed amount for defined scope; \'contingency\' is a percentage of recovery; \'blended_rate\' applies a single rate across all timekeepers; \'retainer\' is a periodic fixed fee for availability.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Billing Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which all billing amounts for this engagement are denominated (e.g., USD, GBP, EUR). Supports multi-currency legal spend management for international outside counsel engagements.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetAlertThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Budget Alert Threshold Pct' ;
    rdfs:comment 'The percentage of the budget_cap_amount at which an automated budget alert notification is triggered to the approving in-house counsel and legal operations team (e.g., 80.00 for 80%). Supports proactive legal spend management.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetCapAmount rdf:type rdf:Property ;
    rdfs:label 'Budget Cap Amount' ;
    rdfs:comment 'The maximum authorized spend limit approved for this outside counsel engagement, expressed in the billing currency. Triggers budget alert workflows when actual spend approaches or exceeds this threshold. Core to legal spend management and EBITDA control.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:conflictCheckCompleted rdf:type rdf:Property ;
    rdfs:label 'Conflict Check Completed' ;
    rdfs:comment 'Indicates whether a formal conflict of interest check was performed by the outside counsel firm prior to engagement commencement. Required under ABA Model Rules to ensure no adverse representation conflicts exist.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conflictCheckDate rdf:type rdf:Property ;
    rdfs:label 'Conflict Check Date' ;
    rdfs:comment 'The date on which the outside counsel firm completed and certified the conflict of interest check for this engagement. Provides an audit trail for compliance with professional responsibility requirements.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contingencyFeePct rdf:type rdf:Property ;
    rdfs:label 'Contingency Fee Pct' ;
    rdfs:comment 'The percentage of any monetary recovery or settlement that outside counsel is entitled to receive when billing_arrangement_type is \'contingency\'. Null for non-contingency arrangements. Governed by ABA fee reasonableness standards.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:engagementClosureReason rdf:type rdf:Property ;
    rdfs:label 'Engagement Closure Reason' ;
    rdfs:comment 'The reason code explaining why the engagement was closed or terminated. Populated when engagement_status transitions to \'closed\' or \'terminated\'. Supports post-matter analysis and outside counsel performance reviews. [ENUM-REF-CANDIDATE: matter_resolved|settlement|budget_exhausted|scope_change|firm_change|client_termination|regulatory_resolution|other — promote to reference product]' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementLetterDate rdf:type rdf:Property ;
    rdfs:label 'Engagement Letter Date' ;
    rdfs:comment 'The date on which the formal engagement letter was executed and signed by both Sports Entertainment and the outside counsel firm. Establishes the contractual commencement point for the engagement.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:engagementNumber rdf:type rdf:Property ;
    rdfs:label 'Engagement Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to the engagement at issuance (e.g., CE-2024-000123). Used in engagement letters, invoices, and legal matter management systems to uniquely identify the engagement across departments and outside counsel firms.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseCapAmount rdf:type rdf:Property ;
    rdfs:label 'Expense Cap Amount' ;
    rdfs:comment 'Maximum authorized amount for reimbursable expenses under this engagement, expressed in billing currency. Null if expense_reimbursement_allowed is false or if no cap is set. Prevents uncontrolled disbursement spend.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenseReimbursementAllowed rdf:type rdf:Property ;
    rdfs:label 'Expense Reimbursement Allowed' ;
    rdfs:comment 'Indicates whether outside counsel is authorized to bill disbursements and out-of-pocket expenses (e.g., travel, court filing fees, expert witness fees) in addition to legal fees under this engagement.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:invoiceCount rdf:type rdf:Property ;
    rdfs:label 'Invoice Count' ;
    rdfs:comment 'Total number of invoices received from outside counsel against this engagement to date. Used for billing frequency analysis, outside counsel performance monitoring, and accounts payable workflow management.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:invoiceReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Invoice Review Required' ;
    rdfs:comment 'Indicates whether invoices submitted under this engagement require manual review by in-house counsel or legal operations before payment approval. Drives workflow routing in the accounts payable process.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastInvoiceDate rdf:type rdf:Property ;
    rdfs:label 'Last Invoice Date' ;
    rdfs:comment 'The date of the most recently received invoice from outside counsel under this engagement. Used to monitor billing activity, identify dormant engagements, and trigger follow-up actions.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leadAttorneyBarNumber rdf:type rdf:Property ;
    rdfs:label 'Lead Attorney Bar Number' ;
    rdfs:comment 'State bar registration number of the lead attorney, used to verify licensure and standing. Required for compliance with legal engagement governance policies and outside counsel guidelines.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadAttorneyName rdf:type rdf:Property ;
    rdfs:label 'Lead Attorney Name' ;
    rdfs:comment 'Full name of the primary attorney at the outside counsel firm responsible for managing and executing this engagement. Used for relationship management, performance evaluation, and matter continuity tracking.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ledesBillingFormat rdf:type rdf:Property ;
    rdfs:label 'Ledes Billing Format' ;
    rdfs:comment 'The Legal Electronic Data Exchange Standard (LEDES) format required for electronic invoice submission by outside counsel under this engagement. Ensures structured, machine-readable invoice data for automated processing and audit.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matterReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Matter Reference Number' ;
    rdfs:comment 'The internal matter management system reference number assigned to the underlying legal matter (e.g., from a legal matter management platform). Enables cross-system traceability between the engagement record and the matter management system.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matterType rdf:type rdf:Property ;
    rdfs:label 'Matter Type' ;
    rdfs:comment 'Classification of the legal matter category for which outside counsel is engaged. Drives routing, reporting, and benchmarking by matter type. [ENUM-REF-CANDIDATE: litigation|ip_trademark|contract_negotiation|regulatory_compliance|labor_employment|real_estate|corporate_governance|arbitration|mergers_acquisitions|tax — promote to reference product]' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndaExecuted rdf:type rdf:Property ;
    rdfs:label 'Nda Executed' ;
    rdfs:comment 'Indicates whether a Non-Disclosure Agreement (NDA) or confidentiality agreement has been executed with the outside counsel firm for this engagement. Particularly important for IP, broadcast rights, and athlete contract matters.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outsideCounselGuidelinesVersion rdf:type rdf:Property ;
    rdfs:label 'Outside Counsel Guidelines Version' ;
    rdfs:comment 'Version identifier of the Sports Entertainment Outside Counsel Guidelines document that governs this engagement (e.g., \'OCG-2024-v3.1\'). Ensures billing practices, staffing requirements, and reporting obligations are aligned to the correct policy version.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outsideCounselMatterNumber rdf:type rdf:Property ;
    rdfs:label 'Outside Counsel Matter Number' ;
    rdfs:comment 'The matter reference number assigned by the outside counsel firm in their own billing and matter management system. Required for invoice reconciliation and e-billing platform matching (e.g., eBillingHub, Legal Tracker).' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredVendorFlag rdf:type rdf:Property ;
    rdfs:label 'Preferred Vendor Flag' ;
    rdfs:comment 'Indicates whether the outside counsel firm is on Sports Entertainment\'s approved preferred vendor panel at the time of this engagement. Preferred panel firms have pre-negotiated rates and streamlined onboarding. Supports panel management and ROI analysis.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retainerAmount rdf:type rdf:Property ;
    rdfs:label 'Retainer Amount' ;
    rdfs:comment 'The periodic fixed retainer fee (in billing currency) paid to outside counsel for availability and ongoing services when billing_arrangement_type is \'retainer\'. Null for non-retainer arrangements.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retainerFrequency rdf:type rdf:Property ;
    rdfs:label 'Retainer Frequency' ;
    rdfs:comment 'The frequency at which the retainer_amount is paid to outside counsel. Applicable only when billing_arrangement_type is \'retainer\'. Used for accounts payable scheduling and cash flow forecasting.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeOfWork rdf:type rdf:Property ;
    rdfs:label 'Scope Of Work' ;
    rdfs:comment 'Narrative description of the legal services authorized under this engagement, as defined in the engagement letter. Specifies the matter type, deliverables, geographic jurisdiction, and any exclusions. Critical for invoice review and scope creep management.' ;
    rdfs:domain ind:CounselEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentDocumentGovernanceDocumentId rdf:type rdf:Property ;
    rdfs:label 'Parent Document Governance Document Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the original or parent governance document from which this record was derived (e.g., an amendment references its base agreement, a restated document references its predecessor). Null for original instruments.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GovernanceDocument .

ind:primarySupersededByDocumentGovernanceDocumentId rdf:type rdf:Property ;
    rdfs:label 'Primary Superseded By Document Governance Document Id' ;
    rdfs:comment 'Identifier of the governance document that replaced or superseded this record. Populated when document_status is \'superseded\', enabling forward navigation of the document version chain.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GovernanceDocument .

ind:arbitrationVenue rdf:type rdf:Property ;
    rdfs:label 'Arbitration Venue' ;
    rdfs:comment 'City or institution designated as the seat of arbitration or dispute resolution proceedings under this governance document (e.g., \'New York, NY\', \'Lausanne, Switzerland - CAS\', \'London - ICC\'). Applicable when dispute_resolution_mechanism is \'arbitration\'.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boardApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Board Approval Date' ;
    rdfs:comment 'Date on which the Board of Directors or equivalent governing body formally approved this governance document or its execution. Required for SOX compliance and corporate governance audit trails.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:counterpartyCount rdf:type rdf:Property ;
    rdfs:label 'Counterparty Count' ;
    rdfs:comment 'Total number of distinct counterparty entities named in the governance document. Supports complexity classification and multi-party agreement tracking.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:counterpartyNames rdf:type rdf:Property ;
    rdfs:label 'Counterparty Names' ;
    rdfs:comment 'Pipe-delimited list of the full legal names of all counterparties (other than the governing entity) who are signatories to this governance document (e.g., \'NFL League Office|Silver Lake Partners LP\'). Supports counterparty search and relationship mapping.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentLanguage rdf:type rdf:Property ;
    rdfs:label 'Document Language' ;
    rdfs:comment 'ISO 639-1 or ISO 639-2 language code of the primary language in which the governance document is written (e.g., \'en\' for English, \'fr\' for French, \'es\' for Spanish). Relevant for multi-jurisdictional agreements in global sports markets.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentName rdf:type rdf:Property ;
    rdfs:label 'Document Name' ;
    rdfs:comment 'Official title or name of the governance document as it appears on the executed instrument (e.g., \'Amended and Restated Certificate of Incorporation\', \'Sports Entertainment LLC Operating Agreement\').' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentStatus rdf:type rdf:Property ;
    rdfs:label 'Document Status' ;
    rdfs:comment 'Current lifecycle state of the governance document. \'draft\' indicates the document is in preparation; \'executed\' means fully signed and binding; \'superseded\' means replaced by a newer version; \'terminated\' means the agreement has been formally ended; \'under_review\' means currently being assessed for amendment or renewal.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executedByName rdf:type rdf:Property ;
    rdfs:label 'Executed By Name' ;
    rdfs:comment 'Full name of the authorized signatory representing Sports Entertainment who executed this governance document on behalf of the organization. Supports signatory authority audit and corporate authorization tracking.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executedByTitle rdf:type rdf:Property ;
    rdfs:label 'Executed By Title' ;
    rdfs:comment 'Official corporate title of the authorized signatory who executed this document on behalf of Sports Entertainment (e.g., \'Chief Executive Officer\', \'General Counsel\', \'President\'). Validates signatory authority level.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isConfidential rdf:type rdf:Property ;
    rdfs:label 'Is Confidential' ;
    rdfs:comment 'Indicates whether the governance document is subject to a confidentiality or non-disclosure obligation restricting its distribution. True means the document contains confidential terms; False means it is publicly disclosable (e.g., publicly filed articles of incorporation).' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPubliclyFiled rdf:type rdf:Property ;
    rdfs:label 'Is Publicly Filed' ;
    rdfs:comment 'Indicates whether this governance document has been filed with a public regulatory authority (e.g., SEC EDGAR, state secretary of state). True means the document is part of the public record; False means it is a private instrument.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalCounselName rdf:type rdf:Property ;
    rdfs:label 'Legal Counsel Name' ;
    rdfs:comment 'Name of the outside law firm or in-house counsel responsible for drafting, reviewing, or negotiating this governance document. Supports outside counsel relationship management and matter tracking.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notarizationDate rdf:type rdf:Property ;
    rdfs:label 'Notarization Date' ;
    rdfs:comment 'Date on which the governance document was notarized or apostilled, if notarization_required is True. Null if notarization is not required or has not yet occurred.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notarizationRequired rdf:type rdf:Property ;
    rdfs:label 'Notarization Required' ;
    rdfs:comment 'Indicates whether this governance document requires notarization or apostille certification for legal validity in the governing jurisdiction. True means notarization is a condition of enforceability.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:repositoryReference rdf:type rdf:Property ;
    rdfs:label 'Repository Reference' ;
    rdfs:comment 'Unique path, URI, or identifier pointing to the secure document repository location where the executed governance document is stored (e.g., SharePoint path, DocuSign envelope ID, or legal DMS record ID). Enables direct retrieval of the authoritative document.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repositorySystem rdf:type rdf:Property ;
    rdfs:label 'Repository System' ;
    rdfs:comment 'Name of the document management system or platform where the governance document is stored (e.g., \'imanage\', \'netdocs\', \'sharepoint\', \'docusign\'). Supports retrieval routing and system integration. [ENUM-REF-CANDIDATE: sharepoint|docusign|imanage|netdocs|opentext|box|other — promote to reference product]' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueSharingIncluded rdf:type rdf:Property ;
    rdfs:label 'Revenue Sharing Included' ;
    rdfs:comment 'Indicates whether this governance document contains revenue sharing, profit distribution, or financial allocation provisions (e.g., league revenue sharing, joint venture profit splits, partnership distributions). Relevant for financial reporting under SOX and EBITDA analysis.' ;
    rdfs:domain ind:GovernanceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryInsuranceEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Insurance Employee Id' ;
    rdfs:comment 'Reference to the party (individual, organization, or counterparty) who filed or is the subject of the insurance claim. Serves as the PARTY_REFERENCE for this transaction header. May be an athlete, employee, vendor, fan, or third party.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:claimNumber rdf:type rdf:Property ;
    rdfs:label 'Claim Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned to the claim at the time of filing, used for communication with the insurer, outside counsel, and internal risk management teams. Serves as the BUSINESS_IDENTIFIER for this transaction.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimPriority rdf:type rdf:Property ;
    rdfs:label 'Claim Priority' ;
    rdfs:comment 'Internal priority classification assigned to the claim based on financial exposure, reputational risk, and legal complexity. Drives resource allocation, escalation thresholds, and management reporting cadence.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimType rdf:type rdf:Property ;
    rdfs:label 'Claim Type' ;
    rdfs:comment 'Classification of the insurance claim by the nature of the loss or liability event. Drives routing to the appropriate insurer coverage line and in-house legal team. [ENUM-REF-CANDIDATE: property_damage|bodily_injury|workers_compensation|general_liability|media_liability|event_cancellation|directors_officers|cyber — promote to reference product]' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimedAmount rdf:type rdf:Property ;
    rdfs:label 'Claimed Amount' ;
    rdfs:comment 'Gross monetary amount initially claimed by the claimant or filed against the insurer at the time of submission. Represents the gross-base amount in the MONETARY_TRIPLET for this transaction. Used for reserve setting and exposure assessment.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageConfirmed rdf:type rdf:Property ;
    rdfs:label 'Coverage Confirmed' ;
    rdfs:comment 'Indicates whether the insurer has formally confirmed that the claim falls within the scope of the applicable policy coverage. True when coverage is confirmed; False when coverage is disputed or pending determination.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageLine rdf:type rdf:Property ;
    rdfs:label 'Coverage Line' ;
    rdfs:comment 'Insurance coverage layer applicable to this claim. Indicates whether the claim falls under the primary policy, excess layer, umbrella policy, or reinsurance arrangement. Drives financial recovery routing and reserve allocation.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Amount' ;
    rdfs:comment 'Policy deductible amount applicable to this specific claim as defined in the governing insurance policy. Represents the portion of the loss retained by Sports Entertainment before insurer coverage applies. Critical for net recovery calculation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incidentCountryCode rdf:type rdf:Property ;
    rdfs:label 'Incident Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction where the incident occurred. Determines applicable law, regulatory reporting requirements (GDPR, CCPA, OSHA), and governing body jurisdiction (FIFA, IOC, NFL, etc.).' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentLocation rdf:type rdf:Property ;
    rdfs:label 'Incident Location' ;
    rdfs:comment 'Physical location or venue where the incident occurred (e.g., stadium name, arena section, broadcast facility, training facility). Used for venue operations risk analysis, OSHA compliance reporting, and ADA accommodation tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurerClaimHandler rdf:type rdf:Property ;
    rdfs:label 'Insurer Claim Handler' ;
    rdfs:comment 'Full name of the claims adjuster or handler assigned by the insurer to manage and investigate this specific claim. Used for direct communication, escalation tracking, and SLA monitoring with the insurer.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurerHandlerEmail rdf:type rdf:Property ;
    rdfs:label 'Insurer Handler Email' ;
    rdfs:comment 'Email address of the insurer-assigned claim handler for direct correspondence and document exchange. Classified as confidential as it is a business contact at an external organization.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationCloseDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Close Date' ;
    rdfs:comment 'Date on which the claim investigation was formally concluded. Used alongside investigation_start_date to calculate investigation duration for risk management KPI reporting.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investigationStartDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Start Date' ;
    rdfs:comment 'Date on which the formal claim investigation was initiated by the insurer or internal risk management team. Used to measure investigation cycle time and SLA compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isSubrogationApplicable rdf:type rdf:Property ;
    rdfs:label 'Is Subrogation Applicable' ;
    rdfs:comment 'Indicates whether Sports Entertainment or the insurer has the right to pursue subrogation (recovery from a liable third party) in connection with this claim. True when subrogation rights exist; False otherwise. Relevant for recovery strategy and legal action planning.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Recovery Amount' ;
    rdfs:comment 'Actual monetary amount recovered from the insurer following claim resolution. May differ from settlement_amount due to deductibles, coverage sub-limits, or co-insurance provisions. Key metric for insurance recovery monitoring and ROI analysis.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Date' ;
    rdfs:comment 'Date on which the required regulatory report was submitted to the applicable governing body. Populated only when regulatory_report_required is True. Used for compliance tracking and audit evidence.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReportRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Required' ;
    rdfs:comment 'Indicates whether this claim requires mandatory regulatory reporting to a governing body (e.g., OSHA incident report, WADA notification, SEC disclosure for material claims, FCC notification for broadcast-related incidents). True when regulatory reporting is mandated.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Amount' ;
    rdfs:comment 'Actuarial reserve amount set aside by the insurer or internal risk management to cover the estimated ultimate cost of the claim. Represents the adjustment/estimate component of the MONETARY_TRIPLET. Subject to periodic re-evaluation as the claim progresses.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subrogationRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Recovery Amount' ;
    rdfs:comment 'Monetary amount recovered through subrogation proceedings against a liable third party. Populated only when is_subrogation_applicable is True and recovery has been obtained. Reduces the net cost of the claim to Sports Entertainment.' ;
    rdfs:domain ind:InsuranceClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:additionalInsureds rdf:type rdf:Property ;
    rdfs:label 'Additional Insureds' ;
    rdfs:comment 'Comma-separated list of third parties (venues, sponsors, broadcast partners, leagues) added as additional insureds under this policy, typically required by contract. Supports contractual compliance verification.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Broker License Number' ;
    rdfs:comment 'State or jurisdiction-issued license number of the insurance broker. Required for regulatory compliance verification and broker credential management.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerName rdf:type rdf:Property ;
    rdfs:label 'Broker Name' ;
    rdfs:comment 'Name of the insurance broker or intermediary firm that placed the policy on behalf of Sports Entertainment. Used for broker relationship management and commission tracking.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Cancellation Notice Days' ;
    rdfs:comment 'Number of days advance written notice required by either party to cancel the policy prior to its expiry date. Critical for continuity of coverage planning and contractual obligation management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificateOfInsuranceNumber rdf:type rdf:Property ;
    rdfs:label 'Certificate Of Insurance Number' ;
    rdfs:comment 'Reference number of the Certificate of Insurance (COI) issued to evidence coverage for third parties such as venues, sponsors, or event partners. Required for contractual compliance and venue access.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsCount rdf:type rdf:Property ;
    rdfs:label 'Claims Count' ;
    rdfs:comment 'Number of currently open or active claims filed against this policy. Provides a real-time indicator of policy utilization and potential reserve requirements. Not a calculated aggregate — sourced directly from the claims management system.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageCategory rdf:type rdf:Property ;
    rdfs:label 'Coverage Category' ;
    rdfs:comment 'Broad risk category under which the policy is classified for enterprise risk management and financial reporting purposes. Enables roll-up analysis across the insurance portfolio by risk class. [ENUM-REF-CANDIDATE: liability|property|casualty|health_disability|financial_crime|cyber|event_risk|umbrella_excess — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageLimit rdf:type rdf:Property ;
    rdfs:label 'Coverage Limit' ;
    rdfs:comment 'Maximum aggregate dollar amount the insurer will pay under this policy for all covered losses during the policy period. Used for risk gap analysis and adequacy assessments.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageTrigger rdf:type rdf:Property ;
    rdfs:label 'Coverage Trigger' ;
    rdfs:comment 'Designates whether the policy responds on a claims-made basis (claim must be filed during the policy period) or an occurrence basis (loss must occur during the policy period regardless of when the claim is filed). Critical for tail liability management.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsements rdf:type rdf:Property ;
    rdfs:label 'Endorsements' ;
    rdfs:comment 'Free-text description or comma-separated list of endorsements, riders, and amendments attached to the base policy that modify, expand, or restrict coverage terms. Examples include terrorism endorsements, communicable disease exclusions, or athlete-specific riders.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionsSummary rdf:type rdf:Property ;
    rdfs:label 'Exclusions Summary' ;
    rdfs:comment 'Summary description of material exclusions from coverage as stated in the policy. Informs risk gap analysis and ensures legal and risk management teams are aware of uncovered exposures.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extendedReportingPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Extended Reporting Period Days' ;
    rdfs:comment 'Number of days after policy expiry during which claims arising from incidents that occurred during the policy period may still be reported. Also known as the tail period; applicable to claims-made policies.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:governingLawState rdf:type rdf:Property ;
    rdfs:label 'Governing Law State' ;
    rdfs:comment 'Two-letter US state code (or equivalent sub-national code) whose laws govern the interpretation and enforcement of the policy contract. Relevant for domestic policies subject to state insurance regulation.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurerFinancialRating rdf:type rdf:Property ;
    rdfs:label 'Insurer Financial Rating' ;
    rdfs:comment 'Financial strength rating assigned to the insurer by a recognized rating agency (e.g., A.M. Best, S&P, Moody\'s). Used to assess counterparty credit risk and ensure the insurer meets minimum rating thresholds required by corporate policy.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurerNaicCode rdf:type rdf:Property ;
    rdfs:label 'Insurer Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code assigned to the insurer by the National Association of Insurance Commissioners. Enables regulatory identification and financial strength verification of the carrier.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurerName rdf:type rdf:Property ;
    rdfs:label 'Insurer Name' ;
    rdfs:comment 'Legal name of the insurance carrier or underwriting company that issued the policy. Used for counterparty management, claims routing, and regulatory disclosure.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurerRatingAgency rdf:type rdf:Property ;
    rdfs:label 'Insurer Rating Agency' ;
    rdfs:comment 'Name of the credit rating agency that issued the insurer\'s financial strength rating. Provides context for interpreting the insurer_financial_rating value.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isUmbrellaPolicy rdf:type rdf:Property ;
    rdfs:label 'Is Umbrella Policy' ;
    rdfs:comment 'Indicates whether this policy is an umbrella or excess liability policy that provides coverage above the limits of underlying primary policies. Used to model the layered insurance tower structure.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastClaimsReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Claims Review Date' ;
    rdfs:comment 'Date of the most recent formal review of claims activity under this policy conducted by the legal and risk management team. Supports audit trail and governance documentation requirements.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:namedInsureds rdf:type rdf:Property ;
    rdfs:label 'Named Insureds' ;
    rdfs:comment 'Comma-separated list of all legal entities, subsidiaries, and affiliates of Sports Entertainment explicitly named as insureds on the policy declarations page. Determines which entities have coverage rights under the policy.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perOccurrenceLimit rdf:type rdf:Property ;
    rdfs:label 'Per Occurrence Limit' ;
    rdfs:comment 'Maximum dollar amount the insurer will pay for any single covered loss event or occurrence. Distinct from the aggregate coverage_limit; used in event-level claims analysis and venue risk assessments.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Policy Document Reference' ;
    rdfs:comment 'Reference identifier or URL pointing to the digitized policy document stored in the corporate document management system (e.g., SAP S/4HANA document management or DAM). Enables direct access to the full policy wording.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyNumber rdf:type rdf:Property ;
    rdfs:label 'Policy Number' ;
    rdfs:comment 'Externally-issued policy number assigned by the insurer, used as the primary business identifier for the policy in all correspondence, claims, and regulatory filings. Maps to the insurer\'s policy administration system reference.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Amount' ;
    rdfs:comment 'Total annual premium payable to the insurer for the policy period, expressed in the policy currency. Used for budgeting, financial planning in Workday Adaptive Planning, and EBITDA impact analysis.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumCurrency rdf:type rdf:Property ;
    rdfs:label 'Premium Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the premium amount (e.g., USD, GBP, EUR). Supports multi-currency reporting for global insurance portfolios.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumPaymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Premium Payment Frequency' ;
    rdfs:comment 'Frequency at which premium installments are paid to the insurer. Drives accounts payable scheduling in SAP S/4HANA FI and cash flow forecasting.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionAmount rdf:type rdf:Property ;
    rdfs:label 'Retention Amount' ;
    rdfs:comment 'Self-insured retention (SIR) amount that Sports Entertainment retains before the insurer\'s obligation is triggered, applicable to claims-made policies. Distinct from the deductible in that the insured manages defense costs within the SIR layer.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retroactiveDate rdf:type rdf:Property ;
    rdfs:label 'Retroactive Date' ;
    rdfs:comment 'For claims-made policies, the earliest date from which covered incidents are eligible for a claim under this policy. Incidents occurring before this date are excluded. Null for occurrence-based policies.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskCategory rdf:type rdf:Property ;
    rdfs:label 'Risk Category' ;
    rdfs:comment 'Enterprise risk management classification of the primary risk type addressed by this policy. Aligns with the corporate risk register and supports ERM reporting to the board and audit committee.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underlyingPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Underlying Policy Number' ;
    rdfs:comment 'Policy number of the primary policy that this umbrella or excess policy sits above. Populated only when is_umbrella_policy is true. Enables construction of the full insurance tower for risk analysis.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipAssetId rdf:type rdf:Property ;
    rdfs:label 'Ip Asset Id' ;
    rdfs:comment 'Reference to the specific IP portfolio asset (trademark, copyright, patent, domain, trade secret) that is the subject of this enforcement action. Links to the IP portfolio registry.' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:trademarkRegistrationId rdf:type rdf:Property ;
    rdfs:label 'Trademark Registration Id' ;
    rdfs:comment 'Foreign key linking to legal.trademark_registration. Business justification: ip_enforcement_action.ip_registration_number is a denormalized string reference to the trademark or IP registration being enforced. Adding trademark_registration_id FK normalizes this relationship and' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrademarkRegistration .

ind:actionType rdf:type rdf:Property ;
    rdfs:label 'Action Type' ;
    rdfs:comment 'Classification of the IP enforcement mechanism employed. Determines applicable procedural rules, filing venues, and statutory frameworks. [ENUM-REF-CANDIDATE: cease_and_desist|dmca_takedown|udrp_dispute|trademark_opposition|copyright_litigation|patent_litigation|trade_secret_claim|customs_recordation — promote to reference product]' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastRightsRelated rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Related' ;
    rdfs:comment 'Indicates whether this enforcement action involves unauthorized broadcast, streaming, or redistribution of Sports Entertainment media rights content (e.g., PPV piracy, RSN blackout violations, OTT unauthorized retransmission). Links to broadcast rights deal enforcement.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:counterfeitGoodsSeizedQuantity rdf:type rdf:Property ;
    rdfs:label 'Counterfeit Goods Seized Quantity' ;
    rdfs:comment 'Number of counterfeit merchandise units (e.g., jerseys, caps, licensed product SKUs) seized or identified as part of the enforcement action. Applicable to merchandise and licensing enforcement actions. Null for non-goods enforcement types.' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:damagesSoughtAmount rdf:type rdf:Property ;
    rdfs:label 'Damages Sought Amount' ;
    rdfs:comment 'Monetary value of damages, injunctive relief, or statutory penalties sought by Sports Entertainment (or claimed against it in defensive actions). Expressed in the currency indicated by currency_code. Used for financial risk exposure reporting and EBITDA impact analysis.' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:docketNumber rdf:type rdf:Property ;
    rdfs:label 'Docket Number' ;
    rdfs:comment 'Official court, tribunal, or administrative docket/case number assigned by the filing venue (e.g., USPTO TTAB opposition number, federal court civil action number, WIPO case number). Used for external tracking and legal correspondence.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmRelated rdf:type rdf:Property ;
    rdfs:label 'Drm Related' ;
    rdfs:comment 'Indicates whether this enforcement action involves circumvention of Digital Rights Management (DRM) technology protecting broadcast content, OTT streams, or digital media assets. Triggers DMCA anti-circumvention provisions under 17 U.S.C. § 1201.' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enforcementChannel rdf:type rdf:Property ;
    rdfs:label 'Enforcement Channel' ;
    rdfs:comment 'The institutional venue or platform through which the enforcement action is being pursued (e.g., USPTO TTAB for trademark oppositions, WIPO for UDRP domain disputes, platform takedown for DMCA notices on social media or streaming services). [ENUM-REF-CANDIDATE: uspto_ttab|federal_court|wipo|platform_takedown|customs_cbp|state_court|international_tribunal — promote to reference product]' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementDirection rdf:type rdf:Property ;
    rdfs:label 'Enforcement Direction' ;
    rdfs:comment 'Indicates whether Sports Entertainment is the initiating party (offensive — asserting its IP rights) or the responding party (defensive — defending against a third-party IP claim). Critical for legal strategy reporting and risk exposure analysis.' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infringingAssetDescription rdf:type rdf:Property ;
    rdfs:label 'Infringing Asset Description' ;
    rdfs:comment 'Detailed description of the infringing material, product, domain, or content that is the subject of the enforcement action (e.g., counterfeit jersey bearing NFL team logo, unauthorized streaming of PPV broadcast, domain name mimicking official team website). Essential for legal pleadings and evidence documentation.' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatedDate rdf:type rdf:Property ;
    rdfs:label 'Initiated Date' ;
    rdfs:comment 'Calendar date on which Sports Entertainment formally initiated or received the IP enforcement action (e.g., date a cease-and-desist letter was sent, a DMCA notice was filed, or a complaint was served). Satisfies TRANSACTION_HEADER BUSINESS_EVENT_TIMESTAMP category.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:injunctionGranted rdf:type rdf:Property ;
    rdfs:label 'Injunction Granted' ;
    rdfs:comment 'Indicates whether a preliminary or permanent injunction was granted as part of the enforcement action outcome. True when injunctive relief was awarded; False otherwise. Critical for IP portfolio protection reporting.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ipRightType rdf:type rdf:Property ;
    rdfs:label 'Ip Right Type' ;
    rdfs:comment 'Category of intellectual property right being enforced (e.g., trademark for league logos, copyright for broadcast content, right of publicity for athlete NIL). Drives applicable legal framework and jurisdiction rules.' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionDetail rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Detail' ;
    rdfs:comment 'Specific court, tribunal, or administrative body name and district/circuit where the action is filed (e.g., \'U.S. District Court, S.D.N.Y.\', \'WIPO Arbitration and Mediation Center\', \'USPTO TTAB\'). Complements jurisdiction_country_code with granular venue information.' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalFeesIncurredAmount rdf:type rdf:Property ;
    rdfs:label 'Legal Fees Incurred Amount' ;
    rdfs:comment 'Cumulative outside counsel and filing fees incurred for this enforcement action to date. Sourced from SAP S/4HANA CO cost center postings. Used for ROI analysis of IP enforcement program and outside counsel budget management.' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nilRelated rdf:type rdf:Property ;
    rdfs:label 'Nil Related' ;
    rdfs:comment 'Indicates whether this enforcement action involves unauthorized use of an athlete\'s Name, Image, and Likeness (NIL). Triggers specific NIL agreement review and athlete notification obligations under applicable state NIL laws and CBA provisions.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outcome rdf:type rdf:Property ;
    rdfs:label 'Outcome' ;
    rdfs:comment 'Final result of the enforcement action upon resolution. Drives IP portfolio strategy, outside counsel performance evaluation, and legal risk reporting. Null while action is active.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repeatInfringer rdf:type rdf:Property ;
    rdfs:label 'Repeat Infringer' ;
    rdfs:comment 'Indicates whether the respondent party has been the subject of a prior IP enforcement action by Sports Entertainment. True signals a pattern of infringement, which may support enhanced damages claims and escalated enforcement strategy.' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:respondentCountryCode rdf:type rdf:Property ;
    rdfs:label 'Respondent Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the respondent party\'s primary jurisdiction or domicile (e.g., USA, GBR, CHN). Used for international enforcement strategy, treaty applicability, and jurisdictional routing.' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Response Deadline Date' ;
    rdfs:comment 'Statutory or procedural deadline by which the respondent must respond, or by which Sports Entertainment must file a reply. Critical for docket management and SLA compliance with outside counsel.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementTermsSummary rdf:type rdf:Property ;
    rdfs:label 'Settlement Terms Summary' ;
    rdfs:comment 'Narrative summary of key settlement terms including non-monetary obligations (e.g., domain transfer, content removal, licensing grant, injunction compliance, royalty arrangement). Complements settlement_amount with qualitative terms.' ;
    rdfs:domain ind:IpEnforcementAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Owner Corporate Entity Id' ;
    rdfs:comment 'Foreign key linking to legal.corporate_entity. Business justification: ip_portfolio.owner_entity_name and owner_entity_type are denormalized references to the corporate entity that owns the IP asset. Adding owner_corporate_entity_id FK (with \'owner_\' prefix to distinguis' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:applicationNumber rdf:type rdf:Property ;
    rdfs:label 'Application Number' ;
    rdfs:comment 'Official application serial number assigned by the IP authority at the time of filing, prior to registration. Distinct from registration_number; used to track pending applications through examination and opposition proceedings.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetName rdf:type rdf:Property ;
    rdfs:label 'Asset Name' ;
    rdfs:comment 'Human-readable name or title of the intellectual property asset (e.g., league logo name, team trademark name, broadcast brand name, patent title). Serves as the primary identity label for the asset.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coOwnerEntityName rdf:type rdf:Property ;
    rdfs:label 'Co Owner Entity Name' ;
    rdfs:comment 'Legal name of any co-owning entity sharing IP rights with Sports Entertainment. Null if solely owned. Relevant for joint venture IP assets and co-branded league properties.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copyrightWorkType rdf:type rdf:Property ;
    rdfs:label 'Copyright Work Type' ;
    rdfs:comment 'Category of copyrightable work (literary, musical, audiovisual, pictorial/graphic/sculptural, sound recording, architectural). Applicable to copyright asset types only. Relevant for broadcast content, game footage, music, and digital media assets.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:domainRegistrar rdf:type rdf:Property ;
    rdfs:label 'Domain Registrar' ;
    rdfs:comment 'Name of the accredited domain name registrar through which the domain name IP asset is registered (e.g., GoDaddy, Verisign, MarkMonitor). Applicable to domain name asset types only. Null for other IP types.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:domainTld rdf:type rdf:Property ;
    rdfs:label 'Domain Tld' ;
    rdfs:comment 'Top-level domain extension of the registered domain name asset (e.g., .com, .net, .sport, .tv). Applicable to domain name asset types only. Supports portfolio analysis of domain coverage across TLDs.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmApplicable rdf:type rdf:Property ;
    rdfs:label 'Drm Applicable' ;
    rdfs:comment 'Indicates whether Digital Rights Management (DRM) controls are applied to this IP asset for digital distribution and enforcement purposes. Particularly relevant for broadcast content copyrights and digital media assets distributed via OTT (Over-The-Top) and IPTV platforms.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enforcementWatchActive rdf:type rdf:Property ;
    rdfs:label 'Enforcement Watch Active' ;
    rdfs:comment 'Indicates whether an active trademark or IP watch service is monitoring for potential infringements, conflicting applications, or unauthorized use of this IP asset. True = watch service active; False = no active monitoring.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedValuationUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Valuation Usd' ;
    rdfs:comment 'Estimated fair market value of the IP asset in US dollars as assessed by internal finance or external IP valuation specialists. Used for balance sheet reporting, licensing fee benchmarking, and M&A due diligence. Classified confidential as commercially sensitive.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firstUseAnywhereDate rdf:type rdf:Property ;
    rdfs:label 'First Use Anywhere Date' ;
    rdfs:comment 'Date on which the trademark or service mark was first used anywhere (not limited to commerce). Distinct from use_in_commerce_date; establishes the earliest possible priority date for common law trademark rights.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:internalReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Internal Reference Code' ;
    rdfs:comment 'Internal docket or reference code assigned by Sports Entertainment\'s legal department for tracking this IP asset in internal matter management and ERP systems (e.g., SAP S/4HANA legal module). Enables cross-referencing with internal legal matter tracking.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipClassDescription rdf:type rdf:Property ;
    rdfs:label 'Ip Class Description' ;
    rdfs:comment 'Textual description of the goods or services covered under the Nice Classification code, as filed with the IP authority. Provides specificity beyond the class number for enforcement and licensing scope determination.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRenewalDate rdf:type rdf:Property ;
    rdfs:label 'Last Renewal Date' ;
    rdfs:comment 'Date on which the most recent renewal of the IP registration was completed and accepted by the IP authority. Supports renewal history tracking and compliance verification.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licensingEligible rdf:type rdf:Property ;
    rdfs:label 'Licensing Eligible' ;
    rdfs:comment 'Indicates whether this IP asset is approved and available for licensing to third parties (e.g., merchandise licensees, broadcast partners, sponsors). True = eligible for licensing; False = restricted to internal use or subject to licensing moratorium.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:markType rdf:type rdf:Property ;
    rdfs:label 'Mark Type' ;
    rdfs:comment 'Specific form of the trademark or service mark (e.g., word mark, design/logo mark, composite mark, sound mark, color mark, motion mark). Applicable to trademark and service mark asset types only. Null for patents, copyrights, and domain names.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:niceClassCode rdf:type rdf:Property ;
    rdfs:label 'Nice Class Code' ;
    rdfs:comment 'International Nice Classification class number (1–45) applicable to trademark and service mark registrations. Defines the goods or services covered by the mark (e.g., Class 41 for sports and entertainment services, Class 25 for clothing/merchandise). Null for non-trademark asset types.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oppositionFiled rdf:type rdf:Property ;
    rdfs:label 'Opposition Filed' ;
    rdfs:comment 'Indicates whether an opposition or cancellation proceeding has been filed against this IP asset by a third party, or filed by Sports Entertainment against a conflicting application. True = opposition proceeding active or on record.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patentType rdf:type rdf:Property ;
    rdfs:label 'Patent Type' ;
    rdfs:comment 'Classification of patent by type (utility, design, plant, provisional). Applicable to patent asset types only. Null for trademarks, copyrights, and domain names. Determines protection term and maintenance fee schedule.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityClaimCountry rdf:type rdf:Property ;
    rdfs:label 'Priority Claim Country' ;
    rdfs:comment 'ISO 3166-1 country code of the jurisdiction in which the original priority application was filed. Used in conjunction with priority_claim_date for Paris Convention priority assertions.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityClaimDate rdf:type rdf:Property ;
    rdfs:label 'Priority Claim Date' ;
    rdfs:comment 'Date of the earliest priority claim asserted for this IP asset under the Paris Convention or PCT (Patent Cooperation Treaty). Null if no priority claim is made. Determines seniority in multi-jurisdictional filings.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registrationStatus rdf:type rdf:Property ;
    rdfs:label 'Registration Status' ;
    rdfs:comment 'Current lifecycle status of the IP asset registration with the governing IP authority. Drives renewal workflows, enforcement eligibility, and portfolio reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalDeadline rdf:type rdf:Property ;
    rdfs:label 'Renewal Deadline' ;
    rdfs:comment 'Deadline by which renewal filings and fees must be submitted to maintain active IP protection. May precede expiration_date by a statutory grace period. Drives automated renewal reminders and outside counsel task assignments.' ;
    rdfs:domain ind:IpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalTermYears rdf:type rdf:Property ;
    rdfs:label 'Renewal Term Years' ;
    rdfs:comment 'Duration in years of each renewal period for this IP asset as prescribed by the applicable IP authority and asset type (e.g., 10 years for US trademarks, 20 years for utility patents from filing date). Drives automated expiration and renewal deadline calculations.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:useInCommerceDate rdf:type rdf:Property ;
    rdfs:label 'Use In Commerce Date' ;
    rdfs:comment 'Date on which the trademark or service mark was first used in interstate or international commerce. Required for US trademark registrations under the Lanham Act. Establishes common law rights and supports opposition proceedings.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:valuationDate rdf:type rdf:Property ;
    rdfs:label 'Valuation Date' ;
    rdfs:comment 'Date on which the estimated valuation was last assessed or updated. Supports staleness detection for financial reporting and triggers revaluation workflows per accounting policy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deadlineId rdf:type rdf:Property ;
    rdfs:label 'Deadline Id' ;
    rdfs:comment 'Unique surrogate identifier for each legal deadline record in the Sports Entertainment legal portfolio. Primary key for the legal_deadline data product.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attorneyEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Attorney Employee Id' ;
    rdfs:comment 'Reference to the internal attorney or legal counsel assigned as the primary owner responsible for meeting this deadline.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:associatedLeagueOrEvent rdf:type rdf:Property ;
    rdfs:label 'Associated League Or Event' ;
    rdfs:comment 'Name or identifier of the sports league, competition, or live event to which this deadline is linked (e.g., NFL season, FIFA World Cup, UFC event). Enables league-specific deadline portfolio reporting.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastRightsReference rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Reference' ;
    rdfs:comment 'Reference to the media rights deal or broadcast agreement associated with this deadline when the matter involves OTT, RSN, or DRM licensing obligations.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractReference rdf:type rdf:Property ;
    rdfs:label 'Contract Reference' ;
    rdfs:comment 'Reference to the specific contract, agreement, or license whose expiration, renewal, or obligation triggers this deadline. Confidential business data.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysUntilDeadline rdf:type rdf:Property ;
    rdfs:label 'Days Until Deadline' ;
    rdfs:comment 'Calculated number of calendar days remaining until the deadline date from the current date. Used for prioritization dashboards and SLA monitoring. Negative values indicate overdue deadlines.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deadlineCategory rdf:type rdf:Property ;
    rdfs:label 'Deadline Category' ;
    rdfs:comment 'High-level domain category grouping the deadline for portfolio-level reporting and workload management across the legal department.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deadlineDate rdf:type rdf:Property ;
    rdfs:label 'Deadline Date' ;
    rdfs:comment 'The actual calendar date by which the legal action, filing, response, or renewal must be completed. This is the hard deadline that triggers compliance obligations.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deadlineDescription rdf:type rdf:Property ;
    rdfs:label 'Deadline Description' ;
    rdfs:comment 'Detailed narrative description of the required legal action, filing, or obligation associated with this deadline. Provides context for attorneys and legal operations staff.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deadlineStatus rdf:type rdf:Property ;
    rdfs:label 'Deadline Status' ;
    rdfs:comment 'Current lifecycle state of the deadline. Drives proactive management workflows and escalation triggers across the legal portfolio.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deadlineType rdf:type rdf:Property ;
    rdfs:label 'Deadline Type' ;
    rdfs:comment 'Classification of the legal deadline by its nature and governing rule. Drives workflow routing and escalation logic. [ENUM-REF-CANDIDATE: statute_of_limitations|response_due|renewal_filing|discovery_cutoff|contract_expiration|license_renewal|appeal_filing|regulatory_submission|hearing_date|arbitration_deadline — promote to reference product]' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extendedDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Extended Deadline Date' ;
    rdfs:comment 'Revised deadline date granted through a formal extension, continuance, or court order. Null if no extension has been granted.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extensionGranted rdf:type rdf:Property ;
    rdfs:label 'Extension Granted' ;
    rdfs:comment 'Indicates whether a formal extension, continuance, or additional time has been granted for this deadline by a court, regulatory body, or counterparty.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:extensionReason rdf:type rdf:Property ;
    rdfs:label 'Extension Reason' ;
    rdfs:comment 'Reason for which an extension was granted for this deadline. Required for audit trail and compliance documentation when original deadlines are modified.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalReminderDate rdf:type rdf:Property ;
    rdfs:label 'Final Reminder Date' ;
    rdfs:comment 'Date on which the final urgent reminder is triggered, typically 7 days before the deadline, prompting immediate action.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstReminderDate rdf:type rdf:Property ;
    rdfs:label 'First Reminder Date' ;
    rdfs:comment 'Date on which the first automated reminder notification is triggered to the responsible attorney and legal operations team, typically 90 or 60 days before the deadline.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gdprDataInvolved rdf:type rdf:Property ;
    rdfs:label 'Gdpr Data Involved' ;
    rdfs:comment 'Indicates whether the legal matter or action associated with this deadline involves personal data subject to GDPR or CCPA obligations. Triggers additional data protection review requirements.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCompleted rdf:type rdf:Property ;
    rdfs:label 'Is Completed' ;
    rdfs:comment 'Indicates whether the required legal action associated with this deadline has been completed. True when the action is fully executed and documented.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCourtImposed rdf:type rdf:Property ;
    rdfs:label 'Is Court Imposed' ;
    rdfs:comment 'Indicates whether this deadline was set by a court order, arbitration panel, or regulatory body rather than by internal legal operations. Court-imposed deadlines carry heightened compliance risk.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCritical rdf:type rdf:Property ;
    rdfs:label 'Is Critical' ;
    rdfs:comment 'Indicates whether this deadline is classified as critical, meaning that missing it would result in irreversible legal consequences such as loss of IP rights, default judgment, or regulatory sanction.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEscalated rdf:type rdf:Property ;
    rdfs:label 'Is Escalated' ;
    rdfs:comment 'Indicates whether this deadline has been escalated to senior legal leadership or the General Counsel due to risk, proximity, or missed action. Triggers executive-level visibility.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Original Deadline Date' ;
    rdfs:comment 'The initial deadline date before any extensions, continuances, or modifications were granted. Preserved for audit trail and compliance reporting purposes.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsibleAttorneyName rdf:type rdf:Property ;
    rdfs:label 'Responsible Attorney Name' ;
    rdfs:comment 'Full name of the internal attorney or legal counsel assigned as the primary owner of this deadline. Retained as a denormalized field for operational reporting and audit trail.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondReminderDate rdf:type rdf:Property ;
    rdfs:label 'Second Reminder Date' ;
    rdfs:comment 'Date on which the second automated reminder notification is triggered, typically 30 days before the deadline, escalating urgency.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:secondaryAttorneyName rdf:type rdf:Property ;
    rdfs:label 'Secondary Attorney Name' ;
    rdfs:comment 'Full name of a backup or secondary attorney who assumes responsibility if the primary attorney is unavailable. Ensures continuity of deadline management.' ;
    rdfs:domain ind:Deadline ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wadaCaseReference rdf:type rdf:Property ;
    rdfs:label 'Wada Case Reference' ;
    rdfs:comment 'Reference to the WADA anti-doping case or Performance Enhancing Drug (PED) proceeding associated with this deadline when the matter involves athlete eligibility or doping violations.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdApprovingCounselEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Hold Approving Counsel Employee Id' ;
    rdfs:comment 'Reference to the senior counsel or General Counsel who approved the issuance or release of this legal hold. Supports governance and sign-off audit trail requirements.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:holdEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Hold Employee Id' ;
    rdfs:comment 'Reference to the internal or outside counsel attorney responsible for issuing and managing this legal hold notice.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:holdInsurancePolicyId rdf:type rdf:Property ;
    rdfs:label 'Hold Insurance Policy Id' ;
    rdfs:comment 'Reference to the corporate insurance policy (e.g., Directors and Officers, General Liability, Media Liability) that may be triggered by the underlying litigation matter associated with this hold.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsurancePolicy .

ind:holdRelatedInsurancePolicyId rdf:type rdf:Property ;
    rdfs:label 'Hold Related Insurance Policy Id' ;
    rdfs:comment 'Reference to the corporate insurance policy (e.g., Directors and Officers, General Liability, Media Liability) that may be triggered by the underlying litigation matter associated with this hold.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsurancePolicy .

ind:anticipatedLitigationDate rdf:type rdf:Property ;
    rdfs:label 'Anticipated Litigation Date' ;
    rdfs:comment 'Date on which litigation was reasonably anticipated, which may precede the formal issue date. Establishes the earliest point at which preservation obligations arose under the duty to preserve doctrine.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectionStatus rdf:type rdf:Property ;
    rdfs:label 'Collection Status' ;
    rdfs:comment 'Current status of the electronically stored information (ESI) collection process under this legal hold. Tracks progress from preservation through active collection for eDiscovery review.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:custodianAcknowledgmentCount rdf:type rdf:Property ;
    rdfs:label 'Custodian Acknowledgment Count' ;
    rdfs:comment 'Number of custodians who have formally acknowledged receipt and understanding of the legal hold notice. Used to track compliance with notification obligations and identify non-responsive custodians.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:custodianCount rdf:type rdf:Property ;
    rdfs:label 'Custodian Count' ;
    rdfs:comment 'Total number of individual custodians (employees, contractors, or third parties) placed under this legal hold notice. Used for scope assessment, compliance tracking, and eDiscovery cost estimation.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataSourceDalet rdf:type rdf:Property ;
    rdfs:label 'Data Source Dalet' ;
    rdfs:comment 'Indicates whether Dalet Galaxy media asset management and broadcast workflow records are included in the scope of this legal hold, relevant for broadcast rights disputes and IP litigation.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSourceEmail rdf:type rdf:Property ;
    rdfs:label 'Data Source Email' ;
    rdfs:comment 'Indicates whether corporate email systems (e.g., Microsoft Exchange/Outlook) are included in the scope of this legal hold for electronically stored information (ESI) preservation.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSourceOtherDescription rdf:type rdf:Property ;
    rdfs:label 'Data Source Other Description' ;
    rdfs:comment 'Free-text description of any additional data sources placed on hold beyond the standard enumerated sources (e.g., Hudl performance analytics, Archtics venue seating data, custom databases, third-party vendor systems).' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSourcePhysicalDocuments rdf:type rdf:Property ;
    rdfs:label 'Data Source Physical Documents' ;
    rdfs:comment 'Indicates whether physical (paper) documents, contracts, and records are included in the scope of this legal hold in addition to electronically stored information (ESI).' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSourceSalesforce rdf:type rdf:Property ;
    rdfs:label 'Data Source Salesforce' ;
    rdfs:comment 'Indicates whether Salesforce CRM records (fan and sponsor relationship data, contracts, communications) are included in the scope of this legal hold for ESI preservation.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSourceSap rdf:type rdf:Property ;
    rdfs:label 'Data Source Sap' ;
    rdfs:comment 'Indicates whether SAP S/4HANA ERP records (financial, procurement, sales and distribution data) are included in the scope of this legal hold for ESI preservation.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSourceSharepoint rdf:type rdf:Property ;
    rdfs:label 'Data Source Sharepoint' ;
    rdfs:comment 'Indicates whether Microsoft SharePoint document repositories and collaboration sites are included in the scope of this legal hold for ESI preservation.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSourceSlack rdf:type rdf:Property ;
    rdfs:label 'Data Source Slack' ;
    rdfs:comment 'Indicates whether Slack messaging platform channels and direct messages are included in the scope of this legal hold for ESI preservation.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dateRangeEnd rdf:type rdf:Property ;
    rdfs:label 'Date Range End' ;
    rdfs:comment 'Latest date of documents and ESI that must be preserved under this legal hold. Null if the hold extends to the present date. Defines the temporal scope of the preservation obligation.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateRangeStart rdf:type rdf:Property ;
    rdfs:label 'Date Range Start' ;
    rdfs:comment 'Earliest date of documents and ESI that must be preserved under this legal hold. Defines the temporal scope of the preservation obligation.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ediscoveryPlatform rdf:type rdf:Property ;
    rdfs:label 'Ediscovery Platform' ;
    rdfs:comment 'Name of the eDiscovery software platform used to manage collection, processing, and review of ESI under this hold (e.g., \'Relativity\', \'Nuix\', \'Everlaw\', \'Logikcull\'). Supports operational tracking and vendor management.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedDataVolumeGb rdf:type rdf:Property ;
    rdfs:label 'Estimated Data Volume Gb' ;
    rdfs:comment 'Estimated total volume of electronically stored information (ESI) subject to this legal hold, measured in gigabytes. Used for eDiscovery cost estimation, vendor scoping, and resource planning.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firstNotificationDate rdf:type rdf:Property ;
    rdfs:label 'First Notification Date' ;
    rdfs:comment 'Date on which the initial legal hold notification was sent to custodians. Distinct from the issue date; tracks when custodians were actually informed of their preservation obligations.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:governingCourtOrBody rdf:type rdf:Property ;
    rdfs:label 'Governing Court Or Body' ;
    rdfs:comment 'Name of the court, arbitration panel, or regulatory body overseeing the matter (e.g., \'SDNY\', \'FCC\', \'SEC\', \'CAS - Court of Arbitration for Sport\', \'WADA\', \'NFL League Office\'). Informs preservation scope and production obligations.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdName rdf:type rdf:Property ;
    rdfs:label 'Hold Name' ;
    rdfs:comment 'Descriptive name assigned to the legal hold notice, typically referencing the matter name or case identifier (e.g., \'Smith v. Sports Entertainment - 2024 Broadcast Rights Dispute\'). Used for identification and communication with custodians.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdStatus rdf:type rdf:Property ;
    rdfs:label 'Hold Status' ;
    rdfs:comment 'Current lifecycle state of the legal hold notice. \'active\' means preservation obligations are in force; \'released\' means the hold has been formally lifted; \'suspended\' means temporarily paused pending review; \'pending_approval\' means awaiting sign-off; \'expired\' means the hold lapsed without formal release.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdType rdf:type rdf:Property ;
    rdfs:label 'Hold Type' ;
    rdfs:comment 'Classification of the triggering matter type for the legal hold. Determines the applicable preservation standards and regulatory frameworks. [ENUM-REF-CANDIDATE: litigation|regulatory_investigation|government_inquiry|internal_investigation|arbitration|pre_litigation — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issueTimestamp rdf:type rdf:Property ;
    rdfs:label 'Issue Timestamp' ;
    rdfs:comment 'Precise date and time at which the legal hold notice was formally issued and distributed to custodians. Provides granular audit trail for eDiscovery compliance and spoliation defense beyond the issue date.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:itHoldImplementationDate rdf:type rdf:Property ;
    rdfs:label 'It Hold Implementation Date' ;
    rdfs:comment 'Date on which IT technical preservation controls were activated for this legal hold. Used to verify that system-level preservation was implemented promptly after the hold was issued.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:itHoldImplemented rdf:type rdf:Property ;
    rdfs:label 'It Hold Implemented' ;
    rdfs:comment 'Indicates whether the IT department has implemented technical preservation controls (e.g., journaling, in-place holds, backup suspension) to enforce the legal hold at the system level, beyond custodian self-preservation.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastReminderDate rdf:type rdf:Property ;
    rdfs:label 'Last Reminder Date' ;
    rdfs:comment 'Date on which the most recent reminder notification was sent to custodians to reaffirm their preservation obligations. Periodic reminders are a best practice for demonstrating good-faith compliance.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:matterJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Matter Jurisdiction' ;
    rdfs:comment 'Legal jurisdiction governing the underlying litigation or regulatory investigation (e.g., \'US-Federal\', \'US-CA\', \'UK\', \'EU\'). Determines applicable procedural rules and preservation standards.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privilegeReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Privilege Review Required' ;
    rdfs:comment 'Indicates whether attorney-client privilege or work product doctrine review is required before any collected ESI can be produced. Triggers privilege log preparation workflows.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:releaseReason rdf:type rdf:Property ;
    rdfs:label 'Release Reason' ;
    rdfs:comment 'Narrative explanation for why the legal hold was released (e.g., \'Matter settled\', \'Case dismissed\', \'Statute of limitations expired\', \'Regulatory investigation closed\'). Required for audit trail and records management resumption.' ;
    rdfs:domain ind:Hold ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reminderFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Reminder Frequency Days' ;
    rdfs:comment 'Configured interval in calendar days between periodic custodian reminder notifications for this legal hold. Supports automated reminder scheduling and compliance monitoring.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewingCounselEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Reviewing Counsel Employee Id' ;
    rdfs:comment 'Reference to the in-house attorney or legal operations staff member responsible for reviewing and approving this invoice.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:approvedAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Amount' ;
    rdfs:comment 'Total amount approved for payment by in-house counsel after review. May be less than the billed amount if line items were reduced or disallowed per outside counsel guidelines.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billedAmount rdf:type rdf:Property ;
    rdfs:label 'Billed Amount' ;
    rdfs:comment 'Gross total amount billed by outside counsel on this invoice, inclusive of all fees and expenses as submitted. Denominated in the invoice currency.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingFormat rdf:type rdf:Property ;
    rdfs:label 'Billing Format' ;
    rdfs:comment 'Electronic billing format in which the invoice was submitted. LEDES formats are required for eBilling compliance. Supports format-based processing routing.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period End Date' ;
    rdfs:comment 'End date of the billing period covered by this invoice. Defines the close of the timeframe during which legal services were rendered.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period Start Date' ;
    rdfs:comment 'Start date of the billing period covered by this invoice. Defines the beginning of the timeframe during which legal services were rendered.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetMatterCode rdf:type rdf:Property ;
    rdfs:label 'Budget Matter Code' ;
    rdfs:comment 'Budget code or WBS element associated with the legal matter for financial planning and variance analysis. Links invoice spend to approved legal budget in Workday Adaptive Planning.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputedAmount rdf:type rdf:Property ;
    rdfs:label 'Disputed Amount' ;
    rdfs:comment 'Total amount placed under dispute by in-house counsel due to billing guideline violations, rate discrepancies, or unsupported charges. Supports dispute resolution tracking.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ebillingSubmissionReference rdf:type rdf:Property ;
    rdfs:label 'Ebilling Submission Reference' ;
    rdfs:comment 'Unique identifier assigned by the eBilling platform upon submission of the invoice file. Used for tracking and reconciliation within the eBilling system.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseLineCount rdf:type rdf:Property ;
    rdfs:label 'Expense Line Count' ;
    rdfs:comment 'Total number of expense line items included in this invoice. Used for invoice complexity assessment and disbursement analytics.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expensesBilledAmount rdf:type rdf:Property ;
    rdfs:label 'Expenses Billed Amount' ;
    rdfs:comment 'Portion of the total billed amount attributable to disbursements and expense line items (e.g., court filing fees, travel, expert witness costs). Supports expense category analytics.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feesBilledAmount rdf:type rdf:Property ;
    rdfs:label 'Fees Billed Amount' ;
    rdfs:comment 'Portion of the total billed amount attributable to attorney and timekeeper professional fees (excluding expenses). Supports fee vs. expense spend analytics.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firmInvoiceReference rdf:type rdf:Property ;
    rdfs:label 'Firm Invoice Reference' ;
    rdfs:comment 'The law firm\'s internal reference or matter number associated with this invoice, as provided by outside counsel. Facilitates cross-reference during dispute resolution and reconciliation.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:guidelineViolationFlag rdf:type rdf:Property ;
    rdfs:label 'Guideline Violation Flag' ;
    rdfs:comment 'Indicates whether one or more line items on this invoice were flagged as violating outside counsel billing guidelines (e.g., block billing, excessive rates, unauthorized timekeepers).' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEbillingCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Ebilling Compliant' ;
    rdfs:comment 'Indicates whether the invoice was submitted in a LEDES-compliant eBilling format and passed automated billing guideline validation checks. Supports eBilling compliance reporting.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paidAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Amount' ;
    rdfs:comment 'Actual amount remitted to outside counsel for this invoice. May differ from approved amount due to partial payments or payment plan arrangements.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receivedDate rdf:type rdf:Property ;
    rdfs:label 'Received Date' ;
    rdfs:comment 'Date the invoice was received by the in-house legal operations team. Used to calculate review SLA compliance and aging.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:timekeeperEntryCount rdf:type rdf:Property ;
    rdfs:label 'Timekeeper Entry Count' ;
    rdfs:comment 'Total number of individual timekeeper billing entries (time records) included in this invoice. Used for invoice complexity assessment and eBilling validation.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:utbmsExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Utbms Expense Amount' ;
    rdfs:comment 'Total expense amount categorized under UTBMS expense codes (E-series). Enables standardized disbursement analytics across matters and firms.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utbmsFeesAmount rdf:type rdf:Property ;
    rdfs:label 'Utbms Fees Amount' ;
    rdfs:comment 'Total fees amount categorized under UTBMS task codes (L-series litigation, A-series counseling, etc.). Enables standardized legal spend analytics by task category across matters.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supervisingCounselEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Supervising Counsel Employee Id' ;
    rdfs:comment 'Identifier of the senior in-house attorney or General Counsel who supervises this matter. Used for escalation routing, approval workflows, and executive matter reporting. References the workforce/employee master.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supervisingCounselId rdf:type rdf:Property ;
    rdfs:label 'Supervising Counsel Id' ;
    rdfs:comment 'Identifier of the senior in-house attorney or General Counsel who supervises this matter. Used for escalation routing, approval workflows, and executive matter reporting. References the workforce/employee master.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualCloseDate rdf:type rdf:Property ;
    rdfs:label 'Actual Close Date' ;
    rdfs:comment 'Calendar date on which the legal matter was formally closed and all associated activities were concluded. Null if the matter remains open. Used for cycle-time analytics and SLA compliance reporting.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cbaRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Cba Related Flag' ;
    rdfs:comment 'Indicates whether this matter arises from or is governed by a Collective Bargaining Agreement (CBA) between the league/club and a players\' association. True = CBA-governed matter. Triggers specialized labor law handling.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:counterpartyName rdf:type rdf:Property ;
    rdfs:label 'Counterparty Name' ;
    rdfs:comment 'Name of the primary external party involved in this legal matter (e.g., opposing party in a dispute, regulatory authority, transaction counterparty, M&A target entity, athlete or agent in NIL/CBA matters). May be an individual or organization.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPrivacyFlag rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Flag' ;
    rdfs:comment 'Indicates whether this matter involves personal data, data privacy obligations, or a potential data breach subject to GDPR, CCPA, or other applicable privacy regulations. True = data privacy implications present.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedLegalSpend rdf:type rdf:Property ;
    rdfs:label 'Estimated Legal Spend' ;
    rdfs:comment 'Projected total legal cost for this matter in the operating currency (USD), including in-house counsel time allocation and outside counsel fees. Used for budget planning in Workday Adaptive Planning and EBITDA impact assessment.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ipAssetReference rdf:type rdf:Property ;
    rdfs:label 'Ip Asset Reference' ;
    rdfs:comment 'Reference identifier for the intellectual property asset (trademark, copyright, patent, broadcast rights, DRM policy, or NIL rights) that is the subject of this matter. Null for non-IP matters. Links to the IP portfolio management system.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalPracticeArea rdf:type rdf:Property ;
    rdfs:label 'Legal Practice Area' ;
    rdfs:comment 'Primary legal practice area governing this matter (e.g., Intellectual Property, Employment Law, Broadcast & Media Rights, Contract Law, Antitrust, Data Privacy, Sports Governance). Used for panel counsel routing and expertise matching. [ENUM-REF-CANDIDATE: intellectual_property|employment|broadcast_media_rights|contract|antitrust|data_privacy|sports_governance|real_estate|corporate|tax|regulatory — promote to reference product]' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:litigationRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Litigation Risk Flag' ;
    rdfs:comment 'Indicates whether this matter carries a material risk of escalating to formal litigation. True = litigation risk identified. Used for legal reserve provisioning and financial disclosure under SOX and SEC reporting requirements.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matterDescription rdf:type rdf:Property ;
    rdfs:label 'Matter Description' ;
    rdfs:comment 'Detailed narrative description of the legal matter, including background facts, legal issues involved, business context, and scope of in-house or outside counsel engagement. Authored by the assigned in-house counsel at intake.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matterName rdf:type rdf:Property ;
    rdfs:label 'Matter Name' ;
    rdfs:comment 'Short descriptive title of the legal matter as assigned by in-house counsel at intake (e.g., \'NIL Agreement Review – Athlete XYZ\', \'Venue Lease Dispute – Stadium A\'). Used for identification in matter management dashboards and reporting.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matterNumber rdf:type rdf:Property ;
    rdfs:label 'Matter Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to the matter at intake, used across in-house counsel systems, outside counsel invoices, and matter management platforms. Format: LM-{YYYY}-{NNNNNN}.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matterStatus rdf:type rdf:Property ;
    rdfs:label 'Matter Status' ;
    rdfs:comment 'Current lifecycle state of the legal matter within the in-house legal department\'s matter management workflow. Drives SLA tracking, resource allocation, and executive reporting.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextActionDescription rdf:type rdf:Property ;
    rdfs:label 'Next Action Description' ;
    rdfs:comment 'Brief description of the next required legal action or milestone for this matter (e.g., \'Submit regulatory response to FCC\', \'Execute NDA with counterparty\', \'Complete M&A due diligence review\'). Supports docketing and task management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextActionDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Action Due Date' ;
    rdfs:comment 'Date by which the next required legal action, filing, response, or milestone must be completed for this matter. Used for docketing, deadline management, and counsel workload planning.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outsideCounselEngagementRef rdf:type rdf:Property ;
    rdfs:label 'Outside Counsel Engagement Ref' ;
    rdfs:comment 'Reference number or engagement code for the outside law firm retained on this matter, as recorded in the legal spend management or e-billing system. Links to the outside counsel relationship record for invoice reconciliation and panel management.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outsideCounselFirmName rdf:type rdf:Property ;
    rdfs:label 'Outside Counsel Firm Name' ;
    rdfs:comment 'Name of the external law firm engaged to provide legal services on this matter. Captured for spend reporting, panel performance analytics, and conflict-of-interest checks.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pedWadaFlag rdf:type rdf:Property ;
    rdfs:label 'Ped Wada Flag' ;
    rdfs:comment 'Indicates whether this matter involves a Performance Enhancing Drug (PED) allegation or World Anti-Doping Agency (WADA) anti-doping rule violation. True = PED/WADA matter. Triggers specialized handling protocols and CAS arbitration procedures.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:privilegedFlag rdf:type rdf:Property ;
    rdfs:label 'Privileged Flag' ;
    rdfs:comment 'Indicates whether communications and documents associated with this matter are protected under attorney-client privilege. True = privileged. Controls access permissions and document disclosure in e-discovery and regulatory inquiry responses.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reference Number' ;
    rdfs:comment 'External reference number assigned by the relevant regulatory or governing body for this inquiry or matter (e.g., FCC docket number, SEC inquiry reference, WADA case ID). Null for non-regulatory matters.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedContractRef rdf:type rdf:Property ;
    rdfs:label 'Related Contract Ref' ;
    rdfs:comment 'Reference number of the primary contract or agreement that is the subject of or directly related to this legal matter (e.g., broadcast rights deal number, sponsorship agreement ID, athlete CBA reference, venue lease number). Links to the contract management system.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spendCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Spend Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code applicable to the estimated and actual legal spend amounts on this matter (e.g., USD, GBP, EUR). Supports multi-currency reporting for global operations.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCloseDate rdf:type rdf:Property ;
    rdfs:label 'Target Close Date' ;
    rdfs:comment 'Projected calendar date by which the legal matter is expected to be resolved and closed. Set at intake and may be revised during the matter lifecycle. Used for workload planning and SLA tracking.' ;
    rdfs:domain ind:Matter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:opinionId rdf:type rdf:Property ;
    rdfs:label 'Opinion Id' ;
    rdfs:comment 'Unique surrogate identifier for each formal legal opinion or memorandum record in the Sports Entertainment legal knowledge management system.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:issuingCounselEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Issuing Counsel Employee Id' ;
    rdfs:comment 'Reference to the attorney (in-house or outside counsel) who authored and issued this formal legal opinion or memorandum.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:opinionAthleteContractId rdf:type rdf:Property ;
    rdfs:label 'Opinion Athlete Contract Id' ;
    rdfs:comment 'Reference to a specific contract or agreement that is the subject of this legal opinion (e.g., a broadcast rights deal, sponsorship agreement, or CBA provision under review).' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteContract .

ind:opinionEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Opinion Employee Id' ;
    rdfs:comment 'Reference to the in-house attorney or outside counsel who formally requested this legal opinion on behalf of a Sports Entertainment business unit.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:opinionIssuingCounselEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Opinion Issuing Counsel Employee Id' ;
    rdfs:comment 'Reference to the attorney (in-house or outside counsel) who authored and issued this formal legal opinion or memorandum.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:opinionLitigationCaseId rdf:type rdf:Property ;
    rdfs:label 'Opinion Litigation Case Id' ;
    rdfs:comment 'Reference to an active or anticipated litigation case for which this legal opinion was prepared, enabling linkage between legal opinions and the litigation case management portfolio.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LitigationCase .

ind:opinionRelatedContractAthleteContractId rdf:type rdf:Property ;
    rdfs:label 'Opinion Related Contract Athlete Contract Id' ;
    rdfs:comment 'Reference to a specific contract or agreement that is the subject of this legal opinion (e.g., a broadcast rights deal, sponsorship agreement, or CBA provision under review).' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteContract .

ind:opinionRelatedLitigationCaseId rdf:type rdf:Property ;
    rdfs:label 'Opinion Related Litigation Case Id' ;
    rdfs:comment 'Reference to an active or anticipated litigation case for which this legal opinion was prepared, enabling linkage between legal opinions and the litigation case management portfolio.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LitigationCase .

ind:supersededByOpinionId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Opinion Id' ;
    rdfs:comment 'Reference to the newer legal opinion that supersedes this record when opinion_status is \'superseded\'. Enables forward-chaining of opinion version history for legal knowledge management.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Opinion .

ind:attorneyClientPrivilege rdf:type rdf:Property ;
    rdfs:label 'Attorney Client Privilege' ;
    rdfs:comment 'Indicates whether this legal opinion is protected by attorney-client privilege. When True, the document is subject to strict access controls and may not be disclosed in litigation without privilege waiver review.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conclusionCode rdf:type rdf:Property ;
    rdfs:label 'Conclusion Code' ;
    rdfs:comment 'Standardized categorical code representing the overall legal conclusion of the opinion. Favorable indicates the activity is legally permissible; conditional indicates permissibility subject to stated conditions; unfavorable indicates legal risk or impermissibility.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentRepositoryReference rdf:type rdf:Property ;
    rdfs:label 'Document Repository Reference' ;
    rdfs:comment 'Unique reference path or document ID pointing to the full-text legal opinion document stored in the enterprise document management or legal matter management system (e.g., SharePoint, iManage, NetDocuments path or document ID).' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedLegalFeeUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Legal Fee Usd' ;
    rdfs:comment 'Estimated total legal fees in US dollars associated with the preparation and issuance of this legal opinion, used for matter budgeting and outside counsel spend management. Denominated in USD per enterprise financial reporting standard.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:issuingCounselType rdf:type rdf:Property ;
    rdfs:label 'Issuing Counsel Type' ;
    rdfs:comment 'Indicates whether the legal opinion was authored by in-house legal counsel employed by Sports Entertainment or by an external outside counsel law firm engaged for the matter.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionStateProvince rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction State Province' ;
    rdfs:comment 'State, province, or sub-national jurisdiction relevant to the legal opinion where applicable (e.g., \'California\', \'New York\', \'Ontario\'). Particularly relevant for US state-level gaming, employment, and privacy law opinions.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opinionScope rdf:type rdf:Property ;
    rdfs:label 'Opinion Scope' ;
    rdfs:comment 'Indicates whether the legal opinion addresses domestic (single-country), international (single foreign jurisdiction), or multi-jurisdictional legal questions. Supports global legal portfolio management across Sports Entertainment\'s international markets.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opinionStatus rdf:type rdf:Property ;
    rdfs:label 'Opinion Status' ;
    rdfs:comment 'Current lifecycle status of the legal opinion. Draft opinions are works-in-progress; final opinions are formally issued; superseded opinions have been replaced by a newer version; withdrawn opinions have been retracted by issuing counsel.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opinionType rdf:type rdf:Property ;
    rdfs:label 'Opinion Type' ;
    rdfs:comment 'Classification of the legal opinion by subject matter area. Covers gaming regulatory opinions, tax opinions, employment law guidance, IP clearance opinions, antitrust risk assessments, M&A due diligence memos, and other legal subject areas. [ENUM-REF-CANDIDATE: gaming_regulatory|tax|employment_law|ip_clearance|antitrust|ma_due_diligence|contract_review|regulatory_compliance|other — promote to reference product]' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relianceLimitations rdf:type rdf:Property ;
    rdfs:label 'Reliance Limitations' ;
    rdfs:comment 'Narrative description of any limitations on who may rely on this opinion and under what circumstances (e.g., \'This opinion may be relied upon solely by Sports Entertainment and may not be shared with third parties without prior written consent of issuing counsel\').' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relianceParties rdf:type rdf:Property ;
    rdfs:label 'Reliance Parties' ;
    rdfs:comment 'Comma-separated list of named parties (business units, entities, or third parties) explicitly authorized to rely on this legal opinion as stated in the opinion letter or engagement terms.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingBusinessUnit rdf:type rdf:Property ;
    rdfs:label 'Requesting Business Unit' ;
    rdfs:comment 'Name of the Sports Entertainment business unit or division that requested this legal opinion (e.g., \'Broadcast & Media Rights\', \'Athlete Management\', \'Venue Operations\', \'Sponsorship & Partnerships\', \'Merchandise & Licensing\').' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Review Completed Date' ;
    rdfs:comment 'The date on which the internal legal review and approval process for this opinion was completed prior to formal issuance, supporting quality control and turnaround time analytics.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subjectMatterSummary rdf:type rdf:Property ;
    rdfs:label 'Subject Matter Summary' ;
    rdfs:comment 'Concise narrative description of the legal question or business issue addressed by this opinion (e.g., \'Legality of proposed sports betting partnership under Nevada gaming statutes\', \'NIL agreement compliance with NCAA and state law\'). Used for knowledge management and precedent search.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wadaRelated rdf:type rdf:Property ;
    rdfs:label 'Wada Related' ;
    rdfs:comment 'Indicates whether this legal opinion relates to anti-doping matters, Performance Enhancing Drug (PED) violations, or WADA Code compliance, enabling targeted reporting to sports governance bodies.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workProductProtected rdf:type rdf:Property ;
    rdfs:label 'Work Product Protected' ;
    rdfs:comment 'Indicates whether this legal opinion qualifies as attorney work product under the work product doctrine, providing an additional layer of protection from disclosure in discovery proceedings.' ;
    rdfs:domain ind:Opinion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:spendBudgetId rdf:type rdf:Property ;
    rdfs:label 'Spend Budget Id' ;
    rdfs:comment 'Unique surrogate identifier for each legal spend budget record in the Sports Entertainment legal department. Primary key for the legal_spend_budget data product.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualSpendAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Spend Amount' ;
    rdfs:comment 'Cumulative actual expenditure posted against this budget record from the start of the budget period through the last_updated_timestamp. Sourced from SAP S/4HANA FI/CO actual cost postings and accounts payable invoice processing. Used in variance and burn-rate analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Budget Amount' ;
    rdfs:comment 'Total approved budget allocation for this legal spend category, business unit, and budget period, expressed in the reporting currency. Represents the baseline authorized spend ceiling approved by the General Counsel or Deputy GC. Used as the denominator in variance analysis.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetCategory rdf:type rdf:Property ;
    rdfs:label 'Budget Category' ;
    rdfs:comment 'Classification of the legal expenditure type covered by this budget record. Categories align with the legal department\'s chart of accounts in SAP S/4HANA CO: outside counsel fees, IP (Intellectual Property) prosecution fees, litigation reserves, insurance premiums, regulatory filing fees, and internal legal operations. [ENUM-REF-CANDIDATE: outside_counsel|ip_prosecution_fees|litigation_reserve|insurance_premiums|regulatory_filing_fees|internal_legal_ops — promote to reference product]' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetNotes rdf:type rdf:Property ;
    rdfs:label 'Budget Notes' ;
    rdfs:comment 'Free-text field for budget owner commentary, variance explanations, reforecast rationale, or special instructions related to this budget record. Classified as confidential due to potential attorney-client privileged content.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetOwnerName rdf:type rdf:Property ;
    rdfs:label 'Budget Owner Name' ;
    rdfs:comment 'Name of the legal department executive responsible for this budget record, typically the General Counsel (GC) or Deputy General Counsel. The budget owner is accountable for spend governance, reforecast submissions, and variance explanations.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetOwnerTitle rdf:type rdf:Property ;
    rdfs:label 'Budget Owner Title' ;
    rdfs:comment 'Official title of the budget owner responsible for this legal spend allocation. Supports delegation-of-authority controls and SOX-compliant approval workflow documentation. [ENUM-REF-CANDIDATE: general_counsel|deputy_general_counsel|associate_general_counsel|vp_legal|director_legal_ops — promote to reference product]' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Budget Period End Date' ;
    rdfs:comment 'The last calendar date of the budget period covered by this record. Defines the boundary for spend accrual and variance reporting within this budget allocation.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Budget Period Start Date' ;
    rdfs:comment 'The first calendar date of the budget period covered by this record. Supports sub-annual (quarterly or semi-annual) budget allocations in addition to full fiscal-year budgets.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetPeriodYear rdf:type rdf:Property ;
    rdfs:label 'Budget Period Year' ;
    rdfs:comment 'Fiscal year to which this legal spend budget record applies (e.g., 2024, 2025). Aligns with the Sports Entertainment fiscal calendar as defined in SAP S/4HANA FI (Financial Accounting) and Workday Adaptive Planning annual planning cycles.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:budgetReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Budget Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to this budget record, used for cross-referencing with SAP S/4HANA CO (Controlling) cost center planning documents and Workday Adaptive Planning budget lines. Format: LSB-{YYYY}-{NNNNNN}.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetStatus rdf:type rdf:Property ;
    rdfs:label 'Budget Status' ;
    rdfs:comment 'Current lifecycle state of the legal spend budget record. Tracks progression from initial draft through General Counsel approval to active spend tracking and eventual closure. [ENUM-REF-CANDIDATE: draft|pending_approval|approved|active|reforecast|closed|cancelled — promote to reference product]' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessUnitName rdf:type rdf:Property ;
    rdfs:label 'Business Unit Name' ;
    rdfs:comment 'Name of the Sports Entertainment business unit or division to which this legal spend budget is allocated (e.g., NFL Operations, Broadcast Network, Venue Management, Athlete Management, Merchandise & Licensing). Supports cross-divisional legal cost allocation and chargeback reporting.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isGdprMatter rdf:type rdf:Property ;
    rdfs:label 'Is Gdpr Matter' ;
    rdfs:comment 'Indicates whether this legal spend budget record relates to a matter involving GDPR (General Data Protection Regulation) compliance, data subject rights, supervisory authority proceedings, or cross-border data transfer disputes. Supports GDPR Article 5 accountability and DPA reporting.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMaterialLitigationReserve rdf:type rdf:Property ;
    rdfs:label 'Is Material Litigation Reserve' ;
    rdfs:comment 'Indicates whether this budget record includes a litigation reserve that meets the materiality threshold requiring disclosure in SEC financial filings or SOX management certifications. True = material disclosure required; False = below materiality threshold.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWadaMatter rdf:type rdf:Property ;
    rdfs:label 'Is Wada Matter' ;
    rdfs:comment 'Indicates whether this legal spend budget record is associated with a WADA (World Anti-Doping Agency) anti-doping proceeding, PED (Performance Enhancing Drug) investigation, or CAS (Court of Arbitration for Sport) appeal. Supports sports-specific compliance spend tracking.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastReforecastDate rdf:type rdf:Property ;
    rdfs:label 'Last Reforecast Date' ;
    rdfs:comment 'Date on which the most recent reforecast of this budget record was submitted and approved. Tracks the currency of the reforecast_amount and supports quarterly legal department financial review cycles.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:litigationReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Litigation Reserve Amount' ;
    rdfs:comment 'Specific reserve amount set aside within this budget record for anticipated litigation losses, settlements, or judgments. Applicable when budget_category is \'litigation_reserve\'. Supports ASC 450 (Contingencies) and IAS 37 (Provisions) financial disclosure requirements for material litigation.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outsideCounselEngagementType rdf:type rdf:Property ;
    rdfs:label 'Outside Counsel Engagement Type' ;
    rdfs:comment 'Fee arrangement type governing the outside counsel engagement associated with this budget record. Applicable when budget_category is \'outside_counsel\'. Supports outside counsel spend governance and rate benchmarking per the Sports Entertainment Outside Counsel Guidelines.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reforecastAmount rdf:type rdf:Property ;
    rdfs:label 'Reforecast Amount' ;
    rdfs:comment 'Most recent reforecast of expected total spend for this budget record for the full budget period, reflecting updated projections based on actual spend trends, new matter developments, or litigation reserve adjustments. Replaces the approved budget as the primary variance baseline after reforecast approval.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reforecastVersion rdf:type rdf:Property ;
    rdfs:label 'Reforecast Version' ;
    rdfs:comment 'Sequential version counter for reforecast submissions against this budget record within the budget period (e.g., 1 = Q1 reforecast, 2 = Q2 reforecast). Enables audit trail of forecast evolution and supports Workday Adaptive Planning version management.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sapInternalOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Internal Order Number' ;
    rdfs:comment 'SAP S/4HANA CO internal order number assigned to this legal spend budget for project-level cost tracking and settlement. Enables granular cost collection for specific legal matters or IP prosecution campaigns beyond cost center level.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spendToBudgetPct rdf:type rdf:Property ;
    rdfs:label 'Spend To Budget Pct' ;
    rdfs:comment 'Persisted ratio of actual_spend_amount to approved_budget_amount expressed as a percentage (0.00–100.00+). Stored as a point-in-time snapshot to support KPI (Key Performance Indicator) dashboards and legal department financial management reporting without requiring recalculation at query time.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workdayBudgetLineReference rdf:type rdf:Property ;
    rdfs:label 'Workday Budget Line Reference' ;
    rdfs:comment 'Reference identifier from Workday Adaptive Planning corresponding to this legal spend budget line. Enables bidirectional traceability between the Silver Layer data product and the source financial planning system for reconciliation and audit purposes.' ;
    rdfs:domain ind:SpendBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedEventFixtureId rdf:type rdf:Property ;
    rdfs:label 'Related Event Fixture Id' ;
    rdfs:comment 'Reference to a specific sports or entertainment event that is the subject of or directly related to this litigation matter (e.g., a personal injury claim arising from a specific game or concert). Links to the event master for operational context and insurance claim correlation.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fixture .

ind:answerDueDate rdf:type rdf:Property ;
    rdfs:label 'Answer Due Date' ;
    rdfs:comment 'Deadline by which Sports Entertainment must file its answer, motion to dismiss, or other responsive pleading. Critical for legal calendar management and avoiding default judgments.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:caseName rdf:type rdf:Property ;
    rdfs:label 'Case Name' ;
    rdfs:comment 'Official caption or style of the case as it appears on court filings (e.g., \'Sports Entertainment LLC v. Acme Promotions Inc.\'). Used for identification in legal registers, board reports, and outside counsel communications.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtOrTribunal rdf:type rdf:Property ;
    rdfs:label 'Court Or Tribunal' ;
    rdfs:comment 'Full name of the court, arbitration panel, regulatory body, or tribunal where the matter is pending (e.g., \'U.S. District Court – SDNY\', \'American Arbitration Association\', \'Court of Arbitration for Sport\', \'NLRB\'). Used for docketing, service of process tracking, and legal calendar management.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveryCutoffDate rdf:type rdf:Property ;
    rdfs:label 'Discovery Cutoff Date' ;
    rdfs:comment 'Court-ordered deadline by which all fact discovery (depositions, document production, interrogatories) must be completed. Drives legal hold management, e-discovery workflows, and outside counsel scheduling.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dispositionDate rdf:type rdf:Property ;
    rdfs:label 'Disposition Date' ;
    rdfs:comment 'Date on which the final disposition of the matter was reached (settlement execution date, judgment entry date, or arbitration award date). Triggers reserve release, legal hold lift, and financial close-out workflows.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dispositionType rdf:type rdf:Property ;
    rdfs:label 'Disposition Type' ;
    rdfs:comment 'The manner in which the litigation matter was ultimately resolved. Populated when case_status transitions to \'settled\' or \'closed\'. Used for litigation outcome analytics, reserve release, and post-matter review. [ENUM-REF-CANDIDATE: settlement|judgment_for_plaintiff|judgment_for_defendant|dismissal_with_prejudice|dismissal_without_prejudice|arbitration_award|consent_decree — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Exposure Amount' ;
    rdfs:comment 'Legal team\'s current best estimate of the maximum potential financial liability (damages, penalties, fees) if the matter is decided adversely to Sports Entertainment. Used for financial reserve setting, EBITDA impact analysis, and SEC disclosure materiality assessments under ASC 450.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expertDisclosureDate rdf:type rdf:Property ;
    rdfs:label 'Expert Disclosure Date' ;
    rdfs:comment 'Court-ordered deadline for disclosure of expert witnesses and their reports under FRCP Rule 26(a)(2). Relevant for damages quantification experts, sports science experts, and industry standard-of-care witnesses.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insuranceClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Number' ;
    rdfs:comment 'Claim number assigned by the insurer upon tender of the litigation matter. Used to track insurance recovery, monitor insurer defense obligations, and reconcile indemnification payments against reserve amounts.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isClassAction rdf:type rdf:Property ;
    rdfs:label 'Is Class Action' ;
    rdfs:comment 'Indicates whether this matter is a class action or collective action lawsuit. Class actions carry significantly higher exposure, require specialized defense strategy, and trigger enhanced reserve and disclosure requirements.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMaterial rdf:type rdf:Property ;
    rdfs:label 'Is Material' ;
    rdfs:comment 'Indicates whether this litigation matter meets the SEC materiality threshold requiring disclosure in public financial filings (10-K, 10-Q) under SEC Regulation S-K Item 103. Set by in-house counsel in consultation with finance. True = material disclosure required.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isUnderLegalHold rdf:type rdf:Property ;
    rdfs:label 'Is Under Legal Hold' ;
    rdfs:comment 'Indicates whether a litigation hold (preservation notice) has been issued for this matter, requiring suspension of normal document retention and destruction policies. True = active legal hold in place. Critical for e-discovery compliance and spoliation risk management.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalFeeBudget rdf:type rdf:Property ;
    rdfs:label 'Legal Fee Budget' ;
    rdfs:comment 'Approved budget for outside counsel and litigation-related expenses for this matter, as set during matter intake or annual legal budget planning in Workday Adaptive Planning. Compared against legal_fees_incurred for variance reporting.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:legalFeesIncurred rdf:type rdf:Property ;
    rdfs:label 'Legal Fees Incurred' ;
    rdfs:comment 'Cumulative outside counsel and litigation-related legal fees invoiced and approved to date for this matter. Sourced from SAP S/4HANA AP module invoice postings. Used for matter budget tracking, outside counsel spend analysis, and total cost-of-litigation reporting.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:legalHoldDate rdf:type rdf:Property ;
    rdfs:label 'Legal Hold Date' ;
    rdfs:comment 'Date on which the litigation hold notice was formally issued to relevant custodians within Sports Entertainment. Used to establish the preservation obligation start date and demonstrate good-faith compliance with e-discovery obligations.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:opposingCounselFirm rdf:type rdf:Property ;
    rdfs:label 'Opposing Counsel Firm' ;
    rdfs:comment 'Name of the law firm representing the opposing party. Used for conflict-of-interest screening, litigation intelligence, and outside counsel relationship management.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opposingLeadAttorney rdf:type rdf:Property ;
    rdfs:label 'Opposing Lead Attorney' ;
    rdfs:comment 'Full name of the lead attorney of record for the opposing party. Used for conflict checks, deposition scheduling, and litigation strategy assessments.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opposingPartyName rdf:type rdf:Property ;
    rdfs:label 'Opposing Party Name' ;
    rdfs:comment 'Full legal name of the primary adverse party (individual, corporation, union, or regulatory body) in the litigation matter. Used for conflict-of-interest checks, counterparty risk analysis, and legal correspondence.' ;
    rdfs:domain ind:Legal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyRole rdf:type rdf:Property ;
    rdfs:label 'Party Role' ;
    rdfs:comment 'Designates whether Sports Entertainment is the initiating party (plaintiff/petitioner) or responding party (defendant/respondent) in the matter. Critical for exposure assessment, litigation strategy, and financial disclosure under SEC Regulation S-K.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedBusinessUnit rdf:type rdf:Property ;
    rdfs:label 'Related Business Unit' ;
    rdfs:comment 'The Sports Entertainment business unit or division most directly involved in or affected by this litigation matter (e.g., \'Venue Operations\', \'Broadcast\', \'Athlete Management\', \'Ticketing\', \'Merchandise\'). Used for cost allocation, business unit risk reporting, and operational impact assessment.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceDate rdf:type rdf:Property ;
    rdfs:label 'Service Date' ;
    rdfs:comment 'Date on which Sports Entertainment was formally served with process or on which it served the opposing party, establishing the response deadline and triggering internal legal escalation workflows.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trialDate rdf:type rdf:Property ;
    rdfs:label 'Trial Date' ;
    rdfs:comment 'Scheduled date for the commencement of trial or final arbitration hearing. Used for resource planning, witness preparation scheduling, and financial reserve review triggers.' ;
    rdfs:domain ind:LitigationCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:litigationEventId rdf:type rdf:Property ;
    rdfs:label 'Litigation Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each litigation event record within the Silver Layer lakehouse. Primary key for the litigation_event data product.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adaComplianceRelated rdf:type rdf:Property ;
    rdfs:label 'Ada Compliance Related' ;
    rdfs:comment 'Indicates whether this litigation event relates to an ADA (Americans with Disabilities Act) compliance matter, such as venue accessibility claims. Relevant for venue operations and facility management disputes.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastRightsDealReference rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Deal Reference' ;
    rdfs:comment 'Reference to the specific broadcast or media rights deal that is the subject of or implicated by this litigation event. Relevant for rights violation disputes and sublicense disagreements. Classified confidential.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtDocketNumber rdf:type rdf:Property ;
    rdfs:label 'Court Docket Number' ;
    rdfs:comment 'Official docket number assigned by the court or arbitral tribunal to this specific filing or event. Used to cross-reference official court records and track filings in PACER or equivalent court management systems.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtName rdf:type rdf:Property ;
    rdfs:label 'Court Name' ;
    rdfs:comment 'Full name of the court, arbitral tribunal, or dispute resolution body before which this litigation event takes place (e.g., U.S. District Court for the Southern District of New York, Court of Arbitration for Sport).' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDescription rdf:type rdf:Property ;
    rdfs:label 'Event Description' ;
    rdfs:comment 'Detailed narrative description of the litigation event, including procedural context, key arguments raised, and any notable developments. Classified confidential due to attorney-client privilege considerations.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Event Reference Number' ;
    rdfs:comment 'Externally-known business identifier for this litigation event, used in correspondence with courts, outside counsel, and opposing parties. Follows the format EVT-YYYY-NNNNNN.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingParty rdf:type rdf:Property ;
    rdfs:label 'Filing Party' ;
    rdfs:comment 'The party in the litigation who initiated or filed this specific procedural event. Identifies whether Sports Entertainment or the opposing party is the moving party for this event.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingPartyName rdf:type rdf:Property ;
    rdfs:label 'Filing Party Name' ;
    rdfs:comment 'Legal name of the entity or individual who filed or initiated this litigation event. May be Sports Entertainment, an opposing party, or a third party. Classified confidential as it relates to active legal proceedings.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isConfidentialSettlement rdf:type rdf:Property ;
    rdfs:label 'Is Confidential Settlement' ;
    rdfs:comment 'Indicates whether this litigation event involves a confidential settlement agreement subject to non-disclosure obligations. Drives access control and data handling restrictions for this record.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMaterialLitigation rdf:type rdf:Property ;
    rdfs:label 'Is Material Litigation' ;
    rdfs:comment 'Indicates whether this litigation event is part of a matter deemed material for SEC financial disclosure purposes under SOX. Drives escalation to the CFO and General Counsel for public company reporting obligations.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leadJudgeName rdf:type rdf:Property ;
    rdfs:label 'Lead Judge Name' ;
    rdfs:comment 'Name of the presiding judge, arbitrator, or mediator overseeing this litigation event. Used for case assignment tracking and judicial history analysis.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Next Deadline Date' ;
    rdfs:comment 'The next procedural deadline triggered by this litigation event, such as a response due date, appeal filing window, or discovery cutoff. Critical for docket management and deadline tracking.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextDeadlineDescription rdf:type rdf:Property ;
    rdfs:label 'Next Deadline Description' ;
    rdfs:comment 'Narrative description of the next procedural deadline triggered by this event, specifying the required action and responsible party (e.g., \'File answer to amended complaint by defendant\').' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proceedingStage rdf:type rdf:Property ;
    rdfs:label 'Proceeding Stage' ;
    rdfs:comment 'Current stage of the overall litigation proceeding at the time of this event. Enables portfolio-level reporting on case maturity and resource allocation across the legal department. [ENUM-REF-CANDIDATE: pre_litigation|pleadings|discovery|motions|trial|post_trial|appeal|enforcement — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rulingSummary rdf:type rdf:Property ;
    rdfs:label 'Ruling Summary' ;
    rdfs:comment 'Concise narrative summary of the judge\'s, arbitrator\'s, or mediator\'s ruling or decision arising from this event. Classified confidential due to attorney-client privilege and active litigation sensitivity.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Settlement Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the settlement amount (e.g., USD, EUR, GBP). Required for multi-currency financial reporting and SAP S/4HANA FI integration.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venueLocation rdf:type rdf:Property ;
    rdfs:label 'Venue Location' ;
    rdfs:comment 'Physical or virtual location where the litigation event takes place, such as a courthouse address, arbitration center, or remote hearing platform. Distinct from sports venue operations.' ;
    rdfs:domain ind:LitigationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachReportedDate rdf:type rdf:Property ;
    rdfs:label 'Breach Reported Date' ;
    rdfs:comment 'Date on which a breach or suspected breach of this NDA was formally reported. Populated only when breach_reported_flag is True.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:breachReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Breach Reported Flag' ;
    rdfs:comment 'Indicates whether a breach or suspected breach of this NDA has been formally reported to the legal team. Triggers escalation and potential litigation workflows.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ccpaApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Ccpa Applicable Flag' ;
    rdfs:comment 'Indicates whether the California Consumer Privacy Act (CCPA) applies to personal data shared under this NDA, based on California residency of data subjects.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:confidentialityScope rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Scope' ;
    rdfs:comment 'Narrative description of the categories of confidential information covered by the NDA, such as financial data, broadcast rights terms, athlete performance data, IP portfolios, M&A transaction details, or strategic partnership terms.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityTermYears rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Term Years' ;
    rdfs:comment 'Duration in years for which confidentiality obligations survive after the NDA\'s expiration or termination. Null indicates perpetual post-termination obligations.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:counterpartyJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Counterparty Jurisdiction' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the legal jurisdiction of the counterparty. Informs applicable data privacy law (GDPR, CCPA) and governing law selection.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartySignatoryName rdf:type rdf:Property ;
    rdfs:label 'Counterparty Signatory Name' ;
    rdfs:comment 'Full name of the individual who signed the NDA on behalf of the counterparty organization, or the individual themselves for personal NDAs (athletes, employees).' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartySignatoryTitle rdf:type rdf:Property ;
    rdfs:label 'Counterparty Signatory Title' ;
    rdfs:comment 'Job title or role of the counterparty signatory, used to confirm authority to bind the counterparty organization to the NDA.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gdprApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Gdpr Applicable Flag' ;
    rdfs:comment 'Indicates whether the General Data Protection Regulation (GDPR) applies to the personal data shared under this NDA, based on counterparty jurisdiction or data subject location.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:governingLawStateProvince rdf:type rdf:Property ;
    rdfs:label 'Governing Law State Province' ;
    rdfs:comment 'State or province within the governing law jurisdiction (e.g., New York, California, Ontario) specifying the sub-national legal framework applicable to the NDA.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPerpetual rdf:type rdf:Property ;
    rdfs:label 'Is Perpetual' ;
    rdfs:comment 'Indicates whether the confidentiality obligations under this NDA are perpetual (no defined end date). When True, expiration_date is expected to be null.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialDeviationFlag rdf:type rdf:Property ;
    rdfs:label 'Material Deviation Flag' ;
    rdfs:comment 'Indicates whether this NDA contains material deviations from the approved standard template, requiring additional legal review or senior counsel approval.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialDeviationNotes rdf:type rdf:Property ;
    rdfs:label 'Material Deviation Notes' ;
    rdfs:comment 'Description of significant deviations from the standard NDA template, including the nature of the deviation and the business justification. Populated only when material_deviation_flag is True.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndaType rdf:type rdf:Property ;
    rdfs:label 'Nda Type' ;
    rdfs:comment 'Classification of the NDA by directionality of confidentiality obligations: mutual (both parties bound), one_way_outbound (Sports Entertainment discloses), one_way_inbound (counterparty discloses), or multilateral (three or more parties).' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Nil Related Flag' ;
    rdfs:comment 'Indicates whether this NDA is associated with a Name, Image, and Likeness (NIL) agreement or negotiation involving an athlete, requiring specific compliance with NIL regulations.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outsideCounselFirm rdf:type rdf:Property ;
    rdfs:label 'Outside Counsel Firm' ;
    rdfs:comment 'Name of the external law firm engaged to assist in drafting, reviewing, or negotiating this NDA, if applicable. Supports outside counsel spend tracking and relationship management.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permittedDisclosureExceptions rdf:type rdf:Property ;
    rdfs:label 'Permitted Disclosure Exceptions' ;
    rdfs:comment 'Description of carve-outs and exceptions to the confidentiality obligation, such as disclosures required by law, regulatory bodies (SEC, FCC), court order, or to professional advisors on a need-to-know basis.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDueDate rdf:type rdf:Property ;
    rdfs:label 'Review Due Date' ;
    rdfs:comment 'Date by which the assigned in-house counsel must complete a scheduled review of the NDA, typically set ahead of expiration or renewal notice deadlines to enable proactive management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sportsEntertainmentSignatoryName rdf:type rdf:Property ;
    rdfs:label 'Sports Entertainment Signatory Name' ;
    rdfs:comment 'Full name of the Sports Entertainment authorized representative who executed the NDA on behalf of the company.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportsEntertainmentSignatoryTitle rdf:type rdf:Property ;
    rdfs:label 'Sports Entertainment Signatory Title' ;
    rdfs:comment 'Job title or role of the Sports Entertainment signatory, confirming authority to bind the company to the NDA.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateVersion rdf:type rdf:Property ;
    rdfs:label 'Template Version' ;
    rdfs:comment 'Version identifier of the standard NDA template used as the basis for this agreement (e.g., v3.2-mutual, v2.0-vendor). Supports template governance and legal review tracking.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionContext rdf:type rdf:Property ;
    rdfs:label 'Transaction Context' ;
    rdfs:comment 'Business context or deal type that prompted the NDA execution. Enables segmentation of NDA portfolio by business activity. [ENUM-REF-CANDIDATE: ma_transaction|broadcast_rights|sponsorship|athlete_signing|vendor_engagement|content_licensing|venue_partnership|investor_relations|general — promote to reference product]' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualSpendBudgetUsd rdf:type rdf:Property ;
    rdfs:label 'Annual Spend Budget Usd' ;
    rdfs:comment 'Approved annual budget in US dollars allocated to this outside counsel firm for the current fiscal year. Used for legal spend management, budget vs. actual variance tracking in Workday Adaptive Planning, and outside counsel cost control.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:barAdmissionJurisdictions rdf:type rdf:Property ;
    rdfs:label 'Bar Admission Jurisdictions' ;
    rdfs:comment 'Comma-separated list of jurisdictions (US state codes or country codes) in which the outside counsel firm\'s attorneys hold active bar admissions. Validates the firm\'s legal authority to practice in jurisdictions relevant to Sports Entertainment matters.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAddress rdf:type rdf:Property ;
    rdfs:label 'Billing Address' ;
    rdfs:comment 'Full mailing address of the outside counsel firm used for invoice and payment correspondence. Required for SAP S/4HANA accounts payable processing and tax document issuance (e.g., IRS Form 1099).' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactEmail rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Email' ;
    rdfs:comment 'Professional email address of the billing contact at the outside counsel firm. Used for invoice routing, e-billing platform enrollment, and payment confirmation communications.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactName rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Name' ;
    rdfs:comment 'Full name of the designated billing contact at the outside counsel firm responsible for invoice submission, billing rate queries, and accounts receivable coordination with Sports Entertainment\'s finance team.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Conflict Check Status' ;
    rdfs:comment 'Current status of the conflict-of-interest check conducted for this outside counsel firm. Cleared indicates no conflicts found; conflict_identified indicates a potential conflict requiring resolution; waived indicates a conflict was identified but formally waived by authorized legal leadership.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataProcessingAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Data Processing Agreement Flag' ;
    rdfs:comment 'Indicates whether a Data Processing Agreement (DPA) has been executed with this outside counsel firm as required under GDPR Article 28 and CCPA for any engagement involving personal data of EU or California residents (e.g., fan data, athlete data).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diversityCertExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Diversity Cert Expiry Date' ;
    rdfs:comment 'Date on which the outside counsel firm\'s diversity certification expires. Triggers renewal reminder workflow to maintain accurate supplier diversity reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:diversityCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Diversity Certification Number' ;
    rdfs:comment 'Official certification number issued by the certifying body (e.g., NMSDC, WBENC) confirming the outside counsel firm\'s diversity status. Used for audit verification and supplier diversity reporting.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diversityCertificationType rdf:type rdf:Property ;
    rdfs:label 'Diversity Certification Type' ;
    rdfs:comment 'Type of diversity certification held by the outside counsel firm as recognized by a third-party certifying body (e.g., NMSDC, WBENC). Supports Sports Entertainment\'s supplier diversity reporting and DEI (Diversity, Equity, and Inclusion) program compliance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ebillingPlatform rdf:type rdf:Property ;
    rdfs:label 'Ebilling Platform' ;
    rdfs:comment 'Name of the electronic billing platform through which this outside counsel firm submits invoices to Sports Entertainment. Supports automated invoice ingestion, UTBMS code validation, and billing guideline enforcement.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementEndDate rdf:type rdf:Property ;
    rdfs:label 'Engagement End Date' ;
    rdfs:comment 'Date on which the outside counsel firm\'s engagement relationship with Sports Entertainment formally ended or is scheduled to end. Null for currently active relationships. Used for vendor lifecycle management and historical reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:engagementJurisdictions rdf:type rdf:Property ;
    rdfs:label 'Engagement Jurisdictions' ;
    rdfs:comment 'Comma-separated list of ISO 3166-1 alpha-2 country codes or US state codes representing all jurisdictions in which this outside counsel is authorized and engaged to provide legal services on behalf of Sports Entertainment. Supports multi-jurisdictional matter routing.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementStartDate rdf:type rdf:Property ;
    rdfs:label 'Engagement Start Date' ;
    rdfs:comment 'Date on which the outside counsel firm\'s engagement relationship with Sports Entertainment formally commenced. Represents the effective start of the master engagement framework or first matter assignment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firmCode rdf:type rdf:Property ;
    rdfs:label 'Firm Code' ;
    rdfs:comment 'Internally assigned alphanumeric code uniquely identifying the outside counsel firm within Sports Entertainment systems (e.g., SAP S/4HANA vendor master). Used for cross-system reconciliation and billing reference.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firmName rdf:type rdf:Property ;
    rdfs:label 'Firm Name' ;
    rdfs:comment 'Full legal name of the outside law firm or solo practitioner as registered with the relevant bar association or professional body. Used as the primary identity label for the counsel record.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firmType rdf:type rdf:Property ;
    rdfs:label 'Firm Type' ;
    rdfs:comment 'Classification of the outside counsel firm by size and market tier. AmLaw 100/200 denotes large national firms ranked by the American Lawyer; boutique indicates specialized niche practices; regional covers mid-market firms; solo covers individual practitioners; international covers non-US headquartered global firms.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hqCountryCode rdf:type rdf:Property ;
    rdfs:label 'Hq Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the country where the outside counsel firm\'s principal office is headquartered. Used for geographic reporting, tax treaty analysis, and GDPR/CCPA data transfer assessments.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hqStateProvince rdf:type rdf:Property ;
    rdfs:label 'Hq State Province' ;
    rdfs:comment 'State or province of the outside counsel firm\'s principal office. Critical for US bar admission verification and state-specific regulatory compliance (e.g., CCPA for California-based firms).' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:malpracticeCoverageAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Malpractice Coverage Amount Usd' ;
    rdfs:comment 'Total professional liability (malpractice) insurance coverage amount in US dollars maintained by the outside counsel firm. Sports Entertainment requires a minimum coverage threshold as a condition of panel counsel designation.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:malpracticeInsuranceCarrier rdf:type rdf:Property ;
    rdfs:label 'Malpractice Insurance Carrier' ;
    rdfs:comment 'Name of the professional liability (malpractice) insurance carrier for the outside counsel firm. Required as part of vendor onboarding due diligence to ensure adequate coverage for legal services rendered to Sports Entertainment.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:malpracticePolicyExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Malpractice Policy Expiry Date' ;
    rdfs:comment 'Expiry date of the outside counsel firm\'s current professional liability insurance policy. Triggers renewal verification workflow to ensure continuous coverage during active engagements.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ndaExecutedFlag rdf:type rdf:Property ;
    rdfs:label 'Nda Executed Flag' ;
    rdfs:comment 'Indicates whether a Non-Disclosure Agreement (NDA) has been fully executed between Sports Entertainment and this outside counsel firm. Required before sharing confidential business information, IP portfolios, or athlete contract details.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ndaExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Nda Execution Date' ;
    rdfs:comment 'Date on which the Non-Disclosure Agreement (NDA) between Sports Entertainment and this outside counsel firm was fully executed by authorized signatories.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:panelCounselFlag rdf:type rdf:Property ;
    rdfs:label 'Panel Counsel Flag' ;
    rdfs:comment 'Indicates whether this outside counsel firm holds a formal panel counsel designation, meaning they are pre-approved and preferred for routine legal matters under a standing engagement framework. Panel counsel typically receive preferred billing rates and streamlined matter assignment.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Primary Jurisdiction' ;
    rdfs:comment 'ISO 3166-1 alpha-2 or alpha-3 country code representing the primary jurisdiction in which the outside counsel firm is licensed and primarily engaged. Drives conflict-of-law analysis and regulatory compliance requirements.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPracticeAreas rdf:type rdf:Property ;
    rdfs:label 'Primary Practice Areas' ;
    rdfs:comment 'Comma-separated list of the firm\'s primary legal practice areas relevant to Sports Entertainment engagements (e.g., intellectual property, labor and employment, commercial litigation, mergers and acquisitions, gaming regulation, broadcast rights, athlete contracts, sponsorship). [ENUM-REF-CANDIDATE: intellectual_property|labor_employment|litigation|mergers_acquisitions|gaming_regulation|broadcast_rights|athlete_contracts|sponsorship|real_estate|tax|corporate_governance|data_privacy — promote to reference product]' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCardEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Rate Card Effective Date' ;
    rdfs:comment 'Date from which the current negotiated billing rate card is effective for this outside counsel firm. Used to validate invoice rates and trigger rate renegotiation workflows upon expiry.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateCardExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Rate Card Expiry Date' ;
    rdfs:comment 'Date on which the current negotiated billing rate card expires for this outside counsel firm. Triggers rate renegotiation or renewal workflow. Null indicates an open-ended rate arrangement.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:relationshipPartnerEmail rdf:type rdf:Property ;
    rdfs:label 'Relationship Partner Email' ;
    rdfs:comment 'Professional email address of the primary relationship partner at the outside counsel firm. Used for matter assignment notifications, billing communications, and relationship management correspondence.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipPartnerName rdf:type rdf:Property ;
    rdfs:label 'Relationship Partner Name' ;
    rdfs:comment 'Full name of the lead attorney or relationship partner at the outside counsel firm who serves as the primary point of contact for Sports Entertainment. This individual is accountable for matter quality, billing oversight, and strategic relationship management.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardAssociateRateUsd rdf:type rdf:Property ;
    rdfs:label 'Standard Associate Rate Usd' ;
    rdfs:comment 'Standard hourly billing rate in US dollars for associate-level attorneys at this outside counsel firm as negotiated in the rate card agreement. Supports tiered billing analysis and budget forecasting.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:standardParalegalRateUsd rdf:type rdf:Property ;
    rdfs:label 'Standard Paralegal Rate Usd' ;
    rdfs:comment 'Standard hourly billing rate in US dollars for paralegal staff at this outside counsel firm as negotiated in the rate card agreement. Enables granular legal spend analysis by timekeeper category.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:standardPartnerRateUsd rdf:type rdf:Property ;
    rdfs:label 'Standard Partner Rate Usd' ;
    rdfs:comment 'Standard hourly billing rate in US dollars for partner-level attorneys at this outside counsel firm as negotiated in the rate card agreement. Used for matter budget estimation and invoice validation in SAP S/4HANA.' ;
    rdfs:domain ind:OutsideCounsel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxIdentifier rdf:type rdf:Property ;
    rdfs:label 'Tax Identifier' ;
    rdfs:comment 'Federal Employer Identification Number (EIN) or equivalent tax identification number for the outside counsel firm. Required for IRS Form 1099 reporting, SAP S/4HANA vendor master tax configuration, and SOX-compliant vendor payment controls.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerOfAttorneyId rdf:type rdf:Property ;
    rdfs:label 'Power Of Attorney Id' ;
    rdfs:comment 'Unique surrogate identifier for each power of attorney instrument record in the Sports Entertainment corporate legal system.' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:grantorCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Grantor Corporate Entity Id' ;
    rdfs:comment 'Foreign key linking to legal.corporate_entity. Business justification: power_of_attorney.grantor_entity_name and grantor_entity_type are denormalized references to the corporate entity granting the power of attorney. Adding grantor_corporate_entity_id FK (with \'grantor_\'' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:apostilleRequired rdf:type rdf:Property ;
    rdfs:label 'Apostille Required' ;
    rdfs:comment 'Indicates whether an apostille certification is required for this POA to be recognized in a foreign jurisdiction under the Hague Convention. Critical for international IP prosecution and cross-border transactions.' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:apostilleStatus rdf:type rdf:Property ;
    rdfs:label 'Apostille Status' ;
    rdfs:comment 'Current status of the apostille certification for international recognition: not_required, pending (applied for), or completed (apostille affixed).' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityCategory rdf:type rdf:Property ;
    rdfs:label 'Authority Category' ;
    rdfs:comment 'Functional category of authority granted: financial (banking, payments, investments), legal (litigation, contracts), ip_prosecution (patent/trademark filings), real_estate (venue/property transactions), employment (HR actions), or regulatory_filing (government submissions). [ENUM-REF-CANDIDATE: financial|legal|ip_prosecution|real_estate|employment|regulatory_filing|media_rights|licensing — promote to reference product]' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityScope rdf:type rdf:Property ;
    rdfs:label 'Authority Scope' ;
    rdfs:comment 'Narrative description of the specific powers and authority granted under the POA, including any limitations, conditions, or restrictions on the grantee\'s authority (e.g., authority to sign contracts up to $500K, authority to prosecute trademark applications in specified jurisdictions).' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentVersion rdf:type rdf:Property ;
    rdfs:label 'Document Version' ;
    rdfs:comment 'Version identifier of the POA document (e.g., v1.0, v2.1), tracking amendments or re-executions of the instrument over its lifecycle.' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:granteeName rdf:type rdf:Property ;
    rdfs:label 'Grantee Name' ;
    rdfs:comment 'Full legal name of the individual or entity receiving the delegated authority under the POA instrument. May be an employee, outside counsel, agent, or corporate officer.' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:granteeOrganization rdf:type rdf:Property ;
    rdfs:label 'Grantee Organization' ;
    rdfs:comment 'Name of the organization or firm the grantee represents (e.g., outside counsel law firm, bank, IP prosecution firm). Null if the grantee is acting in an individual capacity.' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:granteeRole rdf:type rdf:Property ;
    rdfs:label 'Grantee Role' ;
    rdfs:comment 'Business role or capacity of the grantee in relation to Sports Entertainment: corporate_officer, outside_counsel, ip_agent (for IP prosecution POAs), banking_signatory, or authorized_representative. [ENUM-REF-CANDIDATE: corporate_officer|outside_counsel|ip_agent|banking_signatory|authorized_representative|notary|trustee — promote to reference product]' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantorJurisdictionCountryCode rdf:type rdf:Property ;
    rdfs:label 'Grantor Jurisdiction Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction under which the grantor entity is incorporated or registered (e.g., USA, GBR, DEU).' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipOfficeReference rdf:type rdf:Property ;
    rdfs:label 'Ip Office Reference' ;
    rdfs:comment 'Reference number assigned by the relevant patent or trademark office (e.g., USPTO, EUIPO, WIPO) when the POA is filed as part of an IP prosecution matter. Populated only for ip_prosecution type POAs.' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDurable rdf:type rdf:Property ;
    rdfs:label 'Is Durable' ;
    rdfs:comment 'Indicates whether this POA is durable, meaning it remains effective even if the grantor becomes incapacitated. True for durable POAs; False for standard POAs that terminate upon incapacity.' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSpringing rdf:type rdf:Property ;
    rdfs:label 'Is Springing' ;
    rdfs:comment 'Indicates whether this POA is a springing POA that only becomes effective upon the occurrence of a specified triggering event (e.g., incapacity of the grantor, completion of a condition precedent).' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:monetaryLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Monetary Limit Amount' ;
    rdfs:comment 'Maximum monetary value up to which the grantee is authorized to act on behalf of the grantor entity under this POA. Null if no monetary cap applies or if the POA is non-financial in nature.' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:monetaryLimitCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Monetary Limit Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the monetary authority limit (e.g., USD, EUR, GBP). Populated only when monetary_limit_amount is set.' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notarizationStatus rdf:type rdf:Property ;
    rdfs:label 'Notarization Status' ;
    rdfs:comment 'Current notarization status of the POA instrument: not_required (jurisdiction does not require it), pending (awaiting notarization), completed (notarized), or waived (formally waived with documented justification).' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notaryName rdf:type rdf:Property ;
    rdfs:label 'Notary Name' ;
    rdfs:comment 'Full name of the notary public who notarized the POA instrument. Populated only when notarization_status is \'completed\'.' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poaType rdf:type rdf:Property ;
    rdfs:label 'Poa Type' ;
    rdfs:comment 'Classification of the POA instrument: general (broad authority), limited (specific transaction or scope), ip_prosecution (filed with patent/trademark offices for IP prosecution authority), banking_authorization (authorized signatory for banking transactions), or durable (remains effective upon incapacity). [ENUM-REF-CANDIDATE: general|limited|ip_prosecution|banking_authorization|durable|springing — promote to reference product if additional types emerge]' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerOfAttorneyStatus rdf:type rdf:Property ;
    rdfs:label 'Power Of Attorney Status' ;
    rdfs:comment 'Current lifecycle status of the POA instrument: draft (being prepared), pending_execution (awaiting signatures), active (fully executed and in force), suspended (temporarily inactive), revoked (formally cancelled before expiration), or expired (past effective end date).' ;
    rdfs:domain ind:PowerOfAttorney ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:associatedEventReference rdf:type rdf:Property ;
    rdfs:label 'Associated Event Reference' ;
    rdfs:comment 'Internal reference identifier for a specific event or series of events to which this license applies (e.g., a one-time event permit for a concert or championship game). Null for standing operational licenses.' ;
    rdfs:domain ind:RegulatoryLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoRenewalEligible rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Eligible' ;
    rdfs:comment 'Boolean flag indicating whether this license type is eligible for automatic renewal by the issuing authority upon timely application submission, without requiring a full re-application process.' ;
    rdfs:domain ind:RegulatoryLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastFrequencyBand rdf:type rdf:Property ;
    rdfs:label 'Broadcast Frequency Band' ;
    rdfs:comment 'Frequency band or transmission medium authorized under an FCC broadcast license. Applicable to broadcast licenses only; null for non-broadcast license types. Supports FCC compliance and media rights distribution management. [ENUM-REF-CANDIDATE: AM|FM|UHF|VHF|satellite|cable|IPTV|OTT — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RegulatoryLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastLicenseCallSign rdf:type rdf:Property ;
    rdfs:label 'Broadcast License Call Sign' ;
    rdfs:comment 'FCC-assigned call sign for broadcast licenses (e.g., WABC, KCAL). Applicable only to FCC broadcast licenses; null for all other license types. Supports RSN and OTT broadcast rights compliance tracking.' ;
    rdfs:domain ind:RegulatoryLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceOfficerEmail rdf:type rdf:Property ;
    rdfs:label 'Compliance Officer Email' ;
    rdfs:comment 'Corporate email address of the compliance officer responsible for this license. Used for automated renewal alerts and regulatory correspondence routing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceOfficerName rdf:type rdf:Property ;
    rdfs:label 'Compliance Officer Name' ;
    rdfs:comment 'Full name of the internal compliance officer or legal counsel responsible for managing this license, ensuring timely renewal, and maintaining regulatory relationship with the issuing authority.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feePaymentDate rdf:type rdf:Property ;
    rdfs:label 'Fee Payment Date' ;
    rdfs:comment 'Date on which the license fee was paid to the issuing authority. Used for financial reconciliation in SAP S/4HANA and audit trail purposes.' ;
    rdfs:domain ind:RegulatoryLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isRevoked rdf:type rdf:Property ;
    rdfs:label 'Is Revoked' ;
    rdfs:comment 'Boolean flag indicating whether the license has been permanently revoked by the issuing regulatory authority. True when revocation is confirmed; False otherwise.' ;
    rdfs:domain ind:RegulatoryLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuingAuthorityType rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority Type' ;
    rdfs:comment 'Classification of the regulatory authority level that issued the license, distinguishing federal, state/provincial, municipal, international governing body, or industry regulator.' ;
    rdfs:domain ind:RegulatoryLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionDescription rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Description' ;
    rdfs:comment 'Human-readable description of the jurisdiction, including state, province, county, or municipality name where the license is operative (e.g., \'State of Nevada\', \'City of Los Angeles\', \'England and Wales\').' ;
    rdfs:domain ind:RegulatoryLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseConditions rdf:type rdf:Property ;
    rdfs:label 'License Conditions' ;
    rdfs:comment 'Free-text description of any special conditions, restrictions, or obligations attached to the license by the issuing authority (e.g., capacity limits, operating hour restrictions, geographic service area limitations, mandatory reporting requirements).' ;
    rdfs:domain ind:RegulatoryLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseTermYears rdf:type rdf:Property ;
    rdfs:label 'License Term Years' ;
    rdfs:comment 'Duration of the license grant period expressed in whole years as specified by the issuing authority (e.g., FCC broadcast licenses are typically granted for 8-year terms). Supports renewal planning and portfolio lifecycle management.' ;
    rdfs:domain ind:RegulatoryLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalApplicationDeadline rdf:type rdf:Property ;
    rdfs:label 'Renewal Application Deadline' ;
    rdfs:comment 'The last date by which a renewal application must be submitted to the issuing authority to avoid lapse of the license. Typically precedes the expiration date by a regulatory-mandated lead time.' ;
    rdfs:domain ind:RegulatoryLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:wageringLicenseCategory rdf:type rdf:Property ;
    rdfs:label 'Wagering License Category' ;
    rdfs:comment 'Sub-classification of sports wagering licenses by operational model. Applicable only to gaming and wagering license types; null for all other license types. Supports compliance with state gaming control board requirements.' ;
    rdfs:domain ind:RegulatoryLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimantFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Claimant Fan Profile Id' ;
    rdfs:comment 'Foreign key linking to fan.fan_profile. Business justification: Individual fan-related settlements (ticket fraud, data breach, personal injury) name specific fan claimants. Legal teams need to link settlement agreements to the fan profile for payment processing, c' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:inhouseCounselEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Inhouse Counsel Employee Id' ;
    rdfs:comment 'Reference to the internal attorney responsible for managing and approving the settlement agreement. Links to the attorney/workforce record in SAP SuccessFactors.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:agreementReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Agreement Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned to the settlement agreement by the legal department or outside counsel, used for cross-referencing with court filings, SAP FI documents, and outside counsel matter management systems.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceMonitoringEndDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Monitoring End Date' ;
    rdfs:comment 'Date on which the compliance monitoring obligations under the settlement expire. Null if compliance_monitoring_required = False or if monitoring is perpetual.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceMonitoringRequired rdf:type rdf:Property ;
    rdfs:label 'Compliance Monitoring Required' ;
    rdfs:comment 'Indicates whether the settlement requires ongoing compliance monitoring (e.g., periodic reporting to a regulator, independent monitor, or court). Triggers creation of compliance monitoring tasks in the legal workflow system.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:courtOrTribunalName rdf:type rdf:Property ;
    rdfs:label 'Court Or Tribunal Name' ;
    rdfs:comment 'Name of the court, arbitration tribunal, or regulatory body before which the underlying matter was pending at the time of settlement (e.g., \'U.S. District Court SDNY\', \'Court of Arbitration for Sport\', \'NLRB\'). Null if settled pre-litigation.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentRepositoryUrl rdf:type rdf:Property ;
    rdfs:label 'Document Repository Url' ;
    rdfs:comment 'URL or path to the executed settlement agreement document stored in the organization\'s document management or DAM (Digital Asset Management) system. Enables direct access to the source legal instrument.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Final Payment Date' ;
    rdfs:comment 'Date by which all monetary obligations under the settlement must be fully discharged. Null for lump-sum payments where payment_due_date equals the final date.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:injunctionScopeDescription rdf:type rdf:Property ;
    rdfs:label 'Injunction Scope Description' ;
    rdfs:comment 'Narrative description of the scope and duration of any injunctive relief included in the settlement (e.g., geographic restrictions, IP use prohibitions, broadcast blackout requirements). Populated only when injunction_granted = True.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Insurance Recovery Amount' ;
    rdfs:comment 'Portion of the settlement amount expected to be recovered from the organization\'s insurance carrier(s). Net exposure = settlement_amount minus insurance_recovery_amount. Used for SAP FI reserve management and EBITDA impact reporting.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isMaterialSettlement rdf:type rdf:Property ;
    rdfs:label 'Is Material Settlement' ;
    rdfs:comment 'Indicates whether this settlement meets the materiality threshold requiring disclosure in SEC financial filings or board-level reporting. True = material; triggers SOX disclosure controls and SEC reporting workflow.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNonDisparagement rdf:type rdf:Property ;
    rdfs:label 'Is Non Disparagement' ;
    rdfs:comment 'Indicates whether the settlement agreement includes a non-disparagement clause prohibiting either party from making negative public statements about the other. Relevant for athlete, employee, and sponsor settlements.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nonMonetaryTermsSummary rdf:type rdf:Property ;
    rdfs:label 'Non Monetary Terms Summary' ;
    rdfs:comment 'Summary of non-monetary obligations included in the settlement, such as behavioral commitments, policy changes, reinstatement of employment, IP licensing grants, or broadcast rights modifications. Complements injunction_scope_description for mixed settlements.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Date' ;
    rdfs:comment 'Date on which the parties reached agreement in principle on settlement terms, which may precede formal execution. Used for financial accrual and reserve release timing in SAP FI/CO.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementType rdf:type rdf:Property ;
    rdfs:label 'Settlement Type' ;
    rdfs:comment 'Classification of the settlement instrument. \'monetary\' = cash payment only; \'injunctive\' = court-ordered behavioral relief; \'consent_decree\' = regulatory enforcement resolution; \'confidential\' = terms sealed by agreement; \'mixed\' = combination of monetary and non-monetary relief.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlingPartyName rdf:type rdf:Property ;
    rdfs:label 'Settling Party Name' ;
    rdfs:comment 'Legal name of the primary counterparty (claimant, plaintiff, or regulatory body) entering into the settlement with Sports Entertainment. Captured as a denormalized string to preserve the exact legal name at time of execution.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlingPartyType rdf:type rdf:Property ;
    rdfs:label 'Settling Party Type' ;
    rdfs:comment 'Classification of the counterparty entering the settlement. Drives compliance reporting and determines applicable regulatory frameworks (e.g., GDPR for individuals, FCC for regulatory bodies, FIFA/NFL governance for sports governing bodies).' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sportsEntertainmentEntityName rdf:type rdf:Property ;
    rdfs:label 'Sports Entertainment Entity Name' ;
    rdfs:comment 'The specific legal entity within the Sports Entertainment corporate group that is party to this settlement (e.g., a specific league subsidiary, broadcasting entity, or venue operating company). Supports multi-entity corporate structures.' ;
    rdfs:domain ind:SettlementAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationBasis rdf:type rdf:Property ;
    rdfs:label 'Application Basis' ;
    rdfs:comment 'The legal basis under which the trademark application was filed. Use in Commerce (Section 1(a)) requires current use; Intent to Use (Section 1(b)) is for marks not yet in use; Foreign Registration (Section 44(e)) is based on a home country registration; Madrid Protocol (Section 66(a)) is for international designations.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:associatedBrandCategory rdf:type rdf:Property ;
    rdfs:label 'Associated Brand Category' ;
    rdfs:comment 'Business category of the Sports Entertainment brand asset associated with this trademark registration. Classifies the mark by its commercial function within the enterprise\'s brand architecture (e.g., league brand, team brand, event brand, venue brand, broadcast brand). [ENUM-REF-CANDIDATE: league|team|athlete|event|venue|broadcast|merchandise|digital — promote to reference product]' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationProceedingReference rdf:type rdf:Property ;
    rdfs:label 'Cancellation Proceeding Reference' ;
    rdfs:comment 'The official case number for any cancellation or invalidation proceeding filed against this trademark registration before the relevant IP office\'s trial board. Null if no cancellation proceeding is pending or has been filed.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:colorClaim rdf:type rdf:Property ;
    rdfs:label 'Color Claim' ;
    rdfs:comment 'Description of specific colors claimed as a feature of the trademark, if applicable. Identifies the color(s) that form part of the mark and the elements to which those colors apply. Null for marks filed in black and white without color claims.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclaimerText rdf:type rdf:Property ;
    rdfs:label 'Disclaimer Text' ;
    rdfs:comment 'Statement disclaiming exclusive rights to specific non-distinctive elements within the trademark (e.g., generic or descriptive words, geographic terms). Required by IP offices when a mark contains elements that cannot be exclusively owned. Affects enforcement scope.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmLicensingFlag rdf:type rdf:Property ;
    rdfs:label 'Drm Licensing Flag' ;
    rdfs:comment 'Indicates whether this trademark is subject to active Digital Rights Management (DRM) licensing arrangements, including digital broadcast, streaming, or online platform licensing agreements. Relevant for Sports Entertainment\'s OTT and digital content distribution operations.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:filingJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Filing Jurisdiction' ;
    rdfs:comment 'The intellectual property office or treaty system under which this trademark application was filed (e.g., USPTO for United States, EUIPO for European Union, WIPO for Madrid Protocol international designations, CIPO for Canada, IPO for United Kingdom). Uses standard office abbreviation codes.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goodsServicesDescription rdf:type rdf:Property ;
    rdfs:label 'Goods Services Description' ;
    rdfs:comment 'The formal identification of goods and/or services covered by the trademark registration as specified in the application. This description defines the scope of trademark protection and must align with the Nice Classification codes. Critical for enforcement and licensing scope determination.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'International Registration Number' ;
    rdfs:comment 'The international registration number assigned by the World Intellectual Property Organization (WIPO) International Bureau for marks filed under the Madrid Protocol or Madrid Agreement. Applicable only to international trademark filings; null for national-only registrations.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isIncontestable rdf:type rdf:Property ;
    rdfs:label 'Is Incontestable' ;
    rdfs:comment 'Indicates whether the trademark has achieved incontestable status under Section 15 of the Lanham Act (USPTO) by filing a Declaration of Incontestability after five consecutive years of continuous use in commerce following registration. Incontestable marks have stronger legal protection against certain challenges.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licensedToThirdParty rdf:type rdf:Property ;
    rdfs:label 'Licensed To Third Party' ;
    rdfs:comment 'Indicates whether this trademark has been licensed to one or more third parties (e.g., merchandise licensees, broadcast partners, sponsors) under a trademark license agreement. Triggers additional monitoring and quality control obligations for the licensor.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:madridDesignationCountries rdf:type rdf:Property ;
    rdfs:label 'Madrid Designation Countries' ;
    rdfs:comment 'Comma-separated list of ISO 3166-1 alpha-3 country codes for countries designated under a WIPO Madrid Protocol international registration. Applicable only to international filings; null for national-only registrations. Defines the geographic scope of international protection sought.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:markDescription rdf:type rdf:Property ;
    rdfs:label 'Mark Description' ;
    rdfs:comment 'Formal written description of the trademark mark as submitted to the IP office, particularly required for figurative, combined, 3D, sound, and color marks. Describes the visual or non-visual elements of the mark for examination and publication purposes.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:markName rdf:type rdf:Property ;
    rdfs:label 'Mark Name' ;
    rdfs:comment 'The textual name or verbal element of the trademark as filed with the relevant intellectual property office (e.g., USPTO, EUIPO, WIPO). For figurative-only marks, this field captures the descriptive title used internally.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:niceClassCodes rdf:type rdf:Property ;
    rdfs:label 'Nice Class Codes' ;
    rdfs:comment 'Comma-separated list of Nice Classification class numbers (1–45) under which the trademark is filed, identifying the goods and services covered by the mark. Sports Entertainment marks typically span classes 25 (clothing), 28 (sporting goods), 41 (entertainment services), and 38 (broadcasting). Multiple classes indicate broader protection scope.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officialFilingFeeUsd rdf:type rdf:Property ;
    rdfs:label 'Official Filing Fee Usd' ;
    rdfs:comment 'The official government filing fee paid to the intellectual property office at the time of application or renewal, expressed in US dollars. Used for IP portfolio cost tracking, budget planning, and financial reporting of trademark maintenance expenditures.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oppositionCaseReference rdf:type rdf:Property ;
    rdfs:label 'Opposition Case Reference' ;
    rdfs:comment 'The official case or proceeding number assigned by the IP office\'s trial board (e.g., USPTO TTAB) for any opposition proceeding filed against this trademark application. Null if no opposition has been filed.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oppositionPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Opposition Period End Date' ;
    rdfs:comment 'The date on which the statutory opposition period closes following publication of the trademark application. After this date, absent a filed opposition, the mark proceeds to registration. Critical for prosecution timeline management and docketing.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ownerCountryCode rdf:type rdf:Property ;
    rdfs:label 'Owner Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the trademark owner\'s domicile or principal place of business as recorded with the IP office. Required for international filings and determines eligibility under certain treaty provisions.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerEntityName rdf:type rdf:Property ;
    rdfs:label 'Owner Entity Name' ;
    rdfs:comment 'The legal name of the entity recorded as the owner of the trademark registration with the IP office. May be a parent company, subsidiary, or operating entity of Sports Entertainment. Critical for enforcement standing and licensing authority.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerEntityType rdf:type rdf:Property ;
    rdfs:label 'Owner Entity Type' ;
    rdfs:comment 'Legal classification of the trademark owner entity as recorded with the IP office. Determines the legal capacity to own and enforce trademark rights and affects filing requirements.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityDate rdf:type rdf:Property ;
    rdfs:label 'Priority Date' ;
    rdfs:comment 'The priority date claimed under the Paris Convention, if applicable, based on an earlier foreign filing. This date may precede the actual filing date and establishes the effective priority for rights determination in multi-jurisdiction prosecution strategies.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:prosecutionNotes rdf:type rdf:Property ;
    rdfs:label 'Prosecution Notes' ;
    rdfs:comment 'Free-text field capturing significant prosecution history notes, office action summaries, examiner correspondence highlights, or strategic decisions made during the prosecution lifecycle. Provides context for trademark counsel and IP portfolio managers reviewing the registration history.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prosecutionStatus rdf:type rdf:Property ;
    rdfs:label 'Prosecution Status' ;
    rdfs:comment 'Current lifecycle state of the trademark application or registration through the prosecution process. Tracks progression from initial filing through examination, publication, registration, and post-registration maintenance. [ENUM-REF-CANDIDATE: pending|published|registered|abandoned|cancelled|expired — promote to reference product]' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:section15Filed rdf:type rdf:Property ;
    rdfs:label 'Section 15 Filed' ;
    rdfs:comment 'Indicates whether a Section 15 Declaration of Incontestability has been filed with the USPTO, which may be combined with the Section 8 filing. Applicable to USPTO registrations only. Filing this declaration strengthens the mark\'s legal standing.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:section8Filed rdf:type rdf:Property ;
    rdfs:label 'Section 8 Filed' ;
    rdfs:comment 'Indicates whether a Section 8 Declaration of Continued Use (or Excusable Non-Use) has been filed with the USPTO between the 5th and 6th year anniversary of registration, as required to maintain the registration. Applicable to USPTO registrations only.' ;
    rdfs:domain ind:TrademarkRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceCheckId rdf:type rdf:Property ;
    rdfs:label 'Compliance Check Id' ;
    rdfs:comment 'Primary key for compliance_check' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:confiscationRecordId rdf:type rdf:Property ;
    rdfs:label 'Confiscation Record Id' ;
    rdfs:comment 'Foreign key linking to security.confiscation_record. Business justification: When security confiscates suspected counterfeit merchandise at a screening checkpoint, a compliance check is initiated against the licensing agreement. Linking compliance_check to the triggering confi' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConfiscationRecord .

ind:goodsReceiptId rdf:type rdf:Property ;
    rdfs:label 'Goods Receipt Id' ;
    rdfs:comment 'Foreign key linking to merchandise.merchandise_goods_receipt. Business justification: Compliance checks are performed on merchandise goods receipts to verify brand compliance, authenticity, and quality before accepting inventory. The merchandise_goods_receipt table has \'inspection_stat' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MerchandiseGoodsReceipt .

ind:inspectorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Inspector Employee Id' ;
    rdfs:comment 'Reference to the internal employee or authorized third-party inspector who conducted the compliance check.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:memorabiliaItemId rdf:type rdf:Property ;
    rdfs:label 'Memorabilia Item Id' ;
    rdfs:comment 'Foreign key linking to merchandise.memorabilia_item. Business justification: Compliance checks verify authenticity and brand compliance of memorabilia items. The memorabilia_item table has \'authentication_cert_number\', \'is_authenticated\', \'brand_compliance_status\', and \'ip_pro' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemorabiliaItem .

ind:productCategoryId rdf:type rdf:Property ;
    rdfs:label 'Product Category Id' ;
    rdfs:comment 'Foreign key linking to merchandise.product_category. Business justification: Compliance checks are performed at the product category level (e.g., all jerseys must meet specific logo/stitching standards). Currently tracked as STRING attribute \'product_category\'. Normalizing to ' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProductCategory .

ind:skuCatalogId rdf:type rdf:Property ;
    rdfs:label 'Sku Sku Catalog Id' ;
    rdfs:comment 'Reference to the specific SKU (Stock Keeping Unit) inspected during this compliance check. Links to the merchandise product catalog.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SkuCatalog .

ind:supplierId rdf:type rdf:Property ;
    rdfs:label 'Supplier Id' ;
    rdfs:comment 'Foreign key linking to merchandise.supplier. Business justification: compliance_check stores licensee_name (STRING) and licensee_country_code (STRING) as denormalized text. The supplier table is the authoritative master for licensed producers with legal_name, country_c' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Supplier .

ind:vendorCertificationId rdf:type rdf:Property ;
    rdfs:label 'Vendor Certification Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor_certification. Business justification: Brand compliance inspections in sports merchandise must verify that suppliers hold valid certifications (ISO, ethical sourcing, licensed producer). Linking compliance_check to vendor_certification ena' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VendorCertification .

ind:wholesaleAccountId rdf:type rdf:Property ;
    rdfs:label 'Wholesale Account Id' ;
    rdfs:comment 'Foreign key linking to merchandise.wholesale_account. Business justification: Compliance checks are performed on wholesale accounts to verify brand compliance certification and adherence to licensing standards. The wholesale_account table has \'brand_compliance_certified\' and \'b' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WholesaleAccount .

ind:checkReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Check Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned to this compliance inspection, used in correspondence with licensees, league brand offices, and audit trails. Format: BCC-YYYY-NNNNNN.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checklistVersion rdf:type rdf:Property ;
    rdfs:label 'Checklist Version' ;
    rdfs:comment 'The version identifier of the internal brand compliance checklist template used for this inspection. Supports audit traceability and ensures consistent application of criteria across inspections.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:colorSpecificationResult rdf:type rdf:Property ;
    rdfs:label 'Color Specification Result' ;
    rdfs:comment 'Pass/fail result for the color specification checklist criterion, verifying that Pantone, CMYK, and RGB color values match the official team and league color standards.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionDescription rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Description' ;
    rdfs:comment 'Detailed description of the specific corrective actions required by the licensee to remediate identified brand compliance violations, including steps, standards to be met, and any required re-submission of samples.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionRequired rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Required' ;
    rdfs:comment 'Indicates whether this compliance check has resulted in a mandatory corrective action requirement for the licensee. True when one or more checklist criteria have failed and remediation is required.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:counterfeitRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Counterfeit Risk Flag' ;
    rdfs:comment 'Indicates whether the inspected merchandise has been flagged as a potential counterfeit or unauthorized reproduction of licensed product, triggering escalation to the IP (Intellectual Property) protection and legal teams.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Date' ;
    rdfs:comment 'The calendar date on which the physical or digital brand compliance inspection was conducted for the specified SKU.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inspectionMethod rdf:type rdf:Property ;
    rdfs:label 'Inspection Method' ;
    rdfs:comment 'Indicates whether the compliance inspection was conducted via physical examination of the merchandise sample, digital review of design files and specifications, or a hybrid of both methods.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Inspection Timestamp' ;
    rdfs:comment 'Precise date and time when the compliance inspection was initiated, capturing the exact business event time for audit and SLA (Service Level Agreement) tracking purposes.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:inspectionType rdf:type rdf:Property ;
    rdfs:label 'Inspection Type' ;
    rdfs:comment 'Classification of the compliance check by its trigger or purpose: initial pre-production review, periodic scheduled audit, triggered inspection due to complaint or violation flag, pre-launch approval, post-market surveillance, or formal audit. [ENUM-REF-CANDIDATE: initial|periodic|triggered|pre_launch|post_market|audit — promote to reference product if additional types are required]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorNotes rdf:type rdf:Property ;
    rdfs:label 'Inspector Notes' ;
    rdfs:comment 'Free-text field for the inspector to record additional observations, contextual information, or qualitative findings not captured by the structured checklist criteria.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipProtectionResult rdf:type rdf:Property ;
    rdfs:label 'Ip Protection Result' ;
    rdfs:comment 'Pass/fail result for the IP (Intellectual Property) protection checklist criterion, verifying that trademarks, copyrights, and holographic authentication features are present and correctly applied to prevent counterfeiting.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:labelingResult rdf:type rdf:Property ;
    rdfs:label 'Labeling Result' ;
    rdfs:comment 'Pass/fail result for the labeling checklist criterion, verifying that hang tags, care labels, country-of-origin labels, and official licensed product holograms or authentication marks are correctly applied.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leagueBrandStandardVersion rdf:type rdf:Property ;
    rdfs:label 'League Brand Standard Version' ;
    rdfs:comment 'The version identifier of the official league or team brand standards document against which this compliance check was conducted. Ensures auditability as brand standards evolve over time.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:logoUsageResult rdf:type rdf:Property ;
    rdfs:label 'Logo Usage Result' ;
    rdfs:comment 'Pass/fail result for the logo usage checklist criterion, verifying that team and league logos are applied in accordance with official brand guidelines including placement, sizing, and orientation.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialQualityResult rdf:type rdf:Property ;
    rdfs:label 'Material Quality Result' ;
    rdfs:comment 'Pass/fail result for the material quality checklist criterion, verifying that fabric composition, weight, durability, and finish meet the minimum quality standards specified in the licensing agreement.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packagingResult rdf:type rdf:Property ;
    rdfs:label 'Packaging Result' ;
    rdfs:comment 'Pass/fail result for the packaging checklist criterion, verifying that retail packaging design, materials, and branding elements conform to league and team packaging standards.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinspectionDate rdf:type rdf:Property ;
    rdfs:label 'Reinspection Date' ;
    rdfs:comment 'The scheduled or actual date of the follow-up re-inspection conducted after the licensee has completed corrective actions.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinspectionRequired rdf:type rdf:Property ;
    rdfs:label 'Reinspection Required' ;
    rdfs:comment 'Indicates whether a follow-up re-inspection of the SKU is required after corrective actions have been completed by the licensee.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resolutionDeadline rdf:type rdf:Property ;
    rdfs:label 'Resolution Deadline' ;
    rdfs:comment 'The date by which the licensee must complete all corrective actions and submit evidence of remediation to the brand compliance team. Drives SLA (Service Level Agreement) monitoring and escalation workflows.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sampleBatchNumber rdf:type rdf:Property ;
    rdfs:label 'Sample Batch Number' ;
    rdfs:comment 'The production batch or lot number of the merchandise sample submitted for compliance inspection. Enables traceability back to the manufacturing run for recall or remediation purposes.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleQuantityInspected rdf:type rdf:Property ;
    rdfs:label 'Sample Quantity Inspected' ;
    rdfs:comment 'The number of individual merchandise units sampled and inspected during this compliance check. Supports statistical quality control and audit documentation.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stitchingEmbroideryResult rdf:type rdf:Property ;
    rdfs:label 'Stitching Embroidery Result' ;
    rdfs:comment 'Pass/fail result for the stitching and embroidery checklist criterion, verifying stitch count, thread color accuracy, and embroidery placement meet official specifications for apparel and soft goods.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationCount rdf:type rdf:Property ;
    rdfs:label 'Violation Count' ;
    rdfs:comment 'Total number of distinct brand compliance violations identified across all checklist criteria during this inspection. Used to prioritize corrective action and assess licensee compliance performance.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:violationSeverity rdf:type rdf:Property ;
    rdfs:label 'Violation Severity' ;
    rdfs:comment 'Severity classification of the most serious violation identified in this inspection. Critical violations may trigger immediate product recall or license suspension; major violations require corrective action before sale; minor violations require remediation within a defined period.' ;
    rdfs:domain ind:ComplianceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfillmentShipmentId rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Shipment Id' ;
    rdfs:comment 'Unique surrogate identifier for each outbound fulfillment shipment record in the merchandise domain. Primary key for the fulfillment_shipment data product.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FulfillmentShipment .

ind:carrierVendorId rdf:type rdf:Property ;
    rdfs:label 'Carrier Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: Carriers (UPS, FedEx, DHL) used for merchandise fulfillment are registered vendors with contracted SLAs and performance scorecards. Linking fulfillment_shipment to carrier vendor enables SLA breach tr' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:fulfillingEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Fulfilling Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Warehouse fulfillment operations require tracking which employee packed and dispatched each shipment for labor accountability, error rate reporting, and pick/pack performance management. No employee F' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:carrierServiceLevel rdf:type rdf:Property ;
    rdfs:label 'Carrier Service Level' ;
    rdfs:comment 'Specific service tier selected for this shipment (e.g., Ground, 2-Day, Overnight, International Priority). Determines transit time commitment and cost. Used for SLA compliance analysis.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customsDeclarationNumber rdf:type rdf:Property ;
    rdfs:label 'Customs Declaration Number' ;
    rdfs:comment 'Official customs declaration or harmonized tariff reference number assigned for international shipments. Required for cross-border compliance and import/export regulatory reporting.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declaredCustomsValue rdf:type rdf:Property ;
    rdfs:label 'Declared Customs Value' ;
    rdfs:comment 'The declared monetary value of the shipment contents for customs purposes on international orders. Used to determine applicable duties, taxes, and import thresholds.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveredTimestamp rdf:type rdf:Property ;
    rdfs:label 'Delivered Timestamp' ;
    rdfs:comment 'The precise date and time of confirmed delivery at the fan destination as reported by the carrier scan event. Provides granular delivery performance data beyond the date-level actual_delivery_date.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:estimatedDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Estimated Delivery Date' ;
    rdfs:comment 'The carrier-committed or system-calculated date by which the parcel is expected to arrive at the fan destination. Used for SLA compliance monitoring and fan communication.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fulfillmentChannel rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Channel' ;
    rdfs:comment 'The sales and fulfillment channel through which this shipment originated. Distinguishes DTC (Direct-To-Consumer) e-commerce orders from venue store POS transactions, third-party retail, or wholesale distribution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfillmentType rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Type' ;
    rdfs:comment 'Indicates the operational model used to fulfill this shipment: warehouse pick-and-pack, venue store dispatch, drop-ship from supplier, or third-party logistics (3PL) provider.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPartialFulfillment rdf:type rdf:Property ;
    rdfs:label 'Is Partial Fulfillment' ;
    rdfs:comment 'Indicates whether this shipment represents a partial fulfillment of the associated order (True) or a complete fulfillment (False). Relevant when orders contain multiple SKUs fulfilled in separate shipments.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:labelCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Label Created Timestamp' ;
    rdfs:comment 'The precise date and time when the shipping label was generated in the fulfillment system. Marks the start of the shipment lifecycle and is used for warehouse throughput analysis.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lengthCm rdf:type rdf:Property ;
    rdfs:label 'Length Cm' ;
    rdfs:comment 'Length dimension of the shipment package in centimetres. Combined with width and height for dimensional weight (DIM weight) calculation used in carrier billing.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:packageCount rdf:type rdf:Property ;
    rdfs:label 'Package Count' ;
    rdfs:comment 'Number of individual packages or parcels included in this shipment. Supports multi-box shipment tracking and carrier billing reconciliation.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recipientEmail rdf:type rdf:Property ;
    rdfs:label 'Recipient Email' ;
    rdfs:comment 'Email address of the shipment recipient used for carrier tracking notifications and delivery confirmation communications. Classified as PII per GDPR and CCPA.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientName rdf:type rdf:Property ;
    rdfs:label 'Recipient Name' ;
    rdfs:comment 'Full name of the individual designated to receive the shipment as captured at order time. Required for carrier label generation and delivery confirmation. Classified as PII per GDPR and CCPA.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientPhone rdf:type rdf:Property ;
    rdfs:label 'Recipient Phone' ;
    rdfs:comment 'Phone number of the shipment recipient used for carrier delivery notifications and failed delivery contact. Classified as PII per GDPR and CCPA.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresSignature rdf:type rdf:Property ;
    rdfs:label 'Requires Signature' ;
    rdfs:comment 'Indicates whether a recipient signature is required upon delivery (True). Typically applied to high-value merchandise, limited-edition memorabilia, or VIP fan orders.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnTrackingNumber rdf:type rdf:Property ;
    rdfs:label 'Return Tracking Number' ;
    rdfs:comment 'Carrier tracking number assigned for the return shipment if the fan initiates a return or the delivery fails. Supports reverse logistics tracking and merchandise returns processing.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shipDate rdf:type rdf:Property ;
    rdfs:label 'Ship Date' ;
    rdfs:comment 'The calendar date on which the shipment was physically handed off to the carrier. Used as the baseline for SLA delivery window calculations and carrier performance reporting.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:shipmentNumber rdf:type rdf:Property ;
    rdfs:label 'Shipment Number' ;
    rdfs:comment 'Externally visible business identifier for this shipment, used in customer-facing communications, packing slips, and carrier handoff documentation. Distinct from the internal surrogate key.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shipmentStatus rdf:type rdf:Property ;
    rdfs:label 'Shipment Status' ;
    rdfs:comment 'Current lifecycle state of the shipment as reported by the carrier or fulfillment system. Drives fan-facing delivery notifications and DTC SLA tracking. [ENUM-REF-CANDIDATE: pending|label_created|in_transit|out_for_delivery|delivered|failed|returned|cancelled — promote to reference product]' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shippedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Shipped Timestamp' ;
    rdfs:comment 'The precise date and time when the shipment was confirmed as dispatched and handed to the carrier. Used for SLA measurement and fulfillment lead time analytics.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:shippingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Shipping Address Line1' ;
    rdfs:comment 'Primary street address line of the fan delivery destination. Required for carrier label generation. Classified as PII per GDPR and CCPA.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shippingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Shipping Address Line2' ;
    rdfs:comment 'Secondary address line (apartment, suite, unit number) for the fan delivery destination. Classified as PII per GDPR and CCPA.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shippingCity rdf:type rdf:Property ;
    rdfs:label 'Shipping City' ;
    rdfs:comment 'City of the fan delivery destination. Used for geographic delivery analytics and carrier zone determination. Classified as PII per GDPR and CCPA.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shippingCost rdf:type rdf:Property ;
    rdfs:label 'Shipping Cost' ;
    rdfs:comment 'Actual cost charged by the carrier for transporting this shipment, in the operating currency. Used for fulfillment cost analysis, margin reporting, and carrier contract performance evaluation.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shippingCostChargedToFan rdf:type rdf:Property ;
    rdfs:label 'Shipping Cost Charged To Fan' ;
    rdfs:comment 'The shipping fee amount collected from the fan at checkout. May differ from the actual carrier cost due to flat-rate shipping promotions, free shipping thresholds, or subsidized DTC shipping programs.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shippingCostCurrency rdf:type rdf:Property ;
    rdfs:label 'Shipping Cost Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the shipping cost amount (e.g., USD, GBP, EUR). Required for multi-currency international fulfillment operations.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shippingCountryCode rdf:type rdf:Property ;
    rdfs:label 'Shipping Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 three-letter country code of the fan delivery destination (e.g., USA, GBR, CAN). Used for international shipping compliance, customs documentation, and cross-border analytics.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shippingPostalCode rdf:type rdf:Property ;
    rdfs:label 'Shipping Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the fan delivery destination. Used for carrier zone assignment, delivery time estimation, and geographic analytics. Classified as PII per GDPR and CCPA.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shippingStateProvince rdf:type rdf:Property ;
    rdfs:label 'Shipping State Province' ;
    rdfs:comment 'State or province of the fan delivery destination. Used for carrier zone pricing, tax jurisdiction determination, and regional fulfillment analytics.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shopifyFulfillmentCode rdf:type rdf:Property ;
    rdfs:label 'Shopify Fulfillment Code' ;
    rdfs:comment 'External fulfillment identifier assigned by Shopify Plus at the time the fulfillment record is created. Used to reconcile shipment records with the Shopify Plus e-commerce platform and DTC fulfillment workflows.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trackingNumber rdf:type rdf:Property ;
    rdfs:label 'Tracking Number' ;
    rdfs:comment 'Carrier-assigned tracking number provided at the time of shipment handoff. Used by fans and operations teams to monitor parcel transit status via the carrier portal. Supports DTC SLA tracking.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:widthCm rdf:type rdf:Property ;
    rdfs:label 'Width Cm' ;
    rdfs:comment 'Width dimension of the shipment package in centimetres. Used in dimensional weight calculation for carrier billing and packaging optimization.' ;
    rdfs:domain ind:FulfillmentShipment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inventoryPositionId rdf:type rdf:Property ;
    rdfs:label 'Inventory Position Id' ;
    rdfs:comment 'Unique surrogate identifier for each inventory position record representing a SKU-location snapshot in the merchandise domain.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:countEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Count Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Physical inventory counts require tracking which employee performed the count for audit accountability, variance investigation, and shrinkage reporting. `last_physical_count_date` and `count_variance_' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryInventoryRetailLocationId rdf:type rdf:Property ;
    rdfs:label 'Primary Inventory Retail Location Id' ;
    rdfs:comment 'Reference to the storage location (venue store, warehouse fulfillment center, or third-party retail consignment site) where this inventory position is held.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RetailLocation .

ind:tertiaryInventoryTransferDestinationLocationRetailLocationId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Inventory Transfer Destination Location Retail Location Id' ;
    rdfs:comment 'Reference to the destination storage location for the most recent or active stock transfer affecting this inventory position. Used for event-day venue stocking and warehouse rebalancing.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RetailLocation .

ind:availableToSellQty rdf:type rdf:Property ;
    rdfs:label 'Available To Sell Qty' ;
    rdfs:comment 'Net units of the SKU at this location that can be sold or allocated to new orders. Calculated as on_hand_qty minus reserved_qty minus blocked_qty. Drives omnichannel availability display and reorder triggers.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blockedQty rdf:type rdf:Property ;
    rdfs:label 'Blocked Qty' ;
    rdfs:comment 'Units of the SKU held at this location that are blocked from sale due to quality inspection, compliance hold, damage assessment, or licensing dispute. Tracked separately from reserved stock.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brandComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Brand Compliance Status' ;
    rdfs:comment 'Current brand compliance status of the SKU inventory at this location. Non-compliant or under-review stock may be blocked from sale pending IP or licensing verification.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countVarianceQty rdf:type rdf:Property ;
    rdfs:label 'Count Variance Qty' ;
    rdfs:comment 'Difference between last_physical_count_qty and system on_hand_qty at the time of the count. Positive values indicate system over-count; negative values indicate shrinkage or unrecorded losses.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inTransitQty rdf:type rdf:Property ;
    rdfs:label 'In Transit Qty' ;
    rdfs:comment 'Units of the SKU currently in transit to this location from another storage location (warehouse, venue, or third-party). Included in inventory planning but not yet physically received.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inventoryValue rdf:type rdf:Property ;
    rdfs:label 'Inventory Value' ;
    rdfs:comment 'Total financial value of on-hand stock for this SKU at this location (on_hand_qty × unit_cost). Used for balance sheet inventory reporting and EBITDA analysis. Confidential financial data.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isConsignment rdf:type rdf:Property ;
    rdfs:label 'Is Consignment' ;
    rdfs:comment 'Indicates whether the inventory at this location is held on consignment with a third-party retailer. Consignment stock requires separate royalty tracking and licensing compliance under IP agreements.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEventAllocated rdf:type rdf:Property ;
    rdfs:label 'Is Event Allocated' ;
    rdfs:comment 'Indicates whether this inventory position has been specifically allocated for an upcoming event (e.g., game day, concert, championship). Event-allocated stock is excluded from general omnichannel availability.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastMovementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Movement Timestamp' ;
    rdfs:comment 'Date and time of the most recent stock movement (sale, transfer, adjustment, receipt) that changed the on-hand quantity for this SKU-location combination. Critical for real-time inventory sync validation.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastMovementType rdf:type rdf:Property ;
    rdfs:label 'Last Movement Type' ;
    rdfs:comment 'Type of the most recent stock movement that updated this inventory position. Used for audit trail and inventory reconciliation. [ENUM-REF-CANDIDATE: sale|return|transfer_in|transfer_out|adjustment|receipt|write_off|event_allocation — promote to reference product]' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPhysicalCountDate rdf:type rdf:Property ;
    rdfs:label 'Last Physical Count Date' ;
    rdfs:comment 'Date on which the most recent physical inventory count was conducted for this SKU at this location. Used to assess count freshness and schedule cycle counts per SOX and internal audit requirements.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPhysicalCountQty rdf:type rdf:Property ;
    rdfs:label 'Last Physical Count Qty' ;
    rdfs:comment 'Actual unit count recorded during the most recent physical inventory count for this SKU at this location. Compared against system on-hand quantity to identify shrinkage or discrepancies.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:locationCode rdf:type rdf:Property ;
    rdfs:label 'Location Code' ;
    rdfs:comment 'Alphanumeric code identifying the physical storage location (e.g., venue store bin, warehouse zone, consignment shelf). Used for warehouse management and event-day stocking operations.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationType rdf:type rdf:Property ;
    rdfs:label 'Location Type' ;
    rdfs:comment 'Classification of the storage location where inventory is held. Drives omnichannel fulfillment routing, event-day stocking logic, and consignment royalty tracking. [ENUM-REF-CANDIDATE: venue_store|warehouse|consignment|pop_up|online_fulfillment|third_party_retail — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxStockQty rdf:type rdf:Property ;
    rdfs:label 'Max Stock Qty' ;
    rdfs:comment 'Upper capacity limit for this SKU at this storage location. Prevents over-stocking and supports space planning for venue stores and warehouse zones.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:onHandQty rdf:type rdf:Property ;
    rdfs:label 'On Hand Qty' ;
    rdfs:comment 'Total physical units of the SKU currently present at the storage location, including reserved and blocked stock. Sourced from Shopify Plus inventory sync or warehouse management system.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:posLocationCode rdf:type rdf:Property ;
    rdfs:label 'Pos Location Code' ;
    rdfs:comment 'Identifier for the POS terminal or venue store location as registered in the POS system. Used to reconcile POS transaction-driven inventory deductions with Shopify Plus and SAP inventory records.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionStatus rdf:type rdf:Property ;
    rdfs:label 'Position Status' ;
    rdfs:comment 'Current lifecycle status of the inventory position record. \'blocked\' indicates stock held for quality inspection or compliance review; \'pending_audit\' indicates a physical count discrepancy under investigation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reorderPointQty rdf:type rdf:Property ;
    rdfs:label 'Reorder Point Qty' ;
    rdfs:comment 'Stock level threshold at which a replenishment order should be initiated for this SKU at this location. Accounts for lead time and safety stock. Used by merchandise operations for automated reorder triggers.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reorderQty rdf:type rdf:Property ;
    rdfs:label 'Reorder Qty' ;
    rdfs:comment 'Standard replenishment order quantity for this SKU at this location when the reorder point is reached. Reflects economic order quantity or vendor minimum order quantity.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reservedQty rdf:type rdf:Property ;
    rdfs:label 'Reserved Qty' ;
    rdfs:comment 'Units of the SKU at this location that are committed to open orders, event-day allocations, or transfer requests and are not available for new sales. Sourced from Shopify Plus committed inventory.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyStockQty rdf:type rdf:Property ;
    rdfs:label 'Safety Stock Qty' ;
    rdfs:comment 'Minimum buffer stock level for the SKU at this location below which a replenishment alert is triggered. Set by merchandise planners to prevent stockouts during peak event periods.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shopifyInventoryItemCode rdf:type rdf:Property ;
    rdfs:label 'Shopify Inventory Item Code' ;
    rdfs:comment 'External identifier assigned by Shopify Plus to the inventory item for this SKU. Used for real-time inventory sync between Shopify Plus and the lakehouse silver layer.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shopifyLocationCode rdf:type rdf:Property ;
    rdfs:label 'Shopify Location Code' ;
    rdfs:comment 'External identifier assigned by Shopify Plus to the fulfillment location. Used to reconcile Shopify inventory levels with SAP and POS system records across omnichannel operations.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shrinkageQty rdf:type rdf:Property ;
    rdfs:label 'Shrinkage Qty' ;
    rdfs:comment 'Cumulative units of the SKU lost at this location due to theft, damage, or unrecorded consumption since the last physical count. Used for loss prevention reporting and inventory reconciliation.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:skuCode rdf:type rdf:Property ;
    rdfs:label 'Sku Code' ;
    rdfs:comment 'Human-readable alphanumeric code uniquely identifying the merchandise SKU, sourced from Shopify Plus or SAP material master. Used for omnichannel inventory reconciliation and POS scanning.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Transfer Completion Date' ;
    rdfs:comment 'Date on which the most recent stock transfer to or from this inventory position was completed and receiving confirmation was recorded.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transferQty rdf:type rdf:Property ;
    rdfs:label 'Transfer Qty' ;
    rdfs:comment 'Number of units involved in the most recent or active stock transfer for this SKU-location. Captured to support transfer reconciliation and event-day stocking verification.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transferReason rdf:type rdf:Property ;
    rdfs:label 'Transfer Reason' ;
    rdfs:comment 'Business reason for the most recent stock transfer affecting this inventory position. Supports event-day logistics planning and omnichannel inventory optimization reporting.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferStatus rdf:type rdf:Property ;
    rdfs:label 'Transfer Status' ;
    rdfs:comment 'Current workflow status of the most recent stock transfer associated with this inventory position. Drives in-transit quantity calculations and fulfillment center receiving workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitCost rdf:type rdf:Property ;
    rdfs:label 'Unit Cost' ;
    rdfs:comment 'Standard or moving average cost per unit of the SKU at this location used for inventory valuation. Sourced from SAP S/4HANA material ledger. Confidential as it reflects supplier pricing and margin data.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationMethod rdf:type rdf:Property ;
    rdfs:label 'Valuation Method' ;
    rdfs:comment 'Accounting method used to value inventory for this SKU at this location. Determines how unit_cost is calculated and reported on financial statements. Must align with SAP material ledger configuration.' ;
    rdfs:domain ind:InventoryPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inventoryTransferId rdf:type rdf:Property ;
    rdfs:label 'Inventory Transfer Id' ;
    rdfs:comment 'Unique system-generated identifier for each inventory transfer record within the merchandise domain. Primary key for the inventory_transfer data product.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:destinationLocationRetailLocationId rdf:type rdf:Property ;
    rdfs:label 'Destination Location Retail Location Id' ;
    rdfs:comment 'Identifier of the retail location, warehouse, or fulfillment center to which merchandise stock is being transferred. References the location master in the venue/warehouse registry.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RetailLocation .

ind:primaryInventoryEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Inventory Employee Id' ;
    rdfs:comment 'Identifier of the employee or system user who initiated the inventory transfer request. Supports accountability tracking and approval workflow auditing.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Completion Date' ;
    rdfs:comment 'Calendar date on which the inventory transfer was fully received and confirmed at the destination location. Null until the transfer reaches completed status. Used for on-time delivery performance reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:carrierName rdf:type rdf:Property ;
    rdfs:label 'Carrier Name' ;
    rdfs:comment 'Name of the logistics carrier or internal transport team responsible for physically moving the merchandise between locations (e.g., \'FedEx\', \'UPS\', \'Internal Fleet\'). Used for carrier performance tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationLocationCode rdf:type rdf:Property ;
    rdfs:label 'Destination Location Code' ;
    rdfs:comment 'Short alphanumeric code identifying the destination location. Denormalized for operational reporting without requiring a join to the location master.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationLocationName rdf:type rdf:Property ;
    rdfs:label 'Destination Location Name' ;
    rdfs:comment 'Human-readable name of the destination location (e.g., \'Staples Center Venue Store\', \'West Coast Warehouse\'). Denormalized for operational dashboards and transfer documentation.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationLocationType rdf:type rdf:Property ;
    rdfs:label 'Destination Location Type' ;
    rdfs:comment 'Classification of the destination location in the merchandise distribution network. Determines applicable receiving procedures, SLAs, and inventory accounting treatment.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Timestamp' ;
    rdfs:comment 'Date and time when merchandise stock physically departed the origin location. Marks the start of the in-transit phase and triggers inventory deduction at the origin.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:estimatedRetailValue rdf:type rdf:Property ;
    rdfs:label 'Estimated Retail Value' ;
    rdfs:comment 'Estimated total retail value of all merchandise units included in the transfer, calculated at standard retail price. Used for insurance, loss reporting, and financial exposure assessment during transit.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedArrivalDate rdf:type rdf:Property ;
    rdfs:label 'Expected Arrival Date' ;
    rdfs:comment 'Planned calendar date by which the transferred merchandise is expected to arrive at the destination location. Used for event-day stocking planning and SLA monitoring.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isEventDayTransfer rdf:type rdf:Property ;
    rdfs:label 'Is Event Day Transfer' ;
    rdfs:comment 'Boolean flag indicating whether this transfer was specifically initiated to support event-day venue store stocking operations. Enables fast filtering of event-driven inventory movements for post-event analysis.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPartialTransfer rdf:type rdf:Property ;
    rdfs:label 'Is Partial Transfer' ;
    rdfs:comment 'Indicates whether the transfer was fulfilled partially (True) or in full (False). A partial transfer occurs when not all requested SKUs or quantities were available at the origin at the time of dispatch.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originLocationCode rdf:type rdf:Property ;
    rdfs:label 'Origin Location Code' ;
    rdfs:comment 'Short alphanumeric code identifying the origin location (e.g., warehouse, venue store, fulfillment center). Denormalized for operational reporting without requiring a join to the location master.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originLocationName rdf:type rdf:Property ;
    rdfs:label 'Origin Location Name' ;
    rdfs:comment 'Human-readable name of the origin location (e.g., \'Madison Square Garden Venue Store\', \'East Coast Fulfillment Center\'). Denormalized for operational dashboards and transfer documentation.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originLocationType rdf:type rdf:Property ;
    rdfs:label 'Origin Location Type' ;
    rdfs:comment 'Classification of the origin location in the merchandise distribution network. Determines applicable transfer rules, SLAs, and inventory accounting treatment.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shippingMethod rdf:type rdf:Property ;
    rdfs:label 'Shipping Method' ;
    rdfs:comment 'Mode of transport used for the inventory transfer. Drives cost estimation and expected transit time calculations. Same_day and overnight are critical for event-day stocking scenarios.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceTransferReference rdf:type rdf:Property ;
    rdfs:label 'Source Transfer Reference' ;
    rdfs:comment 'The native transfer order number or document reference from the originating system of record (e.g., SAP MM Transfer Order number, Shopify inventory transfer ID). Enables cross-system reconciliation and audit traceability.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferCost rdf:type rdf:Property ;
    rdfs:label 'Transfer Cost' ;
    rdfs:comment 'Actual or estimated logistics cost incurred to execute the inventory transfer (e.g., courier fees, internal transport charges). Used for cost center allocation and profitability analysis of omnichannel operations.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferNumber rdf:type rdf:Property ;
    rdfs:label 'Transfer Number' ;
    rdfs:comment 'Externally-visible business identifier for the inventory transfer, used in operational communications, warehouse documentation, and Shopify Plus / SAP MM transfer order references. Follows the format TRF-YYYY-NNNNNN.' ;
    rdfs:domain ind:InventoryTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferType rdf:type rdf:Property ;
    rdfs:label 'Transfer Type' ;
    rdfs:comment 'Categorizes the nature of the stock movement: inter-warehouse rebalancing, store-to-store redistribution, warehouse-to-store replenishment, store-to-warehouse returns, or fulfillment center allocation. Drives routing logic and SLA targets. [ENUM-REF-CANDIDATE: inter_warehouse|store_to_store|warehouse_to_store|store_to_warehouse|fulfillment_center|cross_dock — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastMediaRightsDealId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Media Rights Deal Id' ;
    rdfs:comment 'Foreign key linking to broadcast.media_rights_deal. Business justification: IP rights co-execution: in sports entertainment, a broadcast rights deal and a merchandise licensing agreement are often co-executed for the same league/franchise IP and territory. Legal and commercia' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MediaRightsDeal .

ind:internalOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Internal Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Each licensing agreement has an internal employee owner responsible for compliance monitoring, royalty reporting, and renewal management. Enables license portfolio management and workload reporting. T' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:licensorCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Licensor Corporate Entity Id' ;
    rdfs:comment 'Foreign key linking to legal.corporate_entity. Business justification: Merchandise licensing agreements are executed by specific corporate entities (league entity, franchise holding company). Entity-level royalty consolidation, intercompany billing, SOX reporting, and go' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:licensorFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Licensor Franchise Id' ;
    rdfs:comment 'Reference to the party (league, team, athlete, or rights-holding entity) granting the IP license.' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:requiredInsurancePolicyId rdf:type rdf:Property ;
    rdfs:label 'Required Insurance Policy Id' ;
    rdfs:comment 'Foreign key linking to legal.insurance_policy. Business justification: Merchandise licensing agreements require licensees to maintain insurance (product liability, IP infringement coverage) — confirmed by insurance_required_amount on licensing_agreement. Linking to insur' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsurancePolicy .

ind:advancePayment rdf:type rdf:Property ;
    rdfs:label 'Advance Payment' ;
    rdfs:comment 'Upfront payment made by the licensee to the licensor at agreement execution, typically applied against future royalty obligations (recoupable advance).' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:antiCounterfeitingClause rdf:type rdf:Property ;
    rdfs:label 'Anti Counterfeiting Clause' ;
    rdfs:comment 'Indicates whether the agreement includes specific anti-counterfeiting obligations requiring the licensee to actively monitor and report unauthorized use of licensed IP.' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditRequirement rdf:type rdf:Property ;
    rdfs:label 'Audit Requirement' ;
    rdfs:comment 'Specifies the contractually mandated frequency of compliance audits the licensor may conduct on the licensee\'s books and production records to verify royalty accuracy and brand compliance.' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Brand Compliance Required' ;
    rdfs:comment 'Indicates whether the licensee is required to submit product samples and artwork for brand compliance review and approval before production. Supports IP (Intellectual Property) protection and brand integrity.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeResolution rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution' ;
    rdfs:comment 'The contractually agreed mechanism for resolving disputes arising under this licensing agreement.' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceRequiredAmount rdf:type rdf:Property ;
    rdfs:label 'Insurance Required Amount' ;
    rdfs:comment 'Minimum liability insurance coverage amount the licensee is contractually required to maintain and evidence throughout the agreement term.' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isNilAgreement rdf:type rdf:Property ;
    rdfs:label 'Is Nil Agreement' ;
    rdfs:comment 'Indicates whether this licensing agreement covers NIL (Name Image and Likeness) rights for an individual athlete, enabling athlete-branded merchandise production and sale.' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licensedIpDescription rdf:type rdf:Property ;
    rdfs:label 'Licensed Ip Description' ;
    rdfs:comment 'Narrative description of the specific intellectual property rights granted under this agreement, including team names, logos, player NIL (Name Image and Likeness) rights, trademarks, and other brand assets authorized for use.' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumGuaranteedRoyalty rdf:type rdf:Property ;
    rdfs:label 'Minimum Guaranteed Royalty' ;
    rdfs:comment 'The minimum royalty amount the licensee is contractually obligated to pay the licensor over the agreement term, regardless of actual sales volume. Protects licensor revenue floor.' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:productCategoryScope rdf:type rdf:Property ;
    rdfs:label 'Product Category Scope' ;
    rdfs:comment 'Comma-delimited list or narrative description of the merchandise product categories covered by this license (e.g., apparel, headwear, memorabilia, footwear, accessories). Defines the boundaries of authorized production. [ENUM-REF-CANDIDATE: apparel|headwear|memorabilia|footwear|accessories|collectibles|digital — promote to reference product]' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyRatePct rdf:type rdf:Property ;
    rdfs:label 'Royalty Rate Pct' ;
    rdfs:comment 'The contractually agreed royalty rate expressed as a percentage of net sales that the licensee must remit to the licensor for each unit of licensed merchandise sold.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:royaltyReportingFrequency rdf:type rdf:Property ;
    rdfs:label 'Royalty Reporting Frequency' ;
    rdfs:comment 'The contractually required frequency at which the licensee must submit royalty statements and remit royalty payments to the licensor.' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sellOffPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Sell Off Period Days' ;
    rdfs:comment 'Number of calendar days after agreement expiration or termination during which the licensee is permitted to sell existing inventory of licensed merchandise before all sales must cease.' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:territoryDescription rdf:type rdf:Property ;
    rdfs:label 'Territory Description' ;
    rdfs:comment 'Narrative description of the authorized sales and distribution territory when the territory spans multiple countries or requires specific regional clarification beyond the primary territory code.' ;
    rdfs:domain ind:LicensingAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authenticatingVendorId rdf:type rdf:Property ;
    rdfs:label 'Authenticating Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: Memorabilia authentication in sports entertainment is performed by certified third-party vendors (e.g., PSA, JSA, Beckett). Linking memorabilia_item to the authenticating vendor enables vendor perform' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:authenticationAssetId rdf:type rdf:Property ;
    rdfs:label 'Authentication Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: Memorabilia authentication workflows require linking each item to its provenance media asset — signing ceremony video, inspection photos, certificate scans — stored in the DAM. Insurance valuation, re' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:storageRetailLocationId rdf:type rdf:Property ;
    rdfs:label 'Storage Retail Location Id' ;
    rdfs:comment 'Foreign key linking to merchandise.retail_location. Business justification: memorabilia_item.storage_location (STRING) is a denormalized text field identifying where the authenticated item is physically stored (vault, display case, warehouse). retail_location is the authorita' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RetailLocation .

ind:acquisitionSource rdf:type rdf:Property ;
    rdfs:label 'Acquisition Source' ;
    rdfs:comment 'The channel or method through which the organization acquired this memorabilia item. Used for provenance chain-of-custody documentation and sourcing analytics. [ENUM-REF-CANDIDATE: athlete_donation|league_allocation|auction_purchase|estate_purchase|team_consignment|third_party_purchase|internal_transfer — promote to reference product]' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authenticationCertNumber rdf:type rdf:Property ;
    rdfs:label 'Authentication Cert Number' ;
    rdfs:comment 'The unique certificate number issued by the authentication provider verifying the item\'s authenticity. This is the primary external reference for provenance validation and resale documentation. Essential for anti-counterfeiting compliance.' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authenticationDate rdf:type rdf:Property ;
    rdfs:label 'Authentication Date' ;
    rdfs:comment 'The date on which the memorabilia item was authenticated by the designated authentication provider. Used for provenance timeline, certificate validity tracking, and re-authentication scheduling.' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:autographLocation rdf:type rdf:Property ;
    rdfs:label 'Autograph Location' ;
    rdfs:comment 'Description of where on the item the autograph appears (e.g., \'front number\', \'back nameplate\', \'sweet spot\', \'panel\'). Used for authentication verification and catalog description accuracy.' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionGrade rdf:type rdf:Property ;
    rdfs:label 'Condition Grade' ;
    rdfs:comment 'Standardized physical condition grade of the memorabilia item as assessed by the authentication provider or internal grader. Directly impacts current market valuation and resale pricing. Follows PSA/BAS grading scale conventions. [ENUM-REF-CANDIDATE: mint|near_mint|excellent|very_good|good|fair|poor — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionNotes rdf:type rdf:Property ;
    rdfs:label 'Condition Notes' ;
    rdfs:comment 'Free-text description of the item\'s physical condition, including specific wear, damage, or notable characteristics observed during grading. Supplements the condition grade with qualitative detail for buyers and insurers.' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentValuation rdf:type rdf:Property ;
    rdfs:label 'Current Valuation' ;
    rdfs:comment 'The most recent appraised or market-assessed value of this memorabilia item, in the currency specified by currency_code. Updated periodically based on market conditions, comparable sales, and re-authentication. Used for insurance, financial reporting, and pricing decisions.' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:editionSize rdf:type rdf:Property ;
    rdfs:label 'Edition Size' ;
    rdfs:comment 'Total number of items produced in this edition run. Applicable for limited and numbered editions. A value of NULL indicates an open edition with no production cap. Critical for scarcity valuation and collector market pricing.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:editionType rdf:type rdf:Property ;
    rdfs:label 'Edition Type' ;
    rdfs:comment 'Indicates whether this memorabilia item is part of a limited edition run, an open edition, a unique one-of-one piece, or a numbered series. Drives scarcity-based valuation and collector demand.' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inscription rdf:type rdf:Property ;
    rdfs:label 'Inscription' ;
    rdfs:comment 'Any personalized inscription or dedication written by the athlete alongside the autograph (e.g., \'MVP 2016\', \'To John, Best Wishes\'). Affects item uniqueness, valuation, and buyer appeal.' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipProtectionStatus rdf:type rdf:Property ;
    rdfs:label 'Ip Protection Status' ;
    rdfs:comment 'Status of intellectual property rights verification for this memorabilia item, including trademark, likeness rights, and image rights clearance. Ensures compliance with IP (Intellectual Property) and DRM (Digital Rights Management) obligations before sale or reproduction.' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAutographed rdf:type rdf:Property ;
    rdfs:label 'Is Autographed' ;
    rdfs:comment 'Indicates whether this memorabilia item bears an authenticated autograph or signature from the associated athlete or notable figure. Autographed items require additional signature authentication documentation.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isGameUsed rdf:type rdf:Property ;
    rdfs:label 'Is Game Used' ;
    rdfs:comment 'Indicates whether this memorabilia item was actually used during an official game or competitive event (True) versus being a signed or commemorative item not used in play (False). Game-used status significantly impacts authentication requirements and market valuation.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itemCode rdf:type rdf:Property ;
    rdfs:label 'Item Code' ;
    rdfs:comment 'Externally-known unique business identifier / catalog code for this memorabilia item, distinct from the standard Stock Keeping Unit (SKU) catalog. Used in Shopify Plus, POS systems, and auction house references. Format: MEM- prefix followed by alphanumeric characters.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemName rdf:type rdf:Property ;
    rdfs:label 'Item Name' ;
    rdfs:comment 'Human-readable name or title of the memorabilia item (e.g., \'LeBron James Autographed 2016 NBA Finals Jersey\', \'Tom Brady Game-Used Super Bowl LV Helmet\'). Used in catalog display, e-commerce listings, and auction descriptions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemStatus rdf:type rdf:Property ;
    rdfs:label 'Item Status' ;
    rdfs:comment 'Current lifecycle status of the memorabilia item. Drives inventory availability, sales eligibility, and operational workflows across venue stores, e-commerce, and auction channels.' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemType rdf:type rdf:Property ;
    rdfs:label 'Item Type' ;
    rdfs:comment 'Classification of the memorabilia item by physical category. Drives authentication requirements, valuation methodology, and display/storage protocols. [ENUM-REF-CANDIDATE: autographed_jersey|game_used_equipment|championship_ring|photograph|trading_card|trophy|collectible_figurine|other — promote to reference product]' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:listPrice rdf:type rdf:Property ;
    rdfs:label 'List Price' ;
    rdfs:comment 'The official retail or auction asking price for this memorabilia item, in the currency specified by currency_code. Used in Shopify Plus e-commerce listings, venue store POS, and auction catalog pricing.' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:provenanceDescription rdf:type rdf:Property ;
    rdfs:label 'Provenance Description' ;
    rdfs:comment 'Narrative description of the item\'s origin, history, and chain of custody — including the specific game, event, or moment of significance (e.g., \'Worn by Michael Jordan during Game 6 of the 1998 NBA Finals\'). Essential for authentication, valuation, and marketing.' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shopifyProductCode rdf:type rdf:Property ;
    rdfs:label 'Shopify Product Code' ;
    rdfs:comment 'The unique product identifier assigned by Shopify Plus for this memorabilia item in the e-commerce platform. Used for cross-system reconciliation between the merchandise master and the DTC (Direct-To-Consumer) online storefront.' ;
    rdfs:domain ind:MemorabiliaItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashierEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Cashier Employee Id' ;
    rdfs:comment 'Employee or operator identifier of the cashier who processed the in-venue POS transaction. Populated only for venue_pos channel orders. Used for workforce accountability, loss prevention, and operational audits.' ;
    rdfs:domain ind:MerchOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:priceListId rdf:type rdf:Property ;
    rdfs:label 'Price List Id' ;
    rdfs:comment 'Foreign key linking to merchandise.price_list. Business justification: merch_order captures the gross_amount, discount_amount, and net_total but has no reference to which price_list configuration governed the transaction. Adding price_list_id creates an order-level audit' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PriceList .

ind:promoCodeId rdf:type rdf:Property ;
    rdfs:label 'Promo Code Id' ;
    rdfs:comment 'Foreign key linking to ticketing.promo_code. Business justification: Cross-domain promotional campaigns (e.g., sponsor-funded codes valid for both ticket discounts and merchandise) are common in sports entertainment. Linking merch_order to ticketing.promo_code enables ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PromoCode .

ind:channelSubtype rdf:type rdf:Property ;
    rdfs:label 'Channel Subtype' ;
    rdfs:comment 'Granular classification of the sales channel within the primary channel type. Enables detailed omnichannel analytics distinguishing mobile app vs. online store within e-commerce, or kiosk vs. arena store within venue POS. [ENUM-REF-CANDIDATE: online_store|mobile_app|arena_store|kiosk|pop_up|third_party_retailer — promote to reference product]' ;
    rdfs:domain ind:MerchOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:giftOrderFlag rdf:type rdf:Property ;
    rdfs:label 'Gift Order Flag' ;
    rdfs:comment 'Indicates whether the merchandise order was designated as a gift by the purchaser. When true, triggers gift wrapping, suppresses price disclosure on packing slip, and enables gift receipt generation. Relevant for holiday and event-driven merchandise campaigns.' ;
    rdfs:domain ind:MerchOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netTotal rdf:type rdf:Property ;
    rdfs:label 'Net Total' ;
    rdfs:comment 'Final amount charged to the customer: gross_amount minus discount_amount plus tax_amount plus shipping_amount. Represents the actual revenue collected for this order. Used as the primary revenue figure for financial reporting and reconciliation against payment records.' ;
    rdfs:domain ind:MerchOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:orderDate rdf:type rdf:Property ;
    rdfs:label 'Order Date' ;
    rdfs:comment 'The principal real-world timestamp when the merchandise order was placed by the customer or captured at the Point of Sale (POS) terminal. Represents the business event time, distinct from system audit timestamps. Stored in ISO 8601 format with timezone offset.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReference rdf:type rdf:Property ;
    rdfs:label 'Payment Reference' ;
    rdfs:comment 'Payment gateway transaction reference or authorization code for the order. For PCI DSS compliance, this stores only the tokenized or masked payment reference — never raw card numbers, CVV, or full PAN. Used for payment reconciliation and dispute resolution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:posTerminalCode rdf:type rdf:Property ;
    rdfs:label 'Pos Terminal Code' ;
    rdfs:comment 'Unique identifier of the Point of Sale (POS) terminal device that processed the in-venue transaction. Populated only for venue_pos channel orders. Used for reconciliation, audit trails, and PCI DSS compliance reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Return Eligible Flag' ;
    rdfs:comment 'Indicates whether the order is eligible for return or exchange under the current merchandise return policy. May be false for event-day clearance items, personalized/customized merchandise, or items past the return window. Drives customer service and reverse logistics workflows.' ;
    rdfs:domain ind:MerchOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnWindowExpiry rdf:type rdf:Property ;
    rdfs:label 'Return Window Expiry' ;
    rdfs:comment 'The last date on which a return or exchange can be initiated for this order, calculated from the order date based on the applicable return policy. Used by customer service to validate return eligibility and by operations to manage reverse logistics SLA (Service Level Agreement) compliance.' ;
    rdfs:domain ind:MerchOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:shippingAmount rdf:type rdf:Property ;
    rdfs:label 'Shipping Amount' ;
    rdfs:comment 'Shipping and handling charges applied to the order. Populated for e-commerce orders with physical delivery. Zero or null for in-venue POS transactions where goods are handed over at point of purchase.' ;
    rdfs:domain ind:MerchOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceOrderReference rdf:type rdf:Property ;
    rdfs:label 'Source Order Reference' ;
    rdfs:comment 'The native order identifier from the originating operational system (e.g., Shopify Plus order ID, POS transaction ID, wholesale portal order number). Enables traceability back to the system of record for reconciliation, dispute resolution, and audit purposes.' ;
    rdfs:domain ind:MerchOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxExemptFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Flag' ;
    rdfs:comment 'Indicates whether the order is exempt from sales tax, typically applicable to wholesale B2B orders with a valid tax exemption certificate or reseller permit. Drives tax calculation logic and financial reporting for SAP S/4HANA FI tax reconciliation.' ;
    rdfs:domain ind:MerchOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxExemptionRef rdf:type rdf:Property ;
    rdfs:label 'Tax Exemption Ref' ;
    rdfs:comment 'Tax exemption certificate number or reseller permit reference for tax-exempt orders. Populated only when tax_exempt_flag is true. Required for tax audit documentation and compliance with applicable sales tax regulations.' ;
    rdfs:domain ind:MerchOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:merchandiseGoodsReceiptId rdf:type rdf:Property ;
    rdfs:label 'Merchandise Goods Receipt Id' ;
    rdfs:comment 'Unique system-generated identifier for the merchandise goods receipt record. Primary key for this entity. Entity role: TRANSACTION_HEADER — represents a discrete business event (physical receipt of inventory) with a clear lifecycle.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:partnerPurchaseOrderId rdf:type rdf:Property ;
    rdfs:label 'Partner Purchase Order Id' ;
    rdfs:comment 'Reference to the purchase order against which this goods receipt is posted. Links the receipt to the originating procurement document for three-way matching (PO, GR, Invoice).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PurchaseOrder .

ind:primaryMerchandiseSkuCatalogId rdf:type rdf:Property ;
    rdfs:label 'Primary Merchandise Sku Catalog Id' ;
    rdfs:comment 'Reference to the merchandise SKU (Stock Keeping Unit) received. Links to the product master catalog for item-level inventory updates, licensing validation, and brand compliance checks.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SkuCatalog .

ind:vendorInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Vendor Invoice Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor_invoice. Business justification: Three-way match (PO → Goods Receipt → Invoice) is a mandatory AP control for merchandise procurement. Linking merchandise_goods_receipt to vendor_invoice enables invoice verification against received ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VendorInvoice .

ind:acceptedQuantity rdf:type rdf:Property ;
    rdfs:label 'Accepted Quantity' ;
    rdfs:comment 'The quantity of received units that passed quality inspection and were accepted into usable inventory. May be less than received_quantity if some units were damaged or failed inspection.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arrivalCondition rdf:type rdf:Property ;
    rdfs:label 'Arrival Condition' ;
    rdfs:comment 'Overall physical condition of the shipment as assessed upon arrival at the warehouse. Drives quality inspection routing and supplier discrepancy workflows. Short-shipped and over-shipped indicate quantity variances versus the delivery note.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billOfLadingNumber rdf:type rdf:Property ;
    rdfs:label 'Bill Of Lading Number' ;
    rdfs:comment 'Carrier-issued bill of lading number for the inbound shipment. Used for freight claims, carrier performance tracking, and customs compliance for international merchandise shipments.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandComplianceVerified rdf:type rdf:Property ;
    rdfs:label 'Brand Compliance Verified' ;
    rdfs:comment 'Indicates whether the received merchandise has been verified as compliant with the applicable IP licensing and brand standards (correct logos, colors, labeling). Non-compliant items must be quarantined and returned to vendor.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:countryOfOrigin rdf:type rdf:Property ;
    rdfs:label 'Country Of Origin' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code indicating where the merchandise was manufactured. Required for customs declarations, import duty calculations, and trade compliance reporting for international merchandise sourcing.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryNoteNumber rdf:type rdf:Property ;
    rdfs:label 'Delivery Note Number' ;
    rdfs:comment 'The delivery note or packing slip number provided by the supplier accompanying the shipment. Used for cross-referencing supplier documentation during discrepancy resolution and three-way matching.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discrepancyNotes rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Notes' ;
    rdfs:comment 'Free-text description of the discrepancy observed, including details of damage, wrong items, or quantity variances. Captured by the warehouse receiver or quality inspector for supplier communication.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discrepancyQuantity rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Quantity' ;
    rdfs:comment 'The numeric quantity variance between the PO quantity and the received quantity (po_quantity minus received_quantity). Positive value indicates short shipment; negative value indicates over-shipment.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discrepancyResolutionStatus rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Resolution Status' ;
    rdfs:comment 'Current status of the supplier discrepancy resolution workflow initiated when a receipt variance is identified. Tracks progress from identification through resolution or escalation.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discrepancyType rdf:type rdf:Property ;
    rdfs:label 'Discrepancy Type' ;
    rdfs:comment 'Classification of the discrepancy identified between the purchase order and the actual receipt. Drives the appropriate supplier resolution workflow. [ENUM-REF-CANDIDATE: none|quantity_short|quantity_over|damaged|wrong_item|wrong_size|wrong_color|mixed — promote to reference product]' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Expected Delivery Date' ;
    rdfs:comment 'The date on which the merchandise was originally scheduled to be delivered per the purchase order. Used for supplier on-time delivery performance measurement and event-driven inventory planning (e.g., pre-game merchandise availability).' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hologramVerified rdf:type rdf:Property ;
    rdfs:label 'Hologram Verified' ;
    rdfs:comment 'Indicates whether the official league/association authentication hologram or tamper-evident label is present and verified on the received merchandise. Required for licensed sports merchandise to confirm authenticity and prevent counterfeit goods from entering inventory.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionStatus rdf:type rdf:Property ;
    rdfs:label 'Inspection Status' ;
    rdfs:comment 'Current status of the quality inspection process for this goods receipt. Passed status is required before accepted_quantity is posted to usable inventory. Waived indicates inspection was bypassed under an approved supplier certification.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inventoryUpdateStatus rdf:type rdf:Property ;
    rdfs:label 'Inventory Update Status' ;
    rdfs:comment 'Indicates whether the accepted quantity from this goods receipt has been posted to the inventory management system. Posted status confirms the inventory position has been updated. Reversed indicates a cancellation posting was made.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poNumber rdf:type rdf:Property ;
    rdfs:label 'Po Number' ;
    rdfs:comment 'Human-readable purchase order number from the source procurement system (SAP S/4HANA). Retained on the receipt for three-way matching, supplier invoicing, and audit without requiring a join.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poQuantity rdf:type rdf:Property ;
    rdfs:label 'Po Quantity' ;
    rdfs:comment 'The quantity of this SKU that was ordered on the originating purchase order line. Used as the baseline for discrepancy calculation (received vs. ordered).' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receiptNotes rdf:type rdf:Property ;
    rdfs:label 'Receipt Notes' ;
    rdfs:comment 'Free-text operational notes captured by the warehouse receiver at the time of receipt. May include observations about packaging condition, carrier handling issues, or special handling instructions for the received merchandise.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptNumber rdf:type rdf:Property ;
    rdfs:label 'Receipt Number' ;
    rdfs:comment 'Externally-known, human-readable document number assigned to this goods receipt. Follows the format GR-{YEAR}-{SEQUENCE}. Used in supplier communications, warehouse documentation, and audit trails.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptStatus rdf:type rdf:Property ;
    rdfs:label 'Receipt Status' ;
    rdfs:comment 'Current lifecycle state of the goods receipt document. Drives downstream workflows: accepted triggers inventory update; rejected or partially_accepted initiates supplier discrepancy resolution; cancelled voids the receipt.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptTimestamp rdf:type rdf:Property ;
    rdfs:label 'Receipt Timestamp' ;
    rdfs:comment 'Precise date and time when the goods receipt was recorded in the system. Used for intraday inventory tracking, shift-level reporting, and audit trail purposes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:receivedQuantity rdf:type rdf:Property ;
    rdfs:label 'Received Quantity' ;
    rdfs:comment 'The actual quantity of this SKU physically received and counted at the warehouse. Core operational field used to update inventory positions and calculate discrepancies versus PO quantity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receivingChannel rdf:type rdf:Property ;
    rdfs:label 'Receiving Channel' ;
    rdfs:comment 'The operational channel or facility type where the merchandise was received. Distinguishes between venue retail stores, central distribution centers, third-party retailer locations, and e-commerce fulfillment centers for omnichannel inventory management.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectedQuantity rdf:type rdf:Property ;
    rdfs:label 'Rejected Quantity' ;
    rdfs:comment 'The quantity of received units that failed quality inspection and were rejected. Triggers supplier discrepancy resolution workflow and return-to-vendor (RTV) process.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnToVendorInitiated rdf:type rdf:Property ;
    rdfs:label 'Return To Vendor Initiated' ;
    rdfs:comment 'Indicates whether a return-to-vendor process has been initiated for rejected or non-compliant units from this goods receipt. Triggers the RTV workflow in SAP S/4HANA for credit memo processing.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalReceiptValue rdf:type rdf:Property ;
    rdfs:label 'Total Receipt Value' ;
    rdfs:comment 'Total monetary value of the accepted merchandise received, calculated as accepted_quantity multiplied by unit_cost. Used for inventory valuation postings, accounts payable accruals, and financial reporting.' ;
    rdfs:domain ind:MerchandiseGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:orderLineId rdf:type rdf:Property ;
    rdfs:label 'Order Line Id' ;
    rdfs:comment 'Unique surrogate identifier for each individual order line item within the merchandise domain. Primary key for this entity.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrderLine .

ind:fulfillmentLocationType rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Location Type' ;
    rdfs:comment 'Classification of the fulfillment origin for this line item, distinguishing between central warehouse, venue retail store, third-party logistics (3PL) provider, or direct drop-ship from supplier. Supports omnichannel fulfillment analytics.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isGift rdf:type rdf:Property ;
    rdfs:label 'Is Gift' ;
    rdfs:comment 'Indicates whether this line item was purchased as a gift, triggering gift wrapping, gift receipt generation, and suppression of price information on packing slips.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPersonalized rdf:type rdf:Property ;
    rdfs:label 'Is Personalized' ;
    rdfs:comment 'Indicates whether this line item includes a personalization or customization (e.g., player name/number printing on a jersey). Personalized items typically have different return eligibility and production lead times.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReturnEligible rdf:type rdf:Property ;
    rdfs:label 'Is Return Eligible' ;
    rdfs:comment 'Indicates whether this line item is eligible for return based on product type, licensing restrictions, event-specific merchandise policies, or return window expiry. Drives customer-facing return eligibility checks.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineDiscountAmount rdf:type rdf:Property ;
    rdfs:label 'Line Discount Amount' ;
    rdfs:comment 'Total monetary discount applied to this specific line item, including promotional codes, loyalty discounts, and manual overrides. Expressed in the order currency.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineDiscountPct rdf:type rdf:Property ;
    rdfs:label 'Line Discount Pct' ;
    rdfs:comment 'Discount rate applied to this line item expressed as a percentage of the unit price multiplied by quantity. Supports promotional effectiveness analysis and margin impact reporting.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineNumber rdf:type rdf:Property ;
    rdfs:label 'Line Number' ;
    rdfs:comment 'Sequential position of this line item within the parent order, starting at 1. Used for ordering, display, and reconciliation of multi-line orders.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineSubtotal rdf:type rdf:Property ;
    rdfs:label 'Line Subtotal' ;
    rdfs:comment 'Pre-tax line total calculated as (unit_price × quantity_ordered) minus line_discount_amount. Represents the net merchandise value of this line before tax. Used for revenue attribution and financial reporting.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Line Tax Amount' ;
    rdfs:comment 'Total tax amount charged on this line item, aggregating all applicable tax lines (e.g., state, local, VAT). Required for tax remittance reporting and financial reconciliation.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineTotal rdf:type rdf:Property ;
    rdfs:label 'Line Total' ;
    rdfs:comment 'Final total for this line item inclusive of tax and after all discounts (line_subtotal + line_tax_amount). Represents the amount the customer is charged for this specific line. Used for revenue reporting and financial reconciliation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:personalizationDetail rdf:type rdf:Property ;
    rdfs:label 'Personalization Detail' ;
    rdfs:comment 'Free-text description of the personalization applied to this line item (e.g., \'Name: JOHNSON, Number: 23\'). Populated only when is_personalized is true. Drives production instructions for customization fulfillment.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productName rdf:type rdf:Property ;
    rdfs:label 'Product Name' ;
    rdfs:comment 'Display name of the merchandise product at the time of purchase (e.g., \'Home Jersey 2024 – Size L\'). Captured as a point-in-time snapshot to preserve historical accuracy independent of catalog changes.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityFulfilled rdf:type rdf:Property ;
    rdfs:label 'Quantity Fulfilled' ;
    rdfs:comment 'Number of units of this line item that have been physically picked, packed, and shipped or handed over to the customer. Enables partial fulfillment tracking and backorder identification.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quantityOrdered rdf:type rdf:Property ;
    rdfs:label 'Quantity Ordered' ;
    rdfs:comment 'Number of units of the SKU ordered on this line item. Used for inventory reservation, fulfillment picking, and sales volume reporting.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quantityReturned rdf:type rdf:Property ;
    rdfs:label 'Quantity Returned' ;
    rdfs:comment 'Number of units of this line item that have been returned by the customer. Supports return rate analysis, refund processing, and net revenue calculation at the SKU level.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresShipping rdf:type rdf:Property ;
    rdfs:label 'Requires Shipping' ;
    rdfs:comment 'Indicates whether this line item requires physical shipment to the customer, as opposed to in-venue pickup or digital delivery. Drives shipping cost allocation and logistics workflow routing.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnStatus rdf:type rdf:Property ;
    rdfs:label 'Return Status' ;
    rdfs:comment 'Current status of any return or refund request associated with this line item. Supports returns management, refund authorization workflows, and customer service operations.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnWindowExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Return Window Expiry Date' ;
    rdfs:comment 'The last date on which a return for this line item can be initiated, calculated from the fulfillment date based on the applicable return policy. Used to enforce return eligibility and automate policy expiry.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemLineRef rdf:type rdf:Property ;
    rdfs:label 'Source System Line Ref' ;
    rdfs:comment 'The native line item identifier from the originating operational system (e.g., Shopify Plus line item ID or SAP S/4HANA SD item number). Enables traceability and reconciliation between the lakehouse silver layer and the system of record.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxExempt rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt' ;
    rdfs:comment 'Indicates whether this line item is exempt from sales tax, applicable for wholesale transactions, reseller purchases, or tax-exempt organizations. Supports tax compliance and audit reporting.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unitPrice rdf:type rdf:Property ;
    rdfs:label 'Unit Price' ;
    rdfs:comment 'Listed selling price per single unit of the SKU at the time of order placement, before any line-level discounts or promotions are applied. Expressed in the order currency.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variantDescription rdf:type rdf:Property ;
    rdfs:label 'Variant Description' ;
    rdfs:comment 'Descriptive label for the specific product variant attributes such as size, color, and team affiliation (e.g., \'Red / XL / Chicago Bulls\'). Supports customer-facing order confirmations and returns processing.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warehouseCode rdf:type rdf:Property ;
    rdfs:label 'Warehouse Code' ;
    rdfs:comment 'Reference to the fulfillment warehouse or distribution center assigned to fulfill this line item. Used for inventory allocation, pick-pack-ship operations, and logistics cost attribution.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:basePrice rdf:type rdf:Property ;
    rdfs:label 'Base Price' ;
    rdfs:comment 'The standard unit price (MSRP or list price) for merchandise SKUs under this price list, expressed in the designated currency. This is the principal quantitative pricing fact before any discounts or promotions are applied.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountType rdf:type rdf:Property ;
    rdfs:label 'Discount Type' ;
    rdfs:comment 'The mechanism by which the promotional discount is applied: percentage (% off base price), fixed_amount (flat dollar reduction), bogo (Buy One Get One), free_shipping (shipping waiver), bundle (multi-SKU deal price), loyalty_points (fan loyalty reward redemption). Null for non-promotional price lists.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountValue rdf:type rdf:Property ;
    rdfs:label 'Discount Value' ;
    rdfs:comment 'The magnitude of the discount: a percentage (0–100) for percentage-type discounts, or a fixed monetary amount for fixed_amount-type discounts. Interpreted in conjunction with discount_type.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCombinable rdf:type rdf:Property ;
    rdfs:label 'Is Combinable' ;
    rdfs:comment 'Indicates whether this price list or promotional discount may be combined with other active promotions in the same transaction. False enforces exclusivity (e.g., championship launch pricing cannot stack with loyalty discounts).' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLoyaltyRedemption rdf:type rdf:Property ;
    rdfs:label 'Is Loyalty Redemption' ;
    rdfs:comment 'Indicates whether this price list entry is redeemable via fan loyalty reward points rather than direct monetary payment. Supports fan loyalty reward redemption tracking.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:listStatus rdf:type rdf:Property ;
    rdfs:label 'List Status' ;
    rdfs:comment 'Current lifecycle state of the price list: draft (under configuration), active (live and applicable), scheduled (approved but not yet effective), expired (past effective_end_date), suspended (temporarily disabled), archived (retired from use).' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loyaltyPointsRequired rdf:type rdf:Property ;
    rdfs:label 'Loyalty Points Required' ;
    rdfs:comment 'Number of fan loyalty reward points required to redeem this price list offer. Applicable only when is_loyalty_redemption is True. Null for non-loyalty price lists.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minOrderQuantity rdf:type rdf:Property ;
    rdfs:label 'Min Order Quantity' ;
    rdfs:comment 'Minimum number of SKU units that must be included in a transaction for this price list to be applicable. Used for wholesale bulk pricing and bundle deal qualification.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minOrderValue rdf:type rdf:Property ;
    rdfs:label 'Min Order Value' ;
    rdfs:comment 'Minimum transaction value (in the price list currency) required to qualify for this price list or promotional discount. Used for free shipping thresholds and tiered promotional offers.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumAdvertisedPrice rdf:type rdf:Property ;
    rdfs:label 'Minimum Advertised Price' ;
    rdfs:comment 'The lowest price at which merchandise may be advertised per licensing and brand compliance agreements. Enforced across all channels to protect brand integrity and licensor relationships.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:msrp rdf:type rdf:Property ;
    rdfs:label 'Msrp' ;
    rdfs:comment 'The Manufacturer\'s Suggested Retail Price (MSRP) as recommended by the league licensor or brand owner. Used as the reference ceiling price for compliance with licensing agreements and MAP (Minimum Advertised Price) policies.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perCustomerUsageLimit rdf:type rdf:Property ;
    rdfs:label 'Per Customer Usage Limit' ;
    rdfs:comment 'Maximum number of times a single customer may redeem this promotional price list or promo code. Prevents abuse of fan loyalty and event-day promotions.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priceListCode rdf:type rdf:Property ;
    rdfs:label 'Price List Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this price list across systems (Shopify Plus, SAP SD, POS). Used as the business key for cross-system reconciliation.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceListName rdf:type rdf:Property ;
    rdfs:label 'Price List Name' ;
    rdfs:comment 'Human-readable name of the price list (e.g., \'Championship Launch MSRP 2025\', \'VIP Member Wholesale Spring\', \'Event-Day GA Promo\'). Used in Shopify Plus and POS displays.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceListType rdf:type rdf:Property ;
    rdfs:label 'Price List Type' ;
    rdfs:comment 'Classification of the price list by its commercial purpose: base (standard MSRP), wholesale (B2B/retailer), vip_member (fan loyalty tier), promotional (campaign-driven discount), event_day (championship or game-day launch), clearance (end-of-season markdown). [ENUM-REF-CANDIDATE: base|wholesale|vip_member|promotional|event_day|clearance — promote to reference product if additional types emerge]' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promoCodeRedemptionCount rdf:type rdf:Property ;
    rdfs:label 'Promo Code Redemption Count' ;
    rdfs:comment 'Running count of the number of times this promotional code has been successfully redeemed. Used for campaign performance tracking and budget burn monitoring.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:promoCodeUsageLimit rdf:type rdf:Property ;
    rdfs:label 'Promo Code Usage Limit' ;
    rdfs:comment 'Maximum total number of times this promotional code may be redeemed across all customers. Null indicates unlimited usage. Used to control promotional budget exposure.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sapConditionRecordCode rdf:type rdf:Property ;
    rdfs:label 'Sap Condition Record Code' ;
    rdfs:comment 'The condition record number (KNUMH) from SAP S/4HANA SD pricing configuration corresponding to this price list entry. Enables traceability back to the ERP pricing master.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shopifyPriceListCode rdf:type rdf:Property ;
    rdfs:label 'Shopify Price List Code' ;
    rdfs:comment 'The native price list identifier assigned by Shopify Plus for this record. Used for cross-system reconciliation between the lakehouse silver layer and the Shopify Plus e-commerce platform.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxClass rdf:type rdf:Property ;
    rdfs:label 'Tax Class' ;
    rdfs:comment 'Tax classification applicable to merchandise sold under this price list, determining the VAT/sales tax treatment at point of sale. Aligns with SAP SD tax condition types.' ;
    rdfs:domain ind:PriceList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:associatedEventFixtureId rdf:type rdf:Property ;
    rdfs:label 'Associated Event Fixture Id' ;
    rdfs:comment 'Reference to the specific sports or entertainment event (game, match, concert) that this promotion is tied to, when event_trigger is not \'none\'. Links to the event domain for event-day and championship merchandise promotion activation.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fixture .

ind:associatedFixtureId rdf:type rdf:Property ;
    rdfs:label 'Associated Fixture Id' ;
    rdfs:comment 'Reference to the specific sports or entertainment event (game, match, concert) that this promotion is tied to, when event_trigger is not \'none\'. Links to the event domain for event-day and championship merchandise promotion activation.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fixture .

ind:bundledBonusOfferId rdf:type rdf:Property ;
    rdfs:label 'Bundled Bonus Offer Id' ;
    rdfs:comment 'Foreign key linking to gaming.bonus_offer. Business justification: Cross-domain promotional bundling: Sports Entertainment operators run campaigns pairing merchandise discounts with gaming bonus offers (e.g., \'bet $50, get 20% off jersey\'). Marketing and campaign rep' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BonusOffer .

ind:promotionAssociatedLeagueId rdf:type rdf:Property ;
    rdfs:label 'Promotion Associated League Id' ;
    rdfs:comment 'Reference to the professional league or competition (e.g., NFL, NBA, MLS) whose licensed merchandise is covered by this promotion. Supports league-specific licensing compliance and royalty tracking.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:League .

ind:promotionLeagueId rdf:type rdf:Property ;
    rdfs:label 'Promotion League Id' ;
    rdfs:comment 'Reference to the professional league or competition (e.g., NFL, NBA, MLS) whose licensed merchandise is covered by this promotion. Supports league-specific licensing compliance and royalty tracking.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:League .

ind:applicableCategoryList rdf:type rdf:Property ;
    rdfs:label 'Applicable Category List' ;
    rdfs:comment 'Comma-delimited list of merchandise category codes (e.g., APPAREL, HEADWEAR, MEMORABILIA) to which this promotion applies when applicable_scope is \'specific_categories\'. Aligns with the merchandise product hierarchy in SAP S/4HANA MM.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableScope rdf:type rdf:Property ;
    rdfs:label 'Applicable Scope' ;
    rdfs:comment 'Defines the breadth of merchandise to which the promotion applies: all_products (entire catalog), specific_skus (individual SKU-level targeting), specific_categories (e.g., apparel, headwear), specific_collections (e.g., championship collection), or entire_order (applied to the full cart value).' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bogoBuyQuantity rdf:type rdf:Property ;
    rdfs:label 'Bogo Buy Quantity' ;
    rdfs:comment 'For Buy One Get One (BOGO) promotion types, the number of items the customer must purchase to qualify for the free or discounted item(s). Null for non-BOGO promotion types.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bogoGetQuantity rdf:type rdf:Property ;
    rdfs:label 'Bogo Get Quantity' ;
    rdfs:comment 'For Buy One Get One (BOGO) promotion types, the number of items the customer receives free or at a discounted price after meeting the bogo_buy_quantity threshold. Null for non-BOGO promotion types.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brandComplianceApproved rdf:type rdf:Property ;
    rdfs:label 'Brand Compliance Approved' ;
    rdfs:comment 'Indicates whether the promotional creative, messaging, and discount terms have been reviewed and approved by the brand compliance team to ensure alignment with league IP guidelines and sponsor brand standards. True = approved; False = pending or rejected.' ;
    rdfs:domain ind:Merchandise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:channelRestriction rdf:type rdf:Property ;
    rdfs:label 'Channel Restriction' ;
    rdfs:comment 'Specifies the sales channel(s) through which this promotion is valid: all_channels (no restriction), online_only (Shopify Plus DTC e-commerce), in_venue_pos (venue Point of Sale terminals), third_party_retail (licensed retail partners), or dtc_app (Direct-To-Consumer mobile application). Supports omnichannel campaign management.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountValueType rdf:type rdf:Property ;
    rdfs:label 'Discount Value Type' ;
    rdfs:comment 'Specifies the unit of measure for the discount_value field: percentage (proportion of item price), fixed_amount (absolute currency deduction), or free (item/shipping provided at no cost). Enables correct calculation logic in Shopify Plus and POS systems.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventTrigger rdf:type rdf:Property ;
    rdfs:label 'Event Trigger' ;
    rdfs:comment 'Business event that triggers or is associated with this promotion. Captures the sports-entertainment context: none (standard promotion), game_day (active on event day), championship_win (post-championship merchandise launch), playoff_entry, season_opener, concert_event, or anniversary. Enables event-driven promotion activation workflows. [ENUM-REF-CANDIDATE: none|game_day|championship_win|playoff_entry|season_opener|concert_event|anniversary — promote to reference product if additional triggers emerge]' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:freeShippingThreshold rdf:type rdf:Property ;
    rdfs:label 'Free Shipping Threshold' ;
    rdfs:comment 'Minimum order subtotal (in promotion currency) required to qualify for free shipping when promotion_type is \'free_shipping\'. Null for non-shipping promotions or promotions with no spend threshold for free shipping.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicRestriction rdf:type rdf:Property ;
    rdfs:label 'Geographic Restriction' ;
    rdfs:comment 'Comma-delimited list of ISO 3166-1 alpha-3 country codes where this promotion is valid. Null indicates no geographic restriction (global). Required for international licensing compliance and GDPR/CCPA-compliant targeted promotions in EU and California markets.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipLicenseRequired rdf:type rdf:Property ;
    rdfs:label 'Ip License Required' ;
    rdfs:comment 'Indicates whether the merchandise covered by this promotion requires a valid Intellectual Property (IP) licensing agreement (e.g., team logo, league trademark). True = IP license verification required before promotion activation; False = no IP licensing constraint. Supports brand compliance and IP protection obligations.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAutoApply rdf:type rdf:Property ;
    rdfs:label 'Is Auto Apply' ;
    rdfs:comment 'Indicates whether the promotion is automatically applied to qualifying carts without requiring the customer to enter a promo code. True = automatic discount; False = requires promo_code entry. Supports seamless event-day fan experience promotions.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loyaltyPointsCost rdf:type rdf:Property ;
    rdfs:label 'Loyalty Points Cost' ;
    rdfs:comment 'Number of fan loyalty points required to redeem this promotion when requires_loyalty_membership is True and promotion_type is \'loyalty_reward\'. Null for non-loyalty promotions. Managed through the fan loyalty program in Adobe Experience Platform and Salesforce CRM.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxDiscountCapAmount rdf:type rdf:Property ;
    rdfs:label 'Max Discount Cap Amount' ;
    rdfs:comment 'Maximum absolute discount amount (in promotion currency) that can be applied per transaction, regardless of the calculated percentage discount. Prevents excessive margin erosion on high-value merchandise orders. Null indicates no cap.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minPurchaseAmount rdf:type rdf:Property ;
    rdfs:label 'Min Purchase Amount' ;
    rdfs:comment 'Minimum cart or order subtotal (in the promotion currency) that must be met before the promotion can be applied. Null indicates no minimum spend threshold. Used to drive higher basket values on event-day and championship merchandise campaigns.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minQuantity rdf:type rdf:Property ;
    rdfs:label 'Min Quantity' ;
    rdfs:comment 'Minimum number of qualifying items that must be in the cart before the promotion activates. Primarily used for bundle and BOGO promotion types. Null indicates no quantity threshold.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:promotionDescription rdf:type rdf:Property ;
    rdfs:label 'Promotion Description' ;
    rdfs:comment 'Free-text marketing description of the promotion as communicated to fans and retail staff. Includes terms and conditions summary, eligible merchandise categories, and any event-specific context (e.g., \'Celebrate the championship with 20% off all official team jerseys this weekend only\').' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promotionName rdf:type rdf:Property ;
    rdfs:label 'Promotion Name' ;
    rdfs:comment 'Human-readable marketing name for the promotional campaign as displayed to fans and retail staff (e.g., \'Championship Day 20% Off\', \'Buy One Get One Jersey\', \'Fan Loyalty Free Shipping\').' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promotionStatus rdf:type rdf:Property ;
    rdfs:label 'Promotion Status' ;
    rdfs:comment 'Current lifecycle state of the promotional campaign: draft (being configured), scheduled (approved but not yet live), active (currently redeemable), paused (temporarily suspended), expired (past end date), or cancelled (terminated before expiry).' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promotionType rdf:type rdf:Property ;
    rdfs:label 'Promotion Type' ;
    rdfs:comment 'Classification of the promotional mechanism applied: percentage_discount (e.g., 20% off), fixed_amount (e.g., $10 off), bogo (Buy One Get One), free_shipping, bundle (multi-item deal), or loyalty_reward (fan loyalty point redemption). [ENUM-REF-CANDIDATE: percentage_discount|fixed_amount|bogo|free_shipping|bundle|loyalty_reward — promote to reference product if additional types emerge]' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresLoyaltyMembership rdf:type rdf:Property ;
    rdfs:label 'Requires Loyalty Membership' ;
    rdfs:comment 'Indicates whether redemption of this promotion requires the customer to be an active member of the fan loyalty program. True = loyalty members only; False = available to all customers. Supports fan loyalty reward redemption campaigns managed via Adobe Experience Platform.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:termsAndConditions rdf:type rdf:Property ;
    rdfs:label 'Terms And Conditions' ;
    rdfs:comment 'Full legal terms and conditions text governing the promotion, including exclusions, geographic restrictions, and expiry terms. Required for consumer protection compliance and GDPR/CCPA transparency obligations when promotions are targeted to EU or California-based fans.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageLimitPerCustomer rdf:type rdf:Property ;
    rdfs:label 'Usage Limit Per Customer' ;
    rdfs:comment 'Maximum number of times a single customer or fan account may redeem this promotion. Null indicates no per-customer restriction. Prevents abuse of fan loyalty reward promotions.' ;
    rdfs:domain ind:Promotion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:usageLimitTotal rdf:type rdf:Property ;
    rdfs:label 'Usage Limit Total' ;
    rdfs:comment 'Maximum total number of times this promotion can be redeemed across all customers and channels combined. Null indicates unlimited redemptions. Critical for scarcity-driven championship and limited-edition merchandise promotions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lossPreventionSurveillanceCameraId rdf:type rdf:Property ;
    rdfs:label 'Loss Prevention Surveillance Camera Id' ;
    rdfs:comment 'Foreign key linking to security.surveillance_camera. Business justification: Loss prevention operations in sports venues explicitly assign primary surveillance cameras to retail locations for theft monitoring and incident investigation. LP teams pull footage by store location;' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SurveillanceCamera .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line 1' ;
    rdfs:comment 'Primary street address of the physical retail location. Required for venue stores, kiosks, warehouse outlets, and pop-up shops. Null for pure e-commerce storefronts.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line 2' ;
    rdfs:comment 'Secondary address detail for the physical retail location (suite, unit, concourse level, gate reference). Supplements address_line_1 for precise wayfinding within large venue complexes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelSegment rdf:type rdf:Property ;
    rdfs:label 'Channel Segment' ;
    rdfs:comment 'Sales channel segment classification for the retail location. Distinguishes Direct-To-Consumer (DTC) owned channels from wholesale, marketplace, venue retail, and concession operations. Drives revenue attribution, royalty calculation, and licensing compliance reporting.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Default Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code used as the default transaction currency for this retail location (e.g., USD, GBP, EUR). Drives POS configuration, Shopify Plus storefront currency, and SAP SD pricing procedures.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDayHours rdf:type rdf:Property ;
    rdfs:label 'Event Day Hours' ;
    rdfs:comment 'Extended or modified operating hours applied on event days (game days, concerts, PPV events). Overrides standard weekday/weekend hours when an event is scheduled at the associated venue. Format: HH:MM-HH:MM.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floorAreaSqft rdf:type rdf:Property ;
    rdfs:label 'Floor Area Sqft' ;
    rdfs:comment 'Total usable retail floor area of the location in square feet. Used for merchandise density planning, inventory capacity modeling, and lease/facility cost allocation. Serves as the MEASUREMENT_OR_VALUE for the MASTER_RESOURCE role.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inventoryLocationCode rdf:type rdf:Property ;
    rdfs:label 'Inventory Location Code' ;
    rdfs:comment 'SAP S/4HANA MM storage location or warehouse code linked to this retail location for inventory management, stock replenishment, and goods movement tracking. Enables real-time inventory visibility across omnichannel merchandise operations.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFlagship rdf:type rdf:Property ;
    rdfs:label 'Is Flagship' ;
    rdfs:comment 'Indicates whether this retail location is designated as the flagship store for the associated venue or brand. Flagship stores receive priority inventory allocation, exclusive product launches, and premium visual merchandising standards.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOnline rdf:type rdf:Property ;
    rdfs:label 'Is Online' ;
    rdfs:comment 'Indicates whether this retail location is a virtual/online storefront (e.g., Shopify Plus e-commerce) rather than a physical location. Drives omnichannel routing logic, inventory fulfillment rules, and digital analytics tagging.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:latitude rdf:type rdf:Property ;
    rdfs:label 'Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the retail location in decimal degrees (WGS 84). Enables proximity-based fan engagement, geofencing campaigns via Adobe Experience Platform, and venue map integrations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:licenseTerritory rdf:type rdf:Property ;
    rdfs:label 'License Territory' ;
    rdfs:comment 'Geographic territory designation under which this retail location is authorized to sell licensed merchandise (e.g., \'NFL_NFC_WEST\', \'FIFA_EUROPE\', \'NBA_EASTERN_CONFERENCE\'). Enforces IP licensing boundaries and royalty calculation scope per league governing body agreements.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationStatus rdf:type rdf:Property ;
    rdfs:label 'Location Status' ;
    rdfs:comment 'Current operational lifecycle state of the retail location. Controls whether the location is available for sales transactions, inventory replenishment, and POS terminal assignment. Serves as the LIFECYCLE_STATUS for the MASTER_RESOURCE role.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:longitude rdf:type rdf:Property ;
    rdfs:label 'Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the retail location in decimal degrees (WGS 84). Used alongside latitude for geospatial analytics, fan proximity targeting, and digital wayfinding.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managerName rdf:type rdf:Property ;
    rdfs:label 'Manager Name' ;
    rdfs:comment 'Name of the store manager or location lead responsible for day-to-day operations of this retail location. Used for operational escalation, staffing accountability, and SAP SuccessFactors workforce assignment reference.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingHoursWeekday rdf:type rdf:Property ;
    rdfs:label 'Operating Hours Weekday' ;
    rdfs:comment 'Standard weekday operating hours for the retail location in HH:MM-HH:MM 24-hour format (e.g., \'09:00-21:00\'). Used for fan-facing store locator, staff scheduling, and omnichannel availability configuration.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingHoursWeekend rdf:type rdf:Property ;
    rdfs:label 'Operating Hours Weekend' ;
    rdfs:comment 'Standard weekend operating hours for the retail location in HH:MM-HH:MM 24-hour format (e.g., \'10:00-18:00\'). Distinct from weekday hours to support event-day extended trading and fan engagement scheduling.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentMethodsAccepted rdf:type rdf:Property ;
    rdfs:label 'Payment Methods Accepted' ;
    rdfs:comment 'Comma-delimited list of payment methods accepted at this retail location (e.g., \'credit_card,debit_card,cash,mobile_pay,gift_card\'). Drives POS configuration, fan-facing signage, and PCI-DSS scope assessment. [ENUM-REF-CANDIDATE: credit_card|debit_card|cash|mobile_pay|gift_card|crypto — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:posTerminalCount rdf:type rdf:Property ;
    rdfs:label 'Pos Terminal Count' ;
    rdfs:comment 'Number of active Point of Sale (POS) terminals assigned to this retail location. Used for capacity planning, PCI-DSS terminal compliance audits, and peak event staffing models.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:salesOrgCode rdf:type rdf:Property ;
    rdfs:label 'Sales Org Code' ;
    rdfs:comment 'SAP S/4HANA SD sales organization code to which this retail location belongs. Determines pricing procedures, output determination, and revenue recognition rules applicable to merchandise transactions at this location.' ;
    rdfs:domain ind:RetailLocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Customer Fan Profile Id' ;
    rdfs:comment 'Identifier of the fan or customer who submitted the return request. Used for CRM tracking, return history analysis, and loyalty program impact assessment.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:primaryReturnOriginalOrderMerchOrderId rdf:type rdf:Property ;
    rdfs:label 'Primary Return Original Order Merch Order Id' ;
    rdfs:comment 'Reference to the original merchandise sales order from which the items being returned were purchased. Links the return to the originating transaction for refund calculation and inventory reconciliation.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MerchOrder .

ind:primaryReturnSkuCatalogId rdf:type rdf:Property ;
    rdfs:label 'Primary Return Sku Catalog Id' ;
    rdfs:comment 'Reference to the specific merchandise SKU being returned. Links to the product master catalog for item identification, inventory restock eligibility, and licensing compliance validation.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SkuCatalog .

ind:returnSkuCatalogId rdf:type rdf:Property ;
    rdfs:label 'Return Sku Catalog Id' ;
    rdfs:comment 'FK to merchandise.sku_catalog' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SkuCatalog .

ind:tertiaryReturnMerchOrderId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Return Merch Order Id' ;
    rdfs:comment 'Identifier of the original Point of Sale transaction from which the returned item was purchased. Populated for POS-channel returns; used for in-store reconciliation and receipt validation.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MerchOrder .

ind:customerEmail rdf:type rdf:Property ;
    rdfs:label 'Customer Email' ;
    rdfs:comment 'Email address of the customer associated with the return request, captured at the time of submission for communication and notification purposes. Subject to GDPR and CCPA data privacy regulations.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Ip Compliance Flag' ;
    rdfs:comment 'Indicates whether the returned item has been flagged for potential IP, counterfeit, or brand compliance concerns. Triggers escalation to the licensing and IP protection team for investigation.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itemCondition rdf:type rdf:Property ;
    rdfs:label 'Item Condition' ;
    rdfs:comment 'Physical condition of the merchandise item as assessed upon receipt of the return. Determines restock eligibility, supplier chargeback applicability, and IP/brand compliance escalation.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netRefundAmount rdf:type rdf:Property ;
    rdfs:label 'Net Refund Amount' ;
    rdfs:comment 'Final refund amount payable to the customer after deducting restocking fees and any other adjustments from the gross refund amount. Used for financial settlement and AR reconciliation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyException rdf:type rdf:Property ;
    rdfs:label 'Policy Exception' ;
    rdfs:comment 'Indicates whether this return request was approved as an exception to the standard merchandise returns policy (e.g., outside return window, non-returnable item category). Requires manager authorization.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyExceptionReason rdf:type rdf:Property ;
    rdfs:label 'Policy Exception Reason' ;
    rdfs:comment 'Narrative explanation for why a policy exception was granted on this return request. Populated only when policy_exception is True. Required for audit and compliance review.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:posTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Pos Transaction Reference' ;
    rdfs:comment 'Identifier of the original Point of Sale transaction from which the returned item was purchased. Populated for POS-channel returns; used for in-store reconciliation and receipt validation.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundMethod rdf:type rdf:Property ;
    rdfs:label 'Refund Method' ;
    rdfs:comment 'Payment instrument or channel through which the approved refund will be issued to the customer. Drives downstream payment processing and PCI-DSS compliance workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restockEligible rdf:type rdf:Property ;
    rdfs:label 'Restock Eligible' ;
    rdfs:comment 'Indicates whether the returned merchandise item is eligible to be restocked and resold. Determined by item condition assessment and licensing compliance check.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restockingFee rdf:type rdf:Property ;
    rdfs:label 'Restocking Fee' ;
    rdfs:comment 'Fee deducted from the refund amount to cover handling and restocking costs, applied per the merchandise returns policy. May be zero for defective or mis-shipped items.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnChannel rdf:type rdf:Property ;
    rdfs:label 'Return Channel' ;
    rdfs:comment 'The omnichannel sales channel through which the original purchase was made and/or the return is being processed. Supports channel-specific returns policy enforcement and reverse logistics routing.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnMethod rdf:type rdf:Property ;
    rdfs:label 'Return Method' ;
    rdfs:comment 'Physical method by which the customer is returning the merchandise item(s). Determines reverse logistics workflow, carrier label generation, and processing location assignment.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnReasonCode rdf:type rdf:Property ;
    rdfs:label 'Return Reason Code' ;
    rdfs:comment 'Standardized reason code selected by the customer or agent explaining why the merchandise is being returned. Used for quality analytics, supplier chargebacks, and brand compliance reporting. [ENUM-REF-CANDIDATE: defective|wrong_item|wrong_size|not_as_described|damaged_in_transit|changed_mind|duplicate_order|counterfeit_suspected — promote to reference product]' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnReasonNotes rdf:type rdf:Property ;
    rdfs:label 'Return Reason Notes' ;
    rdfs:comment 'Free-text narrative provided by the customer or customer service agent elaborating on the reason for return. Supplements the standardized return_reason_code with contextual detail for quality review.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnWindowEligible rdf:type rdf:Property ;
    rdfs:label 'Return Window Eligible' ;
    rdfs:comment 'Indicates whether the return request was submitted within the allowable return window defined by the merchandise returns policy. Drives automated approval or escalation routing.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rmaNumber rdf:type rdf:Property ;
    rdfs:label 'Rma Number' ;
    rdfs:comment 'Externally-visible Return Merchandise Authorization number issued to the customer as proof of approved return. Used across omnichannel touchpoints (Shopify Plus, POS, venue stores) to track the return through reverse logistics.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shopifyReturnCode rdf:type rdf:Property ;
    rdfs:label 'Shopify Return Code' ;
    rdfs:comment 'Native return identifier assigned by Shopify Plus for e-commerce channel returns. Used for system-of-record reconciliation between the lakehouse Silver Layer and the Shopify Plus operational platform.' ;
    rdfs:domain ind:ReturnRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyPaymentId rdf:type rdf:Property ;
    rdfs:label 'Royalty Payment Id' ;
    rdfs:comment 'Unique surrogate identifier for each royalty payment record in the merchandise licensing domain. Primary key for the royalty_payment data product.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:advanceOffsetAmount rdf:type rdf:Property ;
    rdfs:label 'Advance Offset Amount' ;
    rdfs:comment 'Amount of previously paid royalty advance applied as an offset against the current period royalty due. Reduces the net royalty payable when an advance has been recouped against earned royalties.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Flag' ;
    rdfs:comment 'Indicates whether this royalty payment record is currently subject to a licensor-initiated audit under contractual audit rights provisions. True = under audit; False = not under audit.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cbaComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Cba Compliance Flag' ;
    rdfs:comment 'Indicates whether this royalty payment satisfies all applicable CBA (Collective Bargaining Agreement) reporting and payment obligations for the period. True = compliant; False = non-compliant or pending review.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Date' ;
    rdfs:comment 'Date on which a royalty dispute was formally resolved between the licensee and licensor. Null if no dispute exists or if dispute is still open. Used to track dispute lifecycle and SLA compliance.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grossSalesAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Sales Amount' ;
    rdfs:comment 'Total gross sales revenue from licensed merchandise for the reporting period, before any deductions, returns, or allowances. Serves as the royalty base for rate application. Sourced from Shopify Plus e-commerce and POS transaction data.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:licensorAcceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Licensor Acceptance Date' ;
    rdfs:comment 'Date on which the licensor formally accepted the royalty report and payment amount for the reporting period. Null if not yet accepted or if disputed.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licensorType rdf:type rdf:Property ;
    rdfs:label 'Licensor Type' ;
    rdfs:comment 'Classification of the IP rights holder receiving the royalty payment. Distinguishes between league-level IP (e.g., NFL, NBA, FIFA), team IP, individual athlete NIL (Name Image and Likeness) rights, player association collective rights, or event-specific IP.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netRoyaltyPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Net Royalty Paid Amount' ;
    rdfs:comment 'Final net amount actually disbursed to the licensor after applying minimum guarantees, advance offsets, and adjustments. This is the monetary triplet net total for the royalty payment transaction.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netSalesAmount rdf:type rdf:Property ;
    rdfs:label 'Net Sales Amount' ;
    rdfs:comment 'Net sales amount after deducting returns and allowances from gross sales. Represents the contractually defined royalty base upon which the royalty rate is applied to calculate royalty due.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Reference Number' ;
    rdfs:comment 'Externally-known business identifier for this royalty payment, used in licensor correspondence, audit submissions, and SAP S/4HANA FI payment documents. Format: RPY-YYYY-NNNNNN.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Report Submission Date' ;
    rdfs:comment 'Date on which the royalty report for the period was formally submitted to the licensor. Used to verify compliance with contractual reporting deadlines and to support licensor audit rights.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportSubmissionStatus rdf:type rdf:Property ;
    rdfs:label 'Report Submission Status' ;
    rdfs:comment 'Status of the royalty report submitted to the licensor for the reporting period. Tracks whether the report is in draft, has been formally submitted, accepted by the licensor, disputed, or is overdue per contractual deadlines.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnsAllowancesAmount rdf:type rdf:Property ;
    rdfs:label 'Returns Allowances Amount' ;
    rdfs:comment 'Total value of merchandise returns and trade allowances deducted from gross sales to arrive at net royalty base. Includes customer returns, damaged goods credits, and promotional allowances per licensing agreement terms.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:royaltyDueAmount rdf:type rdf:Property ;
    rdfs:label 'Royalty Due Amount' ;
    rdfs:comment 'Calculated royalty amount due to the licensor, derived by applying the royalty rate to net sales. Represents the gross royalty obligation before adjustments, minimum guarantees, or advance offsets.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ageRestriction rdf:type rdf:Property ;
    rdfs:label 'Age Restriction' ;
    rdfs:comment 'Age restriction classification for the SKU. Applies to products such as alcohol-branded merchandise or items with content restrictions. Drives age-gate enforcement on e-commerce and POS channels.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:barcode rdf:type rdf:Property ;
    rdfs:label 'Barcode' ;
    rdfs:comment 'Universal Product Code (UPC) or European Article Number (EAN) barcode assigned to the SKU for POS scanning, inventory management, and retail distribution. Aligns with GS1 barcode standards.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandName rdf:type rdf:Property ;
    rdfs:label 'Brand Name' ;
    rdfs:comment 'The licensed or proprietary brand associated with the SKU (e.g., Nike, Fanatics, Mitchell & Ness, New Era, \'47 Brand). Critical for brand compliance tracking, royalty calculation, and IP protection workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:colorHexCode rdf:type rdf:Property ;
    rdfs:label 'Color Hex Code' ;
    rdfs:comment 'Hexadecimal color code representing the primary color of the SKU for digital display consistency across e-commerce platforms, digital asset management (DAM), and brand compliance validation.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:colorName rdf:type rdf:Property ;
    rdfs:label 'Color Name' ;
    rdfs:comment 'Primary color name or color combination of the SKU variant as displayed to consumers (e.g., \'Lakers Gold\', \'Midnight Navy\', \'Heather Grey\'). Aligns with Shopify Plus variant option for color and supports visual merchandising.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceApprovedDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Approved Date' ;
    rdfs:comment 'Date on which brand compliance approval was granted by the league or team IP owner for this SKU. Used for audit trails, licensing compliance reporting, and SOX financial controls.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costPrice rdf:type rdf:Property ;
    rdfs:label 'Cost Price' ;
    rdfs:comment 'Standard cost of goods for this SKU representing the landed cost per unit including manufacturing, materials, and inbound freight. Used for gross margin calculation, inventory valuation, and EBITDA reporting.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discontinuationDate rdf:type rdf:Property ;
    rdfs:label 'Discontinuation Date' ;
    rdfs:comment 'Date on which the SKU was or is scheduled to be discontinued and removed from active sales channels. Null for currently active SKUs. Supports end-of-life inventory planning and catalog archival.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:genderTarget rdf:type rdf:Property ;
    rdfs:label 'Gender Target' ;
    rdfs:comment 'Target gender or age demographic for the SKU used for product classification, catalog filtering, and merchandising segmentation across sales channels.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:harmonizedTariffCode rdf:type rdf:Property ;
    rdfs:label 'Harmonized Tariff Code' ;
    rdfs:comment 'Harmonized System (HS) tariff classification code used for international trade, customs clearance, and import duty determination. Required for cross-border merchandise distribution and third-party retail export compliance.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLimitedEdition rdf:type rdf:Property ;
    rdfs:label 'Is Limited Edition' ;
    rdfs:comment 'Indicates whether the SKU is a limited edition release with a defined production run cap. True triggers limited edition pricing strategy, scarcity marketing, and edition size tracking.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseRequired rdf:type rdf:Property ;
    rdfs:label 'License Required' ;
    rdfs:comment 'Indicates whether this SKU requires an active licensing agreement to manufacture, distribute, or sell. True for all officially licensed league, team, or athlete-branded merchandise. Drives compliance checks in the licensing workflow.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialComposition rdf:type rdf:Property ;
    rdfs:label 'Material Composition' ;
    rdfs:comment 'Fabric or material composition of the product (e.g., \'100% Polyester\', \'60% Cotton 40% Polyester\', \'Genuine Leather\'). Required for product labeling compliance, customs declarations, and consumer transparency regulations.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productDescription rdf:type rdf:Property ;
    rdfs:label 'Product Description' ;
    rdfs:comment 'Detailed marketing and operational description of the product including materials, features, fit, and intended use. Used for e-commerce listings, catalog publishing, and digital asset management.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productType rdf:type rdf:Property ;
    rdfs:label 'Product Type' ;
    rdfs:comment 'Indicates whether the SKU represents a physical tangible good, a digital product (e.g., digital collectible, downloadable content), or a bundle of multiple items. Drives fulfillment routing and revenue recognition treatment.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresAuthentication rdf:type rdf:Property ;
    rdfs:label 'Requires Authentication' ;
    rdfs:comment 'Indicates whether this SKU requires a certificate of authenticity (COA) or third-party authentication (e.g., PSA/DNA, JSA) before sale. Applies to autographed memorabilia, game-used items, and high-value collectibles.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:salesChannelAvailability rdf:type rdf:Property ;
    rdfs:label 'Sales Channel Availability' ;
    rdfs:comment 'Pipe-delimited list of sales channels where this SKU is authorized for sale (e.g., \'shopify_online|venue_pos|third_party_retail|dtc_app\'). Drives omnichannel availability logic and channel-specific pricing rules. [ENUM-REF-CANDIDATE: shopify_online|venue_pos|third_party_retail|dtc_app|wholesale|international — promote to reference product]' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapMaterialNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Material Number' ;
    rdfs:comment 'SAP S/4HANA Materials Management (MM) material number (MATNR field) for this SKU. Enables reconciliation between the merchandise catalog and SAP procurement, inventory valuation, and financial reporting modules.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shopifyVariantCode rdf:type rdf:Property ;
    rdfs:label 'Shopify Variant Code' ;
    rdfs:comment 'Native variant identifier from the Shopify Plus e-commerce platform used for system-of-record reconciliation, API integration, and omnichannel order management. Enables traceability between the Silver Layer catalog and the Shopify Plus source system.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sizeCode rdf:type rdf:Property ;
    rdfs:label 'Size Code' ;
    rdfs:comment 'Standardized size designation for the SKU variant (e.g., XS, S, M, L, XL, XXL, 3XL, 7, 7.5, 32x30). Null for non-sized items such as collectibles or accessories. Aligns with Shopify Plus variant option for size.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxable rdf:type rdf:Property ;
    rdfs:label 'Taxable' ;
    rdfs:comment 'Indicates whether this SKU is subject to sales tax. Drives tax calculation at POS and e-commerce checkout. Certain memorabilia or resale items may have different tax treatment depending on jurisdiction.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weightGrams rdf:type rdf:Property ;
    rdfs:label 'Weight Grams' ;
    rdfs:comment 'Physical weight of the SKU in grams used for shipping rate calculation, customs documentation, and carrier SLA compliance across e-commerce fulfillment and third-party retail distribution.' ;
    rdfs:domain ind:SkuCatalog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shopifyVendorId rdf:type rdf:Property ;
    rdfs:label 'Shopify Vendor Id' ;
    rdfs:comment 'Vendor identifier assigned in Shopify Plus for this supplier. Used to link merchandise supplier records to e-commerce product listings and DTC (Direct-To-Consumer) fulfillment workflows.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:bankAccountRef rdf:type rdf:Property ;
    rdfs:label 'Bank Account Ref' ;
    rdfs:comment 'Masked or tokenized reference to the supplier\'s bank account used for electronic payment processing. Full account details are stored in the SAP S/4HANA FI payment configuration. PCI-DSS and SOX controls apply.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectRate rdf:type rdf:Property ;
    rdfs:label 'Defect Rate' ;
    rdfs:comment 'Percentage (0.00–100.00) of units received from this supplier that failed quality inspection. Used to monitor merchandise quality compliance and trigger corrective action plans.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ethicalSourcingCertName rdf:type rdf:Property ;
    rdfs:label 'Ethical Sourcing Cert Name' ;
    rdfs:comment 'Name of the ethical sourcing certification held by the supplier (e.g., Fair Trade, SA8000, WRAP, B Corp). Supports ESG due diligence and brand compliance reporting.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ethicalSourcingCertified rdf:type rdf:Property ;
    rdfs:label 'Ethical Sourcing Certified' ;
    rdfs:comment 'Indicates whether the supplier holds a recognized ethical sourcing certification (e.g., Fair Trade, SA8000, WRAP). Required for brand compliance and ESG reporting.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incotermsCode rdf:type rdf:Property ;
    rdfs:label 'Incoterms Code' ;
    rdfs:comment 'International Commercial Terms (Incoterms 2020) code defining the division of shipping costs, risk, and responsibilities between the supplier and Sports Entertainment. Critical for merchandise import logistics and customs compliance. [ENUM-REF-CANDIDATE: EXW|FCA|CPT|CIP|DAP|DPU|DDP|FAS|FOB|CFR|CIF — 11 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLicensedProducer rdf:type rdf:Property ;
    rdfs:label 'Is Licensed Producer' ;
    rdfs:comment 'Indicates whether the supplier holds an active official merchandise license from the relevant sports league or governing body (e.g., NFL, NBA, FIFA) to produce and distribute branded goods. Mandatory for IP protection and brand compliance.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isoCertExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Iso Cert Expiry Date' ;
    rdfs:comment 'Expiry date of the supplier\'s ISO certification. Procurement teams use this to schedule re-certification audits and ensure continuous compliance.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isoCertificationCode rdf:type rdf:Property ;
    rdfs:label 'Iso Certification Code' ;
    rdfs:comment 'ISO standard certification code held by the supplier (e.g., ISO 9001 for quality management, ISO 14001 for environmental management). Used in supplier qualification and audit processes.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Lead Time Days' ;
    rdfs:comment 'Standard number of calendar days from purchase order placement to goods receipt for this supplier. Used for merchandise replenishment planning, event inventory readiness, and Shopify Plus fulfillment SLA management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumOrderQuantity rdf:type rdf:Property ;
    rdfs:label 'Minimum Order Quantity' ;
    rdfs:comment 'Minimum number of units the supplier requires per purchase order line. Used in procurement planning to ensure order quantities meet supplier thresholds and avoid penalties.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:onTimeDeliveryRate rdf:type rdf:Property ;
    rdfs:label 'On Time Delivery Rate' ;
    rdfs:comment 'Percentage (0.00–100.00) of purchase orders delivered by the supplier on or before the confirmed delivery date. Key performance indicator for supplier reliability and event merchandise readiness.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Payment Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the supplier is paid (e.g., USD, EUR, GBP). Used for multi-currency procurement and financial settlement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredSupplierFlag rdf:type rdf:Property ;
    rdfs:label 'Preferred Supplier Flag' ;
    rdfs:comment 'Indicates whether this supplier has been designated as a preferred vendor for merchandise procurement, qualifying them for priority purchase order allocation and strategic partnership benefits.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:productCategories rdf:type rdf:Property ;
    rdfs:label 'Product Categories' ;
    rdfs:comment 'Comma-separated list of merchandise product categories supplied by this vendor (e.g., apparel, headwear, memorabilia, accessories, footwear). Used for category management and sourcing strategy.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityRatingScore rdf:type rdf:Property ;
    rdfs:label 'Quality Rating Score' ;
    rdfs:comment 'Numeric quality performance score (0.00–100.00) assigned to the supplier based on defect rates, return rates, and compliance with merchandise quality standards. Used in supplier evaluation and sourcing decisions.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:region rdf:type rdf:Property ;
    rdfs:label 'Region' ;
    rdfs:comment 'Geographic region where the supplier primarily operates (e.g., North America, Europe, Asia-Pacific). Used for supply chain risk segmentation and regional sourcing strategy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapVendorAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Vendor Account Number' ;
    rdfs:comment '10-digit vendor account number (LIFNR) assigned in SAP S/4HANA MM/FI for this supplier. Used as the cross-system reconciliation key between the merchandise supplier master and the ERP financial and procurement modules.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supplierCode rdf:type rdf:Property ;
    rdfs:label 'Supplier Code' ;
    rdfs:comment 'Externally-known alphanumeric code assigned to the supplier for use in purchase orders, invoices, and procurement communications. Aligns with SAP S/4HANA vendor account number (LIFNR) in the MM module.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supplierStatus rdf:type rdf:Property ;
    rdfs:label 'Supplier Status' ;
    rdfs:comment 'Current lifecycle status of the supplier in the merchandise procurement master. Active suppliers are eligible for purchase orders; suspended suppliers are under review; blacklisted suppliers are permanently excluded from procurement.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supplierType rdf:type rdf:Property ;
    rdfs:label 'Supplier Type' ;
    rdfs:comment 'Classification of the supplier\'s operational role in the merchandise supply chain. Manufacturer produces goods; distributor warehouses and ships; print-on-demand fulfills custom orders; licensee holds IP rights to produce; wholesaler sells in bulk; dropshipper ships directly to consumer. [ENUM-REF-CANDIDATE: manufacturer|distributor|print_on_demand|licensee|wholesaler|dropshipper — promote to reference product]' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Number' ;
    rdfs:comment 'Government-issued tax identification number (e.g., EIN in the USA, VAT number in the EU) for the supplier entity. Required for financial reporting, 1099/W-9 compliance, and royalty payment processing.' ;
    rdfs:domain ind:Supplier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeName rdf:type rdf:Property ;
    rdfs:label 'Trade Name' ;
    rdfs:comment 'Operating or brand name of the supplier, which may differ from the legal name. Used in day-to-day procurement communications and vendor-facing materials.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentAccountWholesaleAccountId rdf:type rdf:Property ;
    rdfs:label 'Parent Account Wholesale Account Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the parent wholesale account record, enabling hierarchical account structures (e.g., a regional subsidiary linked to a national chain parent). Null for top-level accounts.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WholesaleAccount .

ind:annualPurchaseCommitment rdf:type rdf:Property ;
    rdfs:label 'Annual Purchase Commitment' ;
    rdfs:comment 'Contractually committed annual purchase volume in USD for this wholesale account. Used to validate tier eligibility, trigger volume rebates, and support financial planning in Workday Adaptive Planning.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizedProductCategories rdf:type rdf:Property ;
    rdfs:label 'Authorized Product Categories' ;
    rdfs:comment 'Comma-separated list of merchandise product categories this wholesale account is licensed to sell (e.g., \'apparel,headwear,memorabilia\'). Enforces IP protection and brand compliance by restricting unauthorized SKU distribution.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandComplianceAuditDate rdf:type rdf:Property ;
    rdfs:label 'Brand Compliance Audit Date' ;
    rdfs:comment 'Date of the most recent brand compliance audit conducted for this wholesale account. Used to schedule recurring audits and assess IP protection posture.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:brandComplianceCertified rdf:type rdf:Property ;
    rdfs:label 'Brand Compliance Certified' ;
    rdfs:comment 'Indicates whether this wholesale account has passed the most recent brand compliance audit, confirming adherence to IP protection standards, display guidelines, and anti-counterfeiting requirements.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditLimit rdf:type rdf:Property ;
    rdfs:label 'Credit Limit' ;
    rdfs:comment 'Maximum outstanding accounts receivable balance permitted for this wholesale account before new orders are blocked. Managed in SAP S/4HANA SD credit management module.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountPct rdf:type rdf:Property ;
    rdfs:label 'Discount Pct' ;
    rdfs:comment 'Percentage discount applied to the standard wholesale price list for this account, expressed as a decimal (e.g., 35.00 = 35%). Negotiated as part of the licensing or distribution agreement.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endingInventoryOnHand rdf:type rdf:Property ;
    rdfs:label 'Ending Inventory On Hand' ;
    rdfs:comment 'Total units of licensed merchandise remaining in the wholesale account\'s inventory as reported in the most recent sell-through report. Drives replenishment order recommendations.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isExclusiveTerritory rdf:type rdf:Property ;
    rdfs:label 'Is Exclusive Territory' ;
    rdfs:comment 'Indicates whether this wholesale account holds exclusive distribution rights within its assigned territory. Exclusive accounts prevent other wholesale partners from selling the same licensed product categories in the same territory.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastSellthroughRatePct rdf:type rdf:Property ;
    rdfs:label 'Last Sellthrough Rate Pct' ;
    rdfs:comment 'Sell-through rate percentage from the most recent report, calculated as units sold divided by units received, expressed as a percentage. Indicates retail velocity and inventory health for licensed merchandise.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastSellthroughReportDate rdf:type rdf:Property ;
    rdfs:label 'Last Sellthrough Report Date' ;
    rdfs:comment 'Date on which the most recent sell-through report was received from this wholesale account. Used to monitor reporting compliance and trigger overdue notifications.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastSellthroughUnitsSold rdf:type rdf:Property ;
    rdfs:label 'Last Sellthrough Units Sold' ;
    rdfs:comment 'Total units sold across all SKUs as reported in the most recent sell-through report submission. Used for inventory replenishment decisions and royalty calculation inputs.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minOrderQty rdf:type rdf:Property ;
    rdfs:label 'Min Order Qty' ;
    rdfs:comment 'Minimum number of units per SKU or per order that this wholesale account must purchase per transaction. Enforces Minimum Order Quantity (MOQ) commitments defined in the distribution agreement.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sapCustomerNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Customer Number' ;
    rdfs:comment 'SAP S/4HANA SD customer master number (KUNNR) for this wholesale account, used to reconcile orders, invoices, and payments in the ERP system.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sellThroughReportFrequency rdf:type rdf:Property ;
    rdfs:label 'Sell Through Report Frequency' ;
    rdfs:comment 'Contractually required frequency at which this wholesale account must submit sell-through reports detailing units sold by SKU (Stock Keeping Unit), sell-through rates, and ending inventory on hand.' ;
    rdfs:domain ind:WholesaleAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryName rdf:type rdf:Property ;
    rdfs:label 'Territory Name' ;
    rdfs:comment 'Human-readable name of the assigned sales territory (e.g., \'Northeast US\', \'Western Europe\', \'Asia Pacific\'). Complements territory_code for reporting and display purposes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partnerGoodsReceiptId rdf:type rdf:Property ;
    rdfs:label 'Partner Goods Receipt Id' ;
    rdfs:comment 'Unique surrogate identifier for each goods receipt record in the partner domain. Primary key for the partner_goods_receipt data product in the Databricks Silver Layer.' ;
    rdfs:domain ind:Partner ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PartnerGoodsReceipt .

ind:receivingLocationFacilityId rdf:type rdf:Property ;
    rdfs:label 'Receiving Location Facility Id' ;
    rdfs:comment 'Reference to the Sports Entertainment facility where goods were physically received — stadium, arena, concert venue, warehouse, or broadcast facility. Drives inventory posting to the correct plant/storage location.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:billOfLading rdf:type rdf:Property ;
    rdfs:label 'Bill Of Lading' ;
    rdfs:comment 'The carrier\'s bill of lading or waybill number for the shipment. Used for freight tracking, carrier SLA compliance, and logistics dispute resolution for physical goods deliveries to Sports Entertainment venues and warehouses.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Gr Document Number' ;
    rdfs:comment 'The externally-known SAP material document number assigned to this goods receipt posting (e.g., 5000012345). Used as the primary business identifier for three-way matching (Purchase Order / Goods Receipt / Invoice) and accounts payable invoice verification workflows.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grDocumentYear rdf:type rdf:Property ;
    rdfs:label 'Gr Document Year' ;
    rdfs:comment 'The fiscal year in which the SAP material document was posted (e.g., 2024). Combined with gr_document_number to form the unique SAP material document key (MBLNR + MJAHR).' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:grStatus rdf:type rdf:Property ;
    rdfs:label 'Gr Status' ;
    rdfs:comment 'Current lifecycle status of the goods receipt document. \'posted\' indicates the SAP material document has been successfully created and inventory updated. \'reversed\' indicates a cancellation posting has been made. \'blocked\' indicates the receipt is on hold pending quality resolution.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionLotNumber rdf:type rdf:Property ;
    rdfs:label 'Inspection Lot Number' ;
    rdfs:comment 'The SAP Quality Management inspection lot number created automatically upon goods receipt posting when quality inspection is required for the material. Links the goods receipt to the detailed quality inspection record.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPartialDelivery rdf:type rdf:Property ;
    rdfs:label 'Is Partial Delivery' ;
    rdfs:comment 'Indicates whether this goods receipt represents a partial fulfillment of the purchase order line (True) with further deliveries expected, or a complete delivery (False). Drives open PO quantity tracking and delivery completion monitoring.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReturnDelivery rdf:type rdf:Property ;
    rdfs:label 'Is Return Delivery' ;
    rdfs:comment 'Indicates whether this goods receipt record represents a return delivery to the vendor (True) rather than an inbound receipt (False). Return deliveries reverse inventory and trigger vendor debit memo processing.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialDescription rdf:type rdf:Property ;
    rdfs:label 'Material Description' ;
    rdfs:comment 'Human-readable description of the goods or service item received as defined in the SAP material master. Provides context for receiving staff, quality inspectors, and accounts payable teams without requiring a material master lookup.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialGroup rdf:type rdf:Property ;
    rdfs:label 'Material Group' ;
    rdfs:comment 'SAP material group code classifying the type of goods received (e.g., merchandise inventory, broadcast equipment, venue maintenance supplies, event production materials, catering provisions). Enables spend analytics and category management reporting.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialNumber rdf:type rdf:Property ;
    rdfs:label 'Material Number' ;
    rdfs:comment 'The SAP material master number identifying the specific goods or service item received (e.g., merchandise SKU, broadcast equipment part number, venue maintenance supply, catering provision). Used for inventory management and three-way matching.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:movementType rdf:type rdf:Property ;
    rdfs:label 'Movement Type' ;
    rdfs:comment 'SAP inventory movement type code governing how the goods receipt affects stock (e.g., 101 = GR for PO into unrestricted stock, 103 = GR into GR blocked stock, 105 = Release from GR blocked stock). Determines the accounting entries generated. [ENUM-REF-CANDIDATE: 101|103|105|122|161|501 — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onTimeDeliveryFlag rdf:type rdf:Property ;
    rdfs:label 'On Time Delivery Flag' ;
    rdfs:comment 'Indicates whether the goods were received on or before the SLA required delivery date (True = on time, False = late). Derived from comparison of receipt_date vs sla_required_delivery_date. Used for vendor KPI scorecarding and SLA performance reporting.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderedQuantity rdf:type rdf:Property ;
    rdfs:label 'Ordered Quantity' ;
    rdfs:comment 'The quantity of goods originally ordered on the purchase order line item. Used to calculate over/under delivery variances and assess vendor fulfillment accuracy.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plantCode rdf:type rdf:Property ;
    rdfs:label 'Plant Code' ;
    rdfs:comment 'The SAP plant code representing the Sports Entertainment operational unit (stadium, arena, broadcast facility, warehouse) where the goods receipt is posted. Determines the inventory valuation area and cost center assignment.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityInspectionResult rdf:type rdf:Property ;
    rdfs:label 'Quality Inspection Result' ;
    rdfs:comment 'The outcome of the quality inspection performed on the received goods. \'pass\' = all goods accepted; \'conditional\' = partial acceptance with conditions; \'fail\' = goods rejected; \'not_required\' = inspection waived per material master settings. Drives usage decision in SAP QM.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptCategory rdf:type rdf:Property ;
    rdfs:label 'Receipt Category' ;
    rdfs:comment 'Business classification of the type of goods or services received, aligned to Sports Entertainment operational domains. Enables domain-specific reporting across merchandise inventory, broadcast equipment deliveries, venue maintenance supplies, event production materials, and catering provisions. [ENUM-REF-CANDIDATE: merchandise|broadcast_equipment|venue_supplies|event_production|catering|technology|other — promote to reference product]' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionNotes rdf:type rdf:Property ;
    rdfs:label 'Rejection Notes' ;
    rdfs:comment 'Free-text description providing additional detail on the reason for goods rejection, supplementing the rejection_reason_code. Captured by the receiving inspector and used for vendor dispute resolution and return-to-vendor documentation.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapPostingStatus rdf:type rdf:Property ;
    rdfs:label 'Sap Posting Status' ;
    rdfs:comment 'Indicates whether the goods receipt has been successfully posted in SAP S/4HANA, is pending posting, failed due to a system error, or has been reversed. Critical for accounts payable invoice verification and three-way matching readiness.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaRequiredDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Sla Required Delivery Date' ;
    rdfs:comment 'The contractually committed delivery date per the vendor SLA or purchase order schedule line. Compared against receipt_date to determine on-time delivery performance and SLA compliance for vendor scorecarding.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:storageLocationCode rdf:type rdf:Property ;
    rdfs:label 'Storage Location Code' ;
    rdfs:comment 'The SAP storage location code within the receiving plant where accepted goods are physically stored (e.g., MERCH-WH01 for merchandise warehouse, BCAST-EQ01 for broadcast equipment store). Drives inventory placement and warehouse management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalGrValue rdf:type rdf:Property ;
    rdfs:label 'Total Gr Value' ;
    rdfs:comment 'The total monetary value of the accepted goods receipt posting in the company code currency (accepted_quantity × valuation_price). Posted to the GR/IR clearing account in SAP FI and used for accounts payable invoice verification.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationPrice rdf:type rdf:Property ;
    rdfs:label 'Valuation Price' ;
    rdfs:comment 'The unit price at which the received goods are valued in SAP inventory accounting, derived from the purchase order price or moving average price. Used for inventory valuation and accounts payable three-way matching.' ;
    rdfs:domain ind:PartnerGoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveryVenueId rdf:type rdf:Property ;
    rdfs:label 'Delivery Venue Id' ;
    rdfs:comment 'Reference to the venue or facility where goods or services are to be delivered. Supports venue operations procurement (e.g., HVAC parts delivered to stadium, broadcast equipment to OB truck bay). Corresponds to SAP ship-to address on the PO.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Venue .

ind:deliveryAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Delivery Address Line1' ;
    rdfs:comment 'Primary street address line for the delivery location when the destination is not a managed venue in the venue master (e.g., temporary event site, off-site warehouse, broadcast remote location). Classified confidential as organizational contact data.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryCity rdf:type rdf:Property ;
    rdfs:label 'Delivery City' ;
    rdfs:comment 'City of the delivery destination address. Used for logistics routing, freight cost allocation, and geographic spend analysis across global markets.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryCountryCode rdf:type rdf:Property ;
    rdfs:label 'Delivery Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 three-letter country code for the delivery destination. Supports multi-jurisdictional procurement across global sports and entertainment markets (e.g., USA, GBR, AUS, BRA). Required for customs, import duties, and cross-border compliance.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goodsReceiptDate rdf:type rdf:Property ;
    rdfs:label 'Goods Receipt Date' ;
    rdfs:comment 'The date on which goods or services were physically received and a goods receipt (GR) document was posted in SAP. Corresponds to the posting date of the MIGO goods receipt transaction. Key date for three-way matching (PO/GR/invoice) in accounts payable.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:goodsReceiptQuantity rdf:type rdf:Property ;
    rdfs:label 'Goods Receipt Quantity' ;
    rdfs:comment 'Total quantity of goods physically received and posted against this purchase order across all goods receipt documents. Compared against ordered quantity to determine delivery completeness and trigger invoice verification.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossOrderValue rdf:type rdf:Property ;
    rdfs:label 'Gross Order Value' ;
    rdfs:comment 'Total gross value of the purchase order inclusive of all taxes and surcharges. Represents the total financial commitment to the vendor. Used for cash flow forecasting, accounts payable liability reporting, and budget variance analysis.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Verification Date' ;
    rdfs:comment 'The date on which the vendor invoice was verified and matched against the purchase order and goods receipt in SAP MIRO (invoice verification). Nullable until invoice is processed. Completes the three-way match cycle.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoicedAmount rdf:type rdf:Property ;
    rdfs:label 'Invoiced Amount' ;
    rdfs:comment 'Total monetary amount for which vendor invoices have been verified against this purchase order in SAP MIRO. Compared against net order value to identify billing discrepancies. Key metric for accounts payable liability management.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoicedQuantity rdf:type rdf:Property ;
    rdfs:label 'Invoiced Quantity' ;
    rdfs:comment 'Total quantity for which vendor invoices have been verified and posted in SAP MIRO against this purchase order. Used to identify over-invoicing or under-invoicing discrepancies in the three-way match process.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isBlanketRelease rdf:type rdf:Property ;
    rdfs:label 'Is Blanket Release' ;
    rdfs:comment 'Indicates whether this purchase order is a release order drawn against a blanket/framework agreement. When True, the contract_id field references the parent blanket agreement. Supports spend tracking against pre-negotiated vendor contracts.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isGoodsReceiptRequired rdf:type rdf:Property ;
    rdfs:label 'Is Goods Receipt Required' ;
    rdfs:comment 'Indicates whether a goods receipt must be posted before invoice verification can proceed for this purchase order. Corresponds to SAP EKPO.WEPOS (GR indicator). When False, invoice-only processing is permitted (e.g., for certain service orders).' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isInvoiceReceiptRequired rdf:type rdf:Property ;
    rdfs:label 'Is Invoice Receipt Required' ;
    rdfs:comment 'Indicates whether invoice verification is required for this purchase order before payment can be released. Corresponds to SAP EKPO.REPOS. When False, automatic payment may be triggered upon goods receipt (e.g., evaluated receipt settlement).' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netOrderValue rdf:type rdf:Property ;
    rdfs:label 'Net Order Value' ;
    rdfs:comment 'Total net value of the purchase order before taxes, representing the sum of all line item net amounts (quantity × unit price minus discounts). Corresponds to SAP EKKO.NETWR. Used for spend analytics, budget consumption tracking, and EBITDA impact reporting.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:poStatus rdf:type rdf:Property ;
    rdfs:label 'Po Status' ;
    rdfs:comment 'Current fulfillment lifecycle status of the purchase order reflecting goods receipt and invoice verification progress. Open: no goods received; Partially Delivered: partial goods receipt posted; Fully Delivered: all line items goods-receipted; Invoiced: vendor invoice matched and verified; Closed: three-way match complete and payment processed; Cancelled: order voided.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poType rdf:type rdf:Property ;
    rdfs:label 'Po Type' ;
    rdfs:comment 'Classification of the purchase order by procurement method. Standard: single discrete order; Blanket: framework release order against a master agreement; Emergency: expedited order bypassing standard approval workflow; Consignment: vendor-managed inventory arrangement; Service: service entry sheet-based order for labor or managed services. Corresponds to SAP EKKO.BSART.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procurementCategory rdf:type rdf:Property ;
    rdfs:label 'Procurement Category' ;
    rdfs:comment 'Business category of goods or services being procured. Examples include venue operations, broadcast equipment, merchandise inventory, event services, technology, facilities maintenance (HVAC/BMS), and catering. Supports spend analytics and category management. [ENUM-REF-CANDIDATE: venue_operations|broadcast_equipment|merchandise_inventory|event_services|technology|facilities_maintenance|catering|security|transportation|marketing — promote to reference product]' ;
    rdfs:domain ind:Partner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchasingGroupCode rdf:type rdf:Property ;
    rdfs:label 'Purchasing Group Code' ;
    rdfs:comment 'SAP purchasing group (buyer group) code identifying the individual buyer or team responsible for this purchase order. Corresponds to EKKO.EKGRP. Used for buyer workload analysis and procurement accountability.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchasingOrgCode rdf:type rdf:Property ;
    rdfs:label 'Purchasing Org Code' ;
    rdfs:comment 'SAP purchasing organization code responsible for negotiating and managing this purchase order. Corresponds to EKKO.EKORG. Represents the organizational unit (e.g., league office, venue group, broadcast division) with procurement authority.' ;
    rdfs:domain ind:Partner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rfpId rdf:type rdf:Property ;
    rdfs:label 'Rfp Id' ;
    rdfs:comment 'Unique surrogate identifier for the Request for Proposal record in the partner domain. Primary key for the rfp data product.' ;
    rdfs:domain ind:Partner ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Rfp .

ind:awardedVendorId rdf:type rdf:Property ;
    rdfs:label 'Awarded Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: rfp currently stores the winning vendor only as awarded_vendor_name (STRING), which is a denormalized string. Adding awarded_vendor_id → vendor.vendor_id normalizes this to a proper FK, enabling joins' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:sourcingLeadEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Sourcing Lead Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: RFP sourcing in sports-entertainment (broadcast rights, venue operations, merchandise) is led by a specific employee accountable for the procurement process. Linking to employee enables workload repor' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:awardedContractValue rdf:type rdf:Property ;
    rdfs:label 'Awarded Contract Value' ;
    rdfs:comment 'Actual contract value agreed with the winning vendor upon award. May differ from the estimated contract value. Null until the RFP reaches Awarded status. Used for financial commitment tracking and EBITDA impact analysis.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastRightsInvolved rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Involved' ;
    rdfs:comment 'Indicates whether the procurement involves broadcast technology, OTT platform services, or media rights distribution infrastructure. Triggers additional FCC and DRM compliance review steps.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clarificationDeadline rdf:type rdf:Property ;
    rdfs:label 'Clarification Deadline' ;
    rdfs:comment 'Last date by which prospective vendors may submit written questions or requests for clarification on the RFP requirements. Supports transparent and compliant procurement.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractCurrency rdf:type rdf:Property ;
    rdfs:label 'Contract Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the estimated and awarded contract values are denominated (e.g., USD, GBP, EUR). Supports multi-currency procurement across global markets.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractTermMonths rdf:type rdf:Property ;
    rdfs:label 'Contract Term Months' ;
    rdfs:comment 'Expected duration of the resulting contract in whole months. Used for financial planning, SLA scheduling, and renewal forecasting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deliveryLocation rdf:type rdf:Property ;
    rdfs:label 'Delivery Location' ;
    rdfs:comment 'Primary location or venue where contracted services or goods are to be delivered or performed (e.g., stadium name, broadcast facility, distribution centre). Relevant for venue services, merchandise, and broadcast technology procurement.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedContractValue rdf:type rdf:Property ;
    rdfs:label 'Estimated Contract Value' ;
    rdfs:comment 'Internal estimate of the total contract value expected to result from this RFP, expressed in the contract currency. Used for budget planning, approval thresholds, and financial forecasting in Workday Adaptive Planning.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:evaluationCriteria rdf:type rdf:Property ;
    rdfs:label 'Evaluation Criteria' ;
    rdfs:comment 'Structured description of the criteria used to score and rank vendor proposals (e.g., price weighting, technical capability, SLA commitments, sustainability, financial stability). May reference a scoring matrix document.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationStartDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Start Date' ;
    rdfs:comment 'Date on which the formal evaluation of submitted vendor proposals begins. Marks the transition from the Issued to Evaluation lifecycle stage.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isIncumbentEligible rdf:type rdf:Property ;
    rdfs:label 'Is Incumbent Eligible' ;
    rdfs:comment 'Indicates whether the current incumbent vendor is permitted to participate in this RFP. False may indicate a mandatory market test or conflict-of-interest exclusion.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuingDepartment rdf:type rdf:Property ;
    rdfs:label 'Issuing Department' ;
    rdfs:comment 'Name of the internal business unit or department that initiated and owns the RFP (e.g., Broadcast Operations, Venue Management, IT, Finance, Merchandise). Drives accountability and approval routing.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Osha Compliance Required' ;
    rdfs:comment 'Indicates whether the vendor must demonstrate OSHA compliance for on-site work at venues or facilities. Applicable for construction, HVAC, BMS, and venue operations procurement.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pciDssRequired rdf:type rdf:Property ;
    rdfs:label 'Pci Dss Required' ;
    rdfs:comment 'Indicates whether the vendor must demonstrate PCI-DSS compliance as part of the evaluation criteria. Applicable for ticketing, POS, and payment processing technology procurement.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priceWeightPct rdf:type rdf:Property ;
    rdfs:label 'Price Weight Pct' ;
    rdfs:comment 'Percentage weight assigned to price/cost in the overall vendor evaluation scoring model. Together with technical and other weights, must sum to 100%. Supports transparent and auditable procurement scoring.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:procurementMethod rdf:type rdf:Property ;
    rdfs:label 'Procurement Method' ;
    rdfs:comment 'Method used to conduct the procurement. Open: any vendor may respond; Restricted: only pre-qualified vendors invited; Sole Source: single vendor without competition; Negotiated: direct negotiation with selected vendors.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposalsReceivedCount rdf:type rdf:Property ;
    rdfs:label 'Proposals Received Count' ;
    rdfs:comment 'Actual number of vendor proposals received by the submission deadline. Compared against vendors_invited_count to measure vendor engagement and market competitiveness.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresNda rdf:type rdf:Property ;
    rdfs:label 'Requires Nda' ;
    rdfs:comment 'Indicates whether vendors must execute a Non-Disclosure Agreement (NDA) before receiving the full RFP documentation. Common for broadcast rights, IP-sensitive technology, and NIL-related procurement.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rfpDescription rdf:type rdf:Property ;
    rdfs:label 'Rfp Description' ;
    rdfs:comment 'Detailed narrative describing the business need, scope of work, deliverables, and objectives of the procurement. Used by evaluators and vendors to understand requirements.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rfpNumber rdf:type rdf:Property ;
    rdfs:label 'Rfp Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned to the RFP at issuance, used in all vendor communications and procurement correspondence (e.g., RFP-2024-00123). Aligns with SAP MM purchasing document numbering.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rfpStatus rdf:type rdf:Property ;
    rdfs:label 'Rfp Status' ;
    rdfs:comment 'Current lifecycle state of the RFP. Draft: under internal preparation; Issued: distributed to vendors; Evaluation: proposals under review; Awarded: contract awarded to winning vendor; Cancelled: procurement discontinued.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaWeightPct rdf:type rdf:Property ;
    rdfs:label 'Sla Weight Pct' ;
    rdfs:comment 'Percentage weight assigned to Service Level Agreement (SLA) commitments in the vendor evaluation scoring model. Reflects the operational importance of service reliability for broadcast, venue, and IT procurement.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sustainabilityWeightPct rdf:type rdf:Property ;
    rdfs:label 'Sustainability Weight Pct' ;
    rdfs:comment 'Percentage weight assigned to environmental and social sustainability criteria in the vendor evaluation scoring model. Aligns with ISO 20121 Event Sustainability Management requirements.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:technicalWeightPct rdf:type rdf:Property ;
    rdfs:label 'Technical Weight Pct' ;
    rdfs:comment 'Percentage weight assigned to technical capability and solution quality in the vendor evaluation scoring model. Complements price_weight_pct and other criteria weights.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vendorsInvitedCount rdf:type rdf:Property ;
    rdfs:label 'Vendors Invited Count' ;
    rdfs:comment 'Total number of prospective vendors formally invited to respond to this RFP. Supports competitive procurement governance and sourcing strategy analysis.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rfpResponseId rdf:type rdf:Property ;
    rdfs:label 'Rfp Response Id' ;
    rdfs:comment 'Unique surrogate identifier for each vendor bid submission in response to an issued RFP. Primary key for the rfp_response data product.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:awardJustification rdf:type rdf:Property ;
    rdfs:label 'Award Justification' ;
    rdfs:comment 'Free-text narrative provided by the procurement evaluator documenting the rationale for recommending or not recommending this bid for contract award. Required for procurement governance and regulatory audit trails.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bestAndFinalOfferFlag rdf:type rdf:Property ;
    rdfs:label 'Best And Final Offer Flag' ;
    rdfs:comment 'Indicates whether this submission represents the vendor\'s Best and Final Offer (BAFO) following negotiation rounds. BAFO submissions are the definitive pricing and terms used for final award decisions.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bidValidityDate rdf:type rdf:Property ;
    rdfs:label 'Bid Validity Date' ;
    rdfs:comment 'The date until which the vendor\'s bid submission remains valid and binding. After this date, the vendor may revise pricing or withdraw the offer. Critical for procurement timeline management.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:clarificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Clarification Due Date' ;
    rdfs:comment 'The deadline by which the vendor must respond to any clarification requests raised by the procurement team. Null if no clarification has been requested.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:clarificationRequested rdf:type rdf:Property ;
    rdfs:label 'Clarification Requested' ;
    rdfs:comment 'Indicates whether the procurement team has issued a formal clarification request to the vendor regarding their bid submission. Tracks the need for additional information before evaluation can be completed.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialComplianceScore rdf:type rdf:Property ;
    rdfs:label 'Commercial Compliance Score' ;
    rdfs:comment 'Numeric score (0–100) assigned by the evaluation panel reflecting the degree to which the vendor\'s bid meets the commercial requirements of the RFP, including pricing competitiveness, payment terms, and contractual risk allocation.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractDurationDays rdf:type rdf:Property ;
    rdfs:label 'Contract Duration Days' ;
    rdfs:comment 'The total number of calendar days the vendor proposes for the contract or service engagement period, from start date to delivery date. Used for comparative timeline evaluation across bids.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disqualificationReason rdf:type rdf:Property ;
    rdfs:label 'Disqualification Reason' ;
    rdfs:comment 'Reason code explaining why a bid was disqualified or rejected during the evaluation process. Null if the bid was not disqualified. [ENUM-REF-CANDIDATE: non_compliant_technical|non_compliant_commercial|late_submission|incomplete_documentation|conflict_of_interest|debarred_vendor|pricing_anomaly|other — promote to reference product]' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diversityCertification rdf:type rdf:Property ;
    rdfs:label 'Diversity Certification' ;
    rdfs:comment 'Vendor\'s declared diversity or inclusion certification status as submitted in the bid. Used to support Sports Entertainment\'s supplier diversity programme and ESG reporting obligations. [ENUM-REF-CANDIDATE: minority_owned|women_owned|veteran_owned|disability_owned|small_business|none|not_disclosed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationMethodology rdf:type rdf:Property ;
    rdfs:label 'Evaluation Methodology' ;
    rdfs:comment 'The procurement evaluation approach applied to score and rank this bid submission (e.g., weighted criteria scoring for broadcast rights bids, lowest price for commodity merchandise supply).' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationRound rdf:type rdf:Property ;
    rdfs:label 'Evaluation Round' ;
    rdfs:comment 'Sequential round number of the procurement evaluation process in which this bid was assessed (e.g., 1 = initial screening, 2 = technical deep-dive, 3 = best and final offer). Supports multi-stage procurement workflows.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evaluatorNotes rdf:type rdf:Property ;
    rdfs:label 'Evaluator Notes' ;
    rdfs:comment 'Structured or free-text notes recorded by the assigned evaluator during the bid review process, capturing observations on vendor capability, risk factors, and compliance gaps.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gdprComplianceConfirmed rdf:type rdf:Property ;
    rdfs:label 'Gdpr Compliance Confirmed' ;
    rdfs:comment 'Indicates whether the vendor has confirmed compliance with GDPR data protection requirements as part of their bid submission. Mandatory for technology vendors and any vendor processing fan or employee personal data in EU markets.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceCoverageConfirmed rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Confirmed' ;
    rdfs:comment 'Indicates whether the vendor has confirmed adequate insurance coverage (public liability, professional indemnity, workers\' compensation) as required by the RFP specification. Mandatory for venue operations and event services.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAwardRecommended rdf:type rdf:Property ;
    rdfs:label 'Is Award Recommended' ;
    rdfs:comment 'Indicates whether the procurement evaluation team has formally recommended this bid for contract award. Supports procurement governance and audit trail documentation.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isShortlisted rdf:type rdf:Property ;
    rdfs:label 'Is Shortlisted' ;
    rdfs:comment 'Indicates whether this vendor bid has been shortlisted for further negotiation or final award consideration following the initial evaluation round.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overallEvaluationScore rdf:type rdf:Property ;
    rdfs:label 'Overall Evaluation Score' ;
    rdfs:comment 'Weighted composite score combining technical, commercial, and SLA compliance scores as determined by the procurement evaluation methodology. Used for bid ranking and shortlisting decisions.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTerms rdf:type rdf:Property ;
    rdfs:label 'Payment Terms' ;
    rdfs:comment 'The vendor\'s proposed payment schedule and conditions (e.g., Net 30, 50% upfront / 50% on delivery, milestone-based). Captured as submitted in the bid for commercial evaluation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pciDssComplianceConfirmed rdf:type rdf:Property ;
    rdfs:label 'Pci Dss Compliance Confirmed' ;
    rdfs:comment 'Indicates whether the vendor has confirmed PCI-DSS compliance for any payment processing or cardholder data handling scope included in their bid. Required for ticketing, POS, and merchandise technology vendors.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priceBasis rdf:type rdf:Property ;
    rdfs:label 'Price Basis' ;
    rdfs:comment 'The commercial pricing model under which the vendor\'s proposed price is structured (e.g., fixed fee for a broadcast production contract, unit rate for merchandise supply, revenue share for venue concessions).' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Proposed Delivery Date' ;
    rdfs:comment 'The date by which the vendor commits to delivering the full scope of services or goods as specified in the RFP. Used for timeline evaluation and SLA benchmarking.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proposedPrice rdf:type rdf:Property ;
    rdfs:label 'Proposed Price' ;
    rdfs:comment 'The gross base price proposed by the vendor for delivering the contracted scope of services or goods as specified in the RFP. Expressed in the currency indicated by currency_code.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proposedStartDate rdf:type rdf:Property ;
    rdfs:label 'Proposed Start Date' ;
    rdfs:comment 'The date the vendor proposes to commence service delivery or project mobilisation. Distinct from the delivery/completion date; used for scheduling and resource planning.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responseDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Response Document Reference' ;
    rdfs:comment 'Reference identifier or URL pointing to the vendor\'s full bid submission document stored in the Digital Asset Management (DAM) system or document repository. Enables retrieval of the original submission for audit and legal purposes.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Response Reference Number' ;
    rdfs:comment 'Externally-visible alphanumeric reference number assigned to this bid submission, used in vendor correspondence and procurement audit trails. Format: RFP-RESP-YYYY-NNNNNN.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaComplianceScore rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Score' ;
    rdfs:comment 'Numeric score (0–100) reflecting how well the vendor\'s proposed SLA terms align with Sports Entertainment\'s minimum service level requirements, including uptime, response times, and penalty clauses.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subcontractingFlag rdf:type rdf:Property ;
    rdfs:label 'Subcontracting Flag' ;
    rdfs:comment 'Indicates whether the vendor\'s bid includes the use of subcontractors for any portion of the scope. Relevant for risk assessment, compliance vetting, and OSHA/ADA contractor obligations.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subcontractorDetails rdf:type rdf:Property ;
    rdfs:label 'Subcontractor Details' ;
    rdfs:comment 'Description of any proposed subcontractors, their roles, and the percentage of scope they will deliver. Populated only when subcontracting_flag is True.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionStatus rdf:type rdf:Property ;
    rdfs:label 'Submission Status' ;
    rdfs:comment 'Current lifecycle state of the vendor bid submission within the procurement evaluation workflow. [ENUM-REF-CANDIDATE: draft|submitted|under_review|shortlisted|rejected|awarded|withdrawn — promote to reference product]' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sustainabilityScore rdf:type rdf:Property ;
    rdfs:label 'Sustainability Score' ;
    rdfs:comment 'Numeric score (0–100) reflecting the vendor\'s environmental and social sustainability credentials as assessed against ISO 20121 Event Sustainability Management criteria. Increasingly weighted in Sports Entertainment procurement decisions.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:technicalComplianceScore rdf:type rdf:Property ;
    rdfs:label 'Technical Compliance Score' ;
    rdfs:comment 'Numeric score (0–100) assigned by the evaluation panel reflecting the degree to which the vendor\'s bid meets the technical requirements specified in the RFP (e.g., broadcast infrastructure capability, venue technology standards, IT system compatibility).' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:warrantyPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Warranty Period Days' ;
    rdfs:comment 'Number of calendar days of warranty or defect liability coverage proposed by the vendor post-delivery. Relevant for technology, equipment, and infrastructure procurement in venue and broadcast operations.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentOrderServiceOrderId rdf:type rdf:Property ;
    rdfs:label 'Parent Order Service Order Id' ;
    rdfs:comment 'Self-referencing identifier linking this service order to a parent order when it is a sub-order or follow-up remediation order. Enables hierarchical order tracking for complex multi-phase service engagements.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceOrder .

ind:accessCredentialRequired rdf:type rdf:Property ;
    rdfs:label 'Access Credential Required' ;
    rdfs:comment 'Indicates whether vendor personnel require special venue access credentials (e.g., field-level passes, broadcast compound access, restricted backstage) to perform this service. Triggers credential issuance workflow with venue operations.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:actualEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Actual End Datetime' ;
    rdfs:comment 'The actual date and time the vendor completed service delivery. Used to calculate actual service duration, overtime charges, and SLA performance metrics.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Actual Start Datetime' ;
    rdfs:comment 'The actual date and time the vendor commenced service delivery on-site. Compared against requested_start_datetime to calculate schedule adherence and SLA compliance.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:approvedDatetime rdf:type rdf:Property ;
    rdfs:label 'Approved Datetime' ;
    rdfs:comment 'The date and time at which the service order was formally approved by the authorized manager. Marks the transition from \'submitted\' to \'confirmed\' status and triggers vendor notification.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:crewSizeActual rdf:type rdf:Property ;
    rdfs:label 'Crew Size Actual' ;
    rdfs:comment 'The actual number of vendor personnel who reported on-site to fulfill the service order. Compared against crew_size_required to identify under-staffing incidents and vendor compliance issues.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crewSizeRequired rdf:type rdf:Property ;
    rdfs:label 'Crew Size Required' ;
    rdfs:comment 'The minimum number of vendor personnel required to fulfill this service order. Used for workforce planning, venue access credentialing, and safety compliance headcount verification.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:permitReference rdf:type rdf:Property ;
    rdfs:label 'Permit Reference' ;
    rdfs:comment 'Reference number for any regulatory permit, license, or authorization required to perform the service (e.g., pyrotechnics permit, electrical work permit, food service license). Supports compliance audit trails.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postServiceNotes rdf:type rdf:Property ;
    rdfs:label 'Post Service Notes' ;
    rdfs:comment 'Free-text qualitative feedback recorded by the quality sign-off authority following service completion. Captures observations on vendor performance, issues encountered, and recommendations for future orders.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postServiceScore rdf:type rdf:Property ;
    rdfs:label 'Post Service Score' ;
    rdfs:comment 'Numeric quality and performance score (0.00–10.00) assigned to the vendor following service completion. Assessed by the quality sign-off authority across dimensions such as timeliness, crew professionalism, and output quality. Feeds into vendor performance scorecards.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualitySignoffAuthority rdf:type rdf:Property ;
    rdfs:label 'Quality Signoff Authority' ;
    rdfs:comment 'The name or role title of the Sports Entertainment employee or designated representative who is authorized to approve service completion and sign off on quality acceptance. Required before actual_cost is released for payment.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualitySignoffDatetime rdf:type rdf:Property ;
    rdfs:label 'Quality Signoff Datetime' ;
    rdfs:comment 'The date and time at which the quality sign-off authority formally accepted and approved the completed service. Triggers the service entry sheet posting in SAP and releases the vendor invoice for payment.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:requestedEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Requested End Datetime' ;
    rdfs:comment 'The date and time by which the vendor must complete service delivery. Used for SLA compliance measurement and event-day deadline enforcement.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:requestedStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Requested Start Datetime' ;
    rdfs:comment 'The date and time by which the vendor is required to commence service delivery. For event-day orders, this is typically tied to venue open or broadcast go-live time. Stored in ISO 8601 format with timezone offset.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:safetyIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Flag' ;
    rdfs:comment 'Indicates whether a safety incident (injury, near-miss, equipment failure, hazardous condition) was reported during the execution of this service order. Triggers mandatory OSHA incident reporting and internal safety review workflows.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyIncidentReference rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Reference' ;
    rdfs:comment 'The OSHA incident report or internal safety case reference number associated with a safety event during this service order. Populated only when safety_incident_flag is True. Enables cross-referencing with the compliance incident management system.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceCategory rdf:type rdf:Property ;
    rdfs:label 'Service Category' ;
    rdfs:comment 'High-level grouping of the service type used for spend analytics, budget allocation, and vendor performance dashboards. Rolls up individual service types into operational categories. [ENUM-REF-CANDIDATE: broadcast|facility|security|hospitality|logistics|production|medical|grounds — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceLocationZone rdf:type rdf:Property ;
    rdfs:label 'Service Location Zone' ;
    rdfs:comment 'The specific zone, section, or area within the venue where the service is to be performed (e.g., \'Broadcast Compound\', \'North Concourse\', \'Field Level\', \'Loading Dock B\'). Supports crew routing, access credentialing, and venue operations coordination.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaBreached rdf:type rdf:Property ;
    rdfs:label 'Sla Breached' ;
    rdfs:comment 'Indicates whether the vendor failed to meet the contractual SLA completion deadline for this service order. Set to True when actual_end_datetime exceeds the SLA-defined deadline. Triggers vendor performance deductions.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaCompletionHours rdf:type rdf:Property ;
    rdfs:label 'Sla Completion Hours' ;
    rdfs:comment 'The contractually agreed maximum number of hours from service order issuance to full service completion. Used to determine SLA breach status and vendor penalty triggers.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaResponseHours rdf:type rdf:Property ;
    rdfs:label 'Sla Response Hours' ;
    rdfs:comment 'The contractually agreed maximum number of hours from service order issuance to vendor on-site commencement. Derived from the governing vendor contract SLA terms. Used for SLA breach monitoring.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specialRequirements rdf:type rdf:Property ;
    rdfs:label 'Special Requirements' ;
    rdfs:comment 'Free-text field capturing any special operational, safety, or regulatory requirements specific to this service order (e.g., pyrotechnics permit number, HVAC shutdown window, broadcast frequency coordination, food handler certification requirement).' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderDescription rdf:type rdf:Property ;
    rdfs:label 'Work Order Description' ;
    rdfs:comment 'Detailed narrative description of the scope of work to be performed under this service order. Specifies deliverables, technical requirements, equipment to be used, and any special instructions for the vendor crew.' ;
    rdfs:domain ind:ServiceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Sla Definition Id' ;
    rdfs:comment 'Primary key for sla_definition' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SlaDefinition .

ind:applicableEventType rdf:type rdf:Property ;
    rdfs:label 'Applicable Event Type' ;
    rdfs:comment 'The type of sports or entertainment event to which this SLA applies (e.g., \'NFL Regular Season\', \'PPV Boxing\', \'Concert\', \'FIFA World Cup Qualifier\'). Allows SLA terms to vary by event tier and commercial significance. Null if the SLA applies universally across all events.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationTier rdf:type rdf:Property ;
    rdfs:label 'Escalation Tier' ;
    rdfs:comment 'The escalation level triggered when this SLA is breached. Tier_1 routes to the vendor account manager; Tier_2 escalates to the vendor operations director; Tier_3 involves legal/procurement; Executive escalates to C-suite. Drives automated alerting workflows.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gracePeriodValue rdf:type rdf:Property ;
    rdfs:label 'Grace Period Value' ;
    rdfs:comment 'The allowable tolerance period or buffer before a breach is formally recorded and penalties are triggered. Expressed in the unit defined by metric_unit (e.g., 5 minutes grace on a 30-minute response time SLA). Null if no grace period applies.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internalOwnerCode rdf:type rdf:Property ;
    rdfs:label 'Internal Owner Code' ;
    rdfs:comment 'Code identifying the internal Sports Entertainment department or cost centre responsible for managing and enforcing this SLA (e.g., \'BROADCAST-OPS\', \'VENUE-MGMT\', \'IT-INFRA\', \'PROCUREMENT\'). Enables SLA ownership accountability reporting.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEventDaySla rdf:type rdf:Property ;
    rdfs:label 'Is Event Day Sla' ;
    rdfs:comment 'Indicates whether this SLA definition applies specifically during live event windows (True) or covers standard operational periods (False). Event-day SLAs typically carry stricter thresholds and faster escalation for broadcast uptime, venue HVAC, and catering services.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measurementFrequency rdf:type rdf:Property ;
    rdfs:label 'Measurement Frequency' ;
    rdfs:comment 'How frequently vendor performance against this SLA is measured and recorded (e.g., real_time for broadcast uptime monitoring, daily for catering delivery, monthly for IT infrastructure availability). Drives the cadence of SLA compliance reporting.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricType rdf:type rdf:Property ;
    rdfs:label 'Metric Type' ;
    rdfs:comment 'The type of performance metric this SLA definition measures. Determines how vendor compliance is evaluated: uptime_pct for broadcast/IT availability, response_time for incident acknowledgement, resolution_time for fault closure, delivery_lead_time for merchandise/catering supply, availability_pct for venue services, error_rate_pct for broadcast signal quality.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyCapValue rdf:type rdf:Property ;
    rdfs:label 'Penalty Cap Value' ;
    rdfs:comment 'Maximum cumulative penalty amount that can be applied to the vendor under this SLA within a single reporting period. Protects against disproportionate penalties in long-term vendor relationships. Expressed in penalty_currency_code.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyStructureType rdf:type rdf:Property ;
    rdfs:label 'Penalty Structure Type' ;
    rdfs:comment 'The type of financial or contractual remedy applied when the vendor breaches this SLA. Fixed_fee applies a flat monetary penalty; percentage_of_contract deducts a percentage of the contract value; service_credit issues a credit against future invoices; termination_right grants the right to terminate the contract; none indicates no financial penalty.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyValue rdf:type rdf:Property ;
    rdfs:label 'Penalty Value' ;
    rdfs:comment 'The monetary amount or percentage rate applied as a penalty upon SLA breach. Interpretation depends on penalty_structure_type: a flat currency amount for fixed_fee, a percentage rate (0–100) for percentage_of_contract or service_credit. Null if penalty_structure_type is \'none\'.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Reporting Period' ;
    rdfs:comment 'The aggregation window over which SLA compliance is formally reported to stakeholders and used for penalty calculation (e.g., monthly for broadcast uptime, quarterly for venue maintenance). May differ from measurement_frequency.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceSubcategory rdf:type rdf:Property ;
    rdfs:label 'Service Subcategory' ;
    rdfs:comment 'Granular classification within the service category (e.g., \'OTT Stream Delivery\' under Broadcast, \'HVAC Preventive Maintenance\' under Venue Operations, \'POS System Uptime\' under IT Infrastructure). Enables fine-grained SLA reporting.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaCode rdf:type rdf:Property ;
    rdfs:label 'Sla Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this SLA definition across procurement and vendor management systems. Used as the business-facing reference in contracts and vendor communications (e.g., SLA-BCAST-20240001).' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaDescription rdf:type rdf:Property ;
    rdfs:label 'Sla Description' ;
    rdfs:comment 'Free-text narrative describing the scope, obligations, and context of this SLA definition. Provides business users with qualitative context beyond the structured metric fields (e.g., \'Governs uptime of OTT streaming infrastructure during live broadcast windows for Tier 1 RSN partners\').' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaName rdf:type rdf:Property ;
    rdfs:label 'Sla Name' ;
    rdfs:comment 'Human-readable descriptive name for the SLA definition (e.g., \'Broadcast Uptime SLA — Tier 1 OTT Partner\', \'Venue HVAC Maintenance Response SLA\'). Used in reporting dashboards and vendor scorecards.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaStatus rdf:type rdf:Property ;
    rdfs:label 'Sla Status' ;
    rdfs:comment 'Current lifecycle state of the SLA definition. Draft indicates the SLA is under negotiation; active means it is currently enforced; suspended means enforcement is temporarily paused; expired means the effective period has ended; terminated means the SLA has been cancelled.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaVersion rdf:type rdf:Property ;
    rdfs:label 'Sla Version' ;
    rdfs:comment 'Version identifier for this SLA definition (e.g., v1.0, v2.3). Tracks amendments and renegotiations over the contract lifecycle. Enables audit trail of SLA term changes.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorResponsibilityCode rdf:type rdf:Property ;
    rdfs:label 'Vendor Responsibility Code' ;
    rdfs:comment 'Code identifying the specific vendor team, department, or contact role accountable for delivering against this SLA (e.g., \'OPS-NOC\' for network operations centre, \'FIELD-TECH\' for on-site technicians). Used for vendor escalation routing.' ;
    rdfs:domain ind:SlaDefinition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaMeasurementId rdf:type rdf:Property ;
    rdfs:label 'Sla Measurement Id' ;
    rdfs:comment 'Unique surrogate identifier for each SLA performance measurement record in the Sports Entertainment partner domain.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measurementTakenByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Measurement Taken By Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: SLA measurements for broadcast uptime, venue services, and event-day vendor performance are recorded by specific employees. Linking to employee enables measurement integrity audits and accountability ' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:vendorScorecardId rdf:type rdf:Property ;
    rdfs:label 'Vendor Scorecard Id' ;
    rdfs:comment 'Reference to the vendor performance scorecard period into which this measurement rolls up. Enables aggregation of individual measurements into periodic vendor performance scorecards for executive reporting and contract reviews.' ;
    rdfs:domain ind:Partner ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VendorScorecard .

ind:breachFlag rdf:type rdf:Property ;
    rdfs:label 'Breach Flag' ;
    rdfs:comment 'Indicates whether the vendor\'s actual performance breached the contractually agreed SLA threshold during this measurement period. True = breach occurred; False = SLA met or exceeded.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:breachSeverity rdf:type rdf:Property ;
    rdfs:label 'Breach Severity' ;
    rdfs:comment 'Severity classification of the SLA breach when breach_flag is True: minor (within tolerance band), major (significant deviation requiring escalation), critical (severe breach triggering immediate remediation and potential contract penalty). Null when no breach.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastEventType rdf:type rdf:Property ;
    rdfs:label 'Broadcast Event Type' ;
    rdfs:comment 'For broadcast-related SLA measurements, classifies the type of broadcast event being monitored (e.g., live_game, PPV (Pay-Per-View), OTT (Over-The-Top Streaming) stream, RSN (Regional Sports Network) broadcast). Null for non-broadcast service categories.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consecutiveBreachCount rdf:type rdf:Property ;
    rdfs:label 'Consecutive Breach Count' ;
    rdfs:comment 'Running count of consecutive measurement periods in which this SLA metric has been breached without recovery. Used to trigger escalation thresholds and cumulative penalty clauses in vendor contracts.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataCompletenessPercentage rdf:type rdf:Property ;
    rdfs:label 'Data Completeness Percentage' ;
    rdfs:comment 'Percentage of the measurement period for which actual performance data was successfully collected (e.g., 95.0 means data was available for 95% of the period). Values below threshold may invalidate the measurement per SLA contract terms.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeRaisedFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Raised Flag' ;
    rdfs:comment 'Indicates whether the vendor has formally disputed the accuracy or validity of this SLA measurement. When True, measurement_status transitions to \'disputed\' and the record is held from penalty processing pending resolution.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:forceMajeureFlag rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Flag' ;
    rdfs:comment 'Indicates whether the SLA breach or underperformance during this period was attributed to a force majeure event (e.g., natural disaster, power grid failure, government-mandated shutdown). Force majeure breaches are typically excluded from penalty calculations per contract terms.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measurementConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Measurement Confidence Score' ;
    rdfs:comment 'A 0–100 score indicating the reliability and completeness of the data used to produce this measurement (e.g., 100 = fully automated sensor data with no gaps; 60 = partial manual data with some estimated values). Supports data quality governance and dispute resolution.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementPeriodType rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Type' ;
    rdfs:comment 'Granularity of the measurement window: daily (24-hour rolling), weekly (7-day), monthly (calendar month), or per_event (scoped to a single Sports Entertainment event).' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Measurement Reference Number' ;
    rdfs:comment 'Externally-visible business identifier for this measurement record, used in vendor communications, audit trails, and penalty dispute resolution. Format: SLA-MEAS-YYYY-NNNNNN.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Measurement Source System' ;
    rdfs:comment 'The system or method used to capture the actual performance data for this measurement (e.g., network_monitoring for broadcast uptime, iot_sensor for HVAC readings, manual_inspection for security deployment checks). Supports data lineage and audit. [ENUM-REF-CANDIDATE: network_monitoring|iot_sensor|manual_inspection|ticketing_system|broadcast_monitoring|pos_system|third_party_audit — promote to reference product]' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyTriggerFlag rdf:type rdf:Property ;
    rdfs:label 'Penalty Trigger Flag' ;
    rdfs:comment 'Auto-generated flag indicating whether this measurement record has triggered a financial penalty calculation workflow per the vendor contract terms. True = penalty workflow initiated; False = no penalty triggered.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:periodEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Period End Timestamp' ;
    rdfs:comment 'The exact date and time marking the end of the SLA measurement window. Together with period_start_timestamp defines the full measurement interval.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:periodStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Period Start Timestamp' ;
    rdfs:comment 'The exact date and time marking the beginning of the SLA measurement window. Used to align measurements with event schedules and broadcast windows.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:remediationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Remediation Required Flag' ;
    rdfs:comment 'Indicates whether the vendor is contractually required to submit a remediation plan following this measurement breach. Drives the remediation workflow in vendor performance management.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaMetricCode rdf:type rdf:Property ;
    rdfs:label 'Sla Metric Code' ;
    rdfs:comment 'Standardized code identifying the specific SLA metric being measured (e.g., BROADCAST_UPTIME_PCT, HVAC_RESPONSE_MIN, CATERING_DELIVERY_PUNCTUALITY_PCT, SECURITY_DEPLOYMENT_READINESS_PCT). Drives metric-specific threshold lookups and penalty rules. [ENUM-REF-CANDIDATE: BROADCAST_UPTIME_PCT|HVAC_RESPONSE_MIN|CATERING_DELIVERY_PCT|SECURITY_READINESS_PCT|NETWORK_LATENCY_MS|TICKETING_SYSTEM_UPTIME_PCT — promote to reference product]' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaMetricName rdf:type rdf:Property ;
    rdfs:label 'Sla Metric Name' ;
    rdfs:comment 'Human-readable name of the SLA metric being measured (e.g., \'Broadcast Uptime Percentage\', \'HVAC Response Time\', \'Catering Delivery Punctuality\'). Used in vendor scorecards and executive reporting.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:variancePercentage rdf:type rdf:Property ;
    rdfs:label 'Variance Percentage' ;
    rdfs:comment 'The percentage deviation of actual_value from target_value, calculated as ((actual_value - target_value) / target_value) * 100. Negative values indicate underperformance. Used in penalty calculation workflows and vendor scorecards.' ;
    rdfs:domain ind:SlaMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:apContactEmail rdf:type rdf:Property ;
    rdfs:label 'Ap Contact Email' ;
    rdfs:comment 'Email address of the vendor\'s accounts payable or billing department. Used exclusively for invoice submission, payment remittance advice, and AP dispute resolution. Distinct from the primary operational contact.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountName rdf:type rdf:Property ;
    rdfs:label 'Bank Account Name' ;
    rdfs:comment 'Name of the bank account holder as registered with the vendor\'s financial institution. Required for payment disbursement validation and fraud prevention controls in SAP S/4HANA FI.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Account Number' ;
    rdfs:comment 'Vendor\'s bank account number used for ACH, wire transfer, or EFT payment disbursement. Stored in tokenized/encrypted form per PCI-DSS Level 1 requirements. Last 4 digits may be displayed for verification purposes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Routing Number' ;
    rdfs:comment 'American Bankers Association (ABA) routing transit number or SWIFT/BIC code for international vendors. Used to route ACH and wire transfer payments to the correct financial institution. Stored encrypted at rest per PCI-DSS requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessType rdf:type rdf:Property ;
    rdfs:label 'Business Type' ;
    rdfs:comment 'Operational classification of the vendor\'s business relationship type with Sports Entertainment. Distinguishes broadcast partners (OB, RSN affiliates), venue service providers (HVAC, BMS, catering), merchandise suppliers (manufacturing, licensing), technology vendors (SaaS, infrastructure), and contractors (project-based). [ENUM-REF-CANDIDATE: broadcast_partner|venue_service_provider|merchandise_supplier|technology_vendor|contractor|staffing_agency|logistics_provider|media_agency — promote to reference product]' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataProcessorFlag rdf:type rdf:Property ;
    rdfs:label 'Data Processor Flag' ;
    rdfs:comment 'Indicates whether this vendor processes personal data on behalf of Sports Entertainment as a data processor under GDPR Article 28 or CCPA. When True, a Data Processing Agreement (DPA) is mandatory and the vendor must be included in the data processor register.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dunsNumber rdf:type rdf:Property ;
    rdfs:label 'Duns Number' ;
    rdfs:comment 'Nine-digit Dun & Bradstreet Data Universal Numbering System (D-U-N-S) identifier for the vendor\'s legal entity. Used for credit risk assessment, vendor due diligence, and global entity resolution across procurement systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCertExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Insurance Cert Expiry Date' ;
    rdfs:comment 'Expiration date of the vendor\'s general liability, professional indemnity, or workers\' compensation insurance certificate. Vendors operating at venues or events must maintain valid insurance per OSHA and ADA compliance requirements. Triggers renewal alerts in procurement workflow.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minorityOwnedFlag rdf:type rdf:Property ;
    rdfs:label 'Minority Owned Flag' ;
    rdfs:comment 'Indicates whether the vendor is a certified minority-owned business. Supports supplier diversity program reporting, ESG disclosures, and league-mandated diversity spend targets (e.g., NFL, NBA supplier diversity initiatives).' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentCurrency rdf:type rdf:Property ;
    rdfs:label 'Payment Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the vendor is paid (e.g., USD, GBP, EUR). Drives AP payment processing, FX conversion, and financial reporting in SAP S/4HANA FI.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredPurchasingOrg rdf:type rdf:Property ;
    rdfs:label 'Preferred Purchasing Org' ;
    rdfs:comment 'SAP purchasing organization code (EKORG) to which this vendor is primarily assigned. Determines which procurement team manages the vendor relationship, applicable pricing conditions, and purchasing authority levels.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCategory rdf:type rdf:Property ;
    rdfs:label 'Primary Category' ;
    rdfs:comment 'Top-level category classification from the vendor taxonomy hierarchy identifying the primary business function the vendor serves. Examples include: Broadcast Technology, Venue Facilities, Merchandise Manufacturing, IT Infrastructure, Catering, Security, Transportation, Medical. This product is the SSOT for vendor categorization — no separate category reference table exists. [ENUM-REF-CANDIDATE: broadcast_technology|venue_facilities|merchandise_manufacturing|it_infrastructure|catering|security|transportation|medical|legal|marketing|logistics — promote to reference product]' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressCity rdf:type rdf:Property ;
    rdfs:label 'Registered Address City' ;
    rdfs:comment 'City of the vendor\'s official registered business address. Used in conjunction with address line, state, and postal code for complete legal address representation.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressPostalCode rdf:type rdf:Property ;
    rdfs:label 'Registered Address Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the vendor\'s official registered business address. Used for geographic spend analysis, tax jurisdiction determination, and address validation.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressState rdf:type rdf:Property ;
    rdfs:label 'Registered Address State' ;
    rdfs:comment 'State, province, or region of the vendor\'s official registered business address. Used for state-level tax compliance, licensing requirements, and jurisdictional regulatory reporting.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationCountry rdf:type rdf:Property ;
    rdfs:label 'Registration Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction where the vendor\'s legal entity is incorporated or registered. Drives tax withholding rules, currency defaults, and regulatory compliance requirements (e.g., GDPR for EU vendors).' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapVendorNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Vendor Number' ;
    rdfs:comment 'The 10-digit vendor account number assigned in SAP S/4HANA MM (LFA1-LIFNR). Used as the cross-system reconciliation key between the data platform and the ERP system of record.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryCategory rdf:type rdf:Property ;
    rdfs:label 'Secondary Category' ;
    rdfs:comment 'Second-level category in the vendor taxonomy hierarchy providing more granular classification within the primary category (e.g., within \'Broadcast Technology\': OB Truck Services, CDN Delivery, IPTV Infrastructure). Supports hierarchical spend analysis and category management.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:smallBusinessFlag rdf:type rdf:Property ;
    rdfs:label 'Small Business Flag' ;
    rdfs:comment 'Indicates whether the vendor qualifies as a Small Business Enterprise (SBE) per SBA size standards or applicable jurisdiction thresholds. Used for supplier diversity spend tracking and government-mandated small business procurement reporting.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vendorStatus rdf:type rdf:Property ;
    rdfs:label 'Vendor Status' ;
    rdfs:comment 'Current operational status of the vendor within the procurement lifecycle. \'onboarding\' indicates the vendor is in the approval workflow; \'probation\' indicates performance concerns; \'suspended\' indicates a temporary hold pending review; \'terminated\' indicates the relationship has ended.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorTier rdf:type rdf:Property ;
    rdfs:label 'Vendor Tier' ;
    rdfs:comment 'Procurement tier designation indicating the strategic importance and preferred usage level of the vendor. \'strategic\' vendors receive priority engagement and executive sponsorship; \'preferred\' vendors are first-choice for category spend; \'approved\' vendors are qualified for use; \'probation\' vendors are under performance review.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:w9W8FormType rdf:type rdf:Property ;
    rdfs:label 'W9 W8 Form Type' ;
    rdfs:comment 'IRS tax form type on file for this vendor. W-9 for US domestic entities; W-8BEN for foreign individuals; W-8BEN-E for foreign entities; W-8ECI for foreign entities with US trade income. Required for 1099/1042-S reporting and withholding tax determination.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationBody rdf:type rdf:Property ;
    rdfs:label 'Accreditation Body' ;
    rdfs:comment 'Name of the national or international accreditation body that accredits the issuing certification body (e.g., \'UKAS\', \'ANAB\', \'DAkkS\'). Provides the chain of trust for the certification\'s credibility.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Applicable Jurisdiction' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the primary jurisdiction in which this certification is valid and enforceable (e.g., \'USA\', \'GBR\', \'EUU\' for EU-wide). Relevant for GDPR, CCPA, and other jurisdiction-specific compliance requirements.' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableVendorCategory rdf:type rdf:Property ;
    rdfs:label 'Applicable Vendor Category' ;
    rdfs:comment 'The vendor category for which this certification is relevant within Sports Entertainment\'s partner domain. Aligns with the vendor segmentation taxonomy. [ENUM-REF-CANDIDATE: broadcast_partner|venue_service_provider|merchandise_supplier|technology_vendor|third_party_contractor|food_beverage|security_services|media_production — promote to reference product]' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificateDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Certificate Document Ref' ;
    rdfs:comment 'Reference path, URL, or DAM asset identifier pointing to the stored digital copy of the certificate document in the Digital Asset Management system or document repository.' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationGrade rdf:type rdf:Property ;
    rdfs:label 'Certification Grade' ;
    rdfs:comment 'Grade, level, or tier of the certification where applicable (e.g., PCI-DSS Level 1/2/3/4, ISO 9001 Grade A/B, WADA Tier 1/2). Null if the certification type does not have a graded structure.' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationName rdf:type rdf:Property ;
    rdfs:label 'Certification Name' ;
    rdfs:comment 'Full descriptive name of the certification as issued by the certifying body (e.g., \'ISO 9001:2015 Quality Management System\', \'PCI-DSS Level 1 Service Provider\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationScope rdf:type rdf:Property ;
    rdfs:label 'Certification Scope' ;
    rdfs:comment 'Description of the specific services, processes, or business units covered by this certification as defined in the certificate document (e.g., \'Broadcast equipment supply and installation\', \'Payment processing for ticketing operations\').' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationStandardVersion rdf:type rdf:Property ;
    rdfs:label 'Certification Standard Version' ;
    rdfs:comment 'Version or edition of the standard under which the certification was issued (e.g., \'ISO 9001:2015\', \'PCI-DSS v4.0\', \'WADA Code 2021\').' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceDomain rdf:type rdf:Property ;
    rdfs:label 'Compliance Domain' ;
    rdfs:comment 'High-level compliance domain that this certification addresses. Used for grouping and reporting across the vendor compliance portfolio. [ENUM-REF-CANDIDATE: quality|data_privacy|payment_security|health_safety|accessibility|anti_doping|sustainability|diversity|financial_controls|broadcast_regulation — promote to reference product]' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysToExpiry rdf:type rdf:Property ;
    rdfs:label 'Days To Expiry' ;
    rdfs:comment 'Calculated number of calendar days remaining until the certification expiry date as of the last data refresh. Negative values indicate the certification has already expired. Used for compliance dashboards and SLA monitoring.' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:engagementBlockFlag rdf:type rdf:Property ;
    rdfs:label 'Engagement Block Flag' ;
    rdfs:comment 'Indicates whether the current certification status (e.g., expired, revoked, rejected) is actively blocking vendor engagement or contract execution. True = vendor engagement is blocked pending resolution; False = no block in effect.' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Exception Approved By' ;
    rdfs:comment 'Name or employee identifier of the authorized approver who granted the compliance exception for this certification. Populated only when exception_approved_flag is True.' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionApprovedFlag rdf:type rdf:Property ;
    rdfs:label 'Exception Approved Flag' ;
    rdfs:comment 'Indicates whether a formal compliance exception has been approved allowing vendor engagement despite a missing, expired, or non-compliant certification. True = exception approved; False = no exception in effect.' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Exception Expiry Date' ;
    rdfs:comment 'Date on which the approved compliance exception expires. After this date, the vendor must have a valid certification or a new exception must be approved.' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:issuingBody rdf:type rdf:Property ;
    rdfs:label 'Issuing Body' ;
    rdfs:comment 'Name of the organization, regulatory authority, or accreditation body that issued the certification (e.g., \'Bureau Veritas\', \'PCI Security Standards Council\', \'WADA\', \'OSHA\', \'BSI Group\').' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingBodyCountry rdf:type rdf:Property ;
    rdfs:label 'Issuing Body Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction in which the issuing body is registered or operates (e.g., \'USA\', \'GBR\', \'CHE\').' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalApplicationDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Application Date' ;
    rdfs:comment 'Date on which the vendor submitted or is expected to submit the renewal application to the issuing body. Used to track renewal pipeline and avoid certification lapses.' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalReminderDays rdf:type rdf:Property ;
    rdfs:label 'Renewal Reminder Days' ;
    rdfs:comment 'Number of calendar days before the expiry date at which the renewal reminder notification should be triggered (e.g., 90 days prior to expiry).' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalReminderFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Reminder Flag' ;
    rdfs:comment 'Indicates whether an automated renewal reminder notification has been activated for this certification. True = reminder is enabled; False = reminder is disabled.' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Flag' ;
    rdfs:comment 'Indicates whether this certification satisfies a specific Service Level Agreement (SLA) requirement in the vendor\'s contract with Sports Entertainment. True = SLA requirement met; False = SLA requirement not met.' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vendorSubmittedDate rdf:type rdf:Property ;
    rdfs:label 'Vendor Submitted Date' ;
    rdfs:comment 'Date on which the vendor submitted this certification document to Sports Entertainment\'s procurement or compliance team for review and onboarding.' ;
    rdfs:domain ind:VendorCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vendorContactId rdf:type rdf:Property ;
    rdfs:label 'Vendor Contact Id' ;
    rdfs:comment 'Unique surrogate identifier for an individual contact person associated with a vendor organization in the Sports Entertainment partner domain. Primary key for this record.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:internalAccountOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Internal Account Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Each vendor contact in sports-entertainment is managed by a specific internal employee (account manager or relationship owner). This is standard vendor relationship management — enables workload repor' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:alternateEmail rdf:type rdf:Property ;
    rdfs:label 'Alternate Email' ;
    rdfs:comment 'Secondary or backup email address for the vendor contact. Used when the primary email is unresponsive or during out-of-office periods. Particularly important for SLA escalation contacts where guaranteed reachability is critical.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Authority Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the contract_authority_limit amount (e.g., USD, EUR, GBP). Ensures correct interpretation of the authority limit in multi-currency global vendor relationships.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastDomainExpertise rdf:type rdf:Property ;
    rdfs:label 'Broadcast Domain Expertise' ;
    rdfs:comment 'Indicates whether this vendor contact has specific expertise in broadcast and media rights distribution workflows (e.g., OTT integration, RSN feeds, IPTV delivery, CDN configuration). Used to route broadcast-related technical queries and integration issues.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactRoleType rdf:type rdf:Property ;
    rdfs:label 'Contact Role Type' ;
    rdfs:comment 'Functional classification of the vendor contact\'s role within the relationship. Drives SLA escalation routing and event-day coordination workflows. Commercial = account/sales; Technical = integration/IT; Legal = contract/compliance; Operational = on-site/delivery; Escalation = designated SLA breach contact.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactStatus rdf:type rdf:Property ;
    rdfs:label 'Contact Status' ;
    rdfs:comment 'Current lifecycle status of the vendor contact record. Active contacts are eligible for SLA escalation routing and event-day coordination. Inactive or terminated contacts are retained for audit history but excluded from operational workflows.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractAuthorityLimit rdf:type rdf:Property ;
    rdfs:label 'Contract Authority Limit' ;
    rdfs:comment 'Maximum monetary value (in USD) up to which this vendor contact has authority to commit or approve on behalf of their organization. Used during procurement negotiations to determine whether escalation to a higher authority is required.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:department rdf:type rdf:Property ;
    rdfs:label 'Department' ;
    rdfs:comment 'The organizational department or business unit within the vendor company that this contact belongs to (e.g., Broadcast Operations, Legal, Finance, IT Integration, Venue Services). Supports routing of communications to the correct functional area.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doNotContactFlag rdf:type rdf:Property ;
    rdfs:label 'Do Not Contact Flag' ;
    rdfs:comment 'Indicates that this vendor contact has requested to not be contacted, or has been flagged by internal policy as off-limits for outreach (e.g., during legal disputes, contract termination proceedings). Suppresses automated communications.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gdprConsentDate rdf:type rdf:Property ;
    rdfs:label 'Gdpr Consent Date' ;
    rdfs:comment 'Date on which GDPR consent was last granted or withdrawn by the vendor contact. Required for GDPR compliance audit trails demonstrating lawful basis for data processing.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gdprConsentStatus rdf:type rdf:Property ;
    rdfs:label 'Gdpr Consent Status' ;
    rdfs:comment 'GDPR data processing consent status for vendor contacts based in EU/EEA jurisdictions. Tracks whether the contact has granted, withdrawn, or not yet provided consent for data processing activities. Not applicable for contacts outside GDPR scope.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEventDayContact rdf:type rdf:Property ;
    rdfs:label 'Is Event Day Contact' ;
    rdfs:comment 'Indicates whether this contact is designated as an on-site or on-call point of contact during live event operations. Event-day contacts are included in event coordination call sheets and venue operations runbooks.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryContact rdf:type rdf:Property ;
    rdfs:label 'Is Primary Contact' ;
    rdfs:comment 'Indicates whether this individual is the designated primary contact for the vendor organization. Only one contact per vendor per role type should be flagged as primary. Drives default routing for contract communications and SLA notifications.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSlaEscalationContact rdf:type rdf:Property ;
    rdfs:label 'Is Sla Escalation Contact' ;
    rdfs:comment 'Indicates whether this contact is designated to receive SLA breach escalation notifications. Contacts flagged true are included in automated SLA breach alert workflows and incident management routing.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jobTitle rdf:type rdf:Property ;
    rdfs:label 'Job Title' ;
    rdfs:comment 'Official job title of the vendor contact as designated by their employer organization (e.g., Account Manager, Broadcast Integration Lead, Legal Counsel, On-Site Venue Supervisor). Used to identify seniority and functional authority.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languagePreference rdf:type rdf:Property ;
    rdfs:label 'Language Preference' ;
    rdfs:comment 'Preferred language for communications with this vendor contact, expressed as an IETF BCP 47 language tag (e.g., en-US, fr-FR, es-ES, pt-BR). Supports multilingual contract negotiations and global vendor relationship management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastInteractionDate rdf:type rdf:Property ;
    rdfs:label 'Last Interaction Date' ;
    rdfs:comment 'Date of the most recent recorded business interaction with this vendor contact (meeting, call, email exchange, contract review). Used to identify dormant contacts and trigger relationship re-engagement workflows.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:linkedinProfileUrl rdf:type rdf:Property ;
    rdfs:label 'Linkedin Profile Url' ;
    rdfs:comment 'LinkedIn professional profile URL for the vendor contact. Used for relationship intelligence, background verification during onboarding, and maintaining up-to-date contact information for key account managers and technical leads.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextScheduledInteractionDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Interaction Date' ;
    rdfs:comment 'Date of the next planned business interaction with this vendor contact (e.g., quarterly business review, contract renewal discussion, SLA performance review). Supports proactive relationship management scheduling.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:officeLocation rdf:type rdf:Property ;
    rdfs:label 'Office Location' ;
    rdfs:comment 'City or office location where the vendor contact is primarily based (e.g., New York, London, Los Angeles). Used for scheduling in-person meetings, on-site visits, and understanding geographic coverage for venue service providers.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phoneDirect rdf:type rdf:Property ;
    rdfs:label 'Phone Direct' ;
    rdfs:comment 'Direct dial phone number for the vendor contact in E.164 international format. Primary voice channel for urgent SLA escalations and event-day operational coordination.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phoneMobile rdf:type rdf:Property ;
    rdfs:label 'Phone Mobile' ;
    rdfs:comment 'Mobile/cell phone number for the vendor contact in E.164 international format. Used for SMS notifications, WhatsApp, and after-hours SLA escalation when direct line is unavailable.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredCommChannel rdf:type rdf:Property ;
    rdfs:label 'Preferred Comm Channel' ;
    rdfs:comment 'The vendor contact\'s preferred method of communication for routine business interactions. Informs CRM outreach strategy and ensures communications are delivered through the most effective channel for relationship management.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipEndDate rdf:type rdf:Property ;
    rdfs:label 'Relationship End Date' ;
    rdfs:comment 'Date on which this vendor contact\'s relationship with Sports Entertainment was formally ended (e.g., due to role change, departure from vendor organization, or contract termination). Null for currently active contacts.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:relationshipStartDate rdf:type rdf:Property ;
    rdfs:label 'Relationship Start Date' ;
    rdfs:comment 'Date on which this vendor contact was first established as an active point of contact for Sports Entertainment. Tracks the tenure of the relationship for account management and vendor performance reviews.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:salutation rdf:type rdf:Property ;
    rdfs:label 'Salutation' ;
    rdfs:comment 'Formal salutation or honorific for the vendor contact (e.g., Mr, Ms, Dr, Prof). Used in formal written correspondence, contract cover letters, and executive-level communications.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapVendorContactRef rdf:type rdf:Property ;
    rdfs:label 'Sap Vendor Contact Ref' ;
    rdfs:comment 'Reference identifier for this contact in SAP S/4HANA vendor contact records (KNVK table equivalent for vendor contacts). Supports reconciliation between financial procurement workflows and the partner domain data product.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seniorityLevel rdf:type rdf:Property ;
    rdfs:label 'Seniority Level' ;
    rdfs:comment 'Seniority classification of the vendor contact within their organization. Used to determine appropriate escalation paths — executive-level contacts are engaged for strategic issues, while operational contacts handle day-to-day coordination.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorCrmContactCode rdf:type rdf:Property ;
    rdfs:label 'Vendor Crm Contact Code' ;
    rdfs:comment 'External identifier for this vendor contact record in the Salesforce CRM system. Enables bidirectional synchronization between the lakehouse silver layer and the operational CRM for relationship management workflows.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venueServicesDomainExpertise rdf:type rdf:Property ;
    rdfs:label 'Venue Services Domain Expertise' ;
    rdfs:comment 'Indicates whether this vendor contact has specific expertise in venue operations and facility management (e.g., HVAC, BMS, ADA compliance, OSHA safety). Used to route venue service queries and on-site coordination requests.' ;
    rdfs:domain ind:VendorContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:counterpartyCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Counterparty Corporate Entity Id' ;
    rdfs:comment 'Foreign key linking to legal.corporate_entity. Business justification: Vendor contracts are executed with specific legal entities (counterparties). Legal teams need to link the contract to the counterparty corporate entity for entity verification, intercompany agreement ' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:parentContractVendorContractId rdf:type rdf:Property ;
    rdfs:label 'Parent Contract Vendor Contract Id' ;
    rdfs:comment 'Self-referencing identifier linking a SOW or amendment to its parent MSA or framework agreement. Null for standalone contracts. Enables contract hierarchy navigation (e.g., multiple SOWs under a single MSA).' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VendorContract .

ind:annualContractValue rdf:type rdf:Property ;
    rdfs:label 'Annual Contract Value' ;
    rdfs:comment 'The annualized value of the contract, representing the recurring yearly cost obligation. Distinct from TCV — used for annual budget planning, cost center allocation, and year-over-year vendor spend analysis. Maps to ARR (Annual Recurring Revenue equivalent on cost side).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualSpend rdf:type rdf:Property ;
    rdfs:label 'Annual Spend' ;
    rdfs:comment 'The contracted or actual annual spend amount committed to this vendor by this franchise for the specified service category. This value is franchise-vendor specific and cannot reside on either master record as the same vendor has different spend levels across different franchises.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autoRenewalTermMonths rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Term Months' ;
    rdfs:comment 'The duration in months for each auto-renewal period when auto_renewal_flag is True. Null when auto_renewal_flag is False. Used to project future contract obligations and budget forecasting.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractDescription rdf:type rdf:Property ;
    rdfs:label 'Contract Description' ;
    rdfs:comment 'Detailed narrative description of the scope of goods or services covered by the contract. Captures the business purpose, key deliverables, and operational context (e.g., \'Provision of CDN services for OTT streaming platform across North American markets\').' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractTitle rdf:type rdf:Property ;
    rdfs:label 'Contract Title' ;
    rdfs:comment 'Descriptive title or short name of the contract as referenced in legal documents and internal procurement systems (e.g., \'Broadcast Technology Services MSA — Vendor XYZ 2024\'). Used for search, reporting, and document management.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indemnificationCap rdf:type rdf:Property ;
    rdfs:label 'Indemnification Cap' ;
    rdfs:comment 'Maximum aggregate liability cap for indemnification obligations under the contract, expressed in contract currency. Critical for legal risk management and financial exposure assessment. Typically expressed as a multiple of TCV.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insuranceMinCoverage rdf:type rdf:Property ;
    rdfs:label 'Insurance Min Coverage' ;
    rdfs:comment 'Minimum required insurance coverage amount the vendor must maintain, expressed in contract currency. Null when insurance_required_flag is False. Used for vendor compliance verification and risk management.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insuranceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Insurance Required Flag' ;
    rdfs:comment 'Indicates whether the contract requires the vendor to maintain specified insurance coverage (e.g., general liability, workers compensation, professional indemnity). True = insurance certificates required. Supports OSHA and ADA compliance for venue service vendors.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ipOwnership rdf:type rdf:Property ;
    rdfs:label 'Ip Ownership' ;
    rdfs:comment 'Defines the IP ownership arrangement for any intellectual property created or used under this contract. sports_entertainment = SE owns all IP; vendor = vendor retains IP; joint = shared ownership; licensed_to_se = vendor licenses IP to SE; licensed_to_vendor = SE licenses IP to vendor. Critical for DRM and content rights management.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pciComplianceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Pci Compliance Required Flag' ;
    rdfs:comment 'Indicates whether the vendor is required to maintain PCI-DSS compliance as a condition of this contract. True = PCI-DSS certification required (e.g., ticketing payment processors, POS vendors). Supports PCI SSC audit requirements.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferredVendorStatus rdf:type rdf:Property ;
    rdfs:label 'Preferred Vendor Status' ;
    rdfs:comment 'The preferred vendor designation assigned to this vendor specifically for this franchise, which may differ from the enterprise-level vendor_tier on the vendor master. A vendor may be preferred for one franchise but only approved for another based on local performance history.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalTriggerDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Trigger Date' ;
    rdfs:comment 'Calculated date by which the renewal decision must be made, derived from expiration_date minus renewal_notice_days. Stored as a business attribute to support procurement calendar alerts and SLA compliance tracking.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalType rdf:type rdf:Property ;
    rdfs:label 'Renewal Type' ;
    rdfs:comment 'Classification of the most recent or anticipated renewal action. auto_renewal = renewed automatically per contract terms; renegotiated = renewed with revised terms; terminated = not renewed and contract ended; pending = renewal decision not yet made.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeOfServices rdf:type rdf:Property ;
    rdfs:label 'Scope Of Services' ;
    rdfs:comment 'Structured summary of the specific services, deliverables, or goods covered under this contract. Distinct from contract_description (which is narrative) — this field captures the formal contractual scope statement used for SLA measurement and performance tracking.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaUptimePct rdf:type rdf:Property ;
    rdfs:label 'Sla Uptime Pct' ;
    rdfs:comment 'Contractually committed minimum uptime percentage for technology or broadcast services (e.g., 99.95 for 99.95% uptime). Applicable primarily to technology_vendor and broadcast_partner contracts. Used for SLA compliance monitoring and penalty calculation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vendorIncidentId rdf:type rdf:Property ;
    rdfs:label 'Vendor Incident Id' ;
    rdfs:comment 'Unique surrogate identifier for each vendor incident record in the partner domain. Primary key for the vendor_incident data product.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorIncidentVendorIncidentId rdf:type rdf:Property ;
    rdfs:label 'Prior Incident Vendor Incident Id' ;
    rdfs:comment 'Reference to the previous vendor incident record if this incident is a recurrence. Enables incident lineage tracking and pattern analysis for vendor performance management.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VendorIncident .

ind:slaDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Sla Sla Definition Id' ;
    rdfs:comment 'Reference to the specific Service Level Agreement (SLA) that was breached or at risk due to this incident. Drives SLA breach linkage and scorecard deductions.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SlaDefinition .

ind:affectedService rdf:type rdf:Property ;
    rdfs:label 'Affected Service' ;
    rdfs:comment 'The specific vendor-provided service or operational area impacted by the incident (e.g., broadcast feed, HVAC, merchandise fulfillment, network connectivity, security screening).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastOutageDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Broadcast Outage Duration Minutes' ;
    rdfs:comment 'Duration of broadcast service interruption in minutes, applicable when incident_type is broadcast_outage. Used for FCC outage reporting, RSN SLA compliance, and OTT/IPTV service credit calculations.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveActionCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Completed Date' ;
    rdfs:comment 'The date on which the vendor confirmed completion of the corrective action plan. Used to measure vendor responsiveness and close the incident lifecycle.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionDueDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Due Date' ;
    rdfs:comment 'The deadline by which the vendor must submit or complete the corrective action plan. Used to track vendor compliance with post-incident obligations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escalationLevel rdf:type rdf:Property ;
    rdfs:label 'Escalation Level' ;
    rdfs:comment 'The organizational level to which the incident has been escalated. Tracks accountability and governance oversight for high-impact vendor failures.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Amount' ;
    rdfs:comment 'Estimated or confirmed financial impact of the vendor incident in the operating currency, including lost revenue, remediation costs, and operational losses. Feeds contract penalty calculations.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incidentAcknowledgedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Incident Acknowledged Timestamp' ;
    rdfs:comment 'Date and time when the vendor formally acknowledged the incident. Used to measure vendor response time against SLA acknowledgement targets.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:incidentDetectedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Incident Detected Timestamp' ;
    rdfs:comment 'Precise date and time when the vendor incident was first detected or reported, used for SLA response time measurement and mean-time-to-detect analytics.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:penaltyAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Penalty Applied Flag' ;
    rdfs:comment 'Indicates whether the contractual penalty amount has been formally applied and communicated to the vendor. True means the penalty has been actioned in the accounts payable workflow.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurrenceFlag rdf:type rdf:Property ;
    rdfs:label 'Recurrence Flag' ;
    rdfs:comment 'Indicates whether this incident is a recurrence of a previously recorded incident of the same type from the same vendor. Recurrent incidents may trigger escalated contract penalties or termination review.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rootCauseDescription rdf:type rdf:Property ;
    rdfs:label 'Root Cause Description' ;
    rdfs:comment 'Detailed narrative description of the identified root cause of the vendor incident, as determined through investigation. Supports corrective action planning and vendor accountability documentation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scorecardDeductionPoints rdf:type rdf:Property ;
    rdfs:label 'Scorecard Deduction Points' ;
    rdfs:comment 'Number of performance scorecard points deducted from the vendor\'s periodic scorecard as a result of this incident. Feeds the vendor scorecard calculation engine for contract renewal decisions.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaResolutionTargetMinutes rdf:type rdf:Property ;
    rdfs:label 'Sla Resolution Target Minutes' ;
    rdfs:comment 'The contractually agreed maximum resolution time in minutes for this incident severity level, as defined in the applicable SLA. Compared against actual resolution time to determine breach.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaResponseTargetMinutes rdf:type rdf:Property ;
    rdfs:label 'Sla Response Target Minutes' ;
    rdfs:comment 'The contractually agreed maximum response time in minutes for this incident severity level, as defined in the applicable SLA. Used to determine SLA breach status.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vendorContactName rdf:type rdf:Property ;
    rdfs:label 'Vendor Contact Name' ;
    rdfs:comment 'Name of the primary vendor contact person responsible for responding to and resolving this incident. Captured for communication and accountability purposes.' ;
    rdfs:domain ind:VendorIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Billing Period End' ;
    rdfs:comment 'The end date of the service or delivery period covered by this invoice. Used alongside billing_period_start to define the accrual window for services rendered.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Billing Period Start' ;
    rdfs:comment 'The start date of the service or delivery period covered by this invoice. Relevant for recurring service contracts such as venue maintenance, broadcast technology, or facility management.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:earlyPaymentDiscountDate rdf:type rdf:Property ;
    rdfs:label 'Early Payment Discount Date' ;
    rdfs:comment 'The last date by which payment must be made to qualify for the early payment discount. Enables treasury teams to optimize working capital and capture available discounts.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:earlyPaymentDiscountPct rdf:type rdf:Property ;
    rdfs:label 'Early Payment Discount Pct' ;
    rdfs:comment 'The percentage discount offered by the vendor if payment is made before the early payment discount deadline (e.g., 2% if paid within 10 days). Supports cash discount optimization.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entryDate rdf:type rdf:Property ;
    rdfs:label 'Entry Date' ;
    rdfs:comment 'The date the invoice was entered/received into the accounts payable system. Used for processing time measurement and SLA compliance tracking. Corresponds to CPUDT in SAP RBKP.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isDuplicate rdf:type rdf:Property ;
    rdfs:label 'Is Duplicate' ;
    rdfs:comment 'Indicates whether this invoice has been identified as a potential or confirmed duplicate of another invoice from the same vendor for the same period and amount. Supports duplicate payment prevention controls.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPaymentBlocked rdf:type rdf:Property ;
    rdfs:label 'Is Payment Blocked' ;
    rdfs:comment 'Indicates whether payment on this invoice is currently blocked from processing. True if a payment block is active; False if the invoice is clear for payment. Enables quick filtering of blocked invoices in AP dashboards.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vendorPaymentId rdf:type rdf:Property ;
    rdfs:label 'Vendor Payment Id' ;
    rdfs:comment 'Unique surrogate identifier for each vendor payment transaction record in the Silver Layer lakehouse. Primary key for the vendor_payment data product.' ;
    rdfs:domain ind:VendorPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bankAccountReference rdf:type rdf:Property ;
    rdfs:label 'Bank Account Reference' ;
    rdfs:comment 'Masked or tokenized reference to the vendor\'s bank account used for this payment (e.g., last 4 digits of account number or bank account ID from SAP vendor master). Full account details are stored in the secure payment vault per PCI-DSS requirements. Supports payment reconciliation and audit.' ;
    rdfs:domain ind:VendorPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankRoutingReference rdf:type rdf:Property ;
    rdfs:label 'Bank Routing Reference' ;
    rdfs:comment 'Masked or tokenized reference to the bank routing/sort code or SWIFT/BIC code associated with the vendor\'s bank for this payment. Supports international wire payment routing and reconciliation.' ;
    rdfs:domain ind:VendorPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysPastDue rdf:type rdf:Property ;
    rdfs:label 'Days Past Due' ;
    rdfs:comment 'Number of calendar days between the invoice due_date and the actual payment_date. Positive value indicates late payment; zero or negative indicates on-time or early payment. Used for vendor relationship management and payment performance KPI reporting.' ;
    rdfs:domain ind:VendorPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:discountTakenFlag rdf:type rdf:Property ;
    rdfs:label 'Discount Taken Flag' ;
    rdfs:comment 'Indicates whether an early payment discount was applied to this payment transaction. True = discount was taken; False = no discount applied. Used for cash discount analytics and working capital reporting.' ;
    rdfs:domain ind:VendorPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payment Amount' ;
    rdfs:comment 'Actual net amount received by the vendor after deduction of withholding tax (payment_amount minus withholding_tax_amount). Used for vendor remittance advice and accounts payable reconciliation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentChannel rdf:type rdf:Property ;
    rdfs:label 'Payment Channel' ;
    rdfs:comment 'The channel or interface through which the payment instruction was initiated. \'automated\' = SAP F110 automatic payment run; \'manual\' = manually posted payment (F-53); \'portal\' = vendor self-service portal; \'treasury_system\' = initiated via treasury management system.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Number' ;
    rdfs:comment 'Externally-known payment document number generated by SAP S/4HANA FI during the payment run (F110). Used for reconciliation with bank statements and vendor remittance advice. Corresponds to the SAP clearing document number (AUGBL).' ;
    rdfs:domain ind:VendorPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentRunNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Run Number' ;
    rdfs:comment 'Identifier of the SAP F110 automatic payment run batch that generated this payment. Used to group all payments executed in the same payment run for reconciliation and audit purposes.' ;
    rdfs:domain ind:VendorPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Flag' ;
    rdfs:comment 'Indicates whether this payment has been reversed or voided after initial posting. True = payment reversed; False = payment stands. Reversed payments require a corresponding reversal document for audit trail integrity.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valueDate rdf:type rdf:Property ;
    rdfs:label 'Value Date' ;
    rdfs:comment 'The bank value date on which funds are credited to the vendor\'s bank account. May differ from payment_date due to banking processing times. Critical for accurate cash position reporting and treasury management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commercialValueScore rdf:type rdf:Property ;
    rdfs:label 'Commercial Value Score' ;
    rdfs:comment 'Performance sub-score assessing the vendor\'s pricing competitiveness, cost transparency, and overall commercial value delivered relative to market benchmarks and contract terms. Scored 0–100.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commercialValueWeight rdf:type rdf:Property ;
    rdfs:label 'Commercial Value Weight' ;
    rdfs:comment 'Percentage weight assigned to the commercial value sub-score in the overall composite score calculation for this evaluation.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceScore rdf:type rdf:Property ;
    rdfs:label 'Compliance Score' ;
    rdfs:comment 'Performance sub-score measuring the vendor\'s adherence to contractual obligations, regulatory requirements (OSHA, ADA, GDPR, PCI-DSS), and Sports Entertainment internal policies during the evaluation period. Scored 0–100.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceWeight rdf:type rdf:Property ;
    rdfs:label 'Compliance Weight' ;
    rdfs:comment 'Percentage weight assigned to the compliance sub-score in the overall composite score calculation for this evaluation.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveryScore rdf:type rdf:Property ;
    rdfs:label 'Delivery Score' ;
    rdfs:comment 'Performance sub-score measuring on-time and in-full delivery performance during the evaluation period. Reflects adherence to agreed delivery schedules for events, broadcasts, merchandise, and venue services. Scored 0–100.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveryWeight rdf:type rdf:Property ;
    rdfs:label 'Delivery Weight' ;
    rdfs:comment 'Percentage weight assigned to the delivery sub-score in the overall composite score calculation for this evaluation.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeResolutionNotes rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Notes' ;
    rdfs:comment 'Free-text notes documenting the outcome of any vendor dispute raised against this scorecard evaluation. Confidential procurement record used in contract negotiations and legal proceedings.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationFrequency rdf:type rdf:Property ;
    rdfs:label 'Evaluation Frequency' ;
    rdfs:comment 'The cadence at which this vendor is evaluated. Drives scheduling of future scorecards and aligns with contract SLA review cycles.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationMethod rdf:type rdf:Property ;
    rdfs:label 'Evaluation Method' ;
    rdfs:comment 'Indicates whether the scorecard was generated through automated system scoring (e.g., SAP MM KPI extraction), manual evaluator assessment, or a hybrid of both methods.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Evaluation Period End' ;
    rdfs:comment 'The last date of the performance measurement window covered by this scorecard. Together with evaluation_period_start, defines the assessment interval.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evaluationPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Evaluation Period Start' ;
    rdfs:comment 'The first date of the performance measurement window covered by this scorecard. Defines the beginning of the assessment interval (e.g., quarterly, annual).' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evaluatorComments rdf:type rdf:Property ;
    rdfs:label 'Evaluator Comments' ;
    rdfs:comment 'Free-text qualitative commentary provided by the evaluator summarizing vendor performance highlights, concerns, and context not captured by quantitative sub-scores.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementPlanDueDate rdf:type rdf:Property ;
    rdfs:label 'Improvement Plan Due Date' ;
    rdfs:comment 'Target date by which the vendor must submit or complete a formal improvement plan in response to this scorecard evaluation. Applicable when improvement_plan_required is True.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:improvementPlanRequired rdf:type rdf:Property ;
    rdfs:label 'Improvement Plan Required' ;
    rdfs:comment 'Indicates whether a formal vendor improvement plan (VIP) has been mandated as a result of this scorecard evaluation. True when performance tier is probation or when specific sub-scores fall below minimum thresholds.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:innovationScore rdf:type rdf:Property ;
    rdfs:label 'Innovation Score' ;
    rdfs:comment 'Performance sub-score measuring the vendor\'s contribution of new ideas, process improvements, technology upgrades, or value-added services beyond baseline contractual scope. Scored 0–100.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:innovationWeight rdf:type rdf:Property ;
    rdfs:label 'Innovation Weight' ;
    rdfs:comment 'Percentage weight assigned to the innovation sub-score in the overall composite score calculation for this evaluation.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overallScore rdf:type rdf:Property ;
    rdfs:label 'Overall Score' ;
    rdfs:comment 'Composite weighted performance score for the vendor across all evaluation dimensions for the assessment period. Expressed on a 0–100 scale. Drives performance tier assignment and contract renewal decisions.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceTier rdf:type rdf:Property ;
    rdfs:label 'Performance Tier' ;
    rdfs:comment 'Categorical tier assigned to the vendor based on the overall scorecard result. Drives procurement routing, contract renewal eligibility, and preferred vendor list inclusion. Values: preferred (top performers), approved (meets standards), probation (below threshold — improvement plan required), disqualified (removed from approved vendor list).' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPerformanceTier rdf:type rdf:Property ;
    rdfs:label 'Prior Performance Tier' ;
    rdfs:comment 'The vendor\'s performance tier assigned in the immediately preceding scorecard evaluation. Enables trend analysis and tier movement tracking across evaluation cycles.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityScore rdf:type rdf:Property ;
    rdfs:label 'Quality Score' ;
    rdfs:comment 'Performance sub-score measuring the vendor\'s quality of goods or services delivered during the evaluation period. Includes defect rates, rework incidents, and quality audit outcomes. Scored 0–100.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityWeight rdf:type rdf:Property ;
    rdfs:label 'Quality Weight' ;
    rdfs:comment 'Percentage weight assigned to the quality sub-score in the overall composite score calculation for this evaluation. Weights across all dimensions must sum to 100.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recommendedAction rdf:type rdf:Property ;
    rdfs:label 'Recommended Action' ;
    rdfs:comment 'Formal procurement recommendation resulting from this scorecard evaluation. Drives contract renewal negotiations and vendor relationship management decisions. [ENUM-REF-CANDIDATE: renew|renegotiate|place_on_probation|issue_improvement_plan|terminate|no_action — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scorecardReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Scorecard Reference Number' ;
    rdfs:comment 'Externally-known business identifier for this scorecard record, used in procurement correspondence, contract renewal negotiations, and audit trails. Format: VSC-YYYY-NNNNNN.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scorecardStatus rdf:type rdf:Property ;
    rdfs:label 'Scorecard Status' ;
    rdfs:comment 'Current workflow lifecycle state of the vendor scorecard record. Controls visibility and downstream use: draft (in preparation), in_review (pending evaluator sign-off), approved (finalized), published (shared with vendor), superseded (replaced by a revised scorecard).' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoringModelVersion rdf:type rdf:Property ;
    rdfs:label 'Scoring Model Version' ;
    rdfs:comment 'Version identifier of the vendor scoring model or weighting framework applied to generate this scorecard. Enables reproducibility and comparison across evaluation cycles when model parameters change.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceScore rdf:type rdf:Property ;
    rdfs:label 'Service Score' ;
    rdfs:comment 'Performance sub-score measuring responsiveness, issue resolution speed, account management quality, and overall service experience during the evaluation period. Scored 0–100.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceWeight rdf:type rdf:Property ;
    rdfs:label 'Service Weight' ;
    rdfs:comment 'Percentage weight assigned to the service sub-score in the overall composite score calculation for this evaluation.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaBreachCount rdf:type rdf:Property ;
    rdfs:label 'Sla Breach Count' ;
    rdfs:comment 'Total number of distinct SLA breaches recorded against this vendor during the evaluation period. Used to assess severity of non-compliance and trigger escalation or remediation actions.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaComplianceRate rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Rate' ;
    rdfs:comment 'Percentage of SLA obligations met by the vendor during the evaluation period. Calculated as (SLA obligations met / total SLA obligations) × 100. Key input to the compliance sub-score and contract renewal decision.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vendorAcknowledged rdf:type rdf:Property ;
    rdfs:label 'Vendor Acknowledged' ;
    rdfs:comment 'Indicates whether the vendor has formally acknowledged receipt and acceptance of this scorecard evaluation. Required for audit trail and dispute resolution purposes.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vendorAcknowledgementDate rdf:type rdf:Property ;
    rdfs:label 'Vendor Acknowledgement Date' ;
    rdfs:comment 'Date on which the vendor formally acknowledged this scorecard evaluation. Populated when vendor_acknowledged is True.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vendorDisputeRaised rdf:type rdf:Property ;
    rdfs:label 'Vendor Dispute Raised' ;
    rdfs:comment 'Indicates whether the vendor has formally disputed the findings of this scorecard evaluation. Triggers a review and adjudication workflow in the procurement team.' ;
    rdfs:domain ind:VendorScorecard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:abTestId rdf:type rdf:Property ;
    rdfs:label 'Ab Test Id' ;
    rdfs:comment 'Unique surrogate identifier for each A/B or multivariate experiment record in the platform digital experimentation framework.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AbTest .

ind:adobeExperimentId rdf:type rdf:Property ;
    rdfs:label 'Adobe Experiment Id' ;
    rdfs:comment 'The native experiment identifier assigned by Adobe Experience Platform (AEP) when the experiment is configured in AEP. Enables bidirectional traceability between the platform data product and the source system of record.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Experiment .

ind:primaryKpiDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Primary Kpi Definition Id' ;
    rdfs:comment 'Foreign key linking to analytics.kpi_definition. Business justification: A/B test governance requires each experiment to reference a standardized KPI definition as its primary success metric. The primary_success_metric plain-text attribute is a denormalized KPI reference; ' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:KpiDefinition .

ind:abTestStatus rdf:type rdf:Property ;
    rdfs:label 'Ab Test Status' ;
    rdfs:comment 'Current state of the experiment in its lifecycle. \'draft\' = configured but not launched; \'active\' = running and collecting data; \'paused\' = temporarily halted; \'concluded\' = data collection complete, results available; \'archived\' = historical record only.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conclusionType rdf:type rdf:Property ;
    rdfs:label 'Conclusion Type' ;
    rdfs:comment 'Classification of the experiment outcome upon conclusion. \'winner_declared\' = a statistically significant winning variant was identified; \'inconclusive\' = insufficient data; \'null_result\' = no significant difference detected; \'stopped_early\' = experiment terminated before completion.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlVariantKey rdf:type rdf:Property ;
    rdfs:label 'Control Variant Key' ;
    rdfs:comment 'The key/code identifying the control (baseline) variant within this experiment (e.g., \'CONTROL\', \'A\'). Used to anchor statistical comparisons and causal inference analysis.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRetentionDays rdf:type rdf:Property ;
    rdfs:label 'Data Retention Days' ;
    rdfs:comment 'Number of days that fan-level variant assignment and exposure data for this experiment must be retained before deletion, in compliance with GDPR data minimisation and CCPA retention policies.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:earlyStoppingReason rdf:type rdf:Property ;
    rdfs:label 'Early Stopping Reason' ;
    rdfs:comment 'Reason the experiment was stopped before the scheduled end date. \'significance_reached\' = primary metric crossed significance threshold early; \'guardrail_breach\' = a secondary guardrail metric degraded unacceptably; \'sample_ratio_mismatch\' = traffic allocation integrity failure detected. Null if experiment ran to full schedule.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionGroupKey rdf:type rdf:Property ;
    rdfs:label 'Exclusion Group Key' ;
    rdfs:comment 'Identifier of the mutual exclusion group this experiment belongs to. Experiments sharing the same exclusion group key will not overlap in fan assignment. Null if the experiment is not part of any exclusion group.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureFlagKey rdf:type rdf:Property ;
    rdfs:label 'Feature Flag Key' ;
    rdfs:comment 'The platform feature flag identifier associated with this experiment when test_type is \'feature_flag\'. Links the experiment to the feature rollout gate in the platform configuration system.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gdprArticle22Applicable rdf:type rdf:Property ;
    rdfs:label 'Gdpr Article22 Applicable' ;
    rdfs:comment 'Indicates whether this experiment involves automated decision-making that materially affects fan experience, triggering GDPR Article 22 transparency and documentation obligations. True = GDPR Article 22 disclosure required; False = standard experiment.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hypothesis rdf:type rdf:Property ;
    rdfs:label 'Hypothesis' ;
    rdfs:comment 'Formal statement of the causal hypothesis being tested (e.g., \'Changing the CTA button from grey to orange will increase ticket purchase conversion by 5% among mobile fans\'). Required for experiment governance and causal inference documentation.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMutuallyExclusive rdf:type rdf:Property ;
    rdfs:label 'Is Mutually Exclusive' ;
    rdfs:comment 'Indicates whether fans enrolled in this experiment are excluded from all other concurrent experiments on the same touchpoint. True = mutually exclusive (prevents interaction effects); False = fan may be in multiple experiments simultaneously.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumDetectableEffect rdf:type rdf:Property ;
    rdfs:label 'Minimum Detectable Effect' ;
    rdfs:comment 'The smallest relative or absolute change in the primary success metric that the experiment is powered to detect (e.g., 0.050000 = 5% relative lift). Used in sample size calculation and experiment power analysis.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ownerTeam rdf:type rdf:Property ;
    rdfs:label 'Owner Team' ;
    rdfs:comment 'Name of the business or product team responsible for designing, running, and acting on this experiment (e.g., \'Fan Engagement Product\', \'Ticketing UX\', \'Digital Personalization\'). Used for experiment governance accountability.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personalizationAlgorithmCode rdf:type rdf:Property ;
    rdfs:label 'Personalization Algorithm Code' ;
    rdfs:comment 'Reference to the Adobe Experience Platform personalization algorithm or model being tested as a variant in this experiment. Populated only for personalization_algorithm test category experiments.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiredSampleSize rdf:type rdf:Property ;
    rdfs:label 'Required Sample Size' ;
    rdfs:comment 'Minimum number of unique fan exposures required per variant to achieve the pre-registered statistical power and significance threshold. Calculated at experiment design time.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rolloutDecision rdf:type rdf:Property ;
    rdfs:label 'Rollout Decision' ;
    rdfs:comment 'Post-experiment business decision on what to do with the winning variant. \'ship\' = deploy to 100% of audience; \'iterate\' = run follow-up experiment; \'abandon\' = discard the variant; \'hold\' = defer decision pending further review.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salesforceCampaignReference rdf:type rdf:Property ;
    rdfs:label 'Salesforce Campaign Reference' ;
    rdfs:comment 'The Salesforce CRM Campaign record ID linked to this experiment when the test is associated with a fan engagement or sponsor campaign. Enables experiment-to-campaign attribution in Salesforce reporting.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondarySuccessMetrics rdf:type rdf:Property ;
    rdfs:label 'Secondary Success Metrics' ;
    rdfs:comment 'Comma-separated list of secondary KPIs monitored alongside the primary metric (e.g., \'session_duration, bounce_rate, nps_score\'). NPS = Net Promoter Score. Used for guardrail monitoring and holistic experiment evaluation.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statisticalPower rdf:type rdf:Property ;
    rdfs:label 'Statistical Power' ;
    rdfs:comment 'Pre-registered statistical power (1 - beta) for the experiment design (e.g., 0.8000 = 80% power). Determines the probability of detecting a true effect of the minimum detectable effect size.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statisticalSignificanceThreshold rdf:type rdf:Property ;
    rdfs:label 'Statistical Significance Threshold' ;
    rdfs:comment 'Pre-registered p-value threshold below which the experiment result is considered statistically significant (e.g., 0.0500 for 95% confidence). Enforces rigorous experiment governance and prevents premature conclusions.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetSegmentDefinition rdf:type rdf:Property ;
    rdfs:label 'Target Segment Definition' ;
    rdfs:comment 'JSON-serialised or plain-text description of the audience segment criteria used to qualify fans for inclusion in the experiment (e.g., \'Season ticket holders in North America, age 18-35, active in last 30 days\'). Sourced from Adobe Experience Platform segment builder.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testCategory rdf:type rdf:Property ;
    rdfs:label 'Test Category' ;
    rdfs:comment 'Business domain category of the experiment. Classifies the area of the digital platform being tested to enable portfolio-level experiment governance and conflict detection. [ENUM-REF-CANDIDATE: ui_ux|pricing_display|notification_copy|personalization_algorithm|feature_rollout|content_recommendation|checkout_flow|onboarding — promote to reference product]' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testKey rdf:type rdf:Property ;
    rdfs:label 'Test Key' ;
    rdfs:comment 'Externally-known, human-readable unique code identifying the experiment across systems (e.g., \'CHECKOUT_CTA_V2_2024Q3\'). Used as the stable business identifier referenced in Adobe Experience Platform experiment configurations and Salesforce CRM campaign linkages.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testName rdf:type rdf:Property ;
    rdfs:label 'Test Name' ;
    rdfs:comment 'Descriptive human-readable name of the experiment (e.g., \'Checkout Button Color Test – Mobile App Q3 2024\'). Used in experiment governance dashboards and stakeholder reporting.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trafficAllocationPct rdf:type rdf:Property ;
    rdfs:label 'Traffic Allocation Pct' ;
    rdfs:comment 'Percentage of the qualifying audience segment that is enrolled into this experiment (0.00–100.00). The remainder of the segment is excluded from the test entirely. Enables gradual rollout and risk management.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variantCount rdf:type rdf:Property ;
    rdfs:label 'Variant Count' ;
    rdfs:comment 'Total number of variants in the experiment including the control group (e.g., 2 for a classic A/B test, 3+ for multivariate). Drives traffic allocation validation logic.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:winningVariantKey rdf:type rdf:Property ;
    rdfs:label 'Winning Variant Key' ;
    rdfs:comment 'The key/code of the variant declared as the winner upon experiment conclusion. Null if the experiment is still active, inconclusive, or resulted in no statistically significant winner.' ;
    rdfs:domain ind:AbTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicalOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Technical Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Each API integration (ticketing, broadcast, loyalty, DRM) has a named technical owner employee accountable for uptime, incident escalation, and change management approvals. technical_owner_email is a ' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:apiVersion rdf:type rdf:Property ;
    rdfs:label 'Api Version' ;
    rdfs:comment 'Version identifier of the API specification being consumed or exposed (e.g., \'v3\', \'v2.1\'). Tracks version currency and flags integrations running on deprecated API versions requiring upgrade.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authMethod rdf:type rdf:Property ;
    rdfs:label 'Auth Method' ;
    rdfs:comment 'Authentication mechanism used to secure the API integration (e.g., OAuth2, API Key, JWT Bearer Token, HTTP Basic, Mutual TLS, SAML). Critical for security audits, PCI-DSS compliance reviews, and incident triage. [ENUM-REF-CANDIDATE: OAuth2|API_Key|JWT|Basic|mTLS|SAML|None — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseEndpointUrl rdf:type rdf:Property ;
    rdfs:label 'Base Endpoint Url' ;
    rdfs:comment 'The root URL of the external or internal API endpoint (e.g., \'https://api.ticketmaster.com/v3\'). Classified as confidential as it may expose internal infrastructure topology. Used for connectivity validation and incident triage.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessOwnerEmail rdf:type rdf:Property ;
    rdfs:label 'Business Owner Email' ;
    rdfs:comment 'Email address of the business stakeholder accountable for the integration\'s business outcomes and vendor relationship (e.g., the Director of Digital Platforms or Head of Ticketing Technology). Used for escalation and governance reviews.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Change Approval Required' ;
    rdfs:comment 'Indicates whether changes to this integration require formal change advisory board (CAB) approval before deployment. True for platinum/gold SLA tier integrations and PCI-scoped integrations. Enforces SOX and PCI-DSS change management controls.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataFormat rdf:type rdf:Property ;
    rdfs:label 'Data Format' ;
    rdfs:comment 'Serialization format of the data payload exchanged by the integration (e.g., JSON, XML, CSV, Avro, Parquet, Protobuf). Used for schema validation, transformation pipeline configuration, and compatibility assessment.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependencySystems rdf:type rdf:Property ;
    rdfs:label 'Dependency Systems' ;
    rdfs:comment 'Comma-separated list of internal platform systems or data products that depend on this integration (e.g., \'fan_profile,ticket_order,content_delivery\'). Used for impact analysis during incidents, planned maintenance, and deprecation planning.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationUrl rdf:type rdf:Property ;
    rdfs:label 'Documentation Url' ;
    rdfs:comment 'URL pointing to the API integration\'s technical documentation, runbook, or Confluence/wiki page. Enables rapid onboarding of engineers during incidents and supports knowledge management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encryptionInTransit rdf:type rdf:Property ;
    rdfs:label 'Encryption In Transit' ;
    rdfs:comment 'Indicates whether all data transmitted through this integration is encrypted in transit (e.g., TLS 1.2+). Mandatory for PCI-scoped and PII-bearing integrations. Used in security compliance audits.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gdprDataTransferMechanism rdf:type rdf:Property ;
    rdfs:label 'Gdpr Data Transfer Mechanism' ;
    rdfs:comment 'Legal mechanism used to authorize cross-border personal data transfers for this integration under GDPR. \'SCCs\' = Standard Contractual Clauses; \'Adequacy_Decision\' = EU Commission adequacy decision for destination country; \'BCRs\' = Binding Corporate Rules; \'Not_Applicable\' = no EU personal data transferred. Required for GDPR Article 44-49 compliance.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthStatus rdf:type rdf:Property ;
    rdfs:label 'Health Status' ;
    rdfs:comment 'Current real-time operational health state of the integration as reported by the monitoring layer. \'healthy\' = operating within SLA; \'degraded\' = elevated error rates or latency; \'down\' = integration is non-functional; \'unknown\' = health check not yet performed or monitoring gap.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentEscalationPolicy rdf:type rdf:Property ;
    rdfs:label 'Incident Escalation Policy' ;
    rdfs:comment 'Name or identifier of the PagerDuty/OpsGenie escalation policy applied to alerts for this integration (e.g., \'P1-Ticketing-Oncall\', \'P2-Platform-Engineering\'). Ensures alerts are routed to the correct on-call team based on SLA tier.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrationCategory rdf:type rdf:Property ;
    rdfs:label 'Integration Category' ;
    rdfs:comment 'Business domain category classifying the integration by its primary function. Aligns to the platform data domains (e.g., \'ticketing\' for Ticketmaster/AXS, \'crm\' for Salesforce, \'commerce\' for Shopify Plus, \'media_asset\' for Dalet Galaxy). [ENUM-REF-CANDIDATE: ticketing|crm|commerce|media_asset|broadcast|finance|analytics|identity|content|workforce — promote to reference product]' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrationCode rdf:type rdf:Property ;
    rdfs:label 'Integration Code' ;
    rdfs:comment 'Short, unique alphanumeric code used as the externally-known business identifier for the integration (e.g., \'TM_TICKET_AVAIL\', \'SFDC_FAN_SYNC\'). Used in incident triage, monitoring dashboards, and dependency mapping.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrationName rdf:type rdf:Property ;
    rdfs:label 'Integration Name' ;
    rdfs:comment 'Human-readable name identifying the API integration (e.g., \'Ticketmaster Ticket Availability Feed\', \'Salesforce CRM Fan Sync\', \'Shopify Plus Order Webhook\'). Used as the primary display label in integration inventories and dependency maps.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrationStatus rdf:type rdf:Property ;
    rdfs:label 'Integration Status' ;
    rdfs:comment 'Current operational lifecycle state of the API integration. \'active\' = live and serving traffic; \'inactive\' = configured but not in use; \'deprecated\' = scheduled for decommission; \'maintenance\' = temporarily suspended for planned work; \'pending_approval\' = awaiting governance sign-off.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrationType rdf:type rdf:Property ;
    rdfs:label 'Integration Type' ;
    rdfs:comment 'Directional classification of the integration. \'inbound\' = data flows into the platform; \'outbound\' = data flows out; \'bidirectional\' = two-way sync; \'webhook\' = event-driven push from external system; \'event_stream\' = continuous streaming feed (e.g., Kafka, Kinesis).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipAllowlist rdf:type rdf:Property ;
    rdfs:label 'Ip Allowlist' ;
    rdfs:comment 'Comma-separated list of permitted source IP addresses or CIDR ranges authorized to call this integration endpoint. Null if no IP restriction is applied. Classified confidential as it reveals network topology. Used for firewall rule validation and security audits.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPciInTransit rdf:type rdf:Property ;
    rdfs:label 'Is Pci In Transit' ;
    rdfs:comment 'Indicates whether this integration transmits payment card data subject to PCI-DSS controls. True = PCI-scoped integration requiring enhanced security controls, quarterly vulnerability scans, and annual PCI audit inclusion.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPiiInTransit rdf:type rdf:Property ;
    rdfs:label 'Is Pii In Transit' ;
    rdfs:comment 'Indicates whether this integration transmits Personally Identifiable Information (PII) such as fan names, emails, or payment data. True = PII flows through this integration. Drives GDPR/CCPA compliance controls, data transfer impact assessments, and encryption requirements.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastHealthCheckTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Health Check Timestamp' ;
    rdfs:comment 'Timestamp of the most recent automated health check performed against this integration endpoint. Used to identify stale health status readings and ensure monitoring coverage is current.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastSuccessfulCallTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Successful Call Timestamp' ;
    rdfs:comment 'Timestamp of the most recent successfully completed API call for this integration. Used in incident triage to determine when the integration last functioned correctly and to calculate downtime duration.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:monitoringDashboardUrl rdf:type rdf:Property ;
    rdfs:label 'Monitoring Dashboard Url' ;
    rdfs:comment 'URL to the real-time monitoring dashboard (e.g., Datadog, Grafana, Splunk) for this integration. Enables rapid access to health metrics, error rates, and latency trends during incident triage.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:owningTeam rdf:type rdf:Property ;
    rdfs:label 'Owning Team' ;
    rdfs:comment 'Name of the internal engineering or product team responsible for maintaining this integration (e.g., \'Platform Engineering\', \'Fan Engagement Tech\', \'Ticketing Systems\'). Used for incident escalation routing and ownership accountability.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protocol rdf:type rdf:Property ;
    rdfs:label 'Protocol' ;
    rdfs:comment 'Communication protocol used by the integration (e.g., REST, SOAP, GraphQL, gRPC, SFTP, AMQP, Kafka, WebSocket). Determines how requests and responses are structured and transmitted. [ENUM-REF-CANDIDATE: REST|SOAP|GraphQL|gRPC|SFTP|AMQP|Kafka|WebSocket|JDBC|FTP — promote to reference product]' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateLimitPerDay rdf:type rdf:Property ;
    rdfs:label 'Rate Limit Per Day' ;
    rdfs:comment 'Maximum number of API requests permitted per calendar day as defined by the provider contract. Complements the per-minute rate limit for daily quota management and cost control, particularly relevant for third-party data feed integrations with usage-based pricing.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rateLimitPerMinute rdf:type rdf:Property ;
    rdfs:label 'Rate Limit Per Minute' ;
    rdfs:comment 'Maximum number of API requests permitted per minute as defined by the integration contract or provider policy. Used for throttling configuration, capacity planning, and preventing API quota exhaustion during peak event traffic (e.g., on-sale events).' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retryMaxAttempts rdf:type rdf:Property ;
    rdfs:label 'Retry Max Attempts' ;
    rdfs:comment 'Maximum number of automatic retry attempts the platform will make upon transient API failure before escalating to an alert or dead-letter queue. Configures resilience behavior for the integration.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:timeoutSeconds rdf:type rdf:Property ;
    rdfs:label 'Timeout Seconds' ;
    rdfs:comment 'Maximum number of seconds the platform will wait for a response from the API endpoint before declaring a timeout failure. Used to configure circuit breakers and prevent cascading failures in the integration layer.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tlsVersion rdf:type rdf:Property ;
    rdfs:label 'Tls Version' ;
    rdfs:comment 'Minimum TLS protocol version enforced for this integration\'s encrypted communications. \'TLS1.3\' is preferred; \'TLS1.2\' is the minimum acceptable per PCI-DSS v4.0. \'None\' indicates unencrypted (only permissible for internal non-sensitive integrations).' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uptimeTargetPct rdf:type rdf:Property ;
    rdfs:label 'Uptime Target Pct' ;
    rdfs:comment 'Contractual or internally agreed uptime availability target for this integration expressed as a percentage (e.g., 99.95 for platinum tier). Used for SLA compliance monitoring and vendor performance management.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:webhookSecretHash rdf:type rdf:Property ;
    rdfs:label 'Webhook Secret Hash' ;
    rdfs:comment 'Hashed (non-reversible) representation of the shared secret used to validate incoming webhook payloads. Stored as a hash only — never the plaintext secret. Applicable only to webhook-type integrations. Used to verify payload authenticity and prevent spoofing.' ;
    rdfs:domain ind:ApiIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appReleaseId rdf:type rdf:Property ;
    rdfs:label 'App Release Id' ;
    rdfs:comment 'Unique surrogate identifier for each mobile or web application release record in the Sports Entertainment digital platform.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:releaseOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Release Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: App releases for fan-facing sports platforms require a named release owner employee accountable for rollout decisions, forced-update triggers, and crash rate thresholds. release_owner and approved_by ' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:rollbackSourceReleaseId rdf:type rdf:Property ;
    rdfs:label 'Rollback Source Release Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the release that was rolled back when is_rollback is True. Enables lineage tracing between rollback events and their originating releases.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AppRelease .

ind:adaComplianceVerified rdf:type rdf:Property ;
    rdfs:label 'Ada Compliance Verified' ;
    rdfs:comment 'Indicates whether accessibility compliance (ADA / WCAG standards) has been verified for this release. True = accessibility audit completed and passed. Ensures fan-facing digital touchpoints meet legal accessibility requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:anrRatePct rdf:type rdf:Property ;
    rdfs:label 'Anr Rate Pct' ;
    rdfs:comment 'Percentage of sessions experiencing Application Not Responding (ANR) errors for Android releases. Monitored alongside crash rate as a key quality indicator per Google Play policy thresholds.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appStoreRating rdf:type rdf:Property ;
    rdfs:label 'App Store Rating' ;
    rdfs:comment 'Average user rating (1.00 to 5.00) for this release version as reported by the Apple App Store or Google Play Store. Tracks fan satisfaction with each release and informs product prioritization.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appStoreReviewCount rdf:type rdf:Property ;
    rdfs:label 'App Store Review Count' ;
    rdfs:comment 'Total number of user reviews submitted for this release version on the applicable app store. Provides statistical confidence context for the app_store_rating value.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appStoreSubmissionReference rdf:type rdf:Property ;
    rdfs:label 'App Store Submission Reference' ;
    rdfs:comment 'External identifier assigned by the Apple App Store or Google Play Store upon submission of the release for review. Used to track review status and correspondence with platform operators.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buildNumber rdf:type rdf:Property ;
    rdfs:label 'Build Number' ;
    rdfs:comment 'Internal monotonically-increasing build identifier generated by the CI/CD pipeline. Uniquely identifies the compiled artifact submitted to the app store or deployed to web infrastructure. Distinct from the user-facing version number.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crashRatePct rdf:type rdf:Property ;
    rdfs:label 'Crash Rate Pct' ;
    rdfs:comment 'Observed percentage of sessions that resulted in an application crash for this release version (e.g., 0.0125 = 1.25%). Key quality signal monitored post-release to trigger rollback decisions. Sourced from crash analytics tooling.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crashRateThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Crash Rate Threshold Pct' ;
    rdfs:comment 'Maximum acceptable crash rate percentage defined for this release before an automatic rollback or escalation is triggered. Distinct from the observed crash_rate_pct — this is the target/SLA value.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drmPolicyUpdated rdf:type rdf:Property ;
    rdfs:label 'Drm Policy Updated' ;
    rdfs:comment 'Indicates whether this release includes changes to Digital Rights Management (DRM) configuration or enforcement logic. True = DRM policy changes are included, requiring broadcast rights compliance review.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:featureChangelog rdf:type rdf:Property ;
    rdfs:label 'Feature Changelog' ;
    rdfs:comment 'Structured summary of new features, enhancements, and resolved defects included in this release. Published to app store listing pages and internal stakeholder communications. Supports fan-facing release notes and product marketing.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureFlagSet rdf:type rdf:Property ;
    rdfs:label 'Feature Flag Set' ;
    rdfs:comment 'Comma-separated list of feature flag keys activated or deactivated in this release (e.g., \'ppv_checkout_v2,loyalty_wallet,live_poll_v3\'). Enables dark launches and progressive feature enablement without a new release.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gdprChangesIncluded rdf:type rdf:Property ;
    rdfs:label 'Gdpr Changes Included' ;
    rdfs:comment 'Indicates whether this release includes changes to consent management, data processing flows, or privacy controls relevant to GDPR compliance. True = Data Protection Officer review required prior to release.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isForcedUpdate rdf:type rdf:Property ;
    rdfs:label 'Is Forced Update' ;
    rdfs:comment 'Indicates whether fans are required to update to this release before continuing to use the application. Typically set for critical security patches or breaking API changes. True = mandatory upgrade enforced.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRollback rdf:type rdf:Property ;
    rdfs:label 'Is Rollback' ;
    rdfs:comment 'Indicates whether this release record represents a rollback to a prior version following a quality or stability incident. True = this release reverts the platform to a previous known-good state.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumOsVersion rdf:type rdf:Property ;
    rdfs:label 'Minimum Os Version' ;
    rdfs:comment 'The lowest operating system version on which this release is supported (e.g., iOS 15.0, Android 11.0). Drives device compatibility messaging and fan support triage.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pciScopeChange rdf:type rdf:Property ;
    rdfs:label 'Pci Scope Change' ;
    rdfs:comment 'Indicates whether this release modifies payment processing flows, tokenization logic, or any component within PCI-DSS scope. True = PCI SSC compliance review and re-assessment may be required.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:releaseDescription rdf:type rdf:Property ;
    rdfs:label 'Release Description' ;
    rdfs:comment 'Free-text narrative description of the business purpose and scope of this release. Provides context beyond the structured changelog for stakeholder communications and governance documentation.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseEnvironment rdf:type rdf:Property ;
    rdfs:label 'Release Environment' ;
    rdfs:comment 'Target deployment environment for this release record: development (internal engineering), staging (pre-production validation), or production (live fan-facing environment).' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseName rdf:type rdf:Property ;
    rdfs:label 'Release Name' ;
    rdfs:comment 'Human-readable marketing or internal name assigned to the release (e.g., \'Summer Fan Experience Update\', \'Season Opener Release\'). Used in communications and release notes.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseNotesUrl rdf:type rdf:Property ;
    rdfs:label 'Release Notes Url' ;
    rdfs:comment 'URL linking to the full release notes document or changelog page for this release. Used by internal teams, partners, and API consumers to review detailed change information.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseNumber rdf:type rdf:Property ;
    rdfs:label 'Release Number' ;
    rdfs:comment 'Externally-known semantic version number of the release following major.minor.patch convention (e.g., 4.12.3). Used as the primary business identifier for the release across app stores and internal communications.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseStatus rdf:type rdf:Property ;
    rdfs:label 'Release Status' ;
    rdfs:comment 'Current lifecycle state of the release from initial draft through app store review, staged rollout, full live deployment, and eventual deprecation or rollback. [ENUM-REF-CANDIDATE: draft|in_review|approved|in_rollout|live|rolled_back|deprecated — promote to reference product]' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Release Timestamp' ;
    rdfs:comment 'Precise date and time (with timezone offset) at which the release was deployed or made live on the target platform. Supports SLA measurement and incident correlation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:releaseType rdf:type rdf:Property ;
    rdfs:label 'Release Type' ;
    rdfs:comment 'Classification of the release by scope of change: major (breaking changes or significant new features), minor (backward-compatible new features), patch (bug fixes), hotfix (emergency production fix), or rollback (reverting to a prior version).' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rolloutPercentage rdf:type rdf:Property ;
    rdfs:label 'Rollout Percentage' ;
    rdfs:comment 'Percentage of the eligible user base currently receiving this release as part of a staged or phased rollout strategy (0.00 to 100.00). Enables controlled deployment and risk mitigation for high-traffic fan-facing platforms.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rolloutStrategy rdf:type rdf:Property ;
    rdfs:label 'Rollout Strategy' ;
    rdfs:comment 'Deployment strategy applied for this release: immediate (100% of users at once), staged (incremental percentage increase), canary (small subset for early validation), beta (opt-in test group), or forced_update (mandatory upgrade blocking prior versions).' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityScanStatus rdf:type rdf:Property ;
    rdfs:label 'Security Scan Status' ;
    rdfs:comment 'Status of the automated security vulnerability scan performed on this release build prior to deployment. Passed = no critical or high vulnerabilities detected. Failed = release blocked pending remediation.' ;
    rdfs:domain ind:AppRelease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concurrentSessionCount rdf:type rdf:Property ;
    rdfs:label 'Concurrent Session Count' ;
    rdfs:comment 'The number of active sessions for the same fan account at the time this session was initiated. Used to enforce concurrent session limits (e.g., OTT streaming entitlement enforcement), detect credential sharing, and support fraud investigation.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:entitlementTier rdf:type rdf:Property ;
    rdfs:label 'Entitlement Tier' ;
    rdfs:comment 'The fan\'s subscription or access entitlement tier active at the time of session initiation (e.g., free, basic, premium, VIP, enterprise). Determines feature access, content availability, and OTT streaming rights during the session. Supports ARPU segmentation and LTV analysis.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geoRegion rdf:type rdf:Property ;
    rdfs:label 'Geo Region' ;
    rdfs:comment 'Sub-national region or state derived from IP geolocation (e.g., California, Ontario, Bavaria). Supports CCPA applicability determination, Regional Sports Network (RSN) rights enforcement, and regional fan engagement segmentation.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityProviderSessionReference rdf:type rdf:Property ;
    rdfs:label 'Identity Provider Session Reference' ;
    rdfs:comment 'The session or correlation identifier issued by the external identity provider (SSO/OAuth) for this authentication event (e.g., Okta session ID, Azure AD correlation ID). Used to correlate Sports Entertainment sessions with IdP audit logs for security investigations.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBotSuspected rdf:type rdf:Property ;
    rdfs:label 'Is Bot Suspected' ;
    rdfs:comment 'Indicates whether automated bot detection (e.g., CAPTCHA failure, behavioral anomaly scoring) flagged this session as potentially non-human at initiation. Used for fraud investigation, ticket scalping prevention, and platform abuse mitigation.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTrustedDevice rdf:type rdf:Property ;
    rdfs:label 'Is Trusted Device' ;
    rdfs:comment 'Indicates whether the device used for this session was previously registered as a trusted device by the fan, enabling reduced friction authentication (e.g., MFA bypass). Supports adaptive authentication and fan experience personalization.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loginAttemptCount rdf:type rdf:Property ;
    rdfs:label 'Login Attempt Count' ;
    rdfs:comment 'The number of authentication attempts made before this session was successfully established. A value greater than 1 indicates prior failed attempts. Used for brute-force detection, account lockout policy enforcement, and security incident investigation.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mfaMethod rdf:type rdf:Property ;
    rdfs:label 'Mfa Method' ;
    rdfs:comment 'The specific second-factor method used when MFA was required. \'sms_otp\' is SMS one-time password; \'email_otp\' is email one-time password; \'totp_app\' is time-based OTP via authenticator app; \'push_notification\' is in-app push approval; \'none\' when MFA was not required or bypassed.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mfaStatus rdf:type rdf:Property ;
    rdfs:label 'Mfa Status' ;
    rdfs:comment 'Indicates whether Multi-Factor Authentication (MFA) was required and the outcome at session initiation. \'not_required\' means MFA policy did not apply; \'passed\' means MFA challenge was successfully completed; \'failed\' means MFA challenge was not completed (session may have been blocked); \'bypassed\' means MFA was skipped via trusted device or admin override.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oauthScope rdf:type rdf:Property ;
    rdfs:label 'Oauth Scope' ;
    rdfs:comment 'The permission scopes granted to the session token during OAuth-based authentication (e.g., \'openid profile email ticketing:read\'). Defines what resources and APIs the session is authorized to access. Supports least-privilege access auditing.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referrerUrl rdf:type rdf:Property ;
    rdfs:label 'Referrer Url' ;
    rdfs:comment 'The URL or deep-link from which the fan navigated to the authentication page (e.g., a promotional email link, a sponsor landing page, a social media post). Supports fan acquisition attribution, Customer Acquisition Cost (CAC) analysis, and campaign effectiveness reporting.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Session Duration Seconds' ;
    rdfs:comment 'The total elapsed time in seconds between session_start_timestamp and session_end_timestamp. Null if the session is still active. Used for fan engagement depth analysis, SLA compliance reporting, and Average Revenue Per User (ARPU) correlation studies.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sessionEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Session End Timestamp' ;
    rdfs:comment 'The precise date and time (UTC) when the session was closed, expired, or terminated. Null if the session is still active. Used to compute session duration and identify abnormally long or short sessions.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sessionInvalidationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Session Invalidation Timestamp' ;
    rdfs:comment 'The precise date and time (UTC) when the session token was explicitly invalidated by a security event (e.g., password reset, admin revocation, GDPR erasure request). Distinct from session_end_timestamp which records normal closure. Supports GDPR right-to-erasure audit trails and security incident timelines.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sessionStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Session Start Timestamp' ;
    rdfs:comment 'The precise date and time (UTC) when the fan successfully authenticated and the session was established. Principal business event timestamp for SLA measurement and session duration analytics.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sessionToken rdf:type rdf:Property ;
    rdfs:label 'Session Token' ;
    rdfs:comment 'Cryptographically generated bearer token issued at authentication that uniquely identifies the active session. Used for SLA monitoring, fraud investigation, and session continuity across digital touchpoints. Treated as a sensitive identifier per GDPR and CCPA.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssoProvider rdf:type rdf:Property ;
    rdfs:label 'Sso Provider' ;
    rdfs:comment 'The identity provider used when auth_method is \'sso\' or \'social_oauth\' (e.g., Google, Apple, Facebook, Microsoft Azure AD, Okta). Null when direct password authentication is used. Supports SSO adoption analytics and identity provider SLA monitoring.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:userAgent rdf:type rdf:Property ;
    rdfs:label 'User Agent' ;
    rdfs:comment 'The HTTP User-Agent string reported by the fan\'s browser or app client at session initiation (e.g., \'Mozilla/5.0 (iPhone; CPU iPhone OS 17_2...\'). Used for device classification, browser compatibility analysis, and fraud pattern detection.' ;
    rdfs:domain ind:AuthSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentRecommendationId rdf:type rdf:Property ;
    rdfs:label 'Content Recommendation Id' ;
    rdfs:comment 'Unique surrogate identifier for each content recommendation record generated by the platform recommendation engine.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContentRecommendation .

ind:personalizationProfileId rdf:type rdf:Property ;
    rdfs:label 'Personalization Profile Id' ;
    rdfs:comment 'Reference to the Adobe Experience Platform (AEP) personalization profile used as the basis for generating this recommendation.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PersonalizationProfile .

ind:aepDecisionReference rdf:type rdf:Property ;
    rdfs:label 'Aep Decision Reference' ;
    rdfs:comment 'The unique decision identifier assigned by Adobe Experience Platform\'s Offer Decisioning or Journey Optimizer engine for this recommendation event. Enables cross-system traceability between the Silver layer and AEP.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:algorithmCode rdf:type rdf:Property ;
    rdfs:label 'Algorithm Code' ;
    rdfs:comment 'Reference to the recommendation algorithm or model version that produced this recommendation, enabling model performance tracking and A/B comparison.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:algorithmName rdf:type rdf:Property ;
    rdfs:label 'Algorithm Name' ;
    rdfs:comment 'Human-readable name of the recommendation algorithm used (e.g., \'collaborative_filtering_v3\', \'content_based_sport_affinity\', \'hybrid_aep_v2\'). Supports model lineage and explainability.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:algorithmVersion rdf:type rdf:Property ;
    rdfs:label 'Algorithm Version' ;
    rdfs:comment 'Semantic version number of the recommendation algorithm model at the time this recommendation was generated. Critical for model drift analysis and rollback decisions.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionPct rdf:type rdf:Property ;
    rdfs:label 'Completion Pct' ;
    rdfs:comment 'Percentage of the recommended content asset consumed by the fan (0.00–100.00). Null if no engagement. Key metric for recommendation quality and content affinity model training.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceScore rdf:type rdf:Property ;
    rdfs:label 'Confidence Score' ;
    rdfs:comment 'Probability score (0.0000–1.0000) assigned by the recommendation engine indicating the predicted relevance of this content item to the fan. Used for ranking, threshold filtering, and model evaluation.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:engagementOutcome rdf:type rdf:Property ;
    rdfs:label 'Engagement Outcome' ;
    rdfs:comment 'The fan\'s observed behavioral response to this recommendation. Captures the primary engagement signal used for model feedback loops and recommendation effectiveness measurement.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedbackSignal rdf:type rdf:Property ;
    rdfs:label 'Feedback Signal' ;
    rdfs:comment 'Explicit or implicit feedback signal captured from the fan regarding this recommendation (e.g., thumbs up, \'not interested\', explicit like). Used as a supervised training signal for recommendation model improvement.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRightsCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Rights Compliant' ;
    rdfs:comment 'Indicates whether the recommended content asset is cleared for delivery to the fan based on their geographic location and applicable broadcast rights windows (DRM/geo-restriction check). Critical for rights compliance audit.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isUpsellCandidate rdf:type rdf:Property ;
    rdfs:label 'Is Upsell Candidate' ;
    rdfs:comment 'Indicates whether this recommendation was intentionally surfaced as a premium content upsell opportunity (e.g., PPV event, premium tier content) to drive subscription upgrade or Pay-Per-View (PPV) purchase.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:personalizationSegmentCode rdf:type rdf:Property ;
    rdfs:label 'Personalization Segment Code' ;
    rdfs:comment 'The AEP-derived personalization micro-segment code active for this fan at recommendation time (e.g., \'high_value_nfl_fan\', \'lapsed_subscriber\'). Supports granular personalization performance analysis.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rankPosition rdf:type rdf:Property ;
    rdfs:label 'Rank Position' ;
    rdfs:comment 'Ordinal position of this content item within the recommendation set served to the fan in a given session (1 = top recommendation). Used for position-bias analysis and click-through rate (CTR) measurement by rank.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recommendationReference rdf:type rdf:Property ;
    rdfs:label 'Recommendation Reference' ;
    rdfs:comment 'Externally referenceable business identifier for this recommendation record, used in downstream analytics, A/B testing, and audit trails.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendationSetSize rdf:type rdf:Property ;
    rdfs:label 'Recommendation Set Size' ;
    rdfs:comment 'Total number of content items included in the recommendation set delivered to the fan in this session. Provides context for interpreting rank position and coverage metrics.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recommendationStatus rdf:type rdf:Property ;
    rdfs:label 'Recommendation Status' ;
    rdfs:comment 'Current lifecycle state of the recommendation record. \'generated\' = produced by engine but not yet delivered; \'served\' = displayed to fan; \'clicked\' = fan engaged; \'dismissed\' = fan explicitly dismissed; \'expired\' = TTL elapsed before serving; \'suppressed\' = blocked by business rule or frequency cap.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Recommendation Timestamp' ;
    rdfs:comment 'The precise date and time (ISO 8601 with timezone offset) at which the recommendation engine produced this recommendation record. This is the principal business event timestamp.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recommendationType rdf:type rdf:Property ;
    rdfs:label 'Recommendation Type' ;
    rdfs:comment 'The surface or placement context where this recommendation was generated for delivery. Drives channel-specific performance analysis. [ENUM-REF-CANDIDATE: homepage_feed|post_view|in_game|email|push_notification|in_app_banner|search_results|live_event_overlay — promote to reference product]' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Served Timestamp' ;
    rdfs:comment 'The date and time at which this recommendation was actually displayed/delivered to the fan\'s device. Distinct from recommendation_timestamp (generation time). Null if recommendation was generated but never served.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:userContextType rdf:type rdf:Property ;
    rdfs:label 'User Context Type' ;
    rdfs:comment 'The behavioral context of the fan at the time of recommendation generation. Captures the fan\'s intent signal used as input to the recommendation engine (e.g., browsing, watching live event, post-event, onboarding).' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:viewDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'View Duration Seconds' ;
    rdfs:comment 'Number of seconds the fan consumed the recommended content after clicking through. Null if no click occurred. Used for content completion rate analysis and recommendation quality scoring.' ;
    rdfs:domain ind:ContentRecommendation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:subscriptionTierId rdf:type rdf:Property ;
    rdfs:label 'Subscription Tier Id' ;
    rdfs:comment 'Reference to the fan\'s active subscription tier at the time of device registration. Determines the device registration limit, concurrent stream entitlement, and DRM quality level applicable to this device.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SubscriptionTier .

ind:adobeEcid rdf:type rdf:Property ;
    rdfs:label 'Adobe Ecid' ;
    rdfs:comment 'Adobe Experience Cloud Identity (ECID) associated with this device. Enables cross-channel identity stitching in Adobe Experience Platform for personalization, audience segmentation, and fan engagement analytics.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authProvider rdf:type rdf:Property ;
    rdfs:label 'Auth Provider' ;
    rdfs:comment 'Identity provider used to authenticate the fan on this device during registration. Supports SSO integrations with Google, Apple, Facebook, and Ticketmaster identity services.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concurrentStreamSlot rdf:type rdf:Property ;
    rdfs:label 'Concurrent Stream Slot' ;
    rdfs:comment 'The stream slot number (1 through N) assigned to this device within the fan\'s concurrent stream entitlement. Used by the DRM enforcement engine to manage simultaneous playback sessions across registered devices.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deregistrationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Deregistration Timestamp' ;
    rdfs:comment 'Timestamp when the device was deregistered or revoked from the fan\'s account. Null if the device is still active. Used for audit trails, device slot reclamation, and GDPR right-to-erasure compliance.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:deviceFingerprintHash rdf:type rdf:Property ;
    rdfs:label 'Device Fingerprint Hash' ;
    rdfs:comment 'SHA-256 cryptographic hash of the device\'s unique hardware and software fingerprint attributes. Used for fraud detection, device identity verification, and DRM concurrent stream enforcement without storing raw device identifiers. Compliant with GDPR pseudonymisation requirements.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceLimitStatus rdf:type rdf:Property ;
    rdfs:label 'Device Limit Status' ;
    rdfs:comment 'Indicates whether the fan\'s account is within, at, or over the maximum number of registered devices permitted by their subscription tier. Used to enforce device registration caps and trigger remediation workflows.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceMake rdf:type rdf:Property ;
    rdfs:label 'Device Make' ;
    rdfs:comment 'Manufacturer or brand of the registered device (e.g., Apple, Samsung, Sony, Microsoft). Used for device compatibility analytics and DRM certificate validation.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceModel rdf:type rdf:Property ;
    rdfs:label 'Device Model' ;
    rdfs:comment 'Specific hardware model of the registered device (e.g., iPhone 15 Pro, Samsung Galaxy S24, PlayStation 5). Used for compatibility analysis, DRM enforcement, and targeted feature delivery.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceName rdf:type rdf:Property ;
    rdfs:label 'Device Name' ;
    rdfs:comment 'Human-readable label assigned to the device by the fan (e.g., \'John\'s iPhone 15\'). Displayed in the fan\'s device management portal to help fans identify and manage their registered devices.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmCertificate rdf:type rdf:Property ;
    rdfs:label 'Drm Certificate' ;
    rdfs:comment 'DRM device certificate string (e.g., Widevine, FairPlay, PlayReady) issued to the device for encrypted content playback authorization. Enforces broadcast rights and concurrent stream limits per the content rights windows defined in content.content_drm_policy.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmCertificateExpiryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Drm Certificate Expiry Timestamp' ;
    rdfs:comment 'Timestamp at which the DRM device certificate expires. The platform must re-provision the certificate before this date to maintain uninterrupted content playback access for the fan.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fraudFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Flag' ;
    rdfs:comment 'Indicates whether this device has been flagged as potentially fraudulent by the platform\'s fraud detection engine or a manual review process. Flagged devices may have access suspended pending investigation.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudFlagReason rdf:type rdf:Property ;
    rdfs:label 'Fraud Flag Reason' ;
    rdfs:comment 'Reason code explaining why this device was flagged as potentially fraudulent. Used by the trust and safety team to prioritize and route fraud investigations.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryDevice rdf:type rdf:Property ;
    rdfs:label 'Is Primary Device' ;
    rdfs:comment 'Indicates whether this device is designated as the fan\'s primary device. The primary device may receive preferential DRM stream allocation and is used as the default target for critical account notifications.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastActiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Active Timestamp' ;
    rdfs:comment 'Timestamp of the most recent authenticated session or activity recorded on this device. Used to identify dormant devices for cleanup, enforce device limit policies, and support fan re-engagement campaigns.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mfaEnabled rdf:type rdf:Property ;
    rdfs:label 'Mfa Enabled' ;
    rdfs:comment 'Indicates whether multi-factor authentication is enabled for this device. Devices with MFA enabled receive elevated trust scores and may bypass additional step-up challenges for high-value transactions such as ticket purchases.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationOptIn rdf:type rdf:Property ;
    rdfs:label 'Notification Opt In' ;
    rdfs:comment 'Indicates whether the fan has granted permission for the platform to send push notifications to this device. Governs push notification delivery eligibility for event alerts, promotional offers, and fan engagement campaigns.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationOptInTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Opt In Timestamp' ;
    rdfs:comment 'Timestamp when the fan granted or last updated push notification consent for this device. Required for GDPR and CCPA consent audit trails.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:osPlatform rdf:type rdf:Property ;
    rdfs:label 'Os Platform' ;
    rdfs:comment 'Operating system platform running on the registered device. Used for push notification routing, DRM certificate compatibility checks, and platform-specific feature entitlement enforcement. [ENUM-REF-CANDIDATE: iOS|Android|tvOS|watchOS|Windows|macOS|Tizen|webOS|PlayStation|Xbox — promote to reference product]' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:osVersion rdf:type rdf:Property ;
    rdfs:label 'Os Version' ;
    rdfs:comment 'Version string of the operating system installed on the registered device at the time of last check-in. Used to assess DRM compatibility, enforce minimum OS version policies, and target OS-specific feature rollouts.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pushNotificationToken rdf:type rdf:Property ;
    rdfs:label 'Push Notification Token' ;
    rdfs:comment 'Platform-issued push notification token (APNs token for iOS, FCM registration token for Android) used to deliver personalized push notifications for event alerts, ticket offers, and fan engagement campaigns via Adobe Experience Platform.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pushTokenExpiryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Push Token Expiry Timestamp' ;
    rdfs:comment 'Timestamp at which the push notification token expires and must be refreshed. Used by the notification delivery engine to proactively re-register tokens before expiry to prevent missed fan communications.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:registrationCountryCode rdf:type rdf:Property ;
    rdfs:label 'Registration Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the geographic location from which the device was registered. Used for broadcast rights geo-enforcement, GDPR/CCPA jurisdiction determination, and regional content personalization.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationIpAddress rdf:type rdf:Property ;
    rdfs:label 'Registration Ip Address' ;
    rdfs:comment 'IP address from which the device registration request originated. Used for geolocation-based fraud detection, broadcast rights geo-enforcement, and security audit logging.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationReference rdf:type rdf:Property ;
    rdfs:label 'Registration Reference' ;
    rdfs:comment 'Externally visible alphanumeric reference code assigned to this device registration at the time of enrollment. Used in support communications and audit trails.' ;
    rdfs:domain ind:DeviceRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Registration Timestamp' ;
    rdfs:comment 'Timestamp when the fan first registered this device with the digital platform. Serves as the effective start date for device authorization and is used in device limit enforcement and fraud detection analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:distributionVendorContractId rdf:type rdf:Property ;
    rdfs:label 'Distribution Vendor Contract Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor_contract. Business justification: Distribution partner subscriptions are governed by revenue share contracts. Linking to vendor_contract enables commission calculation, revenue share reconciliation, and contract compliance reporting p' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VendorContract .

ind:distributionVendorId rdf:type rdf:Property ;
    rdfs:label 'Distribution Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: Digital subscriptions are sold through distribution partners (telcos, cable operators, app stores). Linking to vendor enables partner revenue share reporting, commission calculations, and distribution' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:subscriptionPlanId rdf:type rdf:Property ;
    rdfs:label 'Subscription Plan Id' ;
    rdfs:comment 'Reference to the subscription plan product definition (e.g., OTT streaming pass, premium app tier, PPV season package, bundled content+ticketing). Links to the plan reference product.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SubscriptionPlan .

ind:arpuContribution rdf:type rdf:Property ;
    rdfs:label 'Arpu Contribution' ;
    rdfs:comment 'Monthly Average Revenue Per User (ARPU) contribution attributed to this subscription, normalised to a monthly basis regardless of billing cycle. Used as a KPI baseline for digital platform performance reporting and Lifetime Value (LTV) modelling.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:churnRiskTier rdf:type rdf:Property ;
    rdfs:label 'Churn Risk Tier' ;
    rdfs:comment 'Categorical churn risk classification assigned to the subscription based on engagement signals, payment history, and behavioural patterns scored in Adobe Experience Platform. Drives proactive retention campaign targeting and win-back prioritisation.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concurrentStreamsLimit rdf:type rdf:Property ;
    rdfs:label 'Concurrent Streams Limit' ;
    rdfs:comment 'Maximum number of simultaneous streams permitted under this subscription plan. Enforced by the OTT streaming platform to prevent credential sharing and protect broadcast rights. Sourced from Adobe Experience Platform entitlement configuration.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contentAccessTier rdf:type rdf:Property ;
    rdfs:label 'Content Access Tier' ;
    rdfs:comment 'Entitlement tier defining the breadth of content accessible under this subscription (e.g., basic live streams only, standard VOD library, premium exclusive content, VIP all-access, PPV-only). Drives Digital Rights Management (DRM) enforcement in the content delivery layer.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastLoginDate rdf:type rdf:Property ;
    rdfs:label 'Last Login Date' ;
    rdfs:comment 'Date on which the subscriber most recently authenticated and accessed the digital platform. Key engagement signal for churn risk scoring, dormant account identification, and GDPR data retention policy application.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Payment Date' ;
    rdfs:comment 'Date of the most recent successful payment received for this subscription. Used to identify at-risk accounts with lapsed payments and to validate billing cycle compliance.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:netCharge rdf:type rdf:Property ;
    rdfs:label 'Net Charge' ;
    rdfs:comment 'Net amount billed to the fan after applying discounts and adding taxes (subscription_charge - discount_amount + tax_amount). Represents the actual cash collected per billing cycle and the ARPU contribution for this subscription.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offlineDownloadFlag rdf:type rdf:Property ;
    rdfs:label 'Offline Download Flag' ;
    rdfs:comment 'Indicates whether the subscription plan entitles the fan to download content for offline viewing. True = offline downloads permitted; False = streaming only. Relevant for Digital Rights Management (DRM) policy enforcement.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentFailureCount rdf:type rdf:Property ;
    rdfs:label 'Payment Failure Count' ;
    rdfs:comment 'Cumulative count of failed payment attempts for the current subscription term. Used to trigger dunning workflows, suspension logic, and churn risk escalation. Sourced from SAP S/4HANA FI payment processing logs.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentMethodToken rdf:type rdf:Property ;
    rdfs:label 'Payment Method Token' ;
    rdfs:comment 'Tokenised reference to the fan\'s stored payment instrument (credit/debit card, digital wallet) used for recurring billing. The actual card data is held in the PCI-DSS-compliant payment vault; this field stores only the opaque token. Never contains raw card numbers.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promoDescription rdf:type rdf:Property ;
    rdfs:label 'Promo Description' ;
    rdfs:comment 'Human-readable description of the promotional offer applied to this subscription (e.g., \'Season Opener 30% Off\', \'Bundle with Season Ticket\'). Supports marketing reporting and fan communication.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salesforceSubscriptionReference rdf:type rdf:Property ;
    rdfs:label 'Salesforce Subscription Reference' ;
    rdfs:comment 'Native record identifier from the Salesforce CRM subscription object (18-character Salesforce ID). Enables bi-directional traceability between the silver-layer data product and the operational system of record for reconciliation and lineage.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriptionType rdf:type rdf:Property ;
    rdfs:label 'Subscription Type' ;
    rdfs:comment 'Classification of the digital subscription product category. Distinguishes Over-The-Top (OTT) streaming passes, premium app tiers, Pay-Per-View (PPV) season packages, and bundled content+ticketing subscriptions for revenue segmentation and analytics.' ;
    rdfs:domain ind:DigitalSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adobeChannelId rdf:type rdf:Property ;
    rdfs:label 'Adobe Channel Id' ;
    rdfs:comment 'The unique channel identifier assigned to this digital touchpoint within Adobe Experience Platform (AEP), used for fan journey orchestration, personalization segment targeting, and cross-channel analytics attribution. Enables SSOT linkage between the platform registry and AEP channel configuration.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Channel .

ind:apiGatewayEndpoint rdf:type rdf:Property ;
    rdfs:label 'Api Gateway Endpoint' ;
    rdfs:comment 'The base URL of the API (Application Programming Interface) gateway endpoint serving this digital touchpoint (e.g., https://api.sportsentertainment.com/v2/fan). Used for integration configuration, SLA endpoint monitoring, and API versioning management.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appStoreIdentifier rdf:type rdf:Property ;
    rdfs:label 'App Store Identifier' ;
    rdfs:comment 'The official app store listing identifier for mobile touchpoints — Apple App Store bundle ID (e.g., com.sportsentertainment.fanapp) or Google Play package name. Null for non-mobile platform types. Used for version tracking, deep-link routing, and push notification configuration.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arpuBaselineUsd rdf:type rdf:Property ;
    rdfs:label 'Arpu Baseline Usd' ;
    rdfs:comment 'The established ARPU (Average Revenue Per User) baseline in US Dollars for this digital touchpoint, representing the expected revenue contribution per active fan per month. Used as a KPI benchmark for digital performance reporting, Workday Adaptive Planning financial forecasts, and channel investment prioritization.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authenticationMethod rdf:type rdf:Property ;
    rdfs:label 'Authentication Method' ;
    rdfs:comment 'The primary user authentication mechanism supported by this digital touchpoint. Drives identity federation configuration, session management policies, and GDPR/CCPA consent flow design. Values: oauth2, saml, magic_link, social_sso (Social Single Sign-On), guest, biometric.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cacBaselineUsd rdf:type rdf:Property ;
    rdfs:label 'Cac Baseline Usd' ;
    rdfs:comment 'The established CAC (Customer Acquisition Cost) baseline in US Dollars for acquiring a new fan through this digital touchpoint. Used as a KPI benchmark for digital marketing ROI (Return on Investment) analysis and channel budget allocation in Workday Adaptive Planning.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ccpaOptOutSupported rdf:type rdf:Property ;
    rdfs:label 'Ccpa Opt Out Supported' ;
    rdfs:comment 'Indicates whether this digital touchpoint implements the CCPA \'Do Not Sell or Share My Personal Information\' opt-out mechanism, required for channels accessible to California residents. Drives privacy compliance workflow and Salesforce CRM consent record updates.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:channelCategory rdf:type rdf:Property ;
    rdfs:label 'Channel Category' ;
    rdfs:comment 'Ownership classification of the digital touchpoint indicating whether the channel is directly owned and operated by Sports Entertainment (owned), operated by a third-party partner under agreement (partner), or distributed via a syndication arrangement (syndicated). Informs rights management and DRM policy assignment.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentStreamingCapable rdf:type rdf:Property ;
    rdfs:label 'Content Streaming Capable' ;
    rdfs:comment 'Indicates whether this digital touchpoint supports live or on-demand video content streaming. True for OTT players and IPTV endpoints. Drives CDN (Content Delivery Network) routing, DRM enforcement, and broadcast rights compliance checks.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:currentVersion rdf:type rdf:Property ;
    rdfs:label 'Current Version' ;
    rdfs:comment 'The currently deployed semantic version of the digital touchpoint application or platform (e.g., 4.2.1). Follows semantic versioning (MAJOR.MINOR.PATCH). Used for version lifecycle management, feature flag targeting, and incident root-cause analysis.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmEnabled rdf:type rdf:Property ;
    rdfs:label 'Drm Enabled' ;
    rdfs:comment 'Indicates whether Digital Rights Management (DRM) content protection is enforced on this digital touchpoint. True for OTT players and IPTV endpoints distributing broadcast content under media rights agreements. Drives content licensing compliance and broadcast rights enforcement.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gdprConsentRequired rdf:type rdf:Property ;
    rdfs:label 'Gdpr Consent Required' ;
    rdfs:comment 'Indicates whether this digital touchpoint is subject to GDPR consent collection requirements, applicable when the channel is accessible to fans in EU/EEA markets. Drives consent management platform (CMP) activation and data processing lawfulness checks.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grantDate rdf:type rdf:Property ;
    rdfs:label 'Grant Date' ;
    rdfs:comment 'The date on which the IP usage license was formally granted for this specific touchpoint. Belongs to the individual grant record, not to the IP asset or the touchpoint globally.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:loyaltyCapable rdf:type rdf:Property ;
    rdfs:label 'Loyalty Capable' ;
    rdfs:comment 'Indicates whether this digital touchpoint supports fan loyalty program interactions including point earning, redemption, and tier status display. Drives Adobe Experience Platform personalization and Salesforce CRM loyalty event tracking.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ltvBaselineUsd rdf:type rdf:Property ;
    rdfs:label 'Ltv Baseline Usd' ;
    rdfs:comment 'The established LTV (Lifetime Value) baseline in US Dollars representing the expected total revenue from a fan acquired through this digital touchpoint over their engagement lifetime. Used for channel investment justification, fan segmentation strategy, and Workday Adaptive Planning revenue modeling.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:merchandiseCapable rdf:type rdf:Property ;
    rdfs:label 'Merchandise Capable' ;
    rdfs:comment 'Indicates whether this digital touchpoint supports merchandise browsing and purchase via the Shopify Plus DTC (Direct-To-Consumer) e-commerce integration. Drives SKU (Stock Keeping Unit) catalog availability and POS (Point of Sale) routing.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumSupportedVersion rdf:type rdf:Property ;
    rdfs:label 'Minimum Supported Version' ;
    rdfs:comment 'The oldest version of the touchpoint application that is still officially supported and receives security patches. Fans on versions below this threshold are prompted to upgrade. Critical for PCI-DSS compliance and GDPR data security obligations.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npsTarget rdf:type rdf:Property ;
    rdfs:label 'Nps Target' ;
    rdfs:comment 'The target NPS (Net Promoter Score) for fan experience quality on this digital touchpoint, ranging from -100 to +100. Used as a KPI benchmark in Adobe Experience Platform fan satisfaction reporting and digital experience design reviews.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pciScope rdf:type rdf:Property ;
    rdfs:label 'Pci Scope' ;
    rdfs:comment 'Indicates whether this digital touchpoint is within PCI-DSS (Payment Card Industry Data Security Standard) scope due to processing, storing, or transmitting cardholder data. True for channels with ticketing, merchandise, or PPV payment capabilities. Drives annual PCI audit scope and security control requirements.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:personalizationEnabled rdf:type rdf:Property ;
    rdfs:label 'Personalization Enabled' ;
    rdfs:comment 'Indicates whether Adobe Experience Platform personalization engine is active for this digital touchpoint, enabling real-time fan experience customization, targeted content recommendations, and dynamic offer delivery.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ppvCapable rdf:type rdf:Property ;
    rdfs:label 'Ppv Capable' ;
    rdfs:comment 'Indicates whether this digital touchpoint supports Pay-Per-View (PPV) event purchases and streaming. Drives PPV product availability, payment flow routing, and PCI-DSS scope determination for the channel.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryMarket rdf:type rdf:Property ;
    rdfs:label 'Primary Market' ;
    rdfs:comment 'The primary geographic market for which this digital touchpoint is designed and operated, expressed as an ISO 3166-1 alpha-3 country code (e.g., USA, GBR, DEU). Drives regulatory compliance applicability (GDPR, CCPA), content geo-restriction rules, and localization configuration.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salesforceChannelRef rdf:type rdf:Property ;
    rdfs:label 'Salesforce Channel Ref' ;
    rdfs:comment 'The channel reference identifier in Salesforce CRM used to attribute fan interactions, case origins, and engagement events to this digital touchpoint. Enables omnichannel fan journey tracking and CRM-based NPS (Net Promoter Score) attribution.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionTimeoutMinutes rdf:type rdf:Property ;
    rdfs:label 'Session Timeout Minutes' ;
    rdfs:comment 'The number of minutes of inactivity after which a fan session on this digital touchpoint is automatically terminated. Configurable per platform type and SLA tier. Drives security compliance and PCI-DSS session management requirements.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supportedLanguages rdf:type rdf:Property ;
    rdfs:label 'Supported Languages' ;
    rdfs:comment 'Comma-delimited list of BCP-47 language codes supported by this digital touchpoint for UI localization (e.g., \'en-US, es-MX, fr-FR, pt-BR\'). Drives content localization workflows, fan experience personalization, and international market expansion planning.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportedOsVersions rdf:type rdf:Property ;
    rdfs:label 'Supported Os Versions' ;
    rdfs:comment 'Comma-delimited list of operating system versions officially supported by this touchpoint (e.g., \'iOS 16+, iOS 17\' or \'Android 12, Android 13, Android 14\'). Null for non-mobile/non-OS-dependent platforms. Used for compatibility testing and fan support triage.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketingCapable rdf:type rdf:Property ;
    rdfs:label 'Ticketing Capable' ;
    rdfs:comment 'Indicates whether this digital touchpoint supports ticket browsing, purchase, and mobile ticket delivery. Drives integration with Ticketmaster/AXS ticketing systems and determines PCI-DSS payment scope for the channel.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:touchpointCode rdf:type rdf:Property ;
    rdfs:label 'Touchpoint Code' ;
    rdfs:comment 'Externally-known, human-readable unique code assigned to the digital channel (e.g., TP-IOSAPP-001, TP-WEBPRT-002). Used as the business identifier across all domain attribution and reporting. Sourced from Adobe Experience Platform channel configuration.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:touchpointName rdf:type rdf:Property ;
    rdfs:label 'Touchpoint Name' ;
    rdfs:comment 'Human-readable display name of the digital channel (e.g., \'Sports Entertainment iOS App\', \'Fan Web Portal\', \'OTT Streaming Player — Roku\'). Used in dashboards, SLA reports, and omnichannel orchestration configurations.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:touchpointStatus rdf:type rdf:Property ;
    rdfs:label 'Touchpoint Status' ;
    rdfs:comment 'Current operational lifecycle state of the digital channel. \'active\' indicates the channel is live and serving fans; \'maintenance\' indicates scheduled downtime; \'deprecated\' indicates the channel is being sunset; \'pilot\' indicates limited-release testing. Drives SLA monitoring and omnichannel routing decisions.' ;
    rdfs:domain ind:DigitalTouchpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanInteractionId rdf:type rdf:Property ;
    rdfs:label 'Fan Interaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each fan interaction record in the platform digital touchpoint system. Primary key for the fan_interaction data product.' ;
    rdfs:domain ind:FanInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:abTestVariantId rdf:type rdf:Property ;
    rdfs:label 'Ab Test Variant Id' ;
    rdfs:comment 'Reference to the A/B test variant that was exposed to the fan during this interaction. Populated only when interaction_type is ab_test_exposure. Used by the personalization engine to measure variant performance.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AbTestVariant .

ind:personalizationRuleId rdf:type rdf:Property ;
    rdfs:label 'Personalization Rule Id' ;
    rdfs:comment 'Reference to the specific personalization rule or recommendation algorithm that surfaced the content or offer triggering this interaction. Enables attribution of engagement outcomes to personalization engine decisions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PersonalizationRule .

ind:pollQuestionId rdf:type rdf:Property ;
    rdfs:label 'Poll Question Id' ;
    rdfs:comment 'Reference to the specific poll or quiz question that the fan responded to. Populated when interaction_type is poll_participation or quiz_participation.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PollQuestion .

ind:abTestVariantLabel rdf:type rdf:Property ;
    rdfs:label 'Ab Test Variant Label' ;
    rdfs:comment 'Label identifying which variant of the A/B test the fan was exposed to (e.g., control, variant_a). Populated when interaction_type is ab_test_exposure.' ;
    rdfs:domain ind:FanInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Interaction Duration Seconds' ;
    rdfs:comment 'Duration in seconds from interaction initiation to completion or abandonment. For content plays and live stream joins, this represents watch/listen time. Null for instantaneous interactions such as social shares or loyalty check-ins.' ;
    rdfs:domain ind:FanInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interactionReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Interaction Reference Code' ;
    rdfs:comment 'Externally-visible business identifier for this interaction record, used in customer support, analytics reporting, and Adobe Experience Platform event correlation. Format: INT- followed by 8-20 alphanumeric characters.' ;
    rdfs:domain ind:FanInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionStatus rdf:type rdf:Property ;
    rdfs:label 'Interaction Status' ;
    rdfs:comment 'Lifecycle outcome state of the interaction: completed (full engagement), abandoned (fan exited before completion), converted (resulted in a purchase or sign-up), in_progress (ongoing at capture time), or error (technical failure during interaction).' ;
    rdfs:domain ind:FanInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Interaction Timestamp' ;
    rdfs:comment 'The precise date and time (UTC) when the fan interaction was initiated on the platform digital touchpoint. This is the principal business event time, distinct from record audit timestamps. Conforms to ISO 8601 format yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:FanInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isFirstInteraction rdf:type rdf:Property ;
    rdfs:label 'Is First Interaction' ;
    rdfs:comment 'Indicates whether this is the fan\'s first recorded interaction of this interaction_type on the platform. Used to measure new engagement acquisition, onboarding funnel entry, and CAC (Customer Acquisition Cost) attribution.' ;
    rdfs:domain ind:FanInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loyaltyPointsAwarded rdf:type rdf:Property ;
    rdfs:label 'Loyalty Points Awarded' ;
    rdfs:comment 'Number of loyalty points credited to the fan\'s account as a result of this interaction. Populated for loyalty check-ins and qualifying engagement actions. Zero for non-qualifying interactions.' ;
    rdfs:domain ind:FanInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pollResponseValue rdf:type rdf:Property ;
    rdfs:label 'Poll Response Value' ;
    rdfs:comment 'The fan\'s selected answer or response text for a poll or quiz interaction. Populated when interaction_type is poll_participation or quiz_participation. Stored as a string to accommodate both option codes and free-text responses.' ;
    rdfs:domain ind:FanInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:purchaseCategory rdf:type rdf:Property ;
    rdfs:label 'Purchase Category' ;
    rdfs:comment 'Category of the in-app purchase initiated during this interaction. PPV (Pay-Per-View) refers to single-event streaming purchases. Populated when interaction_type is in_app_purchase_initiated.' ;
    rdfs:domain ind:FanInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseInitiatedAmount rdf:type rdf:Property ;
    rdfs:label 'Purchase Initiated Amount' ;
    rdfs:comment 'Gross monetary value of the in-app purchase that was initiated during this interaction, in the transaction currency. Populated only when interaction_type is in_app_purchase_initiated. This is the initiated amount, not the confirmed transaction amount (which is owned by the ticketing or merchandise domain).' ;
    rdfs:domain ind:FanInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:socialSharePlatform rdf:type rdf:Property ;
    rdfs:label 'Social Share Platform' ;
    rdfs:comment 'The external social media platform to which the fan shared content. Populated when interaction_type is social_share. Used to measure social amplification and UGC (User Generated Content) reach by platform.' ;
    rdfs:domain ind:FanInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utmCampaign rdf:type rdf:Property ;
    rdfs:label 'Utm Campaign' ;
    rdfs:comment 'Urchin Tracking Module (UTM) campaign parameter captured from the interaction URL or deep link. Used for digital marketing attribution, CPM (Cost Per Mille) analysis, and GRP (Gross Rating Point) measurement across digital channels.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:owningOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Owning Org Unit Id' ;
    rdfs:comment 'Foreign key linking to workforce.org_unit. Business justification: Fan segments are owned by specific org units (marketing, digital, sponsorship) in sports entertainment. This link enables segment governance, headcount-to-segment budget allocation, and org-level audi' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:parentSegmentFanSegmentId rdf:type rdf:Property ;
    rdfs:label 'Parent Segment Fan Segment Id' ;
    rdfs:comment 'Self-referencing identifier pointing to a parent fan segment when this segment is a sub-segment or nested audience within a broader segment hierarchy (e.g., \'High-Value Ticket Buyers\' as parent of \'High-Value Playoff Ticket Buyers\'). Enables hierarchical audience architecture.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanSegment .

ind:activationChannels rdf:type rdf:Property ;
    rdfs:label 'Activation Channels' ;
    rdfs:comment 'Comma-separated list of digital and physical channels through which this segment is activated for targeted engagement (e.g., \'email,push_notification,in_app,paid_social,sms,display_ad\'). Drives omnichannel orchestration across the fan engagement platform. [ENUM-REF-CANDIDATE: email|push_notification|in_app|paid_social|sms|display_ad|iptv|web_personalization — promote to reference product]' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aiModelVersion rdf:type rdf:Property ;
    rdfs:label 'Ai Model Version' ;
    rdfs:comment 'Version identifier of the machine learning or AI model used to generate or score this segment, applicable when segment_type is \'ai_generated\' or \'lookalike\'. Enables model governance, reproducibility audits, and performance tracking over time.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arpuBaseline rdf:type rdf:Property ;
    rdfs:label 'Arpu Baseline' ;
    rdfs:comment 'Baseline Average Revenue Per User (ARPU) value in USD associated with fans in this segment, derived from historical transactional data across ticketing, merchandise, and digital subscriptions. Used for sponsorship audience valuation, DTC campaign ROI forecasting, and revenue planning.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:audienceOverlapPct rdf:type rdf:Property ;
    rdfs:label 'Audience Overlap Pct' ;
    rdfs:comment 'Estimated percentage of this segment\'s membership that also belongs to one or more other active segments. Used to manage audience fatigue, frequency capping, and campaign deduplication in omnichannel orchestration.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cacBenchmark rdf:type rdf:Property ;
    rdfs:label 'Cac Benchmark' ;
    rdfs:comment 'Benchmark Customer Acquisition Cost (CAC) in USD for acquiring a new fan into this segment through paid and owned channels. Used to evaluate DTC campaign efficiency and set maximum bid thresholds for paid media activation.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataStewardName rdf:type rdf:Property ;
    rdfs:label 'Data Steward Name' ;
    rdfs:comment 'Full name of the designated data steward accountable for the accuracy, compliance, and lifecycle management of this segment definition. Required for GDPR accountability and internal data governance.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:definitionLogic rdf:type rdf:Property ;
    rdfs:label 'Definition Logic' ;
    rdfs:comment 'Full textual or serialized expression of the inclusion/exclusion criteria that determine segment membership. May contain SQL-like predicates, Adobe Experience Platform Profile Query Language (PQL) expressions, or Salesforce CRM filter logic. Critical for auditability and reproducibility of audience targeting.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanSegmentDescription rdf:type rdf:Property ;
    rdfs:label 'Fan Segment Description' ;
    rdfs:comment 'Free-text business description of the segment\'s purpose, intended use cases, and strategic rationale. Used in campaign briefs, sponsorship activation proposals, and data governance documentation to communicate segment intent to non-technical stakeholders.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanSegmentStatus rdf:type rdf:Property ;
    rdfs:label 'Fan Segment Status' ;
    rdfs:comment 'Current lifecycle state of the fan segment definition. \'active\' = segment is live and eligible for activation; \'draft\' = segment is being configured and not yet published; \'inactive\' = segment has been paused; \'archived\' = segment is retired and no longer used; \'under_review\' = segment is pending compliance or business approval.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gdprProcessingBasis rdf:type rdf:Property ;
    rdfs:label 'Gdpr Processing Basis' ;
    rdfs:comment 'Legal basis under GDPR Article 6 under which fan personal data is processed for this segment. Required for all segments targeting fans in EU/EEA markets. Must be documented prior to segment activation. Values align to GDPR Article 6(1) lawful bases.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPiiIncluded rdf:type rdf:Property ;
    rdfs:label 'Is Pii Included' ;
    rdfs:comment 'Indicates whether the segment definition logic or activation payload includes or exposes Personally Identifiable Information (PII) attributes. Triggers enhanced GDPR/CCPA compliance controls, data minimisation review, and restricted channel activation policies.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSponsorshipEligible rdf:type rdf:Property ;
    rdfs:label 'Is Sponsorship Eligible' ;
    rdfs:comment 'Indicates whether this segment is approved and available for use in sponsor-funded targeted campaigns and sponsorship activation programs. Segments may be ineligible due to GDPR consent restrictions, audience sensitivity (e.g., minors), or contractual exclusions.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ltvTier rdf:type rdf:Property ;
    rdfs:label 'Ltv Tier' ;
    rdfs:comment 'Categorical Lifetime Value (LTV) tier assigned to this segment based on the aggregate projected revenue contribution of its members over their fan relationship lifecycle. Used for prioritization of engagement investment, VIP experience allocation, and sponsorship audience premium pricing.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxAge rdf:type rdf:Property ;
    rdfs:label 'Max Age' ;
    rdfs:comment 'Maximum age (in years) of fans eligible for inclusion in this segment, as defined in the segment criteria. Used in conjunction with min_age to define demographic targeting bands for campaigns and sponsorship activations.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:membershipCount rdf:type rdf:Property ;
    rdfs:label 'Membership Count' ;
    rdfs:comment 'Point-in-time count of fan profiles currently qualifying for and active within this segment. Refreshed on each segment evaluation cycle. Used for campaign sizing, reach estimation, and sponsorship audience guarantees.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:membershipRefreshFrequency rdf:type rdf:Property ;
    rdfs:label 'Membership Refresh Frequency' ;
    rdfs:comment 'How frequently the segment membership roster is re-evaluated and updated against the current fan profile data. Determines the freshness of audience targeting and impacts platform compute resource allocation.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minAge rdf:type rdf:Property ;
    rdfs:label 'Min Age' ;
    rdfs:comment 'Minimum age (in years) of fans eligible for inclusion in this segment, as defined in the segment criteria. Used to enforce age-gating for alcohol sponsorship activations, gambling promotions, and COPPA/GDPR child data protection compliance.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:npsBaseline rdf:type rdf:Property ;
    rdfs:label 'Nps Baseline' ;
    rdfs:comment 'Baseline Net Promoter Score (NPS) for fans within this segment, derived from fan satisfaction surveys and feedback data. Used to benchmark engagement quality, identify at-risk segments, and measure the impact of targeted experience programs.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sportAffinity rdf:type rdf:Property ;
    rdfs:label 'Sport Affinity' ;
    rdfs:comment 'Comma-separated list of sports or leagues (e.g., \'NFL,NBA,MLS\') that fans in this segment have demonstrated primary affinity toward, based on content consumption, ticketing, and merchandise purchase signals. Used for cross-sport content personalization and league-specific sponsorship targeting.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suppressionListApplied rdf:type rdf:Property ;
    rdfs:label 'Suppression List Applied' ;
    rdfs:comment 'Indicates whether a suppression list (e.g., opt-out, unsubscribe, do-not-contact) has been applied to this segment to exclude fans who have exercised data rights or communication preferences. Critical for GDPR and CCPA compliance.' ;
    rdfs:domain ind:FanSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:featureEntitlementId rdf:type rdf:Property ;
    rdfs:label 'Feature Entitlement Id' ;
    rdfs:comment 'Unique surrogate identifier for each feature entitlement record. Primary key for the platform.feature_entitlement data product. Serves as the SSOT reference for all access control decisions across mobile, web, and OTT touchpoints.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ppvEventPpvPackageId rdf:type rdf:Property ;
    rdfs:label 'Ppv Event Ppv Package Id' ;
    rdfs:comment 'Reference to the specific Pay-Per-View (PPV) event fixture this entitlement grants access to. Populated only when entitlement_type is ppv_purchase. Links to the event domain for event metadata and scheduling context.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PpvPackage .

ind:venueBanId rdf:type rdf:Property ;
    rdfs:label 'Venue Ban Id' ;
    rdfs:comment 'Foreign key linking to security.venue_ban. Business justification: Entitlement revocation upon venue ban: when a venue ban is issued, specific feature entitlements (PPV access, live streaming, loyalty rewards) must be individually revoked. The entitlement revocation ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VenueBan .

ind:autoRenew rdf:type rdf:Property ;
    rdfs:label 'Auto Renew' ;
    rdfs:comment 'Indicates whether this entitlement is configured to automatically renew upon expiry (e.g., recurring subscription-based entitlements). True = auto-renew enabled; False = one-time or manually renewed. Drives subscription lifecycle management.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concurrentAccessLimit rdf:type rdf:Property ;
    rdfs:label 'Concurrent Access Limit' ;
    rdfs:comment 'Maximum number of simultaneous active sessions permitted under this entitlement (e.g., 1 for PPV single-screen, 3 for family subscription tier). Enforced by the session management layer across mobile, web, and OTT touchpoints.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deviceTypeRestriction rdf:type rdf:Property ;
    rdfs:label 'Device Type Restriction' ;
    rdfs:comment 'Pipe-delimited list of device types on which this entitlement may be consumed (e.g., smartphone|tablet|smart_tv|desktop|console). Null indicates no device restriction. Enforced by the DRM and session management layer.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drmLicenseType rdf:type rdf:Property ;
    rdfs:label 'Drm License Type' ;
    rdfs:comment 'The Digital Rights Management (DRM) license scheme applied to this entitlement for content protection. Governs how the content can be decrypted and rendered on the fan\'s device. Values: widevine (Google/Android), fairplay (Apple), playready (Microsoft), clear (unprotected), multi_drm (adaptive multi-scheme).' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entitlementCode rdf:type rdf:Property ;
    rdfs:label 'Entitlement Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for this entitlement record, used in customer communications, support tickets, and access control audit logs. Format: ENT- followed by 6–20 uppercase alphanumeric characters.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entitlementSourceReference rdf:type rdf:Property ;
    rdfs:label 'Entitlement Source Reference' ;
    rdfs:comment 'External reference identifier from the originating source system that triggered this entitlement (e.g., Ticketmaster order ID for PPV purchase, Salesforce opportunity ID for sponsor grant, promotional code string for marketing campaign). Enables traceability back to the originating transaction.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entitlementStatus rdf:type rdf:Property ;
    rdfs:label 'Entitlement Status' ;
    rdfs:comment 'Current lifecycle state of the entitlement. Controls whether access is granted at runtime. active=currently valid and accessible; suspended=temporarily blocked; expired=past effective_until date; revoked=administratively cancelled; pending=granted but not yet effective; consumed=single-use entitlement fully used.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entitlementType rdf:type rdf:Property ;
    rdfs:label 'Entitlement Type' ;
    rdfs:comment 'Classification of the source mechanism that granted this entitlement. Drives access control logic and revenue attribution. Values: subscription (recurring tier), ppv_purchase (Pay-Per-View one-time purchase), sponsor_grant (sponsor-funded access), loyalty_milestone (loyalty program reward), promotional_code (marketing promo), complimentary (manually granted). [ENUM-REF-CANDIDATE: subscription|ppv_purchase|sponsor_grant|loyalty_milestone|promotional_code|complimentary — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entitlementValueAmount rdf:type rdf:Property ;
    rdfs:label 'Entitlement Value Amount' ;
    rdfs:comment 'The monetary value attributed to this entitlement at the time of grant, expressed in the currency indicated by currency_code. Used for sponsor ROI reporting, ARPU (Average Revenue Per User) analysis, and LTV (Lifetime Value) modelling. For complimentary or loyalty grants, this reflects the fair market value.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geoBlackoutCode rdf:type rdf:Property ;
    rdfs:label 'Geo Blackout Code' ;
    rdfs:comment 'Pipe-delimited list of ISO 3166-1 alpha-3 country codes where this entitlement is explicitly blocked due to broadcast blackout rules or rights restrictions (e.g., RSN blackout zones). Takes precedence over geo_restriction_code.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geoRestrictionCode rdf:type rdf:Property ;
    rdfs:label 'Geo Restriction Code' ;
    rdfs:comment 'Pipe-delimited list of ISO 3166-1 alpha-3 country codes where this entitlement is valid (e.g., USA|CAN|GBR). Null indicates no geographic restriction. Enforced at the CDN and OTT access layer to comply with broadcast rights windows and GDPR/CCPA jurisdictional requirements.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gracePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Grace Period Days' ;
    rdfs:comment 'Number of days after the effective_until date during which the entitlement remains accessible before hard expiry. Used to accommodate payment retry windows for subscription renewals and to improve fan retention metrics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:grantedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Granted Timestamp' ;
    rdfs:comment 'The real-world business event timestamp when this entitlement was issued to the fan account — i.e., when the purchase was completed, the loyalty milestone was reached, or the sponsor grant was applied. Distinct from the record audit created timestamp.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:loyaltyTierCode rdf:type rdf:Property ;
    rdfs:label 'Loyalty Tier Code' ;
    rdfs:comment 'The fan loyalty program tier code at the time this entitlement was granted (e.g., BRONZE, SILVER, GOLD, PLATINUM). Populated when entitlement_type is loyalty_milestone. Used for loyalty analytics and milestone validation.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offlineAccessPermitted rdf:type rdf:Property ;
    rdfs:label 'Offline Access Permitted' ;
    rdfs:comment 'Indicates whether the fan may access the entitled content or feature while the device is offline (e.g., cached content, offline loyalty wallet). Distinct from download_permitted — covers broader offline capability beyond downloaded files.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentalRatingCode rdf:type rdf:Property ;
    rdfs:label 'Parental Rating Code' ;
    rdfs:comment 'Content rating classification applied to this entitlement\'s associated feature or content asset. Used to enforce parental controls and age-gating at the access layer. Follows US broadcast and film rating standards. [ENUM-REF-CANDIDATE: G|PG|PG-13|R|NC-17|TV-Y|TV-G|TV-PG|TV-14|TV-MA — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promotionalCode rdf:type rdf:Property ;
    rdfs:label 'Promotional Code' ;
    rdfs:comment 'The marketing or sponsor promotional code that was redeemed to generate this entitlement. Populated only when entitlement_type is promotional_code. Used for campaign attribution, redemption rate reporting, and sponsor ROI analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionCap rdf:type rdf:Property ;
    rdfs:label 'Resolution Cap' ;
    rdfs:comment 'Maximum video resolution permitted under this entitlement for streaming content. Used to differentiate subscription tiers (e.g., Basic=SD, Premium=4K). Enforced by the CDN and OTT delivery layer.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revokedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Revoked Timestamp' ;
    rdfs:comment 'Date and time when this entitlement was revoked or suspended. Populated only when entitlement_status is revoked or suspended. Used for compliance reporting and fan dispute resolution timelines.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:slaTierCode rdf:type rdf:Property ;
    rdfs:label 'Sla Tier Code' ;
    rdfs:comment 'Service Level Agreement (SLA) tier assigned to this entitlement, governing platform performance guarantees such as stream start time, uptime, and support response time. Values: standard, premium, vip, enterprise. Used for SLA monitoring and breach reporting.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferable rdf:type rdf:Property ;
    rdfs:label 'Transferable' ;
    rdfs:comment 'Indicates whether this entitlement can be transferred or gifted to another fan account. True = transferable (e.g., gifted PPV access, sponsor-granted VIP passes); False = non-transferable (bound to the original fan account). Enforced by the access control engine.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:usageCount rdf:type rdf:Property ;
    rdfs:label 'Usage Count' ;
    rdfs:comment 'Running count of the number of times this entitlement has been consumed or accessed to date. Compared against usage_limit to determine whether the entitlement is exhausted. Updated by the access control engine on each successful access event.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:usageLimit rdf:type rdf:Property ;
    rdfs:label 'Usage Limit' ;
    rdfs:comment 'Maximum total number of times this entitlement may be consumed or accessed (e.g., 1 for a single-use PPV token, 5 for a multi-use loyalty reward redemption). Null indicates unlimited usage within the effective date window.' ;
    rdfs:domain ind:FeatureEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deliveryVendorId rdf:type rdf:Property ;
    rdfs:label 'Delivery Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: Notification campaigns are delivered via push gateway vendors (e.g., Braze, Firebase). Linking to vendor enables delivery SLA compliance tracking, cost-per-campaign allocation, and vendor performance ' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:messageTemplateId rdf:type rdf:Property ;
    rdfs:label 'Message Template Id' ;
    rdfs:comment 'Reference to the master message template record defining the notification body, subject line, and personalization token structure used by this campaign. Templates are managed in Adobe Experience Platform Content Library.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MessageTemplate .

ind:primaryNotificationEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Notification Employee Id' ;
    rdfs:comment 'Platform user identifier (Salesforce CRM or Adobe Experience Platform user) who authored and submitted the campaign for approval. Used for accountability and audit trail purposes.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:abTestEnabled rdf:type rdf:Property ;
    rdfs:label 'Ab Test Enabled' ;
    rdfs:comment 'Indicates whether this campaign is configured as an A/B variant test. When True, the campaign includes multiple message variants distributed across the target segment to measure comparative engagement performance.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:abVariantCount rdf:type rdf:Property ;
    rdfs:label 'Ab Variant Count' ;
    rdfs:comment 'Number of distinct message variants defined for this A/B test campaign. Typically 2 (A and B) but may include up to 5 variants for multivariate tests. Only meaningful when ab_test_enabled is True.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:abWinningVariant rdf:type rdf:Property ;
    rdfs:label 'Ab Winning Variant' ;
    rdfs:comment 'Identifier of the winning message variant (e.g., \'A\', \'B\', \'C\') as determined by the A/B test evaluation criteria (e.g., highest open rate, highest click-through rate). Populated after the test evaluation window closes.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualLaunchTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Launch Timestamp' ;
    rdfs:comment 'The actual date and time the campaign was activated and first notifications began dispatching. May differ from scheduled_start_timestamp due to approval delays or manual overrides. Populated upon campaign activation.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:campaignCode rdf:type rdf:Property ;
    rdfs:label 'Campaign Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the campaign, used for cross-system tracking in Salesforce CRM, Adobe Experience Platform, and reporting dashboards. Follows the platform naming convention (e.g., PUSH_EVT_2025_NBA_FINALS).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:campaignDescription rdf:type rdf:Property ;
    rdfs:label 'Campaign Description' ;
    rdfs:comment 'Free-text business description of the campaign\'s objective, target audience rationale, and expected fan action. Used by marketing and platform teams for campaign documentation and stakeholder communication.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:campaignStatus rdf:type rdf:Property ;
    rdfs:label 'Campaign Status' ;
    rdfs:comment 'Current lifecycle state of the notification campaign. Controls whether the campaign is eligible for delivery execution. Draft = in authoring; Scheduled = approved and queued; Active = currently delivering; Paused = temporarily halted; Completed = delivery window closed; Cancelled = terminated before completion.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:campaignType rdf:type rdf:Property ;
    rdfs:label 'Campaign Type' ;
    rdfs:comment 'Business classification of the campaign\'s primary purpose. Drives template selection, personalization logic, and regulatory compliance checks. [ENUM-REF-CANDIDATE: event_reminder|ticket_alert|merchandise_drop|loyalty_milestone|content_recommendation|re_engagement — promote to reference product if additional types are added]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:canSpamCompliant rdf:type rdf:Property ;
    rdfs:label 'Can Spam Compliant' ;
    rdfs:comment 'Indicates whether the email channel configuration for this campaign has been verified as compliant with the CAN-SPAM Act requirements, including valid sender address, physical mailing address, and functional unsubscribe mechanism. Required for all email notification campaigns.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ccpaCompliant rdf:type rdf:Property ;
    rdfs:label 'Ccpa Compliant' ;
    rdfs:comment 'Indicates whether the campaign has been reviewed and confirmed compliant with CCPA requirements for California-resident fans, including honoring opt-out of sale/sharing of personal information and providing required disclosures.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:channelMix rdf:type rdf:Property ;
    rdfs:label 'Channel Mix' ;
    rdfs:comment 'Pipe-delimited list of omnichannel delivery channels enabled for this campaign (e.g., \'push|sms|email|in_app\'). Supported channels: push (mobile push notification), sms (SMS/text alert), email (email trigger), in_app (in-app message). Governs which channel-specific templates and regulatory consent checks are applied.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deepLinkUrl rdf:type rdf:Property ;
    rdfs:label 'Deep Link Url' ;
    rdfs:comment 'The primary call-to-action deep link URL embedded in the notification, directing fans to a specific in-app screen or web page (e.g., ticket purchase page, merchandise product page, content player). Supports both universal links (iOS) and app links (Android).' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliverySlaTargetPct rdf:type rdf:Property ;
    rdfs:label 'Delivery Sla Target Pct' ;
    rdfs:comment 'The contractual or operational SLA target for delivery rate expressed as a percentage (e.g., 95.00 = 95%). Defines the minimum acceptable proportion of sent notifications that must be confirmed delivered. Used for SLA monitoring and platform performance reporting.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eprivacyCompliant rdf:type rdf:Property ;
    rdfs:label 'Eprivacy Compliant' ;
    rdfs:comment 'Indicates whether the campaign complies with the EU ePrivacy Directive requirements for electronic communications, including cookie consent and direct marketing rules applicable to push notifications and in-app messages targeting EU-resident fans.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:frequencyCap rdf:type rdf:Property ;
    rdfs:label 'Frequency Cap' ;
    rdfs:comment 'Maximum number of notifications a single fan profile may receive from this campaign within the frequency_cap_period. Prevents notification fatigue and supports fan experience quality standards. A value of 0 indicates no cap is applied.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyCapPeriod rdf:type rdf:Property ;
    rdfs:label 'Frequency Cap Period' ;
    rdfs:comment 'The time window over which the frequency_cap limit is enforced per fan profile. Day = rolling 24-hour window; Week = rolling 7-day window; Month = calendar month; Campaign_lifetime = total across the full campaign duration.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personalizationTokenMap rdf:type rdf:Property ;
    rdfs:label 'Personalization Token Map' ;
    rdfs:comment 'JSON-serialized key-value mapping of personalization tokens to their data source bindings (e.g., \'{"fan_first_name": "profile.given_name", "event_name": "event.name"}\') as configured in Adobe Experience Platform. Enables dynamic content substitution at delivery time.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quietHoursEnforced rdf:type rdf:Property ;
    rdfs:label 'Quiet Hours Enforced' ;
    rdfs:comment 'Indicates whether the campaign respects configured quiet hours (e.g., no push or SMS notifications between 10 PM and 8 AM local fan time). Required for TCPA compliance on SMS channels and best-practice fan experience management.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:schedulingRule rdf:type rdf:Property ;
    rdfs:label 'Scheduling Rule' ;
    rdfs:comment 'Defines the dispatch timing logic for the campaign. One_time = single batch send; Recurring_daily/weekly = repeated sends on a schedule; Event_triggered = dispatched upon a platform event (e.g., ticket purchase confirmation); Behavior_triggered = dispatched upon fan behavior signal (e.g., app session, cart abandonment).' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sendTimeOptimizationEnabled rdf:type rdf:Property ;
    rdfs:label 'Send Time Optimization Enabled' ;
    rdfs:comment 'Indicates whether Adobe Experience Platform\'s AI-driven send-time optimization is enabled for this campaign. When True, the platform dynamically adjusts individual fan notification delivery times to maximize open rates based on historical engagement patterns.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetSegmentSize rdf:type rdf:Property ;
    rdfs:label 'Target Segment Size' ;
    rdfs:comment 'Total number of fan profiles included in the target audience segment at the time the campaign was scheduled or launched. Captured as a point-in-time snapshot for delivery planning and post-campaign analysis.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tcpaCompliant rdf:type rdf:Property ;
    rdfs:label 'Tcpa Compliant' ;
    rdfs:comment 'Indicates whether the SMS channel configuration for this campaign has been verified as compliant with TCPA requirements, including prior express written consent for marketing messages and adherence to quiet hours. Required for all SMS notification campaigns.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalBounced rdf:type rdf:Property ;
    rdfs:label 'Total Bounced' ;
    rdfs:comment 'Cumulative count of notifications that failed to deliver due to invalid addresses, inactive device tokens, or carrier rejections. Includes both hard bounces (permanent failures) and soft bounces (temporary failures). Used for list hygiene and deliverability management.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalClicked rdf:type rdf:Property ;
    rdfs:label 'Total Clicked' ;
    rdfs:comment 'Cumulative count of notifications where the fan clicked a call-to-action link or deep link (e.g., \'Buy Tickets\', \'Shop Now\', \'Watch Now\'). Primary engagement metric for conversion attribution and ROI measurement.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalDelivered rdf:type rdf:Property ;
    rdfs:label 'Total Delivered' ;
    rdfs:comment 'Cumulative count of notification messages confirmed as successfully delivered to fan devices or inboxes. Excludes bounces, unsubscribes, and delivery failures. Used to compute delivery rate for SLA monitoring.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalOpened rdf:type rdf:Property ;
    rdfs:label 'Total Opened' ;
    rdfs:comment 'Cumulative count of delivered notifications that were opened or viewed by the fan recipient. For push notifications, this is a tap event; for email, this is a pixel-tracked open event. Used to compute open rate for campaign performance reporting.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalSent rdf:type rdf:Property ;
    rdfs:label 'Total Sent' ;
    rdfs:comment 'Cumulative count of notification messages dispatched to fans across all enabled channels for this campaign. Updated in near-real-time as delivery progresses. Represents the raw send volume before delivery confirmation.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalUnsubscribed rdf:type rdf:Property ;
    rdfs:label 'Total Unsubscribed' ;
    rdfs:comment 'Cumulative count of fans who opted out of future notifications via the unsubscribe mechanism triggered by this campaign. Critical for CAN-SPAM, TCPA, and GDPR compliance tracking. Unsubscribe requests must be honored within 10 business days per CAN-SPAM.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:utmParameters rdf:type rdf:Property ;
    rdfs:label 'Utm Parameters' ;
    rdfs:comment 'URL tracking parameters appended to the deep link for campaign attribution in web analytics (e.g., \'utm_source=push&utm_medium=notification&utm_campaign=NBA_FINALS_2025\'). Enables attribution of fan conversions to specific notification campaigns in Adobe Analytics.' ;
    rdfs:domain ind:NotificationCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredTeamFranchiseId rdf:type rdf:Property ;
    rdfs:label 'Preferred Team Franchise Id' ;
    rdfs:comment 'Reference to the fan\'s primary team affiliation used to personalize content feeds, merchandise recommendations, and event notifications. Sourced from AEP behavioral segment data.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Franchise .

ind:primaryFanSegmentId rdf:type rdf:Property ;
    rdfs:label 'Primary Fan Segment Id' ;
    rdfs:comment 'Foreign key linking to platform.fan_segment. Business justification: personalization_profile.primary_segment_name is a STRING denoting the fan\'s primary audience segment. Replacing with primary_fan_segment_id FK to fan_segment normalizes this to the master segment regi' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanSegment .

ind:contentAffinityScore rdf:type rdf:Property ;
    rdfs:label 'Content Affinity Score' ;
    rdfs:comment 'Normalized affinity score (0.0000–1.0000) produced by the AEP personalization engine representing the fan\'s overall propensity to engage with recommended content. Higher scores indicate stronger behavioral alignment with recommended content types. Raw model output — not a calculated KPI.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataResidencyRegion rdf:type rdf:Property ;
    rdfs:label 'Data Residency Region' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code indicating the geographic region where this fan\'s personalization data must be stored and processed, per GDPR data residency and cross-border transfer requirements. [ENUM-REF-CANDIDATE: USA|GBR|DEU|FRA|AUS|CAN|JPN|BRA|MEX|SGP — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dtcSubscriber rdf:type rdf:Property ;
    rdfs:label 'Dtc Subscriber' ;
    rdfs:comment 'Indicates whether the fan holds an active DTC (Direct-To-Consumer) digital subscription (e.g., OTT streaming pass, league app subscription). Enables personalization of premium content and subscriber-exclusive offers.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fanValueTier rdf:type rdf:Property ;
    rdfs:label 'Fan Value Tier' ;
    rdfs:comment 'Segmentation tier assigned by the personalization engine based on the fan\'s engagement depth, purchase history, and LTV (Lifetime Value) signals. Drives differentiated personalization experiences and VIP (Very Important Person) content access.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followedAthleteCount rdf:type rdf:Property ;
    rdfs:label 'Followed Athlete Count' ;
    rdfs:comment 'Number of individual athletes the fan is actively following within the platform. Used as a signal for personalization depth and fan engagement intensity scoring.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastActiveDate rdf:type rdf:Property ;
    rdfs:label 'Last Active Date' ;
    rdfs:comment 'Date of the fan\'s most recent authenticated interaction with any digital touchpoint (mobile app, web portal, OTT streaming). Used to identify dormant fans for re-engagement campaigns.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPurchaseDate rdf:type rdf:Property ;
    rdfs:label 'Last Purchase Date' ;
    rdfs:comment 'Date of the fan\'s most recent transactional purchase (ticket, merchandise, PPV event, or subscription). Used by the personalization engine to determine purchase recency signals for recommendation targeting.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastSyncTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Sync Timestamp' ;
    rdfs:comment 'Timestamp of the most recent successful synchronization between the AEP personalization engine and this Silver layer record. Used to assess data freshness and trigger re-sync workflows when staleness thresholds are breached.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:localeCode rdf:type rdf:Property ;
    rdfs:label 'Locale Code' ;
    rdfs:comment 'IETF BCP 47 locale code combining language and region (e.g., \'en_US\', \'es_MX\', \'fr_CA\'). Governs date/time formatting, currency display, and regional content availability within the digital platform.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:merchandiseAffinityScore rdf:type rdf:Property ;
    rdfs:label 'Merchandise Affinity Score' ;
    rdfs:comment 'Normalized affinity score (0.0000–1.0000) from the AEP personalization engine indicating the fan\'s propensity to engage with merchandise recommendations. Feeds into Shopify Plus DTC (Direct-To-Consumer) personalized product recommendations.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notificationFrequencyCap rdf:type rdf:Property ;
    rdfs:label 'Notification Frequency Cap' ;
    rdfs:comment 'Maximum number of personalized push/email/SMS notifications the fan has configured to receive per day. Enforced by the omnichannel orchestration layer to prevent notification fatigue and protect NPS scores.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:personalizationEngineVersion rdf:type rdf:Property ;
    rdfs:label 'Personalization Engine Version' ;
    rdfs:comment 'Version identifier of the AEP personalization model or algorithm that generated the current affinity scores and segment memberships. Enables model governance, A/B testing attribution, and reproducibility audits.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppvPurchaser rdf:type rdf:Property ;
    rdfs:label 'Ppv Purchaser' ;
    rdfs:comment 'Indicates whether the fan has made at least one PPV (Pay-Per-View) purchase. Used to segment high-intent fans for premium event personalization and PPV upsell campaigns.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferredContentGenre rdf:type rdf:Property ;
    rdfs:label 'Preferred Content Genre' ;
    rdfs:comment 'The fan\'s dominant content consumption genre as identified by AEP behavioral analysis (e.g., live_game, highlights, behind_the_scenes, analysis, interviews, documentary). Drives content recommendation engine targeting. [ENUM-REF-CANDIDATE: live_game|highlights|behind_the_scenes|analysis|interviews|documentary|news — promote to reference product]' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profileCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Profile Created Timestamp' ;
    rdfs:comment 'Timestamp when the personalization profile was first created in the AEP system and ingested into the Silver layer. Represents the start of the fan\'s personalization lifecycle.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:profileStatus rdf:type rdf:Property ;
    rdfs:label 'Profile Status' ;
    rdfs:comment 'Current lifecycle state of the personalization profile. \'suppressed\' indicates the fan has opted out of personalization processing per GDPR/CCPA consent requirements. \'pending_sync\' indicates the profile is awaiting the next AEP synchronization cycle.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profileUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Profile Updated Timestamp' ;
    rdfs:comment 'Timestamp of the most recent update to any attribute within this personalization profile record. Used for change data capture (CDC) processing and audit trail compliance.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:quietHoursEnd rdf:type rdf:Property ;
    rdfs:label 'Quiet Hours End' ;
    rdfs:comment 'Local time (HH:MM, 24-hour format) at which the fan\'s notification quiet period ends. Notifications resume after this time. Stored as STRING to represent time-of-day independent of date.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quietHoursStart rdf:type rdf:Property ;
    rdfs:label 'Quiet Hours Start' ;
    rdfs:comment 'Local time (HH:MM, 24-hour format) at which the fan\'s notification quiet period begins. No push, SMS, or email notifications are dispatched during the quiet window. Stored as STRING to represent time-of-day independent of date.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentMembershipCount rdf:type rdf:Property ;
    rdfs:label 'Segment Membership Count' ;
    rdfs:comment 'Number of active AEP audience segments the fan is currently a member of. Reflects the breadth of personalization targeting applicable to this fan at the time of last sync.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:smsNotificationEnabled rdf:type rdf:Property ;
    rdfs:label 'Sms Notification Enabled' ;
    rdfs:comment 'Indicates whether the fan has opted in to receive personalized SMS text message communications. Governed by TCPA, GDPR, and CCPA consent frameworks.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:syncFrequency rdf:type rdf:Property ;
    rdfs:label 'Sync Frequency' ;
    rdfs:comment 'Configured synchronization cadence between AEP and the lakehouse Silver layer for this profile. Real-time sync applies to high-value fans (platinum/gold tier); batch sync applies to lower-tier fans to optimize platform SLA costs.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketingAffinityScore rdf:type rdf:Property ;
    rdfs:label 'Ticketing Affinity Score' ;
    rdfs:comment 'Normalized affinity score (0.0000–1.0000) from the AEP personalization engine indicating the fan\'s propensity to purchase event tickets. Integrates with Ticketmaster/AXS for targeted ticket offer delivery.' ;
    rdfs:domain ind:PersonalizationProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mergedIntoAccountFanAccountId rdf:type rdf:Property ;
    rdfs:label 'Merged Into Account Fan Account Id' ;
    rdfs:comment 'When account_status is \'merged\', this field holds the platform_fan_account_id of the surviving/target account into which this account was consolidated. Enables identity resolution lineage tracking and prevents duplicate fan profiles in analytics.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanAccount .

ind:accountDeactivationDate rdf:type rdf:Property ;
    rdfs:label 'Account Deactivation Date' ;
    rdfs:comment 'Date on which the fan account was deactivated (fan-initiated or admin-initiated). Null for active accounts. Used for GDPR right-to-erasure scheduling, data retention policy enforcement, and churn cohort analysis.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountSuspensionReason rdf:type rdf:Property ;
    rdfs:label 'Account Suspension Reason' ;
    rdfs:comment 'Reason code for the current or most recent account suspension. Populated only when account_status is \'suspended\'. Used for customer service case management, fraud operations, and compliance audit trails.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activeDeviceCount rdf:type rdf:Property ;
    rdfs:label 'Active Device Count' ;
    rdfs:comment 'Current count of registered/active devices linked to this fan account. Compared against device_limit to enforce concurrent streaming restrictions and flag potential account sharing violations.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:arpuBaselineAmount rdf:type rdf:Property ;
    rdfs:label 'Arpu Baseline Amount' ;
    rdfs:comment 'The baseline Average Revenue Per User (ARPU) figure in the platform\'s operating currency, representing the fan\'s average monthly revenue contribution across all digital channels (subscriptions, DTC purchases, PPV events). Sourced from SAP S/4HANA SD module and used as a KPI baseline for digital performance reporting.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cacSource rdf:type rdf:Property ;
    rdfs:label 'Cac Source' ;
    rdfs:comment 'The marketing channel or campaign source attributed to acquiring this fan account, used for Customer Acquisition Cost (CAC) analysis and Return on Investment (ROI) reporting. Examples: \'organic_search\', \'paid_social\', \'email_campaign\', \'referral\', \'event_activation\', \'dtc_app_store\'. [ENUM-REF-CANDIDATE: organic_search|paid_social|email_campaign|referral|event_activation|dtc_app_store|affiliate|direct — promote to reference product]' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentDataSharing rdf:type rdf:Property ;
    rdfs:label 'Consent Data Sharing' ;
    rdfs:comment 'Indicates whether the fan has consented to sharing their behavioural and profile data with Sports Entertainment\'s commercial partners (sponsors, broadcasters, merchandise partners) for personalization and targeted advertising. Governs data activation in Adobe Experience Platform audience segments.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentMarketingEmail rdf:type rdf:Property ;
    rdfs:label 'Consent Marketing Email' ;
    rdfs:comment 'Indicates whether the fan has provided explicit opt-in consent to receive marketing email communications from Sports Entertainment. Required for GDPR Article 6 lawful basis and CAN-SPAM compliance. Drives Salesforce CRM email campaign eligibility.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentPushNotification rdf:type rdf:Property ;
    rdfs:label 'Consent Push Notification' ;
    rdfs:comment 'Indicates whether the fan has granted permission for push notifications on their registered mobile devices. Governs mobile app engagement campaigns, live event alerts, and personalized content recommendations via the Sports Entertainment mobile platform.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deviceLimit rdf:type rdf:Property ;
    rdfs:label 'Device Limit' ;
    rdfs:comment 'Maximum number of concurrent devices permitted to stream or access content under this fan account, as defined by the account tier\'s entitlement policy. Enforced at the platform session management layer to comply with broadcast rights and DRM licensing terms.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dtcChannelFlag rdf:type rdf:Property ;
    rdfs:label 'Dtc Channel Flag' ;
    rdfs:comment 'Indicates whether this fan account was acquired or is primarily engaged through a Direct-To-Consumer (DTC) digital channel (e.g., Sports Entertainment\'s own app or web portal) as opposed to a third-party platform or RSN. Key segmentation flag for DTC strategy performance reporting.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalAccountRef rdf:type rdf:Property ;
    rdfs:label 'External Account Ref' ;
    rdfs:comment 'Externally-known account identifier surfaced to the fan across digital touchpoints (e.g., displayed in the fan portal, mobile app, and Adobe Experience Platform profile). Serves as the business-facing account number distinct from the internal surrogate key.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityProvider rdf:type rdf:Property ;
    rdfs:label 'Identity Provider' ;
    rdfs:comment 'The authentication identity provider (IdP) used to create or link this fan account. \'native\' — Sports Entertainment-managed credentials; \'google\'/\'apple\'/\'facebook\'/\'twitter\' — social login OAuth providers; \'sso_enterprise\' — corporate SSO for B2B/hospitality accounts. [ENUM-REF-CANDIDATE: native|google|apple|facebook|twitter|sso_enterprise|microsoft — promote to reference product if additional providers are onboarded]' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEmailVerified rdf:type rdf:Property ;
    rdfs:label 'Is Email Verified' ;
    rdfs:comment 'Indicates whether the fan has completed email address verification via a confirmation link or OTP. Unverified accounts may have restricted access to ticketing, payments, and premium content per platform policy.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMfaEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Mfa Enabled' ;
    rdfs:comment 'Indicates whether the fan has enrolled in Multi-Factor Authentication (MFA) for their platform account. MFA enrollment is required for VIP-tier accounts and recommended for all accounts with stored payment methods per PCI DSS requirements.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSubscriptionActive rdf:type rdf:Property ;
    rdfs:label 'Is Subscription Active' ;
    rdfs:comment 'Indicates whether the fan currently holds an active paid subscription (premium or VIP tier) on the Sports Entertainment platform. Drives content entitlement checks, OTT access gates, and Annual Recurring Revenue (ARR) reporting.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:linkedSeasonTicketFlag rdf:type rdf:Property ;
    rdfs:label 'Linked Season Ticket Flag' ;
    rdfs:comment 'Indicates whether this platform fan account is linked to one or more season ticket accounts in the Archtics venue seating and inventory management system. Enables cross-domain fan identity resolution between the digital platform and ticketing systems.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ltvScoreBucket rdf:type rdf:Property ;
    rdfs:label 'Ltv Score Bucket' ;
    rdfs:comment 'Categorical Lifetime Value (LTV) score bucket assigned to the fan account based on predictive modelling in Adobe Experience Platform. \'low\' — minimal engagement/spend; \'medium\' — moderate; \'high\' — strong recurring revenue; \'champion\' — top-tier fans with highest LTV and advocacy potential. Used for personalization, offer targeting, and retention investment prioritization.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppvEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Ppv Eligible Flag' ;
    rdfs:comment 'Indicates whether this fan account is eligible to purchase Pay-Per-View (PPV) events based on account tier, verified payment method, geographic rights, and age verification status. Drives PPV purchase flow gating on the OTT platform.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferredLocale rdf:type rdf:Property ;
    rdfs:label 'Preferred Locale' ;
    rdfs:comment 'IETF BCP 47 locale code representing the fan\'s preferred language and regional format settings (e.g., \'en_US\', \'fr_FR\', \'es_MX\'). Drives content localization, notification language, and regional broadcast rights enforcement across OTT and digital platforms.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriptionEndDate rdf:type rdf:Property ;
    rdfs:label 'Subscription End Date' ;
    rdfs:comment 'Date on which the fan\'s current subscription period expires or is scheduled to renew. Null for open-ended or auto-renewing subscriptions until cancellation is confirmed. Drives renewal notifications and churn risk flagging.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subscriptionPlanCode rdf:type rdf:Property ;
    rdfs:label 'Subscription Plan Code' ;
    rdfs:comment 'Code identifying the specific subscription plan the fan is enrolled in (e.g., \'PREMIUM_MONTHLY\', \'VIP_ANNUAL\', \'OTT_BUNDLE\'). Maps to the subscription plan catalogue managed in the platform billing system and drives entitlement resolution.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriptionStartDate rdf:type rdf:Property ;
    rdfs:label 'Subscription Start Date' ;
    rdfs:comment 'Date on which the fan\'s current subscription period commenced. Used for billing cycle management, renewal scheduling, and cohort-based Annual Recurring Revenue (ARR) analysis.' ;
    rdfs:domain ind:FanAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:abTestVariantKey rdf:type rdf:Property ;
    rdfs:label 'Ab Test Variant Key' ;
    rdfs:comment 'The specific variant identifier (e.g., \'control\', \'variant_a\', \'variant_b\') assigned to this notification delivery within the referenced A/B test. Used to attribute fan actions to specific test variants for significance testing.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:badgeCount rdf:type rdf:Property ;
    rdfs:label 'Badge Count' ;
    rdfs:comment 'The numeric badge count set on the app icon as part of this push notification delivery. Used to indicate the number of unread notifications to the fan. A value of 0 clears the badge.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deepLinkDestinationType rdf:type rdf:Property ;
    rdfs:label 'Deep Link Destination Type' ;
    rdfs:comment 'Categorical classification of the deep link destination within the fan-facing app or web portal. Used to analyze which destination types drive the highest engagement and conversion from push notifications. [ENUM-REF-CANDIDATE: event_detail|content_asset|ticket_purchase|merchandise|loyalty_hub|live_score|home_screen — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:devicePlatform rdf:type rdf:Property ;
    rdfs:label 'Device Platform' ;
    rdfs:comment 'The operating system platform of the target device for this push notification. Used to segment delivery performance by platform and to route notifications to the correct push gateway.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanAction rdf:type rdf:Property ;
    rdfs:label 'Fan Action' ;
    rdfs:comment 'The action taken by the fan upon receiving the push notification. Opened: fan tapped to open the app; Dismissed: fan explicitly dismissed the notification; Ignored: notification expired without interaction; Deep_link_followed: fan tapped a deep link within the notification; None: action not yet recorded or not applicable.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanActionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Fan Action Timestamp' ;
    rdfs:comment 'The date and time at which the fan performed the recorded action (open, dismiss, deep link follow) on the push notification. Null if no action was taken. Used to compute time-to-open and engagement latency metrics.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:messageBody rdf:type rdf:Property ;
    rdfs:label 'Message Body' ;
    rdfs:comment 'The full body text of the push notification as displayed to the fan. May contain personalization tokens resolved at send time (e.g., fan name, team name, score). Used for content auditing and regulatory compliance review.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:messageTitle rdf:type rdf:Property ;
    rdfs:label 'Message Title' ;
    rdfs:comment 'The headline text displayed in the push notification banner on the fan\'s device. Typically 40–65 characters. Used for content performance analysis and A/B test variant comparison.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationLocale rdf:type rdf:Property ;
    rdfs:label 'Notification Locale' ;
    rdfs:comment 'The IETF BCP 47 locale code (e.g., en-US, es-MX, fr-FR) used to render the notification message content. Supports multilingual fan engagement across global markets.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payloadSizeBytes rdf:type rdf:Property ;
    rdfs:label 'Payload Size Bytes' ;
    rdfs:comment 'The size of the push notification payload in bytes at the time of dispatch. APNs enforces a 4KB limit and FCM enforces a 4KB limit for data messages. Used for payload optimization monitoring and gateway compliance.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pushToken rdf:type rdf:Property ;
    rdfs:label 'Push Token' ;
    rdfs:comment 'The device-specific push notification token (APNs device token or FCM registration token) used to route this notification to the target device. Classified as confidential PII as it can be used to identify and track a specific device and its associated fan.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:richMediaIncluded rdf:type rdf:Property ;
    rdfs:label 'Rich Media Included' ;
    rdfs:comment 'Indicates whether this push notification includes rich media content (image, video thumbnail, or animated GIF) beyond plain text. Rich media notifications typically achieve higher open rates and are tracked separately for creative performance benchmarking.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sendTimeOptimized rdf:type rdf:Property ;
    rdfs:label 'Send Time Optimized' ;
    rdfs:comment 'Indicates whether the send time for this notification was determined by the platform\'s send-time optimization algorithm (Adobe Journey Optimizer or equivalent) rather than a fixed scheduled time. True when AI-optimized delivery was applied.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sent Timestamp' ;
    rdfs:comment 'The actual date and time at which the push notification was dispatched from the platform to the push gateway (APNs or FCM). Distinct from scheduled_send_timestamp; the delta measures dispatch latency.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:soundEnabled rdf:type rdf:Property ;
    rdfs:label 'Sound Enabled' ;
    rdfs:comment 'Indicates whether an audible alert sound was included with this push notification delivery. Sound-enabled notifications are used for high-priority alerts such as live score updates and breaking news.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ttlSeconds rdf:type rdf:Property ;
    rdfs:label 'Ttl Seconds' ;
    rdfs:comment 'The time-to-live duration in seconds for this push notification. If the device is offline and the notification cannot be delivered within this window, the push gateway discards it. Critical for time-sensitive notifications such as live score updates.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:utmContent rdf:type rdf:Property ;
    rdfs:label 'Utm Content' ;
    rdfs:comment 'The UTM content parameter identifying the specific creative variant or A/B test arm for attribution purposes. Complements utm_campaign to enable granular creative performance analysis.' ;
    rdfs:domain ind:PushNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchQueryId rdf:type rdf:Property ;
    rdfs:label 'Search Query Id' ;
    rdfs:comment 'Unique surrogate identifier for each fan search query record captured across platform digital touchpoints.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aepEventReference rdf:type rdf:Property ;
    rdfs:label 'Aep Event Reference' ;
    rdfs:comment 'The Adobe Experience Platform (AEP) Experience Event identifier corresponding to this search query, enabling bi-directional reconciliation between the lakehouse Silver layer and AEP for personalisation and analytics.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autocompleteTriggered rdf:type rdf:Property ;
    rdfs:label 'Autocomplete Triggered' ;
    rdfs:comment 'Indicates whether the search query was submitted via an autocomplete suggestion rather than a fully typed term. Autocomplete adoption rate is a key search UX metric.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clickedResultPosition rdf:type rdf:Property ;
    rdfs:label 'Clicked Result Position' ;
    rdfs:comment 'The rank position (1-based) of the search result item that the fan clicked or tapped. Null if no result was selected. Used to measure search relevance and click-through quality.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clickedResultReference rdf:type rdf:Property ;
    rdfs:label 'Clicked Result Reference' ;
    rdfs:comment 'The business entity identifier of the search result item that was clicked (e.g., event ID, athlete ID, content asset ID, merchandise SKU). Stored as STRING to accommodate cross-domain entity types.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clickedResultType rdf:type rdf:Property ;
    rdfs:label 'Clicked Result Type' ;
    rdfs:comment 'The entity type of the search result that was clicked, enabling cross-domain click analysis (e.g., event, athlete, content_asset, ticket, merchandise, venue, team). [ENUM-REF-CANDIDATE: event|athlete|content_asset|ticket|merchandise|venue|team — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filterApplied rdf:type rdf:Property ;
    rdfs:label 'Filter Applied' ;
    rdfs:comment 'Indicates whether the fan applied one or more faceted filters (e.g., sport type, date range, price range) in conjunction with this search query.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:filterCriteria rdf:type rdf:Property ;
    rdfs:label 'Filter Criteria' ;
    rdfs:comment 'Serialised representation of the filter parameters applied alongside the search query (e.g., sport=NFL, date_from=2025-01-01, price_max=150). Stored as a delimited string for Silver layer compatibility.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isResultClicked rdf:type rdf:Property ;
    rdfs:label 'Is Result Clicked' ;
    rdfs:comment 'Indicates whether the fan clicked on any search result following this query. False indicates a no-click search, which may signal poor relevance or fan abandonment.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isZeroResult rdf:type rdf:Property ;
    rdfs:label 'Is Zero Result' ;
    rdfs:comment 'Indicates whether the search query returned zero results. True when result_count = 0. Critical KPI for search quality monitoring, content gap identification, and fan experience improvement programmes.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:normalisedQueryText rdf:type rdf:Property ;
    rdfs:label 'Normalised Query Text' ;
    rdfs:comment 'Lowercased, trimmed, and stop-word-reduced version of the raw query text used for search analytics, trending term identification, and personalisation engine (AEP) input.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:platformChannel rdf:type rdf:Property ;
    rdfs:label 'Platform Channel' ;
    rdfs:comment 'The digital channel through which the search was submitted: mobile_app, web_portal, smart_tv, in_venue_kiosk, OTT app, or voice_assistant. Supports omnichannel search analytics.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Query Language Code' ;
    rdfs:comment 'BCP-47 language tag detected or declared for the search query (e.g., en-US, es-MX, fr-FR), supporting multilingual search analytics across global markets.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Query Reference Code' ;
    rdfs:comment 'Business-facing externally referenceable code for this search query record, used in analytics reporting and Adobe Experience Platform (AEP) event correlation.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryStatus rdf:type rdf:Property ;
    rdfs:label 'Query Status' ;
    rdfs:comment 'Lifecycle status of the search query execution: completed (results returned), zero_result (no matches found), error (system failure), cancelled (fan abandoned before results), timeout (exceeded SLA threshold).' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Query Timestamp' ;
    rdfs:comment 'The precise date and time (ISO 8601 with timezone offset) at which the fan submitted the search query. Principal business event timestamp for this record.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:queryType rdf:type rdf:Property ;
    rdfs:label 'Query Type' ;
    rdfs:comment 'Mechanism by which the search was initiated: keyword (typed text), voice (speech-to-text), barcode_scan (merchandise/ticket scan), filter_browse (faceted navigation), autocomplete_selection (suggestion tapped).' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rawQueryText rdf:type rdf:Property ;
    rdfs:label 'Raw Query Text' ;
    rdfs:comment 'The verbatim search string entered by the fan, preserved exactly as submitted before any normalisation or stemming. May contain PII if a fan types a personal name; classified confidential for data governance. Subject to GDPR data minimisation review.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseTimeMs rdf:type rdf:Property ;
    rdfs:label 'Response Time Ms' ;
    rdfs:comment 'End-to-end search response latency in milliseconds from query submission to results rendered on the fan\'s device. Used for SLA compliance monitoring against platform response time thresholds.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resultCount rdf:type rdf:Property ;
    rdfs:label 'Result Count' ;
    rdfs:comment 'Total number of results returned by the search engine for this query. A value of 0 indicates a zero-result query, which is a key signal for search quality and content gap analysis.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:searchAlgorithmVersion rdf:type rdf:Property ;
    rdfs:label 'Search Algorithm Version' ;
    rdfs:comment 'Version identifier of the search ranking algorithm or index configuration active at the time of the query. Enables retrospective analysis of algorithm changes on search quality metrics.' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchContext rdf:type rdf:Property ;
    rdfs:label 'Search Context' ;
    rdfs:comment 'Business context in which the search was performed: pre_event (fan planning before attending), in_venue (fan inside venue during event), content_browse (browsing broadcast/OTT content), post_event (reviewing after event), general (no specific event context).' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchDomain rdf:type rdf:Property ;
    rdfs:label 'Search Domain' ;
    rdfs:comment 'The primary business domain scope of the search query: events, athletes, content (broadcast/OTT), tickets, merchandise, venues, teams, or general cross-domain. Drives search index routing and analytics segmentation. [ENUM-REF-CANDIDATE: events|athletes|content|tickets|merchandise|venues|teams|general|sponsors|news — promote to reference product]' ;
    rdfs:domain ind:SearchQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: SLA incident management in sports entertainment requires assigning a named employee (platform ops engineer, incident manager) as owner for contractually-enforced broadcast and streaming SLA breaches. ' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentIncidentSlaIncidentId rdf:type rdf:Property ;
    rdfs:label 'Parent Incident Sla Incident Id' ;
    rdfs:comment 'Reference to a prior SLA incident record if this incident is a recurrence or child of a broader platform outage event. Enables incident lineage and chronic failure tracking.' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SlaIncident .

ind:primarySlaVendorId rdf:type rdf:Property ;
    rdfs:label 'Primary Sla Vendor Id' ;
    rdfs:comment 'Reference to the external vendor or technology partner responsible for the affected platform component (e.g., CDN provider, OTT streaming vendor, API gateway provider). Used for vendor penalty calculations and SLA compliance reporting.' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:affectedRegion rdf:type rdf:Property ;
    rdfs:label 'Affected Region' ;
    rdfs:comment 'Geographic region or market where the SLA incident was experienced by fans or partners. Uses ISO 3166-1 alpha-3 country codes or regional identifiers (e.g., USA, GBR, DEU) for global market impact analysis.' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arpuImpactEstimate rdf:type rdf:Property ;
    rdfs:label 'Arpu Impact Estimate' ;
    rdfs:comment 'Estimated revenue impact per affected fan account attributable to the SLA breach, expressed in the contract currency. Derived from ARPU (Average Revenue Per User) baselines and used for digital performance impact reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:breachDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Breach Duration Seconds' ;
    rdfs:comment 'Total elapsed time in seconds from incident detection to resolution. Used to determine whether contractual SLA thresholds were exceeded and to calculate vendor penalty amounts.' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:changeRequestId rdf:type rdf:Property ;
    rdfs:label 'Change Request Id' ;
    rdfs:comment 'Reference to the associated change management request raised as a result of this SLA incident to implement a permanent fix or infrastructure improvement.' ;
    rdfs:domain ind:Platform ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fanAccountImpactCount rdf:type rdf:Property ;
    rdfs:label 'Fan Account Impact Count' ;
    rdfs:comment 'Number of distinct fan accounts that experienced degraded or unavailable service during the SLA breach window. Key metric for assessing fan experience impact and calculating penalty thresholds.' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isBreach rdf:type rdf:Property ;
    rdfs:label 'Is Breach' ;
    rdfs:comment 'Indicates whether the incident constitutes a formal SLA breach (True) or is classified as a near-miss event that did not exceed the contractual threshold (False).' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:monitoringSystemSource rdf:type rdf:Property ;
    rdfs:label 'Monitoring System Source' ;
    rdfs:comment 'Name of the monitoring or observability platform that generated the initial alert for this SLA incident (e.g., Adobe Experience Platform, Salesforce CRM health monitor, custom API gateway monitor).' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npsImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Nps Impact Flag' ;
    rdfs:comment 'Indicates whether the SLA incident is expected to negatively affect the NPS (Net Promoter Score) for the affected platform touchpoint, based on fan account impact count and breach duration thresholds.' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyApplicable rdf:type rdf:Property ;
    rdfs:label 'Penalty Applicable' ;
    rdfs:comment 'Indicates whether a financial penalty clause is triggered against a vendor or partner as a result of this SLA breach, based on contractual terms.' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyCurrency rdf:type rdf:Property ;
    rdfs:label 'Penalty Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the vendor penalty amount (e.g., USD, GBP, EUR). Supports multi-currency global operations.' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postIncidentReviewDate rdf:type rdf:Property ;
    rdfs:label 'Post Incident Review Date' ;
    rdfs:comment 'Scheduled or actual date on which the post-incident review meeting or report was completed. Used to track SLA governance compliance and review cycle adherence.' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:postIncidentReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Post Incident Review Status' ;
    rdfs:comment 'Current status of the post-incident review process for this SLA breach. Tracks whether a formal review has been initiated, completed, or waived based on severity level.' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaCompliancePeriod rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Period' ;
    rdfs:comment 'The reporting period (monthly or quarterly) to which this SLA incident is attributed for SLA compliance reporting and vendor scorecard calculations. Format: YYYY-MM (monthly) or YYYY-Q1/Q2/Q3/Q4 (quarterly).' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workaroundApplied rdf:type rdf:Property ;
    rdfs:label 'Workaround Applied' ;
    rdfs:comment 'Indicates whether a temporary workaround was implemented to restore partial service before the full resolution was achieved.' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workaroundDescription rdf:type rdf:Property ;
    rdfs:label 'Workaround Description' ;
    rdfs:comment 'Narrative description of the temporary workaround applied to restore partial service during the incident. Null if no workaround was used.' ;
    rdfs:domain ind:SlaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Policy Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: SLA policies governing broadcast streaming and fan platform uptime have a named policy owner employee (VP Engineering, Platform Director) accountable for compliance reviews, breach reporting, and regu' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:apiAvailabilityTargetPct rdf:type rdf:Property ;
    rdfs:label 'Api Availability Target Pct' ;
    rdfs:comment 'Contractually committed availability target specifically for API (Application Programming Interface) endpoints, expressed as a percentage. May differ from the overall platform uptime target for policies governing partner API consumers. Supports API SLA monitoring and partner reporting.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:breachPenaltyCurrency rdf:type rdf:Property ;
    rdfs:label 'Breach Penalty Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the breach penalty value (e.g., USD, EUR, GBP). Required for multi-market operations across global sports entertainment markets.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachPenaltyPctOfContract rdf:type rdf:Property ;
    rdfs:label 'Breach Penalty Pct Of Contract' ;
    rdfs:comment 'Breach penalty expressed as a percentage of the total contract value, used when the penalty is proportional rather than a fixed amount. Applicable for large broadcast and OTT distribution agreements where penalties scale with contract size.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:breachPenaltyType rdf:type rdf:Property ;
    rdfs:label 'Breach Penalty Type' ;
    rdfs:comment 'Type of penalty applied when the SLA is breached. \'service_credit\' means a credit is issued against future invoices; \'financial_penalty\' means a direct monetary payment is owed; \'contract_termination\' means the partner may terminate the agreement; \'none\' means no contractual penalty applies (internal SLAs).' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachPenaltyValue rdf:type rdf:Property ;
    rdfs:label 'Breach Penalty Value' ;
    rdfs:comment 'Monetary value of the penalty applied upon SLA breach, expressed in the currency defined by breach_penalty_currency. For service credits, this is the credit amount. For financial penalties, this is the payment amount. Confidential as it reflects contractual financial terms.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cdnFailoverTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Cdn Failover Time Seconds' ;
    rdfs:comment 'Maximum time in seconds within which the Content Delivery Network (CDN) must complete automatic failover to a backup edge node upon primary node failure. Critical for OTT broadcast continuity and live event streaming SLAs.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationTier1Minutes rdf:type rdf:Property ;
    rdfs:label 'Escalation Tier 1 Minutes' ;
    rdfs:comment 'Time in minutes after incident detection at which the incident is escalated to Tier 1 support (e.g., on-call engineering team). Part of the multi-tier escalation chain defined in the SLA policy.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationTier2Minutes rdf:type rdf:Property ;
    rdfs:label 'Escalation Tier 2 Minutes' ;
    rdfs:comment 'Time in minutes after incident detection at which the incident is escalated to Tier 2 support (e.g., senior engineering or vendor escalation). Triggers executive notification for broadcast-critical or VIP-tier SLAs.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exclusionNotes rdf:type rdf:Property ;
    rdfs:label 'Exclusion Notes' ;
    rdfs:comment 'Free-text description of events or conditions explicitly excluded from SLA uptime calculations (e.g., force majeure, scheduled maintenance, third-party CDN outages beyond contractual control). Used in breach dispute resolution.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalPolicyReference rdf:type rdf:Property ;
    rdfs:label 'External Policy Reference' ;
    rdfs:comment 'Reference identifier from the external system of record (e.g., Salesforce Contract ID, SAP SD Contract Number) that corresponds to this SLA policy. Enables cross-system traceability and reconciliation.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingRegulation rdf:type rdf:Property ;
    rdfs:label 'Governing Regulation' ;
    rdfs:comment 'Primary regulatory framework or governing body standard that this SLA policy must comply with (e.g., \'FCC\', \'GDPR\', \'PCI-DSS\', \'SOX\', \'CCPA\'). Used to route breach events to the correct compliance reporting workflow.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentResolutionTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Incident Resolution Time Minutes' ;
    rdfs:comment 'Maximum time in minutes within which a detected incident must be fully resolved before a breach penalty is applied. Distinct from response time — this measures end-to-end resolution, not initial acknowledgement.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:incidentResponseTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Incident Response Time Minutes' ;
    rdfs:comment 'Maximum time in minutes within which the operations team must acknowledge and begin responding to a detected incident before an escalation is triggered. Defines the first escalation window in the incident management workflow.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isBroadcastCritical rdf:type rdf:Property ;
    rdfs:label 'Is Broadcast Critical' ;
    rdfs:comment 'Indicates whether this SLA policy governs a broadcast-critical service (e.g., live OTT streaming, RSN feed distribution) requiring the highest availability and fastest failover commitments. When True, triggers enhanced monitoring and executive escalation paths.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegulatoryReportable rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Reportable' ;
    rdfs:comment 'Indicates whether SLA compliance data for this policy must be included in regulatory reporting submissions (e.g., FCC broadcast availability reports, GDPR data processing SLA disclosures). When True, breach events are automatically flagged for compliance reporting.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maintenanceWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Maintenance Window End' ;
    rdfs:comment 'Daily end time (HH:MM in 24-hour UTC format) of the scheduled maintenance window during which downtime is excluded from SLA uptime calculations. Paired with maintenance_window_start to define the exclusion window.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceWindowStart rdf:type rdf:Property ;
    rdfs:label 'Maintenance Window Start' ;
    rdfs:comment 'Daily start time (HH:MM in 24-hour UTC format) of the scheduled maintenance window during which downtime is excluded from SLA uptime calculations. Allows planned maintenance to be carved out from breach detection.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceWindowTimezone rdf:type rdf:Property ;
    rdfs:label 'Maintenance Window Timezone' ;
    rdfs:comment 'IANA timezone identifier for the maintenance window times (e.g., \'America/New_York\', \'Europe/London\', \'UTC\'). Required for global operations spanning multiple time zones across sports entertainment markets.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxBreachCreditsPct rdf:type rdf:Property ;
    rdfs:label 'Max Breach Credits Pct' ;
    rdfs:comment 'Maximum cumulative service credits that can be issued in a measurement period, expressed as a percentage of the period\'s contract value. Caps the total financial exposure from repeated SLA breaches within a single period.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxDowntimeMinutesMonthly rdf:type rdf:Property ;
    rdfs:label 'Max Downtime Minutes Monthly' ;
    rdfs:comment 'Maximum cumulative downtime in minutes permitted within a calendar month before the SLA is considered breached. Derived from the uptime target but stored explicitly for operational monitoring convenience. For 99.9% uptime, this is approximately 43.8 minutes per month.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measurementWindow rdf:type rdf:Property ;
    rdfs:label 'Measurement Window' ;
    rdfs:comment 'The time window over which SLA compliance is measured and reported. \'monthly\' is the most common for contractual SLAs; \'daily\' or \'hourly\' may apply to broadcast-critical or live event policies. Determines the aggregation period for uptime and response time calculations.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationChannel rdf:type rdf:Property ;
    rdfs:label 'Notification Channel' ;
    rdfs:comment 'Primary channel through which SLA breach alerts and escalation notifications are delivered to operations and partner stakeholders. Supports integration with monitoring tools such as PagerDuty, Slack, and webhook-based alerting systems.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseTimeThresholdMs rdf:type rdf:Property ;
    rdfs:label 'Response Time Threshold Ms' ;
    rdfs:comment 'Maximum acceptable API or page response time in milliseconds before a performance breach is triggered. Typical values: 200ms for API endpoints, 3000ms for web portals, 500ms for mobile app API calls. Used in real-time SLA monitoring and alerting pipelines.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceTier rdf:type rdf:Property ;
    rdfs:label 'Service Tier' ;
    rdfs:comment 'Fan account or partner service tier to which this SLA policy applies. \'standard\' covers general admission (GA) digital users; \'premium\' covers paid subscription fans; \'enterprise\' covers B2B API partners; \'vip\' covers Very Important Person (VIP) fan accounts; \'broadcast_critical\' covers OTT/RSN broadcast distribution partners requiring highest availability guarantees.' ;
    rdfs:domain ind:SlaPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessEventId rdf:type rdf:Property ;
    rdfs:label 'Access Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each physical access control scan event record in the Silver layer lakehouse. Primary key for this table.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:officerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Officer Employee Id' ;
    rdfs:comment 'Reference to the security officer or staff member who performed a manual override or was stationed at the checkpoint. Null when no officer interaction occurred.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accessDirection rdf:type rdf:Property ;
    rdfs:label 'Access Direction' ;
    rdfs:comment 'Direction of movement at the checkpoint: \'entry\' = entering the zone or venue, \'exit\' = leaving the zone or venue, \'internal\' = movement between internal zones. Used for real-time occupancy tracking and crowd flow analysis.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adaAccommodationFlag rdf:type rdf:Property ;
    rdfs:label 'Ada Accommodation Flag' ;
    rdfs:comment 'Indicates whether the credential holder required an ADA (Americans with Disabilities Act) accommodation at this access point (e.g., accessible gate routing). True = ADA accommodation applied; False = standard access.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:antiPassbackZone rdf:type rdf:Property ;
    rdfs:label 'Anti Passback Zone' ;
    rdfs:comment 'Identifier of the anti-passback zone group assigned to this checkpoint. Anti-passback rules prevent a credential from being used to enter a zone it has not exited. Used for tailgating detection and occupancy integrity.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biometricVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Biometric Verified Flag' ;
    rdfs:comment 'Indicates whether biometric verification (e.g., facial recognition, fingerprint) was used as part of the credential authentication for this scan event. True = biometric match confirmed; False = biometric not used or not matched.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:checkpointName rdf:type rdf:Property ;
    rdfs:label 'Checkpoint Name' ;
    rdfs:comment 'Human-readable name or label of the physical access checkpoint (e.g., \'Gate A – North Entrance\', \'Field Level Door 3\', \'Media Tunnel\'). Supports operational reporting and post-event forensic review without requiring a zone lookup.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialHolderCategory rdf:type rdf:Property ;
    rdfs:label 'Credential Holder Category' ;
    rdfs:comment 'Broad category of the person holding the credential. Distinct from credential_type (which describes the credential itself); this describes the person\'s role. Used for access pattern analytics and compliance reporting. [ENUM-REF-CANDIDATE: athlete|staff|media|vip|vendor|law_enforcement|official — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialToken rdf:type rdf:Property ;
    rdfs:label 'Credential Token' ;
    rdfs:comment 'Tokenized or masked representation of the physical credential identifier (e.g., RFID card number, barcode, NFC token) as presented to the reader. Stored in tokenized form to comply with PCI-DSS and GDPR. Not the raw credential number.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialReasonCode rdf:type rdf:Property ;
    rdfs:label 'Denial Reason Code' ;
    rdfs:comment 'Standardized code indicating why access was denied or flagged. Null when scan_result is \'granted\' or \'override_granted\'. [ENUM-REF-CANDIDATE: INVALID_CREDENTIAL|EXPIRED_CREDENTIAL|ZONE_NOT_AUTHORIZED|BLACKLISTED|DUPLICATE_SCAN|CAPACITY_EXCEEDED|SYSTEM_ERROR — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateScanFlag rdf:type rdf:Property ;
    rdfs:label 'Duplicate Scan Flag' ;
    rdfs:comment 'Indicates whether this scan event was detected as a duplicate presentation of the same credential within a short time window (anti-passback detection). True = duplicate detected; False = unique scan.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyEvacuationFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Evacuation Flag' ;
    rdfs:comment 'Indicates whether this scan event occurred during an active emergency evacuation protocol. True = evacuation mode active at time of scan; False = normal operations. Critical for post-incident headcount reconciliation.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventPhase rdf:type rdf:Property ;
    rdfs:label 'Event Phase' ;
    rdfs:comment 'Operational phase of the event at the time of the scan. Used to segment access patterns by event lifecycle stage for crowd management analytics and post-event review.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementNotifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Notified Flag' ;
    rdfs:comment 'Indicates whether law enforcement was notified as a result of this access event (e.g., blacklisted credential, flagged individual). True = law enforcement notification triggered; False = no notification.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkZone rdf:type rdf:Property ;
    rdfs:label 'Network Zone' ;
    rdfs:comment 'Network segment or VLAN identifier of the reader device that processed this scan. Used for cybersecurity segmentation audits and forensic network analysis in the event of a security breach.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupancyCountAtScan rdf:type rdf:Property ;
    rdfs:label 'Occupancy Count At Scan' ;
    rdfs:comment 'Snapshot of the current occupancy count for the zone at the moment this scan event was processed. Captured at scan time to support real-time occupancy tracking and capacity compliance reporting.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:officerOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Officer Override Flag' ;
    rdfs:comment 'Indicates whether a security officer manually overrode the system\'s access decision for this event. True = officer override applied; False = system decision was final. Critical for post-event forensic review and accountability audits.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideJustification rdf:type rdf:Property ;
    rdfs:label 'Override Justification' ;
    rdfs:comment 'Free-text or coded reason provided by the officer when performing a manual override. Required when officer_override_flag is True. Supports accountability and compliance audit trails.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readerDeviceCode rdf:type rdf:Property ;
    rdfs:label 'Reader Device Code' ;
    rdfs:comment 'Reference to the physical access control reader or scanner device that captured this scan event. Used for device-level diagnostics, tamper detection, and post-event forensic review.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:readerFirmwareVersion rdf:type rdf:Property ;
    rdfs:label 'Reader Firmware Version' ;
    rdfs:comment 'Firmware version of the access control reader device at the time of the scan. Captured for forensic integrity, device audit trails, and vulnerability management compliance.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readerLocationCode rdf:type rdf:Property ;
    rdfs:label 'Reader Location Code' ;
    rdfs:comment 'Alphanumeric code identifying the physical location of the reader device within the venue (e.g., \'NE-G1-R04\'). Supports device-level forensic analysis and maintenance tracking.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scanDurationMs rdf:type rdf:Property ;
    rdfs:label 'Scan Duration Ms' ;
    rdfs:comment 'Time in milliseconds taken for the reader to process the credential and return a result. Used for throughput analysis, reader performance monitoring, and identifying bottlenecks at high-traffic checkpoints.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scanResult rdf:type rdf:Property ;
    rdfs:label 'Scan Result' ;
    rdfs:comment 'Outcome of the credential scan at the access point. \'granted\' = access permitted; \'denied\' = access refused; \'flagged\' = access held for secondary review; \'override_granted\' = officer manually permitted entry; \'timeout\' = reader did not receive a valid response. Core field for real-time occupancy tracking and compliance audit trails.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scanTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scan Timestamp' ;
    rdfs:comment 'Precise date and time (with timezone offset) when the credential was presented to the reader. The principal real-world event time for this access event. Formatted as yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:secondaryScreeningFlag rdf:type rdf:Property ;
    rdfs:label 'Secondary Screening Flag' ;
    rdfs:comment 'Indicates whether the credential holder was referred for secondary security screening (e.g., bag check, wand scan) at this access event. True = secondary screening triggered; False = standard throughput.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceEventReference rdf:type rdf:Property ;
    rdfs:label 'Source Event Reference' ;
    rdfs:comment 'The original event transaction ID or record key from the source access control system (e.g., Ticketmaster/AXS transaction ID). Enables traceability back to the operational system of record for audit and reconciliation.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watchlistMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Watchlist Match Flag' ;
    rdfs:comment 'Indicates whether the credential or credential holder matched an entry on a security watchlist at the time of the scan. True = watchlist match detected; False = no match. Triggers escalation workflows.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zoneCapacity rdf:type rdf:Property ;
    rdfs:label 'Zone Capacity' ;
    rdfs:comment 'Maximum permitted occupancy for the zone at the time of the scan event, as configured in the access control system. Used alongside occupancy_count_at_scan to determine capacity compliance status.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:zoneLevel rdf:type rdf:Property ;
    rdfs:label 'Zone Level' ;
    rdfs:comment 'Security classification level of the zone being accessed at the time of the scan. Captures the sensitivity of the zone for risk-tiered reporting and compliance. Values: public, restricted, highly_restricted, field_level, backstage.' ;
    rdfs:domain ind:AccessEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessCloseTime rdf:type rdf:Property ;
    rdfs:label 'Access Close Time' ;
    rdfs:comment 'Standard time of day (HH:MM, 24-hour format) at which access to this zone closes relative to event day operations (e.g., \'23:59\' for post-event lockdown). Used for access control system scheduling and security staffing deployment.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:accessControlSystem rdf:type rdf:Property ;
    rdfs:label 'Access Control System' ;
    rdfs:comment 'Name or type of the electronic access control system managing entry/exit to this zone (e.g., Ticketmaster/AXS turnstile, Lenel, C-Cure, Genetec, Honeywell, manual staffed checkpoint, or none). Determines integration points for real-time access event logging. [ENUM-REF-CANDIDATE: ticketmaster_axs|lenel|ccure|genetec|honeywell|manual|none — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessOpenTime rdf:type rdf:Property ;
    rdfs:label 'Access Open Time' ;
    rdfs:comment 'Standard time of day (HH:MM, 24-hour format) at which access to this zone opens relative to event day operations (e.g., \'06:00\' for early crew access). Used for access control system scheduling and security staffing deployment.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:adaAccessibleFlag rdf:type rdf:Property ;
    rdfs:label 'Ada Accessible Flag' ;
    rdfs:comment 'Indicates whether the access zone meets ADA accessibility requirements including wheelchair access, accessible entry/exit points, and compliant pathways (True = ADA compliant, False = not compliant or not assessed). Required for ADA regulatory reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adjacentZoneCodes rdf:type rdf:Property ;
    rdfs:label 'Adjacent Zone Codes' ;
    rdfs:comment 'Comma-separated list of zone_codes for physically adjacent access zones sharing a boundary or transition point with this zone. Used for crowd flow modeling, spillover risk assessment, and emergency egress path analysis. Note: a dedicated zone_adjacency junction product should be used for full relational modeling.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alcoholPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Alcohol Permitted Flag' ;
    rdfs:comment 'Indicates whether alcohol consumption and/or service is permitted within this zone (True = permitted, False = not permitted). Used for concession operations planning, liquor licensing compliance, and fan experience management.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastZoneFlag rdf:type rdf:Property ;
    rdfs:label 'Broadcast Zone Flag' ;
    rdfs:comment 'Indicates whether this zone is designated as a broadcast or media production area (True = broadcast zone, False = non-broadcast). Triggers media credential requirements and coordination with broadcast operations teams and OB (Outside Broadcast) units.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cameraCount rdf:type rdf:Property ;
    rdfs:label 'Camera Count' ;
    rdfs:comment 'Number of surveillance cameras installed and actively monitoring the access zone. Used for security audit compliance, coverage gap analysis, and incident response planning.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:credentialTypeRequired rdf:type rdf:Property ;
    rdfs:label 'Credential Type Required' ;
    rdfs:comment 'Type of credential required for access to this zone (e.g., event_ticket, staff_badge, media_credential, vip_wristband, law_enforcement_id, biometric, all_access_pass). Drives credentialing issuance rules in Ticketmaster/AXS and physical security systems. [ENUM-REF-CANDIDATE: event_ticket|staff_badge|media_credential|vip_wristband|law_enforcement_id|biometric|all_access_pass|none — promote to reference product]' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyAssemblyPointFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Assembly Point Flag' ;
    rdfs:comment 'Indicates whether this zone serves as a designated emergency assembly or muster point during evacuation scenarios (True = designated assembly point, False = not designated). Used in emergency response plans and evacuation drills.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:entryPointCount rdf:type rdf:Property ;
    rdfs:label 'Entry Point Count' ;
    rdfs:comment 'Number of physical entry points (gates, turnstiles, doors, checkpoints) providing access into this zone. Used for crowd flow throughput modeling, staffing calculations, and emergency egress planning.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evacuationRouteCode rdf:type rdf:Property ;
    rdfs:label 'Evacuation Route Code' ;
    rdfs:comment 'Code identifying the primary designated evacuation route assigned to this zone in the venue emergency response plan. Used by security command center and first responders during emergency scenarios.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exitPointCount rdf:type rdf:Property ;
    rdfs:label 'Exit Point Count' ;
    rdfs:comment 'Number of physical exit points from this zone. Used for emergency evacuation planning, egress compliance with fire safety codes, and crowd flow modeling.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:floorAreaSqm rdf:type rdf:Property ;
    rdfs:label 'Floor Area Sqm' ;
    rdfs:comment 'Physical floor area of the access zone measured in square metres. Used to calculate occupancy density ratios, crowd flow modeling, and compliance with safety regulations requiring minimum space per person.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hvacZoneReference rdf:type rdf:Property ;
    rdfs:label 'Hvac Zone Reference' ;
    rdfs:comment 'Reference code linking this access zone to the corresponding HVAC zone in the Building Management System (BMS). Used for environmental control coordination during events and emergency ventilation management.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastSafetyInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Safety Inspection Date' ;
    rdfs:comment 'Date of the most recent physical safety inspection conducted for this access zone by internal safety officers or external regulatory inspectors. Used for OSHA compliance tracking and venue certification renewals.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lawEnforcementRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Required Flag' ;
    rdfs:comment 'Indicates whether sworn law enforcement officers are required to be stationed at or within this zone during events (True = required, False = not required). Used for event security planning, law enforcement coordination, and regulatory compliance.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:levelNumber rdf:type rdf:Property ;
    rdfs:label 'Level Number' ;
    rdfs:comment 'Numeric floor or level within the venue where the zone is located (e.g., 0 = ground/field level, 1 = concourse level, 2 = upper deck, -1 = sub-ground). Used for wayfinding, evacuation routing, and zone adjacency mapping.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mapCoordinates rdf:type rdf:Property ;
    rdfs:label 'Map Coordinates' ;
    rdfs:comment 'Geographic or venue-relative coordinate string (e.g., GeoJSON polygon or venue grid reference) defining the physical boundary of the zone on the venue floor plan. Used for digital venue mapping, crowd flow modeling, and real-time occupancy visualization.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxOccupancy rdf:type rdf:Property ;
    rdfs:label 'Max Occupancy' ;
    rdfs:comment 'Maximum number of persons permitted within the zone simultaneously as defined by fire safety codes, venue engineering assessments, and regulatory approvals. Used for crowd flow modeling, real-time occupancy monitoring, and ADA compliance reporting.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minSecurityStaffCount rdf:type rdf:Property ;
    rdfs:label 'Min Security Staff Count' ;
    rdfs:comment 'Minimum number of security personnel required to be deployed in this zone during an active event. Used for event staffing plans, security contractor scheduling, and compliance with venue safety regulations.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nextSafetyInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Next Safety Inspection Date' ;
    rdfs:comment 'Scheduled date for the next mandatory safety inspection of this access zone. Used for compliance calendar management and proactive safety governance.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reEntryPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Re Entry Permitted Flag' ;
    rdfs:comment 'Indicates whether credential holders who have exited this zone are permitted to re-enter during the same event (True = re-entry allowed, False = no re-entry). Drives access control system configuration in Ticketmaster/AXS.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:screeningProtocol rdf:type rdf:Property ;
    rdfs:label 'Screening Protocol' ;
    rdfs:comment 'Security screening method applied at entry points to this zone: none, visual_check, metal_detector, magnetometer, pat_down, full_search, or biometric_scan. Determines staffing requirements and equipment deployment for event security operations. [ENUM-REF-CANDIDATE: none|visual_check|metal_detector|magnetometer|pat_down|full_search|biometric_scan — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectionReference rdf:type rdf:Property ;
    rdfs:label 'Section Reference' ;
    rdfs:comment 'Venue section or block designation within which the access zone falls (e.g., \'North Stand\', \'Section 112\', \'East Wing\'). Aligns with Archtics seating inventory and venue map coordinates for operational cross-referencing.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:smokingPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Smoking Permitted Flag' ;
    rdfs:comment 'Indicates whether smoking is permitted within this zone (True = permitted, False = not permitted). Used for venue policy enforcement, health and safety compliance, and fan experience communications.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surveillanceCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Surveillance Coverage Flag' ;
    rdfs:comment 'Indicates whether the access zone is covered by CCTV or other surveillance systems (True = covered, False = not covered). Critical for security planning, incident investigation, and compliance with venue safety regulations.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timeRestrictedFlag rdf:type rdf:Property ;
    rdfs:label 'Time Restricted Flag' ;
    rdfs:comment 'Indicates whether access to this zone is restricted to specific time windows during an event (True = time-restricted, False = open throughout event). When True, access_open_time and access_close_time define the permitted window.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zoneCode rdf:type rdf:Property ;
    rdfs:label 'Zone Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying the access zone within a venue (e.g., FIELD-01, PRESS-BOX-A, VIP-SUITE-N). Used on credentials, wristbands, and access control hardware programming.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneColorCode rdf:type rdf:Property ;
    rdfs:label 'Zone Color Code' ;
    rdfs:comment 'Hexadecimal color code used to visually represent this zone on venue maps, security dashboards, and credentialing systems (e.g., #FF0000 for red restricted zones, #00FF00 for public green zones). Standardizes visual communication across security operations.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneDescription rdf:type rdf:Property ;
    rdfs:label 'Zone Description' ;
    rdfs:comment 'Free-text narrative description of the access zone including its physical characteristics, operational purpose, notable features, and any special access conditions not captured in structured fields. Used for security briefings and operational documentation.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneName rdf:type rdf:Property ;
    rdfs:label 'Zone Name' ;
    rdfs:comment 'Human-readable descriptive name of the access zone (e.g., \'Field Level / Pitch Side\', \'Home Team Locker Room\', \'Broadcast Compound\', \'VIP Hospitality Suite North\'). Used in operational reports and credentialing systems.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneStatus rdf:type rdf:Property ;
    rdfs:label 'Zone Status' ;
    rdfs:comment 'Current operational lifecycle status of the access zone: active (in normal use), inactive (temporarily disabled), under_maintenance (physical works in progress), decommissioned (permanently retired), temporary (event-specific pop-up zone). Drives whether the zone is enforced in access control systems.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneTier rdf:type rdf:Property ;
    rdfs:label 'Zone Tier' ;
    rdfs:comment 'Security classification tier of the zone defining the baseline access control level: public (general admission concourse), restricted (credentialed staff/media), secured (law enforcement / command), sterile (field/pitch/locker room — highest protection). Drives credentialing rules and screening protocols.' ;
    rdfs:domain ind:AccessZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneType rdf:type rdf:Property ;
    rdfs:label 'Zone Type' ;
    rdfs:comment 'Functional category of the zone describing its operational purpose: field_pitch, locker_room, press_box, broadcast_compound, vip_hospitality, back_of_house, command_center, parking_compound, public_concourse, medical, production_truck_bay, merchandise_storage. [ENUM-REF-CANDIDATE: field_pitch|locker_room|press_box|broadcast_compound|vip_hospitality|back_of_house|command_center|parking_compound|public_concourse|medical|production_truck_bay|merchandise_storage — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvingDirectorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approving Director Employee Id' ;
    rdfs:comment 'Reference to the venue security director who reviewed and signed off on this after-action report.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryAfterEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary After Employee Id' ;
    rdfs:comment 'Reference to the security officer or analyst who authored and submitted this after-action report.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:arrestsMade rdf:type rdf:Property ;
    rdfs:label 'Arrests Made' ;
    rdfs:comment 'Number of individuals arrested by law enforcement during or immediately following the event at the venue.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:avgScreeningWaitMinutes rdf:type rdf:Property ;
    rdfs:label 'Avg Screening Wait Minutes' ;
    rdfs:comment 'Average patron wait time in minutes at security screening checkpoints during peak ingress, used to assess fan experience impact and staffing adequacy.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crowdManagementNotes rdf:type rdf:Property ;
    rdfs:label 'Crowd Management Notes' ;
    rdfs:comment 'Narrative description of crowd management observations, including notable congestion points, flow issues, zone capacity breaches, or exemplary crowd control actions during the event.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crowdManagementRating rdf:type rdf:Property ;
    rdfs:label 'Crowd Management Rating' ;
    rdfs:comment 'Qualitative rating of overall crowd management performance during the event as assessed by the venue security director, used for continuous improvement tracking.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directorSignoffTimestamp rdf:type rdf:Property ;
    rdfs:label 'Director Signoff Timestamp' ;
    rdfs:comment 'Date and time at which the venue security director formally reviewed and signed off on this after-action report, completing the approval lifecycle.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ejectionCount rdf:type rdf:Property ;
    rdfs:label 'Ejection Count' ;
    rdfs:comment 'Total number of patrons formally ejected from the venue during the event for code-of-conduct violations, intoxication, or security threats.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emergencyResponseActivated rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Activated' ;
    rdfs:comment 'Indicates whether the venue emergency response plan (ERP) was formally activated during the event, requiring post-event regulatory documentation.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equipmentFailureNotes rdf:type rdf:Property ;
    rdfs:label 'Equipment Failure Notes' ;
    rdfs:comment 'Narrative description of specific equipment failures encountered during the event, including affected systems, duration of outage, and interim mitigation measures applied.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentFailures rdf:type rdf:Property ;
    rdfs:label 'Equipment Failures' ;
    rdfs:comment 'Number of security equipment failures (magnetometers, CCTV cameras, access control readers, radio systems) recorded during the event that impacted security operations.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evacuationActivated rdf:type rdf:Property ;
    rdfs:label 'Evacuation Activated' ;
    rdfs:comment 'Indicates whether a full or partial venue evacuation protocol was activated during the event. True triggers mandatory regulatory notification and escalated review.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evacuationType rdf:type rdf:Property ;
    rdfs:label 'Evacuation Type' ;
    rdfs:comment 'Classification of the evacuation protocol activated during the event. Not applicable when evacuation_activated is False.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventName rdf:type rdf:Property ;
    rdfs:label 'Event Name' ;
    rdfs:comment 'Human-readable name of the Sports Entertainment event (e.g., \'NBA Finals Game 4\', \'UFC 300\') as it appears in scheduling and broadcast systems, denormalized for reporting convenience.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementAgency rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Agency' ;
    rdfs:comment 'Name of the primary law enforcement agency (e.g., LAPD, FBI, State Police) that provided on-site support or was engaged during the event.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementAssists rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Assists' ;
    rdfs:comment 'Number of discrete instances where venue security requested or received assistance from on-site or external law enforcement agencies during the event.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lessonsLearned rdf:type rdf:Property ;
    rdfs:label 'Lessons Learned' ;
    rdfs:comment 'Structured narrative capturing key lessons learned from the event security operation, including what worked well, what failed, and actionable improvements for future events.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalIncidents rdf:type rdf:Property ;
    rdfs:label 'Medical Incidents' ;
    rdfs:comment 'Count of medical emergency incidents requiring first aid, EMS response, or hospital transport during the event. Reported separately per OSHA venue safety requirements.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patronsScreened rdf:type rdf:Property ;
    rdfs:label 'Patrons Screened' ;
    rdfs:comment 'Total number of patrons processed through security screening checkpoints during event ingress, used to calculate screening throughput rate.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peakIngressRatePerHour rdf:type rdf:Property ;
    rdfs:label 'Peak Ingress Rate Per Hour' ;
    rdfs:comment 'Maximum number of patrons processed through all screening checkpoints in any single hour during the event ingress window, used for capacity planning benchmarking.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:physicalAltercations rdf:type rdf:Property ;
    rdfs:label 'Physical Altercations' ;
    rdfs:comment 'Count of physical altercations or fights between patrons requiring security intervention during the event.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyChangeRecommendations rdf:type rdf:Property ;
    rdfs:label 'Policy Change Recommendations' ;
    rdfs:comment 'Narrative description of recommended changes to security policies, screening protocols, staffing levels, equipment, or coordination procedures identified through the post-event debrief.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyChangeRecommended rdf:type rdf:Property ;
    rdfs:label 'Policy Change Recommended' ;
    rdfs:comment 'Indicates whether the after-action review identified one or more recommended changes to security policy, procedures, or staffing models requiring management review.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prohibitedItemsConfiscated rdf:type rdf:Property ;
    rdfs:label 'Prohibited Items Confiscated' ;
    rdfs:comment 'Total number of prohibited items (weapons, contraband, restricted substances) confiscated at screening checkpoints or during the event.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportDate rdf:type rdf:Property ;
    rdfs:label 'Report Date' ;
    rdfs:comment 'Calendar date on which the after-action report was formally authored and submitted, typically within 24–72 hours of the event conclusion.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:screeningLanesDeployed rdf:type rdf:Property ;
    rdfs:label 'Screening Lanes Deployed' ;
    rdfs:comment 'Total number of patron screening lanes (magnetometers, walk-through scanners, wand stations) that were operational during the event ingress period.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:securityStaffDeployed rdf:type rdf:Property ;
    rdfs:label 'Security Staff Deployed' ;
    rdfs:comment 'Total number of security personnel (in-house and contracted) deployed across all posts and zones for the event.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:threatLevelAssessed rdf:type rdf:Property ;
    rdfs:label 'Threat Level Assessed' ;
    rdfs:comment 'Security threat level assessed by the venue security director for the event, based on pre-event intelligence, incident activity, and law enforcement advisories.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAttendance rdf:type rdf:Property ;
    rdfs:label 'Total Attendance' ;
    rdfs:comment 'Total number of patrons, staff, and credentialed personnel present at the event, used as the denominator for per-capita security metric calculations.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalIncidents rdf:type rdf:Property ;
    rdfs:label 'Total Incidents' ;
    rdfs:comment 'Aggregate count of all security incidents recorded during the event across all categories, serving as the primary headline KPI for security performance benchmarking.' ;
    rdfs:domain ind:AfterActionReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryConfiscationEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Confiscation Employee Id' ;
    rdfs:comment 'Reference to the security officer or law enforcement personnel who physically performed the confiscation. Satisfies TRANSACTION_HEADER PARTY_REFERENCE category. Links to the workforce/security officer master record.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:prohibitedItemId rdf:type rdf:Property ;
    rdfs:label 'Prohibited Item Id' ;
    rdfs:comment 'Reference to the prohibited_item reference product that classifies the type of item confiscated (e.g., weapon, alcohol, laser pointer, drone). Drives policy calibration and trend reporting by item category.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProhibitedItem .

ind:screeningCheckpointId rdf:type rdf:Property ;
    rdfs:label 'Screening Checkpoint Id' ;
    rdfs:comment 'Reference to the specific screening checkpoint (entry gate, perimeter post, or in-venue security station) where the confiscation occurred. Enables checkpoint-level throughput and confiscation rate analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ScreeningCheckpoint .

ind:screeningEventId rdf:type rdf:Property ;
    rdfs:label 'Screening Event Id' ;
    rdfs:comment 'Reference to the parent screening_event record that triggered this confiscation, enabling full traceability from the screening interaction to the confiscation outcome. Supports chain-of-custody linkage.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ScreeningEvent .

ind:shiftAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Shift Assignment Id' ;
    rdfs:comment 'Reference to the security shift schedule record during which the confiscation occurred. Enables shift-level confiscation volume analysis and officer workload reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ShiftAssignment .

ind:shiftAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Shift Shift Assignment Id' ;
    rdfs:comment 'Reference to the security shift schedule record during which the confiscation occurred. Enables shift-level confiscation volume analysis and officer workload reporting.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ShiftAssignment .

ind:supervisorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Supervisor Employee Id' ;
    rdfs:comment 'Reference to the security supervisor who oversaw or approved the confiscation action, particularly when escalation_flag is True. Supports chain-of-custody accountability and supervisory review workflows.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:arrestMadeFlag rdf:type rdf:Property ;
    rdfs:label 'Arrest Made Flag' ;
    rdfs:comment 'Indicates whether the individual from whom the item was confiscated was arrested in connection with this confiscation event. True = arrest made; False = no arrest. Critical for law enforcement coordination reporting and venue safety KPI dashboards.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chainOfCustodyNotes rdf:type rdf:Property ;
    rdfs:label 'Chain Of Custody Notes' ;
    rdfs:comment 'Free-text log of all custody transfers, handling events, and disposition actions for the confiscated item from point of seizure through final resolution. Supports legal defensibility, law enforcement handover documentation, and post-event audit reviews.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confiscationLocationDetail rdf:type rdf:Property ;
    rdfs:label 'Confiscation Location Detail' ;
    rdfs:comment 'Specific physical location description within the venue where the confiscation occurred (e.g., \'Gate C North Entry Lane 3\', \'Section 112 Row 5\', \'Concourse Level 2 near restrooms\'). Complements the access_zone_id with granular location data for incident mapping.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confiscationMethod rdf:type rdf:Property ;
    rdfs:label 'Confiscation Method' ;
    rdfs:comment 'The method or trigger by which the prohibited item was identified and confiscated. Supports analysis of detection effectiveness across different security methods and informs resource deployment strategy.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confiscationNumber rdf:type rdf:Property ;
    rdfs:label 'Confiscation Number' ;
    rdfs:comment 'Externally-known, human-readable reference number assigned to this confiscation event at the point of occurrence (e.g., CONF-2024-000123). Used on physical receipts issued to the item owner and in law enforcement handover documentation. Satisfies TRANSACTION_HEADER BUSINESS_IDENTIFIER category.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confiscationStatus rdf:type rdf:Property ;
    rdfs:label 'Confiscation Status' ;
    rdfs:comment 'Current lifecycle state of the confiscation record, tracking the disposition workflow from initial seizure through final resolution. \'open\' = newly recorded; \'held\' = item in secure storage; \'turned_over_to_law_enforcement\' = transferred to police/agency; \'destroyed\' = item disposed per policy; \'retrieved_by_owner\' = owner reclaimed item post-event; \'closed\' = record fully resolved. Satisfies TRANSACTION_HEADER LIFECYCLE_STATUS category.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confiscationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Confiscation Timestamp' ;
    rdfs:comment 'Precise date and time (ISO 8601 with timezone offset) when the prohibited item was physically confiscated from the individual. This is the principal real-world event time, distinct from record creation. Satisfies TRANSACTION_HEADER BUSINESS_EVENT_TIMESTAMP category. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:destructionDate rdf:type rdf:Property ;
    rdfs:label 'Destruction Date' ;
    rdfs:comment 'Date on which the confiscated item was destroyed per venue security policy. Populated only when disposition_type is \'destroyed\'. Supports compliance documentation for prohibited item disposal procedures. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:entryDeniedFlag rdf:type rdf:Property ;
    rdfs:label 'Entry Denied Flag' ;
    rdfs:comment 'Indicates whether the individual from whom the item was confiscated was denied entry to the venue as a result of the confiscation. True = entry denied; False = individual permitted entry after confiscation. Supports access control outcome reporting.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gateNumber rdf:type rdf:Property ;
    rdfs:label 'Gate Number' ;
    rdfs:comment 'Identifier of the entry gate or security lane at which the confiscation occurred during the screening process. Used for gate-level throughput and confiscation rate benchmarking.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemCategory rdf:type rdf:Property ;
    rdfs:label 'Item Category' ;
    rdfs:comment 'High-level classification of the confiscated item used for rapid trend reporting and policy calibration without requiring a join to the prohibited_item reference product. [ENUM-REF-CANDIDATE: weapon|alcohol|drug|pyrotechnic|laser_device|drone|oversized_bag|recording_device|food_beverage|other — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemDescription rdf:type rdf:Property ;
    rdfs:label 'Item Description' ;
    rdfs:comment 'Free-text description of the specific confiscated item as recorded by the confiscating officer (e.g., \'6-inch folding knife, black handle\', \'half-full bottle of spirits\'). Provides granular detail beyond the category classification for incident reporting and law enforcement handover.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemQuantity rdf:type rdf:Property ;
    rdfs:label 'Item Quantity' ;
    rdfs:comment 'Number of individual units of the prohibited item confiscated in this single confiscation event (e.g., 3 bottles of alcohol, 2 flares). Supports volume-based trend analysis and storage capacity planning. Satisfies TRANSACTION_HEADER QUANTITATIVE_RESULT category (non-monetary transaction).' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lawEnforcementCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Case Number' ;
    rdfs:comment 'Official case or incident number assigned by the responding law enforcement agency when the confiscated item is turned over to police custody. Populated only when law_enforcement_notified_flag is True. Enables cross-reference with external law enforcement records.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerProvidedFlag rdf:type rdf:Property ;
    rdfs:label 'Owner Provided Flag' ;
    rdfs:comment 'Indicates whether the individual from whom the item was confiscated voluntarily provided their identity information. True = identity provided; False = identity not provided or refused. Governs whether owner identity fields are populated and affects retrieval eligibility.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ownerTicketBarcode rdf:type rdf:Property ;
    rdfs:label 'Owner Ticket Barcode' ;
    rdfs:comment 'Barcode or ticket reference number from the ticket held by the individual from whom the item was confiscated. Links the confiscation event to the ticketing system (Ticketmaster/AXS) for fan identity resolution and post-event ban enforcement.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptIssuedFlag rdf:type rdf:Property ;
    rdfs:label 'Receipt Issued Flag' ;
    rdfs:comment 'Indicates whether a physical or digital confiscation receipt was issued to the item owner at the time of confiscation. True = receipt issued; False = no receipt issued (e.g., item immediately destroyed or owner refused). Supports retrieval claim validation.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retrievalDate rdf:type rdf:Property ;
    rdfs:label 'Retrieval Date' ;
    rdfs:comment 'Date on which the confiscated item was retrieved by its owner from secure storage post-event. Populated only when confiscation_status transitions to \'retrieved_by_owner\'. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:wadaSubstanceFlag rdf:type rdf:Property ;
    rdfs:label 'Wada Substance Flag' ;
    rdfs:comment 'Indicates whether the confiscated item is classified as a prohibited substance under the World Anti-Doping Agency (WADA) prohibited list. True = WADA-listed substance; False = not a WADA substance. Triggers mandatory reporting to league compliance and anti-doping authorities.' ;
    rdfs:domain ind:ConfiscationRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:credentialEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Credential Employee Id' ;
    rdfs:comment 'Reference to the internal system user (security administrator or credentialing officer) who issued this credential. Supports chain-of-custody audit trail and accountability for credential issuance.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:credentialHolderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Credential Holder Employee Id' ;
    rdfs:comment 'Reference to the person record (workforce member, athlete, contractor, media representative, or VIP guest) to whom this credential is issued. Links credential to the holder\'s identity in the relevant party master.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:credentialRevokedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Credential Revoked By User Employee Id' ;
    rdfs:comment 'Reference to the internal system user (security administrator) who executed the revocation action. Supports chain-of-custody audit trail. Null if credential has not been revoked.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:employeeCertificationId rdf:type rdf:Property ;
    rdfs:label 'Employee Certification Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee_certification. Business justification: Credential issuance in sports venues requires verifying the holder\'s underlying certification (e.g., security license, first-aid cert). Accreditation teams must confirm employee_certification before i' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmployeeCertification .

ind:hospitalityEntitlementId rdf:type rdf:Property ;
    rdfs:label 'Hospitality Entitlement Id' ;
    rdfs:comment 'Foreign key linking to sponsorship.hospitality_entitlement. Business justification: Sponsor hospitality entitlements (VIP suite, field-level passes) are fulfilled by issuing security credentials to sponsor guests. Security staff verify credentials against the authorizing entitlement ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HospitalityEntitlement .

ind:issuedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Issued By User Employee Id' ;
    rdfs:comment 'Reference to the internal system user (security administrator or credentialing officer) who issued this credential. Supports chain-of-custody audit trail and accountability for credential issuance.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:revokedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Revoked By User Employee Id' ;
    rdfs:comment 'Reference to the internal system user (security administrator) who executed the revocation action. Supports chain-of-custody audit trail. Null if credential has not been revoked.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accessZoneList rdf:type rdf:Property ;
    rdfs:label 'Access Zone List' ;
    rdfs:comment 'Comma-delimited list of specific zone codes within the venue that this credential authorizes entry to (e.g., \'Z01,Z04,Z07,Z12\'). Complements access_tier with granular zone-level control as configured in the access control system.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationReference rdf:type rdf:Property ;
    rdfs:label 'Accreditation Reference' ;
    rdfs:comment 'External reference number or accreditation ID assigned by the governing body or league office (e.g., FIFA accreditation number, IOC media pass number). Used for cross-referencing with external accreditation systems.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Background Check Status' ;
    rdfs:comment 'Status of the background screening conducted on the credential holder prior to issuance. Classified as confidential business-sensitive data. Values: cleared (passed), pending (in progress), failed (did not pass), waived (exempted by policy), not_required (credential type exempt).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:barcodeValue rdf:type rdf:Property ;
    rdfs:label 'Barcode Value' ;
    rdfs:comment 'Encoded barcode string (1D or 2D/QR) printed on or embedded in the credential, scanned at access control checkpoints. Classified as confidential as it is the operational key for physical access. Managed in alignment with Ticketmaster/AXS access control systems.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:biometricLinked rdf:type rdf:Property ;
    rdfs:label 'Biometric Linked' ;
    rdfs:comment 'Indicates whether this credential has been linked to a biometric profile (e.g., fingerprint, facial recognition) for enhanced identity verification at high-security access points. True = biometric data is enrolled and active for this credential.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:biometricType rdf:type rdf:Property ;
    rdfs:label 'Biometric Type' ;
    rdfs:comment 'Type of biometric modality enrolled for this credential when biometric_linked is True. Classified as restricted PII/biometric per GDPR Article 9 and CCPA. Values: fingerprint, facial_recognition, iris_scan, palm_vein, none.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:colorCode rdf:type rdf:Property ;
    rdfs:label 'Color Code' ;
    rdfs:comment 'Hex color code representing the physical color of the credential lanyard or card stock, used for rapid visual identification of access tier by security staff at checkpoints (e.g., #FF0000 for red = restricted zone, #00FF00 for green = general operations).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialNumber rdf:type rdf:Property ;
    rdfs:label 'Credential Number' ;
    rdfs:comment 'Externally visible, human-readable credential identifier printed on the physical badge or encoded in the digital pass (e.g., CRED-STAFF-000123). Used by security personnel and access control systems to reference a specific credential without exposing the internal surrogate key.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialStatus rdf:type rdf:Property ;
    rdfs:label 'Credential Status' ;
    rdfs:comment 'Current lifecycle state of the credential. active: valid and in use; suspended: temporarily deactivated (e.g., investigation); revoked: permanently cancelled; expired: past validity end date; pending_activation: issued but not yet activated; lost_stolen: reported missing and deactivated for security.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyContactName rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Name' ;
    rdfs:comment 'Full name of the emergency contact person for the credential holder, used by venue medical and security staff in the event of an incident. Classified as restricted PII per GDPR and CCPA.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyContactPhone rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Phone' ;
    rdfs:comment 'Phone number of the emergency contact person for the credential holder. Classified as restricted PII per GDPR and CCPA. Used by venue medical and security staff in emergency situations.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escortRequired rdf:type rdf:Property ;
    rdfs:label 'Escort Required' ;
    rdfs:comment 'Indicates whether the credential holder must be accompanied by an authorized escort when accessing certain zones. True = escort is mandatory. Used for contractor and visitor credentials in high-security areas.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holderName rdf:type rdf:Property ;
    rdfs:label 'Holder Name' ;
    rdfs:comment 'Full legal name of the individual to whom the credential is issued, as printed on the physical credential. Retained for operational verification by security personnel at access points. Classified as restricted PII per GDPR and CCPA.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holderOrganization rdf:type rdf:Property ;
    rdfs:label 'Holder Organization' ;
    rdfs:comment 'Name of the organization, team, media outlet, agency, or employer that the credential holder represents (e.g., \'ESPN\', \'Dallas Cowboys\', \'ABC Security Services\'). Used for affiliation-based access grouping and sponsor/partner credential management.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holderRole rdf:type rdf:Property ;
    rdfs:label 'Holder Role' ;
    rdfs:comment 'Functional role or job title of the credential holder within the event or venue context (e.g., \'Head Coach\', \'Camera Operator\', \'Paramedic\', \'Venue Director\'). Informs access tier assignment and is displayed on the physical credential.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingAuthorityCode rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority Code' ;
    rdfs:comment 'Standardized short code identifying the issuing authority (e.g., \'NFL_SEC\', \'FIFA_ACC\', \'VENUE_MGR\'). Used for system-level filtering and reporting across multi-league or multi-event deployments.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementBadgeNumber rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Badge Number' ;
    rdfs:comment 'Official badge or shield number of the law enforcement officer, used to verify identity against agency records. Classified as confidential. Populated only for credential_type = law_enforcement.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:multiEventFlag rdf:type rdf:Property ;
    rdfs:label 'Multi Event Flag' ;
    rdfs:comment 'Indicates whether this credential is valid across multiple events (e.g., a season-long staff badge or a tournament-wide media pass) rather than a single event. True = valid for multiple events within the validity period.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:photoUrl rdf:type rdf:Property ;
    rdfs:label 'Photo Url' ;
    rdfs:comment 'Secure URL pointing to the credential holder\'s photograph stored in the Digital Asset Management (DAM) system, used for visual identity verification by security personnel. Classified as restricted biometric PII per GDPR Article 9.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:printTemplateCode rdf:type rdf:Property ;
    rdfs:label 'Print Template Code' ;
    rdfs:comment 'Code referencing the physical credential print template used for this credential type (e.g., \'TMPL-MEDIA-2024\', \'TMPL-STAFF-VIP\'). Determines layout, branding, and security features printed on the badge.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rfidTagCode rdf:type rdf:Property ;
    rdfs:label 'Rfid Tag Code' ;
    rdfs:comment 'Unique identifier of the RFID chip embedded in the credential card or wristband, used for contactless access control scanning. Classified as confidential as it is a physical access key. Null if the credential does not use RFID technology.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Vehicle Access Flag' ;
    rdfs:comment 'Indicates whether this credential also grants vehicle access to restricted parking or loading dock areas at the venue. True = vehicle access is authorized in addition to pedestrian access.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vehiclePlateNumber rdf:type rdf:Property ;
    rdfs:label 'Vehicle Plate Number' ;
    rdfs:comment 'License plate number of the vehicle authorized for venue access under this credential when vehicle_access_flag is True. Classified as confidential. Null if vehicle access is not granted.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Credential Assignment Id' ;
    rdfs:comment 'Unique system-generated identifier for each credential assignment record. Primary key for the credential_assignment data product in the security domain.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CredentialAssignment .

ind:assignedByOfficerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned By Officer Employee Id' ;
    rdfs:comment 'Reference to the security officer or credentialing authority who authorized and issued this credential assignment. Used for accountability and audit trail purposes.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryCredentialHolderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Credential Holder Employee Id' ;
    rdfs:comment 'Reference to the individual (staff, media, contractor, law enforcement, athlete, sponsor representative) to whom the credential is assigned. Links to the person or party master record.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assignmentNumber rdf:type rdf:Property ;
    rdfs:label 'Assignment Number' ;
    rdfs:comment 'Externally-known human-readable business identifier for the credential assignment, used in credentialing workflows, printed on assignment receipts, and referenced in post-event reconciliation reports. Format: CA-{YYYY}-{NNNNNN}.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialScope rdf:type rdf:Property ;
    rdfs:label 'Credential Scope' ;
    rdfs:comment 'Defines the temporal and event scope of the credential assignment — whether it is valid for a single event, multiple events, an entire season, or the venue broadly. Drives validity period enforcement and renewal workflows.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDayNumber rdf:type rdf:Property ;
    rdfs:label 'Event Day Number' ;
    rdfs:comment 'For multi-day events (tournaments, festivals, conventions), the specific day number within the event for which this credential is valid. Null for single-day events or season-wide credentials.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:holderFullName rdf:type rdf:Property ;
    rdfs:label 'Holder Full Name' ;
    rdfs:comment 'Full legal name of the individual to whom the credential is assigned. Captured at time of assignment for identity verification and printed on the credential. Subject to GDPR and CCPA data protection requirements.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holderIdNumber rdf:type rdf:Property ;
    rdfs:label 'Holder Id Number' ;
    rdfs:comment 'Government-issued or organizational identification number (e.g., employee ID, press pass number, law enforcement badge number) used to verify the identity of the credential holder at time of issuance.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holderPhotoUrl rdf:type rdf:Property ;
    rdfs:label 'Holder Photo Url' ;
    rdfs:comment 'Secure URL reference to the credential holder\'s photo image stored in the Digital Asset Management (DAM) system. Used for visual identity verification at access control points. Subject to biometric data protection regulations.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holderType rdf:type rdf:Property ;
    rdfs:label 'Holder Type' ;
    rdfs:comment 'Classification of the individual receiving the credential, defining their role and relationship to the event or venue. Drives access zone eligibility and credentialing workflow routing. [ENUM-REF-CANDIDATE: staff|media|contractor|law_enforcement|athlete|sponsor|vip|volunteer|official|vendor — promote to reference product]' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Issued Timestamp' ;
    rdfs:comment 'Date and time at which the physical or digital credential was formally issued and activated in the access control system. Distinct from assignment_timestamp (when the record was created) and pickup_timestamp (when the holder collected it).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mealEntitlement rdf:type rdf:Property ;
    rdfs:label 'Meal Entitlement' ;
    rdfs:comment 'Indicates whether the credential assignment includes meal or catering entitlement in designated hospitality areas (e.g., press dining, staff cafeteria). Used for catering planning and cost allocation.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:multiZoneAccess rdf:type rdf:Property ;
    rdfs:label 'Multi Zone Access' ;
    rdfs:comment 'Indicates whether this credential assignment grants access to multiple zones beyond the primary access zone. True when the holder is authorized for more than one zone; False for single-zone access.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parkingZone rdf:type rdf:Property ;
    rdfs:label 'Parking Zone' ;
    rdfs:comment 'Designated parking zone or lot assigned to the credential holder when vehicle access is granted (e.g., \'Lot A - Media\', \'Field Level - Broadcast\', \'VIP Garage\'). Null when vehicle_access is False.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pickupConfirmed rdf:type rdf:Property ;
    rdfs:label 'Pickup Confirmed' ;
    rdfs:comment 'Indicates whether the credential holder has physically collected the credential from the credentialing desk. True when pickup has been confirmed; False when credential is still awaiting collection.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pickupLocation rdf:type rdf:Property ;
    rdfs:label 'Pickup Location' ;
    rdfs:comment 'Name or designation of the credentialing desk, gate, or location where the credential was or is to be collected by the holder (e.g., \'Media Gate North\', \'VIP Credentialing Desk Level 2\').' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pickupTimestamp rdf:type rdf:Property ;
    rdfs:label 'Pickup Timestamp' ;
    rdfs:comment 'Date and time at which the credential holder physically collected the credential from the credentialing desk. Null if credential has not yet been picked up.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:returnConfirmed rdf:type rdf:Property ;
    rdfs:label 'Return Confirmed' ;
    rdfs:comment 'Indicates whether the credential has been returned to the credentialing authority after the event or assignment period. True when return is confirmed; False when credential is still outstanding. Critical for post-event reconciliation.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnTimestamp rdf:type rdf:Property ;
    rdfs:label 'Return Timestamp' ;
    rdfs:comment 'Date and time at which the credential was returned to the credentialing authority. Null if credential has not yet been returned. Used in post-event reconciliation to identify unreturned credentials.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:specialAccessNotes rdf:type rdf:Property ;
    rdfs:label 'Special Access Notes' ;
    rdfs:comment 'Free-text field capturing any special access permissions, restrictions, or annotations associated with this credential assignment (e.g., \'Authorized for post-game press conference only\', \'Escort required at all times\'). Supports non-standard credentialing scenarios.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleAccess rdf:type rdf:Property ;
    rdfs:label 'Vehicle Access' ;
    rdfs:comment 'Indicates whether this credential assignment includes authorization for vehicle access to restricted venue areas such as loading docks, field-level parking, or broadcast compound. True when vehicle access is granted.' ;
    rdfs:domain ind:CredentialAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alcoholCutoffTime rdf:type rdf:Property ;
    rdfs:label 'Alcohol Cutoff Time' ;
    rdfs:comment 'Scheduled timestamp at which alcohol sales and service must cease during the event, as mandated by local licensing conditions or league policy. Null when alcohol service is not permitted.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:alcoholServicePermitted rdf:type rdf:Property ;
    rdfs:label 'Alcohol Service Permitted' ;
    rdfs:comment 'Indicates whether alcohol service is permitted at this event under this plan. Alcohol service status directly influences crowd behavior risk assessment, staffing ratios, and incident response protocols.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorityApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Authority Approval Date' ;
    rdfs:comment 'Date on which the local authority, fire marshal, or governing body granted formal approval of this crowd management plan. Null if approval is pending or not required.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bagPolicyType rdf:type rdf:Property ;
    rdfs:label 'Bag Policy Type' ;
    rdfs:comment 'Bag screening policy in effect for this event. Clear_bag_only requires transparent bags meeting size specifications; no_bag prohibits all bags; standard_search allows bags subject to manual inspection; no_restriction applies no bag limitations.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crowdFlowStrategy rdf:type rdf:Property ;
    rdfs:label 'Crowd Flow Strategy' ;
    rdfs:comment 'Operational strategy governing how attendees are directed through the venue during ingress and egress. Zoned entry assigns gates by seating section; timed entry staggers arrival windows; general admission (GA) is open flow; VIP priority provides dedicated lanes; staggered release controls post-event exit sequencing; hybrid combines multiple approaches.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evacuationRouteDescription rdf:type rdf:Property ;
    rdfs:label 'Evacuation Route Description' ;
    rdfs:comment 'Narrative description of the primary and secondary emergency evacuation routes for the venue under this plan, including designated assembly points, exit sequencing by zone, and any route modifications due to venue configuration or construction. Supports compliance with OSHA emergency action plan requirements.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evacuationTimeTargetMinutes rdf:type rdf:Property ;
    rdfs:label 'Evacuation Time Target Minutes' ;
    rdfs:comment 'Target maximum time in minutes to fully evacuate the venue under emergency conditions, as established by the venue security director and validated against fire marshal requirements. Benchmark for drill performance and plan adequacy reviews.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gateCloseTime rdf:type rdf:Property ;
    rdfs:label 'Gate Close Time' ;
    rdfs:comment 'Scheduled timestamp at which entry gates are closed to new arrivals. After this time, late arrivals may be directed to designated late-entry points per the plan.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:gatesActivatedCount rdf:type rdf:Property ;
    rdfs:label 'Gates Activated Count' ;
    rdfs:comment 'Total number of entry gates scheduled to be open and staffed during peak ingress as defined in the gate activation schedule. Determines throughput capacity and is calibrated against expected attendance.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:highRiskFlag rdf:type rdf:Property ;
    rdfs:label 'High Risk Flag' ;
    rdfs:comment 'Indicates whether this event has been classified as high-risk based on threat intelligence, historical incident data, rivalry classification, or law enforcement advisories. When True, elevated security protocols, additional staffing, and enhanced surveillance are mandated.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastDrillDate rdf:type rdf:Property ;
    rdfs:label 'Last Drill Date' ;
    rdfs:comment 'Date of the most recent evacuation or emergency response drill conducted against this plan. Used to verify plan currency and compliance with regulatory drill frequency requirements.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lawEnforcementContact rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Contact' ;
    rdfs:comment 'Name and contact details of the designated law enforcement liaison officer for this event. Confidential operational information used by venue security director and event command staff.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:magnetometerScreening rdf:type rdf:Property ;
    rdfs:label 'Magnetometer Screening' ;
    rdfs:comment 'Indicates whether walk-through magnetometer or wand screening is deployed at entry gates for this event. Drives gate throughput calculations and staffing requirements for security screening lanes.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxSafeOccupancy rdf:type rdf:Property ;
    rdfs:label 'Max Safe Occupancy' ;
    rdfs:comment 'Total maximum number of persons permitted inside the venue at any one time as determined by fire code, structural engineering assessments, and local authority licensing. This is the hard ceiling for ticket sales and access control enforcement.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medicalStaffCount rdf:type rdf:Property ;
    rdfs:label 'Medical Staff Count' ;
    rdfs:comment 'Number of on-site medical personnel (paramedics, EMTs, first-aiders) deployed under this plan. Determined by expected attendance, event risk classification, and local authority licensing requirements.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peakIngressEndTime rdf:type rdf:Property ;
    rdfs:label 'Peak Ingress End Time' ;
    rdfs:comment 'Expected timestamp at which the peak ingress volume subsides to normal flow levels. Defines the window during which maximum gate staffing and crowd control resources must be deployed.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:peakIngressStartTime rdf:type rdf:Property ;
    rdfs:label 'Peak Ingress Start Time' ;
    rdfs:comment 'Expected timestamp at which the highest volume of attendee arrivals begins, based on historical gate scan data and event start time. Used to schedule peak staffing deployment and activate maximum gate capacity.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:planCode rdf:type rdf:Property ;
    rdfs:label 'Plan Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the crowd management plan, used in operational communications, regulatory submissions, and cross-system references. Format: CMP- followed by 4-12 alphanumeric characters.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planName rdf:type rdf:Property ;
    rdfs:label 'Plan Name' ;
    rdfs:comment 'Human-readable descriptive name for the crowd management plan, typically referencing the event name, venue, and season or date for easy identification by operations staff.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planNotes rdf:type rdf:Property ;
    rdfs:label 'Plan Notes' ;
    rdfs:comment 'Free-text field for operational notes, special instructions, or event-specific considerations not captured in structured fields. May include weather contingency notes, VIP movement protocols, or coordination notes with law enforcement.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Status' ;
    rdfs:comment 'Current lifecycle state of the crowd management plan. Draft indicates initial authoring; under_review indicates pending security director sign-off; approved indicates authorized for use; active indicates currently in force on event day; superseded indicates replaced by a newer version; archived indicates retired.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prohibitedItemsList rdf:type rdf:Property ;
    rdfs:label 'Prohibited Items List' ;
    rdfs:comment 'Comma-separated list of items prohibited from entry under this crowd management plan (e.g., large bags, glass containers, laser pointers, professional cameras). Drives security screening protocols and public-facing communications.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityStaffingCount rdf:type rdf:Property ;
    rdfs:label 'Security Staffing Count' ;
    rdfs:comment 'Total number of security personnel (including contracted and in-house staff) scheduled to be deployed for this event under this crowd management plan. Used for workforce planning and compliance with venue licensing conditions.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:submittedToAuthorityDate rdf:type rdf:Property ;
    rdfs:label 'Submitted To Authority Date' ;
    rdfs:comment 'Date on which this crowd management plan was formally submitted to the relevant local authority, fire marshal, or governing body for review and licensing approval. Required for regulatory compliance tracking.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveillanceCameraCount rdf:type rdf:Property ;
    rdfs:label 'Surveillance Camera Count' ;
    rdfs:comment 'Total number of CCTV and surveillance cameras active and covering the venue under this crowd management plan. Used to verify adequate coverage density per zone and compliance with venue licensing conditions.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveillanceSystemActive rdf:type rdf:Property ;
    rdfs:label 'Surveillance System Active' ;
    rdfs:comment 'Indicates whether the venue CCTV and surveillance system is confirmed active and operational for this event under this plan. A value of True confirms surveillance coverage is in place as required by the plan.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:venueConfigurationCode rdf:type rdf:Property ;
    rdfs:label 'Venue Configuration Code' ;
    rdfs:comment 'Code identifying the specific seating and floor layout configuration of the venue for this event, as defined in the Archtics venue seating and inventory management system. Different configurations (e.g., end-stage, center-stage, full-capacity, reduced-capacity) drive different crowd flow strategies.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneOccupancyThresholds rdf:type rdf:Property ;
    rdfs:label 'Zone Occupancy Thresholds' ;
    rdfs:comment 'Structured description of maximum safe occupancy thresholds by venue zone (e.g., lower bowl, upper deck, floor/GA, concourse, VIP areas). Stored as a delimited key-value string (zone_code:max_persons) since complex types are not permitted. Drives real-time crowd density monitoring and gate hold decisions.' ;
    rdfs:domain ind:CrowdManagementPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ejectionRecordId rdf:type rdf:Property ;
    rdfs:label 'Ejection Record Id' ;
    rdfs:comment 'Unique system-generated identifier for each ejection record. Primary key for the ejection_record data product within the security domain.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EjectionRecord .

ind:primaryEjectionEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Ejection Employee Id' ;
    rdfs:comment 'Reference to the security officer or staff member who executed the ejection, as recorded in SAP SuccessFactors workforce records. Used for officer performance review, training needs analysis, and legal accountability.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:appealFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Flag' ;
    rdfs:comment 'Indicates whether the ejected individual has formally filed an appeal against the ejection decision. True = appeal filed; False = no appeal filed. Triggers the ejection review workflow and updates ejection_status to \'appealed\'.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:banRecommendationFlag rdf:type rdf:Property ;
    rdfs:label 'Ban Recommendation Flag' ;
    rdfs:comment 'Indicates whether the ejecting officer or supervisor has recommended a venue ban for the ejected individual. True = ban recommended; False = no ban recommended. Feeds the venue ban registry workflow for formal ban issuance.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:banRegistryReference rdf:type rdf:Property ;
    rdfs:label 'Ban Registry Reference' ;
    rdfs:comment 'Reference to the formal ban record created in the venue ban registry as a result of this ejection. Populated after the ban is formally issued following the recommendation workflow. Null if no ban was issued.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:banType rdf:type rdf:Property ;
    rdfs:label 'Ban Type' ;
    rdfs:comment 'Classification of the recommended or issued ban scope. Populated when ban_recommendation_flag is True. Drives the ban registry entry type and enforcement duration. [ENUM-REF-CANDIDATE: single_event|season|multi_season|lifetime|league_wide — promote to reference product]' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crowdDensityLevel rdf:type rdf:Property ;
    rdfs:label 'Crowd Density Level' ;
    rdfs:comment 'Assessed crowd density level in the ejection zone at the time of the incident. Used for crowd management analysis, security staffing optimization, and post-event safety reviews. Aligns with ISO 20121 event sustainability and safety management standards.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ejectedPartyIdNumber rdf:type rdf:Property ;
    rdfs:label 'Ejected Party Id Number' ;
    rdfs:comment 'The identification document number (e.g., driver\'s license number, passport number) of the ejected individual as recorded for ban enforcement and law enforcement handoff. Stored in compliance with GDPR and CCPA data minimization principles.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ejectedPartyIdType rdf:type rdf:Property ;
    rdfs:label 'Ejected Party Id Type' ;
    rdfs:comment 'Type of identification document presented or used to identify the ejected individual at the time of ejection. Supports identity verification for ban enforcement and law enforcement handoff.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ejectedPartyName rdf:type rdf:Property ;
    rdfs:label 'Ejected Party Name' ;
    rdfs:comment 'Full name of the individual who was ejected, as recorded at the time of ejection from identification documents or ticketing records. Required for ban enforcement, law enforcement handoff documentation, and legal proceedings.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ejectedPartyType rdf:type rdf:Property ;
    rdfs:label 'Ejected Party Type' ;
    rdfs:comment 'Classification of the type of individual who was ejected. Determines the applicable code of conduct, ban enforcement pathway, and reporting requirements. VIP (Very Important Person) guests and media personnel follow distinct escalation protocols.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ejectingOfficerBadge rdf:type rdf:Property ;
    rdfs:label 'Ejecting Officer Badge' ;
    rdfs:comment 'The badge or credential number of the security officer who performed the ejection. Serves as the operational identifier used in field documentation, law enforcement handoff forms, and incident reports independent of the internal workforce system ID.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Ejection Reason Code' ;
    rdfs:comment 'Standardized reason code classifying the primary cause of the ejection. Drives ban recommendation logic, repeat offender scoring, and regulatory reporting. [ENUM-REF-CANDIDATE: intoxication|fighting|field_invasion|harassment|prohibited_item|threatening_behavior|racial_abuse|ticket_fraud — promote to reference product]' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ejectionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Ejection Reason Description' ;
    rdfs:comment 'Free-text narrative description of the specific circumstances leading to the ejection, as recorded by the ejecting security officer. Supplements the standardized reason code with contextual detail for incident review and legal proceedings.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ejectionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Ejection Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned to this ejection at the time of occurrence, used in law enforcement handoff documentation, ban notices, and fan appeals. Format: EJ-{YYYY}-{NNNNNN}.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ejectionStatus rdf:type rdf:Property ;
    rdfs:label 'Ejection Status' ;
    rdfs:comment 'Current lifecycle state of the ejection record. \'pending\' indicates the ejection is being processed; \'confirmed\' means the ejection is finalized; \'appealed\' means the ejected party has filed a formal appeal; \'overturned\' means the ejection was reversed upon review; \'upheld\' means the ejection was sustained after appeal.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ejectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ejection Timestamp' ;
    rdfs:comment 'The precise date and time at which the ejection was executed — i.e., when the individual physically exited or was removed from the venue. This is the principal real-world business event time, distinct from when the record was created in the system.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lawEnforcementHandoffFlag rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Handoff Flag' ;
    rdfs:comment 'Indicates whether the ejected individual was handed off to law enforcement (police, stadium security authority) at the time of ejection. True = law enforcement was involved; False = internal security handled the ejection without law enforcement transfer.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalAssistanceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Medical Assistance Required Flag' ;
    rdfs:comment 'Indicates whether medical assistance was required for the ejected individual or any other party involved in the incident (e.g., intoxication requiring EMT response, injury from altercation). True = medical assistance was provided or requested; False = no medical assistance needed.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorEjectionCount rdf:type rdf:Property ;
    rdfs:label 'Prior Ejection Count' ;
    rdfs:comment 'The number of prior ejections on record for this individual at the time of this ejection event. Used to determine escalation thresholds for ban recommendations and repeat offender classification. Sourced from the ejection history at time of record creation.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prohibitedItemDescription rdf:type rdf:Property ;
    rdfs:label 'Prohibited Item Description' ;
    rdfs:comment 'Description of any prohibited item(s) found on or associated with the ejected individual. Populated when ejection_reason_code is \'prohibited_item\'. Includes item type, quantity, and disposition (confiscated, surrendered, etc.).' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repeatOffenderFlag rdf:type rdf:Property ;
    rdfs:label 'Repeat Offender Flag' ;
    rdfs:comment 'Indicates whether the ejected individual has a prior ejection record within the Sports Entertainment system at the time of this ejection. True = prior ejection(s) on record; False = first-time ejection. Drives escalated ban recommendations and repeat offender tracking workflows.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surveillanceClipReference rdf:type rdf:Property ;
    rdfs:label 'Surveillance Clip Reference' ;
    rdfs:comment 'Digital Asset Management (DAM) reference identifier for the surveillance footage clip associated with this ejection, stored in the Dalet Galaxy media asset management system. Populated when surveillance_footage_available_flag is True.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveillanceFootageAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Surveillance Footage Available Flag' ;
    rdfs:comment 'Indicates whether surveillance camera footage of the ejection incident is available and has been flagged for retention. True = footage available and retained; False = no footage available. Supports legal proceedings, appeals, and security system audits.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ticketBarcode rdf:type rdf:Property ;
    rdfs:label 'Ticket Barcode' ;
    rdfs:comment 'The barcode or digital token from the ejected individual\'s ticket as scanned at entry or at the point of ejection via Ticketmaster/AXS access control. Links the ejection to the specific ticket transaction for ban enforcement and refund eligibility determination.' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venueZoneCode rdf:type rdf:Property ;
    rdfs:label 'Venue Zone Code' ;
    rdfs:comment 'Alphanumeric code identifying the specific zone or section of the venue where the ejection incident originated, as defined in the Archtics venue seating and inventory management system (e.g., \'SEC-114\', \'FIELD-LEVEL\', \'CONCOURSE-B\'). Used for crowd management hotspot analysis.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venueZoneType rdf:type rdf:Property ;
    rdfs:label 'Venue Zone Type' ;
    rdfs:comment 'Classification of the venue zone where the ejection occurred. Supports access control analysis and security resource allocation by zone category. [ENUM-REF-CANDIDATE: seating_bowl|field_level|concourse|vip_suite|media_zone|backstage|parking|entry_gate — promote to reference product]' ;
    rdfs:domain ind:EjectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activatingAuthorityEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Activating Authority Employee Id' ;
    rdfs:comment 'Reference to the individual (security officer, venue director, incident commander) who formally authorized and triggered the emergency plan activation. Serves as the PARTY_REFERENCE category for TRANSACTION_HEADER role.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:complianceIncidentReportId rdf:type rdf:Property ;
    rdfs:label 'Compliance Incident Report Id' ;
    rdfs:comment 'Foreign key linking to compliance.incident_report. Business justification: Emergency activations (bomb threats, mass casualty events, evacuations) at sports venues trigger mandatory OSHA recordable incident reports and league governing body notifications. Compliance teams mu' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IncidentReport .

ind:triggeringSecurityIncidentId rdf:type rdf:Property ;
    rdfs:label 'Triggering Security Incident Id' ;
    rdfs:comment 'Foreign key linking to security.security_incident. Business justification: An emergency activation is often triggered by a specific security incident — a bomb threat, mass casualty event, or severe altercation that escalates to emergency response plan activation. The existin' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SecurityIncident .

ind:activationNumber rdf:type rdf:Property ;
    rdfs:label 'Activation Number' ;
    rdfs:comment 'Externally-known, human-readable business identifier for this emergency activation event (e.g., EMA-2024-000123). Used in after-action reports, law enforcement coordination, and regulatory filings. Serves as the BUSINESS_IDENTIFIER category for TRANSACTION_HEADER role.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activationSource rdf:type rdf:Property ;
    rdfs:label 'Activation Source' ;
    rdfs:comment 'Identifies how the emergency activation was triggered: manually by an authorized officer, automatically by an alarm or surveillance system, or reported by law enforcement, staff, or fans. Supports root cause analysis and system effectiveness evaluation.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:afterActionReportReference rdf:type rdf:Property ;
    rdfs:label 'After Action Report Reference' ;
    rdfs:comment 'Document reference number or URL linking to the formal After-Action Report (AAR) completed following this emergency activation. The AAR documents lessons learned, response effectiveness, and corrective actions. Required for OSHA, ISO 20121, and league governance compliance.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:afterActionReportStatus rdf:type rdf:Property ;
    rdfs:label 'After Action Report Status' ;
    rdfs:comment 'Current completion status of the After-Action Report (AAR) for this emergency activation. Tracks compliance with mandatory post-incident review requirements.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allClearTimestamp rdf:type rdf:Property ;
    rdfs:label 'All Clear Timestamp' ;
    rdfs:comment 'The date and time when the all-clear signal was officially issued, indicating the emergency has been resolved and normal operations may resume. Null if the activation has not yet been resolved. Used to calculate response duration.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:broadcastInterrupted rdf:type rdf:Property ;
    rdfs:label 'Broadcast Interrupted' ;
    rdfs:comment 'Indicates whether live broadcast operations (TV, OTT, radio) were interrupted or suspended as a result of this emergency activation. Relevant for media rights compliance, FCC reporting, and broadcast partner SLA management.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commandPostLocation rdf:type rdf:Property ;
    rdfs:label 'Command Post Location' ;
    rdfs:comment 'Physical location description of the Incident Command Post (ICP) established for this emergency activation (e.g., \'Gate C Security Office\', \'Parking Lot B Mobile Command Unit\'). Critical for coordinating multi-agency response and documenting ICS compliance.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmedFatalitiesCount rdf:type rdf:Property ;
    rdfs:label 'Confirmed Fatalities Count' ;
    rdfs:comment 'Total number of confirmed fatalities recorded as a direct result of the emergency incident. Triggers mandatory OSHA fatality reporting within 8 hours, executive notification, and regulatory investigation protocols.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:confirmedInjuriesCount rdf:type rdf:Property ;
    rdfs:label 'Confirmed Injuries Count' ;
    rdfs:comment 'Total number of confirmed injuries (non-fatal) recorded as a direct result of the emergency incident. Used for OSHA 300 log reporting, insurance claims, and after-action analysis.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drillExercise rdf:type rdf:Property ;
    rdfs:label 'Drill Exercise' ;
    rdfs:comment 'Indicates whether this activation record represents a planned emergency drill or tabletop exercise rather than an actual emergency event. Allows filtering of drill records from operational incident analytics and regulatory reporting.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emsNotified rdf:type rdf:Property ;
    rdfs:label 'Ems Notified' ;
    rdfs:comment 'Indicates whether Emergency Medical Services (EMS) was formally notified as part of this emergency activation. Mandatory documentation for mass casualty and medical emergency plan types.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedOccupancyAtActivation rdf:type rdf:Property ;
    rdfs:label 'Estimated Occupancy At Activation' ;
    rdfs:comment 'Estimated number of persons (fans, staff, athletes, media) present in the venue at the time of emergency activation. Critical for resource allocation, casualty ratio calculations, and post-event safety analysis. Serves as the QUANTITATIVE_RESULT category for this non-monetary TRANSACTION_HEADER.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evacuationInitiated rdf:type rdf:Property ;
    rdfs:label 'Evacuation Initiated' ;
    rdfs:comment 'Indicates whether a full or partial venue evacuation was initiated as part of this emergency activation. Drives crowd management protocol tracking and post-event safety audit requirements.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventCancelled rdf:type rdf:Property ;
    rdfs:label 'Event Cancelled' ;
    rdfs:comment 'Indicates whether the Sports Entertainment event was fully cancelled (not resumed) as a result of this emergency activation. Triggers ticketing refund workflows, force majeure clauses, and insurance claim processes.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventSuspended rdf:type rdf:Property ;
    rdfs:label 'Event Suspended' ;
    rdfs:comment 'Indicates whether the Sports Entertainment event (game, concert, match) was formally suspended or halted as a result of this emergency activation. Impacts ticketing refund obligations, broadcast rights, and league governance reporting.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:falseAlarm rdf:type rdf:Property ;
    rdfs:label 'False Alarm' ;
    rdfs:comment 'Indicates whether this emergency activation was subsequently determined to be a false alarm (no actual emergency existed). Critical for tracking false alarm rates, system calibration, and regulatory reporting to fire/police authorities.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fbiNotified rdf:type rdf:Property ;
    rdfs:label 'Fbi Notified' ;
    rdfs:comment 'Indicates whether the Federal Bureau of Investigation (FBI) was formally notified as part of this emergency activation. Required for terrorism, active shooter, and bomb threat plan types per federal reporting obligations.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fireDepartmentNotified rdf:type rdf:Property ;
    rdfs:label 'Fire Department Notified' ;
    rdfs:comment 'Indicates whether the fire department was formally notified as part of this emergency activation. Required for NFPA 101 and OSHA compliance documentation.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incidentCommanderName rdf:type rdf:Property ;
    rdfs:label 'Incident Commander Name' ;
    rdfs:comment 'Full name of the designated Incident Commander (IC) who assumed operational control of the emergency response under the Incident Command System (ICS). May differ from the activating authority if command was transferred.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentSeverityLevel rdf:type rdf:Property ;
    rdfs:label 'Incident Severity Level' ;
    rdfs:comment 'Standardized severity classification of the emergency incident at time of activation (Level 1 = minor/localized to Level 5 = catastrophic/mass casualty). Drives resource mobilization, agency notification requirements, and executive escalation protocols.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentTriggerDescription rdf:type rdf:Property ;
    rdfs:label 'Incident Trigger Description' ;
    rdfs:comment 'Narrative description of the specific incident, condition, or threat that triggered the emergency plan activation. Captures the initiating event details for after-action review and regulatory reporting.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceClaimFiled rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Filed' ;
    rdfs:comment 'Indicates whether an insurance claim has been filed in connection with this emergency activation. Triggers financial reporting workflows and links to the finance domain for claim tracking.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lockdownInitiated rdf:type rdf:Property ;
    rdfs:label 'Lockdown Initiated' ;
    rdfs:comment 'Indicates whether a venue lockdown (perimeter secured, no entry/exit permitted) was initiated as part of this emergency activation. Critical for active shooter and terrorism threat plan types.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalTransportsCount rdf:type rdf:Property ;
    rdfs:label 'Medical Transports Count' ;
    rdfs:comment 'Number of individuals transported by EMS or other medical transport to off-site medical facilities during or immediately following the emergency activation. Supports EMS coordination reporting and insurance documentation.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:otherAgenciesNotified rdf:type rdf:Property ;
    rdfs:label 'Other Agencies Notified' ;
    rdfs:comment 'Free-text or comma-separated list of additional agencies notified beyond police, fire, EMS, and FBI (e.g., \'DHS, ATF, Local Emergency Management, Red Cross, FEMA\'). Captures full notification scope for compliance and after-action review.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policeNotified rdf:type rdf:Property ;
    rdfs:label 'Police Notified' ;
    rdfs:comment 'Indicates whether law enforcement (police) was formally notified as part of this emergency activation. Required for regulatory compliance documentation and after-action reporting.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReportFiled rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Filed' ;
    rdfs:comment 'Indicates whether a mandatory regulatory report (e.g., OSHA fatality/hospitalization report, FCC emergency alert report, local authority notification) has been filed for this emergency activation.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReportReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Reference' ;
    rdfs:comment 'Reference number or tracking identifier for the regulatory report filed with the applicable authority (OSHA, FCC, local emergency management). Populated only when regulatory_report_filed is True.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Response Duration Minutes' ;
    rdfs:comment 'Total elapsed time in minutes from activation_timestamp to all_clear_timestamp. Captured as a stored business metric (not derived at query time) to support SLA compliance reporting and benchmarking against emergency response KPI targets.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shelterInPlaceInitiated rdf:type rdf:Property ;
    rdfs:label 'Shelter In Place Initiated' ;
    rdfs:comment 'Indicates whether a shelter-in-place directive was issued to venue occupants as part of this emergency activation. Mutually exclusive with full evacuation in most scenarios.' ;
    rdfs:domain ind:EmergencyActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:threatCategory rdf:type rdf:Property ;
    rdfs:label 'Threat Category' ;
    rdfs:comment 'Broad category of the threat or hazard that prompted the emergency activation. Used for trend analysis, risk modeling, and compliance reporting across venue and event portfolios. [ENUM-REF-CANDIDATE: physical|medical|environmental|structural|cyber|crowd|weather|terrorism — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByPlanEmergencyResponsePlanId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Plan Emergency Response Plan Id' ;
    rdfs:comment 'Reference to the newer emergency response plan that has replaced this version. Null if this is the current active version. Enables version chain traceability for audit and regulatory review.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmergencyResponsePlan .

ind:activationTrigger rdf:type rdf:Property ;
    rdfs:label 'Activation Trigger' ;
    rdfs:comment 'Narrative description of the specific conditions or thresholds that trigger activation of this emergency response plan (e.g., \'Confirmed armed individual on premises\', \'NWS Tornado Warning issued within 10-mile radius\'). Critical for incident command decision-making.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adaAccommodationProvisions rdf:type rdf:Property ;
    rdfs:label 'Ada Accommodation Provisions' ;
    rdfs:comment 'Description of specific provisions within this plan for evacuating and sheltering guests and staff with disabilities, including wheelchair-accessible evacuation routes, Areas of Rescue Assistance (ARA), and mobility assistance protocols.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationProtocol rdf:type rdf:Property ;
    rdfs:label 'Communication Protocol' ;
    rdfs:comment 'Description of the communication systems and protocols used during plan activation, including radio frequencies, PA system codes, mass notification system triggers, and social media blackout procedures.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crowdCapacityThreshold rdf:type rdf:Property ;
    rdfs:label 'Crowd Capacity Threshold' ;
    rdfs:comment 'Minimum crowd attendance count at which this plan\'s enhanced protocols are activated (e.g., plans may have tiered activation based on event size). Supports DHS Special Event Assessment Rating (SEAR) classification.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dhsApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Dhs Approval Date' ;
    rdfs:comment 'Date on which DHS formally approved this emergency response plan. Null if approval is pending, not required, or rejected.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dhsApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Dhs Approval Status' ;
    rdfs:comment 'Regulatory approval status of this plan with the U.S. Department of Homeland Security. Required for events classified under DHS Special Event Assessment Rating (SEAR) Tier I-III.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireMarshalApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Fire Marshal Approval Date' ;
    rdfs:comment 'Date on which the local fire marshal formally approved this emergency response plan. Null if approval is pending, not required, or rejected.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fireMarshalApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Fire Marshal Approval Status' ;
    rdfs:comment 'Regulatory approval status of this plan with the local fire marshal authority. Required for all venue events under NFPA 101 and local fire codes. Drives event permit issuance.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireMarshalContact rdf:type rdf:Property ;
    rdfs:label 'Fire Marshal Contact' ;
    rdfs:comment 'Primary contact phone number for the local fire marshal office responsible for approving and coordinating fire evacuation components of this plan. Required for regulatory compliance.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentCommandStructure rdf:type rdf:Property ;
    rdfs:label 'Incident Command Structure' ;
    rdfs:comment 'Description of the Incident Command System (ICS) hierarchy governing this plan, including Incident Commander role, Operations Section Chief, Safety Officer, and Public Information Officer designations per NIMS ICS standards.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentCommanderTitle rdf:type rdf:Property ;
    rdfs:label 'Incident Commander Title' ;
    rdfs:comment 'Official job title of the designated Incident Commander (e.g., \'Director of Event Security\', \'VP Venue Operations\'). Used in regulatory filings and law enforcement coordination documents.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaBlackoutFlag rdf:type rdf:Property ;
    rdfs:label 'Media Blackout Flag' ;
    rdfs:comment 'Indicates whether this plan includes a media and social media blackout protocol during initial activation to prevent panic, protect operational security, and manage public communications through official channels only.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalTriageZoneCount rdf:type rdf:Property ;
    rdfs:label 'Medical Triage Zone Count' ;
    rdfs:comment 'Number of designated medical triage zones established under this plan for mass casualty incident (MCI) response. Drives medical resource pre-positioning and EMS coordination planning.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:multiVenueFlag rdf:type rdf:Property ;
    rdfs:label 'Multi Venue Flag' ;
    rdfs:comment 'Indicates whether this emergency response plan applies to multiple venues simultaneously (e.g., a league-wide severe weather protocol). When True, venue_id represents the primary venue and additional venues are linked in a separate association table.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mutualAidAgreementRef rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Agreement Ref' ;
    rdfs:comment 'Reference number or name of the mutual aid agreement with external agencies (neighboring jurisdictions, hospitals, EMS providers) that supports this plan. Enables cross-agency resource sharing during large-scale incidents.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Plan Document Url' ;
    rdfs:comment 'Secure URL to the full emergency response plan document stored in the Sports Entertainment Digital Asset Management (DAM) system. Access restricted to authorized security and compliance personnel. Confidential operational security document.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planOwnerDepartment rdf:type rdf:Property ;
    rdfs:label 'Plan Owner Department' ;
    rdfs:comment 'Organizational department responsible for this emergency response plan (e.g., \'Venue Security Operations\', \'Event Safety and Compliance\', \'Facilities Management\').' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planOwnerName rdf:type rdf:Property ;
    rdfs:label 'Plan Owner Name' ;
    rdfs:comment 'Full name of the Sports Entertainment staff member accountable for maintaining, updating, and submitting this emergency response plan. Confidential internal personnel data.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryTriageZoneLocation rdf:type rdf:Property ;
    rdfs:label 'Primary Triage Zone Location' ;
    rdfs:comment 'Physical location description of the primary medical triage zone within the venue (e.g., \'Gate A Concourse Level 1\', \'Field Level South End Zone\'). Used by EMS and medical staff during MCI activation.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicAddressCode rdf:type rdf:Property ;
    rdfs:label 'Public Address Code' ;
    rdfs:comment 'Standardized code word or phrase used in venue public address announcements to signal activation of this plan without causing public panic (e.g., \'Code Alpha\' for medical emergency, \'Code Bravo\' for security threat).' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Regulatory Jurisdiction' ;
    rdfs:comment 'Geographic and regulatory jurisdiction governing this plan (e.g., \'Clark County, Nevada\', \'City of New York, NY\', \'Federal – DHS Tier 1\'). Determines which regulatory bodies must approve the plan.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searTier rdf:type rdf:Property ;
    rdfs:label 'Sear Tier' ;
    rdfs:comment 'DHS Special Event Assessment Rating tier assigned to events covered by this plan. Tier 1 represents the highest national significance (e.g., Super Bowl, Olympics); Tier 3 represents significant regional events. Determines federal resource allocation and coordination requirements.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shelterInPlaceZone rdf:type rdf:Property ;
    rdfs:label 'Shelter In Place Zone' ;
    rdfs:comment 'Designated venue area(s) for shelter-in-place protocols, applicable for severe weather, active threat, or hazmat scenarios. Includes interior hardened areas, concourse corridors, and below-grade spaces.' ;
    rdfs:domain ind:EmergencyResponsePlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threatLevel rdf:type rdf:Property ;
    rdfs:label 'Threat Level' ;
    rdfs:comment 'Severity classification of the emergency scenario addressed by this plan, aligned with DHS threat level taxonomy. Drives resource pre-positioning, law enforcement notification thresholds, and public communication protocols.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementDeploymentId rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Deployment Id' ;
    rdfs:comment 'Unique surrogate identifier for each law enforcement deployment record within the Sports Entertainment security domain. Primary key for this transactional entity. Role: TRANSACTION_HEADER.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualCostUsd rdf:type rdf:Property ;
    rdfs:label 'Actual Cost Usd' ;
    rdfs:comment 'Actual invoiced or billed cost in US Dollars for this law enforcement deployment following event completion. Reconciled against estimated_cost_usd for financial reporting and mutual aid cost recovery.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agencyName rdf:type rdf:Property ;
    rdfs:label 'Agency Name' ;
    rdfs:comment 'Full official name of the law enforcement agency or private security contractor deployed (e.g., \'Los Angeles Police Department\', \'Federal Bureau of Investigation\', \'Allied Universal Security\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyType rdf:type rdf:Property ;
    rdfs:label 'Agency Type' ;
    rdfs:comment 'Classification of the deploying agency by jurisdictional level and organizational type. Drives mutual aid agreement requirements and command hierarchy protocols.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:armedOfficersCount rdf:type rdf:Property ;
    rdfs:label 'Armed Officers Count' ;
    rdfs:comment 'Number of armed officers within this deployment. Supports weapons accountability, insurance reporting, and compliance with venue firearms policies and local ordinances.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:arrestsMadeCount rdf:type rdf:Property ;
    rdfs:label 'Arrests Made Count' ;
    rdfs:comment 'Number of arrests made by law enforcement during this deployment. Required for league compliance reporting (NFL, NBA, FIFA), venue licensing, and public safety analytics.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commandLiaisonBadgeNumber rdf:type rdf:Property ;
    rdfs:label 'Command Liaison Badge Number' ;
    rdfs:comment 'Official badge or identification number of the command liaison officer. Used for identity verification, official documentation, and post-event debrief records.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commandLiaisonName rdf:type rdf:Property ;
    rdfs:label 'Command Liaison Name' ;
    rdfs:comment 'Full name of the senior law enforcement officer or agency representative serving as the primary command liaison for this deployment. Used for inter-agency coordination and incident escalation.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commandLiaisonPhone rdf:type rdf:Property ;
    rdfs:label 'Command Liaison Phone' ;
    rdfs:comment 'Direct contact phone number for the command liaison officer during the event. Critical for real-time incident coordination and emergency escalation.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debriefCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Debrief Completed Flag' ;
    rdfs:comment 'Indicates whether the post-event debrief session with the law enforcement agency has been completed. Drives workflow completion and compliance closure in the security operations process.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:debriefDate rdf:type rdf:Property ;
    rdfs:label 'Debrief Date' ;
    rdfs:comment 'Date on which the post-event debrief session was conducted with the law enforcement agency command liaison. Required for after-action reporting and continuous improvement of security protocols.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:debriefNotes rdf:type rdf:Property ;
    rdfs:label 'Debrief Notes' ;
    rdfs:comment 'Narrative notes captured during the post-event debrief session documenting observations, incidents, lessons learned, and recommendations for future deployments. Supports continuous improvement of security operations.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deploymentEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Deployment End Timestamp' ;
    rdfs:comment 'The actual date and time when the law enforcement unit concluded deployment and was released from the event. Used for billing reconciliation, mutual aid cost recovery, and post-event debrief scheduling.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:deploymentNumber rdf:type rdf:Property ;
    rdfs:label 'Deployment Number' ;
    rdfs:comment 'Externally-known business identifier for the deployment, used in mutual aid agreements, post-event debrief reports, and inter-agency communications. Format: LED-{YYYY}-{NNNNNN}.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deploymentStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Deployment Start Timestamp' ;
    rdfs:comment 'The actual date and time when the law enforcement unit commenced deployment at the venue or event perimeter. Principal real-world business event timestamp per TRANSACTION_HEADER role.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:deploymentType rdf:type rdf:Property ;
    rdfs:label 'Deployment Type' ;
    rdfs:comment 'Operational classification of the deployment describing the tactical role and positioning of the law enforcement unit. [ENUM-REF-CANDIDATE: perimeter|inside_venue|mounted|k9|plainclothes|aerial|water_patrol — promote to reference product if additional types are added]' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deploymentZoneAssignment rdf:type rdf:Property ;
    rdfs:label 'Deployment Zone Assignment' ;
    rdfs:comment 'Description of the specific venue zone(s), perimeter sectors, or operational areas assigned to this deployment unit. Complements the access_zone reference for multi-zone or perimeter deployments not mapped to a single zone.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ejectionsCount rdf:type rdf:Property ;
    rdfs:label 'Ejections Count' ;
    rdfs:comment 'Number of fan or attendee ejections from the venue facilitated by law enforcement during this deployment. Supports crowd management analytics and league compliance reporting.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:federalAgencyCode rdf:type rdf:Property ;
    rdfs:label 'Federal Agency Code' ;
    rdfs:comment 'Standardized code identifying the specific federal agency when agency_type is \'federal_agency\'. Null or N/A for non-federal deployments. Supports federal coordination and reporting obligations. [ENUM-REF-CANDIDATE: FBI|DHS|SECRET_SERVICE|ATF|DEA|TSA|USMS|OTHER|N/A — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentCommandPostLocation rdf:type rdf:Property ;
    rdfs:label 'Incident Command Post Location' ;
    rdfs:comment 'Physical location description of the Incident Command Post (ICP) established for this deployment within or adjacent to the venue. Used for emergency response coordination and post-event documentation.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentsReportedCount rdf:type rdf:Property ;
    rdfs:label 'Incidents Reported Count' ;
    rdfs:comment 'Number of security incidents formally reported by the law enforcement unit during this deployment. Used for post-event analysis, insurance reporting, and league compliance reporting.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:k9UnitFlag rdf:type rdf:Property ;
    rdfs:label 'K9 Unit Flag' ;
    rdfs:comment 'Indicates whether this deployment includes a K9 (canine) unit for explosive detection, crowd control, or narcotics screening. Drives specific venue access and handler coordination requirements.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalAssistsCount rdf:type rdf:Property ;
    rdfs:label 'Medical Assists Count' ;
    rdfs:comment 'Number of medical assistance events where law enforcement provided first response support during this deployment. Supports OSHA compliance reporting and venue safety analytics.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mountedUnitFlag rdf:type rdf:Property ;
    rdfs:label 'Mounted Unit Flag' ;
    rdfs:comment 'Indicates whether this deployment includes a mounted (equestrian) unit for crowd management and perimeter control. Drives specific venue access, staging area, and animal welfare coordination requirements.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:officerCountActual rdf:type rdf:Property ;
    rdfs:label 'Officer Count Actual' ;
    rdfs:comment 'Actual number of law enforcement officers or security personnel who reported for and executed this deployment. Used for billing, compliance verification, and post-event debrief analysis.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:officerCountPlanned rdf:type rdf:Property ;
    rdfs:label 'Officer Count Planned' ;
    rdfs:comment 'Number of law enforcement officers or security personnel originally planned for this deployment as specified in the security operations plan or mutual aid agreement.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overtimeAuthorizedFlag rdf:type rdf:Property ;
    rdfs:label 'Overtime Authorized Flag' ;
    rdfs:comment 'Indicates whether overtime hours have been pre-authorized for this deployment. Drives cost accrual in SAP S/4HANA FI/CO and mutual aid cost recovery calculations.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:radioChannelAssignment rdf:type rdf:Property ;
    rdfs:label 'Radio Channel Assignment' ;
    rdfs:comment 'Designated radio frequency channel or talkgroup assigned to this law enforcement deployment for inter-agency communications during the event. Critical for incident command coordination.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searRating rdf:type rdf:Property ;
    rdfs:label 'Sear Rating' ;
    rdfs:comment 'DHS Special Event Assessment Rating assigned to the event, determining the level of federal law enforcement coordination and resource deployment required. SEAR-1 is the highest federal interest; SEAR-5 is local-only.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehiclesAssignedCount rdf:type rdf:Property ;
    rdfs:label 'Vehicles Assigned Count' ;
    rdfs:comment 'Number of law enforcement vehicles (patrol cars, motorcycles, command vehicles) assigned to this deployment. Used for venue parking allocation, staging logistics, and cost reconciliation.' ;
    rdfs:domain ind:LawEnforcementDeployment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:previousSnapshotOccupancySnapshotId rdf:type rdf:Property ;
    rdfs:label 'Previous Snapshot Occupancy Snapshot Id' ;
    rdfs:comment 'Reference to the immediately preceding occupancy snapshot record for the same event and zone. Enables delta calculation of occupancy changes between intervals without requiring a self-join on sequence number.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OccupancySnapshot .

ind:adaAccessibleZone rdf:type rdf:Property ;
    rdfs:label 'Ada Accessible Zone' ;
    rdfs:comment 'Indicates whether this zone is designated as ADA (Americans with Disabilities Act) accessible, with compliant pathways, seating, and egress routes. Relevant for emergency evacuation planning and accessibility compliance reporting.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alertSeverity rdf:type rdf:Property ;
    rdfs:label 'Alert Severity' ;
    rdfs:comment 'Categorical severity classification of the capacity alert for this snapshot. none = below threshold; advisory = approaching threshold; warning = at threshold; critical = at or exceeding maximum capacity. Informs escalation protocols for security and emergency response teams.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Alert Threshold Pct' ;
    rdfs:comment 'The occupancy percentage at which the capacity_alert_flag is set to True for this zone. Configurable per zone and event type to reflect different risk tolerances (e.g., 85% for GA floor, 95% for seated sections).' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availableCapacity rdf:type rdf:Property ;
    rdfs:label 'Available Capacity' ;
    rdfs:comment 'The remaining number of persons that can be admitted to the zone before reaching maximum capacity (max_capacity minus current_occupancy_count). Used by gate staff and security supervisors for real-time admission control decisions.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capacityAlertFlag rdf:type rdf:Property ;
    rdfs:label 'Capacity Alert Flag' ;
    rdfs:comment 'Indicates whether this snapshot has triggered a capacity threshold alert (True) because occupancy is approaching or exceeding the defined alert threshold percentage. Drives real-time notifications to security operations and venue management.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:credentialedStaffCount rdf:type rdf:Property ;
    rdfs:label 'Credentialed Staff Count' ;
    rdfs:comment 'The number of credentialed staff (security personnel, event staff, medical, law enforcement) present within the zone at the time of the snapshot. Used to calculate staff-to-patron ratios for crowd management compliance and post-event safety reporting.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crowdDensityCategory rdf:type rdf:Property ;
    rdfs:label 'Crowd Density Category' ;
    rdfs:comment 'Qualitative classification of crowd density in the zone based on occupancy percentage thresholds. low (<50%), moderate (50–74%), high (75–84%), very_high (85–94%), critical (95%+). Used by security operations for rapid situational awareness without requiring numeric interpretation.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentOccupancyCount rdf:type rdf:Property ;
    rdfs:label 'Current Occupancy Count' ;
    rdfs:comment 'The number of persons physically present within the access zone at the time of the snapshot. Derived from gate scan aggregation, manual count, or sensor feed as indicated by the data_source field.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:egressCount rdf:type rdf:Property ;
    rdfs:label 'Egress Count' ;
    rdfs:comment 'The number of persons who exited the access zone since the previous snapshot interval. Sourced from gate scan aggregation or sensor directional flow data. Critical for monitoring evacuation progress during emergency response scenarios.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gateScanCount rdf:type rdf:Property ;
    rdfs:label 'Gate Scan Count' ;
    rdfs:comment 'The number of valid ticket scans recorded at access gates for this zone since the previous snapshot interval. Sourced directly from Ticketmaster/AXS access control systems. Used to cross-validate sensor-based occupancy readings.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ingressCount rdf:type rdf:Property ;
    rdfs:label 'Ingress Count' ;
    rdfs:comment 'The number of persons who entered the access zone since the previous snapshot interval. Sourced from gate scan aggregation (Ticketmaster/AXS) or sensor directional flow data. Supports ingress rate monitoring during peak entry periods.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lawEnforcementPresent rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Present' ;
    rdfs:comment 'Indicates whether sworn law enforcement officers (police, sheriff, federal agents) are physically deployed in or immediately adjacent to this zone at the time of the snapshot. Relevant for incident response coordination and post-event security reporting.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:manualOverride rdf:type rdf:Property ;
    rdfs:label 'Manual Override' ;
    rdfs:comment 'Indicates whether the occupancy count in this snapshot was manually entered or adjusted by a security supervisor, overriding the automated system reading. When True, manual_override_reason should be populated.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:manualOverrideReason rdf:type rdf:Property ;
    rdfs:label 'Manual Override Reason' ;
    rdfs:comment 'Free-text explanation provided by the security supervisor when manual_override is True. Documents the justification for overriding automated occupancy data (e.g., \'sensor malfunction in north corridor\', \'gate scanner offline\'). Required for audit trail compliance.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxCapacity rdf:type rdf:Property ;
    rdfs:label 'Max Capacity' ;
    rdfs:comment 'The licensed or operationally approved maximum number of persons permitted in the access zone simultaneously. Established by venue fire code, local authority, and ADA compliance requirements. Sourced from Archtics venue inventory.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occupancyPct rdf:type rdf:Property ;
    rdfs:label 'Occupancy Pct' ;
    rdfs:comment 'The ratio of current occupancy count to maximum zone capacity expressed as a percentage (0.00–100.00+). Used to trigger crowd density alerts and inform real-time security deployment decisions.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:occupancyTrend rdf:type rdf:Property ;
    rdfs:label 'Occupancy Trend' ;
    rdfs:comment 'Directional trend of occupancy compared to the previous snapshot for this zone: increasing (net ingress), stable (minimal change within ±2%), or decreasing (net egress). Provides rapid situational awareness for security supervisors without requiring numeric comparison.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sensorDeviceCode rdf:type rdf:Property ;
    rdfs:label 'Sensor Device Code' ;
    rdfs:comment 'The unique identifier of the IoT sensor, gate scanner, or counting device that provided the primary occupancy reading for this snapshot. Enables device-level data quality auditing and fault isolation when readings are anomalous.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snapshotIntervalSeconds rdf:type rdf:Property ;
    rdfs:label 'Snapshot Interval Seconds' ;
    rdfs:comment 'The configured polling interval in seconds between successive occupancy snapshots for this zone during the event. Typical values: 30, 60, 120, 300. Shorter intervals are used during high-risk periods such as event ingress and egress.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:snapshotSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Snapshot Sequence Number' ;
    rdfs:comment 'Sequential ordinal number of this snapshot within the event and zone combination, starting at 1. Enables ordered time-series reconstruction of occupancy trends for a specific zone throughout the event lifecycle.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveillanceActive rdf:type rdf:Property ;
    rdfs:label 'Surveillance Active' ;
    rdfs:comment 'Indicates whether CCTV or other surveillance systems are actively monitoring this zone at the time of the snapshot. A False value may indicate a system outage requiring manual security coverage escalation.' ;
    rdfs:domain ind:OccupancySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Post Assignment Id' ;
    rdfs:comment 'Unique system-generated identifier for each security post assignment record. Primary key for the post_assignment data product.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postId rdf:type rdf:Property ;
    rdfs:label 'Post Id' ;
    rdfs:comment 'Reference to the specific security post (physical location or zone) to which the officer is assigned. Links to the security post master record.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Post .

ind:primaryPostEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Post Employee Id' ;
    rdfs:comment 'Reference to the security personnel (workforce member) assigned to this post. Sourced from SAP SuccessFactors Human Capital Management workforce records.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:reliefOfficerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Relief Officer Employee Id' ;
    rdfs:comment 'Reference to the secondary security officer designated to relieve the primary assigned officer during the shift. Nullable when no relief is scheduled.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:tertiaryPostSupervisorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Post Supervisor Employee Id' ;
    rdfs:comment 'Reference to the security supervisor responsible for overseeing this post assignment. Used for escalation routing and post-event accountability reporting.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Actual Duration Minutes' ;
    rdfs:comment 'Actual number of minutes the officer was on post, calculated from confirmed check-in and check-out times. Used for payroll reconciliation and SLA compliance verification.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adaPost rdf:type rdf:Property ;
    rdfs:label 'Ada Post' ;
    rdfs:comment 'Indicates whether this post assignment is designated to support Americans with Disabilities Act (ADA) accessibility compliance, including assisting guests with disabilities in accessible seating or entry zones.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignmentSource rdf:type rdf:Property ;
    rdfs:label 'Assignment Source' ;
    rdfs:comment 'Indicates how the post assignment was created or modified. \'manual\' = entered by scheduling staff; \'automated\' = generated by workforce management system; \'supervisor_override\' = changed by on-site supervisor; \'emergency_redeployment\' = reassigned due to incident.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentType rdf:type rdf:Property ;
    rdfs:label 'Assignment Type' ;
    rdfs:comment 'Classification of the post assignment by operational function. Drives briefing requirements, equipment allocation, and staffing tier. [ENUM-REF-CANDIDATE: standard|vip|perimeter|access_control|crowd_management|emergency_response|surveillance|law_enforcement_liaison — promote to reference product]' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:briefingAcknowledged rdf:type rdf:Property ;
    rdfs:label 'Briefing Acknowledged' ;
    rdfs:comment 'Indicates whether the assigned officer has formally acknowledged receipt and understanding of the post briefing notes. True = acknowledged; False = not yet acknowledged. Required for compliance audit trails.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:briefingAcknowledgedTime rdf:type rdf:Property ;
    rdfs:label 'Briefing Acknowledged Time' ;
    rdfs:comment 'Date and time the assigned officer formally acknowledged the post briefing. Null if briefing has not yet been acknowledged. Supports compliance and incident investigation audit trails.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:briefingNotes rdf:type rdf:Property ;
    rdfs:label 'Briefing Notes' ;
    rdfs:comment 'Free-text field capturing post-specific operational instructions, threat advisories, VIP movement schedules, crowd management directives, or special protocols communicated to the officer prior to the shift.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkInConfirmed rdf:type rdf:Property ;
    rdfs:label 'Check In Confirmed' ;
    rdfs:comment 'Indicates whether the officer\'s check-in at the post has been formally confirmed by a supervisor or access control system. True = confirmed; False = not yet confirmed or disputed.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:checkInTime rdf:type rdf:Property ;
    rdfs:label 'Check In Time' ;
    rdfs:comment 'Actual date and time the assigned security officer confirmed their presence at the post. Captured via access control system or supervisor confirmation. Null if officer has not yet checked in.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:checkOutConfirmed rdf:type rdf:Property ;
    rdfs:label 'Check Out Confirmed' ;
    rdfs:comment 'Indicates whether the officer\'s check-out from the post has been formally confirmed by a supervisor or access control system. True = confirmed; False = not yet confirmed or disputed.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:checkOutTime rdf:type rdf:Property ;
    rdfs:label 'Check Out Time' ;
    rdfs:comment 'Actual date and time the assigned security officer departed or was relieved from the post. Null if officer has not yet checked out. Used for post-event staffing reconciliation.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:credentialLevel rdf:type rdf:Property ;
    rdfs:label 'Credential Level' ;
    rdfs:comment 'Required credential or clearance level for the assigned post, indicating the minimum qualification tier the officer must hold. Ensures regulatory and venue compliance for sensitive access zones.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialVerified rdf:type rdf:Property ;
    rdfs:label 'Credential Verified' ;
    rdfs:comment 'Indicates whether the assigned officer\'s credentials have been verified as meeting the required credential level for this post prior to shift commencement. True = verified; False = pending or failed.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crowdDensityZone rdf:type rdf:Property ;
    rdfs:label 'Crowd Density Zone' ;
    rdfs:comment 'Expected crowd density classification for the post location at the time of assignment. Used to calibrate staffing ratios and crowd management protocols per venue safety plans.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyResponseRole rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Role' ;
    rdfs:comment 'Designated emergency response role for the officer at this post during a critical incident or evacuation. \'none\' = standard post with no special emergency designation.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentIssued rdf:type rdf:Property ;
    rdfs:label 'Equipment Issued' ;
    rdfs:comment 'Comma-separated list or description of security equipment issued to the officer for this post assignment (e.g., radio, wand, body camera, access card). Supports equipment accountability and post-event inventory reconciliation.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentReported rdf:type rdf:Property ;
    rdfs:label 'Incident Reported' ;
    rdfs:comment 'Indicates whether a security incident was reported by the officer at this post during the assigned shift. True = at least one incident report filed. Enables rapid post-event incident aggregation.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lawEnforcementCoordinated rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Coordinated' ;
    rdfs:comment 'Indicates whether this post assignment involves coordination with external law enforcement agencies (e.g., local police, federal agents). True = law enforcement coordination required or active.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overtimeFlag rdf:type rdf:Property ;
    rdfs:label 'Overtime Flag' ;
    rdfs:comment 'Indicates whether this post assignment constitutes overtime hours for the assigned officer based on applicable labor agreements or Collective Bargaining Agreement (CBA) thresholds. True = overtime applies.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payRateCode rdf:type rdf:Property ;
    rdfs:label 'Pay Rate Code' ;
    rdfs:comment 'Code referencing the applicable pay rate tier for this post assignment, used for payroll processing in SAP S/4HANA. Confidential as it relates to compensation structure.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postCoverageGapMinutes rdf:type rdf:Property ;
    rdfs:label 'Post Coverage Gap Minutes' ;
    rdfs:comment 'Number of minutes the post was uncovered due to late check-in, early check-out, no-show, or relief delay. A value of 0 indicates continuous coverage. Critical KPI for post-event security audit.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:radioChannel rdf:type rdf:Property ;
    rdfs:label 'Radio Channel' ;
    rdfs:comment 'Designated radio channel or frequency assigned to this post for inter-team communications during the event. Critical for emergency response coordination and crowd management.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reliefStartTime rdf:type rdf:Property ;
    rdfs:label 'Relief Start Time' ;
    rdfs:comment 'Scheduled or actual time the relief officer takes over coverage of the post from the primary assigned officer. Null if no relief is scheduled.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:shiftDate rdf:type rdf:Property ;
    rdfs:label 'Shift Date' ;
    rdfs:comment 'Calendar date of the security shift. Used for day-level scheduling, reporting, and reconciliation independent of precise timestamps.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:shiftDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Shift Duration Minutes' ;
    rdfs:comment 'Planned duration of the security shift in minutes, derived from scheduled start and end times. Used for payroll calculation inputs and staffing hour reporting.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shiftEndTime rdf:type rdf:Property ;
    rdfs:label 'Shift End Time' ;
    rdfs:comment 'Scheduled date and time the security officer is expected to conclude coverage at the assigned post. Used for shift planning and staffing reconciliation.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:shiftStartTime rdf:type rdf:Property ;
    rdfs:label 'Shift Start Time' ;
    rdfs:comment 'Scheduled date and time the security officer is expected to begin coverage at the assigned post. Used for shift planning and real-time post coverage visibility.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:vipPost rdf:type rdf:Property ;
    rdfs:label 'Vip Post' ;
    rdfs:comment 'Indicates whether this post assignment is designated as a Very Important Person (VIP) security post, requiring enhanced protocols, elevated credential levels, and heightened situational awareness.' ;
    rdfs:domain ind:PostAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adaConsiderationNotes rdf:type rdf:Property ;
    rdfs:label 'Ada Consideration Notes' ;
    rdfs:comment 'Notes documenting any ADA accommodation exceptions or special handling procedures for this prohibited item category (e.g., medical devices, mobility aids, prescribed medications that may resemble prohibited items). Ensures compliance with ADA accessibility requirements.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableEventTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Event Types' ;
    rdfs:comment 'Comma-separated list of event type codes for which this prohibition is enforced (e.g., NFL_GAME, NBA_GAME, CONCERT, PPV_EVENT, CHAMPIONSHIP). Supports event-specific restriction configuration distinct from venue-level rules.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableVenueTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Venue Types' ;
    rdfs:comment 'Comma-separated list of venue type codes to which this prohibition applies (e.g., STADIUM, ARENA, AMPHITHEATER, CONCERT_HALL, OUTDOOR_FESTIVAL). Enables venue-specific policy enforcement and checkpoint configuration. [ENUM-REF-CANDIDATE: stadium|arena|amphitheater|concert_hall|outdoor_festival|training_facility|broadcast_studio|all — promote to reference product]' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastInterferenceFlag rdf:type rdf:Property ;
    rdfs:label 'Broadcast Interference Flag' ;
    rdfs:comment 'Indicates whether this item poses a risk of interfering with broadcast operations, OB (Outside Broadcast) equipment, or IPTV/CDN signal distribution (e.g., laser pointers, unauthorized RF transmitters, drones). Supports coordination with broadcast production teams.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:confiscationAction rdf:type rdf:Property ;
    rdfs:label 'Confiscation Action' ;
    rdfs:comment 'Standardized action code indicating the disposition of the prohibited item upon confiscation. Used to drive automated workflow routing in screening event records and incident management systems.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confiscationProtocol rdf:type rdf:Property ;
    rdfs:label 'Confiscation Protocol' ;
    rdfs:comment 'Standardized procedure code or narrative describing the required officer action upon detection of this prohibited item at a screening checkpoint (e.g., voluntary surrender at gate, law enforcement handoff, secure storage for retrieval, destruction). Drives officer training and incident documentation.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialOfEntryRequired rdf:type rdf:Property ;
    rdfs:label 'Denial Of Entry Required' ;
    rdfs:comment 'Indicates whether possession of this item at a screening checkpoint mandates denial of venue entry to the bearer, even if the item is surrendered. Applies to items posing ongoing safety risk.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exemptionCredentialTypes rdf:type rdf:Property ;
    rdfs:label 'Exemption Credential Types' ;
    rdfs:comment 'Comma-separated list of credential types that may be granted an exemption from this prohibition (e.g., LAW_ENFORCEMENT, MEDICAL_STAFF, BROADCAST_CREW, VIP_CREDENTIAL). Supports conditional enforcement logic at access checkpoints.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fanCommunicationText rdf:type rdf:Property ;
    rdfs:label 'Fan Communication Text' ;
    rdfs:comment 'Public-facing text used in fan communications, ticketing platforms (Ticketmaster/AXS), venue signage, and digital channels to inform attendees of this prohibition. Supports consistent messaging across Adobe Experience Platform and DTC fan engagement channels.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentReportRequired rdf:type rdf:Property ;
    rdfs:label 'Incident Report Required' ;
    rdfs:comment 'Indicates whether every detection of this prohibited item must generate a formal incident report regardless of confiscation outcome. Supports compliance audit trails and regulatory reporting.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ipRightsRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Ip Rights Risk Flag' ;
    rdfs:comment 'Indicates whether this item poses a risk to intellectual property (IP) or digital rights management (DRM) protections, such as unauthorized recording devices, professional camera equipment, or streaming devices that could enable unauthorized content distribution.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itemSubcategory rdf:type rdf:Property ;
    rdfs:label 'Item Subcategory' ;
    rdfs:comment 'Secondary classification providing finer granularity within the item category (e.g., within Weapons: Firearms, Edged Weapons, Blunt Instruments, Projectile Devices; within Containers: Glass Bottles, Metal Cans, Hard-Sided Coolers). Supports tiered enforcement protocols.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Notification Required' ;
    rdfs:comment 'Indicates whether detection of this prohibited item mandates immediate notification of on-site law enforcement personnel. True for weapons, explosives, and other items posing imminent public safety risk.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prohibitionBasis rdf:type rdf:Property ;
    rdfs:label 'Prohibition Basis' ;
    rdfs:comment 'The regulatory, legal, or policy authority that mandates or authorizes the prohibition of this item (e.g., DHS Venue Security Guidelines, NFL Security Policy, Local Ordinance, State Law, WADA, FCC Regulation). Supports compliance documentation and legal defensibility. [ENUM-REF-CANDIDATE: dhs_venue_security|league_policy|local_ordinance|state_law|federal_law|wada|fcc|osha|ada|iso_20121|internal_policy — promote to reference product]' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prohibitionType rdf:type rdf:Property ;
    rdfs:label 'Prohibition Type' ;
    rdfs:comment 'Indicates whether the item is absolutely prohibited at all times (absolute), prohibited only under specific conditions such as size or quantity thresholds (conditional), or restricted only for designated event types such as PPV or championship events (event_specific). Drives checkpoint officer decision logic.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Receipt Required Flag' ;
    rdfs:comment 'Indicates whether a confiscation receipt must be issued to the bearer when this item is surrendered or seized at a screening checkpoint. Supports chain-of-custody documentation and legal defensibility.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sizeThresholdDescription rdf:type rdf:Property ;
    rdfs:label 'Size Threshold Description' ;
    rdfs:comment 'Narrative description of any size, dimension, or capacity threshold that triggers the prohibition for conditional items (e.g., \'Bags exceeding 12x6x12 inches\', \'Containers larger than 1 liter\', \'Camera lenses longer than 6 inches\'). Applicable when prohibition_type is conditional.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcePolicyDocument rdf:type rdf:Property ;
    rdfs:label 'Source Policy Document' ;
    rdfs:comment 'Reference to the source security policy document, version, and section from which this prohibited item definition was derived (e.g., \'Sports Entertainment Venue Security Policy v4.2, Section 3.1\'). Supports traceability and policy version management.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Storage Available Flag' ;
    rdfs:comment 'Indicates whether the venue offers secure storage or check-in facilities where fans may voluntarily surrender and retrieve this item rather than being denied entry. Supports fan experience and ADA accommodation considerations.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supersededByItemCode rdf:type rdf:Property ;
    rdfs:label 'Superseded By Item Code' ;
    rdfs:comment 'The item_code of the newer prohibited item record that replaces this record when policy_status is \'superseded\'. Enables forward navigation in the policy version chain for compliance audit purposes.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wadaRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Wada Related Flag' ;
    rdfs:comment 'Indicates whether this prohibited item is related to performance-enhancing drug (PED) paraphernalia or substances governed by WADA regulations. Relevant for events under IOC, FIFA, or other WADA-signatory governing bodies.' ;
    rdfs:domain ind:ProhibitedItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surveillanceCameraId rdf:type rdf:Property ;
    rdfs:label 'Surveillance Camera Id' ;
    rdfs:comment 'Identifier of the primary CCTV surveillance camera covering this checkpoint, as registered in the venue\'s video management system. Enables rapid retrieval of footage for incident investigation and compliance audits.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SurveillanceCamera .

ind:activationEndTime rdf:type rdf:Property ;
    rdfs:label 'Activation End Time' ;
    rdfs:comment 'Standard time of day (HH:MM, 24-hour format) at which this checkpoint ceases screening operations and is deactivated. Used for egress planning and post-event security stand-down scheduling.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:activationScheduleType rdf:type rdf:Property ;
    rdfs:label 'Activation Schedule Type' ;
    rdfs:comment 'Defines the operational activation pattern for this checkpoint — whether it is staffed only on event days, permanently active, activated seasonally, or deployed on-demand for high-security events. Drives resource planning and cost allocation.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activationStartTime rdf:type rdf:Property ;
    rdfs:label 'Activation Start Time' ;
    rdfs:comment 'Standard time of day (HH:MM, 24-hour format) at which this checkpoint is activated and begins screening operations relative to event start. Used for gate opening schedules and ingress management planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:adaLaneCount rdf:type rdf:Property ;
    rdfs:label 'Ada Lane Count' ;
    rdfs:comment 'Number of ADA (Americans with Disabilities Act) compliant accessible screening lanes available at this checkpoint. Distinct from the total lane count — used for ADA compliance reporting and accessibility planning.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:checkpointCode rdf:type rdf:Property ;
    rdfs:label 'Checkpoint Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the screening checkpoint, used in operational communications, staffing assignments, and incident reporting (e.g., \'GATE-A-MAG-01\', \'VIP-BAG-03\'). Unique within a venue.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkpointStatus rdf:type rdf:Property ;
    rdfs:label 'Checkpoint Status' ;
    rdfs:comment 'Current operational lifecycle status of the screening checkpoint. Drives activation scheduling, staffing allocation, and security coverage gap analysis.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkpointType rdf:type rdf:Property ;
    rdfs:label 'Checkpoint Type' ;
    rdfs:comment 'Classification of the physical security screening checkpoint by its primary function and method of screening. Drives staffing requirements, equipment deployment, and throughput planning. [ENUM-REF-CANDIDATE: magnetometer_lane|bag_check_station|pat_down_area|vehicle_inspection|credentialing_desk|explosive_trace_detection — promote to reference product if additional types are added]' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialTypeAccepted rdf:type rdf:Property ;
    rdfs:label 'Credential Type Accepted' ;
    rdfs:comment 'Type(s) of credentials or access passes accepted at this checkpoint for entry authorization (e.g., \'event_ticket\', \'media_credential\', \'staff_badge\', \'law_enforcement_id\'). Drives access control configuration in Ticketmaster/AXS. [ENUM-REF-CANDIDATE: event_ticket|media_credential|staff_badge|law_enforcement_id|vip_pass|vendor_pass|athlete_credential — promote to reference product]' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyResponseZone rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Zone' ;
    rdfs:comment 'Designated emergency response zone code to which this checkpoint belongs for incident command and evacuation coordination. Aligns with the venue emergency response plan and law enforcement sector assignments.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentAssetTag rdf:type rdf:Property ;
    rdfs:label 'Equipment Asset Tag' ;
    rdfs:comment 'Physical asset tag or serial number of the primary screening equipment unit deployed at this checkpoint. Used for maintenance tracking, calibration scheduling, and asset lifecycle management in the facilities management system.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentLastCalibrationDate rdf:type rdf:Property ;
    rdfs:label 'Equipment Last Calibration Date' ;
    rdfs:comment 'Date on which the primary screening equipment at this checkpoint was most recently calibrated and certified for operational use. Required for regulatory compliance and safety audits.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:equipmentNextCalibrationDate rdf:type rdf:Property ;
    rdfs:label 'Equipment Next Calibration Date' ;
    rdfs:comment 'Scheduled date for the next mandatory calibration of the primary screening equipment at this checkpoint. Triggers maintenance work orders and ensures continuous compliance with security equipment standards.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventTypeApplicability rdf:type rdf:Property ;
    rdfs:label 'Event Type Applicability' ;
    rdfs:comment 'Specifies the category of events for which this checkpoint is activated (e.g., \'all_events\', \'sports_only\', \'concerts_only\', \'ppv_events\', \'high_profile_only\'). Supports dynamic checkpoint activation planning across the event calendar. [ENUM-REF-CANDIDATE: all_events|sports_only|concerts_only|ppv_events|high_profile_only|private_events — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floorLevel rdf:type rdf:Property ;
    rdfs:label 'Floor Level' ;
    rdfs:comment 'Floor or level designation within the venue where this checkpoint is located (e.g., \'Ground\', \'Level 1\', \'Concourse\', \'Basement\'). Used for emergency evacuation planning and facility management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAdaAccessible rdf:type rdf:Property ;
    rdfs:label 'Is Ada Accessible' ;
    rdfs:comment 'Indicates whether this screening checkpoint includes an ADA (Americans with Disabilities Act) compliant accessible lane for patrons with mobility impairments, wheelchairs, or other accessibility needs. Mandatory for venue ADA compliance reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isExpressLane rdf:type rdf:Property ;
    rdfs:label 'Is Express Lane' ;
    rdfs:comment 'Indicates whether this checkpoint operates as an expedited screening lane for credentialed personnel, season ticket holders, VIP (Very Important Person) guests, or pre-screened patrons with reduced wait times.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isVehicleCheckpoint rdf:type rdf:Property ;
    rdfs:label 'Is Vehicle Checkpoint' ;
    rdfs:comment 'Indicates whether this checkpoint is designated for vehicle inspection rather than pedestrian screening. Drives different equipment, staffing, and protocol requirements for parking lot and loading dock security.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laneCount rdf:type rdf:Property ;
    rdfs:label 'Lane Count' ;
    rdfs:comment 'Number of parallel screening lanes available at this checkpoint. A single checkpoint may have multiple lanes operating simultaneously to increase throughput capacity during peak ingress periods.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Inspection Date' ;
    rdfs:comment 'Date of the most recent formal safety and compliance inspection of this checkpoint by internal security management or an external regulatory authority. Supports OSHA compliance tracking and audit readiness.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lawEnforcementPost rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Post' ;
    rdfs:comment 'Indicates whether this checkpoint requires a dedicated law enforcement officer (LEO) post as part of the security deployment plan. Drives coordination with local police, sheriff, or federal law enforcement agencies.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxQueueLengthMeters rdf:type rdf:Property ;
    rdfs:label 'Max Queue Length Meters' ;
    rdfs:comment 'Maximum physical queue length in meters that can be accommodated at this checkpoint before crowd management protocols are triggered. Used for ingress modeling and crowd density safety planning.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minStaffRequired rdf:type rdf:Property ;
    rdfs:label 'Min Staff Required' ;
    rdfs:comment 'Minimum number of security personnel required to operate this checkpoint at baseline capacity. Used for staffing plans, shift scheduling, and SLA (Service Level Agreement) compliance with law enforcement partners.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operatingSopReference rdf:type rdf:Property ;
    rdfs:label 'Operating Sop Reference' ;
    rdfs:comment 'Document reference number or URL for the Standard Operating Procedure (SOP) governing operations at this checkpoint type. Ensures staff follow approved protocols and supports compliance audits.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optimalStaffCount rdf:type rdf:Property ;
    rdfs:label 'Optimal Staff Count' ;
    rdfs:comment 'Recommended number of security personnel for this checkpoint to achieve rated throughput capacity. Distinct from minimum staffing — represents the target headcount for peak event operations.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:physicalLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Physical Location Description' ;
    rdfs:comment 'Narrative description of the precise physical location of this checkpoint within the venue (e.g., \'North concourse, adjacent to Section 101 entrance, ground level\'). Supports emergency response coordination and incident reporting.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryEquipmentType rdf:type rdf:Property ;
    rdfs:label 'Primary Equipment Type' ;
    rdfs:comment 'Primary security screening equipment deployed at this checkpoint. WTMD (Walk-Through Metal Detector), X-ray (baggage X-ray scanner), ETD (Explosive Trace Detection). Drives maintenance scheduling, calibration records, and procurement planning. [ENUM-REF-CANDIDATE: WTMD|X-ray|ETD|handheld_wand|visual_inspection|CCTV|vehicle_barrier — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prohibitedItemsListVersion rdf:type rdf:Property ;
    rdfs:label 'Prohibited Items List Version' ;
    rdfs:comment 'Version identifier of the prohibited items policy document governing what items are screened and confiscated at this checkpoint (e.g., \'v2.3\'). Ensures staff are operating under the current approved policy and supports audit traceability.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryEquipmentType rdf:type rdf:Property ;
    rdfs:label 'Secondary Equipment Type' ;
    rdfs:comment 'Secondary or supplemental screening equipment deployed at this checkpoint in addition to the primary equipment (e.g., handheld wand alongside WTMD, ETD alongside X-ray). Nullable when only primary equipment is deployed.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:throughputCapacityPerHour rdf:type rdf:Property ;
    rdfs:label 'Throughput Capacity Per Hour' ;
    rdfs:comment 'Rated maximum number of persons that can be screened through this checkpoint per hour under normal operating conditions. Used for crowd management planning, staffing optimization, and event ingress modeling.' ;
    rdfs:domain ind:ScreeningCheckpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryScreeningEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Screening Employee Id' ;
    rdfs:comment 'Reference to the security officer or personnel who conducted or oversaw this screening interaction. Used for officer performance tracking and incident accountability.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:screenedPersonFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Screened Person Fan Profile Id' ;
    rdfs:comment 'Reference to the fan, staff member, or credentialed personnel who was screened. May be null for anonymous general admission screenings where identity is not captured.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:adaAccommodationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Ada Accommodation Required Flag' ;
    rdfs:comment 'Indicates whether the screened individual required an ADA accommodation during the screening process (e.g., wheelchair user, medical device wearer). Supports ADA compliance reporting and accessibility audit requirements.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alarmResolution rdf:type rdf:Property ;
    rdfs:label 'Alarm Resolution' ;
    rdfs:comment 'The resolution or explanation for an equipment alarm triggered during screening. Null when no alarm was triggered. Supports false-positive rate analysis and equipment calibration review.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confiscationReceiptNumber rdf:type rdf:Property ;
    rdfs:label 'Confiscation Receipt Number' ;
    rdfs:comment 'Reference number issued to the individual when a prohibited item is confiscated, enabling item retrieval after the event if applicable. Null when no item was confiscated. Supports chain-of-custody documentation.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryDeniedReason rdf:type rdf:Property ;
    rdfs:label 'Entry Denied Reason' ;
    rdfs:comment 'Free-text or coded reason why entry was denied to the screened individual. Null when entry was not denied. Supports denied-entry trend analysis and policy enforcement review.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentAlarmTriggeredFlag rdf:type rdf:Property ;
    rdfs:label 'Equipment Alarm Triggered Flag' ;
    rdfs:comment 'Indicates whether the screening equipment (e.g., magnetometer, X-ray) triggered an alarm during this interaction. Distinguishes equipment-initiated alerts from officer-initiated secondary screenings.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equipmentCode rdf:type rdf:Property ;
    rdfs:label 'Equipment Code' ;
    rdfs:comment 'Identifier of the specific screening equipment unit used (e.g., magnetometer unit serial number, X-ray machine ID). Supports equipment maintenance tracking, calibration compliance, and fault correlation analysis.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationType rdf:type rdf:Property ;
    rdfs:label 'Escalation Type' ;
    rdfs:comment 'The type of escalation triggered by this screening interaction. Null or \'none\' when no escalation occurred. Used to categorize escalation patterns and resource deployment analysis.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemConfiscatedFlag rdf:type rdf:Property ;
    rdfs:label 'Item Confiscated Flag' ;
    rdfs:comment 'Indicates whether the detected prohibited item was physically confiscated from the individual. Distinct from denied_entry outcome — an item may be confiscated while the individual is still permitted entry. Supports confiscation log and chain-of-custody tracking.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laneNumber rdf:type rdf:Property ;
    rdfs:label 'Lane Number' ;
    rdfs:comment 'The specific screening lane within a checkpoint where the interaction occurred. Multiple lanes may operate at a single gate or checkpoint. Used for lane-level throughput and staffing analysis.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prohibitedItemCategory rdf:type rdf:Property ;
    rdfs:label 'Prohibited Item Category' ;
    rdfs:comment 'High-level category of the prohibited item detected during screening. Null when no prohibited item was found. Supports trend analysis and policy review. [ENUM-REF-CANDIDATE: weapon_firearm|weapon_edged|weapon_blunt|explosive|controlled_substance|alcohol|oversized_bag|laser_device|other — promote to reference product]' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prohibitedItemFlag rdf:type rdf:Property ;
    rdfs:label 'Prohibited Item Flag' ;
    rdfs:comment 'Indicates whether a prohibited item was detected during this screening interaction. True when any prohibited item was found, regardless of whether it was confiscated or the individual was denied entry. Key driver for prohibited item trend analysis.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:queueWaitTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Queue Wait Time Seconds' ;
    rdfs:comment 'The estimated or measured time in seconds the individual waited in the queue before reaching the screening checkpoint. Supports fan experience analysis, crowd management planning, and SLA reporting for entry operations.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:screenedPersonType rdf:type rdf:Property ;
    rdfs:label 'Screened Person Type' ;
    rdfs:comment 'Classification of the individual being screened, distinguishing fans from credentialed personnel, VIP guests, media, athletes, and law enforcement. Supports segmented security analytics and credentialing compliance. [ENUM-REF-CANDIDATE: fan|staff|vendor|media|vip|athlete|law_enforcement — promote to reference product]' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Screening Duration Seconds' ;
    rdfs:comment 'The elapsed time in seconds from the start to the completion of the screening interaction. Used for checkpoint throughput analysis, staffing optimization, and identifying bottlenecks in the fan entry process.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:screeningMethod rdf:type rdf:Property ;
    rdfs:label 'Screening Method' ;
    rdfs:comment 'The physical or technological method used to conduct the screening. Supports equipment utilization analysis and compliance with venue security protocols. [ENUM-REF-CANDIDATE: walk_through_magnetometer|hand_wand|pat_down|bag_x_ray|visual_inspection|explosive_trace_detection — promote to reference product]' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningOutcome rdf:type rdf:Property ;
    rdfs:label 'Screening Outcome' ;
    rdfs:comment 'The result of the screening interaction indicating the disposition of the screened individual. Drives escalation workflows, prohibited item trend analysis, and checkpoint throughput reporting. [ENUM-REF-CANDIDATE: cleared|secondary_screening|denied_entry|prohibited_item_confiscated|medical_referral|law_enforcement_referral — promote to reference product]' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Screening Reference Number' ;
    rdfs:comment 'Externally-visible alphanumeric reference code assigned to this screening interaction, used for incident reporting, law enforcement coordination, and audit trail purposes. Format: SCR-{YEAR}-{EVENTID}-{SEQUENCE}.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningTimestamp rdf:type rdf:Property ;
    rdfs:label 'Screening Timestamp' ;
    rdfs:comment 'The precise date and time when the screening interaction occurred at the checkpoint. Principal business event timestamp used for throughput analysis, timeline reconstruction, and post-event security review.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:secondaryScreeningOutcome rdf:type rdf:Property ;
    rdfs:label 'Secondary Screening Outcome' ;
    rdfs:comment 'The final disposition of a secondary screening interaction when the initial screening outcome was \'secondary_screening\'. Null for interactions that did not require secondary screening. Completes the full screening lifecycle record.' ;
    rdfs:domain ind:ScreeningEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgmentSignOffStatus rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Sign Off Status' ;
    rdfs:comment 'Status of the formal acknowledgment sign-off process confirming that attendees received and understood the briefing. Partial indicates some but not all attendees have signed off.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adaProtocolBriefedFlag rdf:type rdf:Property ;
    rdfs:label 'Ada Protocol Briefed Flag' ;
    rdfs:comment 'Indicates whether Americans with Disabilities Act accommodation and evacuation assistance protocols were reviewed during the briefing. Required for ADA compliance at all venues.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:briefingStatus rdf:type rdf:Property ;
    rdfs:label 'Briefing Status' ;
    rdfs:comment 'Current lifecycle status of the security briefing record. Tracks whether the briefing has been scheduled, is underway, has been completed, or was cancelled/postponed.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:briefingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Briefing Timestamp' ;
    rdfs:comment 'The precise date and time at which the security briefing commenced. Principal real-world event timestamp for this transaction. Stored in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:briefingType rdf:type rdf:Property ;
    rdfs:label 'Briefing Type' ;
    rdfs:comment 'Classification of the briefing by operational purpose. Pre-event briefings are the primary type; shift-change and emergency types support ongoing event operations.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationChannelsBriefed rdf:type rdf:Property ;
    rdfs:label 'Communication Channels Briefed' ;
    rdfs:comment 'Description of radio channels, frequencies, and communication protocols (e.g., command net, tactical net) communicated to security staff during the briefing. Critical for inter-team coordination.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crowdManagementProtocol rdf:type rdf:Property ;
    rdfs:label 'Crowd Management Protocol' ;
    rdfs:comment 'Identifier or name of the crowd management protocol communicated during the briefing (e.g., \'Standard GA Protocol\', \'SRO High-Density Protocol\'). Aligns with venue capacity and event type.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
    rdfs:comment 'Method by which the security briefing was delivered to attendees. In-person is standard; virtual and hybrid methods may be used for remote staff or multi-site events.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalSignOffFlag rdf:type rdf:Property ;
    rdfs:label 'Digital Sign Off Flag' ;
    rdfs:comment 'Indicates whether the acknowledgment sign-off was captured digitally (True) or via physical paper signature (False). Supports audit trail and records management.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyPlanVersion rdf:type rdf:Property ;
    rdfs:label 'Emergency Plan Version' ;
    rdfs:comment 'Version identifier of the emergency response plan referenced and communicated during the briefing (e.g., \'v2.1\'). Ensures staff are briefed on the current operative plan version.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evacuationRoutesReviewedFlag rdf:type rdf:Property ;
    rdfs:label 'Evacuation Routes Reviewed Flag' ;
    rdfs:comment 'Indicates whether evacuation routes and assembly points were reviewed with attendees during the briefing. True = reviewed; False = not reviewed. Required for ADA and OSHA compliance.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incidentReportingProtocolBriefedFlag rdf:type rdf:Property ;
    rdfs:label 'Incident Reporting Protocol Briefed Flag' ;
    rdfs:comment 'Indicates whether incident reporting procedures, escalation paths, and documentation requirements were communicated during the briefing.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:keyDirectivesSummary rdf:type rdf:Property ;
    rdfs:label 'Key Directives Summary' ;
    rdfs:comment 'Narrative summary of the primary operational directives, protocols, and instructions issued during the briefing. Captures the substantive content communicated to attendees for compliance documentation.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementAgencyName rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Agency Name' ;
    rdfs:comment 'Name of the primary law enforcement agency represented at the briefing (e.g., \'NYPD\', \'FBI Field Office\'). Supports inter-agency coordination documentation.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementCount rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Count' ;
    rdfs:comment 'Number of law enforcement liaison officers (police, federal agents, etc.) who attended the briefing. Tracks inter-agency coordination compliance.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lawEnforcementLiaisonName rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Liaison Name' ;
    rdfs:comment 'Name of the designated law enforcement liaison officer present at the briefing. Business-confidential operational contact information for security coordination.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:location rdf:type rdf:Property ;
    rdfs:label 'Location' ;
    rdfs:comment 'Physical location within the venue where the briefing was held (e.g., \'Command Center Room 1A\', \'Gate B Staging Area\'). Supports venue operations coordination.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaCredentialProtocolBriefedFlag rdf:type rdf:Property ;
    rdfs:label 'Media Credential Protocol Briefed Flag' ;
    rdfs:comment 'Indicates whether media credentialing and broadcast zone access protocols were reviewed during the briefing. Supports broadcast operations security coordination.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postAssignmentCount rdf:type rdf:Property ;
    rdfs:label 'Post Assignment Count' ;
    rdfs:comment 'Number of distinct security post assignments reviewed during the briefing. Provides a quantitative measure of operational coverage confirmed.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postAssignmentsReviewedFlag rdf:type rdf:Property ;
    rdfs:label 'Post Assignments Reviewed Flag' ;
    rdfs:comment 'Indicates whether all security post assignments were reviewed and confirmed with attendees during the briefing. True = post assignments reviewed; False = not reviewed.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prohibitedItemsBriefedFlag rdf:type rdf:Property ;
    rdfs:label 'Prohibited Items Briefed Flag' ;
    rdfs:comment 'Indicates whether the list of prohibited items and confiscation procedures was reviewed with security staff during the briefing. True = briefed; False = not briefed.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:securityStaffCount rdf:type rdf:Property ;
    rdfs:label 'Security Staff Count' ;
    rdfs:comment 'Number of contracted or in-house security staff personnel who attended the briefing. Supports staffing compliance verification.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:signOffDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Sign Off Document Reference' ;
    rdfs:comment 'Reference number or URL to the stored acknowledgment sign-off document (physical scan or digital record). Supports compliance audit and records retention.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialEventConsiderations rdf:type rdf:Property ;
    rdfs:label 'Special Event Considerations' ;
    rdfs:comment 'Free-text field capturing any unique security considerations specific to this event briefing, such as high-profile athlete appearances, political dignitaries, protest activity advisories, or elevated media presence.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supervisorCount rdf:type rdf:Property ;
    rdfs:label 'Supervisor Count' ;
    rdfs:comment 'Number of security supervisors and team leads who attended the briefing. Supervisors are responsible for cascading directives to their respective teams.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:threatLevelJustification rdf:type rdf:Property ;
    rdfs:label 'Threat Level Justification' ;
    rdfs:comment 'Narrative explanation of the factors and intelligence inputs that informed the communicated threat level. Provides audit trail for threat assessment decisions.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAttendeeCount rdf:type rdf:Property ;
    rdfs:label 'Total Attendee Count' ;
    rdfs:comment 'Total number of individuals who attended the security briefing across all role categories. Quantitative result confirming briefing reach and compliance.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:venueOperationsCount rdf:type rdf:Property ;
    rdfs:label 'Venue Operations Count' ;
    rdfs:comment 'Number of venue operations team members (facility management, event staff) who attended the briefing. Ensures cross-functional awareness of security protocols.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vipProtocolBriefedFlag rdf:type rdf:Property ;
    rdfs:label 'Vip Protocol Briefed Flag' ;
    rdfs:comment 'Indicates whether VIP access protocols, escort procedures, and special handling requirements were communicated during the briefing. True = briefed; False = not briefed.' ;
    rdfs:domain ind:Briefing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primarySecurityEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Security Employee Id' ;
    rdfs:comment 'Internal employee identifier for the Sports Entertainment security manager or procurement officer who owns and is accountable for this contract. Used for escalation and renewal workflows.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:armedServicesFlag rdf:type rdf:Property ;
    rdfs:label 'Armed Services Flag' ;
    rdfs:comment 'Indicates whether this contract authorizes the deployment of armed security personnel. Triggers additional licensing verification, law enforcement coordination, and regulatory compliance checks.' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:backgroundCheckRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Background Check Required Flag' ;
    rdfs:comment 'Indicates whether all security personnel deployed under this contract must pass a background check prior to deployment. Supports compliance with venue security protocols and law enforcement coordination requirements.' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingRateStructure rdf:type rdf:Property ;
    rdfs:label 'Billing Rate Structure' ;
    rdfs:comment 'The commercial billing model governing how the vendor invoices Sports Entertainment for security services. Hourly and daily rates apply per officer; flat fee and per-event rates apply to the full deployment; retainer is a fixed periodic payment; milestone-based ties payment to deliverables.' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractValue rdf:type rdf:Property ;
    rdfs:label 'Contract Value' ;
    rdfs:comment 'Total maximum monetary value of the security contract over its full term in the contract currency. Used for budget planning, procurement approval thresholds, and financial reporting.' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractedHeadcount rdf:type rdf:Property ;
    rdfs:label 'Contracted Headcount' ;
    rdfs:comment 'Total number of security personnel contracted to be deployed under this agreement. Used for workforce planning, venue capacity compliance, and SLA monitoring.' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:executiveProtectionFlag rdf:type rdf:Property ;
    rdfs:label 'Executive Protection Flag' ;
    rdfs:comment 'Indicates whether this contract includes executive protection (close protection) services for VIP athletes, executives, or dignitaries attending Sports Entertainment events.' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Amount' ;
    rdfs:comment 'Minimum insurance coverage amount in the contract currency that the vendor must maintain for general liability and workers compensation. Verified during contract onboarding and annual renewal.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insuranceExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Insurance Expiry Date' ;
    rdfs:comment 'Date on which the vendor\'s current insurance certificate expires. Used to trigger renewal reminders and compliance checks. Contract may be suspended if insurance lapses.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:k9ServicesFlag rdf:type rdf:Property ;
    rdfs:label 'K9 Services Flag' ;
    rdfs:comment 'Indicates whether this contract includes K9 (canine) security unit services for explosive detection, crowd deterrence, or perimeter patrol.' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lawEnforcementCoordinationFlag rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Coordination Flag' ;
    rdfs:comment 'Indicates whether this contract includes provisions for coordinating with local law enforcement agencies during events. Relevant for large-scale events requiring off-duty officer deployment.' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumHeadcount rdf:type rdf:Property ;
    rdfs:label 'Minimum Headcount' ;
    rdfs:comment 'Minimum number of security personnel the vendor is contractually obligated to provide at any given deployment. Falling below this threshold constitutes an SLA breach.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overtimeHourlyRate rdf:type rdf:Property ;
    rdfs:label 'Overtime Hourly Rate' ;
    rdfs:comment 'Contracted billing rate per officer per hour for overtime hours exceeding the standard shift duration. Used for invoice validation and event cost estimation.' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceCategories rdf:type rdf:Property ;
    rdfs:label 'Service Categories' ;
    rdfs:comment 'Pipe-delimited list of primary service category codes covered under this contract (e.g., staffing|k9|crowd_management). Enables multi-category filtering for analytics and procurement reporting. [ENUM-REF-CANDIDATE: staffing|k9|executive_protection|crowd_management|access_control|surveillance|armed_guard|cyber_security|event_security|patrol — promote to reference product]' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceScope rdf:type rdf:Property ;
    rdfs:label 'Service Scope' ;
    rdfs:comment 'Narrative description of the security services covered under this contract, including staffing, K9 units, executive protection, crowd management, access control, surveillance monitoring, or other specialized services. Free-text field capturing the full scope of work.' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardHourlyRate rdf:type rdf:Property ;
    rdfs:label 'Standard Hourly Rate' ;
    rdfs:comment 'Contracted standard billing rate per officer per hour in the contract currency. Used for invoice validation and cost forecasting. Applicable when billing_rate_structure is hourly.' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vendorLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor License Number' ;
    rdfs:comment 'State or jurisdiction-issued private security company license number held by the vendor. Required for regulatory compliance verification prior to contract activation.' ;
    rdfs:domain ind:SecurityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveillanceAssetId rdf:type rdf:Property ;
    rdfs:label 'Surveillance Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: Security incident investigations require linking to the DAM asset containing the surveillance footage clip. Post-incident review, insurance claims, and law enforcement handoff processes all depend on ' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:banDurationDays rdf:type rdf:Property ;
    rdfs:label 'Ban Duration Days' ;
    rdfs:comment 'Duration in days of the venue ban issued to the involved party. A value of -1 or null indicates a permanent ban. Populated when ban_issued is True.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:banIssued rdf:type rdf:Property ;
    rdfs:label 'Ban Issued' ;
    rdfs:comment 'Indicates whether a venue ban or trespass notice was issued to the involved party as a result of this incident. Triggers downstream ban enforcement processes in Ticketmaster/AXS access control.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closedAt rdf:type rdf:Property ;
    rdfs:label 'Closed At' ;
    rdfs:comment 'Date and time the security incident case was formally closed following completion of all required actions, investigations, and documentation. Null if the incident remains open or under review.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:closureNotes rdf:type rdf:Property ;
    rdfs:label 'Closure Notes' ;
    rdfs:comment 'Free-text notes recorded at the time of case closure, summarizing final outcomes, follow-up actions completed, and any lessons learned for security operations improvement.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialTypeViolated rdf:type rdf:Property ;
    rdfs:label 'Credential Type Violated' ;
    rdfs:comment 'Type of access credential involved in a credentialing violation incident (e.g., forged media pass, unauthorized field access badge). Populated when incident_type is credentialing_violation. [ENUM-REF-CANDIDATE: media|staff|vip|field_access|broadcast|vendor|athlete — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposition rdf:type rdf:Property ;
    rdfs:label 'Disposition' ;
    rdfs:comment 'Final outcome or action taken as a result of the security incident. Drives downstream processes including ban enforcement, medical referral, and law enforcement handoff. [ENUM-REF-CANDIDATE: ejected|arrested|warned|banned|referred_medical|no_action|trespass_notice|cited — promote to reference product]' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyResponsePlanActivated rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Plan Activated' ;
    rdfs:comment 'Indicates whether the venue\'s formal Emergency Response Plan (ERP) was activated in response to this incident. Required for post-incident compliance review and insurance documentation.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evacuationTriggered rdf:type rdf:Property ;
    rdfs:label 'Evacuation Triggered' ;
    rdfs:comment 'Indicates whether the incident triggered a partial or full venue evacuation protocol. Drives post-incident emergency response plan review and regulatory reporting obligations.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gateIdentifier rdf:type rdf:Property ;
    rdfs:label 'Gate Identifier' ;
    rdfs:comment 'Identifier of the entry/exit gate associated with the incident location, relevant for access control violations, prohibited item seizures, and credentialing breaches detected at ingress/egress points.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:involvedPartyIdNumber rdf:type rdf:Property ;
    rdfs:label 'Involved Party Id Number' ;
    rdfs:comment 'Government-issued or venue-issued identification number (e.g., driver\'s license, passport, fan membership ID) for the primary involved party. Restricted PII used for law enforcement coordination and ban enforcement.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:involvedPartyName rdf:type rdf:Property ;
    rdfs:label 'Involved Party Name' ;
    rdfs:comment 'Full name of the primary individual involved in the security incident (subject, suspect, or victim). Classified as restricted PII under GDPR and CCPA. Required for law enforcement reporting and case management.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:involvedPartyType rdf:type rdf:Property ;
    rdfs:label 'Involved Party Type' ;
    rdfs:comment 'Classification of the primary party involved in or subject to the security incident. Determines applicable regulatory obligations (e.g., GDPR for fan data, CBA provisions for athlete incidents). [ENUM-REF-CANDIDATE: fan|athlete|staff|vendor|media|vip_guest|unknown — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementNotified rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Notified' ;
    rdfs:comment 'Indicates whether local law enforcement (police, FBI, or other agency) was notified of the security incident. Required for regulatory reporting and incident severity escalation tracking.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leagueGoverningBodyReported rdf:type rdf:Property ;
    rdfs:label 'League Governing Body Reported' ;
    rdfs:comment 'Indicates whether the incident was reported to the relevant league governing body (e.g., NFL, NBA, FIFA, NHL) per league security reporting obligations. Required for compliance with league security protocols and CBA provisions.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalReferralRequired rdf:type rdf:Property ;
    rdfs:label 'Medical Referral Required' ;
    rdfs:comment 'Indicates whether the incident required a medical referral or emergency medical services (EMS) response. Triggers coordination with venue.safety_incident domain for OSHA recordkeeping when True.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:narrative rdf:type rdf:Property ;
    rdfs:label 'Narrative' ;
    rdfs:comment 'Free-text detailed description of the security incident as recorded by the responding officer, including sequence of events, actions taken, and any relevant contextual observations. Primary source for legal and insurance documentation.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfPersonsInvolved rdf:type rdf:Property ;
    rdfs:label 'Number Of Persons Involved' ;
    rdfs:comment 'Total count of individuals directly involved in the security incident (subjects, victims, and witnesses). Used for incident severity assessment and resource deployment analysis.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prohibitedItemType rdf:type rdf:Property ;
    rdfs:label 'Prohibited Item Type' ;
    rdfs:comment 'Classification of the prohibited item seized during the incident, applicable when incident_type is prohibited_item_seizure (e.g., weapon, alcohol, pyrotechnic, laser pointer, drone). [ENUM-REF-CANDIDATE: weapon|alcohol|pyrotechnic|laser_pointer|drone|controlled_substance|recording_device|other — promote to reference product]' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedAt rdf:type rdf:Property ;
    rdfs:label 'Reported At' ;
    rdfs:comment 'Date and time the incident was formally reported to the security operations center or duty manager, which may differ from the occurrence time. Used to measure reporting lag and response readiness.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responseTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Response Time Minutes' ;
    rdfs:comment 'Elapsed time in minutes between the incident occurrence timestamp and the arrival of the first responding security officer. Key performance indicator (KPI) for security operations SLA compliance and staffing adequacy reviews.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sectionIdentifier rdf:type rdf:Property ;
    rdfs:label 'Section Identifier' ;
    rdfs:comment 'Specific section, block, or area designation within the venue zone where the incident took place (e.g., Section 112, Row G, Gate 4 Entry). Sourced from Archtics seating inventory for precise location mapping.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityTier rdf:type rdf:Property ;
    rdfs:label 'Severity Tier' ;
    rdfs:comment 'Standardized severity classification assigned to the incident at time of reporting, used to prioritize response resources and escalation protocols. Tier 1 Critical requires immediate law enforcement; Tier 4 Low is handled by venue security staff.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveillanceFootageAvailable rdf:type rdf:Property ;
    rdfs:label 'Surveillance Footage Available' ;
    rdfs:comment 'Indicates whether CCTV or surveillance camera footage is available and has been preserved for this incident. Critical for evidence management, legal proceedings, and post-incident review.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surveillanceFootageReference rdf:type rdf:Property ;
    rdfs:label 'Surveillance Footage Reference' ;
    rdfs:comment 'Reference identifier or storage path for the associated surveillance footage clip in the Digital Asset Management (DAM) system (Dalet Galaxy). Populated when surveillance_footage_available is True.' ;
    rdfs:domain ind:SecurityIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionId rdf:type rdf:Property ;
    rdfs:label 'Position Id' ;
    rdfs:comment 'Foreign key linking to workforce.position. Business justification: Each security post requires a specific workforce position (e.g., Security Officer II, Crowd Control Supervisor). Linking security_post to the workforce position enables headcount budget alignment, pay' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Position .

ind:supervisingPostId rdf:type rdf:Property ;
    rdfs:label 'Supervising Post Id' ;
    rdfs:comment 'Self-referencing identifier of the supervisory post responsible for overseeing this post. Enables hierarchical post management and chain-of-command reporting within the security deployment structure.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Post .

ind:adaAccessiblePost rdf:type rdf:Property ;
    rdfs:label 'Ada Accessible Post' ;
    rdfs:comment 'Indicates whether this post is positioned to provide ADA-compliant assistance and access support to guests with disabilities. Required for ADA compliance reporting and venue accessibility audits.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:armedPost rdf:type rdf:Property ;
    rdfs:label 'Armed Post' ;
    rdfs:comment 'Indicates whether officers assigned to this post are required to be armed. Drives staffing qualification requirements, insurance compliance, and regulatory reporting.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equipmentRequired rdf:type rdf:Property ;
    rdfs:label 'Equipment Required' ;
    rdfs:comment 'Comma-separated list or description of equipment required at this post (e.g., \'handheld_scanner, radio, baton, first_aid_kit\'). Used for pre-event equipment staging and inventory management.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indoorOutdoor rdf:type rdf:Property ;
    rdfs:label 'Indoor Outdoor' ;
    rdfs:comment 'Indicates whether the post is located indoors, outdoors, or spans both environments. Affects equipment requirements (weather gear, shelter), officer welfare planning, and OSHA compliance.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementRequired rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Required' ;
    rdfs:comment 'Indicates whether sworn law enforcement officers (police, sheriff, federal agents) are required at this post, as opposed to private security personnel. Drives law enforcement coordination and contract requirements.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumStaffCount rdf:type rdf:Property ;
    rdfs:label 'Minimum Staff Count' ;
    rdfs:comment 'Absolute minimum number of security officers needed to maintain acceptable coverage at this post. If staffing falls below this threshold, the post is flagged as critically understaffed in gap analysis reporting.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patrolCycleMinutes rdf:type rdf:Property ;
    rdfs:label 'Patrol Cycle Minutes' ;
    rdfs:comment 'Expected duration in minutes for one complete patrol cycle for roving or mobile response posts. Used to calculate patrol frequency and identify coverage gaps during event operations.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patrolRouteDescription rdf:type rdf:Property ;
    rdfs:label 'Patrol Route Description' ;
    rdfs:comment 'Narrative description of the patrol route or coverage area for roving and mobile response posts. Defines the geographic path, checkpoints, and frequency of patrol cycles. Applicable only to non-fixed post types.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postCode rdf:type rdf:Property ;
    rdfs:label 'Post Code' ;
    rdfs:comment 'Alphanumeric business identifier for the security post, used operationally on event-day deployment sheets, radio logs, and staffing rosters. Unique within a venue (e.g., \'GT-01\', \'FP-NW\', \'CMD-01\').' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postName rdf:type rdf:Property ;
    rdfs:label 'Post Name' ;
    rdfs:comment 'Human-readable descriptive name of the security post as used in operational briefings and staffing plans (e.g., \'North Gate Entry\', \'Field Perimeter West\', \'Command Center Alpha\').' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postStatus rdf:type rdf:Property ;
    rdfs:label 'Post Status' ;
    rdfs:comment 'Current lifecycle status of the security post record. Active posts are available for staffing deployment; inactive posts are temporarily not in use; suspended posts are under review; decommissioned posts have been permanently retired.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postType rdf:type rdf:Property ;
    rdfs:label 'Post Type' ;
    rdfs:comment 'Operational classification of the post defining its deployment mode. Fixed posts remain stationary (gates, tunnels, field perimeter); roving patrol posts cover a defined zone on foot or vehicle; mobile response posts are rapid-reaction positions; command center posts coordinate overall security operations. [ENUM-REF-CANDIDATE: fixed|roving_patrol|mobile_response|command_center|perimeter|access_control — promote to reference product]' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityTier rdf:type rdf:Property ;
    rdfs:label 'Priority Tier' ;
    rdfs:comment 'Operational priority classification of the post indicating its criticality to overall venue security. Critical posts (e.g., field access, command center) must be staffed before lower-tier posts during resource constraints. Used in post coverage gap analysis.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredStaffCount rdf:type rdf:Property ;
    rdfs:label 'Required Staff Count' ;
    rdfs:comment 'Minimum number of security officers required to be assigned to this post during an active shift. Used for event-day staffing deployment planning and post coverage gap analysis.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shiftType rdf:type rdf:Property ;
    rdfs:label 'Shift Type' ;
    rdfs:comment 'Classification of the shift window relative to the event lifecycle. Pre-event shifts cover setup and ingress; event-day shifts cover active event operations; post-event shifts cover egress and venue clearance; overnight shifts cover facility security between events.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supervisorPost rdf:type rdf:Property ;
    rdfs:label 'Supervisor Post' ;
    rdfs:comment 'Indicates whether this post is designated as a supervisory position responsible for overseeing a cluster of adjacent posts. Drives supervisory staffing requirements and chain-of-command reporting.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surveillanceCoverage rdf:type rdf:Property ;
    rdfs:label 'Surveillance Coverage' ;
    rdfs:comment 'Indicates whether this post is supported by fixed CCTV or surveillance camera coverage, supplementing the physical officer presence. Used in security operations planning and incident investigation.' ;
    rdfs:domain ind:Post ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvedByOfficerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approved By Officer Employee Id' ;
    rdfs:comment 'Reference to the security officer or director who granted final approval for this staffing plan. Required for audit trail and accountability under venue safety regulations.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:securityVendorId rdf:type rdf:Property ;
    rdfs:label 'Security Vendor Id' ;
    rdfs:comment 'Reference to the primary contracted private security vendor responsible for supplying the majority of the security workforce for this event.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:armedOfficerCount rdf:type rdf:Property ;
    rdfs:label 'Armed Officer Count' ;
    rdfs:comment 'Number of armed security personnel (private or law enforcement) planned for deployment. Tracked separately for regulatory compliance, insurance requirements, and venue permitting.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crowdManagementOfficerCount rdf:type rdf:Property ;
    rdfs:label 'Crowd Management Officer Count' ;
    rdfs:comment 'Number of security personnel specifically designated for crowd management duties, including queue management, crowd flow direction, and surge prevention at high-density areas.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emergencyResponsePlanReference rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Plan Reference' ;
    rdfs:comment 'Document reference code or identifier for the emergency response plan (ERP) associated with this staffing plan. Links to the formal ERP document governing evacuation, medical emergency, and active threat protocols.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:k9HandlerCount rdf:type rdf:Property ;
    rdfs:label 'K9 Handler Count' ;
    rdfs:comment 'Number of K9 (canine) handler teams planned for deployment. K9 units are used for explosive detection, crowd deterrence, and perimeter sweeps at high-security events.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lawEnforcementConfirmedCount rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Confirmed Count' ;
    rdfs:comment 'Number of sworn law enforcement officers confirmed by the relevant public agency as available and committed for this event. May differ from requested count due to agency availability constraints.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lawEnforcementContactName rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Contact Name' ;
    rdfs:comment 'Name of the designated law enforcement point-of-contact for this event\'s security coordination. Business-confidential operational information used for direct coordination.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementLiaisonCount rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Liaison Count' ;
    rdfs:comment 'Number of dedicated law enforcement liaison officers embedded within the private security command structure to facilitate real-time coordination between venue security and public law enforcement agencies.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lawEnforcementRequestedCount rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Requested Count' ;
    rdfs:comment 'Total number of sworn law enforcement officers formally requested from public agencies (police, sheriff, state patrol) to supplement private security for this event. Drives law_enforcement_deployment records.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medicalSecurityLiaisonCount rdf:type rdf:Property ;
    rdfs:label 'Medical Security Liaison Count' ;
    rdfs:comment 'Number of security personnel assigned to coordinate with on-site medical teams, ensuring secure access for emergency medical responders and managing crowd clearance during medical incidents.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planNumber rdf:type rdf:Property ;
    rdfs:label 'Plan Number' ;
    rdfs:comment 'Externally-known business identifier for the staffing plan, used in communications with vendors, law enforcement agencies, and venue operations teams. Format: SSP-{YEAR}-{SEQUENCE}.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postGuardCount rdf:type rdf:Property ;
    rdfs:label 'Post Guard Count' ;
    rdfs:comment 'Number of security personnel assigned to fixed post positions throughout the venue, including concourse patrols, section guards, and perimeter posts.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preEventBriefingScheduled rdf:type rdf:Property ;
    rdfs:label 'Pre Event Briefing Scheduled' ;
    rdfs:comment 'Scheduled date and time for the mandatory pre-event security briefing where all deployed personnel receive role assignments, threat intelligence updates, and emergency protocol reviews.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:radioChannelLawEnforcement rdf:type rdf:Property ;
    rdfs:label 'Radio Channel Law Enforcement' ;
    rdfs:comment 'Radio channel designation used for direct communications between venue security command and deployed law enforcement officers. Separate from the private security channel to maintain operational clarity.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:radioChannelPrimary rdf:type rdf:Property ;
    rdfs:label 'Radio Channel Primary' ;
    rdfs:comment 'Primary radio communications channel designation assigned to the security team for this event. Ensures all security personnel operate on a coordinated communications network.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningOfficerCount rdf:type rdf:Property ;
    rdfs:label 'Screening Officer Count' ;
    rdfs:comment 'Number of security personnel assigned to entry screening checkpoints, responsible for bag checks, magnetometer operation, and prohibited item detection at venue access points.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specialInstructions rdf:type rdf:Property ;
    rdfs:label 'Special Instructions' ;
    rdfs:comment 'Free-text field capturing event-specific security instructions, VIP protection requirements, protest management protocols, or other non-standard directives that supplement the standard operating procedures for this event.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:staffingRatio rdf:type rdf:Property ;
    rdfs:label 'Staffing Ratio' ;
    rdfs:comment 'Planned ratio of total security personnel to expected attendance (security officers per 1,000 attendees). Used to benchmark against industry standards and regulatory minimums for venue safety compliance.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalHeadcount rdf:type rdf:Property ;
    rdfs:label 'Total Headcount' ;
    rdfs:comment 'Total number of security personnel planned for deployment across all roles for this event. Equals the sum of all role-specific headcount fields and serves as the master workforce count for capacity planning.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vendorAllocatedCount rdf:type rdf:Property ;
    rdfs:label 'Vendor Allocated Count' ;
    rdfs:comment 'Number of security personnel formally allocated by the contracted private security vendor for this event. Confirmed by the vendor against the staffing request and used for contract compliance tracking.' ;
    rdfs:domain ind:StaffingPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:analyticsIntegrationEnabled rdf:type rdf:Property ;
    rdfs:label 'Analytics Integration Enabled' ;
    rdfs:comment 'Indicates whether this camera\'s feed is integrated with the video analytics platform for AI-powered capabilities such as crowd density monitoring, object detection, perimeter breach detection, or facial recognition. Distinct from basic recording.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:analyticsPlatformCode rdf:type rdf:Property ;
    rdfs:label 'Analytics Platform Code' ;
    rdfs:comment 'Reference to the specific video analytics platform instance processing this camera\'s feed (e.g., crowd analytics engine, facial recognition system). Populated only when analytics_integration_enabled is True.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetTag rdf:type rdf:Property ;
    rdfs:label 'Asset Tag' ;
    rdfs:comment 'Externally-known unique asset tag or barcode label physically affixed to the camera unit, used for physical inventory audits and field identification. Serves as the BUSINESS_IDENTIFIER for this master resource. Sourced from SAP S/4HANA Fixed Asset module.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:audioRecordingEnabled rdf:type rdf:Property ;
    rdfs:label 'Audio Recording Enabled' ;
    rdfs:comment 'Indicates whether the camera captures audio in addition to video. Audio recording has specific legal and regulatory implications under wiretapping laws and GDPR, requiring explicit signage and consent notices at the venue.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cameraName rdf:type rdf:Property ;
    rdfs:label 'Camera Name' ;
    rdfs:comment 'Human-readable descriptive name or label assigned to the camera for operational identification (e.g., \'North Concourse Gate 4 PTZ\', \'Field Level South Fixed\'). Serves as the IDENTITY_LABEL for this master resource.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cameraType rdf:type rdf:Property ;
    rdfs:label 'Camera Type' ;
    rdfs:comment 'Classification of the camera by its physical form factor and operational capability. Fixed cameras are stationary; PTZ (Pan-Tilt-Zoom) cameras are remotely controllable; body-worn cameras are carried by security personnel; drone cameras are aerial; thermal cameras detect heat signatures; 360-degree cameras provide panoramic coverage. Serves as the CLASSIFICATION_OR_TYPE for this master resource. [ENUM-REF-CANDIDATE: fixed|ptz|body_worn|drone|thermal|360_degree|fisheye|covert — promote to reference product]' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageAreaSqm rdf:type rdf:Property ;
    rdfs:label 'Coverage Area Sqm' ;
    rdfs:comment 'Approximate physical area in square metres that the camera\'s field of view covers under normal operating conditions. Used for security coverage gap analysis and venue safety compliance reporting.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crowdManagementFlag rdf:type rdf:Property ;
    rdfs:label 'Crowd Management Flag' ;
    rdfs:comment 'Indicates whether this camera is designated as a primary asset for crowd management and density monitoring operations during events. Cameras flagged for crowd management are prioritised in the security operations centre (SOC) dashboard and integrated with emergency response plans.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyResponseFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Flag' ;
    rdfs:comment 'Indicates whether this camera is designated as a critical asset in the venue\'s emergency response plan (e.g., covering evacuation routes, emergency exits, first aid stations). These cameras receive priority maintenance and are monitored continuously during events.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fieldOfViewDegrees rdf:type rdf:Property ;
    rdfs:label 'Field Of View Degrees' ;
    rdfs:comment 'Horizontal field of view angle of the camera lens expressed in degrees. Used for coverage gap analysis, camera placement optimisation, and security zone mapping.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firmwareVersion rdf:type rdf:Property ;
    rdfs:label 'Firmware Version' ;
    rdfs:comment 'Current firmware version installed on the camera unit. Critical for cybersecurity vulnerability management, patch compliance tracking, and ensuring compatibility with the video analytics platform.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frameRateFps rdf:type rdf:Property ;
    rdfs:label 'Frame Rate Fps' ;
    rdfs:comment 'Recording frame rate of the camera expressed in frames per second (FPS). Standard values: 15 FPS (general surveillance), 25/30 FPS (standard motion), 60 FPS (high-speed event capture). Affects storage consumption and suitability for video analytics such as crowd counting and facial recognition.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gdprPrivacyNoticePosted rdf:type rdf:Property ;
    rdfs:label 'Gdpr Privacy Notice Posted' ;
    rdfs:comment 'Indicates whether a GDPR-compliant privacy notice (informing individuals of video surveillance) is posted in the area covered by this camera. Mandatory for venues operating in EU jurisdictions under GDPR Article 13. Supports regulatory compliance audit evidence.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gpsLatitude rdf:type rdf:Property ;
    rdfs:label 'Gps Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the camera installation point in decimal degrees (WGS84). Enables precise geospatial mapping of surveillance coverage and integration with venue GIS systems.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpsLongitude rdf:type rdf:Property ;
    rdfs:label 'Gps Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the camera installation point in decimal degrees (WGS84). Enables precise geospatial mapping of surveillance coverage and integration with venue GIS systems.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installationDate rdf:type rdf:Property ;
    rdfs:label 'Installation Date' ;
    rdfs:comment 'Date on which the camera was physically installed and commissioned at the venue. Used for asset age tracking, warranty period calculation, and planned replacement scheduling.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastMaintenanceDate rdf:type rdf:Property ;
    rdfs:label 'Last Maintenance Date' ;
    rdfs:comment 'Date of the most recent preventive or corrective maintenance performed on the camera. Used to track maintenance compliance, schedule next service, and assess operational reliability.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lawEnforcementAccessible rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Accessible' ;
    rdfs:comment 'Indicates whether footage from this camera is accessible to law enforcement agencies under a pre-agreed data sharing agreement or upon lawful request. Governs data governance workflows for footage disclosure and chain-of-custody documentation.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:macAddress rdf:type rdf:Property ;
    rdfs:label 'Mac Address' ;
    rdfs:comment 'Hardware MAC (Media Access Control) address of the camera\'s network interface. Used for network access control (NAC) policy enforcement and device authentication on the venue security network.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufacturer rdf:type rdf:Property ;
    rdfs:label 'Manufacturer' ;
    rdfs:comment 'Name of the original equipment manufacturer (OEM) of the camera hardware (e.g., Axis Communications, Bosch, Hanwha, Hikvision, Pelco). Used for warranty management, vendor SLA tracking, and procurement decisions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelNumber rdf:type rdf:Property ;
    rdfs:label 'Model Number' ;
    rdfs:comment 'Manufacturer\'s model number or product SKU for the camera hardware. Used for spare parts procurement, firmware compatibility tracking, and technical support escalation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mountingLocation rdf:type rdf:Property ;
    rdfs:label 'Mounting Location' ;
    rdfs:comment 'Physical mounting configuration of the camera unit indicating how and where it is installed. Informs maintenance access procedures and field-of-view calculations. [ENUM-REF-CANDIDATE: ceiling|wall|pole|mast|mobile|body|aerial — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextMaintenanceDate rdf:type rdf:Property ;
    rdfs:label 'Next Maintenance Date' ;
    rdfs:comment 'Date on which the next scheduled preventive maintenance for this camera is due. Drives maintenance work order generation and ensures continuous operational coverage during events.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nightVisionEnabled rdf:type rdf:Property ;
    rdfs:label 'Night Vision Enabled' ;
    rdfs:comment 'Indicates whether the camera is equipped with infrared (IR) or low-light night vision capability. Critical for 24/7 venue security coverage during evening events and overnight facility monitoring.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operationalStatus rdf:type rdf:Property ;
    rdfs:label 'Operational Status' ;
    rdfs:comment 'Current lifecycle state of the surveillance camera asset indicating whether it is actively recording, offline, undergoing maintenance, in fault condition, decommissioned, or awaiting installation. Serves as the LIFECYCLE_STATUS for this master resource.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerSource rdf:type rdf:Property ;
    rdfs:label 'Power Source' ;
    rdfs:comment 'Method by which the camera receives electrical power. PoE (Power over Ethernet) and PoE+ are common for networked cameras; AC mains for high-power units; battery for temporary/mobile deployments; solar for outdoor remote locations. Affects maintenance scheduling and resilience planning.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ptzControllable rdf:type rdf:Property ;
    rdfs:label 'Ptz Controllable' ;
    rdfs:comment 'Indicates whether the camera supports remote Pan-Tilt-Zoom (PTZ) control by security operators. PTZ cameras can be directed to track incidents in real time, providing dynamic coverage beyond fixed camera limitations.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordingSystemCode rdf:type rdf:Property ;
    rdfs:label 'Recording System Code' ;
    rdfs:comment 'Reference to the video management system (VMS) or network video recorder (NVR) that this camera streams to and stores footage on. Links to the recording system master product.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resolutionPixels rdf:type rdf:Property ;
    rdfs:label 'Resolution Pixels' ;
    rdfs:comment 'Numeric resolution of the camera sensor expressed in megapixels (e.g., 2 for 1080p, 8 for 4K). Used for precise technical specification, storage capacity planning, and video analytics platform configuration.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:securityZoneClassification rdf:type rdf:Property ;
    rdfs:label 'Security Zone Classification' ;
    rdfs:comment 'Security access classification of the venue zone monitored by this camera. Drives access control policies, footage access permissions, and law enforcement data sharing protocols. VIP zones have enhanced privacy considerations; high-security zones may have extended retention periods.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageBandwidthMbps rdf:type rdf:Property ;
    rdfs:label 'Storage Bandwidth Mbps' ;
    rdfs:comment 'Network bandwidth consumed by this camera\'s video stream in megabits per second (Mbps) under normal recording conditions. Used for network capacity planning and recording system infrastructure sizing.' ;
    rdfs:domain ind:SurveillanceCamera ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:warrantyExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Warranty Expiry Date' ;
    rdfs:comment 'Date on which the manufacturer\'s hardware warranty for this camera expires. Used to trigger procurement decisions for extended warranty or replacement, and to determine whether repair costs are covered.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveillanceFootageRequestId rdf:type rdf:Property ;
    rdfs:label 'Surveillance Footage Request Id' ;
    rdfs:comment 'Unique system-generated identifier for each surveillance footage request record. Primary key for this transactional entity.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SurveillanceFootageRequest .

ind:fulfilledAssetId rdf:type rdf:Property ;
    rdfs:label 'Fulfilled Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: When a surveillance footage request is fulfilled, the footage is ingested into the DAM as a content asset. Chain-of-custody tracking, legal hold compliance, and law enforcement disclosure processes re' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:requestingOfficerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Requesting Officer Employee Id' ;
    rdfs:comment 'Identifier of the internal security officer or staff member who initiated the footage request. Represents the PARTY_REFERENCE for internal requestors.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accessZone rdf:type rdf:Property ;
    rdfs:label 'Access Zone' ;
    rdfs:comment 'Venue access control zone or area designation (e.g., GA concourse, VIP suite level, player tunnel, backstage) where the requested cameras are located.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chainOfCustodyLog rdf:type rdf:Property ;
    rdfs:label 'Chain Of Custody Log' ;
    rdfs:comment 'Sequential narrative log documenting every individual who accessed, transferred, or handled the footage from extraction through delivery, maintaining evidentiary integrity.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryReceiptReference rdf:type rdf:Property ;
    rdfs:label 'Delivery Receipt Reference' ;
    rdfs:comment 'Reference number or acknowledgment identifier confirming receipt of the footage by the requesting party.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryRecipientName rdf:type rdf:Property ;
    rdfs:label 'Delivery Recipient Name' ;
    rdfs:comment 'Full name of the individual who received the delivered footage package, used for chain-of-custody confirmation.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureAuthorized rdf:type rdf:Property ;
    rdfs:label 'Disclosure Authorized' ;
    rdfs:comment 'Indicates whether formal authorization has been granted to disclose the requested footage to the requesting party, particularly for external law enforcement or legal proceedings.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disclosureAuthorizedBy rdf:type rdf:Property ;
    rdfs:label 'Disclosure Authorized By' ;
    rdfs:comment 'Name or identifier of the internal authority (e.g., Chief Security Officer, Legal Counsel, VP of Operations) who granted authorization for footage disclosure.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureAuthorizedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Disclosure Authorized Timestamp' ;
    rdfs:comment 'Date and time when disclosure authorization was formally granted for this footage request.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:footageEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Footage End Timestamp' ;
    rdfs:comment 'End date and time of the surveillance footage window being requested. Defines the conclusion of the temporal range for footage retrieval.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:footageFileSizeGb rdf:type rdf:Property ;
    rdfs:label 'Footage File Size Gb' ;
    rdfs:comment 'Total size in gigabytes of the extracted surveillance footage package delivered to the requesting party.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:footageFormat rdf:type rdf:Property ;
    rdfs:label 'Footage Format' ;
    rdfs:comment 'Digital file format of the extracted surveillance footage provided to the requesting party.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:footageHash rdf:type rdf:Property ;
    rdfs:label 'Footage Hash' ;
    rdfs:comment 'SHA-256 cryptographic hash of the extracted footage file used to verify integrity and detect tampering throughout the chain of custody.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:footagePurpose rdf:type rdf:Property ;
    rdfs:label 'Footage Purpose' ;
    rdfs:comment 'Detailed narrative description of the business or legal purpose for which the surveillance footage is being requested, including incident description or investigation context.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:footageRetentionExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Footage Retention Expiry Date' ;
    rdfs:comment 'Date on which the extracted footage copy associated with this request is scheduled for deletion per data retention policy, unless a legal hold is active.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:footageStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Footage Start Timestamp' ;
    rdfs:comment 'Start date and time of the surveillance footage window being requested. Defines the beginning of the temporal range for footage retrieval.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fulfilledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Fulfilled Timestamp' ;
    rdfs:comment 'Date and time when the footage was successfully extracted, packaged, and delivered to the requesting party.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:legalHoldReference rdf:type rdf:Property ;
    rdfs:label 'Legal Hold Reference' ;
    rdfs:comment 'Reference number or identifier of the legal hold order applied to this footage request, issued by legal counsel or court authority.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privacyImpactAssessed rdf:type rdf:Property ;
    rdfs:label 'Privacy Impact Assessed' ;
    rdfs:comment 'Indicates whether a privacy impact assessment was conducted for this footage request to evaluate risks to individuals captured in the footage, as required under GDPR and CCPA.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:redactionCompleted rdf:type rdf:Property ;
    rdfs:label 'Redaction Completed' ;
    rdfs:comment 'Indicates whether required redaction of the footage has been completed prior to delivery.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:redactionRequired rdf:type rdf:Property ;
    rdfs:label 'Redaction Required' ;
    rdfs:comment 'Indicates whether portions of the footage must be redacted (e.g., to protect uninvolved individuals\' privacy) before disclosure to the requesting party.' ;
    rdfs:domain ind:Security ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requestingAgencyCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Requesting Agency Case Number' ;
    rdfs:comment 'External case, docket, or reference number assigned by the requesting law enforcement agency or legal body to cross-reference with their own records.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingAgencyName rdf:type rdf:Property ;
    rdfs:label 'Requesting Agency Name' ;
    rdfs:comment 'Name of the external law enforcement agency, legal firm, or insurance company submitting the request. Populated when requesting_party_type is external.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingPartyName rdf:type rdf:Property ;
    rdfs:label 'Requesting Party Name' ;
    rdfs:comment 'Full name of the individual or organization requesting the footage. May be an internal security officer, law enforcement officer, legal counsel, or insurance adjuster.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingPartyType rdf:type rdf:Property ;
    rdfs:label 'Requesting Party Type' ;
    rdfs:comment 'Classification of the entity submitting the footage request, distinguishing between internal staff, external law enforcement agencies, legal representatives, and other authorized parties.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaDueDate rdf:type rdf:Property ;
    rdfs:label 'Sla Due Date' ;
    rdfs:comment 'Target date by which the footage request must be fulfilled per internal SLA or law enforcement response time requirements.' ;
    rdfs:domain ind:SurveillanceFootageRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:threatAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Threat Assessment Id' ;
    rdfs:comment 'Unique system-generated identifier for each formal threat assessment record within the Sports Entertainment security domain.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryThreatEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Threat Employee Id' ;
    rdfs:comment 'Reference to the security officer or analyst who authored and submitted this threat assessment. Used for accountability, chain-of-custody, and law enforcement briefing attribution.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:priorSecurityIncidentId rdf:type rdf:Property ;
    rdfs:label 'Prior Security Incident Id' ;
    rdfs:comment 'Foreign key linking to security.security_incident. Business justification: Threat assessments frequently reference prior security incidents as intelligence inputs — a prior_incident_flag and prior_incident_reference (STRING) already exist on the table, indicating this relati' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SecurityIncident .

ind:reviewingOfficerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Reviewing Officer Employee Id' ;
    rdfs:comment 'Reference to the senior security officer or supervisor who reviewed and approved this threat assessment. Supports dual-control and chain-of-command validation.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:subjectAthleteProfileId rdf:type rdf:Property ;
    rdfs:label 'Subject Athlete Profile Id' ;
    rdfs:comment 'Foreign key linking to athlete.athlete_profile. Business justification: Threat assessments are conducted for specific athletes — either threats directed at athletes (requiring protective detail) or athlete conduct risks. Role prefix \'subject_\' is required as threat_assess' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AthleteProfile .

ind:subjectSuspensionRecordId rdf:type rdf:Property ;
    rdfs:label 'Subject Suspension Record Id' ;
    rdfs:comment 'Foreign key linking to athlete.suspension_record. Business justification: Security threat assessment teams incorporate athlete suspension history — especially violence-related or conduct violations — into venue risk evaluations. Role prefix \'subject_\' distinguishes this fro' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SuspensionRecord .

ind:assessmentNarrative rdf:type rdf:Property ;
    rdfs:label 'Assessment Narrative' ;
    rdfs:comment 'Full narrative description of the threat assessment findings, including threat actor behavior indicators, intelligence corroboration, vulnerability analysis, and contextual factors. Core content of law enforcement briefing packages.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentNumber rdf:type rdf:Property ;
    rdfs:label 'Assessment Number' ;
    rdfs:comment 'Externally-referenced alphanumeric identifier for the threat assessment, used in law enforcement briefing packages, DHS/FBI coordination, and inter-agency communications. Format: TA-{YYYY}-{NNNNNN}.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assessment Timestamp' ;
    rdfs:comment 'The precise date and time at which the formal threat assessment was conducted and documented. This is the principal real-world event time, distinct from record creation audit timestamps.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:consequenceRating rdf:type rdf:Property ;
    rdfs:label 'Consequence Rating' ;
    rdfs:comment 'Assessment of the potential impact severity if the threat materializes, covering life safety, operational disruption, reputational damage, and financial loss. Aligned with ISO 31000 and DHS THIRA consequence descriptors.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countermeasuresStatus rdf:type rdf:Property ;
    rdfs:label 'Countermeasures Status' ;
    rdfs:comment 'Current implementation status of the recommended countermeasures: not-initiated, in-planning, partially-implemented, fully-implemented, or not-required (threat resolved before implementation).' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countermeasuresSummary rdf:type rdf:Property ;
    rdfs:label 'Countermeasures Summary' ;
    rdfs:comment 'Narrative summary of recommended security countermeasures derived from this threat assessment, including enhanced screening protocols, access zone restrictions, surveillance augmentation, law enforcement deployment, and crowd management adjustments.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crowdSizeEstimate rdf:type rdf:Property ;
    rdfs:label 'Crowd Size Estimate' ;
    rdfs:comment 'Estimated attendance or crowd size for the associated event or venue at the time of the threat assessment. A key input to consequence rating and crowd management countermeasure planning.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dhsCoordinationFlag rdf:type rdf:Property ;
    rdfs:label 'Dhs Coordination Flag' ;
    rdfs:comment 'Indicates whether this threat assessment has been shared with or coordinated through the Department of Homeland Security (DHS). True when DHS has been formally notified or is actively involved.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evacuationPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Evacuation Plan Flag' ;
    rdfs:comment 'Indicates whether this threat assessment has triggered a review or activation of the venue or event evacuation plan.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fbiCoordinationFlag rdf:type rdf:Property ;
    rdfs:label 'Fbi Coordination Flag' ;
    rdfs:comment 'Indicates whether this threat assessment has been shared with or coordinated through the Federal Bureau of Investigation (FBI). True when FBI has been formally notified or is actively involved in the threat response.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:intelligenceClassification rdf:type rdf:Property ;
    rdfs:label 'Intelligence Classification' ;
    rdfs:comment 'Handling classification of the underlying intelligence that supports this threat assessment, governing distribution and access controls within Sports Entertainment and partner agencies.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intelligenceSourceTypes rdf:type rdf:Property ;
    rdfs:label 'Intelligence Source Types' ;
    rdfs:comment 'Pipe-delimited list of intelligence source categories that informed this assessment (e.g., \'HUMINT|OSINT|SIGINT|law-enforcement-tip|social-media-monitoring|venue-staff-report\'). Supports source attribution and analytical confidence scoring.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:likelihoodRating rdf:type rdf:Property ;
    rdfs:label 'Likelihood Rating' ;
    rdfs:comment 'Assessment of the probability that the identified threat will materialize, using a standardized five-point scale aligned with ISO 31000 risk likelihood descriptors.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:localLawEnforcementFlag rdf:type rdf:Property ;
    rdfs:label 'Local Law Enforcement Flag' ;
    rdfs:comment 'Indicates whether local law enforcement agencies (municipal police, county sheriff) have been briefed on or are coordinating response to this threat assessment.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Prior Incident Flag' ;
    rdfs:comment 'Indicates whether the subject or threat actor has a documented prior security incident history within Sports Entertainment venues or events. Supports recidivism risk scoring and escalation decisions.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:searLevel rdf:type rdf:Property ;
    rdfs:label 'Sear Level' ;
    rdfs:comment 'DHS Special Event Assessment Rating (SEAR) level assigned to the associated event, ranging from SEAR I (highest national significance) to SEAR V (local significance). Drives federal resource allocation and security planning requirements.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectAffiliation rdf:type rdf:Property ;
    rdfs:label 'Subject Affiliation' ;
    rdfs:comment 'Known organizational, group, or ideological affiliation of the person of interest or threat actor (e.g., extremist group, rival organization, disgruntled former employee). Informs threat context and law enforcement briefings.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threatLevelScore rdf:type rdf:Property ;
    rdfs:label 'Threat Level Score' ;
    rdfs:comment 'Numeric risk score (typically 1–100) derived from the formal threat assessment methodology, enabling quantitative comparison, trending, and AI/ML model inputs across assessments.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:threatSubcategory rdf:type rdf:Property ;
    rdfs:label 'Threat Subcategory' ;
    rdfs:comment 'Secondary classification providing granular detail within the threat category (e.g., \'vehicle-ramming\', \'active-shooter\', \'IED\', \'ransomware\', \'crowd-crush\', \'stalking\'). Free-text to accommodate evolving threat typologies.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vipPresenceFlag rdf:type rdf:Property ;
    rdfs:label 'Vip Presence Flag' ;
    rdfs:comment 'Indicates whether a VIP (Very Important Person) — such as a head of state, celebrity athlete, or high-profile sponsor — is expected to be present at the assessed event or venue, elevating the threat profile and security requirements.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vulnerabilitySummary rdf:type rdf:Property ;
    rdfs:label 'Vulnerability Summary' ;
    rdfs:comment 'Summary of identified physical, operational, or cyber-physical vulnerabilities at the venue or event that are relevant to this threat assessment. Informs countermeasure prioritization.' ;
    rdfs:domain ind:ThreatAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingVenueId rdf:type rdf:Property ;
    rdfs:label 'Issuing Venue Id' ;
    rdfs:comment 'Reference to the venue that issued this ban. Determines the primary enforcement jurisdiction and the venue whose access control systems must enforce the ban.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Venue .

ind:specificEventFixtureId rdf:type rdf:Property ;
    rdfs:label 'Specific Event Fixture Id' ;
    rdfs:comment 'Reference to the specific event to which an event-specific ban applies. Populated only when ban_type is \'event_specific\' or enforcement_scope is \'event_specific\'. Null for season, multi-season, or permanent bans.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fixture .

ind:appealLodgedDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Lodged Date' ;
    rdfs:comment 'Date on which the banned individual formally lodged an appeal against this venue ban. Null when no appeal has been submitted.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealResolvedDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Resolved Date' ;
    rdfs:comment 'Date on which the appeal was formally resolved and a decision communicated to the banned individual. Null when appeal is still pending.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:banIssuedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ban Issued Timestamp' ;
    rdfs:comment 'The precise date and time at which the venue ban was formally issued and recorded in the system. Represents the principal business event timestamp for this transaction.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:banReasonCategory rdf:type rdf:Property ;
    rdfs:label 'Ban Reason Category' ;
    rdfs:comment 'Standardised category classifying the primary reason for the venue ban. Used for reporting, trend analysis, and compliance with league conduct governance. [ENUM-REF-CANDIDATE: violence|harassment|intoxication|trespass|prohibited_item|fraud|racism_discrimination|other — promote to reference product]' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:banReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Ban Reason Description' ;
    rdfs:comment 'Free-text narrative describing the specific circumstances and conduct that led to the issuance of this venue ban. Supplements the standardised reason category with case-specific detail for legal and operational review.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:banReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Ban Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned to this ban record, used in correspondence with law enforcement, legal counsel, and the banned individual. Format: BAN-YYYY-NNNNNN.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:banStatus rdf:type rdf:Property ;
    rdfs:label 'Ban Status' ;
    rdfs:comment 'Current lifecycle state of the venue ban. Active bans are enforced at all applicable access control points. Suspended bans are temporarily paused pending appeal or legal review. Expired bans have passed their end date. Reinstated bans were previously lifted but re-activated. Appealed bans are under formal review. Cancelled bans were rescinded.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:banViolationCount rdf:type rdf:Property ;
    rdfs:label 'Ban Violation Count' ;
    rdfs:comment 'Number of recorded instances where the banned individual has attempted to or successfully gained access to a venue in violation of this ban. Used to escalate enforcement actions and support prosecution.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bannedPersonDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Banned Person Date Of Birth' ;
    rdfs:comment 'Date of birth of the banned individual, used for positive identity verification at venue access control points and in law enforcement trespass order documentation.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bannedPersonFullName rdf:type rdf:Property ;
    rdfs:label 'Banned Person Full Name' ;
    rdfs:comment 'Full legal name of the banned individual. Required for identity verification at access control points and for law enforcement trespass order documentation. Applies to both registered fan account holders and external individuals with no fan account.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bannedPersonIdNumber rdf:type rdf:Property ;
    rdfs:label 'Banned Person Id Number' ;
    rdfs:comment 'Government-issued identification number (e.g., driver\'s licence, passport, national ID) of the banned individual, used for positive identity verification and law enforcement coordination. Stored in compliance with applicable data minimisation requirements.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bannedPersonIdType rdf:type rdf:Property ;
    rdfs:label 'Banned Person Id Type' ;
    rdfs:comment 'Type of government-issued identification document provided for the banned individual. Used alongside the ID number for identity verification at access control points.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementScope rdf:type rdf:Property ;
    rdfs:label 'Enforcement Scope' ;
    rdfs:comment 'Defines the geographic and operational scope of the ban enforcement. Single-venue bans apply only to the issuing venue; all-venues bans apply across all Sports Entertainment venues; league-wide bans are coordinated with the governing league body; event-specific bans apply only to a designated event.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingAuthorityTitle rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority Title' ;
    rdfs:comment 'Job title or role of the Sports Entertainment official who issued this venue ban (e.g., Head of Security, Venue Operations Manager). Supports governance and escalation workflows.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastViolationDate rdf:type rdf:Property ;
    rdfs:label 'Last Violation Date' ;
    rdfs:comment 'Date of the most recent recorded violation of this venue ban. Null when no violations have been recorded. Used to trigger escalation workflows and law enforcement referrals.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationMethod rdf:type rdf:Property ;
    rdfs:label 'Notification Method' ;
    rdfs:comment 'Channel through which the formal ban notification was delivered to the banned individual. Certified mail and in-person delivery provide stronger legal proof of receipt.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photoIdOnFile rdf:type rdf:Property ;
    rdfs:label 'Photo Id On File' ;
    rdfs:comment 'Indicates whether a photograph of the banned individual has been captured and stored in the security system to support visual identification at access control points.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementEligible rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Eligible' ;
    rdfs:comment 'Indicates whether the banned individual is eligible to apply for reinstatement and lifting of the ban upon meeting defined conditions. False for permanent bans or bans where reinstatement has been explicitly denied.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementReviewDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Review Date' ;
    rdfs:comment 'Scheduled date on which the ban is due for reinstatement eligibility review. Enables proactive case management and ensures timely processing of reinstatement applications.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ticketingAccountSuspended rdf:type rdf:Property ;
    rdfs:label 'Ticketing Account Suspended' ;
    rdfs:comment 'Indicates whether the banned individual\'s ticketing account has been suspended in Ticketmaster/AXS as part of ban enforcement, preventing future ticket purchases and access credential generation.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trespassOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Trespass Order Number' ;
    rdfs:comment 'Official trespass order or notice number issued by law enforcement authorities in conjunction with this venue ban. Enables cross-referencing with police records and supports prosecution if the banned individual violates the order.' ;
    rdfs:domain ind:VenueBan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activationCode rdf:type rdf:Property ;
    rdfs:label 'Activation Code' ;
    rdfs:comment 'Externally-known alphanumeric reference code for this activation deliverable, used in deal documentation, invoicing, and partner communications.' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activationName rdf:type rdf:Property ;
    rdfs:label 'Activation Name' ;
    rdfs:comment 'Human-readable name or title of the brand activation deliverable (e.g., \'Halftime Show Title Sponsor Billboard\', \'Jersey Sleeve Patch — Season 2025\').' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activationType rdf:type rdf:Property ;
    rdfs:label 'Activation Type' ;
    rdfs:comment 'The specific commercial activation format applied to this deal\'s coverage of this betting market — e.g., branded odds feed, broadcast mention during live in-play, or co-branded market name. Belongs to the activation record, not to the deal or market independently.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:airtimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Airtime Seconds' ;
    rdfs:comment 'Contracted or delivered airtime duration in seconds for broadcast and audio activations (e.g., 30-second billboard, 15-second PA announcement).' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractedImpressions rdf:type rdf:Property ;
    rdfs:label 'Contracted Impressions' ;
    rdfs:comment 'The number of guaranteed impressions committed for this specific deal-market combination. Distinct from the deal-level impression_commitment on the deal master, which aggregates across all market activations.' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractedQuantity rdf:type rdf:Property ;
    rdfs:label 'Contracted Quantity' ;
    rdfs:comment 'Number of activation units committed in the sponsorship deal (e.g., number of broadcast spots, number of in-venue signage placements, number of social posts).' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractedValue rdf:type rdf:Property ;
    rdfs:label 'Contracted Value' ;
    rdfs:comment 'Monetary value attributed to this individual activation deliverable as allocated from the parent sponsorship deal. Used for ROI tracking and revenue recognition.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveredQuantity rdf:type rdf:Property ;
    rdfs:label 'Delivered Quantity' ;
    rdfs:comment 'Actual number of activation units delivered to date. Compared against contracted_quantity to determine fulfillment rate and identify shortfalls.' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drmCompliant rdf:type rdf:Property ;
    rdfs:label 'Drm Compliant' ;
    rdfs:comment 'Indicates whether the digital activation asset has been verified as compliant with DRM (Digital Rights Management) policies, including IP licensing and content protection requirements.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fccDisclosureRequired rdf:type rdf:Property ;
    rdfs:label 'Fcc Disclosure Required' ;
    rdfs:comment 'Indicates whether this broadcast activation requires a sponsorship identification disclosure per FCC regulations (47 CFR §317 and §507). Mandatory for paid broadcast integrations.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fccDisclosureText rdf:type rdf:Property ;
    rdfs:label 'Fcc Disclosure Text' ;
    rdfs:comment 'Exact on-air or on-screen disclosure text required by FCC regulations for this broadcast activation (e.g., \'Paid for by [Sponsor Name]\'). Null if FCC disclosure is not required.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grpContracted rdf:type rdf:Property ;
    rdfs:label 'Grp Contracted' ;
    rdfs:comment 'Gross Rating Points committed in the sponsorship deal for broadcast activations. GRP = Reach % × Frequency, used for broadcast media valuation.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impressionsContracted rdf:type rdf:Property ;
    rdfs:label 'Impressions Contracted' ;
    rdfs:comment 'Number of audience impressions (CPM basis) committed in the sponsorship deal for this activation. Used for GRP/CPM performance measurement.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:jerseyPlacementPosition rdf:type rdf:Property ;
    rdfs:label 'Jersey Placement Position' ;
    rdfs:comment 'Specific position on the athlete kit where the sponsor brand appears. Applicable only for jersey/kit channel activations.' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kitManufacturer rdf:type rdf:Property ;
    rdfs:label 'Kit Manufacturer' ;
    rdfs:comment 'Name of the official kit/apparel manufacturer (e.g., Nike, Adidas, Under Armour) relevant for jersey placement activations, as kit manufacturer approval may be required per CBA or league rules.' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketCategoryExclusivity rdf:type rdf:Property ;
    rdfs:label 'Market Category Exclusivity' ;
    rdfs:comment 'Indicates whether the sponsoring brand holds exclusive rights within this betting market category under this deal. Cannot reside on deal (which spans many categories) nor on betting_market (which is a shared catalog definition).' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:namingRights rdf:type rdf:Property ;
    rdfs:label 'Naming Rights' ;
    rdfs:comment 'Indicates whether this activation constitutes or is associated with a venue or event naming rights arrangement.' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:placementDimensions rdf:type rdf:Property ;
    rdfs:label 'Placement Dimensions' ;
    rdfs:comment 'Physical or pixel dimensions of the activation placement (e.g., \'3m x 1m\', \'728x90px\', \'30s airtime\'). Supports fulfillment verification and creative asset compliance.' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementLocation rdf:type rdf:Property ;
    rdfs:label 'Placement Location' ;
    rdfs:comment 'Specific physical or digital location of the activation (e.g., \'North End Zone LED Board Row 1\', \'Left Sleeve\', \'Pre-Roll Slot — ESPN OTT\', \'Homepage Banner Position 1\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proofOfPerformanceUrl rdf:type rdf:Property ;
    rdfs:label 'Proof Of Performance Url' ;
    rdfs:comment 'URL or DAM (Digital Asset Management) reference link to the proof-of-performance documentation (photos, broadcast clips, screenshots) confirming activation delivery.' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleTeam rdf:type rdf:Property ;
    rdfs:label 'Responsible Team' ;
    rdfs:comment 'Internal business team or department accountable for delivering this activation (e.g., \'Broadcast Partnerships\', \'In-Venue Operations\', \'Digital Marketing\', \'Merchandise & Licensing\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Sponsor Approval Status' ;
    rdfs:comment 'Status of the sponsor\'s review and approval of the activation creative assets and placement specifications prior to delivery.' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorApprovedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sponsor Approved Timestamp' ;
    rdfs:comment 'Date and time when the sponsor formally approved the activation creative and placement specifications.' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sponsorshipActivationCategory rdf:type rdf:Property ;
    rdfs:label 'Sponsorship Activation Category' ;
    rdfs:comment 'High-level classification of the activation type. [ENUM-REF-CANDIDATE: in_venue_signage|jersey_placement|broadcast_billboard|virtual_led_overlay|sponsored_segment|branded_replay|digital_banner|social_media_post|experiential|naming_rights_display|pa_announcement|led_perimeter_board|halftime_show_integration|broadcast_integration — promote to reference product]' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:virtualOverlay rdf:type rdf:Property ;
    rdfs:label 'Virtual Overlay' ;
    rdfs:comment 'Indicates whether this activation uses virtual LED overlay technology (digitally inserted signage visible only in broadcast, not physically present in venue).' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:visibilityTier rdf:type rdf:Property ;
    rdfs:label 'Visibility Tier' ;
    rdfs:comment 'Commercial tier indicating the prominence and audience reach of the placement (Premium = highest visibility/CPM, Standard, Value = lowest).' ;
    rdfs:domain ind:SponsorshipActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activationFulfillmentId rdf:type rdf:Property ;
    rdfs:label 'Activation Fulfillment Id' ;
    rdfs:comment 'Unique surrogate identifier for each brand activation fulfillment record in the sponsorship domain. Primary key for this transactional entity.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primarySponsorshipActivationId rdf:type rdf:Property ;
    rdfs:label 'Primary Sponsorship Activation Id' ;
    rdfs:comment 'Reference to the parent brand activation deliverable that this fulfillment record is executing against. Links fulfillment to the contracted activation obligation.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SponsorshipActivation .

ind:verifyingEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Verifying Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Proof-of-performance verification: activation_fulfillment requires a traceable employee sign-off for sponsor billing, compliance audits, and make-good disputes. \'verified_by\' is a denormalized name; F' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:audienceReach rdf:type rdf:Property ;
    rdfs:label 'Audience Reach' ;
    rdfs:comment 'Estimated number of unique individuals reached by this activation fulfillment, distinct from total impressions which may count repeat exposures. Used alongside GRP to calculate frequency and assess campaign effectiveness.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brandSafetyCompliant rdf:type rdf:Property ;
    rdfs:label 'Brand Safety Compliant' ;
    rdfs:comment 'Indicates whether the activation fulfillment met all brand safety requirements as defined in the sponsorship contract (e.g., no adjacency to prohibited content, correct placement context). Critical for broadcast and digital channel fulfillments.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastLogTimestamp rdf:type rdf:Property ;
    rdfs:label 'Broadcast Log Timestamp' ;
    rdfs:comment 'The precise timestamp recorded in the broadcast transmission log (Dalet Galaxy) confirming the exact air time of the sponsored content or advertisement. Used for broadcast fulfillment verification and FCC compliance documentation.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cpmRealized rdf:type rdf:Property ;
    rdfs:label 'Cpm Realized' ;
    rdfs:comment 'The effective Cost Per Mille (CPM) achieved based on actual impressions delivered versus the contracted value. Calculated as (contract_value / impressions_delivered) * 1000. Used in ROI reporting and renewal pricing benchmarking.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fulfillmentQualityRating rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Quality Rating' ;
    rdfs:comment 'Numeric quality score (1.0 to 5.0) assigned to this activation fulfillment based on placement prominence, brand safety compliance, creative execution fidelity, and audience alignment. Used in sponsor satisfaction reporting and renewal scoring.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fulfillmentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for this fulfillment record, used in proof-of-performance reports, sponsor invoices, and renewal negotiations. Format: ACT-FUL-YYYYMMDD-XXXX.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfillmentValueUsd rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Value Usd' ;
    rdfs:comment 'The monetary value attributed to this specific activation fulfillment in US Dollars, derived from the contracted rate and delivered impressions. Used for revenue recognition, sponsor invoicing, and EBITDA reporting under SAP S/4HANA FI/CO.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grpAchieved rdf:type rdf:Property ;
    rdfs:label 'Grp Achieved' ;
    rdfs:comment 'Actual Gross Rating Points (GRP) delivered for this activation fulfillment as reported by the audience measurement provider. Compared against grp_contracted to determine fulfillment compliance and trigger make-good obligations.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:makegoodRequired rdf:type rdf:Property ;
    rdfs:label 'Makegood Required' ;
    rdfs:comment 'Indicates whether a make-good (compensatory activation) is required due to under-delivery against contracted impressions or GRP targets. True triggers a make-good workflow in Salesforce CRM for scheduling a replacement activation.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:proofOfPlayReference rdf:type rdf:Property ;
    rdfs:label 'Proof Of Play Reference' ;
    rdfs:comment 'Unique identifier or URI pointing to the proof-of-performance artifact (e.g., screenshot filename, broadcast log timestamp key, photo asset ID in DAM, or OTT stream clip reference). Used to substantiate fulfillment claims in sponsor reporting and dispute resolution.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proofType rdf:type rdf:Property ;
    rdfs:label 'Proof Type' ;
    rdfs:comment 'Classification of the proof-of-performance artifact submitted for this fulfillment. Determines the verification workflow and the level of evidentiary weight assigned during sponsor audit or dispute resolution.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortfallImpressions rdf:type rdf:Property ;
    rdfs:label 'Shortfall Impressions' ;
    rdfs:comment 'The gap between contracted impressions and delivered impressions (impressions_contracted minus impressions_delivered). Positive values indicate under-delivery triggering make-good obligations. Zero or negative values indicate full or over-delivery.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shortfallNotes rdf:type rdf:Property ;
    rdfs:label 'Shortfall Notes' ;
    rdfs:comment 'Free-text explanation of any under-delivery or fulfillment gap, including root cause (e.g., event cancellation, broadcast preemption, technical failure, weather). Used in sponsor communications, make-good planning, and renewal negotiations.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorAcknowledged rdf:type rdf:Property ;
    rdfs:label 'Sponsor Acknowledged' ;
    rdfs:comment 'Indicates whether the sponsor has formally acknowledged and accepted this fulfillment record as proof-of-performance. True enables revenue recognition and closes the fulfillment obligation in SAP S/4HANA.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sponsorAcknowledgementDate rdf:type rdf:Property ;
    rdfs:label 'Sponsor Acknowledgement Date' ;
    rdfs:comment 'Date on which the sponsor formally acknowledged and accepted the fulfillment proof-of-performance. Nullable until acknowledgement is received. Used as the trigger date for revenue recognition and invoice generation.' ;
    rdfs:domain ind:ActivationFulfillment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assetValuationId rdf:type rdf:Property ;
    rdfs:label 'Asset Valuation Id' ;
    rdfs:comment 'Unique surrogate identifier for each sponsorship asset valuation record in the silver layer lakehouse.' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByAssetValuationId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Asset Valuation Id' ;
    rdfs:comment 'Reference to the newer asset_valuation record that replaces this one when a revised valuation is issued. Enables full valuation history and audit trail for a given asset.' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AssetValuation .

ind:assessedValue rdf:type rdf:Property ;
    rdfs:label 'Assessed Value' ;
    rdfs:comment 'The independently assessed fair market value of the sponsorship asset per unit (e.g., per season, per event, per broadcast slot). Principal quantitative fact of this record. Used to price new deals and validate ROI claims.' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastAirtimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Broadcast Airtime Seconds' ;
    rdfs:comment 'Total broadcast airtime in seconds attributed to this asset in the valuation period, used specifically in broadcast equivalency methodology calculations.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:comparableDealReference rdf:type rdf:Property ;
    rdfs:label 'Comparable Deal Reference' ;
    rdfs:comment 'Reference to a comparable sponsorship deal or industry benchmark transaction used to support the valuation (e.g., deal code, IEG benchmark ID). Applicable when methodology is \'comparable_deal\'.' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalPlatformFlag rdf:type rdf:Property ;
    rdfs:label 'Digital Platform Flag' ;
    rdfs:comment 'Indicates whether this valuation covers a digital or OTT platform sponsorship asset (e.g., app sponsorship, DTC streaming overlay, social media integration). Requires DRM compliance assessment.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusivityCategory rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Category' ;
    rdfs:comment 'The product or industry category for which exclusivity is granted as part of this asset valuation (e.g., \'Automotive\', \'Financial Services\', \'Telecommunications\'). Exclusivity commands a premium in the assessed value.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryBenchmarkCpm rdf:type rdf:Property ;
    rdfs:label 'Industry Benchmark Cpm' ;
    rdfs:comment 'The prevailing industry CPM benchmark rate used as a reference point in this valuation, sourced from Nielsen, IEG, or comparable market data. Enables variance analysis between assessed value and market norms.' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:industryBenchmarkGrp rdf:type rdf:Property ;
    rdfs:label 'Industry Benchmark Grp' ;
    rdfs:comment 'The prevailing industry GRP benchmark used as a reference point in this valuation. Enables variance analysis between the asset\'s GRP delivery and market norms for broadcast and media assets.' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jerseySponsorshipFlag rdf:type rdf:Property ;
    rdfs:label 'Jersey Sponsorship Flag' ;
    rdfs:comment 'Indicates whether this valuation pertains to a jersey or kit sponsorship asset (front-of-shirt, sleeve patch, training kit). Jersey valuations are subject to league CBA and kit manufacturer approval.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:namingRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Naming Rights Flag' ;
    rdfs:comment 'Indicates whether this valuation pertains to a naming rights asset (stadium, arena, or event naming rights). Naming rights valuations require additional IP rights and legal review.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nilRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Nil Rights Flag' ;
    rdfs:comment 'Indicates whether this valuation includes Name, Image, and Likeness (NIL) rights for athlete-linked sponsorship assets. NIL valuations require athlete consent and compliance with applicable NIL regulations.' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valuationCode rdf:type rdf:Property ;
    rdfs:label 'Valuation Code' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to this valuation engagement, used in agency correspondence, audit trails, and deal documentation.' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationMethodology rdf:type rdf:Property ;
    rdfs:label 'Valuation Methodology' ;
    rdfs:comment 'The analytical approach used to derive the assessed market value. Broadcast equivalency converts airtime to equivalent advertising cost; Nielsen media value uses proprietary audience measurement; independent agency applies third-party appraisal. [ENUM-REF-CANDIDATE: broadcast_equivalency|nielsen_media_value|independent_agency|cpm_benchmark|grp_benchmark|comparable_deal — promote to reference product]' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationNotes rdf:type rdf:Property ;
    rdfs:label 'Valuation Notes' ;
    rdfs:comment 'Free-text notes from the valuation analyst or approver capturing assumptions, caveats, market conditions, or special circumstances that influenced the assessed value.' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationReportReference rdf:type rdf:Property ;
    rdfs:label 'Valuation Report Reference' ;
    rdfs:comment 'Document reference or URL to the full valuation report issued by the valuation source (e.g., Nielsen report ID, agency PDF URL in DAM). Used for audit, legal review, and sponsor ROI substantiation.' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationSource rdf:type rdf:Property ;
    rdfs:label 'Valuation Source' ;
    rdfs:comment 'Name of the entity or system that produced this valuation (e.g., \'Nielsen Sports\', \'Repucom\', \'Joyce Julius\', \'Internal Revenue Management Team\', \'Workday Adaptive Planning\'). Used to assess credibility and independence of the valuation.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationSourceType rdf:type rdf:Property ;
    rdfs:label 'Valuation Source Type' ;
    rdfs:comment 'Classification of the valuation source as internal (produced by the organization\'s own revenue team) or external (independent agency, league-mandated, broadcast partner). Affects credibility weighting in ROI claims.' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationStatus rdf:type rdf:Property ;
    rdfs:label 'Valuation Status' ;
    rdfs:comment 'Current lifecycle state of this valuation record. \'approved\' valuations are used for deal pricing and ROI reporting; \'superseded\' records are retained for audit history.' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationUnit rdf:type rdf:Property ;
    rdfs:label 'Valuation Unit' ;
    rdfs:comment 'The unit basis against which the assessed value is expressed (e.g., per season, per event, per broadcast slot). Essential for normalizing comparisons across asset types and deal structures. [ENUM-REF-CANDIDATE: per_season|per_event|per_broadcast_slot|per_impression|per_year|per_match|per_activation — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastIntegrationId rdf:type rdf:Property ;
    rdfs:label 'Broadcast Integration Id' ;
    rdfs:comment 'Unique surrogate identifier for each sponsor broadcast integration record within the sponsorship domain. Primary key for this master record.' ;
    rdfs:domain ind:BroadcastIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalIntegrationBroadcastIntegrationId rdf:type rdf:Property ;
    rdfs:label 'Original Integration Broadcast Integration Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the original broadcast integration record that this make-good placement is compensating for. Populated only when make_good_flag is True, enabling fulfillment lineage tracking.' ;
    rdfs:domain ind:BroadcastIntegration ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BroadcastIntegration .

ind:traffickingEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Trafficking Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Broadcast trafficking ownership: broadcast_integration has a \'trafficking_deadline\' requiring a named employee responsible for delivering creative assets to broadcast networks. Trafficking employee ac' ;
    rdfs:domain ind:BroadcastIntegration ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assetApproved rdf:type rdf:Property ;
    rdfs:label 'Asset Approved' ;
    rdfs:comment 'Indicates whether the sponsor\'s creative asset for this broadcast integration has been reviewed and approved by the broadcast production team and compliance review process prior to airing.' ;
    rdfs:domain ind:BroadcastIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastWindow rdf:type rdf:Property ;
    rdfs:label 'Broadcast Window' ;
    rdfs:comment 'The designated programming window within the broadcast production during which the sponsor integration is scheduled to appear (e.g., pre-game, in-game, halftime, post-game). Drives production scheduling and sponsor fulfillment tracking. [ENUM-REF-CANDIDATE: pre_game|in_game|halftime|post_game|pre_show|intermission|overtime|replay_window — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:BroadcastIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedAudienceSize rdf:type rdf:Property ;
    rdfs:label 'Estimated Audience Size' ;
    rdfs:comment 'The projected number of viewers expected to be reached by this broadcast integration based on historical ratings, Nielsen data, or platform subscriber counts. Used for CPM (Cost Per Mille) pricing and sponsor ROI (Return on Investment) projections.' ;
    rdfs:domain ind:BroadcastIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geoMarket rdf:type rdf:Property ;
    rdfs:label 'Geo Market' ;
    rdfs:comment 'The geographic market or territory in which this broadcast integration is authorized to air (e.g., USA, GBR, CAN, or a specific DMA/regional market). Governs territorial rights compliance for sponsor activations across global broadcast distributions.' ;
    rdfs:domain ind:BroadcastIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionInBreak rdf:type rdf:Property ;
    rdfs:label 'Position In Break' ;
    rdfs:comment 'The sequential position of the sponsor integration within a commercial break or programming segment (e.g., 1 = first position, 2 = second position). First and last positions typically command premium CPM (Cost Per Mille) rates.' ;
    rdfs:domain ind:BroadcastIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduledAirDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Air Date' ;
    rdfs:comment 'The calendar date on which the broadcast integration is scheduled to air. Used for production planning, sponsor fulfillment tracking, and post-air reporting.' ;
    rdfs:domain ind:BroadcastIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:traffickingDeadline rdf:type rdf:Property ;
    rdfs:label 'Trafficking Deadline' ;
    rdfs:comment 'The deadline by which the sponsor\'s creative assets must be delivered and approved in the trafficking system (Dalet Galaxy) to meet the scheduled air date. Drives sponsor asset delivery SLA management.' ;
    rdfs:domain ind:BroadcastIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:virtualOverlayZone rdf:type rdf:Property ;
    rdfs:label 'Virtual Overlay Zone' ;
    rdfs:comment 'For virtual LED overlay integration types, specifies the on-screen zone where the digital sponsor overlay is rendered (e.g., perimeter board, pitch-side, end zone). Relevant for virtual advertising technology deployments in live sports broadcasts.' ;
    rdfs:domain ind:BroadcastIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractingCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Contracting Corporate Entity Id' ;
    rdfs:comment 'Foreign key linking to legal.corporate_entity. Business justification: Sponsorship deals are executed by a specific legal corporate entity (league holding company, franchise subsidiary). SOX revenue recognition, intercompany accounting, and legal enforceability require i' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:activationDeliverablesSummary rdf:type rdf:Property ;
    rdfs:label 'Activation Deliverables Summary' ;
    rdfs:comment 'High-level summary of the key activation deliverables committed under this deal (e.g., jersey patch, LED signage, broadcast mentions, social media posts, hospitality packages). Supports fulfillment tracking and partner reporting.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:audienceCommitmentSize rdf:type rdf:Property ;
    rdfs:label 'Audience Commitment Size' ;
    rdfs:comment 'The contractually committed number of fan profiles from this segment that the deal is obligated to reach during the targeting flight window. This is a per-segment-per-deal contractual figure that belongs to the targeting relationship, not to the deal total or the segment\'s overall fan_count.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:audienceDeliveryStatus rdf:type rdf:Property ;
    rdfs:label 'Audience Delivery Status' ;
    rdfs:comment 'Current fulfillment state of the audience commitment for this segment-deal pairing. Tracks whether the contractual audience reach obligation is being met. Belongs to the targeting relationship — a segment may be fully delivered under one deal while underdelivered under another simultaneously.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastMentionRequirement rdf:type rdf:Property ;
    rdfs:label 'Broadcast Mention Requirement' ;
    rdfs:comment 'Contractual specification for how and how often the sponsor or named asset must be verbally or visually referenced during broadcast coverage (e.g., \'Minimum 3 verbal mentions per broadcast hour\'). Applicable to naming rights and broadcast integration deals.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:campaignFlightEndDate rdf:type rdf:Property ;
    rdfs:label 'Campaign Flight End Date' ;
    rdfs:comment 'End date of the active campaign flight period for digital partnership activations. Defines the window during which impression and CTR commitments must be fulfilled.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:campaignFlightStartDate rdf:type rdf:Property ;
    rdfs:label 'Campaign Flight Start Date' ;
    rdfs:comment 'Start date of the active campaign flight period for digital partnership activations. May differ from the overall deal start date if the digital campaign runs within a sub-window of the contract term.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Contract Document Reference' ;
    rdfs:comment 'Reference identifier or URL to the executed contract document stored in the document management system. Enables audit trail and legal review access for SOX and SEC compliance.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ctrTarget rdf:type rdf:Property ;
    rdfs:label 'Ctr Target' ;
    rdfs:comment 'Contractually committed click-through rate target for digital sponsorship activations, expressed as a decimal proportion (e.g., 0.0250 = 2.50%). Applicable to digital platform partnership deals. Used for performance benchmarking and ROI reporting.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataSharingConsentScope rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Consent Scope' ;
    rdfs:comment 'GDPR/CCPA-compliant scope of fan data that may be shared with the sponsor under this deal. Governs data exchange in digital platform partnerships and Adobe Experience Platform personalization activations. Values: none, anonymized_aggregate, pseudonymized, identified_opt_in, full_consent.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalPartnershipType rdf:type rdf:Property ;
    rdfs:label 'Digital Partnership Type' ;
    rdfs:comment 'Sub-classification of digital platform partnership deals. Specifies the nature of the digital activation: app title sponsor, OTT streaming sponsor, social media co-branding, DTC campaign integration, API data partnership, or Adobe Experience Platform personalization. Values: app_title_sponsor, ott_streaming_sponsor, social_media_co_branding, dtc_campaign_integration, api_data_partnership, adobe_personalization.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalPropertyUrl rdf:type rdf:Property ;
    rdfs:label 'Digital Property Url' ;
    rdfs:comment 'Web URL of the digital property associated with the deal, such as a renamed stadium website, OTT platform landing page, or DTC campaign microsite. Applicable to naming rights and digital platform partnership deals.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Executed Timestamp' ;
    rdfs:comment 'Date and time at which the sponsorship deal was formally executed (signed by all parties). Represents the principal business event timestamp for this agreement. Used for revenue recognition and legal effective date tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:grpCommitment rdf:type rdf:Property ;
    rdfs:label 'Grp Commitment' ;
    rdfs:comment 'Total Gross Rating Points (GRP) committed to the sponsor for broadcast and media activations under this deal. GRP = Reach % × Frequency. Used for broadcast integration performance tracking and ROI reporting.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hospitalityEntitlements rdf:type rdf:Property ;
    rdfs:label 'Hospitality Entitlements' ;
    rdfs:comment 'Description of VIP hospitality entitlements included in the deal (e.g., number of suite tickets, GA tickets, VIP passes, meet-and-greet access per event). Managed through Archtics venue inventory.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impressionCommitment rdf:type rdf:Property ;
    rdfs:label 'Impression Commitment' ;
    rdfs:comment 'Total number of guaranteed digital or broadcast impressions committed to the sponsor under the deal terms. Used for CPM and GRP performance tracking and ROI reporting.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:namedAsset rdf:type rdf:Property ;
    rdfs:label 'Named Asset' ;
    rdfs:comment 'For venue naming rights deals: the specific asset whose name is being licensed to the sponsor (e.g., stadium, arena, practice facility, trophy, award, league division). Null or \'none\' for non-naming-rights deal types. [ENUM-REF-CANDIDATE: stadium|arena|practice_facility|trophy|award|league_division|none — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilRightsIncluded rdf:type rdf:Property ;
    rdfs:label 'Nil Rights Included' ;
    rdfs:comment 'Indicates whether the deal includes Name, Image, and Likeness (NIL) rights for athletes or talent associated with the sponsoring entity\'s activations. Relevant for athlete endorsement components of sponsorship deals.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalOptionDeadline rdf:type rdf:Property ;
    rdfs:label 'Renewal Option Deadline' ;
    rdfs:comment 'Date by which the sponsor must exercise their contractual renewal option. Null if renewal_option_flag is false. Drives CRM renewal pipeline alerts in Salesforce.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalOptionTerms rdf:type rdf:Property ;
    rdfs:label 'Renewal Option Terms' ;
    rdfs:comment 'Summary description of the contractual renewal option terms, including any escalation clauses, right-of-first-refusal conditions, or pricing adjustments applicable upon renewal.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salesforceOpportunityCode rdf:type rdf:Property ;
    rdfs:label 'Salesforce Opportunity Code' ;
    rdfs:comment 'Reference to the originating opportunity record in Salesforce CRM (Fan and Sponsor Relationship Management). Enables traceability from prospecting through deal execution.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signageSpecification rdf:type rdf:Property ;
    rdfs:label 'Signage Specification' ;
    rdfs:comment 'Description of physical or digital signage deliverables committed under the deal, including placement locations, dimensions, and display frequency (e.g., \'LED perimeter board, 4 placements, 30-second rotation\'). Applicable to venue and broadcast deals.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetingPriority rdf:type rdf:Property ;
    rdfs:label 'Targeting Priority' ;
    rdfs:comment 'The priority rank of this fan segment within the deal\'s overall audience targeting strategy. Indicates whether this segment is the primary audience commitment or a supplemental targeting layer. Belongs to the relationship, not to the deal or segment independently.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territory rdf:type rdf:Property ;
    rdfs:label 'Territory' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the primary territory in which the sponsorship deal is active and rights are granted. For multi-territory deals, references the primary market.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealAmendmentId rdf:type rdf:Property ;
    rdfs:label 'Deal Amendment Id' ;
    rdfs:comment 'Unique surrogate identifier for each deal amendment record in the sponsorship domain. Primary key for the deal_amendment data product.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentAmendmentDealAmendmentId rdf:type rdf:Property ;
    rdfs:label 'Parent Amendment Deal Amendment Id' ;
    rdfs:comment 'Self-referencing identifier linking this amendment to a prior amendment it supersedes or modifies. Enables reconstruction of the full amendment chain for a given deal. Null for first-generation amendments.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DealAmendment .

ind:amendedFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Amended Fee Amount' ;
    rdfs:comment 'The revised total sponsorship fee value as established by this amendment. Replaces the original fee amount upon amendment approval and execution.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amendedTermEndDate rdf:type rdf:Property ;
    rdfs:label 'Amended Term End Date' ;
    rdfs:comment 'The revised contract end date as established by a term extension amendment. Null for amendments that do not modify the deal term.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amendmentType rdf:type rdf:Property ;
    rdfs:label 'Amendment Type' ;
    rdfs:comment 'Classification of the nature of the amendment. Drives downstream processing logic and reporting segmentation. [ENUM-REF-CANDIDATE: fee_adjustment|term_extension|asset_swap|territory_expansion|force_majeure_relief|termination_partial|scope_reduction|payment_schedule_change — promote to reference product]' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentVersion rdf:type rdf:Property ;
    rdfs:label 'Amendment Version' ;
    rdfs:comment 'Sequential version number tracking revisions to this specific amendment record during the drafting and negotiation process. Supports amendment audit trail and version control.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approverTitle rdf:type rdf:Property ;
    rdfs:label 'Approver Title' ;
    rdfs:comment 'Job title or role of the approver at the time of amendment approval (e.g., VP of Partnerships, Chief Revenue Officer). Supports authorization level validation and audit compliance.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetSwapDescription rdf:type rdf:Property ;
    rdfs:label 'Asset Swap Description' ;
    rdfs:comment 'Narrative description of the sponsorship assets being exchanged in an asset_swap amendment (e.g., replacing jersey logo placement with LED perimeter board inventory). Populated only for asset_swap amendment types.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastRightsChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Change Flag' ;
    rdfs:comment 'Indicates whether this amendment modifies broadcast integration rights or OTT (Over-The-Top Streaming) / RSN (Regional Sports Network) placement entitlements within the sponsorship deal.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Flag' ;
    rdfs:comment 'Indicates whether this amendment has been reviewed for compliance with applicable regulations including GDPR, CCPA, PCI-DSS, WADA anti-doping provisions, and league governance rules (e.g., NFL, NBA, FIFA). Required for amendments involving data sharing, athlete NIL rights, or PED-related sponsor exclusions.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cpmRateAmended rdf:type rdf:Property ;
    rdfs:label 'Cpm Rate Amended' ;
    rdfs:comment 'The revised CPM (Cost Per Mille) rate applicable to digital and broadcast advertising inventory entitlements under this amendment. Null for amendments not affecting advertising inventory pricing.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:digitalPlatformChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Digital Platform Change Flag' ;
    rdfs:comment 'Indicates whether this amendment modifies digital platform partnership entitlements, including DTC (Direct-To-Consumer) channels, social media integrations, or API (Application Programming Interface) data sharing rights.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentReference rdf:type rdf:Property ;
    rdfs:label 'Document Reference' ;
    rdfs:comment 'Reference identifier or URL pointing to the executed amendment document stored in the DAM (Digital Asset Management) system or contract repository. Enables direct access to the legal document from the data record.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'External Reference Number' ;
    rdfs:comment 'The sponsor\'s own internal reference or purchase order number for this amendment, as provided by the sponsoring organization. Facilitates cross-system reconciliation and sponsor billing alignment.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeDeltaAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Delta Amount' ;
    rdfs:comment 'The net change in sponsorship fee resulting from this amendment (amended_fee_amount minus original_fee_amount). Positive values indicate fee increases; negative values indicate reductions. Used for revenue forecasting and EBITDA (Earnings Before Interest Taxes Depreciation and Amortization) impact analysis.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forceMajeureCategory rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Category' ;
    rdfs:comment 'Classification of the force majeure event type triggering a force_majeure_relief amendment. Supports insurance claims, regulatory reporting, and precedent analysis for future contract drafting.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grpImpactDelta rdf:type rdf:Property ;
    rdfs:label 'Grp Impact Delta' ;
    rdfs:comment 'The net change in GRP (Gross Rating Point) media value entitlements resulting from this amendment. Positive values indicate increased broadcast exposure; negative values indicate reduced exposure. Used for media value ROI (Return on Investment) reporting.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:legalReviewCompleted rdf:type rdf:Property ;
    rdfs:label 'Legal Review Completed' ;
    rdfs:comment 'Indicates whether the required legal review has been completed for this amendment. Must be true before approval_status can transition to approved when legal_review_required is true.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Legal Review Required' ;
    rdfs:comment 'Indicates whether this amendment requires formal legal counsel review before execution. Typically triggered by high-value fee adjustments, territory expansions, or force majeure provisions.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:namingRightsChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Naming Rights Change Flag' ;
    rdfs:comment 'Indicates whether this amendment modifies venue naming rights entitlements. Triggers downstream venue operations and facility management updates when true.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nilRightsChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Nil Rights Change Flag' ;
    rdfs:comment 'Indicates whether this amendment modifies NIL (Name Image and Likeness) rights provisions within the sponsorship deal. Relevant for athlete-linked sponsorship agreements.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Original Fee Amount' ;
    rdfs:comment 'The total contracted sponsorship fee value from the original executed deal prior to this amendment. Provides the baseline for calculating delta values and ROI (Return on Investment) impact.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalTermEndDate rdf:type rdf:Property ;
    rdfs:label 'Original Term End Date' ;
    rdfs:comment 'The original contract end date from the executed deal prior to any term extension amendments. Baseline for calculating term delta in extension amendments.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalTermStartDate rdf:type rdf:Property ;
    rdfs:label 'Original Term Start Date' ;
    rdfs:comment 'The original contract start date from the executed deal prior to any term extension amendments. Provides baseline for calculating term delta in extension amendments.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentScheduleChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Schedule Change Flag' ;
    rdfs:comment 'Indicates whether this amendment modifies the payment schedule or installment structure of the sponsorship deal, independent of fee amount changes. True when payment timing or frequency is altered.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sponsorCounterpartName rdf:type rdf:Property ;
    rdfs:label 'Sponsor Counterpart Name' ;
    rdfs:comment 'Name of the sponsor organization\'s authorized representative who executed the amendment on behalf of the sponsoring brand. Retained for legal and audit purposes.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termExtensionDays rdf:type rdf:Property ;
    rdfs:label 'Term Extension Days' ;
    rdfs:comment 'The number of calendar days by which the deal term is extended under this amendment. Populated only for term_extension amendment types. Supports renewal pipeline forecasting.' ;
    rdfs:domain ind:DealAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dealTermId rdf:type rdf:Property ;
    rdfs:label 'Deal Term Id' ;
    rdfs:comment 'Unique surrogate identifier for a sponsorship deal term record in the Silver Layer lakehouse. Primary key for this entity.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activationDeliverableCount rdf:type rdf:Property ;
    rdfs:label 'Activation Deliverable Count' ;
    rdfs:comment 'Total number of distinct brand activation deliverables committed under this deal term (e.g., in-venue signage placements, broadcast integrations, digital content pieces, hospitality events). Drives activation fulfillment tracking.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:broadcastIntegrationType rdf:type rdf:Property ;
    rdfs:label 'Broadcast Integration Type' ;
    rdfs:comment 'Specifies the type of broadcast integration deliverable included in this deal term. Virtual_led = virtual pitch-side LED branding; on_screen_graphic = branded lower-third or overlay; presenter_mention = verbal sponsor mention by broadcaster; sponsored_segment = branded content segment; halftime_show = halftime entertainment sponsorship; replay_sponsor = branded replay sequence. Null if term_type is not broadcast_integration.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Cash Fee Amount' ;
    rdfs:comment 'The portion of the total contract fee to be paid in cash by the sponsor. Distinguishes cash from Value-in-Kind (VIK) contributions for revenue recognition and EBITDA reporting purposes.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:escalationBasis rdf:type rdf:Property ;
    rdfs:label 'Escalation Basis' ;
    rdfs:comment 'The basis on which the escalation rate is calculated. Fixed_rate applies a predetermined percentage; cpi_linked ties escalation to the Consumer Price Index; revenue_linked ties it to the organization\'s revenue growth; negotiated means the rate is renegotiated at each interval.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationRatePct rdf:type rdf:Property ;
    rdfs:label 'Escalation Rate Pct' ;
    rdfs:comment 'Annual percentage rate by which the contract fee escalates over the term (e.g., 3.00 = 3% per annum). Supports multi-year deal modeling and SAP S/4HANA SD billing plan escalation configuration. Null if no escalation clause applies.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forceMajeureClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Clause Flag' ;
    rdfs:comment 'Indicates whether this deal term contains a force majeure clause that suspends or modifies obligations in the event of extraordinary circumstances beyond either party\'s control (e.g., pandemic, natural disaster, government prohibition of events). True = force majeure clause present.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grpDeliveryCommitment rdf:type rdf:Property ;
    rdfs:label 'Grp Delivery Commitment' ;
    rdfs:comment 'The contractually committed Gross Rating Point (GRP) delivery target for broadcast or media placements associated with this deal term. GRP measures the total advertising weight delivered to the target audience. Used for ROI tracking and make-good calculations.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceMilestoneCount rdf:type rdf:Property ;
    rdfs:label 'Invoice Milestone Count' ;
    rdfs:comment 'Total number of billing milestones or invoice installments defined under this deal term\'s payment schedule. Used to validate completeness of the SAP S/4HANA SD billing plan and track invoicing progress.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ipRightsGrantedFlag rdf:type rdf:Property ;
    rdfs:label 'Ip Rights Granted Flag' ;
    rdfs:comment 'Indicates whether this deal term grants the sponsor rights to use the organization\'s Intellectual Property (IP) — including logos, trademarks, athlete likenesses, and league marks — in their own marketing and advertising. True = IP rights granted; False = no IP rights granted. Relevant to NIL (Name, Image, and Likeness) compliance.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jerseyPlacementLocation rdf:type rdf:Property ;
    rdfs:label 'Jersey Placement Location' ;
    rdfs:comment 'Specifies the physical location on the team kit where the sponsor\'s branding is placed under a jersey sponsorship deal term. Null if term_type is not jersey_sponsorship. [ENUM-REF-CANDIDATE: front_chest|back_upper|sleeve_left|sleeve_right|collar|shorts|training_kit|goalkeeper_kit — promote to reference product]' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:killClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Kill Clause Flag' ;
    rdfs:comment 'Indicates whether this deal term contains a kill clause (early termination right) that either party may invoke upon breach of defined thresholds. True = kill clause present; False = no kill clause.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:killClauseThreshold rdf:type rdf:Property ;
    rdfs:label 'Kill Clause Threshold' ;
    rdfs:comment 'Narrative description of the specific condition or metric threshold that triggers the kill clause (e.g., \'Sponsor brand NPS falls below 20\', \'Broadcast audience drops below 500,000 for 2 consecutive events\', \'Regulatory sanction imposed on either party\'). Null if kill_clause_flag is False.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latePaymentPenaltyRatePct rdf:type rdf:Property ;
    rdfs:label 'Late Payment Penalty Rate Pct' ;
    rdfs:comment 'Annual percentage rate applied to overdue sponsor payments as a contractual late payment penalty (e.g., 1.50 = 1.5% per annum on outstanding balance). Null if no late payment penalty clause exists. Used in SAP S/4HANA FI dunning configuration.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:namingRightsAsset rdf:type rdf:Property ;
    rdfs:label 'Naming Rights Asset' ;
    rdfs:comment 'Description of the specific asset (venue, stadium, arena, event, competition, or league) for which naming rights are granted under this deal term (e.g., \'Main Stadium — Exterior and Interior Branding\', \'Annual Championship Series\'). Null if term_type is not naming_rights.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilAthleteRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Nil Athlete Rights Flag' ;
    rdfs:comment 'Indicates whether this deal term specifically includes Name, Image, and Likeness (NIL) rights for one or more individual athletes, allowing the sponsor to use athlete identity in commercial activations. True = NIL rights included; False = no individual athlete NIL rights.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performanceBonusAmount rdf:type rdf:Property ;
    rdfs:label 'Performance Bonus Amount' ;
    rdfs:comment 'Additional monetary amount payable by the sponsor upon achievement of defined performance milestones (e.g., team reaching playoffs, broadcast audience exceeding GRP threshold, NPS target met). Null if no performance bonus clause exists.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceBonusTrigger rdf:type rdf:Property ;
    rdfs:label 'Performance Bonus Trigger' ;
    rdfs:comment 'Narrative description of the specific performance condition(s) that must be met to trigger the performance bonus payment (e.g., \'Team qualifies for championship final\', \'Broadcast CPM exceeds $25 for 3 consecutive quarters\', \'GRP delivery exceeds 500 in target demographic\').' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalOptionPeriods rdf:type rdf:Property ;
    rdfs:label 'Renewal Option Periods' ;
    rdfs:comment 'Number of additional renewal periods the sponsor may exercise under the renewal option clause (e.g., 2 = two additional one-year terms). Null if renewal_option_flag is False.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rofrFlag rdf:type rdf:Property ;
    rdfs:label 'Rofr Flag' ;
    rdfs:comment 'Indicates whether the sponsor holds a Right of First Refusal (ROFR) on the renewal of this deal term, giving them priority to match any competing offer before the rights are offered to a third party. True = ROFR granted; False = no ROFR.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sapBillingPlanType rdf:type rdf:Property ;
    rdfs:label 'Sap Billing Plan Type' ;
    rdfs:comment 'The SAP S/4HANA SD billing plan type code assigned to this deal term, controlling how and when invoices are generated (e.g., \'01\' for milestone billing, \'02\' for periodic billing). Directly maps to SAP billing plan configuration.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapContractNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Contract Number' ;
    rdfs:comment 'The SAP S/4HANA SD sales contract document number associated with this deal term, used for billing plan integration, invoice generation, and revenue recognition. Enables traceability between the lakehouse Silver Layer and the ERP system of record.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Term Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code for this deal term record, used in SAP S/4HANA SD billing and contract correspondence. Format: <ORG_CODE>-DT-<SEQUENCE>.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termStatus rdf:type rdf:Property ;
    rdfs:label 'Term Status' ;
    rdfs:comment 'Current lifecycle state of the deal term. Draft indicates terms under negotiation; active indicates binding and in-force; suspended indicates temporarily paused (e.g., force majeure); terminated indicates early exit via kill clause; expired indicates natural end-of-term; pending_renewal indicates renewal option under evaluation.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termType rdf:type rdf:Property ;
    rdfs:label 'Term Type' ;
    rdfs:comment 'Classification of the deal term by its commercial nature. Financial covers cash payment obligations; activation covers brand activation deliverables; naming_rights covers venue or event naming; broadcast_integration covers in-broadcast placements; digital_platform covers OTT/DTC digital integrations; jersey_sponsorship covers kit branding rights. [ENUM-REF-CANDIDATE: financial|activation|naming_rights|broadcast_integration|digital_platform|jersey_sponsorship|merchandise_licensing|hospitality — promote to reference product]' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalContractFee rdf:type rdf:Property ;
    rdfs:label 'Total Contract Fee' ;
    rdfs:comment 'Gross total monetary value of this deal term over its full effective period, expressed in the contract currency. Represents the face value of the sponsorship obligation before any escalation, bonus, or VIK adjustments. Key input for EBITDA and ARR reporting.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vikAmount rdf:type rdf:Property ;
    rdfs:label 'Vik Amount' ;
    rdfs:comment 'The portion of the total contract fee fulfilled through non-cash Value-in-Kind (VIK) contributions such as goods, services, media inventory, or hospitality provided by the sponsor. Tracked separately from cash for accounting and ROI analysis.' ;
    rdfs:domain ind:DealTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vikDescription rdf:type rdf:Property ;
    rdfs:label 'Vik Description' ;
    rdfs:comment 'Narrative description of the non-cash Value-in-Kind (VIK) goods or services provided by the sponsor as part of their contractual obligation (e.g., \'Official airline partner — 500 business class flights per season\', \'Official vehicle fleet — 50 SUVs for event logistics\').' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalPartnershipId rdf:type rdf:Property ;
    rdfs:label 'Digital Partnership Id' ;
    rdfs:comment 'Unique surrogate identifier for the digital partnership record in the Sports Entertainment lakehouse silver layer.' ;
    rdfs:domain ind:DigitalPartnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activationChannel rdf:type rdf:Property ;
    rdfs:label 'Activation Channel' ;
    rdfs:comment 'The primary digital channel through which the sponsorship activation is delivered to fans and users (e.g., web, mobile app, OTT streaming, social media, email, podcast, API, push notification). [ENUM-REF-CANDIDATE: web|mobile_app|ott_streaming|social_media|email|podcast|api|push_notification — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandSafetyTier rdf:type rdf:Property ;
    rdfs:label 'Brand Safety Tier' ;
    rdfs:comment 'The brand safety protection tier applied to this digital partnership, defining the content adjacency controls and contextual targeting restrictions to protect the sponsor\'s brand reputation.' ;
    rdfs:domain ind:DigitalPartnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ccpaOptOutHonoured rdf:type rdf:Property ;
    rdfs:label 'Ccpa Opt Out Honoured' ;
    rdfs:comment 'Indicates whether California Consumer Privacy Act (CCPA) consumer opt-out signals are contractually honoured and technically enforced for fan data shared under this digital partnership.' ;
    rdfs:domain ind:DigitalPartnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contentRightsIncluded rdf:type rdf:Property ;
    rdfs:label 'Content Rights Included' ;
    rdfs:comment 'Indicates whether the digital partnership includes rights to use Sports Entertainment content (highlights, athlete imagery, league IP) in the sponsor\'s own digital marketing activations.' ;
    rdfs:domain ind:DigitalPartnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dealCurrency rdf:type rdf:Property ;
    rdfs:label 'Deal Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the deal value (e.g., USD, GBP, EUR).' ;
    rdfs:domain ind:DigitalPartnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealValue rdf:type rdf:Property ;
    rdfs:label 'Deal Value' ;
    rdfs:comment 'Total contracted monetary value of the digital partnership agreement in the deal currency. Represents gross committed spend by the sponsor.' ;
    rdfs:domain ind:DigitalPartnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flightEndDate rdf:type rdf:Property ;
    rdfs:label 'Flight End Date' ;
    rdfs:comment 'The date on which the digital partnership campaign activation ends. Nullable for open-ended or evergreen partnerships.' ;
    rdfs:domain ind:DigitalPartnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:flightStartDate rdf:type rdf:Property ;
    rdfs:label 'Flight Start Date' ;
    rdfs:comment 'The date on which the digital partnership campaign activation begins and impressions/placements start being served.' ;
    rdfs:domain ind:DigitalPartnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gdprDpaReference rdf:type rdf:Property ;
    rdfs:label 'Gdpr Dpa Reference' ;
    rdfs:comment 'Reference number or identifier of the executed GDPR Data Processing Agreement (DPA) with the sponsor, required when personal fan data is shared under this digital partnership.' ;
    rdfs:domain ind:DigitalPartnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:makeGoodRequired rdf:type rdf:Property ;
    rdfs:label 'Make Good Required' ;
    rdfs:comment 'Indicates whether a make-good (compensatory additional inventory or credits) is required due to under-delivery of contracted digital impressions or GRP commitments.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partnershipName rdf:type rdf:Property ;
    rdfs:label 'Partnership Name' ;
    rdfs:comment 'Human-readable commercial name for the digital partnership (e.g., \'Acme Corp OTT Streaming Sponsorship — 2024 Season\').' ;
    rdfs:domain ind:DigitalPartnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partnershipNumber rdf:type rdf:Property ;
    rdfs:label 'Partnership Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code for this digital partnership, used in CRM, invoicing, and partner-facing communications (e.g., DP-2024-AB1234).' ;
    rdfs:domain ind:DigitalPartnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partnershipType rdf:type rdf:Property ;
    rdfs:label 'Partnership Type' ;
    rdfs:comment 'Category of digital partnership describing the nature of the commercial arrangement. [ENUM-REF-CANDIDATE: app_title_sponsor|website_banner|ott_streaming_sponsor|social_media_co_branding|dtc_campaign_integration|api_data_partnership|adobe_aep_personalization|email_newsletter_sponsor|podcast_sponsor|esports_integration — promote to reference product]' ;
    rdfs:domain ind:DigitalPartnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Deadline Date' ;
    rdfs:comment 'The date by which the sponsor must exercise their renewal option. Null if no renewal option exists. Used by the commercial team to manage pipeline and avoid lapse.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:roiTargetPct rdf:type rdf:Property ;
    rdfs:label 'Roi Target Pct' ;
    rdfs:comment 'Internally agreed Return on Investment (ROI) target percentage for this digital partnership, used to benchmark actual performance against commercial expectations.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entitlementRedemptionId rdf:type rdf:Property ;
    rdfs:label 'Entitlement Redemption Id' ;
    rdfs:comment 'Unique surrogate identifier for each VIP hospitality entitlement redemption transaction record in the sponsorship domain.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parkingPassId rdf:type rdf:Property ;
    rdfs:label 'Parking Pass Id' ;
    rdfs:comment 'Foreign key linking to ticketing.parking_pass. Business justification: Sponsor hospitality parking fulfillment: sponsor contracts commonly include parking passes as part of hospitality entitlements. Linking entitlement_redemption to the issued parking_pass enables comple' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ParkingPass .

ind:sponsorContactId rdf:type rdf:Property ;
    rdfs:label 'Sponsor Contact Id' ;
    rdfs:comment 'Reference to the CRM contact record for the sponsor representative who redeemed the entitlement, enabling relationship history tracking.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SponsorContact .

ind:balanceReinstated rdf:type rdf:Property ;
    rdfs:label 'Balance Reinstated' ;
    rdfs:comment 'Indicates whether the entitlement units from a cancelled or no-show redemption have been reinstated to the sponsor\'s available balance, enabling accurate entitlement balance tracking.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cancellationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cancellation Timestamp' ;
    rdfs:comment 'Date and time at which the redemption was cancelled, used for SLA compliance measurement and entitlement balance reinstatement processing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:checkOutTimestamp rdf:type rdf:Property ;
    rdfs:label 'Check Out Timestamp' ;
    rdfs:comment 'Date and time the sponsor representative exited the venue or hospitality area, used for dwell-time analysis and VIP experience quality measurement.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataPrivacyRegion rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Region' ;
    rdfs:comment 'Regulatory jurisdiction applicable to the sponsor contact\'s personal data captured in this redemption record, determining which privacy framework (GDPR, CCPA, etc.) governs data handling.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entitlementFairValue rdf:type rdf:Property ;
    rdfs:label 'Entitlement Fair Value' ;
    rdfs:comment 'Estimated monetary fair value of the entitlement units redeemed in this transaction, used for ROI (Return on Investment) tracking, deal valuation, and financial reporting under SOX and GAAP.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entitlementSubtype rdf:type rdf:Property ;
    rdfs:label 'Entitlement Subtype' ;
    rdfs:comment 'Further classification within the entitlement type, such as \'pre-game field access\' under field_pass or \'executive suite\' under suite_access, enabling granular fulfillment tracking.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfillmentConfirmed rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Confirmed' ;
    rdfs:comment 'Indicates whether the entitlement redemption has been formally confirmed as fulfilled by the account management team, used for proof-of-performance reporting and deal compliance.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gdprConsentCaptured rdf:type rdf:Property ;
    rdfs:label 'Gdpr Consent Captured' ;
    rdfs:comment 'Indicates whether explicit GDPR consent was obtained from the sponsor contact for processing their personal data in connection with this redemption, required for EU market operations.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:guestCount rdf:type rdf:Property ;
    rdfs:label 'Guest Count' ;
    rdfs:comment 'Total number of guests (including the sponsor contact) who attended under this redemption, used for hospitality capacity planning and VIP experience reporting.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:proofOfRedemptionUrl rdf:type rdf:Property ;
    rdfs:label 'Proof Of Redemption Url' ;
    rdfs:comment 'URL link to supporting documentation or media (photo, scan log, digital confirmation) evidencing that the entitlement was redeemed, stored in the Digital Asset Management (DAM) system.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityContracted rdf:type rdf:Property ;
    rdfs:label 'Quantity Contracted' ;
    rdfs:comment 'Total number of entitlement units of this type allocated to the sponsor under the deal for the event or season, providing the baseline for balance tracking.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quantityRemaining rdf:type rdf:Property ;
    rdfs:label 'Quantity Remaining' ;
    rdfs:comment 'Number of entitlement units of this type still available to the sponsor after this redemption, calculated at the time of redemption for point-in-time balance reporting.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:redemptionChannel rdf:type rdf:Property ;
    rdfs:label 'Redemption Channel' ;
    rdfs:comment 'The channel through which the sponsor representative submitted or activated the entitlement redemption (e.g., self-service online portal, account manager facilitation, on-site at venue). Informs digital adoption and service model analysis.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redemptionDate rdf:type rdf:Property ;
    rdfs:label 'Redemption Date' ;
    rdfs:comment 'Calendar date on which the entitlement was redeemed, used for day-level reporting, entitlement balance reconciliation, and renewal package analysis.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:redemptionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Redemption Reference Number' ;
    rdfs:comment 'Externally visible alphanumeric reference code assigned to this redemption transaction, used for confirmation communications and sponsor portal lookups.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redemptionStatus rdf:type rdf:Property ;
    rdfs:label 'Redemption Status' ;
    rdfs:comment 'Current lifecycle state of the entitlement redemption. \'confirmed\' indicates the redemption was validated and used; \'no_show\' indicates the entitlement was reserved but the guest did not attend; \'partially_used\' indicates only a subset of the redeemed quantity was consumed.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:satisfactionComments rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Comments' ;
    rdfs:comment 'Free-text qualitative feedback provided by the sponsor representative following the redemption experience, used for hospitality quality improvement and account management.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:satisfactionRating rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Rating' ;
    rdfs:comment 'Post-redemption satisfaction score provided by the sponsor representative, typically on a 1–10 scale. Feeds into Net Promoter Score (NPS) analysis and informs renewal package design.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specialAccommodationNotes rdf:type rdf:Property ;
    rdfs:label 'Special Accommodation Notes' ;
    rdfs:comment 'Free-text notes capturing any special accessibility, dietary, or hospitality requirements for the sponsor guests attending under this redemption, supporting ADA compliance and VIP experience delivery.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorContactEmail rdf:type rdf:Property ;
    rdfs:label 'Sponsor Contact Email' ;
    rdfs:comment 'Email address of the sponsor representative who redeemed the entitlement, used for confirmation communications and CRM linkage. Classified as restricted PII per GDPR and CCPA.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorContactName rdf:type rdf:Property ;
    rdfs:label 'Sponsor Contact Name' ;
    rdfs:comment 'Full name of the sponsor representative who redeemed the entitlement. Captured for hospitality fulfilment records and relationship management. Classified as confidential PII per GDPR and CCPA.' ;
    rdfs:domain ind:EntitlementRedemption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfilmentOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Fulfilment Owner Employee Id' ;
    rdfs:comment 'Reference to the internal account manager or sponsorship fulfilment team member responsible for delivering and managing this entitlement. Supports accountability tracking and SLA monitoring.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:holdAllocationId rdf:type rdf:Property ;
    rdfs:label 'Hold Allocation Id' ;
    rdfs:comment 'Foreign key linking to ticketing.hold_allocation. Business justification: Sponsor seat reservation operations: hospitality entitlements are fulfilled by holding specific seats in ticketing via hold_allocation (which already carries sponsor_id). Linking the entitlement to it' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HoldAllocation .

ind:primarySponsorContactId rdf:type rdf:Property ;
    rdfs:label 'Primary Sponsor Contact Id' ;
    rdfs:comment 'Reference to the primary sponsor-side contact person authorised to manage and redeem this entitlement. Used for communication, redemption validation, and CRM relationship tracking.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SponsorContact .

ind:sponsorAccountId rdf:type rdf:Property ;
    rdfs:label 'Sponsor Account Id' ;
    rdfs:comment 'Reference to the sponsor organisation (B2B account) that holds this hospitality entitlement. Supports sponsor relationship management and utilisation reporting.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:suiteId rdf:type rdf:Property ;
    rdfs:label 'Suite Id' ;
    rdfs:comment 'Foreign key linking to venue.suite. Business justification: Sponsor hospitality entitlements are allocated to specific suites for each event. Suite-level tracking is essential for sponsor hospitality fulfillment, suite inventory management, and post-event ROI ' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Suite .

ind:advanceBookingDays rdf:type rdf:Property ;
    rdfs:label 'Advance Booking Days' ;
    rdfs:comment 'Minimum number of days in advance that a redemption request must be submitted before the event date. Enforces operational lead time for venue and catering preparation.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:avgSatisfactionRating rdf:type rdf:Property ;
    rdfs:label 'Avg Satisfaction Rating' ;
    rdfs:comment 'Average guest satisfaction score collected across all redemption events for this entitlement, on a 1.00–5.00 scale. Aggregated from individual redemption-level ratings to support NPS and renewal decision-making.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cateringIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Catering Included Flag' ;
    rdfs:comment 'Indicates whether food and beverage catering is included as part of this entitlement (True) or whether catering must be arranged and charged separately (False). Drives venue operations and cost allocation.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceClearanceFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Clearance Flag' ;
    rdfs:comment 'Indicates whether this entitlement has passed all required compliance checks (e.g., anti-bribery, GDPR data sharing consent for guest lists, PCI-DSS for any associated payment processing). Must be True before redemptions are activated.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractualValue rdf:type rdf:Property ;
    rdfs:label 'Contractual Value' ;
    rdfs:comment 'Monetary value attributed to this entitlement as specified in the sponsorship deal contract. Used for ROI tracking, deal valuation, and financial reporting under SAP S/4HANA FI/CO. Expressed in the deal currency.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dressCode rdf:type rdf:Property ;
    rdfs:label 'Dress Code' ;
    rdfs:comment 'Required dress standard for guests redeeming this entitlement. Communicated to sponsors during booking confirmation and enforced at venue access points.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entitlementName rdf:type rdf:Property ;
    rdfs:label 'Entitlement Name' ;
    rdfs:comment 'Human-readable label for this entitlement as it appears in sponsor-facing materials and the online redemption portal (e.g., \'Platinum Suite — Home Season 2025\', \'Field Access Pass — Championship Final\').' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventScope rdf:type rdf:Property ;
    rdfs:label 'Event Scope' ;
    rdfs:comment 'Defines the range of events to which this entitlement applies. Determines whether the entitlement is valid for all home games, playoff rounds, a specific single event, the full season, a curated selection of events, or a tournament only.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:faceValuePerUnit rdf:type rdf:Property ;
    rdfs:label 'Face Value Per Unit' ;
    rdfs:comment 'Market or face value of a single unit of this entitlement (e.g., per VIP ticket, per suite night). Used to calculate total entitlement value, sponsor ROI, and in-kind benefit reporting.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gdprConsentObtainedFlag rdf:type rdf:Property ;
    rdfs:label 'Gdpr Consent Obtained Flag' ;
    rdfs:comment 'Indicates whether the sponsor and their nominated guests have provided GDPR-compliant data processing consent for the collection and use of personal data during hospitality redemptions (True = consent on file). Required for EU-market operations.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:guestListCapacity rdf:type rdf:Property ;
    rdfs:label 'Guest List Capacity' ;
    rdfs:comment 'Maximum number of guests the sponsor may register per redemption event for this entitlement. Governs guest list management and venue access control headcount.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastRedemptionDate rdf:type rdf:Property ;
    rdfs:label 'Last Redemption Date' ;
    rdfs:comment 'Date of the most recent confirmed redemption against this entitlement. Used to identify dormant entitlements and trigger proactive sponsor engagement by account managers.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:parkingPassesIncluded rdf:type rdf:Property ;
    rdfs:label 'Parking Passes Included' ;
    rdfs:comment 'Number of complimentary parking passes included per event redemption for this entitlement. Zero indicates no parking benefit. Supports venue logistics and access control planning.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quantityPerEvent rdf:type rdf:Property ;
    rdfs:label 'Quantity Per Event' ;
    rdfs:comment 'Maximum number of units that may be redeemed at any single event within the entitlement scope. Enforces per-event capacity limits distinct from the overall allocation.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalRecommendation rdf:type rdf:Property ;
    rdfs:label 'Renewal Recommendation' ;
    rdfs:comment 'Account manager\'s recommendation for this entitlement at the next sponsorship renewal cycle, based on utilisation rate, satisfaction scores, and strategic value. Informs renewal package design.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rolloverPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Rollover Permitted Flag' ;
    rdfs:comment 'Indicates whether unused entitlement units may roll over to the next season or event period (True) or expire at the end of the current period (False). Informs renewal package design and financial liability reporting.' ;
    rdfs:domain ind:HospitalityEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transferableFlag rdf:type rdf:Property ;
    rdfs:label 'Transferable Flag' ;
    rdfs:comment 'Indicates whether the sponsor may transfer or reassign this entitlement to a third party (True) or whether it is restricted to named sponsor contacts only (False). Governs redemption eligibility validation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inventoryAllocationId rdf:type rdf:Property ;
    rdfs:label 'Inventory Allocation Id' ;
    rdfs:comment 'Unique surrogate identifier for each inventory allocation record linking a specific ad inventory unit to a sponsorship deal or activation. Primary key for this transactional entity.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inventoryUnitId rdf:type rdf:Property ;
    rdfs:label 'Inventory Unit Id' ;
    rdfs:comment 'Reference to the specific advertising or sponsorship inventory unit being allocated (e.g., LED board slot, broadcast spot, digital banner, naming rights panel, jersey patch position).' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InventoryUnit .

ind:originalAllocationInventoryAllocationId rdf:type rdf:Property ;
    rdfs:label 'Original Allocation Inventory Allocation Id' ;
    rdfs:comment 'Reference to the original inventory allocation record that this make-good allocation is compensating for. Populated only when make_good_flag is True. Enables traceability of make-good chains.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InventoryAllocation .

ind:actualImpressionsDelivered rdf:type rdf:Property ;
    rdfs:label 'Actual Impressions Delivered' ;
    rdfs:comment 'The actual number of audience impressions or exposures recorded upon delivery of this inventory allocation. Compared against impression_target to assess performance and trigger make-good provisions.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualQuantityDelivered rdf:type rdf:Property ;
    rdfs:label 'Actual Quantity Delivered' ;
    rdfs:comment 'The actual number of inventory units delivered upon fulfillment of this allocation. Compared against allocated_quantity to determine fulfillment rate and identify make-good obligations.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocatedQuantity rdf:type rdf:Property ;
    rdfs:label 'Allocated Quantity' ;
    rdfs:comment 'Number of inventory units allocated in this record (e.g., number of broadcast spots, number of digital impressions blocks, number of signage panels). Represents the principal quantitative fact of this allocation transaction.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocatedValue rdf:type rdf:Property ;
    rdfs:label 'Allocated Value' ;
    rdfs:comment 'The commercial value assigned to this specific inventory allocation, representing the portion of the sponsorship deal\'s total contract value attributable to this unit. Used for revenue recognition, ROI tracking, and deal fulfillment reporting.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Date' ;
    rdfs:comment 'The calendar date on which this inventory unit was formally allocated to the sponsorship deal or activation. Represents the principal business event date for this transaction.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Allocation Reference Number' ;
    rdfs:comment 'Externally-known business identifier for this allocation transaction, used in sponsor-facing communications, fulfillment reports, and cross-system reconciliation (e.g., CRM opportunity line reference, SAP SD delivery order number).' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationStatus rdf:type rdf:Property ;
    rdfs:label 'Allocation Status' ;
    rdfs:comment 'Current lifecycle state of this inventory allocation. \'reserved\' indicates a hold pending confirmation; \'confirmed\' indicates a committed booking; \'delivered\' indicates fulfillment is complete; \'cancelled\' indicates the allocation was voided; \'pending_approval\' indicates awaiting internal or sponsor sign-off.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Allocation Timestamp' ;
    rdfs:comment 'Precise date and time when this inventory allocation record was created in the system, capturing the exact moment of reservation or booking action.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:approvalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Approval Required Flag' ;
    rdfs:comment 'Indicates whether this inventory allocation requires explicit approval from a league governing body, broadcast rights holder, or internal compliance team before it can be confirmed and delivered.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryEndDate rdf:type rdf:Property ;
    rdfs:label 'Delivery End Date' ;
    rdfs:comment 'The date by which this inventory allocation must be fully delivered or activated. Defines the closing boundary of the fulfillment window and drives SLA compliance tracking.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deliveryStartDate rdf:type rdf:Property ;
    rdfs:label 'Delivery Start Date' ;
    rdfs:comment 'The date from which this inventory allocation is scheduled to begin delivery or activation. Defines the opening boundary of the fulfillment window.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grpTarget rdf:type rdf:Property ;
    rdfs:label 'Grp Target' ;
    rdfs:comment 'The target Gross Rating Point (GRP) value committed for this inventory allocation, representing the expected audience reach multiplied by frequency. Used for broadcast and media inventory performance measurement and sponsor ROI reporting.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impressionTarget rdf:type rdf:Property ;
    rdfs:label 'Impression Target' ;
    rdfs:comment 'The target number of audience impressions or exposures committed for this inventory allocation. Used for digital and broadcast inventory performance tracking and sponsor proof-of-performance reporting.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inventoryType rdf:type rdf:Property ;
    rdfs:label 'Inventory Type' ;
    rdfs:comment 'Classification of the advertising or sponsorship inventory unit being allocated. Drives fulfillment workflows, measurement methodology (CPM, GRP, impressions), and reporting. [ENUM-REF-CANDIDATE: broadcast_spot|digital_display|venue_signage|jersey_patch|naming_rights|social_media|print|activation_space — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementPosition rdf:type rdf:Property ;
    rdfs:label 'Placement Position' ;
    rdfs:comment 'Specific placement position or location descriptor for this inventory allocation (e.g., \'North End LED Row 1\', \'Halftime Break Slot 2\', \'Homepage Banner Top\', \'Left Sleeve Jersey Patch\'). Provides granular fulfillment and proof-of-performance detail.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCardValue rdf:type rdf:Property ;
    rdfs:label 'Rate Card Value' ;
    rdfs:comment 'The published or standard rate card value for this inventory unit prior to any negotiated discount or deal adjustment. Enables calculation of discount depth and benchmarking of deal terms against market rates.' ;
    rdfs:domain ind:InventoryAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jerseySponsorshipId rdf:type rdf:Property ;
    rdfs:label 'Jersey Sponsorship Id' ;
    rdfs:comment 'Unique surrogate identifier for each jersey sponsorship placement record. Primary key for the master record of jersey and kit sponsorship placements.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:logoAssetId rdf:type rdf:Property ;
    rdfs:label 'Logo Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: Jersey sponsorship placements require the exact logo artwork asset from the DAM for league approval workflows. League approval teams verify the specific logo_asset version before approving jersey plac' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:activationDeliverablesCount rdf:type rdf:Property ;
    rdfs:label 'Activation Deliverables Count' ;
    rdfs:comment 'Total number of contractually obligated activation deliverables associated with this jersey sponsorship placement (e.g., social media posts, in-stadium appearances, co-branded content pieces). Used to track fulfillment progress.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Fee Amount' ;
    rdfs:comment 'Annual monetary value of the jersey sponsorship placement as agreed in the commercial contract. Expressed in the contract currency. Used for revenue recognition, financial planning, and Return on Investment (ROI) reporting. Sensitive commercial data.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brandDisplayName rdf:type rdf:Property ;
    rdfs:label 'Brand Display Name' ;
    rdfs:comment 'The exact brand name or logo descriptor as it must appear on the jersey placement. May differ from the legal sponsor entity name (e.g., a product brand vs. parent corporation). Used in kit production artwork briefs.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastVisibilityTier rdf:type rdf:Property ;
    rdfs:label 'Broadcast Visibility Tier' ;
    rdfs:comment 'Classification of the placement\'s expected broadcast exposure level based on camera angles, screen time analytics, and placement location. Tier 1 Premium represents maximum broadcast visibility (e.g., front chest). Used to calculate Cost Per Mille (CPM) and Gross Rating Point (GRP) valuations for sponsor Return on Investment (ROI) reporting.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Contract Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the annual fee and total contract value (e.g., USD, GBP, EUR). Required for multi-currency financial reporting and foreign exchange conversion.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedBroadcastSeconds rdf:type rdf:Property ;
    rdfs:label 'Estimated Broadcast Seconds' ;
    rdfs:comment 'Estimated total broadcast screen-time in seconds for this placement per match or event, based on historical camera analytics and placement location. Used as an input to sponsor Return on Investment (ROI) and Cost Per Mille (CPM) valuation models.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:feeEscalationRatePct rdf:type rdf:Property ;
    rdfs:label 'Fee Escalation Rate Pct' ;
    rdfs:comment 'Annual percentage rate at which the sponsorship fee escalates over the contract term (e.g., 0.0300 = 3% per annum). Used in multi-year financial forecasting and revenue recognition schedules.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isBroadcastIntegrated rdf:type rdf:Property ;
    rdfs:label 'Is Broadcast Integrated' ;
    rdfs:comment 'Indicates whether this jersey sponsorship includes a broadcast integration component such as virtual logo insertion, augmented reality overlay, or dedicated broadcast mention. True triggers broadcast operations workflow in Dalet Galaxy.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDigitalPlatformIncluded rdf:type rdf:Property ;
    rdfs:label 'Is Digital Platform Included' ;
    rdfs:comment 'Indicates whether the jersey sponsorship rights extend to digital and Over-The-Top (OTT) streaming platforms, social media, and Direct-To-Consumer (DTC) channels in addition to live broadcast. Drives digital rights management and Adobe Experience Platform activation workflows.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNilArrangement rdf:type rdf:Property ;
    rdfs:label 'Is Nil Arrangement' ;
    rdfs:comment 'Indicates whether this jersey sponsorship is an individual athlete Name, Image, and Likeness (NIL) arrangement rather than a team-level deal. True for NIL deals; False for team or league-wide placements. Drives different compliance, revenue-sharing, and reporting workflows.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kitManufacturerCode rdf:type rdf:Property ;
    rdfs:label 'Kit Manufacturer Code' ;
    rdfs:comment 'Reference to the official kit or apparel manufacturer (e.g., Nike, Adidas, Under Armour) responsible for producing the jersey on which the sponsorship is placed.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:kitType rdf:type rdf:Property ;
    rdfs:label 'Kit Type' ;
    rdfs:comment 'Type of kit or jersey on which the sponsorship placement appears. Determines the scope of brand exposure across different match and training contexts. [ENUM-REF-CANDIDATE: home|away|third|training|goalkeeper|cup|special_edition — promote to reference product]' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leagueApprovalReference rdf:type rdf:Property ;
    rdfs:label 'League Approval Reference' ;
    rdfs:comment 'Official reference or case number issued by the governing league or federation upon approval of the jersey sponsorship placement. Used for compliance documentation and dispute resolution.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementCode rdf:type rdf:Property ;
    rdfs:label 'Placement Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for this specific jersey sponsorship placement. Used in contracts, invoices, and activation briefs. Format: JSP- followed by 4–12 uppercase alphanumeric characters.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementHeightMm rdf:type rdf:Property ;
    rdfs:label 'Placement Height Mm' ;
    rdfs:comment 'Approved height of the sponsor logo or brand mark on the jersey placement, measured in millimetres. Governed by league kit regulations and contract specifications. Used in kit production quality control.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:placementName rdf:type rdf:Property ;
    rdfs:label 'Placement Name' ;
    rdfs:comment 'Human-readable descriptive name for the jersey sponsorship placement (e.g., \'Front Chest Primary Sponsor — Home Kit 2024–25\'). Used in reporting, activation briefs, and stakeholder communications.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementTier rdf:type rdf:Property ;
    rdfs:label 'Placement Tier' ;
    rdfs:comment 'Commercial tier classification of the placement indicating its prominence and exclusivity level. Primary denotes the main front-chest sponsor; secondary and tertiary denote subordinate placements such as sleeve or collar sponsors.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placementWidthMm rdf:type rdf:Property ;
    rdfs:label 'Placement Width Mm' ;
    rdfs:comment 'Approved width of the sponsor logo or brand mark on the jersey placement, measured in millimetres. Governed by league kit regulations and contract specifications. Used in kit production quality control.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sponsorshipType rdf:type rdf:Property ;
    rdfs:label 'Sponsorship Type' ;
    rdfs:comment 'Classification of the sponsorship arrangement type. Distinguishes between team-level jersey deals, individual athlete Name, Image, and Likeness (NIL) arrangements, league-wide kit sponsorships, and tournament-specific placements.' ;
    rdfs:domain ind:JerseySponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandedAssetId rdf:type rdf:Property ;
    rdfs:label 'Branded Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: Naming rights agreements reference specific brand logo and signage artwork assets stored in the DAM. Rights management and league approval workflows require linking the naming right to the approved br' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:dealOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Deal Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Naming rights deal ownership: naming_right is a standalone high-value agreement product with no employee FK. The employee managing the naming rights relationship is critical for renewal tracking, stak' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:activationBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Activation Budget Amount' ;
    rdfs:comment 'Total budget allocated by the sponsor for brand activation activities associated with the naming rights agreement (events, promotions, fan engagement, digital campaigns). Tracked in SAP S/4HANA CO.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastMentionCountMin rdf:type rdf:Property ;
    rdfs:label 'Broadcast Mention Count Min' ;
    rdfs:comment 'Minimum number of on-air brand mentions of the named asset\'s sponsor name contractually required per broadcast event or season, as specified in the naming rights agreement.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:digitalUrl rdf:type rdf:Property ;
    rdfs:label 'Digital Url' ;
    rdfs:comment 'The official digital property URL (website or primary digital destination) for the named asset reflecting the sponsor\'s brand, as required by the naming rights agreement.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalUrlChangeRequired rdf:type rdf:Property ;
    rdfs:label 'Digital Url Change Required' ;
    rdfs:comment 'Indicates whether the naming rights agreement requires changes to digital property URLs (website domains, social media handles, app store listings) to reflect the sponsor\'s brand name.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeResolutionBody rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Body' ;
    rdfs:comment 'Name of the arbitration or dispute resolution body specified in the naming rights agreement for resolving contractual disputes (e.g., CAS - Court of Arbitration for Sport, ICC International Court of Arbitration).' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeEscalationRate rdf:type rdf:Property ;
    rdfs:label 'Fee Escalation Rate' ;
    rdfs:comment 'Annual percentage rate at which the naming rights fee escalates over the term of the agreement (e.g., 0.0300 = 3% per annum). Used in Workday Adaptive Planning for multi-year revenue projections.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gdprCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Gdpr Compliant Flag' ;
    rdfs:comment 'Indicates whether the data processing activities associated with this naming rights agreement (fan data used in activation campaigns) have been reviewed for GDPR compliance. Relevant for EU market activations.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ipRightsIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Ip Rights Included Flag' ;
    rdfs:comment 'Indicates whether the naming rights agreement grants the sponsor Intellectual Property (IP) usage rights, such as the right to use league logos, team marks, or event trademarks in their own marketing.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:namedAssetName rdf:type rdf:Property ;
    rdfs:label 'Named Asset Name' ;
    rdfs:comment 'The official branded name of the asset as it appears publicly following the naming rights agreement (e.g., \'Acme Arena\', \'TechCorp Stadium\'). This is the name used in all broadcast mentions, signage, and digital properties.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:namedAssetPriorName rdf:type rdf:Property ;
    rdfs:label 'Named Asset Prior Name' ;
    rdfs:comment 'The name of the asset prior to the current naming rights agreement. Used for historical reference, fan communications, and transition period signage management.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:namedAssetType rdf:type rdf:Property ;
    rdfs:label 'Named Asset Type' ;
    rdfs:comment 'Category of the physical or intangible property subject to the naming rights. Determines applicable signage, broadcast, and digital obligations. [ENUM-REF-CANDIDATE: stadium|arena|practice_facility|trophy|award|league_division|digital_property|broadcast_segment — promote to reference product]' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Nil Compliance Flag' ;
    rdfs:comment 'Indicates whether the naming rights agreement has been reviewed and confirmed compliant with applicable Name Image and Likeness (NIL) regulations, particularly relevant when athlete names or likenesses are incorporated into the named asset branding.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signageCount rdf:type rdf:Property ;
    rdfs:label 'Signage Count' ;
    rdfs:comment 'Total number of physical and digital signage units contractually required to display the sponsor\'s brand name under the naming rights agreement.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:signageSpecDescription rdf:type rdf:Property ;
    rdfs:label 'Signage Spec Description' ;
    rdfs:comment 'Detailed description of the physical and digital signage obligations under the naming rights agreement, including placement locations, dimensions, illumination requirements, and brand standards compliance.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soxReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Sox Reportable Flag' ;
    rdfs:comment 'Indicates whether this naming rights agreement meets the materiality threshold requiring disclosure under SOX financial controls for public company reporting. Drives inclusion in SEC financial reporting.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:termYears rdf:type rdf:Property ;
    rdfs:label 'Term Years' ;
    rdfs:comment 'Total contractual duration of the naming rights agreement expressed in whole years. Supports long-term revenue planning and renewal pipeline management.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:terminationClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Termination Clause Flag' ;
    rdfs:comment 'Indicates whether the agreement contains an early termination clause allowing either party to exit the agreement before the effective end date under defined conditions.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:terminationFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Termination Fee Amount' ;
    rdfs:comment 'Contractual penalty or fee payable upon early termination of the naming rights agreement. Expressed in the contract currency. Applicable only when termination_clause_flag is True.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Fee Amount' ;
    rdfs:comment 'Total contractual value of the naming rights agreement over the full term, expressed in the contract currency. Used for financial reporting under SAP S/4HANA FI/CO and SOX compliance disclosures.' ;
    rdfs:domain ind:NamingRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentScheduleId rdf:type rdf:Property ;
    rdfs:label 'Payment Schedule Id' ;
    rdfs:comment 'Unique surrogate identifier for the payment schedule milestone record within the sponsorship domain. Primary key for this entity.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disputeRaisedDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Raised Date' ;
    rdfs:comment 'Date on which the sponsor formally raised a dispute for this payment milestone. Null if no dispute has been raised. Used to track dispute resolution SLA compliance and aging.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastPeriod rdf:type rdf:Property ;
    rdfs:label 'Forecast Period' ;
    rdfs:comment 'Fiscal quarter in which this payment milestone is expected to be received for cash flow forecasting purposes, formatted as YYYY-Q{N} (e.g., 2025-Q2). Used in Workday Adaptive Planning for sponsorship revenue forecasting and EBITDA projections.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Fee Amount' ;
    rdfs:comment 'Contractual late payment penalty fee assessed against the sponsor for overdue payment of this milestone, as defined in the sponsorship deal terms. Expressed in the deal currency. Zero or null if no late fee applies or has been assessed.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:milestoneName rdf:type rdf:Property ;
    rdfs:label 'Milestone Name' ;
    rdfs:comment 'Descriptive label for this payment milestone as defined in the sponsorship contract (e.g., \'Q1 Installment\', \'Season Opener Activation Fee\', \'Signing Bonus\', \'Annual Naming Rights Fee\'). Used in sponsor communications and invoice descriptions.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneSequence rdf:type rdf:Property ;
    rdfs:label 'Milestone Sequence' ;
    rdfs:comment 'Ordinal position of this payment milestone within the overall deal payment schedule (e.g., 1 = first installment, 2 = second installment). Supports chronological ordering and installment tracking.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:receivedAmount rdf:type rdf:Property ;
    rdfs:label 'Received Amount' ;
    rdfs:comment 'Actual amount received from the sponsor for this milestone. May differ from net_amount in cases of partial payment, short payment, or currency conversion variance. Null until payment is received.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Date' ;
    rdfs:comment 'Date on which the revenue associated with this payment milestone is recognized in the financial statements under ASC 606 / IFRS 15. May differ from the received_date for multi-period or performance-obligation-based sponsorship deals.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sapFiDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Fi Document Number' ;
    rdfs:comment 'SAP S/4HANA Financial Accounting document number associated with the accounts receivable posting for this payment milestone. Serves as the primary cross-reference between the sponsorship data product and the general ledger for audit and reconciliation purposes.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledAmount rdf:type rdf:Property ;
    rdfs:label 'Scheduled Amount' ;
    rdfs:comment 'Gross contractual amount due for this payment milestone as specified in the sponsorship deal. Represents the base obligation before any adjustments, discounts, or withholding taxes. Expressed in the deal currency.' ;
    rdfs:domain ind:PaymentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceMetricId rdf:type rdf:Property ;
    rdfs:label 'Performance Metric Id' ;
    rdfs:comment 'Unique surrogate identifier for each sponsorship performance metric record in the Silver Layer lakehouse. Primary key for this transactional measurement entity.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brandRecallScore rdf:type rdf:Property ;
    rdfs:label 'Brand Recall Score' ;
    rdfs:comment 'Unaided or aided brand recall score measured via consumer survey panels (Kantar, Nielsen) during the measurement period. Expressed as a percentage of surveyed audience who recalled the sponsor brand in the context of the sports/entertainment property.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractedTargetValue rdf:type rdf:Property ;
    rdfs:label 'Contracted Target Value' ;
    rdfs:comment 'The agreed-upon target value for this KPI as stipulated in the sponsorship contract. Serves as the benchmark against which actual performance is measured for fulfillment and ROI reporting.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataSourceReportReference rdf:type rdf:Property ;
    rdfs:label 'Data Source Report Reference' ;
    rdfs:comment 'The external report or file identifier from the measurement data source (e.g., Nielsen report ID, Kantar study reference number) that this metric record was derived from. Enables traceability back to the source measurement report.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impressions rdf:type rdf:Property ;
    rdfs:label 'Impressions' ;
    rdfs:comment 'Total number of times the sponsor\'s brand asset (logo, advertisement, naming rights mention) was served or displayed across all channels (broadcast, digital, in-venue) during the measurement period.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inVenueDwellTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'In Venue Dwell Time Seconds' ;
    rdfs:comment 'Average number of seconds fans spent in proximity to or engaged with in-venue sponsor activations (branded zones, experiential areas, digital signage) during the measurement period. Captured via venue analytics systems.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isContractedKpi rdf:type rdf:Property ;
    rdfs:label 'Is Contracted Kpi' ;
    rdfs:comment 'Indicates whether this metric corresponds to a formally contracted KPI obligation in the sponsorship agreement (True) or is a supplementary/bonus metric tracked for additional insight (False). Drives fulfillment compliance reporting.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measurementPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Measurement Period End' ;
    rdfs:comment 'End date of the measurement window during which the sponsorship KPI data was collected. Together with measurement_period_start defines the reporting interval.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Start' ;
    rdfs:comment 'Start date of the measurement window during which the sponsorship KPI data was collected. Aligns with contracted reporting periods (weekly, monthly, quarterly, seasonal).' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:metricReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Metric Reference Code' ;
    rdfs:comment 'Externally-known business identifier for this performance metric record, used in ROI reports, renewal negotiations, and sponsor-facing dashboards. Format: PM-YYYYMMDD-XXXX.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npsLift rdf:type rdf:Property ;
    rdfs:label 'Nps Lift' ;
    rdfs:comment 'Change in Net Promoter Score for the sponsor brand attributable to the sponsorship activation, measured via fan/consumer surveys. Positive values indicate brand sentiment improvement driven by the partnership.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reach000s rdf:type rdf:Property ;
    rdfs:label 'Reach 000s' ;
    rdfs:comment 'Total unique audience reached by the sponsorship activation during the measurement period, expressed in thousands. Sourced from Nielsen or Kantar audience measurement panels.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:socialEngagementRate rdf:type rdf:Property ;
    rdfs:label 'Social Engagement Rate' ;
    rdfs:comment 'Percentage engagement rate for sponsor-related social media content during the measurement period ((likes + comments + shares + saves) / total impressions × 100). Sourced from Adobe Experience Platform social analytics.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sponsorVerified rdf:type rdf:Property ;
    rdfs:label 'Sponsor Verified' ;
    rdfs:comment 'Indicates whether the sponsor has formally reviewed and accepted this performance metric measurement as accurate. Required for final ROI reporting and renewal negotiation documentation.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sponsorVerifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sponsor Verified Timestamp' ;
    rdfs:comment 'Date and time when the sponsor formally verified and accepted this performance metric measurement. Null if sponsor_verified is False.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:accountExecutiveEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Account Executive Employee Id' ;
    rdfs:comment 'Internal employee identifier for the assigned account executive, sourced from SAP SuccessFactors. Enables HR-to-CRM cross-referencing for performance management and commission calculations.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:convertedSponsorId rdf:type rdf:Property ;
    rdfs:label 'Converted Sponsor Id' ;
    rdfs:comment 'Foreign key linking to sponsorship.sponsor. Business justification: prospect is the pre-deal pipeline record for prospective sponsors. When a prospect successfully converts, a sponsor master record is created. Linking prospect.converted_sponsor_id → sponsor.sponsor_id' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Sponsor .

ind:annualValueUsd rdf:type rdf:Property ;
    rdfs:label 'Annual Value Usd' ;
    rdfs:comment 'Estimated annual cash value of the prospective sponsorship deal in US Dollars. Used for ARR pipeline reporting and year-over-year commercial growth tracking distinct from total contract value.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastIntegrationInterest rdf:type rdf:Property ;
    rdfs:label 'Broadcast Integration Interest' ;
    rdfs:comment 'Indicates whether the prospect has expressed interest in broadcast or OTT media integration as part of the sponsorship package (e.g., in-broadcast overlays, sponsored segments). Triggers broadcast inventory review.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:categoryExclusivityRequested rdf:type rdf:Property ;
    rdfs:label 'Category Exclusivity Requested' ;
    rdfs:comment 'Indicates whether the prospective sponsor has requested category exclusivity rights as part of the deal. Triggers exclusivity conflict checks against existing sponsor.sponsor records.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closeProbabilityPct rdf:type rdf:Property ;
    rdfs:label 'Close Probability Pct' ;
    rdfs:comment 'Estimated percentage likelihood (0.00–100.00) that this prospect will convert to a signed sponsorship deal. Used for weighted pipeline valuation and revenue forecasting in Workday Adaptive Planning.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:competitorName rdf:type rdf:Property ;
    rdfs:label 'Competitor Name' ;
    rdfs:comment 'Name of the competing sports property or rights holder that won the deal when this prospect is marked as closed-lost due to a competitor. Supports competitive intelligence and market positioning analysis.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crmLeadCode rdf:type rdf:Property ;
    rdfs:label 'Crm Lead Code' ;
    rdfs:comment 'Reference identifier for the originating Salesforce CRM Lead record, if the prospect was converted from a lead. Null if the prospect was created directly as an opportunity.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crmOpportunityCode rdf:type rdf:Property ;
    rdfs:label 'Crm Opportunity Code' ;
    rdfs:comment 'Reference identifier for the corresponding Salesforce CRM Opportunity record. Enables bi-directional traceability between the lakehouse silver layer and the CRM system of record.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPrivacyConsent rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Consent' ;
    rdfs:comment 'Indicates whether the prospect organization\'s primary contact has provided consent for data processing and outreach communications in accordance with applicable privacy regulations (GDPR, CCPA).' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dealTermYears rdf:type rdf:Property ;
    rdfs:label 'Deal Term Years' ;
    rdfs:comment 'Proposed contract duration in years for the prospective sponsorship deal. Informs total contract value calculations and long-term revenue planning.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:digitalPlatformInterest rdf:type rdf:Property ;
    rdfs:label 'Digital Platform Interest' ;
    rdfs:comment 'Indicates whether the prospect has expressed interest in digital and DTC platform sponsorship activations (e.g., app integrations, OTT pre-roll, social media partnerships). Informs digital inventory planning.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedDealValueUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Deal Value Usd' ;
    rdfs:comment 'Estimated total contract value of the prospective sponsorship deal in US Dollars. Used for pipeline valuation, revenue forecasting, and Workday Adaptive Planning integration. Represents the gross deal value before any discounts or value-in-kind adjustments.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedCloseDate rdf:type rdf:Property ;
    rdfs:label 'Expected Close Date' ;
    rdfs:comment 'Anticipated date by which the sponsorship deal is expected to be signed and executed. Drives pipeline aging analysis, quarterly revenue forecasting, and account executive performance tracking.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:headquartersCountry rdf:type rdf:Property ;
    rdfs:label 'Headquarters Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the prospective sponsor\'s headquarters location. Determines applicable data privacy regulations (GDPR, CCPA) and international deal structuring requirements.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryVertical rdf:type rdf:Property ;
    rdfs:label 'Industry Vertical' ;
    rdfs:comment 'Primary industry sector of the prospective sponsor (e.g., Automotive, Financial Services, Consumer Packaged Goods, Technology, Apparel). Used for category exclusivity analysis and portfolio diversification reporting. [ENUM-REF-CANDIDATE: Automotive|Financial Services|Consumer Packaged Goods|Technology|Apparel|Healthcare|Telecommunications|Retail|Energy|Insurance — promote to reference product]' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lostReason rdf:type rdf:Property ;
    rdfs:label 'Lost Reason' ;
    rdfs:comment 'Reason code explaining why a prospect was marked as closed-lost. Populated only when pipeline_stage = closed_lost. Supports win/loss analysis and commercial strategy refinement. [ENUM-REF-CANDIDATE: budget|competitor|no_decision|timing|category_conflict|relationship|pricing|strategic_fit — promote to reference product]' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicsCode rdf:type rdf:Property ;
    rdfs:label 'Naics Code' ;
    rdfs:comment 'Six-digit NAICS code identifying the primary industry classification of the prospective sponsor. Supports standardized industry segmentation and regulatory reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:namingRightsInterest rdf:type rdf:Property ;
    rdfs:label 'Naming Rights Interest' ;
    rdfs:comment 'Indicates whether the prospect has expressed interest in venue or event naming rights as part of the sponsorship package. Flags high-value naming rights pipeline for executive review.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextActionDate rdf:type rdf:Property ;
    rdfs:label 'Next Action Date' ;
    rdfs:comment 'Scheduled date for the next planned commercial activity or follow-up action with the prospect (e.g., follow-up call, contract review meeting). Drives account executive task management.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nilPartnershipInterest rdf:type rdf:Property ;
    rdfs:label 'Nil Partnership Interest' ;
    rdfs:comment 'Indicates whether the prospect has expressed interest in Name, Image, and Likeness (NIL) athlete partnership arrangements as part of the sponsorship deal.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:organizationLegalName rdf:type rdf:Property ;
    rdfs:label 'Organization Legal Name' ;
    rdfs:comment 'Full registered legal name of the prospective sponsor organization as it would appear on a contract. May differ from the trading or brand name.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationName rdf:type rdf:Property ;
    rdfs:label 'Organization Name' ;
    rdfs:comment 'Legal or trading name of the prospective sponsor organization. Primary identity label for the prospect entity used in pipeline reporting and executive dashboards.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentOrganizationName rdf:type rdf:Property ;
    rdfs:label 'Parent Organization Name' ;
    rdfs:comment 'Name of the ultimate parent company or holding entity of the prospect, if applicable. Used for category exclusivity checks and enterprise-level relationship management.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineStage rdf:type rdf:Property ;
    rdfs:label 'Pipeline Stage' ;
    rdfs:comment 'Current stage of the prospect in the pre-deal commercial pipeline lifecycle. Drives pipeline reporting, revenue forecasting, and account executive workload management. [ENUM-REF-CANDIDATE: identified|qualified|pitched|proposal_sent|negotiating|closed_won|closed_lost — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pitchDate rdf:type rdf:Property ;
    rdfs:label 'Pitch Date' ;
    rdfs:comment 'Date on which the formal sponsorship pitch or presentation was delivered to the prospective sponsor. Tracks pipeline velocity and time-to-pitch KPI.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proposalSentDate rdf:type rdf:Property ;
    rdfs:label 'Proposal Sent Date' ;
    rdfs:comment 'Date on which the formal sponsorship proposal document was sent to the prospective sponsor. Tracks pipeline velocity and time-to-proposal KPI.' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:prospectingSource rdf:type rdf:Property ;
    rdfs:label 'Prospecting Source' ;
    rdfs:comment 'Channel or method through which this prospect was identified and entered the pipeline. Supports Customer Acquisition Cost (CAC) analysis and channel effectiveness reporting. [ENUM-REF-CANDIDATE: inbound|referral|outbound_cold|conference|agency|renewal_expansion|executive_introduction|digital_campaign — promote to reference product]' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorshipCategory rdf:type rdf:Property ;
    rdfs:label 'Sponsorship Category' ;
    rdfs:comment 'The sponsorship inventory category being pursued by the prospect (e.g., Jersey Sponsorship, Naming Rights, Broadcast Integration, Digital Platform, Venue Signage, Title Sponsorship). Determines which activation inventory is reserved during negotiation. [ENUM-REF-CANDIDATE: Jersey Sponsorship|Naming Rights|Broadcast Integration|Digital Platform|Venue Signage|Title Sponsorship|Presenting Sponsor|Official Partner — promote to reference product]' ;
    rdfs:domain ind:Prospect ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueInKindUsd rdf:type rdf:Property ;
    rdfs:label 'Value In Kind Usd' ;
    rdfs:comment 'Estimated value of non-cash goods or services offered by the prospect as part of the sponsorship deal (e.g., product supply, media airtime, hospitality). Tracked separately from cash value for deal structuring and EBITDA reporting.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewalId rdf:type rdf:Property ;
    rdfs:label 'Renewal Id' ;
    rdfs:comment 'Unique system-generated identifier for the sponsorship renewal record. Primary key for the renewal data product.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoRenewalClause rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Clause' ;
    rdfs:comment 'Indicates whether the original deal contained an auto-renewal clause that triggered this renewal. True = auto-renewal clause present and active; False = manual renewal process.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastIntegrationIncluded rdf:type rdf:Property ;
    rdfs:label 'Broadcast Integration Included' ;
    rdfs:comment 'Indicates whether broadcast media integrations (e.g., OTT (Over-The-Top Streaming), RSN (Regional Sports Network), linear TV) are included in the proposed renewal package.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractExecutedDate rdf:type rdf:Property ;
    rdfs:label 'Contract Executed Date' ;
    rdfs:comment 'The date on which the renewed sponsorship contract was formally signed and executed by both parties. Marks the transition from agreed stage to a binding new deal.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:declineReasonCode rdf:type rdf:Property ;
    rdfs:label 'Decline Reason Code' ;
    rdfs:comment 'Standardized reason code capturing why a sponsor declined to renew. Populated only when renewal_stage = declined. Supports churn analysis and retention strategy improvement. [ENUM-REF-CANDIDATE: budget_reduction|strategic_realignment|competitive_offer|dissatisfaction|market_exit|other — promote to reference product]' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declineReasonNotes rdf:type rdf:Property ;
    rdfs:label 'Decline Reason Notes' ;
    rdfs:comment 'Free-text narrative providing additional context for a declined renewal, supplementing the decline_reason_code. Captures qualitative intelligence for account management review.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiationDate rdf:type rdf:Property ;
    rdfs:label 'Initiation Date' ;
    rdfs:comment 'The date on which the renewal process was formally initiated, either by the account management team or triggered by an auto-renewal clause. Represents the business event timestamp for the start of the renewal lifecycle.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:keyAssetsProposed rdf:type rdf:Property ;
    rdfs:label 'Key Assets Proposed' ;
    rdfs:comment 'Summary description of the principal sponsorship assets (e.g., jersey placement, naming rights, broadcast integrations, digital platform partnerships) included in the proposed renewal package.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:namingRightsIncluded rdf:type rdf:Property ;
    rdfs:label 'Naming Rights Included' ;
    rdfs:comment 'Indicates whether venue or property naming rights are included in the proposed renewal package. True = naming rights are part of the renewed deal. Drives legal review and regulatory disclosure requirements.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:negotiationNotes rdf:type rdf:Property ;
    rdfs:label 'Negotiation Notes' ;
    rdfs:comment 'Confidential free-text field capturing key negotiation points, sponsor requests, concessions offered, and strategic context during the renewal process. Restricted to account management and commercial leadership.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Notice Deadline Date' ;
    rdfs:comment 'The calculated deadline date by which the sponsor must provide notice of intent to renew or decline, derived from the original term end date minus the notice period. Drives proactive outreach workflows.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalTcv rdf:type rdf:Property ;
    rdfs:label 'Original Tcv' ;
    rdfs:comment 'The total contract value (TCV) of the expiring sponsorship deal in the deal currency. Provides the commercial baseline for renewal uplift and ROI (Return on Investment) analysis.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proposedAnnualValue rdf:type rdf:Property ;
    rdfs:label 'Proposed Annual Value' ;
    rdfs:comment 'The proposed annualized sponsorship fee for the renewed deal, equivalent to ARR (Annual Recurring Revenue). Supports year-over-year revenue planning and ARR reporting.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proposedTcv rdf:type rdf:Property ;
    rdfs:label 'Proposed Tcv' ;
    rdfs:comment 'The proposed total contract value (TCV) for the renewed sponsorship deal in the deal currency. Key commercial metric for revenue forecasting and renewal uplift tracking.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proposedTermEndDate rdf:type rdf:Property ;
    rdfs:label 'Proposed Term End Date' ;
    rdfs:comment 'The proposed end date for the renewed sponsorship agreement. Represents the effective-until date of the new binding term. Nullable for open-ended multi-year structures pending final negotiation.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proposedTermStartDate rdf:type rdf:Property ;
    rdfs:label 'Proposed Term Start Date' ;
    rdfs:comment 'The proposed start date for the renewed sponsorship agreement. Represents the effective-from date of the new binding term being negotiated.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proposedTermYears rdf:type rdf:Property ;
    rdfs:label 'Proposed Term Years' ;
    rdfs:comment 'The proposed duration of the renewed deal expressed in years (e.g., 1.0, 2.5, 3.0). Supports multi-year extension analysis and pipeline forecasting.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sponsorIntent rdf:type rdf:Property ;
    rdfs:label 'Sponsor Intent' ;
    rdfs:comment 'Account manager\'s qualitative assessment of the sponsor\'s intent to renew, captured during the negotiation phase. Supports pipeline probability scoring and retention forecasting. [ENUM-REF-CANDIDATE: strong_renew|likely_renew|neutral|likely_decline|strong_decline|unknown — promote to reference product if additional intent categories are required]' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Target Decision Date' ;
    rdfs:comment 'The internal target date by which a renewal decision (agreed or declined) should be reached. Used for pipeline management and proactive outreach scheduling.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:upliftPercentage rdf:type rdf:Property ;
    rdfs:label 'Uplift Percentage' ;
    rdfs:comment 'The percentage increase or decrease in the proposed TCV relative to the original TCV. Positive values indicate commercial growth; negative values indicate concessions. Supports renewal performance benchmarking.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueInKindProposed rdf:type rdf:Property ;
    rdfs:label 'Value In Kind Proposed' ;
    rdfs:comment 'The proposed non-cash value-in-kind component of the renewed deal (e.g., complimentary tickets, hospitality, media inventory). Reported separately from cash TCV for accurate revenue recognition.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brandExposureValue rdf:type rdf:Property ;
    rdfs:label 'Brand Exposure Value' ;
    rdfs:comment 'The total estimated monetary value of brand exposure delivered to the sponsor across all touchpoints, incorporating quality-adjusted multipliers for placement prominence, audience demographics, and dwell time. Distinct from raw MVE.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastGrp rdf:type rdf:Property ;
    rdfs:label 'Broadcast Grp' ;
    rdfs:comment 'The total Gross Rating Points (GRP) accumulated from broadcast television exposures of the sponsor\'s brand during the report period. GRP = Reach% × Frequency. Standard broadcast advertising effectiveness metric.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastMve rdf:type rdf:Property ;
    rdfs:label 'Broadcast Mve' ;
    rdfs:comment 'The media value equivalent (MVE) attributable specifically to broadcast television and radio exposures of the sponsor\'s brand during the report period. Derived from CPM-based valuation of broadcast audience impressions.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractedActivations rdf:type rdf:Property ;
    rdfs:label 'Contracted Activations' ;
    rdfs:comment 'The total number of activation deliverables contractually obligated for the report period. Serves as the denominator in the fulfillment rate calculation.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deliveredActivations rdf:type rdf:Property ;
    rdfs:label 'Delivered Activations' ;
    rdfs:comment 'The actual number of activation deliverables successfully completed and verified during the report period. Serves as the numerator in the fulfillment rate calculation.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:digitalMve rdf:type rdf:Property ;
    rdfs:label 'Digital Mve' ;
    rdfs:comment 'The media value equivalent (MVE) attributable to digital and OTT platform exposures including social media, streaming, website, and app placements during the report period.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fulfillmentRatePct rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Rate Pct' ;
    rdfs:comment 'The percentage of contracted activation deliverables that were successfully completed during the report period (delivered activations / total contracted activations × 100). Measures operational delivery performance against contractual obligations.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:generatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Generated Timestamp' ;
    rdfs:comment 'The precise date and time when this ROI report record was first created in the system. Serves as the audit creation timestamp for data lineage.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:jerseyExposureSeconds rdf:type rdf:Property ;
    rdfs:label 'Jersey Exposure Seconds' ;
    rdfs:comment 'Total cumulative seconds of broadcast airtime during which the sponsor\'s jersey logo was visible on screen during the report period. Key metric for jersey sponsorship valuation.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:keyHighlights rdf:type rdf:Property ;
    rdfs:label 'Key Highlights' ;
    rdfs:comment 'Narrative summary of the most significant sponsorship performance achievements, milestones, and notable activations during the report period. Included in the sponsor-facing report document for review meetings.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:makeGoodValue rdf:type rdf:Property ;
    rdfs:label 'Make Good Value' ;
    rdfs:comment 'The estimated monetary value of make-good inventory or credits owed to the sponsor due to underdelivery during the report period. Populated only when make_good_required is True.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:namingRightsEvents rdf:type rdf:Property ;
    rdfs:label 'Naming Rights Events' ;
    rdfs:comment 'The number of events held at the named venue during the report period for which the sponsor\'s naming rights were active and publicly promoted. Relevant only for naming rights sponsorship agreements.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:performanceNotes rdf:type rdf:Property ;
    rdfs:label 'Performance Notes' ;
    rdfs:comment 'Internal analyst commentary on sponsorship performance variances, underdelivery explanations, make-good obligations, or contextual factors affecting the report period metrics. Not shared externally.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roiRatio rdf:type rdf:Property ;
    rdfs:label 'Roi Ratio' ;
    rdfs:comment 'The ratio of total media value equivalent (MVE) to total contracted sponsorship value for the report period (MVE / Contracted Value). A ratio greater than 1.0 indicates the sponsor received more media value than the fee paid. Core metric shared during renewal negotiations.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:socialMediaMentions rdf:type rdf:Property ;
    rdfs:label 'Social Media Mentions' ;
    rdfs:comment 'The total number of organic and paid social media mentions of the sponsor\'s brand associated with the sponsorship property during the report period. Contributes to digital MVE and fan engagement metrics.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceSystemRef rdf:type rdf:Property ;
    rdfs:label 'Source System Ref' ;
    rdfs:comment 'The originating system record identifier for this ROI report (e.g., Salesforce CRM report record ID). Supports data lineage tracing from the Silver Layer back to the operational system of record.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorSatisfactionScore rdf:type rdf:Property ;
    rdfs:label 'Sponsor Satisfaction Score' ;
    rdfs:comment 'Sponsor-reported satisfaction rating collected during or after the ROI review meeting, typically on a 1–10 scale. Informs NPS tracking and renewal probability assessment.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAudienceReach rdf:type rdf:Property ;
    rdfs:label 'Total Audience Reach' ;
    rdfs:comment 'The cumulative unduplicated audience count exposed to the sponsor\'s brand across all channels (broadcast, digital, in-venue, OTT) during the report period. Key metric for demonstrating brand exposure scale to sponsors.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalImpressions rdf:type rdf:Property ;
    rdfs:label 'Total Impressions' ;
    rdfs:comment 'The total number of brand impression instances (duplicated) delivered across all channels during the report period. Distinct from audience reach — counts each exposure event. Used in CPM-based valuation calculations.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalMve rdf:type rdf:Property ;
    rdfs:label 'Total Mve' ;
    rdfs:comment 'The aggregate media value equivalent (MVE) of all sponsor brand exposures across broadcast, digital, venue, and activation channels during the report period. Represents the fair-market advertising value of the sponsorship inventory delivered.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:venueMve rdf:type rdf:Property ;
    rdfs:label 'Venue Mve' ;
    rdfs:comment 'The media value equivalent (MVE) attributable to in-venue brand exposures including signage, LED boards, naming rights activations, and on-field/court placements during the report period.' ;
    rdfs:domain ind:RoiReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:activationRegion rdf:type rdf:Property ;
    rdfs:label 'Activation Region' ;
    rdfs:comment 'Geographic scope of the sponsor\'s activation rights (e.g., \'Global\', \'North America\', \'USA\', \'GBR\', \'DEU\'). Determines where brand activations, broadcast integrations, and digital placements may be executed. Uses ISO 3166-1 alpha-3 for country-level or named region for multi-country scopes.' ;
    rdfs:domain ind:Sponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualInvestmentUsd rdf:type rdf:Property ;
    rdfs:label 'Annual Investment Usd' ;
    rdfs:comment 'Total contracted annual cash investment value of the sponsorship in US Dollars. Represents the base financial commitment excluding value-in-kind (VIK) contributions. Used for revenue forecasting, EBITDA (Earnings Before Interest Taxes Depreciation and Amortization) reporting, and tier qualification.' ;
    rdfs:domain ind:Sponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Broadcast Integration Flag' ;
    rdfs:comment 'Indicates whether this sponsor has contracted broadcast integration rights including virtual signage, sponsored segments, on-screen billboards, or OTT (Over-The-Top Streaming) branded content placements.' ;
    rdfs:domain ind:Sponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:categoryExclusivityFlag rdf:type rdf:Property ;
    rdfs:label 'Category Exclusivity Flag' ;
    rdfs:comment 'Indicates whether this sponsor holds exclusive rights within their industry category, preventing competing brands in the same category from entering into sponsorship agreements. Critical for conflict-of-interest checks during new deal prospecting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataPrivacyConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Consent Flag' ;
    rdfs:comment 'Indicates whether the sponsoring organization\'s primary contact has provided consent for data processing activities under applicable privacy regulations. Required for GDPR-compliant B2B contact data management in EU markets.' ;
    rdfs:domain ind:Sponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:headquartersStateProvince rdf:type rdf:Property ;
    rdfs:label 'Headquarters State Province' ;
    rdfs:comment 'State or province of the sponsor\'s global headquarters. Used for regional market segmentation, tax jurisdiction determination, and compliance with state-level privacy laws such as CCPA.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryCategory rdf:type rdf:Property ;
    rdfs:label 'Industry Category' ;
    rdfs:comment 'Primary industry sector of the sponsoring organization using standard classification (e.g., Automotive, Financial Services, Consumer Packaged Goods, Technology, Telecommunications, Apparel). Used for category exclusivity management and competitive conflict checks. [ENUM-REF-CANDIDATE: automotive|financial_services|consumer_packaged_goods|technology|telecommunications|apparel|healthcare|food_beverage|insurance|retail|energy|media — promote to reference product]' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilPartnershipFlag rdf:type rdf:Property ;
    rdfs:label 'Nil Partnership Flag' ;
    rdfs:comment 'Indicates whether this sponsor has active NIL (Name, Image, and Likeness) agreements with individual athletes managed through the sports-entertainment ecosystem. NIL deals require separate compliance tracking under applicable state laws and league policies.' ;
    rdfs:domain ind:Sponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalProbability rdf:type rdf:Property ;
    rdfs:label 'Renewal Probability' ;
    rdfs:comment 'Estimated probability (0.00–100.00) that the sponsor will renew their agreement at the end of the current contract term. Assessed by the account manager and updated in Salesforce CRM. Used for revenue forecasting and pipeline management.' ;
    rdfs:domain ind:Sponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inventoryOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Inventory Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Inventory ownership: sponsorship_ad_inventory has \'internal_owner_team\' (team-level, not person). A specific employee owns each inventory asset for pricing decisions, availability management, and allo' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:propertyId rdf:type rdf:Property ;
    rdfs:label 'Property Id' ;
    rdfs:comment 'Identifier of the Sports Entertainment property (venue, broadcast channel, OTT platform, mobile app, or league) to which this inventory asset belongs. Links the asset to its owning property for rights management and revenue attribution.' ;
    rdfs:domain ind:Sponsorship ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Property .

ind:assessedValuePerUnit rdf:type rdf:Property ;
    rdfs:label 'Assessed Value Per Unit' ;
    rdfs:comment 'The independently assessed fair market value of a single unit of this inventory asset, expressed in the valuation currency. Represents the SSOT for what each asset unit is worth in the current market. Used as the floor price in sponsor negotiations and for ROI (Return on Investment) reporting.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetCode rdf:type rdf:Property ;
    rdfs:label 'Asset Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying the inventory asset across all Sports Entertainment properties and Salesforce CRM. Used in sponsor proposals, contracts, and activation briefs as the canonical asset reference.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:audienceDemographicProfile rdf:type rdf:Property ;
    rdfs:label 'Audience Demographic Profile' ;
    rdfs:comment 'Description of the primary audience demographic profile associated with this inventory asset (e.g., \'Male 18-34, ABC1, sports enthusiast\', \'Family audience, mixed gender, 25-54\'). Sourced from Adobe Experience Platform fan analytics or Nielsen audience measurement. Used in sponsor targeting and CPM justification.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:availabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Availability Status' ;
    rdfs:comment 'Current availability state of the inventory asset in the sponsorship sales lifecycle. \'available\' indicates the asset is open for sale; \'sold\' indicates it is committed to a sponsor; \'reserved\' indicates a hold pending contract execution; \'held\' indicates a short-term sales hold; \'retired\' indicates the asset is no longer offered; \'pending_approval\' indicates the asset is awaiting internal sign-off before listing.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cpmBenchmark rdf:type rdf:Property ;
    rdfs:label 'Cpm Benchmark' ;
    rdfs:comment 'The industry benchmark CPM (Cost Per Mille) rate for this asset type and channel, expressed in the asset\'s valuation currency. Represents the market cost per 1,000 impressions used to benchmark assessed value against industry norms. Sourced from Nielsen, independent agency, or Sports Entertainment commercial intelligence.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedImpressions rdf:type rdf:Property ;
    rdfs:label 'Estimated Impressions' ;
    rdfs:comment 'Estimated number of audience impressions delivered per unit activation of this inventory asset, based on Nielsen media measurement, broadcast ratings, or venue attendance data. Used as the primary input for CPM (Cost Per Mille) valuation and GRP (Gross Rating Point) calculations in sponsor proposals.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventTypeEligibility rdf:type rdf:Property ;
    rdfs:label 'Event Type Eligibility' ;
    rdfs:comment 'Defines the types of events for which this inventory asset is eligible to be activated (e.g., \'regular_season\', \'playoffs\', \'finals\', \'international\', \'concert\', \'all\'). Restricts asset availability to appropriate event contexts and supports event-specific packaging.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gdprDataUsageFlag rdf:type rdf:Property ;
    rdfs:label 'Gdpr Data Usage Flag' ;
    rdfs:comment 'Indicates whether activation of this inventory asset involves the collection or processing of fan personal data (True), triggering GDPR (General Data Protection Regulation) or CCPA compliance obligations. Applicable to digital assets such as in-app banners, OTT pre-rolls, and personalized digital overlays that use fan behavioral data for targeting.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grpRating rdf:type rdf:Property ;
    rdfs:label 'Grp Rating' ;
    rdfs:comment 'The GRP (Gross Rating Point) value assigned to this inventory asset, representing the percentage of the target audience reached multiplied by the average frequency of exposure. Used for broadcast and media inventory valuation and sponsor ROI (Return on Investment) reporting. Sourced from Nielsen or independent agency assessment.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internalOwnerTeam rdf:type rdf:Property ;
    rdfs:label 'Internal Owner Team' ;
    rdfs:comment 'The internal Sports Entertainment business unit or team responsible for managing and selling this inventory asset (e.g., \'Global Partnerships\', \'Broadcast Sales\', \'Venue Commercial\', \'Digital Partnerships\'). Used for revenue attribution, KPI (Key Performance Indicator) reporting, and workflow routing.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDigital rdf:type rdf:Property ;
    rdfs:label 'Is Digital' ;
    rdfs:comment 'Indicates whether this inventory asset is a digital placement (True) or a physical/static placement (False). Digital assets include OTT pre-rolls, in-app banners, digital overlays, and social media posts. Physical assets include static signage, LED boards, and naming rights plaques. Drives DRM (Digital Rights Management) and DAM (Digital Asset Management) workflow routing.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNamingRights rdf:type rdf:Property ;
    rdfs:label 'Is Naming Rights' ;
    rdfs:comment 'Indicates whether this inventory asset represents a naming rights unit (True), such as a venue naming rights package or a competition naming rights package. Naming rights assets have distinct legal, IP (Intellectual Property), and valuation characteristics and require separate governance approval.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:listPricePerUnit rdf:type rdf:Property ;
    rdfs:label 'List Price Per Unit' ;
    rdfs:comment 'The standard published list price for a single unit of this inventory asset, expressed in the valuation currency. Represents the starting price point in sponsor negotiations before any package discounts or deal-specific adjustments. Distinct from assessed_value_per_unit which reflects independent market valuation.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxUnitsPerSponsor rdf:type rdf:Property ;
    rdfs:label 'Max Units Per Sponsor' ;
    rdfs:comment 'The maximum number of units of this inventory asset that a single sponsor may purchase, enforcing competitive separation and preventing monopolization of high-visibility placements. Null indicates no per-sponsor cap.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minCommitmentUnits rdf:type rdf:Property ;
    rdfs:label 'Min Commitment Units' ;
    rdfs:comment 'The minimum number of units a sponsor must purchase to activate this inventory asset. Enforces commercial packaging rules and prevents sub-economic placements. For example, a broadcast billboard may require a minimum of 10 spots per broadcast.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:placementLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Placement Location Description' ;
    rdfs:comment 'Detailed description of the physical or digital placement location of the inventory asset (e.g., \'East perimeter board, pitch-side, between 18-yard box and halfway line\', \'Pre-roll slot on League Pass OTT app home screen\', \'North Stand fascia, upper tier\'). Provides the specificity required for activation briefs and sponsor approval.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionSpecNotes rdf:type rdf:Property ;
    rdfs:label 'Production Spec Notes' ;
    rdfs:comment 'Technical production specifications and creative requirements for this inventory asset, such as artwork dimensions, file format requirements, broadcast safe zones, LED pixel pitch, audio specifications for PA announcements, or digital ad unit specifications (IAB standards). Used by the activation and production teams.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorCategory rdf:type rdf:Property ;
    rdfs:label 'Sponsor Category' ;
    rdfs:comment 'The industry or product category of the sponsor occupying or targeted for this inventory asset (e.g., automotive, financial services, beverage, technology, insurance, apparel). Used for competitive exclusivity enforcement and category-based inventory packaging. [ENUM-REF-CANDIDATE: automotive|financial_services|beverage|technology|insurance|apparel|healthcare|telecommunications|retail|energy — promote to reference product]' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitCount rdf:type rdf:Property ;
    rdfs:label 'Unit Count' ;
    rdfs:comment 'Total number of discrete units available for this inventory asset type at the associated property. For example, the number of LED perimeter board panels, the number of OTT pre-roll slots per broadcast, or the number of PA announcement slots per event. Drives capacity planning and sell-through rate analysis.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unitDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Unit Duration Seconds' ;
    rdfs:comment 'Duration in seconds of a single inventory unit for time-based assets such as broadcast billboards, OTT pre-roll slots, PA announcements, and digital overlays. Null for non-time-based assets such as naming rights or jersey patches. Standard broadcast durations include 15, 30, and 60 seconds.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:valuationCurrency rdf:type rdf:Property ;
    rdfs:label 'Valuation Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the assessed value per unit and CPM benchmark are denominated (e.g., USD, GBP, EUR). Supports multi-currency operations across global Sports Entertainment markets.' ;
    rdfs:domain ind:SponsorshipAdInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:companionEntitlementId rdf:type rdf:Property ;
    rdfs:label 'Companion Entitlement Id' ;
    rdfs:comment 'Reference to a linked companion entitlement for ADA accessible seating, where a companion seat is paired with an accessible seat. Null if no companion pairing exists. Supports ADA compliance and seating management.' ;
    rdfs:domain ind:AccessEntitlement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccessEntitlement .

ind:originalFanFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Original Fan Fan Profile Id' ;
    rdfs:comment 'Reference to the fan who originally purchased this entitlement before any transfers occurred. Null if no transfer has taken place. Used for season ticket holder analytics and NIL (Name Image and Likeness) attribution.' ;
    rdfs:domain ind:AccessEntitlement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:ppvAssetId rdf:type rdf:Property ;
    rdfs:label 'Ppv Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: PPV digital access entitlements must reference the content asset they unlock for concurrent stream enforcement, DRM validation, and geo-restriction checks at playback time. OTT/PPV operations require ' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:primaryAccessFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Primary Access Fan Profile Id' ;
    rdfs:comment 'Reference to the fan (ticket holder) who holds this entitlement. Identifies the individual granted access rights for the event. Used for CRM integration and fan engagement analytics.' ;
    rdfs:domain ind:AccessEntitlement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:ticketInventoryId rdf:type rdf:Property ;
    rdfs:label 'Ticket Ticket Inventory Id' ;
    rdfs:comment 'Reference to the parent ticket record from which this entitlement was generated. Links the entitlement to the originating ticket purchase or transfer transaction.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TicketInventory .

ind:admissionType rdf:type rdf:Property ;
    rdfs:label 'Admission Type' ;
    rdfs:comment 'Defines the re-entry policy for this entitlement. SINGLE_USE = one-time entry only; MULTI_USE = multiple entries permitted (e.g., festival passes); RE_ENTRY = exit and re-entry allowed within the validity window.' ;
    rdfs:domain ind:AccessEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Age Restriction Flag' ;
    rdfs:comment 'Indicates whether this entitlement is subject to an age restriction requirement (e.g., 18+ or 21+ events). Gate staff must verify age documentation when this flag is true.' ;
    rdfs:domain ind:AccessEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:entitlementNotes rdf:type rdf:Property ;
    rdfs:label 'Entitlement Notes' ;
    rdfs:comment 'Free-text operational notes associated with this entitlement, such as special access instructions, VIP hospitality details, or box office agent comments. Used by venue operations staff.' ;
    rdfs:domain ind:AccessEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entitlementToken rdf:type rdf:Property ;
    rdfs:label 'Entitlement Token' ;
    rdfs:comment 'The unique cryptographic token (barcode, QR code, or NFC credential value) used for physical gate access validation. This is the machine-readable credential presented at the access control point. Classified confidential as it is the operative access credential.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalEntitlementRef rdf:type rdf:Property ;
    rdfs:label 'External Entitlement Ref' ;
    rdfs:comment 'The entitlement or ticket identifier as recorded in the originating source system (Ticketmaster, AXS, or Archtics). Used for cross-system reconciliation and support case resolution.' ;
    rdfs:domain ind:AccessEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:faceValueAmount rdf:type rdf:Property ;
    rdfs:label 'Face Value Amount' ;
    rdfs:comment 'The original printed or listed face value of the ticket associated with this entitlement, in the transaction currency. Used for revenue reporting, resale price comparison, and regulatory compliance with ticket scalping laws.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gateCode rdf:type rdf:Property ;
    rdfs:label 'Gate Code' ;
    rdfs:comment 'The identifier of the physical gate or access control point where this entitlement was scanned and validated. Null if not yet scanned. Used for gate throughput analysis and crowd flow management.' ;
    rdfs:domain ind:AccessEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isResaleable rdf:type rdf:Property ;
    rdfs:label 'Is Resaleable' ;
    rdfs:comment 'Indicates whether this entitlement is eligible for listing on the official resale marketplace. Distinct from transferability — resale implies a monetary transaction on the secondary market, subject to league and venue resale policies.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scanAttemptCount rdf:type rdf:Property ;
    rdfs:label 'Scan Attempt Count' ;
    rdfs:comment 'The total number of scan attempts recorded against this entitlement at access control points, including both successful and failed attempts. Used for fraud detection and duplicate entry prevention.' ;
    rdfs:domain ind:AccessEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tokenFormat rdf:type rdf:Property ;
    rdfs:label 'Token Format' ;
    rdfs:comment 'The physical or digital format of the entitlement credential presented at the gate. Determines the scanning hardware and validation protocol used at access control points. [ENUM-REF-CANDIDATE: BARCODE|QR_CODE|NFC|MOBILE_WALLET|RFID|PAPER — promote to reference product if additional formats are added]' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferCount rdf:type rdf:Property ;
    rdfs:label 'Transfer Count' ;
    rdfs:comment 'The number of times this entitlement has been transferred between fans. Used to enforce maximum transfer limits set by league policy and to detect potential scalping activity.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transferredTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transferred Timestamp' ;
    rdfs:comment 'The date and time when ownership of this entitlement was transferred to another fan via the resale marketplace or peer-to-peer transfer. Null if no transfer has occurred.' ;
    rdfs:domain ind:AccessEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:validFromTimestamp rdf:type rdf:Property ;
    rdfs:label 'Valid From Timestamp' ;
    rdfs:comment 'The date and time from which this entitlement becomes active and can be used for venue access. Defines the start of the validity window. Gate systems reject scans before this timestamp.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:validUntilTimestamp rdf:type rdf:Property ;
    rdfs:label 'Valid Until Timestamp' ;
    rdfs:comment 'The date and time after which this entitlement expires and can no longer be used for venue access. Defines the end of the validity window. Gate systems reject scans after this timestamp.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:voidReasonCode rdf:type rdf:Property ;
    rdfs:label 'Void Reason Code' ;
    rdfs:comment 'Standardised reason code explaining why this entitlement was voided. Null if not voided. Used for refund processing, fraud analytics, and compliance reporting. [ENUM-REF-CANDIDATE: REFUND|FRAUD|DUPLICATE|EVENT_CANCELLED|POLICY_VIOLATION|SYSTEM_ERROR|CHARGEBACK — promote to reference product]' ;
    rdfs:domain ind:AccessEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Voided Timestamp' ;
    rdfs:comment 'The date and time when this entitlement was voided or cancelled. Null if the entitlement has not been voided. Required for audit trail and refund processing compliance.' ;
    rdfs:domain ind:AccessEntitlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dynamicPriceRuleId rdf:type rdf:Property ;
    rdfs:label 'Dynamic Price Rule Id' ;
    rdfs:comment 'Unique surrogate identifier for a dynamic pricing rule record in the ticketing yield management system.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activationEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Activation End Timestamp' ;
    rdfs:comment 'The date and time after which this pricing rule ceases to execute. Defines the closing boundary of the rule\'s activation window. Null for open-ended rules. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:activationStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Activation Start Timestamp' ;
    rdfs:comment 'The date and time from which this pricing rule becomes eligible to execute. Defines the opening boundary of the rule\'s activation window. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:adjustmentDirection rdf:type rdf:Property ;
    rdfs:label 'Adjustment Direction' ;
    rdfs:comment 'Indicates whether the rule can only increase prices, only decrease prices, or move in either direction based on demand signals. \'bidirectional\' rules are used in fully automated yield management.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentMethod rdf:type rdf:Property ;
    rdfs:label 'Adjustment Method' ;
    rdfs:comment 'Mechanism by which the price adjustment is calculated: \'percentage\' = adjust by a percentage of the current price; \'fixed_amount\' = add or subtract a fixed currency amount; \'multiplier\' = multiply the base price by a factor.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentValue rdf:type rdf:Property ;
    rdfs:label 'Adjustment Value' ;
    rdfs:comment 'The numeric magnitude of the price adjustment. Interpretation depends on adjustment_method: for \'percentage\' this is the percent (e.g., 15.00 = 15%); for \'fixed_amount\' this is the currency delta; for \'multiplier\' this is the factor (e.g., 1.25). Classified confidential as it represents proprietary pricing strategy.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ceilingPrice rdf:type rdf:Property ;
    rdfs:label 'Ceiling Price' ;
    rdfs:comment 'Maximum allowable ticket price for this rule. The dynamic pricing engine will never increase the ticket price above this bound, managing fan experience and regulatory price-gouging considerations. Classified confidential as proprietary pricing strategy.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:competitorPriceOffsetPct rdf:type rdf:Property ;
    rdfs:label 'Competitor Price Offset Pct' ;
    rdfs:comment 'The percentage above or below the competitor benchmark price at which this rule targets ticket pricing. Positive = price above competitor; negative = price below. Classified confidential as proprietary competitive strategy.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Demand Threshold Pct' ;
    rdfs:comment 'The inventory sold-through percentage that must be reached before this demand-based rule activates. For example, 75.00 means the rule fires when 75% of allocated inventory is sold. Applicable when rule_type = \'demand_based\' or \'inventory_threshold\'.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalRuleReference rdf:type rdf:Property ;
    rdfs:label 'External Rule Reference' ;
    rdfs:comment 'The native rule identifier from the source system (Ticketmaster, AXS, or Archtics) that corresponds to this record. Enables bidirectional traceability between the lakehouse Silver Layer and operational ticketing systems.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floorPrice rdf:type rdf:Property ;
    rdfs:label 'Floor Price' ;
    rdfs:comment 'Minimum allowable ticket price for this rule. The dynamic pricing engine will never reduce the ticket price below this bound, protecting revenue floor commitments. Classified confidential as proprietary pricing strategy.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isEventOverride rdf:type rdf:Property ;
    rdfs:label 'Is Event Override' ;
    rdfs:comment 'Indicates whether this rule is an event-specific override that supersedes standard dynamic pricing rules for a particular event. True = override rule; False = standard rule. Supports playoff, championship, and special event pricing exceptions.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isResaleApplicable rdf:type rdf:Property ;
    rdfs:label 'Is Resale Applicable' ;
    rdfs:comment 'Indicates whether this dynamic pricing rule also applies to resale/secondary market ticket listings managed through the official resale marketplace. True = rule governs resale pricing; False = primary market only.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxAdjustmentPctPerTrigger rdf:type rdf:Property ;
    rdfs:label 'Max Adjustment Pct Per Trigger' ;
    rdfs:comment 'The maximum percentage change allowed in a single rule trigger event. Caps runaway price movements from a single demand spike. For example, 20.00 means no single trigger can move the price more than 20%.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxAdjustmentsPerDay rdf:type rdf:Property ;
    rdfs:label 'Max Adjustments Per Day' ;
    rdfs:comment 'Maximum number of times this rule may trigger a price change within a single calendar day. Prevents excessive price volatility that could damage fan trust and brand perception.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ruleType rdf:type rdf:Property ;
    rdfs:label 'Rule Type' ;
    rdfs:comment 'Classification of the pricing algorithm driving this rule. \'demand_based\' = adjusts price based on real-time demand signals; \'time_to_event\' = adjusts based on days/hours until event; \'competitor_benchmark\' = adjusts relative to competitor pricing; \'inventory_threshold\' = triggers on remaining inventory levels; \'manual_override\' = yield manager-initiated adjustment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeToEventHours rdf:type rdf:Property ;
    rdfs:label 'Time To Event Hours' ;
    rdfs:comment 'Number of hours before the event start time at which this time-based pricing rule activates. For example, 72 means the rule fires 72 hours before the event. Applicable when rule_type = \'time_to_event\'.' ;
    rdfs:domain ind:DynamicPriceRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gateScanId rdf:type rdf:Property ;
    rdfs:label 'Gate Scan Id' ;
    rdfs:comment 'Unique surrogate identifier for each gate scan event record in the access control system. Primary key for the gate_scan data product in the Databricks Silver Layer.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isAdaAccessibleEntry rdf:type rdf:Property ;
    rdfs:label 'Is Ada Accessible Entry' ;
    rdfs:comment 'Indicates whether the gate/entry point used for this scan is designated as an Americans with Disabilities Act (ADA) accessible entry point. Supports ADA compliance reporting and accessibility audit requirements.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMobileTicket rdf:type rdf:Property ;
    rdfs:label 'Is Mobile Ticket' ;
    rdfs:comment 'Indicates whether the scanned ticket was delivered and presented as a digital mobile ticket (via app or mobile wallet) as opposed to a printed or physical ticket. Tracks digital ticket delivery adoption rates and supports DTC (Direct-To-Consumer) digital strategy analytics.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReentryPermitted rdf:type rdf:Property ;
    rdfs:label 'Is Reentry Permitted' ;
    rdfs:comment 'Indicates whether the ticket type and event policy allow re-entry after an exit scan. Drives access control logic at the gate and supports policy compliance auditing.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minutesBeforeEventStart rdf:type rdf:Property ;
    rdfs:label 'Minutes Before Event Start' ;
    rdfs:comment 'Calculated number of minutes before the scheduled event start time that the scan occurred. Negative values indicate scans after event start. Supports ingress flow analysis, gate staffing optimization, and fan arrival behavior analytics.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:networkMode rdf:type rdf:Property ;
    rdfs:label 'Network Mode' ;
    rdfs:comment 'Connectivity state of the scanning device at the time of the scan. \'online\' = real-time validation against central entitlement database; \'offline\' = scan processed using locally cached entitlement list; \'degraded\' = partial connectivity with reduced validation capability. Affects scan result reliability and audit requirements.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideFlag rdf:type rdf:Property ;
    rdfs:label 'Override Flag' ;
    rdfs:comment 'Indicates whether the scan result was manually overridden by an authorized operator (e.g., granting access despite a system denial). Overrides require operator accountability and are flagged for post-event security audit.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:processingDurationMs rdf:type rdf:Property ;
    rdfs:label 'Processing Duration Ms' ;
    rdfs:comment 'Time in milliseconds taken by the access control device to process the scan and return a result. Used for device performance benchmarking, SLA monitoring, and identifying hardware or network latency issues at entry points.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scanDirection rdf:type rdf:Property ;
    rdfs:label 'Scan Direction' ;
    rdfs:comment 'Indicates whether the scan represents an initial entry into the venue, an exit, or a re-entry after leaving. Supports real-time occupancy tracking, re-entry policy enforcement, and post-event ingress/egress flow analysis.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scanReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Scan Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned by the Ticketmaster/AXS access control hardware to uniquely identify this scan transaction. Used for cross-system reconciliation and audit trail.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scanSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Scan Sequence Number' ;
    rdfs:comment 'Sequential count of scan attempts for this specific entitlement token within the event. A value of 1 indicates the first scan; values greater than 1 indicate re-entry or duplicate scan attempts. Critical for duplicate detection and re-entry policy enforcement.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceEventKey rdf:type rdf:Property ;
    rdfs:label 'Source Event Key' ;
    rdfs:comment 'Natural key or transaction identifier from the originating source system (Ticketmaster/AXS) for this scan record. Enables traceability back to the source system for reconciliation, reprocessing, and audit purposes in the Silver Layer.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketSourceChannel rdf:type rdf:Property ;
    rdfs:label 'Ticket Source Channel' ;
    rdfs:comment 'Distribution channel through which the scanned ticket was originally acquired. Distinguishes primary market sales, resale marketplace, season ticket packages, group sales, complimentary allocations, will-call, and mobile transfers. Supports channel attribution and revenue analytics. [ENUM-REF-CANDIDATE: primary_market|resale_marketplace|season_package|group_sales|comp|will_call|mobile_transfer — promote to reference product]' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketType rdf:type rdf:Property ;
    rdfs:label 'Ticket Type' ;
    rdfs:comment 'Classification of the ticket entitlement scanned at the gate. Reflects the pricing tier and access level: General Admission (GA), Very Important Person (VIP), Standing Room Only (SRO), season ticket, group ticket, complimentary, press credential, or staff pass. Sourced from Archtics inventory classification. [ENUM-REF-CANDIDATE: GA|VIP|SRO|season|group|comp|press|staff — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:turnstileIdentifier rdf:type rdf:Property ;
    rdfs:label 'Turnstile Identifier' ;
    rdfs:comment 'Unique identifier for the specific turnstile or lane within a gate where the scan was processed. Enables granular throughput analysis and maintenance tracking at the individual turnstile level.' ;
    rdfs:domain ind:GateScan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cateringVendorId rdf:type rdf:Property ;
    rdfs:label 'Catering Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: Group sales include catering packages fulfilled by contracted hospitality vendors (e.g., Aramark, Levy Restaurants). Linking catering_vendor_id enables vendor payment reconciliation for catering_amoun' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:cateringAmount rdf:type rdf:Property ;
    rdfs:label 'Catering Amount' ;
    rdfs:comment 'The monetary value of catering and food and beverage services included in or added to the group sale. Null if catering_included is false.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cateringIncluded rdf:type rdf:Property ;
    rdfs:label 'Catering Included' ;
    rdfs:comment 'Indicates whether a catering or food and beverage add-on is included as part of the group sale package. Triggers catering coordination workflow with venue operations.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coordinatorEmail rdf:type rdf:Property ;
    rdfs:label 'Coordinator Email' ;
    rdfs:comment 'Primary email address of the group coordinator used for booking confirmations, ticket delivery, and event-day communications.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinatorPhone rdf:type rdf:Property ;
    rdfs:label 'Coordinator Phone' ;
    rdfs:comment 'Primary phone number of the group coordinator for day-of-event logistics, access control, and urgent communications.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositAmount rdf:type rdf:Property ;
    rdfs:label 'Deposit Amount' ;
    rdfs:comment 'The initial deposit amount required to confirm and hold the group ticket block. Typically a percentage of the net_amount per group sales policy.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositDueDate rdf:type rdf:Property ;
    rdfs:label 'Deposit Due Date' ;
    rdfs:comment 'The date by which the deposit payment must be received to maintain the group ticket block reservation. Expiry triggers automatic release of inventory.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:depositReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Deposit Received Date' ;
    rdfs:comment 'The actual date on which the deposit payment was received and confirmed. Null if deposit has not yet been received.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:faceValuePrice rdf:type rdf:Property ;
    rdfs:label 'Face Value Price' ;
    rdfs:comment 'The standard published per-ticket face value price before any group discount is applied. Used as the baseline for discount calculation and revenue reporting.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalPaymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Final Payment Due Date' ;
    rdfs:comment 'The date by which the remaining balance (net_amount minus deposit_amount) must be paid in full. Typically set relative to the event date per group sales policy.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:finalPaymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Final Payment Received Date' ;
    rdfs:comment 'The actual date on which the final balance payment was received and confirmed, completing the payment obligation for the group sale.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:groupName rdf:type rdf:Property ;
    rdfs:label 'Group Name' ;
    rdfs:comment 'The name of the purchasing group or organization (e.g., \'Acme Corp Corporate Outing\', \'Lincoln Elementary School Field Trip\', \'Birthday Party - Smith Family\'). Used for fulfillment, signage, and hospitality coordination.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupType rdf:type rdf:Property ;
    rdfs:label 'Group Type' ;
    rdfs:comment 'Classification of the purchasing group by organizational category, used for pricing authority, package eligibility, and reporting segmentation. [ENUM-REF-CANDIDATE: corporate|school|community_org|birthday_party|suite_buyout|military|nonprofit|other — promote to reference product]' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hospitalityPackageCode rdf:type rdf:Property ;
    rdfs:label 'Hospitality Package Code' ;
    rdfs:comment 'Code identifying the group experience or hospitality package selected (e.g., pre-game buffet, suite catering, meet-and-greet, field access). References the hospitality package catalog.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:negotiatedPrice rdf:type rdf:Property ;
    rdfs:label 'Negotiated Price' ;
    rdfs:comment 'The agreed per-ticket price after group discount negotiation. Requires pricing authority approval when below standard group floor price.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saleDate rdf:type rdf:Property ;
    rdfs:label 'Sale Date' ;
    rdfs:comment 'The calendar date on which the group sale agreement was formally executed and confirmed by the organizational buyer.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:saleNumber rdf:type rdf:Property ;
    rdfs:label 'Sale Number' ;
    rdfs:comment 'Externally-visible, human-readable reference number for the group sale transaction used in customer communications, invoices, and fulfillment workflows. Format: GRP-YYYY-NNNNNN.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saleStatus rdf:type rdf:Property ;
    rdfs:label 'Sale Status' ;
    rdfs:comment 'Current lifecycle state of the group sale transaction, tracking progression from initial inquiry through fulfillment. [ENUM-REF-CANDIDATE: draft|pending_approval|confirmed|deposit_received|paid|fulfilled|cancelled — promote to reference product]' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatingRow rdf:type rdf:Property ;
    rdfs:label 'Seating Row' ;
    rdfs:comment 'The row designation within the assigned seating section for the group block (e.g., \'A\', \'B\', \'12\'). Null for GA or SRO allocations.' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatingTier rdf:type rdf:Property ;
    rdfs:label 'Seating Tier' ;
    rdfs:comment 'The pricing and access tier of the allocated seating block. GA (General Admission), VIP (Very Important Person), SRO (Standing Room Only), premium, suite, club, or standard. Drives pricing authority and hospitality entitlements. [ENUM-REF-CANDIDATE: GA|VIP|SRO|premium|suite|club|standard — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:GroupSale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Ticket Delivery Method' ;
    rdfs:comment 'The method by which digital or physical tickets are delivered to the group coordinator or individual attendees. Drives fulfillment workflow in Ticketmaster/AXS.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketQuantity rdf:type rdf:Property ;
    rdfs:label 'Ticket Quantity' ;
    rdfs:comment 'Total number of tickets included in this group sale. Must be 10 or greater per group sale eligibility policy.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:archticsHoldId rdf:type rdf:Property ;
    rdfs:label 'Archtics Hold Id' ;
    rdfs:comment 'Native hold identifier from the Archtics Venue Seating and Inventory Management system of record. Enables bi-directional reconciliation between the Silver layer data product and the operational Archtics platform.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Hold .

ind:presaleNotificationCampaignId rdf:type rdf:Property ;
    rdfs:label 'Presale Notification Campaign Id' ;
    rdfs:comment 'Foreign key linking to platform.notification_campaign. Business justification: Presale hold windows are activated via targeted notification campaigns to eligible fan groups. Linking hold_allocation to the presale notification_campaign enables presale conversion rate reporting — ' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NotificationCampaign .

ind:accessCode rdf:type rdf:Property ;
    rdfs:label 'Access Code' ;
    rdfs:comment 'Alphanumeric code required by eligible buyers to access a presale window associated with this hold allocation. Confidential as it controls access to restricted inventory. Null for non-presale hold types.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:faceValue rdf:type rdf:Property ;
    rdfs:label 'Face Value' ;
    rdfs:comment 'Printed face value per ticket in the held block, expressed in the event\'s operating currency. Used for comp valuation, sponsor entitlement reporting, and revenue recognition under SAP S/4HANA SD.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdCode rdf:type rdf:Property ;
    rdfs:label 'Hold Code' ;
    rdfs:comment 'Externally-known alphanumeric code assigned to this hold allocation block, used by Ticketmaster/AXS and Archtics to reference the hold in operational workflows and reporting. Serves as the business-facing identifier for the hold.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Hold Created Timestamp' ;
    rdfs:comment 'Date and time when this hold allocation was first placed in the ticketing system. Represents the principal business event timestamp — the moment inventory was removed from general availability. Sourced from Ticketmaster/AXS or Archtics system of record.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:holdExpiryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Hold Expiry Timestamp' ;
    rdfs:comment 'Date and time at which this hold allocation automatically expires and unreleased inventory is returned to general on-sale pool. Critical for tiered on-sale sequencing and inventory management SLA enforcement.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:holdOwner rdf:type rdf:Property ;
    rdfs:label 'Hold Owner' ;
    rdfs:comment 'Name or identifier of the business unit, partner, or individual responsible for managing this hold allocation (e.g., sponsor name, artist management agency, media partner, venue operations team). Operational accountability field used in Archtics hold management workflows.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdReason rdf:type rdf:Property ;
    rdfs:label 'Hold Reason' ;
    rdfs:comment 'Narrative description of the business justification for placing this hold allocation (e.g., \'Platinum sponsor contractual comp entitlement Q3\', \'Artist rider requirement - 50 house seats\', \'Media credential access - broadcast partners\'). Supports audit and compliance review.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAdaHold rdf:type rdf:Property ;
    rdfs:label 'Is Ada Hold' ;
    rdfs:comment 'Indicates whether this hold allocation is designated for Americans with Disabilities Act (ADA) accessible seating. ADA holds are subject to specific regulatory requirements for accessible seat inventory management.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isComp rdf:type rdf:Property ;
    rdfs:label 'Is Comp' ;
    rdfs:comment 'Indicates whether tickets in this hold allocation are designated as complimentary (zero face value distribution). Comp holds require separate revenue recognition treatment under SAP S/4HANA FI/CO and SOX financial controls.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDynamicPricingEligible rdf:type rdf:Property ;
    rdfs:label 'Is Dynamic Pricing Eligible' ;
    rdfs:comment 'Indicates whether tickets in this hold allocation are subject to dynamic pricing adjustments when released to general inventory. False for comp, ADA, and fixed-price sponsor holds.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxTicketsPerBuyer rdf:type rdf:Property ;
    rdfs:label 'Max Tickets Per Buyer' ;
    rdfs:comment 'Maximum number of tickets a single eligible buyer may purchase from this hold allocation during the presale or comp distribution window. Enforces per-buyer limits to prevent bulk purchasing and ensure equitable access.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:presaleWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Presale Window End' ;
    rdfs:comment 'Date and time when the presale window closes for this hold allocation. Unreleased inventory after this timestamp is subject to release rules defined by hold_expiry_timestamp or manual release.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:presaleWindowStart rdf:type rdf:Property ;
    rdfs:label 'Presale Window Start' ;
    rdfs:comment 'Date and time when the presale window opens for this hold allocation, allowing eligible buyers to purchase before general public on-sale. Applicable when hold_type is presale. Drives tiered on-sale sequencing.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:publicOnsaleTimestamp rdf:type rdf:Property ;
    rdfs:label 'Public Onsale Timestamp' ;
    rdfs:comment 'Date and time of the general public on-sale for the event. Used to calculate the lead time between hold creation and public availability, and to enforce release deadlines for presale and comp holds.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:quantityConsumed rdf:type rdf:Property ;
    rdfs:label 'Quantity Consumed' ;
    rdfs:comment 'Number of tickets from this hold allocation that have been issued, distributed, or sold (e.g., comps distributed to sponsor, presale tickets sold). Tracks actual utilization of the hold block.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quantityHeld rdf:type rdf:Property ;
    rdfs:label 'Quantity Held' ;
    rdfs:comment 'Total number of tickets/seats placed on hold under this allocation record. Represents the gross inventory block size at the time the hold was created.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quantityReleased rdf:type rdf:Property ;
    rdfs:label 'Quantity Released' ;
    rdfs:comment 'Number of tickets from this hold allocation that have been released back to general on-sale inventory. Enables tracking of partial releases and remaining hold balance.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:releaseToPool rdf:type rdf:Property ;
    rdfs:label 'Release To Pool' ;
    rdfs:comment 'Designates the inventory pool to which unreleased tickets from this hold will be returned upon expiry or manual release. Controls tiered on-sale sequencing and resale marketplace eligibility.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatFrom rdf:type rdf:Property ;
    rdfs:label 'Seat From' ;
    rdfs:comment 'Starting seat number in the contiguous block of held seats within the specified section and row. Used with seat_to to define the exact seat range held in Archtics inventory.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatTo rdf:type rdf:Property ;
    rdfs:label 'Seat To' ;
    rdfs:comment 'Ending seat number in the contiguous block of held seats within the specified section and row. Used with seat_from to define the exact seat range held in Archtics inventory.' ;
    rdfs:domain ind:HoldAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:archticsPassCode rdf:type rdf:Property ;
    rdfs:label 'Archtics Pass Code' ;
    rdfs:comment 'The native parking pass identifier assigned by the Archtics venue inventory management system. Used for reconciliation between the lakehouse Silver layer and the operational source system.' ;
    rdfs:domain ind:ParkingPass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bundleType rdf:type rdf:Property ;
    rdfs:label 'Bundle Type' ;
    rdfs:comment 'Describes the bundling context of the parking pass. Standalone indicates a direct purchase; season_package indicates inclusion in a season ticket plan; group_sale indicates part of a group booking; hospitality indicates a VIP/hospitality package inclusion; comp indicates a complimentary pass.' ;
    rdfs:domain ind:ParkingPass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compReasonCode rdf:type rdf:Property ;
    rdfs:label 'Comp Reason Code' ;
    rdfs:comment 'Coded reason for issuing a complimentary parking pass (e.g., SPONSOR, MEDIA, ATHLETE, VIP_GUEST, STAFF). Required when is_comp is true for audit and cost allocation purposes.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalPassRef rdf:type rdf:Property ;
    rdfs:label 'External Pass Ref' ;
    rdfs:comment 'External reference number assigned by Ticketmaster or AXS for this parking pass. Supports cross-system reconciliation and customer service lookups.' ;
    rdfs:domain ind:ParkingPass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBundled rdf:type rdf:Property ;
    rdfs:label 'Is Bundled' ;
    rdfs:comment 'Indicates whether this parking pass was sold as part of a bundled ticket package (e.g., included with a season ticket or VIP hospitality package) rather than purchased as a standalone item.' ;
    rdfs:domain ind:ParkingPass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lotCode rdf:type rdf:Property ;
    rdfs:label 'Lot Code' ;
    rdfs:comment 'Alphanumeric code identifying the specific parking lot or structure assigned to this pass. Corresponds to the venue\'s parking inventory manifest in Archtics.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lotZone rdf:type rdf:Property ;
    rdfs:label 'Lot Zone' ;
    rdfs:comment 'Sub-zone designation within the parking lot (e.g., \'Zone 1\', \'Row C\'). Provides finer-grained location detail for large multi-zone lots.' ;
    rdfs:domain ind:ParkingPass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passNumber rdf:type rdf:Property ;
    rdfs:label 'Pass Number' ;
    rdfs:comment 'Externally visible, human-readable identifier for the parking pass as printed on the physical or digital credential. Used for gate validation and customer service lookup.' ;
    rdfs:domain ind:ParkingPass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passStatus rdf:type rdf:Property ;
    rdfs:label 'Pass Status' ;
    rdfs:comment 'Current lifecycle status of the parking pass. Drives access control decisions and revenue reporting. [ENUM-REF-CANDIDATE: active|used|cancelled|expired|voided|transferred — promote to reference product if additional statuses are required]' ;
    rdfs:domain ind:ParkingPass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passType rdf:type rdf:Property ;
    rdfs:label 'Pass Type' ;
    rdfs:comment 'Classification of the parking pass by access tier and amenity level. General (GA) passes provide standard lot access; VIP passes provide premium proximity; tailgate passes include designated tailgate zone access; accessible passes comply with ADA requirements. [ENUM-REF-CANDIDATE: general|vip|tailgate|accessible|staff|media — promote to reference product]' ;
    rdfs:domain ind:ParkingPass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceFee rdf:type rdf:Property ;
    rdfs:label 'Service Fee' ;
    rdfs:comment 'Convenience or service fee charged on top of the face value for processing and distribution of the parking pass.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validDate rdf:type rdf:Property ;
    rdfs:label 'Valid Date' ;
    rdfs:comment 'The calendar date on which this parking pass is valid for use. For single-event passes, this matches the event date. For multi-day events, this may differ from the event start date.' ;
    rdfs:domain ind:ParkingPass ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eligibilityRule rdf:type rdf:Property ;
    rdfs:label 'Eligibility Rule' ;
    rdfs:comment 'Free-text or structured rule expression defining who is eligible to purchase tickets at this tier (e.g., \'Season ticket holders only\', \'Members with Gold status\', \'Military/First Responder ID required\', \'Age 12 and under\'). Enforced at point of sale in Ticketmaster/AXS.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalTierCode rdf:type rdf:Property ;
    rdfs:label 'External Tier Code' ;
    rdfs:comment 'The pricing tier identifier as assigned by the external ticketing system of record (Ticketmaster/AXS or Archtics). Used for system integration, reconciliation, and cross-system data lineage. Enables mapping between the internal BIGINT PK and the source system\'s native identifier.' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityFee rdf:type rdf:Property ;
    rdfs:label 'Facility Fee' ;
    rdfs:comment 'Per-ticket facility/venue fee charged at this tier, retained by the venue operator to fund venue operations and capital improvements. Distinct from the service fee and reported separately in venue revenue accounting.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:includesHospitality rdf:type rdf:Property ;
    rdfs:label 'Includes Hospitality' ;
    rdfs:comment 'Indicates whether hospitality benefits (food and beverage, lounge access, pre-event reception) are bundled with this pricing tier. Applicable to VIP, suite, and premium club tiers. Drives hospitality operations planning.' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesMerchandise rdf:type rdf:Property ;
    rdfs:label 'Includes Merchandise' ;
    rdfs:comment 'Indicates whether a merchandise item or voucher (e.g., team jersey, program, gift bag) is bundled with tickets at this pricing tier as part of the package offering.' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includesParking rdf:type rdf:Property ;
    rdfs:label 'Includes Parking' ;
    rdfs:comment 'Indicates whether a parking pass is bundled with tickets at this pricing tier as part of the ticket package (e.g., VIP and suite tiers often include complimentary parking).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inventoryClass rdf:type rdf:Property ;
    rdfs:label 'Inventory Class' ;
    rdfs:comment 'Archtics inventory classification that maps this pricing tier to a physical seating inventory class within the venue manifest. Drives seat map allocation and capacity planning in Archtics Venue Seating Inventory system.' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxPrice rdf:type rdf:Property ;
    rdfs:label 'Max Price' ;
    rdfs:comment 'The maximum allowable price for this tier when dynamic pricing is active. The dynamic pricing engine will not price tickets above this ceiling value. Null when dynamic_pricing_enabled is False.' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxTicketsPerOrder rdf:type rdf:Property ;
    rdfs:label 'Max Tickets Per Order' ;
    rdfs:comment 'Maximum number of tickets at this tier that a single fan/customer may purchase in one order transaction. Enforces anti-scalping and fair access policies. Configured in Ticketmaster/AXS order rules.' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberExclusive rdf:type rdf:Property ;
    rdfs:label 'Member Exclusive' ;
    rdfs:comment 'Indicates whether this pricing tier is exclusively available to registered members or season ticket holders, restricting general public purchase. Integrates with Salesforce CRM membership validation at checkout.' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minPrice rdf:type rdf:Property ;
    rdfs:label 'Min Price' ;
    rdfs:comment 'The minimum allowable price for this tier when dynamic pricing is active. The dynamic pricing engine will not price tickets below this floor value. Null when dynamic_pricing_enabled is False.' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minTicketsPerOrder rdf:type rdf:Property ;
    rdfs:label 'Min Tickets Per Order' ;
    rdfs:comment 'Minimum number of tickets at this tier required per order transaction. Primarily applicable to group sales tiers where a minimum group size must be met (e.g., minimum 10 tickets for group pricing).' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:presaleEligible rdf:type rdf:Property ;
    rdfs:label 'Presale Eligible' ;
    rdfs:comment 'Indicates whether tickets at this tier are available during presale windows (e.g., fan club presale, sponsor presale, credit card presale) before general public on-sale. Drives presale campaign configuration in Ticketmaster/AXS.' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priceTierDescription rdf:type rdf:Property ;
    rdfs:label 'Price Tier Description' ;
    rdfs:comment 'Detailed marketing and operational description of the pricing tier, including benefits, inclusions, and eligibility notes. Displayed to fans on the ticketing platform and used by box office staff for customer service.' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceTierStatus rdf:type rdf:Property ;
    rdfs:label 'Price Tier Status' ;
    rdfs:comment 'Current lifecycle state of the pricing tier: active (available for sale), inactive (temporarily unavailable), draft (under configuration, not yet published), archived (retired, historical reference only), suspended (paused pending review). Controls availability in the dynamic pricing engine and order processing.' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resaleEligible rdf:type rdf:Property ;
    rdfs:label 'Resale Eligible' ;
    rdfs:comment 'Indicates whether tickets at this pricing tier are eligible for listing on the secondary/resale marketplace. When False, tickets are non-transferable and resale is prohibited (e.g., certain VIP hospitality packages or promotional tickets).' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resaleMinPrice rdf:type rdf:Property ;
    rdfs:label 'Resale Min Price' ;
    rdfs:comment 'Minimum price at which a ticket of this tier may be listed on the secondary resale marketplace. Enforces floor pricing to protect face value integrity and prevent below-cost resale. Null when resale_eligible is False.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:seatingType rdf:type rdf:Property ;
    rdfs:label 'Seating Type' ;
    rdfs:comment 'Physical seating configuration associated with this pricing tier: RESERVED (assigned seat), GENERAL_ADMISSION (first-come seating), STANDING (standing area), SUITE (private suite), BOX (premium box), or ACCESSIBLE (ADA-compliant seating). Determines access control and entry validation logic.' ;
    rdfs:domain ind:PriceTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sortOrder rdf:type rdf:Property ;
    rdfs:label 'Sort Order' ;
    rdfs:comment 'Numeric display sort order for presenting pricing tiers in the correct sequence on ticketing platforms, box office interfaces, and fan-facing purchase flows. Lower values appear first.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taxRate rdf:type rdf:Property ;
    rdfs:label 'Tax Rate' ;
    rdfs:comment 'Applicable tax rate (as a decimal fraction, e.g., 0.0875 for 8.75%) applied to the face value for this pricing tier, based on the jurisdiction of the venue. Used by the order processing system for tax calculation and SAP S/4HANA tax reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierCategory rdf:type rdf:Property ;
    rdfs:label 'Tier Category' ;
    rdfs:comment 'High-level classification of the pricing tier aligned with industry-standard seating categories: GA (General Admission), VIP (Very Important Person), SRO (Standing Room Only), PREMIUM, SUITE, ACCESSIBLE (ADA-compliant), CLUB, or FIELD level. Drives dynamic pricing engine segmentation and reporting. [ENUM-REF-CANDIDATE: GA|VIP|SRO|PREMIUM|SUITE|ACCESSIBLE|CLUB|FIELD — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierCode rdf:type rdf:Property ;
    rdfs:label 'Tier Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying the pricing tier across systems (e.g., GA01, VIP_PLAT, SRO_STD, SUITE_A). Used as the business key in Ticketmaster/AXS and Archtics integrations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierName rdf:type rdf:Property ;
    rdfs:label 'Tier Name' ;
    rdfs:comment 'Human-readable display name for the pricing tier as shown to fans and box office staff (e.g., \'General Admission\', \'VIP Platinum\', \'Standing Room Only\', \'Club Level Premium\').' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierType rdf:type rdf:Property ;
    rdfs:label 'Tier Type' ;
    rdfs:comment 'Classifies the commercial packaging type of the tier: SINGLE_EVENT (per-event ticket), SEASON_PACKAGE (full season ticket), GROUP_SALES (bulk group purchase), MINI_PLAN (partial season plan), or FLEX_PLAN (flexible game selection plan). Determines eligibility rules and order processing logic.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeDescription rdf:type rdf:Property ;
    rdfs:label 'Code Description' ;
    rdfs:comment 'Detailed description of the promotional offer, including terms, eligible events, and intended audience. Used for internal documentation and customer-facing display in checkout flows.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeName rdf:type rdf:Property ;
    rdfs:label 'Code Name' ;
    rdfs:comment 'Descriptive internal name for the promotional code offer, used by marketing and ticketing operations staff to identify the promotion (e.g., \'Summer Season Opener 25% Off\', \'VIP Early Bird 2024\').' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeStatus rdf:type rdf:Property ;
    rdfs:label 'Code Status' ;
    rdfs:comment 'Current lifecycle state of the promotional code. \'draft\' = configured but not yet live; \'active\' = available for redemption; \'paused\' = temporarily suspended; \'expired\' = past validity window; \'exhausted\' = usage limit reached; \'cancelled\' = manually deactivated.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeString rdf:type rdf:Property ;
    rdfs:label 'Code String' ;
    rdfs:comment 'The human-readable alphanumeric code string that fans enter at checkout to redeem the discount (e.g., SUMMER25, VIP2024, BOGO_NBA). Must be unique across all active codes. Sourced from Ticketmaster/AXS promo code configuration.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeType rdf:type rdf:Property ;
    rdfs:label 'Code Type' ;
    rdfs:comment 'Indicates whether the code is a single fixed string reusable by multiple fans (multi_use), a one-time-use code (single_use), or part of a batch of unique codes each valid once (unique_batch). Drives redemption validation logic in Ticketmaster/AXS.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleSalesChannel rdf:type rdf:Property ;
    rdfs:label 'Eligible Sales Channel' ;
    rdfs:comment 'The sales channel(s) through which this promotional code may be redeemed: \'online\' = web checkout; \'mobile\' = mobile app; \'box_office\' = in-venue point of sale (POS); \'group_sales\' = group sales desk; \'all\' = no channel restriction.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalPromoRef rdf:type rdf:Property ;
    rdfs:label 'External Promo Ref' ;
    rdfs:comment 'The identifier assigned to this promotional code in the originating source system (e.g., Ticketmaster promo ID, Salesforce campaign member ID). Enables cross-system reconciliation and audit tracing.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPresale rdf:type rdf:Property ;
    rdfs:label 'Is Presale' ;
    rdfs:comment 'Indicates whether this promotional code grants access to a presale window before the general public on-sale date. True = presale access code; False = standard discount code with no presale privilege.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSeasonTicketHolderExclusive rdf:type rdf:Property ;
    rdfs:label 'Is Season Ticket Holder Exclusive' ;
    rdfs:comment 'Indicates whether this promotional code is exclusively available to season ticket holders (STH). True = restricted to verified STH accounts in Archtics; False = available to general fan base.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSingleEvent rdf:type rdf:Property ;
    rdfs:label 'Is Single Event' ;
    rdfs:comment 'Indicates whether this promotional code is scoped to a single specific event (True) or is valid across multiple events within the validity window (False). Drives event-level restriction enforcement in Ticketmaster/AXS.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxDiscountAmount rdf:type rdf:Property ;
    rdfs:label 'Max Discount Amount' ;
    rdfs:comment 'Cap on the maximum discount value that can be applied per redemption, expressed in the applicable currency. Primarily used with percentage-type codes to prevent excessive discounting on high-value orders. Null if no cap applies.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxTicketsPerRedemption rdf:type rdf:Property ;
    rdfs:label 'Max Tickets Per Redemption' ;
    rdfs:comment 'Maximum number of tickets that can be purchased in a single order using this promotional code. Prevents bulk purchasing abuse, particularly relevant for presale and fan-exclusive offers.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minOrderAmount rdf:type rdf:Property ;
    rdfs:label 'Min Order Amount' ;
    rdfs:comment 'Minimum qualifying ticket order value (in the applicable currency) required before the promotional code can be applied. Enforced at checkout to prevent misuse on low-value transactions. Null if no minimum threshold applies.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:redeemedDiscountTotal rdf:type rdf:Property ;
    rdfs:label 'Redeemed Discount Total' ;
    rdfs:comment 'Cumulative sum of all discount amounts granted through successful redemptions of this promotional code, expressed in the applicable currency. Updated from ticket order transactions. Used to monitor budget consumption.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usageLimitPerFan rdf:type rdf:Property ;
    rdfs:label 'Usage Limit Per Fan' ;
    rdfs:comment 'Maximum number of times a single fan account may redeem this promotional code. Enforced via fan_id lookup at checkout to prevent abuse. Null indicates no per-fan restriction.' ;
    rdfs:domain ind:PromoCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:createdBy rdf:type rdf:Property ;
    rdfs:label 'Created By' ;
    rdfs:comment 'Name or employee identifier of the user who created this promotional code record. Business audit field (not a technical ETL field) supporting accountability and governance for discount issuance.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundId rdf:type rdf:Property ;
    rdfs:label 'Refund Id' ;
    rdfs:comment 'Unique system-generated surrogate identifier for the ticket refund record. Primary key for the refund data product in the ticketing domain Silver layer.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvalAgentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approval Agent Employee Id' ;
    rdfs:comment 'Reference to the customer service agent or system user who approved the refund request. Null for auto-approved refunds triggered by event cancellation rules. Supports SOX segregation-of-duties audit.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:approvalLevel rdf:type rdf:Property ;
    rdfs:label 'Approval Level' ;
    rdfs:comment 'The authorization tier at which the refund was approved. AUTO indicates system-triggered approval (e.g., event cancellation policy); AGENT, SUPERVISOR, and FINANCE indicate escalating human approval tiers based on refund amount thresholds.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossRefundAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Refund Amount' ;
    rdfs:comment 'The total face value of the ticket(s) being refunded before any deductions such as service fees or processing charges. Represents the base monetary amount subject to reversal in SAP FI.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isEventInitiated rdf:type rdf:Property ;
    rdfs:label 'Is Event Initiated' ;
    rdfs:comment 'Indicates whether the refund was triggered by an event-level action (cancellation, postponement, force majeure) rather than a fan-initiated request. Drives bulk refund processing workflows and league governance reporting.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFraudRelated rdf:type rdf:Property ;
    rdfs:label 'Is Fraud Related' ;
    rdfs:comment 'Indicates whether the refund was initiated due to a confirmed or suspected fraudulent transaction. When true, triggers PCI-DSS fraud incident reporting and Salesforce CRM fraud case creation.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalPaymentMethod rdf:type rdf:Property ;
    rdfs:label 'Original Payment Method' ;
    rdfs:comment 'The payment instrument used in the original ticket purchase transaction. Determines eligibility for ORIGINAL_PAYMENT refund routing and informs PCI-DSS cardholder data handling requirements.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTransactionRef rdf:type rdf:Property ;
    rdfs:label 'Payment Transaction Ref' ;
    rdfs:comment 'The external payment processor transaction reference number for the refund settlement (e.g., Stripe charge ID, Adyen PSP reference). Used for reconciliation between Ticketmaster/AXS and the payment gateway. Never stores raw card data.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processed Timestamp' ;
    rdfs:comment 'The date and time when the refund was submitted to the payment processor or credit wallet system for execution. Distinct from approved_timestamp; marks the point of financial commitment.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:refundNumber rdf:type rdf:Property ;
    rdfs:label 'Refund Number' ;
    rdfs:comment 'Externally visible, human-readable refund reference number issued to the fan and used in customer service communications. Formatted as RFD- followed by a 10-digit sequence. Sourced from Ticketmaster/AXS refund workflow.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundStatus rdf:type rdf:Property ;
    rdfs:label 'Refund Status' ;
    rdfs:comment 'Current lifecycle state of the refund request within the approval and processing workflow. Drives operational queues in Ticketmaster/AXS and SAP FI posting logic.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundType rdf:type rdf:Property ;
    rdfs:label 'Refund Type' ;
    rdfs:comment 'Indicates whether the refund covers the full ticket face value (FULL), a portion of the ticket value (PARTIAL), or is issued as a credit/voucher rather than a monetary return (CREDIT). Drives revenue recognition reversal logic in SAP CO.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resaleRefundFlag rdf:type rdf:Property ;
    rdfs:label 'Resale Refund Flag' ;
    rdfs:comment 'Indicates whether the refund relates to a ticket purchased through the secondary/resale marketplace rather than the primary box office. Resale refunds may follow different policy rules and fee structures.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceFeeRefundAmount rdf:type rdf:Property ;
    rdfs:label 'Service Fee Refund Amount' ;
    rdfs:comment 'The portion of the refund attributable to service fees originally charged on the ticket purchase. May be zero if service fees are non-refundable per the event\'s refund policy. Tracked separately for revenue accounting in SAP CO.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystemRefundCode rdf:type rdf:Property ;
    rdfs:label 'Source System Refund Code' ;
    rdfs:comment 'The native refund identifier as recorded in the originating operational system (e.g., Ticketmaster refund transaction ID, SAP FI document number). Enables cross-system reconciliation and audit trail back to the system of record.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxRefundAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Refund Amount' ;
    rdfs:comment 'The tax component being reversed as part of the refund. Required for VAT/GST compliance reporting in applicable jurisdictions and SAP FI tax reversal postings.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voucherCode rdf:type rdf:Property ;
    rdfs:label 'Voucher Code' ;
    rdfs:comment 'The unique alphanumeric voucher code issued to the fan when refund_method is VOUCHER. Redeemable against future ticket purchases in Ticketmaster/AXS. Null for non-voucher refund methods.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voucherExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Voucher Expiry Date' ;
    rdfs:comment 'The date on which the issued refund voucher expires and can no longer be redeemed. Applicable only when refund_method is VOUCHER. Null for monetary refund methods.' ;
    rdfs:domain ind:Refund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resaleId rdf:type rdf:Property ;
    rdfs:label 'Resale Id' ;
    rdfs:comment 'Primary key for resale' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:buyerFanFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Buyer Fan Fan Profile Id' ;
    rdfs:comment 'Reference to the fan/account record of the individual who purchased or received the resale ticket. Populated upon transaction completion or transfer acceptance.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:marketplaceVendorId rdf:type rdf:Property ;
    rdfs:label 'Marketplace Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: Resale marketplaces (StubHub, SeatGeek, Ticketmaster Resale) are contracted vendors with revenue share agreements. Linking enables revenue_share_amount reconciliation against vendor contracts, anti-sc' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:originalAccessEntitlementId rdf:type rdf:Property ;
    rdfs:label 'Original Access Entitlement Id' ;
    rdfs:comment 'Foreign key linking to ticketing.access_entitlement. Business justification: A resale transaction invalidates the original access entitlement and triggers issuance of a new one. Linking resale to the original access_entitlement via original_access_entitlement_id enables full l' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccessEntitlement .

ind:originalTicketOrderLineId rdf:type rdf:Property ;
    rdfs:label 'Original Ticket Order Line Id' ;
    rdfs:comment 'Foreign key linking to ticketing.ticket_order_line. Business justification: A resale transaction originates from a specific ticket that was originally purchased as a line item in a ticket order. Linking resale to the original ticket_order_line via original_ticket_order_line_i' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TicketOrderLine .

ind:originalTicketTicketInventoryId rdf:type rdf:Property ;
    rdfs:label 'Original Ticket Ticket Inventory Id' ;
    rdfs:comment 'Reference to the primary market ticket record from which this resale lifecycle originated. Links the secondary market activity back to the original ticketing entitlement.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TicketInventory .

ind:resaleBuyerFanFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Resale Buyer Fan Fan Profile Id' ;
    rdfs:comment 'Reference to the fan/account record of the individual who purchased or received the resale ticket. Populated upon transaction completion or transfer acceptance.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:resaleFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Resale Fan Profile Id' ;
    rdfs:comment 'Reference to the fan/account record of the individual or entity listing the ticket for resale or transfer. Used for seller identity verification and anti-scalping compliance.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:antiScalpingCompliant rdf:type rdf:Property ;
    rdfs:label 'Anti Scalping Compliant' ;
    rdfs:comment 'Indicates whether the resale transaction complies with applicable anti-scalping rules (e.g., price cap relative to face value, seller type restrictions, event-specific resale windows). True = compliant; False = violation flagged for review.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:antiScalpingRuleCode rdf:type rdf:Property ;
    rdfs:label 'Anti Scalping Rule Code' ;
    rdfs:comment 'The specific anti-scalping rule or policy code applied to evaluate this transaction (e.g., \'PRICE_CAP_150PCT\', \'STH_ONLY_RESALE\', \'BLACKOUT_WINDOW\'). Populated when anti_scalping_compliant is False to identify the violated rule.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dynamicPricingApplied rdf:type rdf:Property ;
    rdfs:label 'Dynamic Pricing Applied' ;
    rdfs:comment 'Indicates whether the marketplace applied dynamic pricing algorithms to adjust the listing price during the active listing period. True = dynamic pricing was applied; False = static listing price maintained.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:listingCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Listing Created Timestamp' ;
    rdfs:comment 'The date and time when the seller created the resale listing on the marketplace platform. Represents the start of the resale lifecycle. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:listingExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Listing Expiry Date' ;
    rdfs:comment 'The date on which the resale listing automatically expires if not sold or withdrawn. Typically set to the event date. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:listingPrice rdf:type rdf:Property ;
    rdfs:label 'Listing Price' ;
    rdfs:comment 'The asking price set by the seller at the time of listing creation, in the transaction currency. Represents the gross amount the buyer is expected to pay before marketplace fees.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:listingReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Listing Reference Number' ;
    rdfs:comment 'Externally visible alphanumeric identifier assigned to the resale listing by the marketplace platform (e.g., Ticketmaster Fan-to-Fan, AXS Marketplace). Used by sellers and buyers to reference a specific listing.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newEntitlementToken rdf:type rdf:Property ;
    rdfs:label 'New Entitlement Token' ;
    rdfs:comment 'The new digital access token or barcode issued to the buyer/recipient upon completion of the resale or transfer. Replaces the original ticket token and is used for venue access control via Ticketmaster/AXS or Archtics.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalEntitlementToken rdf:type rdf:Property ;
    rdfs:label 'Original Entitlement Token' ;
    rdfs:comment 'The digital access token or barcode of the original ticket that was invalidated upon resale or transfer. Retained for audit trail and anti-fraud verification purposes.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalFaceValue rdf:type rdf:Property ;
    rdfs:label 'Original Face Value' ;
    rdfs:comment 'The primary market face value of the ticket at the time of original purchase. Used to calculate price uplift, anti-scalping cap compliance, and revenue share calculations.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:platformFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Platform Fee Amount' ;
    rdfs:comment 'The fee charged by the marketplace platform (e.g., Ticketmaster, AXS) for facilitating the resale transaction. Deducted from the sale price before calculating seller proceeds.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceUpliftPct rdf:type rdf:Property ;
    rdfs:label 'Price Uplift Pct' ;
    rdfs:comment 'The percentage by which the sale_price exceeds the original_face_value, calculated as ((sale_price - original_face_value) / original_face_value) * 100. Used for anti-scalping compliance monitoring and dynamic pricing analytics.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueShareAmount rdf:type rdf:Property ;
    rdfs:label 'Revenue Share Amount' ;
    rdfs:comment 'The portion of the resale sale price allocated back to the league, team, or rights holder per the applicable revenue share agreement. Calculated based on revenue_share_rate applied to the sale price.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueShareRate rdf:type rdf:Property ;
    rdfs:label 'Revenue Share Rate' ;
    rdfs:comment 'The contractual percentage rate (expressed as a decimal, e.g., 0.0500 = 5%) applied to the sale price to calculate the revenue_share_amount owed to the rights holder. Sourced from the applicable league or team revenue share agreement.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salePrice rdf:type rdf:Property ;
    rdfs:label 'Sale Price' ;
    rdfs:comment 'The final price at which the ticket was sold on the secondary market. May differ from listing_price due to dynamic pricing adjustments or negotiated changes. Populated only when lifecycle_status is \'sold\'.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sellerProceeds rdf:type rdf:Property ;
    rdfs:label 'Seller Proceeds' ;
    rdfs:comment 'Net amount remitted to the seller after deducting platform fees and any applicable revenue share from the sale price. Represents the seller\'s actual payout for the transaction.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sellerType rdf:type rdf:Property ;
    rdfs:label 'Seller Type' ;
    rdfs:comment 'Classification of the seller entity: season_ticket_holder (STH reselling allocated seats), individual_fan (casual reseller), broker (licensed ticket broker), corporate_account (business account holder). Drives anti-scalping rule applicability and revenue share tiers.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemListingCode rdf:type rdf:Property ;
    rdfs:label 'Source System Listing Code' ;
    rdfs:comment 'The native listing identifier from the originating marketplace system (Ticketmaster, AXS, or other platform). Enables reconciliation between the Silver layer resale record and the operational source system record.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketTier rdf:type rdf:Property ;
    rdfs:label 'Ticket Tier' ;
    rdfs:comment 'The pricing and access tier of the resale ticket: GA (General Admission), VIP (Very Important Person), SRO (Standing Room Only), premium, or standard. Drives anti-scalping cap thresholds and revenue share tier applicability.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Transfer Restriction Flag' ;
    rdfs:comment 'Indicates whether the original ticket carried a transfer restriction (e.g., non-transferable VIP package, restricted season ticket). True = transfer restrictions applied; False = no restrictions. Used to validate eligibility for resale or transfer.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transferTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transfer Timestamp' ;
    rdfs:comment 'The date and time when a peer-to-peer ticket transfer (gift or forward) was completed and the new entitlement was issued to the recipient. Distinct from transaction_timestamp which applies to commercial sales. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:Resale ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:accountRepEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Account Rep Employee Id' ;
    rdfs:comment 'Reference to the internal sales or account management representative assigned to this season ticket account in Salesforce CRM. Drives relationship management workflows and commission tracking.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accountBalance rdf:type rdf:Property ;
    rdfs:label 'Account Balance' ;
    rdfs:comment 'Current outstanding balance on the season ticket account. Positive value indicates amount owed by the fan; negative value indicates a credit. Sourced from SAP S/4HANA AR sub-ledger.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adaAccommodation rdf:type rdf:Property ;
    rdfs:label 'Ada Accommodation' ;
    rdfs:comment 'Indicates whether the season ticket account has an Americans with Disabilities Act (ADA) accessibility accommodation on record, such as wheelchair-accessible seating or companion seat requirements.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communicationPreference rdf:type rdf:Property ;
    rdfs:label 'Communication Preference' ;
    rdfs:comment 'Preferred communication channel for season ticket account notifications, renewal reminders, and promotional messages. Drives outbound campaign routing in Salesforce CRM and Adobe Experience Platform.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forwardTicketOptIn rdf:type rdf:Property ;
    rdfs:label 'Forward Ticket Opt In' ;
    rdfs:comment 'Indicates whether the season ticket holder has enabled the ticket forwarding feature, allowing them to digitally transfer individual game tickets to guests via the Ticketmaster/AXS platform.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:installmentCount rdf:type rdf:Property ;
    rdfs:label 'Installment Count' ;
    rdfs:comment 'Total number of installment payments scheduled for the season ticket package under the selected payment plan. Applicable when payment_plan_type is \'installment\' or \'auto_pay\'.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastNpsSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Last Nps Survey Date' ;
    rdfs:comment 'Date on which the most recent Net Promoter Score (NPS) survey was completed by the season ticket holder. Used to control survey frequency and track sentiment trends over time.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:netPackageAmount rdf:type rdf:Property ;
    rdfs:label 'Net Package Amount' ;
    rdfs:comment 'Net amount payable for the season ticket package after all discounts are applied (face_value_amount minus discount_amount). Represents the contractual obligation amount. Satisfies MONETARY_TRIPLET net-total component.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Next Payment Date' ;
    rdfs:comment 'Date on which the next scheduled payment is due for this season ticket account. Used to trigger payment reminders and auto-payment processing.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:parkingIncluded rdf:type rdf:Property ;
    rdfs:label 'Parking Included' ;
    rdfs:comment 'Indicates whether the season ticket package includes a parking pass entitlement for home events at the venue.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentPlanStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Status' ;
    rdfs:comment 'Current status of the payment plan for this season ticket account. Drives collections workflows, account suspension triggers, and financial reporting.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPlanType rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Type' ;
    rdfs:comment 'Type of payment arrangement selected by the season ticket holder. Determines billing schedule, installment frequency, and auto-payment eligibility.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resaleOptIn rdf:type rdf:Property ;
    rdfs:label 'Resale Opt In' ;
    rdfs:comment 'Indicates whether the season ticket holder has opted into the official resale marketplace program, allowing unused tickets to be listed for resale through the organization\'s authorized platform.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rowCode rdf:type rdf:Property ;
    rdfs:label 'Row Code' ;
    rdfs:comment 'Row identifier within the assigned section for the season ticket seats (e.g., \'A\', \'B\', \'12\'). Used for access control and seat map display.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatCount rdf:type rdf:Property ;
    rdfs:label 'Seat Count' ;
    rdfs:comment 'Total number of seats assigned to this season ticket account. A single account may hold multiple contiguous or non-contiguous seats.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seatNumbers rdf:type rdf:Property ;
    rdfs:label 'Seat Numbers' ;
    rdfs:comment 'Comma-separated list of seat numbers within the assigned row for this account (e.g., \'5,6,7\'). Stored as a delimited string since seat assignments are managed atomically at the account level in Archtics.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectionCode rdf:type rdf:Property ;
    rdfs:label 'Section Code' ;
    rdfs:comment 'Alphanumeric code identifying the venue section where the season ticket seats are located (e.g., \'101\', \'CLUB-A\', \'SUITE-12\'). Sourced from Archtics seating inventory.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemAccountRef rdf:type rdf:Property ;
    rdfs:label 'Source System Account Ref' ;
    rdfs:comment 'Native account identifier from the originating operational system (Archtics or Ticketmaster/AXS) used for reconciliation and lineage tracing between the Silver Layer and the system of record.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sthLoyaltyTier rdf:type rdf:Property ;
    rdfs:label 'Sth Loyalty Tier' ;
    rdfs:comment 'Loyalty program tier assigned to the season ticket holder (STH) based on tenure, spend, and engagement. Determines benefit eligibility such as priority seating, exclusive events, and merchandise discounts.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tenureYears rdf:type rdf:Property ;
    rdfs:label 'Tenure Years' ;
    rdfs:comment 'Number of consecutive seasons the fan has held a season ticket account with the organization. Used to calculate STH loyalty tier eligibility and long-term retention metrics.' ;
    rdfs:domain ind:SeasonTicketAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:archticsPlanCode rdf:type rdf:Property ;
    rdfs:label 'Archtics Plan Code' ;
    rdfs:comment 'The native plan identifier assigned to this season ticket package in the Archtics venue seating and inventory management system. Used for cross-system reconciliation between the Silver Layer and the operational Archtics source of record.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitTier rdf:type rdf:Property ;
    rdfs:label 'Benefit Tier' ;
    rdfs:comment 'The STH (Season Ticket Holder) benefit tier associated with this package, determining the level of perks, exclusive access, merchandise discounts, and concierge services. Drives benefit fulfillment workflows in Salesforce CRM and Adobe Experience Platform personalization.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bundleDiscountPct rdf:type rdf:Property ;
    rdfs:label 'Bundle Discount Pct' ;
    rdfs:comment 'The percentage discount applied to the PPV consumer price for this specific season ticket package and PPV package combination. Varies per bundle pairing and cannot reside on either parent product.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bundlePrice rdf:type rdf:Property ;
    rdfs:label 'Bundle Price' ;
    rdfs:comment 'The negotiated price charged for this specific PPV package when accessed through the season ticket bundle. Differs from the standalone consumer_price on ppv_package and belongs to this pairing only.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:digitalDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Digital Delivery Method' ;
    rdfs:comment 'The method by which digital tickets for events in this package are delivered to the STH (Season Ticket Holder). Drives the ticket fulfillment workflow in Ticketmaster/AXS and determines the access control technology used at venue entry points.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:includesMerchandiseCredit rdf:type rdf:Property ;
    rdfs:label 'Includes Merchandise Credit' ;
    rdfs:comment 'Indicates whether a merchandise store credit or discount entitlement is bundled with this season ticket package. Triggers integration with Shopify Plus for credit issuance to the STH account.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inventoryCount rdf:type rdf:Property ;
    rdfs:label 'Inventory Count' ;
    rdfs:comment 'Total number of this season ticket package available for sale in the current season. Represents the maximum allocatable units in Archtics seating inventory. Drives sold_out status transitions.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:merchandiseCreditAmount rdf:type rdf:Property ;
    rdfs:label 'Merchandise Credit Amount' ;
    rdfs:comment 'The monetary value of merchandise store credit included in this season ticket package when includes_merchandise_credit is True. Denominated in the package currency_code. Null when includes_merchandise_credit is False.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewalPriorityRank rdf:type rdf:Property ;
    rdfs:label 'Renewal Priority Rank' ;
    rdfs:comment 'Numeric rank determining the STH (Season Ticket Holder) renewal priority order for this package tier. Lower values indicate higher priority (e.g., rank 1 = first right of renewal). Critical for managing the annual renewal window and STH retention strategy.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seatQuantity rdf:type rdf:Property ;
    rdfs:label 'Seat Quantity' ;
    rdfs:comment 'Number of seats included in this season ticket package definition. Typically 1 for individual packages; higher values for group plans or suite packages. Drives inventory allocation in Archtics.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:soldCount rdf:type rdf:Property ;
    rdfs:label 'Sold Count' ;
    rdfs:comment 'Number of this season ticket package units that have been sold or confirmed for the current season. Used for inventory tracking, revenue forecasting in Workday Adaptive Planning, and sold_out threshold monitoring.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sthLoyaltyPointsAwarded rdf:type rdf:Property ;
    rdfs:label 'Sth Loyalty Points Awarded' ;
    rdfs:comment 'Number of fan loyalty points awarded to the STH (Season Ticket Holder) upon purchase or renewal of this package. Feeds into the fan engagement and NPS (Net Promoter Score) program managed via Adobe Experience Platform.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:streamingTierIncluded rdf:type rdf:Property ;
    rdfs:label 'Streaming Tier Included' ;
    rdfs:comment 'The streaming quality and access tier granted to the STH holder for this bundled PPV package. Different STH tiers may receive different streaming quality for the same PPV event.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termsAndConditionsVersion rdf:type rdf:Property ;
    rdfs:label 'Terms And Conditions Version' ;
    rdfs:comment 'Version identifier of the legal terms and conditions governing this season ticket package (e.g., \'v2.1\'). Required for GDPR, CCPA, and SOX compliance to ensure the correct contractual terms are associated with each package sold.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalEventCount rdf:type rdf:Property ;
    rdfs:label 'Total Event Count' ;
    rdfs:comment 'Total number of home events (games, matches, or performances) included in this season ticket package. Defines the scope of the package and is used to calculate per-event cost for fan communications and analytics.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waitlistEligible rdf:type rdf:Property ;
    rdfs:label 'Waitlist Eligible' ;
    rdfs:comment 'Indicates whether fans can join a waitlist for this season ticket package when it is sold out. Drives the waitlist management workflow in Salesforce CRM and Archtics inventory management.' ;
    rdfs:domain ind:SeasonTicketPackage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priceZoneId rdf:type rdf:Property ;
    rdfs:label 'Price Zone Id' ;
    rdfs:comment 'Reference to the event-specific price zone assigned to this inventory unit. Price zones define the base pricing tier and dynamic pricing eligibility for the seat.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PriceZone .

ind:accessGate rdf:type rdf:Property ;
    rdfs:label 'Access Gate' ;
    rdfs:comment 'The designated entry gate or access point at the venue through which the holder of this inventory unit is directed. Used for access control configuration in AXS/Ticketmaster gate management and crowd flow planning.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adaAccommodationType rdf:type rdf:Property ;
    rdfs:label 'Ada Accommodation Type' ;
    rdfs:comment 'Specifies the type of ADA accessibility accommodation provided by this inventory unit. Applicable only when is_ada_accessible = true. Supports ADA compliance reporting and accessible inventory allocation.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:archticsSeatKey rdf:type rdf:Property ;
    rdfs:label 'Archtics Seat Key' ;
    rdfs:comment 'The native seat-level unique identifier as assigned by the Archtics venue seating system. Used for reconciliation and real-time sync with the source-of-record seating manifest.' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:barcodeFormat rdf:type rdf:Property ;
    rdfs:label 'Barcode Format' ;
    rdfs:comment 'The barcode or digital credential format used for access control scanning of this inventory unit. Determines scanner compatibility at venue entry points.' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compReason rdf:type rdf:Property ;
    rdfs:label 'Comp Reason' ;
    rdfs:comment 'The reason code for complimentary allocation of this inventory unit. Applicable only when inventory_type = COMPLIMENTARY or inventory_status = COMP. Required for SOX financial controls and sponsor/media comp tracking.' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalDeliveryEligible rdf:type rdf:Property ;
    rdfs:label 'Digital Delivery Eligible' ;
    rdfs:comment 'Indicates whether this inventory unit supports digital ticket delivery (mobile wallet, NFC, QR code). Drives delivery method options presented at checkout and access control configuration at venue gates.' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dynamicPriceAmount rdf:type rdf:Property ;
    rdfs:label 'Dynamic Price Amount' ;
    rdfs:comment 'The current dynamically adjusted price for this inventory unit, reflecting real-time demand signals, sell-through rates, and competitive pricing algorithms. Updated continuously by the dynamic pricing engine. Null if dynamic pricing is not enabled for this inventory unit.' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hostInventoryCode rdf:type rdf:Property ;
    rdfs:label 'Host Inventory Code' ;
    rdfs:comment 'The inventory unit identifier assigned by the Ticketmaster Host system. Used for cross-system reconciliation between Archtics seating manifest and Ticketmaster ticketing platform.' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inventoryStatus rdf:type rdf:Property ;
    rdfs:label 'Inventory Status' ;
    rdfs:comment 'Current allocation state of the inventory unit: AVAILABLE (open for sale), SOLD (ticket issued), HELD (temporarily locked for a transaction or hold pool), KILLED (removed from sellable inventory), COMP (complimentary allocation), RESERVED (pre-allocated to a specific channel or package). SSOT for available-to-sell calculations.' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAisleSeat rdf:type rdf:Property ;
    rdfs:label 'Is Aisle Seat' ;
    rdfs:comment 'Indicates whether this seat is positioned directly adjacent to an aisle. Used for accessibility filtering, premium seat designation, and fan preference matching in CRM-driven personalization.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDynamicPricingEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Dynamic Pricing Enabled' ;
    rdfs:comment 'Indicates whether this inventory unit is eligible for dynamic pricing adjustments. When true, the dynamic_price_amount field is actively maintained by the pricing engine.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isObstructedView rdf:type rdf:Property ;
    rdfs:label 'Is Obstructed View' ;
    rdfs:comment 'Indicates whether this seat has a partially or fully obstructed sightline to the stage or playing field. Drives discounted pricing eligibility and mandatory disclosure requirements at point of sale.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSeasonTicketEligible rdf:type rdf:Property ;
    rdfs:label 'Is Season Ticket Eligible' ;
    rdfs:comment 'Indicates whether this inventory unit is eligible to be included in a season ticket package. Drives season ticket renewal workflows and package construction in Archtics.' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:killReason rdf:type rdf:Property ;
    rdfs:label 'Kill Reason' ;
    rdfs:comment 'Reason code explaining why this inventory unit has been killed (removed from sellable inventory). Applicable only when inventory_status = KILLED. [ENUM-REF-CANDIDATE: OBSTRUCTED_VIEW|STRUCTURAL|SAFETY|ADA_COMPANION|EQUIPMENT|SIGHTLINE|BROADCAST|STAGING — promote to reference product]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastStatusChangeTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Status Change Timestamp' ;
    rdfs:comment 'The date and time when the inventory_status of this unit was most recently updated. Supports audit trail, real-time inventory monitoring, and SLA tracking for hold-to-sale conversion.' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:manifestSectionType rdf:type rdf:Property ;
    rdfs:label 'Manifest Section Type' ;
    rdfs:comment 'The physical section category within the venue manifest as defined in the Archtics seating configuration. Supports venue layout analytics and capacity planning. [ENUM-REF-CANDIDATE: LOWER_BOWL|UPPER_BOWL|FLOOR|SUITE|CLUB|STANDING|PRESS_BOX|FIELD|MEZZANINE — promote to reference product]' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manifestVersion rdf:type rdf:Property ;
    rdfs:label 'Manifest Version' ;
    rdfs:comment 'The version identifier of the venue seating manifest from which this inventory unit was loaded. Enables tracking of manifest changes (e.g., reconfiguration for different event types such as concert vs. sports) and supports rollback and audit.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resaleMaxPrice rdf:type rdf:Property ;
    rdfs:label 'Resale Max Price' ;
    rdfs:comment 'The maximum price ceiling enforced for resale of this inventory unit on the official resale marketplace. Applicable in jurisdictions or leagues with anti-scalping price cap regulations.' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rowLabel rdf:type rdf:Property ;
    rdfs:label 'Row Label' ;
    rdfs:comment 'The alphanumeric row identifier within the section (e.g., \'A\', \'12\', \'AA\'). Null for General Admission (GA) or Standing Room Only (SRO) inventory types.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rowSequence rdf:type rdf:Property ;
    rdfs:label 'Row Sequence' ;
    rdfs:comment 'Numeric sequence of the row within the section, used for physical ordering and proximity-based seat grouping logic. Supports best-available seat algorithms and contiguous seat selection.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:saleChannel rdf:type rdf:Property ;
    rdfs:label 'Sale Channel' ;
    rdfs:comment 'The designated sales channel through which this inventory unit is authorized to be sold. Controls channel-specific routing in Ticketmaster/AXS and supports channel mix analytics. [ENUM-REF-CANDIDATE: BOX_OFFICE|ONLINE|MOBILE|GROUP_SALES|SEASON_PACKAGE|RESALE|API_PARTNER|VIP_HOSPITALITY — promote to reference product]' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatSequence rdf:type rdf:Property ;
    rdfs:label 'Seat Sequence' ;
    rdfs:comment 'Numeric sequence of the seat within the row, used for physical ordering and contiguous seat grouping. Supports best-available algorithms that prioritize adjacent seats for group purchases.' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seatTier rdf:type rdf:Property ;
    rdfs:label 'Seat Tier' ;
    rdfs:comment 'The commercial tier classification of the seat within the venue manifest, used for pricing strategy and channel routing. Distinct from inventory_type (pool) — tier reflects the quality/experience level of the physical location.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatingCapacityType rdf:type rdf:Property ;
    rdfs:label 'Seating Capacity Type' ;
    rdfs:comment 'Describes the physical seating configuration of this inventory unit: FIXED (permanent installed seat), PORTABLE (temporary/removable seat), STANDING (no seat, standing position), or LAWN (open lawn area). Affects ADA compliance and capacity calculations.' ;
    rdfs:domain ind:TicketInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectionLabel rdf:type rdf:Property ;
    rdfs:label 'Section Label' ;
    rdfs:comment 'The alphanumeric label of the venue section in which this inventory unit is located (e.g., \'101\', \'FLOOR A\', \'PRESS BOX\'). Sourced from the Archtics seating manifest.' ;
    rdfs:domain ind:Ticketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashierAgentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Cashier Agent Employee Id' ;
    rdfs:comment 'Identifier of the box office cashier or sales agent who processed this order on behalf of the fan. Populated only for box office, kiosk, and group sales channels; null for self-service digital channels. Used for agent performance tracking and fraud detection.' ;
    rdfs:domain ind:TicketOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:fulfillmentVendorId rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: Ticket fulfillment vendors (barcode printers, mobile delivery platforms) are contracted partners. Linking enables SLA breach detection on delivery_status, vendor payment reconciliation, and operationa' ;
    rdfs:domain ind:TicketOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:resaleOriginalOrderId rdf:type rdf:Property ;
    rdfs:label 'Resale Original Order Id' ;
    rdfs:comment 'Reference to the original primary-market ticket order from which the resale tickets originated. Populated only when resale_flag is True. Enables full resale chain traceability and anti-fraud analysis.' ;
    rdfs:domain ind:TicketOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TicketOrder .

ind:accessBarcode rdf:type rdf:Property ;
    rdfs:label 'Access Barcode' ;
    rdfs:comment 'The primary digital access credential (barcode, QR code token, or NFC token reference) associated with this order for venue entry. Stored as a tokenized reference, not the raw barcode value, to prevent unauthorized duplication. Used by access control systems at venue gates.' ;
    rdfs:domain ind:TicketOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessibleSeatingFlag rdf:type rdf:Property ;
    rdfs:label 'Accessible Seating Flag' ;
    rdfs:comment 'Indicates whether this order includes ADA-compliant accessible seating accommodations. True = accessible seating requested and allocated. Required for ADA compliance reporting and venue accessibility management.' ;
    rdfs:domain ind:TicketOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderNotes rdf:type rdf:Property ;
    rdfs:label 'Order Notes' ;
    rdfs:comment 'Free-text notes or special instructions associated with this order, entered by the fan, box office agent, or group sales coordinator. May include accessibility requests, VIP service notes, or group coordinator instructions.' ;
    rdfs:domain ind:TicketOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderTotalAmount rdf:type rdf:Property ;
    rdfs:label 'Order Total Amount' ;
    rdfs:comment 'Net total amount charged to the fan for this order, equal to face_value_amount + service_fee_amount + tax_amount minus any discounts. This is the authoritative total for payment processing and revenue recognition.' ;
    rdfs:domain ind:TicketOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pricingModel rdf:type rdf:Property ;
    rdfs:label 'Pricing Model' ;
    rdfs:comment 'The pricing strategy applied to this order. FIXED (standard face value), DYNAMIC (demand-based variable pricing), SEASON_PACKAGE (season ticket bundle), GROUP_RATE (bulk group discount), or RESALE (secondary market). Supports revenue management analytics.' ;
    rdfs:domain ind:TicketOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundReasonCode rdf:type rdf:Property ;
    rdfs:label 'Refund Reason Code' ;
    rdfs:comment 'Standardized reason code explaining why a refund was issued for this order. Populated when refund_amount > 0. Supports refund trend analysis, event cancellation impact reporting, and fraud detection.' ;
    rdfs:domain ind:TicketOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resaleFlag rdf:type rdf:Property ;
    rdfs:label 'Resale Flag' ;
    rdfs:comment 'Indicates whether this order was placed through the secondary/resale marketplace rather than the primary ticketing channel. True = resale order. Used for primary vs. secondary market revenue segmentation and league governance reporting.' ;
    rdfs:domain ind:TicketOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:salesChannelCode rdf:type rdf:Property ;
    rdfs:label 'Sales Channel Code' ;
    rdfs:comment 'Identifies the commerce channel through which the ticket order was placed. Supports multi-channel revenue attribution and reconciliation. [ENUM-REF-CANDIDATE: TICKETMASTER|AXS|BOX_OFFICE|GROUP_SALES|DTC|KIOSK|PARTNER_API — promote to reference product]' ;
    rdfs:domain ind:TicketOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemOrderCode rdf:type rdf:Property ;
    rdfs:label 'Source System Order Code' ;
    rdfs:comment 'The native order identifier from the originating ticketing platform (e.g., Ticketmaster order ID, AXS confirmation number, Archtics transaction ID). Enables bi-directional reconciliation between the Silver Layer and the operational system of record.' ;
    rdfs:domain ind:TicketOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessStatus rdf:type rdf:Property ;
    rdfs:label 'Access Status' ;
    rdfs:comment 'The current access control entitlement status for this ticket at the venue. Tracks whether the ticket holder has entered, exited, or been denied entry. Sourced from AXS/Ticketmaster access control scanners.' ;
    rdfs:domain ind:TicketOrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dynamicPrice rdf:type rdf:Property ;
    rdfs:label 'Dynamic Price' ;
    rdfs:comment 'The actual selling price applied to this ticket after dynamic pricing model adjustments (demand-based, algorithmic, or promotional). May differ from face_value when dynamic pricing is active.' ;
    rdfs:domain ind:TicketOrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalLineRef rdf:type rdf:Property ;
    rdfs:label 'External Line Ref' ;
    rdfs:comment 'The externally-known line item identifier assigned by the source ticketing system (Ticketmaster/AXS or Archtics). Used for reconciliation with the operational system of record.' ;
    rdfs:domain ind:TicketOrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gateEntryPoint rdf:type rdf:Property ;
    rdfs:label 'Gate Entry Point' ;
    rdfs:comment 'The designated gate or entry point at the venue through which the ticket holder is authorized to enter (e.g., \'Gate A\', \'North Entrance\', \'VIP Entrance\'). Supports venue operations and crowd management.' ;
    rdfs:domain ind:TicketOrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isResale rdf:type rdf:Property ;
    rdfs:label 'Is Resale' ;
    rdfs:comment 'Indicates whether this ticket was sold through the secondary/resale marketplace rather than primary sale. Distinguishes primary and secondary market revenue streams for analytics and league reporting.' ;
    rdfs:domain ind:TicketOrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineStatus rdf:type rdf:Property ;
    rdfs:label 'Line Status' ;
    rdfs:comment 'Current lifecycle state of this ticket order line. Drives fulfillment workflows, access control entitlement, and revenue recognition. [ENUM-REF-CANDIDATE: issued|cancelled|refunded|transferred|voided|reissued — promote to reference product]' ;
    rdfs:domain ind:TicketOrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceZone rdf:type rdf:Property ;
    rdfs:label 'Price Zone' ;
    rdfs:comment 'The pricing zone designation assigned to the seat within the venue manifest (e.g., \'Zone A\', \'Platinum\', \'Field Level\'). Used for dynamic pricing model application and revenue tier analysis.' ;
    rdfs:domain ind:TicketOrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantity rdf:type rdf:Property ;
    rdfs:label 'Quantity' ;
    rdfs:comment 'The number of ticket units represented by this line item. Typically 1 for individually assigned seats; may be greater than 1 for GA (General Admission) or SRO (Standing Room Only) allocations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resaleOriginalPrice rdf:type rdf:Property ;
    rdfs:label 'Resale Original Price' ;
    rdfs:comment 'The original face value price at which the ticket was first sold in the primary market, retained for resale margin analysis and league resale policy compliance. Only populated when is_resale is True.' ;
    rdfs:domain ind:TicketOrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizationCode rdf:type rdf:Property ;
    rdfs:label 'Authorization Code' ;
    rdfs:comment 'Alphanumeric code returned by the card network or payment processor confirming that the payment was authorized. Required for dispute resolution, chargeback management, and financial audit trails. Null for failed or pending transactions.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Authorized Timestamp' ;
    rdfs:comment 'The precise date and time when the payment was authorized by the card network or payment processor. This is the principal business event timestamp for the payment lifecycle. Used for fraud detection time-window analysis and PCI-DSS audit trails.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:capturedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Captured Timestamp' ;
    rdfs:comment 'The precise date and time when the authorized payment was captured (funds actually charged). Distinct from authorization timestamp; the gap between authorization and capture is monitored for compliance with card network rules. Null for non-captured transactions.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cardExpiryMonth rdf:type rdf:Property ;
    rdfs:label 'Card Expiry Month' ;
    rdfs:comment 'The expiration month of the payment card (1–12). Stored in compliance with PCI-DSS to support recurring payment validation and card-on-file management for season ticket holders. Null for non-card payment methods.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cardExpiryYear rdf:type rdf:Property ;
    rdfs:label 'Card Expiry Year' ;
    rdfs:comment 'The four-digit expiration year of the payment card. Stored in compliance with PCI-DSS to support recurring payment validation and card-on-file management for season ticket holders. Null for non-card payment methods.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cardNetwork rdf:type rdf:Property ;
    rdfs:label 'Card Network' ;
    rdfs:comment 'The card network or scheme associated with the payment instrument (e.g., Visa, Mastercard, American Express, Discover, UnionPay). Used for interchange fee analysis, network-specific reporting, and chargeback routing.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargebackStatus rdf:type rdf:Property ;
    rdfs:label 'Chargeback Status' ;
    rdfs:comment 'Current status of any chargeback dispute associated with this payment transaction. Tracks the chargeback lifecycle from initiation through resolution. Used for fraud management, financial loss reporting, and card network compliance. Default is \'none\' for transactions with no chargeback.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureReasonCode rdf:type rdf:Property ;
    rdfs:label 'Failure Reason Code' ;
    rdfs:comment 'Standardized decline or failure code returned by the payment processor or card network when a payment is not authorized (e.g., insufficient_funds, card_expired, do_not_honor, fraud_suspected). Used for failed payment analysis, retry logic, and fan communication. Null for successful transactions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Failure Reason Description' ;
    rdfs:comment 'Human-readable description of the payment failure reason corresponding to the failure_reason_code. Used by customer service teams in Salesforce CRM for fan outreach and dispute resolution. Null for successful transactions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudScore rdf:type rdf:Property ;
    rdfs:label 'Fraud Score' ;
    rdfs:comment 'Numeric fraud risk score assigned by the payment processor\'s fraud detection engine or an internal fraud scoring model at the time of payment (0.00–100.00, where higher values indicate greater fraud risk). Used for real-time payment decisioning, fraud trend analysis, and PCI-DSS fraud monitoring requirements.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentNumber rdf:type rdf:Property ;
    rdfs:label 'Installment Number' ;
    rdfs:comment 'The sequential installment number for recurring or installment-based payments (e.g., 1 of 4 for a season ticket payment plan). Null for one-time payments. Used for installment plan tracking and revenue recognition scheduling.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installmentTotalCount rdf:type rdf:Property ;
    rdfs:label 'Installment Total Count' ;
    rdfs:comment 'The total number of installments in the payment plan for season ticket or group sales installment arrangements (e.g., 4 for a quarterly payment plan). Null for one-time payments. Used alongside installment_number for plan completion tracking.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:is3dsAuthenticated rdf:type rdf:Property ;
    rdfs:label 'Is 3ds Authenticated' ;
    rdfs:comment 'Indicates whether the payment was authenticated using 3D Secure (3DS) protocol (e.g., Visa Secure, Mastercard Identity Check). True if 3DS authentication was completed. Used for fraud liability shift determination and PCI-DSS compliance reporting.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maskedCardReference rdf:type rdf:Property ;
    rdfs:label 'Masked Card Reference' ;
    rdfs:comment 'Masked representation of the payment card number or digital wallet identifier (e.g., last 4 digits of card, masked wallet token). Stored in PCI-DSS compliant masked format for customer service, receipt display, and dispute identification without exposing full PAN.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentNotes rdf:type rdf:Property ;
    rdfs:label 'Payment Notes' ;
    rdfs:comment 'Free-text notes or comments associated with the payment transaction, entered by customer service agents or system processes (e.g., manual override justification, special handling instructions for VIP fan payments, dispute context). Used in Salesforce CRM case management.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processorTransactionToken rdf:type rdf:Property ;
    rdfs:label 'Processor Transaction Token' ;
    rdfs:comment 'Tokenized reference assigned by the payment processor to uniquely identify this transaction within the processor\'s system. Replaces raw card data per PCI-DSS tokenization requirements. Used for refund initiation, dispute management, and settlement reconciliation.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Refunded Timestamp' ;
    rdfs:comment 'The precise date and time when the refund was processed and submitted to the payment processor. Null for non-refunded transactions. Used for refund SLA monitoring and fan experience reporting.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:settlementReference rdf:type rdf:Property ;
    rdfs:label 'Settlement Reference' ;
    rdfs:comment 'The batch settlement reference number assigned by the payment processor or acquiring bank when the transaction is included in a settlement batch. Used for bank reconciliation, SAP S/4HANA FI bank statement matching, and financial close processes.' ;
    rdfs:domain ind:TicketPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketTransferId rdf:type rdf:Property ;
    rdfs:label 'Ticket Transfer Id' ;
    rdfs:comment 'Unique system-generated identifier for each peer-to-peer ticket transfer record. Primary key for the ticket_transfer data product.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryTicketFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Primary Ticket Fan Profile Id' ;
    rdfs:comment 'Fan account identifier of the ticket holder initiating the transfer (the sender). Used for CRM tracking, season ticket holder (STH) loyalty attribution, and transfer eligibility validation.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:priorTransferTicketTransferId rdf:type rdf:Property ;
    rdfs:label 'Prior Transfer Ticket Transfer Id' ;
    rdfs:comment 'Reference to the immediately preceding transfer record for this ticket, enabling chain-of-custody tracking across multiple transfers. Null for the first transfer of a ticket.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TicketTransfer .

ind:recipientFanFanProfileId rdf:type rdf:Property ;
    rdfs:label 'Recipient Fan Fan Profile Id' ;
    rdfs:comment 'Fan account identifier of the fan receiving the transferred ticket. Populated upon successful transfer acceptance. Null if the recipient has not yet accepted or does not have an existing fan account.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FanProfile .

ind:expiryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Expiry Timestamp' ;
    rdfs:comment 'Date and time after which the transfer invitation is no longer valid for acceptance. If the recipient does not accept before this timestamp, the transfer status transitions to \'expired\' and the entitlement reverts to the sender.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fraudRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Risk Flag' ;
    rdfs:comment 'Indicates whether this transfer was flagged by the fraud detection system as potentially suspicious (e.g., rapid successive transfers, transfers to unknown accounts, high-value event tickets). Triggers manual review workflow.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:initiatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Initiated Timestamp' ;
    rdfs:comment 'Date and time when the sender initiated the ticket transfer request. This is the principal business event timestamp for the transfer lifecycle. Stored in ISO 8601 format with timezone offset.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isReturnTransfer rdf:type rdf:Property ;
    rdfs:label 'Is Return Transfer' ;
    rdfs:comment 'Indicates whether this transfer represents a ticket being returned to the original sender after a prior outbound transfer. Supports STH account reconciliation and loyalty point reversal workflows.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recipientDisplayName rdf:type rdf:Property ;
    rdfs:label 'Recipient Display Name' ;
    rdfs:comment 'Display name or full name of the recipient as entered by the sender or resolved from the recipient fan account. Used for sender confirmation UI and customer service. Classified as restricted PII per GDPR Article 4.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientTermsAcceptedFlag rdf:type rdf:Property ;
    rdfs:label 'Recipient Terms Accepted Flag' ;
    rdfs:comment 'Indicates whether the recipient explicitly accepted the transfer terms and conditions upon claiming the ticket. Required for entitlement issuance and compliance with consumer protection regulations.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemTransferCode rdf:type rdf:Property ;
    rdfs:label 'Source System Transfer Code' ;
    rdfs:comment 'Native transfer identifier from the originating operational system (Ticketmaster or AXS). Used for cross-system reconciliation, support case lookup, and data lineage tracing between the Silver layer and the source system of record.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termsAcceptedFlag rdf:type rdf:Property ;
    rdfs:label 'Terms Accepted Flag' ;
    rdfs:comment 'Indicates whether the sender explicitly accepted the transfer terms and conditions at the time of initiating the transfer. Required for compliance with Ticketmaster/AXS transfer policy and consumer protection regulations.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transferDirection rdf:type rdf:Property ;
    rdfs:label 'Transfer Direction' ;
    rdfs:comment 'Indicates the directional nature of the transfer relative to the originating account. \'outbound\' — sender is giving away the ticket; \'inbound\' — recipient is receiving; \'return\' — ticket returned to original holder after a prior transfer.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferMethod rdf:type rdf:Property ;
    rdfs:label 'Transfer Method' ;
    rdfs:comment 'Channel or mechanism used to deliver the transfer invitation to the recipient. \'mobile_app\' — in-app transfer via Ticketmaster/AXS mobile; \'email\' — transfer link sent via email; \'sms\' — transfer link sent via SMS; \'platform_link\' — shareable URL generated for transfer.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Transfer Reference Number' ;
    rdfs:comment 'Externally-visible alphanumeric reference number assigned to the transfer transaction, used for fan-facing communication, customer service lookup, and audit trail. Sourced from Ticketmaster/AXS transfer workflow.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferRestrictionReason rdf:type rdf:Property ;
    rdfs:label 'Transfer Restriction Reason' ;
    rdfs:comment 'Reason code explaining why a transfer was restricted or blocked. \'none\' — no restriction; \'price_tier_restricted\' — price tier does not permit transfer; \'event_restricted\' — event-level transfer lockout; \'package_restricted\' — season ticket package terms prohibit transfer; \'compliance_hold\' — regulatory or compliance hold; \'fraud_hold\' — fraud risk flag applied.' ;
    rdfs:domain ind:TicketTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:archticsManifestKey rdf:type rdf:Property ;
    rdfs:label 'Archtics Manifest Key' ;
    rdfs:comment 'The native manifest or seat map identifier from the Archtics venue seating and inventory management system. Used for system-of-record reconciliation and cross-system data lineage between the Silver layer and the Archtics source.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventConfigurationType rdf:type rdf:Property ;
    rdfs:label 'Event Configuration Type' ;
    rdfs:comment 'The category of event this manifest is configured to support. Determines stage orientation, field of play, and seating bowl layout. A single venue may have multiple manifests for different event types.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isKillSeat rdf:type rdf:Property ;
    rdfs:label 'Is Kill Seat' ;
    rdfs:comment 'Indicates whether this seat is designated as a kill seat — permanently or temporarily removed from saleable inventory due to production equipment placement (e.g., camera platforms, lighting rigs, sound towers, mixing boards). Kill seats cannot be sold or allocated.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPremiumSeat rdf:type rdf:Property ;
    rdfs:label 'Is Premium Seat' ;
    rdfs:comment 'Indicates whether this seat is classified as a premium inventory seat (e.g., club seat, courtside, field-level, VIP box). Premium seats are subject to distinct pricing tiers, hospitality entitlements, and season ticket package eligibility rules.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isResaleEligible rdf:type rdf:Property ;
    rdfs:label 'Is Resale Eligible' ;
    rdfs:comment 'Indicates whether seats in this manifest section are eligible for listing on the secondary resale marketplace. Certain sections (e.g., suite holds, sponsor allocations, comp seats) may be restricted from resale per contractual or league governance rules.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:manifestCode rdf:type rdf:Property ;
    rdfs:label 'Manifest Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this manifest configuration within the venue. Used as the business identifier in Archtics and Ticketmaster/AXS integrations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manifestName rdf:type rdf:Property ;
    rdfs:label 'Manifest Name' ;
    rdfs:comment 'Human-readable name describing this manifest configuration (e.g., \'Full House Basketball\', \'Concert End-Stage\', \'Football GA Floor\'). Used by operations staff to identify the correct seating layout.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manifestStatus rdf:type rdf:Property ;
    rdfs:label 'Manifest Status' ;
    rdfs:comment 'Current lifecycle state of the manifest configuration. \'draft\' indicates under construction; \'active\' is the live configuration used for ticketing; \'inactive\' is temporarily disabled; \'archived\' is retired.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manifestType rdf:type rdf:Property ;
    rdfs:label 'Manifest Type' ;
    rdfs:comment 'Classification of the seating configuration type. Determines whether seats are individually assigned (reserved_seating), open floor (general_admission / GA), or a hybrid layout. SRO (Standing Room Only) is a distinct configuration for overflow capacity.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obstructionDescription rdf:type rdf:Property ;
    rdfs:label 'Obstruction Description' ;
    rdfs:comment 'Free-text description of the nature of the view obstruction for seats flagged as obstructed (e.g., \'Structural column blocks left 20% of stage\', \'Partial view of scoreboard only\'). Null for unobstructed seats.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceZoneCode rdf:type rdf:Property ;
    rdfs:label 'Price Zone Code' ;
    rdfs:comment 'The pricing zone designation assigned to this seat/section in the manifest (e.g., \'ZONE-A\', \'PREMIUM\', \'VALUE\'). Maps to the price_tier reference and drives face value assignment during inventory allocation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rowCount rdf:type rdf:Property ;
    rdfs:label 'Row Count' ;
    rdfs:comment 'Total number of rows within this section as defined in the manifest. Used for capacity planning, inventory validation, and seat map rendering.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seatCapacity rdf:type rdf:Property ;
    rdfs:label 'Seat Capacity' ;
    rdfs:comment 'Total number of individual seats or standing positions represented by this manifest record. For reserved seating this is typically 1; for GA sections this reflects the total capacity of the section or zone.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seatCountPerRow rdf:type rdf:Property ;
    rdfs:label 'Seat Count Per Row' ;
    rdfs:comment 'Number of individual seats in each row of this section. May vary by row in curved bowl configurations; this field captures the standard or average count for the section.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seatingOrientation rdf:type rdf:Property ;
    rdfs:label 'Seating Orientation' ;
    rdfs:comment 'The directional orientation of the seating section relative to the primary performance or playing surface. Relevant for multi-configuration venues that host both sports and entertainment events with different stage/field orientations. [ENUM-REF-CANDIDATE: end_stage|center_stage|in_the_round|field_facing|court_facing|ice_facing|pitch_facing — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sightLineRating rdf:type rdf:Property ;
    rdfs:label 'Sight Line Rating' ;
    rdfs:comment 'Qualitative rating of the sightline quality from this seat or section to the primary performance or playing surface. Used in fan-facing seat selection tools and dynamic pricing models to differentiate seat value.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ticketmasterMapCode rdf:type rdf:Property ;
    rdfs:label 'Ticketmaster Map Code' ;
    rdfs:comment 'The seat map identifier assigned by Ticketmaster/AXS for this manifest configuration. Required for inventory synchronization and digital ticket delivery through the Ticketmaster distribution platform.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAdaSeatCount rdf:type rdf:Property ;
    rdfs:label 'Total Ada Seat Count' ;
    rdfs:comment 'Total number of ADA-designated seats or spaces in this manifest configuration. Used for ADA compliance reporting and accommodation fulfillment tracking.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalKillSeatCount rdf:type rdf:Property ;
    rdfs:label 'Total Kill Seat Count' ;
    rdfs:comment 'Total number of seats designated as kill seats in this manifest configuration. Used for production planning, capacity reconciliation, and revenue impact analysis.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalSellableCapacity rdf:type rdf:Property ;
    rdfs:label 'Total Sellable Capacity' ;
    rdfs:comment 'Total number of seats or positions in this manifest that are eligible for sale, excluding kill seats, ADA companion holds, and structural exclusions. The principal quantitative fact for revenue capacity planning.' ;
    rdfs:domain ind:VenueManifest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waitlistId rdf:type rdf:Property ;
    rdfs:label 'Waitlist Id' ;
    rdfs:comment 'Unique surrogate identifier for each waitlist record in the ticketing domain. Primary key for the waitlist data product.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requestedSeatingSectionId rdf:type rdf:Property ;
    rdfs:label 'Requested Seating Section Id' ;
    rdfs:comment 'Foreign key linking to venue.seating_section. Business justification: Waitlist management for specific sections requires linking to the canonical seating_section for capacity availability checks, ADA accommodation matching, and STH renewal priority processing. Role-pref' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SeatingSection .

ind:cancellationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason Code' ;
    rdfs:comment 'Coded reason for removal from the waitlist when status is \'cancelled\', \'expired\', or \'withdrawn\'. Supports demand analytics and queue management reporting. [ENUM-REF-CANDIDATE: fan_withdrawn|offer_expired|operator_removed|duplicate|ineligible|event_cancelled — promote to reference product if additional codes are needed]' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandSignalFlag rdf:type rdf:Property ;
    rdfs:label 'Demand Signal Flag' ;
    rdfs:comment 'Indicates whether this waitlist record has been included in the demand signal feed used by the dynamic pricing engine. Active waitlist entries contribute to demand pressure metrics that influence dynamic pricing rule triggers.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAdaRequired rdf:type rdf:Property ;
    rdfs:label 'Is Ada Required' ;
    rdfs:comment 'Indicates whether the fan requires ADA-accessible seating as part of their waitlist request. Ensures accessible inventory is matched and offered in compliance with ADA venue accessibility requirements.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPriorityOverride rdf:type rdf:Property ;
    rdfs:label 'Is Priority Override' ;
    rdfs:comment 'Indicates whether an operator has manually overridden the fan\'s queue position or priority rank outside of the standard algorithmic ranking. Supports audit trail for queue management decisions.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationPreference rdf:type rdf:Property ;
    rdfs:label 'Notification Preference' ;
    rdfs:comment 'Fan\'s preferred channel for receiving waitlist offer notifications. Drives outbound communication routing through Adobe Experience Platform and Salesforce CRM. Options: email, SMS, push notification, or combinations.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offerCount rdf:type rdf:Property ;
    rdfs:label 'Offer Count' ;
    rdfs:comment 'Total number of ticket offers that have been extended to this fan for this waitlist entry. Tracks repeat offer cycles where a fan declines or allows an offer to expire and is re-queued.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:offerExpiryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Offer Expiry Timestamp' ;
    rdfs:comment 'Date and time by which the fan must accept and complete purchase of the offered tickets before the offer lapses and inventory is released to the next fan in queue. Critical for revenue recovery and queue throughput.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:offerExtendedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Offer Extended Timestamp' ;
    rdfs:comment 'Date and time when a ticket offer was formally extended to the fan from the waitlist. Marks the transition from \'active\' to \'offered\' status. Null if no offer has been made yet.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:priceCeiling rdf:type rdf:Property ;
    rdfs:label 'Price Ceiling' ;
    rdfs:comment 'Maximum ticket price the fan is willing to pay for the waitlisted product. Offers exceeding this threshold are not extended. Critical for demand segmentation and willingness-to-pay analytics.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceFloor rdf:type rdf:Property ;
    rdfs:label 'Price Floor' ;
    rdfs:comment 'Minimum ticket price the fan is willing to accept for the waitlisted product. Used in dynamic pricing offer matching — offers below this threshold are not extended. Supports demand signaling for dynamic pricing models.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorityOverrideReason rdf:type rdf:Property ;
    rdfs:label 'Priority Override Reason' ;
    rdfs:comment 'Free-text explanation for why a manual priority override was applied to this waitlist record. Populated only when is_priority_override is True. Required for audit compliance.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queuePosition rdf:type rdf:Property ;
    rdfs:label 'Queue Position' ;
    rdfs:comment 'Current ordinal position of the fan in the waitlist queue. Recalculated dynamically as fans ahead convert, withdraw, or are removed. Position 1 is next in line for an offer.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requestedQuantity rdf:type rdf:Property ;
    rdfs:label 'Requested Quantity' ;
    rdfs:comment 'Number of tickets the fan is requesting through the waitlist. Drives inventory matching logic — an offer is only extended when the requested quantity becomes available contiguously.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requestedSeatRow rdf:type rdf:Property ;
    rdfs:label 'Requested Seat Row' ;
    rdfs:comment 'Preferred row within the requested section. Optional granular seating preference used for premium upgrade waitlists and STH package matching.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedSeatSection rdf:type rdf:Property ;
    rdfs:label 'Requested Seat Section' ;
    rdfs:comment 'Specific seating section the fan has requested on the waitlist (e.g., \'Section 101\', \'Club Level\'). Optional preference used for offer matching in Archtics seating inventory.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemWaitlistCode rdf:type rdf:Property ;
    rdfs:label 'Source System Waitlist Code' ;
    rdfs:comment 'Original waitlist identifier from the operational source system (Ticketmaster, AXS, or Archtics). Preserved for lineage tracing, reconciliation, and cross-system deduplication in the Silver layer.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sthTenureYears rdf:type rdf:Property ;
    rdfs:label 'Sth Tenure Years' ;
    rdfs:comment 'Number of consecutive years the fan has held or previously held a season ticket. Used as a priority factor in STH waitlist ranking — longer tenure earns higher queue priority per league governance policies.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waitlistNumber rdf:type rdf:Property ;
    rdfs:label 'Waitlist Number' ;
    rdfs:comment 'Human-readable, externally-visible reference number assigned to the waitlist registration. Used in fan communications, CRM records, and Ticketmaster/AXS correspondence.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waitlistStatus rdf:type rdf:Property ;
    rdfs:label 'Waitlist Status' ;
    rdfs:comment 'Current lifecycle state of the waitlist record. \'active\' = fan is queued; \'offered\' = ticket offer has been extended; \'converted\' = fan purchased; \'expired\' = offer window lapsed; \'cancelled\' = removed by operator; \'withdrawn\' = fan self-removed.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waitlistType rdf:type rdf:Property ;
    rdfs:label 'Waitlist Type' ;
    rdfs:comment 'Classification of the waitlist request by product type. Distinguishes between single-event sold-out demand, Season Ticket Holder (STH) package waitlists, premium seating upgrades, suite requests, and group sales queues.' ;
    rdfs:domain ind:Waitlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessibleRouteConnected rdf:type rdf:Property ;
    rdfs:label 'Accessible Route Connected' ;
    rdfs:comment 'Indicates whether this feature is connected to a continuous accessible route as required by ADA Standards for Accessible Design Section 206. Critical for ADA path-of-travel compliance assessments.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualMaintenanceCost rdf:type rdf:Property ;
    rdfs:label 'Annual Maintenance Cost' ;
    rdfs:comment 'Estimated or actual annual cost to maintain and inspect this accessibility feature, in USD. Used for venue operations budgeting and ADA compliance cost tracking in Workday Adaptive Planning.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacity rdf:type rdf:Property ;
    rdfs:label 'Capacity' ;
    rdfs:comment 'Maximum number of persons or devices this feature can accommodate simultaneously (e.g., elevator capacity in persons, companion seating area capacity in seats, sensory room capacity). Distinct from quantity of units.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fanFacingDescription rdf:type rdf:Property ;
    rdfs:label 'Fan Facing Description' ;
    rdfs:comment 'Consumer-friendly description of this accessibility feature for publication on the venue website, mobile app, and fan engagement platforms (Adobe Experience Platform). Supports fan accessibility experience management and DTC (Direct-To-Consumer) communications.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureCode rdf:type rdf:Property ;
    rdfs:label 'Feature Code' ;
    rdfs:comment 'Externally-known unique alphanumeric code assigned to this accessibility feature, used for cross-system reference and ADA compliance reporting (e.g., WCR-101, ELV-B2, HLP-MAIN).' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:featureType rdf:type rdf:Property ;
    rdfs:label 'Feature Type' ;
    rdfs:comment 'Categorical classification of the accessibility feature type. [ENUM-REF-CANDIDATE: wheelchair_ramp|elevator|accessible_restroom|hearing_loop|braille_signage|accessible_parking|companion_seating|sensory_room|accessible_entrance|tactile_pathway|assistive_listening_device|lowered_counter|accessible_concession — promote to reference product]' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionAuthority rdf:type rdf:Property ;
    rdfs:label 'Inspection Authority' ;
    rdfs:comment 'Name of the authority having jurisdiction (AHJ) or regulatory body that conducted or certified the last inspection (e.g., \'City of Los Angeles Building and Safety\', \'State Fire Marshal\', \'DOJ ADA Inspector\').' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Inspection Certificate Number' ;
    rdfs:comment 'Official certificate or permit number issued by the inspection authority upon successful compliance inspection. Required for ADA audit documentation and regulatory reporting.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installationCost rdf:type rdf:Property ;
    rdfs:label 'Installation Cost' ;
    rdfs:comment 'Total capital expenditure incurred for the installation of this accessibility feature, in the venue\'s operating currency (USD). Supports fixed asset capitalization in SAP S/4HANA FI-AA and ADA capital investment reporting.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAdaCertified rdf:type rdf:Property ;
    rdfs:label 'Is Ada Certified' ;
    rdfs:comment 'Indicates whether this feature has received formal ADA (Americans with Disabilities Act) certification from an accredited inspector or authority having jurisdiction (AHJ). Distinct from compliance_status which tracks ongoing state.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEventDayAvailable rdf:type rdf:Property ;
    rdfs:label 'Is Event Day Available' ;
    rdfs:comment 'Indicates whether this accessibility feature is available and operational during live events. Some features (e.g., sensory rooms) may only be activated on event days. Supports event-day logistics planning.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPublished rdf:type rdf:Property ;
    rdfs:label 'Is Published' ;
    rdfs:comment 'Indicates whether this accessibility feature is currently published and visible to fans on public-facing channels (venue website, mobile app, ticketing platforms). Controls fan-facing accessibility information display.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:locationDescription rdf:type rdf:Property ;
    rdfs:label 'Location Description' ;
    rdfs:comment 'Descriptive text identifying the physical location of the feature within the venue (e.g., \'Gate A, Section 101, Level 2 concourse near elevator bank\'). Used for fan wayfinding and maintenance dispatch.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceTeam rdf:type rdf:Property ;
    rdfs:label 'Maintenance Team' ;
    rdfs:comment 'Name or identifier of the internal or contracted maintenance team responsible for upkeep and inspection of this feature (e.g., \'Facilities Ops - Electrical\', \'Third-Party Elevator Services Inc.\'). Supports work order routing.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationNotes rdf:type rdf:Property ;
    rdfs:label 'Remediation Notes' ;
    rdfs:comment 'Free-text description of remediation actions required or in progress when compliance_status is non_compliant or remediation_in_progress. Documents corrective action plans for ADA audit purposes.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationTargetDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Target Date' ;
    rdfs:comment 'Target completion date for remediation of a non-compliant accessibility feature. Used for ADA compliance reporting and regulatory deadline tracking.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requiresAdvanceBooking rdf:type rdf:Property ;
    rdfs:label 'Requires Advance Booking' ;
    rdfs:comment 'Indicates whether fans must book or reserve this accessibility feature in advance (e.g., sensory rooms, companion seating, accessible parking). Drives Ticketmaster/AXS ticketing workflow configuration.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signagePresent rdf:type rdf:Property ;
    rdfs:label 'Signage Present' ;
    rdfs:comment 'Indicates whether the required International Symbol of Accessibility (ISA) signage and directional signage is present and compliant at this feature location. Required under ADA Section 216.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:venueLevel rdf:type rdf:Property ;
    rdfs:label 'Venue Level' ;
    rdfs:comment 'The floor or level within the venue where the feature is located (e.g., \'Level 1\', \'Concourse B\', \'Lower Bowl\', \'Mezzanine\'). Supports spatial analytics and accessibility mapping.' ;
    rdfs:domain ind:AccessibilityFeature ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetAcquisitionCost rdf:type rdf:Property ;
    rdfs:label 'Asset Acquisition Cost' ;
    rdfs:comment 'Original purchase or acquisition cost of the BMS subsystem in USD. Used for asset valuation, depreciation calculations, insurance coverage, and capital expenditure reporting in SAP S/4HANA Fixed Assets.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:backupSystemAssetTag rdf:type rdf:Property ;
    rdfs:label 'Backup System Asset Tag' ;
    rdfs:comment 'Asset tag of the designated backup or redundant BMS subsystem that takes over if this primary system fails. Enables rapid failover identification during incident response.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bmsProtocol rdf:type rdf:Property ;
    rdfs:label 'Bms Protocol' ;
    rdfs:comment 'Communication protocol used by this BMS subsystem to integrate with the central Building Management System (BMS) platform (e.g., BACnet, Modbus, LonWorks, KNX). Required for system integration and interoperability management.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buildingZone rdf:type rdf:Property ;
    rdfs:label 'Building Zone' ;
    rdfs:comment 'Physical zone, wing, floor, or area within the venue where this BMS subsystem is located (e.g., \'North Concourse Level 2\', \'Mechanical Room B\', \'Press Box\'). Enables spatial asset management and event-day zone readiness reporting.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityRating rdf:type rdf:Property ;
    rdfs:label 'Capacity Rating' ;
    rdfs:comment 'Principal quantitative capacity or performance rating of the BMS subsystem expressed in its native unit (e.g., BTU/hr for HVAC, kVA for electrical panels, GPM for plumbing). The unit is specified in capacity_rating_unit.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityRatingUnit rdf:type rdf:Property ;
    rdfs:label 'Capacity Rating Unit' ;
    rdfs:comment 'Unit of measure for the capacity_rating field (e.g., BTU/hr for HVAC, kVA for electrical, GPM for plumbing). Ensures correct interpretation of the numeric capacity value. [ENUM-REF-CANDIDATE: BTU_hr|kVA|kW|GPM|LPM|tons|amps|volts|PSI — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissioningDate rdf:type rdf:Property ;
    rdfs:label 'Commissioning Date' ;
    rdfs:comment 'Date on which the BMS subsystem was formally commissioned and accepted into operational service following installation testing and sign-off. May differ from installation_date if a testing/burn-in period occurred.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:energyConsumptionKw rdf:type rdf:Property ;
    rdfs:label 'Energy Consumption Kw' ;
    rdfs:comment 'Rated or measured energy consumption of the BMS subsystem in kilowatts (kW). Used for energy management, sustainability reporting under ISO 20121, and utility cost allocation.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAdaCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Ada Compliant' ;
    rdfs:comment 'Indicates whether this BMS subsystem (particularly access control and lighting systems) meets Americans with Disabilities Act (ADA) accessibility requirements. Critical for venue compliance audits.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEventDayCritical rdf:type rdf:Property ;
    rdfs:label 'Is Event Day Critical' ;
    rdfs:comment 'Indicates whether this BMS subsystem is classified as critical for live event operations (e.g., fire suppression, main electrical, HVAC for player areas). Critical systems require pre-event operational verification and have escalated incident response protocols.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOshaCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Osha Compliant' ;
    rdfs:comment 'Indicates whether this BMS subsystem currently meets all applicable OSHA safety standards and regulations. A false value triggers a compliance remediation workflow.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Last Certification Date' ;
    rdfs:comment 'Date of the most recent regulatory or code-compliance certification inspection for this BMS subsystem (e.g., fire suppression annual certification, electrical panel inspection). Critical for OSHA and local building code compliance tracking.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maintenanceFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Maintenance Frequency Days' ;
    rdfs:comment 'Standard interval in calendar days between scheduled preventive maintenance activities for this BMS subsystem, as defined by the manufacturer or facility maintenance program.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:meanTimeBetweenFailures rdf:type rdf:Property ;
    rdfs:label 'Mean Time Between Failures' ;
    rdfs:comment 'Manufacturer-specified or historically observed mean time between failures (MTBF) for this BMS subsystem, expressed in hours. Used for reliability analysis, maintenance interval optimization, and risk scoring.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meanTimeToRepair rdf:type rdf:Property ;
    rdfs:label 'Mean Time To Repair' ;
    rdfs:comment 'Average time in hours required to restore this BMS subsystem to operational status following a failure. Used for SLA definition, event-day risk assessment, and maintenance resource planning.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:networkAddress rdf:type rdf:Property ;
    rdfs:label 'Network Address' ;
    rdfs:comment 'Network or device address assigned to this BMS subsystem within the building automation network (e.g., BACnet device instance, Modbus slave address, IP address for networked controllers). Classified confidential as it reveals infrastructure topology.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextCertificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Certification Due Date' ;
    rdfs:comment 'Scheduled date by which the next mandatory regulatory certification or inspection must be completed for this BMS subsystem. Drives compliance calendar and event-day readiness gates.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:redundancyType rdf:type rdf:Property ;
    rdfs:label 'Redundancy Type' ;
    rdfs:comment 'Classification of the redundancy or failover configuration for this BMS subsystem (e.g., active-standby, active-active, manual backup, none). Informs risk assessment and event-day contingency planning.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roomOrPanelCode rdf:type rdf:Property ;
    rdfs:label 'Room Or Panel Code' ;
    rdfs:comment 'Specific room number, mechanical room designation, or panel board identifier where the BMS subsystem is housed. Used for precise physical location tracking and maintenance dispatch.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemName rdf:type rdf:Property ;
    rdfs:label 'System Name' ;
    rdfs:comment 'Human-readable name assigned to this BMS subsystem (e.g., \'North Wing HVAC Unit 3\', \'Main Electrical Panel B\', \'Fire Suppression Zone 2\'). Used as the primary identity label for facility staff and maintenance teams.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemSubtype rdf:type rdf:Property ;
    rdfs:label 'System Subtype' ;
    rdfs:comment 'Further classification within the system type (e.g., for HVAC: \'chiller\', \'air_handling_unit\', \'cooling_tower\'; for electrical: \'main_distribution\', \'sub_panel\', \'UPS\'). Enables granular asset categorization for maintenance planning.' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemType rdf:type rdf:Property ;
    rdfs:label 'System Type' ;
    rdfs:comment 'Classification of the BMS subsystem by functional category. Drives compliance requirements, maintenance schedules, and regulatory inspection protocols. [ENUM-REF-CANDIDATE: HVAC|electrical|fire_suppression|lighting|plumbing|security_access — promote to reference product if additional types are needed]' ;
    rdfs:domain ind:BmsSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessibleCapacity rdf:type rdf:Property ;
    rdfs:label 'Accessible Capacity' ;
    rdfs:comment 'Number of ADA-compliant accessible seating positions designated within this configuration, including wheelchair spaces and companion seats. Mandatory for ADA compliance reporting.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:archticsConfigCode rdf:type rdf:Property ;
    rdfs:label 'Archtics Config Code' ;
    rdfs:comment 'Source system identifier for this capacity configuration as recorded in the Archtics Venue Seating and Inventory Management system. Used for system-of-record reconciliation and data lineage tracing.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bowlOrientation rdf:type rdf:Property ;
    rdfs:label 'Bowl Orientation' ;
    rdfs:comment 'Describes which sections of the seating bowl are open and in use for this configuration. Drives section-level inventory activation in Archtics and determines sightline-based kill-seat patterns.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastCameraPositions rdf:type rdf:Property ;
    rdfs:label 'Broadcast Camera Positions' ;
    rdfs:comment 'Number of designated broadcast camera positions activated within this capacity configuration. Impacts kill-seat counts and sightline planning; relevant to OB (Outside Broadcast) and RSN (Regional Sports Network) production requirements.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complimentaryHoldCount rdf:type rdf:Property ;
    rdfs:label 'Complimentary Hold Count' ;
    rdfs:comment 'Number of seats held as complimentary allocations for athletes, staff, sponsors, and league officials under this configuration. Reduces sellable inventory and is tracked for financial reporting and CBA (Collective Bargaining Agreement) compliance.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:concessionStandCount rdf:type rdf:Property ;
    rdfs:label 'Concession Stand Count' ;
    rdfs:comment 'Number of concession stands and food and beverage service points activated under this capacity configuration. Drives staffing plans, POS (Point of Sale) system activation, and per-cap revenue forecasting.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:configDescription rdf:type rdf:Property ;
    rdfs:label 'Config Description' ;
    rdfs:comment 'Detailed narrative describing the purpose, layout rationale, and operational context of this capacity configuration, including any special setup notes for event-day logistics.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:configStatus rdf:type rdf:Property ;
    rdfs:label 'Config Status' ;
    rdfs:comment 'Current lifecycle state of the capacity configuration. \'active\' indicates the configuration is approved and available for event assignment; \'draft\' indicates it is under review; \'archived\' indicates it is retired from use.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldFloorCapacity rdf:type rdf:Property ;
    rdfs:label 'Field Floor Capacity' ;
    rdfs:comment 'Number of positions allocated on the field, floor, or stage-adjacent area for this configuration. Includes floor-level VIP (Very Important Person) standing, pit areas, and on-field hospitality zones.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fireCodeApproved rdf:type rdf:Property ;
    rdfs:label 'Fire Code Approved' ;
    rdfs:comment 'Indicates whether this capacity configuration has received fire marshal or local authority approval confirming that egress paths, aisle widths, and occupancy limits meet applicable fire safety codes.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:floorPlanVersion rdf:type rdf:Property ;
    rdfs:label 'Floor Plan Version' ;
    rdfs:comment 'Version identifier of the venue floor plan drawing associated with this capacity configuration (e.g., \'v3.2\'). Ensures traceability to the approved architectural drawing used for seating layout.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gaCapacity rdf:type rdf:Property ;
    rdfs:label 'Ga Capacity' ;
    rdfs:comment 'Number of General Admission (GA) standing or unreserved floor positions allocated within this configuration. Used for festival-style and floor-level event formats.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:killSeatCount rdf:type rdf:Property ;
    rdfs:label 'Kill Seat Count' ;
    rdfs:comment 'Number of seats removed from sellable inventory (\'killed\') in this configuration due to obstructed sightlines, staging equipment, production rigging, or operational requirements. Reduces effective sellable capacity from total configured capacity.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leagueApproved rdf:type rdf:Property ;
    rdfs:label 'League Approved' ;
    rdfs:comment 'Indicates whether this capacity configuration has been formally approved by the relevant league or governing body (e.g., NFL, NBA, FIFA) as meeting minimum venue standards for sanctioned competition.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxOccupancyLimit rdf:type rdf:Property ;
    rdfs:label 'Max Occupancy Limit' ;
    rdfs:comment 'Regulatory or fire-code maximum occupancy limit for the venue under this configuration as certified by local authorities. May differ from total configured capacity and governs hard attendance caps for safety compliance.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operationalHoldCount rdf:type rdf:Property ;
    rdfs:label 'Operational Hold Count' ;
    rdfs:comment 'Number of seats withheld from sale for operational purposes such as security personnel, event staff, emergency egress, and venue operations under this configuration.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parkingSpacesAllocated rdf:type rdf:Property ;
    rdfs:label 'Parking Spaces Allocated' ;
    rdfs:comment 'Total number of parking spaces designated for patron use under this capacity configuration, including accessible parking. Used in event-day logistics, traffic management, and ancillary revenue planning.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pressMediaCapacity rdf:type rdf:Property ;
    rdfs:label 'Press Media Capacity' ;
    rdfs:comment 'Number of credentialed press, broadcast, and media positions allocated within this configuration, including press box, commentary positions, and camera platforms.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reducedCapacityPct rdf:type rdf:Property ;
    rdfs:label 'Reduced Capacity Pct' ;
    rdfs:comment 'Percentage of total configured capacity at which this configuration operates when a reduced-capacity mode is in effect (e.g., public health restrictions, partial-fill events, or socially distanced seating). Expressed as a decimal percentage (e.g., 50.00 for 50%).' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reservedSeatingCapacity rdf:type rdf:Property ;
    rdfs:label 'Reserved Seating Capacity' ;
    rdfs:comment 'Number of individually assigned reserved seats available in this configuration, excluding suites, accessible, press, and field/floor allocations. Core inventory for standard ticket sales.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seatingMode rdf:type rdf:Property ;
    rdfs:label 'Seating Mode' ;
    rdfs:comment 'Physical seating arrangement mode for this configuration. \'fixed\' indicates permanent bowl seating; \'festival\' indicates floor-level General Admission (GA) standing; \'retractable\' indicates use of retractable seating sections; \'portable\' indicates temporary staging.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sellableCapacity rdf:type rdf:Property ;
    rdfs:label 'Sellable Capacity' ;
    rdfs:comment 'Net number of ticketable positions available for public sale under this configuration, calculated as total configured capacity minus kill seats, operational holds, and complimentary allocations. The operative figure for revenue management and ticket inventory.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:setupDurationHours rdf:type rdf:Property ;
    rdfs:label 'Setup Duration Hours' ;
    rdfs:comment 'Estimated number of hours required to physically configure the venue to match this capacity configuration (e.g., installing portable seating, rigging stage, repositioning retractable sections). Used in event-day logistics and venue scheduling.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sroCapacity rdf:type rdf:Property ;
    rdfs:label 'Sro Capacity' ;
    rdfs:comment 'Number of Standing Room Only (SRO) positions available in this configuration, typically in concourse or designated standing areas beyond the primary seating bowl.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stageConfiguration rdf:type rdf:Property ;
    rdfs:label 'Stage Configuration' ;
    rdfs:comment 'Physical stage layout used in this capacity configuration, which directly determines seating bowl shape and kill-seat patterns. \'end_stage\' is standard for concerts; \'center_stage\' for boxing/UFC; \'none\' for sports without a stage. [ENUM-REF-CANDIDATE: none|end_stage|center_stage|thrust|in_the_round|half_house|traverse — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suiteCapacity rdf:type rdf:Property ;
    rdfs:label 'Suite Capacity' ;
    rdfs:comment 'Total number of seats or positions allocated within premium suites and luxury boxes under this configuration. Drives premium hospitality and sponsorship revenue reporting.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:teardownDurationHours rdf:type rdf:Property ;
    rdfs:label 'Teardown Duration Hours' ;
    rdfs:comment 'Estimated number of hours required to dismantle and restore the venue from this capacity configuration back to a neutral state. Critical for back-to-back event scheduling and venue turnaround planning.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ticketmasterManifestCode rdf:type rdf:Property ;
    rdfs:label 'Ticketmaster Manifest Code' ;
    rdfs:comment 'Identifier of the seating manifest in the Ticketmaster / AXS ticketing platform that corresponds to this capacity configuration. Enables direct linkage between capacity setup and ticket inventory manifests.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalConfiguredCapacity rdf:type rdf:Property ;
    rdfs:label 'Total Configured Capacity' ;
    rdfs:comment 'Total number of seats or standing positions available under this configuration. Represents the principal quantitative fact for this resource and is the master capacity figure used in ticketing inventory allocation and revenue management.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vipCapacity rdf:type rdf:Property ;
    rdfs:label 'Vip Capacity' ;
    rdfs:comment 'Number of premium VIP (Very Important Person) positions designated in this configuration, covering club-level seats, hospitality lounges, and premium floor access beyond standard suite allocations.' ;
    rdfs:domain ind:CapacityConfig ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:menuId rdf:type rdf:Property ;
    rdfs:label 'Menu Id' ;
    rdfs:comment 'Reference to the standard menu configuration assigned to this concession stand, defining the approved item list, pricing tiers, and promotional offerings. Links to the menu master record.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Menu .

ind:adaAccessible rdf:type rdf:Property ;
    rdfs:label 'Ada Accessible' ;
    rdfs:comment 'Indicates whether this concession stand has an ADA-compliant accessible service counter meeting the required counter height, approach clearance, and signage standards. Critical for ADA compliance reporting and fan accessibility planning.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alcoholLicenseFlag rdf:type rdf:Property ;
    rdfs:label 'Alcohol License Flag' ;
    rdfs:comment 'Indicates whether this concession stand holds a valid alcohol beverage service license permitting the sale of beer, wine, or spirits. Drives compliance checks, age-verification POS configuration, and regulatory reporting.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cashlessOnlyFlag rdf:type rdf:Property ;
    rdfs:label 'Cashless Only Flag' ;
    rdfs:comment 'Indicates whether this concession stand operates exclusively on cashless payment methods (card and mobile), with no cash acceptance. Supports venue-wide cashless transformation initiatives and POS configuration.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concourseLevel rdf:type rdf:Property ;
    rdfs:label 'Concourse Level' ;
    rdfs:comment 'The vertical level or deck of the venue where the concession stand is located (e.g., \'Main Concourse\', \'Upper Deck\', \'Club Level\', \'Field Level\'). Used for operational routing and fan wayfinding.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concourseSection rdf:type rdf:Property ;
    rdfs:label 'Concourse Section' ;
    rdfs:comment 'The specific section, gate, or zone identifier within the concourse level where the stand is physically situated (e.g., \'Gate A\', \'Section 100-110\', \'North End Zone\'). Supports event-day logistics and staffing assignments.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireSuppressionSystemFlag rdf:type rdf:Property ;
    rdfs:label 'Fire Suppression System Flag' ;
    rdfs:comment 'Indicates whether this concession stand is equipped with a fire suppression system (e.g., Ansul hood suppression for cooking equipment). Required for OSHA compliance and insurance documentation.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geoLatitude rdf:type rdf:Property ;
    rdfs:label 'Geo Latitude' ;
    rdfs:comment 'GPS latitude coordinate of the concession stand\'s physical location within the venue. Enables digital venue mapping, fan wayfinding applications, and indoor navigation integrations.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geoLongitude rdf:type rdf:Property ;
    rdfs:label 'Geo Longitude' ;
    rdfs:comment 'GPS longitude coordinate of the concession stand\'s physical location within the venue. Enables digital venue mapping, fan wayfinding applications, and indoor navigation integrations.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:healthInspectionScore rdf:type rdf:Property ;
    rdfs:label 'Health Inspection Score' ;
    rdfs:comment 'Numeric score assigned by the health authority during the most recent inspection, typically on a 0–100 scale. Enables trend analysis and benchmarking of food safety performance across stands.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthInspectionStatus rdf:type rdf:Property ;
    rdfs:label 'Health Inspection Status' ;
    rdfs:comment 'Current health and food safety inspection status of the concession stand as assessed by the local health authority. Drives operational readiness decisions and compliance reporting. Values: pass, conditional_pass, fail, pending, not_inspected.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hvacZoneCode rdf:type rdf:Property ;
    rdfs:label 'Hvac Zone Code' ;
    rdfs:comment 'Building Management System (BMS) zone code for the Heating, Ventilation, and Air Conditioning (HVAC) zone covering this concession stand. Supports facility management, food safety temperature compliance, and OSHA environmental standards.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastEquipmentServiceDate rdf:type rdf:Property ;
    rdfs:label 'Last Equipment Service Date' ;
    rdfs:comment 'Date of the most recent preventive maintenance or equipment servicing performed at this concession stand. Supports facility management scheduling and OSHA equipment safety compliance.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastHealthInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Health Inspection Date' ;
    rdfs:comment 'Date of the most recent health and food safety inspection conducted at this concession stand. Used to track inspection currency and schedule upcoming inspections per regulatory requirements.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maxThroughputPerHour rdf:type rdf:Property ;
    rdfs:label 'Max Throughput Per Hour' ;
    rdfs:comment 'Engineered maximum number of transactions this stand can process per hour under full staffing and optimal conditions. Used for event-day capacity planning, queue management, and per-capita spend modeling.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nextHealthInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Next Health Inspection Date' ;
    rdfs:comment 'Scheduled date for the next mandatory health and food safety inspection at this concession stand. Supports proactive compliance management and operational readiness planning.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:operatorType rdf:type rdf:Property ;
    rdfs:label 'Operator Type' ;
    rdfs:comment 'Indicates whether the concession stand is operated directly by the venue (in_house) or by an external contracted concessionaire (third_party). Drives revenue recognition treatment and contract compliance tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:posSystemCode rdf:type rdf:Property ;
    rdfs:label 'Pos System Code' ;
    rdfs:comment 'Identifier of the POS system instance or configuration profile assigned to this stand within the POS platform (e.g., Oracle MICROS, Appetize, SpotOn). Used for POS system integration and transaction reconciliation with SAP S/4HANA SD.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatingCapacity rdf:type rdf:Property ;
    rdfs:label 'Seating Capacity' ;
    rdfs:comment 'Number of guest seats available at or adjacent to this concession stand, applicable for premium club kitchens, bar stations, and sit-down food outlets. Null for walk-up or portable stands with no dedicated seating.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:selfServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Self Service Flag' ;
    rdfs:comment 'Indicates whether this concession stand operates as a self-service kiosk or automated unit requiring no staff attendant. Relevant for labor cost modeling and fan experience design.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:squareFootage rdf:type rdf:Property ;
    rdfs:label 'Square Footage' ;
    rdfs:comment 'Physical floor area of the concession stand in square feet. Used for facility management, lease cost allocation, and OSHA occupancy compliance calculations.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:staffCountStandard rdf:type rdf:Property ;
    rdfs:label 'Staff Count Standard' ;
    rdfs:comment 'Standard number of staff members assigned to operate this concession stand during a typical event. Used for workforce planning, labor cost budgeting, and SAP SuccessFactors scheduling.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standCode rdf:type rdf:Property ;
    rdfs:label 'Stand Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the concession stand unit, used in POS system configuration, signage, and operational reporting (e.g., CS-101, BAR-C3). Sourced from SAP S/4HANA SD plant/storage location codes.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standName rdf:type rdf:Property ;
    rdfs:label 'Stand Name' ;
    rdfs:comment 'Human-readable display name of the concession stand as it appears on venue maps, signage, and fan-facing applications (e.g., \'Club Level Bar\', \'Section 112 Hot Dogs\', \'Premium Lounge Kitchen\').' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standType rdf:type rdf:Property ;
    rdfs:label 'Stand Type' ;
    rdfs:comment 'Operational classification of the concession stand unit indicating its physical configuration and service model: permanent (fixed built-in unit), portable (mobile cart), premium (club/suite kitchen), bar (licensed alcohol bar station), or specialty (themed or branded outlet).' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageAreaCode rdf:type rdf:Property ;
    rdfs:label 'Storage Area Code' ;
    rdfs:comment 'SAP S/4HANA MM storage location code identifying the back-of-house inventory storage area associated with this concession stand. Enables inventory replenishment tracking and materials management.' ;
    rdfs:domain ind:ConcessionStand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concessionTransactionId rdf:type rdf:Property ;
    rdfs:label 'Concession Transaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each Point of Sale (POS) concession transaction record in the Silver Layer lakehouse. Primary key for this entity.' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalTransactionConcessionTransactionId rdf:type rdf:Property ;
    rdfs:label 'Original Transaction Concession Transaction Id' ;
    rdfs:comment 'Reference to the original concession_transaction_id that this record voids or refunds. Null for original sale transactions. Enables full transaction lineage and audit trail for dispute resolution.' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConcessionTransaction .

ind:ageVerificationFlag rdf:type rdf:Property ;
    rdfs:label 'Age Verification Flag' ;
    rdfs:comment 'Indicates whether age verification was performed for this transaction (required for alcohol sales). True = age verified. Supports regulatory compliance with state alcohol beverage control laws and venue liability management.' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:alcoholSaleFlag rdf:type rdf:Property ;
    rdfs:label 'Alcohol Sale Flag' ;
    rdfs:comment 'Indicates whether the transaction included the sale of an alcoholic beverage. True = alcohol sold. Used for regulatory compliance reporting, alcohol revenue tracking, and enforcement of venue alcohol policies (e.g., last-call cutoff times).' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cardType rdf:type rdf:Property ;
    rdfs:label 'Card Type' ;
    rdfs:comment 'The card network brand used for card-based payments (Visa, Mastercard, Amex, Discover). Populated only when payment_method is \'credit_card\' or \'debit_card\'; otherwise \'none\'. Used for payment processing fee analysis and PCI-DSS reporting.' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountCode rdf:type rdf:Property ;
    rdfs:label 'Discount Code' ;
    rdfs:comment 'Promotional or coupon code applied to the transaction to trigger the discount. Null if no discount code was used. Enables promotion effectiveness tracking and redemption reporting.' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRefund rdf:type rdf:Property ;
    rdfs:label 'Is Refund' ;
    rdfs:comment 'Indicates whether this transaction record represents a post-sale refund/reversal rather than an original sale. True = refund transaction with negative net_amount. False = original sale. Enables accurate net revenue calculation.' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isVoid rdf:type rdf:Property ;
    rdfs:label 'Is Void' ;
    rdfs:comment 'Indicates whether this transaction has been voided (cancelled before settlement). True = voided transaction that should be excluded from revenue totals. False = active transaction. Used for revenue reconciliation and fraud monitoring.' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itemSku rdf:type rdf:Property ;
    rdfs:label 'Item Sku' ;
    rdfs:comment 'The Stock Keeping Unit (SKU) code identifying the specific food, beverage, or non-merchandise concession item sold. Aligns with SAP S/4HANA MM material number for inventory and cost-of-goods tracking.' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:posTransactionNumber rdf:type rdf:Property ;
    rdfs:label 'Pos Transaction Number' ;
    rdfs:comment 'Externally-known transaction reference number generated by the POS terminal at the time of sale. Used for receipt lookup, dispute resolution, and reconciliation with SAP S/4HANA SD billing documents.' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantitySold rdf:type rdf:Property ;
    rdfs:label 'Quantity Sold' ;
    rdfs:comment 'Number of units of the concession item sold in this transaction line. Used for inventory depletion tracking, per-capita spend analysis, and demand forecasting.' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standZone rdf:type rdf:Property ;
    rdfs:label 'Stand Zone' ;
    rdfs:comment 'The venue zone or section designation where the concession stand or cart is located (e.g., \'Lower Bowl\', \'Club Level\', \'Upper Deck\', \'Concourse A\'). Enables zone-level revenue analysis and staffing allocation.' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxJurisdictionCode rdf:type rdf:Property ;
    rdfs:label 'Tax Jurisdiction Code' ;
    rdfs:comment 'The tax jurisdiction code identifying the applicable state and local tax authority for this transaction. Used for multi-jurisdiction tax remittance and SAP S/4HANA FI tax reporting (e.g., \'CA0073000\' for Los Angeles County).' ;
    rdfs:domain ind:ConcessionTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDayOpsId rdf:type rdf:Property ;
    rdfs:label 'Event Day Ops Id' ;
    rdfs:comment 'Unique surrogate identifier for each event-day operational record. Primary key for the event_day_ops data product in the venue domain. Role: TRANSACTION_HEADER.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:facilityManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Facility Manager Employee Id' ;
    rdfs:comment 'Reference to the workforce record of the facility manager responsible for certifying pre-event readiness and signing off post-event closeout. Aligns with SAP SuccessFactors HCM employee records.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:operationalReadinessId rdf:type rdf:Property ;
    rdfs:label 'Operational Readiness Id' ;
    rdfs:comment 'Foreign key linking to venue.operational_readiness. Business justification: event_day_ops captures event-day execution and has a readiness_status field that duplicates data from the operational_readiness record. The operational_readiness product is the authoritative pre-event' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OperationalReadiness .

ind:rentalId rdf:type rdf:Property ;
    rdfs:label 'Rental Id' ;
    rdfs:comment 'Foreign key linking to venue.venue_rental. Business justification: For third-party rental events (concerts, corporate events, non-resident events), event_day_ops records the operational execution of that rental event. Linking event_day_ops to the venue_rental agreeme' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Rental .

ind:activeConcessionStandCount rdf:type rdf:Property ;
    rdfs:label 'Active Concession Stand Count' ;
    rdfs:comment 'Number of concession stands that were open and operational during the event. Used for food and beverage revenue analysis, staffing efficiency reporting, and Point of Sale (POS) reconciliation.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activeParkingLotCount rdf:type rdf:Property ;
    rdfs:label 'Active Parking Lot Count' ;
    rdfs:comment 'Number of parking lots or structures that were open and actively managed during the event. Used for parking revenue reconciliation and fan ingress/egress logistics analysis.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adaAccessConfirmed rdf:type rdf:Property ;
    rdfs:label 'Ada Access Confirmed' ;
    rdfs:comment 'Indicates whether all Americans with Disabilities Act (ADA) accessible entrances, seating areas, restrooms, and concession points have been verified as operational and unobstructed prior to event commencement.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bmsAlertCount rdf:type rdf:Property ;
    rdfs:label 'Bms Alert Count' ;
    rdfs:comment 'Total number of alerts generated by the venue\'s Building Management System (BMS) during the event-day operational window, including HVAC, electrical, plumbing, and structural alerts. Used for facility maintenance prioritization and post-event review.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:checklistCompletionPct rdf:type rdf:Property ;
    rdfs:label 'Checklist Completion Pct' ;
    rdfs:comment 'Percentage of pre-event readiness checklist items marked as completed at the time of facility manager approval. A value of 100.00 indicates all items were verified; values below 100.00 indicate outstanding items requiring conditional approval or rejection.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:criticalItemFailureCount rdf:type rdf:Property ;
    rdfs:label 'Critical Item Failure Count' ;
    rdfs:comment 'Number of critical checklist items that failed verification during the pre-event readiness assessment. Critical items include life-safety systems, emergency egress, and ADA access points. A non-zero count triggers conditional or rejected readiness status.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:damageAssessmentRequired rdf:type rdf:Property ;
    rdfs:label 'Damage Assessment Required' ;
    rdfs:comment 'Indicates whether a post-event facility damage assessment has been flagged as required based on incidents, structural observations, or facility manager discretion during event closeout.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencySystemVerified rdf:type rdf:Property ;
    rdfs:label 'Emergency System Verified' ;
    rdfs:comment 'Indicates whether emergency communication systems, public address systems, and emergency egress lighting have been tested and verified as operational prior to event commencement.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:facilityManagerApprovalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Facility Manager Approval Timestamp' ;
    rdfs:comment 'Date and time at which the facility manager formally approved or rejected the pre-event readiness certification. Serves as the official certification timestamp for compliance audit trails.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fireSystemVerified rdf:type rdf:Property ;
    rdfs:label 'Fire System Verified' ;
    rdfs:comment 'Indicates whether the venue\'s fire detection, suppression, and alarm systems have been tested and verified as fully operational prior to event commencement. Mandatory life-safety compliance check.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gatesOpenTimestamp rdf:type rdf:Property ;
    rdfs:label 'Gates Open Timestamp' ;
    rdfs:comment 'Actual date and time at which venue gates were opened to allow fan ingress. Used to measure gate-open-to-event-start lead time and to reconcile against Ticketmaster/AXS access control scan data.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:hvacVerified rdf:type rdf:Property ;
    rdfs:label 'Hvac Verified' ;
    rdfs:comment 'Indicates whether the venue\'s Heating, Ventilation, and Air Conditioning (HVAC) system has been inspected and verified as operational prior to event commencement. Required for OSHA compliance and fan comfort standards.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadInEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Load In End Timestamp' ;
    rdfs:comment 'Actual date and time at which all production and equipment load-in activities were completed. Used to calculate load-in duration and assess readiness timeline adherence.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:loadInStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Load In Start Timestamp' ;
    rdfs:comment 'Actual date and time at which production, equipment, and talent load-in activities commenced at the venue. Critical for event-day logistics scheduling and union labor compliance under applicable Collective Bargaining Agreements (CBA).' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:loadOutEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Load Out End Timestamp' ;
    rdfs:comment 'Actual date and time at which all post-event load-out activities were completed and the venue was returned to base operational state. Marks the end of the active event-day operational window.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:loadOutStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Load Out Start Timestamp' ;
    rdfs:comment 'Actual date and time at which post-event production and equipment load-out activities commenced. Used for venue turnaround scheduling and labor cost tracking.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:medicalStationReady rdf:type rdf:Property ;
    rdfs:label 'Medical Station Ready' ;
    rdfs:comment 'Indicates whether all designated medical aid stations within the venue are staffed, stocked, and operationally ready prior to gates opening. Required for mass-gathering event compliance.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:opsReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Ops Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to this event-day operational record, used for cross-system identification and communication with venue operations teams. Format: EDO-{YYYY}-{NNNNNN}.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opsStatus rdf:type rdf:Property ;
    rdfs:label 'Ops Status' ;
    rdfs:comment 'Current lifecycle stage of the event-day operational record, tracking progression from pre-event preparation through in-progress execution to post-event reconciliation and final closure.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peakConcourseOccupancy rdf:type rdf:Property ;
    rdfs:label 'Peak Concourse Occupancy' ;
    rdfs:comment 'Maximum number of fans simultaneously present on the concourse level at any point during the event, as measured by crowd management systems. Used for crowd density analysis and OSHA safety compliance reporting.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postEventNotes rdf:type rdf:Property ;
    rdfs:label 'Post Event Notes' ;
    rdfs:comment 'Free-text field for facility manager observations, anomalies, and recommendations captured during post-event closeout. Feeds into the post-event report and informs future event-day operational planning.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postEventSignoffTimestamp rdf:type rdf:Property ;
    rdfs:label 'Post Event Signoff Timestamp' ;
    rdfs:comment 'Date and time at which the facility manager formally signed off on the post-event closeout, confirming load-out completion, damage assessment disposition, and venue return to base operational state.' ;
    rdfs:domain ind:EventDayOps ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:securitySweepCompleted rdf:type rdf:Property ;
    rdfs:label 'Security Sweep Completed' ;
    rdfs:comment 'Indicates whether a full venue security sweep has been completed prior to gates opening, confirming no unauthorized persons or prohibited items are present in the facility.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:broadcastProductionLevel rdf:type rdf:Property ;
    rdfs:label 'Broadcast Production Level' ;
    rdfs:comment 'Classification of the venue\'s broadcast infrastructure capability tier. Tier 1 = full national/international OB (Outside Broadcast) production with permanent broadcast compound; Tier 2 = RSN (Regional Sports Network) capable; Tier 3 = local/streaming only; Non-broadcast = no permanent broadcast infrastructure.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldDimensionsNotes rdf:type rdf:Property ;
    rdfs:label 'Field Dimensions Notes' ;
    rdfs:comment 'Free-text description of the primary playing field or stage dimensions including notable non-standard measurements (e.g., asymmetric outfield dimensions in MLB ballparks, stage depth for concert configurations). Used by event production and broadcast teams for pre-event planning.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossSqft rdf:type rdf:Property ;
    rdfs:label 'Gross Sqft' ;
    rdfs:comment 'Total gross interior square footage of the venue facility including all concourses, concession areas, back-of-house operations, suites, and playing surface. Used for facility management cost allocation, HVAC sizing, and OSHA compliance reporting.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:homeTenantName rdf:type rdf:Property ;
    rdfs:label 'Home Tenant Name' ;
    rdfs:comment 'Name of the primary home team, franchise, or resident tenant organization that uses the venue as its principal home base (e.g., \'Los Angeles Rams\', \'New York Knicks\'). Used in event scheduling, broadcast rights attribution, and sponsorship agreement scoping.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hvacSystemType rdf:type rdf:Property ;
    rdfs:label 'Hvac System Type' ;
    rdfs:comment 'Classification of the primary HVAC system installed in the venue. Determines energy consumption benchmarks, maintenance scheduling cadence, and climate control capability for event-day comfort and ice surface management (NHL arenas).' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxEventCapacityOverride rdf:type rdf:Property ;
    rdfs:label 'Max Event Capacity Override' ;
    rdfs:comment 'Operationally approved maximum attendance figure that may differ from the certified total capacity due to event-specific configurations (e.g., stage placement reducing seating, COVID-era restrictions, or temporary expansion permits). Used by ticketing systems to set hard inventory ceilings per event.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ownershipStructure rdf:type rdf:Property ;
    rdfs:label 'Ownership Structure' ;
    rdfs:comment 'Legal and financial relationship between Sports Entertainment and the venue asset. Determines accounting treatment (capital vs. operating lease), maintenance obligations, and naming rights negotiation authority under SAP FI/CO asset accounting.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:playingSurfaceType rdf:type rdf:Property ;
    rdfs:label 'Playing Surface Type' ;
    rdfs:comment 'Type of playing surface installed in the venue\'s primary competition area. Determines sport eligibility, athlete safety protocols, and maintenance scheduling. [ENUM-REF-CANDIDATE: natural_grass|artificial_turf|hardwood|ice|clay|grass|synthetic_clay — promote to reference product if additional surface types are required]' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumSuiteCount rdf:type rdf:Property ;
    rdfs:label 'Premium Suite Count' ;
    rdfs:comment 'Total number of premium luxury suites and private boxes available in the venue. Drives VIP ticketing inventory, suite license agreement management, and premium hospitality revenue planning in Salesforce CRM and Archtics.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primarySportCategory rdf:type rdf:Property ;
    rdfs:label 'Primary Sport Category' ;
    rdfs:comment 'The principal sport or entertainment category for which the venue is primarily designed and configured (e.g., \'American Football\', \'Basketball\', \'Ice Hockey\', \'Soccer\', \'Concert/Live Entertainment\', \'Baseball\'). Drives default seating bowl configuration and broadcast production setup.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roofType rdf:type rdf:Property ;
    rdfs:label 'Roof Type' ;
    rdfs:comment 'Classification of the venue\'s roof structure indicating weather protection capability. Impacts event scheduling decisions, broadcast lighting requirements, HVAC system design, and contingency planning for weather-affected events.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreboardType rdf:type rdf:Property ;
    rdfs:label 'Scoreboard Type' ;
    rdfs:comment 'Type of primary scoreboard and video display system installed in the venue. Determines broadcast production integration capability, in-venue fan experience quality, and advertising inventory available on digital displays.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatingBowlConfigCode rdf:type rdf:Property ;
    rdfs:label 'Seating Bowl Config Code' ;
    rdfs:comment 'Alphanumeric code identifying the specific seating bowl layout configuration loaded in Archtics for this venue (e.g., \'NFL-FULL\', \'CONCERT-360\', \'NBA-STANDARD\'). Maps to the seating manifest used for ticket inventory allocation and pricing zone assignment.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCapacity rdf:type rdf:Property ;
    rdfs:label 'Total Capacity' ;
    rdfs:comment 'Maximum total number of spectators the venue can accommodate across all seating categories (GA, reserved, VIP, SRO) as certified by local fire and safety authorities. Primary capacity figure used in ticketing inventory allocation and revenue yield modeling.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:venueCode rdf:type rdf:Property ;
    rdfs:label 'Venue Code' ;
    rdfs:comment 'Short alphanumeric business identifier for the venue used in operational systems, scheduling interfaces, and broadcast production workflows (e.g., \'LAX-SOFI\', \'NYC-MSG\'). Externally recognized across SAP, Ticketmaster/AXS, and Archtics integrations.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wifiCapacityMbps rdf:type rdf:Property ;
    rdfs:label 'Wifi Capacity Mbps' ;
    rdfs:comment 'Total available Wi-Fi network bandwidth in megabits per second provisioned for the venue\'s public fan-facing network. Supports digital fan engagement platforms, mobile ticketing, OTT streaming, and DTC content delivery during events.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:yearBuilt rdf:type rdf:Property ;
    rdfs:label 'Year Built' ;
    rdfs:comment 'Four-digit calendar year in which the venue was originally constructed and opened. Used for asset depreciation scheduling in SAP FI/CO, capital planning, and historical context in broadcast storytelling.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:yearLastRenovated rdf:type rdf:Property ;
    rdfs:label 'Year Last Renovated' ;
    rdfs:comment 'Four-digit calendar year of the most recent significant capital renovation or refurbishment of the venue. Used in asset lifecycle management, capital expenditure planning, and ADA/OSHA compliance upgrade tracking.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maintenanceWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Maintenance Work Order Id' ;
    rdfs:comment 'Unique surrogate identifier for the maintenance work order record in the Silver Layer lakehouse. Primary key for this entity. Role: TRANSACTION_HEADER.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedByManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approved By Manager Employee Id' ;
    rdfs:comment 'Reference to the facility manager or supervisor who reviewed and approved the work order for execution. Required for sign-off and compliance audit trail per OSHA and internal governance.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:maintenancePlanId rdf:type rdf:Property ;
    rdfs:label 'Maintenance Plan Id' ;
    rdfs:comment 'Reference to the SAP PM preventive maintenance plan that generated this work order, if applicable. Null for reactive/emergency orders. Enables traceability between planned maintenance schedules and executed work orders.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaintenancePlan .

ind:primaryMaintenanceRequestedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Maintenance Requested By Employee Id' ;
    rdfs:comment 'Reference to the employee or facility staff member who initiated and submitted the maintenance work order request. Supports accountability and requester notification workflows.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:tertiaryMaintenanceApprovedByManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Maintenance Approved By Manager Employee Id' ;
    rdfs:comment 'Reference to the facility manager or supervisor who reviewed and approved the work order for execution. Required for sign-off and compliance audit trail per OSHA and internal governance.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:triggeringSafetyIncidentId rdf:type rdf:Property ;
    rdfs:label 'Triggering Safety Incident Id' ;
    rdfs:comment 'Foreign key linking to venue.safety_incident. Business justification: Safety incidents frequently trigger corrective maintenance work orders (e.g., a fan injury due to a broken seat triggers a repair work order). This FK on maintenance_work_order references the safety_i' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SafetyIncident .

ind:triggeringSafetyInspectionId rdf:type rdf:Property ;
    rdfs:label 'Triggering Safety Inspection Id' ;
    rdfs:comment 'Foreign key linking to venue.safety_inspection. Business justification: Safety inspections with corrective_actions_required=TRUE generate maintenance work orders to remediate findings. This FK on maintenance_work_order references the safety_inspection that identified the ' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SafetyInspection .

ind:triggeringSlaIncidentId rdf:type rdf:Property ;
    rdfs:label 'Triggering Sla Incident Id' ;
    rdfs:comment 'Foreign key linking to platform.sla_incident. Business justification: Platform SLA incidents (Wi-Fi outage, POS system failure, scoreboard connectivity loss) trigger venue maintenance work orders for physical remediation. The existing triggering_safety_incident_id and t' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SlaIncident .

ind:actualLaborHours rdf:type rdf:Property ;
    rdfs:label 'Actual Labor Hours' ;
    rdfs:comment 'Actual number of labor hours recorded by the technician upon work order confirmation in SAP PM. Used for variance analysis against estimated hours, payroll costing, and productivity KPI reporting.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetSystemCategory rdf:type rdf:Property ;
    rdfs:label 'Asset System Category' ;
    rdfs:comment 'High-level categorization of the venue infrastructure system or asset type being maintained. Supports maintenance trend analysis by system type and regulatory compliance reporting. HVAC: Heating Ventilation and Air Conditioning. BMS: Building Management System. [ENUM-REF-CANDIDATE: hvac|bms|electrical|plumbing|structural|seating|concessions|av_systems|security|parking|lighting — promote to reference product]' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionNotes rdf:type rdf:Property ;
    rdfs:label 'Completion Notes' ;
    rdfs:comment 'Free-text field capturing the technician\'s observations, findings, and actions taken upon completion of the work order. Includes any deviations from the planned scope, follow-up recommendations, or residual risks identified during execution.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:damageCode rdf:type rdf:Property ;
    rdfs:label 'Damage Code' ;
    rdfs:comment 'Standardized SAP PM catalog code describing the type of damage observed on the asset (e.g., corrosion, fracture, leakage, contamination). Used in conjunction with failure code for root cause analysis and insurance claims.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedLaborHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Labor Hours' ;
    rdfs:comment 'Planned number of labor hours required to complete the maintenance work order, as estimated during work order creation or planning. Used for resource capacity planning and budget estimation.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalServiceCost rdf:type rdf:Property ;
    rdfs:label 'External Service Cost' ;
    rdfs:comment 'Cost of external contractor or vendor services procured via purchase order and charged to this work order. Relevant for specialized maintenance (e.g., elevator servicing, fire suppression systems) requiring licensed third-party contractors.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failureCode rdf:type rdf:Property ;
    rdfs:label 'Failure Code' ;
    rdfs:comment 'Standardized SAP PM catalog code identifying the root cause or failure mode of the defect that triggered a corrective or emergency work order (e.g., mechanical wear, electrical fault, vandalism). Enables failure mode analysis and reliability-centered maintenance (RCM) reporting.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalLocationCode rdf:type rdf:Property ;
    rdfs:label 'Functional Location Code' ;
    rdfs:comment 'SAP PM functional location identifier representing the hierarchical physical location within the venue where the work is performed (e.g., ARENA-01-HVAC-ZONE-B). Enables spatial analysis of maintenance activity across venue infrastructure.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAdaComplianceRelated rdf:type rdf:Property ;
    rdfs:label 'Is Ada Compliance Related' ;
    rdfs:comment 'Indicates whether this work order is related to Americans with Disabilities Act (ADA) accessibility compliance, such as repairs to accessible seating, ramps, elevators, or accessible restrooms. Flags orders requiring ADA compliance sign-off.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSafetyCritical rdf:type rdf:Property ;
    rdfs:label 'Is Safety Critical' ;
    rdfs:comment 'Indicates whether this work order involves a safety-critical system or structural element where failure could pose risk to personnel, fans, or athletes. Safety-critical orders require expedited processing and mandatory sign-off per OSHA regulations.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationNumber rdf:type rdf:Property ;
    rdfs:label 'Notification Number' ;
    rdfs:comment 'SAP PM notification number associated with the defect or malfunction report that triggered this work order. Links the work order back to the originating fault notification for full traceability.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partsCost rdf:type rdf:Property ;
    rdfs:label 'Parts Cost' ;
    rdfs:comment 'Actual cost of spare parts and materials consumed during the maintenance work order, as recorded through SAP MM goods issue against the order. Enables materials cost breakdown separate from labor costs.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:partsUsedDescription rdf:type rdf:Property ;
    rdfs:label 'Parts Used Description' ;
    rdfs:comment 'Free-text or structured description of spare parts, materials, and consumables used during the maintenance activity. Includes part names, quantities, and SAP material numbers where applicable. Supports inventory replenishment and parts usage trend analysis.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitToWorkNumber rdf:type rdf:Property ;
    rdfs:label 'Permit To Work Number' ;
    rdfs:comment 'Reference number of the formal permit to work (PTW) issued for this maintenance activity, required for high-risk tasks such as hot work, confined space entry, or electrical isolation. Mandatory for OSHA compliance documentation.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresShutdown rdf:type rdf:Property ;
    rdfs:label 'Requires Shutdown' ;
    rdfs:comment 'Indicates whether execution of this work order requires a partial or full shutdown of a venue zone, system, or utility (e.g., power isolation, HVAC shutdown). Drives coordination with venue operations and event scheduling teams.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workDescription rdf:type rdf:Property ;
    rdfs:label 'Work Description' ;
    rdfs:comment 'Detailed narrative description of the maintenance task to be performed, including the nature of the fault or scheduled activity, scope of work, and any special instructions for the technician. Sourced from SAP PM short and long text fields.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Work Order Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned by SAP S/4HANA Plant Maintenance (PM) module to uniquely identify this maintenance work order across operational systems. Used for cross-system traceability and field technician reference.' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderStatus rdf:type rdf:Property ;
    rdfs:label 'Work Order Status' ;
    rdfs:comment 'Current lifecycle state of the maintenance work order within the SAP PM workflow. Draft: created but not yet released. Open: released and awaiting execution. In Progress: technician actively working. On Hold: paused pending parts or approval. Completed: work finished, awaiting sign-off. Closed: fully signed off and costed. Cancelled: voided before execution. [ENUM-REF-CANDIDATE: draft|open|in_progress|on_hold|completed|closed|cancelled — promote to reference product]' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderType rdf:type rdf:Property ;
    rdfs:label 'Work Order Type' ;
    rdfs:comment 'Classification of the maintenance activity by its trigger and nature. Preventive: scheduled routine maintenance. Corrective: repair of a known fault. Emergency: unplanned critical failure response. Inspection: condition assessment. Predictive: data-driven proactive maintenance. Capital: improvement or replacement project. [ENUM-REF-CANDIDATE: preventive|corrective|emergency|inspection|predictive|capital — promote to reference product]' ;
    rdfs:domain ind:MaintenanceWorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvingManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approving Manager Employee Id' ;
    rdfs:comment 'Reference to the facility manager or operations officer who reviewed and approved, conditionally approved, or rejected this readiness certification record.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:adaAccessVerified rdf:type rdf:Property ;
    rdfs:label 'Ada Access Verified' ;
    rdfs:comment 'Indicates whether all ADA-required accessible routes, seating areas, restrooms, and facilities have been verified as operational and unobstructed for this event. True = ADA access confirmed; False = ADA access not verified or deficiencies found.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bmsConnectivityStatus rdf:type rdf:Property ;
    rdfs:label 'Bms Connectivity Status' ;
    rdfs:comment 'Status of the venue\'s Building Management System (BMS) connectivity and monitoring capability as assessed during the pre-event readiness check. BMS monitors HVAC, electrical, and life-safety systems in real time.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastInfrastructureStatus rdf:type rdf:Property ;
    rdfs:label 'Broadcast Infrastructure Status' ;
    rdfs:comment 'Operational status of the venue\'s broadcast infrastructure including camera positions, cabling, production truck hookups, and Outside Broadcast (OB) connectivity as verified during the pre-event readiness check.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checklistItemCount rdf:type rdf:Property ;
    rdfs:label 'Checklist Item Count' ;
    rdfs:comment 'Total number of checklist items included in the readiness assessment for this event and facility combination, as defined by the applicable checklist version.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:concessionStandsReady rdf:type rdf:Property ;
    rdfs:label 'Concession Stands Ready' ;
    rdfs:comment 'Indicates whether concession stands and food service areas have been inspected, stocked, and confirmed ready for fan service prior to gates opening. True = concessions ready; False = not ready.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionalWaiverNotes rdf:type rdf:Property ;
    rdfs:label 'Conditional Waiver Notes' ;
    rdfs:comment 'Free-text notes documenting the specific conditions, mitigations, or waivers applied when the readiness status is \'conditional\'. Captures the rationale for proceeding despite failed or waived items.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyPlanActivated rdf:type rdf:Property ;
    rdfs:label 'Contingency Plan Activated' ;
    rdfs:comment 'Indicates whether a contingency or emergency operations plan has been activated for this event due to identified risks or failed checklist items. True = contingency plan activated; False = standard operations plan in effect.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalItemsFailedCount rdf:type rdf:Property ;
    rdfs:label 'Critical Items Failed Count' ;
    rdfs:comment 'Number of checklist items classified as critical (life-safety, structural, or regulatory) that failed during the readiness assessment. Any value greater than zero typically triggers a \'rejected\' or \'conditional\' readiness status.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crowdManagementPlanConfirmed rdf:type rdf:Property ;
    rdfs:label 'Crowd Management Plan Confirmed' ;
    rdfs:comment 'Indicates whether the crowd management and ingress/egress plan has been reviewed, staffed, and confirmed as ready for the expected attendance level for this event. True = plan confirmed; False = not confirmed.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyLightingStatus rdf:type rdf:Property ;
    rdfs:label 'Emergency Lighting Status' ;
    rdfs:comment 'Operational status of the venue\'s emergency lighting and exit signage systems as verified during the pre-event readiness assessment. Required for safe evacuation under NFPA 101 and OSHA standards.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evacuationPlanPosted rdf:type rdf:Property ;
    rdfs:label 'Evacuation Plan Posted' ;
    rdfs:comment 'Indicates whether current evacuation plans and emergency exit signage have been posted and verified at all required locations throughout the venue prior to the event. True = posted and verified; False = not confirmed.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventTypeCategory rdf:type rdf:Property ;
    rdfs:label 'Event Type Category' ;
    rdfs:comment 'Classification of the event type for which this readiness assessment is being conducted. Determines which checklist items are applicable and which may be waived. [ENUM-REF-CANDIDATE: sporting_event|concert|conference|mixed_use|private_event|other — promote to reference product if additional types are needed]' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldPlayingSurfaceStatus rdf:type rdf:Property ;
    rdfs:label 'Field Playing Surface Status' ;
    rdfs:comment 'Readiness status of the playing field or performance surface as assessed during the pre-event readiness check. Includes inspection for safety hazards, markings, and surface conditions. \'conditional\' may indicate weather-related concerns.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireSuppressionStatus rdf:type rdf:Property ;
    rdfs:label 'Fire Suppression Status' ;
    rdfs:comment 'Operational status of the venue\'s fire suppression system (sprinklers, suppression agents) as verified during the pre-event readiness assessment. A non-operational status is a critical failure.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazmatInspectionCompleted rdf:type rdf:Property ;
    rdfs:label 'Hazmat Inspection Completed' ;
    rdfs:comment 'Indicates whether a hazardous materials inspection has been completed for the venue prior to the event, confirming no prohibited substances or unsafe storage conditions are present. True = inspection completed and cleared; False = not completed.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hvacSystemStatus rdf:type rdf:Property ;
    rdfs:label 'Hvac System Status' ;
    rdfs:comment 'Operational status of the venue\'s Heating, Ventilation, and Air Conditioning (HVAC) system as assessed during the pre-event readiness check. \'degraded\' indicates partial functionality that may require mitigation.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemsFailedCount rdf:type rdf:Property ;
    rdfs:label 'Items Failed Count' ;
    rdfs:comment 'Number of checklist items that did not meet the required standard during the readiness assessment, including both critical and non-critical failures.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:itemsPassedCount rdf:type rdf:Property ;
    rdfs:label 'Items Passed Count' ;
    rdfs:comment 'Number of checklist items that were inspected and confirmed as fully compliant during the readiness assessment.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:itemsWaivedCount rdf:type rdf:Property ;
    rdfs:label 'Items Waived Count' ;
    rdfs:comment 'Number of checklist items formally waived for this assessment, typically due to inapplicability for the specific event type, venue configuration, or approved variance.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medicalStationStatus rdf:type rdf:Property ;
    rdfs:label 'Medical Station Status' ;
    rdfs:comment 'Readiness status of on-site medical stations and first-aid facilities for the event. \'partial\' indicates some stations are staffed and equipped but not all required stations are fully operational.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaComplianceConfirmed rdf:type rdf:Property ;
    rdfs:label 'Osha Compliance Confirmed' ;
    rdfs:comment 'Indicates whether all applicable Occupational Safety and Health Administration (OSHA) requirements for venue operations have been verified as compliant during this readiness assessment. True = OSHA compliance confirmed; False = compliance not confirmed or deficiencies found.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parkingOperationsReady rdf:type rdf:Property ;
    rdfs:label 'Parking Operations Ready' ;
    rdfs:comment 'Indicates whether parking lots, garages, and traffic management personnel are in position and operational prior to gates opening. True = parking operations ready; False = not ready.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:posSystemsReady rdf:type rdf:Property ;
    rdfs:label 'Pos Systems Ready' ;
    rdfs:comment 'Indicates whether all Point of Sale (POS) terminals at concessions, merchandise stands, and box offices have been tested and confirmed operational prior to gates opening. True = POS systems ready; False = not ready.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicAddressSystemStatus rdf:type rdf:Property ;
    rdfs:label 'Public Address System Status' ;
    rdfs:comment 'Operational status of the venue\'s public address and emergency announcement system as verified during the pre-event readiness assessment. Critical for emergency communications and fan experience.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readinessReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Readiness Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned to this readiness certification record, used for audit trails, regulatory submissions, and cross-system traceability (e.g., OR-LAX001-20240915).' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readinessStatus rdf:type rdf:Property ;
    rdfs:label 'Readiness Status' ;
    rdfs:comment 'The overall certification outcome of the pre-event operational readiness assessment. \'approved\' means all critical items passed; \'conditional\' means minor items failed but event may proceed with mitigations; \'rejected\' means critical failures prevent event execution; \'pending\' means assessment is not yet complete; \'in_review\' means assessment is under management review.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reassessmentDeadline rdf:type rdf:Property ;
    rdfs:label 'Reassessment Deadline' ;
    rdfs:comment 'The deadline by which a reassessment must be completed when reassessment_required is True. Typically set relative to the gates_open_timestamp to ensure sufficient time for remediation and re-inspection.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reassessmentRequired rdf:type rdf:Property ;
    rdfs:label 'Reassessment Required' ;
    rdfs:comment 'Indicates whether a follow-up readiness reassessment is required before the event can proceed, typically triggered by a \'conditional\' or \'rejected\' status with remediation actions underway. True = reassessment required; False = no reassessment needed.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scoreboardDisplayStatus rdf:type rdf:Property ;
    rdfs:label 'Scoreboard Display Status' ;
    rdfs:comment 'Operational status of the venue\'s scoreboard, video boards, and digital display systems as verified during the pre-event readiness check. Impacts fan experience and broadcast production.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Weather Risk Level' ;
    rdfs:comment 'Assessed weather risk level for the event based on forecasts at the time of the readiness assessment. Influences conditional readiness decisions for outdoor or partially-covered venues. Values: low, moderate, high, severe.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wifiNetworkStatus rdf:type rdf:Property ;
    rdfs:label 'Wifi Network Status' ;
    rdfs:comment 'Operational status of the venue\'s fan-facing and operational Wi-Fi network infrastructure as verified during the pre-event readiness assessment. Impacts fan engagement, Point of Sale (POS) systems, and digital ticketing.' ;
    rdfs:domain ind:OperationalReadiness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryScreeningCheckpointId rdf:type rdf:Property ;
    rdfs:label 'Entry Screening Checkpoint Id' ;
    rdfs:comment 'Foreign key linking to security.screening_checkpoint. Business justification: Vehicle entry screening checkpoints serve specific parking lots. Security operations and staffing plans need to know which screening checkpoint controls entry to each parking lot for vehicle credentia' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ScreeningCheckpoint .

ind:accessControlType rdf:type rdf:Property ;
    rdfs:label 'Access Control Type' ;
    rdfs:comment 'Method used to control vehicle entry and exit at this parking lot: open (no control), ticket_scan (barcode/QR scan via Ticketmaster/AXS), permit_display (visual permit check), license_plate_recognition (automated LPR system), rfid (RFID transponder-based access).' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessibleSpaces rdf:type rdf:Property ;
    rdfs:label 'Accessible Spaces' ;
    rdfs:comment 'Number of parking spaces designated for persons with disabilities in compliance with ADA requirements. Used for ADA compliance reporting and event-day accessibility planning.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:baseEventRate rdf:type rdf:Property ;
    rdfs:label 'Base Event Rate' ;
    rdfs:comment 'Standard per-event parking fee charged to general patrons for this lot, expressed in the venue\'s operating currency. Used as the baseline for dynamic pricing calculations and revenue forecasting.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bmsZoneCode rdf:type rdf:Property ;
    rdfs:label 'Bms Zone Code' ;
    rdfs:comment 'Zone identifier within the venue\'s Building Management System (BMS) that monitors environmental and operational systems for this parking facility (e.g., lighting controls, barrier systems, HVAC in garages).' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityLastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Capacity Last Verified Date' ;
    rdfs:comment 'Date on which the total space count and space-type breakdown for this parking lot was last physically verified or audited. Ensures accuracy of capacity data used in event-day logistics and ADA compliance reporting.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:covered rdf:type rdf:Property ;
    rdfs:label 'Covered' ;
    rdfs:comment 'Indicates whether the parking lot or garage provides overhead cover/shelter for vehicles. Relevant for premium pricing differentiation and fan experience communications.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:distanceFromEntranceM rdf:type rdf:Property ;
    rdfs:label 'Distance From Entrance M' ;
    rdfs:comment 'Measured walking distance in meters from the nearest lot entry point to the venue\'s main public entrance. Used for fan wayfinding, ADA accessibility assessments, and shuttle route planning.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evChargingSpaces rdf:type rdf:Property ;
    rdfs:label 'Ev Charging Spaces' ;
    rdfs:comment 'Number of parking spaces equipped with electric vehicle (EV) charging stations. Supports sustainability reporting, fan amenity communications, and ISO 20121 event sustainability management.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastAdaInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Ada Inspection Date' ;
    rdfs:comment 'Date of the most recent ADA accessibility compliance inspection conducted for this parking lot. Supports regulatory audit trails and proactive compliance management.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lightingType rdf:type rdf:Property ;
    rdfs:label 'Lighting Type' ;
    rdfs:comment 'Type of lighting infrastructure installed in the parking lot. Relevant for OSHA safety compliance, energy management, and ISO 20121 sustainability reporting.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lotName rdf:type rdf:Property ;
    rdfs:label 'Lot Name' ;
    rdfs:comment 'Human-readable name of the parking lot as displayed to fans and operations staff (e.g., \'North Garage\', \'VIP Lot A\', \'Remote Shuttle Lot 3\').' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lotType rdf:type rdf:Property ;
    rdfs:label 'Lot Type' ;
    rdfs:comment 'Categorical classification of the parking facility structure and service tier: surface (open-air flat lot), garage (multi-level structured parking), remote (off-site shuttle-served lot), vip (premium reserved lot), accessible (ADA-designated accessible parking area).' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oversizedSpaces rdf:type rdf:Property ;
    rdfs:label 'Oversized Spaces' ;
    rdfs:comment 'Number of spaces designated for oversized vehicles such as buses, RVs, and trailers. Relevant for tailgating event planning and large-vehicle logistics.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preSaleAvailable rdf:type rdf:Property ;
    rdfs:label 'Pre Sale Available' ;
    rdfs:comment 'Indicates whether parking spaces in this lot can be purchased in advance through online or DTC (Direct-To-Consumer) ticketing channels prior to event day.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reservedSpaces rdf:type rdf:Property ;
    rdfs:label 'Reserved Spaces' ;
    rdfs:comment 'Number of spaces pre-allocated for season ticket holders, sponsors, VIP guests, or other reserved parking programs. Supports Ticketmaster/AXS parking inventory management.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonPassEligible rdf:type rdf:Property ;
    rdfs:label 'Season Pass Eligible' ;
    rdfs:comment 'Indicates whether this parking lot accepts season parking passes or annual parking permits. Drives eligibility logic in Ticketmaster/AXS access control and CRM entitlement management.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shuttleRouteCode rdf:type rdf:Property ;
    rdfs:label 'Shuttle Route Code' ;
    rdfs:comment 'Identifier for the shuttle bus route assigned to service this parking lot. Populated only when shuttle_served is True. Used for event-day logistics coordination and fan communications.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shuttleServed rdf:type rdf:Property ;
    rdfs:label 'Shuttle Served' ;
    rdfs:comment 'Indicates whether this parking lot is served by a shuttle bus service transporting patrons to and from the venue. Relevant for remote lot operations and fan experience planning.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalSpaces rdf:type rdf:Property ;
    rdfs:label 'Total Spaces' ;
    rdfs:comment 'Total number of vehicle parking spaces in the lot, including all space types (standard, accessible, EV, VIP, oversized). Principal capacity metric for event-day logistics and revenue planning.' ;
    rdfs:domain ind:ParkingLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:investigatingOfficerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Investigating Officer Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: OSHA incident investigation requires tracking which employee conducted the investigation. Sports venue safety compliance and regulatory reporting (OSHA 300 log) depend on identifying the responsible i' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:bodyPartAffected rdf:type rdf:Property ;
    rdfs:label 'Body Part Affected' ;
    rdfs:comment 'Description of the body part(s) injured or affected (e.g., head, left knee, lower back). Required for OSHA 301 incident report and insurance claim documentation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cctvFootageAvailable rdf:type rdf:Property ;
    rdfs:label 'Cctv Footage Available' ;
    rdfs:comment 'Indicates whether closed-circuit television (CCTV) or security camera footage of the incident is available and has been preserved. Critical for investigation, legal proceedings, and insurance claims.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveActionPlan rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan' ;
    rdfs:comment 'Free-text description of the planned corrective and preventive actions to address the root cause and prevent recurrence (e.g., install non-slip flooring, retrain crowd management staff, replace faulty equipment). Required for OSHA compliance and insurance risk management.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionStatus rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Status' ;
    rdfs:comment 'Current completion status of the corrective action plan. Enables management oversight of outstanding safety remediation obligations and regulatory compliance tracking.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysAwayFromWork rdf:type rdf:Property ;
    rdfs:label 'Days Away From Work' ;
    rdfs:comment 'Number of calendar days an affected worker was away from work as a result of the incident. Mandatory field for OSHA 300 log (Column H) for work-related injuries and illnesses. Zero for non-worker incidents.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysRestrictedWork rdf:type rdf:Property ;
    rdfs:label 'Days Restricted Work' ;
    rdfs:comment 'Number of calendar days an affected worker was on restricted work activity or job transfer as a result of the incident. Mandatory field for OSHA 300 log (Column I). Zero for non-worker incidents.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emergencyServicesType rdf:type rdf:Property ;
    rdfs:label 'Emergency Services Type' ;
    rdfs:comment 'Type of external emergency services dispatched in response to the incident. Null or \'none\' when is_emergency_services_called is false.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedLiabilityUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Liability Usd' ;
    rdfs:comment 'Estimated financial liability or cost exposure associated with the incident in US dollars, including medical costs, legal fees, and potential settlements. Used for insurance reserve setting and financial risk reporting under SOX.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incidentDatetime rdf:type rdf:Property ;
    rdfs:label 'Incident Datetime' ;
    rdfs:comment 'The precise date and time the safety or security incident occurred, recorded in ISO 8601 format with timezone offset. This is the principal real-world event timestamp used for OSHA 300 log entries, insurance reporting, and regulatory compliance.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:incidentNumber rdf:type rdf:Property ;
    rdfs:label 'Incident Number' ;
    rdfs:comment 'Externally-known, human-readable reference number assigned to the incident at time of reporting (e.g., INC-2024-000123). Used for cross-referencing with OSHA 300 log, insurance claims, and regulatory submissions.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryIllnessType rdf:type rdf:Property ;
    rdfs:label 'Injury Illness Type' ;
    rdfs:comment 'OSHA 300 log classification of the nature of the injury or illness (columns M1–M6 on OSHA Form 300). Required for OSHA 300A annual summary and regulatory reporting.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEmergencyServicesCalled rdf:type rdf:Property ;
    rdfs:label 'Is Emergency Services Called' ;
    rdfs:comment 'Indicates whether external emergency services (EMS, fire department, police) were dispatched to the venue in response to this incident. Triggers mandatory insurance notification and may require regulatory reporting.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFatality rdf:type rdf:Property ;
    rdfs:label 'Is Fatality' ;
    rdfs:comment 'Indicates whether the incident resulted in one or more fatalities. Triggers mandatory OSHA reporting within 8 hours of employer knowledge under 29 CFR Part 1904.39 and activates crisis management protocols.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHospitalizationRequired rdf:type rdf:Property ;
    rdfs:label 'Is Hospitalization Required' ;
    rdfs:comment 'Indicates whether any affected person required in-patient hospitalization as a result of the incident. Mandatory OSHA reporting trigger (within 24 hours) for work-related incidents under 29 CFR Part 1904.39.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oshaCaseType rdf:type rdf:Property ;
    rdfs:label 'Osha Case Type' ;
    rdfs:comment 'OSHA 300 log case classification indicating the most serious outcome of the incident: death, days away from work, restricted work or job transfer, or other recordable case. Directly maps to OSHA Form 300 columns G through J.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personsAffectedCount rdf:type rdf:Property ;
    rdfs:label 'Persons Affected Count' ;
    rdfs:comment 'Total count of individuals (fans, workers, athletes, staff) directly affected by the incident. Used for severity assessment, insurance claims, and mass casualty protocol activation thresholds.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryNotificationDatetime rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Datetime' ;
    rdfs:comment 'Date and time the required regulatory notification was submitted (e.g., OSHA fatality report). Null if regulatory_notification_required is false or notification is pending. Used to verify compliance with mandatory reporting deadlines.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reportedByName rdf:type rdf:Property ;
    rdfs:label 'Reported By Name' ;
    rdfs:comment 'Full name of the venue staff member or official who formally reported the incident. Required for OSHA 301 incident report accountability and internal audit trail.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedDatetime rdf:type rdf:Property ;
    rdfs:label 'Reported Datetime' ;
    rdfs:comment 'The date and time the incident was formally reported to venue management or safety personnel. May differ from incident_datetime due to delayed discovery or reporting lag. Required for OSHA timeliness compliance.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:venueSection rdf:type rdf:Property ;
    rdfs:label 'Venue Section' ;
    rdfs:comment 'Specific section, block, or area designation within the venue zone where the incident occurred (e.g., Section 112, Gate B, Lot C). Aligns with Archtics seating and inventory management location codes.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherConditions rdf:type rdf:Property ;
    rdfs:label 'Weather Conditions' ;
    rdfs:comment 'Prevailing weather conditions at the time of the incident for outdoor or partially-outdoor venues. Relevant for slip-and-fall liability, crowd management decisions, and structural incident analysis. \'indoor_na\' for fully enclosed venues. [ENUM-REF-CANDIDATE: clear|rain|snow|fog|extreme_heat|high_wind|indoor_na — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessCount rdf:type rdf:Property ;
    rdfs:label 'Witness Count' ;
    rdfs:comment 'Number of witnesses identified at the time of the incident. Supports investigation completeness assessment and legal discovery preparation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyInspectionId rdf:type rdf:Property ;
    rdfs:label 'Safety Inspection Id' ;
    rdfs:comment 'Unique surrogate identifier for each safety inspection record within the venue compliance management system.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:internalReviewerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Internal Reviewer Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Venue safety inspection compliance requires tracking which internal employee reviewed findings before regulatory submission. Audit trails for fire code, ADA, and OSHA inspections must link to a verifi' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:priorInspectionSafetyInspectionId rdf:type rdf:Property ;
    rdfs:label 'Prior Inspection Safety Inspection Id' ;
    rdfs:comment 'Reference to the immediately preceding inspection of the same type at this venue, enabling inspection history chaining and trend analysis across inspection cycles.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SafetyInspection .

ind:reportAssetId rdf:type rdf:Property ;
    rdfs:label 'Report Asset Id' ;
    rdfs:comment 'Foreign key linking to content.asset. Business justification: Regulatory compliance requires inspection reports to be stored as versioned, managed content assets for audit trails and regulatory submission. safety_inspection has report_document_ref (plain string)' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:adaComplianceChecked rdf:type rdf:Property ;
    rdfs:label 'Ada Compliance Checked' ;
    rdfs:comment 'Indicates whether ADA (Americans with Disabilities Act) accessibility requirements — including accessible seating, ramps, restrooms, signage, and assistive listening systems — were specifically evaluated during this inspection.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:areasInspected rdf:type rdf:Property ;
    rdfs:label 'Areas Inspected' ;
    rdfs:comment 'Descriptive list of the specific venue zones, sections, or systems covered during the inspection (e.g., concourse level A, HVAC — Heating Ventilation and Air Conditioning plant room, emergency exits, accessible seating sections, electrical switchgear rooms, concession stands). Free-text narrative or comma-delimited zone codes.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bmsSystemChecked rdf:type rdf:Property ;
    rdfs:label 'Bms System Checked' ;
    rdfs:comment 'Indicates whether the Building Management System (BMS) — including HVAC, fire suppression, emergency lighting, and access control integrations — was reviewed as part of this inspection.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Certificate Expiry Date' ;
    rdfs:comment 'The date on which the compliance certificate issued from this inspection expires and a renewal inspection is required. Drives proactive scheduling of future inspections.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificateIssued rdf:type rdf:Property ;
    rdfs:label 'Certificate Issued' ;
    rdfs:comment 'Indicates whether a formal compliance certificate, clearance letter, or occupancy permit was issued as a result of this inspection. True when a certificate has been formally issued by the regulatory authority.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateNumber rdf:type rdf:Property ;
    rdfs:label 'Certificate Number' ;
    rdfs:comment 'The unique reference number printed on the compliance certificate or clearance document issued by the regulatory authority following a successful inspection. Null when no certificate was issued.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionNotes rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Notes' ;
    rdfs:comment 'Narrative description of the corrective actions required, including specific remediation steps, responsible parties, and any interim mitigation measures mandated by the inspector or regulatory authority.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionsRequired rdf:type rdf:Property ;
    rdfs:label 'Corrective Actions Required' ;
    rdfs:comment 'Indicates whether one or more corrective actions have been mandated as a result of this inspection. True when any finding requires a formal remediation response tracked in the corrective action management system.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fireSafetyChecked rdf:type rdf:Property ;
    rdfs:label 'Fire Safety Checked' ;
    rdfs:comment 'Indicates whether fire safety systems — including sprinklers, extinguishers, emergency exits, evacuation routes, and fire suppression equipment — were evaluated during this inspection.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionEndTime rdf:type rdf:Property ;
    rdfs:label 'Inspection End Time' ;
    rdfs:comment 'Precise date and time when the inspection walkthrough or audit concluded on-site. Combined with start time to derive inspection duration for operational planning.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:inspectionNumber rdf:type rdf:Property ;
    rdfs:label 'Inspection Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to this inspection, used in regulatory correspondence, certificates, and corrective action tracking. Format: INS-{YYYY}-{NNNNNN}.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionScope rdf:type rdf:Property ;
    rdfs:label 'Inspection Scope' ;
    rdfs:comment 'Indicates whether the inspection covered the entire facility or was limited to specific zones, systems, or follow-up items from a prior inspection. Supports risk-based compliance planning.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionStartTime rdf:type rdf:Property ;
    rdfs:label 'Inspection Start Time' ;
    rdfs:comment 'Precise date and time when the inspection walkthrough or audit commenced on-site. Used for duration tracking and scheduling coordination with venue operations.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:inspectionTrigger rdf:type rdf:Property ;
    rdfs:label 'Inspection Trigger' ;
    rdfs:comment 'The reason or event that initiated this inspection. Distinguishes between routine periodic inspections, those triggered by an incident or complaint, pre-event readiness checks, and post-event assessments.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorCredentials rdf:type rdf:Property ;
    rdfs:label 'Inspector Credentials' ;
    rdfs:comment 'Professional certifications, license numbers, or regulatory authority credentials held by the lead inspector (e.g., Certified Safety Professional (CSP), OSHA 30-hour, Certified Access Specialist (CASp), Professional Engineer (PE) license number). Validates inspector authority and competency.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorName rdf:type rdf:Property ;
    rdfs:label 'Inspector Name' ;
    rdfs:comment 'Full name of the lead inspector or auditor who conducted the inspection. May be an external regulatory official or a certified internal safety officer.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalReviewDate rdf:type rdf:Property ;
    rdfs:label 'Internal Review Date' ;
    rdfs:comment 'The date on which the internal venue safety officer or compliance manager completed their review of the inspection findings and acknowledged the corrective action plan.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:majorFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Major Findings Count' ;
    rdfs:comment 'Number of findings classified as major — significant non-conformances that require corrective action within a defined timeframe but do not pose immediate life-safety risk. Distinct from critical findings.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minorFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Minor Findings Count' ;
    rdfs:comment 'Number of findings classified as minor — low-risk observations or housekeeping items that should be addressed but do not materially impact safety or compliance status.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:structuralIntegrityChecked rdf:type rdf:Property ;
    rdfs:label 'Structural Integrity Checked' ;
    rdfs:comment 'Indicates whether a structural engineering assessment of the venue\'s load-bearing elements, seating bowl, roof, and temporary structures (e.g., stages, rigging) was conducted as part of this inspection.' ;
    rdfs:domain ind:SafetyInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accessibilityFeatures rdf:type rdf:Property ;
    rdfs:label 'Accessibility Features' ;
    rdfs:comment 'Free-text description of specific accessibility accommodations available at or near this seat, such as hearing loop proximity, assistive listening device availability, or transfer seat specifications. Supports ADA compliance documentation and fan service.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessibleRouteAvailable rdf:type rdf:Property ;
    rdfs:label 'Accessible Route Available' ;
    rdfs:comment 'Indicates whether an ADA-compliant accessible route (ramp, elevator, or level pathway) is available to reach this seat from the venue entrance. True = accessible route available; False = not accessible by compliant route. Critical for ADA compliance and fan service.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:condition rdf:type rdf:Property ;
    rdfs:label 'Condition' ;
    rdfs:comment 'Current physical condition of the seat hardware (frame, cushion, armrests, cup holder). Used for maintenance prioritization, capital expenditure planning, and fan experience quality management.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:elevationM rdf:type rdf:Property ;
    rdfs:label 'Elevation M' ;
    rdfs:comment 'Vertical elevation of the seat above the playing field or stage floor level, measured in meters. Used for sightline quality scoring, broadcast camera planning, and premium seat valuation.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entryGate rdf:type rdf:Property ;
    rdfs:label 'Entry Gate' ;
    rdfs:comment 'The recommended or assigned entry gate or turnstile through which a fan holding a ticket for this seat should enter the venue. Used for access control routing, crowd flow management, and fan experience optimization.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gaAreaCode rdf:type rdf:Property ;
    rdfs:label 'Ga Area Code' ;
    rdfs:comment 'For General Admission (GA) or Standing Room Only (SRO) areas, the code identifying the GA zone to which this inventory record belongs. Null for reserved seating. Used to manage GA capacity and access control.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hasCupholder rdf:type rdf:Property ;
    rdfs:label 'Has Cupholder' ;
    rdfs:comment 'Indicates whether this seat is equipped with a built-in cup holder. True = cup holder present; False = no cup holder. Used for fan amenity reporting and concessions upsell targeting.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasPowerOutlet rdf:type rdf:Property ;
    rdfs:label 'Has Power Outlet' ;
    rdfs:comment 'Indicates whether this seat has an accessible power outlet or USB charging port. True = power outlet available; False = no power outlet. Relevant for premium and club-level seat differentiation and fan engagement platform connectivity.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:installDate rdf:type rdf:Property ;
    rdfs:label 'Install Date' ;
    rdfs:comment 'Date on which this seat was physically installed in the venue. Used for asset lifecycle management, warranty tracking, and capital expenditure depreciation schedules.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isAda rdf:type rdf:Property ;
    rdfs:label 'Is Ada' ;
    rdfs:comment 'Indicates whether this seat is designated as an ADA-compliant accessible space (wheelchair space or transfer seat) per Americans with Disabilities Act requirements. True = ADA-designated; False = standard seat. Critical for regulatory compliance reporting and accessible inventory management.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAisle rdf:type rdf:Property ;
    rdfs:label 'Is Aisle' ;
    rdfs:comment 'Indicates whether this seat is positioned directly adjacent to an aisle, providing easier ingress/egress. True = aisle seat; False = non-aisle seat. Used for premium seat selection, accessibility routing, and emergency egress planning.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCompanion rdf:type rdf:Property ;
    rdfs:label 'Is Companion' ;
    rdfs:comment 'Indicates whether this seat is designated as a companion seat immediately adjacent to an ADA accessible space, reserved for a companion of a wheelchair user. True = companion seat; False = not a companion seat. Required for ADA compliance inventory tracking.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isKill rdf:type rdf:Property ;
    rdfs:label 'Is Kill' ;
    rdfs:comment 'Indicates whether this seat is permanently structurally unavailable and must never be sold or activated. Kill seats arise from structural obstructions, safety requirements, or permanent equipment installations. True = kill seat; False = not a kill seat.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPremium rdf:type rdf:Property ;
    rdfs:label 'Is Premium' ;
    rdfs:comment 'Indicates whether this seat is classified as a premium inventory seat (club, loge, courtside, field-level, or VIP designation) commanding a premium price tier. True = premium; False = standard. Drives revenue management and sponsorship inventory reporting.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextInspectionDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Inspection Due Date' ;
    rdfs:comment 'Scheduled date by which the next physical inspection of this seat must be completed to maintain OSHA and venue safety compliance. Drives preventive maintenance scheduling.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:seasonTicketEligible rdf:type rdf:Property ;
    rdfs:label 'Season Ticket Eligible' ;
    rdfs:comment 'Indicates whether this seat is eligible to be included in a season ticket package. True = eligible for season ticket sales; False = not eligible (e.g., event-only inventory, kill seats, or operational holds). Drives CRM and ticketing inventory allocation.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seatCode rdf:type rdf:Property ;
    rdfs:label 'Seat Code' ;
    rdfs:comment 'Externally-known alphanumeric code that uniquely identifies the seat within its section, as printed on a ticket or displayed on a seat placard. Corresponds to the Archtics seat identifier used in Ticketmaster/AXS ticketing workflows.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatType rdf:type rdf:Property ;
    rdfs:label 'Seat Type' ;
    rdfs:comment 'Classification of the seat by its physical configuration and service tier. Drives pricing, accessibility compliance, and inventory allocation rules. Values: standard (general bowl seat), accessible (ADA wheelchair space), companion (adjacent to accessible space for a companion), premium (club/loge/VIP seat), stool (bar-height stool in standing/lounge areas), suite (private suite seat).' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequence rdf:type rdf:Property ;
    rdfs:label 'Sequence' ;
    rdfs:comment 'Numeric ordinal position of the seat within the row, used for physical layout ordering and adjacent-seat grouping logic in ticketing systems.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sightlineQuality rdf:type rdf:Property ;
    rdfs:label 'Sightline Quality' ;
    rdfs:comment 'Qualitative rating of the seat\'s sightline to the primary viewing area (field, stage, or court), derived from physical geometry and obstruction analysis. Used for pricing, fan experience design, and ticket disclosure requirements.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:xCoordinate rdf:type rdf:Property ;
    rdfs:label 'X Coordinate' ;
    rdfs:comment 'Horizontal Cartesian coordinate of the seat\'s physical position within the venue floor plan, measured in meters from a defined venue origin point. Used for venue mapping, sightline analysis, and digital twin applications.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yCoordinate rdf:type rdf:Property ;
    rdfs:label 'Y Coordinate' ;
    rdfs:comment 'Vertical Cartesian coordinate of the seat\'s physical position within the venue floor plan, measured in meters from a defined venue origin point. Used for venue mapping, sightline analysis, and spatial analytics.' ;
    rdfs:domain ind:Seat ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adaSeatCount rdf:type rdf:Property ;
    rdfs:label 'Ada Seat Count' ;
    rdfs:comment 'Number of seats within this section that are designated as ADA-compliant accessible positions, including wheelchair spaces and companion seats. Required for ADA compliance reporting and venue accessibility audits.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:archticsSectionCode rdf:type rdf:Property ;
    rdfs:label 'Archtics Section Code' ;
    rdfs:comment 'Native section identifier as assigned within the Archtics Venue Seating and Inventory Management system. Used for system-of-record reconciliation, data lineage tracking, and integration with Ticketmaster/AXS ticketing workflows.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastCameraZone rdf:type rdf:Property ;
    rdfs:label 'Broadcast Camera Zone' ;
    rdfs:comment 'Indicates whether this seating section falls within a designated broadcast camera or production zone, which may restrict fan movement, signage, or attire during live broadcasts. Relevant for FCC broadcast compliance and OB (Outside Broadcast) production planning.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:companionSeatCount rdf:type rdf:Property ;
    rdfs:label 'Companion Seat Count' ;
    rdfs:comment 'Number of companion seats adjacent to ADA wheelchair positions within this section. Required for ADA compliance to ensure accessible patrons can be accompanied. Distinct from total ADA seat count.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emergencyExitRoute rdf:type rdf:Property ;
    rdfs:label 'Emergency Exit Route' ;
    rdfs:comment 'Designated emergency evacuation route identifier or description for this seating section, as defined in the venue\'s life safety plan. Required for OSHA compliance, fire marshal approval, and event-day safety briefings.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryGateCode rdf:type rdf:Property ;
    rdfs:label 'Entry Gate Code' ;
    rdfs:comment 'Code identifying the primary entry gate or access point assigned to this seating section for fan ingress and egress. Used in access control configuration within Ticketmaster/AXS and for event-day crowd flow management.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floorLevelNumber rdf:type rdf:Property ;
    rdfs:label 'Floor Level Number' ;
    rdfs:comment 'Numeric floor or deck level within the venue structure where this section is physically located (e.g., 1 = ground/field level, 2 = concourse level, 3 = upper deck). Used for building management, emergency egress planning, and OSHA compliance.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hearingLoopInstalled rdf:type rdf:Property ;
    rdfs:label 'Hearing Loop Installed' ;
    rdfs:comment 'Indicates whether an assistive listening hearing loop (induction loop) system is installed in this seating section to support patrons with hearing impairments. Required for ADA compliance and venue accessibility certification.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCovered rdf:type rdf:Property ;
    rdfs:label 'Is Covered' ;
    rdfs:comment 'Indicates whether the seating section is covered by a roof, overhang, or canopy structure, providing weather protection for patrons. Relevant for outdoor venues and open-air stadiums; used in fan experience communications and premium pricing decisions.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isIndoor rdf:type rdf:Property ;
    rdfs:label 'Is Indoor' ;
    rdfs:comment 'Indicates whether the seating section is located within a fully enclosed indoor environment (arena, indoor stadium). Distinct from is_covered which may apply to partially covered outdoor sections. Drives HVAC system assignment and environmental comfort planning.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:levelName rdf:type rdf:Property ;
    rdfs:label 'Level Name' ;
    rdfs:comment 'Vertical bowl level designation indicating the physical tier of the venue where this section is located (e.g., field, lower bowl, club level, upper bowl, mezzanine, roof deck). Used for pricing, sightline analysis, and fan wayfinding.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxEventCapacity rdf:type rdf:Property ;
    rdfs:label 'Max Event Capacity' ;
    rdfs:comment 'Maximum permitted occupancy for this section under applicable fire code, local authority, and OSHA safety regulations. May differ from total_capacity due to regulatory constraints, temporary staging, or reduced-capacity configurations for specific event types.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:obstructedView rdf:type rdf:Property ;
    rdfs:label 'Obstructed View' ;
    rdfs:comment 'Indicates whether any seats in this section have a partially or fully obstructed sightline due to structural columns, equipment, or other physical barriers. Required for consumer disclosure compliance and ticket pricing adjustments.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumAmenityFlag rdf:type rdf:Property ;
    rdfs:label 'Premium Amenity Flag' ;
    rdfs:comment 'Indicates whether this section includes premium amenities such as in-seat food and beverage service, dedicated wait staff, private restrooms, or exclusive lounge access. Used for premium product packaging, sponsorship activation, and VIP fan experience design.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rowLabelEnd rdf:type rdf:Property ;
    rdfs:label 'Row Label End' ;
    rdfs:comment 'Label of the last row in this seating section as printed on tickets and venue maps (e.g., \'Z\', \'30\', \'ZZ\'). Used alongside row_label_start to define the full row range for seat map configuration.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rowLabelStart rdf:type rdf:Property ;
    rdfs:label 'Row Label Start' ;
    rdfs:comment 'Label of the first row in this seating section as printed on tickets and venue maps (e.g., \'A\', \'1\', \'AA\'). Used for seat map rendering and fan wayfinding in Archtics and Ticketmaster/AXS.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatsPerRow rdf:type rdf:Property ;
    rdfs:label 'Seats Per Row' ;
    rdfs:comment 'Standard number of seats in each row of the section. May vary by row; this field captures the modal or configured default value used for capacity calculations. Null for variable-row or GA sections.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sectionName rdf:type rdf:Property ;
    rdfs:label 'Section Name' ;
    rdfs:comment 'Human-readable display name of the seating section as presented to fans on tickets, venue maps, and digital platforms (e.g., \'Lower Bowl Section 101\', \'Club Level East\', \'North End Zone\').' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectionNotes rdf:type rdf:Property ;
    rdfs:label 'Section Notes' ;
    rdfs:comment 'Free-text operational notes or remarks about this seating section, such as temporary restrictions, special configurations, or event-specific instructions. Used by venue operations staff for event-day logistics and facility management.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectionOrientation rdf:type rdf:Property ;
    rdfs:label 'Section Orientation' ;
    rdfs:comment 'Cardinal or relative directional orientation of the seating section within the venue bowl (e.g., north end zone, south sideline, east corner). Used for wayfinding, broadcast camera positioning, and sun/shadow exposure analysis for outdoor venues. [ENUM-REF-CANDIDATE: north|south|east|west|northeast|northwest|southeast|southwest|center — promote to reference product]' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectionStatus rdf:type rdf:Property ;
    rdfs:label 'Section Status' ;
    rdfs:comment 'Current operational lifecycle status of the seating section. Active: available for ticketing and event assignment; Inactive: temporarily unavailable; Under Renovation: physically inaccessible due to construction; Decommissioned: permanently removed from inventory; Seasonal: available only during specific seasons or event types.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectionType rdf:type rdf:Property ;
    rdfs:label 'Section Type' ;
    rdfs:comment 'Operational classification of the seating section by access and seating arrangement. Reserved: assigned seats; General Admission (GA): open floor/standing; Standing Room Only (SRO): no fixed seats; Suite: premium enclosed box; Accessible: ADA-compliant designated area; Press: media/broadcast credential holders; VIP: premium hospitality. [ENUM-REF-CANDIDATE: reserved|general_admission|sro|suite|accessible|press|vip — promote to reference product]' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sightlineRating rdf:type rdf:Property ;
    rdfs:label 'Sightline Rating' ;
    rdfs:comment 'Numeric quality score (e.g., 1.0–10.0) representing the quality of the view from this section to the primary event surface (field, stage, court, ice). Derived from venue geometry and used in pricing strategy, fan experience scoring, and premium product differentiation.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:smokingPermitted rdf:type rdf:Property ;
    rdfs:label 'Smoking Permitted' ;
    rdfs:comment 'Indicates whether smoking or vaping is permitted within this seating section. Governed by local ordinances, venue policy, and OSHA indoor air quality standards. Used for fan communications and compliance documentation.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wifiZoneCode rdf:type rdf:Property ;
    rdfs:label 'Wifi Zone Code' ;
    rdfs:comment 'Identifier of the wireless network access zone covering this seating section. Used for digital platform connectivity planning, fan engagement app performance monitoring, and Adobe Experience Platform audience activation.' ;
    rdfs:domain ind:SeatingSection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amenityNotes rdf:type rdf:Property ;
    rdfs:label 'Amenity Notes' ;
    rdfs:comment 'Free-text description of additional suite amenities not captured by structured flags (e.g., dedicated concierge service, custom furniture, branded décor, HVAC zoning). Supports sales and marketing use cases.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualLicenseFee rdf:type rdf:Property ;
    rdfs:label 'Annual License Fee' ;
    rdfs:comment 'Annualized value of the suite license fee, normalized for multi-year agreements. Used for year-over-year revenue comparison, ARR (Annual Recurring Revenue) reporting, and per-suite P&L benchmarking.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cateringCreditAmount rdf:type rdf:Property ;
    rdfs:label 'Catering Credit Amount' ;
    rdfs:comment 'Dollar value of complimentary catering credit included in the suite license agreement per season or per event, as applicable. Used for food and beverage revenue netting and per-suite P&L analysis.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Contract Execution Date' ;
    rdfs:comment 'Date on which the suite license agreement was formally signed and executed by both parties. Distinct from the license start date; used for audit trails and SOX financial controls.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hasAvSystem rdf:type rdf:Property ;
    rdfs:label 'Has Av System' ;
    rdfs:comment 'Indicates whether the suite is equipped with an integrated Audio-Visual (AV) system including displays, broadcast feeds, and sound. Relevant for broadcast operations and premium experience delivery.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasCateringKitchen rdf:type rdf:Property ;
    rdfs:label 'Has Catering Kitchen' ;
    rdfs:comment 'Indicates whether the suite includes a dedicated catering kitchen or prep area. Relevant for premium hospitality operations, food service licensing, and OSHA food safety compliance.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasPrivateBar rdf:type rdf:Property ;
    rdfs:label 'Has Private Bar' ;
    rdfs:comment 'Indicates whether the suite includes a private bar facility. Drives premium hospitality pricing, catering credit allocation, and suite marketing collateral.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasPrivateRestroom rdf:type rdf:Property ;
    rdfs:label 'Has Private Restroom' ;
    rdfs:comment 'Indicates whether the suite includes a private restroom facility. Impacts ADA compliance assessment, premium tier classification, and license fee valuation.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasRenewalOption rdf:type rdf:Property ;
    rdfs:label 'Has Renewal Option' ;
    rdfs:comment 'Indicates whether the suite license agreement includes a contractual renewal option for the licensee. Drives renewal pipeline prioritization and proactive outreach in Salesforce CRM.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:includedEventCount rdf:type rdf:Property ;
    rdfs:label 'Included Event Count' ;
    rdfs:comment 'Total number of events included in the suite license agreement for the term. Used for per-event cost allocation, utilization tracking, and per-suite P&L analysis.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:includedEventTypes rdf:type rdf:Property ;
    rdfs:label 'Included Event Types' ;
    rdfs:comment 'Comma-separated list or description of event categories covered under the suite license (e.g., \'NFL Regular Season, NFL Playoffs, Concerts\'). Defines the scope of access entitlements within the agreement.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRenovationDate rdf:type rdf:Property ;
    rdfs:label 'Last Renovation Date' ;
    rdfs:comment 'Date of the most recent physical renovation or refurbishment of the suite. Used for facility lifecycle management, capital expenditure planning, and premium hospitality quality assurance.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseEndDate rdf:type rdf:Property ;
    rdfs:label 'License End Date' ;
    rdfs:comment 'Date on which the suite license agreement expires or terminates. Nullable for open-ended agreements. Drives renewal pipeline alerts and contract expiry reporting in Salesforce CRM.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseStartDate rdf:type rdf:Property ;
    rdfs:label 'License Start Date' ;
    rdfs:comment 'Date on which the suite license agreement becomes effective and binding. Used for revenue recognition scheduling, access control activation, and contract lifecycle management.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseTermType rdf:type rdf:Property ;
    rdfs:label 'License Term Type' ;
    rdfs:comment 'Classification of the suite license by duration structure: annual (one-year term), multi-year (multi-season commitment), or per-event (single event basis). Determines revenue recognition method and renewal cycle.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseeName rdf:type rdf:Property ;
    rdfs:label 'Licensee Name' ;
    rdfs:comment 'Legal name of the entity or individual holding the suite license. For corporate licensees this is the company name; for individual licensees this is the person\'s full legal name. Sensitive commercial data subject to confidentiality obligations.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseeType rdf:type rdf:Property ;
    rdfs:label 'Licensee Type' ;
    rdfs:comment 'Classification of the suite licensee by entity type. Drives contract terms, tax treatment, and CRM segmentation in Salesforce. [ENUM-REF-CANDIDATE: corporate|individual|non_profit|government|media — promote to reference product if additional types are added]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentSchedule rdf:type rdf:Property ;
    rdfs:label 'Payment Schedule' ;
    rdfs:comment 'Frequency and structure of license fee payment installments as defined in the suite agreement. Drives accounts receivable scheduling in SAP S/4HANA FI and cash flow forecasting in Workday Adaptive Planning.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standingPositions rdf:type rdf:Property ;
    rdfs:label 'Standing Positions' ;
    rdfs:comment 'Number of Standing Room Only (SRO) positions within the suite beyond fixed seating. Contributes to total capacity and is used for event-day access control and OSHA compliance.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:suiteLevel rdf:type rdf:Property ;
    rdfs:label 'Suite Level' ;
    rdfs:comment 'Physical level or tier within the venue where the suite is located (e.g., \'Club Level\', \'Loge Level\', \'Upper Concourse\'). Used for venue mapping, wayfinding, and premium hospitality segmentation.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suiteName rdf:type rdf:Property ;
    rdfs:label 'Suite Name' ;
    rdfs:comment 'Human-readable marketing or branded name of the suite (e.g., \'Champions Club Suite\', \'Founders Loge Box\'). Used in CRM, sales collateral, and fan-facing communications.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suiteNumber rdf:type rdf:Property ;
    rdfs:label 'Suite Number' ;
    rdfs:comment 'Alphanumeric identifier assigned to the suite within the venue, used for wayfinding, ticketing systems, and operational staff coordination (e.g., \'S-101\', \'PL-22\'). Corresponds to the physical suite designation in Archtics seating inventory.' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suiteType rdf:type rdf:Property ;
    rdfs:label 'Suite Type' ;
    rdfs:comment 'Classification of the premium hospitality unit by physical and commercial configuration. Drives pricing tiers, amenity packages, and license fee structures. [ENUM-REF-CANDIDATE: private_suite|club_box|loge_box|party_suite|press_box|founders_suite — promote to reference product if additional types are added]' ;
    rdfs:domain ind:Suite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalLicenseFee rdf:type rdf:Property ;
    rdfs:label 'Total License Fee' ;
    rdfs:comment 'Total contractual license fee for the full term of the suite agreement in the venue\'s operating currency. Used for revenue recognition scheduling, P&L analysis, and EBITDA reporting. Sensitive commercial financial data.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:suiteLicenseId rdf:type rdf:Property ;
    rdfs:label 'Suite License Id' ;
    rdfs:comment 'Unique system-generated identifier for the suite license record. Primary key for the suite_license data product within the venue domain.' ;
    rdfs:domain ind:SuiteLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:licenseeAccountId rdf:type rdf:Property ;
    rdfs:label 'Licensee Account Id' ;
    rdfs:comment 'Reference to the corporate or individual client account (licensee) holding this suite license, as managed in the CRM system.' ;
    rdfs:domain ind:SuiteLicense ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:foodBeveragePackageType rdf:type rdf:Property ;
    rdfs:label 'Food Beverage Package Type' ;
    rdfs:comment 'The tier of food and beverage service package included in the suite license agreement. Drives catering operations planning and cost allocation for venue concessions.' ;
    rdfs:domain ind:SuiteLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseeContactEmail rdf:type rdf:Property ;
    rdfs:label 'Licensee Contact Email' ;
    rdfs:comment 'Primary email address of the licensee contact person used for contract communications, event notifications, and billing correspondence.' ;
    rdfs:domain ind:SuiteLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseeContactName rdf:type rdf:Property ;
    rdfs:label 'Licensee Contact Name' ;
    rdfs:comment 'Full name of the primary individual contact person at the licensee organization responsible for managing the suite license relationship.' ;
    rdfs:domain ind:SuiteLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseeContactPhone rdf:type rdf:Property ;
    rdfs:label 'Licensee Contact Phone' ;
    rdfs:comment 'Primary phone number of the licensee contact person for direct communication regarding suite operations, event logistics, and account management.' ;
    rdfs:domain ind:SuiteLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parkingPassesCount rdf:type rdf:Property ;
    rdfs:label 'Parking Passes Count' ;
    rdfs:comment 'The number of complimentary parking passes included per event under the suite license agreement. Supports venue operations planning and access control.' ;
    rdfs:domain ind:SuiteLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priceEscalationRate rdf:type rdf:Property ;
    rdfs:label 'Price Escalation Rate' ;
    rdfs:comment 'The contractually agreed annual percentage rate at which the suite license fee escalates for multi-year agreements (e.g., 0.0300 = 3% per annum). Used for future revenue forecasting in Workday Adaptive Planning.' ;
    rdfs:domain ind:SuiteLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signageRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Signage Rights Flag' ;
    rdfs:comment 'Indicates whether the licensee has been granted rights to display corporate branding or signage within or on the exterior of the licensed suite.' ;
    rdfs:domain ind:SuiteLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sublicenseFlag rdf:type rdf:Property ;
    rdfs:label 'Sublicense Flag' ;
    rdfs:comment 'Indicates whether the licensee is permitted to sublicense unused event dates to other parties under the terms of the suite license agreement.' ;
    rdfs:domain ind:SuiteLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suiteNamingRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Suite Naming Rights Flag' ;
    rdfs:comment 'Indicates whether the licensee has been granted naming rights for the suite (e.g., the suite is branded with the licensee\'s corporate name on venue maps and signage).' ;
    rdfs:domain ind:SuiteLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vipCredentialCount rdf:type rdf:Property ;
    rdfs:label 'Vip Credential Count' ;
    rdfs:comment 'The number of VIP access credentials or passes included per event under the suite license, granting access to premium areas such as field-level, backstage, or club lounges.' ;
    rdfs:domain ind:SuiteLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acquisitionDigitalTouchpointId rdf:type rdf:Property ;
    rdfs:label 'Acquisition Digital Touchpoint Id' ;
    rdfs:comment 'Foreign key linking to platform.digital_touchpoint. Business justification: Venue rentals booked through digital channels (online booking portals, venue websites) require acquisition channel attribution for digital sales reporting and marketing ROI analysis. Role-prefixed \'ac' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DigitalTouchpoint .

ind:salesOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Sales Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Venue rental agreements are owned by specific sales employees for commission calculation, performance reporting, and client relationship management. Sports venue sales operations require linking renta' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:adaAccommodationRequired rdf:type rdf:Property ;
    rdfs:label 'Ada Accommodation Required' ;
    rdfs:comment 'Indicates whether the renter has requested specific ADA-compliant accommodations beyond standard venue accessibility features (e.g., additional wheelchair spaces, assistive listening devices, accessible staging). Triggers ADA compliance review.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:avServiceFee rdf:type rdf:Property ;
    rdfs:label 'Av Service Fee' ;
    rdfs:comment 'Ancillary charge for audio-visual equipment, production support, and technical services provided by the venue to the renter. Includes sound systems, lighting rigs, screens, and AV technician labor.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseRentalFee rdf:type rdf:Property ;
    rdfs:label 'Base Rental Fee' ;
    rdfs:comment 'Core facility rental charge for the agreed space and time period, exclusive of ancillary services. Represents the primary revenue line for venue rental operations. Denominated in the contract currency.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cancellationPolicyCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Policy Code' ;
    rdfs:comment 'Code referencing the applicable cancellation and refund policy tier governing this rental agreement. Determines penalty schedules and deposit forfeiture rules if the renter cancels.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cateringServiceFee rdf:type rdf:Property ;
    rdfs:label 'Catering Service Fee' ;
    rdfs:comment 'Ancillary charge for food and beverage catering services provided by the venue or its contracted catering partner. Covers event catering packages, concession staffing, and bar services.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cleaningServiceFee rdf:type rdf:Property ;
    rdfs:label 'Cleaning Service Fee' ;
    rdfs:comment 'Ancillary charge for pre-event preparation cleaning and post-event cleanup services. Covers janitorial labor, waste removal, and facility restoration to operational readiness.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractSignedDate rdf:type rdf:Property ;
    rdfs:label 'Contract Signed Date' ;
    rdfs:comment 'Date on which the venue rental agreement was formally executed (signed by both parties). Marks the binding commencement of contractual obligations and triggers downstream workflows in SAP S/4HANA.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endDatetime rdf:type rdf:Property ;
    rdfs:label 'End Datetime' ;
    rdfs:comment 'Date and time at which the renter\'s access to the venue concludes, including teardown and load-out periods. Used for scheduling subsequent events, utility deactivation, and overtime fee calculation.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:exclusiveCateringRequired rdf:type rdf:Property ;
    rdfs:label 'Exclusive Catering Required' ;
    rdfs:comment 'Indicates whether the renter is contractually required to use the venue\'s exclusive catering provider rather than bringing external caterers. Impacts catering revenue and vendor management.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Insurance Certificate Number' ;
    rdfs:comment 'Reference number of the renter\'s liability insurance certificate submitted as a contractual requirement. Venues require renters to carry minimum liability coverage; this field tracks compliance with that requirement.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otherAncillaryFees rdf:type rdf:Property ;
    rdfs:label 'Other Ancillary Fees' ;
    rdfs:comment 'Aggregate of all additional ancillary service charges not captured in dedicated fee fields (e.g., parking management, Wi-Fi, power/utilities, staging, décor, ticketing services). Itemized in the contract but summarized here.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rentalStatus rdf:type rdf:Property ;
    rdfs:label 'Rental Status' ;
    rdfs:comment 'Current lifecycle state of the venue rental agreement. Tracks progression from initial inquiry through confirmation, active event execution, completion, or cancellation.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renterContactEmail rdf:type rdf:Property ;
    rdfs:label 'Renter Contact Email' ;
    rdfs:comment 'Email address of the primary contact person for the renting organization. Used for contract delivery, event coordination, and operational communications.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renterContactName rdf:type rdf:Property ;
    rdfs:label 'Renter Contact Name' ;
    rdfs:comment 'Full name of the primary point-of-contact individual representing the renting organization. Used for operational coordination, event-day logistics, and communication.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renterContactPhone rdf:type rdf:Property ;
    rdfs:label 'Renter Contact Phone' ;
    rdfs:comment 'Primary telephone number for the renter\'s designated contact person. Used for event-day coordination and urgent operational communications.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renterName rdf:type rdf:Property ;
    rdfs:label 'Renter Name' ;
    rdfs:comment 'Legal name of the third-party individual, company, or organization renting the venue. Used for contract execution, invoicing, and compliance documentation. May be a promoter, corporation, private individual, or government entity.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renterType rdf:type rdf:Property ;
    rdfs:label 'Renter Type' ;
    rdfs:comment 'Classification of the renting party by organizational category. Drives applicable pricing tiers, contractual terms, insurance requirements, and regulatory obligations. [ENUM-REF-CANDIDATE: promoter|corporate|private|government|non_profit|educational — promote to reference product]' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityServiceFee rdf:type rdf:Property ;
    rdfs:label 'Security Service Fee' ;
    rdfs:comment 'Ancillary charge for venue security personnel, access control, crowd management, and event security services provided to the renter. Driven by expected attendance and event risk profile.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:spaceConfiguration rdf:type rdf:Property ;
    rdfs:label 'Space Configuration' ;
    rdfs:comment 'Describes the scope of venue space included in the rental agreement. Determines which areas, zones, and facilities are allocated to the renter and which remain restricted or available for other uses.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spacesRentedDescription rdf:type rdf:Property ;
    rdfs:label 'Spaces Rented Description' ;
    rdfs:comment 'Narrative description of the specific venue areas, zones, sections, or rooms included in the rental (e.g., \'Main floor, sections A-D, VIP suites 1-10, loading dock B\'). Supplements the space_configuration classification with granular detail.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startDatetime rdf:type rdf:Property ;
    rdfs:label 'Start Datetime' ;
    rdfs:comment 'Date and time at which the renter\'s access to the venue begins, including setup and load-in periods. Governs staffing schedules, utility activation, and access control. Stored in ISO 8601 format with timezone offset.' ;
    rdfs:domain ind:Rental ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:staffingAgencyVendorId rdf:type rdf:Property ;
    rdfs:label 'Staffing Agency Vendor Id' ;
    rdfs:comment 'Reference to the external staffing agency contracted to fulfill labor demand for this plan. Null if staffing is fulfilled by in-house workforce.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:actualHeadcount rdf:type rdf:Property ;
    rdfs:label 'Actual Headcount' ;
    rdfs:comment 'Actual number of staff who reported and worked for this role category on event day. Captured post-event for variance analysis against required and confirmed headcount.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agencyPurchaseOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Agency Purchase Order Number' ;
    rdfs:comment 'SAP purchase order number issued to the staffing agency for this role category. Required for accounts payable processing and agency invoice matching.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:briefingLocation rdf:type rdf:Property ;
    rdfs:label 'Briefing Location' ;
    rdfs:comment 'Physical location within or near the venue where staff in this role category are required to report for pre-event briefing and credential check-in.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmedHeadcount rdf:type rdf:Property ;
    rdfs:label 'Confirmed Headcount' ;
    rdfs:comment 'Number of staff positions confirmed and scheduled for this role category as of the latest plan update. Compared against required_headcount to identify fulfillment gaps.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contingencyHeadcount rdf:type rdf:Property ;
    rdfs:label 'Contingency Headcount' ;
    rdfs:comment 'Number of additional staff positions held in reserve for this role category to cover no-shows, emergencies, or unexpected demand surges on event day.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:credentialRequirements rdf:type rdf:Property ;
    rdfs:label 'Credential Requirements' ;
    rdfs:comment 'Description of required certifications, licenses, or credentials that staff in this role category must hold (e.g., CPR certification, security guard license, food handler permit, AV technician certification).' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deploymentZone rdf:type rdf:Property ;
    rdfs:label 'Deployment Zone' ;
    rdfs:comment 'Venue zone or area where staff in this role category are assigned to operate (e.g., Gate A, Concourse Level 2, Parking Lot C, Field Level). Supports event-day logistics coordination.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentType rdf:type rdf:Property ;
    rdfs:label 'Employment Type' ;
    rdfs:comment 'Classification of the employment arrangement for staff in this role category. Determines payroll processing, CBA applicability, and agency billing procedures.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfillmentSource rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Source' ;
    rdfs:comment 'Indicates whether the staffing demand for this role category is fulfilled by in-house employees, an external staffing agency, a combination of both, or volunteers.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAdaRole rdf:type rdf:Property ;
    rdfs:label 'Is Ada Role' ;
    rdfs:comment 'Indicates whether this role category is specifically designated to support ADA accessibility services for guests with disabilities (e.g., wheelchair escorts, hearing loop operators).' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOshaSafetyCritical rdf:type rdf:Property ;
    rdfs:label 'Is Osha Safety Critical' ;
    rdfs:comment 'Indicates whether this role category is classified as safety-critical under OSHA standards, requiring mandatory minimum staffing levels and specific credential verification before event approval.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payRateUsd rdf:type rdf:Property ;
    rdfs:label 'Pay Rate Usd' ;
    rdfs:comment 'Planned hourly pay rate in US dollars for staff in this role category. Used for cost estimation and budget reconciliation. Classified as confidential business data.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Plan Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference number assigned to this staffing plan for cross-system tracking and vendor communication (e.g., VSP-2025-0042).' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredHeadcount rdf:type rdf:Property ;
    rdfs:label 'Required Headcount' ;
    rdfs:comment 'Total number of staff positions required for this role category to safely and operationally execute the event. Represents the labor demand target.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:roleCategory rdf:type rdf:Property ;
    rdfs:label 'Role Category' ;
    rdfs:comment 'Operational role category for which this staffing plan row specifies headcount requirements. Each plan record covers one role category per event. [ENUM-REF-CANDIDATE: security|medical|usher|concessions|parking|cleaning|av_production|guest_services|other — promote to reference product]' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftDurationHours rdf:type rdf:Property ;
    rdfs:label 'Shift Duration Hours' ;
    rdfs:comment 'Total planned shift duration in hours for this role category, derived from shift start and end timestamps. Used for cost estimation and CBA compliance checks.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shiftEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Shift End Timestamp' ;
    rdfs:comment 'Planned date and time when staff in this role category are scheduled to end their shift, including post-event teardown and debrief time.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:shiftStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Shift Start Timestamp' ;
    rdfs:comment 'Planned date and time when staff in this role category are scheduled to begin their shift, including pre-event setup and briefing time.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:supervisorName rdf:type rdf:Property ;
    rdfs:label 'Supervisor Name' ;
    rdfs:comment 'Name of the designated supervisor or team lead responsible for managing staff in this role category on event day. Business reference field, not direct PII in operational context.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uniformCode rdf:type rdf:Property ;
    rdfs:label 'Uniform Code' ;
    rdfs:comment 'Code identifying the required uniform or dress code for staff in this role category. Used for procurement planning and event-day identification of staff.' ;
    rdfs:domain ind:StaffPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Benefit Enrollment Id' ;
    rdfs:comment 'Unique surrogate identifier for each benefit enrollment record in the Sports Entertainment workforce benefits system. Primary key for this entity.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benefitPlanId rdf:type rdf:Property ;
    rdfs:label 'Benefit Plan Id' ;
    rdfs:comment 'Reference to the specific benefit plan offered by Sports Entertainment (e.g., Blue Shield PPO, Delta Dental, Fidelity 401k). Links to the benefit plan catalog.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BenefitPlan .

ind:employmentContractId rdf:type rdf:Property ;
    rdfs:label 'Employment Contract Id' ;
    rdfs:comment 'Foreign key linking to workforce.employment_contract. Business justification: Benefit eligibility and plan selection are governed by employment contract terms — specifically contract_type, fte_ratio, cba_covered, and employment_category. Linking benefit_enrollment.employment_co' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmploymentContract .

ind:openEnrollmentPeriodId rdf:type rdf:Property ;
    rdfs:label 'Open Enrollment Period Id' ;
    rdfs:comment 'Reference to the annual or qualifying open enrollment window during which this election was made. Supports benefits cost reporting by enrollment cycle.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OpenEnrollmentPeriod .

ind:acaOfferOfCoverageCode rdf:type rdf:Property ;
    rdfs:label 'Aca Offer Of Coverage Code' ;
    rdfs:comment 'IRS-defined code indicating the type of minimum essential coverage (MEC) offered to the employee and their dependents for ACA Form 1095-C Line 14 reporting. Values correspond to IRS ACA offer codes (1A through 1F).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualElectionAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Election Amount' ;
    rdfs:comment 'Total annual dollar amount elected by the employee for the benefit plan. Primarily applicable to FSA, HSA, and 401k contribution elections. Expressed in USD.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beneficiaryDesignationOnFile rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Designation On File' ;
    rdfs:comment 'Indicates whether the employee has a valid beneficiary designation on file for this benefit plan (life insurance, 401k, disability). Absence of a beneficiary designation triggers HR follow-up workflow. True = designation on file; False = missing.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carrierMemberNumber rdf:type rdf:Property ;
    rdfs:label 'Carrier Member Number' ;
    rdfs:comment 'Unique member identification number assigned by the insurance carrier or benefit provider to the enrolled employee. Used for claims processing, eligibility verification, and carrier file transmissions.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbaPlanIndicator rdf:type rdf:Property ;
    rdfs:label 'Cba Plan Indicator' ;
    rdfs:comment 'Indicates whether this benefit enrollment is governed by a Collective Bargaining Agreement (CBA) rather than the standard Sports Entertainment benefits program. CBA-governed plans may have different contribution rates, eligibility rules, and carrier arrangements.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraEligible rdf:type rdf:Property ;
    rdfs:label 'Cobra Eligible' ;
    rdfs:comment 'Indicates whether the employee is eligible for COBRA (Consolidated Omnibus Budget Reconciliation Act) continuation coverage upon termination of this enrollment. Triggers COBRA notification workflow within the required 14-day window.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Cobra Notification Date' ;
    rdfs:comment 'Date on which the COBRA election notice was sent to the employee following a qualifying event. Required for DOL compliance; Sports Entertainment must notify within 14 days of the plan administrator being notified of the qualifying event.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageEndDate rdf:type rdf:Property ;
    rdfs:label 'Coverage End Date' ;
    rdfs:comment 'Actual date on which insurance or benefit coverage ends for the employee and enrolled dependents. Used for COBRA notification triggering and ACA compliance gap analysis.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageStartDate rdf:type rdf:Property ;
    rdfs:label 'Coverage Start Date' ;
    rdfs:comment 'Actual date on which insurance or benefit coverage begins for the employee and any enrolled dependents. May differ from effective_date in cases of retroactive enrollment or carrier processing delays.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageTier rdf:type rdf:Property ;
    rdfs:label 'Coverage Tier' ;
    rdfs:comment 'Level of coverage elected by the employee, determining which dependents are covered under the plan. Options include employee only, employee plus spouse, employee plus children, or full family coverage.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentCount rdf:type rdf:Property ;
    rdfs:label 'Dependent Count' ;
    rdfs:comment 'Number of dependents (spouse, children, domestic partner) enrolled under this benefit plan. Drives coverage tier validation and premium calculation. Does not include the employee themselves.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:electionDate rdf:type rdf:Property ;
    rdfs:label 'Election Date' ;
    rdfs:comment 'Date on which the employee made or confirmed their benefit election. Distinct from the effective date; captures the actual decision event for audit and compliance purposes.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employeeContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Employee Contribution Amount' ;
    rdfs:comment 'Annual dollar amount contributed by the employee toward the benefit plan premium or election. Used in total rewards analysis and payroll deduction calculations. Expressed in USD.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employeeWorkClassification rdf:type rdf:Property ;
    rdfs:label 'Employee Work Classification' ;
    rdfs:comment 'Employment classification of the workforce member at the time of enrollment. Determines benefit eligibility rules; full-time employees receive full benefits while part-time, seasonal, and event crew may have restricted eligibility per CBA (Collective Bargaining Agreement) terms.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Employer Contribution Amount' ;
    rdfs:comment 'Annual dollar amount contributed by Sports Entertainment toward the employee\'s benefit plan. Supports benefits cost reporting, EBITDA analysis, and total compensation benchmarking. Expressed in USD.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerMatchRate rdf:type rdf:Property ;
    rdfs:label 'Employer Match Rate' ;
    rdfs:comment 'Sports Entertainment\'s employer matching contribution rate for retirement plan enrollments, expressed as a decimal percentage of the employee\'s contribution (e.g., 0.5000 = 50% match up to the match cap). Applicable only to 401k plan type enrollments.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enrollmentSource rdf:type rdf:Property ;
    rdfs:label 'Enrollment Source' ;
    rdfs:comment 'Reason or trigger that initiated this benefit enrollment. Distinguishes between annual open enrollment, new hire enrollment, qualifying life event (QLE) changes, rehire reinstatement, or administrative corrections.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceOfInsurabilityRequired rdf:type rdf:Property ;
    rdfs:label 'Evidence Of Insurability Required' ;
    rdfs:comment 'Indicates whether the employee is required to submit Evidence of Insurability (EOI) / medical underwriting for this enrollment (e.g., supplemental life insurance above guaranteed issue amount). True = EOI required; False = not required.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evidenceOfInsurabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Evidence Of Insurability Status' ;
    rdfs:comment 'Current status of the Evidence of Insurability (EOI) submission and carrier review process. Applicable only when evidence_of_insurability_required is True. Pending coverage may be limited until EOI is approved.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fsaRolloverAmount rdf:type rdf:Property ;
    rdfs:label 'Fsa Rollover Amount' ;
    rdfs:comment 'Dollar amount of unused FSA funds rolled over from the prior plan year under IRS rollover provisions. Applicable only to FSA plan type enrollments. Expressed in USD.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:groupNumber rdf:type rdf:Property ;
    rdfs:label 'Group Number' ;
    rdfs:comment 'Insurance group number assigned by the carrier to Sports Entertainment\'s benefit plan. Used on insurance cards and for carrier eligibility file transmissions (HIPAA 834).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hsaContributionLimit rdf:type rdf:Property ;
    rdfs:label 'Hsa Contribution Limit' ;
    rdfs:comment 'IRS-mandated annual contribution limit applicable to this employee\'s HSA enrollment based on coverage tier (self-only vs. family) and age (catch-up contributions for age 55+). Stored for compliance validation against annual_election_amount. Expressed in USD.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAcaEligible rdf:type rdf:Property ;
    rdfs:label 'Is Aca Eligible' ;
    rdfs:comment 'Indicates whether the employee meets the ACA employer mandate eligibility threshold (typically 30+ hours per week for 120+ days). Drives IRS Form 1095-C reporting obligations for Sports Entertainment as an Applicable Large Employer (ALE).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTobaccoUser rdf:type rdf:Property ;
    rdfs:label 'Is Tobacco User' ;
    rdfs:comment 'Indicates whether the employee self-reported as a tobacco user during enrollment. Affects premium surcharge calculations for medical plans under ACA wellness program rules. True = tobacco user; False = non-tobacco user.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:perPayPeriodDeduction rdf:type rdf:Property ;
    rdfs:label 'Per Pay Period Deduction' ;
    rdfs:comment 'Employee\'s benefit premium deduction amount per payroll cycle. Derived from the annual employee contribution divided by the number of pay periods; stored here as the operational payroll deduction value. Expressed in USD.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planYear rdf:type rdf:Property ;
    rdfs:label 'Plan Year' ;
    rdfs:comment 'Calendar or fiscal year for which this benefit enrollment is in effect (e.g., 2024). Used for annual benefits cost reporting, ACA employer mandate compliance, and year-over-year total rewards analysis.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qualifyingLifeEventDate rdf:type rdf:Property ;
    rdfs:label 'Qualifying Life Event Date' ;
    rdfs:comment 'Date on which the qualifying life event occurred that triggered the mid-year enrollment change. Required for IRS compliance validation of the 30/60-day election window.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qualifyingLifeEventType rdf:type rdf:Property ;
    rdfs:label 'Qualifying Life Event Type' ;
    rdfs:comment 'Type of qualifying life event (QLE) that triggered a mid-year enrollment change outside of open enrollment. Applicable only when enrollment_source is qualifying_life_event. [ENUM-REF-CANDIDATE: marriage|divorce|birth|adoption|death|loss_of_coverage|relocation|other — promote to reference product]' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementContributionRate rdf:type rdf:Property ;
    rdfs:label 'Retirement Contribution Rate' ;
    rdfs:comment 'Employee\'s elected contribution rate as a percentage of gross pay for 401k or other retirement savings plan enrollment. Stored as a decimal (e.g., 0.0600 = 6%). Applicable only to retirement plan type enrollments.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safeHarborCode rdf:type rdf:Property ;
    rdfs:label 'Safe Harbor Code' ;
    rdfs:comment 'IRS-defined safe harbor code for ACA Form 1095-C Line 16 reporting, indicating the reason an employer shared responsibility payment may not apply (e.g., employee not employed, enrolled in coverage, not full-time). Values correspond to IRS ACA safe harbor codes (2A through 2F).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wellnessProgramEnrolled rdf:type rdf:Property ;
    rdfs:label 'Wellness Program Enrolled' ;
    rdfs:comment 'Indicates whether the employee has enrolled in Sports Entertainment\'s wellness program in conjunction with this benefit plan. Wellness participation may affect premium discounts under ACA-compliant wellness incentive programs.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:engagingCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Engaging Corporate Entity Id' ;
    rdfs:comment 'Foreign key linking to legal.corporate_entity. Business justification: Contingent workers (broadcast crew, event staff) are engaged by a specific legal entity for tax form issuance (1099, IR35 determination) and entity-level contractor spend reporting. Role-prefixed \'eng' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:supplyingVendorId rdf:type rdf:Property ;
    rdfs:label 'Supplying Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: Contingent workers (broadcast crew, event staff, security) in sports-entertainment are supplied by staffing agencies registered as vendors. Linking enables vendor performance tracking for staffing age' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:agencyWorkerNumber rdf:type rdf:Property ;
    rdfs:label 'Agency Worker Number' ;
    rdfs:comment 'The identifier assigned to this worker by the supplying staffing agency. Used to reconcile agency invoices, track agency-specific compliance records, and manage agency SLA performance.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:broadcastCrewRole rdf:type rdf:Property ;
    rdfs:label 'Broadcast Crew Role' ;
    rdfs:comment 'Specific broadcast production role for contingent workers engaged in broadcast operations (e.g., \'Camera Operator\', \'Audio Engineer\', \'Graphics Operator\', \'OB Truck Technician\', \'Replay Operator\'). Null for non-broadcast workers. Aligns with Dalet Galaxy workflow assignments.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Credential Expiry Date' ;
    rdfs:comment 'The date on which the contingent worker\'s primary professional credential expires. Triggers renewal notification workflows and blocks assignment to roles requiring the credential after expiry.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Credential Verified Flag' ;
    rdfs:comment 'Indicates whether the contingent worker\'s required professional credential was verified as current and valid specifically for this fixture. Credential expiry may occur between assignments, making per-assignment verification operationally necessary for venue access compliance.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:functionalDomain rdf:type rdf:Property ;
    rdfs:label 'Functional Domain' ;
    rdfs:comment 'The primary business domain in which the contingent worker operates. Aligns with Sports Entertainment\'s data domain taxonomy and drives cost center allocation and reporting. [ENUM-REF-CANDIDATE: broadcast|event_operations|venue|athlete_support|league_officiating|content_production|security|merchandise|ticketing|fan_engagement — promote to reference product]' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalRole rdf:type rdf:Property ;
    rdfs:label 'Functional Role' ;
    rdfs:comment 'The primary operational role the contingent worker performs for Sports Entertainment (e.g., \'Camera Operator\', \'Event Security\', \'Stage Crew\', \'Broadcast Producer\', \'Referee\', \'Ticket Scanner\'). Used for scheduling, credentialing, and labor cost allocation.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isUnionMember rdf:type rdf:Property ;
    rdfs:label 'Is Union Member' ;
    rdfs:comment 'Indicates whether the contingent worker is a member of a labor union covered by a Collective Bargaining Agreement (CBA) applicable to Sports Entertainment. Drives CBA rule enforcement in scheduling and payroll.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nationalIdHash rdf:type rdf:Property ;
    rdfs:label 'National Id Hash' ;
    rdfs:comment 'One-way cryptographic hash of the contingent worker\'s national identification number (e.g., SSN, SIN, NIN). Stored as a hash to enable deduplication and tax reporting linkage without exposing the raw identifier. Required for IRS 1099-NEC filing.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onboardingCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Onboarding Completion Date' ;
    rdfs:comment 'The date on which the contingent worker completed all required onboarding steps including identity verification, background check, safety training, and credential validation. Marks the worker as fully eligible for assignment.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:oshaSafetyTrained rdf:type rdf:Property ;
    rdfs:label 'Osha Safety Trained' ;
    rdfs:comment 'Indicates whether the contingent worker has completed the mandatory OSHA safety training required for their assigned functional role and venue environment. Blocks event-day assignment if false for safety-sensitive roles.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oshaTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Osha Training Date' ;
    rdfs:comment 'The date on which the contingent worker most recently completed OSHA safety training. Used to track training currency and trigger renewal workflows per OSHA recertification schedules.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Pay Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the contingent worker\'s pay rate (e.g., USD, GBP, EUR). Required for multi-currency payroll processing and financial reporting.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payRate rdf:type rdf:Property ;
    rdfs:label 'Pay Rate' ;
    rdfs:comment 'The agreed compensation rate for this contingent worker. Interpretation depends on pay_rate_type (hourly, daily, flat fee). Used for labor cost forecasting, invoice validation, and CBA compliance checks.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payRateType rdf:type rdf:Property ;
    rdfs:label 'Pay Rate Type' ;
    rdfs:comment 'The basis on which the contingent worker\'s pay rate is calculated. Determines how labor costs are accrued and how timesheet hours translate to payable amounts.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rehireEligible rdf:type rdf:Property ;
    rdfs:label 'Rehire Eligible' ;
    rdfs:comment 'Indicates whether this contingent worker is eligible to be re-engaged for future events or assignments. Set to false for workers terminated for cause, failed background checks, or flagged under do-not-rehire policies.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roleDuringEvent rdf:type rdf:Property ;
    rdfs:label 'Role During Event' ;
    rdfs:comment 'The specific functional role the contingent worker performs at this fixture. May differ from the worker\'s default functional_role on the master record — e.g., a worker whose default role is \'broadcast_crew\' may be assigned as \'operations\' for a specific event.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:successfactorsExternalCode rdf:type rdf:Property ;
    rdfs:label 'Successfactors External Code' ;
    rdfs:comment 'The external worker identifier assigned by SAP SuccessFactors to this contingent worker record. Used to reconcile the silver-layer master record with the system of record.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxFormType rdf:type rdf:Property ;
    rdfs:label 'Tax Form Type' ;
    rdfs:comment 'The IRS or equivalent tax form type applicable to this contingent worker\'s engagement. Drives tax withholding logic, year-end reporting obligations, and vendor payment processing in SAP S/4HANA.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venueAccessLevel rdf:type rdf:Property ;
    rdfs:label 'Venue Access Level' ;
    rdfs:comment 'The maximum venue access level granted to this contingent worker based on their role, background check status, and credential verification. Controls physical access badge provisioning via Ticketmaster/AXS access control systems.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workAuthorizationType rdf:type rdf:Property ;
    rdfs:label 'Work Authorization Type' ;
    rdfs:comment 'The type of work authorization held by the contingent worker in the country of engagement. Required for I-9 compliance in the US and equivalent immigration compliance in other jurisdictions.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workCountryCode rdf:type rdf:Property ;
    rdfs:label 'Work Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the primary country where the contingent worker performs services. Determines applicable labor law, tax jurisdiction, and GDPR/CCPA data privacy obligations.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workEmail rdf:type rdf:Property ;
    rdfs:label 'Work Email' ;
    rdfs:comment 'Primary work email address used for scheduling communications, credential distribution, and broadcast crew coordination. May be a personal email for gig workers without a company domain.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workPhone rdf:type rdf:Property ;
    rdfs:label 'Work Phone' ;
    rdfs:comment 'Primary contact phone number for the contingent worker used for event-day coordination, last-minute scheduling changes, and emergency contact by venue operations.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workerStatus rdf:type rdf:Property ;
    rdfs:label 'Worker Status' ;
    rdfs:comment 'Current lifecycle status of the contingent worker record. Controls access provisioning, scheduling eligibility, and payroll processing. \'do_not_rehire\' flags workers barred from future engagements per HR or legal directive.' ;
    rdfs:domain ind:ContingentWorker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workerType rdf:type rdf:Property ;
    rdfs:label 'Worker Type' ;
    rdfs:comment 'Classification of the contingent worker\'s engagement model. Drives tax treatment (1099 vs W-2 agency), CBA applicability, and onboarding workflow. [ENUM-REF-CANDIDATE: freelance|event_day_contractor|gig_worker|temporary_staff|agency_worker|independent_contractor — promote to reference product]' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employingCorporateEntityId rdf:type rdf:Property ;
    rdfs:label 'Employing Corporate Entity Id' ;
    rdfs:comment 'Foreign key linking to legal.corporate_entity. Business justification: In multi-entity sports organizations (league holdco, team entities, broadcast subsidiaries), each employee is employed by a specific legal entity for tax withholding, statutory reporting (W-2, IR35), ' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateEntity .

ind:baseSalaryAmount rdf:type rdf:Property ;
    rdfs:label 'Base Salary Amount' ;
    rdfs:comment 'The employee\'s annual base salary or hourly rate as applicable, in the local currency of the work location. Stored as a raw compensation figure for payroll processing, budget planning, and CBA compliance verification. Classified as confidential business data.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employmentStatus rdf:type rdf:Property ;
    rdfs:label 'Employment Status' ;
    rdfs:comment 'Current lifecycle state of the employee\'s employment relationship with Sports Entertainment. Drives access provisioning, payroll activation, and workforce reporting. \'pending_start\' indicates a hired employee who has not yet commenced work.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ethnicityCode rdf:type rdf:Property ;
    rdfs:label 'Ethnicity Code' ;
    rdfs:comment 'Standardized code representing the employee\'s self-identified ethnicity, as voluntarily provided. Used exclusively for EEOC regulatory reporting and DEI workforce analytics. Classified as restricted sensitive personal data under GDPR Article 9. [ENUM-REF-CANDIDATE: promote to reference product per EEOC categories]' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flsaClassification rdf:type rdf:Property ;
    rdfs:label 'Flsa Classification' ;
    rdfs:comment 'The employee\'s classification under the U.S. Fair Labor Standards Act (FLSA), determining overtime eligibility and minimum wage applicability. \'exempt\' employees are not entitled to overtime; \'non_exempt\' employees are. Critical for payroll compliance and labor law audits.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderIdentity rdf:type rdf:Property ;
    rdfs:label 'Gender Identity' ;
    rdfs:comment 'The employee\'s self-identified gender, as voluntarily provided and stored in SAP SuccessFactors. Used for DEI (Diversity, Equity, and Inclusion) workforce analytics and regulatory EEO reporting. Classified as restricted sensitive personal data under GDPR Article 9. [ENUM-REF-CANDIDATE: male|female|non_binary|prefer_not_to_say|other — promote to reference product]' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hireDate rdf:type rdf:Property ;
    rdfs:label 'Hire Date' ;
    rdfs:comment 'The official date on which the employee commenced employment with Sports Entertainment, as recorded in SAP SuccessFactors. Used for tenure calculations, benefits vesting schedules, and CBA seniority determinations.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:jobCode rdf:type rdf:Property ;
    rdfs:label 'Job Code' ;
    rdfs:comment 'The standardized job classification code from the Sports Entertainment job catalog, as maintained in SAP SuccessFactors. Maps to a specific job family, grade, and FLSA classification. Examples include codes for event operations staff, broadcast technicians, league officials, and venue management roles.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payFrequency rdf:type rdf:Property ;
    rdfs:label 'Pay Frequency' ;
    rdfs:comment 'The frequency at which the employee is paid (e.g., weekly for event crew, bi-weekly for full-time staff). Drives payroll processing schedules in SAP SuccessFactors Payroll and determines pay period boundaries for labor cost accruals.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payGrade rdf:type rdf:Property ;
    rdfs:label 'Pay Grade' ;
    rdfs:comment 'The compensation grade band assigned to the employee\'s position within the Sports Entertainment pay structure, as defined in SAP SuccessFactors Compensation. Determines salary range eligibility, bonus targets, and benefits tier. Classified as confidential business data.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payType rdf:type rdf:Property ;
    rdfs:label 'Pay Type' ;
    rdfs:comment 'Indicates whether the employee is compensated on a salaried, hourly, per diem, or stipend basis. Determines payroll calculation method and overtime eligibility rules. Seasonal event crew and broadcast crews are typically hourly or per diem.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:successfactorsPersonCode rdf:type rdf:Property ;
    rdfs:label 'Successfactors Person Code' ;
    rdfs:comment 'The natural/business key assigned by SAP SuccessFactors Employee Central to uniquely identify the person across all employment instances. Used for system-of-record cross-referencing and HR integrations.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workLocationCode rdf:type rdf:Property ;
    rdfs:label 'Work Location Code' ;
    rdfs:comment 'The code identifying the primary physical work location assigned to the employee (e.g., a specific venue, broadcast facility, league office, or remote designation). Used for OSHA safety compliance, ADA accommodation tracking, and event crew deployment planning.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:learningEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Learning Enrollment Id' ;
    rdfs:comment 'Foreign key linking to workforce.learning_enrollment. Business justification: Employee certifications are frequently earned through completion of a learning enrollment (training course). Both tables share credential_type, training_provider, training_completion_date, and trainin' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LearningEnrollment .

ind:previousCertificationEmployeeCertificationId rdf:type rdf:Property ;
    rdfs:label 'Previous Certification Employee Certification Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the prior version of this certification record that was superseded by renewal or reissuance. Enables full renewal chain traceability for audit and compliance purposes.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmployeeCertification .

ind:trainingProviderVendorId rdf:type rdf:Property ;
    rdfs:label 'Training Provider Vendor Id' ;
    rdfs:comment 'Foreign key linking to partner.vendor. Business justification: External training providers for employee certifications (safety, broadcast operations, venue management) are registered vendors in sports-entertainment. Linking enables vendor spend tracking for train' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:accessCredentialScope rdf:type rdf:Property ;
    rdfs:label 'Access Credential Scope' ;
    rdfs:comment 'Defines the venue zones, broadcast facilities, or restricted areas that this credential authorizes the employee to access (e.g., \'Field Level\', \'Broadcast Compound\', \'Back of House\', \'VIP Areas\'). Integrates with venue access control systems.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationSubtype rdf:type rdf:Property ;
    rdfs:label 'Certification Subtype' ;
    rdfs:comment 'Granular classification within the certification type (e.g., \'OSHA 10\', \'OSHA 30\', \'Basic First Aid\', \'Advanced CPR\', \'Forklift Class I\', \'SIA Door Supervisor\'). Enables precise compliance tracking at the credential level.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCurrency rdf:type rdf:Property ;
    rdfs:label 'Cost Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the certification cost amount (e.g., \'USD\', \'GBP\', \'EUR\'). Required for multi-currency financial reporting in global sports entertainment operations.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Credential Document Ref' ;
    rdfs:comment 'Reference identifier or URL pointing to the scanned or digital copy of the certification document stored in the SAP SuccessFactors document management system or enterprise DAM. Enables auditors to retrieve source documents.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:examScore rdf:type rdf:Property ;
    rdfs:label 'Exam Score' ;
    rdfs:comment 'Numeric score achieved by the employee on the certification examination, where applicable. Expressed as a percentage or raw score per the certifying authority\'s scale. Null if no examination was required.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCbaRequired rdf:type rdf:Property ;
    rdfs:label 'Is Cba Required' ;
    rdfs:comment 'Indicates whether this certification is mandated under a Collective Bargaining Agreement (CBA) for unionized workforce members such as broadcast crews, stagehands, or arena operations staff.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOshaRequired rdf:type rdf:Property ;
    rdfs:label 'Is Osha Required' ;
    rdfs:comment 'Flags whether this certification is specifically required to satisfy Occupational Safety and Health Administration (OSHA) regulatory obligations for the employee\'s role or work environment (e.g., OSHA 10/30 for venue construction and event setup crews).' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuingCountry rdf:type rdf:Property ;
    rdfs:label 'Issuing Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction in which the certification was issued. Supports multi-jurisdiction compliance tracking for global sports entertainment operations.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingStateProvince rdf:type rdf:Property ;
    rdfs:label 'Issuing State Province' ;
    rdfs:comment 'State or province of the issuing jurisdiction where applicable (e.g., \'CA\', \'NY\', \'TX\'). Required for state-level licenses such as food handler permits and security licenses that are jurisdiction-specific.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobRoleRequirement rdf:type rdf:Property ;
    rdfs:label 'Job Role Requirement' ;
    rdfs:comment 'The specific job role, position, or workforce category for which this certification is required (e.g., \'Broadcast Engineer\', \'Event Crew\', \'Food Service Staff\', \'Security Officer\', \'Forklift Operator\'). Links certification requirements to workforce role definitions.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonComplianceReason rdf:type rdf:Property ;
    rdfs:label 'Non Compliance Reason' ;
    rdfs:comment 'Free-text description of the reason for non-compliance when compliance_flag is False (e.g., \'Certification expired\', \'Verification failed\', \'Renewal not completed by due date\'). Supports HR investigation and remediation workflows.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passingScore rdf:type rdf:Property ;
    rdfs:label 'Passing Score' ;
    rdfs:comment 'Minimum score required to pass the certification examination as defined by the certifying authority. Used to validate exam_score and determine pass/fail outcome.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trainingCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Training Completion Date' ;
    rdfs:comment 'Date on which the employee completed the training course or examination that resulted in this certification. May differ from the issue date if there is a processing lag at the certifying authority.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trainingHours rdf:type rdf:Property ;
    rdfs:label 'Training Hours' ;
    rdfs:comment 'Total number of instructional hours completed as part of the certification program (e.g., 10 hours for OSHA 10, 30 hours for OSHA 30). Used for CBA compliance reporting and workforce development tracking.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validityPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Validity Period Months' ;
    rdfs:comment 'Standard duration in months for which this certification type remains valid before renewal is required, as defined by the issuing authority (e.g., 24 months for CPR/AED, 36 months for OSHA 30). Used to auto-calculate renewal due dates.' ;
    rdfs:domain ind:EmployeeCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:workerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Worker Employee Id' ;
    rdfs:comment 'Reference to the workforce member (employee, contractor, seasonal crew, broadcast talent, or league official) to whom this contract applies. Links to the workforce identity record in SAP SuccessFactors.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:basePayRate rdf:type rdf:Property ;
    rdfs:label 'Base Pay Rate' ;
    rdfs:comment 'The contractual base compensation amount expressed in the unit defined by pay_basis (annual salary, hourly rate, daily rate, or per-event fee). Excludes bonuses, commissions, and NIL-related compensation. Stored in the contract currency. Used for pay equity analysis, CBA compliance, and labor cost forecasting.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusTargetPct rdf:type rdf:Property ;
    rdfs:label 'Bonus Target Pct' ;
    rdfs:comment 'The contractually agreed target annual bonus expressed as a percentage of base pay rate. Used in total compensation modeling, labor cost forecasting, and annual incentive plan administration. Zero if no bonus is applicable for this contract.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cbaAgreementReference rdf:type rdf:Property ;
    rdfs:label 'Cba Agreement Reference' ;
    rdfs:comment 'The identifier or name of the specific Collective Bargaining Agreement governing this contract (e.g., \'NFL-NFLPA-CBA-2020\', \'IATSE-Local-695-2023\'). Populated only when cba_covered is True. Used for CBA compliance reporting and labor relations management.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbaCovered rdf:type rdf:Property ;
    rdfs:label 'Cba Covered' ;
    rdfs:comment 'Indicates whether this employment contract is governed by a Collective Bargaining Agreement (True) or is an individual/non-union contract (False). Determines which CBA provisions, wage scales, and grievance procedures apply.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionEligible rdf:type rdf:Property ;
    rdfs:label 'Commission Eligible' ;
    rdfs:comment 'Indicates whether the employee is eligible to earn commission under this contract (True) or not (False). Applicable to sponsorship sales staff, merchandise sales roles, and ticket sales representatives. Drives commission plan enrollment in SAP SuccessFactors.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractedHoursPerWeek rdf:type rdf:Property ;
    rdfs:label 'Contracted Hours Per Week' ;
    rdfs:comment 'The number of hours per week the employee is contractually obligated to work. Used for FTE (Full-Time Equivalent) calculations, overtime threshold determination, and labor cost forecasting. Zero for zero-hours contracts.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employmentCategory rdf:type rdf:Property ;
    rdfs:label 'Employment Category' ;
    rdfs:comment 'Legal employment category determining tax treatment, benefit eligibility, and labor law protections: employee (direct hire with full employment rights), independent_contractor (self-employed, no employment rights), agency_worker (supplied by staffing agency), or intern (structured learning placement). Critical for IRS worker classification compliance and GDPR data subject rights determination.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flsaStatus rdf:type rdf:Property ;
    rdfs:label 'Flsa Status' ;
    rdfs:comment 'Indicates whether the employee is classified as exempt (not entitled to overtime pay) or non_exempt (entitled to overtime pay at 1.5x rate) under the US Fair Labor Standards Act. Critical for overtime cost management, payroll compliance, and OSHA labor standards reporting.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fteRatio rdf:type rdf:Property ;
    rdfs:label 'Fte Ratio' ;
    rdfs:comment 'The proportion of a standard full-time working week represented by this contract, expressed as a decimal (e.g., 1.000 = full-time, 0.500 = half-time). Derived from contracted hours but stored for workforce planning, headcount reporting, and labor cost allocation.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jobGrade rdf:type rdf:Property ;
    rdfs:label 'Job Grade' ;
    rdfs:comment 'The compensation grade or band level assigned to the position under this contract (e.g., \'G5\', \'M3\', \'E1\'). Determines the applicable salary range, benefit tier, and merit increase eligibility. Sourced from SAP SuccessFactors Job Classification.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meritIncreaseSchedule rdf:type rdf:Property ;
    rdfs:label 'Merit Increase Schedule' ;
    rdfs:comment 'The schedule governing when merit-based pay increases are reviewed and applied under this contract: annual (standard review cycle), bi_annual (twice-yearly for high-demand broadcast talent), performance_triggered (milestone-based for athlete-adjacent roles), or none (fixed-rate contracts such as CBA-governed hourly staff).' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nilCompensationEligible rdf:type rdf:Property ;
    rdfs:label 'Nil Compensation Eligible' ;
    rdfs:comment 'Indicates whether this contract includes provisions for Name, Image, and Likeness (NIL) compensation, applicable to athlete-adjacent roles such as brand ambassadors, coaching staff with public profiles, and broadcast talent. True enables NIL agreement linkage and NIL revenue tracking.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nilProvisionDetails rdf:type rdf:Property ;
    rdfs:label 'Nil Provision Details' ;
    rdfs:comment 'Free-text description of the NIL-related compensation provisions included in this contract, such as approved usage categories, revenue share percentages, or exclusivity restrictions. Populated only when nil_compensation_eligible is True.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overtimeEligible rdf:type rdf:Property ;
    rdfs:label 'Overtime Eligible' ;
    rdfs:comment 'Indicates whether the employee is eligible to receive overtime pay under this contract (True) or not (False). Typically aligned with FLSA non-exempt status but may also reflect CBA-specific overtime provisions for event crew and broadcast staff.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payBasis rdf:type rdf:Property ;
    rdfs:label 'Pay Basis' ;
    rdfs:comment 'The basis on which compensation is calculated: annual_salary (salaried employees), hourly_rate (part-time and event crew), daily_rate (broadcast crew and officials), or per_event (talent and officials paid per appearance). Determines how base pay rate is interpreted and applied in payroll.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probationEndDate rdf:type rdf:Property ;
    rdfs:label 'Probation End Date' ;
    rdfs:comment 'The date on which the employee\'s probationary period concludes. During probation, different notice periods and benefit eligibility rules may apply. Null if no probation period is applicable (e.g., rehires, senior executives).' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remoteWorkType rdf:type rdf:Property ;
    rdfs:label 'Remote Work Type' ;
    rdfs:comment 'The contractually agreed work location arrangement: on_site (venue/office-based), remote (fully remote), hybrid (split on-site and remote), or travelling (primarily travelling, e.g., touring broadcast crew, league officials). Affects tax nexus determination, OSHA safety obligations, and facility cost allocation.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryRangeMax rdf:type rdf:Property ;
    rdfs:label 'Salary Range Max' ;
    rdfs:comment 'The maximum of the approved compensation band for the position. Used to flag above-band compensation requiring executive approval and to cap merit increase eligibility in annual review cycles.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salaryRangeMid rdf:type rdf:Property ;
    rdfs:label 'Salary Range Mid' ;
    rdfs:comment 'The midpoint (market reference point) of the approved compensation band for the position. Used as the benchmark for compa-ratio calculations in annual compensation review cycles and pay equity reporting.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salaryRangeMin rdf:type rdf:Property ;
    rdfs:label 'Salary Range Min' ;
    rdfs:comment 'The minimum of the approved compensation band for the position associated with this contract. Used in pay equity analysis, compensation review cycles, and to ensure base_pay_rate does not fall below the band floor. Sourced from SAP SuccessFactors Compensation Management grade structures.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unionLocal rdf:type rdf:Property ;
    rdfs:label 'Union Local' ;
    rdfs:comment 'The specific union local or chapter to which the employee belongs under the applicable CBA (e.g., \'IATSE Local 695\', \'IBEW Local 40\'). Used for union dues remittance, grievance routing, and CBA compliance tracking. Null for non-union contracts.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workLocationCountry rdf:type rdf:Property ;
    rdfs:label 'Work Location Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the primary work location specified in the contract. Determines applicable labor law jurisdiction, tax withholding rules, GDPR/CCPA applicability, and governing CBA.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workerClassification rdf:type rdf:Property ;
    rdfs:label 'Worker Classification' ;
    rdfs:comment 'Operational classification of the workforce member under this contract: full_time (permanent staff), part_time (regular reduced-hours staff), seasonal (event-season workers), event_crew (per-event technical and production crew), broadcast_talent (on-air and production broadcast staff), or league_official (referees, umpires, and governing body officials). Drives benefit eligibility, OSHA training requirements, and reporting.' ;
    rdfs:domain ind:EmploymentContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentEventId rdf:type rdf:Property ;
    rdfs:label 'Employment Event Id' ;
    rdfs:comment 'Primary key for employment_event' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fromOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'From Org Unit Id' ;
    rdfs:comment 'Identifier of the organizational unit (department, division, or cost center) the employee belonged to before this employment event. Supports org change management and headcount reporting.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:fromPositionId rdf:type rdf:Property ;
    rdfs:label 'From Position Id' ;
    rdfs:comment 'Identifier of the employee\'s position prior to this employment event. Applicable for internal movements. Used for internal mobility reporting and org change management in SAP SuccessFactors.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Position .

ind:fromVenueId rdf:type rdf:Property ;
    rdfs:label 'From Venue Id' ;
    rdfs:comment 'Identifier of the venue or facility the employee was assigned to prior to this employment event. Relevant for venue-to-venue transfers and seasonal staff movements across Sports Entertainment properties.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Venue .

ind:hrApproverEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Hr Approver Employee Id' ;
    rdfs:comment 'Employee ID of the HR Business Partner or HR manager who approved this employment event in SAP SuccessFactors. Required for SOX internal controls and CBA compliance documentation.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:jobApplicationId rdf:type rdf:Property ;
    rdfs:label 'Job Application Id' ;
    rdfs:comment 'Foreign key linking to workforce.job_application. Business justification: A hire employment event is the direct outcome of a successful job application. Linking employment_event.job_application_id → job_application.job_application_id closes the talent acquisition lifecycle ' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JobApplication .

ind:laborRelationsCaseId rdf:type rdf:Property ;
    rdfs:label 'Labor Relations Case Id' ;
    rdfs:comment 'Foreign key linking to workforce.labor_relations_case. Business justification: Employment events such as terminations, suspensions, and demotions are frequently the outcome of a labor relations case (disciplinary action, grievance resolution, arbitration award). Linking employme' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LaborRelationsCase .

ind:primaryEmploymentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Employment Employee Id' ;
    rdfs:comment 'Unique identifier for the employee who is the subject of this employment event. References the workforce employee master record in SAP SuccessFactors Employee Central.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryEmploymentStaffPlanId rdf:type rdf:Property ;
    rdfs:label 'Primary Employment Staff Plan Id' ;
    rdfs:comment 'Identifier of the venue or facility the employee was assigned to prior to this employment event. Relevant for venue-to-venue transfers and seasonal staff movements across Sports Entertainment properties.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StaffPlan .

ind:tertiaryEmploymentHrApproverEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Employment Hr Approver Employee Id' ;
    rdfs:comment 'Employee ID of the HR Business Partner or HR manager who approved this employment event in SAP SuccessFactors. Required for SOX internal controls and CBA compliance documentation.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:toOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'To Org Unit Id' ;
    rdfs:comment 'Identifier of the organizational unit the employee is moving to as a result of this employment event. Null for separation events.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:toPositionId rdf:type rdf:Property ;
    rdfs:label 'To Position Id' ;
    rdfs:comment 'Identifier of the employee\'s new position following this employment event. Applicable for internal movements. Null for separation events.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Position .

ind:toVenueId rdf:type rdf:Property ;
    rdfs:label 'To Venue Id' ;
    rdfs:comment 'Identifier of the venue or facility the employee is being assigned to as a result of this employment event. Null for separation events or non-venue movements.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Venue .

ind:toVenueVenueStaffPlanId rdf:type rdf:Property ;
    rdfs:label 'To Venue Venue Staff Plan Id' ;
    rdfs:comment 'Identifier of the venue or facility the employee is being assigned to as a result of this employment event. Null for separation events or non-venue movements.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StaffPlan .

ind:cbaGoverned rdf:type rdf:Property ;
    rdfs:label 'Cba Governed' ;
    rdfs:comment 'Indicates whether this employment event is subject to a Collective Bargaining Agreement (CBA). Drives additional compliance validation steps and documentation requirements for unionized workforce segments.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:compensationChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Compensation Change Flag' ;
    rdfs:comment 'Indicates whether this employment event is accompanied by a change in the employee\'s base compensation. True when a salary adjustment is triggered by the event (e.g., promotion, demotion). Drives downstream payroll processing in SAP S/4HANA.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equipmentReturnStatus rdf:type rdf:Property ;
    rdfs:label 'Equipment Return Status' ;
    rdfs:comment 'Tracks the status of company equipment return for separation events (e.g., laptops, access cards, broadcast equipment, uniforms). Supports offboarding checklist compliance and asset management.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventNumber rdf:type rdf:Property ;
    rdfs:label 'Event Number' ;
    rdfs:comment 'Externally-known business identifier for this employment event, formatted as EE-{YYYY}-{NNNNNN}. Used in HR correspondence, audit trails, and cross-system references with SAP SuccessFactors and Workday Adaptive Planning.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exitInterviewCompleted rdf:type rdf:Property ;
    rdfs:label 'Exit Interview Completed' ;
    rdfs:comment 'Indicates whether an exit interview was conducted for this separation event. Applicable only for separation event types. Supports turnover analysis and employee experience reporting.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exitInterviewDate rdf:type rdf:Property ;
    rdfs:label 'Exit Interview Date' ;
    rdfs:comment 'Date on which the exit interview was conducted for a separation event. Null if exit_interview_completed is false or event is an internal movement.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exitReasonCategory rdf:type rdf:Property ;
    rdfs:label 'Exit Reason Category' ;
    rdfs:comment 'Standardized category of the primary reason for voluntary separation as captured during the exit interview. Used for attrition root-cause analysis and retention strategy development.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fromJobGrade rdf:type rdf:Property ;
    rdfs:label 'From Job Grade' ;
    rdfs:comment 'The employee\'s job grade or pay band classification prior to this employment event. Used to determine if the event constitutes a promotion or demotion and for compensation equity analysis.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hrApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Hr Approval Status' ;
    rdfs:comment 'Current approval status of the employment event within the HR workflow in SAP SuccessFactors. Tracks whether the event is awaiting HR sign-off, has been approved, rejected, or escalated to senior HR leadership.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hrApprovalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Hr Approval Timestamp' ;
    rdfs:comment 'Date and time when the HR approver formally approved or rejected this employment event in SAP SuccessFactors. Critical for SLA compliance and audit trail.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastWorkingDate rdf:type rdf:Property ;
    rdfs:label 'Last Working Date' ;
    rdfs:comment 'The final date on which the employee is expected to perform work duties. For separations, this drives final payroll processing, benefit termination, and system access revocation scheduling. May differ from effective_date for notice periods.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:oshaIncidentRelated rdf:type rdf:Property ;
    rdfs:label 'Osha Incident Related' ;
    rdfs:comment 'Indicates whether this employment event (particularly an involuntary termination or medical separation) is related to an OSHA-reportable workplace safety incident. Supports OSHA compliance reporting and legal risk management.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rehireRestrictionReason rdf:type rdf:Property ;
    rdfs:label 'Rehire Restriction Reason' ;
    rdfs:comment 'Narrative explanation for why an employee is flagged as ineligible for rehire. Populated only when rehire_eligible is false. Classified as confidential due to sensitive HR content.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Secondment End Date' ;
    rdfs:comment 'Planned end date for a temporary assignment or inter-league secondment. Applicable only when movement_type is \'temporary_assignment\' or \'inter_league_secondment\'. Null for permanent movements and separations.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:separationType rdf:type rdf:Property ;
    rdfs:label 'Separation Type' ;
    rdfs:comment 'Specific classification of a separation event. Applicable only when event_type is \'separation\'. Distinguishes voluntary resignation, involuntary termination, retirement, and end of seasonal contract — critical for turnover analysis and CBA compliance reporting.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severanceEligible rdf:type rdf:Property ;
    rdfs:label 'Severance Eligible' ;
    rdfs:comment 'Indicates whether the employee is eligible for severance pay as part of this separation event. Determined by employment contract terms, CBA provisions, and HR policy. Drives downstream payroll processing in SAP S/4HANA.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:successfactorsEventCode rdf:type rdf:Property ;
    rdfs:label 'Successfactors Event Code' ;
    rdfs:comment 'The native event identifier assigned by SAP SuccessFactors Employee Central for this employment event record. Used for source system traceability and reconciliation between the Databricks Silver layer and the system of record.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemAccessRevocationDate rdf:type rdf:Property ;
    rdfs:label 'System Access Revocation Date' ;
    rdfs:comment 'Date on which all system access was or is scheduled to be revoked for a separating employee. Null for internal movement events. Supports security audit and GDPR compliance.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:systemAccessRevoked rdf:type rdf:Property ;
    rdfs:label 'System Access Revoked' ;
    rdfs:comment 'Indicates whether all IT system access (SAP, Salesforce CRM, Adobe Experience Platform, broadcast systems, etc.) has been revoked for a separating employee. Critical for information security compliance and GDPR data access controls.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:toJobGrade rdf:type rdf:Property ;
    rdfs:label 'To Job Grade' ;
    rdfs:comment 'The employee\'s job grade or pay band classification following this employment event. Null for separation events. Compared against from_job_grade to classify promotion or demotion.' ;
    rdfs:domain ind:EmploymentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:candidateId rdf:type rdf:Property ;
    rdfs:label 'Candidate Id' ;
    rdfs:comment 'Reference to the candidate profile record in the talent acquisition system. Enables tracking of a single candidate across multiple applications.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Candidate .

ind:primaryJobHiringManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Job Hiring Manager Employee Id' ;
    rdfs:comment 'Reference to the internal employee record of the hiring manager responsible for the open position. Used for approval routing, interview scheduling, and workforce analytics.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:requisitionId rdf:type rdf:Property ;
    rdfs:label 'Requisition Id' ;
    rdfs:comment 'Reference to the approved headcount requisition that triggered this job posting. Links the application to the originating position request and budget authorization.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Requisition .

ind:tertiaryJobReferralEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Job Referral Employee Id' ;
    rdfs:comment 'Reference to the internal employee who referred this candidate, when source_channel is \'employee_referral\'. Used for referral bonus processing and referral program effectiveness reporting.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:applicationStatus rdf:type rdf:Property ;
    rdfs:label 'Application Status' ;
    rdfs:comment 'Current workflow state of the job application within the talent acquisition pipeline. Drives recruiter task queues, candidate communications, and funnel conversion reporting. [ENUM-REF-CANDIDATE: new|in_review|interview|offer|hired|withdrawn|rejected — promote to reference product]' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliedDate rdf:type rdf:Property ;
    rdfs:label 'Applied Date' ;
    rdfs:comment 'Calendar date on which the candidate formally submitted the job application. Principal business event date for time-to-fill calculations and sourcing analytics.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentScore rdf:type rdf:Property ;
    rdfs:label 'Assessment Score' ;
    rdfs:comment 'Numeric score from standardized pre-employment assessments (skills tests, cognitive assessments, or role-specific evaluations) administered during the recruiting process. Expressed as a percentage or scaled score per assessment design.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:candidateEmail rdf:type rdf:Property ;
    rdfs:label 'Candidate Email' ;
    rdfs:comment 'Primary email address of the job applicant used for all recruiting communications, interview invitations, and offer delivery. Governed under GDPR and CCPA data privacy regulations.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:candidateFirstName rdf:type rdf:Property ;
    rdfs:label 'Candidate First Name' ;
    rdfs:comment 'Legal first (given) name of the job applicant as provided during application submission. Required for candidate communications, offer letters, and background check initiation.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:candidateLastName rdf:type rdf:Property ;
    rdfs:label 'Candidate Last Name' ;
    rdfs:comment 'Legal last (family) name of the job applicant as provided during application submission. Required for candidate communications, offer letters, and background check initiation.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:candidatePhone rdf:type rdf:Property ;
    rdfs:label 'Candidate Phone' ;
    rdfs:comment 'Primary contact phone number for the job applicant. Used by recruiters for interview scheduling and offer negotiation calls.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costPerHireUsd rdf:type rdf:Property ;
    rdfs:label 'Cost Per Hire Usd' ;
    rdfs:comment 'Total recruiting cost attributed to this application, expressed in USD. Includes agency fees, advertising spend, assessment costs, and recruiter time allocation. Key KPI for talent acquisition efficiency benchmarking.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deiDisabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Dei Disability Status' ;
    rdfs:comment 'Self-reported disability status of the candidate, collected voluntarily for Section 503 and ADA compliance reporting. Not used in hiring decisions. Governed under GDPR Article 9.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deiEthnicity rdf:type rdf:Property ;
    rdfs:label 'Dei Ethnicity' ;
    rdfs:comment 'Self-reported ethnicity of the candidate, collected voluntarily for DEI hiring metrics and EEOC compliance reporting. Not used in hiring decisions. Governed under GDPR Article 9 and CCPA. [ENUM-REF-CANDIDATE: white|black_or_african_american|hispanic_or_latino|asian|native_american|pacific_islander|two_or_more|prefer_not_to_say — promote to reference product]' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deiGenderIdentity rdf:type rdf:Property ;
    rdfs:label 'Dei Gender Identity' ;
    rdfs:comment 'Self-reported gender identity of the candidate, collected voluntarily for DEI hiring metrics and EEOC compliance reporting. Not used in hiring decisions. Governed under GDPR and CCPA.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deiVeteranStatus rdf:type rdf:Property ;
    rdfs:label 'Dei Veteran Status' ;
    rdfs:comment 'Self-reported veteran status of the candidate, collected voluntarily for VEVRAA compliance and DEI reporting. Not used in hiring decisions.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interviewStage rdf:type rdf:Property ;
    rdfs:label 'Interview Stage' ;
    rdfs:comment 'Current or most recently completed interview stage in the candidate evaluation process. Tracks pipeline progression from initial phone screen through final round interviews.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isInternalCandidate rdf:type rdf:Property ;
    rdfs:label 'Is Internal Candidate' ;
    rdfs:comment 'Indicates whether the applicant is a current employee of Sports Entertainment applying for an internal transfer or promotion. Drives internal mobility reporting and CBA compliance tracking.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRehire rdf:type rdf:Property ;
    rdfs:label 'Is Rehire' ;
    rdfs:comment 'Indicates whether the candidate was previously employed by Sports Entertainment. Triggers rehire eligibility review and prior employment record lookup in SAP SuccessFactors.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jobFamily rdf:type rdf:Property ;
    rdfs:label 'Job Family' ;
    rdfs:comment 'Functional grouping of the position within the organizational job architecture (e.g., Broadcast & Media, Athlete Operations, Venue Management, Finance, Technology). Supports workforce planning and DEI analytics segmentation.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offerAcceptedDate rdf:type rdf:Property ;
    rdfs:label 'Offer Accepted Date' ;
    rdfs:comment 'Calendar date on which the candidate formally accepted the employment offer. Marks the successful close of the talent acquisition lifecycle for this application.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:offerCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Offer Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the offered_base_salary and any other monetary offer components (e.g., USD, GBP, EUR, AUD). Required for global workforce compensation reporting.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offerDeclineReason rdf:type rdf:Property ;
    rdfs:label 'Offer Decline Reason' ;
    rdfs:comment 'Categorized reason provided by the candidate for declining the employment offer. Informs compensation benchmarking, location strategy, and talent market competitiveness assessments.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offerDeclinedDate rdf:type rdf:Property ;
    rdfs:label 'Offer Declined Date' ;
    rdfs:comment 'Calendar date on which the candidate declined the employment offer. Populated when offer_accepted_date is null and the candidate chose not to accept. Used for offer decline rate and competitive compensation analysis.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:offerExtendedDate rdf:type rdf:Property ;
    rdfs:label 'Offer Extended Date' ;
    rdfs:comment 'Calendar date on which a formal employment offer was extended to the candidate. Used for time-to-offer KPI measurement and offer acceptance rate analytics.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:offeredBaseSalary rdf:type rdf:Property ;
    rdfs:label 'Offered Base Salary' ;
    rdfs:comment 'Annual base salary amount included in the formal employment offer extended to the candidate. Expressed in the local currency of the position. Confidential business data used for compensation benchmarking and budget variance analysis.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionTitle rdf:type rdf:Property ;
    rdfs:label 'Position Title' ;
    rdfs:comment 'Job title of the open position the candidate is applying for (e.g., Head of Broadcast Operations, Event Crew Coordinator, League Official). Sourced from the approved requisition in SAP SuccessFactors.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingType rdf:type rdf:Property ;
    rdfs:label 'Posting Type' ;
    rdfs:comment 'Indicates whether the job requisition was posted internally (to existing employees), externally (to the public), or both. Drives internal mobility tracking and sourcing channel attribution.' ;
    rdfs:domain ind:JobApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requisitionNumber rdf:type rdf:Property ;
    rdfs:label 'Requisition Number' ;
    rdfs:comment 'Human-readable requisition reference number from SAP SuccessFactors (e.g., REQ-0001234). Externally visible identifier used in job postings, candidate communications, and headcount governance reporting.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetStartDate rdf:type rdf:Property ;
    rdfs:label 'Target Start Date' ;
    rdfs:comment 'Anticipated first day of employment for the candidate as specified in the requisition or offer. Used for workforce planning, onboarding scheduling, and time-to-fill measurement.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:workAuthorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Work Authorization Status' ;
    rdfs:comment 'Candidate\'s self-reported eligibility to work in the country of the open position without employer sponsorship. Required for I-9 compliance and international hiring decisions across global markets.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaIncidentId rdf:type rdf:Property ;
    rdfs:label 'Osha Incident Id' ;
    rdfs:comment 'Foreign key linking to workforce.osha_incident. Business justification: labor_relations_case has an osha_related boolean flag indicating the case stems from a workplace safety incident. Linking labor_relations_case.osha_incident_id → osha_incident.osha_incident_id formali' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OshaIncident .

ind:unionId rdf:type rdf:Property ;
    rdfs:label 'Union Id' ;
    rdfs:comment 'Reference to the labor union representing the employee in this case. Links to the union master record. Relevant for cases involving unionized workforce segments (e.g., NFLPA, NBPA, MLBPA, NHLPA, MLSPA, broadcast crew unions).' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Union .

ind:appealDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Date' ;
    rdfs:comment 'Date on which the appeal was formally filed. Null if no appeal has been filed. Used for tracking appeal deadlines and case escalation timelines.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealOutcome rdf:type rdf:Property ;
    rdfs:label 'Appeal Outcome' ;
    rdfs:comment 'The outcome of the appeal process. \'Pending\' means the appeal is still under review; \'upheld\' means the original decision was confirmed; \'overturned\' means the appeal succeeded; \'remanded\' means the case was sent back for reconsideration; \'withdrawn\' means the appeal was retracted. Null if no appeal was filed.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arbitratorName rdf:type rdf:Property ;
    rdfs:label 'Arbitrator Name' ;
    rdfs:comment 'Full name of the neutral arbitrator assigned to adjudicate the case when it reaches arbitration. Null for cases resolved prior to arbitration. Sourced from the agreed arbitration panel per the CBA.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseSource rdf:type rdf:Property ;
    rdfs:label 'Case Source' ;
    rdfs:comment 'Identifies who or what initiated this labor relations case. Distinguishes between employee-initiated grievances, union-filed actions, management-initiated disciplinary proceedings, regulatory agency referrals, or third-party complaints.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplinaryActionType rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Action Type' ;
    rdfs:comment 'The specific type of disciplinary action imposed on the employee, if applicable. Null for grievance or arbitration cases not involving employer-initiated discipline.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerRepresentativeName rdf:type rdf:Property ;
    rdfs:label 'Employer Representative Name' ;
    rdfs:comment 'Full name of the management or HR representative handling this case on behalf of Sports Entertainment. Used for case accountability and correspondence tracking.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalCaseReference rdf:type rdf:Property ;
    rdfs:label 'External Case Reference' ;
    rdfs:comment 'External reference number assigned by a third-party body such as the American Arbitration Association (AAA), National Labor Relations Board (NLRB), Court of Arbitration for Sport (CAS), or a league office. Used for cross-referencing with external proceedings.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filedDate rdf:type rdf:Property ;
    rdfs:label 'Filed Date' ;
    rdfs:comment 'The date on which the labor relations case was formally filed or initiated. This is the principal real-world event date for the case lifecycle and is used for statutory deadline tracking.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grievanceStep rdf:type rdf:Property ;
    rdfs:label 'Grievance Step' ;
    rdfs:comment 'Current step in the multi-step CBA grievance procedure. Most CBAs define a sequential escalation path (Step 1: supervisor, Step 2: HR/management, Step 3: senior management, then arbitration). Null for non-grievance case types.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalCounselEngaged rdf:type rdf:Property ;
    rdfs:label 'Legal Counsel Engaged' ;
    rdfs:comment 'Indicates whether external or internal legal counsel has been formally engaged to represent Sports Entertainment in this labor relations case. True if legal counsel is involved; False otherwise. Triggers legal hold and document preservation obligations.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalHold rdf:type rdf:Property ;
    rdfs:label 'Legal Hold' ;
    rdfs:comment 'Indicates whether a legal hold has been placed on records associated with this case, preventing deletion or modification of related documents and data. True if a legal hold is active; False otherwise.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oshaRelated rdf:type rdf:Property ;
    rdfs:label 'Osha Related' ;
    rdfs:comment 'Indicates whether this labor relations case involves an Occupational Safety and Health Administration (OSHA) workplace safety violation or injury-related grievance. True if OSHA-related; False otherwise. Triggers mandatory OSHA recordkeeping and reporting obligations.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorCaseCount rdf:type rdf:Property ;
    rdfs:label 'Prior Case Count' ;
    rdfs:comment 'Number of prior labor relations cases on record for this employee at the time this case was filed. Used to assess progressive discipline history and inform case handling decisions under CBA progressive discipline provisions.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:successfactorsCaseCode rdf:type rdf:Property ;
    rdfs:label 'Successfactors Case Code' ;
    rdfs:comment 'The native case or employee relations record identifier from SAP SuccessFactors Employee Central. Used for system-of-record traceability and cross-system reconciliation between the Databricks Silver layer and the HR source system.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspensionDays rdf:type rdf:Property ;
    rdfs:label 'Suspension Days' ;
    rdfs:comment 'Number of calendar days the employee is suspended without pay as part of the disciplinary action. Applicable only when disciplinary_action_type is \'suspension\'. Used for payroll adjustment and CBA compliance tracking.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unionRepresentativeName rdf:type rdf:Property ;
    rdfs:label 'Union Representative Name' ;
    rdfs:comment 'Full name of the union steward or representative assigned to represent the employee in this labor relations case. Captured as a denormalized field for case documentation purposes.' ;
    rdfs:domain ind:LaborRelationsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workforceCategory rdf:type rdf:Property ;
    rdfs:label 'Workforce Category' ;
    rdfs:comment 'Classification of the employee\'s workforce category at the time of the case. Determines applicable CBA, labor law protections, and HR policy framework. [ENUM-REF-CANDIDATE: full_time|part_time|seasonal|event_crew|broadcast_crew|league_official|contractor — promote to reference product]' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courseId rdf:type rdf:Property ;
    rdfs:label 'Course Id' ;
    rdfs:comment 'Reference to the course or learning program catalog item in the LMS. Identifies the specific training offering the employee is enrolled in.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Course .

ind:performanceReviewId rdf:type rdf:Property ;
    rdfs:label 'Performance Review Id' ;
    rdfs:comment 'Foreign key linking to workforce.performance_review. Business justification: Performance reviews identify development gaps and trigger mandatory learning enrollments (development_gap_assessment, development_plan_id on performance_review). Linking learning_enrollment.performanc' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PerformanceReview .

ind:attemptNumber rdf:type rdf:Property ;
    rdfs:label 'Attempt Number' ;
    rdfs:comment 'Sequential attempt number for this enrollment, starting at 1. Increments when an employee re-attempts a course after a failed assessment. Used to track remediation patterns and compliance risk.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cbaObligationCode rdf:type rdf:Property ;
    rdfs:label 'Cba Obligation Code' ;
    rdfs:comment 'Reference code identifying the specific Collective Bargaining Agreement (CBA) clause or article that mandates this training. Null for non-CBA-required training. Critical for labor relations compliance reporting.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialIssueDate rdf:type rdf:Property ;
    rdfs:label 'Credential Issue Date' ;
    rdfs:comment 'Date on which the credential or certificate was formally issued by the issuing authority. Marks the start of the credential validity period.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialRenewalStatus rdf:type rdf:Property ;
    rdfs:label 'Credential Renewal Status' ;
    rdfs:comment 'Current renewal state of the credential. Drives automated alerts for upcoming expirations and supports venue access control decisions. Expired credentials may restrict employee access to regulated areas.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Credential Verification Status' ;
    rdfs:comment 'Status of third-party or issuing authority verification of the credential. Unverified or rejected credentials may block venue access or broadcast licensing. Supports audit and compliance reporting.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRecurrent rdf:type rdf:Property ;
    rdfs:label 'Is Recurrent' ;
    rdfs:comment 'Indicates whether this training must be periodically renewed (e.g., annual OSHA refresher, biennial First Aid/CPR recertification). Drives automated re-enrollment scheduling.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:learningType rdf:type rdf:Property ;
    rdfs:label 'Learning Type' ;
    rdfs:comment 'Classification of the learning activity by its business purpose and regulatory driver. Mandatory compliance covers GDPR, PCI-DSS, and SOX training; CBA-required safety covers Collective Bargaining Agreement (CBA) obligations; broadcast certification covers FCC licensing requirements; OSHA certification covers Occupational Safety and Health Administration (OSHA) mandates.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lmsSourceCode rdf:type rdf:Property ;
    rdfs:label 'Lms Source Code' ;
    rdfs:comment 'Native identifier of this enrollment record in the SAP SuccessFactors Learning Management System (LMS). Enables traceability back to the system of record for reconciliation and audit purposes.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxAttemptsAllowed rdf:type rdf:Property ;
    rdfs:label 'Max Attempts Allowed' ;
    rdfs:comment 'Maximum number of assessment attempts permitted for this course enrollment before escalation or mandatory re-enrollment is triggered. Defined at the course level and copied to the enrollment for audit traceability.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:passFailStatus rdf:type rdf:Property ;
    rdfs:label 'Pass Fail Status' ;
    rdfs:comment 'Assessment outcome for the learning activity. Pass status may trigger credential issuance or venue access rights. Fail status may trigger mandatory re-enrollment per OSHA or CBA requirements.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passingScoreThreshold rdf:type rdf:Property ;
    rdfs:label 'Passing Score Threshold' ;
    rdfs:comment 'Minimum score required to pass the course assessment, expressed as a percentage. Defined at the course level and copied to the enrollment for audit traceability.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recurrenceIntervalMonths rdf:type rdf:Property ;
    rdfs:label 'Recurrence Interval Months' ;
    rdfs:comment 'Number of months between required renewals for recurrent training. For example, 12 for annual OSHA refresher or 24 for biennial CPR recertification. Null for non-recurrent training.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingCost rdf:type rdf:Property ;
    rdfs:label 'Training Cost' ;
    rdfs:comment 'Total cost incurred for this enrollment, including registration fees, external provider fees, and materials. Denominated in the operating currency (USD). Used for workforce development budget tracking and cost allocation to business units.' ;
    rdfs:domain ind:LearningEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leaveRequestId rdf:type rdf:Property ;
    rdfs:label 'Leave Request Id' ;
    rdfs:comment 'Unique system-generated identifier for each leave and absence request record in SAP SuccessFactors Time and Attendance. Primary key for the leave_request data product.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventId rdf:type rdf:Property ;
    rdfs:label 'Event Id' ;
    rdfs:comment 'Reference to a specific sports or entertainment event in the event domain that this leave request may impact. Populated when the leave overlaps with a scheduled event requiring the employee\'s role (e.g., game day, concert, broadcast). Supports event staffing gap identification.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmploymentEvent .

ind:primaryLeaveEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Leave Employee Id' ;
    rdfs:comment 'Reference to the workforce employee record in SAP SuccessFactors for whom this leave request is submitted. Links to the employee master in the workforce domain.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:tertiaryLeaveBackfillEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Leave Backfill Employee Id' ;
    rdfs:comment 'Reference to the workforce employee record of the individual assigned to cover the absent employee\'s duties during the leave period. Null if no backfill has been assigned or if backfill_required = False.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:approvedDays rdf:type rdf:Property ;
    rdfs:label 'Approved Days' ;
    rdfs:comment 'Total number of calendar or working days approved for this leave request, expressed as a decimal to accommodate partial-day approvals. Used for absence trend analysis, payroll deduction calculations, and FMLA entitlement tracking (12-week annual cap).' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedHours rdf:type rdf:Property ;
    rdfs:label 'Approved Hours' ;
    rdfs:comment 'Total number of hours approved for this leave request. Used for intermittent FMLA tracking (where leave is taken in hourly increments), part-time employee proration, and event-day comp time calculations for broadcast crews and event staff.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:backfillRequired rdf:type rdf:Property ;
    rdfs:label 'Backfill Required' ;
    rdfs:comment 'Indicates whether a temporary replacement or backfill resource must be sourced to cover the employee\'s responsibilities during the leave period. True = backfill needed; False = coverage not required. Triggers workforce planning and contingent labor procurement workflows.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Certification Due Date' ;
    rdfs:comment 'The deadline by which the employee must submit required medical certification documentation to HR. Typically 15 calendar days from the date HR requests certification per FMLA regulations. Null when certification is not required.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employeeNotes rdf:type rdf:Property ;
    rdfs:label 'Employee Notes' ;
    rdfs:comment 'Free-text notes entered by the employee at the time of submission providing additional context for the leave request. Confidential HR data. Must not contain PHI (medical details should be captured via formal certification process only). Restricted to HR and the approving manager.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeWorkSchedule rdf:type rdf:Property ;
    rdfs:label 'Employee Work Schedule' ;
    rdfs:comment 'Work schedule classification of the employee at the time of the leave request. Determines applicable leave entitlements, proration rules, and staffing gap impact. Covers full-time staff, part-time event crew, broadcast crews, league officials, and seasonal workers per the workforce domain scope.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fmlaDesignationNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Fmla Designation Notice Date' ;
    rdfs:comment 'The date on which HR issued the FMLA Designation Notice (WH-382) to the employee, confirming whether the leave qualifies as FMLA-protected. Must be issued within 5 business days of receiving sufficient information per DOL regulations. Null for non-FMLA leave types.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fmlaHoursUsed rdf:type rdf:Property ;
    rdfs:label 'Fmla Hours Used' ;
    rdfs:comment 'Cumulative FMLA-designated hours consumed by this specific leave request against the employee\'s annual 480-hour (12-week) FMLA entitlement. Populated only when is_fmla_eligible = True. Used for FMLA entitlement balance tracking and DOL compliance reporting.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hrNotes rdf:type rdf:Property ;
    rdfs:label 'Hr Notes' ;
    rdfs:comment 'Free-text notes entered by HR personnel during the review and processing of the leave request. May include documentation status, escalation notes, or compliance observations. Confidential HR data restricted to HR personnel only.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFmlaEligible rdf:type rdf:Property ;
    rdfs:label 'Is Fmla Eligible' ;
    rdfs:comment 'Indicates whether the employee meets FMLA eligibility criteria at the time of the request: employed for at least 12 months, worked 1,250 hours in the prior 12 months, and works at a location with 50+ employees within 75 miles. True = eligible; False = not eligible. Drives FMLA compliance reporting.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isIntermittent rdf:type rdf:Property ;
    rdfs:label 'Is Intermittent' ;
    rdfs:comment 'Indicates whether this leave is taken intermittently (in separate blocks of time or by reducing the normal work schedule) rather than as a continuous absence. True = intermittent leave; False = continuous leave. Intermittent FMLA requires separate hourly tracking and is common for chronic conditions among event-day staff.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPaid rdf:type rdf:Property ;
    rdfs:label 'Is Paid' ;
    rdfs:comment 'Indicates whether the approved leave is compensated (paid) or uncompensated (unpaid). True = paid leave; False = unpaid leave. Drives payroll processing in SAP SuccessFactors and determines whether PTO balance is decremented.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:juryDutyCourtName rdf:type rdf:Property ;
    rdfs:label 'Jury Duty Court Name' ;
    rdfs:comment 'Name of the court or tribunal issuing the jury summons for jury duty leave requests. Null for non-jury-duty leave types. Used to validate the legitimacy of the jury duty claim and for payroll differential calculations.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaveEndDate rdf:type rdf:Property ;
    rdfs:label 'Leave End Date' ;
    rdfs:comment 'The last calendar date on which the employee is scheduled to be absent under this leave request. Null for open-ended leaves pending medical certification. Used to calculate approved leave duration and plan workforce coverage.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leaveReason rdf:type rdf:Property ;
    rdfs:label 'Leave Reason' ;
    rdfs:comment 'General business reason or description provided by the employee for the leave request. Kept at a high level to avoid PHI exposure (e.g., \'personal medical\', \'family care\', \'military deployment\'). Confidential HR data restricted to HR personnel and the approving manager. [ENUM-REF-CANDIDATE: PERSONAL_MEDICAL|FAMILY_CARE|MILITARY_DEPLOYMENT|BEREAVEMENT|CIVIC_DUTY|PARENTAL_BONDING|PERSONAL — promote to reference product]' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaveStartDate rdf:type rdf:Property ;
    rdfs:label 'Leave Start Date' ;
    rdfs:comment 'The first calendar date on which the employee is scheduled to be absent under this leave request. Used for event staffing gap analysis and payroll processing.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leaveType rdf:type rdf:Property ;
    rdfs:label 'Leave Type' ;
    rdfs:comment 'Classification of the leave category as defined by HR policy and applicable labor law. Values include: FMLA (Family and Medical Leave Act), PTO (Paid Time Off), SICK, BEREAVEMENT, JURY_DUTY, MILITARY, PARENTAL, COMP_TIME (event-day compensatory time). Drives eligibility rules, pay treatment, and regulatory reporting. [ENUM-REF-CANDIDATE: FMLA|PTO|SICK|BEREAVEMENT|JURY_DUTY|MILITARY|PARENTAL|COMP_TIME — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalCertificationReceived rdf:type rdf:Property ;
    rdfs:label 'Medical Certification Received' ;
    rdfs:comment 'Indicates whether the required medical certification documentation has been received and accepted by HR. True = received; False = pending or not received. Used to track FMLA compliance deadlines (employee has 15 calendar days to provide certification).' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalCertificationRequired rdf:type rdf:Property ;
    rdfs:label 'Medical Certification Required' ;
    rdfs:comment 'Indicates whether a medical certification form (e.g., FMLA WH-380-E or WH-380-F) is required to support this leave request. True = certification required; False = not required. Drives HR compliance workflow and document collection tracking.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:militaryOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Military Order Number' ;
    rdfs:comment 'Official military deployment order number provided by the employee to support a military leave request under USERRA (Uniformed Services Employment and Reemployment Rights Act). Null for non-military leave types. Confidential HR document reference.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payTreatment rdf:type rdf:Property ;
    rdfs:label 'Pay Treatment' ;
    rdfs:comment 'Specifies the compensation treatment applied during the leave period. FULL_PAY = 100% salary continuation; PARTIAL_PAY = reduced pay per policy or CBA; UNPAID = no compensation; STD = Short-Term Disability benefit; LTD = Long-Term Disability benefit. Used by payroll to apply correct earnings codes.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phasedReturnPlan rdf:type rdf:Property ;
    rdfs:label 'Phased Return Plan' ;
    rdfs:comment 'Indicates whether the employee has an approved phased or gradual return-to-work plan following the leave (e.g., reduced hours for first two weeks). True = phased return approved; False = full-duty return. Common for medical and parental leave returns in sports operations.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ptoHoursDeducted rdf:type rdf:Property ;
    rdfs:label 'Pto Hours Deducted' ;
    rdfs:comment 'Number of accrued PTO hours deducted from the employee\'s PTO balance for this leave request. Applicable when leave type is PTO or when employer requires concurrent PTO usage during FMLA leave. Feeds into SAP SuccessFactors leave balance management.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnToWorkDate rdf:type rdf:Property ;
    rdfs:label 'Return To Work Date' ;
    rdfs:comment 'The confirmed or expected calendar date on which the employee is scheduled to return to active duty following the leave. May differ from leave_end_date + 1 due to weekends, holidays, or phased return arrangements. Critical for event staffing and broadcast crew scheduling.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemRecordCode rdf:type rdf:Property ;
    rdfs:label 'Source System Record Code' ;
    rdfs:comment 'The native record identifier assigned by SAP SuccessFactors Time and Attendance to this leave request. Preserved for data lineage, reconciliation, and bi-directional sync between the Silver Layer and the system of record.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentUnitOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Parent Unit Org Unit Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediate parent organizational unit in the hierarchy. Enables recursive traversal of the org tree for span-of-control analysis, rollup reporting, and budget consolidation. Null for the root-level enterprise unit.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:primaryOrgManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Org Manager Employee Id' ;
    rdfs:comment 'Employee identifier of the designated manager or head of this organizational unit as recorded in SAP SuccessFactors. Used for approval workflows, span-of-control reporting, and organizational accountability mapping.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:quaternaryOrgHrBusinessPartnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Quaternary Org Hr Business Partner Employee Id' ;
    rdfs:comment 'Employee identifier of the HR Business Partner (HRBP) assigned to support this organizational unit. Used for HR service delivery routing, talent management accountability, and CBA labor relations management.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:tertiaryOrgEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Org Employee Id' ;
    rdfs:comment 'Employee identifier of the HR Business Partner (HRBP) assigned to support this organizational unit. Used for HR service delivery routing, talent management accountability, and CBA labor relations management.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:adaComplianceScope rdf:type rdf:Property ;
    rdfs:label 'Ada Compliance Scope' ;
    rdfs:comment 'Indicates whether this organizational unit has ADA compliance obligations, particularly relevant for venue operations, fan-facing event units, and public-access facilities. Drives accessibility audit scheduling and accommodation workflow routing.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:businessUnitCode rdf:type rdf:Property ;
    rdfs:label 'Business Unit Code' ;
    rdfs:comment 'Code identifying the broader business unit or profit center grouping to which this org unit belongs (e.g., \'SPORTS\', \'ENTERTAINMENT\', \'BROADCAST\', \'VENUES\'). Supports EBITDA reporting by business segment and strategic portfolio analysis.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fteCountActual rdf:type rdf:Property ;
    rdfs:label 'Fte Count Actual' ;
    rdfs:comment 'Current actual full-time equivalent (FTE) count of employees assigned to this organizational unit, including part-time workers converted to FTE fractions. Sourced from SAP SuccessFactors headcount reporting. Used for span-of-control analysis and budget variance tracking.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gdprDataController rdf:type rdf:Property ;
    rdfs:label 'Gdpr Data Controller' ;
    rdfs:comment 'Indicates whether this organizational unit acts as a GDPR data controller for personal data processed within its scope. Relevant for EU-based operations, fan data management, and broadcast rights distribution in European markets. Drives data protection impact assessment (DPIA) obligations.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orgUnitStatus rdf:type rdf:Property ;
    rdfs:label 'Org Unit Status' ;
    rdfs:comment 'Current lifecycle status of the organizational unit. \'active\' indicates the unit is operational and staffed; \'inactive\' indicates it has been decommissioned or merged; \'pending\' indicates it is approved but not yet operational; \'archived\' indicates historical record retained for audit purposes.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaEstablishmentNumber rdf:type rdf:Property ;
    rdfs:label 'Osha Establishment Number' ;
    rdfs:comment 'OSHA establishment identifier assigned to this organizational unit for safety compliance reporting purposes. Required for OSHA 300 injury and illness log maintenance, particularly for venue operations, event crew, and broadcast production units. Null for non-physical or administrative org units.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payrollAreaCode rdf:type rdf:Property ;
    rdfs:label 'Payroll Area Code' ;
    rdfs:comment 'SAP SuccessFactors / SAP HCM payroll area code assigned to this organizational unit, determining the payroll processing schedule, pay frequency, and payroll run grouping. Critical for multi-country payroll operations across global sports entertainment markets.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:successfactorsObjectCode rdf:type rdf:Property ;
    rdfs:label 'Successfactors Object Code' ;
    rdfs:comment 'Native object identifier from SAP SuccessFactors Org Chart for this organizational unit (Foundation Object external code). Used for bi-directional synchronization between the Silver Layer data product and the system of record, and for audit trail reconciliation.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:successionPlanStatus rdf:type rdf:Property ;
    rdfs:label 'Succession Plan Status' ;
    rdfs:comment 'Current status of the succession planning process for the leadership position of this organizational unit. Tracked in SAP SuccessFactors Succession & Development module. Critical for talent risk management across key sports operations and broadcast leadership roles.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitCode rdf:type rdf:Property ;
    rdfs:label 'Unit Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying the organizational unit across enterprise systems (SAP SuccessFactors, SAP S/4HANA, Workday Adaptive Planning). Used as the business key for cross-system integration and reporting.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitName rdf:type rdf:Property ;
    rdfs:label 'Unit Name' ;
    rdfs:comment 'Official human-readable name of the organizational unit as defined in SAP SuccessFactors Org Chart (e.g., \'NFL Operations Division\', \'Broadcast Network – East\', \'Venue Facilities – Madison Square Garden\'). Used in workforce reporting, org charts, and budget allocation displays.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitShortName rdf:type rdf:Property ;
    rdfs:label 'Unit Short Name' ;
    rdfs:comment 'Abbreviated display name for the organizational unit used in dashboards, payslips, and space-constrained reporting contexts (e.g., \'NFL Ops\', \'Broadcast-E\', \'MSG Facilities\').' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitType rdf:type rdf:Property ;
    rdfs:label 'Unit Type' ;
    rdfs:comment 'Classification of the organizational unit by its structural role within Sports Entertainment. Drives hierarchy rules, budget allocation logic, and workforce reporting segmentation. [ENUM-REF-CANDIDATE: department|division|league|venue|broadcast_network|cost_center_group|shared_service — promote to reference product if additional types emerge]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amputationFlag rdf:type rdf:Property ;
    rdfs:label 'Amputation Flag' ;
    rdfs:comment 'Indicates whether the incident resulted in an amputation. Amputations must be reported to OSHA within 24 hours per 29 CFR 1904.39. Triggers mandatory regulatory notification workflow.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:daysRestrictedDuty rdf:type rdf:Property ;
    rdfs:label 'Days Restricted Duty' ;
    rdfs:comment 'Number of calendar days the employee was placed on restricted work activity or job transfer as a result of the incident. Required field on OSHA 300 Log column H. Combined with days_away_from_work to calculate DART rate.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:establishmentName rdf:type rdf:Property ;
    rdfs:label 'Establishment Name' ;
    rdfs:comment 'The legal name of the Sports Entertainment establishment (venue, office, or broadcast facility) as registered with OSHA for recordkeeping purposes. Required on OSHA 300 Log header. May differ from the operational venue name.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventActivity rdf:type rdf:Property ;
    rdfs:label 'Event Activity' ;
    rdfs:comment 'Description of the work activity or task the employee was performing at the time of the incident (e.g., stage rigging, field maintenance, crowd management, broadcast equipment setup, merchandise stocking). Required for root cause analysis and corrective action planning.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fatalityFlag rdf:type rdf:Property ;
    rdfs:label 'Fatality Flag' ;
    rdfs:comment 'Indicates whether the incident resulted in the death of the employee. Fatalities must be reported to OSHA within 8 hours of the employer learning of the death. Triggers mandatory regulatory notification workflow.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalizationFlag rdf:type rdf:Property ;
    rdfs:label 'Hospitalization Flag' ;
    rdfs:comment 'Indicates whether the incident resulted in in-patient hospitalization of the employee. In-patient hospitalizations must be reported to OSHA within 24 hours. Distinct from emergency room visits without admission.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incidentLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Incident Location Description' ;
    rdfs:comment 'Specific description of the physical location within the venue, broadcast site, or facility where the incident occurred (e.g., loading dock, field level, broadcast booth, concourse level 2, locker room). Supplements the venue_id with granular location context.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentTime rdf:type rdf:Property ;
    rdfs:label 'Incident Time' ;
    rdfs:comment 'Precise date and time at which the workplace safety incident occurred. Used for shift-level analysis, event-day correlation, and root cause investigation timelines.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:injuryNature rdf:type rdf:Property ;
    rdfs:label 'Injury Nature' ;
    rdfs:comment 'Describes the physical nature of the injury or illness sustained (e.g., laceration, fracture, sprain, burn, concussion, heat illness, respiratory condition). Coded per OSHA BLS Occupational Injury and Illness Classification System (OIICS). [ENUM-REF-CANDIDATE: laceration|fracture|sprain|strain|burn|concussion|contusion|heat_illness|respiratory|amputation|dislocation|other — promote to reference product]' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Completed Date' ;
    rdfs:comment 'Date on which the formal incident investigation was completed and findings were documented. Used to measure investigation timeliness and compliance with internal safety program SLAs.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lostConsciousness rdf:type rdf:Property ;
    rdfs:label 'Lost Consciousness' ;
    rdfs:comment 'Indicates whether the employee lost consciousness as a result of the incident. Loss of consciousness is an independent OSHA recordability criterion regardless of medical treatment received.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalTreatmentBeyondFirstAid rdf:type rdf:Property ;
    rdfs:label 'Medical Treatment Beyond First Aid' ;
    rdfs:comment 'Indicates whether the injured employee received medical treatment beyond first aid, which is a key criterion for OSHA recordability determination. True if treatment beyond first aid was provided; False if only first aid was administered.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oshaCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Osha Case Number' ;
    rdfs:comment 'Sequential case number assigned to the incident on the OSHA 300 Log for the establishment and calendar year. Required field on OSHA Form 300. Used for annual 300A summary compilation and regulatory audit trail.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaLogType rdf:type rdf:Property ;
    rdfs:label 'Osha Log Type' ;
    rdfs:comment 'Identifies which OSHA recordkeeping form(s) this incident is entered on: OSHA 300 Log of Work-Related Injuries and Illnesses, OSHA 300A Annual Summary, or OSHA 301 Incident Report. Drives compliance reporting workflow.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaRecordability rdf:type rdf:Property ;
    rdfs:label 'Osha Recordability' ;
    rdfs:comment 'Determination of whether the incident meets OSHA recordability criteria under 29 CFR 1904.7. Recordable cases must be entered on the OSHA 300 Log. Non-recordable cases are retained for internal tracking only.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Osha Submission Date' ;
    rdfs:comment 'The date on which the incident was formally submitted or reported to OSHA through the Injury Tracking Application (ITA) or direct notification. Used to verify compliance with mandatory reporting deadlines (8-hour for fatalities, 24-hour for hospitalizations/amputations).' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:witnessNames rdf:type rdf:Property ;
    rdfs:label 'Witness Names' ;
    rdfs:comment 'Names of individuals who witnessed the incident. Required on OSHA 301 Incident Report. Stored as a delimited string. Classified as confidential due to potential legal sensitivity in workers\' compensation and liability proceedings.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workRelated rdf:type rdf:Property ;
    rdfs:label 'Work Related' ;
    rdfs:comment 'Indicates whether the incident has been determined to be work-related per OSHA 29 CFR 1904.5 criteria. Work-relatedness is a prerequisite for OSHA recordability. False for incidents determined to be personal in nature.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workersCompClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Workers Comp Claim Number' ;
    rdfs:comment 'The workers\' compensation insurance claim number associated with this OSHA incident, if a claim was filed. Links the safety record to the financial and insurance claim management process. Confidential due to financial and legal sensitivity.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payrollRecordId rdf:type rdf:Property ;
    rdfs:label 'Payroll Record Id' ;
    rdfs:comment 'Unique surrogate identifier for each payroll processing record in the Sports Entertainment workforce payroll system. Primary key for this entity. Sourced from SAP SuccessFactors Payroll.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:payrollRunId rdf:type rdf:Property ;
    rdfs:label 'Payroll Run Id' ;
    rdfs:comment 'Reference to the payroll run batch that produced this record. Enables grouping of all employee pay results processed in the same payroll execution cycle.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PayrollRun .

ind:basePayAmount rdf:type rdf:Property ;
    rdfs:label 'Base Pay Amount' ;
    rdfs:comment 'The regular base salary or hourly wage earnings component for the pay period, excluding overtime, differentials, and supplemental pay. Core compensation component sourced from the employee\'s pay structure in SAP SuccessFactors.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benefitDeductionAmount rdf:type rdf:Property ;
    rdfs:label 'Benefit Deduction Amount' ;
    rdfs:comment 'Total employee pre-tax and post-tax benefit deductions for the pay period, including health insurance premiums, dental, vision, 401(k) contributions, FSA/HSA contributions, and other voluntary benefit elections.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:broadcastDifferentialAmount rdf:type rdf:Property ;
    rdfs:label 'Broadcast Differential Amount' ;
    rdfs:comment 'Additional shift differential pay earned by broadcast crew members for specialized broadcast production work. Reflects premium compensation for technical broadcast roles per applicable CBA or employment agreements.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:directDepositFlag rdf:type rdf:Property ;
    rdfs:label 'Direct Deposit Flag' ;
    rdfs:comment 'Indicates whether the employee\'s net pay for this payroll record was disbursed via direct deposit (True) or by physical check (False). Used for payment method tracking and bank reconciliation.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employerFicaAmount rdf:type rdf:Property ;
    rdfs:label 'Employer Fica Amount' ;
    rdfs:comment 'Employer\'s matching share of FICA (Social Security 6.2% + Medicare 1.45%) contributions for the pay period. Represents a labor cost to Sports Entertainment beyond gross pay; required for IRS Form 941 and financial labor cost reporting.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventDayDifferentialAmount rdf:type rdf:Property ;
    rdfs:label 'Event Day Differential Amount' ;
    rdfs:comment 'Additional shift differential pay earned for hours worked on event days (game days, concert days, live events). Specific to Sports Entertainment operations where event-day staffing commands premium compensation per CBA or employment agreements.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:federalIncomeTaxWithheld rdf:type rdf:Property ;
    rdfs:label 'Federal Income Tax Withheld' ;
    rdfs:comment 'Total federal income tax withheld from the employee\'s gross pay for the pay period per IRS withholding tables and the employee\'s W-4 filing status. Required for IRS Form 941 and W-2 reporting.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ficaMedicareAmount rdf:type rdf:Property ;
    rdfs:label 'Fica Medicare Amount' ;
    rdfs:comment 'Employee\'s share of Federal Insurance Contributions Act (FICA) Medicare tax withheld for the pay period. Calculated at the statutory rate (1.45%), with additional 0.9% for high earners. Required for IRS Form 941 and W-2 reporting.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ficaSocialSecurityAmount rdf:type rdf:Property ;
    rdfs:label 'Fica Social Security Amount' ;
    rdfs:comment 'Employee\'s share of Federal Insurance Contributions Act (FICA) Social Security tax withheld for the pay period. Calculated at the statutory rate (6.2%) up to the annual wage base limit. Required for IRS Form 941 and W-2 reporting.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:garnishmentAmount rdf:type rdf:Property ;
    rdfs:label 'Garnishment Amount' ;
    rdfs:comment 'Total court-ordered or legally mandated wage garnishment deductions applied to the employee\'s pay for the period. Includes child support, tax levies, creditor garnishments, and student loan garnishments per applicable court orders.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossPayAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Pay Amount' ;
    rdfs:comment 'Total pre-tax compensation earned by the employee for the pay period, including base pay, overtime, shift differentials, and all other earnings components before any deductions. Expressed in USD.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:localIncomeTaxWithheld rdf:type rdf:Property ;
    rdfs:label 'Local Income Tax Withheld' ;
    rdfs:comment 'Total local/municipal income tax withheld from the employee\'s gross pay for the pay period. Applicable in jurisdictions with local income taxes (e.g., city taxes in markets where Sports Entertainment operates venues).' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netPayAmount rdf:type rdf:Property ;
    rdfs:label 'Net Pay Amount' ;
    rdfs:comment 'Total take-home pay disbursed to the employee after all tax withholdings, benefit deductions, union dues, garnishments, and other deductions have been subtracted from gross pay. Expressed in USD.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overnightDifferentialAmount rdf:type rdf:Property ;
    rdfs:label 'Overnight Differential Amount' ;
    rdfs:comment 'Additional shift differential pay earned for hours worked during overnight shifts (typically midnight to 6 AM). Applicable to venue operations, security, and broadcast crews working overnight at Sports Entertainment facilities.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overtimeHours rdf:type rdf:Property ;
    rdfs:label 'Overtime Hours' ;
    rdfs:comment 'Total number of overtime hours worked by the employee during the pay period, as defined by FLSA thresholds (hours exceeding 40 per workweek) or applicable CBA provisions for Sports Entertainment event and broadcast crews.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overtimePayAmount rdf:type rdf:Property ;
    rdfs:label 'Overtime Pay Amount' ;
    rdfs:comment 'Total premium compensation paid for overtime hours worked during the pay period. Calculated at the applicable overtime rate (typically 1.5x base rate) per FLSA or CBA requirements.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payDate rdf:type rdf:Property ;
    rdfs:label 'Pay Date' ;
    rdfs:comment 'The actual date on which the employee\'s net pay was disbursed via direct deposit or check. Used for cash flow reporting and payroll audit compliance.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payGroupCode rdf:type rdf:Property ;
    rdfs:label 'Pay Group Code' ;
    rdfs:comment 'SAP SuccessFactors pay group identifier that clusters employees sharing the same payroll processing schedule, pay frequency, and payroll area (e.g., FT-STAFF, PT-EVENT, BROADCAST-CREW, LEAGUE-OFFICIAL).' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Pay Period End Date' ;
    rdfs:comment 'The last calendar date of the pay period covered by this payroll record. Defines the closing boundary of the earnings window for compensation calculation.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Pay Period Start Date' ;
    rdfs:comment 'The first calendar date of the pay period covered by this payroll record. Together with pay_period_end_date defines the earnings window for which compensation is calculated.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payrollRunDate rdf:type rdf:Property ;
    rdfs:label 'Payroll Run Date' ;
    rdfs:comment 'The date on which the payroll processing run was executed in SAP SuccessFactors. Distinct from pay_date; used for payroll audit trails and reconciliation.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regularHoursWorked rdf:type rdf:Property ;
    rdfs:label 'Regular Hours Worked' ;
    rdfs:comment 'Total regular (non-overtime) hours worked by the employee during the pay period. Used for hourly pay calculation, FLSA compliance tracking, and workforce capacity reporting.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retirementContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Retirement Contribution Amount' ;
    rdfs:comment 'Employee\'s elective deferral contribution to qualified retirement plans (401(k), 403(b)) deducted from pay for the period. Tracked separately from general benefit deductions for IRS annual contribution limit compliance and plan reporting.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateIncomeTaxWithheld rdf:type rdf:Property ;
    rdfs:label 'State Income Tax Withheld' ;
    rdfs:comment 'Total state income tax withheld from the employee\'s gross pay for the pay period per applicable state tax authority requirements. Varies by state of employment; critical for multi-state Sports Entertainment operations.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDeductionsAmount rdf:type rdf:Property ;
    rdfs:label 'Total Deductions Amount' ;
    rdfs:comment 'Sum of all deductions applied to gross pay for the period, including taxes, FICA, union dues, garnishments, and benefit deductions. Reconciliation field: gross_pay_amount minus total_deductions_amount equals net_pay_amount.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unionDuesAmount rdf:type rdf:Property ;
    rdfs:label 'Union Dues Amount' ;
    rdfs:comment 'Total union dues deducted from the employee\'s pay for the period per Collective Bargaining Agreement (CBA) obligations. Applicable to unionized Sports Entertainment workforce including event crew, broadcast technicians, and league officials.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ytdFederalTaxWithheld rdf:type rdf:Property ;
    rdfs:label 'Ytd Federal Tax Withheld' ;
    rdfs:comment 'Cumulative federal income tax withheld from the employee\'s pay from the start of the calendar year through this pay period. Required for IRS Form W-2 Box 2 reporting and annual tax reconciliation.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ytdFicaSocialSecurityAmount rdf:type rdf:Property ;
    rdfs:label 'Ytd Fica Social Security Amount' ;
    rdfs:comment 'Cumulative employee FICA Social Security tax withheld from the start of the calendar year through this pay period. Used to track against the annual Social Security wage base limit and for IRS Form W-2 Box 4 reporting.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ytdGrossPayAmount rdf:type rdf:Property ;
    rdfs:label 'Ytd Gross Pay Amount' ;
    rdfs:comment 'Cumulative gross pay earned by the employee from the start of the calendar year through the end of this pay period. Required for FICA wage base tracking, W-2 preparation, and annual compensation reporting.' ;
    rdfs:domain ind:PayrollRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:developmentPlanId rdf:type rdf:Property ;
    rdfs:label 'Development Plan Id' ;
    rdfs:comment 'Reference to the Individual Development Plan (IDP) created in SAP SuccessFactors as a follow-up action from this performance review, capturing learning and growth objectives.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DevelopmentPlan .

ind:hrBusinessPartnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Hr Business Partner Employee Id' ;
    rdfs:comment 'Reference to the HR Business Partner responsible for overseeing the review process for this employee\'s department or business unit.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryPerformanceEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Performance Employee Id' ;
    rdfs:comment 'Reference to the employee whose performance is being evaluated. Links to the workforce employee master record in SAP SuccessFactors.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryPerformancePositionId rdf:type rdf:Property ;
    rdfs:label 'Primary Performance Position Id' ;
    rdfs:comment 'Reference to the organizational position held by the employee at the time of the review, capturing role context for succession planning.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Position .

ind:reviewFormId rdf:type rdf:Property ;
    rdfs:label 'Review Form Id' ;
    rdfs:comment 'Reference to the performance review form template used for this evaluation cycle, as configured in SAP SuccessFactors.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReviewForm .

ind:tertiaryPerformanceHrBusinessPartnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Performance Hr Business Partner Employee Id' ;
    rdfs:comment 'Reference to the HR Business Partner responsible for overseeing the review process for this employee\'s department or business unit.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:acknowledgedDate rdf:type rdf:Property ;
    rdfs:label 'Acknowledged Date' ;
    rdfs:comment 'The date on which the employee formally acknowledged receipt and review of their completed performance evaluation in SAP SuccessFactors.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calibratedRating rdf:type rdf:Property ;
    rdfs:label 'Calibrated Rating' ;
    rdfs:comment 'The final performance rating after HR calibration session adjustments. May differ from the manager\'s original overall_rating if the calibration panel modified the score.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calibrationDate rdf:type rdf:Property ;
    rdfs:label 'Calibration Date' ;
    rdfs:comment 'The date on which the performance rating was reviewed and validated in an HR calibration session to ensure consistency and fairness across the organization.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calibrationStatus rdf:type rdf:Property ;
    rdfs:label 'Calibration Status' ;
    rdfs:comment 'Indicates the current state of the HR calibration process for this review. Calibration ensures rating consistency across departments and business units within Sports Entertainment.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competencyRating rdf:type rdf:Property ;
    rdfs:label 'Competency Rating' ;
    rdfs:comment 'Numeric rating reflecting the employee\'s demonstrated behavioral competencies (e.g., leadership, collaboration, communication, innovation) as assessed by the manager during the review period.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:developmentGapAssessment rdf:type rdf:Property ;
    rdfs:label 'Development Gap Assessment' ;
    rdfs:comment 'Free-text or structured narrative describing the competency and skill gaps the employee must address to be ready for the succession target position or next career level.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goalAchievementRating rdf:type rdf:Property ;
    rdfs:label 'Goal Achievement Rating' ;
    rdfs:comment 'Numeric rating reflecting the degree to which the employee achieved their defined performance goals and Key Performance Indicators (KPIs) during the review period.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCbaCovered rdf:type rdf:Property ;
    rdfs:label 'Is Cba Covered' ;
    rdfs:comment 'Indicates whether the employee is covered by a Collective Bargaining Agreement (CBA) at the time of the review. CBA-covered employees may have specific review process requirements and rating constraints.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managerComments rdf:type rdf:Property ;
    rdfs:label 'Manager Comments' ;
    rdfs:comment 'Free-text narrative provided by the reviewing manager summarizing the employee\'s performance, strengths, development areas, and behavioral observations during the review period.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meritIncreasePct rdf:type rdf:Property ;
    rdfs:label 'Merit Increase Pct' ;
    rdfs:comment 'The recommended merit salary increase percentage for the employee based on their performance rating. Expressed as a percentage of current base salary. Confidential compensation data.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meritIncreaseRecommended rdf:type rdf:Property ;
    rdfs:label 'Merit Increase Recommended' ;
    rdfs:comment 'Indicates whether the employee is recommended for a merit-based salary increase based on their performance rating outcome. Feeds into the compensation planning cycle.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nineBoxPlacement rdf:type rdf:Property ;
    rdfs:label 'Nine Box Placement' ;
    rdfs:comment 'The employee\'s placement on the 9-box talent grid (performance vs. potential matrix) as determined during the calibration session. Used for succession planning and talent pipeline segmentation. [ENUM-REF-CANDIDATE: high_performer_high_potential|high_performer_medium_potential|high_performer_low_potential|medium_performer_high_potential|medium_performer_medium_potential|medium_performer_low_potential|low_performer_high_potential|low_performer_medium_potential|low_performer_low_potential — promote to reference product]' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallRating rdf:type rdf:Property ;
    rdfs:label 'Overall Rating' ;
    rdfs:comment 'The final composite performance rating assigned to the employee for the review period, expressed on a numeric scale (e.g., 1.00–5.00). Drives merit increase eligibility and succession planning decisions.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overallRatingLabel rdf:type rdf:Property ;
    rdfs:label 'Overall Rating Label' ;
    rdfs:comment 'Descriptive label corresponding to the overall numeric performance rating. Used in HR communications, talent reviews, and succession planning discussions.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipFlag rdf:type rdf:Property ;
    rdfs:label 'Pip Flag' ;
    rdfs:comment 'Indicates whether the employee has been placed on a formal Performance Improvement Plan (PIP) as an outcome of this review. Triggers specific HR workflow and CBA-governed notification obligations.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:promotionRecommended rdf:type rdf:Property ;
    rdfs:label 'Promotion Recommended' ;
    rdfs:comment 'Indicates whether the reviewing manager has formally recommended the employee for promotion as part of this performance review cycle.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readinessTier rdf:type rdf:Property ;
    rdfs:label 'Readiness Tier' ;
    rdfs:comment 'Indicates the employee\'s assessed readiness to assume the succession target position. Used in talent pipeline planning: ready_now (immediate successor), one_to_two_years (near-term development), three_plus_years (long-term pipeline), not_ready (not currently a viable successor).' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionRiskRating rdf:type rdf:Property ;
    rdfs:label 'Retention Risk Rating' ;
    rdfs:comment 'HR assessment of the likelihood that the employee may voluntarily leave the organization. Informs targeted retention strategies and succession urgency planning for critical roles.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewCycleYear rdf:type rdf:Property ;
    rdfs:label 'Review Cycle Year' ;
    rdfs:comment 'The calendar or fiscal year of the performance review cycle (e.g., 2024). Used for year-over-year talent analytics, merit budget planning, and succession pipeline reporting.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewNumber rdf:type rdf:Property ;
    rdfs:label 'Review Number' ;
    rdfs:comment 'Externally visible business identifier for the performance review record, formatted as PR-{YEAR}-{SEQUENCE}. Used for cross-system reference and HR correspondence.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Review Period End Date' ;
    rdfs:comment 'The last date of the performance evaluation period covered by this review. Defines the end boundary of the assessment window.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Review Period Start Date' ;
    rdfs:comment 'The first date of the performance evaluation period covered by this review. Defines the start boundary of the assessment window.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:selfAssessmentComments rdf:type rdf:Property ;
    rdfs:label 'Self Assessment Comments' ;
    rdfs:comment 'Free-text narrative authored by the employee reflecting on their own performance, accomplishments, challenges, and development goals during the review period.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selfAssessmentRating rdf:type rdf:Property ;
    rdfs:label 'Self Assessment Rating' ;
    rdfs:comment 'Numeric rating the employee assigned to their own overall performance during the self-assessment phase of the review cycle. Used for calibration comparison against manager rating.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:submittedDate rdf:type rdf:Property ;
    rdfs:label 'Submitted Date' ;
    rdfs:comment 'The date on which the manager formally submitted the completed performance review for HR processing and calibration.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:successionNominated rdf:type rdf:Property ;
    rdfs:label 'Succession Nominated' ;
    rdfs:comment 'Indicates whether the employee has been nominated as a successor for a critical or target position as part of the succession planning process linked to this review cycle.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workforceSegment rdf:type rdf:Property ;
    rdfs:label 'Workforce Segment' ;
    rdfs:comment 'Classification of the employee\'s workforce category at the time of the review. Determines applicable review templates, CBA obligations, and rating scale configurations within SAP SuccessFactors.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incumbentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Incumbent Employee Id' ;
    rdfs:comment 'Identifier of the employee currently assigned to fill this position. Null if the position is vacant. Enables position-to-person mapping for org chart, payroll, and workforce reporting.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:locationFacilityId rdf:type rdf:Property ;
    rdfs:label 'Location Facility Id' ;
    rdfs:comment 'Identifier of the primary work location (venue, office, broadcast facility) associated with this position. Used for venue-based workforce planning, OSHA site compliance, and ADA accessibility reporting.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:reportsToPositionId rdf:type rdf:Property ;
    rdfs:label 'Reports To Position Id' ;
    rdfs:comment 'Self-referencing identifier of the parent position in the organizational hierarchy to which this position directly reports. Enables org chart construction, span-of-control analysis, and reporting line governance.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Position .

ind:budgetApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Budget Approval Status' ;
    rdfs:comment 'Indicates the current budget authorization state of the position. \'approved\' means the position has been funded in the annual headcount plan; \'pending\' means awaiting finance sign-off; \'rejected\' means not funded; \'on_hold\' means temporarily suspended pending budget review.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentName rdf:type rdf:Property ;
    rdfs:label 'Department Name' ;
    rdfs:comment 'Human-readable name of the organizational department to which this position belongs (e.g., \'Broadcast Operations\', \'Venue Facilities\', \'Athlete Services\'). Denormalized for reporting convenience.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eeo1Category rdf:type rdf:Property ;
    rdfs:label 'Eeo1 Category' ;
    rdfs:comment 'EEO-1 job category assigned to the position per EEOC reporting requirements. Used to classify positions for annual EEO-1 Component 1 workforce demographic reporting submitted to the U.S. Equal Employment Opportunity Commission. [ENUM-REF-CANDIDATE: Executive/Senior Officials|First/Mid Officials|Professionals|Technicians|Sales Workers|Administrative Support|Craft Workers|Operatives|Laborers|Service Workers — promote to reference product]' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filledDate rdf:type rdf:Property ;
    rdfs:label 'Filled Date' ;
    rdfs:comment 'The date on which an incumbent was assigned to fill this position. Used to calculate time-to-fill KPIs, vacancy duration analysis, and recruitment performance reporting.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fteAllocation rdf:type rdf:Property ;
    rdfs:label 'Fte Allocation' ;
    rdfs:comment 'The Full-Time Equivalent (FTE) value assigned to this position, representing the proportion of a full-time workload (e.g., 1.0 = full-time, 0.5 = half-time). Used for headcount governance, budget planning, and workforce capacity analysis.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:headcountPlanYear rdf:type rdf:Property ;
    rdfs:label 'Headcount Plan Year' ;
    rdfs:comment 'The fiscal year in which this position was approved in the headcount plan (e.g., 2025). Used to align position records with annual workforce planning cycles and budget periods.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isKeyPosition rdf:type rdf:Property ;
    rdfs:label 'Is Key Position' ;
    rdfs:comment 'Indicates whether this position is designated as a key or critical role for succession planning purposes. True = key position requiring a succession plan; False = standard position. Used in SAP SuccessFactors Succession & Development.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSafetySensitive rdf:type rdf:Property ;
    rdfs:label 'Is Safety Sensitive' ;
    rdfs:comment 'Indicates whether the position is classified as safety-sensitive under OSHA regulations, requiring additional pre-employment screening, drug testing, and ongoing safety compliance monitoring (e.g., field crew, electrical technicians, event security).' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isUnionEligible rdf:type rdf:Property ;
    rdfs:label 'Is Union Eligible' ;
    rdfs:comment 'Indicates whether the position is eligible for union membership under applicable labor agreements. True = union-eligible; False = non-union. Critical for CBA compliance, labor relations management, and payroll processing.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jobLevel rdf:type rdf:Property ;
    rdfs:label 'Job Level' ;
    rdfs:comment 'Career level designation indicating the seniority and scope of the position within the organizational hierarchy. Used for compensation banding, succession planning, and workforce segmentation. [ENUM-REF-CANDIDATE: Individual Contributor|Senior Individual Contributor|Manager|Senior Manager|Director|Senior Director|Vice President|Senior Vice President|Executive — promote to reference product]' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leagueEntityCode rdf:type rdf:Property ;
    rdfs:label 'League Entity Code' ;
    rdfs:comment 'Code identifying the specific league, sports property, or business entity (e.g., NFL franchise, NBA team, MLS club, broadcast network) to which this position is assigned. Enables workforce segmentation across multi-league and multi-entity operations.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxIncumbents rdf:type rdf:Property ;
    rdfs:label 'Max Incumbents' ;
    rdfs:comment 'The maximum number of employees that can be assigned to this position simultaneously (typically 1 for standard positions; may be greater for shared or pooled positions such as event-day crew pools). Used for headcount governance.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:payRangeMax rdf:type rdf:Property ;
    rdfs:label 'Pay Range Max' ;
    rdfs:comment 'Maximum annual base salary (in USD) defined for this position\'s pay grade band. Used for compensation benchmarking, offer management, and budget planning. Confidential as it reveals internal compensation structure.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payRangeMin rdf:type rdf:Property ;
    rdfs:label 'Pay Range Min' ;
    rdfs:comment 'Minimum annual base salary (in USD) defined for this position\'s pay grade band. Used for compensation benchmarking, offer management, and budget planning. Confidential as it reveals internal compensation structure.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionType rdf:type rdf:Property ;
    rdfs:label 'Position Type' ;
    rdfs:comment 'Classification of the position by employment duration and engagement model. \'permanent\' denotes year-round full-time roles; \'seasonal\' denotes roles tied to a sports season or event cycle; \'event_day\' denotes roles activated only on event days (e.g., ushers, security); \'contract\' denotes fixed-term engagements; \'part_time\' denotes recurring part-time roles.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remoteWorkEligibility rdf:type rdf:Property ;
    rdfs:label 'Remote Work Eligibility' ;
    rdfs:comment 'Indicates the remote work classification for this position. \'on_site\' requires physical presence (e.g., venue operations, event-day staff); \'hybrid\' allows partial remote; \'remote\' is fully remote-eligible; \'not_eligible\' applies to positions with mandatory on-site requirements.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresBackgroundCheck rdf:type rdf:Property ;
    rdfs:label 'Requires Background Check' ;
    rdfs:comment 'Indicates whether incumbents in this position are required to pass a background check as a condition of employment. Driven by venue security requirements, league governance mandates, and regulatory compliance.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresCredential rdf:type rdf:Property ;
    rdfs:label 'Requires Credential' ;
    rdfs:comment 'Indicates whether the position requires a specific professional credential, license, or certification (e.g., EMT certification for medical staff, broadcast engineering license, security guard license). Drives compliance tracking in SAP SuccessFactors.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:successionReadiness rdf:type rdf:Property ;
    rdfs:label 'Succession Readiness' ;
    rdfs:comment 'Indicates the succession readiness state for this key position, reflecting whether a qualified successor is identified and ready. Used in talent review and succession planning processes.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vacancyReason rdf:type rdf:Property ;
    rdfs:label 'Vacancy Reason' ;
    rdfs:comment 'Reason code explaining why the position is currently vacant. Used for workforce analytics, attrition reporting, and recruitment prioritization. [ENUM-REF-CANDIDATE: new_position|resignation|termination|retirement|transfer|leave_of_absence|promotion — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Work Schedule Code' ;
    rdfs:comment 'Code identifying the standard work schedule pattern assigned to this position (e.g., standard 40-hour week, event-day shift, rotating broadcast schedule). Sourced from SAP SuccessFactors Time Management.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualHoursWorked rdf:type rdf:Property ;
    rdfs:label 'Actual Hours Worked' ;
    rdfs:comment 'Total compensable hours worked during the shift after deducting unpaid break time. Feeds directly into payroll processing. Supports FLSA audit trails and CBA overtime compliance calculations.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assignedLocation rdf:type rdf:Property ;
    rdfs:label 'Assigned Location' ;
    rdfs:comment 'Specific location within the venue or facility where the employee is assigned during the shift (e.g., \'Gate 4 Entry\', \'Press Box Level 3\', \'Broadcast Truck Bay 2\', \'Main Office Floor 5\'). Supports venue operations management and OSHA safety compliance.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakDeductionHours rdf:type rdf:Property ;
    rdfs:label 'Break Deduction Hours' ;
    rdfs:comment 'Total unpaid break time deducted from gross hours to arrive at compensable actual hours worked. Includes meal breaks and rest periods per FLSA and applicable state labor laws.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cbaRuleCode rdf:type rdf:Property ;
    rdfs:label 'Cba Rule Code' ;
    rdfs:comment 'Code identifying the specific Collective Bargaining Agreement (CBA) provision or rule set applied to this shift for pay calculation (e.g., overtime thresholds, rest period requirements, event-day premiums). Critical for union labor compliance and grievance resolution.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doubleTimeHours rdf:type rdf:Property ;
    rdfs:label 'Double Time Hours' ;
    rdfs:comment 'Hours worked at 2x the regular pay rate, typically triggered by CBA provisions for extended shifts, consecutive days worked, or specific event-day conditions. Feeds into payroll processing and labor cost reporting.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventDayPremiumHours rdf:type rdf:Property ;
    rdfs:label 'Event Day Premium Hours' ;
    rdfs:comment 'Hours eligible for event-day premium pay as defined in CBA agreements for staff working live sports or entertainment events. Distinct from standard overtime; reflects sports-entertainment industry-specific compensation structures.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flsaExemptionStatus rdf:type rdf:Property ;
    rdfs:label 'Flsa Exemption Status' ;
    rdfs:comment 'FLSA exemption classification for the employee on this shift. Determines whether overtime pay provisions apply. \'non_exempt\' employees are entitled to FLSA overtime protections; exempt categories are not. Required for FLSA audit trail compliance.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hourlyRate rdf:type rdf:Property ;
    rdfs:label 'Hourly Rate' ;
    rdfs:comment 'Employee\'s base hourly compensation rate applicable to this shift in local currency. Used as the base for regular, overtime, and double-time pay calculations. Classified as confidential financial data.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laborCostAmount rdf:type rdf:Property ;
    rdfs:label 'Labor Cost Amount' ;
    rdfs:comment 'Total gross labor cost for this shift assignment calculated as actual hours worked multiplied by applicable pay rates (regular + overtime + double-time + premiums). Feeds event staffing labor cost tracking and EBITDA reporting via SAP S/4HANA CO.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managerApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Manager Approval Status' ;
    rdfs:comment 'Current approval workflow status of the timesheet for this shift. \'pending\' = awaiting manager review; \'approved\' = manager confirmed hours; \'rejected\' = returned for correction; \'escalated\' = routed to HR or payroll for exception handling. Required for payroll processing gate.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerApprovalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Manager Approval Timestamp' ;
    rdfs:comment 'Date and time when the manager approved or rejected the timesheet for this shift. Provides audit trail for SOX financial controls and payroll processing compliance. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:noShowFlag rdf:type rdf:Property ;
    rdfs:label 'No Show Flag' ;
    rdfs:comment 'Indicates whether the employee failed to report for a scheduled shift without prior notification. True when assignment_status = \'no_show\'. Triggers HR attendance management workflows and may affect CBA disciplinary provisions.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onCallHours rdf:type rdf:Property ;
    rdfs:label 'On Call Hours' ;
    rdfs:comment 'Hours the employee was designated on-call and available for deployment, compensated per CBA on-call provisions. Common for broadcast crews, medical staff, and event operations personnel.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oshaHoursOfServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Osha Hours Of Service Flag' ;
    rdfs:comment 'Indicates whether this shift triggers an OSHA hours-of-service review due to extended duration, insufficient rest between shifts, or hazardous work environment conditions. True when OSHA thresholds are approached or exceeded.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payGradeCode rdf:type rdf:Property ;
    rdfs:label 'Pay Grade Code' ;
    rdfs:comment 'Pay grade or compensation band code applicable to the employee for this shift, sourced from SAP SuccessFactors compensation management. Determines base hourly rate for payroll calculation. Classified as confidential business data.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payrollPeriod rdf:type rdf:Property ;
    rdfs:label 'Payroll Period' ;
    rdfs:comment 'Payroll period identifier to which this shift record is assigned for compensation processing (e.g., \'2024-11-W2\' for bi-weekly or \'2024-11-M\' for monthly). Aligns with SAP S/4HANA payroll run cycles.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payrollProcessingStatus rdf:type rdf:Property ;
    rdfs:label 'Payroll Processing Status' ;
    rdfs:comment 'Status of this shift record within the payroll processing pipeline. \'not_submitted\' = pending manager approval; \'submitted\' = sent to payroll; \'processed\' = included in payroll run; \'on_hold\' = flagged for manual review; \'error\' = processing failure requiring correction. Feeds SAP S/4HANA FI payroll integration.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regularHours rdf:type rdf:Property ;
    rdfs:label 'Regular Hours' ;
    rdfs:comment 'Hours worked at the standard straight-time pay rate, not exceeding the CBA or FLSA threshold for overtime. Component of the pay calculation triplet (regular + overtime + double-time = actual hours worked).' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roleDuringShift rdf:type rdf:Property ;
    rdfs:label 'Role During Shift' ;
    rdfs:comment 'Specific functional role the employee performs during this shift (e.g., \'Head Usher\', \'Broadcast Director\', \'Security Supervisor\', \'Concessions Lead\'). May differ from the employee\'s primary position for cross-trained or flex-deployed staff.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledHours rdf:type rdf:Property ;
    rdfs:label 'Scheduled Hours' ;
    rdfs:comment 'Total number of hours the employee is scheduled to work during this shift, derived from scheduled start and end times minus planned breaks. Used for pre-event labor cost forecasting and CBA compliance checks.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shiftNotes rdf:type rdf:Property ;
    rdfs:label 'Shift Notes' ;
    rdfs:comment 'Free-text notes entered by the employee or manager regarding this shift assignment (e.g., early departure reason, equipment issues, special event conditions). Supports exception management and HR documentation.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Shift Reference Number' ;
    rdfs:comment 'Externally-known business identifier for the shift assignment, generated by SAP SuccessFactors Time and Attendance. Used in payroll processing, manager communications, and audit trails. Format: SHF-YYYYMMDD-XXXXXX.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timesheetSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Timesheet Submission Date' ;
    rdfs:comment 'Date on which the employee submitted the timesheet for this shift in SAP SuccessFactors. Used to track submission timeliness, enforce payroll cutoff deadlines, and audit late submissions.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:travelTimeHours rdf:type rdf:Property ;
    rdfs:label 'Travel Time Hours' ;
    rdfs:comment 'Compensable travel time hours recorded for employees traveling to away events, broadcast locations, or multi-venue assignments per FLSA and CBA travel pay provisions.' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workerCategory rdf:type rdf:Property ;
    rdfs:label 'Worker Category' ;
    rdfs:comment 'Classification of the worker type for this shift assignment. Determines applicable CBA provisions, benefit eligibility, and payroll processing rules. [ENUM-REF-CANDIDATE: full_time|part_time|seasonal|event_crew|broadcast_crew|league_official — promote to reference product]' ;
    rdfs:domain ind:ShiftAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generalManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'General Manager Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Every sports venue has a General Manager (employee) responsible for overall venue P&L, league compliance, and tenant relations. Executive reporting, naming rights negotiations, and league governance r' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:iso20121CertExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Iso 20121 Cert Expiry Date' ;
    rdfs:comment 'Expiry date of the venue\'s ISO 20121 Event Sustainability Management System certification. Triggers recertification workflows and may affect eligibility for international event bids.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leagueAffiliationCode rdf:type rdf:Property ;
    rdfs:label 'League Affiliation Code' ;
    rdfs:comment 'Official code identifying the primary professional league or governing body the venue is affiliated with (e.g., NFL, NBA, MLB, NHL, MLS, FIFA). Drives league-specific compliance requirements, broadcast rights assignments, and CBA obligations.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:namingRightsExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Naming Rights Expiry Date' ;
    rdfs:comment 'Date on which the current naming-rights sponsorship agreement expires. Triggers renewal pipeline activity in Salesforce CRM and venue_name update workflows. Commercially sensitive contract data.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:namingRightsHolder rdf:type rdf:Property ;
    rdfs:label 'Naming Rights Holder' ;
    rdfs:comment 'Name of the corporate sponsor that has purchased naming rights for the venue. Commercially sensitive sponsorship data managed in Salesforce CRM. Impacts venue_name display and brand compliance obligations.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaSafetyRating rdf:type rdf:Property ;
    rdfs:label 'Osha Safety Rating' ;
    rdfs:comment 'Current OSHA occupational safety and health compliance rating for the venue as determined by the most recent regulatory inspection. Drives event hosting eligibility and insurance premium calculations.' ;
    rdfs:domain ind:Venue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creatorDealId rdf:type rdf:Property ;
    rdfs:label 'Creator Deal Id' ;
    rdfs:comment 'Primary key for the creator_deal association' ;
    rdfs:domain ind:CreatorDeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:partnershipId rdf:type rdf:Property ;
    rdfs:label 'Partnership Id' ;
    rdfs:comment 'Primary key for the league_partnership association' ;
    rdfs:domain ind:Partnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualValue rdf:type rdf:Property ;
    rdfs:label 'Annual Value' ;
    rdfs:comment 'The total annual contracted financial value of the partnership agreement in the payment currency. Represents the combined cash, media, and in-kind value committed by the vendor to the league per contract year. Belongs to the relationship, not to either the league or vendor master.' ;
    rdfs:domain ind:Partnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:officialDesignation rdf:type rdf:Property ;
    rdfs:label 'Official Designation' ;
    rdfs:comment 'The formal official title granted to the vendor by the league (e.g., \'Official Ball Supplier\', \'Official Timing Partner\', \'Official Apparel Partner\'). This designation is the core business artifact of the partnership and appears in marketing, broadcast, and licensing materials.' ;
    rdfs:domain ind:Partnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryBroadcastPartner rdf:type rdf:Property ;
    rdfs:label 'Primary Broadcast Partner' ;
    rdfs:comment 'Name of the primary national or international broadcast rights holder for this league (e.g., \'ESPN/ABC\', \'NBC Sports\', \'Sky Sports\', \'beIN Sports\'). Used for rights management, content distribution planning, and sponsor activation. [Moved from league: This denormalized STRING attribute on the league master stores the name of the primary broadcast rights holder — a specific instance of a league-vendor partnership. The correct model is a record in league_partnership with official_designation = \'Official Broadcast Partner\' and category_exclusivity_flag = TRUE, linked via vendor_id to the vendor master. Storing a vendor name as a string on the league record violates normalization and creates a data quality risk when the broadcast partner changes. This attribute should be removed from league and replaced by a query against league_partnership filtered by official_designation category.]' ;
    rdfs:domain ind:Partnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipLicenseGrantId rdf:type rdf:Property ;
    rdfs:label 'Ip License Grant Id' ;
    rdfs:comment 'Primary key for the ip_license_grant association' ;
    rdfs:domain ind:IpLicenseGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:licenseGrantType rdf:type rdf:Property ;
    rdfs:label 'License Grant Type' ;
    rdfs:comment 'Classification of the license grant by exclusivity and sublicensing rights. Determines whether the vendor holds exclusive rights to the IP asset within the defined territory and scope, or whether Sports Entertainment may grant the same rights to other vendors concurrently.' ;
    rdfs:domain ind:IpLicenseGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseTermEnd rdf:type rdf:Property ;
    rdfs:label 'License Term End' ;
    rdfs:comment 'The date on which this specific IP license grant expires. May differ from the parent vendor contract expiration_date if the IP licensing provision has a shorter or independently negotiated term.' ;
    rdfs:domain ind:IpLicenseGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseTermStart rdf:type rdf:Property ;
    rdfs:label 'License Term Start' ;
    rdfs:comment 'The date on which this specific IP license grant becomes effective. May differ from the parent vendor contract effective_date if the IP licensing provision has its own commencement date.' ;
    rdfs:domain ind:IpLicenseGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetAllocationId rdf:type rdf:Property ;
    rdfs:label 'Budget Allocation Id' ;
    rdfs:comment 'Primary key for the budget_allocation association' ;
    rdfs:domain ind:BudgetAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocatedAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Amount' ;
    rdfs:comment 'The planned budget amount allocated to this specific org unit from the parent budget record for the fiscal period. Sourced from the relationship_data field \'budget_amount\' identified in the detection phase. This amount belongs to the allocation, not to the budget or org unit alone.' ;
    rdfs:domain ind:BudgetAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocatedHeadcountBudget rdf:type rdf:Property ;
    rdfs:label 'Allocated Headcount Budget' ;
    rdfs:comment 'Approved full-time equivalent (FTE) headcount budget allocated to this org unit under this specific budget record and fiscal year. Sourced from relationship_data \'headcount_budget\'. Moved from org_unit because headcount budget varies by fiscal year and budget version — it is a property of the allocation, not a static org unit attribute.' ;
    rdfs:domain ind:BudgetAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Budget Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the operating budget of this organizational unit (e.g., \'USD\', \'GBP\', \'EUR\'). Used for multi-currency financial consolidation in SAP S/4HANA and Workday Adaptive Planning. [Moved from org_unit: The operating budget currency for an org unit is relevant only in the context of a specific budget allocation. As a static org_unit attribute it cannot accommodate multi-currency allocations across different fiscal years or budget scenarios. It belongs on the allocation record as \'currency_code\'.]' ;
    rdfs:domain ind:BudgetAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headcountBudget rdf:type rdf:Property ;
    rdfs:label 'Headcount Budget' ;
    rdfs:comment 'Approved full-time equivalent (FTE) headcount budget for this organizational unit as authorized in the annual workforce plan. Used for headcount variance reporting, recruitment approval workflows, and span-of-control governance. [Moved from org_unit: Approved FTE headcount budget is a planning-cycle attribute that changes with each annual budget and reforecast. It is not a static property of the org unit — it is a property of the allocation of headcount to that org unit for a specific fiscal year and budget version. Moving it to the association enables proper versioning and variance tracking against fte_count_actual.]' ;
    rdfs:domain ind:BudgetAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:broadcastRightsTier rdf:type rdf:Property ;
    rdfs:label 'Broadcast Rights Tier' ;
    rdfs:comment 'Classification of the league\'s broadcast rights value tier, used to categorize RSN (Regional Sports Network), national, and OTT (Over-The-Top Streaming) rights packaging. Drives revenue forecasting, CPM rate card setting, and DTC platform strategy. [Moved from league: The league-level broadcast_rights_tier is a summary/default classification, but the actual rights tier is per-channel-per-league agreement and varies by channel, territory, and exclusivity. The authoritative value belongs on the association as rights_tier. The league-level attribute may be retained as a summary/default but should not be the system of record.]' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Flag' ;
    rdfs:comment 'Indicates whether this channel is the primary (flagship) broadcast partner for this league within the agreed territory. A league may have multiple channels but only one primary partner per territory. Belongs to the agreement, not to the channel or league independently.' ;
    rdfs:domain ind:RightsAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rightsTier rdf:type rdf:Property ;
    rdfs:label 'Rights Tier' ;
    rdfs:comment 'Classification of the broadcast rights value tier for this specific channel-league agreement. Determines revenue sharing, production obligations, and promotional commitments. Belongs to the agreement, not to the channel or league independently.' ;
    rdfs:domain ind:RightsAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionCostAllocationId rdf:type rdf:Property ;
    rdfs:label 'Position Cost Allocation Id' ;
    rdfs:comment 'Primary key for the position_cost_allocation association' ;
    rdfs:domain ind:PositionCostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Allocation Percentage' ;
    rdfs:comment 'The proportion of the position\'s total FTE and labor cost charged to this cost center, expressed as a decimal (e.g., 0.60 = 60%). All allocation_percentage values for a given position_id must sum to 1.00 across active records.' ;
    rdfs:domain ind:PositionCostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isPrimaryCostCenter rdf:type rdf:Property ;
    rdfs:label 'Is Primary Cost Center' ;
    rdfs:comment 'Indicates whether this cost center is the primary (majority) funding source for the position. Used to determine the default cost center for reporting and payroll posting when a single cost center must be nominated.' ;
    rdfs:domain ind:PositionCostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:channelActivationId rdf:type rdf:Property ;
    rdfs:label 'Channel Activation Id' ;
    rdfs:comment 'Primary key for the channel_activation association' ;
    rdfs:domain ind:ChannelActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activationEndDate rdf:type rdf:Property ;
    rdfs:label 'Activation End Date' ;
    rdfs:comment 'Date on which this deal\'s activation on this specific channel ends. May differ from the deal\'s campaign_flight_end_date if channel decommission or rights windows vary.' ;
    rdfs:domain ind:ChannelActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:activationStartDate rdf:type rdf:Property ;
    rdfs:label 'Activation Start Date' ;
    rdfs:comment 'Date on which this deal\'s activation on this specific channel begins. May differ from the deal\'s campaign_flight_start_date if channel go-live dates are staggered.' ;
    rdfs:domain ind:ChannelActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contentPlacementId rdf:type rdf:Property ;
    rdfs:label 'Content Placement Id' ;
    rdfs:comment 'Primary key for the venue_content_placement association' ;
    rdfs:domain ind:ContentPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:displayChannelType rdf:type rdf:Property ;
    rdfs:label 'Display Channel Type' ;
    rdfs:comment 'The AV delivery channel or system type used to push the content asset to the display zone. Drives technical routing and encoding requirements for the placement.' ;
    rdfs:domain ind:ContentPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Display End Datetime' ;
    rdfs:comment 'Date and time when the content placement window closes and the asset is deactivated from display in the specified zone at this facility. Used for rights expiry enforcement and AV system deactivation.' ;
    rdfs:domain ind:ContentPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:displayRightsStatus rdf:type rdf:Property ;
    rdfs:label 'Display Rights Status' ;
    rdfs:comment 'Current rights clearance state for this specific facility-asset placement combination. A single asset may be cleared for display at one venue but restricted at another due to territorial or contractual rights constraints. This status is distinct from the asset-level drm_status on the content.asset master.' ;
    rdfs:domain ind:ContentPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Display Start Datetime' ;
    rdfs:comment 'Date and time when the content placement window opens and the asset becomes active for display in the specified zone at this facility. Used for scheduling, rights window enforcement, and AV system activation.' ;
    rdfs:domain ind:ContentPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:displayZone rdf:type rdf:Property ;
    rdfs:label 'Display Zone' ;
    rdfs:comment 'Identifies the specific physical AV zone within the facility where the content asset is scheduled for display. A single facility-asset placement is scoped to one zone; multiple records cover multiple zones for the same asset at the same venue.' ;
    rdfs:domain ind:ContentPlacement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityVendorEngagementId rdf:type rdf:Property ;
    rdfs:label 'Facility Vendor Engagement Id' ;
    rdfs:comment 'Primary key for the facility_vendor_engagement association' ;
    rdfs:domain ind:FacilityVendorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryContact rdf:type rdf:Property ;
    rdfs:label 'Primary Contact' ;
    rdfs:comment 'Full name or identifier of the vendor\'s designated operational contact for this specific facility engagement. May differ from the vendor-level primary_contact_name when the vendor assigns dedicated account managers per venue. Belongs to the engagement, not the vendor master.' ;
    rdfs:domain ind:FacilityVendorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorActivationId rdf:type rdf:Property ;
    rdfs:label 'Vendor Activation Id' ;
    rdfs:comment 'Primary key for the vendor_activation association' ;
    rdfs:domain ind:VendorActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accreditationStatus rdf:type rdf:Property ;
    rdfs:label 'Accreditation Status' ;
    rdfs:comment 'The clearance and accreditation status of the vendor (and their on-site staff/equipment) for this specific fixture. Accreditation is event-specific and may differ from the vendor\'s general risk_tier. Sourced from detection phase relationship data.' ;
    rdfs:domain ind:VendorActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activationRole rdf:type rdf:Property ;
    rdfs:label 'Activation Role' ;
    rdfs:comment 'The operational role the vendor plays at this fixture — e.g., primary supplier vs. backup or subcontractor. A vendor may hold different roles across different fixtures. Sourced from detection phase relationship data.' ;
    rdfs:domain ind:VendorActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueAllocationId rdf:type rdf:Property ;
    rdfs:label 'Revenue Allocation Id' ;
    rdfs:comment 'Primary key for the revenue_allocation association' ;
    rdfs:domain ind:RevenueAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationPct rdf:type rdf:Property ;
    rdfs:label 'Allocation Pct' ;
    rdfs:comment 'The percentage of the total revenue stream amount allocated to this franchise for the given season. For league-wide streams (e.g., national broadcast), this reflects each franchise\'s contractual share.' ;
    rdfs:domain ind:RevenueAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:platformRightsGrantId rdf:type rdf:Property ;
    rdfs:label 'Platform Rights Grant Id' ;
    rdfs:comment 'Primary key for the platform_rights_grant association' ;
    rdfs:domain ind:PlatformRightsGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:platformRightsType rdf:type rdf:Property ;
    rdfs:label 'Platform Rights Type' ;
    rdfs:comment 'The category of rights granted to this specific digital touchpoint under this deal (e.g., live streaming, replay, highlights). A deal may grant live rights to the OTT app but only highlights rights to the web portal.' ;
    rdfs:domain ind:PlatformRightsGrant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewMemberAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Crew Member Assignment Id' ;
    rdfs:comment 'Primary key for the crew_member_assignment association' ;
    rdfs:domain ind:CrewMemberAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:substitutedForOfficialId rdf:type rdf:Property ;
    rdfs:label 'Substituted For Official Id' ;
    rdfs:comment 'Reference to the original official (official_id) whom this official replaced on this crew assignment. Null when substitution_flag is false. Supports substitution audit trail and workload adjustment calculations.' ;
    rdfs:domain ind:CrewMemberAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Official .

ind:roleOnCrew rdf:type rdf:Property ;
    rdfs:label 'Role On Crew' ;
    rdfs:comment 'The specific officiating role this individual performs on this crew for this game. Determines responsibilities, positioning, and CBA compensation tier. Replaces the crew_chief_official_id and var_operator_official_id FKs on officiating_crew.' ;
    rdfs:domain ind:CrewMemberAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleLogic rdf:type rdf:Property ;
    rdfs:label 'Rule Logic' ;
    rdfs:comment 'The structured expression or named rule governing how and when this content asset is delivered to the fan segment. Sourced from the detection phase as personalization_rule. Belongs to the assignment, not to the segment or asset independently.' ;
    rdfs:domain ind:Fan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:audienceTargetingAllocationId rdf:type rdf:Property ;
    rdfs:label 'Audience Targeting Allocation Id' ;
    rdfs:comment 'Primary key for the audience_targeting_allocation association' ;
    rdfs:domain ind:AudienceTargetingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:audienceReachCommitment rdf:type rdf:Property ;
    rdfs:label 'Audience Reach Commitment' ;
    rdfs:comment 'Contracted number of fan impressions, touchpoints, or unique fan profiles the sponsor has purchased the right to reach within this segment over the allocation period. Belongs to the allocation as the commitment is specific to this sponsor-segment pairing and period.' ;
    rdfs:domain ind:AudienceTargetingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:audienceTargetingAllocationStatus rdf:type rdf:Property ;
    rdfs:label 'Audience Targeting Allocation Status' ;
    rdfs:comment 'Current lifecycle state of this audience targeting allocation. Drives workflow routing and activation eligibility for this specific sponsor-segment pairing.' ;
    rdfs:domain ind:AudienceTargetingAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:footageCameraScopeId rdf:type rdf:Property ;
    rdfs:label 'Footage Camera Scope Id' ;
    rdfs:comment 'Primary key for the footage_camera_scope association' ;
    rdfs:domain ind:FootageCameraScope ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cameraIdsRequested rdf:type rdf:Property ;
    rdfs:label 'Camera Ids Requested' ;
    rdfs:comment 'Comma-separated list of surveillance camera identifiers whose footage is being requested. References the physical camera inventory within the venue security system. [Moved from surveillance_footage_request: This comma-separated STRING field is a denormalized multi-valued FK that encodes the M:N relationship in an anti-pattern. It must be decomposed into individual footage_camera_scope records, one per camera per request. The field should be removed from surveillance_footage_request once the association table is populated.]' ;
    rdfs:domain ind:FootageCameraScope ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retrievalStatus rdf:type rdf:Property ;
    rdfs:label 'Retrieval Status' ;
    rdfs:comment 'Operational status of footage retrieval for this specific camera within the request. A request may be partially fulfilled if some cameras have been retrieved while others are still pending or failed (e.g., footage overwritten due to retention expiry).' ;
    rdfs:domain ind:FootageCameraScope ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueAttributionId rdf:type rdf:Property ;
    rdfs:label 'Revenue Attribution Id' ;
    rdfs:comment 'Primary key for the content_revenue_attribution association' ;
    rdfs:domain ind:RevenueAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revenueAmount rdf:type rdf:Property ;
    rdfs:label 'Revenue Amount' ;
    rdfs:comment 'The monetary amount of revenue allocated to this specific asset under this revenue stream for the defined window and territory. Used for rights valuation, royalty calculation, and segment P&L reporting. Denominated in the currency of the parent revenue stream.' ;
    rdfs:domain ind:RevenueAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketJurisdictionAvailabilityId rdf:type rdf:Property ;
    rdfs:label 'Market Jurisdiction Availability Id' ;
    rdfs:comment 'Primary key for the market_jurisdiction_availability association' ;
    rdfs:domain ind:MarketJurisdictionAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:jurisdictionSpecificMaxStake rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Specific Max Stake' ;
    rdfs:comment 'Maximum wager amount permitted for this specific market within this specific jurisdiction, expressed in the jurisdiction\'s currency. Overrides the global max_stake_amount on betting_market when a jurisdiction imposes a stricter or different limit. NULL indicates the global market limit applies.' ;
    rdfs:domain ind:MarketJurisdictionAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightsWindowChannelAuthorizationId rdf:type rdf:Property ;
    rdfs:label 'Rights Window Channel Authorization Id' ;
    rdfs:comment 'Primary key for the rights_window_channel_authorization association' ;
    rdfs:domain ind:RightsWindowChannelAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authorizationEnd rdf:type rdf:Property ;
    rdfs:label 'Authorization End' ;
    rdfs:comment 'The date and time at which this channel authorization expires. May align with or precede the parent rights window end, supporting early termination of a specific channel\'s authorization without affecting the broader window.' ;
    rdfs:domain ind:RightsWindowChannelAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:authorizationStart rdf:type rdf:Property ;
    rdfs:label 'Authorization Start' ;
    rdfs:comment 'The date and time from which this channel authorization is effective. May align with or be a subset of the parent rights window start, allowing phased channel rollouts within a single rights window.' ;
    rdfs:domain ind:RightsWindowChannelAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:authorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Authorization Status' ;
    rdfs:comment 'Current lifecycle state of this specific channel authorization. Drives whether the platform channel is permitted to distribute content under this rights window at any given moment.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionLicenseId rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction License Id' ;
    rdfs:comment 'Primary key for the jurisdiction_license association' ;
    rdfs:domain ind:JurisdictionLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignedRole rdf:type rdf:Property ;
    rdfs:label 'Assigned Role' ;
    rdfs:comment 'The specific regulatory role or designation the employee holds under this jurisdiction license. Defined by the jurisdiction\'s licensing authority and determines the scope of the employee\'s authorized activities.' ;
    rdfs:domain ind:JurisdictionLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Vendor Assignment Id' ;
    rdfs:comment 'Primary key for the vendor_assignment association' ;
    rdfs:domain ind:VendorAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accountResponsibilityScope rdf:type rdf:Property ;
    rdfs:label 'Account Responsibility Scope' ;
    rdfs:comment 'Defines the bounded scope of the employee\'s responsibility within this vendor assignment. Distinguishes employees who own the full account from those with a narrower functional scope (e.g., payment processing only). Sourced from detection phase account_responsibility_scope attribute.' ;
    rdfs:domain ind:VendorAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Flag' ;
    rdfs:comment 'Indicates whether this employee is the designated primary point of contact for the vendor. Only one active assignment per vendor should carry this flag as TRUE at any given time. Sourced from detection phase primary_contact_flag attribute.' ;
    rdfs:domain ind:VendorAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relationshipRole rdf:type rdf:Property ;
    rdfs:label 'Relationship Role' ;
    rdfs:comment 'The functional role the employee plays in managing the vendor relationship. Determines the nature of the employee\'s responsibility — e.g., ACCOUNT_MANAGER is the primary commercial owner, LEGAL_LIAISON handles contract and compliance matters, AP_CONTACT manages payment and invoicing interactions. Sourced from detection phase relationship_role attribute.' ;
    rdfs:domain ind:VendorAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venueActivationId rdf:type rdf:Property ;
    rdfs:label 'Venue Activation Id' ;
    rdfs:comment 'Primary key for the activation association' ;
    rdfs:domain ind:VenueActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:zone rdf:type rdf:Property ;
    rdfs:label 'Zone' ;
    rdfs:comment 'The designated zone or area within the facility where the sponsorship activation is deployed (e.g., main concourse, field-level, premium club, digital fascia). Specific to each facility-deal pairing as the same deal may activate in different zones across venues.' ;
    rdfs:domain ind:VenueActivation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tenancyId rdf:type rdf:Property ;
    rdfs:label 'Tenancy Id' ;
    rdfs:comment 'Primary key for the tenancy association' ;
    rdfs:domain ind:Tenancy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leaseAgreementRef rdf:type rdf:Property ;
    rdfs:label 'Lease Agreement Ref' ;
    rdfs:comment 'Reference identifier or document locator for the formal lease or occupancy agreement governing this tenancy. Links to the contract management system for full legal terms.' ;
    rdfs:domain ind:Tenancy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tenancyStatus rdf:type rdf:Property ;
    rdfs:label 'Tenancy Status' ;
    rdfs:comment 'Current lifecycle status of this tenancy arrangement. Enables operational queries to distinguish currently active occupancies from historical or pending agreements.' ;
    rdfs:domain ind:Tenancy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tenancyType rdf:type rdf:Property ;
    rdfs:label 'Tenancy Type' ;
    rdfs:comment 'Classification of the franchise\'s use of the facility — whether it serves as the primary home venue, a practice facility, a training center, a temporary arrangement, or a shared-use agreement. Determines revenue share structures and operational priority.' ;
    rdfs:domain ind:Tenancy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityObligationApplicabilityId rdf:type rdf:Property ;
    rdfs:label 'Facility Obligation Applicability Id' ;
    rdfs:comment 'Primary key for the facility_obligation_applicability association' ;
    rdfs:domain ind:FacilityObligationApplicability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicabilityEndDate rdf:type rdf:Property ;
    rdfs:label 'Applicability End Date' ;
    rdfs:comment 'The date on which this compliance obligation ceases to apply to this specific facility, if applicable. May be set when a facility is decommissioned, sold, or when a regulatory exemption is granted for this location.' ;
    rdfs:domain ind:FacilityObligationApplicability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicabilityStartDate rdf:type rdf:Property ;
    rdfs:label 'Applicability Start Date' ;
    rdfs:comment 'The date on which this compliance obligation became applicable to this specific facility. May differ from the obligation\'s global effective_date if the facility was built, acquired, or activated after the obligation took effect.' ;
    rdfs:domain ind:FacilityObligationApplicability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Last Verified Date' ;
    rdfs:comment 'The most recent date on which compliance with this obligation was formally verified and confirmed at this specific facility. Drives audit scheduling and remediation prioritization at the venue level.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:franchiseDistributionRightId rdf:type rdf:Property ;
    rdfs:label 'Franchise Distribution Right Id' ;
    rdfs:comment 'Primary key for the franchise_distribution_right association' ;
    rdfs:domain ind:FranchiseDistributionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contentRightsTier rdf:type rdf:Property ;
    rdfs:label 'Content Rights Tier' ;
    rdfs:comment 'The tier of content rights granted to this digital touchpoint for this franchise — determines what content (live games, highlights, PPV events, archival) the touchpoint is authorized to deliver. Sourced from detection phase relationship data.' ;
    rdfs:domain ind:FranchiseDistributionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:touchpointRole rdf:type rdf:Property ;
    rdfs:label 'Touchpoint Role' ;
    rdfs:comment 'The functional role this digital touchpoint plays in distributing the franchise\'s content — e.g., primary (full rights, main channel), syndicated (secondary distribution), preview_only (limited free content). Sourced from detection phase relationship data.' ;
    rdfs:domain ind:FranchiseDistributionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryOversightId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Oversight Id' ;
    rdfs:comment 'Primary key for the regulatory_oversight association' ;
    rdfs:domain ind:RegulatoryOversight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:oversightType rdf:type rdf:Property ;
    rdfs:label 'Oversight Type' ;
    rdfs:comment 'Classification of the type of regulatory authority this governing body exercises over this franchise (e.g., anti-doping, broadcast, labor-safety, franchise-governance). Drives which compliance obligations apply.' ;
    rdfs:domain ind:RegulatoryOversight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryOversightStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Oversight Status' ;
    rdfs:comment 'Lifecycle status of this specific franchise-governing body oversight record. Distinct from compliance_status — this tracks whether the oversight relationship itself is active, not whether the franchise is compliant.' ;
    rdfs:domain ind:RegulatoryOversight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationId rdf:type rdf:Property ;
    rdfs:label 'Accreditation Id' ;
    rdfs:comment 'Primary key for the accreditation association' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceScope rdf:type rdf:Property ;
    rdfs:label 'Compliance Scope' ;
    rdfs:comment 'Specific activities, services, or product categories that this accreditation covers for the vendor (e.g., \'urine and blood sample analysis for prohibited substances\', \'broadcast transmission equipment for live sports\'). Scope is unique to each vendor-governing body pair.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:presaleAccessId rdf:type rdf:Property ;
    rdfs:label 'Presale Access Id' ;
    rdfs:comment 'Primary key for the presale_access association' ;
    rdfs:domain ind:PresaleAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationQuantity rdf:type rdf:Property ;
    rdfs:label 'Allocation Quantity' ;
    rdfs:comment 'Number of tickets from the parent hold allocation reserved for exclusive or priority access by this fan segment. Cannot live on hold_allocation (one record per block, not per segment) nor on fan_segment (a reference master with no event-specific inventory data).' ;
    rdfs:domain ind:PresaleAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:conversionRate rdf:type rdf:Property ;
    rdfs:label 'Conversion Rate' ;
    rdfs:comment 'Post-sale metric expressing the percentage of this segment\'s allocated quantity that was actually purchased during the presale window. Computed at the segment-allocation level and used for future presale sizing decisions. Cannot live on hold_allocation (aggregates across all segments) nor on fan_segment (aggregates across all events).' ;
    rdfs:domain ind:PresaleAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibilityGroupCode rdf:type rdf:Property ;
    rdfs:label 'Eligibility Group Code' ;
    rdfs:comment 'Structured code identifying the fan segment, loyalty tier, or partner group eligible for this hold (e.g., \'SEASON_HOLDER\', \'FAN_CLUB_GOLD\', \'SPONSOR_GUEST\'). Enables programmatic eligibility enforcement and CRM-driven targeting via Salesforce CRM and Adobe Experience Platform. [Moved from hold_allocation: This field on hold_allocation is a single-value text code that attempts to capture the fan segment or loyalty group eligible for the hold. In the true M:N model, multiple segments can be entitled to the same hold allocation, each with their own priority and quantity. The eligibility_group_code becomes redundant and misleading once the presale_access association table exists — segment identity is now captured via the FK to fan_segment. The field should be deprecated from hold_allocation and replaced by the association records.]' ;
    rdfs:domain ind:PresaleAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:presaleAccessStatus rdf:type rdf:Property ;
    rdfs:label 'Presale Access Status' ;
    rdfs:comment 'Current lifecycle state of this segment\'s access entitlement against the hold allocation. Tracks whether the access grant is active, expired, released, or consumed.' ;
    rdfs:domain ind:PresaleAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelJurisdictionAuthorizationId rdf:type rdf:Property ;
    rdfs:label 'Channel Jurisdiction Authorization Id' ;
    rdfs:comment 'Primary key for the channel_jurisdiction_authorization association' ;
    rdfs:domain ind:ChannelJurisdictionAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contentRightsStatus rdf:type rdf:Property ;
    rdfs:label 'Content Rights Status' ;
    rdfs:comment 'Current status of content rights clearance for this platform channel within this jurisdiction. Reflects whether rights have been cleared, are pending review, or have been denied for this channel-jurisdiction combination.' ;
    rdfs:domain ind:ChannelJurisdictionAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Reference' ;
    rdfs:comment 'Reference identifier for the specific regulatory filing, approval document, or compliance submission that authorizes this platform channel to operate in this jurisdiction. Serves as the audit trail link to the regulatory body\'s records.' ;
    rdfs:domain ind:ChannelJurisdictionAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wageringPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Wagering Permitted Flag' ;
    rdfs:comment 'Indicates whether wagering-related content (odds, live betting, DFS) is permitted for distribution on this specific platform channel within this specific jurisdiction. A channel may be authorized in a jurisdiction but restricted from wagering content specifically.' ;
    rdfs:domain ind:ChannelJurisdictionAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:streamingRightsAuthorizationId rdf:type rdf:Property ;
    rdfs:label 'Streaming Rights Authorization Id' ;
    rdfs:comment 'Primary key for the streaming_rights_authorization association' ;
    rdfs:domain ind:StreamingRightsAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:streamingRightsType rdf:type rdf:Property ;
    rdfs:label 'Streaming Rights Type' ;
    rdfs:comment 'Specifies the type of streaming rights granted: live (real-time broadcast), VOD (on-demand after broadcast), replay (full game replay), archive (historical season content), or highlights_only. A touchpoint may be authorized for live rights for the current season but only archive rights for prior seasons.' ;
    rdfs:domain ind:StreamingRightsAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectionPricingAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Section Pricing Assignment Id' ;
    rdfs:comment 'Primary key for the section_pricing_assignment association' ;
    rdfs:domain ind:SectionPricingAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:promotionSkuInclusionId rdf:type rdf:Property ;
    rdfs:label 'Promotion Sku Inclusion Id' ;
    rdfs:comment 'Primary key for the promotion_sku_inclusion association' ;
    rdfs:domain ind:PromotionSkuInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicableDiscountValue rdf:type rdf:Property ;
    rdfs:label 'Applicable Discount Value' ;
    rdfs:comment 'The effective discount value applied to this specific SKU within the promotion. May differ from the promotion-level discount_value when a per-SKU override is in effect. Interpreted according to the parent promotion\'s discount_value_type.' ;
    rdfs:domain ind:PromotionSkuInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicableSkuList rdf:type rdf:Property ;
    rdfs:label 'Applicable Sku List' ;
    rdfs:comment 'Comma-delimited list of Stock Keeping Unit (SKU) codes to which this promotion is restricted when applicable_scope is \'specific_skus\'. Populated from the merchandise SKU catalog managed in Shopify Plus. Null when scope is broader than individual SKUs. [Moved from promotion: This comma-delimited STRING on promotion is a denormalized encoding of the M:N relationship between promotions and SKUs. Once the promotion_sku_inclusion association table exists, individual SKU inclusions are represented as rows in that table, making this field redundant and harmful to referential integrity. It should be removed from promotion and replaced by querying promotion_sku_inclusion.]' ;
    rdfs:domain ind:PromotionSkuInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelRestrictionOverride rdf:type rdf:Property ;
    rdfs:label 'Channel Restriction Override' ;
    rdfs:comment 'Per-SKU channel restriction that supersedes the promotion-level channel_restriction for this specific SKU inclusion. Specifies the sales channel(s) through which this SKU is eligible for the promotion (e.g., online_only, in_venue_only, all_channels). Null if the promotion-level channel_restriction applies without override.' ;
    rdfs:domain ind:PromotionSkuInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inclusionEndDate rdf:type rdf:Property ;
    rdfs:label 'Inclusion End Date' ;
    rdfs:comment 'Date and time when this SKU\'s eligibility within the promotion expires. May be equal to or earlier than the parent promotion\'s end_date, allowing early removal of specific SKUs from an active campaign.' ;
    rdfs:domain ind:PromotionSkuInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:inclusionStartDate rdf:type rdf:Property ;
    rdfs:label 'Inclusion Start Date' ;
    rdfs:comment 'Date and time when this SKU becomes eligible within the promotion window. May be equal to or later than the parent promotion\'s start_date, allowing phased SKU inclusion within a single campaign.' ;
    rdfs:domain ind:PromotionSkuInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:skuSpecificDiscountOverride rdf:type rdf:Property ;
    rdfs:label 'Sku Specific Discount Override' ;
    rdfs:comment 'Indicates whether the applicable_discount_value on this inclusion record overrides the promotion-level discount. When true, the applicable_discount_value on this record takes precedence over the parent promotion\'s discount_value for this SKU.' ;
    rdfs:domain ind:PromotionSkuInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseId rdf:type rdf:Property ;
    rdfs:label 'License Id' ;
    rdfs:comment 'Primary key for license' ;
    rdfs:domain ind:License ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentFiscalPeriodId rdf:type rdf:Property ;
    rdfs:label 'Parent Fiscal Period Id' ;
    rdfs:comment 'Reference to the parent fiscal period for hierarchical period structures (e.g., a monthly period rolling up to a quarterly period). Null for top-level periods.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FiscalPeriod .

ind:calendarMonth rdf:type rdf:Property ;
    rdfs:label 'Calendar Month' ;
    rdfs:comment 'The calendar month (1-12) in which this fiscal period starts, used for calendar-to-fiscal mapping.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendarQuarter rdf:type rdf:Property ;
    rdfs:label 'Calendar Quarter' ;
    rdfs:comment 'The calendar quarter (1-4) in which this fiscal period starts, used for calendar-to-fiscal mapping.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendarYear rdf:type rdf:Property ;
    rdfs:label 'Calendar Year' ;
    rdfs:comment 'The calendar year in which this fiscal period starts, used for calendar-to-fiscal mapping.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closedDate rdf:type rdf:Property ;
    rdfs:label 'Closed Date' ;
    rdfs:comment 'The date when this fiscal period was officially closed for transaction entry (yyyy-MM-dd). Null if not yet closed.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:daysInPeriod rdf:type rdf:Property ;
    rdfs:label 'Days In Period' ;
    rdfs:comment 'Total number of calendar days in this fiscal period, used for pro-rata calculations and variance analysis.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:description rdf:type rdf:Property ;
    rdfs:label 'Description' ;
    rdfs:comment 'Additional descriptive information about the fiscal period, including special characteristics or notes.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalMonth rdf:type rdf:Property ;
    rdfs:label 'Fiscal Month' ;
    rdfs:comment 'The fiscal month number within the fiscal year (1-12). Null for non-monthly periods.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalQuarter rdf:type rdf:Property ;
    rdfs:label 'Fiscal Quarter' ;
    rdfs:comment 'The fiscal quarter number within the fiscal year (1-4). Null for non-quarterly periods.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalWeek rdf:type rdf:Property ;
    rdfs:label 'Fiscal Week' ;
    rdfs:comment 'The fiscal week number within the fiscal year (1-52 or 1-53). Null for non-weekly periods.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isAdjustmentPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Adjustment Period' ;
    rdfs:comment 'Indicates whether this is a special adjustment period (e.g., Period 13) used for year-end adjustments and accruals (True/False).' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCurrentPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Current Period' ;
    rdfs:comment 'Indicates whether this is the current active fiscal period (True/False).' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isYearEndPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Year End Period' ;
    rdfs:comment 'Indicates whether this period is the final period of the fiscal year, requiring year-end closing procedures (True/False).' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lockedDate rdf:type rdf:Property ;
    rdfs:label 'Locked Date' ;
    rdfs:comment 'The date when this fiscal period was locked for final reporting and audit (yyyy-MM-dd). Null if not yet locked.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodCode rdf:type rdf:Property ;
    rdfs:label 'Period Code' ;
    rdfs:comment 'Business identifier code for the fiscal period, typically combining fiscal year and period number (e.g., FY2024-Q1, FY2024-P01).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodName rdf:type rdf:Property ;
    rdfs:label 'Period Name' ;
    rdfs:comment 'Human-readable name of the fiscal period (e.g., Q1 2024, January 2024, FY2024 Period 1).' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodStatus rdf:type rdf:Property ;
    rdfs:label 'Period Status' ;
    rdfs:comment 'Current lifecycle status of the fiscal period. Future: not yet started; Open: active for transactions; Closed: no new transactions allowed; Locked: closed and finalized for reporting; Archived: historical record only.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Reporting Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code used for financial reporting in this period (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secFilingRequired rdf:type rdf:Property ;
    rdfs:label 'Sec Filing Required' ;
    rdfs:comment 'Indicates whether this fiscal period requires SEC financial reporting filings (10-Q, 10-K) for publicly traded entities (True/False).' ;
    rdfs:domain ind:FiscalPeriod ;
