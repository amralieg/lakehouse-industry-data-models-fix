ind:communityCoefficient rdf:type rdf:Property ;
    rdfs:label 'Community Coefficient' ;
    rdfs:comment 'The coefficient value for community-dwelling beneficiaries in this HCC category.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:institutionalCoefficient rdf:type rdf:Property ;
    rdfs:label 'Institutional Coefficient' ;
    rdfs:comment 'The coefficient value for institutionalized beneficiaries in this HCC category.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newEnrolleeCoefficient rdf:type rdf:Property ;
    rdfs:label 'New Enrollee Coefficient' ;
    rdfs:comment 'The coefficient value for new Medicare Advantage enrollees in this HCC category.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
