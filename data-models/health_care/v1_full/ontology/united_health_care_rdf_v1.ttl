    rdfs:comment 'Indicates if the plan must submit state-specific regulatory reports.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceReviewStatus rdf:type rdf:Property ;
