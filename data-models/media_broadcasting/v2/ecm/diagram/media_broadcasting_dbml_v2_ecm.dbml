  ad_sales_order_id varchar [note: 'Foreign key linking to sales.ad_sales_order. Business justification: Talent clearance required before using talent likeness/performance in advertiser-sponsored content or integrated sponsorships. Real business process: advertiser purchases branded content requiring tal | Column ad_sales_order_id (BIGINT) in sales.talent_clearance']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Talent clearance for facility access is required for union compliance, insurance verification, security protocols, and background checks. Facilities management systems track which talent has been clea | Column broadcast_facility_id (BIGINT) in technology.talent_clearance']
  cleared_media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Talent clearances are often asset-specific (theatrical cut vs TV edit, domestic vs international versions, trailer vs feature). Different assets may require separate clearances based on usage rights,  | Column cleared_media_asset_id (BIGINT) in mediaasset.talent_clearance']
