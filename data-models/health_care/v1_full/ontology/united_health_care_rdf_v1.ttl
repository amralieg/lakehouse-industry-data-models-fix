ind:sepEventDate rdf:type rdf:Property ;
    rdfs:label 'Sep Event Date' ;
    rdfs:comment 'The date of the qualifying life event that triggered the special enrollment period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:year rdf:type rdf:Property ;
    rdfs:label 'Year' ;
    rdfs:comment 'The calendar year for which this coverage is effective.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitBeginDate rdf:type rdf:Property ;
    rdfs:label 'Benefit Begin Date' ;
    rdfs:comment 'The date when benefits under this coverage begin, which may differ from the effective date due to waiting periods.' ;
    rdfs:domain ind:Eligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'The timestamp when the coverage record was last updated in the system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:verificationQueueId rdf:type rdf:Property ;
    rdfs:label 'Verification Queue Id' ;
    rdfs:comment 'Unique identifier for each eligibility verification request in the queue.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VerificationQueue .

ind:providerNpi rdf:type rdf:Property ;
    rdfs:label 'Provider Npi' ;
    rdfs:comment 'Ten-digit National Provider Identifier for the healthcare provider requesting eligibility verification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerTin rdf:type rdf:Property ;
    rdfs:label 'Provider Tin' ;
    rdfs:comment 'Nine-digit Tax Identification Number for the provider organization requesting verification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerName rdf:type rdf:Property ;
    rdfs:label 'Provider Name' ;
    rdfs:comment 'Name of the healthcare provider or facility requesting eligibility verification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingSystem rdf:type rdf:Property ;
    rdfs:label 'Requesting System' ;
    rdfs:comment 'Source system or channel through which the eligibility verification request was submitted.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestType rdf:type rdf:Property ;
    rdfs:label 'Request Type' ;
    rdfs:comment 'Type of verification request indicating the processing mode.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationType rdf:type rdf:Property ;
    rdfs:label 'Verification Type' ;
    rdfs:comment 'Specific type of verification being requested, such as eligibility status, benefit coverage, or prior authorization.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTypeCode rdf:type rdf:Property ;
    rdfs:label 'Service Type Code' ;
    rdfs:comment 'Code indicating the type of healthcare service for which eligibility is being verified, using ANSI X12 service type codes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTypeDescription rdf:type rdf:Property ;
    rdfs:label 'Service Type Description' ;
    rdfs:comment 'Human-readable description of the service type being verified, such as Medical Care, Surgical, Emergency Services, etc.' ;
    rdfs:domain ind:Eligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceDate rdf:type rdf:Property ;
    rdfs:label 'Service Date' ;
    rdfs:comment 'Date of service for which eligibility verification is being requested.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Date Of Birth' ;
    rdfs:comment 'Date of birth of the member for whom eligibility is being verified, used for identity verification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:memberFirstName rdf:type rdf:Property ;
    rdfs:label 'Member First Name' ;
    rdfs:comment 'First name of the member for whom eligibility is being verified.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberLastName rdf:type rdf:Property ;
    rdfs:label 'Member Last Name' ;
    rdfs:comment 'Last name of the member for whom eligibility is being verified.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberMiddleInitial rdf:type rdf:Property ;
    rdfs:label 'Member Middle Initial' ;
    rdfs:comment 'Middle initial of the member for whom eligibility is being verified.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberGender rdf:type rdf:Property ;
    rdfs:label 'Member Gender' ;
    rdfs:comment 'Gender of the member for whom eligibility is being verified. Values: M=Male, F=Female, U=Unknown, O=Other.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberSsn rdf:type rdf:Property ;
    rdfs:label 'Member Ssn' ;
    rdfs:comment 'Social Security Number of the member, used for identity verification in eligibility requests.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queueStatus rdf:type rdf:Property ;
    rdfs:label 'Queue Status' ;
    rdfs:comment 'Current processing status of the verification request in the queue.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priority rdf:type rdf:Property ;
    rdfs:label 'Priority' ;
    rdfs:comment 'Priority level assigned to the verification request, determining processing order in the queue.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestTimestamp rdf:type rdf:Property ;
    rdfs:label 'Request Timestamp' ;
    rdfs:comment 'Date and time when the eligibility verification request was received and entered into the queue.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assigned Timestamp' ;
    rdfs:comment 'Date and time when the verification request was assigned to a processor or processing engine.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:processingStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processing Start Timestamp' ;
    rdfs:comment 'Date and time when processing of the verification request began.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:processingEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processing End Timestamp' ;
    rdfs:comment 'Date and time when processing of the verification request was completed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:expectedCompletionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Expected Completion Timestamp' ;
    rdfs:comment 'Expected date and time by which the verification request should be completed based on Service Level Agreement (SLA) requirements.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:slaTargetSeconds rdf:type rdf:Property ;
    rdfs:label 'Sla Target Seconds' ;
    rdfs:comment 'Target processing time in seconds for the verification request as defined by the Service Level Agreement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualProcessingSeconds rdf:type rdf:Property ;
    rdfs:label 'Actual Processing Seconds' ;
    rdfs:comment 'Actual time in seconds taken to process the verification request from start to completion.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retryCount rdf:type rdf:Property ;
    rdfs:label 'Retry Count' ;
    rdfs:comment 'Number of times the verification request has been retried due to processing failures or errors.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxRetryAttempts rdf:type rdf:Property ;
    rdfs:label 'Max Retry Attempts' ;
    rdfs:comment 'Maximum number of retry attempts allowed for the verification request before it is marked as failed.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:processingEngine rdf:type rdf:Property ;
    rdfs:label 'Processing Engine' ;
    rdfs:comment 'Name of the eligibility verification engine or system used to process the request.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionControlNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Control Number' ;
    rdfs:comment 'Unique control number for the Electronic Data Interchange (EDI) transaction, used for tracking 270/271 transactions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ediInterchangeId rdf:type rdf:Property ;
    rdfs:label 'Edi Interchange Id' ;
    rdfs:comment 'Unique identifier for the EDI interchange containing the eligibility verification request.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ediSenderId rdf:type rdf:Property ;
    rdfs:label 'Edi Sender Id' ;
    rdfs:comment 'Identifier for the sender of the EDI transaction, typically the provider or clearinghouse.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ediReceiverId rdf:type rdf:Property ;
    rdfs:label 'Edi Receiver Id' ;
    rdfs:comment 'Identifier for the receiver of the EDI transaction, typically the health insurance payer.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Receiver .

ind:rejectionReason rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason' ;
    rdfs:comment 'Reason why the verification request was rejected or could not be processed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationStatus rdf:type rdf:Property ;
    rdfs:label 'Validation Status' ;
    rdfs:comment 'Status indicating whether the verification request passed initial validation checks for required data elements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationErrors rdf:type rdf:Property ;
    rdfs:label 'Validation Errors' ;
    rdfs:comment 'List of validation errors encountered during initial validation of the verification request.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseCode rdf:type rdf:Property ;
    rdfs:label 'Response Code' ;
    rdfs:comment 'Code indicating the result of the eligibility verification, such as eligible, not eligible, or additional information required.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDescription rdf:type rdf:Property ;
    rdfs:label 'Response Description' ;
    rdfs:comment 'Human-readable description of the eligibility verification response.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcpRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Pcp Required Flag' ;
    rdfs:comment 'Indicates whether the member is required to have a Primary Care Physician assigned for the plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deductibleRemainingAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Remaining Amount' ;
    rdfs:comment 'Remaining deductible amount that the member must meet for the current benefit period.' ;
    rdfs:domain ind:Eligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outOfPocketMaximumAmount rdf:type rdf:Property ;
    rdfs:label 'Out Of Pocket Maximum Amount' ;
    rdfs:comment 'Maximum out-of-pocket amount the member is responsible for during the benefit period.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outOfPocketRemainingAmount rdf:type rdf:Property ;
    rdfs:label 'Out Of Pocket Remaining Amount' ;
    rdfs:comment 'Remaining out-of-pocket amount the member must pay before reaching the maximum for the benefit period.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copayAmount rdf:type rdf:Property ;
    rdfs:label 'Copay Amount' ;
    rdfs:comment 'Fixed copayment amount the member is responsible for at the time of service for the requested service type.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:networkStatus rdf:type rdf:Property ;
    rdfs:label 'Network Status' ;
    rdfs:comment 'Indicates whether the provider requesting verification is in-network, out-of-network, or both for the member\'s plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Benefit Period Start Date' ;
    rdfs:comment 'Start date of the current benefit period for the member\'s plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:benefitPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Benefit Period End Date' ;
    rdfs:comment 'End date of the current benefit period for the member\'s plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coordinationOfBenefitsFlag rdf:type rdf:Property ;
    rdfs:label 'Coordination Of Benefits Flag' ;
    rdfs:comment 'Indicates whether the member has other insurance coverage requiring coordination of benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryPayerFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Payer Flag' ;
    rdfs:comment 'Indicates whether this insurance plan is the primary payer for the member\'s claims.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraContinuationFlag rdf:type rdf:Property ;
    rdfs:label 'Cobra Continuation Flag' ;
    rdfs:comment 'Indicates whether the member\'s coverage is a COBRA continuation of previous employer-sponsored coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaContinuationFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Continuation Flag' ;
    rdfs:comment 'Indicates whether the member\'s coverage is a HIPAA continuation from a previous plan.' ;
    rdfs:domain ind:Eligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialProgramIndicator rdf:type rdf:Property ;
    rdfs:label 'Special Program Indicator' ;
    rdfs:comment 'Indicator for any special programs the member is enrolled in, such as Disease Management, Care Management, or Special Needs Plan (SNP).' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queueEntrySource rdf:type rdf:Property ;
    rdfs:label 'Queue Entry Source' ;
    rdfs:comment 'Source or channel through which the verification request entered the queue.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseFormat rdf:type rdf:Property ;
    rdfs:label 'Response Format' ;
    rdfs:comment 'Format in which the eligibility verification response will be delivered.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callbackUrl rdf:type rdf:Property ;
    rdfs:label 'Callback Url' ;
    rdfs:comment 'URL endpoint to which the eligibility verification response should be sent for asynchronous requests.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationEmail rdf:type rdf:Property ;
    rdfs:label 'Notification Email' ;
    rdfs:comment 'Email address to which notifications about the verification request status should be sent.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationPhone rdf:type rdf:Property ;
    rdfs:label 'Notification Phone' ;
    rdfs:comment 'Phone number to which notifications about the verification request status should be sent.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestNotes rdf:type rdf:Property ;
    rdfs:label 'Request Notes' ;
    rdfs:comment 'Additional notes or comments provided with the verification request for context or special handling instructions.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingNotes rdf:type rdf:Property ;
    rdfs:label 'Processing Notes' ;
    rdfs:comment 'Notes added by the processor or system during processing of the verification request.' ;
    rdfs:domain ind:VerificationQueue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrail rdf:type rdf:Property ;
    rdfs:label 'Audit Trail' ;
    rdfs:comment 'Detailed audit trail of all actions and status changes for the verification request throughout its lifecycle.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planBenefitMapId rdf:type rdf:Property ;
    rdfs:label 'Plan Benefit Map Id' ;
    rdfs:comment 'Unique identifier for the plan benefit map record linking a health plan to its benefit package configuration.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PlanBenefitMap .

ind:planName rdf:type rdf:Property ;
    rdfs:label 'Plan Name' ;
    rdfs:comment 'Marketing or official name of the health insurance plan as presented to members and providers.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitPackageName rdf:type rdf:Property ;
    rdfs:label 'Benefit Package Name' ;
    rdfs:comment 'Descriptive name of the benefit package configuration identifying the coverage tier or option level.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitPackageCode rdf:type rdf:Property ;
    rdfs:label 'Benefit Package Code' ;
    rdfs:comment 'Short alphanumeric code used for operational identification of the benefit package in claims and eligibility systems.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkName rdf:type rdf:Property ;
    rdfs:label 'Network Name' ;
    rdfs:comment 'Name of the provider network (e.g., National Network, Regional Network, Narrow Network) associated with the plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formularyId rdf:type rdf:Property ;
    rdfs:label 'Formulary Id' ;
    rdfs:comment 'Identifier for the drug formulary list associated with this plan-benefit combination for pharmacy benefit management.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Formulary .

ind:eligibilityRuleId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Rule Id' ;
    rdfs:comment 'Identifier for the collection of eligibility rules governing member qualification, enrollment periods, and continuation rights for this plan-benefit combination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EligibilityRule .

ind:requiresPcpSelection rdf:type rdf:Property ;
    rdfs:label 'Requires Pcp Selection' ;
    rdfs:comment 'Indicates whether members must select a Primary Care Physician for this plan-benefit combination, typically required for HMO plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresReferral rdf:type rdf:Property ;
    rdfs:label 'Requires Referral' ;
    rdfs:comment 'Indicates whether members need a referral from their PCP to see specialists under this plan-benefit configuration.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorAuthorizationRequired rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Required' ;
    rdfs:comment 'Indicates whether certain services require prior authorization approval under this plan-benefit combination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfNetworkCoverage rdf:type rdf:Property ;
    rdfs:label 'Out Of Network Coverage' ;
    rdfs:comment 'Indicates whether the plan-benefit combination provides any coverage for out-of-network providers, typically applicable to PPO and POS plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acaCompliant rdf:type rdf:Property ;
    rdfs:label 'Aca Compliant' ;
    rdfs:comment 'Indicates whether this plan-benefit combination meets ACA essential health benefits and coverage requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hsaEligible rdf:type rdf:Property ;
    rdfs:label 'Hsa Eligible' ;
    rdfs:comment 'Indicates whether this plan-benefit combination qualifies for Health Savings Account contributions, typically HDHP plans meeting IRS requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fsaEligible rdf:type rdf:Property ;
    rdfs:label 'Fsa Eligible' ;
    rdfs:comment 'Indicates whether this plan-benefit combination can be paired with a Flexible Spending Account for pre-tax healthcare expenses.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hraEligible rdf:type rdf:Property ;
    rdfs:label 'Hra Eligible' ;
    rdfs:comment 'Indicates whether this plan-benefit combination can be integrated with an employer-funded Health Reimbursement Arrangement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareAdvantagePlan rdf:type rdf:Property ;
    rdfs:label 'Medicare Advantage Plan' ;
    rdfs:comment 'Indicates whether this is a Medicare Advantage plan subject to CMS Part C regulations and Star Ratings.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prescriptionDrugCoverage rdf:type rdf:Property ;
    rdfs:label 'Prescription Drug Coverage' ;
    rdfs:comment 'Indicates whether this plan-benefit combination includes integrated prescription drug coverage (Part D for Medicare plans).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dentalCoverageIncluded rdf:type rdf:Property ;
    rdfs:label 'Dental Coverage Included' ;
    rdfs:comment 'Indicates whether dental benefits are included in this plan-benefit package or offered separately.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:visionCoverageIncluded rdf:type rdf:Property ;
    rdfs:label 'Vision Coverage Included' ;
    rdfs:comment 'Indicates whether vision benefits are included in this plan-benefit package or offered separately.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:behavioralHealthCoverage rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Coverage' ;
    rdfs:comment 'Indicates whether behavioral health and substance use disorder services are covered under this plan-benefit combination.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maternityCoverage rdf:type rdf:Property ;
    rdfs:label 'Maternity Coverage' ;
    rdfs:comment 'Indicates whether maternity and newborn care are covered as essential health benefits under this plan-benefit combination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pediatricCoverage rdf:type rdf:Property ;
    rdfs:label 'Pediatric Coverage' ;
    rdfs:comment 'Indicates whether pediatric services including dental and vision are covered as essential health benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telehealthCoverage rdf:type rdf:Property ;
    rdfs:label 'Telehealth Coverage' ;
    rdfs:comment 'Indicates whether telehealth and virtual care services are covered under this plan-benefit combination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmeCoverage rdf:type rdf:Property ;
    rdfs:label 'Dme Coverage' ;
    rdfs:comment 'Indicates whether durable medical equipment is covered under this plan-benefit combination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snfCoverage rdf:type rdf:Property ;
    rdfs:label 'Snf Coverage' ;
    rdfs:comment 'Indicates whether skilled nursing facility services are covered under this plan-benefit combination.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:homeHealthCoverage rdf:type rdf:Property ;
    rdfs:label 'Home Health Coverage' ;
    rdfs:comment 'Indicates whether home health services are covered under this plan-benefit combination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hospiceCoverage rdf:type rdf:Property ;
    rdfs:label 'Hospice Coverage' ;
    rdfs:comment 'Indicates whether hospice care services are covered under this plan-benefit combination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualDeductibleIndividual rdf:type rdf:Property ;
    rdfs:label 'Annual Deductible Individual' ;
    rdfs:comment 'The annual deductible amount that an individual member must pay out-of-pocket before the plan begins cost-sharing.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualDeductibleFamily rdf:type rdf:Property ;
    rdfs:label 'Annual Deductible Family' ;
    rdfs:comment 'The annual deductible amount that a family must collectively pay out-of-pocket before the plan begins cost-sharing.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryCareCopay rdf:type rdf:Property ;
    rdfs:label 'Primary Care Copay' ;
    rdfs:comment 'Fixed dollar amount the member pays for a primary care physician office visit.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specialistCopay rdf:type rdf:Property ;
    rdfs:label 'Specialist Copay' ;
    rdfs:comment 'Fixed dollar amount the member pays for a specialist physician office visit.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emergencyRoomCopay rdf:type rdf:Property ;
    rdfs:label 'Emergency Room Copay' ;
    rdfs:comment 'Fixed dollar amount the member pays for an emergency room visit, may be waived if admitted.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:urgentCareCopay rdf:type rdf:Property ;
    rdfs:label 'Urgent Care Copay' ;
    rdfs:comment 'Fixed dollar amount the member pays for an urgent care facility visit.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inpatientHospitalCopay rdf:type rdf:Property ;
    rdfs:label 'Inpatient Hospital Copay' ;
    rdfs:comment 'Fixed dollar amount or per-day amount the member pays for inpatient hospital admissions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outpatientSurgeryCopay rdf:type rdf:Property ;
    rdfs:label 'Outpatient Surgery Copay' ;
    rdfs:comment 'Fixed dollar amount the member pays for outpatient surgical procedures.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:genericDrugCopay rdf:type rdf:Property ;
    rdfs:label 'Generic Drug Copay' ;
    rdfs:comment 'Fixed dollar amount the member pays for generic prescription drugs at retail or mail-order pharmacy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredBrandDrugCopay rdf:type rdf:Property ;
    rdfs:label 'Preferred Brand Drug Copay' ;
    rdfs:comment 'Fixed dollar amount the member pays for preferred brand-name prescription drugs on the formulary.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nonPreferredBrandDrugCopay rdf:type rdf:Property ;
    rdfs:label 'Non Preferred Brand Drug Copay' ;
    rdfs:comment 'Fixed dollar amount the member pays for non-preferred brand-name prescription drugs not on the preferred formulary tier.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specialtyDrugCopay rdf:type rdf:Property ;
    rdfs:label 'Specialty Drug Copay' ;
    rdfs:comment 'Fixed dollar amount or coinsurance percentage the member pays for high-cost specialty medications.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mlrThreshold rdf:type rdf:Property ;
    rdfs:label 'Mlr Threshold' ;
    rdfs:comment 'The minimum percentage of premium revenue that must be spent on medical claims and quality improvement activities for this plan-benefit combination, as required by ACA (80% individual/small group, 85% large group).' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceAreaId rdf:type rdf:Property ;
    rdfs:label 'Service Area Id' ;
    rdfs:comment 'Identifier for the geographic service area where this plan-benefit combination is available for enrollment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceArea .

ind:countyCodes rdf:type rdf:Property ;
    rdfs:label 'County Codes' ;
    rdfs:comment 'Comma-separated list of county FIPS codes where this plan-benefit combination is available.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zipCodes rdf:type rdf:Property ;
    rdfs:label 'Zip Codes' ;
    rdfs:comment 'Comma-separated list of ZIP codes where this plan-benefit combination is available for enrollment.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerGroupSizeMin rdf:type rdf:Property ;
    rdfs:label 'Employer Group Size Min' ;
    rdfs:comment 'Minimum number of employees required for an employer group to be eligible for this plan-benefit combination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:employerGroupSizeMax rdf:type rdf:Property ;
    rdfs:label 'Employer Group Size Max' ;
    rdfs:comment 'Maximum number of employees allowed for an employer group to be eligible for this plan-benefit combination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumParticipationPercentage rdf:type rdf:Property ;
    rdfs:label 'Minimum Participation Percentage' ;
    rdfs:comment 'Minimum percentage of eligible employees that must enroll for an employer group to qualify for this plan-benefit combination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openEnrollmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Open Enrollment End Date' ;
    rdfs:comment 'Annual date when open enrollment ends for this plan-benefit combination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:specialEnrollmentEligible rdf:type rdf:Property ;
    rdfs:label 'Special Enrollment Eligible' ;
    rdfs:comment 'Indicates whether this plan-benefit combination allows enrollment during special enrollment periods triggered by qualifying life events.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketplacePlan rdf:type rdf:Property ;
    rdfs:label 'Marketplace Plan' ;
    rdfs:comment 'Indicates whether this plan-benefit combination is offered through a federal or state health insurance marketplace exchange.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qhpCertified rdf:type rdf:Property ;
    rdfs:label 'Qhp Certified' ;
    rdfs:comment 'Indicates whether this plan-benefit combination is certified as a Qualified Health Plan meeting ACA marketplace standards.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumTaxCreditEligible rdf:type rdf:Property ;
    rdfs:label 'Premium Tax Credit Eligible' ;
    rdfs:comment 'Indicates whether members enrolled in this plan-benefit combination may qualify for federal premium tax credits based on income.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:starRating rdf:type rdf:Property ;
    rdfs:label 'Star Rating' ;
    rdfs:comment 'CMS quality rating for Medicare Advantage plans on a scale of 1 to 5 stars based on quality and performance measures.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedisReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Hedis Reporting Required' ;
    rdfs:comment 'Indicates whether this plan-benefit combination requires HEDIS quality measure reporting to NCQA.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ncqaAccredited rdf:type rdf:Property ;
    rdfs:label 'Ncqa Accredited' ;
    rdfs:comment 'Indicates whether this plan-benefit combination has achieved NCQA accreditation for quality and performance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uracAccredited rdf:type rdf:Property ;
    rdfs:label 'Urac Accredited' ;
    rdfs:comment 'Indicates whether this plan-benefit combination has achieved URAC accreditation for utilization management and quality.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careManagementProgramId rdf:type rdf:Property ;
    rdfs:label 'Care Management Program Id' ;
    rdfs:comment 'Identifier for the care management or disease management program associated with this plan-benefit combination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Program .

ind:utilizationManagementVendor rdf:type rdf:Property ;
    rdfs:label 'Utilization Management Vendor' ;
    rdfs:comment 'Name of the third-party vendor providing utilization management and prior authorization services for this plan-benefit combination.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pbmVendor rdf:type rdf:Property ;
    rdfs:label 'Pbm Vendor' ;
    rdfs:comment 'Name of the pharmacy benefit manager administering prescription drug benefits for this plan-benefit combination.' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsAdministrator rdf:type rdf:Property ;
    rdfs:label 'Claims Administrator' ;
    rdfs:comment 'Name of the entity responsible for claims adjudication for this plan-benefit combination (may be internal or TPA).' ;
    rdfs:domain ind:PlanBenefitMap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:satisfactionScoreId rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Score Id' ;
    rdfs:comment 'Unique identifier for each satisfaction score record, serving as the primary key for tracking aggregated member satisfaction metrics.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SatisfactionScore .

ind:measurementPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Start Date' ;
    rdfs:comment 'The beginning date of the period during which satisfaction data was collected and aggregated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingYear rdf:type rdf:Property ;
    rdfs:label 'Reporting Year' ;
    rdfs:comment 'The calendar year for which the satisfaction score is being reported, used for annual quality reporting and trend analysis.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveyVersion rdf:type rdf:Property ;
    rdfs:label 'Survey Version' ;
    rdfs:comment 'The specific version or edition of the survey instrument used, ensuring consistency in measurement methodology over time.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeScore rdf:type rdf:Property ;
    rdfs:label 'Composite Score' ;
    rdfs:comment 'The overall aggregated satisfaction score calculated from multiple survey questions or data sources, typically expressed as a percentage or scaled value.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:careQualityScore rdf:type rdf:Property ;
    rdfs:label 'Care Quality Score' ;
    rdfs:comment 'Member satisfaction score specifically related to the quality of healthcare services received through the plan.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerServiceScore rdf:type rdf:Property ;
    rdfs:label 'Customer Service Score' ;
    rdfs:comment 'Member satisfaction score measuring the quality and responsiveness of health plan customer service interactions.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimsProcessingScore rdf:type rdf:Property ;
    rdfs:label 'Claims Processing Score' ;
    rdfs:comment 'Member satisfaction score related to the timeliness, accuracy, and transparency of claims adjudication and payment.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:providerAccessScore rdf:type rdf:Property ;
    rdfs:label 'Provider Access Score' ;
    rdfs:comment 'Member satisfaction score measuring ease of access to healthcare providers, including appointment availability and network adequacy.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prescriptionDrugScore rdf:type rdf:Property ;
    rdfs:label 'Prescription Drug Score' ;
    rdfs:comment 'Member satisfaction score related to pharmacy benefit management, drug coverage, and prescription fulfillment experience.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:careCoordinationScore rdf:type rdf:Property ;
    rdfs:label 'Care Coordination Score' ;
    rdfs:comment 'Member satisfaction score measuring the effectiveness of care coordination services and communication between providers.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:healthInformationScore rdf:type rdf:Property ;
    rdfs:label 'Health Information Score' ;
    rdfs:comment 'Member satisfaction score related to the quality, clarity, and accessibility of health information and educational materials provided by the plan.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:npsScore rdf:type rdf:Property ;
    rdfs:label 'Nps Score' ;
    rdfs:comment 'The Net Promoter Score measuring member likelihood to recommend the health plan to others, calculated as percentage of promoters minus percentage of detractors.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseCount rdf:type rdf:Property ;
    rdfs:label 'Response Count' ;
    rdfs:comment 'The total number of member responses received for the satisfaction survey during the measurement period.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eligiblePopulationCount rdf:type rdf:Property ;
    rdfs:label 'Eligible Population Count' ;
    rdfs:comment 'The total number of members eligible to participate in the satisfaction survey based on enrollment and sampling criteria.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responseRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Response Rate Percentage' ;
    rdfs:comment 'The percentage of eligible members who completed the satisfaction survey, calculated as response count divided by eligible population count.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:starsRatingCategory rdf:type rdf:Property ;
    rdfs:label 'Stars Rating Category' ;
    rdfs:comment 'The CMS Stars rating category to which this satisfaction measure contributes for Medicare Advantage and Part D plan quality ratings.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:starsRatingValue rdf:type rdf:Property ;
    rdfs:label 'Stars Rating Value' ;
    rdfs:comment 'The calculated Stars rating value for this satisfaction measure, typically on a scale of 1 to 5 stars.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicRegion rdf:type rdf:Property ;
    rdfs:label 'Geographic Region' ;
    rdfs:comment 'The geographic region or service area for which the satisfaction score is calculated, enabling regional performance analysis.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketSegment rdf:type rdf:Property ;
    rdfs:label 'Market Segment' ;
    rdfs:comment 'The market segment classification for the member population included in the satisfaction measurement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberTenureCategory rdf:type rdf:Property ;
    rdfs:label 'Member Tenure Category' ;
    rdfs:comment 'The categorization of members based on length of enrollment with the health plan, used to analyze satisfaction trends by member tenure.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageGroupCategory rdf:type rdf:Property ;
    rdfs:label 'Age Group Category' ;
    rdfs:comment 'The age group classification of members included in the satisfaction measurement, enabling age-stratified analysis.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderCategory rdf:type rdf:Property ;
    rdfs:label 'Gender Category' ;
    rdfs:comment 'The gender classification of members included in the satisfaction measurement for demographic analysis.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chronicConditionFlag rdf:type rdf:Property ;
    rdfs:label 'Chronic Condition Flag' ;
    rdfs:comment 'Indicator of whether the satisfaction measurement includes members with identified chronic health conditions.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialNeedsFlag rdf:type rdf:Property ;
    rdfs:label 'Special Needs Flag' ;
    rdfs:comment 'Indicator of whether the satisfaction measurement includes members enrolled in Special Needs Plans (SNP) requiring specialized care coordination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benchmarkComparisonGroup rdf:type rdf:Property ;
    rdfs:label 'Benchmark Comparison Group' ;
    rdfs:comment 'The reference group used for comparative analysis of satisfaction scores, such as national benchmarks or peer health plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkPercentile rdf:type rdf:Property ;
    rdfs:label 'Benchmark Percentile' ;
    rdfs:comment 'The percentile ranking of the satisfaction score compared to the benchmark comparison group, indicating relative performance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorYearScore rdf:type rdf:Property ;
    rdfs:label 'Prior Year Score' ;
    rdfs:comment 'The satisfaction score from the previous reporting year, used for year-over-year trend analysis and improvement tracking.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreChangePercentage rdf:type rdf:Property ;
    rdfs:label 'Score Change Percentage' ;
    rdfs:comment 'The percentage change in satisfaction score compared to the prior year, indicating improvement or decline in member satisfaction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetScore rdf:type rdf:Property ;
    rdfs:label 'Target Score' ;
    rdfs:comment 'The target or goal satisfaction score established for quality improvement initiatives and performance management.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetAchievementFlag rdf:type rdf:Property ;
    rdfs:label 'Target Achievement Flag' ;
    rdfs:comment 'Indicator of whether the satisfaction score met or exceeded the established target for the measurement period.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interventionAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Intervention Applied Flag' ;
    rdfs:comment 'Indicator of whether specific quality improvement interventions were implemented during the measurement period to improve satisfaction.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interventionDescription rdf:type rdf:Property ;
    rdfs:label 'Intervention Description' ;
    rdfs:comment 'Detailed description of quality improvement interventions or initiatives implemented to address satisfaction gaps.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorName rdf:type rdf:Property ;
    rdfs:label 'Vendor Name' ;
    rdfs:comment 'The name of the third-party vendor or organization that administered the satisfaction survey, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncqaCertifiedVendorFlag rdf:type rdf:Property ;
    rdfs:label 'Ncqa Certified Vendor Flag' ;
    rdfs:comment 'Indicator of whether the survey vendor is NCQA-certified for CAHPS survey administration, ensuring data quality standards.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:samplingMethodology rdf:type rdf:Property ;
    rdfs:label 'Sampling Methodology' ;
    rdfs:comment 'The statistical sampling approach used to select members for the satisfaction survey, affecting representativeness and validity.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceLevelPercentage rdf:type rdf:Property ;
    rdfs:label 'Confidence Level Percentage' ;
    rdfs:comment 'The statistical confidence level for the satisfaction score, typically 95%, indicating the reliability of the measurement.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marginOfErrorPercentage rdf:type rdf:Property ;
    rdfs:label 'Margin Of Error Percentage' ;
    rdfs:comment 'The margin of error for the satisfaction score, indicating the range within which the true population score likely falls.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statisticalSignificanceFlag rdf:type rdf:Property ;
    rdfs:label 'Statistical Significance Flag' ;
    rdfs:comment 'Indicator of whether changes in satisfaction scores are statistically significant compared to prior periods or benchmarks.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataQualityScore rdf:type rdf:Property ;
    rdfs:label 'Data Quality Score' ;
    rdfs:comment 'A composite score assessing the quality and reliability of the satisfaction data based on response rates, completeness, and validation checks.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditStatus rdf:type rdf:Property ;
    rdfs:label 'Audit Status' ;
    rdfs:comment 'The status of external audit or validation of the satisfaction measurement process and results for regulatory compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Audit Completion Date' ;
    rdfs:comment 'The date when external audit or validation of the satisfaction measurement was completed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incentiveProgramFlag rdf:type rdf:Property ;
    rdfs:label 'Incentive Program Flag' ;
    rdfs:comment 'Indicator of whether this satisfaction measure is tied to financial incentives or quality bonus programs.' ;
    rdfs:domain ind:SatisfactionScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Created Timestamp' ;
    rdfs:comment 'The timestamp when this satisfaction score record was initially created in the system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Updated Timestamp' ;
    rdfs:comment 'The timestamp when this satisfaction score record was last updated or modified.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordStatus rdf:type rdf:Property ;
    rdfs:label 'Record Status' ;
    rdfs:comment 'The current status of the satisfaction score record in its lifecycle, indicating data maturity and usability.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementStatusId rdf:type rdf:Property ;
    rdfs:label 'Improvement Status Id' ;
    rdfs:comment 'Unique identifier for the quality improvement status record. Primary key for the improvement status reference table.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnitedHealthCare .

ind:sequenceOrder rdf:type rdf:Property ;
    rdfs:label 'Sequence Order' ;
    rdfs:comment 'Numeric value indicating the typical progression order of statuses in the quality improvement lifecycle. Lower numbers represent earlier stages.' ;
    rdfs:domain ind:ImprovementStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isInitialStatus rdf:type rdf:Property ;
    rdfs:label 'Is Initial Status' ;
    rdfs:comment 'Flag indicating whether this status is the default starting status for new quality improvement actions.' ;
    rdfs:domain ind:ImprovementStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFinalStatus rdf:type rdf:Property ;
    rdfs:label 'Is Final Status' ;
    rdfs:comment 'Flag indicating whether this status represents a terminal state where no further status transitions are expected.' ;
    rdfs:domain ind:ImprovementStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsEditing rdf:type rdf:Property ;
    rdfs:label 'Allows Editing' ;
    rdfs:comment 'Flag indicating whether quality improvement action details can be modified when in this status.' ;
    rdfs:domain ind:ImprovementStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresApproval rdf:type rdf:Property ;
    rdfs:label 'Requires Approval' ;
    rdfs:comment 'Flag indicating whether formal approval is required before transitioning to this status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalRole rdf:type rdf:Property ;
    rdfs:label 'Approval Role' ;
    rdfs:comment 'The organizational role or position authorized to approve transition to this status (e.g., Quality Manager, Medical Director, Compliance Officer).' ;
    rdfs:domain ind:ImprovementStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationRequired rdf:type rdf:Property ;
    rdfs:label 'Notification Required' ;
    rdfs:comment 'Flag indicating whether stakeholder notifications must be sent when an improvement action transitions to this status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationTemplate rdf:type rdf:Property ;
    rdfs:label 'Notification Template' ;
    rdfs:comment 'Reference to the communication template used for stakeholder notifications when this status is assigned.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaDurationDays rdf:type rdf:Property ;
    rdfs:label 'Sla Duration Days' ;
    rdfs:comment 'Standard number of days an improvement action should remain in this status before progressing to the next stage. Used for performance monitoring.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationThresholdDays rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold Days' ;
    rdfs:comment 'Number of days after which an improvement action in this status should be escalated to management if not progressed.' ;
    rdfs:domain ind:ImprovementStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:iconName rdf:type rdf:Property ;
    rdfs:label 'Icon Name' ;
    rdfs:comment 'Name or identifier of the icon used to represent this status in user interfaces and reports.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isActive rdf:type rdf:Property ;
    rdfs:label 'Is Active' ;
    rdfs:comment 'Flag indicating whether this status is currently available for use in the system. Inactive statuses are retained for historical data but not available for new assignments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReportingCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Code' ;
    rdfs:comment 'Standardized code used for external regulatory reporting to CMS, NCQA, or state agencies regarding quality improvement action status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:starsRatingImpact rdf:type rdf:Property ;
    rdfs:label 'Stars Rating Impact' ;
    rdfs:comment 'Indicates how improvement actions in this status affect CMS Stars quality ratings (positive contribution, neutral, negative, or not applicable).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncqaAccreditationRelevant rdf:type rdf:Property ;
    rdfs:label 'Ncqa Accreditation Relevant' ;
    rdfs:comment 'Flag indicating whether this status is relevant for NCQA accreditation quality improvement documentation and audits.' ;
    rdfs:domain ind:ImprovementStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresDocumentation rdf:type rdf:Property ;
    rdfs:label 'Requires Documentation' ;
    rdfs:comment 'Flag indicating whether supporting documentation must be attached when an improvement action reaches this status.' ;
    rdfs:domain ind:ImprovementStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentationType rdf:type rdf:Property ;
    rdfs:label 'Documentation Type' ;
    rdfs:comment 'Type of documentation required when in this status (e.g., Action Plan, Progress Report, Completion Certificate, Audit Evidence).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowsReopening rdf:type rdf:Property ;
    rdfs:label 'Allows Reopening' ;
    rdfs:comment 'Flag indicating whether improvement actions can be reopened and moved back to an earlier status from this status.' ;
    rdfs:domain ind:ImprovementStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:successCriteria rdf:type rdf:Property ;
    rdfs:label 'Success Criteria' ;
    rdfs:comment 'Detailed description of the criteria that must be met for an improvement action to successfully complete this status phase.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextStatusOptions rdf:type rdf:Property ;
    rdfs:label 'Next Status Options' ;
    rdfs:comment 'Comma-separated list of valid status codes that an improvement action can transition to from this status.' ;
    rdfs:domain ind:ImprovementStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowStage rdf:type rdf:Property ;
    rdfs:label 'Workflow Stage' ;
    rdfs:comment 'High-level workflow stage this status belongs to in the quality improvement lifecycle.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceMetricTracked rdf:type rdf:Property ;
    rdfs:label 'Performance Metric Tracked' ;
    rdfs:comment 'Flag indicating whether time spent in this status is tracked as a key performance indicator for quality improvement program efficiency.' ;
    rdfs:domain ind:ImprovementStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalSystemCode rdf:type rdf:Property ;
    rdfs:label 'External System Code' ;
    rdfs:comment 'Status code used in external quality management or case management systems for integration and data exchange.' ;
    rdfs:domain ind:ImprovementStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationId rdf:type rdf:Property ;
    rdfs:label 'Accreditation Id' ;
    rdfs:comment 'Unique identifier for the accreditation record. Primary key for the accreditation entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Accreditation .

ind:entityType rdf:type rdf:Property ;
    rdfs:label 'Entity Type' ;
    rdfs:comment 'Type of healthcare entity receiving accreditation (e.g., health plan, provider organization, hospital, medical group).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityName rdf:type rdf:Property ;
    rdfs:label 'Entity Name' ;
    rdfs:comment 'Legal name of the entity receiving accreditation.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityIdentifier rdf:type rdf:Property ;
    rdfs:label 'Entity Identifier' ;
    rdfs:comment 'Business identifier for the accredited entity (e.g., NPI, TIN, internal organization ID).' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditingBody rdf:type rdf:Property ;
    rdfs:label 'Accrediting Body' ;
    rdfs:comment 'Name of the accrediting organization that granted the accreditation (e.g., NCQA, URAC, Joint Commission).' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:program rdf:type rdf:Property ;
    rdfs:label 'Program' ;
    rdfs:comment 'Specific accreditation program or product line under which the entity is accredited (e.g., Health Plan Accreditation, Disease Management, Case Management, Utilization Management).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'Date when the accreditation expires and requires renewal or re-evaluation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:awardDate rdf:type rdf:Property ;
    rdfs:label 'Award Date' ;
    rdfs:comment 'Date when the accreditation was officially awarded by the accrediting body.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyDate rdf:type rdf:Property ;
    rdfs:label 'Survey Date' ;
    rdfs:comment 'Date when the on-site or remote accreditation survey was conducted.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decisionDate rdf:type rdf:Property ;
    rdfs:label 'Decision Date' ;
    rdfs:comment 'Date when the accrediting body made the final accreditation decision.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Date' ;
    rdfs:comment 'Date when the accreditation was renewed or is scheduled for renewal.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cycleYears rdf:type rdf:Property ;
    rdfs:label 'Cycle Years' ;
    rdfs:comment 'Duration of the accreditation cycle in years (typically 3 years for NCQA, varies by program).' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificationNumber rdf:type rdf:Property ;
    rdfs:label 'Certification Number' ;
    rdfs:comment 'Unique certification or accreditation number issued by the accrediting body.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeOfAccreditation rdf:type rdf:Property ;
    rdfs:label 'Scope Of Accreditation' ;
    rdfs:comment 'Description of the scope, services, or product lines covered by the accreditation (e.g., commercial HMO, Medicare Advantage, Medicaid managed care).' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:linesOfBusiness rdf:type rdf:Property ;
    rdfs:label 'Lines Of Business' ;
    rdfs:comment 'Specific lines of business covered by the accreditation (e.g., Commercial, Medicare, Medicaid, CHIP, Exchange/Marketplace).' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicScope rdf:type rdf:Property ;
    rdfs:label 'Geographic Scope' ;
    rdfs:comment 'Geographic regions, states, or service areas covered by the accreditation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberCountAtSurvey rdf:type rdf:Property ;
    rdfs:label 'Member Count At Survey' ;
    rdfs:comment 'Number of members or enrollees covered by the entity at the time of the accreditation survey.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overallScore rdf:type rdf:Property ;
    rdfs:label 'Overall Score' ;
    rdfs:comment 'Overall numeric score or percentage achieved in the accreditation evaluation.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:standardsMetCount rdf:type rdf:Property ;
    rdfs:label 'Standards Met Count' ;
    rdfs:comment 'Count of accreditation standards or requirements that were fully met.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standardsTotalCount rdf:type rdf:Property ;
    rdfs:label 'Standards Total Count' ;
    rdfs:comment 'Total count of accreditation standards or requirements evaluated during the survey.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deficienciesCount rdf:type rdf:Property ;
    rdfs:label 'Deficiencies Count' ;
    rdfs:comment 'Count of deficiencies or non-compliance findings identified during the accreditation survey.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveActionRequired rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Required' ;
    rdfs:comment 'Indicates whether corrective action is required to address deficiencies or maintain accreditation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveActionDueDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Due Date' ;
    rdfs:comment 'Date by which corrective actions must be completed and submitted to the accrediting body.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Completion Date' ;
    rdfs:comment 'Date when all required corrective actions were completed and verified.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyType rdf:type rdf:Property ;
    rdfs:label 'Survey Type' ;
    rdfs:comment 'Type of accreditation survey conducted (e.g., initial, renewal, follow-up, focused, unannounced).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyMethodology rdf:type rdf:Property ;
    rdfs:label 'Survey Methodology' ;
    rdfs:comment 'Methodology used to conduct the accreditation survey (e.g., on-site visit, remote review, desk review, hybrid).' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadSurveyorName rdf:type rdf:Property ;
    rdfs:label 'Lead Surveyor Name' ;
    rdfs:comment 'Name of the lead surveyor or reviewer who conducted the accreditation survey.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyTeamSize rdf:type rdf:Property ;
    rdfs:label 'Survey Team Size' ;
    rdfs:comment 'Number of surveyors or reviewers on the accreditation survey team.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:publicDisclosureFlag rdf:type rdf:Property ;
    rdfs:label 'Public Disclosure Flag' ;
    rdfs:comment 'Indicates whether the accreditation status and results are publicly disclosed or listed on the accrediting body\'s website.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicDisclosureDate rdf:type rdf:Property ;
    rdfs:label 'Public Disclosure Date' ;
    rdfs:comment 'Date when the accreditation status was publicly disclosed or published.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealDecision rdf:type rdf:Property ;
    rdfs:label 'Appeal Decision' ;
    rdfs:comment 'Outcome of the accreditation appeal process (e.g., upheld, overturned, modified).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Decision Date' ;
    rdfs:comment 'Date when the appeal decision was rendered by the accrediting body.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:suspensionReason rdf:type rdf:Property ;
    rdfs:label 'Suspension Reason' ;
    rdfs:comment 'Reason for suspension of the accreditation (e.g., non-compliance, failure to submit corrective action, quality concerns).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationReason rdf:type rdf:Property ;
    rdfs:label 'Revocation Reason' ;
    rdfs:comment 'Reason for revocation of the accreditation (e.g., serious non-compliance, fraud, failure to meet standards).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voluntaryWithdrawalFlag rdf:type rdf:Property ;
    rdfs:label 'Voluntary Withdrawal Flag' ;
    rdfs:comment 'Indicates whether the entity voluntarily withdrew from the accreditation program.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:withdrawalDate rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Date' ;
    rdfs:comment 'Date when the entity withdrew from the accreditation program.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorAccreditationLevel rdf:type rdf:Property ;
    rdfs:label 'Prior Accreditation Level' ;
    rdfs:comment 'Accreditation level achieved in the previous accreditation cycle.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAccreditationDate rdf:type rdf:Property ;
    rdfs:label 'Prior Accreditation Date' ;
    rdfs:comment 'Effective date of the prior accreditation.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:historyCount rdf:type rdf:Property ;
    rdfs:label 'History Count' ;
    rdfs:comment 'Number of times the entity has been accredited by this accrediting body.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:firstAccreditationDate rdf:type rdf:Property ;
    rdfs:label 'First Accreditation Date' ;
    rdfs:comment 'Date when the entity first achieved accreditation with this accrediting body.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hedisReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Hedis Reporting Flag' ;
    rdfs:comment 'Indicates whether the entity is required to report HEDIS measures as part of the accreditation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cahpsSurveyFlag rdf:type rdf:Property ;
    rdfs:label 'Cahps Survey Flag' ;
    rdfs:comment 'Indicates whether the entity is required to conduct CAHPS surveys as part of the accreditation.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityImprovementPlanRequired rdf:type rdf:Property ;
    rdfs:label 'Quality Improvement Plan Required' ;
    rdfs:comment 'Indicates whether a quality improvement plan is required as part of the accreditation or corrective action.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityImprovementPlanDueDate rdf:type rdf:Property ;
    rdfs:label 'Quality Improvement Plan Due Date' ;
    rdfs:comment 'Date by which the quality improvement plan must be submitted to the accrediting body.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feeAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Amount' ;
    rdfs:comment 'Total fee amount paid for the accreditation survey and evaluation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeCurrency rdf:type rdf:Property ;
    rdfs:label 'Fee Currency' ;
    rdfs:comment 'Currency in which the accreditation fee was paid.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPersonName rdf:type rdf:Property ;
    rdfs:label 'Contact Person Name' ;
    rdfs:comment 'Name of the primary contact person at the entity for accreditation matters.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPersonTitle rdf:type rdf:Property ;
    rdfs:label 'Contact Person Title' ;
    rdfs:comment 'Job title of the primary contact person for accreditation matters.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPersonEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Person Email' ;
    rdfs:comment 'Email address of the primary contact person for accreditation matters.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPersonPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Person Phone' ;
    rdfs:comment 'Phone number of the primary contact person for accreditation matters.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentUrl rdf:type rdf:Property ;
    rdfs:label 'Document Url' ;
    rdfs:comment 'URL or file path to the official accreditation certificate or decision letter.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyReportUrl rdf:type rdf:Property ;
    rdfs:label 'Survey Report Url' ;
    rdfs:comment 'URL or file path to the detailed accreditation survey report.' ;
    rdfs:domain ind:Accreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordActiveFlag rdf:type rdf:Property ;
    rdfs:label 'Record Active Flag' ;
    rdfs:comment 'Indicates whether the accreditation record is currently active in the system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerScoreId rdf:type rdf:Property ;
    rdfs:label 'Provider Score Id' ;
    rdfs:comment 'Unique identifier for the provider quality score record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProviderScore .

ind:npi rdf:type rdf:Property ;
    rdfs:label 'Npi' ;
    rdfs:comment 'The unique 10-digit National Provider Identifier assigned to the healthcare provider by CMS.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tin rdf:type rdf:Property ;
    rdfs:label 'Tin' ;
    rdfs:comment 'The Tax Identification Number for the provider organization or practice.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialty rdf:type rdf:Property ;
    rdfs:label 'Specialty' ;
    rdfs:comment 'The primary medical specialty or service area of the provider (e.g., cardiology, primary care, orthopedics).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalQualityScore rdf:type rdf:Property ;
    rdfs:label 'Clinical Quality Score' ;
    rdfs:comment 'The quality score based on clinical performance metrics such as HEDIS measures, evidence-based care delivery, and clinical outcomes.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:patientExperienceScore rdf:type rdf:Property ;
    rdfs:label 'Patient Experience Score' ;
    rdfs:comment 'The quality score derived from patient satisfaction surveys and experience measures such as CAHPS.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:patientSafetyScore rdf:type rdf:Property ;
    rdfs:label 'Patient Safety Score' ;
    rdfs:comment 'The quality score reflecting patient safety indicators, adverse events, and safety protocols compliance.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accreditationScore rdf:type rdf:Property ;
    rdfs:label 'Accreditation Score' ;
    rdfs:comment 'The quality score based on accreditation status and results from bodies such as NCQA, URAC, or Joint Commission.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedisComplianceScore rdf:type rdf:Property ;
    rdfs:label 'Hedis Compliance Score' ;
    rdfs:comment 'The score reflecting the provider\'s performance on HEDIS quality measures for preventive care, chronic disease management, and evidence-based practices.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:starsRating rdf:type rdf:Property ;
    rdfs:label 'Stars Rating' ;
    rdfs:comment 'The CMS Star Rating assigned to the provider, typically on a scale of 1 to 5 stars, used for Medicare Advantage and Part D quality assessment.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreCalculationDate rdf:type rdf:Property ;
    rdfs:label 'Score Calculation Date' ;
    rdfs:comment 'The date on which the provider quality scores were calculated and finalized.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scoreStatus rdf:type rdf:Property ;
    rdfs:label 'Score Status' ;
    rdfs:comment 'The current status of the provider quality score (draft, preliminary, final, published, archived, or under review).' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalMembersAttributed rdf:type rdf:Property ;
    rdfs:label 'Total Members Attributed' ;
    rdfs:comment 'The total number of health plan members attributed to this provider for quality measurement purposes.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalEncounters rdf:type rdf:Property ;
    rdfs:label 'Total Encounters' ;
    rdfs:comment 'The total number of patient encounters or visits recorded for the provider during the measurement period.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preventiveCareScore rdf:type rdf:Property ;
    rdfs:label 'Preventive Care Score' ;
    rdfs:comment 'The quality score reflecting the provider\'s performance on preventive care measures such as screenings, immunizations, and wellness visits.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chronicDiseaseManagementScore rdf:type rdf:Property ;
    rdfs:label 'Chronic Disease Management Score' ;
    rdfs:comment 'The quality score reflecting the provider\'s performance on chronic disease management measures for conditions such as diabetes, hypertension, and asthma.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:behavioralHealthScore rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Score' ;
    rdfs:comment 'The quality score reflecting the provider\'s performance on behavioral health and mental health care measures.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicationAdherenceScore rdf:type rdf:Property ;
    rdfs:label 'Medication Adherence Score' ;
    rdfs:comment 'The quality score reflecting patient medication adherence rates for the provider\'s attributed members.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readmissionRate rdf:type rdf:Property ;
    rdfs:label 'Readmission Rate' ;
    rdfs:comment 'The percentage of patients readmitted to the hospital within 30 days of discharge, used as a quality indicator.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emergencyDepartmentUtilizationRate rdf:type rdf:Property ;
    rdfs:label 'Emergency Department Utilization Rate' ;
    rdfs:comment 'The rate of emergency department visits per 1,000 members attributed to the provider, used as a quality and cost efficiency indicator.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:healthOutcomesScore rdf:type rdf:Property ;
    rdfs:label 'Health Outcomes Score' ;
    rdfs:comment 'The quality score reflecting measurable health outcomes achieved for the provider\'s patient population.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costEfficiencyScore rdf:type rdf:Property ;
    rdfs:label 'Cost Efficiency Score' ;
    rdfs:comment 'The score reflecting the provider\'s cost efficiency in delivering care relative to quality outcomes.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cahpsOverallRating rdf:type rdf:Property ;
    rdfs:label 'Cahps Overall Rating' ;
    rdfs:comment 'The overall patient satisfaction rating from CAHPS surveys, typically on a scale of 0-10.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cahpsProviderCommunicationScore rdf:type rdf:Property ;
    rdfs:label 'Cahps Provider Communication Score' ;
    rdfs:comment 'The CAHPS score reflecting patient ratings of provider communication quality.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cahpsAccessToCareScore rdf:type rdf:Property ;
    rdfs:label 'Cahps Access To Care Score' ;
    rdfs:comment 'The CAHPS score reflecting patient ratings of access to care and appointment availability.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCahpsSurveysCompleted rdf:type rdf:Property ;
    rdfs:label 'Total Cahps Surveys Completed' ;
    rdfs:comment 'The total number of CAHPS patient satisfaction surveys completed for the provider during the measurement period.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qualityImprovementProgramParticipation rdf:type rdf:Property ;
    rdfs:label 'Quality Improvement Program Participation' ;
    rdfs:comment 'Indicates whether the provider is actively participating in quality improvement programs sponsored by the health plan or CMS.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valueBasedContractParticipation rdf:type rdf:Property ;
    rdfs:label 'Value Based Contract Participation' ;
    rdfs:comment 'Indicates whether the provider participates in value-based care contracts or alternative payment models.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:apmParticipationType rdf:type rdf:Property ;
    rdfs:label 'Apm Participation Type' ;
    rdfs:comment 'The type of alternative payment model in which the provider participates (ACO, PCMH, bundled payment, shared savings, capitation, or none).' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityTier rdf:type rdf:Property ;
    rdfs:label 'Quality Tier' ;
    rdfs:comment 'The quality tier classification of the provider based on composite quality scores (high, medium, low, or not rated).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Factor' ;
    rdfs:comment 'The average risk adjustment factor for the provider\'s attributed member population, reflecting the complexity and health status of patients.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hccCaptureRate rdf:type rdf:Property ;
    rdfs:label 'Hcc Capture Rate' ;
    rdfs:comment 'The percentage of expected HCC diagnoses that were documented and captured by the provider during the measurement period.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityBonusEligible rdf:type rdf:Property ;
    rdfs:label 'Quality Bonus Eligible' ;
    rdfs:comment 'Indicates whether the provider is eligible for quality-based bonus payments based on performance thresholds.' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityBonusAmount rdf:type rdf:Property ;
    rdfs:label 'Quality Bonus Amount' ;
    rdfs:comment 'The dollar amount of quality-based bonus payments earned by the provider during the measurement period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peerComparisonPercentile rdf:type rdf:Property ;
    rdfs:label 'Peer Comparison Percentile' ;
    rdfs:comment 'The percentile ranking of the provider\'s quality score compared to peers in the same specialty and geographic area (0-100).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nationalBenchmarkComparison rdf:type rdf:Property ;
    rdfs:label 'National Benchmark Comparison' ;
    rdfs:comment 'Indicates how the provider\'s quality performance compares to national benchmarks (above, at, below, or not available).' ;
    rdfs:domain ind:ProviderScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataCompletenessScore rdf:type rdf:Property ;
    rdfs:label 'Data Completeness Score' ;
    rdfs:comment 'The score reflecting the completeness and quality of clinical data submitted by the provider for quality measurement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastQualityAuditDate rdf:type rdf:Property ;
