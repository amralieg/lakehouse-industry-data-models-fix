  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in compliance.audit']

  Note: 'Master reference table for audit. Referenced by audit_id. | Unity Catalog table: media_broadcasting_ecm.compliance.audit'
