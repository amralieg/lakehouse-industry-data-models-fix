    rdfs:range xsd:decimal .

ind:dosageUnit rdf:type rdf:Property ;
    rdfs:label 'Dosage Unit' ;
    rdfs:comment 'Unit of measure for the dosage amount.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextScheduledDoseDatetime rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Dose Datetime' ;
    rdfs:comment 'Planned date and time for the next dose after the current record.' ;
    rdfs:domain ind:BehavioralHealthMatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:patientConsentGiven rdf:type rdf:Property ;
    rdfs:label 'Patient Consent Given' ;
    rdfs:comment 'Indicates whether the patient provided consent for this treatment episode.' ;
    rdfs:domain ind:BehavioralHealthMatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refillCount rdf:type rdf:Property ;
    rdfs:label 'Refill Count' ;
    rdfs:comment 'Number of medication refills authorized for the treatment course.' ;
    rdfs:domain ind:BehavioralHealthMatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:treatmentNumber rdf:type rdf:Property ;
    rdfs:label 'Treatment Number' ;
    rdfs:comment 'Business identifier assigned to the treatment episode, used for external reference and reporting.' ;
    rdfs:domain ind:BehavioralHealthMatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentStatus rdf:type rdf:Property ;
    rdfs:label 'Treatment Status' ;
    rdfs:comment 'Current lifecycle state of the treatment episode.' ;
    rdfs:domain ind:BehavioralHealthMatTreatment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentType rdf:type rdf:Property ;
    rdfs:label 'Treatment Type' ;
    rdfs:comment 'Category of the treatment modality delivered.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetConditionSnomedConceptId rdf:type rdf:Property ;
    rdfs:label 'Target Condition Snomed Concept Id' ;
    rdfs:comment 'Foreign key linking to reference.snomed_concept. Business justification: RPM programs target specific conditions (hypertension, CHF, diabetes). SNOMED linkage enables automated patient eligibility matching, condition-specific outcome reporting, and population health analyt' ;
    rdfs:domain ind:RpmProgram ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SnomedConcept .

ind:billingRate rdf:type rdf:Property ;
    rdfs:label 'Billing Rate' ;
    rdfs:comment 'Reimbursement rate per enrollment period (e.g., per month).' ;
    rdfs:domain ind:RpmProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataCaptureFrequency rdf:type rdf:Property ;
    rdfs:label 'Data Capture Frequency' ;
    rdfs:comment 'How often sensor data is recorded and transmitted.' ;
    rdfs:domain ind:RpmProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationDays rdf:type rdf:Property ;
    rdfs:label 'Duration Days' ;
    rdfs:comment 'Standard length of the program in days once a patient is enrolled.' ;
    rdfs:domain ind:RpmProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enrollmentCriteria rdf:type rdf:Property ;
    rdfs:label 'Enrollment Criteria' ;
    rdfs:comment 'Business rules defining which patients are eligible for enrollment.' ;
    rdfs:domain ind:RpmProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPilotProgram rdf:type rdf:Property ;
    rdfs:label 'Is Pilot Program' ;
    rdfs:comment 'True if the program is a pilot or limited-scope rollout.' ;
    rdfs:domain ind:RpmProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:portalAccessEnabled rdf:type rdf:Property ;
    rdfs:label 'Portal Access Enabled' ;
    rdfs:comment 'Indicates whether enrolled patients have access to a patient portal for RPM data.' ;
    rdfs:domain ind:RpmProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rpmProgramDescription rdf:type rdf:Property ;
    rdfs:label 'Rpm Program Description' ;
    rdfs:comment 'Detailed description of the program\'s purpose, clinical objectives, and target population.' ;
    rdfs:domain ind:RpmProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rpmProgramStatus rdf:type rdf:Property ;
    rdfs:label 'Rpm Program Status' ;
    rdfs:comment 'Current lifecycle status of the program.' ;
    rdfs:domain ind:RpmProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sensorType rdf:type rdf:Property ;
    rdfs:label 'Sensor Type' ;
    rdfs:comment 'Specific physiological parameter measured by the device.' ;
    rdfs:domain ind:DigitalHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupSessionId rdf:type rdf:Property ;
    rdfs:label 'Group Session Id' ;
    rdfs:comment 'Identifier linking to the parent group session record, if applicable.' ;
    rdfs:domain ind:TherapySession ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TherapySession .

ind:telehealthDeviceId rdf:type rdf:Property ;
    rdfs:label 'Telehealth Device Id' ;
    rdfs:comment 'Identifier of the device used to capture the telehealth session (e.g., tablet serial).' ;
    rdfs:domain ind:TherapySession ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Device .

ind:therapyEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Therapy Employee Id' ;
    rdfs:comment 'Identifier of the system user who created the record.' ;
    rdfs:domain ind:TherapySession ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:chargeAdjustment rdf:type rdf:Property ;
    rdfs:label 'Charge Adjustment' ;
    rdfs:comment 'Adjustments (discounts, write-offs, insurance adjustments) applied to the gross charge.' ;
    rdfs:domain ind:TherapySession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargeAmountGross rdf:type rdf:Property ;
    rdfs:label 'Charge Amount Gross' ;
    rdfs:comment 'Total charge for the session before any adjustments.' ;
    rdfs:domain ind:TherapySession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargeAmountNet rdf:type rdf:Property ;
    rdfs:label 'Charge Amount Net' ;
    rdfs:comment 'Final amount payable after adjustments.' ;
    rdfs:domain ind:TherapySession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isGroupSession rdf:type rdf:Property ;
    rdfs:label 'Is Group Session' ;
    rdfs:comment 'True if the session involved multiple patients simultaneously.' ;
    rdfs:domain ind:TherapySession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outcomeMeasureScore rdf:type rdf:Property ;
    rdfs:label 'Outcome Measure Score' ;
    rdfs:comment 'Standardized numeric score reflecting patient outcome for the session (e.g., PHQ-9 total).' ;
    rdfs:domain ind:TherapySession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:patientFeedback rdf:type rdf:Property ;
    rdfs:label 'Patient Feedback' ;
    rdfs:comment 'Free-text feedback provided by the patient after the session.' ;
    rdfs:domain ind:TherapySession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionDate rdf:type rdf:Property ;
    rdfs:label 'Session Date' ;
    rdfs:comment 'Calendar date on which the therapy session took place.' ;
    rdfs:domain ind:TherapySession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sessionOutcome rdf:type rdf:Property ;
    rdfs:label 'Session Outcome' ;
    rdfs:comment 'Clinician-recorded overall outcome of the session.' ;
    rdfs:domain ind:TherapySession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapistNotes rdf:type rdf:Property ;
