ind:applicableContractTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Contract Types' ;
    rdfs:comment 'Comma-separated list of contract types where this clause is applicable or commonly used (e.g., provider agreements, ACO contracts, capitation agreements, VBC contracts).' ;
    rdfs:domain ind:Clause ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Legal Jurisdiction' ;
    rdfs:comment 'Geographic or legal jurisdiction where this clause is applicable or enforceable. May reference specific states or federal jurisdiction.' ;
    rdfs:domain ind:Clause ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerContact rdf:type rdf:Property ;
    rdfs:label 'Owner Contact' ;
    rdfs:comment 'Name or email of the primary contact person responsible for this clause definition.' ;
    rdfs:domain ind:Clause ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceImpact rdf:type rdf:Property ;
    rdfs:label 'Compliance Impact' ;
    rdfs:comment 'Assessment of the regulatory or compliance significance of this clause. High-impact clauses are critical for regulatory adherence.' ;
    rdfs:domain ind:Clause ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresLegalReview rdf:type rdf:Property ;
    rdfs:label 'Requires Legal Review' ;
    rdfs:comment 'Flag indicating whether any modification to this clause requires formal legal department review before use.' ;
    rdfs:domain ind:Clause ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresComplianceReview rdf:type rdf:Property ;
    rdfs:label 'Requires Compliance Review' ;
    rdfs:comment 'Flag indicating whether any modification to this clause requires formal compliance department review before use.' ;
    rdfs:domain ind:Clause ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentClauseId rdf:type rdf:Property ;
    rdfs:label 'Parent Clause Id' ;
    rdfs:comment 'Reference to a parent clause if this clause is a variant or sub-clause of a broader standard clause. Enables hierarchical clause organization.' ;
    rdfs:domain ind:Clause ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clause .

ind:supersedesClauseId rdf:type rdf:Property ;
    rdfs:label 'Supersedes Clause Id' ;
    rdfs:comment 'Reference to a previous clause version that this clause replaces or supersedes. Maintains version history and lineage.' ;
    rdfs:domain ind:Clause ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clause .

ind:relatedClauses rdf:type rdf:Property ;
    rdfs:label 'Related Clauses' ;
    rdfs:comment 'Comma-separated list of clause IDs or codes that are commonly used together with this clause or have related subject matter.' ;
    rdfs:domain ind:Clause ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentReference rdf:type rdf:Property ;
    rdfs:label 'Document Reference' ;
    rdfs:comment 'Reference to the source document, template, or legal precedent from which this clause was derived or adapted.' ;
    rdfs:domain ind:Clause ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countyList rdf:type rdf:Property ;
    rdfs:label 'County List' ;
    rdfs:comment 'Comma-separated list of county names or FIPS codes included in the service area. Used for county-based service area definitions.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkAdequacyStatus rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Status' ;
    rdfs:comment 'Compliance status of the service area against network adequacy requirements (compliant, non-compliant, under review, waiver granted, or pending certification).' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkAdequacyCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Certification Date' ;
    rdfs:comment 'Date when the service area received network adequacy certification from regulatory authorities.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumProviderCount rdf:type rdf:Property ;
    rdfs:label 'Minimum Provider Count' ;
    rdfs:comment 'Minimum number of providers required in the service area to meet network adequacy standards.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualProviderCount rdf:type rdf:Property ;
    rdfs:label 'Actual Provider Count' ;
    rdfs:comment 'Current number of contracted providers actively serving the service area.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberEnrollmentCount rdf:type rdf:Property ;
    rdfs:label 'Member Enrollment Count' ;
    rdfs:comment 'Current number of members enrolled in plans associated with this service area.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumEnrollmentCapacity rdf:type rdf:Property ;
    rdfs:label 'Maximum Enrollment Capacity' ;
    rdfs:comment 'Maximum number of members that can be enrolled in the service area based on network capacity and regulatory limits.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:timeDistanceStandardMet rdf:type rdf:Property ;
    rdfs:label 'Time Distance Standard Met' ;
    rdfs:comment 'Boolean indicator whether the service area meets time and distance standards for member access to providers.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maximumTravelDistanceMiles rdf:type rdf:Property ;
    rdfs:label 'Maximum Travel Distance Miles' ;
    rdfs:comment 'Maximum travel distance in miles that members may need to travel to access in-network providers within the service area.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumTravelTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Maximum Travel Time Minutes' ;
    rdfs:comment 'Maximum travel time in minutes that members may need to travel to access in-network providers within the service area.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:populationDensityCategory rdf:type rdf:Property ;
    rdfs:label 'Population Density Category' ;
    rdfs:comment 'Categorization of population density within the service area (high, medium, low, or very low).' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPopulation rdf:type rdf:Property ;
    rdfs:label 'Total Population' ;
    rdfs:comment 'Total population count within the service area boundaries based on census data.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medicareEligiblePopulation rdf:type rdf:Property ;
    rdfs:label 'Medicare Eligible Population' ;
    rdfs:comment 'Number of Medicare-eligible individuals within the service area based on demographic data.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medicaidEligiblePopulation rdf:type rdf:Property ;
    rdfs:label 'Medicaid Eligible Population' ;
    rdfs:comment 'Number of Medicaid-eligible individuals within the service area based on state program data.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exclusionList rdf:type rdf:Property ;
    rdfs:label 'Exclusion List' ;
    rdfs:comment 'List of specific geographic areas, ZIP codes, or counties explicitly excluded from the service area coverage.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialProvisions rdf:type rdf:Property ;
    rdfs:label 'Special Provisions' ;
    rdfs:comment 'Text describing any special provisions, exceptions, or unique terms applicable to the service area.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:borderCountyIndicator rdf:type rdf:Property ;
    rdfs:label 'Border County Indicator' ;
    rdfs:comment 'Boolean indicator whether the service area includes counties on state borders, which may have special cross-border access provisions.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfAreaCoverageType rdf:type rdf:Property ;
    rdfs:label 'Out Of Area Coverage Type' ;
    rdfs:comment 'Type of coverage provided to members when they are outside the defined service area (emergency only, urgent care, full coverage, or none).' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countyFfsRate rdf:type rdf:Property ;
    rdfs:label 'County Ffs Rate' ;
    rdfs:comment 'Average Medicare Fee-For-Service spending rate for the counties in the service area, used for benchmark calculations.' ;
    rdfs:domain ind:ContractServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityBonusPercentage rdf:type rdf:Property ;
    rdfs:label 'Quality Bonus Percentage' ;
    rdfs:comment 'Percentage bonus applied to benchmark rates based on Star Ratings quality performance in the service area.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exclusionCriteriaId rdf:type rdf:Property ;
    rdfs:label 'Exclusion Criteria Id' ;
    rdfs:comment 'Unique identifier for the exclusion criteria record within the contract management system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExclusionCriteria .

ind:exclusionType rdf:type rdf:Property ;
    rdfs:label 'Exclusion Type' ;
    rdfs:comment 'Specifies the nature of the exclusion: absolute (never covered), conditional (excluded under certain circumstances), partial (some aspects excluded), temporary (time-limited exclusion), or permanent (indefinite exclusion).' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10Code rdf:type rdf:Property ;
    rdfs:label 'Icd 10 Code' ;
    rdfs:comment 'ICD-10 diagnosis code that is excluded from reimbursement under the contract terms, if the exclusion is diagnosis-based.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberAgeMin rdf:type rdf:Property ;
    rdfs:label 'Member Age Min' ;
    rdfs:comment 'Minimum age of the member for whom this exclusion criteria applies. Null if no minimum age restriction.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberAgeMax rdf:type rdf:Property ;
    rdfs:label 'Member Age Max' ;
    rdfs:comment 'Maximum age of the member for whom this exclusion criteria applies. Null if no maximum age restriction.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geographicRestriction rdf:type rdf:Property ;
    rdfs:label 'Geographic Restriction' ;
    rdfs:comment 'Geographic area (state, region, or service area code) where this exclusion criteria applies. Null if no geographic restriction.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersedesExclusionId rdf:type rdf:Property ;
    rdfs:label 'Supersedes Exclusion Id' ;
    rdfs:comment 'Identifier of the previous exclusion criteria record that this version replaces or supersedes.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appliesToNetworkTier rdf:type rdf:Property ;
    rdfs:label 'Applies To Network Tier' ;
    rdfs:comment 'Network tier or participation status to which this exclusion applies: in-network, out-of-network, all, or specific tier levels.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyLimitType rdf:type rdf:Property ;
    rdfs:label 'Frequency Limit Type' ;
    rdfs:comment 'Type of frequency limitation associated with the exclusion, if applicable: per day, per week, per month, per year, per lifetime, per episode, or none.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyLimitValue rdf:type rdf:Property ;
    rdfs:label 'Frequency Limit Value' ;
    rdfs:comment 'Numeric value representing the maximum allowed occurrences within the frequency limit type period. Null if no frequency limit applies.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:denialMessageText rdf:type rdf:Property ;
    rdfs:label 'Denial Message Text' ;
    rdfs:comment 'Standard text message provided to members and providers when a claim is denied based on this exclusion criteria.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMedicareExclusion rdf:type rdf:Property ;
    rdfs:label 'Is Medicare Exclusion' ;
    rdfs:comment 'Indicates whether this exclusion is mandated by Medicare regulations and applies to Medicare Advantage or Part D plans.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMedicaidExclusion rdf:type rdf:Property ;
    rdfs:label 'Is Medicaid Exclusion' ;
    rdfs:comment 'Indicates whether this exclusion is mandated by Medicaid regulations and applies to Medicaid managed care plans.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAcaMandated rdf:type rdf:Property ;
    rdfs:label 'Is Aca Mandated' ;
    rdfs:comment 'Indicates whether this exclusion is mandated or influenced by Affordable Care Act essential health benefits requirements.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hedisImpact rdf:type rdf:Property ;
    rdfs:label 'Hedis Impact' ;
    rdfs:comment 'Description of how this exclusion criteria may impact HEDIS quality measure reporting and performance.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fwaRiskIndicator rdf:type rdf:Property ;
    rdfs:label 'Fwa Risk Indicator' ;
    rdfs:comment 'Risk level indicating the potential for fraud, waste, or abuse related to claims involving this exclusion criteria.' ;
    rdfs:domain ind:ExclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceMetricId rdf:type rdf:Property ;
    rdfs:label 'Performance Metric Id' ;
    rdfs:comment 'Unique identifier for the performance metric record tied to value-based contracts.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PerformanceMetric .

ind:measureSet rdf:type rdf:Property ;
    rdfs:label 'Measure Set' ;
    rdfs:comment 'The quality measure set or program to which this metric belongs (e.g., HEDIS 2023, Medicare Stars 2024, ACO Quality Measures).' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceTier rdf:type rdf:Property ;
    rdfs:label 'Performance Tier' ;
    rdfs:comment 'The performance tier assigned based on the achieved rate relative to target and benchmark thresholds, determining payment level.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:achievementStatus rdf:type rdf:Property ;
    rdfs:label 'Achievement Status' ;
    rdfs:comment 'Indicates whether the provider met, exceeded, or did not meet the target performance rate for this metric.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Eligibility Flag' ;
    rdfs:comment 'Indicates whether the provider is eligible for performance-based payment based on this metric\'s achievement.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weightedScore rdf:type rdf:Property ;
    rdfs:label 'Weighted Score' ;
    rdfs:comment 'The weighted contribution of this metric to the overall performance score, calculated as rate multiplied by weight.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberPopulationCount rdf:type rdf:Property ;
    rdfs:label 'Member Population Count' ;
    rdfs:comment 'The total number of members attributed to the provider for this performance metric during the measurement period.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingEntityId rdf:type rdf:Property ;
    rdfs:label 'Reporting Entity Id' ;
    rdfs:comment 'The unique identifier for the organization or entity responsible for reporting this performance metric.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReportingEntity .

ind:contractYear rdf:type rdf:Property ;
    rdfs:label 'Contract Year' ;
    rdfs:comment 'The contract year to which this performance metric applies for payment and reporting purposes.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:baselineRate rdf:type rdf:Property ;
    rdfs:label 'Baseline Rate' ;
    rdfs:comment 'The baseline performance rate established at the start of the contract period, used to measure improvement.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baselineYear rdf:type rdf:Property ;
    rdfs:label 'Baseline Year' ;
    rdfs:comment 'The year in which the baseline performance rate was established for comparison and improvement measurement.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:improvementRate rdf:type rdf:Property ;
    rdfs:label 'Improvement Rate' ;
    rdfs:comment 'The calculated percentage improvement from the baseline rate to the current performance rate.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sampleSizeMetFlag rdf:type rdf:Property ;
    rdfs:label 'Sample Size Met Flag' ;
    rdfs:comment 'Indicates whether the minimum sample size requirement was met for this performance metric.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:completenessRate rdf:type rdf:Property ;
    rdfs:label 'Completeness Rate' ;
    rdfs:comment 'The percentage of required data elements that were present and complete for the performance metric calculation.' ;
    rdfs:domain ind:PerformanceMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTermId rdf:type rdf:Property ;
    rdfs:label 'Payment Term Id' ;
    rdfs:comment 'Unique identifier for the payment term record. Primary key for the payment term lookup table.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentTerm .

ind:paymentCycleType rdf:type rdf:Property ;
    rdfs:label 'Payment Cycle Type' ;
    rdfs:comment 'The frequency or trigger for payment under this term. Supports various reimbursement models including fee-for-service, capitation, and value-based arrangements.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netDays rdf:type rdf:Property ;
    rdfs:label 'Net Days' ;
    rdfs:comment 'Number of days from invoice date or service date within which full payment is due without discount. Standard values include 15, 30, 45, 60, 90 days.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:discountDays rdf:type rdf:Property ;
    rdfs:label 'Discount Days' ;
    rdfs:comment 'Number of days from invoice date within which payment must be made to qualify for the early payment discount.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dueDateCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Due Date Calculation Method' ;
    rdfs:comment 'Method used to calculate the payment due date. Determines the starting point for counting net days or discount days.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lateFeeType rdf:type rdf:Property ;
    rdfs:label 'Late Fee Type' ;
    rdfs:comment 'Type of late fee structure applied when payment is not received within the net days plus grace period. Supports fixed fees, percentage-based fees, or tiered structures.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lateFeeFrequency rdf:type rdf:Property ;
    rdfs:label 'Late Fee Frequency' ;
    rdfs:comment 'Frequency at which late fees are assessed for overdue payments. Determines whether fees compound or are assessed once.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumLateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Late Fee Amount' ;
    rdfs:comment 'Maximum total late fee amount that can be charged regardless of outstanding balance or duration. Ensures compliance with regulatory caps.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestRateAnnual rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Annual' ;
    rdfs:comment 'Annual interest rate applied to overdue balances. Expressed as a percentage. Must comply with state usury laws and insurance regulations.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Interest Calculation Method' ;
    rdfs:comment 'Method used to calculate interest on overdue balances. Determines whether interest compounds and at what frequency.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prepaymentAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Prepayment Allowed Flag' ;
    rdfs:comment 'Indicates whether prepayment or early payment is allowed under this payment term without penalty.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prepaymentDiscountPercentage rdf:type rdf:Property ;
    rdfs:label 'Prepayment Discount Percentage' ;
    rdfs:comment 'Additional discount percentage offered for prepayment beyond the standard early payment discount. Used in value-based contracts.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:partialPaymentAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Partial Payment Allowed Flag' ;
    rdfs:comment 'Indicates whether partial payments are accepted under this payment term or if full payment is required.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumPaymentPercentage rdf:type rdf:Property ;
    rdfs:label 'Minimum Payment Percentage' ;
    rdfs:comment 'Minimum percentage of total invoice amount required for a partial payment. Alternative to fixed minimum amount.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentMethodRestrictions rdf:type rdf:Property ;
    rdfs:label 'Payment Method Restrictions' ;
    rdfs:comment 'Comma-separated list of allowed or restricted payment methods for this term. Examples: ACH only, wire transfer required, no credit cards.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoPaymentEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Payment Eligible Flag' ;
    rdfs:comment 'Indicates whether this payment term is eligible for automatic payment processing through ACH or recurring payment systems.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeResolutionDays rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Days' ;
    rdfs:comment 'Number of days allowed for payment disputes to be raised and resolved before late fees apply. Supports claims adjudication disputes.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractTypeApplicability rdf:type rdf:Property ;
    rdfs:label 'Contract Type Applicability' ;
    rdfs:comment 'Comma-separated list of contract types where this payment term is applicable. Examples: fee_for_service, capitation, value_based_care, ACO, bundled_payment, DRG, APC.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerTypeApplicability rdf:type rdf:Property ;
    rdfs:label 'Provider Type Applicability' ;
    rdfs:comment 'Comma-separated list of provider types eligible for this payment term. Examples: hospital, physician, ancillary, pharmacy, behavioral_health, DME.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceCategoryApplicability rdf:type rdf:Property ;
    rdfs:label 'Service Category Applicability' ;
    rdfs:comment 'Comma-separated list of service categories where this payment term applies. Examples: inpatient, outpatient, professional, pharmacy, behavioral_health.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityIncentiveEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Incentive Eligible Flag' ;
    rdfs:comment 'Indicates whether this payment term includes eligibility for quality-based incentive payments tied to HEDIS or other quality metrics.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:withholdReleaseCriteria rdf:type rdf:Property ;
    rdfs:label 'Withhold Release Criteria' ;
    rdfs:comment 'Description of criteria that must be met for withheld amounts to be released to the provider. May include quality metrics, utilization targets, or financial performance.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erisaApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Erisa Applicable Flag' ;
    rdfs:comment 'Indicates whether this payment term is subject to ERISA regulations for employer-sponsored health plans.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorityRanking rdf:type rdf:Property ;
    rdfs:label 'Priority Ranking' ;
    rdfs:comment 'Numeric ranking indicating the priority or preference order for this payment term when multiple terms are available. Lower numbers indicate higher priority.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defaultTermFlag rdf:type rdf:Property ;
    rdfs:label 'Default Term Flag' ;
    rdfs:comment 'Indicates whether this is the default payment term to be used when no specific term is selected for a contract.' ;
    rdfs:domain ind:PaymentTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialtyCoverageId rdf:type rdf:Property ;
    rdfs:label 'Specialty Coverage Id' ;
    rdfs:comment 'Unique identifier for the specialty coverage record within the contract.' ;
    rdfs:domain ind:SpecialtyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specialtyName rdf:type rdf:Property ;
    rdfs:label 'Specialty Name' ;
    rdfs:comment 'Full descriptive name of the medical specialty (e.g., Cardiology, Orthopedic Surgery, Family Medicine).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyCategory rdf:type rdf:Property ;
    rdfs:label 'Specialty Category' ;
    rdfs:comment 'High-level categorization of the specialty for network adequacy and reporting purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Status' ;
    rdfs:comment 'Indicates whether the specialty is covered, excluded, or has limited coverage under the contract.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseRateAmount rdf:type rdf:Property ;
    rdfs:label 'Case Rate Amount' ;
    rdfs:comment 'Fixed payment amount per case or episode of care for this specialty.' ;
    rdfs:domain ind:SpecialtyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskSharingArrangement rdf:type rdf:Property ;
    rdfs:label 'Risk Sharing Arrangement' ;
    rdfs:comment 'Type of financial risk-sharing arrangement between the payer and provider for this specialty (e.g., upside only, two-sided risk, full risk).' ;
    rdfs:domain ind:SpecialtyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityIncentiveApplicable rdf:type rdf:Property ;
    rdfs:label 'Quality Incentive Applicable' ;
    rdfs:comment 'Indicates whether quality-based incentive payments apply to this specialty coverage.' ;
    rdfs:domain ind:SpecialtyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deductibleApplicable rdf:type rdf:Property ;
