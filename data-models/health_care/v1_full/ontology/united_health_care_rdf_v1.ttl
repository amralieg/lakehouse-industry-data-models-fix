    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sharedPaymentId rdf:type rdf:Property ;
    rdfs:label 'Shared Payment Id' ;
    rdfs:comment 'Unique identifier of the payment transaction from which this allocation is derived. Links allocation to the source payment batch or remittance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SharedPayment .

ind:allocatedAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Amount' ;
    rdfs:comment 'Dollar amount allocated from the payment to this specific claim line. Represents the portion of total payment assigned to this service line after all adjustments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cobAmount rdf:type rdf:Property ;
    rdfs:label 'Cob Amount' ;
    rdfs:comment 'Amount paid or expected to be paid by another insurance carrier when member has multiple coverage. Used to coordinate benefits between primary and secondary payers.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractualAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Contractual Adjustment Amount' ;
    rdfs:comment 'Difference between billed amount and allowed amount based on provider contract terms. Represents the write-off amount per contractual agreement.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationType rdf:type rdf:Property ;
    rdfs:label 'Allocation Type' ;
    rdfs:comment 'Classification of the payment allocation indicating whether it is a standard payment, adjustment to prior payment, reversal, recoupment of overpayment, or supplemental payment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationStatus rdf:type rdf:Property ;
    rdfs:label 'Allocation Status' ;
    rdfs:comment 'Current processing status of the payment allocation. Tracks lifecycle from initial allocation through posting to provider account and final reconciliation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Date' ;
    rdfs:comment 'Date when the payment amount was allocated to this specific claim line. Represents when the allocation decision was made in the payment processing system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:procedureModifier1 rdf:type rdf:Property ;
    rdfs:label 'Procedure Modifier 1' ;
    rdfs:comment 'First procedure code modifier providing additional information about the service performed. Affects payment calculation and medical necessity determination.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureModifier2 rdf:type rdf:Property ;
    rdfs:label 'Procedure Modifier 2' ;
    rdfs:comment 'Second procedure code modifier providing additional information about the service performed.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureModifier3 rdf:type rdf:Property ;
    rdfs:label 'Procedure Modifier 3' ;
    rdfs:comment 'Third procedure code modifier providing additional information about the service performed.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureModifier4 rdf:type rdf:Property ;
    rdfs:label 'Procedure Modifier 4' ;
    rdfs:comment 'Fourth procedure code modifier providing additional information about the service performed.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typeOfServiceCode rdf:type rdf:Property ;
    rdfs:label 'Type Of Service Code' ;
    rdfs:comment 'Code classifying the general category of service (medical, surgical, diagnostic, etc.). Used for utilization reporting and payment categorization.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason Code' ;
    rdfs:comment 'Standard code explaining why the paid amount differs from the billed amount. Provides transparency on payment adjustments and denials.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason Description' ;
    rdfs:comment 'Human-readable explanation of the adjustment reason code. Provides detailed context for payment variance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remarkDescription rdf:type rdf:Property ;
    rdfs:label 'Remark Description' ;
    rdfs:comment 'Human-readable explanation of the remark code. Provides additional context or instructions to the provider.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parIndicator rdf:type rdf:Property ;
    rdfs:label 'Par Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the provider has a participating contract with the health plan. True if provider is contracted, false if non-contracted.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bundledPaymentIndicator rdf:type rdf:Property ;
    rdfs:label 'Bundled Payment Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this allocation is part of a bundled payment arrangement where multiple services are paid as a single episode. True if bundled, false if unbundled.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valueBasedPaymentIndicator rdf:type rdf:Property ;
    rdfs:label 'Value Based Payment Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this allocation includes value-based payment components such as quality incentives or shared savings. True if value-based, false if standard FFS.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryPayerIndicator rdf:type rdf:Property ;
    rdfs:label 'Primary Payer Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this health plan is the primary payer for this claim. True if primary, false if secondary or tertiary payer in COB scenarios.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobPayerSequence rdf:type rdf:Property ;
    rdfs:label 'Cob Payer Sequence' ;
    rdfs:comment 'Numeric sequence indicating the order of payment responsibility when multiple payers exist (1=primary, 2=secondary, 3=tertiary). Used for COB processing.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:workersCompIndicator rdf:type rdf:Property ;
    rdfs:label 'Workers Comp Indicator' ;
    rdfs:comment 'Boolean flag indicating whether services are related to a workers compensation claim. True if workers comp related, affecting payment responsibility.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:percentage rdf:type rdf:Property ;
    rdfs:label 'Percentage' ;
    rdfs:comment 'Percentage of the total payment allocated to this specific claim line. Used when payment is distributed proportionally across multiple lines.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitsPaid rdf:type rdf:Property ;
    rdfs:label 'Units Paid' ;
    rdfs:comment 'Number of service units paid for this claim line. May differ from units billed if payment is reduced or denied. Units represent quantity of service (visits, days, procedures, etc.).' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitsBilled rdf:type rdf:Property ;
    rdfs:label 'Units Billed' ;
    rdfs:comment 'Number of service units originally billed by the provider for this claim line. Represents quantity of service requested for payment.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentRate rdf:type rdf:Property ;
    rdfs:label 'Payment Rate' ;
    rdfs:comment 'Per-unit payment rate applied to calculate the paid amount. Derived from fee schedules, contracted rates, or regulatory payment methodologies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeScheduleName rdf:type rdf:Property ;
    rdfs:label 'Fee Schedule Name' ;
    rdfs:comment 'Name or identifier of the fee schedule used to determine payment rates for this allocation. May reference Medicare fee schedule, state Medicaid schedule, or custom contracted schedule.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimProcessedDate rdf:type rdf:Property ;
    rdfs:label 'Claim Processed Date' ;
    rdfs:comment 'Date when the claim was adjudicated and payment decision was made. Used for turnaround time reporting and prompt payment compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountingPeriod rdf:type rdf:Property ;
    rdfs:label 'Accounting Period' ;
    rdfs:comment 'Financial accounting period (month/year) to which this payment allocation is assigned for financial reporting. Format typically YYYY-MM or period name.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalLossRatioIndicator rdf:type rdf:Property ;
    rdfs:label 'Medical Loss Ratio Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this payment allocation is included in Medical Loss Ratio calculations for ACA rebate requirements. True if included in MLR numerator.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hedisReportableIndicator rdf:type rdf:Property ;
    rdfs:label 'Hedis Reportable Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this service is reportable for HEDIS quality measures. True if service contributes to HEDIS numerator or denominator.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMeasureIndicator rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this service is relevant for quality measurement programs (HEDIS, Stars, CAHPS, etc.). True if quality-reportable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudReviewIndicator rdf:type rdf:Property ;
    rdfs:label 'Fraud Review Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this payment allocation was flagged for fraud, waste, or abuse review. True if referred to Special Investigations Unit (SIU).' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconsiderationIndicator rdf:type rdf:Property ;
    rdfs:label 'Reconsideration Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this payment allocation was adjusted following provider request for reconsideration. True if reconsidered.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctedClaimIndicator rdf:type rdf:Property ;
    rdfs:label 'Corrected Claim Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this allocation is for a corrected or resubmitted claim. True if claim was corrected after initial submission.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalAllocationId rdf:type rdf:Property ;
    rdfs:label 'Original Allocation Id' ;
    rdfs:comment 'Reference to the original claim_payment_allocation_id if this record is an adjustment, reversal, or correction of a prior allocation. Null for original allocations.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentAllocation .

ind:adjustmentSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Adjustment Sequence Number' ;
    rdfs:comment 'Sequential number indicating the order of adjustments to the original payment allocation. First adjustment is 1, second is 2, etc. Null for original allocations.' ;
    rdfs:domain ind:PaymentAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Payment Source System' ;
    rdfs:comment 'Name or identifier of the source system that generated this payment allocation (Facets, QNXT, HealthRules, etc.). Used for data lineage and reconciliation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Status' ;
    rdfs:comment 'Status indicating whether this payment allocation has been reconciled with provider accounts and financial systems. Tracks reconciliation lifecycle.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Date' ;
    rdfs:comment 'Date when this payment allocation was successfully reconciled with provider accounts and financial systems. Null if not yet reconciled.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:procedureId rdf:type rdf:Property ;
    rdfs:label 'Procedure Id' ;
    rdfs:comment 'Unique identifier for the claim procedure record. Primary key for the claim procedure entity.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Procedure .

ind:codeType rdf:type rdf:Property ;
    rdfs:label 'Code Type' ;
    rdfs:comment 'The coding system classification indicating whether the code is from CPT, HCPCS, CDT (dental), or ICD-10-PCS (inpatient procedures).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortDescription rdf:type rdf:Property ;
    rdfs:label 'Short Description' ;
    rdfs:comment 'Abbreviated description of the procedure code, typically 28 characters or less, used for display in constrained UI spaces and reports.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:longDescription rdf:type rdf:Property ;
    rdfs:label 'Long Description' ;
    rdfs:comment 'Full detailed description of the medical procedure or service represented by the code, including clinical context and specifications.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifierIndicator rdf:type rdf:Property ;
    rdfs:label 'Modifier Indicator' ;
    rdfs:comment 'Flag indicating whether this procedure code can accept CPT or HCPCS modifiers to provide additional information about the service performed.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bilateralIndicator rdf:type rdf:Property ;
    rdfs:label 'Bilateral Indicator' ;
    rdfs:comment 'Flag indicating whether the procedure can be performed bilaterally (on both sides of the body) and qualifies for bilateral pricing adjustments.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assistantSurgeonIndicator rdf:type rdf:Property ;
    rdfs:label 'Assistant Surgeon Indicator' ;
    rdfs:comment 'Flag indicating whether an assistant surgeon is typically allowed for this procedure and eligible for separate reimbursement.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coSurgeonIndicator rdf:type rdf:Property ;
    rdfs:label 'Co Surgeon Indicator' ;
    rdfs:comment 'Flag indicating whether co-surgeons are typically allowed for this procedure with separate reimbursement for each surgeon.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:teamSurgeryIndicator rdf:type rdf:Property ;
    rdfs:label 'Team Surgery Indicator' ;
    rdfs:comment 'Flag indicating whether this procedure qualifies for team surgery billing where multiple surgeons of different specialties work together.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:anesthesiaBaseUnits rdf:type rdf:Property ;
    rdfs:label 'Anesthesia Base Units' ;
    rdfs:comment 'The base unit value assigned to anesthesia procedures used in calculating anesthesia reimbursement along with time units and modifying factors.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:globalPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Global Period Days' ;
    rdfs:comment 'Number of days in the global surgical package during which follow-up care is included in the procedure payment and not separately billable.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:multipleProcedureIndicator rdf:type rdf:Property ;
    rdfs:label 'Multiple Procedure Indicator' ;
    rdfs:comment 'CMS indicator defining payment adjustment rules when multiple procedures are performed during the same session (0=no adjustment, 1=standard rules apply, 2=bilateral adjustment, etc.).' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placeOfServiceRestriction rdf:type rdf:Property ;
    rdfs:label 'Place Of Service Restriction' ;
    rdfs:comment 'Restrictions on where the procedure can be performed (e.g., inpatient only, outpatient only, office setting) affecting coverage and reimbursement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderRestriction rdf:type rdf:Property ;
    rdfs:label 'Gender Restriction' ;
    rdfs:comment 'Indicates if the procedure is gender-specific and should only be performed on male or female patients, or has no gender restriction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageRestrictionLow rdf:type rdf:Property ;
    rdfs:label 'Age Restriction Low' ;
    rdfs:comment 'Minimum age in years for which this procedure is typically appropriate or covered, used for claims editing and medical necessity validation.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageRestrictionHigh rdf:type rdf:Property ;
    rdfs:label 'Age Restriction High' ;
    rdfs:comment 'Maximum age in years for which this procedure is typically appropriate or covered, used for claims editing and medical necessity validation.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:professionalComponentIndicator rdf:type rdf:Property ;
    rdfs:label 'Professional Component Indicator' ;
    rdfs:comment 'Flag indicating whether the procedure can be split into professional and technical components for separate billing (common in radiology and laboratory services).' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:technicalComponentIndicator rdf:type rdf:Property ;
    rdfs:label 'Technical Component Indicator' ;
    rdfs:comment 'Flag indicating whether the procedure has a separately billable technical component covering equipment, supplies, and non-physician staff.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workRelativeValueUnits rdf:type rdf:Property ;
    rdfs:label 'Work Relative Value Units' ;
    rdfs:comment 'The work component of the relative value unit reflecting physician time, skill, and intensity required to perform the procedure.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:practiceExpenseRvu rdf:type rdf:Property ;
    rdfs:label 'Practice Expense Rvu' ;
    rdfs:comment 'The practice expense component of the relative value unit covering overhead costs such as staff, supplies, and equipment.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:malpracticeRvu rdf:type rdf:Property ;
    rdfs:label 'Malpractice Rvu' ;
    rdfs:comment 'The malpractice component of the relative value unit reflecting professional liability insurance costs associated with the procedure.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalRvu rdf:type rdf:Property ;
    rdfs:label 'Total Rvu' ;
    rdfs:comment 'The sum of work, practice expense, and malpractice RVUs used as the basis for Medicare physician fee schedule payment calculations.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityPricingIndicator rdf:type rdf:Property ;
    rdfs:label 'Facility Pricing Indicator' ;
    rdfs:comment 'Flag indicating whether this procedure has different pricing when performed in a facility setting versus a non-facility setting.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nonFacilityPricingIndicator rdf:type rdf:Property ;
    rdfs:label 'Non Facility Pricing Indicator' ;
    rdfs:comment 'Flag indicating whether this procedure has specific pricing for non-facility settings such as physician offices.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ambulatoryPaymentClassification rdf:type rdf:Property ;
    rdfs:label 'Ambulatory Payment Classification' ;
    rdfs:comment 'The APC group assignment for outpatient hospital services under the Medicare Outpatient Prospective Payment System (OPPS).' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisRelatedGroup rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Related Group' ;
    rdfs:comment 'The DRG classification for inpatient hospital services used in the Medicare Inpatient Prospective Payment System (IPPS).' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nationalDrugCode rdf:type rdf:Property ;
    rdfs:label 'National Drug Code' ;
    rdfs:comment 'The NDC number for procedures involving drug administration, linking the procedure to specific pharmaceutical products.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageWholesalePrice rdf:type rdf:Property ;
    rdfs:label 'Average Wholesale Price' ;
    rdfs:comment 'The average wholesale price for drug-related procedures, used as a benchmark for pharmacy reimbursement calculations.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumAllowableCost rdf:type rdf:Property ;
    rdfs:label 'Maximum Allowable Cost' ;
    rdfs:comment 'The maximum reimbursement amount established for generic drugs and multi-source brand drugs in pharmacy benefit management.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:addOnCodeIndicator rdf:type rdf:Property ;
    rdfs:label 'Add On Code Indicator' ;
    rdfs:comment 'Flag indicating whether this is an add-on procedure code that can only be billed in conjunction with a primary procedure code.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryProcedureCode rdf:type rdf:Property ;
    rdfs:label 'Primary Procedure Code' ;
    rdfs:comment 'The primary procedure code that must be present when billing this add-on code, establishing the required code pairing relationship.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicallyUnlikelyEditValue rdf:type rdf:Property ;
    rdfs:label 'Medically Unlikely Edit Value' ;
    rdfs:comment 'The maximum number of units of service that would typically be reported for this procedure on a single date of service, used for claims editing.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nationalCorrectCodingInitiativeIndicator rdf:type rdf:Property ;
    rdfs:label 'National Correct Coding Initiative Indicator' ;
    rdfs:comment 'Flag indicating whether this procedure code is subject to NCCI edits that prevent inappropriate code combinations from being billed together.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:siteOfServiceDifferential rdf:type rdf:Property ;
    rdfs:label 'Site Of Service Differential' ;
    rdfs:comment 'Flag indicating whether reimbursement rates differ based on the site where the service is performed (hospital outpatient vs physician office).' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quantityQualifier rdf:type rdf:Property ;
    rdfs:label 'Quantity Qualifier' ;
    rdfs:comment 'The unit of measurement for procedure quantity such as units (UN), minutes (MJ), square feet (F2), milliliters (ML), used in claims billing.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingUnit rdf:type rdf:Property ;
    rdfs:label 'Billing Unit' ;
    rdfs:comment 'The standard unit of measure for billing this procedure such as per visit, per hour, per session, per unit, or per dose.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conversionFactor rdf:type rdf:Property ;
    rdfs:label 'Conversion Factor' ;
    rdfs:comment 'The dollar amount multiplied by the total RVU to calculate the Medicare payment amount for the procedure, updated annually by CMS.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicareCovered rdf:type rdf:Property ;
    rdfs:label 'Medicare Covered' ;
    rdfs:comment 'Flag indicating whether this procedure is covered under Medicare fee-for-service programs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidCovered rdf:type rdf:Property ;
    rdfs:label 'Medicaid Covered' ;
    rdfs:comment 'Flag indicating whether this procedure is covered under state Medicaid programs, subject to state-specific variations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialCovered rdf:type rdf:Property ;
    rdfs:label 'Commercial Covered' ;
    rdfs:comment 'Flag indicating whether this procedure is typically covered under commercial health insurance plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:experimentalIndicator rdf:type rdf:Property ;
    rdfs:label 'Experimental Indicator' ;
    rdfs:comment 'Flag indicating whether this procedure is considered experimental or investigational and may not be covered by insurance.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cosmeticIndicator rdf:type rdf:Property ;
    rdfs:label 'Cosmetic Indicator' ;
    rdfs:comment 'Flag indicating whether this procedure is considered cosmetic and typically not covered by health insurance unless medically necessary.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialtyDesignation rdf:type rdf:Property ;
    rdfs:label 'Specialty Designation' ;
    rdfs:comment 'The medical specialty or provider type most commonly associated with performing this procedure such as cardiology, orthopedics, or radiology.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalCategory rdf:type rdf:Property ;
    rdfs:label 'Clinical Category' ;
    rdfs:comment 'Broad clinical classification of the procedure for analytics and reporting such as cardiovascular, musculoskeletal, or diagnostic imaging.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typeOfService rdf:type rdf:Property ;
    rdfs:label 'Type Of Service' ;
    rdfs:comment 'CMS type of service classification used for payment and utilization analysis such as medical care, surgery, consultation, or diagnostic test.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outlierThreshold rdf:type rdf:Property ;
    rdfs:label 'Outlier Threshold' ;
    rdfs:comment 'The cost threshold above which additional outlier payments may be made for extraordinarily expensive cases under prospective payment systems.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sequestrationAdjustment rdf:type rdf:Property ;
    rdfs:label 'Sequestration Adjustment' ;
    rdfs:comment 'The percentage reduction applied to Medicare payments due to federal budget sequestration requirements.' ;
    rdfs:domain ind:Procedure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastUpdatedBy rdf:type rdf:Property ;
    rdfs:label 'Last Updated By' ;
    rdfs:comment 'The user ID or system identifier that last modified this procedure code record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentTypeId rdf:type rdf:Property ;
    rdfs:label 'Assessment Type Id' ;
    rdfs:comment 'Unique identifier for the assessment type. Primary key for the assessment type reference data.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AssessmentType .

ind:scoringMethodology rdf:type rdf:Property ;
    rdfs:label 'Scoring Methodology' ;
    rdfs:comment 'Method used to calculate and interpret assessment results (e.g., numeric sum, weighted score, categorical classification, risk stratification algorithm).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoringRangeMin rdf:type rdf:Property ;
    rdfs:label 'Scoring Range Min' ;
    rdfs:comment 'Minimum possible score for assessments using numeric scoring methodology. Null for non-numeric assessments.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoringRangeMax rdf:type rdf:Property ;
    rdfs:label 'Scoring Range Max' ;
    rdfs:comment 'Maximum possible score for assessments using numeric scoring methodology. Null for non-numeric assessments.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interpretationGuidance rdf:type rdf:Property ;
    rdfs:label 'Interpretation Guidance' ;
    rdfs:comment 'Clinical guidance for interpreting assessment scores and results, including risk level thresholds and recommended actions based on score ranges.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskStratificationEnabled rdf:type rdf:Property ;
    rdfs:label 'Risk Stratification Enabled' ;
    rdfs:comment 'Indicates whether this assessment type supports risk stratification of members into low, medium, high risk categories for care management prioritization.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:standardCodeSystem rdf:type rdf:Property ;
    rdfs:label 'Standard Code System' ;
    rdfs:comment 'Industry-standard coding system used to classify this assessment type (e.g., LOINC for clinical observations, CPT for procedures, proprietary for internal assessments).' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardCode rdf:type rdf:Property ;
    rdfs:label 'Standard Code' ;
    rdfs:comment 'The specific code value from the standard code system that represents this assessment type (e.g., LOINC code 44249-1 for PHQ-9).' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardCodeDescription rdf:type rdf:Property ;
    rdfs:label 'Standard Code Description' ;
    rdfs:comment 'Official description from the standard code system for the assigned code.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administrationMethod rdf:type rdf:Property ;
    rdfs:label 'Administration Method' ;
    rdfs:comment 'Primary method by which the assessment is administered to members (e.g., self-administered online, telephonic interview, in-person clinical assessment).' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programType rdf:type rdf:Property ;
    rdfs:label 'Program Type' ;
    rdfs:comment 'Type of care management or disease management program that utilizes this assessment (e.g., Chronic Care Management, Transitional Care, Complex Case Management, Behavioral Health Integration).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedisMeasureCodes rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Codes' ;
    rdfs:comment 'Comma-separated list of HEDIS measure codes that utilize this assessment type (e.g., CBP, CDC, COL, BCS).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:starsMeasureCodes rdf:type rdf:Property ;
    rdfs:label 'Stars Measure Codes' ;
    rdfs:comment 'Comma-separated list of CMS Stars measure codes that utilize this assessment type.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueBasedCareApplicable rdf:type rdf:Property ;
    rdfs:label 'Value Based Care Applicable' ;
    rdfs:comment 'Indicates whether this assessment type is used in value-based care contracts, alternative payment models, or accountable care organization quality measures.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hccCodingImpact rdf:type rdf:Property ;
    rdfs:label 'Hcc Coding Impact' ;
    rdfs:comment 'Indicates whether assessment results can support or validate HCC diagnosis coding for risk adjustment purposes.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:frequencyRecommendation rdf:type rdf:Property ;
    rdfs:label 'Frequency Recommendation' ;
    rdfs:comment 'Recommended frequency for administering this assessment type based on clinical guidelines and care management protocols.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCompletionTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Estimated Completion Time Minutes' ;
    rdfs:comment 'Average time in minutes required to complete the assessment, used for care management resource planning and member communication.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:questionCount rdf:type rdf:Property ;
    rdfs:label 'Question Count' ;
    rdfs:comment 'Total number of questions or items included in the assessment instrument.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validatedInstrument rdf:type rdf:Property ;
    rdfs:label 'Validated Instrument' ;
    rdfs:comment 'Indicates whether this assessment is a clinically validated instrument with established reliability and validity in peer-reviewed literature.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:validationReference rdf:type rdf:Property ;
    rdfs:label 'Validation Reference' ;
    rdfs:comment 'Citation or reference to the clinical validation study or published research supporting the assessment instrument.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copyrightHolder rdf:type rdf:Property ;
    rdfs:label 'Copyright Holder' ;
    rdfs:comment 'Organization or entity holding copyright or intellectual property rights for the assessment instrument (e.g., Pfizer for GAD-7, public domain).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseTerms rdf:type rdf:Property ;
    rdfs:label 'License Terms' ;
    rdfs:comment 'Summary of licensing terms, restrictions, or usage conditions for the assessment instrument.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageAvailability rdf:type rdf:Property ;
    rdfs:label 'Language Availability' ;
    rdfs:comment 'Comma-separated list of languages in which the assessment is available (e.g., English, Spanish, Chinese, Vietnamese) to support diverse member populations.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:culturalAdaptationNotes rdf:type rdf:Property ;
    rdfs:label 'Cultural Adaptation Notes' ;
    rdfs:comment 'Notes on cultural adaptations or considerations for administering the assessment to diverse populations.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresClinicalReview rdf:type rdf:Property ;
    rdfs:label 'Requires Clinical Review' ;
    rdfs:comment 'Indicates whether assessment results require review by a licensed clinical professional (nurse, physician, behavioral health specialist) before care plan development.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triggersIntervention rdf:type rdf:Property ;
    rdfs:label 'Triggers Intervention' ;
    rdfs:comment 'Indicates whether certain assessment results automatically trigger care management interventions, outreach, or escalation protocols.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interventionThreshold rdf:type rdf:Property ;
    rdfs:label 'Intervention Threshold' ;
    rdfs:comment 'Description of score thresholds or result criteria that trigger care management interventions or escalation (e.g., PHQ-9 score >= 10 triggers depression care management).' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationRequirement rdf:type rdf:Property ;
    rdfs:label 'Accreditation Requirement' ;
    rdfs:comment 'Indicates whether this assessment is required for NCQA, URAC, or Joint Commission accreditation.' ;
    rdfs:domain ind:Care ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataCollectionSystem rdf:type rdf:Property ;
    rdfs:label 'Data Collection System' ;
    rdfs:comment 'Primary system or platform used to collect and store assessment data (e.g., Pegasystems Care Management, Salesforce Health Cloud, proprietary assessment portal).' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrationMethod rdf:type rdf:Property ;
    rdfs:label 'Integration Method' ;
    rdfs:comment 'Technical method for integrating assessment data with core systems (e.g., HL7 interface, FHIR API, EDI transaction, manual data entry).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiDataIncluded rdf:type rdf:Property ;
    rdfs:label 'Phi Data Included' ;
    rdfs:comment 'Indicates whether the assessment collects or contains Protected Health Information subject to HIPAA Privacy Rule requirements.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentRequired rdf:type rdf:Property ;
    rdfs:label 'Consent Required' ;
    rdfs:comment 'Indicates whether explicit member consent is required before administering this assessment, beyond standard care management authorization.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:versionDate rdf:type rdf:Property ;
    rdfs:label 'Version Date' ;
    rdfs:comment 'Date when this version of the assessment was released or implemented.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supersedesAssessmentTypeCode rdf:type rdf:Property ;
    rdfs:label 'Supersedes Assessment Type Code' ;
    rdfs:comment 'Code of the previous assessment type that this version replaces or supersedes, used to track assessment evolution and maintain historical continuity.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectMatterExpert rdf:type rdf:Property ;
    rdfs:label 'Subject Matter Expert' ;
    rdfs:comment 'Name or role of the clinical subject matter expert responsible for clinical oversight of this assessment type.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageNotes rdf:type rdf:Property ;
    rdfs:label 'Usage Notes' ;
    rdfs:comment 'Additional operational notes, special instructions, or considerations for care managers administering this assessment.' ;
    rdfs:domain ind:AssessmentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventId rdf:type rdf:Property ;
    rdfs:label 'Event Id' ;
    rdfs:comment 'Unique identifier for the claim event record.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:timestamp rdf:type rdf:Property ;
    rdfs:label 'Timestamp' ;
    rdfs:comment 'Date and time when the event was recorded.' ;
