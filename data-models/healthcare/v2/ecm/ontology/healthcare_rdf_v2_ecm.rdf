    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:datasetStatus rdf:type rdf:Property ;
    rdfs:label 'Dataset Status' ;
    rdfs:comment 'Current lifecycle status of the de-identified dataset indicating its availability and governance state. [ENUM-REF-CANDIDATE: draft|under_review|approved|active|archived|retired|suspended — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:datasetType rdf:type rdf:Property ;
    rdfs:label 'Dataset Type' ;
    rdfs:comment 'Classification of the dataset based on its source and nature (e.g., clinical trial data, observational study, EHR-derived, claims-derived). [ENUM-REF-CANDIDATE: clinical_trial|observational_study|registry|biobank|genomic|imaging|ehr_derived|claims_derived — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:datasetVersion rdf:type rdf:Property ;
    rdfs:label 'Dataset Version' ;
    rdfs:comment 'Version number or identifier for this iteration of the dataset, supporting version control and lineage tracking.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dateRangeEnd rdf:type rdf:Property ;
    rdfs:label 'Date Range End' ;
    rdfs:comment 'The latest date of data included in the dataset, defining the temporal coverage end boundary.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateRangeStart rdf:type rdf:Property ;
    rdfs:label 'Date Range Start' ;
    rdfs:comment 'The earliest date of data included in the dataset, defining the temporal coverage start boundary.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deidentificationDate rdf:type rdf:Property ;
    rdfs:label 'Deidentification Date' ;
    rdfs:comment 'The date when the de-identification process was completed and certified for this dataset.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deidentificationMethod rdf:type rdf:Property ;
    rdfs:label 'Deidentification Method' ;
    rdfs:comment 'The method used to de-identify the dataset per HIPAA standards: Safe Harbor (removal of 18 identifiers), Expert Determination, or Limited Dataset approach.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deidentificationPerformedBy rdf:type rdf:Property ;
    rdfs:label 'Deidentification Performed By' ;
    rdfs:comment 'Name or identifier of the individual or team who performed the de-identification process.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expertDeterminationCertificationFlag rdf:type rdf:Property ;
    rdfs:label 'Expert Determination Certification Flag' ;
    rdfs:comment 'Indicates whether the dataset received expert determination certification per HIPAA 45 CFR 164.514(b)(1).' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expertName rdf:type rdf:Property ;
    rdfs:label 'Expert Name' ;
    rdfs:comment 'Name of the qualified statistical expert who provided the expert determination certification, if applicable.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaLimitedDatasetFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Limited Dataset Flag' ;
