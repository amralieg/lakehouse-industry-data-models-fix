ind:actionDueDate rdf:type rdf:Property ;
    rdfs:label 'Action Due Date' ;
    rdfs:comment 'Target date by which the follow-up action identified in the case note should be completed.' ;
    rdfs:domain ind:CaseNote ;
    rdf:type owl:DatatypeProperty ;
