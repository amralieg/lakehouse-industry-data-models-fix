    rdfs:range xsd:integer .

ind:lineupCode rdf:type rdf:Property ;
    rdfs:label 'Lineup Code' ;
    rdfs:comment 'Externally-known unique business identifier for the lineup used in gaming operations and regulatory reporting.' ;
    rdfs:domain ind:Lineup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineupConfidenceScore rdf:type rdf:Property ;
