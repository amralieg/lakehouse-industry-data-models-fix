    rdfs:comment 'Result of the latest compliance review.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceReviewNotes rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Notes' ;
    rdfs:comment 'Free-text notes from the compliance review.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Regulatory Document Url' ;
    rdfs:comment 'Link to the regulatory document or policy governing the plan.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEssentialBenefitCovered rdf:type rdf:Property ;
    rdfs:label 'Is Essential Benefit Covered' ;
    rdfs:comment 'Indicates if the plan covers all ACA essential health benefits.' ;
    rdfs:domain ind:RegulatoryCompliance ;
    rdf:type owl:DatatypeProperty ;
