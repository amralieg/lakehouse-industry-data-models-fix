    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugInteractionLevel rdf:type rdf:Property ;
    rdfs:label 'Drug Interaction Level' ;
    rdfs:comment 'Highest level of drug interaction risk associated with this medication.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapeuticEquivalentCode rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Equivalent Code' ;
    rdfs:comment 'FDA Orange Book code indicating therapeutic equivalence (AB=therapeutically equivalent, BX=not equivalent).' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formularyTierId rdf:type rdf:Property ;
    rdfs:label 'Formulary Tier Id' ;
    rdfs:comment 'Unique identifier for the formulary tier classification record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FormularyTier .

ind:tierCode rdf:type rdf:Property ;
    rdfs:label 'Tier Code' ;
    rdfs:comment 'Short alphanumeric code representing the tier classification (e.g., T1, T2, SPEC).' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierName rdf:type rdf:Property ;
    rdfs:label 'Tier Name' ;
    rdfs:comment 'Full descriptive name of the formulary tier (e.g., Tier 1 - Generic, Tier 2 - Preferred Brand, Tier 3 - Non-Preferred Brand, Tier 4 - Specialty).' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierCategory rdf:type rdf:Property ;
    rdfs:label 'Tier Category' ;
    rdfs:comment 'Broad category classification of the tier indicating the type of drugs included (e.g., generic, preferred brand, specialty).' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costShareType rdf:type rdf:Property ;
    rdfs:label 'Cost Share Type' ;
    rdfs:comment 'Type of cost-sharing structure applied to this tier (e.g., copay, coinsurance, hybrid, deductible only).' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initialCoverageCopay rdf:type rdf:Property ;
    rdfs:label 'Initial Coverage Copay' ;
    rdfs:comment 'Copayment amount during the initial coverage phase for Medicare Part D plans.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:initialCoverageCoinsurance rdf:type rdf:Property ;
    rdfs:label 'Initial Coverage Coinsurance' ;
    rdfs:comment 'Coinsurance percentage during the initial coverage phase for Medicare Part D plans.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gapCoverageCopay rdf:type rdf:Property ;
    rdfs:label 'Gap Coverage Copay' ;
    rdfs:comment 'Copayment amount during the coverage gap (donut hole) phase for Medicare Part D plans.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gapCoverageCoinsurance rdf:type rdf:Property ;
    rdfs:label 'Gap Coverage Coinsurance' ;
    rdfs:comment 'Coinsurance percentage during the coverage gap (donut hole) phase for Medicare Part D plans.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catastrophicCopay rdf:type rdf:Property ;
    rdfs:label 'Catastrophic Copay' ;
    rdfs:comment 'Copayment amount during the catastrophic coverage phase for Medicare Part D plans.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catastrophicCoinsurance rdf:type rdf:Property ;
    rdfs:label 'Catastrophic Coinsurance' ;
    rdfs:comment 'Coinsurance percentage during the catastrophic coverage phase for Medicare Part D plans.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mailOrderCopay rdf:type rdf:Property ;
    rdfs:label 'Mail Order Copay' ;
    rdfs:comment 'Copayment amount for drugs in this tier when obtained through mail order pharmacy (typically for 90-day supply).' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mailOrderCoinsurance rdf:type rdf:Property ;
    rdfs:label 'Mail Order Coinsurance' ;
    rdfs:comment 'Coinsurance percentage for drugs in this tier when obtained through mail order pharmacy.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retail30DayCopay rdf:type rdf:Property ;
    rdfs:label 'Retail 30 Day Copay' ;
    rdfs:comment 'Copayment amount for a 30-day supply at retail pharmacy for drugs in this tier.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retail90DayCopay rdf:type rdf:Property ;
    rdfs:label 'Retail 90 Day Copay' ;
    rdfs:comment 'Copayment amount for a 90-day supply at retail pharmacy for drugs in this tier.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredPharmacyCopay rdf:type rdf:Property ;
    rdfs:label 'Preferred Pharmacy Copay' ;
    rdfs:comment 'Copayment amount when drugs in this tier are obtained from a preferred network pharmacy.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:standardPharmacyCopay rdf:type rdf:Property ;
    rdfs:label 'Standard Pharmacy Copay' ;
    rdfs:comment 'Copayment amount when drugs in this tier are obtained from a standard network pharmacy.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outOfNetworkCopay rdf:type rdf:Property ;
    rdfs:label 'Out Of Network Copay' ;
    rdfs:comment 'Copayment amount when drugs in this tier are obtained from an out-of-network pharmacy.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumCostShare rdf:type rdf:Property ;
    rdfs:label 'Minimum Cost Share' ;
    rdfs:comment 'Minimum dollar amount the member must pay for drugs in this tier, regardless of actual drug cost.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumCostShare rdf:type rdf:Property ;
    rdfs:label 'Maximum Cost Share' ;
    rdfs:comment 'Maximum dollar amount the member pays for drugs in this tier, serving as a cost-share cap.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityLimitAppliesFlag rdf:type rdf:Property ;
    rdfs:label 'Quantity Limit Applies Flag' ;
    rdfs:comment 'Indicates whether drugs in this tier are subject to quantity limit restrictions on the amount dispensed per fill or time period.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialtyTierFlag rdf:type rdf:Property ;
    rdfs:label 'Specialty Tier Flag' ;
    rdfs:comment 'Indicates whether this tier is designated as a specialty tier for high-cost or specialty medications.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genericTierFlag rdf:type rdf:Property ;
    rdfs:label 'Generic Tier Flag' ;
    rdfs:comment 'Indicates whether this tier is designated for generic drugs.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brandTierFlag rdf:type rdf:Property ;
    rdfs:label 'Brand Tier Flag' ;
    rdfs:comment 'Indicates whether this tier is designated for brand-name drugs.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preventiveTierFlag rdf:type rdf:Property ;
    rdfs:label 'Preventive Tier Flag' ;
    rdfs:comment 'Indicates whether this tier is designated for preventive medications covered at no cost under ACA (Affordable Care Act) requirements.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coveragePhase rdf:type rdf:Property ;
    rdfs:label 'Coverage Phase' ;
    rdfs:comment 'Medicare Part D coverage phase to which this tier cost-sharing applies (e.g., deductible, initial coverage, coverage gap, catastrophic).' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberFacingName rdf:type rdf:Property ;
    rdfs:label 'Member Facing Name' ;
    rdfs:comment 'Simplified, member-friendly name for the tier used in member communications and benefit materials.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsTierId rdf:type rdf:Property ;
    rdfs:label 'Cms Tier Id' ;
    rdfs:comment 'CMS-assigned identifier for this tier used in Medicare Part D formulary submissions and reporting.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncqaTierCode rdf:type rdf:Property ;
    rdfs:label 'Ncqa Tier Code' ;
    rdfs:comment 'NCQA-standardized tier code used for quality reporting and accreditation purposes.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pbmTierCode rdf:type rdf:Property ;
    rdfs:label 'Pbm Tier Code' ;
    rdfs:comment 'PBM system-specific tier code used for claims adjudication and pharmacy network communication.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ediTierCode rdf:type rdf:Property ;
    rdfs:label 'Edi Tier Code' ;
    rdfs:comment 'Standardized tier code used in EDI transactions (e.g., NCPDP D.0) for pharmacy claims processing.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierRank rdf:type rdf:Property ;
    rdfs:label 'Tier Rank' ;
    rdfs:comment 'Relative ranking of this tier within the formulary structure, used for cost-sharing comparisons and analytics.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:costShareVarianceAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Cost Share Variance Allowed Flag' ;
    rdfs:comment 'Indicates whether cost-sharing amounts for this tier can vary by employer group, plan design, or geographic region.' ;
    rdfs:domain ind:FormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employerCustomizableFlag rdf:type rdf:Property ;
    rdfs:label 'Employer Customizable Flag' ;
    rdfs:comment 'Indicates whether employer groups can customize cost-sharing amounts for this tier in their plan designs.' ;
