    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsIncurred rdf:type rdf:Property ;
    rdfs:label 'Claims Incurred' ;
    rdfs:comment 'Total claims incurred amount reported in the filing for the applicable period.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:administrativeExpenses rdf:type rdf:Property ;
    rdfs:label 'Administrative Expenses' ;
    rdfs:comment 'Total administrative expenses reported in the filing for the applicable period.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityRatingScore rdf:type rdf:Property ;
    rdfs:label 'Quality Rating Score' ;
    rdfs:comment 'Overall quality rating score (e.g., Star Rating for Medicare Advantage) reported in the filing.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedisMeasureCount rdf:type rdf:Property ;
    rdfs:label 'Hedis Measure Count' ;
    rdfs:comment 'Number of HEDIS measures reported in the filing.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceAttestationFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Attestation Flag' ;
    rdfs:comment 'Indicates whether the filing includes a formal attestation of compliance with applicable laws and regulations.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:confidentialTreatmentRequestedFlag rdf:type rdf:Property ;
    rdfs:label 'Confidential Treatment Requested Flag' ;
    rdfs:comment 'Indicates whether the submitting organization has requested confidential treatment or trade secret protection for portions of the filing.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
