    rdfs:domain ind:Slate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentEntryCount rdf:type rdf:Property ;
    rdfs:label 'Current Entry Count' ;
    rdfs:comment 'Current number of participant entries registered for the slate at the time of data capture.' ;
    rdfs:domain ind:Slate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:featuredFlag rdf:type rdf:Property ;
    rdfs:label 'Featured Flag' ;
    rdfs:comment 'Indicates whether the slate is featured or promoted prominently on the platform for increased visibility.' ;
    rdfs:domain ind:SportsEntertainment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geofenceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Geofence Required Flag' ;
    rdfs:comment 'Indicates whether geolocation verification is required for participants to enter the slate, ensuring compliance with jurisdictional restrictions.' ;
    rdfs:domain ind:Slate ;
