    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expeditedReason rdf:type rdf:Property ;
    rdfs:label 'Expedited Reason' ;
    rdfs:comment 'Reason or justification for processing the application through expedited review.' ;
