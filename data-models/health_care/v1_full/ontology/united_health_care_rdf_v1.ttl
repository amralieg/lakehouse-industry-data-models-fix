    rdfs:domain ind:Metric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdMinimum rdf:type rdf:Property ;
    rdfs:label 'Threshold Minimum' ;
    rdfs:comment 'Minimum acceptable value below which performance is considered substandard.' ;
