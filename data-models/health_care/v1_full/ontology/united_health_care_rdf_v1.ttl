    rdfs:comment 'Amount of alternative minimum tax calculated and owed.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedTaxPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Tax Payment Amount' ;
    rdfs:comment 'Total estimated tax payments made during the tax year.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookTaxDifferenceAmount rdf:type rdf:Property ;
    rdfs:label 'Book Tax Difference Amount' ;
    rdfs:comment 'Total permanent and temporary differences between book income (GAAP) and taxable income.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredTaxAssetAmount rdf:type rdf:Property ;
    rdfs:label 'Deferred Tax Asset Amount' ;
    rdfs:comment 'Amount of deferred tax assets recognized for temporary differences and carryforwards.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredTaxLiabilityAmount rdf:type rdf:Property ;
    rdfs:label 'Deferred Tax Liability Amount' ;
    rdfs:comment 'Amount of deferred tax liabilities recognized for temporary differences.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uncertainTaxPositionAmount rdf:type rdf:Property ;
