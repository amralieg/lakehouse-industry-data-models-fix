  vendor_contract_id varchar [note: 'Foreign key linking to technology.vendor_contract. Business justification: tech_project.contract_number (STRING) should be normalized to FK to vendor_contract. Technology projects are often executed under vendor contracts (system integrators, equipment suppliers). This links | Column vendor_contract_id (BIGINT) in technology.tech_project']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.tech_project']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.tech_project']
  actual_end_date date [note: 'Actual date when the technology project was completed and closed, which may differ from the planned end date due to schedule variance. | Column actual_end_date (DATE) in technology.tech_project']
  actual_start_date date [note: 'Actual date when the technology project execution began, which may differ from the planned start date due to delays or accelerations. | Column actual_start_date (DATE) in technology.tech_project']
  approval_date date [note: 'Date when the technology project was formally approved by executive leadership or governance board, authorizing budget and resource allocation. | Column approval_date (DATE) in technology.tech_project']
  budget_variance_usd decimal(15,2) [note: 'Difference between total approved budget and forecast total cost in US dollars, indicating over-budget (negative) or under-budget (positive) status. | Column budget_variance_usd (DECIMAL(15,2)) in technology.tech_project']
  business_justification varchar [note: 'Business case and strategic rationale for the technology project, including expected benefits, ROI, regulatory compliance drivers, or operational improvements. | Column business_justification (STRING) in technology.tech_project']
  business_sponsor_name varchar [note: 'Name of the executive or senior leader sponsoring the technology project and providing business direction and funding approval. | Column business_sponsor_name (STRING) in technology.tech_project']
  capital_expenditure_usd decimal(15,2) [note: 'Portion of the project budget allocated to capital expenditure (CapEx) for long-term infrastructure assets such as broadcast equipment, servers, and network hardware. | Column capital_expenditure_usd (DECIMAL(15,2)) in technology.tech_project']
  change_management_required_flag boolean [note: 'Indicates whether formal organizational change management activities are required due to significant process, workflow, or operational changes introduced by the technology project. | Column change_management_required_flag (BOOLEAN) in technology.tech_project']
  compliance_requirement_flag boolean [note: 'Indicates whether the technology project is driven by regulatory or compliance requirements such as FCC mandates, ATSC 3.0 transition deadlines, or security standards. | Column compliance_requirement_flag (BOOLEAN) in technology.tech_project']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.tech_project']
  created_timestamp timestamp [note: 'Timestamp when the technology project record was first created in the system, supporting audit trail and data lineage requirements. | Column created_timestamp (TIMESTAMP) in technology.tech_project']
  forecast_completion_date date [note: 'Current projected completion date for the technology project based on actual progress and remaining work, updated regularly during execution. | Column forecast_completion_date (DATE) in technology.tech_project']
  forecast_total_cost_usd decimal(15,2) [note: 'Current projected total cost for the technology project at completion in US dollars, based on actual spend and estimated remaining costs. | Column forecast_total_cost_usd (DECIMAL(15,2)) in technology.tech_project']
  health_indicator varchar [note: 'RAG (Red-Amber-Green) status indicator summarizing overall project health across schedule, budget, scope, and quality dimensions: green (on track), yellow (at risk), red (critical issues). | Column health_indicator (STRING) in technology.tech_project']
  integration_complexity varchar [note: 'Assessment of the technical complexity of integrating the new technology with existing broadcast systems, workflows, and infrastructure: low, medium, high, or very high. | Column integration_complexity (STRING) in technology.tech_project']
  last_status_update_date date [note: 'Date of the most recent project status update or progress report, used to track reporting currency and governance compliance. | Column last_status_update_date (DATE) in technology.tech_project']
  milestone_summary varchar [note: 'High-level summary of key project milestones achieved and upcoming, providing snapshot of progress for executive reporting and stakeholder communication. | Column milestone_summary (STRING) in technology.tech_project']
  notes varchar [note: 'Free-form notes capturing additional context, issues, decisions, or observations about the technology project not captured in structured fields. | Column notes (STRING) in technology.tech_project']
  operational_expenditure_usd decimal(15,2) [note: 'Portion of the project budget allocated to operational expenditure (OpEx) for recurring costs such as cloud services, software licenses, and maintenance contracts. | Column operational_expenditure_usd (DECIMAL(15,2)) in technology.tech_project']
  planned_end_date date [note: 'Originally scheduled date for the technology project to complete and close, as defined during project planning phase. | Column planned_end_date (DATE) in technology.tech_project']
  planned_start_date date [note: 'Originally scheduled date for the technology project to begin execution, as defined during project planning phase. | Column planned_start_date (DATE) in technology.tech_project']
  priority_level varchar [note: 'Business priority classification of the technology project relative to other initiatives, determining resource allocation and executive attention: critical, high, medium, or low. | Column priority_level (STRING) in technology.tech_project']
  project_code varchar [note: 'Externally-known unique business identifier for the technology project, typically following a standardized format (e.g., BRD-2024-IP for broadcast IP migration). | Column project_code (STRING) in technology.tech_project']
  project_manager_name varchar [note: 'Name of the project manager responsible for day-to-day coordination, scheduling, and delivery of the technology project. | Column project_manager_name (STRING) in technology.tech_project']
  project_name varchar [note: 'Human-readable name of the technology infrastructure project (e.g., ATSC 3.0 Transmitter Upgrade, Cloud Playout Migration). | Column project_name (STRING) in technology.tech_project']
  project_phase varchar [note: 'Current lifecycle phase of the technology project following PMI PMBOK methodology: initiation, planning, execution, monitoring and control, closure, on hold, or cancelled. [ENUM-REF-CANDIDATE: initiation|planning|execution|monitoring_and_control|closure|on_hold|cancelled — 7 candidates stripped; promote to reference product] | Column project_phase (STRING) in technology.tech_project']
  project_status varchar [note: 'Current operational status of the technology project indicating health and progress: not started, in progress, at risk, delayed, completed, cancelled, or suspended. [ENUM-REF-CANDIDATE: not_started|in_progress|at_risk|delayed|completed|cancelled|suspended — 7 candidates stripped; promote to reference product] | Column project_status (STRING) in technology.tech_project']
  project_type varchar [note: 'Classification of the technology project by its primary focus area: broadcast system upgrade, ATSC 3.0 transition, IP studio migration, cloud infrastructure deployment, NOC modernization, or transmission equipment upgrade. | Column project_type (STRING) in technology.tech_project']
  risk_status varchar [note: 'Overall risk assessment for the technology project based on identified risks, mitigation effectiveness, and potential impact to schedule, budget, or scope. | Column risk_status (STRING) in technology.tech_project']
  scope_description varchar [note: 'Detailed description of the technology project scope, including systems, facilities, and infrastructure components to be delivered or upgraded. | Column scope_description (STRING) in technology.tech_project']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.tech_project']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.tech_project']
  spend_to_date_usd decimal(15,2) [note: 'Cumulative actual expenditure on the technology project to date in US dollars, tracked against the total approved budget. | Column spend_to_date_usd (DECIMAL(15,2)) in technology.tech_project']
  technology_owner_name varchar [note: 'Name of the technology leader or architect responsible for technical delivery and infrastructure outcomes of the project. | Column technology_owner_name (STRING) in technology.tech_project']
  technology_stack varchar [note: 'Description of the core technologies, platforms, and systems being deployed or upgraded as part of the project (e.g., SMPTE ST 2110 IP infrastructure, AWS cloud platform, ATSC 3.0 transmitters). | Column technology_stack (STRING) in technology.tech_project']
  total_budget_usd decimal(15,2) [note: 'Total approved budget for the technology infrastructure project in US dollars, including capital expenditure and operational expenditure components. | Column total_budget_usd (DECIMAL(15,2)) in technology.tech_project']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.tech_project']
  updated_timestamp timestamp [note: 'Timestamp when the technology project record was last modified, supporting audit trail and change tracking requirements. | Column updated_timestamp (TIMESTAMP) in technology.tech_project']
  vendor_name varchar [note: 'Name of the primary vendor or systems integrator contracted to deliver the technology infrastructure project (e.g., Ericsson, Cisco, AWS). | Column vendor_name (STRING) in technology.tech_project']

  Note: 'Master record for technology infrastructure projects — broadcast system upgrades, ATSC 3.0 transition projects, IP studio migrations, cloud infrastructure deployments, and NOC modernization initiatives. Captures project name, project type, business sponsor, technology owner, project phase (initiation, planning, execution, closure), planned start/end date, actual start/end date, total budget, spend-to-date, milestone summary, risk status, and project health indicator. Distinct from production.project (content production) — this tracks technology infrastructure investment projects. | Unity Catalog table: media_broadcasting_ecm.technology.tech_project'
}

Table technology.tech_sla {
  tech_sla_id varchar [pk, note: 'Unique identifier for the technology infrastructure service level agreement record. | Column tech_sla_id (BIGINT) in technology.tech_sla']
  superseded_tech_sla_id varchar [note: 'Self-referencing FK on tech_sla (superseded_tech_sla_id) | Column superseded_tech_sla_id (BIGINT) in technology.tech_sla']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.tech_sla']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.tech_sla']
  approval_date date [note: 'Date when this SLA definition was formally approved. | Column approval_date (DATE) in technology.tech_sla']
  approved_by varchar [note: 'Name or identifier of the executive or manager who approved this SLA definition. | Column approved_by (STRING) in technology.tech_sla']
  breach_penalty_definition varchar [note: 'Description of penalties, remediation actions, or service credits applied when SLA targets are not met. May include financial penalties, escalation procedures, or compensatory measures. | Column breach_penalty_definition (STRING) in technology.tech_sla']
  breach_threshold_percentage decimal(5,2) [note: 'Percentage threshold below target availability that triggers a formal SLA breach (e.g., if target is 99.99% and breach threshold is 99.90%, falling below 99.90% triggers breach penalties). | Column breach_threshold_percentage (DECIMAL(5,2)) in technology.tech_sla']
  business_unit_served varchar [note: 'Name of the internal business unit or division that this SLA serves (e.g., News Division, Sports Production, Digital Streaming, Linear Broadcast Operations). | Column business_unit_served (STRING) in technology.tech_sla']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.tech_sla']
  created_timestamp timestamp [note: 'Timestamp when this SLA record was first created in the system. | Column created_timestamp (TIMESTAMP) in technology.tech_sla']
  effective_end_date date [note: 'Date when this SLA expires or is scheduled for renewal. Null for open-ended SLAs. | Column effective_end_date (DATE) in technology.tech_sla']
  effective_start_date date [note: 'Date when this SLA becomes effective and performance measurement begins. | Column effective_start_date (DATE) in technology.tech_sla']
  escalation_procedure varchar [note: 'Description of the escalation path and procedures when SLA targets are at risk or breached, including contact points and escalation timelines. | Column escalation_procedure (STRING) in technology.tech_sla']
  exclusions varchar [note: 'Description of circumstances, events, or conditions excluded from SLA measurement (e.g., planned maintenance windows, force majeure events, third-party vendor outages). | Column exclusions (STRING) in technology.tech_sla']
  last_review_date date [note: 'Date when this SLA was last formally reviewed by stakeholders. | Column last_review_date (DATE) in technology.tech_sla']
  measurement_methodology varchar [note: 'Description of how SLA metrics are calculated and measured, including data sources, calculation formulas, and measurement intervals. | Column measurement_methodology (STRING) in technology.tech_sla']
  measurement_period varchar [note: 'Time period over which SLA performance is measured and reported (monthly, quarterly, annual, weekly, daily). | Column measurement_period (STRING) in technology.tech_sla']
  monitoring_tool varchar [note: 'Name of the monitoring system or tool used to measure and track SLA performance (e.g., Nagios, SolarWinds, Splunk, custom NOC dashboard). | Column monitoring_tool (STRING) in technology.tech_sla']
  mtbf_target_hours varchar [note: 'Target mean time between failures in hours - the average operational time between system failures or service interruptions. | Column mtbf_target_hours (INT) in technology.tech_sla']
  mttr_target_minutes varchar [note: 'Target mean time to repair in minutes - the average time committed to restore service after an incident or failure. | Column mttr_target_minutes (INT) in technology.tech_sla']
  next_review_date date [note: 'Scheduled date for the next formal review of this SLA definition and targets. | Column next_review_date (DATE) in technology.tech_sla']
  notes varchar [note: 'Additional notes, comments, or context about this SLA definition. | Column notes (STRING) in technology.tech_sla']
  owning_technology_team varchar [note: 'Name of the technology team or department responsible for delivering and maintaining this SLA (e.g., Broadcast Engineering, Network Operations Center, IT Infrastructure, Master Control). | Column owning_technology_team (STRING) in technology.tech_sla']
  priority_level varchar [note: 'Business priority level of the service covered by this SLA (critical for mission-critical broadcast services, high for important operations, medium for standard services, low for non-essential services). | Column priority_level (STRING) in technology.tech_sla']
  reporting_frequency varchar [note: 'Frequency at which SLA performance reports are generated and distributed to stakeholders (daily, weekly, monthly, quarterly, annual, real-time). | Column reporting_frequency (STRING) in technology.tech_sla']
  resolution_time_target_minutes varchar [note: 'Target resolution time in minutes for fully resolving and closing an incident or service request. | Column resolution_time_target_minutes (INT) in technology.tech_sla']
  response_time_target_minutes varchar [note: 'Target response time in minutes for NOC or helpdesk to acknowledge and begin addressing an incident or service request. | Column response_time_target_minutes (INT) in technology.tech_sla']
  review_frequency varchar [note: 'Frequency at which the SLA definition and targets are formally reviewed and potentially revised (monthly, quarterly, semi-annual, annual). | Column review_frequency (STRING) in technology.tech_sla']
  service_scope_description varchar [note: 'Detailed description of the technology services, systems, and infrastructure components covered by this SLA. | Column service_scope_description (STRING) in technology.tech_sla']
  service_type varchar [note: 'Category of technology infrastructure service covered by this SLA (broadcast uptime, network availability, NOC response, helpdesk support, playout reliability, transmission quality). | Column service_type (STRING) in technology.tech_sla']
  sla_code varchar [note: 'Unique business identifier code for the SLA used in operational systems and reporting (e.g., SLA-MC-001, SLA-NOC-002). | Column sla_code (STRING) in technology.tech_sla']
  sla_name varchar [note: 'Human-readable name of the technology SLA (e.g., Master Control Uptime SLA, NOC Response Time SLA, IT Helpdesk Resolution SLA). | Column sla_name (STRING) in technology.tech_sla']
  sla_status varchar [note: 'Current lifecycle status of the SLA definition (active, inactive, draft, under review, expired, suspended). | Column sla_status (STRING) in technology.tech_sla']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.tech_sla']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.tech_sla']
  target_availability_percentage decimal(5,2) [note: 'Target uptime or availability percentage committed in the SLA (e.g., 99.99% for master control, 99.95% for network availability). Expressed as percentage with two decimal precision. | Column target_availability_percentage (DECIMAL(5,2)) in technology.tech_sla']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.tech_sla']
  updated_timestamp timestamp [note: 'Timestamp when this SLA record was last modified. | Column updated_timestamp (TIMESTAMP) in technology.tech_sla']

  Note: 'Master record defining Service Level Agreements for technology infrastructure services provided internally to business units — broadcast uptime SLAs, NOC response time SLAs, IT helpdesk SLAs, and network availability SLAs. Captures SLA name, service type, target availability percentage (e.g., 99.99% for master control), MTTR target (minutes), MTBF target, measurement period, breach penalty definition, reporting frequency, and owning technology team. Technology-domain SLA definitions distinct from platform.sla_definition (OTT platform SLAs) and distribution.delivery_sla (partner delivery SLAs). | Unity Catalog table: media_broadcasting_ecm.technology.tech_sla'
}

Table technology.sla_performance_record {
  sla_performance_record_id varchar [pk, note: 'Unique identifier for the SLA performance measurement record. | Column sla_performance_record_id (BIGINT) in technology.sla_performance_record']
  outage_record_id varchar [note: 'Foreign key linking to technology.outage_record. Business justification: SLA breaches are often caused by outages. The \'breach_flag\', \'breach_duration_minutes\', and \'breach_root_cause\' fields correlate with outage events. Links the SLA performance measurement to the specif | Column outage_record_id (BIGINT) in technology.sla_performance_record']
  previous_sla_performance_record_id varchar [note: 'Self-referencing FK on sla_performance_record (previous_sla_performance_record_id) | Column previous_sla_performance_record_id (BIGINT) in technology.sla_performance_record']
  tech_sla_id varchar [note: 'Reference to the technology SLA definition that this performance record measures against. | Column tech_sla_id (BIGINT) in technology.sla_performance_record']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.sla_performance_record']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.sla_performance_record']
  actual_mttr_minutes decimal(10,2) [note: 'The actual mean time to repair measured during the period, representing the average time taken to restore service after an incident. | Column actual_mttr_minutes (DECIMAL(10,2)) in technology.sla_performance_record']
  breach_duration_minutes decimal(10,2) [note: 'The total duration in minutes that the service was in breach of the SLA during the measurement period. Null if no breach occurred. | Column breach_duration_minutes (DECIMAL(10,2)) in technology.sla_performance_record']
  breach_flag boolean [note: 'Indicates whether the SLA was breached during this measurement period (True = breached, False = met). | Column breach_flag (BOOLEAN) in technology.sla_performance_record']
  breach_root_cause varchar [note: 'Detailed description of the root cause analysis for the SLA breach, identifying the underlying technical or operational issue. | Column breach_root_cause (STRING) in technology.sla_performance_record']
  breach_root_cause_category varchar [note: 'High-level categorization of the root cause for the SLA breach. [ENUM-REF-CANDIDATE: hardware_failure|software_defect|network_issue|power_outage|human_error|third_party|planned_maintenance — 7 candidates stripped; promote to reference product] | Column breach_root_cause_category (STRING) in technology.sla_performance_record']
  breach_severity varchar [note: 'The severity classification of the SLA breach based on the magnitude of the deviation from target. | Column breach_severity (STRING) in technology.sla_performance_record']
  compliance_status varchar [note: 'The overall compliance status of this SLA performance record against regulatory and contractual obligations. | Column compliance_status (STRING) in technology.sla_performance_record']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.sla_performance_record']
  created_timestamp timestamp [note: 'The timestamp when this SLA performance record was first created in the system. | Column created_timestamp (TIMESTAMP) in technology.sla_performance_record']
  incident_count varchar [note: 'The total number of incidents that occurred during the measurement period affecting the SLA. | Column incident_count (INT) in technology.sla_performance_record']
  measured_availability_percentage decimal(5,2) [note: 'The actual availability percentage achieved during the measurement period, calculated as (total uptime / total period) * 100. | Column measured_availability_percentage (DECIMAL(5,2)) in technology.sla_performance_record']
  measurement_methodology varchar [note: 'The method used to measure and calculate the SLA performance metrics for this period. | Column measurement_methodology (STRING) in technology.sla_performance_record']
  measurement_period_end timestamp [note: 'The end date and time of the SLA measurement period. | Column measurement_period_end (TIMESTAMP) in technology.sla_performance_record']
  measurement_period_start timestamp [note: 'The start date and time of the SLA measurement period. | Column measurement_period_start (TIMESTAMP) in technology.sla_performance_record']
  monitoring_system varchar [note: 'The name or identifier of the monitoring system or Network Operations Center (NOC) tool that captured the performance data. | Column monitoring_system (STRING) in technology.sla_performance_record']
  notes varchar [note: 'Additional notes, comments, or context regarding this SLA performance measurement record. | Column notes (STRING) in technology.sla_performance_record']
  regulatory_reporting_required boolean [note: 'Indicates whether this SLA performance record must be included in regulatory compliance reporting to bodies such as the Federal Communications Commission (FCC). | Column regulatory_reporting_required (BOOLEAN) in technology.sla_performance_record']
  regulatory_submission_date date [note: 'The date when this SLA performance data was submitted to regulatory authorities for compliance reporting. | Column regulatory_submission_date (DATE) in technology.sla_performance_record']
  remediation_action varchar [note: 'Description of the corrective and preventive actions taken or planned to address the SLA breach and prevent recurrence. | Column remediation_action (STRING) in technology.sla_performance_record']
  remediation_completion_date date [note: 'The date when the remediation action was completed and verified. | Column remediation_completion_date (DATE) in technology.sla_performance_record']
  remediation_status varchar [note: 'Current status of the remediation action implementation. | Column remediation_status (STRING) in technology.sla_performance_record']
  reported_to_stakeholder boolean [note: 'Indicates whether this SLA performance record has been formally reported to internal stakeholders or regulatory bodies. | Column reported_to_stakeholder (BOOLEAN) in technology.sla_performance_record']
  reporting_timestamp timestamp [note: 'The date and time when this SLA performance record was generated and reported. | Column reporting_timestamp (TIMESTAMP) in technology.sla_performance_record']
  service_credit_amount decimal(15,2) [note: 'The monetary value of service credits or penalties applied due to SLA breach, in US dollars. | Column service_credit_amount (DECIMAL(15,2)) in technology.sla_performance_record']
  service_credit_applicable boolean [note: 'Indicates whether a service credit or penalty is applicable due to SLA breach in this measurement period. | Column service_credit_applicable (BOOLEAN) in technology.sla_performance_record']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.sla_performance_record']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.sla_performance_record']
  stakeholder_notification_date date [note: 'The date when stakeholders were notified of this SLA performance result, particularly important for breach notifications. | Column stakeholder_notification_date (DATE) in technology.sla_performance_record']
  target_availability_percentage decimal(5,2) [note: 'The target availability percentage defined in the SLA for this measurement period. | Column target_availability_percentage (DECIMAL(5,2)) in technology.sla_performance_record']
  target_mttr_minutes decimal(10,2) [note: 'The target mean time to repair defined in the SLA for this measurement period. | Column target_mttr_minutes (DECIMAL(10,2)) in technology.sla_performance_record']
  total_downtime_minutes decimal(10,2) [note: 'The cumulative downtime in minutes during the measurement period. | Column total_downtime_minutes (DECIMAL(10,2)) in technology.sla_performance_record']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.sla_performance_record']
  updated_timestamp timestamp [note: 'The timestamp when this SLA performance record was last updated or modified. | Column updated_timestamp (TIMESTAMP) in technology.sla_performance_record']

  Note: 'Transactional record tracking actual technology SLA performance measurements against defined tech_sla targets over a reporting period. Captures measurement period, SLA reference, measured availability percentage, MTTR actual (minutes), incident count, breach flag, breach duration, breach root cause, remediation action, and reporting timestamp. Enables SLA compliance reporting to internal stakeholders and regulatory bodies (FCC technical rules compliance). | Unity Catalog table: media_broadcasting_ecm.technology.sla_performance_record'
}

Table technology.broadcast_standard {
  broadcast_standard_id varchar [pk, note: 'Unique identifier for the broadcast technical standard record. Primary key. | Column broadcast_standard_id (BIGINT) in technology.broadcast_standard']
  supersedes_broadcast_standard_id varchar [note: 'Self-referencing FK on broadcast_standard (supersedes_broadcast_standard_id) | Column supersedes_broadcast_standard_id (BIGINT) in technology.broadcast_standard']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.broadcast_standard']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.broadcast_standard']
  accessibility_features varchar [note: 'Accessibility features supported by this standard (e.g., closed captioning, subtitles, audio description, sign language). Applicable to captioning and accessibility standards. | Column accessibility_features (STRING) in technology.broadcast_standard']
  adoption_date date [note: 'Date when Media Broadcasting officially adopted this standard for use in operations. May differ from effective_date. | Column adoption_date (DATE) in technology.broadcast_standard']
  adoption_status varchar [note: 'Current adoption status of the standard within the organization\'s technology stack (mandatory for compliance, recommended best practice, optional, deprecated/phasing out, sunset/retired, emerging/pilot). | Column adoption_status (STRING) in technology.broadcast_standard']
  applicability_domain varchar [note: 'Business or technical domain(s) where this standard applies within Media Broadcasting operations (e.g., linear broadcast transmission, OTT streaming, studio production, post-production, archival, playout automation). | Column applicability_domain (STRING) in technology.broadcast_standard']
  audio_channels_supported varchar [note: 'Audio channel configurations supported by this standard (e.g., stereo, 5.1, 7.1, Dolby Atmos object-based). Applicable to audio standards. Null otherwise. | Column audio_channels_supported (STRING) in technology.broadcast_standard']
  bandwidth_requirement_mbps decimal(10,2) [note: 'Typical or minimum bandwidth requirement in megabits per second (Mbps) for transmission or streaming using this standard. Null if not applicable. | Column bandwidth_requirement_mbps (DECIMAL(10,2)) in technology.broadcast_standard']
  bit_depth varchar [note: 'Bit depth specification for video or audio encoding (e.g., 8-bit, 10-bit, 12-bit for video; 16-bit, 24-bit for audio). Null if not applicable. | Column bit_depth (STRING) in technology.broadcast_standard']
  compliance_requirement_flag boolean [note: 'Indicates whether adherence to this standard is required for regulatory compliance or broadcast licensing (True if compliance-driven, False if voluntary/best-practice). | Column compliance_requirement_flag (BOOLEAN) in technology.broadcast_standard']
  compression_algorithm varchar [note: 'Compression or codec algorithm specified by this standard (e.g., H.264/AVC, H.265/HEVC, AAC, Dolby AC-4). Applicable to encoding standards. Null otherwise. | Column compression_algorithm (STRING) in technology.broadcast_standard']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.broadcast_standard']
  created_timestamp timestamp [note: 'Timestamp when this broadcast standard record was first created in the system. | Column created_timestamp (TIMESTAMP) in technology.broadcast_standard']
  drm_compatibility varchar [note: 'Digital Rights Management systems compatible with this standard (e.g., Widevine, PlayReady, FairPlay). Applicable to streaming and content protection standards. Null otherwise. | Column drm_compatibility (STRING) in technology.broadcast_standard']
  effective_date date [note: 'Date when this standard version became effective or was officially published by the governing body. | Column effective_date (DATE) in technology.broadcast_standard']
  equipment_compatibility varchar [note: 'Notes on broadcast equipment, encoders, decoders, or infrastructure components compatible with or required for this standard. | Column equipment_compatibility (STRING) in technology.broadcast_standard']
  governing_body varchar [note: 'Name of the standards organization or governing body that publishes and maintains this standard (e.g., ATSC, DVB, SMPTE, SCTE, IETF, ISO, IEC, ITU). | Column governing_body (STRING) in technology.broadcast_standard']
  hdr_support_flag boolean [note: 'Indicates whether this standard supports High Dynamic Range video (HDR10, HDR10+, Dolby Vision, HLG). True if HDR-capable, False otherwise. | Column hdr_support_flag (BOOLEAN) in technology.broadcast_standard']
  implementation_complexity varchar [note: 'Assessed complexity level for implementing this standard in broadcast operations (low, medium, high, very-high) based on technical requirements, infrastructure changes, and integration effort. | Column implementation_complexity (STRING) in technology.broadcast_standard']
  interoperability_notes varchar [note: 'Notes on interoperability with other standards, backward compatibility, and integration considerations for implementation. | Column interoperability_notes (STRING) in technology.broadcast_standard']
  latency_class varchar [note: 'Latency classification for streaming or transmission standards (ultra-low <1s, low 1-3s, standard 3-10s, high >10s). Not-applicable for non-streaming standards. | Column latency_class (STRING) in technology.broadcast_standard']
  license_requirement_flag boolean [note: 'Indicates whether use of this standard requires licensing fees, patent royalties, or commercial agreements (True if licensing required, False if royalty-free or open standard). | Column license_requirement_flag (BOOLEAN) in technology.broadcast_standard']
  notes varchar [note: 'Additional notes, implementation guidance, known issues, or operational considerations for this broadcast standard. | Column notes (STRING) in technology.broadcast_standard']
  regulatory_jurisdiction varchar [note: 'Geographic or regulatory jurisdiction(s) where this standard is mandated or commonly adopted (e.g., USA, EU, UK, Global). Pipe-separated for multiple jurisdictions. | Column regulatory_jurisdiction (STRING) in technology.broadcast_standard']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.broadcast_standard']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.broadcast_standard']
  specification_url varchar [note: 'Web URL linking to the official specification document or standards body publication page for this standard. | Column specification_url (STRING) in technology.broadcast_standard']
  standard_code varchar [note: 'Short alphanumeric code uniquely identifying the broadcast standard (e.g., ATSC-3.0, DVB-T2, HEVC, ST-2110). | Column standard_code (STRING) in technology.broadcast_standard']
  standard_name varchar [note: 'Full descriptive name of the broadcast technical standard (e.g., Advanced Television Systems Committee 3.0, High Efficiency Video Coding). | Column standard_name (STRING) in technology.broadcast_standard']
  standard_type varchar [note: 'Categorical classification of the standard\'s primary technical domain (transmission, encoding, compression, streaming, audio, captioning, metadata, transport, interface, quality). [ENUM-REF-CANDIDATE: transmission|encoding|compression|streaming|audio|captioning|metadata|transport|interface|quality — 10 candidates stripped; promote to reference product] | Column standard_type (STRING) in technology.broadcast_standard']
  successor_standard_code varchar [note: 'Standard code of the successor or next version that supersedes this standard. Null if this is the current version or no successor exists yet. | Column successor_standard_code (STRING) in technology.broadcast_standard']
  sunset_date date [note: 'Planned or actual date when this standard will be or was retired from active use. Null if standard remains active. | Column sunset_date (DATE) in technology.broadcast_standard']
  supported_color_spaces varchar [note: 'Color space specifications supported (e.g., Rec. 709, Rec. 2020, DCI-P3). Applicable to video and HDR standards. Null for non-video standards. | Column supported_color_spaces (STRING) in technology.broadcast_standard']
  supported_frame_rates varchar [note: 'Frame rates supported by this standard (e.g., 24fps, 30fps, 60fps, 120fps). Applicable to video standards. Null for non-video standards. | Column supported_frame_rates (STRING) in technology.broadcast_standard']
  supported_resolutions varchar [note: 'Video resolutions supported by this standard (e.g., 1080p, 4K UHD, 8K). Applicable to video encoding and transmission standards. Null for non-video standards. | Column supported_resolutions (STRING) in technology.broadcast_standard']
  technical_summary varchar [note: 'Brief technical summary describing the purpose, key features, and capabilities of this broadcast standard. | Column technical_summary (STRING) in technology.broadcast_standard']
  transport_protocol varchar [note: 'Network transport protocol or container format specified (e.g., MPEG-TS, RTP, HLS, MPEG-DASH). Applicable to streaming and transport standards. Null otherwise. | Column transport_protocol (STRING) in technology.broadcast_standard']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.broadcast_standard']
  updated_timestamp timestamp [note: 'Timestamp when this broadcast standard record was last modified or updated. | Column updated_timestamp (TIMESTAMP) in technology.broadcast_standard']
  version varchar [note: 'Version number of the standard specification (e.g., 1.0, 2.1, 3.0). Follows semantic versioning where applicable. | Column version (STRING) in technology.broadcast_standard']

  Note: 'Reference master catalog of broadcast technical standards and specifications applicable to Media Broadcasting operations — ATSC 3.0, DVB-T2, MPEG-4 AVC, HEVC, SMPTE ST 2110, SCTE-35, HLS, MPEG-DASH, Dolby Atmos, and HDR standards. Captures standard code, standard name, governing body (ATSC, DVB, SMPTE, SCTE, IETF), version, applicability domain (transmission, encoding, captioning, audio), adoption status (mandatory, recommended, deprecated), and effective date. Reference entity used across technology, distribution, and platform domains. | Unity Catalog table: media_broadcasting_ecm.technology.broadcast_standard'
}

Table technology.equipment_procurement {
  equipment_procurement_id varchar [pk, note: 'Unique identifier for the equipment procurement transaction record. Primary key for this product. | Column equipment_procurement_id (BIGINT) in technology.equipment_procurement']
  blanket_equipment_procurement_id varchar [note: 'Self-referencing FK on equipment_procurement (blanket_equipment_procurement_id) | Column blanket_equipment_procurement_id (BIGINT) in technology.equipment_procurement']
  broadcast_facility_id varchar [note: 'Identifier of the broadcast facility, studio, or warehouse where the equipment will be delivered and received. | Column broadcast_facility_id (BIGINT) in technology.equipment_procurement']
  partner_id varchar [note: 'Identifier of the vendor or supplier from whom the equipment is being procured. | Column partner_id (BIGINT) in partner.equipment_procurement']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.equipment_procurement']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.equipment_procurement']
  actual_delivery_date date [note: 'Actual date when the equipment was delivered to the receiving facility. | Column actual_delivery_date (DATE) in technology.equipment_procurement']
  approval_date date [note: 'Date when the procurement was formally approved by the authorized approver. | Column approval_date (DATE) in technology.equipment_procurement']
  approval_status varchar [note: 'Status of managerial or financial approval for this procurement transaction. | Column approval_status (STRING) in technology.equipment_procurement']
  approved_by varchar [note: 'Name or identifier of the person who approved this procurement transaction. | Column approved_by (STRING) in technology.equipment_procurement']
  asset_tag_assigned varchar [note: 'Unique asset tag or inventory control number assigned to the equipment upon receipt for tracking and asset management purposes. | Column asset_tag_assigned (STRING) in technology.equipment_procurement']
  budget_reference varchar [note: 'Reference to the budget line item, cost center, or capital project against which this procurement is charged. | Column budget_reference (STRING) in technology.equipment_procurement']
  cost_center_code varchar [note: 'Cost center code in the financial system to which this procurement expense is allocated. | Column cost_center_code (STRING) in technology.equipment_procurement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.equipment_procurement']
  created_timestamp timestamp [note: 'Timestamp when this procurement record was first created in the system. | Column created_timestamp (TIMESTAMP) in technology.equipment_procurement']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this procurement transaction. | Column currency_code (STRING) in technology.equipment_procurement']
  equipment_category varchar [note: 'High-level classification of equipment being procured: transmission equipment, encoding/decoding equipment, IT infrastructure, studio equipment, or monitoring systems. [ENUM-REF-CANDIDATE: transmitter|encoder|decoder|server|storage|network|camera|audio|lighting|studio|monitoring — 11 candidates stripped; promote to reference product] | Column equipment_category (STRING) in technology.equipment_procurement']
  equipment_description varchar [note: 'Detailed textual description of the equipment being procured, including make, model, specifications, and intended use. | Column equipment_description (STRING) in technology.equipment_procurement']
  expected_delivery_date date [note: 'Planned or promised delivery date for the equipment as agreed with the vendor. | Column expected_delivery_date (DATE) in technology.equipment_procurement']
  goods_receipt_confirmed boolean [note: 'Flag indicating whether goods receipt has been confirmed in the system (true = received and confirmed, false = not yet received). | Column goods_receipt_confirmed (BOOLEAN) in technology.equipment_procurement']
  goods_receipt_date date [note: 'Date when goods receipt was formally recorded in the system, triggering inventory and financial postings. | Column goods_receipt_date (DATE) in technology.equipment_procurement']
  last_updated_timestamp timestamp [note: 'Timestamp when this procurement record was last modified in the system. | Column last_updated_timestamp (TIMESTAMP) in technology.equipment_procurement']
  manufacturer varchar [note: 'Name of the equipment manufacturer or original equipment manufacturer (OEM). | Column manufacturer (STRING) in technology.equipment_procurement']
  model_number varchar [note: 'Manufacturer\'s model number or product code for the equipment being procured. | Column model_number (STRING) in technology.equipment_procurement']
  notes varchar [note: 'Free-text notes, comments, or special instructions related to this procurement transaction. | Column notes (STRING) in technology.equipment_procurement']
  order_date date [note: 'Date when the purchase order was issued and submitted to the vendor. | Column order_date (DATE) in technology.equipment_procurement']
  payment_terms varchar [note: 'Agreed payment terms with the vendor (e.g., Net 30, Net 60, 2/10 Net 30, payment on delivery). | Column payment_terms (STRING) in technology.equipment_procurement']
  procurement_status varchar [note: 'Current lifecycle status of the procurement transaction in the workflow from draft through goods receipt and installation. [ENUM-REF-CANDIDATE: draft|approved|ordered|in_transit|received|installed|cancelled — 7 candidates stripped; promote to reference product] | Column procurement_status (STRING) in technology.equipment_procurement']
  procurement_type varchar [note: 'Classification of procurement transaction by financial treatment: capital expenditure (capex), operational expenditure (opex), lease, rental, maintenance, or upgrade. | Column procurement_type (STRING) in technology.equipment_procurement']
  purchase_order_number varchar [note: 'Externally-known unique purchase order number issued for this procurement transaction. Business identifier for tracking and reference. | Column purchase_order_number (STRING) in technology.equipment_procurement']
  quantity varchar [note: 'Number of equipment units being procured in this purchase order. | Column quantity (INT) in technology.equipment_procurement']
  receiving_location_name varchar [note: 'Name of the facility or location where equipment is being delivered. | Column receiving_location_name (STRING) in technology.equipment_procurement']
  requisition_number varchar [note: 'Reference number of the internal purchase requisition that initiated this procurement. | Column requisition_number (STRING) in technology.equipment_procurement']
  requisitioner_name varchar [note: 'Name of the person or department who requested this equipment procurement. | Column requisitioner_name (STRING) in technology.equipment_procurement']
  shipping_cost decimal(18,2) [note: 'Freight and shipping charges for delivery of the equipment. | Column shipping_cost (DECIMAL(18,2)) in technology.equipment_procurement']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.equipment_procurement']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.equipment_procurement']
  tax_amount decimal(18,2) [note: 'Total tax amount applicable to this procurement transaction. | Column tax_amount (DECIMAL(18,2)) in technology.equipment_procurement']
  total_amount decimal(18,2) [note: 'Grand total amount for this procurement including equipment cost, taxes, and shipping. | Column total_amount (DECIMAL(18,2)) in technology.equipment_procurement']
  total_cost decimal(18,2) [note: 'Total cost for all units in this procurement transaction (quantity × unit cost), before taxes and fees. | Column total_cost (DECIMAL(18,2)) in technology.equipment_procurement']
  unit_cost decimal(18,2) [note: 'Cost per single unit of equipment in the procurement currency. | Column unit_cost (DECIMAL(18,2)) in technology.equipment_procurement']
  unit_of_measure varchar [note: 'Unit of measure for the quantity being procured (each, unit, set, rack, pair, lot). | Column unit_of_measure (STRING) in technology.equipment_procurement']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.equipment_procurement']
  warranty_expiry_date date [note: 'Date when the equipment warranty coverage expires. | Column warranty_expiry_date (DATE) in technology.equipment_procurement']
  warranty_period_months varchar [note: 'Duration of manufacturer or vendor warranty coverage in months from delivery or installation date. | Column warranty_period_months (INT) in technology.equipment_procurement']

  Note: 'Transactional record of each broadcast equipment or IT asset procurement event — purchase orders raised for transmitters, encoders, studio equipment, servers, and network hardware. Captures purchase order number, procurement type (capex, opex), vendor name, equipment description, quantity, unit cost, total cost, currency, delivery date, receiving facility, asset tag assignment, budget reference, approval status, and goods receipt confirmation. Technology-domain procurement tracking distinct from finance.accounts_payable (financial settlement). | Unity Catalog table: media_broadcasting_ecm.technology.equipment_procurement'
}

Table technology.tech_incident {
  tech_incident_id varchar [pk, note: 'Unique identifier for the technology incident record. Primary key for the tech_incident product. | Column tech_incident_id (BIGINT) in technology.tech_incident']
  affected_channel_id varchar [note: 'Identifier of the broadcast channel impacted by the incident, if applicable. Links to the channel master data. | Column affected_channel_id (BIGINT) in scheduling.tech_incident']
  broadcast_facility_id varchar [note: 'Identifier of the broadcast facility where the incident occurred. Links to broadcast_facility master data. | Column broadcast_facility_id (BIGINT) in technology.tech_incident']
  compliance_incident_id varchar [note: 'Foreign key linking to compliance.incident. Business justification: Technical incidents escalating to compliance incidents when regulatory impact occurs (transmitter failure causing off-air time, encoder failure causing caption loss). Real incident management workflow | Column compliance_incident_id (BIGINT) in compliance.tech_incident']
  noc_alert_id varchar [note: 'Identifier of the NOC alert that triggered or is associated with this incident. Links to noc_alert transactional data. | Column noc_alert_id (BIGINT) in technology.tech_incident']
  parent_tech_incident_id varchar [note: 'Self-referencing FK on tech_incident (parent_tech_incident_id) | Column parent_tech_incident_id (BIGINT) in technology.tech_incident']
  primary_tech_employee_id varchar [note: 'Identifier of the user or system account that reported the incident. Links to user/employee master data. | Column primary_tech_employee_id (BIGINT) in workforce.tech_incident']
  related_change_tech_change_request_id varchar [note: 'Identifier of the related change request if this incident was caused by or resolved through a change in the ITIL change management process. | Column related_change_tech_change_request_id (BIGINT) in technology.tech_incident']
  signal_path_id varchar [note: 'Foreign key linking to technology.signal_path. Business justification: Incidents affect signal paths (path degradation, routing failures, quality issues). The \'affected_service\' field can reference a signal path. Links the incident to the specific signal path experiencin | Column signal_path_id (BIGINT) in technology.tech_incident']
  tech_problem_id varchar [note: 'Identifier of the related problem record if this incident is linked to a known problem in the ITIL problem management process. | Column related_problem_id (BIGINT) in technology.tech_incident']
  tertiary_tech_resolved_by_user_employee_id varchar [note: 'Identifier of the technician or engineer who resolved the incident. Links to user/employee master data. | Column tertiary_tech_resolved_by_user_employee_id (BIGINT) in workforce.tech_incident']
  transmission_equipment_id varchar [note: 'Identifier of the specific transmission or studio equipment involved in the incident. Links to transmission_equipment or studio equipment master data. | Column transmission_equipment_id (BIGINT) in technology.tech_incident']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.tech_incident']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.tech_incident']
  affected_service varchar [note: 'Name of the business service or technical service impacted by the incident (e.g., Live News Broadcast, VOD Streaming Platform, Ad Insertion Service, Network Operations Center Monitoring). | Column affected_service (STRING) in technology.tech_incident']
  affected_viewer_count_estimate varchar [note: 'Estimated number of viewers or subscribers impacted by the incident, used for prioritization and business impact assessment. | Column affected_viewer_count_estimate (INT) in technology.tech_incident']
  assigned_resolver_team varchar [note: 'Name of the technical support team or resolver group currently assigned to investigate and resolve the incident (e.g., Broadcast Engineering, Network Operations, IT Infrastructure, Cybersecurity). | Column assigned_resolver_team (STRING) in technology.tech_incident']
  assigned_to_name varchar [note: 'Full name of the individual technician or engineer currently assigned to the incident. | Column assigned_to_name (STRING) in technology.tech_incident']
  closure_notes varchar [note: 'Final notes and comments recorded when closing the incident, including confirmation of resolution and any follow-up actions. | Column closure_notes (STRING) in technology.tech_incident']
  closure_timestamp timestamp [note: 'Date and time when the incident was formally closed after confirmation that the resolution was successful and no further action is required. | Column closure_timestamp (TIMESTAMP) in technology.tech_incident']
  contact_method varchar [note: 'Channel through which the incident was reported: phone call, email, self-service portal, automated monitoring system, or escalated from NOC alert. | Column contact_method (STRING) in technology.tech_incident']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.tech_incident']
  created_timestamp timestamp [note: 'System timestamp when this incident record was first created in the incident management system. Audit trail field. | Column created_timestamp (TIMESTAMP) in technology.tech_incident']
  escalation_history varchar [note: 'Chronological log of escalation events, including timestamps, escalation reasons, and teams/individuals escalated to. Stored as structured text or JSON. | Column escalation_history (STRING) in technology.tech_incident']
  escalation_level varchar [note: 'Current escalation tier of the incident. 0 = no escalation, 1 = first-level escalation, 2 = second-level escalation, 3+ = senior management escalation. | Column escalation_level (INT) in technology.tech_incident']
  impact_assessment varchar [note: 'Business impact analysis describing the scope and severity of the incident effect on broadcast operations, audience reach, revenue, and service availability. | Column impact_assessment (STRING) in technology.tech_incident']
  incident_category varchar [note: 'High-level classification of the incident type: broadcast signal failures, IT system outages, network disruptions, cybersecurity events, infrastructure faults, or playout automation issues. | Column incident_category (STRING) in technology.tech_incident']
  incident_description varchar [note: 'Detailed narrative description of the incident symptoms, impact, and circumstances as reported by the user or detected by monitoring systems. | Column incident_description (STRING) in technology.tech_incident']
  incident_number varchar [note: 'Externally-visible unique incident ticket number assigned by the ITIL incident management system. Format: INC followed by 8 digits. | Column incident_number (STRING) in technology.tech_incident']
  incident_subcategory varchar [note: 'Detailed classification within the incident category (e.g., signal loss, server crash, DDoS attack, power failure, encoder malfunction). | Column incident_subcategory (STRING) in technology.tech_incident']
  last_modified_timestamp timestamp [note: 'System timestamp when this incident record was last updated. Audit trail field. | Column last_modified_timestamp (TIMESTAMP) in technology.tech_incident']
  outage_duration_minutes varchar [note: 'Total duration in minutes that the service or broadcast was unavailable or degraded due to the incident. | Column outage_duration_minutes (INT) in technology.tech_incident']
  post_incident_review_date date [note: 'Scheduled or completed date of the post-incident review meeting. | Column post_incident_review_date (DATE) in technology.tech_incident']
  post_incident_review_flag boolean [note: 'Indicates whether a formal post-incident review (PIR) or post-mortem is required for this incident. True = PIR required (typically for P1/P2 incidents), False = no PIR needed. | Column post_incident_review_flag (BOOLEAN) in technology.tech_incident']
  priority varchar [note: 'Business priority level assigned to the incident based on impact and urgency. P1 = Critical (immediate broadcast impact), P2 = High, P3 = Medium, P4 = Low. | Column priority (STRING) in technology.tech_incident']
  reported_by_name varchar [note: 'Full name of the person or system that reported the incident. | Column reported_by_name (STRING) in technology.tech_incident']
  reported_timestamp timestamp [note: 'Date and time when the incident was first reported to the service desk or detected by monitoring systems. This is the principal business event timestamp for the incident lifecycle. | Column reported_timestamp (TIMESTAMP) in technology.tech_incident']
  resolution_description varchar [note: 'Detailed narrative of the actions taken to resolve the incident, including troubleshooting steps, fixes applied, and workarounds implemented. | Column resolution_description (STRING) in technology.tech_incident']
  resolution_timestamp timestamp [note: 'Date and time when the incident was resolved and the service restored to normal operation. | Column resolution_timestamp (TIMESTAMP) in technology.tech_incident']
  resolved_by_name varchar [note: 'Full name of the technician or engineer who resolved the incident. | Column resolved_by_name (STRING) in technology.tech_incident']
  root_cause_category varchar [note: 'Classification of the underlying root cause of the incident (e.g., hardware failure, software bug, configuration error, human error, environmental factor, third-party service failure). | Column root_cause_category (STRING) in technology.tech_incident']
  root_cause_description varchar [note: 'Detailed explanation of the root cause identified during post-incident analysis. | Column root_cause_description (STRING) in technology.tech_incident']
  severity varchar [note: 'Technical severity assessment of the incident impact on broadcast operations and services. | Column severity (STRING) in technology.tech_incident']
  sla_breach_flag boolean [note: 'Indicates whether the incident resolution exceeded the committed SLA response or resolution time target. True = SLA breached, False = SLA met. | Column sla_breach_flag (BOOLEAN) in technology.tech_incident']
  sla_target_minutes varchar [note: 'The committed SLA resolution time target in minutes for this incident priority level. | Column sla_target_minutes (INT) in technology.tech_incident']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.tech_incident']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.tech_incident']
  tech_incident_status varchar [note: 'Current lifecycle state of the incident within the ITIL workflow: new (just reported), assigned (routed to resolver), in_progress (actively being worked), pending (awaiting external input), resolved (fix applied), closed (confirmed resolved), cancelled (invalid/duplicate). [ENUM-REF-CANDIDATE: new|assigned|in_progress|pending|resolved|closed|cancelled — 7 candidates stripped; promote to reference product] | Column tech_incident_status (STRING) in technology.tech_incident']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.tech_incident']
  workaround_applied boolean [note: 'Indicates whether a temporary workaround was applied to restore service before a permanent fix. True = workaround used, False = permanent fix applied immediately. | Column workaround_applied (BOOLEAN) in technology.tech_incident']
  workaround_description varchar [note: 'Description of the temporary workaround applied to restore service while a permanent fix is developed. | Column workaround_description (STRING) in technology.tech_incident']

  Note: 'Transactional record of each formal technology incident raised through the ITIL incident management process — broadcast signal failures, IT system outages, cybersecurity events, and infrastructure faults that require structured investigation and resolution. Captures incident number, incident category (broadcast, IT, network, security), priority (P1–P4), affected service, reported timestamp, assigned resolver team, escalation history, resolution timestamp, resolution description, root cause classification, and post-incident review flag. Distinct from noc_alert (automated monitoring trigger) — this is the formal ITIL incident record. | Unity Catalog table: media_broadcasting_ecm.technology.tech_incident'
}

Table technology.encoder_config {
  encoder_config_id varchar [pk, note: 'Unique identifier for the encoder configuration record. | Column encoder_config_id (BIGINT) in technology.encoder_config']
  assigned_channel_id varchar [note: 'Reference to the linear broadcast channel or streaming channel that this encoder is configured to serve. | Column assigned_channel_id (BIGINT) in scheduling.encoder_config']
  base_encoder_config_id varchar [note: 'Self-referencing FK on encoder_config (base_encoder_config_id) | Column base_encoder_config_id (BIGINT) in technology.encoder_config']
  broadcast_facility_id varchar [note: 'Reference to the broadcast facility or data center where the encoder is physically deployed or logically assigned. | Column broadcast_facility_id (BIGINT) in technology.encoder_config']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Encoders are specialized transmission equipment. encoder_config has manufacturer, model_number, serial_number which duplicate transmission_equipment attributes. Normalizing by linking encoder config t | Column transmission_equipment_id (BIGINT) in technology.encoder_config']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.encoder_config']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.encoder_config']
  assigned_stream_name varchar [note: 'Name of the specific stream or service feed that this encoder produces (e.g., main program feed, backup feed, regional variant). | Column assigned_stream_name (STRING) in technology.encoder_config']
  audio_channels varchar [note: 'Audio channel configuration supported by the encoder (e.g., stereo, 5.1 surround, 7.1 surround, mono). | Column audio_channels (STRING) in technology.encoder_config']
  audio_codec varchar [note: 'Audio codec used for encoding audio streams (AAC, Dolby AC-3, Dolby E-AC-3/DD+, Opus, MP3). | Column audio_codec (STRING) in technology.encoder_config']
  commissioning_date date [note: 'Date when the encoder was commissioned and put into operational service. | Column commissioning_date (DATE) in technology.encoder_config']
  configuration_profile varchar [note: 'Named configuration profile or preset applied to the encoder defining encoding parameters, quality settings, and output specifications. | Column configuration_profile (STRING) in technology.encoder_config']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.encoder_config']
  created_timestamp timestamp [note: 'Timestamp when this encoder configuration record was first created in the system. | Column created_timestamp (TIMESTAMP) in technology.encoder_config']
  drm_enabled boolean [note: 'Indicates whether Digital Rights Management encryption is enabled on the encoder output for content protection (True/False). | Column drm_enabled (BOOLEAN) in technology.encoder_config']
  drm_system varchar [note: 'Name of the DRM system integrated with the encoder (e.g., Widevine, PlayReady, FairPlay, AES-128). | Column drm_system (STRING) in technology.encoder_config']
  encoder_code varchar [note: 'Unique business identifier or asset tag code for the encoder used in inventory and configuration management systems. | Column encoder_code (STRING) in technology.encoder_config']
  encoder_name varchar [note: 'Human-readable name assigned to the encoder for operational identification and reference. | Column encoder_name (STRING) in technology.encoder_config']
  encoder_type varchar [note: 'Classification of the encoder deployment model: hardware-based encoder appliance, software encoder running on server, or cloud-based encoding instance. | Column encoder_type (STRING) in technology.encoder_config']
  firmware_version varchar [note: 'Current firmware or software version installed on the encoder, used for compatibility tracking and update management. | Column firmware_version (STRING) in technology.encoder_config']
  input_format varchar [note: 'Video and audio input format accepted by the encoder (e.g., SDI, HDMI, IP/RTP, RTMP, file-based). | Column input_format (STRING) in technology.encoder_config']
  ip_address varchar [note: 'Network IP address assigned to the encoder for management, monitoring, and stream delivery. | Column ip_address (STRING) in technology.encoder_config']
  last_maintenance_date date [note: 'Date of the most recent maintenance or service performed on the encoder. | Column last_maintenance_date (DATE) in technology.encoder_config']
  last_modified_timestamp timestamp [note: 'Timestamp when this encoder configuration record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in technology.encoder_config']
  latency_mode varchar [note: 'Encoding latency profile configured for the encoder: low-latency for live sports and interactive content, ultra-low-latency for real-time applications, or standard for non-time-sensitive content. | Column latency_mode (STRING) in technology.encoder_config']
  management_url varchar [note: 'Web-based management interface URL for accessing the encoder configuration and monitoring dashboard. | Column management_url (STRING) in technology.encoder_config']
  max_concurrent_streams varchar [note: 'Maximum number of simultaneous output streams or renditions that the encoder can produce concurrently. | Column max_concurrent_streams (INT) in technology.encoder_config']
  next_maintenance_due_date date [note: 'Scheduled date for the next planned maintenance or firmware update for the encoder. | Column next_maintenance_due_date (DATE) in technology.encoder_config']
  notes varchar [note: 'Free-text field for additional operational notes, special configuration details, known issues, or maintenance history related to the encoder. | Column notes (STRING) in technology.encoder_config']
  operational_status varchar [note: 'Current operational state of the encoder: active (in production use), standby (ready for failover), maintenance (undergoing service), offline (not operational), or decommissioned (retired from service). | Column operational_status (STRING) in technology.encoder_config']
  output_bitrate_ladder varchar [note: 'Comma-separated list of output bitrates in kbps or Mbps defining the Adaptive Bitrate (ABR) ladder for multi-quality streaming (e.g., 500kbps, 1Mbps, 2.5Mbps, 5Mbps, 8Mbps). | Column output_bitrate_ladder (STRING) in technology.encoder_config']
  output_codec varchar [note: 'Primary video codec used for encoding output streams (H.264/AVC, HEVC/H.265, AV1, VP9, MPEG-2). | Column output_codec (STRING) in technology.encoder_config']
  output_protocol varchar [note: 'Streaming protocol used for encoder output delivery (e.g., HLS, MPEG-DASH, RTMP, SRT, Zixi). | Column output_protocol (STRING) in technology.encoder_config']
  platform_assignment varchar [note: 'Name of the streaming platform, channel, or service to which this encoder is assigned (e.g., OTT platform, linear channel, FAST channel). | Column platform_assignment (STRING) in technology.encoder_config']
  power_consumption_watts decimal(10,2) [note: 'Typical power consumption of the encoder hardware in watts, used for capacity planning and energy cost calculation. | Column power_consumption_watts (DECIMAL(10,2)) in technology.encoder_config']
  rack_location varchar [note: 'Physical rack and unit position where the hardware encoder is installed in the data center or broadcast facility (e.g., Rack-12-U24). | Column rack_location (STRING) in technology.encoder_config']
  redundancy_mode varchar [note: 'Redundancy configuration role of the encoder in the broadcast infrastructure: primary (main encoder), backup (failover encoder), active-active (load-balanced), or none (standalone). | Column redundancy_mode (STRING) in technology.encoder_config']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.encoder_config']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.encoder_config']
  support_contract_number varchar [note: 'Reference number for the active maintenance or technical support contract covering this encoder. | Column support_contract_number (STRING) in technology.encoder_config']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.encoder_config']
  warranty_expiry_date date [note: 'Date when the manufacturer warranty or extended warranty coverage expires for the encoder hardware. | Column warranty_expiry_date (DATE) in technology.encoder_config']

  Note: 'Master configuration record for each video and audio encoder deployed across broadcast and streaming infrastructure — hardware encoders (Harmonic, Elemental), software encoders, and cloud encoding instances. Captures encoder name, encoder type (hardware/software/cloud), assigned facility or platform, input format, output codec (H.264, HEVC, AV1), output bitrate ladder, audio codec, latency mode (low-latency, standard), redundancy mode, assigned channel or stream, firmware version, and operational status. Enables encoder fleet management and configuration governance. | Unity Catalog table: media_broadcasting_ecm.technology.encoder_config'
}

Table technology.satellite_transponder {
  satellite_transponder_id varchar [pk, note: 'Unique identifier for the satellite transponder capacity record. Primary key for the satellite transponder master resource entity. | Column satellite_transponder_id (BIGINT) in technology.satellite_transponder']
  broadcast_facility_id varchar [note: 'Reference to the broadcast facility used for uplink transmission to this transponder. Links to the broadcast_facility master data for operational coordination. | Column broadcast_facility_id (BIGINT) in technology.satellite_transponder']
  broadcast_standard_id varchar [note: 'Foreign key linking to technology.broadcast_standard. Business justification: satellite_transponder.encoding_standard (STRING) should be normalized to FK reference to broadcast_standard master. Satellite transponders operate under specific broadcast standards that should link t | Column broadcast_standard_id (BIGINT) in technology.satellite_transponder']
  parent_satellite_transponder_id varchar [note: 'Self-referencing FK on satellite_transponder (backup_satellite_transponder_id) | Column backup_satellite_transponder_id (BIGINT) in technology.satellite_transponder']
  vendor_contract_id varchar [note: 'Foreign key linking to technology.vendor_contract. Business justification: satellite_transponder.contract_number (STRING) should be normalized to FK to vendor_contract. Satellite transponder capacity is leased under vendor contracts with carriers. This links the transponder  | Column vendor_contract_id (BIGINT) in technology.satellite_transponder']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.satellite_transponder']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.satellite_transponder']
  bandwidth_mhz decimal(8,2) [note: 'Total bandwidth capacity of the transponder in megahertz. Determines the data throughput and number of channels that can be multiplexed on this transponder. | Column bandwidth_mhz (DECIMAL(8,2)) in technology.satellite_transponder']
  carrier_provider varchar [note: 'Name of the satellite operator or service provider leasing the transponder capacity (e.g., SES, Intelsat, Eutelsat, Telesat). Primary vendor contact for technical support and service issues. | Column carrier_provider (STRING) in technology.satellite_transponder']
  center_frequency_mhz decimal(10,3) [note: 'Center operating frequency of the transponder in megahertz. Used for uplink/downlink tuning and interference coordination with adjacent transponders. | Column center_frequency_mhz (DECIMAL(10,3)) in technology.satellite_transponder']
  channel_capacity varchar [note: 'Number of standard-definition or high-definition channels that can be multiplexed on this transponder given current encoding parameters. Used for channel lineup planning. | Column channel_capacity (INT) in technology.satellite_transponder']
  commissioning_date date [note: 'Date when the transponder capacity was first activated and put into operational service for broadcast distribution. Marks the start of the assets operational lifecycle. | Column commissioning_date (DATE) in technology.satellite_transponder']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.satellite_transponder']
  created_timestamp timestamp [note: 'Timestamp when this transponder record was first created in the system. Supports data lineage and audit trail requirements. | Column created_timestamp (TIMESTAMP) in technology.satellite_transponder']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the lease cost (e.g., USD, EUR, GBP). Enables multi-currency financial reporting and consolidation. | Column currency_code (STRING) in technology.satellite_transponder']
  decommissioning_date date [note: 'Date when the transponder capacity was retired from active service. Nullable for active transponders. Used for asset lifecycle tracking and capacity planning. | Column decommissioning_date (DATE) in technology.satellite_transponder']
  downlink_coverage_footprint varchar [note: 'Geographic coverage area of the transponders downlink beam (e.g., North America, Europe, Asia-Pacific, CONUS). Defines the audience reach and distribution territory. | Column downlink_coverage_footprint (STRING) in technology.satellite_transponder']
  eirp_dbw decimal(6,2) [note: 'Effective Isotropic Radiated Power of the transponder in decibels relative to one watt. Measures the signal strength at the coverage area, critical for reception quality planning. | Column eirp_dbw (DECIMAL(6,2)) in technology.satellite_transponder']
  frequency_band varchar [note: 'Radio frequency band used by the transponder for transmission. C-band (4-8 GHz) offers rain fade resistance, Ku-band (12-18 GHz) provides higher bandwidth, Ka-band (26-40 GHz) enables high-throughput applications. | Column frequency_band (STRING) in technology.satellite_transponder']
  last_maintenance_date date [note: 'Date of the most recent maintenance activity or service check performed on the transponder or associated ground equipment. Supports preventive maintenance scheduling. | Column last_maintenance_date (DATE) in technology.satellite_transponder']
  lease_end_date date [note: 'Date when the transponder lease or capacity agreement expires. Nullable for owned capacity or indefinite agreements. Used for renewal planning and capacity forecasting. | Column lease_end_date (DATE) in technology.satellite_transponder']
  lease_start_date date [note: 'Date when the transponder lease or capacity agreement becomes effective. Critical for capacity planning and financial forecasting. | Column lease_start_date (DATE) in technology.satellite_transponder']
  leased_capacity_mbps decimal(10,2) [note: 'Amount of transponder capacity leased by Media Broadcasting in megabits per second. Represents the contracted data rate available for broadcast distribution. | Column leased_capacity_mbps (DECIMAL(10,2)) in technology.satellite_transponder']
  modulation_scheme varchar [note: 'Digital modulation technique used (e.g., QPSK, 8PSK, 16APSK, 32APSK). Higher-order modulation increases throughput but requires better signal-to-noise ratio. | Column modulation_scheme (STRING) in technology.satellite_transponder']
  monthly_lease_cost decimal(12,2) [note: 'Monthly recurring cost for leasing the transponder capacity. Used for budget planning, cost allocation, and financial reporting. Excludes one-time setup fees. | Column monthly_lease_cost (DECIMAL(12,2)) in technology.satellite_transponder']
  next_maintenance_due_date date [note: 'Scheduled date for the next planned maintenance or service review. Used for proactive maintenance planning and service continuity assurance. | Column next_maintenance_due_date (DATE) in technology.satellite_transponder']
  notes varchar [note: 'Free-form text field for additional operational notes, special configurations, service restrictions, or historical context relevant to this transponder capacity. | Column notes (STRING) in technology.satellite_transponder']
  operational_status varchar [note: 'Current operational state of the transponder capacity. Active indicates in-use for broadcast, Standby for backup/redundancy, Maintenance for service windows, Decommissioned for retired capacity, Reserved for future deployment. | Column operational_status (STRING) in technology.satellite_transponder']
  orbital_slot varchar [note: 'Geostationary orbital position of the satellite in degrees (e.g., 101.0W, 28.2E). Defines the satellites fixed position relative to Earth for broadcast coverage planning. | Column orbital_slot (STRING) in technology.satellite_transponder']
  ownership_type varchar [note: 'Indicates whether the transponder capacity is owned outright, leased from a satellite operator, shared with other broadcasters, or reserved under a long-term agreement. | Column ownership_type (STRING) in technology.satellite_transponder']
  polarization varchar [note: 'Signal polarization type: Horizontal, Vertical, Right-Hand Circular Polarization (RHCP), or Left-Hand Circular Polarization (LHCP). Enables frequency reuse by transmitting on orthogonal polarizations. | Column polarization (STRING) in technology.satellite_transponder']
  primary_service varchar [note: 'Primary broadcast service or channel distribution purpose for this transponder (e.g., Linear TV Distribution, VOD Delivery, Contribution Feed, Occasional Use). Supports capacity allocation and service planning. | Column primary_service (STRING) in technology.satellite_transponder']
  redundancy_configuration varchar [note: 'Redundancy role of this transponder in the broadcast distribution architecture. 1+1 provides full hot backup, N+1 shares backup across multiple primaries, None indicates no redundancy. | Column redundancy_configuration (STRING) in technology.satellite_transponder']
  regulatory_license_number varchar [note: 'FCC or equivalent regulatory authority license number authorizing the use of this transponder for broadcast transmission. Required for compliance reporting and spectrum management. | Column regulatory_license_number (STRING) in technology.satellite_transponder']
  satellite_name varchar [note: 'Name of the satellite hosting this transponder (e.g., SES-1, Intelsat 21, Eutelsat 7B). Critical for uplink/downlink coordination and transmission planning. | Column satellite_name (STRING) in technology.satellite_transponder']
  sla_uptime_percentage decimal(5,2) [note: 'Contractually guaranteed uptime percentage for the transponder service (e.g., 99.9%, 99.95%). Used for vendor performance monitoring and service credit calculations. | Column sla_uptime_percentage (DECIMAL(5,2)) in technology.satellite_transponder']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.satellite_transponder']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.satellite_transponder']
  transponder_code varchar [note: 'Business identifier code for the transponder, typically assigned by the satellite operator or internal asset management system. Used for operational reference and capacity planning. | Column transponder_code (STRING) in technology.satellite_transponder']
  transponder_name varchar [note: 'Human-readable name or designation for the transponder, often including satellite name and transponder number for easy identification by broadcast operations teams. | Column transponder_name (STRING) in technology.satellite_transponder']
  transponder_type varchar [note: 'Technology classification of the transponder: Analog (legacy FM), Digital (DVB-S/S2), or Hybrid (supporting both). Modern broadcast operations primarily use digital transponders. | Column transponder_type (STRING) in technology.satellite_transponder']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.satellite_transponder']
  updated_timestamp timestamp [note: 'Timestamp when this transponder record was last modified. Enables change tracking and data quality monitoring for capacity management. | Column updated_timestamp (TIMESTAMP) in technology.satellite_transponder']
  uplink_antenna_size_meters decimal(5,2) [note: 'Diameter of the uplink antenna dish in meters. Larger antennas provide higher gain and better signal quality for satellite transmission. | Column uplink_antenna_size_meters (DECIMAL(5,2)) in technology.satellite_transponder']

  Note: 'Master record for satellite transponder capacity leased or owned by Media Broadcasting for uplink/downlink broadcast distribution. Captures transponder ID, satellite name (e.g., SES-1, Intelsat 21), orbital slot, frequency band (C-band, Ku-band, Ka-band), transponder bandwidth (MHz), polarization, leased capacity (Mbps), lease start/end date, carrier/provider, uplink facility, downlink coverage footprint, and operational status. Manages satellite capacity inventory for linear broadcast distribution. | Unity Catalog table: media_broadcasting_ecm.technology.satellite_transponder'
}

Table technology.tech_asset_lifecycle {
  tech_asset_lifecycle_id varchar [pk, note: 'Unique identifier for the technology asset lifecycle event record. | Column tech_asset_lifecycle_id (BIGINT) in technology.tech_asset_lifecycle']
  broadcast_facility_id varchar [note: 'Reference to the broadcast facility or studio location involved in this lifecycle event (e.g., where the asset was deployed, relocated to, or decommissioned from). | Column broadcast_facility_id (BIGINT) in technology.tech_asset_lifecycle']
  it_asset_id varchar [note: 'Reference to the technology asset (IT asset or transmission equipment) that experienced this lifecycle event. | Column it_asset_id (BIGINT) in technology.tech_asset_lifecycle']
  maintenance_work_order_id varchar [note: 'Foreign key linking to technology.maintenance_work_order. Business justification: tech_asset_lifecycle.work_order_number (STRING) should be normalized to FK to maintenance_work_order. Asset lifecycle events (repairs, upgrades, decommissioning) are often executed via maintenance wor | Column maintenance_work_order_id (BIGINT) in technology.tech_asset_lifecycle']
  partner_id varchar [note: 'Reference to the vendor or service provider involved in this lifecycle event (e.g., supplier for procurement, contractor for installation, disposal company). | Column partner_id (BIGINT) in partner.tech_asset_lifecycle']
  previous_tech_asset_lifecycle_id varchar [note: 'Self-referencing FK on tech_asset_lifecycle (previous_tech_asset_lifecycle_id) | Column previous_tech_asset_lifecycle_id (BIGINT) in technology.tech_asset_lifecycle']
  primary_tech_employee_id varchar [note: 'Identifier of the user or technician who performed or authorized the lifecycle event. | Column primary_tech_employee_id (BIGINT) in workforce.tech_asset_lifecycle']
  tertiary_tech_created_by_user_employee_id varchar [note: 'Identifier of the user who created this lifecycle event record in the system. | Column tertiary_tech_created_by_user_employee_id (BIGINT) in workforce.tech_asset_lifecycle']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Lifecycle events track transmission equipment state transitions (commissioning, maintenance, decommissioning). Currently tech_asset_lifecycle only links to it_asset. Adding specific FK for transmissio | Column transmission_equipment_id (BIGINT) in technology.tech_asset_lifecycle']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.tech_asset_lifecycle']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.tech_asset_lifecycle']
  approval_required_flag boolean [note: 'Indicates whether this lifecycle event required management or executive approval before execution. | Column approval_required_flag (BOOLEAN) in technology.tech_asset_lifecycle']
  approval_timestamp timestamp [note: 'Date and time when this lifecycle event was approved. | Column approval_timestamp (TIMESTAMP) in technology.tech_asset_lifecycle']
  approved_by_user_name varchar [note: 'Name of the manager or executive who approved this lifecycle event. | Column approved_by_user_name (STRING) in technology.tech_asset_lifecycle']
  asset_tag varchar [note: 'Physical asset tag or barcode identifier of the asset at the time of the lifecycle event. | Column asset_tag (STRING) in technology.tech_asset_lifecycle']
  compliance_requirement_flag boolean [note: 'Indicates whether this lifecycle event was driven by regulatory or compliance requirements (e.g., FCC equipment upgrade mandate, environmental disposal regulation). | Column compliance_requirement_flag (BOOLEAN) in technology.tech_asset_lifecycle']
  compliance_standard_reference varchar [note: 'Reference to the specific compliance standard, regulation, or policy that mandated or governed this lifecycle event (e.g., FCC Part 73, ATSC 3.0 transition, ISO 55000). | Column compliance_standard_reference (STRING) in technology.tech_asset_lifecycle']
  cost_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the event cost amount. | Column cost_currency_code (STRING) in technology.tech_asset_lifecycle']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.tech_asset_lifecycle']
  created_timestamp timestamp [note: 'Date and time when this lifecycle event record was first created in the system. | Column created_timestamp (TIMESTAMP) in technology.tech_asset_lifecycle']
  depreciation_impact_flag boolean [note: 'Indicates whether this lifecycle event affects the depreciation schedule of the asset (e.g., upgrade extends useful life, disposal triggers final depreciation). | Column depreciation_impact_flag (BOOLEAN) in technology.tech_asset_lifecycle']
  disposal_certificate_number varchar [note: 'Certificate or documentation number proving compliant disposal of the asset (applicable for disposal events requiring regulatory proof). | Column disposal_certificate_number (STRING) in technology.tech_asset_lifecycle']
  disposal_method varchar [note: 'Method used to dispose of the asset (applicable only for disposal lifecycle events): resale (sold to third party), donation (given to charity or institution), recycling (sent to certified recycler), e-waste (electronic waste disposal), destruction (physical destruction for security), return_to_vendor (returned under lease or warranty). | Column disposal_method (STRING) in technology.tech_asset_lifecycle']
  downtime_duration_minutes varchar [note: 'Duration in minutes that the asset or associated service was unavailable due to this lifecycle event (applicable for deployment, relocation, upgrade, repair, decommission events). | Column downtime_duration_minutes (INT) in technology.tech_asset_lifecycle']
  event_cost_amount decimal(15,2) [note: 'Direct cost incurred for this lifecycle event (e.g., procurement price, installation labor cost, repair cost, disposal fee). | Column event_cost_amount (DECIMAL(15,2)) in technology.tech_asset_lifecycle']
  event_notes varchar [note: 'Free-text notes providing additional context, observations, or details about this lifecycle event (e.g., reason for relocation, issues encountered during deployment, special handling instructions). | Column event_notes (STRING) in technology.tech_asset_lifecycle']
  event_timestamp timestamp [note: 'Date and time when the lifecycle event occurred in the real world. | Column event_timestamp (TIMESTAMP) in technology.tech_asset_lifecycle']
  facility_name varchar [note: 'Name of the broadcast facility or studio location involved in this lifecycle event. | Column facility_name (STRING) in technology.tech_asset_lifecycle']
  impact_assessment varchar [note: 'Business impact assessment of this lifecycle event, describing affected services, channels, or operations. | Column impact_assessment (STRING) in technology.tech_asset_lifecycle']
  last_modified_timestamp timestamp [note: 'Date and time when this lifecycle event record was last updated in the system. | Column last_modified_timestamp (TIMESTAMP) in technology.tech_asset_lifecycle']
  lifecycle_event_type varchar [note: 'Type of lifecycle state transition event: procurement (initial acquisition), deployment (put into service), relocation (moved to new location), upgrade (hardware/software enhancement), repair (corrective action), maintenance (preventive service), decommission (removed from service), disposal (final disposition). [ENUM-REF-CANDIDATE: procurement|deployment|relocation|upgrade|repair|maintenance|decommission|disposal — 8 candidates stripped; promote to reference product] | Column lifecycle_event_type (STRING) in technology.tech_asset_lifecycle']
  location_description varchar [note: 'Detailed description of the physical location within the facility (e.g., rack position, room number, studio designation) where the asset was involved in this event. | Column location_description (STRING) in technology.tech_asset_lifecycle']
  new_state varchar [note: 'The lifecycle state or operational status of the asset immediately after this event. | Column new_state (STRING) in technology.tech_asset_lifecycle']
  performed_by_user_name varchar [note: 'Name of the user or technician who performed or authorized the lifecycle event. | Column performed_by_user_name (STRING) in technology.tech_asset_lifecycle']
  previous_state varchar [note: 'The lifecycle state or operational status of the asset immediately before this event (e.g., in-service, under-repair, available, decommissioned). | Column previous_state (STRING) in technology.tech_asset_lifecycle']
  purchase_order_number varchar [note: 'Purchase order number associated with this lifecycle event (applicable for procurement, upgrade, or repair events involving procurement). | Column purchase_order_number (STRING) in technology.tech_asset_lifecycle']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.tech_asset_lifecycle']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.tech_asset_lifecycle']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.tech_asset_lifecycle']
  warranty_impact_flag boolean [note: 'Indicates whether this lifecycle event affects the warranty status of the asset (e.g., unauthorized repair voids warranty, upgrade extends warranty). | Column warranty_impact_flag (BOOLEAN) in technology.tech_asset_lifecycle']

  Note: 'Transactional audit record tracking each significant lifecycle state transition for a technology asset (IT asset or transmission equipment) — procurement, deployment, relocation, upgrade, repair, decommission, and disposal events. Captures asset reference, lifecycle event type, event timestamp, previous state, new state, performed by, facility involved, notes, and disposal method (if applicable). Enables full asset lifecycle traceability for compliance, depreciation, and refresh planning. | Unity Catalog table: media_broadcasting_ecm.technology.tech_asset_lifecycle'
}

Table technology.tech_problem {
  tech_problem_id varchar [pk, note: 'Primary key for tech_problem | Column tech_problem_id (BIGINT) in technology.tech_problem']
  knowledge_article_id varchar [note: 'Reference to the knowledge base article created from this problem for future reference and training. | Column knowledge_article_id (BIGINT) in technology.tech_problem']
  parent_tech_problem_id varchar [note: 'Self-referencing FK on tech_problem (related_tech_problem_id) | Column related_tech_problem_id (BIGINT) in technology.tech_problem']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.tech_problem']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.tech_problem']
  actual_cost decimal(15,2) [note: 'Actual financial cost incurred to resolve the problem after completion, including all direct and indirect expenses. | Column actual_cost (DECIMAL(15,2)) in technology.tech_problem']
  affected_asset_count varchar [note: 'Number of technology assets (equipment, systems, facilities) impacted by this problem. | Column affected_asset_count (INT) in technology.tech_problem']
  affected_service varchar [note: 'Primary broadcast service or technology service impacted by this problem (e.g., live transmission, playout, encoding). | Column affected_service (STRING) in technology.tech_problem']
  assigned_to_individual varchar [note: 'Name of the specific engineer or problem manager assigned as owner for this problem investigation. | Column assigned_to_individual (STRING) in technology.tech_problem']
  assigned_to_team varchar [note: 'Name of the technology team or support group responsible for investigating and resolving this problem. | Column assigned_to_team (STRING) in technology.tech_problem']
  change_request_number varchar [note: 'Reference to the change request raised to implement the permanent solution for this problem. | Column change_request_number (STRING) in technology.tech_problem']
  closed_date date [note: 'Date when the problem record was formally closed after verification and documentation completion. | Column closed_date (DATE) in technology.tech_problem']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in technology.tech_problem']
  detected_date date [note: 'Date when the underlying problem condition was first detected in broadcast infrastructure or systems. | Column detected_date (DATE) in technology.tech_problem']
  downtime_minutes varchar [note: 'Total minutes of broadcast service downtime or degradation caused by this problem across all affected services. | Column downtime_minutes (INT) in technology.tech_problem']
  estimated_cost decimal(15,2) [note: 'Estimated financial cost to resolve the problem including labor, parts, vendor fees, and downtime impact. | Column estimated_cost (DECIMAL(15,2)) in technology.tech_problem']
  impact varchar [note: 'Assessment of the business impact scope affecting broadcast operations, audience reach, or revenue. | Column impact (STRING) in technology.tech_problem']
  incident_count varchar [note: 'Number of incidents that have been linked to or caused by this underlying problem. | Column incident_count (INT) in technology.tech_problem']
  investigation_start_date date [note: 'Date when formal investigation and root cause analysis activities began for this problem. | Column investigation_start_date (DATE) in technology.tech_problem']
  is_known_error boolean [note: 'Indicates whether this problem has been documented as a known error with identified root cause and workaround in the knowledge base. | Column is_known_error (BOOLEAN) in technology.tech_problem']
  is_major_problem boolean [note: 'Indicates whether this problem is classified as a major problem requiring executive attention and special handling procedures. | Column is_major_problem (BOOLEAN) in technology.tech_problem']
  permanent_solution varchar [note: 'Documented permanent fix or resolution implemented to eliminate the root cause of the problem. | Column permanent_solution (STRING) in technology.tech_problem']
  priority varchar [note: 'Business priority level for problem resolution based on impact and urgency to broadcast operations. | Column priority (STRING) in technology.tech_problem']
  problem_category varchar [note: 'High-level classification of the problem domain within media broadcasting technology operations. | Column problem_category (STRING) in technology.tech_problem']
  problem_number varchar [note: 'Human-readable unique problem identifier used for external communication and tracking. Format: PRB followed by 8 digits. | Column problem_number (STRING) in technology.tech_problem']
  problem_subcategory varchar [note: 'Detailed classification within the problem category for granular analysis and routing to specialized teams. | Column problem_subcategory (STRING) in technology.tech_problem']
  problem_type varchar [note: 'Indicates whether the problem was identified reactively (after incidents) or proactively (through analysis and monitoring). | Column problem_type (STRING) in technology.tech_problem']
  reported_by varchar [note: 'Name or identifier of the person who initially reported or identified this technology problem. | Column reported_by (STRING) in technology.tech_problem']
  reported_date date [note: 'Date when the problem was first reported or identified in the problem management system. | Column reported_date (DATE) in technology.tech_problem']
  resolution_date date [note: 'Date when the permanent solution was implemented and the problem was marked as resolved. | Column resolution_date (DATE) in technology.tech_problem']
  root_cause varchar [note: 'Documented root cause of the problem identified through investigation and analysis, including contributing factors. | Column root_cause (STRING) in technology.tech_problem']
  root_cause_identified_date date [note: 'Date when the root cause of the problem was successfully identified and documented. | Column root_cause_identified_date (DATE) in technology.tech_problem']
  severity varchar [note: 'Technical severity classification indicating the scope and scale of impact on broadcast infrastructure and services. | Column severity (STRING) in technology.tech_problem']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in technology.tech_problem']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in technology.tech_problem']
  target_resolution_date date [note: 'Planned or committed date by which the problem should be resolved based on priority and service level agreements. | Column target_resolution_date (DATE) in technology.tech_problem']
  tech_problem_description varchar [note: 'Detailed narrative description of the technology problem including symptoms, impact, and context for investigation and resolution. | Column description (STRING) in technology.tech_problem']
  tech_problem_status varchar [note: 'Current lifecycle state of the problem record in the problem management workflow. | Column status (STRING) in technology.tech_problem']
  title varchar [note: 'Brief descriptive title summarizing the technology problem for quick identification and reporting. | Column title (STRING) in technology.tech_problem']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in technology.tech_problem']
  urgency varchar [note: 'Time sensitivity for problem resolution based on operational deadlines and broadcast schedules. | Column urgency (STRING) in technology.tech_problem']
  vendor_name varchar [note: 'Name of the equipment or software vendor involved in the problem, if applicable to vendor-supplied technology. | Column vendor_name (STRING) in technology.tech_problem']
  vendor_ticket_number varchar [note: 'External ticket or case number assigned by the vendor for tracking their support and resolution activities. | Column vendor_ticket_number (STRING) in technology.tech_problem']
  workaround varchar [note: 'Temporary solution or procedure to minimize impact of the problem while permanent resolution is developed. | Column workaround (STRING) in technology.tech_problem']

  Note: 'Master reference table for tech_problem. Referenced by related_problem_id. | Unity Catalog table: media_broadcasting_ecm.technology.tech_problem'
}

Table technology.knowledge_article {
  knowledge_article_id varchar [pk, note: 'Primary key for knowledge_article | Column knowledge_article_id (BIGINT) in technology.knowledge_article']
  parent_knowledge_article_id varchar [note: 'Self-referencing FK on knowledge_article (parent_knowledge_article_id) | Column parent_knowledge_article_id (BIGINT) in technology.knowledge_article']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in technology.knowledge_article']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in technology.knowledge_article']
  approval_status varchar [note: 'Current approval workflow status indicating whether the article has been reviewed and approved for publication. | Column approval_status (STRING) in technology.knowledge_article']
  article_number varchar [note: 'Human-readable unique identifier for the knowledge article, typically displayed to users and support staff. | Column article_number (STRING) in technology.knowledge_article']
