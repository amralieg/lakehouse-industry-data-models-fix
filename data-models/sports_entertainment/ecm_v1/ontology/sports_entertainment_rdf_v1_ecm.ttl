    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:knownErrorDate rdf:type rdf:Property ;
    rdfs:label 'Known Error Date' ;
    rdfs:comment 'Date when the problem was officially classified as a known error.' ;
