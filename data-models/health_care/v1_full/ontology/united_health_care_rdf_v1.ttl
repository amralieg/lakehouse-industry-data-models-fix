    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retirementDate rdf:type rdf:Property ;
    rdfs:label 'Retirement Date' ;
    rdfs:comment 'Date when this measure was or will be retired and no longer used for quality reporting.' ;
