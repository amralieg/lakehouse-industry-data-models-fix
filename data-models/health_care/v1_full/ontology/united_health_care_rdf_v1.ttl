ind:annualInteractionVolume rdf:type rdf:Property ;
    rdfs:label 'Annual Interaction Volume' ;
    rdfs:comment 'Estimated or actual number of member interactions handled through this channel annually, used for capacity planning and performance analysis.' ;
    rdfs:domain ind:ServiceChannel ;
