    rdfs:comment 'Level of capability to track delivery, open rates, and member engagement with communications sent through this channel.' ;
    rdfs:domain ind:OutreachChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAssociateAgreementRequired rdf:type rdf:Property ;
    rdfs:label 'Business Associate Agreement Required' ;
    rdfs:comment 'Flag indicating whether a HIPAA Business Associate Agreement is required with vendors supporting this channel due to PHI access.' ;
    rdfs:domain ind:OutreachChannel ;
