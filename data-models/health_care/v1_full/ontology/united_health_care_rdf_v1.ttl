    rdfs:range xsd:string .

ind:declineReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Decline Reason Description' ;
    rdfs:comment 'Detailed description of the reason for declining the enrollment request.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionalApprovalRequirements rdf:type rdf:Property ;
    rdfs:label 'Conditional Approval Requirements' ;
    rdfs:comment 'Specific requirements or conditions that must be met for final approval of the enrollment.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionsApplied rdf:type rdf:Property ;
    rdfs:label 'Exclusions Applied' ;
    rdfs:comment 'Specific medical conditions or services excluded from coverage as part of the underwriting decision.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingTier rdf:type rdf:Property ;
    rdfs:label 'Underwriting Tier' ;
    rdfs:comment 'Tiered classification used for rating and pricing based on underwriting evaluation.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalLossRatioProjection rdf:type rdf:Property ;
    rdfs:label 'Medical Loss Ratio Projection' ;
    rdfs:comment 'Projected Medical Loss Ratio for the group or individual based on underwriting analysis.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimsHistoryReviewed rdf:type rdf:Property ;
    rdfs:label 'Claims History Reviewed' ;
    rdfs:comment 'Indicates whether prior claims history was reviewed as part of the underwriting process.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialEnrollmentPeriod rdf:type rdf:Property ;
    rdfs:label 'Special Enrollment Period' ;
    rdfs:comment 'Indicates whether the enrollment qualifies for a Special Enrollment Period outside of open enrollment.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brokerCommissionPercentage rdf:type rdf:Property ;
    rdfs:label 'Broker Commission Percentage' ;
    rdfs:comment 'Commission percentage payable to the broker for this enrollment.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicationSource rdf:type rdf:Property ;
    rdfs:label 'Application Source' ;
    rdfs:comment 'Source system or method through which the enrollment application was submitted.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpAction rdf:type rdf:Property ;
    rdfs:label 'Follow Up Action' ;
    rdfs:comment 'Description of the specific follow-up action required.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewedByMedicalDirector rdf:type rdf:Property ;
    rdfs:label 'Reviewed By Medical Director' ;
    rdfs:comment 'Indicates whether the underwriting decision was reviewed by a medical director.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalDirectorAgentId rdf:type rdf:Property ;
    rdfs:label 'Medical Director Agent Id' ;
    rdfs:comment 'Unique identifier for the medical director who reviewed the case.' ;
