ind:conversionCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Conversion Coverage Indicator' ;
    rdfs:comment 'Indicates whether this coverage is a conversion from group to individual coverage.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:openEnrollmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Open Enrollment Indicator' ;
    rdfs:comment 'Indicates whether the member enrolled during an open enrollment period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialEnrollmentIndicator rdf:type rdf:Property ;
