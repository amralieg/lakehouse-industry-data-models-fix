    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phoneOptIn rdf:type rdf:Property ;
    rdfs:label 'Phone Opt In' ;
    rdfs:comment 'Indicates whether the lead has consented to receive phone calls for marketing purposes.' ;
