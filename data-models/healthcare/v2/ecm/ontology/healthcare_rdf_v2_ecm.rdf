ind:codeSetVersionId rdf:type rdf:Property ;
    rdfs:label 'Code Set Version Id' ;
    rdfs:comment 'Foreign key linking to reference.code_set_version. Business justification: HEDIS measures reference specific versions of CPT, LOINC, and ICD code sets. Quality measure definitions must be tied to code set versions to ensure accurate measure calculation across reporting perio' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CodeSetVersion .

ind:allowableGapDays rdf:type rdf:Property ;
    rdfs:label 'Allowable Gap Days' ;
    rdfs:comment 'Maximum number of days of enrollment gap permitted during the continuous enrollment period without disqualifying the patient from the eligible population. Defined per NCQA specifications (e.g., 45 days for most measures).' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalArea rdf:type rdf:Property ;
    rdfs:label 'Clinical Area' ;
    rdfs:comment 'Clinical or programmatic area the measure addresses (e.g., \'Diabetes\', \'Cardiovascular\', \'Cancer Screening\', \'Behavioral Health\', \'Maternal Health\', \'Pediatric Care\'). Supports clinical program alignment and population health segmentation in Epic Healthy Planet.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuousEnrollmentDays rdf:type rdf:Property ;
    rdfs:label 'Continuous Enrollment Days' ;
    rdfs:comment 'Number of days of continuous enrollment required for a patient to be included in the eligible population for this measure (e.g., 365 days). Reflects NCQA continuous enrollment specifications used in payer and ACO reporting.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cptCodeList rdf:type rdf:Property ;
    rdfs:label 'Cpt Code List' ;
    rdfs:comment 'Comma-delimited list of CPT procedure codes used to identify qualifying services in the numerator or denominator for this measure. Sourced from NCQA Value Sets and AMA CPT coding standards. Used in administrative and hybrid data collection.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denominatorDefinition rdf:type rdf:Property ;
    rdfs:label 'Denominator Definition' ;
    rdfs:comment 'Formal definition of the denominator population for this measure — the subset of the eligible population that meets all inclusion criteria and is not excluded. Specifies the patient cohort against which numerator compliance is measured.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:domainCategory rdf:type rdf:Property ;
    rdfs:label 'Domain Category' ;
    rdfs:comment 'NCQA-defined domain category grouping the measure (e.g., \'Effectiveness of Care\', \'Access and Availability of Care\'). Used for domain-level performance aggregation and regulatory reporting to CMS and NCQA. [ENUM-REF-CANDIDATE: Effectiveness of Care|Access and Availability of Care|Experience of Care|Utilization and Risk Adjusted Utilization|Health Plan Descriptive Information|Measures Collected Using Electronic Clinical Data Systems — promote to reference product]' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligiblePopulationDescription rdf:type rdf:Property ;
    rdfs:label 'Eligible Population Description' ;
    rdfs:comment 'Narrative description of the eligible population (initial patient population) for this measure, including age range, diagnosis criteria, enrollment requirements, and continuous enrollment specifications as defined in the NCQA technical specification.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionCriteria rdf:type rdf:Property ;
    rdfs:label 'Exception Criteria' ;
    rdfs:comment 'Description of denominator exceptions — patients who are excluded from the denominator based on medical reasons, patient refusal, or system limitations that are not captured as standard exclusions. Distinct from exclusions in NCQA methodology.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedisEcqmCode rdf:type rdf:Property ;
    rdfs:label 'Hedis Ecqm Code' ;
    rdfs:comment 'CMS-assigned eCQM identifier (e.g., \'CMS122v12\') when this HEDIS measure has a corresponding electronic clinical quality measure specification. Enables FHIR-based data extraction from Epic and Cerner for digital quality reporting to CMS.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hybridMedicalRecordRequired rdf:type rdf:Property ;
    rdfs:label 'Hybrid Medical Record Required' ;
    rdfs:comment 'Indicates whether this measure requires medical record review as part of the hybrid data collection method. True when administrative data alone is insufficient to satisfy numerator criteria and chart abstraction is required from Epic ClinDoc or Cerner PowerChart.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:icd10CodeList rdf:type rdf:Property ;
    rdfs:label 'Icd10 Code List' ;
    rdfs:comment 'Comma-delimited list of ICD-10 diagnosis codes used to identify eligible patients or define the denominator/numerator for this measure. Sourced from NCQA Value Sets and aligned with WHO ICD-10 classification. Used in claims-based and hybrid data extraction.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loincCodeList rdf:type rdf:Property ;
    rdfs:label 'Loinc Code List' ;
    rdfs:comment 'Comma-delimited list of LOINC codes for laboratory tests, clinical observations, or assessments used to satisfy numerator criteria for this measure (e.g., HbA1c test codes for CDC measure). Supports EHR-based eCQM data extraction from Beaker LIS and Cerner PathNet.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureCode rdf:type rdf:Property ;
    rdfs:label 'Measure Code' ;
    rdfs:comment 'Official NCQA-assigned alphanumeric code uniquely identifying the HEDIS measure (e.g., CDC, CBP, COL, BCS, AWC). Used as the externally-known business identifier across payer reporting, population health platforms, and Epic Healthy Planet.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureName rdf:type rdf:Property ;
    rdfs:label 'Measure Name' ;
    rdfs:comment 'Full official name of the HEDIS measure as published by NCQA (e.g., \'Comprehensive Diabetes Care\', \'Controlling High Blood Pressure\', \'Colorectal Cancer Screening\'). Human-readable label used in dashboards, regulatory submissions, and quality reports.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureShortName rdf:type rdf:Property ;
    rdfs:label 'Measure Short Name' ;
    rdfs:comment 'Abbreviated or commonly used short name for the HEDIS measure (e.g., \'CDC\', \'CBP\'). Used in operational reporting, Tableau dashboards, and Power BI tiles where space is limited.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureStatus rdf:type rdf:Property ;
    rdfs:label 'Measure Status' ;
    rdfs:comment 'Current lifecycle status of this HEDIS measure specification record: active (in use for current measurement year), retired (no longer reported), suspended (temporarily paused by NCQA), under review (specification being revised), or new (newly introduced measure). Drives inclusion in reporting workflows.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureType rdf:type rdf:Property ;
    rdfs:label 'Measure Type' ;
    rdfs:comment 'Classification of the measure by its quality measurement type: process (was a service delivered), outcome (did the patient\'s health improve), patient experience, access, utilization, or structure. Drives interpretation of performance results and benchmarking methodology.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureVersion rdf:type rdf:Property ;
    rdfs:label 'Measure Version' ;
    rdfs:comment 'Version identifier of the NCQA measure specification (e.g., \'2024.1\'). Tracks specification changes across measurement years to ensure correct logic is applied during data extraction and reporting.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumPerformanceThreshold rdf:type rdf:Property ;
    rdfs:label 'Minimum Performance Threshold' ;
    rdfs:comment 'Minimum acceptable performance rate for this measure below which the organization may face regulatory penalties, payer contract adjustments, or accreditation risk. May reflect CMS floor thresholds, payer contract minimums, or internal quality targets.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nationalAverageRate rdf:type rdf:Property ;
    rdfs:label 'National Average Rate' ;
    rdfs:comment 'NCQA-published national average (mean) performance rate for this measure and measurement year, expressed as a decimal proportion. Used as a baseline comparison for organizational performance assessment and gap analysis reporting.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nationalBenchmarkRate rdf:type rdf:Property ;
    rdfs:label 'National Benchmark Rate' ;
    rdfs:comment 'NCQA-published national benchmark performance rate for this measure and measurement year, expressed as a decimal proportion (e.g., 0.8250 = 82.50%). Represents the 90th percentile or mean threshold used for health plan accreditation and VBP incentive calculations.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ncqaProgram rdf:type rdf:Property ;
    rdfs:label 'Ncqa Program' ;
    rdfs:comment 'NCQA quality program under which this measure is reported (e.g., HEDIS, HEDIS MY for Medicare/Medicaid, CAHPS, HOS, PCMH, ACO HEDIS). Determines submission pathway, benchmark set, and accreditation implications.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncqaSpecificationUrl rdf:type rdf:Property ;
    rdfs:label 'Ncqa Specification Url' ;
    rdfs:comment 'URL link to the official NCQA HEDIS technical specification document for this measure and measurement year. Provides direct access to the authoritative specification for CDI analysts, quality abstractors, and data engineers configuring extraction logic.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numeratorDefinition rdf:type rdf:Property ;
    rdfs:label 'Numerator Definition' ;
    rdfs:comment 'Formal definition of the numerator for this measure — the subset of the denominator population that received the required service, met the outcome threshold, or satisfied the measure criteria. Defines what constitutes a compliant event.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceRateDirection rdf:type rdf:Property ;
    rdfs:label 'Performance Rate Direction' ;
    rdfs:comment 'Indicates whether a higher or lower performance rate represents better quality for this measure. \'Higher is better\' applies to most preventive care measures; \'lower is better\' applies to utilization and adverse event measures (e.g., avoidable ED visits). Critical for correct benchmarking logic.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productLine rdf:type rdf:Property ;
    rdfs:label 'Product Line' ;
    rdfs:comment 'Health plan product line for which this measure applies: commercial, Medicaid, Medicare, Exchange (ACA Marketplace), or CHIP. NCQA publishes separate technical specifications and benchmarks by product line; this field drives correct specification selection.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End Date' ;
    rdfs:comment 'End date of the official HEDIS measurement and reporting period for this measure and measurement year. Services occurring after this date are excluded from the current measurement year calculation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start Date' ;
    rdfs:comment 'Start date of the official HEDIS measurement and reporting period for this measure and measurement year. Defines the window during which eligible services must occur to count toward numerator compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingSubmissionDeadline rdf:type rdf:Property ;
    rdfs:label 'Reporting Submission Deadline' ;
    rdfs:comment 'Deadline date by which HEDIS measure results must be submitted to NCQA, CMS, or the applicable payer for this measurement year. Drives quality reporting project timelines and SLA management for the Quality and Compliance department.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsibleProgram rdf:type rdf:Property ;
    rdfs:label 'Responsible Program' ;
    rdfs:comment 'Name of the internal quality program or department responsible for owning, monitoring, and improving performance on this measure (e.g., \'Population Health\', \'Diabetes Disease Management\', \'Preventive Care\', \'Behavioral Health Integration\'). Used for accountability assignment in quality governance.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stratificationCriteria rdf:type rdf:Property ;
    rdfs:label 'Stratification Criteria' ;
    rdfs:comment 'Description of the stratification dimensions required for this measure (e.g., \'Age 18-64 / Age 65+\', \'Race/Ethnicity per OMB categories\', \'Gender\'). Populated only when stratification_required is True. Supports health equity analytics and SDOH reporting.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stratificationRequired rdf:type rdf:Property ;
    rdfs:label 'Stratification Required' ;
    rdfs:comment 'Indicates whether NCQA requires this measure to be reported with stratified results (e.g., by age group, race/ethnicity, or gender). True when stratification is mandatory for NCQA submission or CMS health equity reporting under SDOH initiatives.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetPerformanceRate rdf:type rdf:Property ;
    rdfs:label 'Target Performance Rate' ;
    rdfs:comment 'Organization-defined internal target performance rate for this measure and measurement year, expressed as a decimal proportion. Set by the Quality department as a stretch goal above the minimum threshold, used for internal KPI tracking and quality improvement planning.' ;
    rdfs:domain ind:HedisMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueSetOid rdf:type rdf:Property ;
    rdfs:label 'Value Set Oid' ;
    rdfs:comment 'Object Identifier (OID) referencing the NCQA-published value set associated with this measure. Used to retrieve the authoritative code lists from the NCQA Value Set Directory and align with HL7 FHIR value set resources for interoperability.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedisResultId rdf:type rdf:Property ;
    rdfs:label 'Hedis Result Id' ;
    rdfs:comment 'Unique surrogate identifier for each HEDIS measure performance result record in the silver layer lakehouse. Primary key for this transactional entity.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditorOrganization rdf:type rdf:Property ;
    rdfs:label 'Auditor Organization' ;
    rdfs:comment 'Name of the NCQA-licensed organization that performed or is performing the HEDIS Compliance Audit for this measure result (e.g., Cotiviti, Inovalon, Optum). Required for NCQA accreditation submissions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkComparisonResult rdf:type rdf:Property ;
    rdfs:label 'Benchmark Comparison Result' ;
    rdfs:comment 'Categorical result of comparing the organization\'s performance rate against NCQA national benchmarks. Indicates whether performance is above the 90th percentile, between the 50th and 90th percentile, or below the 50th percentile. Used for accreditation status determination and quality improvement prioritization.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationRunTimestamp rdf:type rdf:Property ;
    rdfs:label 'Calculation Run Timestamp' ;
    rdfs:comment 'The date and time when the HEDIS measure calculation was executed to produce this result record. Represents the principal business event timestamp for this transactional record. Used for audit trails and recalculation tracking.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataSourceType rdf:type rdf:Property ;
    rdfs:label 'Data Source Type' ;
    rdfs:comment 'Primary data source type used to calculate this HEDIS measure result. Indicates whether the result was derived from administrative claims, EHR clinical data (Epic/Cerner), laboratory data (Beaker/PathNet), pharmacy data (Willow/PharmNet), external registry, or a hybrid combination.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denominatorCount rdf:type rdf:Property ;
    rdfs:label 'Denominator Count' ;
    rdfs:comment 'Total count of eligible members or patients who meet the HEDIS measure denominator criteria (initial patient population minus exclusions) for the reporting period. Represents the population at risk for the measure.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exceptionCount rdf:type rdf:Property ;
    rdfs:label 'Exception Count' ;
    rdfs:comment 'Count of members or patients who qualify for a medical or patient exception to the measure numerator requirement (e.g., patient refusal, medical contraindication documented by clinician). Distinct from exclusions; exceptions are included in the denominator but not penalized.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exclusionCount rdf:type rdf:Property ;
    rdfs:label 'Exclusion Count' ;
    rdfs:comment 'Count of members or patients removed from the initial patient population due to valid NCQA-defined exclusion criteria (e.g., hospice enrollment, contraindications, prior procedures). Reduces the denominator.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gapCount rdf:type rdf:Property ;
    rdfs:label 'Gap Count' ;
    rdfs:comment 'Count of members or patients in the denominator who did NOT meet the numerator criteria and have an open care gap. Calculated as denominator_count minus numerator_count minus exception_count. Drives care gap closure outreach and population health interventions.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hybridSampleSize rdf:type rdf:Property ;
    rdfs:label 'Hybrid Sample Size' ;
    rdfs:comment 'For hybrid methodology measures, the number of medical records sampled for manual review as part of the HEDIS hybrid data collection process. Null for administrative-only measures. NCQA specifies minimum sample sizes.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hybridSupplementalDataUsed rdf:type rdf:Property ;
    rdfs:label 'Hybrid Supplemental Data Used' ;
    rdfs:comment 'Indicates whether supplemental data sources (e.g., EHR data from Epic Healthy Planet, lab data from Beaker, pharmacy data from Willow) were used to supplement administrative claims data in the hybrid measure calculation. True if supplemental data was incorporated.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:initialPopulationCount rdf:type rdf:Property ;
    rdfs:label 'Initial Population Count' ;
    rdfs:comment 'Total count of members or patients who meet the initial patient population criteria for the HEDIS measure before applying exclusions. Provides the starting universe for denominator calculation.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isReportable rdf:type rdf:Property ;
    rdfs:label 'Is Reportable' ;
    rdfs:comment 'Indicates whether this HEDIS measure result meets NCQA minimum denominator size requirements (typically n≥30) and is eligible for external reporting and submission. False if the denominator is too small for reportable results.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStarredMeasure rdf:type rdf:Property ;
    rdfs:label 'Is Starred Measure' ;
    rdfs:comment 'Indicates whether this HEDIS measure is included in the CMS Medicare Advantage Star Ratings program. True if the measure contributes to the plan\'s overall Star Rating score, which affects CMS bonus payments and plan marketing.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:methodologyType rdf:type rdf:Property ;
    rdfs:label 'Methodology Type' ;
    rdfs:comment 'Indicates the HEDIS measurement methodology used to calculate this result: administrative (claims-based), hybrid (claims plus medical record review), survey (CAHPS-based), or ECDS (Electronic Clinical Data Systems). Drives data collection and audit requirements.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mipsQualityCategory rdf:type rdf:Property ;
    rdfs:label 'Mips Quality Category' ;
    rdfs:comment 'Indicates the MIPS performance category this HEDIS measure contributes to under the CMS MACRA/MIPS program. Supports provider-level MIPS quality score calculation and APM reporting.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncqaBenchmarkPercentile50 rdf:type rdf:Property ;
    rdfs:label 'Ncqa Benchmark Percentile 50' ;
    rdfs:comment 'NCQA-published national 50th percentile benchmark rate for this HEDIS measure and measurement year. Used to assess whether the organization\'s performance is at or above the national median.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ncqaBenchmarkPercentile90 rdf:type rdf:Property ;
    rdfs:label 'Ncqa Benchmark Percentile 90' ;
    rdfs:comment 'NCQA-published national 90th percentile benchmark rate for this HEDIS measure and measurement year. Represents the high-performance threshold used for NCQA accreditation and CMS Star Rating top-box scoring.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numeratorCount rdf:type rdf:Property ;
    rdfs:label 'Numerator Count' ;
    rdfs:comment 'Count of eligible members or patients in the denominator who met the HEDIS measure numerator criteria (i.e., received the required service, achieved the clinical threshold, or had the desired outcome) during the measurement period.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:performanceRate rdf:type rdf:Property ;
    rdfs:label 'Performance Rate' ;
    rdfs:comment 'Calculated HEDIS measure performance rate expressed as a decimal proportion (numerator_count / denominator_count). Stored as a decimal (e.g., 0.7823 = 78.23%). Used for benchmarking, VBP scoring, and NCQA accreditation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorYearPerformanceRate rdf:type rdf:Property ;
    rdfs:label 'Prior Year Performance Rate' ;
    rdfs:comment 'The organization\'s HEDIS performance rate for this same measure from the immediately preceding measurement year. Enables year-over-year trend analysis and improvement tracking.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateChangeFromPriorYear rdf:type rdf:Property ;
    rdfs:label 'Rate Change From Prior Year' ;
    rdfs:comment 'Difference between the current year performance rate and the prior year performance rate (current minus prior). Positive values indicate improvement; negative values indicate decline. Supports trend reporting and VBP improvement scoring.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resultIdentifier rdf:type rdf:Property ;
    rdfs:label 'Result Identifier' ;
    rdfs:comment 'Externally-known alphanumeric identifier for this HEDIS result record, used in NCQA submissions, payer reporting, and audit trails. Format: HEDIS-{YEAR}-{MEASURE_CODE}-{SITE_CODE}-{SEQUENCE}.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultNotes rdf:type rdf:Property ;
    rdfs:label 'Result Notes' ;
    rdfs:comment 'Free-text field for quality analysts and HIM staff to document relevant notes about this HEDIS result, such as data quality issues, audit findings, corrective action plans, or explanations for performance outliers.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultVersion rdf:type rdf:Property ;
    rdfs:label 'Result Version' ;
    rdfs:comment 'Incrementing version number for this HEDIS result record, supporting recalculation scenarios where the measure is rerun due to data corrections, supplemental data additions, or audit findings. Version 1 is the initial calculation.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:starRatingWeight rdf:type rdf:Property ;
    rdfs:label 'Star Rating Weight' ;
    rdfs:comment 'The CMS-assigned weight factor for this HEDIS measure in the Medicare Advantage Star Ratings composite score calculation. Higher weights indicate greater impact on the overall Star Rating. Null for non-Star measures.' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stratificationCategory rdf:type rdf:Property ;
    rdfs:label 'Stratification Category' ;
    rdfs:comment 'Population stratification dimension applied to this result record (e.g., age band, gender, race/ethnicity, geographic region, payer mix). Supports health equity analysis and NCQA stratified reporting requirements. [ENUM-REF-CANDIDATE: overall|age_18_64|age_65_plus|male|female|race_white|race_black|race_hispanic|geographic_urban|geographic_rural — promote to reference product]' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionTarget rdf:type rdf:Property ;
    rdfs:label 'Submission Target' ;
    rdfs:comment 'Identifies the recipient organization or program to which this HEDIS result is being submitted (e.g., NCQA for accreditation, CMS for Medicare Advantage Star Ratings, state Medicaid agency, commercial payer, or internal quality reporting only).' ;
    rdfs:domain ind:HedisResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cahpsSurveyId rdf:type rdf:Property ;
    rdfs:label 'Cahps Survey Id' ;
    rdfs:comment 'Unique system-generated identifier for each CAHPS survey program definition or patient response record in the master and transactional entity.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CahpsSurvey .

ind:administrationMode rdf:type rdf:Property ;
    rdfs:label 'Administration Mode' ;
    rdfs:comment 'Method used to administer the CAHPS survey to the patient. CMS-approved modes include mail, telephone, mixed (mail with telephone follow-up), active interactive voice response (IVR), and web. Affects response rate calculations and mode adjustment factors.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Cms Submission Date' ;
    rdfs:comment 'Date the CAHPS survey data was submitted to CMS for the reporting period. Used to verify timely submission compliance with CMS quality reporting deadlines.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cmsSubmissionStatus rdf:type rdf:Property ;
    rdfs:label 'Cms Submission Status' ;
    rdfs:comment 'Status of the CAHPS data submission to CMS for the reporting period. Tracks whether data has been submitted, accepted, or requires resubmission for quality reporting compliance.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleDischarges rdf:type rdf:Property ;
    rdfs:label 'Eligible Discharges' ;
    rdfs:comment 'Total number of patient discharges or encounters eligible for CAHPS survey sampling during the reporting period, prior to exclusion criteria application.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hcahpsLinearMeanScore rdf:type rdf:Property ;
    rdfs:label 'Hcahps Linear Mean Score' ;
    rdfs:comment 'CMS-calculated linear mean score for the HCAHPS survey submission, used in VBP achievement and improvement scoring. Derived from the HCAHPS Summary Star Rating methodology.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumCaseThresholdMet rdf:type rdf:Property ;
    rdfs:label 'Minimum Case Threshold Met' ;
    rdfs:comment 'Indicates whether the facility met the CMS minimum case threshold (typically 100 completed surveys) required for public reporting and VBP scoring eligibility.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modeAdjustmentApplied rdf:type rdf:Property ;
    rdfs:label 'Mode Adjustment Applied' ;
    rdfs:comment 'Indicates whether a CMS-approved mode adjustment factor was applied to the survey scores to account for differences in response patterns across administration modes (mail, telephone, mixed).' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overallHospitalRating rdf:type rdf:Property ;
    rdfs:label 'Overall Hospital Rating' ;
    rdfs:comment 'Patient\'s overall rating of the hospital on a 0-10 numeric scale. Top-box score (9-10) is a key CMS VBP Patient Experience domain metric and publicly reported on Hospital Compare.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientMixAdjustmentApplied rdf:type rdf:Property ;
    rdfs:label 'Patient Mix Adjustment Applied' ;
    rdfs:comment 'Indicates whether patient-mix adjustment (case-mix adjustment) was applied to HCAHPS scores to account for patient demographic and health status differences across facilities, enabling fair comparisons.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publiclyReported rdf:type rdf:Property ;
    rdfs:label 'Publicly Reported' ;
    rdfs:comment 'Indicates whether the CAHPS survey results for this facility and reporting period are publicly reported on CMS Care Compare (formerly Hospital Compare). Facilities must meet minimum case thresholds for public reporting.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recommendHospital rdf:type rdf:Property ;
    rdfs:label 'Recommend Hospital' ;
    rdfs:comment 'Patient\'s response to whether they would recommend the hospital to friends and family. Four-point scale: definitely yes, probably yes, probably no, definitely no. Top-box (definitely yes) is publicly reported on Hospital Compare.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End' ;
    rdfs:comment 'End date of the CAHPS data collection and reporting period. Used to aggregate results for CMS submission and VBP scoring.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start' ;
    rdfs:comment 'Start date of the CAHPS data collection and reporting period (typically quarterly or annual). Used to aggregate results for CMS submission and VBP scoring.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responseLanguage rdf:type rdf:Property ;
    rdfs:label 'Response Language' ;
    rdfs:comment 'Language in which the patient completed the CAHPS survey (e.g., English, Spanish, Chinese). CMS provides translated HCAHPS instruments for approved languages. ISO 639-1 two-letter language code.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseReceived rdf:type rdf:Property ;
    rdfs:label 'Response Received' ;
    rdfs:comment 'Indicates whether a completed survey response was received from the patient. Used in response rate calculations and non-response tracking.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:samplingMethodology rdf:type rdf:Property ;
    rdfs:label 'Sampling Methodology' ;
    rdfs:comment 'Statistical sampling approach used to select patients for CAHPS survey administration. CMS allows census (all eligible patients), random sample, or stratified random sample. Affects weighting and representativeness of results.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreCareTransition rdf:type rdf:Property ;
    rdfs:label 'Score Care Transition' ;
    rdfs:comment 'Patient-reported composite score for the Care Transition domain of HCAHPS. Measures whether patients understood their care responsibilities and had a clear plan post-discharge. Expressed as a percentage (0-100) of top-box responses.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreCleanliness rdf:type rdf:Property ;
    rdfs:label 'Score Cleanliness' ;
    rdfs:comment 'Patient-reported score for the Cleanliness of Hospital Environment item of HCAHPS. Measures how often the patient\'s room and bathroom were kept clean. Expressed as a percentage (0-100) of top-box responses.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreCommunicationDoctors rdf:type rdf:Property ;
    rdfs:label 'Score Communication Doctors' ;
    rdfs:comment 'Patient-reported composite score for the Communication with Doctors domain of HCAHPS. Derived from questions about how often doctors communicated well. Expressed as a percentage (0-100) of top-box responses. Key input to CMS VBP Patient Experience domain.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreCommunicationMedicines rdf:type rdf:Property ;
    rdfs:label 'Score Communication Medicines' ;
    rdfs:comment 'Patient-reported composite score for the Communication About Medicines domain of HCAHPS. Measures how often staff explained medications and side effects. Expressed as a percentage (0-100) of top-box responses.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreCommunicationNurses rdf:type rdf:Property ;
    rdfs:label 'Score Communication Nurses' ;
    rdfs:comment 'Patient-reported composite score for the Communication with Nurses domain of HCAHPS. Derived from questions about how often nurses communicated well. Expressed as a percentage (0-100) of top-box responses.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreDischargeInformation rdf:type rdf:Property ;
    rdfs:label 'Score Discharge Information' ;
    rdfs:comment 'Patient-reported composite score for the Discharge Information domain of HCAHPS. Measures whether patients received adequate information about recovery and follow-up care at discharge. Expressed as a percentage (0-100) of top-box responses.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scorePainManagement rdf:type rdf:Property ;
    rdfs:label 'Score Pain Management' ;
    rdfs:comment 'Patient-reported composite score for the Pain Management domain of HCAHPS. Measures how well hospital staff helped manage patient pain. Expressed as a percentage (0-100) of top-box responses.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreQuietness rdf:type rdf:Property ;
    rdfs:label 'Score Quietness' ;
    rdfs:comment 'Patient-reported score for the Quietness of Hospital Environment item of HCAHPS. Measures how often the area around the patient\'s room was quiet at night. Expressed as a percentage (0-100) of top-box responses.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scoreResponsivenessStaff rdf:type rdf:Property ;
    rdfs:label 'Score Responsiveness Staff' ;
    rdfs:comment 'Patient-reported composite score for the Responsiveness of Hospital Staff domain of HCAHPS. Measures how often staff responded promptly to patient needs. Expressed as a percentage (0-100) of top-box responses.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:starRating rdf:type rdf:Property ;
    rdfs:label 'Star Rating' ;
    rdfs:comment 'CMS HCAHPS Summary Star Rating (1-5 stars) assigned to the facility based on HCAHPS composite and global item scores. Publicly reported on CMS Care Compare website.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveyFollowupDate rdf:type rdf:Property ;
    rdfs:label 'Survey Followup Date' ;
    rdfs:comment 'Date of the follow-up contact attempt (second mailing or telephone follow-up) for non-responding patients in mixed-mode administration.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyMailedDate rdf:type rdf:Property ;
    rdfs:label 'Survey Mailed Date' ;
    rdfs:comment 'Date the CAHPS survey was first mailed or initiated to the patient. Used to calculate response windows and follow-up timing per CMS protocols.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyProgramCode rdf:type rdf:Property ;
    rdfs:label 'Survey Program Code' ;
    rdfs:comment 'Standardized code identifying the specific CAHPS survey program. HCAHPS = Hospital CAHPS, CG-CAHPS = Clinician and Group CAHPS, HH-CAHPS = Home Health CAHPS, OAS-CAHPS = Outpatient and Ambulatory Surgery CAHPS, ICH-CAHPS = In-Center Hemodialysis CAHPS, PCMH-CAHPS = Patient-Centered Medical Home CAHPS. [ENUM-REF-CANDIDATE: HCAHPS|CG-CAHPS|HH-CAHPS|OAS-CAHPS|ICH-CAHPS|PCMH-CAHPS — promote to reference product]' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyStatus rdf:type rdf:Property ;
    rdfs:label 'Survey Status' ;
    rdfs:comment 'Current lifecycle status of the survey administration for a given patient. Tracks progression from sampling through completion or non-response determination per CMS HCAHPS protocols.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyType rdf:type rdf:Property ;
    rdfs:label 'Survey Type' ;
    rdfs:comment 'Categorical classification of the CAHPS survey type indicating the care setting or program type. Drives composite domain scoring logic and CMS reporting requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyVersion rdf:type rdf:Property ;
    rdfs:label 'Survey Version' ;
    rdfs:comment 'Version number or label of the CAHPS survey instrument used (e.g., HCAHPS v15.0, CG-CAHPS 3.0). Ensures responses are interpreted against the correct question set and scoring methodology.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vbpPatientExperienceScore rdf:type rdf:Property ;
    rdfs:label 'Vbp Patient Experience Score' ;
    rdfs:comment 'Calculated CMS Value-Based Purchasing (VBP) patient experience domain score derived from HCAHPS composite and global item scores. Used in VBP Total Performance Score (TPS) calculation affecting Medicare reimbursement.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vendorCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Certification Number' ;
    rdfs:comment 'CMS-issued certification number for the approved CAHPS survey vendor. Required for HCAHPS data submission validation and CMS audit purposes.' ;
    rdfs:domain ind:CahpsSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cahpsResponseId rdf:type rdf:Property ;
    rdfs:label 'Cahps Response Id' ;
    rdfs:comment 'Unique surrogate identifier for each individual CAHPS survey response record in the silver layer lakehouse. Primary key for this transactional entity.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adjustedCompositeScore rdf:type rdf:Property ;
    rdfs:label 'Adjusted Composite Score' ;
    rdfs:comment 'The overall case-mix and mode-adjusted HCAHPS composite score for this response, calculated per CMS linear mean scoring methodology. Adjusts for patient mix differences (age, education, health status, service category, language) to enable fair hospital comparisons.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:careTransitionScore rdf:type rdf:Property ;
    rdfs:label 'Care Transition Score' ;
    rdfs:comment 'Patient-reported composite score for the Care Transition domain. Derived from questions about whether staff took patient preferences into account, understood the purpose of medications, and knew what to do if concerned after discharge. Scored on a 0–100 scale.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dischargeInformationScore rdf:type rdf:Property ;
    rdfs:label 'Discharge Information Score' ;
    rdfs:comment 'Patient-reported composite score for the Discharge Information domain. Derived from questions about whether patients received written information about symptoms to watch for and understood their care responsibilities after discharge. Scored on a 0–100 scale.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:doctorCommunicationScore rdf:type rdf:Property ;
    rdfs:label 'Doctor Communication Score' ;
    rdfs:comment 'Patient-reported composite score for the Communication with Doctors domain of the HCAHPS survey. Derived from questions about how often doctors communicated clearly, listened carefully, and explained things in an understandable way. Scored on a 0–100 scale per CMS methodology.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:educationLevel rdf:type rdf:Property ;
    rdfs:label 'Education Level' ;
    rdfs:comment 'Patient\'s self-reported highest level of education completed as captured on the CAHPS survey. Used as a case-mix adjustment covariate in CMS HCAHPS linear mean score methodology. [ENUM-REF-CANDIDATE: 8th_grade_or_less|some_high_school|high_school_graduate|some_college|4_year_college_graduate|more_than_4_year_college — promote to reference product]' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstContactDate rdf:type rdf:Property ;
    rdfs:label 'First Contact Date' ;
    rdfs:comment 'The date of the first survey contact attempt (initial mailing or first telephone call) made to the patient. Used to track the survey administration timeline and compliance with CMS contact windows.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hospitalEnvironmentScore rdf:type rdf:Property ;
    rdfs:label 'Hospital Environment Score' ;
    rdfs:comment 'Patient-reported composite score for the Hospital Environment domain covering cleanliness and quietness of the hospital environment. Scored on a 0–100 scale per CMS HCAHPS methodology.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ineligibilityReason rdf:type rdf:Property ;
    rdfs:label 'Ineligibility Reason' ;
    rdfs:comment 'The specific reason a patient was excluded from the HCAHPS survey sampling frame. Populated only when is_eligible is False. Used for sampling frame documentation and CMS audit compliance.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEligible rdf:type rdf:Property ;
    rdfs:label 'Is Eligible' ;
    rdfs:comment 'Indicates whether the patient met all CMS eligibility criteria for HCAHPS survey inclusion (e.g., age 18+, non-psychiatric admission, non-excluded diagnosis, minimum one-night stay). Ineligible patients are excluded from the sampling frame.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSampled rdf:type rdf:Property ;
    rdfs:label 'Is Sampled' ;
    rdfs:comment 'Indicates whether the eligible patient was selected into the HCAHPS survey sample for the reporting period. Hospitals may use census or random sampling per CMS guidelines.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languageOfResponse rdf:type rdf:Property ;
    rdfs:label 'Language Of Response' ;
    rdfs:comment 'The ISO 639-2 three-letter language code indicating the language in which the patient completed the CAHPS survey. CMS requires survey vendors to offer surveys in multiple languages. Used for language-stratified response rate analysis.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicineCommunicationScore rdf:type rdf:Property ;
    rdfs:label 'Medicine Communication Score' ;
    rdfs:comment 'Patient-reported composite score for the Communication About Medicines domain. Derived from questions about how often staff explained the purpose of new medications and described possible side effects. Scored on a 0–100 scale per CMS methodology.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nurseCommunicationScore rdf:type rdf:Property ;
    rdfs:label 'Nurse Communication Score' ;
    rdfs:comment 'Patient-reported composite score for the Communication with Nurses domain of the HCAHPS survey. Derived from questions about how often nurses communicated clearly, listened carefully, and explained things in an understandable way. Scored on a 0–100 scale per CMS methodology.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:painManagementScore rdf:type rdf:Property ;
    rdfs:label 'Pain Management Score' ;
    rdfs:comment 'Patient-reported composite score for the Pain Management domain. Derived from questions about how often staff did everything they could to help with pain and how often pain was well controlled. Scored on a 0–100 scale. Note: CMS removed this domain from VBP scoring in 2018 due to opioid concerns; retained for historical trending.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientServiceLine rdf:type rdf:Property ;
    rdfs:label 'Patient Service Line' ;
    rdfs:comment 'The clinical service line associated with the patient\'s inpatient stay (e.g., cardiology, orthopedics, oncology, obstetrics). Used for service-line-level HCAHPS performance stratification and internal benchmarking.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programYear rdf:type rdf:Property ;
    rdfs:label 'Program Year' ;
    rdfs:comment 'The CMS fiscal year for which this CAHPS response contributes to Value-Based Purchasing (VBP) performance scoring and MIPS quality reporting.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingQuarter rdf:type rdf:Property ;
    rdfs:label 'Reporting Quarter' ;
    rdfs:comment 'The CMS reporting quarter in which this survey response is included for HCAHPS public reporting and Value-Based Purchasing (VBP) scoring. Format: YYYYQn (e.g., 2024Q1).' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplingDate rdf:type rdf:Property ;
    rdfs:label 'Sampling Date' ;
    rdfs:comment 'The date the patient was selected into the CAHPS survey sample from the eligible discharge population. Used for sampling frame documentation and CMS audit trail.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:selfReportedHealthStatus rdf:type rdf:Property ;
    rdfs:label 'Self Reported Health Status' ;
    rdfs:comment 'Patient\'s self-reported general health status as captured on the CAHPS survey. Used as a case-mix adjustment covariate in CMS HCAHPS linear mean score methodology to account for patient mix differences across hospitals.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:staffResponsivenessScore rdf:type rdf:Property ;
    rdfs:label 'Staff Responsiveness Score' ;
    rdfs:comment 'Patient-reported composite score for the Responsiveness of Hospital Staff domain. Derived from questions about how often patients received help as soon as they wanted when using the call button or needing to use the bathroom. Scored on a 0–100 scale.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:topBoxDoctorCommunication rdf:type rdf:Property ;
    rdfs:label 'Top Box Doctor Communication' ;
    rdfs:comment 'Indicates whether the patient provided the most favorable (top-box) response for the Communication with Doctors composite domain. CMS VBP scoring uses top-box percentage rates across the patient population.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:topBoxNurseCommunication rdf:type rdf:Property ;
    rdfs:label 'Top Box Nurse Communication' ;
    rdfs:comment 'Indicates whether the patient provided the most favorable (top-box) response for the Communication with Nurses composite domain. Used in CMS VBP Patient Experience of Care domain top-box rate calculation.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:topBoxOverallRating rdf:type rdf:Property ;
    rdfs:label 'Top Box Overall Rating' ;
    rdfs:comment 'Indicates whether the patient gave an overall hospital rating of 9 or 10 (top-box threshold per CMS methodology). Used in CMS VBP Patient Experience of Care domain scoring.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:topBoxRecommend rdf:type rdf:Property ;
    rdfs:label 'Top Box Recommend' ;
    rdfs:comment 'Indicates whether the patient responded \'Definitely Yes\' to the hospital recommendation question (top-box threshold per CMS methodology). Used in CMS VBP Patient Experience of Care domain scoring.' ;
    rdfs:domain ind:CahpsResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disclosureConsentRecordId rdf:type rdf:Property ;
    rdfs:label 'Disclosure Consent Record Id' ;
    rdfs:comment 'Foreign key linking to consent.consent_record. Business justification: TJC sentinel event standards require documented patient/family consent before disclosure of safety event details. Disclosure_status field indicates when consent is needed; this links to the actual con' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentRecord .

ind:radiationDoseRecordId rdf:type rdf:Property ;
    rdfs:label 'Radiation Dose Record Id' ;
    rdfs:comment 'Foreign key linking to radiology.dose_record. Business justification: Radiation overexposure incidents (dose alert threshold breaches, cumulative dose concerns) are patient safety events requiring investigation. Safety event reporting must link to the dose record for ph' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DoseRecord .

ind:actionPlanCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Action Plan Completion Date' ;
    rdfs:comment 'Actual date on which all corrective action plan items were completed and implemented. Used to confirm closure of the safety event lifecycle.' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actionPlanDueDate rdf:type rdf:Property ;
    rdfs:label 'Action Plan Due Date' ;
    rdfs:comment 'Target date by which all corrective action plan items must be completed. Submitted to TJC as part of the sentinel event response package.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actionPlanStatus rdf:type rdf:Property ;
    rdfs:label 'Action Plan Status' ;
    rdfs:comment 'Current completion status of the corrective action plan. Tracks progress from initiation through implementation and effectiveness verification. Drives quality management follow-up workflows.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionPlanSummary rdf:type rdf:Property ;
    rdfs:label 'Action Plan Summary' ;
    rdfs:comment 'Narrative summary of the corrective action plan developed in response to the root cause analysis findings. Describes systemic changes, process improvements, and preventive measures to be implemented.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityIndicator rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Indicator' ;
    rdfs:comment 'Indicates whether this safety event record is protected under peer review or quality assurance confidentiality statutes, which may restrict discoverability in legal proceedings. Varies by state law.' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contributingFactorsSummary rdf:type rdf:Property ;
    rdfs:label 'Contributing Factors Summary' ;
    rdfs:comment 'Narrative summary of the contributing factors identified at the time of initial event report, prior to formal Root Cause Analysis (RCA). May be updated as investigation progresses. Supports early causal analysis.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureDate rdf:type rdf:Property ;
    rdfs:label 'Disclosure Date' ;
    rdfs:comment 'Date on which the patient and/or family were formally informed of the safety event and its circumstances. Required for TJC accreditation and CMS Conditions of Participation compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disclosureStatus rdf:type rdf:Property ;
    rdfs:label 'Disclosure Status' ;
    rdfs:comment 'Status of the patient and/or family disclosure process for this safety event. Tracks whether disclosure has been completed per TJC and CMS requirements for transparent communication of unanticipated outcomes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectivenessVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Verification Date' ;
    rdfs:comment 'Date on which the effectiveness of the corrective action plan was formally verified and documented. Confirms that implemented changes achieved the intended safety improvement. Required for TJC sentinel event closure.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectivenessVerified rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Verified' ;
    rdfs:comment 'Indicates whether the corrective action plan has been formally verified as effective in preventing recurrence of the safety event. Required for TJC sentinel event final closure.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventCategory rdf:type rdf:Property ;
    rdfs:label 'Event Category' ;
    rdfs:comment 'Standardized category of the safety event per AHRQ Common Formats taxonomy (e.g., medication or other substance, fall, pressure ulcer, surgery or anesthesia, healthcare-associated infection, perinatal, device or medical/surgical supply, blood or blood product, environment or infrastructure). [ENUM-REF-CANDIDATE: medication_or_substance|fall|pressure_ulcer|surgery_or_anesthesia|healthcare_associated_infection|perinatal|device_or_supply|blood_or_blood_product|environment_or_infrastructure|other — promote to reference product]' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:harmLevelCode rdf:type rdf:Property ;
    rdfs:label 'Harm Level Code' ;
    rdfs:comment 'Harm level assigned to the event using the National Coordinating Council for Medication Error Reporting and Prevention (NCC MERP) index or equivalent Severity of Harm scale. Categories A–I represent no harm through death. Values A–F shown; full scale: [ENUM-REF-CANDIDATE: A|B|C|D|E|F|G|H|I — promote to reference product]' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:harmLevelDescription rdf:type rdf:Property ;
    rdfs:label 'Harm Level Description' ;
    rdfs:comment 'Human-readable description of the harm level assigned (e.g., \'Reached the patient and required intervention to preclude harm\', \'Contributed to or resulted in permanent patient harm\'). Complements the NCC MERP code for reporting and disclosure.' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCmsReportable rdf:type rdf:Property ;
    rdfs:label 'Is Cms Reportable' ;
    rdfs:comment 'Indicates whether this event must be reported to the Centers for Medicare and Medicaid Services (CMS) under Conditions of Participation or Value-Based Purchasing (VBP) quality reporting requirements.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSentinelEvent rdf:type rdf:Property ;
    rdfs:label 'Is Sentinel Event' ;
    rdfs:comment 'Indicates whether this patient safety event meets The Joint Commission (TJC) definition of a sentinel event requiring formal review and root cause analysis submission. Drives TJC reporting workflow.' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStateReportable rdf:type rdf:Property ;
    rdfs:label 'Is State Reportable' ;
    rdfs:comment 'Indicates whether this event must be reported to the applicable State Department of Health under mandatory adverse event reporting laws. State reporting requirements vary by jurisdiction.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:locationUnit rdf:type rdf:Property ;
    rdfs:label 'Location Unit' ;
    rdfs:comment 'Clinical unit or department where the patient safety event occurred (e.g., ICU, ED, OR, Medical-Surgical Unit, Pharmacy). Supports unit-level safety performance analysis and TJC survey readiness.' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportTimestamp rdf:type rdf:Property ;
    rdfs:label 'Report Timestamp' ;
    rdfs:comment 'Date and time when the patient safety event was formally reported into the safety event management system. Used to calculate reporting lag and compliance with internal reporting windows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reviewDueDate rdf:type rdf:Property ;
    rdfs:label 'Review Due Date' ;
    rdfs:comment 'Target completion date for the formal investigation review. For TJC sentinel events, this is typically 45 days from event identification. Drives escalation and compliance tracking.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewTeamMembers rdf:type rdf:Property ;
    rdfs:label 'Review Team Members' ;
    rdfs:comment 'Comma-separated list of names or role titles of individuals who participated in the formal investigation review team (RCA or ACA). Supports accountability tracking and TJC documentation requirements.' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCausesIdentified rdf:type rdf:Property ;
    rdfs:label 'Root Causes Identified' ;
    rdfs:comment 'Narrative summary of the root causes identified through the formal Root Cause Analysis (RCA) or Apparent Cause Analysis (ACA). Documents the fundamental systemic factors that allowed the event to occur. Supports action plan development.' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceEventReference rdf:type rdf:Property ;
    rdfs:label 'Source Event Reference' ;
    rdfs:comment 'Original identifier of the patient safety event in the source operational system (e.g., Epic incident report ID, RL Solutions event number). Enables traceability back to the system of record.' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tjcAcknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Tjc Acknowledgment Date' ;
    rdfs:comment 'Date on which The Joint Commission (TJC) formally acknowledged receipt and acceptance of the sentinel event RCA submission. Marks completion of the TJC reporting obligation.' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tjcSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Tjc Submission Date' ;
    rdfs:comment 'Date on which the sentinel event report and Root Cause Analysis (RCA) action plan were formally submitted to The Joint Commission (TJC). Required for TJC accreditation compliance.' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:safetyEventReviewId rdf:type rdf:Property ;
    rdfs:label 'Safety Event Review Id' ;
    rdfs:comment 'Unique surrogate identifier for the safety event review record. Primary key for the safety_event_review data product in the quality domain.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:committeeId rdf:type rdf:Property ;
    rdfs:label 'Committee Id' ;
    rdfs:comment 'Foreign key linking to quality.committee. Business justification: Safety event reviews (RCA/ACA) are conducted by or presented to committees (e.g., Patient Safety Committee, Risk Management Committee). This FK enables tracking which committee conducted or reviewed t' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:QualityCommittee .

ind:priorReviewSafetyEventReviewId rdf:type rdf:Property ;
    rdfs:label 'Prior Review Safety Event Review Id' ;
    rdfs:comment 'Reference to a previous safety event review of the same event type, populated when recurrence_flag is True. Enables longitudinal tracking of recurring safety issues and effectiveness of prior corrective actions.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SafetyEventReview .

ind:actionPlanCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Action Plan Completed Date' ;
    rdfs:comment 'Actual date on which all corrective action plan items were fully implemented. Used to measure timeliness of corrective action completion against the action_plan_due_date.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cmsReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Reportable Flag' ;
    rdfs:comment 'Indicates whether this safety event requires reporting to the Centers for Medicare and Medicaid Services (CMS) under Conditions of Participation or Hospital-Acquired Condition (HAC) reduction program requirements.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:departmentUnit rdf:type rdf:Property ;
    rdfs:label 'Department Unit' ;
    rdfs:comment 'Name of the specific clinical department or nursing unit where the safety event occurred (e.g., 4 North Med/Surg, MICU, OR Suite 3). Supports unit-level safety performance reporting.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureToPatientFlag rdf:type rdf:Property ;
    rdfs:label 'Disclosure To Patient Flag' ;
    rdfs:comment 'Indicates whether the safety event and its findings were disclosed to the patient and/or family per CMS Conditions of Participation and TJC patient rights standards. True = disclosure completed.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:effectivenessVerificationNotes rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Verification Notes' ;
    rdfs:comment 'Narrative documentation of the effectiveness verification findings, including metrics used, data reviewed, and conclusions drawn about whether corrective actions achieved the intended risk reduction.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectivenessVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Verification Status' ;
    rdfs:comment 'Status of the post-implementation effectiveness check confirming whether corrective actions successfully reduced or eliminated the identified risk. TJC requires evidence of effectiveness measurement for sentinel event action plans.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:harmLevel rdf:type rdf:Property ;
    rdfs:label 'Harm Level' ;
    rdfs:comment 'Severity of harm to the patient using the National Coordinating Council for Medication Error Reporting and Prevention (NCC MERP) Index or equivalent harm scale (E through I for harm-causing events). Drives regulatory reporting thresholds and review intensity. [ENUM-REF-CANDIDATE: E - Temporary Harm|F - Temporary Harm with Intervention|G - Permanent Harm|H - Life-Sustaining Intervention|I - Death — promote to reference product]' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientSafetyIndicatorCode rdf:type rdf:Property ;
    rdfs:label 'Patient Safety Indicator Code' ;
    rdfs:comment 'AHRQ Patient Safety Indicator (PSI) code associated with this safety event, if applicable (e.g., PSI-03 Pressure Ulcer, PSI-06 Iatrogenic Pneumothorax, PSI-90 Composite). Used for CMS VBP and MIPS quality reporting.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityCommitteeReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Committee Review Flag' ;
    rdfs:comment 'Indicates whether this safety event review was escalated to and reviewed by the hospital Quality Improvement Committee or Patient Safety Committee. Required for TJC governance and CMS QAPI program compliance.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewApprovedDate rdf:type rdf:Property ;
    rdfs:label 'Review Approved Date' ;
    rdfs:comment 'Date on which the completed review findings and action plan were formally approved by the quality committee, patient safety officer, or governing body.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewInitiatedDate rdf:type rdf:Property ;
    rdfs:label 'Review Initiated Date' ;
    rdfs:comment 'Date on which the formal Root Cause Analysis (RCA) or Apparent Cause Analysis (ACA) review process was officially initiated. TJC requires RCA initiation within 45 days of a sentinel event.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewTeamComposition rdf:type rdf:Property ;
    rdfs:label 'Review Team Composition' ;
    rdfs:comment 'Narrative description of the multidisciplinary review team members and their roles (e.g., physician, nurse, pharmacist, risk manager, quality officer, department director). TJC requires interdisciplinary team participation in RCA.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewTeamSize rdf:type rdf:Property ;
    rdfs:label 'Review Team Size' ;
    rdfs:comment 'Total number of individuals who participated in the formal safety event review team. Supports TJC interdisciplinary team composition compliance verification.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tjcReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Tjc Reportable Flag' ;
    rdfs:comment 'Indicates whether this safety event meets The Joint Commission (TJC) criteria for mandatory sentinel event reporting. True = TJC notification required within 5 business days of event determination.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tjcReportedDate rdf:type rdf:Property ;
    rdfs:label 'Tjc Reported Date' ;
    rdfs:comment 'Date on which the sentinel event was formally reported to The Joint Commission (TJC). Required for TJC accreditation compliance tracking. Null if tjc_reportable_flag is False.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mortalityReviewId rdf:type rdf:Property ;
    rdfs:label 'Mortality Review Id' ;
    rdfs:comment 'Unique surrogate identifier for each inpatient mortality review case record in the quality and peer review system. Primary key for the mortality_review data product.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MortalityReview .

ind:primaryMortalityClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Mortality Clinician Id' ;
    rdfs:comment 'Reference to the attending physician of record at the time of the patient\'s death. Used to associate the mortality event with the responsible clinician for peer review and quality reporting purposes.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:reviewConsentRecordId rdf:type rdf:Property ;
    rdfs:label 'Review Consent Record Id' ;
    rdfs:comment 'Foreign key linking to consent.consent_record. Business justification: Mortality review committees requiring family interviews or extended record access beyond treatment scope need documented consent. Quality improvement activities involving patient/family contact requir' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentRecord .

ind:reviewerProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Reviewer Provider Clinician Id' ;
    rdfs:comment 'Reference to the physician or clinical reviewer assigned as the primary reviewer for this mortality case. Supports peer review workload distribution and conflict-of-interest tracking.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:actionPlanRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Action Plan Required Flag' ;
    rdfs:comment 'Indicates whether the peer review committee determined that a formal corrective action plan is required as a result of this mortality review. Triggers downstream quality improvement workflow and follow-up tracking.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careQualityRating rdf:type rdf:Property ;
    rdfs:label 'Care Quality Rating' ;
    rdfs:comment 'Peer review committee\'s overall rating of the quality of care provided during the encounter leading to death. Supports identification of systemic care delivery issues and drives Clinical Documentation Improvement (CDI) initiatives.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdiQueryInitiatedFlag rdf:type rdf:Property ;
    rdfs:label 'Cdi Query Initiated Flag' ;
    rdfs:comment 'Indicates whether a Clinical Documentation Improvement (CDI) query was initiated as a result of this mortality review to clarify or improve clinical documentation for accurate ICD-10 coding and DRG assignment.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmiImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Cmi Impact Flag' ;
    rdfs:comment 'Indicates whether this mortality case was identified as having a potential impact on the facility\'s Case Mix Index (CMI) due to coding gaps or Clinical Documentation Improvement (CDI) opportunities. Supports CDI program prioritization.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsMortalityMeasureCode rdf:type rdf:Property ;
    rdfs:label 'Cms Mortality Measure Code' ;
    rdfs:comment 'Specific CMS mortality outcome measure identifier (e.g., MORT-30-AMI, MORT-30-HF, MORT-30-PN, MORT-30-COPD, MORT-30-STK) applicable to this mortality case. Populated when cms_mortality_measure_flag is true.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsMortalityMeasureFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Mortality Measure Flag' ;
    rdfs:comment 'Indicates whether this mortality case is included in a CMS Hospital Inpatient Quality Reporting (IQR) mortality outcome measure (e.g., AMI-30-day, HF-30-day, PN-30-day mortality). Supports CMS quality program reporting and VBP scoring.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:committeeFindingsSummary rdf:type rdf:Property ;
    rdfs:label 'Committee Findings Summary' ;
    rdfs:comment 'Narrative summary of the peer review committee\'s findings regarding the mortality case, including clinical assessment, care quality observations, and determination rationale. Protected under peer review privilege in most jurisdictions. Confidential business data.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityProtectionFlag rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Protection Flag' ;
    rdfs:comment 'Indicates whether this mortality review record is protected under state peer review privilege statutes, restricting discoverability in legal proceedings. Critical for legal and compliance governance of peer review documentation.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contributingFactor1 rdf:type rdf:Property ;
    rdfs:label 'Contributing Factor 1' ;
    rdfs:comment 'Primary contributing clinical factor identified by the peer review committee as having contributed to the patient\'s death (e.g., delayed diagnosis, medication error, communication failure, system failure). Supports root cause analysis and quality improvement planning.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributingFactor2 rdf:type rdf:Property ;
    rdfs:label 'Contributing Factor 2' ;
    rdfs:comment 'Secondary contributing clinical factor identified by the peer review committee. Captures additional systemic or clinical issues beyond the primary factor that contributed to the mortality outcome.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributingFactor3 rdf:type rdf:Property ;
    rdfs:label 'Contributing Factor 3' ;
    rdfs:comment 'Tertiary contributing clinical factor identified by the peer review committee. Supports comprehensive root cause analysis when multiple systemic issues are identified.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysFromAdmissionToDeath rdf:type rdf:Property ;
    rdfs:label 'Days From Admission To Death' ;
    rdfs:comment 'Number of days elapsed between the patient\'s admission date and the date of death. Supports Length of Stay (LOS) analysis, early mortality detection (death within 24-48 hours), and CMS mortality outcome measure stratification.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deathClassification rdf:type rdf:Property ;
    rdfs:label 'Death Classification' ;
    rdfs:comment 'Clinical classification of the death as expected (consistent with terminal prognosis or end-of-life care plan) or unexpected (unanticipated given the patient\'s clinical condition). Core field for CMS mortality outcome measures and peer review triage.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deathLocationType rdf:type rdf:Property ;
    rdfs:label 'Death Location Type' ;
    rdfs:comment 'Clinical care setting within the facility where the patient death occurred (e.g., ICU, ED, OR, inpatient unit). Supports unit-level mortality analysis and identification of high-risk care areas. [ENUM-REF-CANDIDATE: inpatient_unit|icu|ed|or|pacu|step_down|other — promote to reference product]' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deathTimestamp rdf:type rdf:Property ;
    rdfs:label 'Death Timestamp' ;
    rdfs:comment 'Precise date and time of patient death as documented in the Electronic Health Record (EHR). Used for time-of-day analysis, shift-level mortality reporting, and clinical event sequencing. PHI under HIPAA.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dnrStatusAtDeath rdf:type rdf:Property ;
    rdfs:label 'Dnr Status At Death' ;
    rdfs:comment 'Patient\'s resuscitation code status at the time of death as documented in the EHR. Informs the expected vs. unexpected death classification and supports advance directive compliance review. Relevant to EMTALA and CMS Patient Rights Conditions of Participation.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:haiRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Hai Related Flag' ;
    rdfs:comment 'Indicates whether a Healthcare-Associated Infection (HAI) — such as CLABSI, CAUTI, or SSI — was identified as a contributing factor to the patient\'s death. Supports HAI mortality linkage reporting to CMS and CDC National Healthcare Safety Network (NHSN).' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:haiType rdf:type rdf:Property ;
    rdfs:label 'Hai Type' ;
    rdfs:comment 'Specific type of Healthcare-Associated Infection (HAI) linked to this mortality case when hai_related_flag is true. Values include CLABSI (Central Line-Associated Bloodstream Infection), CAUTI (Catheter-Associated Urinary Tract Infection), SSI (Surgical Site Infection), C. diff, VAP, MRSA. [ENUM-REF-CANDIDATE: clabsi|cauti|ssi|cdiff|vap|mrsa|other — promote to reference product]' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hospiceEnrolledFlag rdf:type rdf:Property ;
    rdfs:label 'Hospice Enrolled Flag' ;
    rdfs:comment 'Indicates whether the patient was enrolled in a hospice program at the time of or prior to the encounter. Supports expected death classification and CMS hospice quality reporting.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:improvementRecommendation rdf:type rdf:Property ;
    rdfs:label 'Improvement Recommendation' ;
    rdfs:comment 'Narrative description of quality improvement recommendations issued by the peer review committee as a result of this mortality review. Drives performance improvement plans and TJC survey readiness activities. Protected under peer review privilege.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mipsReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Mips Reportable Flag' ;
    rdfs:comment 'Indicates whether this mortality case is reportable under the Merit-Based Incentive Payment System (MIPS) quality performance category for the attending provider. Supports MACRA/MIPS compliance tracking.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:palliativeCareInvolvedFlag rdf:type rdf:Property ;
    rdfs:label 'Palliative Care Involved Flag' ;
    rdfs:comment 'Indicates whether the palliative care team was involved in the patient\'s care during the encounter. Supports expected death classification validation and end-of-life care quality metrics.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preventabilityDetermination rdf:type rdf:Property ;
    rdfs:label 'Preventability Determination' ;
    rdfs:comment 'Peer review committee\'s determination of whether the death was preventable, potentially preventable, not preventable, or indeterminate based on clinical evidence review. Core outcome field for quality improvement and CMS Value-Based Purchasing (VBP) reporting.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCauseOfDeathDescription rdf:type rdf:Property ;
    rdfs:label 'Primary Cause Of Death Description' ;
    rdfs:comment 'Plain-language description of the primary underlying cause of death corresponding to the ICD-10 code. Supports readability in committee reports and regulatory submissions without requiring code lookup.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryIcd10CauseOfDeath rdf:type rdf:Property ;
    rdfs:label 'Primary Icd10 Cause Of Death' ;
    rdfs:comment 'International Classification of Diseases 10th Revision (ICD-10) code representing the primary underlying cause of death as coded by Health Information Management (HIM). Used for mortality statistics, DRG grouping, and CMS quality measure reporting.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readmissionRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Readmission Related Flag' ;
    rdfs:comment 'Indicates whether the patient was readmitted within 30 days of a prior discharge and died during the readmission encounter. Supports CMS Hospital Readmissions Reduction Program (HRRP) mortality linkage analysis.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Review Case Number' ;
    rdfs:comment 'Externally-known alphanumeric case number assigned by the quality department or peer review committee to uniquely identify and track this mortality review case across systems and correspondence.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewTriggerType rdf:type rdf:Property ;
    rdfs:label 'Review Trigger Type' ;
    rdfs:comment 'Criterion or event that triggered the formal mortality review (e.g., unexpected death, post-surgical death, death within 24 hours of admission, Against Medical Advice (AMA) discharge followed by death, readmission death). Determines review pathway and committee assignment. [ENUM-REF-CANDIDATE: unexpected_death|surgical_death|icu_death|ed_death|readmission_death|ama_death|other — promote to reference product]' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sentinelEventFlag rdf:type rdf:Property ;
    rdfs:label 'Sentinel Event Flag' ;
    rdfs:comment 'Indicates whether this mortality case has been classified as a TJC Sentinel Event requiring a formal Root Cause Analysis (RCA) and corrective action plan submission to The Joint Commission.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surgicalCaseFlag rdf:type rdf:Property ;
    rdfs:label 'Surgical Case Flag' ;
    rdfs:comment 'Indicates whether the patient underwent a surgical procedure during the encounter associated with this mortality review. Triggers AHRQ PSI-04 (Death Among Surgical Inpatients) measure inclusion and surgical mortality peer review pathway.' ;
    rdfs:domain ind:MortalityReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vbpProgramId rdf:type rdf:Property ;
    rdfs:label 'Vbp Program Id' ;
    rdfs:comment 'Unique surrogate identifier for a CMS Value-Based Purchasing (VBP) program record. Primary key for this master configuration entity.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:achievementBenchmarkPercentile rdf:type rdf:Property ;
    rdfs:label 'Achievement Benchmark Percentile' ;
    rdfs:comment 'National performance percentile representing the benchmark (top performance) for achievement scoring. Typically set at the 95th percentile of baseline period national performance.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:achievementThresholdPercentile rdf:type rdf:Property ;
    rdfs:label 'Achievement Threshold Percentile' ;
    rdfs:comment 'National performance percentile that a hospital must exceed to earn achievement points for a given measure. Typically set at the 50th percentile of baseline period national performance.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicableProviderType rdf:type rdf:Property ;
    rdfs:label 'Applicable Provider Type' ;
    rdfs:comment 'Type of healthcare provider or facility to which this VBP program configuration applies. Determines eligibility rules, measure sets, and payment adjustment calculations. [ENUM-REF-CANDIDATE: acute_care_hospital|critical_access_hospital|psychiatric_hospital|long_term_care|skilled_nursing_facility|home_health_agency — promote to reference product]' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselinePeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Baseline Period End' ;
    rdfs:comment 'End date of the baseline period used to establish benchmark performance scores for achievement scoring calculations.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:baselinePeriodStart rdf:type rdf:Property ;
    rdfs:label 'Baseline Period Start' ;
    rdfs:comment 'Start date of the baseline period used to establish benchmark performance scores against which the performance period is compared for achievement scoring.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cahpsSurveyVendorRequired rdf:type rdf:Property ;
    rdfs:label 'Cahps Survey Vendor Required' ;
    rdfs:comment 'Indicates whether hospitals must use a CMS-approved CAHPS survey vendor to collect patient experience data for the Person and Community Engagement domain. True for HVBP programs.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalOutcomesDomainWeight rdf:type rdf:Property ;
    rdfs:label 'Clinical Outcomes Domain Weight' ;
    rdfs:comment 'Proportional weight assigned to the Clinical Outcomes domain in the Total Performance Score (TPS) calculation, expressed as a decimal (e.g., 0.25 = 25%). Includes mortality, complications, and readmission measures.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cmsProgramCode rdf:type rdf:Property ;
    rdfs:label 'Cms Program Code' ;
    rdfs:comment 'Official CMS-assigned program identifier used in federal regulatory filings, CMS Quality Reporting systems, and QualityNet submissions. Serves as the external reference key for CMS correspondence.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctionWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Correction Window End' ;
    rdfs:comment 'Deadline by which hospitals must submit data corrections or reconsideration requests following the preview report release. After this date, scores are finalized for payment adjustment calculation.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:efficiencyCostReductionWeight rdf:type rdf:Property ;
    rdfs:label 'Efficiency Cost Reduction Weight' ;
    rdfs:comment 'Proportional weight assigned to the Efficiency and Cost Reduction domain in the TPS calculation, expressed as a decimal (e.g., 0.25 = 25%). Includes Medicare Spending Per Beneficiary (MSPB) measure.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:federalRegisterNotice rdf:type rdf:Property ;
    rdfs:label 'Federal Register Notice' ;
    rdfs:comment 'Federal Register citation (volume, page, and date) for the CMS IPPS Final Rule that established this program year\'s VBP parameters (e.g., \'88 FR 49000, July 31, 2023\'). Supports regulatory audit trail.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalScorePublicationDate rdf:type rdf:Property ;
    rdfs:label 'Final Score Publication Date' ;
    rdfs:comment 'Date on which CMS publicly releases final Total Performance Scores (TPS) and payment adjustment factors for all participating hospitals. Triggers the payment adjustment application in the payment year.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isNewMeasureSet rdf:type rdf:Property ;
    rdfs:label 'Is New Measure Set' ;
    rdfs:comment 'Indicates whether this program year introduces a new or substantially revised measure set compared to the prior fiscal year. Triggers additional staff education, CDI workflow updates, and quality committee review.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxAchievementPoints rdf:type rdf:Property ;
    rdfs:label 'Max Achievement Points' ;
    rdfs:comment 'Maximum number of achievement points a hospital can earn per measure under the VBP scoring methodology (typically 10 points).' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxDomainScore rdf:type rdf:Property ;
    rdfs:label 'Max Domain Score' ;
    rdfs:comment 'Maximum possible score achievable within any single domain before weighting is applied. Used to normalize domain scores to a common scale for TPS calculation.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxImprovementPoints rdf:type rdf:Property ;
    rdfs:label 'Max Improvement Points' ;
    rdfs:comment 'Maximum number of improvement points a hospital can earn per measure under the VBP scoring methodology (typically 9 points).' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxPaymentAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Max Payment Adjustment Factor' ;
    rdfs:comment 'Maximum payment adjustment factor (multiplier) that can be applied to a hospital\'s Medicare IPPS payments under this program year. Values above 1.0000 represent a net payment bonus.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxTps rdf:type rdf:Property ;
    rdfs:label 'Max Tps' ;
    rdfs:comment 'Maximum possible Total Performance Score (TPS) a hospital can achieve under this program year configuration. Defines the upper bound for payment adjustment factor calculations.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measureSetVersion rdf:type rdf:Property ;
    rdfs:label 'Measure Set Version' ;
    rdfs:comment 'Version identifier of the CMS-published measure set applicable to this program year (e.g., \'FY2024-v1.2\'). Tracks changes in included measures, specifications, and exclusion criteria across program years.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minCaseVolumeRequired rdf:type rdf:Property ;
    rdfs:label 'Min Case Volume Required' ;
    rdfs:comment 'Minimum number of eligible cases required for a measure to be scored for a hospital. Measures with case volumes below this threshold are suppressed from scoring to ensure statistical reliability.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minMeasureCountRequired rdf:type rdf:Property ;
    rdfs:label 'Min Measure Count Required' ;
    rdfs:comment 'Minimum number of measures a hospital must have reportable data for in order to receive a domain score and be included in VBP payment adjustment calculations. Hospitals below this threshold are excluded from VBP.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minPaymentAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Min Payment Adjustment Factor' ;
    rdfs:comment 'Minimum payment adjustment factor (multiplier) that can be applied to a hospital\'s Medicare IPPS payments under this program year. Values below 1.0000 represent a net payment reduction.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nqfAlignmentFlag rdf:type rdf:Property ;
    rdfs:label 'Nqf Alignment Flag' ;
    rdfs:comment 'Indicates whether all measures in this program year\'s measure set are endorsed by the National Quality Forum (NQF). NQF endorsement is a CMS requirement for VBP measure inclusion.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentAdjustmentFormula rdf:type rdf:Property ;
    rdfs:label 'Payment Adjustment Formula' ;
    rdfs:comment 'Narrative or coded description of the formula used to translate the Total Performance Score (TPS) into a payment adjustment factor. Documents the linear exchange function parameters published in the CMS IPPS Final Rule.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentYear rdf:type rdf:Property ;
    rdfs:label 'Payment Year' ;
    rdfs:comment 'Federal fiscal year in which the VBP payment adjustment (bonus or penalty) is applied to Medicare IPPS payments. Typically lags the performance period by approximately two years.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:performancePeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Performance Period End' ;
    rdfs:comment 'End date of the performance period during which hospital quality data is collected and measured for VBP scoring.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performancePeriodStart rdf:type rdf:Property ;
    rdfs:label 'Performance Period Start' ;
    rdfs:comment 'Start date of the performance period during which hospital quality data is collected and measured for VBP scoring. Distinct from the baseline period.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:personCommunityEngagementWeight rdf:type rdf:Property ;
    rdfs:label 'Person Community Engagement Weight' ;
    rdfs:comment 'Proportional weight assigned to the Person and Community Engagement domain (formerly Patient Experience / CAHPS) in the TPS calculation, expressed as a decimal (e.g., 0.25 = 25%).' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previewReportReleaseDate rdf:type rdf:Property ;
    rdfs:label 'Preview Report Release Date' ;
    rdfs:comment 'Date on which CMS releases preliminary VBP performance scores to hospitals for review and correction prior to final score publication. Hospitals have a defined review and correction window following this date.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qualitynetProgramCode rdf:type rdf:Property ;
    rdfs:label 'Qualitynet Program Code' ;
    rdfs:comment 'Program code used within the CMS QualityNet reporting portal for data submission, preview reports, and final VBP scoring. Required for electronic data interchange with CMS.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRuleCitation rdf:type rdf:Property ;
    rdfs:label 'Regulatory Rule Citation' ;
    rdfs:comment 'Primary federal regulatory citation governing this VBP program year (e.g., \'42 CFR Part 412 Subpart O\'). Used for compliance documentation, audit support, and regulatory reporting.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyDomainWeight rdf:type rdf:Property ;
    rdfs:label 'Safety Domain Weight' ;
    rdfs:comment 'Proportional weight assigned to the Safety domain in the TPS calculation, expressed as a decimal (e.g., 0.25 = 25%). Includes HAI measures such as CLABSI, CAUTI, SSI, and MRSA.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDomainWeightCheck rdf:type rdf:Property ;
    rdfs:label 'Total Domain Weight Check' ;
    rdfs:comment 'Sum of all four domain weights (clinical outcomes + person and community engagement + safety + efficiency and cost reduction). Must equal 1.0000 (100%) for a valid program configuration. Used for data quality validation and audit.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tpsMethodology rdf:type rdf:Property ;
    rdfs:label 'Tps Methodology' ;
    rdfs:comment 'Scoring methodology used to calculate the Total Performance Score (TPS). \'achievement_improvement_higher\' selects the higher of achievement or improvement scores per measure; \'achievement_only\' uses only achievement; \'improvement_only\' uses only improvement.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withholdRate rdf:type rdf:Property ;
    rdfs:label 'Withhold Rate' ;
    rdfs:comment 'Percentage of Medicare IPPS base operating DRG payments withheld from all participating hospitals to fund the VBP incentive pool, expressed as a decimal (e.g., 0.0200 = 2.0%). Established annually by CMS per ACA mandate.' ;
    rdfs:domain ind:VbpProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measureId rdf:type rdf:Property ;
    rdfs:label 'Measure Id' ;
    rdfs:comment 'Primary key for measure' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Measure .

ind:benchmarkPercentile rdf:type rdf:Property ;
    rdfs:label 'Benchmark Percentile' ;
    rdfs:comment 'National percentile rank corresponding to the benchmark threshold (e.g., 75.00 for the 75th percentile). Used to contextualize organizational performance against national peer comparisons in VBP and MIPS scoring.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkThreshold rdf:type rdf:Property ;
    rdfs:label 'Benchmark Threshold' ;
    rdfs:comment 'National or program-defined benchmark performance rate (expressed as a percentage, 0.00–100.00) that the organization targets or must meet for this measure (e.g., 75.00 for 75%). Used in Value-Based Purchasing (VBP) and MIPS scoring.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clinicalDomain rdf:type rdf:Property ;
    rdfs:label 'Clinical Domain' ;
    rdfs:comment 'Clinical or programmatic domain the measure belongs to (e.g., Cardiovascular, Diabetes, Infection Control, Maternal Health, Behavioral Health, Patient Safety, Preventive Care). Used for grouping and filtering in quality dashboards. [ENUM-REF-CANDIDATE: cardiovascular|diabetes|infection_control|maternal_health|behavioral_health|patient_safety|preventive_care|oncology|respiratory|orthopedics — promote to reference product]' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsEcqmCode rdf:type rdf:Property ;
    rdfs:label 'Cms Ecqm Code' ;
    rdfs:comment 'CMS-assigned electronic Clinical Quality Measure (eCQM) identifier (e.g., CMS122v11). Used for electronic submission to CMS quality reporting programs including MIPS and IQR.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cptCodeSet rdf:type rdf:Property ;
    rdfs:label 'Cpt Code Set' ;
    rdfs:comment 'Comma-separated list or value set reference of CPT procedure codes used in the measure logic (e.g., qualifying visit codes, procedure codes for numerator events). References the official value set OID where applicable.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denominatorException rdf:type rdf:Property ;
    rdfs:label 'Denominator Exception' ;
    rdfs:comment 'Criteria allowing removal of patients from the denominator for clinical or patient-choice reasons that do not constitute exclusions (e.g., \'Patient declined vaccination — documented medical reason\'). Distinct from exclusions; applies to process measures only.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denominatorExclusion rdf:type rdf:Property ;
    rdfs:label 'Denominator Exclusion' ;
    rdfs:comment 'Criteria for excluding patients or encounters from the denominator (e.g., \'Patients with documented allergy to influenza vaccine\'). Null if no exclusions apply. Critical for accurate measure calculation.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligiblePopulationCriteria rdf:type rdf:Property ;
    rdfs:label 'Eligible Population Criteria' ;
    rdfs:comment 'Initial patient population criteria defining who is eligible to be included in the measure calculation (age range, diagnosis codes, encounter types, payer types, etc.). Serves as the outermost filter before denominator logic is applied.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floorThreshold rdf:type rdf:Property ;
    rdfs:label 'Floor Threshold' ;
    rdfs:comment 'Minimum acceptable performance rate (as a percentage) below which the organization is subject to payment penalties or accreditation risk. Distinct from the benchmark target; represents the regulatory floor.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:haiCategory rdf:type rdf:Property ;
    rdfs:label 'Hai Category' ;
    rdfs:comment 'For HAI-related measures, identifies the specific infection type tracked: CLABSI (Central Line-Associated Bloodstream Infection), CAUTI (Catheter-Associated Urinary Tract Infection), SSI (Surgical Site Infection), MRSA, CDI (C. difficile), VAE (Ventilator-Associated Event), or NONE for non-HAI measures. [ENUM-REF-CANDIDATE: CLABSI|CAUTI|SSI|MRSA|CDI|VAE|NONE — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:higherIsBetter rdf:type rdf:Property ;
    rdfs:label 'Higher Is Better' ;
    rdfs:comment 'Indicates whether a higher measure rate represents better performance (True) or worse performance (False). For example, vaccination rates are higher-is-better; readmission rates are lower-is-better. Critical for correct performance scoring logic.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:icd10CodeSet rdf:type rdf:Property ;
    rdfs:label 'Icd10 Code Set' ;
    rdfs:comment 'Comma-separated list or value set reference of ICD-10 diagnosis codes used in the measure\'s eligible population, numerator, or denominator logic (e.g., \'E11.9, E11.65\'). References the official value set OID where applicable.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loincCodeSet rdf:type rdf:Property ;
    rdfs:label 'Loinc Code Set' ;
    rdfs:comment 'Comma-separated list or value set reference of LOINC codes used in the measure logic for laboratory results, clinical observations, or survey instruments (e.g., HbA1c result codes for diabetes measures).' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementMethodology rdf:type rdf:Property ;
    rdfs:label 'Measurement Methodology' ;
    rdfs:comment 'Data collection and calculation methodology used for the measure: administrative (claims/ADT data), hybrid (claims + chart review), chart_abstracted (manual chart review), ecqm (electronic clinical quality measure via EHR), survey (patient-reported, e.g., CAHPS), or registry.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumSampleSize rdf:type rdf:Property ;
    rdfs:label 'Minimum Sample Size' ;
    rdfs:comment 'Minimum number of eligible patients or encounters required for the measure result to be reportable and statistically valid. Results below this threshold are typically suppressed in public reporting.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mipsCategory rdf:type rdf:Property ;
    rdfs:label 'Mips Category' ;
    rdfs:comment 'MIPS performance category to which this measure contributes: quality, promoting_interoperability, improvement_activities, cost, or NONE if not applicable to MIPS. Supports MACRA/MIPS composite score calculation for eligible clinicians.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nqfNumber rdf:type rdf:Property ;
    rdfs:label 'Nqf Number' ;
    rdfs:comment 'National Quality Forum (NQF) endorsement number assigned to the measure (e.g., NQF-0028). Null if the measure is not NQF-endorsed. Used for regulatory alignment and cross-program mapping.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingProgram rdf:type rdf:Property ;
    rdfs:label 'Reporting Program' ;
    rdfs:comment 'Name of the regulatory or accreditation program under which this measure is reported (e.g., CMS IQR, CMS OQR, VBP, MIPS, HEDIS, TJC ORYX, State Medicaid, Internal). A measure may belong to multiple programs; this field captures the primary program. [ENUM-REF-CANDIDATE: CMS_IQR|CMS_OQR|VBP|MIPS|APM|HEDIS|TJC_ORYX|STATE|INTERNAL|PCMH — promote to reference product]' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAdjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Flag' ;
    rdfs:comment 'Indicates whether the measure requires risk adjustment to account for patient case mix before performance comparison (True = risk-adjusted). Applies to outcome measures such as mortality and readmission rates.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:snomedCodeSet rdf:type rdf:Property ;
    rdfs:label 'Snomed Code Set' ;
    rdfs:comment 'Comma-separated list or value set reference of SNOMED CT codes used in the measure logic for clinical findings, conditions, or procedures. Supports eCQM value set alignment.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specificationUrl rdf:type rdf:Property ;
    rdfs:label 'Specification Url' ;
    rdfs:comment 'URL link to the official published measure specification document or web page maintained by the measure steward (e.g., CMS eCQM library URL, NCQA HEDIS specification page). Enables direct reference to authoritative source.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:steward rdf:type rdf:Property ;
    rdfs:label 'Steward' ;
    rdfs:comment 'Organization responsible for developing, maintaining, and publishing the measure specification (e.g., CMS, NCQA, TJC, NQF, AMA). Determines the authoritative source for measure updates and versioning. [ENUM-REF-CANDIDATE: CMS|NCQA|TJC|NQF|AMA|AHRQ|STATE|INTERNAL|OTHER — promote to reference product]' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDeadline rdf:type rdf:Property ;
    rdfs:label 'Submission Deadline' ;
    rdfs:comment 'Date by which the measure results must be submitted to the applicable regulatory or accreditation body (e.g., CMS IQR submission deadline). Drives quality reporting workflow and compliance tracking.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tjcMeasureSet rdf:type rdf:Property ;
    rdfs:label 'Tjc Measure Set' ;
    rdfs:comment 'Name of The Joint Commission (TJC) ORYX measure set this measure belongs to (e.g., \'Perinatal Care\', \'Stroke\', \'Venous Thromboembolism\'). Null if not a TJC measure. Supports TJC accreditation survey readiness.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vbpDomain rdf:type rdf:Property ;
    rdfs:label 'Vbp Domain' ;
    rdfs:comment 'CMS Hospital Value-Based Purchasing (VBP) program domain to which this measure is assigned: clinical_care, safety, efficiency (cost reduction), patient_experience (CAHPS), or NONE if not part of VBP. Drives VBP Total Performance Score calculation.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataCompletenessRate rdf:type rdf:Property ;
    rdfs:label 'Data Completeness Rate' ;
    rdfs:comment 'The proportion of eligible cases for which complete data was available for measure calculation. CMS requires a minimum data completeness threshold (typically 75%) for measure results to be publicly reported.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gapToTargetRate rdf:type rdf:Property ;
    rdfs:label 'Gap To Target Rate' ;
    rdfs:comment 'The arithmetic difference between the target_rate and the actual performance_rate (target_rate minus performance_rate). Positive values indicate underperformance; negative values indicate the target has been exceeded.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedisMethodologyIndicator rdf:type rdf:Property ;
    rdfs:label 'Hedis Methodology Indicator' ;
    rdfs:comment 'For HEDIS measures, specifies whether the administrative or hybrid methodology was used for this result. The hybrid methodology supplements administrative data with medical record review to improve accuracy. Not applicable for non-HEDIS measures.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPubliclyReported rdf:type rdf:Property ;
    rdfs:label 'Is Publicly Reported' ;
    rdfs:comment 'Indicates whether this measure result has been or is eligible to be publicly reported on CMS Care Compare, NCQA Health Plan Ratings, or other public transparency platforms.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measureDomain rdf:type rdf:Property ;
    rdfs:label 'Measure Domain' ;
    rdfs:comment 'The clinical or operational domain to which the measure belongs (e.g., Patient Safety, Effectiveness of Care, Efficiency, Patient Experience, Care Coordination). [ENUM-REF-CANDIDATE: patient_safety|effectiveness|efficiency|patient_experience|care_coordination|timeliness|equity — promote to reference product]' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementLevel rdf:type rdf:Property ;
    rdfs:label 'Measurement Level' ;
    rdfs:comment 'The organizational level at which this measure result is reported (facility, unit, provider, health plan, or population). Determines the granularity of the performance result.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meetsReportingThreshold rdf:type rdf:Property ;
    rdfs:label 'Meets Reporting Threshold' ;
    rdfs:comment 'Indicates whether this measure result meets the minimum case volume and data completeness thresholds required for public reporting by CMS or the applicable program. Results not meeting thresholds are suppressed from public display.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mipsMeasureCategory rdf:type rdf:Property ;
    rdfs:label 'Mips Measure Category' ;
    rdfs:comment 'For MIPS-reported measures, the performance category under which this measure is reported (Quality, Promoting Interoperability, Improvement Activities, or Cost). Null for non-MIPS measures.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mipsPointsEarned rdf:type rdf:Property ;
    rdfs:label 'Mips Points Earned' ;
    rdfs:comment 'The number of MIPS performance points earned for this measure in the reporting period, used to calculate the composite MIPS performance score. Null for non-MIPS measures.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ncqaSubmissionStatus rdf:type rdf:Property ;
    rdfs:label 'Ncqa Submission Status' ;
    rdfs:comment 'The submission status of this measure result to the National Committee for Quality Assurance (NCQA) for HEDIS reporting and health plan accreditation purposes. Null for non-HEDIS measures.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerSubmissionStatus rdf:type rdf:Property ;
    rdfs:label 'Payer Submission Status' ;
    rdfs:comment 'The submission status of this measure result to the applicable health plan or payer (e.g., commercial payer, Medicaid managed care organization). Tracks whether the result has been transmitted and acknowledged.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:percentileRank rdf:type rdf:Property ;
    rdfs:label 'Percentile Rank' ;
    rdfs:comment 'The percentile rank of this facility\'s or provider\'s performance rate relative to national or peer benchmarks for this measure (e.g., 75.00 = 75th percentile nationally).' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resultCalculatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Result Calculated Timestamp' ;
    rdfs:comment 'The date and time when this quality measure result was calculated or generated by the analytics or quality measurement system.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sirValue rdf:type rdf:Property ;
    rdfs:label 'Sir Value' ;
    rdfs:comment 'The Standardized Infection Ratio (SIR) for HAI measures, calculated as observed infections divided by predicted infections based on national baseline data. A SIR below 1.0 indicates better-than-expected performance. Null for non-HAI measures.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetRate rdf:type rdf:Property ;
    rdfs:label 'Target Rate' ;
    rdfs:comment 'The internally established or externally mandated performance target rate for this measure in the given reporting period (e.g., organizational goal of 0.9000 for 90% compliance).' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vbpAchievementScore rdf:type rdf:Property ;
    rdfs:label 'Vbp Achievement Score' ;
    rdfs:comment 'The CMS VBP domain-level achievement score for this measure, reflecting performance relative to national achievement thresholds and benchmarks. Null for non-VBP measures.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vbpImprovementScore rdf:type rdf:Property ;
    rdfs:label 'Vbp Improvement Score' ;
    rdfs:comment 'The CMS VBP domain-level improvement score for this measure, reflecting performance improvement relative to the facility\'s own baseline performance. Null for non-VBP measures.' ;
    rdfs:domain ind:MeasureResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cdiReviewId rdf:type rdf:Property ;
    rdfs:label 'Cdi Review Id' ;
    rdfs:comment 'Unique surrogate identifier for each CDI concurrent or retrospective chart review record. Primary key for the cdi_review data product.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:workingDrgId rdf:type rdf:Property ;
    rdfs:label 'Working Drg Id' ;
    rdfs:comment 'Foreign key linking to reference.drg. Business justification: CDI reviews evaluate working DRG assignments during concurrent review to identify documentation improvement opportunities. CDI specialists must reference DRG definitions, relative weights, and CC/MCC ' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Drg .

ind:ccMccOpportunityFlag rdf:type rdf:Property ;
    rdfs:label 'Cc Mcc Opportunity Flag' ;
    rdfs:comment 'Indicates whether the CDI reviewer identified a potential CC or MCC capture opportunity requiring physician query or documentation clarification.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalIndicatorSummary rdf:type rdf:Property ;
    rdfs:label 'Clinical Indicator Summary' ;
    rdfs:comment 'Free-text summary of the clinical indicators identified in the medical record that support the CDI review finding or physician query. Documents the clinical basis for the query per AHIMA/ACDIS compliant query guidelines.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmiImpact rdf:type rdf:Property ;
    rdfs:label 'Cmi Impact' ;
    rdfs:comment 'Calculated difference in DRG relative weight between the working DRG and the potential or final DRG resulting from CDI review activity. Quantifies the CMI optimization contribution of this review.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:documentationImpact rdf:type rdf:Property ;
    rdfs:label 'Documentation Impact' ;
    rdfs:comment 'Category of documentation improvement resulting from the CDI review and query: DRG change, CC/MCC capture, POA status change, or no impact. Used for CDI program ROI and quality reporting.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Drg Change Flag' ;
    rdfs:comment 'Indicates whether the CDI review and associated query activity resulted in a change to the DRG assignment. Key CDI program outcome metric.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:queryInitiatedFlag rdf:type rdf:Property ;
    rdfs:label 'Query Initiated Flag' ;
    rdfs:comment 'Indicates whether a physician query was initiated as a result of this CDI review. Used to calculate query rate and CDI program activity metrics.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:queryMethod rdf:type rdf:Property ;
    rdfs:label 'Query Method' ;
    rdfs:comment 'Method by which the physician query was communicated: verbal, written paper-based, or electronic (e.g., via Epic In-Basket or Cerner PowerChart message). Supports CDI workflow analysis and compliance documentation.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewCompletionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Review Completion Timestamp' ;
    rdfs:comment 'Date and time the CDI review was marked complete. Used to calculate review turnaround time and CDI specialist productivity.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reviewFindingType rdf:type rdf:Property ;
    rdfs:label 'Review Finding Type' ;
    rdfs:comment 'Classification of the CDI reviewer\'s primary finding from the chart review. Drives query initiation workflow and CDI program productivity reporting.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewLagDays rdf:type rdf:Property ;
    rdfs:label 'Review Lag Days' ;
    rdfs:comment 'Number of days elapsed between the patient admission date and the date of this CDI review. Used to measure concurrent review timeliness; a key CDI program performance indicator.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewerCredential rdf:type rdf:Property ;
    rdfs:label 'Reviewer Credential' ;
    rdfs:comment 'Professional credential of the CDI reviewer performing the review (e.g., CCDS, CDIP, RN, MD). Used for CDI program staffing analytics and credential-based productivity reporting.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceReviewReference rdf:type rdf:Property ;
    rdfs:label 'Source Review Reference' ;
    rdfs:comment 'Native identifier of the CDI review record in the originating operational system (e.g., 3M CDI internal review ID, Epic CDI activity ID). Supports cross-system traceability and ETL reconciliation.' ;
    rdfs:domain ind:CdiReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationCoordinatorName rdf:type rdf:Property ;
    rdfs:label 'Accreditation Coordinator Name' ;
    rdfs:comment 'Name of the internal staff member or manager responsible for coordinating the accreditation program, managing survey logistics, and tracking compliance activities.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationCycleYears rdf:type rdf:Property ;
    rdfs:label 'Accreditation Cycle Years' ;
    rdfs:comment 'The standard duration in years of the accreditation cycle for this program (e.g., 3 years for TJC hospital accreditation, 2 years for some disease-specific certifications). Drives renewal scheduling and survey planning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cmsAcceptanceStatus rdf:type rdf:Property ;
    rdfs:label 'Cms Acceptance Status' ;
    rdfs:comment 'Status of CMS review and acceptance of the submitted Plan of Correction. \'accepted\' = CMS approved the PoC; \'rejected\' = CMS rejected and requires revision; \'pending\' = under CMS review; \'not_applicable\' = no CMS PoC required for this program.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complaintSurveyIndicator rdf:type rdf:Property ;
    rdfs:label 'Complaint Survey Indicator' ;
    rdfs:comment 'Indicates whether the most recent survey was triggered by a complaint or adverse event report filed with the accrediting body or CMS. True = complaint-triggered survey; False = routine or scheduled survey.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionLevelDeficiencyCount rdf:type rdf:Property ;
    rdfs:label 'Condition Level Deficiency Count' ;
    rdfs:comment 'Number of findings classified as Condition-Level Deficiencies (CLDs) identified during the survey. Condition-level deficiencies indicate substantial non-compliance with a CMS Condition of Participation and require a Plan of Correction.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deemedStatus rdf:type rdf:Property ;
    rdfs:label 'Deemed Status' ;
    rdfs:comment 'Indicates whether the organization holds CMS Deemed Status through this accreditation program, meaning the accrediting body\'s standards are recognized by CMS as meeting or exceeding CMS Conditions of Participation. True = deemed status granted; False = not deemed.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:findingComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Finding Compliance Status' ;
    rdfs:comment 'Current compliance status of the primary finding from the most recent survey. Tracks whether the organization has achieved compliance with the cited standard or condition.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingEvidence rdf:type rdf:Property ;
    rdfs:label 'Finding Evidence' ;
    rdfs:comment 'Narrative description of the evidence observed or documented by surveyors that supports the primary finding or deficiency citation. Used for Plan of Correction development and compliance tracking.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Finding Resolution Date' ;
    rdfs:comment 'The date on which the primary accreditation finding was resolved and verified as compliant by the accrediting body or internal quality team.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:findingResolutionStatus rdf:type rdf:Property ;
    rdfs:label 'Finding Resolution Status' ;
    rdfs:comment 'Current resolution status of the primary accreditation finding. Tracks the lifecycle from identification through corrective action to verified closure.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingStandardReference rdf:type rdf:Property ;
    rdfs:label 'Finding Standard Reference' ;
    rdfs:comment 'The specific accreditation standard, National Patient Safety Goal (NPSG), CMS Condition of Participation (CoP) condition, or state regulation citation associated with the primary or most significant finding from the survey (e.g., \'TJC NPSG.07.01.01\', \'CMS CoP 482.13\', \'State Health Code §405.1\'). For multi-finding surveys, this captures the lead citation.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:immediateThreatCount rdf:type rdf:Property ;
    rdfs:label 'Immediate Threat Count' ;
    rdfs:comment 'Number of findings classified as Immediate Threat to Health and Safety (ITHS) identified during the survey. These are the most severe findings requiring immediate corrective action and may trigger CMS termination proceedings.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isCmsCopApplicable rdf:type rdf:Property ;
    rdfs:label 'Is Cms Cop Applicable' ;
    rdfs:comment 'Indicates whether CMS Conditions of Participation apply to this accreditation program. True = CMS CoP requirements govern this program; False = program is not subject to CMS CoP (e.g., voluntary certification programs).' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastCmsValidationDate rdf:type rdf:Property ;
    rdfs:label 'Last Cms Validation Date' ;
    rdfs:comment 'Date of the most recent CMS validation survey conducted to verify that the accrediting body\'s survey process meets CMS standards for deemed status programs. CMS conducts validation surveys on a sample of accredited organizations.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextSurveyDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Survey Due Date' ;
    rdfs:comment 'The projected or scheduled date by which the next accreditation survey must occur to maintain continuous accreditation. Calculated from the accreditation cycle and effective date. Used for survey readiness planning.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planOfCorrection rdf:type rdf:Property ;
    rdfs:label 'Plan Of Correction' ;
    rdfs:comment 'Narrative description of the organization\'s Plan of Correction (PoC) submitted to the accrediting body or CMS in response to identified findings or deficiencies. Describes corrective actions, responsible parties, and timelines.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programNumber rdf:type rdf:Property ;
    rdfs:label 'Program Number' ;
    rdfs:comment 'Externally assigned or internally tracked unique program identifier issued by the accrediting body (e.g., TJC organization ID, CMS certification number, NCQA organization ID). Used for cross-referencing with accrediting body portals and regulatory submissions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readinessAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Readiness Assessment Date' ;
    rdfs:comment 'The date of the most recent internal mock survey, readiness tracer, or formal readiness assessment conducted in preparation for the accreditation survey. Supports TJC survey readiness and continuous compliance programs.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:readinessScore rdf:type rdf:Property ;
    rdfs:label 'Readiness Score' ;
    rdfs:comment 'Numeric score (0.00–100.00) from the most recent internal readiness assessment or mock survey, representing the organization\'s estimated compliance percentage with accreditation standards. Used for gap analysis and improvement prioritization.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryBodyContact rdf:type rdf:Property ;
    rdfs:label 'Regulatory Body Contact' ;
    rdfs:comment 'Name and contact information for the primary liaison or account representative at the accrediting body (e.g., TJC account executive, CMS regional office contact). Used for survey coordination and issue escalation.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardLevelDeficiencyCount rdf:type rdf:Property ;
    rdfs:label 'Standard Level Deficiency Count' ;
    rdfs:comment 'Number of findings classified as Standard-Level Deficiencies identified during the survey. These represent non-compliance at the individual standard level within a Condition of Participation.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standardsChaptersReviewed rdf:type rdf:Property ;
    rdfs:label 'Standards Chapters Reviewed' ;
    rdfs:comment 'Comma-separated list or description of the accreditation standards chapters or domains reviewed during the survey (e.g., NPSG, EC, IC, HR, LD, MM, PC, RC, RI, TS for TJC; or CMS CoP conditions reviewed). Supports gap analysis and compliance tracking.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateSurveyAgency rdf:type rdf:Property ;
    rdfs:label 'State Survey Agency' ;
    rdfs:comment 'Name of the state survey agency responsible for conducting CMS validation surveys or state licensure surveys for this program (e.g., state department of health). Required for CMS deemed status programs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyEndDate rdf:type rdf:Property ;
    rdfs:label 'Survey End Date' ;
    rdfs:comment 'The date on which the most recent accreditation survey concluded. For single-day surveys, this equals survey_date. Used to calculate survey duration and schedule post-survey activities.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyScope rdf:type rdf:Property ;
    rdfs:label 'Survey Scope' ;
    rdfs:comment 'Description of the scope of the survey including methodology applied (e.g., tracer methodology, environment of care review, life safety code survey, full organization survey, focused standards review). Free-text or structured description of areas covered.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyorTeam rdf:type rdf:Property ;
    rdfs:label 'Surveyor Team' ;
    rdfs:comment 'Names or identifiers of the surveyors assigned to conduct the accreditation survey. May include lead surveyor and team members from the accrediting body.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Total Findings Count' ;
    rdfs:comment 'Total number of accreditation findings, deficiencies, or Requirements for Improvement (RFIs) identified during the most recent survey. Used for benchmarking, trend analysis, and quality improvement prioritization.' ;
    rdfs:domain ind:AccreditationProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accreditationDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Accreditation Decision Date' ;
    rdfs:comment 'Date on which the accrediting body issued the official accreditation decision. Used to track decision timelines and accreditation cycle management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accreditationStandardsEdition rdf:type rdf:Property ;
    rdfs:label 'Accreditation Standards Edition' ;
    rdfs:comment 'Version or edition year of the accreditation standards manual applied during this survey (e.g., TJC Comprehensive Accreditation Manual for Hospitals 2024 edition). Ensures findings are evaluated against the correct standards version.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionLevelDeficiency rdf:type rdf:Property ;
    rdfs:label 'Condition Level Deficiency' ;
    rdfs:comment 'Indicates whether any Condition-Level deficiency (as opposed to Standard-Level) was cited during a CMS survey. Condition-Level deficiencies represent systemic non-compliance with a Condition of Participation and carry the most severe regulatory consequences.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:copDeficienciesCited rdf:type rdf:Property ;
    rdfs:label 'Cop Deficiencies Cited' ;
    rdfs:comment 'Number of CMS Conditions of Participation (CoP) deficiencies cited during the survey. CoP deficiencies are the most serious CMS findings and may jeopardize Medicare and Medicaid participation if not corrected.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveActionPlanStatus rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Status' ;
    rdfs:comment 'Current status of the facility\'s Corrective Action Plan (CAP) or Plan of Correction (PoC) developed in response to survey findings. Tracks whether corrective actions are required, in progress, submitted to the accrediting body, accepted, or overdue.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentOfCareIncluded rdf:type rdf:Property ;
    rdfs:label 'Environment Of Care Included' ;
    rdfs:comment 'Indicates whether the Environment of Care (EC) standards chapter was included in the scope of this survey, covering safety management, security, hazardous materials, fire safety, medical equipment, and utilities.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escAcceptanceStatus rdf:type rdf:Property ;
    rdfs:label 'Esc Acceptance Status' ;
    rdfs:comment 'Status of the accrediting body\'s review of the submitted Evidence of Standards Compliance (ESC). Indicates whether the corrective action evidence was accepted, rejected, partially accepted, or is still pending review.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Esc Submission Date' ;
    rdfs:comment 'Actual date on which the facility submitted its Evidence of Standards Compliance (ESC) to the accrediting body. Compared against the due date to assess timeliness of corrective action response.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escSubmissionDueDate rdf:type rdf:Property ;
    rdfs:label 'Esc Submission Due Date' ;
    rdfs:comment 'Deadline by which the facility must submit its Evidence of Standards Compliance (ESC) to the accrediting body addressing all Requirements for Improvement (RFI) identified during the survey.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:findingsCountImmediateThreat rdf:type rdf:Property ;
    rdfs:label 'Findings Count Immediate Threat' ;
    rdfs:comment 'Number of findings classified at the highest priority level representing an Immediate Threat to Health or Safety (ITHS). These require urgent corrective action and may trigger conditional accreditation or denial.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsCountObservation rdf:type rdf:Property ;
    rdfs:label 'Findings Count Observation' ;
    rdfs:comment 'Number of lower-priority findings or observations noted during the survey that do not rise to the level of a formal Requirement for Improvement but are documented for quality improvement awareness.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsCountRequirementImprovement rdf:type rdf:Property ;
    rdfs:label 'Findings Count Requirement Improvement' ;
    rdfs:comment 'Number of findings classified as Requirements for Improvement (RFI) — standards elements that were not fully compliant but do not represent an immediate threat. Must be addressed in the Evidence of Standards Compliance (ESC) submission.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsCountTotal rdf:type rdf:Property ;
    rdfs:label 'Findings Count Total' ;
    rdfs:comment 'Total number of all findings across all priority levels identified during the survey. Equals the sum of immediate threat, requirement for improvement, and observation findings.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:followUpSurveyRequired rdf:type rdf:Property ;
    rdfs:label 'Follow Up Survey Required' ;
    rdfs:comment 'Indicates whether the accrediting body has required a follow-up or revisit survey to verify correction of findings. Typically triggered by Immediate Threat to Health or Safety findings or Condition-Level CMS deficiencies.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:infectionPreventionIncluded rdf:type rdf:Property ;
    rdfs:label 'Infection Prevention Included' ;
    rdfs:comment 'Indicates whether Infection Prevention and Control (IC) standards were included in the survey scope. Relevant for tracking Healthcare-Associated Infection (HAI) compliance including CLABSI, CAUTI, and SSI prevention standards.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isUnannounced rdf:type rdf:Property ;
    rdfs:label 'Is Unannounced' ;
    rdfs:comment 'Indicates whether this survey was conducted without prior notification to the facility. Unannounced surveys are standard for TJC triennial surveys and all CMS surveys, providing an unfiltered view of day-to-day operations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leadSurveyorName rdf:type rdf:Property ;
    rdfs:label 'Lead Surveyor Name' ;
    rdfs:comment 'Full name of the primary surveyor or lead assessor assigned by the accrediting body or internal quality team to conduct this survey. Used for accountability and follow-up communications.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lifeSafetyModuleIncluded rdf:type rdf:Property ;
    rdfs:label 'Life Safety Module Included' ;
    rdfs:comment 'Indicates whether the Life Safety Code (LSC) module was included in the scope of this survey. TJC surveys may include a dedicated Life Safety specialist reviewing NFPA 101 compliance.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nationalPatientSafetyGoalsReviewed rdf:type rdf:Property ;
    rdfs:label 'National Patient Safety Goals Reviewed' ;
    rdfs:comment 'Indicates whether the TJC National Patient Safety Goals (NPSG) were specifically reviewed during this survey. NPSGs address critical safety areas including patient identification, medication safety, infection prevention, and fall reduction.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextSurveyTargetDate rdf:type rdf:Property ;
    rdfs:label 'Next Survey Target Date' ;
    rdfs:comment 'Projected or scheduled date for the next accreditation survey cycle. Used for continuous survey readiness planning and resource allocation.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overallReadinessScore rdf:type rdf:Property ;
    rdfs:label 'Overall Readiness Score' ;
    rdfs:comment 'Numeric score (typically expressed as a percentage 0.00–100.00) representing the facility\'s overall compliance or readiness level as assessed during the survey. For internal mock surveys, this reflects the percentage of standards elements found compliant.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preliminaryFindingsSummary rdf:type rdf:Property ;
    rdfs:label 'Preliminary Findings Summary' ;
    rdfs:comment 'Narrative summary of preliminary findings communicated to facility leadership at the survey exit conference before the formal report is issued. Captures key themes, high-priority concerns, and commendations noted by surveyors.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyDurationDays rdf:type rdf:Property ;
    rdfs:label 'Survey Duration Days' ;
    rdfs:comment 'Total number of calendar days the survey spanned from start to end date. Used for resource planning and benchmarking survey scope.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveyNumber rdf:type rdf:Property ;
    rdfs:label 'Survey Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned by the accrediting body or internal quality department to uniquely reference this survey event (e.g., TJC survey tracking number, CMS survey ID, or internal mock survey reference number).' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyReportReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Survey Report Received Date' ;
    rdfs:comment 'Date on which the facility received the official written survey report from the accrediting body. Triggers the formal corrective action response timeline.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyStartDate rdf:type rdf:Property ;
    rdfs:label 'Survey Start Date' ;
    rdfs:comment 'The date on which the on-site survey or assessment officially commenced. For unannounced surveys, this is the date surveyors arrived on-site.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyorTeamComposition rdf:type rdf:Property ;
    rdfs:label 'Surveyor Team Composition' ;
    rdfs:comment 'Description of the full surveyor or assessor team including roles and specialties (e.g., physician surveyor, nurse surveyor, life safety specialist, behavioral health surveyor). Captures team size and expertise mix for survey context.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemTracerTopics rdf:type rdf:Property ;
    rdfs:label 'System Tracer Topics' ;
    rdfs:comment 'Comma-delimited list of system tracer topics evaluated during the survey (e.g., Medication Management, Infection Control, Data Use, Emergency Management). System tracers evaluate organization-wide processes rather than individual patient care.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tjcOrganizationCode rdf:type rdf:Property ;
    rdfs:label 'Tjc Organization Code' ;
    rdfs:comment 'Unique identifier assigned by The Joint Commission to the healthcare organization in the TJC Connect portal. Used to cross-reference survey records with TJC\'s accreditation management system.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tracerMethodologyUsed rdf:type rdf:Property ;
    rdfs:label 'Tracer Methodology Used' ;
    rdfs:comment 'Indicates whether the TJC tracer methodology was employed during this survey, where surveyors follow individual patient care experiences across departments and care transitions to evaluate standards compliance in real-world context.' ;
    rdfs:domain ind:AccreditationSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:standardFindingId rdf:type rdf:Property ;
    rdfs:label 'Standard Finding Id' ;
    rdfs:comment 'Unique surrogate identifier for each compliance finding record. Primary key for the standard_finding data product in the quality domain.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StandardFinding .

ind:interfaceDowntimeId rdf:type rdf:Property ;
    rdfs:label 'Interface Downtime Id' ;
    rdfs:comment 'Foreign key linking to interoperability.interface_downtime. Business justification: Accreditation findings related to data exchange failures (e.g., missed lab results, delayed ADT notifications) need to reference specific downtime events as root cause. This link supports evidence-bas' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InterfaceDowntime .

ind:priorFindingStandardFindingId rdf:type rdf:Property ;
    rdfs:label 'Prior Finding Standard Finding Id' ;
    rdfs:comment 'Reference to the previous standard_finding record for the same standard citation at this facility, when repeat_finding is true. Enables lineage tracking of recurring deficiencies.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StandardFinding .

ind:affectedDepartment rdf:type rdf:Property ;
    rdfs:label 'Affected Department' ;
    rdfs:comment 'The clinical or operational department, unit, or service line within the facility where the deficiency was identified (e.g., ICU, Emergency Department, Pharmacy, Operating Room). Supports departmental accountability tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsAcceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Cms Acceptance Date' ;
    rdfs:comment 'The date on which CMS or the State Survey Agency formally accepted the Plan of Correction (POC) for this finding.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceDueDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Due Date' ;
    rdfs:comment 'The date by which the facility must achieve full compliance with the cited standard and complete all corrective actions. May differ from the POC submission due date.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionOwner rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Owner' ;
    rdfs:comment 'Name or role title of the individual or department accountable for executing and completing the corrective actions specified in the Plan of Correction.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyTagNumber rdf:type rdf:Property ;
    rdfs:label 'Deficiency Tag Number' ;
    rdfs:comment 'The CMS deficiency tag number (e.g., F-Tag for long-term care, K-Tag for life safety code) associated with this finding. Provides standardized cross-reference to the CMS regulatory citation database.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:elementOfPerformance rdf:type rdf:Property ;
    rdfs:label 'Element Of Performance' ;
    rdfs:comment 'The specific Element of Performance (EP) within a TJC standard, or the equivalent sub-requirement within a CMS Condition of Participation, that was cited as deficient. Granular citation enabling targeted corrective action.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementAction rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action' ;
    rdfs:comment 'The regulatory enforcement remedy imposed as a result of this finding, if applicable (e.g., Civil Monetary Penalty, Denial of Payment for New Admissions, Temporary Management, Termination from Medicare/Medicaid). [ENUM-REF-CANDIDATE: None|Civil Monetary Penalty|Denial of Payment|Temporary Management|Termination|State Monitor|Directed Plan of Correction — promote to reference product]' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceOfDeficiency rdf:type rdf:Property ;
    rdfs:label 'Evidence Of Deficiency' ;
    rdfs:comment 'Specific evidence cited by the surveyor to support the finding, including observations, document reviews, staff interviews, or patient record reviews that substantiate the deficiency.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:immediateJeopardy rdf:type rdf:Property ;
    rdfs:label 'Immediate Jeopardy' ;
    rdfs:comment 'Indicates whether the finding has been classified as Immediate Jeopardy (IJ) — a situation in which the facility\'s noncompliance has caused, or is likely to cause, serious injury, harm, impairment, or death to a patient. Triggers mandatory expedited regulatory response.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:monitoringFrequency rdf:type rdf:Property ;
    rdfs:label 'Monitoring Frequency' ;
    rdfs:comment 'Frequency at which ongoing compliance monitoring activities are conducted following corrective action implementation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringMethod rdf:type rdf:Property ;
    rdfs:label 'Monitoring Method' ;
    rdfs:comment 'Description of the ongoing monitoring mechanism established to verify sustained compliance after corrective actions are implemented (e.g., monthly audits, staff competency checks, policy review cycles).' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repeatFinding rdf:type rdf:Property ;
    rdfs:label 'Repeat Finding' ;
    rdfs:comment 'Indicates whether this finding is a recurrence of a previously cited deficiency for the same standard at this facility. Repeat findings carry heightened regulatory scrutiny and may trigger escalated enforcement actions.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revisitDate rdf:type rdf:Property ;
    rdfs:label 'Revisit Date' ;
    rdfs:comment 'The scheduled or actual date of the follow-up revisit by the surveying body to verify correction of this finding.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revisitRequired rdf:type rdf:Property ;
    rdfs:label 'Revisit Required' ;
    rdfs:comment 'Indicates whether a follow-up revisit by the surveying body is required to verify correction of this finding before the finding can be closed.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scopeCode rdf:type rdf:Property ;
    rdfs:label 'Scope Code' ;
    rdfs:comment 'CMS scope classification indicating how broadly the deficiency affects patients or residents: Isolated (limited number), Pattern (more than limited), or Widespread (majority or all). Combined with severity to determine the CMS scope-severity grid rating.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeSeverityGrid rdf:type rdf:Property ;
    rdfs:label 'Scope Severity Grid' ;
    rdfs:comment 'The combined CMS scope and severity grid rating (e.g., \'D\', \'G\', \'J\') derived from the intersection of scope and severity classifications. Determines enforcement remedies and civil monetary penalty calculations.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityCode rdf:type rdf:Property ;
    rdfs:label 'Severity Code' ;
    rdfs:comment 'CMS severity classification (A through L on the scope-severity grid, with A-C representing no actual harm, D-F low actual harm, G-I high actual harm, J-L immediate jeopardy). Stored as the letter code. [ENUM-REF-CANDIDATE: A|B|C|D|E|F|G|H|I|J|K|L — promote to reference product]' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardChapter rdf:type rdf:Property ;
    rdfs:label 'Standard Chapter' ;
    rdfs:comment 'The chapter or section grouping within the accreditation or regulatory framework to which the cited standard belongs (e.g., \'Environment of Care\', \'Infection Prevention and Control\', \'Patient Rights\'). Supports trend analysis by chapter.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Standard Reference Code' ;
    rdfs:comment 'The specific regulatory standard, condition, or requirement code that was found to be deficient or at risk (e.g., TJC NPSG.07.01.01, CMS CoP 482.13, State regulation section number). The authoritative citation for the finding.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardReferenceDescription rdf:type rdf:Property ;
    rdfs:label 'Standard Reference Description' ;
    rdfs:comment 'Full descriptive title of the regulatory standard, condition, or requirement cited in this finding (e.g., \'Reduce the Risk of Health Care-Associated Infections\'). Provides human-readable context for the standard_reference_code.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyingBody rdf:type rdf:Property ;
    rdfs:label 'Surveying Body' ;
    rdfs:comment 'The regulatory or accrediting organization that conducted the survey and issued this finding (e.g., The Joint Commission, CMS, State Department of Health, OIG). Determines applicable standards and reporting obligations. [ENUM-REF-CANDIDATE: TJC|CMS|State DOH|OIG|Internal|DNV|HFAP — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tjcNpsgNumber rdf:type rdf:Property ;
    rdfs:label 'Tjc Npsg Number' ;
    rdfs:comment 'The TJC National Patient Safety Goal (NPSG) number cited in this finding, when applicable (e.g., NPSG.01.01.01 for patient identification, NPSG.07.01.01 for infection prevention). Null when the finding does not relate to an NPSG.' ;
    rdfs:domain ind:StandardFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onboardingProjectId rdf:type rdf:Property ;
    rdfs:label 'Onboarding Project Id' ;
    rdfs:comment 'Foreign key linking to interoperability.onboarding_project. Business justification: Quality improvement initiatives (e.g., reducing readmissions, improving care transitions) often require new data exchange capabilities such as ADT notifications to PCPs or SNFs. Linking initiatives to' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OnboardingProject .

ind:ownerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Owner Employee Id' ;
    rdfs:comment 'Identifier of the quality professional or clinical leader operationally responsible for day-to-day management of the initiative.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryImprovementEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Improvement Employee Id' ;
    rdfs:comment 'Identifier of the executive or senior clinical leader who sponsors and is accountable for the initiative. Typically a Chief Medical Officer, Chief Nursing Officer, or department VP.' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:aimStatement rdf:type rdf:Property ;
    rdfs:label 'Aim Statement' ;
    rdfs:comment 'Specific, measurable, time-bound goal statement for the initiative following IHI Model for Improvement format (e.g., \'By December 2024, reduce CAUTI rate from 2.1 to 1.0 per 1,000 catheter days\'). Core element of CMS quality improvement submissions.' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselineValue rdf:type rdf:Property ;
    rdfs:label 'Baseline Value' ;
    rdfs:comment 'Quantitative baseline performance level for the target measure at the time the initiative was launched. Establishes the starting point for measuring improvement.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentPerformanceDate rdf:type rdf:Property ;
    rdfs:label 'Current Performance Date' ;
    rdfs:comment 'Date on which the current performance value was last measured or updated.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:currentPerformanceValue rdf:type rdf:Property ;
    rdfs:label 'Current Performance Value' ;
    rdfs:comment 'Most recently recorded performance value for the target measure. Enables real-time progress tracking against baseline and goal.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentPhase rdf:type rdf:Property ;
    rdfs:label 'Current Phase' ;
    rdfs:comment 'Current phase of the improvement cycle (e.g., Plan, Do, Study, Act, Sustain for PDSA-based initiatives). Tracks progress through the improvement methodology lifecycle.' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goalValue rdf:type rdf:Property ;
    rdfs:label 'Goal Value' ;
    rdfs:comment 'Target quantitative performance level the initiative aims to achieve by the target completion date. Defined in the aim statement and used to assess initiative success.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:improvementMethodology rdf:type rdf:Property ;
    rdfs:label 'Improvement Methodology' ;
    rdfs:comment 'Formal quality improvement methodology applied to this initiative (e.g., Plan-Do-Study-Act (PDSA), Lean, Six Sigma, IHI Model for Improvement, Root Cause Analysis (RCA), Failure Mode and Effects Analysis (FMEA)). Required for TJC performance improvement chapter compliance. [ENUM-REF-CANDIDATE: PDSA|Lean|Six_Sigma|IHI_Model|RCA|FMEA|Kaizen|other — promote to reference product]' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiativeName rdf:type rdf:Property ;
    rdfs:label 'Initiative Name' ;
    rdfs:comment 'Short, descriptive title of the quality improvement initiative (e.g., \'Reduce CAUTI Rate in ICU by 30%\'). Used in dashboards, reports, and TJC performance improvement documentation.' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiativeNumber rdf:type rdf:Property ;
    rdfs:label 'Initiative Number' ;
    rdfs:comment 'Externally-known, human-readable business identifier for the initiative (e.g., QI-2024-00042). Used in regulatory submissions, TJC survey documentation, and cross-departmental communications.' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiativeStatus rdf:type rdf:Property ;
    rdfs:label 'Initiative Status' ;
    rdfs:comment 'Current lifecycle state of the improvement initiative. Drives workflow routing, reporting filters, and CMS quality program compliance tracking.' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiativeType rdf:type rdf:Property ;
    rdfs:label 'Initiative Type' ;
    rdfs:comment 'Categorical classification of the initiative by primary focus area. Supports portfolio analysis and alignment to organizational quality strategy. [ENUM-REF-CANDIDATE: patient_safety|clinical_quality|operational_efficiency|regulatory_compliance|patient_experience|workforce_development — promote to reference product]' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSentinelEventRelated rdf:type rdf:Property ;
    rdfs:label 'Is Sentinel Event Related' ;
    rdfs:comment 'Indicates whether this initiative was triggered by or is directly related to a sentinel event review. Sentinel event-related initiatives require expedited TJC reporting.' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTjcReportable rdf:type rdf:Property ;
    rdfs:label 'Is Tjc Reportable' ;
    rdfs:comment 'Indicates whether this initiative is required to be documented and reported as part of TJC performance improvement chapter compliance or survey readiness.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lessonsLearned rdf:type rdf:Property ;
    rdfs:label 'Lessons Learned' ;
    rdfs:comment 'Narrative summary of key insights, successes, and failures identified during the initiative. Supports organizational learning, knowledge management, and future initiative planning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pdsaCycleCount rdf:type rdf:Property ;
    rdfs:label 'Pdsa Cycle Count' ;
    rdfs:comment 'Number of Plan-Do-Study-Act (PDSA) or improvement cycles completed to date for this initiative. Tracks iterative improvement progress per IHI Model for Improvement.' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:problemStatement rdf:type rdf:Property ;
    rdfs:label 'Problem Statement' ;
    rdfs:comment 'Narrative description of the specific quality problem or gap being addressed. Defines the \'what\' and \'why\' of the initiative. Required for TJC performance improvement documentation.' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemInitiativeReference rdf:type rdf:Property ;
    rdfs:label 'Source System Initiative Reference' ;
    rdfs:comment 'Native identifier of this initiative record in the originating operational system (e.g., Epic Healthy Planet project ID). Enables reconciliation between the lakehouse and source systems.' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sustainabilityPlan rdf:type rdf:Property ;
    rdfs:label 'Sustainability Plan' ;
    rdfs:comment 'Narrative description of the plan to sustain achieved improvements after the initiative closes, including process changes, policy updates, and monitoring mechanisms.' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Target Completion Date' ;
    rdfs:comment 'Planned date by which the initiative aims to achieve its goal performance value and transition to the sustain phase.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:teamMembers rdf:type rdf:Property ;
    rdfs:label 'Team Members' ;
    rdfs:comment 'Comma-separated list of names or employee IDs of multidisciplinary team members participating in the initiative. Supports accountability tracking and TJC performance improvement documentation.' ;
    rdfs:domain ind:ImprovementInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryQualityClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Quality Clinician Id' ;
    rdfs:comment 'Reference to the clinician whose clinical performance or care decisions are under review. Used for Ongoing Professional Practice Evaluation (OPPE) and Focused Professional Practice Evaluation (FPPE) tracking.' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:actionCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Action Completion Date' ;
    rdfs:comment 'The actual date on which the required corrective or educational action was completed and verified by the medical staff office.' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actionDescription rdf:type rdf:Property ;
    rdfs:label 'Action Description' ;
    rdfs:comment 'Detailed narrative of the specific corrective or educational action taken, including any conditions, timelines, or requirements imposed on the reviewed provider.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionDueDate rdf:type rdf:Property ;
    rdfs:label 'Action Due Date' ;
    rdfs:comment 'Target date by which the required corrective or educational action must be completed by the reviewed provider.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actionTaken rdf:type rdf:Property ;
    rdfs:label 'Action Taken' ;
    rdfs:comment 'The formal action taken by the medical staff committee as a result of the peer review determination. [ENUM-REF-CANDIDATE: no_action|letter_of_concern|education_required|proctoring|privilege_restriction|privilege_suspension|privilege_revocation|referral_to_mec|voluntary_relinquishment — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careDetermination rdf:type rdf:Property ;
    rdfs:label 'Care Determination' ;
    rdfs:comment 'The formal committee determination of whether the care provided was clinically appropriate: appropriate (care met standard), appropriate with suggestions (care met standard but improvement opportunities identified), not appropriate (care did not meet standard), or unable to determine (insufficient information).' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careEventDate rdf:type rdf:Property ;
    rdfs:label 'Care Event Date' ;
    rdfs:comment 'The date on which the clinical care event under review occurred (e.g., date of surgery, date of adverse event, date of the encounter being reviewed). Distinct from the case open date.' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:caseOpenDate rdf:type rdf:Property ;
    rdfs:label 'Case Open Date' ;
    rdfs:comment 'The date on which the peer review case was formally opened and assigned to a reviewer by the medical staff office.' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:caseSummary rdf:type rdf:Property ;
    rdfs:label 'Case Summary' ;
    rdfs:comment 'Narrative summary of the clinical case under review, including relevant clinical context, key events, and the basis for the review. Protected under peer review confidentiality statutes.' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:educationalOpportunityDescription rdf:type rdf:Property ;
    rdfs:label 'Educational Opportunity Description' ;
    rdfs:comment 'Narrative description of the specific educational opportunity identified for the reviewed provider (e.g., documentation improvement, clinical guideline adherence, procedural technique).' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:educationalOpportunityFlag rdf:type rdf:Property ;
    rdfs:label 'Educational Opportunity Flag' ;
    rdfs:comment 'Indicates whether the peer review case identified an educational opportunity for the reviewed provider, regardless of the care determination outcome.' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalReviewerOrganization rdf:type rdf:Property ;
    rdfs:label 'External Reviewer Organization' ;
    rdfs:comment 'Name of the external organization or independent review entity engaged to conduct the peer review when an internal reviewer is not available or a conflict of interest exists.' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fppeTriggerFlag rdf:type rdf:Property ;
    rdfs:label 'Fppe Trigger Flag' ;
    rdfs:comment 'Indicates whether this peer review case resulted in the initiation of a Focused Professional Practice Evaluation (FPPE) for the reviewed provider.' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:npdbReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Npdb Reportable Flag' ;
    rdfs:comment 'Indicates whether the action taken as a result of this peer review case meets the threshold for mandatory reporting to the National Practitioner Data Bank (NPDB) under HCQIA.' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oppeCycle rdf:type rdf:Property ;
    rdfs:label 'Oppe Cycle' ;
    rdfs:comment 'The OPPE review cycle period to which this peer review case contributes (e.g., 2024-H1, 2024-Q3). Used to aggregate peer review outcomes into the provider\'s OPPE profile for reappointment decisions.' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privilegingImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Privileging Impact Flag' ;
    rdfs:comment 'Indicates whether the outcome of this peer review case has a direct impact on the reviewed provider\'s clinical privileges (restriction, suspension, or revocation).' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:protectionStatuteReference rdf:type rdf:Property ;
    rdfs:label 'Protection Statute Reference' ;
    rdfs:comment 'The specific state or federal statute under which peer review confidentiality protection is claimed (e.g., California Evidence Code §1157, Texas Occupations Code §160.007).' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewLevel rdf:type rdf:Property ;
    rdfs:label 'Review Level' ;
    rdfs:comment 'The organizational level at which the review is conducted: department-level (chief review), committee-level (medical staff quality committee), external (independent third-party reviewer), or appellate (appeal hearing panel).' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerFindings rdf:type rdf:Property ;
    rdfs:label 'Reviewer Findings' ;
    rdfs:comment 'Narrative of the peer reviewer\'s clinical findings, analysis of the care provided, and rationale supporting the care appropriateness determination.' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerDescription rdf:type rdf:Property ;
    rdfs:label 'Trigger Description' ;
    rdfs:comment 'Narrative description of the specific event, complaint, or indicator that triggered this peer review case (e.g., unexpected intraoperative complication, patient complaint regarding surgical outcome).' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerType rdf:type rdf:Property ;
    rdfs:label 'Trigger Type' ;
    rdfs:comment 'The initiating event or mechanism that caused this peer review case to be opened. OPPE = Ongoing Professional Practice Evaluation; FPPE = Focused Professional Practice Evaluation.' ;
    rdfs:domain ind:QualityPeerReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureClaimId rdf:type rdf:Property ;
    rdfs:label 'Closure Claim Id' ;
    rdfs:comment 'Foreign key linking to claim.claim. Business justification: Care gaps are closed when claims provide evidence of required services. Healthcare gap closure workflows require linking to the specific claim that satisfied the measure for HEDIS reporting and payer ' ;
    rdfs:domain ind:PopulationHealthGap ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claim .

ind:closureMethod rdf:type rdf:Property ;
    rdfs:label 'Closure Method' ;
    rdfs:comment 'The method by which the care gap was satisfied and closed. \'Claim\' indicates closure via a paid claims record; \'clinical_documentation\' via EHR charting; \'patient_attestation\' via patient self-report; \'lab_result\' via a qualifying lab value; \'immunization_registry\' via state registry data; \'care_plan\' via documented care plan goal achievement.' ;
    rdfs:domain ind:PopulationHealthGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapCategory rdf:type rdf:Property ;
    rdfs:label 'Gap Category' ;
    rdfs:comment 'Clinical sub-category of the care gap describing the nature of the required service (e.g., screening, immunization, lab monitoring, medication management, counseling, follow-up visit). Supports stratified reporting and outreach prioritization.' ;
    rdfs:domain ind:PopulationHealthGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapNumber rdf:type rdf:Property ;
    rdfs:label 'Gap Number' ;
    rdfs:comment 'Business-facing unique identifier for this care gap record, used in outreach workflows, care coordinator communications, and ACO quality reporting. Sourced from Epic Healthy Planet gap tracking.' ;
    rdfs:domain ind:PopulationHealthGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapType rdf:type rdf:Property ;
    rdfs:label 'Gap Type' ;
    rdfs:comment 'Classification of the care gap by clinical category. Indicates whether the gap relates to preventive care (e.g., cancer screening), chronic disease management (e.g., diabetes HbA1c), HEDIS measure compliance, medication adherence, or behavioral health. [ENUM-REF-CANDIDATE: preventive_care|chronic_disease_management|hedis_measure|medication_adherence|behavioral_health|other — promote to reference product]' ;
    rdfs:domain ind:PopulationHealthGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifiedDate rdf:type rdf:Property ;
    rdfs:label 'Identified Date' ;
    rdfs:comment 'The date on which this care gap was first identified for the patient, typically generated by Epic Healthy Planet during a registry refresh or care gap analysis run. Represents the business event timestamp for gap creation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isDenominatorEligible rdf:type rdf:Property ;
    rdfs:label 'Is Denominator Eligible' ;
    rdfs:comment 'Indicates whether the patient meets the denominator eligibility criteria for the associated quality measure (True = eligible; False = ineligible). Ineligible patients are excluded from gap rate calculations.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNumeratorCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Numerator Compliant' ;
    rdfs:comment 'Indicates whether the patient currently meets the numerator criteria for the associated HEDIS or quality measure (True = compliant, gap closed; False = non-compliant, gap open). Directly drives HEDIS rate calculations and ACO quality score submissions.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastOutreachChannel rdf:type rdf:Property ;
    rdfs:label 'Last Outreach Channel' ;
    rdfs:comment 'The communication channel used for the most recent outreach attempt (phone call, mailed letter, patient portal message, care coordinator visit, telehealth, or SMS text). Supports outreach channel effectiveness analytics.' ;
    rdfs:domain ind:PopulationHealthGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outreachResponseStatus rdf:type rdf:Property ;
    rdfs:label 'Outreach Response Status' ;
    rdfs:comment 'The patient\'s response to the most recent outreach attempt. Indicates whether the patient engaged, scheduled an appointment, declined the service, could not be reached, or has not yet responded. Drives next-step care coordinator actions.' ;
    rdfs:domain ind:PopulationHealthGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceGapReference rdf:type rdf:Property ;
    rdfs:label 'Source Gap Reference' ;
    rdfs:comment 'The native identifier for this care gap record in the originating source system (e.g., Epic Healthy Planet internal gap ID). Supports ETL reconciliation, deduplication, and upstream system traceability.' ;
    rdfs:domain ind:PopulationHealthGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdohScreeningId rdf:type rdf:Property ;
    rdfs:label 'Sdoh Screening Id' ;
    rdfs:comment 'Primary key for sdoh_screening' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referralConsentRecordId rdf:type rdf:Property ;
    rdfs:label 'Referral Consent Record Id' ;
    rdfs:comment 'Foreign key linking to consent.consent_record. Business justification: SDOH screening programs require patient consent before sharing information with community resources or external agencies. CMS quality measures for social needs screening require documented consent for' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentRecord .

ind:communityResourceConnected rdf:type rdf:Property ;
    rdfs:label 'Community Resource Connected' ;
    rdfs:comment 'Indicates whether the patient was successfully connected to a community resource following a positive SDOH screen and referral. Supports close-the-loop tracking for CMS SDOH quality measures.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communityResourceName rdf:type rdf:Property ;
    rdfs:label 'Community Resource Name' ;
    rdfs:comment 'Name of the community-based organization or resource connected to the patient following a positive SDOH screen. Supports community partnership tracking and health equity reporting.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthEquityStratifier rdf:type rdf:Property ;
    rdfs:label 'Health Equity Stratifier' ;
    rdfs:comment 'Stratification category used for health equity reporting (e.g., race/ethnicity group, payer type, geographic area). Supports CMS health equity reporting requirements and SDOH disparity analysis. Value is a non-PHI aggregate category, not individual patient data.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPositiveScreen rdf:type rdf:Property ;
    rdfs:label 'Is Positive Screen' ;
    rdfs:comment 'Indicates whether the patient screened positive for a social need in this SDOH domain. A positive screen triggers referral workflows and community resource connection. Core flag for CMS SDOH quality measure numerator identification.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReferralGenerated rdf:type rdf:Property ;
    rdfs:label 'Is Referral Generated' ;
    rdfs:comment 'Indicates whether a community resource or social services referral was generated as a result of a positive SDOH screen. Key metric for CMS SDOH quality measure numerator tracking and health equity reporting.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:needResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Need Resolution Date' ;
    rdfs:comment 'Date on which the patient\'s social need was confirmed resolved. Supports longitudinal outcomes measurement and population health program effectiveness reporting.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:needResolved rdf:type rdf:Property ;
    rdfs:label 'Need Resolved' ;
    rdfs:comment 'Indicates whether the identified social need was resolved following intervention and community resource connection. Supports longitudinal population health outcomes tracking.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:positiveScreenReason rdf:type rdf:Property ;
    rdfs:label 'Positive Screen Reason' ;
    rdfs:comment 'Clinical or administrative reason code or description explaining why the patient screened positive for this SDOH domain. Supports CDI and population health care management workflows.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:questionText rdf:type rdf:Property ;
    rdfs:label 'Question Text' ;
    rdfs:comment 'Verbatim text of the SDOH screening question as presented to the patient. Supports audit, quality review, and longitudinal tracking of question wording across tool versions.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refusalReason rdf:type rdf:Property ;
    rdfs:label 'Refusal Reason' ;
    rdfs:comment 'Reason the patient declined or was unable to complete the SDOH screening. Required for denominator exclusion logic in CMS SDOH quality measures and equity reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceConnectionDate rdf:type rdf:Property ;
    rdfs:label 'Resource Connection Date' ;
    rdfs:comment 'Date on which the patient was confirmed connected to the community resource. Used to calculate time-to-connection metrics and close-the-loop quality measure compliance.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responseValue rdf:type rdf:Property ;
    rdfs:label 'Response Value' ;
    rdfs:comment 'Patient\'s verbatim or coded response to the SDOH screening question. Contains Protected Health Information (PHI) as it reflects the patient\'s social needs. Satisfies TRANSACTION_HEADER QUANTITATIVE_RESULT minimum category for non-monetary clinical transactions.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:screeningNumber rdf:type rdf:Property ;
    rdfs:label 'Screening Number' ;
    rdfs:comment 'Externally visible business identifier for the SDOH screening event, typically sourced from the EHR (Epic Healthy Planet or Cerner Millennium). Used for cross-system reconciliation and audit trail. Satisfies TRANSACTION_HEADER BUSINESS_IDENTIFIER minimum category.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningSetting rdf:type rdf:Property ;
    rdfs:label 'Screening Setting' ;
    rdfs:comment 'Clinical care setting in which the SDOH screening was administered. Supports stratification of screening rates by care setting for CMS quality reporting and health equity analytics.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningStatus rdf:type rdf:Property ;
    rdfs:label 'Screening Status' ;
    rdfs:comment 'Current workflow status of the SDOH screening record. Indicates whether the screening was fully completed, partially administered, refused by the patient, or voided. Satisfies TRANSACTION_HEADER LIFECYCLE_STATUS minimum category.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningTimestamp rdf:type rdf:Property ;
    rdfs:label 'Screening Timestamp' ;
    rdfs:comment 'Precise date and time the SDOH screening was administered, including timezone offset. Supports time-of-day analytics and HL7 FHIR Observation.effectiveDateTime mapping.' ;
    rdfs:domain ind:SdohScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:primaryQualityEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Quality Employee Id' ;
    rdfs:comment 'Reference to the workforce or provider record of the staff member designated as the quality program manager. Enables linkage to HR and credentialing systems for contact and accountability tracking.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accreditationStandardVersion rdf:type rdf:Property ;
    rdfs:label 'Accreditation Standard Version' ;
    rdfs:comment 'Version or edition of the accreditation standards applicable to this program (e.g., TJC 2024 Comprehensive Accreditation Manual for Hospitals, NCQA 2024-2025 Standards). Ensures the organization is evaluated against the correct standard set.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apmModelName rdf:type rdf:Property ;
    rdfs:label 'Apm Model Name' ;
    rdfs:comment 'Name of the CMS Alternative Payment Model (APM) or Advanced APM under which the organization participates (e.g., MSSP ACO, Bundled Payments for Care Improvement, Comprehensive Care for Joint Replacement). Null for non-APM programs.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSubmissionMethod rdf:type rdf:Property ;
    rdfs:label 'Data Submission Method' ;
    rdfs:comment 'Mechanism used to submit quality data to the sponsoring body. Determines technical integration requirements and data validation workflows. Examples: QualityNet portal (CMS), NCQA IDSS (HEDIS), direct EHR submission (eCQM), registry submission (MIPS), claims-based, or attestation.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executiveSponsorName rdf:type rdf:Property ;
    rdfs:label 'Executive Sponsor Name' ;
    rdfs:comment 'Name of the senior organizational leader (e.g., Chief Quality Officer, CMO, CNO) who holds executive accountability for this quality program\'s performance and strategic outcomes.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incentiveAmount rdf:type rdf:Property ;
    rdfs:label 'Incentive Amount' ;
    rdfs:comment 'Total dollar amount of financial incentive or bonus at risk for this program year. Represents the maximum potential positive payment adjustment or bonus available to the organization for achieving top performance.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Last Survey Date' ;
    rdfs:comment 'Date of the most recently completed accreditation survey, audit, or review for this program. Used to track accreditation currency and calculate time to next survey.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measureCount rdf:type rdf:Property ;
    rdfs:label 'Measure Count' ;
    rdfs:comment 'Total number of quality measures included in this program\'s measure set for the program year. Provides a quick indicator of program scope and data collection burden.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mipsQualityCategoryWeight rdf:type rdf:Property ;
    rdfs:label 'Mips Quality Category Weight' ;
    rdfs:comment 'Percentage weight of the Quality performance category in the MIPS composite performance score (e.g., 30.0 for 30%). Weights across all MIPS categories (Quality, Promoting Interoperability, Improvement Activities, Cost) must sum to 100.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mipsSubmissionType rdf:type rdf:Property ;
    rdfs:label 'Mips Submission Type' ;
    rdfs:comment 'Defines how the organization submits MIPS performance data to CMS. Determines the eligible clinician population, scoring methodology, and payment adjustment calculation. Not applicable for non-MIPS programs.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participatingFacilityCount rdf:type rdf:Property ;
    rdfs:label 'Participating Facility Count' ;
    rdfs:comment 'Number of organizational facilities enrolled and actively participating in this quality program. Supports program scope management, resource allocation, and multi-facility performance aggregation.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Payment Adjustment Factor' ;
    rdfs:comment 'Multiplicative factor applied to Medicare base operating DRG payments as a result of program performance (e.g., 1.0175 for a positive adjustment, 0.9800 for a penalty). Specific to CMS VBP and similar pay-for-performance programs. Expressed as a decimal multiplier.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount' ;
    rdfs:comment 'Total dollar amount of financial penalty or payment reduction at risk for this program year. Represents the maximum potential negative payment adjustment if performance thresholds are not met.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:publicReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Public Reporting Flag' ;
    rdfs:comment 'Indicates whether performance results for this program are publicly reported on CMS Hospital Compare, Physician Compare, or other public-facing transparency platforms. Drives reputational risk management and patient choice analytics.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingFrequency rdf:type rdf:Property ;
    rdfs:label 'Reporting Frequency' ;
    rdfs:comment 'Frequency at which performance data must be collected, calculated, and reported for this quality program. Drives data pipeline scheduling, dashboard refresh cadence, and internal review meeting frequency.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAdjustmentApplied rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Applied' ;
    rdfs:comment 'Indicates whether risk adjustment methodology is applied to performance scores in this program to account for patient complexity and socioeconomic factors. True for programs using CMS risk adjustment models (e.g., mortality, readmission measures).' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sdohAdjustmentApplied rdf:type rdf:Property ;
    rdfs:label 'Sdoh Adjustment Applied' ;
    rdfs:comment 'Indicates whether Social Determinants of Health (SDOH) stratification or adjustment is applied in this program\'s scoring methodology. Reflects CMS equity-focused quality reporting initiatives and NCQA health equity accreditation requirements.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sponsor rdf:type rdf:Property ;
    rdfs:label 'Sponsor' ;
    rdfs:comment 'Governing body or organization that owns and administers the quality program. Determines regulatory authority, submission requirements, and financial implications. [ENUM-REF-CANDIDATE: CMS|TJC|NCQA|AMA|State|Internal|AHRQ|NQF|HHS|HRSA — promote to reference product]' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyCycleMonths rdf:type rdf:Property ;
    rdfs:label 'Survey Cycle Months' ;
    rdfs:comment 'Duration in months of the accreditation or certification survey cycle (e.g., 36 months for TJC triennial survey, 12 months for annual NCQA review). Drives survey readiness planning and accreditation renewal workflows.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalPerformanceScoreMethodology rdf:type rdf:Property ;
    rdfs:label 'Total Performance Score Methodology' ;
    rdfs:comment 'Description of the scoring methodology used to calculate the Total Performance Score (TPS) for this program. Includes achievement vs. improvement scoring approach, domain weighting logic, and floor score rules. Specific to CMS VBP and MIPS programs.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vbpClinicalOutcomesWeight rdf:type rdf:Property ;
    rdfs:label 'Vbp Clinical Outcomes Weight' ;
    rdfs:comment 'Percentage weight assigned to the Clinical Outcomes domain within the VBP Total Performance Score calculation (e.g., 40.0 for 40%). Includes mortality, complications, and readmission measures. Weights must sum to 100 across all VBP domains.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vbpEfficiencyCostWeight rdf:type rdf:Property ;
    rdfs:label 'Vbp Efficiency Cost Weight' ;
    rdfs:comment 'Percentage weight assigned to the Efficiency and Cost Reduction domain within the VBP Total Performance Score calculation. Includes Medicare Spending Per Beneficiary (MSPB) measure.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vbpPersonCommunityWeight rdf:type rdf:Property ;
    rdfs:label 'Vbp Person Community Weight' ;
    rdfs:comment 'Percentage weight assigned to the Person and Community Engagement domain (HCAHPS patient experience) within the VBP Total Performance Score calculation. Reflects patient satisfaction and experience of care measures.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vbpSafetyWeight rdf:type rdf:Property ;
    rdfs:label 'Vbp Safety Weight' ;
    rdfs:comment 'Percentage weight assigned to the Safety domain within the VBP Total Performance Score calculation. Includes HAI measures (CLABSI, CAUTI, SSI, MRSA, C. diff) and PSI-90 composite.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Withhold Percentage' ;
    rdfs:comment 'Percentage of Medicare base operating payments withheld by CMS to fund the VBP incentive pool (e.g., 2.0% for FY2024). Withheld funds are redistributed based on Total Performance Score. Applicable to CMS VBP program.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:year rdf:type rdf:Property ;
    rdfs:label 'Year' ;
    rdfs:comment 'Calendar or fiscal year for which this quality program configuration applies (e.g., 2024). Each program year may have distinct measure sets, weights, benchmarks, and payment adjustment factors. Aligns with CMS program year definitions.' ;
    rdfs:domain ind:QualityProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capitalExpenditureId rdf:type rdf:Property ;
    rdfs:label 'Capital Expenditure Id' ;
    rdfs:comment 'Foreign key linking to finance.capital_expenditure. Business justification: Some corrective actions require capital purchases (equipment replacement for safety compliance, facility modifications for accreditation standards, technology upgrades for infection control). These ar' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitalExpenditure .

ind:complianceCorrectiveActionPlanId rdf:type rdf:Property ;
    rdfs:label 'Compliance Corrective Action Plan Id' ;
    rdfs:comment 'Foreign key linking to compliance.corrective_action_plan. Business justification: Quality corrective actions originating from safety events, accreditation findings, or peer reviews must link to compliance CAP system for regulatory tracking, submission to CMS/TJC, verification of ef' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorrectiveActionPlan .

ind:parentCorrectiveActionId rdf:type rdf:Property ;
    rdfs:label 'Parent Corrective Action Id' ;
    rdfs:comment 'Self-referencing FK on corrective_action (parent_corrective_action_id)' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorrectiveAction .

ind:acceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Acceptance Date' ;
    rdfs:comment 'Date when the regulatory or accreditation body formally accepted the corrective action plan or evidence of completion.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:acceptanceStatus rdf:type rdf:Property ;
    rdfs:label 'Acceptance Status' ;
    rdfs:comment 'Status of the corrective action plan or evidence as reviewed and accepted by the regulatory or accreditation body.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionNumber rdf:type rdf:Property ;
    rdfs:label 'Action Number' ;
    rdfs:comment 'Business-facing unique identifier or tracking number for the corrective action, used for external reference and communication with regulatory bodies and accreditation organizations.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionStatus rdf:type rdf:Property ;
    rdfs:label 'Action Status' ;
    rdfs:comment 'Current lifecycle status of the corrective action indicating progress through the action workflow from initiation to closure.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionType rdf:type rdf:Property ;
    rdfs:label 'Action Type' ;
    rdfs:comment 'Classification of the action as corrective (addressing an existing deficiency), preventive (preventing future occurrence), or both.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedDate rdf:type rdf:Property ;
    rdfs:label 'Assigned Date' ;
    rdfs:comment 'Date when the corrective action was formally assigned to the responsible party.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysToComplete rdf:type rdf:Property ;
    rdfs:label 'Days To Complete' ;
    rdfs:comment 'Number of calendar days elapsed from action assignment to completion, used for performance monitoring and accountability tracking.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:effectivenessVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Verification Method' ;
    rdfs:comment 'Description of the method or process used to verify that the corrective action achieved its intended outcome and prevented recurrence (e.g., audits, chart reviews, process observations, outcome measurement).' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isOverdue rdf:type rdf:Property ;
    rdfs:label 'Is Overdue' ;
    rdfs:comment 'Flag indicating whether the corrective action has passed its due date without completion.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originatingEventType rdf:type rdf:Property ;
    rdfs:label 'Originating Event Type' ;
    rdfs:comment 'Classification of the source event or finding that triggered the need for this corrective action. [ENUM-REF-CANDIDATE: patient_safety_event|accreditation_finding|regulatory_deficiency|peer_review|mortality_review|quality_measure_gap|complaint|audit_finding — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryProgram rdf:type rdf:Property ;
    rdfs:label 'Regulatory Program' ;
    rdfs:comment 'Name of the regulatory or quality program that requires or monitors this corrective action (e.g., CMS Conditions of Participation, TJC Accreditation, State Licensure, MIPS, VBP).' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsiblePartyRole rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Role' ;
    rdfs:comment 'Job title or functional role of the individual assigned responsibility for the corrective action (e.g., Nurse Manager, Quality Director, Department Chair).' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemActionReference rdf:type rdf:Property ;
    rdfs:label 'Source System Action Reference' ;
    rdfs:comment 'Unique identifier for the corrective action in the originating source system, used for data lineage and reconciliation.' ;
    rdfs:domain ind:CorrectiveAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationNotes rdf:type rdf:Property ;
    rdfs:label 'Verification Notes' ;
    rdfs:comment 'Detailed notes and findings from the effectiveness verification process, including evidence of sustained improvement or identification of additional actions needed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationResult rdf:type rdf:Property ;
    rdfs:label 'Verification Result' ;
    rdfs:comment 'Outcome of the effectiveness verification assessment, indicating whether the corrective action successfully resolved the issue.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programMeasureAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Program Measure Assignment Id' ;
    rdfs:comment 'Unique surrogate identifier for the program-measure assignment record. Primary key.' ;
    rdfs:domain ind:ProgramMeasureAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:achievementThreshold rdf:type rdf:Property ;
    rdfs:label 'Achievement Threshold' ;
    rdfs:comment 'Program-specific performance threshold for this measure that defines achievement level or benchmark attainment. Thresholds vary by program even for the same measure (e.g., CMS VBP vs. internal quality program).' ;
    rdfs:domain ind:ProgramMeasureAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assignedBy rdf:type rdf:Property ;
    rdfs:label 'Assigned By' ;
    rdfs:comment 'User ID or name of the quality team member who assigned this measure to this program. Supports audit and accountability.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:improvementThreshold rdf:type rdf:Property ;
    rdfs:label 'Improvement Threshold' ;
    rdfs:comment 'Program-specific improvement threshold for this measure used in improvement scoring methodologies. Defines the performance improvement required to earn improvement points.' ;
    rdfs:domain ind:ProgramMeasureAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measureDomainAssignment rdf:type rdf:Property ;
    rdfs:label 'Measure Domain Assignment' ;
    rdfs:comment 'Program-specific domain or category assignment for this measure (e.g., Clinical Outcomes, Safety, Efficiency for VBP; Quality, Cost, Improvement Activities for MIPS). A measure may be assigned to different domains in different programs.' ;
    rdfs:domain ind:ProgramMeasureAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureInclusionEndDate rdf:type rdf:Property ;
    rdfs:label 'Measure Inclusion End Date' ;
    rdfs:comment 'Date on which this measure was removed or became inactive within this quality program. Null indicates the measure is currently active in the program.' ;
    rdfs:domain ind:ProgramMeasureAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measureInclusionStartDate rdf:type rdf:Property ;
    rdfs:label 'Measure Inclusion Start Date' ;
    rdfs:comment 'Date on which this measure became active within this quality program. Supports temporal tracking of program measure composition changes across program years.' ;
    rdfs:domain ind:ProgramMeasureAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurePointsAvailable rdf:type rdf:Property ;
    rdfs:label 'Measure Points Available' ;
    rdfs:comment 'Total points available for this measure within this program\'s scoring methodology. Used in point-based programs like MIPS.' ;
    rdfs:domain ind:ProgramMeasureAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measureReportingFrequency rdf:type rdf:Property ;
    rdfs:label 'Measure Reporting Frequency' ;
    rdfs:comment 'Frequency at which this measure must be reported or calculated for this specific program. A measure may be reported quarterly for one program and annually for another.' ;
    rdfs:domain ind:ProgramMeasureAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureStatusInProgram rdf:type rdf:Property ;
    rdfs:label 'Measure Status In Program' ;
    rdfs:comment 'Current lifecycle status of this measure within this specific program. A measure may be active in one program and inactive in another. Drives reporting and calculation logic.' ;
    rdfs:domain ind:ProgramMeasureAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureWeight rdf:type rdf:Property ;
    rdfs:label 'Measure Weight' ;
    rdfs:comment 'Percentage weight or point value assigned to this measure within the quality program\'s total performance score calculation. Used in VBP, MIPS, and other pay-for-performance programs where measures contribute differentially to overall program score.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:initiativeMeasureTargetId rdf:type rdf:Property ;
    rdfs:label 'Initiative Measure Target Id' ;
    rdfs:comment 'Unique surrogate identifier for this initiative-measure targeting relationship' ;
    rdfs:domain ind:InitiativeMeasureTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isPrimaryMeasure rdf:type rdf:Property ;
    rdfs:label 'Is Primary Measure' ;
    rdfs:comment 'Indicates whether this is the primary/lead measure for the initiative (true) or a secondary/balancing measure (false). An initiative typically has one primary measure and may have multiple secondary measures.' ;
    rdfs:domain ind:InitiativeMeasureTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measureRoleInInitiative rdf:type rdf:Property ;
    rdfs:label 'Measure Role In Initiative' ;
    rdfs:comment 'Categorical role this measure plays within the improvement initiative (e.g., Primary outcome measure, Balancing measure, Process measure). Supports IHI Model for Improvement methodology which requires tracking multiple measure types.' ;
    rdfs:domain ind:InitiativeMeasureTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureUnit rdf:type rdf:Property ;
    rdfs:label 'Measure Unit' ;
    rdfs:comment 'Unit of measurement for the target measure (e.g., \'per 1,000 catheter days\', \'percentage\', \'rate per 100 admissions\'). Required for accurate baseline and goal comparison. [Moved from improvement_initiative: This attribute stores the unit of measurement for \'the target measure\'. However, if an initiative targets multiple measures, each measure may have different units. This should come from the measure table or be stored per initiative-measure relationship, not on the initiative itself.]' ;
    rdfs:domain ind:InitiativeMeasureTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementEndDate rdf:type rdf:Property ;
    rdfs:label 'Measurement End Date' ;
    rdfs:comment 'Date when measurement and tracking of this specific measure concluded for this initiative. Null if still actively tracked.' ;
    rdfs:domain ind:InitiativeMeasureTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementStartDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Start Date' ;
    rdfs:comment 'Date when active measurement and tracking of this specific measure began for this initiative. May differ from initiative start date if measures are added during the initiative lifecycle.' ;
    rdfs:domain ind:InitiativeMeasureTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetMeasureCode rdf:type rdf:Property ;
    rdfs:label 'Target Measure Code' ;
    rdfs:comment 'Standardized code for the primary quality measure (e.g., CMS measure ID, HEDIS measure code, NQF number). Enables linkage to national quality reporting programs. [Moved from improvement_initiative: This attribute stores the code for \'the primary quality measure\'. However, an initiative targets multiple measures, not just one. The measure code should come from the measure table via this association, not be stored redundantly on the initiative.]' ;
    rdfs:domain ind:InitiativeMeasureTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetMeasureName rdf:type rdf:Property ;
    rdfs:label 'Target Measure Name' ;
    rdfs:comment 'Name of the primary quality measure or Key Performance Indicator (KPI) being tracked by this initiative (e.g., \'CAUTI Rate per 1,000 Catheter Days\', \'HEDIS Diabetes HbA1c Control Rate\'). [Moved from improvement_initiative: This attribute stores the name of \'the primary quality measure\' being tracked. However, an initiative can target MULTIPLE measures (primary, secondary, balancing). This attribute should not exist on improvement_initiative - instead, the measure name comes from joining to the measure table via this association.]' ;
    rdfs:domain ind:InitiativeMeasureTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetStatus rdf:type rdf:Property ;
    rdfs:label 'Target Status' ;
    rdfs:comment 'Current status of progress toward the goal for this specific measure (e.g., On Track, At Risk, Behind, Goal Met, Suspended). Enables status tracking per measure within an initiative.' ;
    rdfs:domain ind:InitiativeMeasureTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractInitiativeId rdf:type rdf:Property ;
    rdfs:label 'Contract Initiative Id' ;
    rdfs:comment 'Unique surrogate identifier for this contract-initiative linkage record. Primary key.' ;
    rdfs:domain ind:ContractInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractCreatedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Contract Created By Employee Id' ;
    rdfs:comment 'Identifier of the employee who created this contract-initiative linkage record, typically a contract administrator or quality program manager.' ;
    rdfs:domain ind:ContractInitiative ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:contractLastUpdatedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Contract Last Updated By Employee Id' ;
    rdfs:comment 'Identifier of the employee who most recently updated this contract-initiative linkage record.' ;
    rdfs:domain ind:ContractInitiative ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:contractMeasureCode rdf:type rdf:Property ;
    rdfs:label 'Contract Measure Code' ;
    rdfs:comment 'The specific quality measure code or identifier used in this payer contract to reference this initiative. May differ from the initiative\'s internal measure code if the payer uses a different coding system.' ;
    rdfs:domain ind:ContractInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incentiveEarnedToDate rdf:type rdf:Property ;
    rdfs:label 'Incentive Earned To Date' ;
    rdfs:comment 'Cumulative dollar amount of quality incentive payments earned from this payer contract for this initiative as of the current date.' ;
    rdfs:domain ind:ContractInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastReportedDate rdf:type rdf:Property ;
    rdfs:label 'Last Reported Date' ;
    rdfs:comment 'Date on which performance for this contract-initiative linkage was most recently reported to the payer.' ;
    rdfs:domain ind:ContractInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextReportingDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Reporting Due Date' ;
    rdfs:comment 'Date by which the next performance report for this contract-initiative linkage is due to the payer per contractual obligations.' ;
    rdfs:domain ind:ContractInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:penaltyIncurredToDate rdf:type rdf:Property ;
    rdfs:label 'Penalty Incurred To Date' ;
    rdfs:comment 'Cumulative dollar amount of quality penalties or withheld payments incurred from this payer contract for this initiative as of the current date.' ;
    rdfs:domain ind:ContractInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceTarget rdf:type rdf:Property ;
    rdfs:label 'Performance Target' ;
    rdfs:comment 'The specific quantitative performance target for this initiative as defined in this payer contract. May differ from the initiative\'s overall goal if the contract specifies a different threshold for incentive eligibility.' ;
    rdfs:domain ind:ContractInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractInitiativeStatus rdf:type rdf:Property ;
    rdfs:label 'Contract Initiative Status' ;
    rdfs:comment 'Current lifecycle status of this contract-initiative linkage. Tracks whether the initiative is actively being pursued for this specific contract\'s requirements.' ;
    rdfs:domain ind:ContractInitiative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentCountAtParticipation rdf:type rdf:Property ;
    rdfs:label 'Enrollment Count At Participation' ;
    rdfs:comment 'The number of members enrolled in this health plan at the time of program participation. Used for risk stratification and measure applicability determination.' ;
    rdfs:domain ind:QualityProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Last Submission Date' ;
    rdfs:comment 'The most recent date on which this health plan submitted quality data or performance reports for this program. Used to track compliance with reporting requirements.' ;
    rdfs:domain ind:QualityProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceScore rdf:type rdf:Property ;
    rdfs:label 'Performance Score' ;
    rdfs:comment 'The calculated performance score for this specific health plan within this quality program for the program year. Methodology defined in quality_program.total_performance_score_methodology. Used to determine payment adjustments or star ratings.' ;
    rdfs:domain ind:QualityProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityProgramParticipationStatus rdf:type rdf:Property ;
    rdfs:label 'Quality Program Participation Status' ;
    rdfs:comment 'Current lifecycle status of the health plan\'s participation in this quality program. Drives eligibility for performance measurement and payment adjustments.' ;
    rdfs:domain ind:QualityProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programStudyParticipationId rdf:type rdf:Property ;
    rdfs:label 'Program Study Participation Id' ;
    rdfs:comment 'Unique surrogate identifier for this program-study participation record. Primary key.' ;
    rdfs:domain ind:ProgramStudyParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryQualityProgramId rdf:type rdf:Property ;
    rdfs:label 'Primary Quality Program Id' ;
    rdfs:comment 'Foreign key to quality_program. Identifies which quality program is affected by the research study.' ;
    rdfs:domain ind:ProgramStudyParticipation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:QualityProgram .

ind:primaryResearchStudyId rdf:type rdf:Property ;
    rdfs:label 'Primary Research Study Id' ;
    rdfs:comment 'Foreign key to research_study. Identifies which research study impacts quality program measures.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchStudy .

ind:programStudyResearchStudyId rdf:type rdf:Property ;
    rdfs:label 'Program Study Research Study Id' ;
    rdfs:comment 'Foreign key linking to the research study that impacts quality program measures' ;
    rdfs:domain ind:ProgramStudyParticipation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchStudy .

ind:affectedMeasureIds rdf:type rdf:Property ;
    rdfs:label 'Affected Measure Ids' ;
    rdfs:comment 'Comma-separated list of specific quality measure IDs within the program that are affected by this research study participation. Enables targeted exclusion/stratification logic application.' ;
    rdfs:domain ind:ProgramStudyParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Reporting Flag' ;
    rdfs:comment 'Indicates whether this program-study relationship must be reported to CMS as part of regulatory quality data submission. Drives compliance workflow.' ;
    rdfs:domain ind:ProgramStudyParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enrollmentImpactOnMeasures rdf:type rdf:Property ;
    rdfs:label 'Enrollment Impact On Measures' ;
    rdfs:comment 'Detailed description of how patient enrollment in this research study impacts specific quality measures within the program. Documents which measures are affected and the nature of the impact. Explicitly identified in detection phase.' ;
    rdfs:domain ind:ProgramStudyParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureStratificationRequired rdf:type rdf:Property ;
    rdfs:label 'Measure Stratification Required' ;
    rdfs:comment 'Indicates whether CMS or the program sponsor requires separate stratified reporting of quality measures for patients enrolled in this research study versus non-enrolled patients. Drives reporting workflow and data submission requirements. Explicitly identified in detection phase.' ;
    rdfs:domain ind:ProgramStudyParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:programParticipationType rdf:type rdf:Property ;
    rdfs:label 'Program Participation Type' ;
    rdfs:comment 'Categorical classification of how the research study participation affects quality program measure calculation. Determines the operational impact on performance scoring and reporting. Explicitly identified in detection phase.' ;
    rdfs:domain ind:ProgramStudyParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingExclusionRules rdf:type rdf:Property ;
    rdfs:label 'Reporting Exclusion Rules' ;
    rdfs:comment 'Specific exclusion logic and rules to be applied when calculating quality measures for patients enrolled in this research study. Defines how study participants are handled in numerator/denominator calculations. Explicitly identified in detection phase.' ;
    rdfs:domain ind:ProgramStudyParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureBudgetAllocationId rdf:type rdf:Property ;
    rdfs:label 'Measure Budget Allocation Id' ;
    rdfs:comment 'Unique surrogate identifier for each measure-budget allocation record. Primary key.' ;
    rdfs:domain ind:MeasureBudgetAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:budgetLineId rdf:type rdf:Property ;
    rdfs:label 'Budget Line Id' ;
    rdfs:comment 'Foreign key linking to the budget line providing funding for this quality measure' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BudgetLine .

ind:allocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Allocation Percentage' ;
    rdfs:comment 'Percentage of the budget line amount allocated to this specific quality measure. Enables proportional cost allocation when a single budget line funds multiple measures.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetedImprovementCost rdf:type rdf:Property ;
    rdfs:label 'Budgeted Improvement Cost' ;
    rdfs:comment 'Dollar amount budgeted specifically for improvement activities related to this quality measure (e.g., staff training, process redesign, technology enhancements). Represents the investment expected to improve measure performance.' ;
    rdfs:domain ind:MeasureBudgetAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measureTargetValue rdf:type rdf:Property ;
    rdfs:label 'Measure Target Value' ;
    rdfs:comment 'The performance target or goal set for this quality measure for this fiscal year and budget allocation. Expressed as a rate, percentage, or score depending on measure type. Links financial investment to expected performance outcome.' ;
    rdfs:domain ind:MeasureBudgetAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceIncentiveAmount rdf:type rdf:Property ;
    rdfs:label 'Performance Incentive Amount' ;
    rdfs:comment 'Expected financial return or incentive payment associated with achieving the measure target (e.g., VBP bonus, MIPS positive payment adjustment, shared savings). Enables ROI calculation for quality measure investments.' ;
    rdfs:domain ind:MeasureBudgetAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityCommitteeId rdf:type rdf:Property ;
    rdfs:label 'Quality Committee Id' ;
    rdfs:comment 'Primary key for committee' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accreditationRelevantFlag rdf:type rdf:Property ;
    rdfs:label 'Accreditation Relevant Flag' ;
    rdfs:comment 'Indicates whether this committee\'s activities are directly relevant to organizational accreditation requirements and surveys.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualReportRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Annual Report Required Flag' ;
    rdfs:comment 'Indicates whether the committee is required to produce an annual report of activities and outcomes.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:budgetAllocatedAmount rdf:type rdf:Property ;
    rdfs:label 'Budget Allocated Amount' ;
    rdfs:comment 'Annual budget amount allocated to the committee for operational expenses and initiatives.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Budget Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the budget allocated amount.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bylawsDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Bylaws Document Url' ;
    rdfs:comment 'URL or file path to the committee bylaws document defining operating procedures and governance rules.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chairName rdf:type rdf:Property ;
    rdfs:label 'Chair Name' ;
    rdfs:comment 'Full name of the individual serving as the committee chair or chairperson.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:charterDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Charter Document Url' ;
    rdfs:comment 'URL or file path to the official committee charter document.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:charterEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Charter Effective Date' ;
    rdfs:comment 'Date when the committee charter became effective and the committee was officially established.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:charterExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Charter Expiration Date' ;
    rdfs:comment 'Date when the committee charter expires and requires renewal or dissolution. Null for committees with indefinite charters.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qualityCommitteeCode rdf:type rdf:Property ;
    rdfs:label 'Quality Committee Code' ;
    rdfs:comment 'Short alphanumeric code used to identify the committee in operational systems and reports.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dissolutionReason rdf:type rdf:Property ;
    rdfs:label 'Dissolution Reason' ;
    rdfs:comment 'Explanation of why the committee was dissolved, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dissolvedDate rdf:type rdf:Property ;
    rdfs:label 'Dissolved Date' ;
    rdfs:comment 'Date when the committee was officially dissolved or disbanded. Null for active committees.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastMeetingDate rdf:type rdf:Property ;
    rdfs:label 'Last Meeting Date' ;
    rdfs:comment 'Date of the most recent committee meeting held.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:missionStatement rdf:type rdf:Property ;
    rdfs:label 'Mission Statement' ;
    rdfs:comment 'Official mission statement defining the committee\'s purpose and strategic objectives.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityCommitteeName rdf:type rdf:Property ;
    rdfs:label 'Quality Committee Name' ;
    rdfs:comment 'Official name of the committee as registered with the organization.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextMeetingDate rdf:type rdf:Property ;
    rdfs:label 'Next Meeting Date' ;
    rdfs:comment 'Scheduled date of the next upcoming committee meeting.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryOversightFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Oversight Flag' ;
    rdfs:comment 'Indicates whether this committee has regulatory oversight responsibilities requiring compliance with external standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secretaryName rdf:type rdf:Property ;
    rdfs:label 'Secretary Name' ;
    rdfs:comment 'Full name of the individual serving as the committee secretary responsible for minutes and documentation.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityCommitteeStatus rdf:type rdf:Property ;
    rdfs:label 'Quality Committee Status' ;
    rdfs:comment 'Current operational status of the committee in its lifecycle.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityCommitteeType rdf:type rdf:Property ;
    rdfs:label 'Quality Committee Type' ;
    rdfs:comment 'Classification of the committee based on its primary function and scope of responsibility.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:viceChairName rdf:type rdf:Property ;
    rdfs:label 'Vice Chair Name' ;
    rdfs:comment 'Full name of the individual serving as the committee vice chair or co-chair.' ;
    rdfs:domain ind:QualityCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeStandardId rdf:type rdf:Property ;
    rdfs:label 'Exchange Standard Id' ;
    rdfs:comment 'Foreign key linking to interoperability.exchange_standard. Business justification: Research studies must document which data exchange standards (HL7 v2, FHIR, CDA) are used for regulatory submissions to FDA and data sharing with sponsors/registries per 21 CFR Part 11 compliance requ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExchangeStandard .

ind:principalInvestigatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Principal Investigator Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Principal investigators are institutional employees requiring credentialing, license verification, effort reporting, and IRB authorization. Essential for regulatory compliance (FDA 1572, ICH-GCP) and ' ;
    rdfs:domain ind:Research ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:therapeuticSpecialtyId rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Specialty Id' ;
    rdfs:comment 'Foreign key linking to provider.specialty. Business justification: Therapeutic specialty alignment enables research feasibility assessment, site selection based on clinical expertise, and principal investigator qualification verification. Healthcare operations use sp' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specialty .

ind:actualEnrollment rdf:type rdf:Property ;
    rdfs:label 'Actual Enrollment' ;
    rdfs:comment 'The actual number of subjects enrolled in the study to date.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amendmentCount rdf:type rdf:Property ;
    rdfs:label 'Amendment Count' ;
    rdfs:comment 'The total number of protocol amendments that have been issued for this study.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blindingType rdf:type rdf:Property ;
    rdfs:label 'Blinding Type' ;
    rdfs:comment 'The level of blinding or masking applied in the study design.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cfrPart11CompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Cfr Part 11 Compliant Flag' ;
    rdfs:comment 'Indicates whether the study is conducted in compliance with FDA 21 CFR Part 11 electronic records and electronic signatures requirements.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:controlType rdf:type rdf:Property ;
    rdfs:label 'Control Type' ;
    rdfs:comment 'The type of control used in the study design.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinatingCenter rdf:type rdf:Property ;
    rdfs:label 'Coordinating Center' ;
    rdfs:comment 'The name of the coordinating center or data coordinating center managing the multi-site study.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataMonitoringCommitteeFlag rdf:type rdf:Property ;
    rdfs:label 'Data Monitoring Committee Flag' ;
    rdfs:comment 'Indicates whether an independent Data Monitoring Committee or Data Safety Monitoring Board oversees the study.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enrollmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment End Date' ;
    rdfs:comment 'The date on which subject enrollment was closed or is planned to close.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Start Date' ;
    rdfs:comment 'The date on which subject enrollment began for this study.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fdaRegulatedDeviceFlag rdf:type rdf:Property ;
    rdfs:label 'Fda Regulated Device Flag' ;
    rdfs:comment 'Indicates whether the study involves an FDA-regulated device product.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fdaRegulatedDrugFlag rdf:type rdf:Property ;
    rdfs:label 'Fda Regulated Drug Flag' ;
    rdfs:comment 'Indicates whether the study involves an FDA-regulated drug product.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ideNumber rdf:type rdf:Property ;
    rdfs:label 'Ide Number' ;
    rdfs:comment 'The FDA-assigned Investigational Device Exemption number for device studies.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inclusionCriteria rdf:type rdf:Property ;
    rdfs:label 'Inclusion Criteria' ;
    rdfs:comment 'Summary of the key inclusion criteria that subjects must meet to be eligible for enrollment.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indNumber rdf:type rdf:Property ;
    rdfs:label 'Ind Number' ;
    rdfs:comment 'The FDA-assigned Investigational New Drug application number for drug studies.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irbApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Irb Approval Date' ;
    rdfs:comment 'The date on which the IRB granted initial approval for the study to commence.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:irbExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Irb Expiration Date' ;
    rdfs:comment 'The date on which the current IRB approval expires and requires renewal.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:irbProtocolNumber rdf:type rdf:Property ;
    rdfs:label 'Irb Protocol Number' ;
    rdfs:comment 'The protocol number assigned by the Institutional Review Board that approved the study.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nctIdentifier rdf:type rdf:Property ;
    rdfs:label 'Nct Identifier' ;
    rdfs:comment 'ClinicalTrials.gov registry identifier (NCT number) for the study. Required for applicable clinical trials under FDAAA 801.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phase rdf:type rdf:Property ;
    rdfs:label 'Phase' ;
    rdfs:comment 'The clinical trial phase (I, II, III, IV) indicating the stage of drug or device development. Not applicable for non-interventional studies. [ENUM-REF-CANDIDATE: phase_i|phase_ii|phase_iii|phase_iv|phase_i_ii|phase_ii_iii|not_applicable — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Primary Completion Date' ;
    rdfs:comment 'The date on which the last subject was examined or received an intervention for the purposes of final collection of data for the primary outcome.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primaryOutcomeMeasure rdf:type rdf:Property ;
    rdfs:label 'Primary Outcome Measure' ;
    rdfs:comment 'Description of the primary outcome measure or endpoint that the study is designed to assess.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protocolNumber rdf:type rdf:Property ;
    rdfs:label 'Protocol Number' ;
    rdfs:comment 'The official protocol number assigned to the research study by the sponsor or institution. Serves as the primary business identifier for the study.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protocolVersionDate rdf:type rdf:Property ;
    rdfs:label 'Protocol Version Date' ;
    rdfs:comment 'The effective date of the current protocol version.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:randomizationFlag rdf:type rdf:Property ;
    rdfs:label 'Randomization Flag' ;
    rdfs:comment 'Indicates whether the study employs randomization of subjects to treatment arms.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondaryOutcomeMeasures rdf:type rdf:Property ;
    rdfs:label 'Secondary Outcome Measures' ;
    rdfs:comment 'Description of secondary outcome measures or endpoints assessed in the study.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortTitle rdf:type rdf:Property ;
    rdfs:label 'Short Title' ;
    rdfs:comment 'Abbreviated or short title of the study for operational use and reporting.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorName rdf:type rdf:Property ;
    rdfs:label 'Sponsor Name' ;
    rdfs:comment 'The name of the organization or entity sponsoring the research study (pharmaceutical company, academic institution, government agency).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorType rdf:type rdf:Property ;
    rdfs:label 'Sponsor Type' ;
    rdfs:comment 'Classification of the sponsor organization type.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyType rdf:type rdf:Property ;
    rdfs:label 'Study Type' ;
    rdfs:comment 'Classification of the research study type indicating the nature of the investigation.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetEnrollment rdf:type rdf:Property ;
    rdfs:label 'Target Enrollment' ;
    rdfs:comment 'The planned total number of subjects to be enrolled in the study across all sites.' ;
    rdfs:domain ind:ResearchStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:irbSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Irb Submission Id' ;
    rdfs:comment 'Unique identifier for the IRB or federal agency regulatory submission record. Primary key.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IrbSubmission .

ind:consentPolicyId rdf:type rdf:Property ;
    rdfs:label 'Consent Policy Id' ;
    rdfs:comment 'Foreign key linking to consent.consent_policy. Business justification: IRB submissions must reference institutional consent policies to verify study consent procedures comply with organizational consent governance requirements. IRB reviewers validate consent form element' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentPolicy .

ind:primaryConditionIcdCodeId rdf:type rdf:Property ;
    rdfs:label 'Primary Condition Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: IRB submissions document the disease/condition under study using standardized ICD codes for regulatory review, risk assessment, and vulnerable population determination. Required for IRB protocol revie' ;
    rdfs:domain ind:IrbSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:primaryIrbEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Irb Employee Id' ;
    rdfs:comment 'Foreign key reference to the principal investigator responsible for this study and submission.' ;
    rdfs:domain ind:IrbSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:protocolAmendmentId rdf:type rdf:Property ;
    rdfs:label 'Protocol Amendment Id' ;
    rdfs:comment 'Foreign key linking to research.protocol_amendment. Business justification: IRB submissions can be for protocol amendments (not all submissions are for amendments - initial submissions are for the base protocol). Adding protocol_amendment_id as nullable FK enables tracking of' ;
    rdfs:domain ind:Research ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProtocolAmendment .

ind:tertiaryIrbReviewedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Irb Reviewed By User Employee Id' ;
    rdfs:comment 'Foreign key reference to the IRB member, reviewer, or federal agency officer who conducted the primary review of this submission.' ;
    rdfs:domain ind:IrbSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actionRequiredDescription rdf:type rdf:Property ;
    rdfs:label 'Action Required Description' ;
    rdfs:comment 'Detailed description of the actions required by the sponsor in response to the IRB or agency determination (e.g., \'Revise informed consent to clarify risks\', \'Provide additional safety data\').' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Action Required Flag' ;
    rdfs:comment 'Boolean indicator of whether sponsor action is required in response to this submission (e.g., address IRB stipulations, respond to FDA information request, submit additional data).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:agencyResponseLetter rdf:type rdf:Property ;
    rdfs:label 'Agency Response Letter' ;
    rdfs:comment 'Reference or summary of the official response letter or communication received from the IRB or federal agency regarding this submission.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionsOfApproval rdf:type rdf:Property ;
    rdfs:label 'Conditions Of Approval' ;
    rdfs:comment 'Any stipulations, modifications, or conditions imposed by the IRB or federal agency as part of the approval. May include required protocol changes, additional monitoring, or reporting requirements.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:determinationOutcome rdf:type rdf:Property ;
    rdfs:label 'Determination Outcome' ;
    rdfs:comment 'The IRB or agency\'s determination outcome: approved (full approval with no conditions), conditionally approved (approved pending minor modifications or clarifications), deferred (requires substantive revisions and re-review), disapproved (not approved), exempt determination (research qualifies for exemption), or not human subjects research (activity does not meet definition of human subjects research).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ectdSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Ectd Sequence Number' ;
    rdfs:comment 'The eCTD sequence number for FDA electronic submissions, used to track versions and amendments in the eCTD lifecycle.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:federalAgencyName rdf:type rdf:Property ;
    rdfs:label 'Federal Agency Name' ;
    rdfs:comment 'The name of the federal agency reviewing this submission (e.g., \'FDA Center for Drug Evaluation and Research\', \'FDA Center for Devices and Radiological Health\', \'OHRP\'). Applicable when reviewing_body_type is FDA, OHRP, or other federal agency.' ;
    rdfs:domain ind:IrbSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fwaNumber rdf:type rdf:Property ;
    rdfs:label 'Fwa Number' ;
    rdfs:comment 'The institution\'s Federalwide Assurance number issued by OHRP, which is the assurance of compliance with federal regulations for the protection of human subjects. Format: FWA followed by 8 digits.' ;
    rdfs:domain ind:IrbSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:informedConsentVersion rdf:type rdf:Property ;
    rdfs:label 'Informed Consent Version' ;
    rdfs:comment 'The version identifier of the informed consent document(s) submitted and reviewed as part of this submission.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irbBoardName rdf:type rdf:Property ;
    rdfs:label 'Irb Board Name' ;
    rdfs:comment 'The name of the specific IRB board or panel reviewing this submission (e.g., \'Main IRB\', \'Cancer Research IRB\', \'Pediatric IRB\'). Applicable when reviewing_body_type is IRB.' ;
    rdfs:domain ind:IrbSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nctNumber rdf:type rdf:Property ;
    rdfs:label 'Nct Number' ;
    rdfs:comment 'The ClinicalTrials.gov registry identifier for this study. Format: NCT followed by 8 digits. Required for applicable clinical trials under FDAAA 801.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewingBodyType rdf:type rdf:Property ;
    rdfs:label 'Reviewing Body Type' ;
    rdfs:comment 'The type of regulatory body reviewing this submission: IRB (Institutional Review Board), FDA (Food and Drug Administration), OHRP (Office for Human Research Protections), or other federal agency.' ;
    rdfs:domain ind:IrbSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskLevel rdf:type rdf:Property ;
    rdfs:label 'Risk Level' ;
    rdfs:comment 'The IRB\'s determination of the level of risk to human subjects: minimal risk (probability and magnitude of harm not greater than ordinary life) or greater than minimal risk.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorOrganization rdf:type rdf:Property ;
    rdfs:label 'Sponsor Organization' ;
    rdfs:comment 'The name of the organization or entity sponsoring the research study (e.g., pharmaceutical company, academic institution, government agency).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionNotes rdf:type rdf:Property ;
    rdfs:label 'Submission Notes' ;
    rdfs:comment 'Additional notes, comments, or context regarding this submission, including internal tracking information or special circumstances.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionNumber rdf:type rdf:Property ;
    rdfs:label 'Submission Number' ;
    rdfs:comment 'The externally-known unique identifier or control number assigned by the IRB or federal agency to this submission (e.g., IRB protocol number, IND number, IDE number).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vulnerablePopulationFlag rdf:type rdf:Property ;
    rdfs:label 'Vulnerable Population Flag' ;
    rdfs:comment 'Boolean indicator of whether the study involves vulnerable populations requiring additional protections (e.g., children, prisoners, pregnant women, cognitively impaired individuals).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vulnerablePopulationType rdf:type rdf:Property ;
    rdfs:label 'Vulnerable Population Type' ;
    rdfs:comment 'The specific type of vulnerable population involved in the study, requiring additional regulatory protections and IRB review considerations.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studySiteId rdf:type rdf:Property ;
    rdfs:label 'Study Site Id' ;
    rdfs:comment 'Unique identifier for the study site participating in a clinical trial. Primary key.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StudySite .

ind:siteCoordinatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Site Coordinator Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Site coordinators are institutional employees managing local study operations, subject scheduling, regulatory binder maintenance, and monitoring visit coordination. Required for workload tracking, GCP' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualEnrollmentCount rdf:type rdf:Property ;
    rdfs:label 'Actual Enrollment Count' ;
    rdfs:comment 'Actual number of subjects enrolled at this site to date.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveActionPlanDueDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Due Date' ;
    rdfs:comment 'Date by which the site must submit or complete the corrective action plan to address identified deficiencies.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionPlanRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Required Flag' ;
    rdfs:comment 'Indicates whether a corrective action plan is currently required to address findings from monitoring visits or audits.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:croOrganizationName rdf:type rdf:Property ;
    rdfs:label 'Cro Organization Name' ;
    rdfs:comment 'Name of the CRO contracted to manage site monitoring and oversight activities, if applicable.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQueryCount rdf:type rdf:Property ;
    rdfs:label 'Data Query Count' ;
    rdfs:comment 'Total number of data clarification queries issued to this site for case report form discrepancies or missing data.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enrollmentRatePerMonth rdf:type rdf:Property ;
    rdfs:label 'Enrollment Rate Per Month' ;
    rdfs:comment 'Average number of subjects enrolled per month at this site, used for performance tracking and forecasting.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:informedConsentComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Informed Consent Compliance Status' ;
    rdfs:comment 'Assessment of the sites compliance with informed consent procedures and documentation requirements.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationalProductAccountabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Investigational Product Accountability Status' ;
    rdfs:comment 'Current status of investigational drug or device accountability and inventory reconciliation at this site.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irbApprovalNumber rdf:type rdf:Property ;
    rdfs:label 'Irb Approval Number' ;
    rdfs:comment 'IRB-assigned approval number or reference for the study protocol at this site.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irbOfRecordName rdf:type rdf:Property ;
    rdfs:label 'Irb Of Record Name' ;
    rdfs:comment 'Name of the IRB or ethics committee responsible for reviewing and approving the study at this site.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastMonitoringVisitDate rdf:type rdf:Property ;
    rdfs:label 'Last Monitoring Visit Date' ;
    rdfs:comment 'Date of the most recent monitoring visit conducted at this site.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastMonitoringVisitType rdf:type rdf:Property ;
    rdfs:label 'Last Monitoring Visit Type' ;
    rdfs:comment 'Type of the most recent monitoring visit conducted at this site.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextMonitoringVisitScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Next Monitoring Visit Scheduled Date' ;
    rdfs:comment 'Planned date for the next scheduled monitoring visit at this site.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:openDataQueryCount rdf:type rdf:Property ;
    rdfs:label 'Open Data Query Count' ;
    rdfs:comment 'Number of data queries currently outstanding and awaiting site response or resolution.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:plannedEnrollmentCapacity rdf:type rdf:Property ;
    rdfs:label 'Planned Enrollment Capacity' ;
    rdfs:comment 'Target number of subjects the site is expected to enroll in the clinical trial based on site capabilities and protocol requirements.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:protocolDeviationCount rdf:type rdf:Property ;
    rdfs:label 'Protocol Deviation Count' ;
    rdfs:comment 'Total number of protocol deviations identified at this site across all monitoring visits and audits.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryBinderStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Binder Status' ;
    rdfs:comment 'Current completeness status of the site regulatory binder containing all required regulatory documents and approvals.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screenFailureCount rdf:type rdf:Property ;
    rdfs:label 'Screen Failure Count' ;
    rdfs:comment 'Number of subjects who were screened but failed to meet eligibility criteria and were not enrolled at this site.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seriousAdverseEventCount rdf:type rdf:Property ;
    rdfs:label 'Serious Adverse Event Count' ;
    rdfs:comment 'Number of serious adverse events reported from subjects enrolled at this site, requiring expedited reporting.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seriousProtocolDeviationCount rdf:type rdf:Property ;
    rdfs:label 'Serious Protocol Deviation Count' ;
    rdfs:comment 'Number of serious or major protocol deviations that may impact subject safety or data integrity at this site.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:siteNotes rdf:type rdf:Property ;
    rdfs:label 'Site Notes' ;
    rdfs:comment 'Free-text notes capturing important site-specific information, special considerations, or historical context.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteNumber rdf:type rdf:Property ;
    rdfs:label 'Site Number' ;
    rdfs:comment 'Sponsor-assigned unique site number within the clinical trial. Used for regulatory reporting and site identification across study documentation.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sitePerformanceScore rdf:type rdf:Property ;
    rdfs:label 'Site Performance Score' ;
    rdfs:comment 'Composite performance score for the site based on enrollment rate, data quality, protocol compliance, and query resolution metrics.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:siteRiskRating rdf:type rdf:Property ;
    rdfs:label 'Site Risk Rating' ;
    rdfs:comment 'Overall risk assessment of the site based on performance metrics, compliance history, and monitoring findings.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDocumentVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Source Document Verification Status' ;
    rdfs:comment 'Current status of source document verification activities comparing case report forms to original medical records.' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorOrganizationName rdf:type rdf:Property ;
    rdfs:label 'Sponsor Organization Name' ;
    rdfs:comment 'Name of the organization sponsoring the clinical trial (pharmaceutical company, academic institution, or government agency).' ;
    rdfs:domain ind:StudySite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeOfPrivacyPracticesId rdf:type rdf:Property ;
    rdfs:label 'Notice Of Privacy Practices Id' ;
    rdfs:comment 'Foreign key linking to compliance.notice_of_privacy_practices. Business justification: Research subjects must receive NPP at enrollment per HIPAA. NPP distribution is documented per enrollment for compliance with Privacy Rule requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NoticeOfPrivacyPractices .

ind:primarySubjectStudyResearchStudyId rdf:type rdf:Property ;
    rdfs:label 'Primary Subject Study Research Study Id' ;
    rdfs:comment 'Unique study-specific identifier assigned to the research subject, distinct from Medical Record Number (MRN). Used for de-identification and research data governance.' ;
    rdfs:domain ind:SubjectEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchStudy .

ind:studyArmId rdf:type rdf:Property ;
    rdfs:label 'Study Arm Id' ;
    rdfs:comment 'Foreign key linking to research.study_arm. Business justification: Enrolled subjects are randomized to study arms. Currently has randomization_arm (STRING) but no FK to study_arm master. Adding study_arm_id FK allows removal of redundant randomization_arm column whic' ;
    rdfs:domain ind:Research ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StudyArm .

ind:adverseEventFlag rdf:type rdf:Property ;
    rdfs:label 'Adverse Event Flag' ;
    rdfs:comment 'Indicates whether any adverse events were reported for this subject during the enrollment period. True if adverse events exist, False otherwise.' ;
    rdfs:domain ind:SubjectEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataLockFlag rdf:type rdf:Property ;
    rdfs:label 'Data Lock Flag' ;
    rdfs:comment 'Indicates whether this enrollment record has been locked for final analysis and regulatory submission. True if locked, False if still editable.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataLockTimestamp rdf:type rdf:Property ;
    rdfs:label 'Data Lock Timestamp' ;
    rdfs:comment 'Timestamp when this enrollment record was locked for final analysis. Null if not yet locked.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataMonitoringCommitteeReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Data Monitoring Committee Review Flag' ;
    rdfs:comment 'Indicates whether this subject enrollment was reviewed by the Data Monitoring Committee. True if reviewed, False otherwise.' ;
    rdfs:domain ind:SubjectEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eligibilityConfirmedFlag rdf:type rdf:Property ;
    rdfs:label 'Eligibility Confirmed Flag' ;
    rdfs:comment 'Indicates whether the subject met all inclusion criteria and no exclusion criteria at the time of enrollment. True if eligibility was confirmed, False otherwise.' ;
    rdfs:domain ind:SubjectEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enrollmentNotes rdf:type rdf:Property ;
    rdfs:label 'Enrollment Notes' ;
    rdfs:comment 'Free-text notes or comments related to the subject enrollment, including special circumstances, protocol-specific observations, or administrative remarks.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:informedConsentDate rdf:type rdf:Property ;
    rdfs:label 'Informed Consent Date' ;
    rdfs:comment 'Date when the subject provided informed consent to participate in the research study.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investigationalProductDispensedFlag rdf:type rdf:Property ;
    rdfs:label 'Investigational Product Dispensed Flag' ;
    rdfs:comment 'Indicates whether investigational drug or device was dispensed to this subject. True if product was dispensed, False otherwise.' ;
    rdfs:domain ind:SubjectEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:protocolDeviationFlag rdf:type rdf:Property ;
    rdfs:label 'Protocol Deviation Flag' ;
    rdfs:comment 'Indicates whether any protocol deviations occurred during this subject enrollment. True if deviations were recorded, False otherwise.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seriousAdverseEventFlag rdf:type rdf:Property ;
    rdfs:label 'Serious Adverse Event Flag' ;
    rdfs:comment 'Indicates whether any serious adverse events were reported for this subject. True if serious adverse events exist, False otherwise.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stratificationFactors rdf:type rdf:Property ;
    rdfs:label 'Stratification Factors' ;
    rdfs:comment 'Demographic or clinical characteristics used to stratify the subject during randomization (e.g., age group, disease stage, biomarker status). Stored as structured text or delimited values.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withdrawalDate rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Date' ;
    rdfs:comment 'Date when the subject withdrew from the study or was withdrawn by the investigator prior to completion.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:withdrawalReason rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Reason' ;
    rdfs:comment 'Reason for subject withdrawal from the study (e.g., adverse event, subject request, protocol violation, lost to follow-up, investigator decision).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:informedConsentId rdf:type rdf:Property ;
    rdfs:label 'Informed Consent Id' ;
    rdfs:comment 'Unique identifier for the informed consent record. Primary key for the informed consent data product.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attestationId rdf:type rdf:Property ;
    rdfs:label 'Attestation Id' ;
    rdfs:comment 'Foreign key linking to compliance.attestation. Business justification: Informed consent processes require staff attestation of training and competency. Regulatory requirement for consent administrators to attest to proper training and understanding.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Attestation .

ind:capacityAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Capacity Assessment Id' ;
    rdfs:comment 'Foreign key linking to consent.consent_capacity_assessment. Business justification: Research informed consent requires documented capacity assessment when subject\'s ability to consent is questioned. Regulatory requirement (21 CFR 50.20, ICH-GCP 4.8.9) mandates capacity determination ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapacityAssessment .

ind:consentingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Consenting Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Consenting clinician is required for regulatory compliance (21 CFR 50, ICH-GCP) and informed consent documentation. Healthcare operations track which credentialed clinician obtained consent for audit ' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:informedLastModifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Informed Last Modified By User Employee Id' ;
    rdfs:comment 'User ID of the system user who last modified this informed consent record. Part of audit trail for regulatory compliance.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:informedObtainedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Informed Obtained By User Employee Id' ;
    rdfs:comment 'User ID of the system user who created this informed consent record. Part of audit trail for regulatory compliance.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryInformedEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Informed Employee Id' ;
    rdfs:comment 'Identifier of the research staff member who obtained the informed consent. Must be a qualified and trained individual per protocol.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:capacityAssessmentPerformed rdf:type rdf:Property ;
    rdfs:label 'Capacity Assessment Performed' ;
    rdfs:comment 'Indicates whether a formal assessment of the subject\'s capacity to consent was performed. Required for vulnerable populations or when capacity is in question.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentComprehensionAssessed rdf:type rdf:Property ;
    rdfs:label 'Consent Comprehension Assessed' ;
    rdfs:comment 'Indicates whether the subject\'s comprehension of the informed consent was formally assessed (e.g., via teach-back method or comprehension quiz). Recommended for complex protocols.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentCopyProvidedDate rdf:type rdf:Property ;
    rdfs:label 'Consent Copy Provided Date' ;
    rdfs:comment 'Date on which a copy of the signed informed consent form was provided to the subject. Should match or closely follow consent date.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentCopyProvidedFlag rdf:type rdf:Property ;
    rdfs:label 'Consent Copy Provided Flag' ;
    rdfs:comment 'Indicates whether a copy of the signed informed consent form was provided to the subject or legally authorized representative. Required by FDA and ICH guidelines.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentDiscussionDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Consent Discussion Duration Minutes' ;
    rdfs:comment 'Duration in minutes of the informed consent discussion with the subject. Captured to demonstrate adequate time for subject comprehension and questions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentDocumentLocation rdf:type rdf:Property ;
    rdfs:label 'Consent Document Location' ;
    rdfs:comment 'Physical or electronic location where the original signed informed consent document is stored (e.g., regulatory binder, document management system path). Required for regulatory inspection readiness.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentTime rdf:type rdf:Property ;
    rdfs:label 'Consent Time' ;
    rdfs:comment 'Precise timestamp when the informed consent was obtained, including time zone. Required for electronic consent systems and audit trails.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:consentVersionNumber rdf:type rdf:Property ;
    rdfs:label 'Consent Version Number' ;
    rdfs:comment 'Version number of the consent form template used at the time of consent. Ensures traceability to the specific IRB-approved version.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electronicSignatureReference rdf:type rdf:Property ;
    rdfs:label 'Electronic Signature Reference' ;
    rdfs:comment 'Unique identifier of the electronic signature captured via eConsent platform. Null for paper-based consents. Must comply with 21 CFR Part 11 requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaAuthorizationDate rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization Date' ;
    rdfs:comment 'Date on which HIPAA authorization was obtained. Null if HIPAA authorization was not required or not included.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hipaaAuthorizationIncluded rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization Included' ;
    rdfs:comment 'Indicates whether HIPAA authorization for use and disclosure of Protected Health Information (PHI) was included in this consent. Required for research involving PHI in the United States.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interpreterName rdf:type rdf:Property ;
    rdfs:label 'Interpreter Name' ;
    rdfs:comment 'Full name of the interpreter who assisted with the informed consent process. Null if no interpreter was used.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:larConsentIndicator rdf:type rdf:Property ;
    rdfs:label 'Lar Consent Indicator' ;
    rdfs:comment 'Indicates whether consent was obtained from a legally authorized representative rather than the subject. True when subject lacks capacity to consent.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:larName rdf:type rdf:Property ;
    rdfs:label 'Lar Name' ;
    rdfs:comment 'Full name of the legally authorized representative who provided consent on behalf of the subject. Null if consent was obtained directly from subject.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:larRelationship rdf:type rdf:Property ;
    rdfs:label 'Lar Relationship' ;
    rdfs:comment 'Relationship of the legally authorized representative to the subject (e.g., parent, guardian, healthcare proxy, power of attorney). Null if consent was obtained directly from subject.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reConsentDate rdf:type rdf:Property ;
    rdfs:label 'Re Consent Date' ;
    rdfs:comment 'Date on which re-consent was obtained due to protocol amendments or new information. Null if no re-consent has occurred.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subjectQuestionsAddressedFlag rdf:type rdf:Property ;
    rdfs:label 'Subject Questions Addressed Flag' ;
    rdfs:comment 'Indicates whether all subject questions were addressed during the informed consent process. True confirms subject had opportunity to ask questions and received answers.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subjectSignatureDate rdf:type rdf:Property ;
    rdfs:label 'Subject Signature Date' ;
    rdfs:comment 'Date on which the subject signed the informed consent form. Must match or precede consent date.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subjectSignatureIndicator rdf:type rdf:Property ;
    rdfs:label 'Subject Signature Indicator' ;
    rdfs:comment 'Indicates whether the subject provided a signature on the informed consent form. True for signed consents; false for verbal consent with witness or LAR consent.' ;
    rdfs:domain ind:InformedConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Author Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Protocol amendments are authored by institutional research staff (PIs, research coordinators, regulatory specialists). Tracking authorship supports accountability, workload assessment, and quality met' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supersededByProtocolAmendmentId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Protocol Amendment Id' ;
    rdfs:comment 'Reference to a subsequent amendment that supersedes this one, supporting version history tracking.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProtocolAmendment .

ind:amendmentDate rdf:type rdf:Property ;
    rdfs:label 'Amendment Date' ;
    rdfs:comment 'Date when the amendment was formally created or drafted. Represents the principal business event timestamp for this amendment.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amendmentDescription rdf:type rdf:Property ;
    rdfs:label 'Amendment Description' ;
    rdfs:comment 'Detailed narrative description of the changes introduced by this amendment, including specific sections of the protocol modified.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Amendment Document Url' ;
    rdfs:comment 'URL or file path to the official amendment document stored in the document management system.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentNumber rdf:type rdf:Property ;
    rdfs:label 'Amendment Number' ;
    rdfs:comment 'Sequential or hierarchical identifier for this amendment (e.g., Amendment 1, Amendment 2.1). Serves as the business-facing amendment identifier.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentStatus rdf:type rdf:Property ;
    rdfs:label 'Amendment Status' ;
    rdfs:comment 'Current lifecycle status of the amendment (draft, submitted to IRB, IRB approved, submitted to FDA, FDA approved, sponsor approved, implemented, withdrawn, superseded). [ENUM-REF-CANDIDATE: draft|submitted_to_irb|irb_approved|submitted_to_fda|fda_approved|sponsor_approved|implemented|withdrawn|superseded — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentTitle rdf:type rdf:Property ;
    rdfs:label 'Amendment Title' ;
    rdfs:comment 'Brief descriptive title summarizing the purpose or focus of this amendment.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentType rdf:type rdf:Property ;
    rdfs:label 'Amendment Type' ;
    rdfs:comment 'Classification of the amendment based on the nature and impact of the change (substantial, administrative, minor, safety-related, protocol deviation correction, eligibility criteria change).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentVersion rdf:type rdf:Property ;
    rdfs:label 'Amendment Version' ;
    rdfs:comment 'Version identifier for this amendment document, supporting full version history tracking for regulatory audit readiness.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fdaAcknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Fda Acknowledgment Date' ;
    rdfs:comment 'Date when the FDA acknowledged receipt of the IND amendment submission.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fdaSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Fda Submission Date' ;
    rdfs:comment 'Date when the amendment was submitted to the FDA as part of an Investigational New Drug (IND) amendment.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fdaSubmissionReference rdf:type rdf:Property ;
    rdfs:label 'Fda Submission Reference' ;
    rdfs:comment 'Reference number for the FDA submission (e.g., IND amendment number) associated with this protocol amendment.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactAssessmentEfficacy rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment Efficacy' ;
    rdfs:comment 'Assessment of the amendments impact on study efficacy endpoints, statistical power, and scientific validity.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactAssessmentEnrollment rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment Enrollment' ;
    rdfs:comment 'Assessment of the amendments impact on study enrollment, including changes to eligibility criteria, recruitment strategies, or target enrollment numbers.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactAssessmentOperational rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment Operational' ;
    rdfs:comment 'Assessment of the amendments impact on study operations, site procedures, data collection, and resource requirements.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactAssessmentSafety rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment Safety' ;
    rdfs:comment 'Assessment of the amendments impact on participant safety, including any new risks introduced or mitigated.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationDate rdf:type rdf:Property ;
    rdfs:label 'Implementation Date' ;
    rdfs:comment 'Date when this amendment was implemented and became effective across study sites.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:informedConsentUpdateRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Informed Consent Update Required Flag' ;
    rdfs:comment 'Indicates whether this amendment requires updates to the informed consent form and re-consenting of enrolled participants.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:irbSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Irb Submission Date' ;
    rdfs:comment 'Date when the amendment was submitted to the IRB for review and approval.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:irbSubmissionReference rdf:type rdf:Property ;
    rdfs:label 'Irb Submission Reference' ;
    rdfs:comment 'Reference number or identifier for the IRB submission package associated with this amendment.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protocolSectionsModified rdf:type rdf:Property ;
    rdfs:label 'Protocol Sections Modified' ;
    rdfs:comment 'List or description of specific protocol sections modified by this amendment (e.g., Section 5.2 Inclusion Criteria, Section 8.1 Dosing Schedule).' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonForAmendment rdf:type rdf:Property ;
    rdfs:label 'Reason For Amendment' ;
    rdfs:comment 'Business and scientific rationale explaining why this amendment was necessary (e.g., safety concerns, enrollment challenges, new scientific data, regulatory feedback).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconsentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Reconsent Required Flag' ;
    rdfs:comment 'Indicates whether currently enrolled participants must be re-consented under the amended protocol.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required Flag' ;
    rdfs:comment 'Indicates whether this amendment must be reported to regulatory authorities beyond the FDA (e.g., international regulatory bodies).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:siteImplementationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Site Implementation Required Flag' ;
    rdfs:comment 'Indicates whether this amendment requires implementation actions at individual study sites (True) or is administrative only (False).' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sponsorApprovalAuthority rdf:type rdf:Property ;
    rdfs:label 'Sponsor Approval Authority' ;
    rdfs:comment 'Name or role of the sponsor representative who authorized approval of this amendment.' ;
    rdfs:domain ind:ProtocolAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryStudyEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Study Employee Id' ;
    rdfs:comment 'Reference to the research coordinator or clinical research associate assigned to manage and document this visit.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualDate rdf:type rdf:Property ;
    rdfs:label 'Actual Date' ;
    rdfs:comment 'The date on which the visit actually occurred. May differ from scheduled_date if the visit was rescheduled or occurred outside the protocol window.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adverseEventReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Adverse Event Reported Flag' ;
    rdfs:comment 'Boolean indicator of whether any adverse events were reported or documented during this visit. True indicates at least one adverse event was captured.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assessmentsCompletedCount rdf:type rdf:Property ;
    rdfs:label 'Assessments Completed Count' ;
    rdfs:comment 'The number of protocol-required assessments (procedures, questionnaires, lab tests, imaging studies) that were successfully completed during this visit.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assessmentsMissedCount rdf:type rdf:Property ;
    rdfs:label 'Assessments Missed Count' ;
    rdfs:comment 'The number of protocol-required assessments that were not completed during this visit. Indicates potential protocol deviations.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:compliancePercentage rdf:type rdf:Property ;
    rdfs:label 'Compliance Percentage' ;
    rdfs:comment 'Calculated percentage of protocol-required assessments and procedures that were successfully completed during this visit. Used to track subject adherence and protocol compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataEntryCompleteFlag rdf:type rdf:Property ;
    rdfs:label 'Data Entry Complete Flag' ;
    rdfs:comment 'Boolean indicator of whether all data from this visit has been entered into the electronic data capture (EDC) system. True indicates data entry is complete and the visit record is ready for monitoring or query resolution.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:informedConsentReaffirmedFlag rdf:type rdf:Property ;
    rdfs:label 'Informed Consent Reaffirmed Flag' ;
    rdfs:comment 'Boolean indicator of whether informed consent was reaffirmed or re-consented during this visit (e.g., due to protocol amendments or new risks). True indicates consent was reaffirmed.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:missedVisitReason rdf:type rdf:Property ;
    rdfs:label 'Missed Visit Reason' ;
    rdfs:comment 'Reason why the subject missed the scheduled visit if visit_status is missed (e.g., subject no-show, illness, transportation issues, lost to follow-up).' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protocolDeviationDescription rdf:type rdf:Property ;
    rdfs:label 'Protocol Deviation Description' ;
    rdfs:comment 'Detailed narrative description of any protocol deviations that occurred during this visit, including the nature of the deviation and any corrective actions taken.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryOpenCount rdf:type rdf:Property ;
    rdfs:label 'Query Open Count' ;
    rdfs:comment 'The number of open data queries associated with this visit that require resolution by the site. Used to track data quality and cleaning progress.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceDataVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Source Data Verified Flag' ;
    rdfs:comment 'Boolean indicator of whether the visit data has been verified against source documents by a clinical research associate or monitor. True indicates source data verification (SDV) is complete.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:studyDrugDispensedFlag rdf:type rdf:Property ;
    rdfs:label 'Study Drug Dispensed Flag' ;
    rdfs:comment 'Boolean indicator of whether investigational drug or device was dispensed to the subject during this visit. True indicates study product was provided.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:studyDrugReturnedFlag rdf:type rdf:Property ;
    rdfs:label 'Study Drug Returned Flag' ;
    rdfs:comment 'Boolean indicator of whether the subject returned unused investigational drug or device during this visit for accountability tracking. True indicates product was returned.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:visitDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Visit Duration Minutes' ;
    rdfs:comment 'The total duration of the visit in minutes, from check-in to check-out. Used for operational planning and subject burden assessment.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:visitLocation rdf:type rdf:Property ;
    rdfs:label 'Visit Location' ;
    rdfs:comment 'The physical or virtual location where the visit was conducted (e.g., research clinic, hospital site, subject home, telehealth platform). Important for multi-site studies and decentralized trials.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visitLockedFlag rdf:type rdf:Property ;
    rdfs:label 'Visit Locked Flag' ;
    rdfs:comment 'Boolean indicator of whether the visit data has been locked in the EDC system, preventing further edits. True indicates the visit is locked and considered final for analysis.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:visitLockedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Visit Locked Timestamp' ;
    rdfs:comment 'The date and time when the visit data was locked in the EDC system. Null if the visit is not yet locked.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:visitName rdf:type rdf:Property ;
    rdfs:label 'Visit Name' ;
    rdfs:comment 'Human-readable name or label for the visit as defined in the protocol (e.g., Screening Visit, Baseline Assessment, Week 12 Follow-up, End of Study).' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visitNotes rdf:type rdf:Property ;
    rdfs:label 'Visit Notes' ;
    rdfs:comment 'Free-text clinical notes or observations documented by the study coordinator or investigator during the visit. May include subject comments, logistical issues, or contextual information.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visitNumber rdf:type rdf:Property ;
    rdfs:label 'Visit Number' ;
    rdfs:comment 'Protocol-defined visit number or identifier (e.g., V1, V2, V3, Screening, Baseline, Week 4, Month 6). Corresponds to the schedule of assessments in the study protocol.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visitWindowEndDate rdf:type rdf:Property ;
    rdfs:label 'Visit Window End Date' ;
    rdfs:comment 'The latest date within the protocol-defined visit window during which the visit may be conducted while remaining compliant with the study protocol.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:visitWindowStartDate rdf:type rdf:Property ;
    rdfs:label 'Visit Window Start Date' ;
    rdfs:comment 'The earliest date within the protocol-defined visit window during which the visit may be conducted while remaining compliant with the study protocol.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:visitWindowStatus rdf:type rdf:Property ;
    rdfs:label 'Visit Window Status' ;
    rdfs:comment 'Indicates whether the actual visit date fell within the protocol-defined visit window. Within_window indicates compliance, early indicates the visit occurred before the window opened, late indicates the visit occurred after the window closed, and out_of_window indicates significant protocol deviation.' ;
    rdfs:domain ind:StudyVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adverseEventId rdf:type rdf:Property ;
    rdfs:label 'Adverse Event Id' ;
    rdfs:comment 'Unique identifier for the adverse event or protocol deviation record. Primary key for the adverse event data product.' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Reporting Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Reporting clinician is tracked for adverse event causality assessment, safety monitoring, and regulatory reporting (FDA MedWatch, IRB reporting). Healthcare operations require credentialed clinician a' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:aeTerm rdf:type rdf:Property ;
    rdfs:label 'Ae Term' ;
    rdfs:comment 'Medical term describing the adverse event using standardized medical terminology (typically MedDRA preferred term).' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capaCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Capa Completion Date' ;
    rdfs:comment 'Date when the corrective and preventive action plan was completed and verified.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capaDescription rdf:type rdf:Property ;
    rdfs:label 'Capa Description' ;
    rdfs:comment 'Description of corrective and preventive actions (CAPA) taken to address the protocol deviation or quality event and prevent recurrence.' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:causalityAssessment rdf:type rdf:Property ;
    rdfs:label 'Causality Assessment' ;
    rdfs:comment 'Investigator assessment of the relationship between the adverse event and the investigational product or study procedure: not related, unlikely, possible, probable, or definite.' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviationCategory rdf:type rdf:Property ;
    rdfs:label 'Deviation Category' ;
    rdfs:comment 'Category of protocol deviation: eligibility criteria violation, informed consent issue, dosing error, visit window violation, data collection error, procedure deviation, or other. [ENUM-REF-CANDIDATE: eligibility|informed_consent|dosing|visit_window|data_collection|procedure|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviationDescription rdf:type rdf:Property ;
    rdfs:label 'Deviation Description' ;
    rdfs:comment 'Detailed description of the protocol deviation or violation, including what occurred and how it deviated from the approved protocol.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviationSeverity rdf:type rdf:Property ;
    rdfs:label 'Deviation Severity' ;
    rdfs:comment 'Severity classification of the protocol deviation: minor (no impact on subject safety or data integrity), major (potential impact), or critical (significant impact requiring immediate action).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveryDate rdf:type rdf:Property ;
    rdfs:label 'Discovery Date' ;
    rdfs:comment 'Date when the protocol deviation or quality event was discovered or identified.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expectedness rdf:type rdf:Property ;
    rdfs:label 'Expectedness' ;
    rdfs:comment 'Indicates whether the adverse event was expected (consistent with the investigator brochure or product labeling) or unexpected.' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expeditedReportDate rdf:type rdf:Property ;
    rdfs:label 'Expedited Report Date' ;
    rdfs:comment 'Date when the expedited safety report was submitted to regulatory authorities or IRB.' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expeditedReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Expedited Reporting Flag' ;
    rdfs:comment 'Indicates whether this adverse event requires expedited reporting to regulatory authorities (FDA, IRB) within specified timelines (typically 7 or 15 days for serious, unexpected, and related events).' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Date' ;
    rdfs:comment 'Date when follow-up information was obtained or is scheduled to be obtained for this adverse event.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Required Flag' ;
    rdfs:comment 'Indicates whether additional follow-up information is required for this adverse event or protocol deviation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impactOnDataIntegrity rdf:type rdf:Property ;
    rdfs:label 'Impact On Data Integrity' ;
    rdfs:comment 'Assessment of the protocol deviation or quality event impact on data integrity and study results: none, minimal, moderate, or significant.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactOnSubjectSafety rdf:type rdf:Property ;
    rdfs:label 'Impact On Subject Safety' ;
    rdfs:comment 'Assessment of the protocol deviation or quality event impact on subject safety: none, minimal, moderate, or significant.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irbReportDate rdf:type rdf:Property ;
    rdfs:label 'Irb Report Date' ;
    rdfs:comment 'Date when the adverse event or protocol deviation report was submitted to the IRB.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:irbReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Irb Reportable Flag' ;
    rdfs:comment 'Indicates whether this adverse event or protocol deviation requires reporting to the Institutional Review Board (IRB) per institutional policy and federal regulations.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meddraCode rdf:type rdf:Property ;
    rdfs:label 'Meddra Code' ;
    rdfs:comment 'MedDRA code for the adverse event term, enabling standardized reporting and analysis of safety data.' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meddraVersion rdf:type rdf:Property ;
    rdfs:label 'Meddra Version' ;
    rdfs:comment 'Version of the MedDRA dictionary used for coding the adverse event term.' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medwatchReportNumber rdf:type rdf:Property ;
    rdfs:label 'Medwatch Report Number' ;
    rdfs:comment 'FDA MedWatch (Form 3500A) report number if an expedited safety report was submitted to the FDA.' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:narrative rdf:type rdf:Property ;
    rdfs:label 'Narrative' ;
    rdfs:comment 'Detailed narrative description of the adverse event or protocol deviation, including clinical course, treatment, and outcome. Used for regulatory submissions and safety reviews.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportDate rdf:type rdf:Property ;
    rdfs:label 'Report Date' ;
    rdfs:comment 'Date when the adverse event or protocol deviation was initially reported to the research team or entered into the safety database.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rootCause rdf:type rdf:Property ;
    rdfs:label 'Root Cause' ;
    rdfs:comment 'Root cause analysis of the protocol deviation or quality event, identifying underlying factors that contributed to the occurrence.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seriousnessCriteria rdf:type rdf:Property ;
    rdfs:label 'Seriousness Criteria' ;
    rdfs:comment 'Specific seriousness criteria met by the adverse event: death, life-threatening, hospitalization (initial or prolonged), disability/incapacity, congenital anomaly, or other medically important condition. Multiple criteria may apply.' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seriousnessFlag rdf:type rdf:Property ;
    rdfs:label 'Seriousness Flag' ;
    rdfs:comment 'Indicates whether the adverse event meets regulatory criteria for seriousness (death, life-threatening, hospitalization, disability, congenital anomaly, or other medically important condition).' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:severityGrade rdf:type rdf:Property ;
    rdfs:label 'Severity Grade' ;
    rdfs:comment 'Severity grade of the adverse event using CTCAE scale: Grade 1 (mild), Grade 2 (moderate), Grade 3 (severe), Grade 4 (life-threatening), Grade 5 (death).' ;
    rdfs:domain ind:AdverseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorReportDate rdf:type rdf:Property ;
    rdfs:label 'Sponsor Report Date' ;
    rdfs:comment 'Date when the adverse event or protocol deviation report was submitted to the study sponsor.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sponsorReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Sponsor Reportable Flag' ;
    rdfs:comment 'Indicates whether this adverse event or protocol deviation requires reporting to the study sponsor per the clinical trial agreement.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionScreeningId rdf:type rdf:Property ;
    rdfs:label 'Exclusion Screening Id' ;
    rdfs:comment 'Foreign key linking to compliance.exclusion_screening. Business justification: Investigational product manufacturers/suppliers must be screened against exclusion lists (OIG, SAM, FDA debarment). Standard procurement compliance for federally funded research.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExclusionScreening .

ind:accountabilityRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Accountability Required Flag' ;
    rdfs:comment 'Indicates whether detailed product accountability records (receipt, dispensing, return, destruction) are required for regulatory compliance.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adverseEventReportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Adverse Event Reporting Required Flag' ;
    rdfs:comment 'Indicates whether adverse events related to this investigational product must be reported to regulatory authorities and IRB per safety monitoring requirements.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:comparatorIndicator rdf:type rdf:Property ;
    rdfs:label 'Comparator Indicator' ;
    rdfs:comment 'Indicates whether this investigational product serves as an active comparator or control arm product in the clinical trial.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataGovernanceClassification rdf:type rdf:Property ;
    rdfs:label 'Data Governance Classification' ;
    rdfs:comment 'Data governance classification level for investigational product data (e.g., identifiable, de-identified, limited dataset) per research data governance policies.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expirationManagementRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Expiration Management Required Flag' ;
    rdfs:comment 'Indicates whether expiration date tracking and management is required for this investigational product to ensure product integrity and subject safety.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:formulation rdf:type rdf:Property ;
    rdfs:label 'Formulation' ;
    rdfs:comment 'Detailed formulation description including active ingredients, excipients, and composition for drugs/biologics, or material composition for devices.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indIdeNumber rdf:type rdf:Property ;
    rdfs:label 'Ind Ide Number' ;
    rdfs:comment 'FDA-assigned IND number for investigational drugs/biologics or IDE number for investigational devices. Required for clinical trial regulatory compliance.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indication rdf:type rdf:Property ;
    rdfs:label 'Indication' ;
    rdfs:comment 'Specific disease, condition, or indication for which the investigational product is being studied in the clinical trial.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:informedConsentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Informed Consent Required Flag' ;
    rdfs:comment 'Indicates whether informed consent is required from subjects before administration of this investigational product.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:irbApprovalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Irb Approval Required Flag' ;
    rdfs:comment 'Indicates whether IRB approval is required for the use of this investigational product in the clinical trial.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:labelingRequirements rdf:type rdf:Property ;
    rdfs:label 'Labeling Requirements' ;
    rdfs:comment 'Specific labeling requirements for the investigational product including required statements, warnings, and identification information per regulatory standards.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lotTrackingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Lot Tracking Required Flag' ;
    rdfs:comment 'Indicates whether lot-level tracking and accountability is required for this investigational product per protocol and regulatory requirements.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:manufacturerAddress rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Address' ;
    rdfs:comment 'Physical address of the manufacturing facility where the investigational product is produced.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packagingDescription rdf:type rdf:Property ;
    rdfs:label 'Packaging Description' ;
    rdfs:comment 'Description of the investigational product packaging including container type, closure system, and labeling specifications.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placeboIndicator rdf:type rdf:Property ;
    rdfs:label 'Placebo Indicator' ;
    rdfs:comment 'Indicates whether this investigational product is a placebo (inactive control) used in the clinical trial.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Status' ;
    rdfs:comment 'Current regulatory status of the investigational product in the clinical trial program (active, inactive, withdrawn, suspended, or approved for marketing).' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchBillingCode rdf:type rdf:Property ;
    rdfs:label 'Research Billing Code' ;
    rdfs:comment 'Billing code or charge code used for research billing compliance to distinguish investigational product costs from standard care costs.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnDestructionProcedure rdf:type rdf:Property ;
    rdfs:label 'Return Destruction Procedure' ;
    rdfs:comment 'Documented procedure for returning unused investigational product to sponsor and/or destroying expired or unused product in compliance with regulations.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shelfLifeMonths rdf:type rdf:Property ;
    rdfs:label 'Shelf Life Months' ;
    rdfs:comment 'Approved shelf life of the investigational product in months from date of manufacture, based on stability testing data.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:temperatureMonitoringRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Temperature Monitoring Required Flag' ;
    rdfs:comment 'Indicates whether continuous or periodic temperature monitoring is required during storage and transport of the investigational product.' ;
    rdfs:domain ind:InvestigationalProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:therapeuticArea rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Area' ;
    rdfs:comment 'Primary therapeutic area or disease category that the investigational product is intended to treat (e.g., oncology, cardiology, neurology, infectious disease).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipDispensationId rdf:type rdf:Property ;
    rdfs:label 'Ip Dispensation Id' ;
    rdfs:comment 'Unique identifier for the investigational product dispensation record. Primary key.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dispensingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Dispensing Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Dispensing clinician is required for investigational product accountability (21 CFR 312.62), DEA compliance for controlled substances, and protocol adherence verification. Healthcare operations track ' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:accountabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Accountability Status' ;
    rdfs:comment 'The current status of investigational product accountability for this dispensation record (pending, reconciled, discrepancy, closed).' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administrationInstructions rdf:type rdf:Property ;
    rdfs:label 'Administration Instructions' ;
    rdfs:comment 'Instructions provided to the subject regarding how to administer or take the investigational product.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chainOfCustodySignature rdf:type rdf:Property ;
    rdfs:label 'Chain Of Custody Signature' ;
    rdfs:comment 'Electronic or physical signature capturing the chain of custody transfer from dispenser to subject.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispensationDate rdf:type rdf:Property ;
    rdfs:label 'Dispensation Date' ;
    rdfs:comment 'The date on which the investigational product was dispensed to the research subject.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dispensationNotes rdf:type rdf:Property ;
    rdfs:label 'Dispensation Notes' ;
    rdfs:comment 'Additional notes or comments recorded by the dispenser regarding this investigational product dispensation event.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispensationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispensation Timestamp' ;
    rdfs:comment 'The precise date and time when the investigational product was dispensed to the research subject.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispensedByRole rdf:type rdf:Property ;
    rdfs:label 'Dispensed By Role' ;
    rdfs:comment 'The role of the personnel who dispensed the investigational product (e.g., pharmacist, research coordinator).' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedReturnDate rdf:type rdf:Property ;
    rdfs:label 'Expected Return Date' ;
    rdfs:comment 'The date by which the subject is expected to return unused investigational product for accountability reconciliation.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:kitNumber rdf:type rdf:Property ;
    rdfs:label 'Kit Number' ;
    rdfs:comment 'The unique kit number assigned to the investigational product package dispensed to the subject.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:missedDoses rdf:type rdf:Property ;
    rdfs:label 'Missed Doses' ;
    rdfs:comment 'The number of doses the subject reported missing or not taking as instructed.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:randomizationNumber rdf:type rdf:Property ;
    rdfs:label 'Randomization Number' ;
    rdfs:comment 'The randomization number assigned to the subject that determines treatment assignment. Protected to maintain blinding.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageInstructions rdf:type rdf:Property ;
    rdfs:label 'Storage Instructions' ;
    rdfs:comment 'Instructions provided to the subject regarding proper storage conditions for the investigational product (e.g., refrigeration, room temperature).' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectNumber rdf:type rdf:Property ;
    rdfs:label 'Subject Number' ;
    rdfs:comment 'The unique subject enrollment number assigned within the clinical trial. Protected health information under HIPAA.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectSignatureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Subject Signature Timestamp' ;
    rdfs:comment 'The timestamp when the subject signed to acknowledge receipt of the investigational product.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:temperatureAtDispensation rdf:type rdf:Property ;
    rdfs:label 'Temperature At Dispensation' ;
    rdfs:comment 'The temperature recorded at the time of dispensation if temperature-sensitive investigational product. Measured in Celsius.' ;
    rdfs:domain ind:IpDispensation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:biospecimenId rdf:type rdf:Property ;
    rdfs:label 'Biospecimen Id' ;
    rdfs:comment 'Unique identifier for the biospecimen record. Primary key for the biospecimen data product.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:collectorClinicianId rdf:type rdf:Property ;
    rdfs:label 'Collector Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Collecting clinician is required for biospecimen chain of custody, protocol compliance verification, and specimen quality assurance. Healthcare operations track credentialed clinician for invasive col' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:parentBiospecimenId rdf:type rdf:Property ;
    rdfs:label 'Parent Biospecimen Id' ;
    rdfs:comment 'Reference to the parent biospecimen if this specimen is an aliquot or derivative of another specimen.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Biospecimen .

ind:specimenTypeSnomedConceptId rdf:type rdf:Property ;
    rdfs:label 'Specimen Type Snomed Concept Id' ;
    rdfs:comment 'Foreign key linking to reference.snomed_concept. Business justification: Biospecimen types and anatomical sites are standardized using SNOMED CT for interoperability with biobanks, research data sharing, and regulatory submissions. Critical for NIH data sharing compliance ' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SnomedConcept .

ind:aliquotNumber rdf:type rdf:Property ;
    rdfs:label 'Aliquot Number' ;
    rdfs:comment 'Sequential number identifying this aliquot if the original specimen was divided into multiple aliquots.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:anatomicalSite rdf:type rdf:Property ;
    rdfs:label 'Anatomical Site' ;
    rdfs:comment 'Anatomical location or body site from which the specimen was collected (e.g., left arm, liver, lung, colon).' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:barcode rdf:type rdf:Property ;
    rdfs:label 'Barcode' ;
    rdfs:comment 'Unique barcode or label identifier affixed to the physical specimen container for tracking and chain-of-custody purposes.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boxPosition rdf:type rdf:Property ;
    rdfs:label 'Box Position' ;
    rdfs:comment 'Position of the specimen within the storage box (e.g., box identifier, grid position A1, B2).' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chainOfCustodyLog rdf:type rdf:Property ;
    rdfs:label 'Chain Of Custody Log' ;
    rdfs:comment 'Detailed log or audit trail documenting all handling, transfers, and custody changes of the specimen to ensure integrity and traceability.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionTime rdf:type rdf:Property ;
    rdfs:label 'Collection Time' ;
    rdfs:comment 'Precise date and time when the biospecimen was collected, critical for time-sensitive assays and stability tracking.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:collectionVolume rdf:type rdf:Property ;
    rdfs:label 'Collection Volume' ;
    rdfs:comment 'Volume of the specimen collected, typically measured in milliliters (mL) for liquid specimens.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectionVolumeUnit rdf:type rdf:Property ;
    rdfs:label 'Collection Volume Unit' ;
    rdfs:comment 'Unit of measure for the collection volume or quantity (e.g., mL, L, uL for liquids; g, mg for solids).' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentForFutureUse rdf:type rdf:Property ;
    rdfs:label 'Consent For Future Use' ;
    rdfs:comment 'Indicates whether the research subject provided informed consent for future use of this specimen in additional research studies.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deidentificationStatus rdf:type rdf:Property ;
    rdfs:label 'Deidentification Status' ;
    rdfs:comment 'Indicates whether the specimen is identified, de-identified, anonymized, or coded per HIPAA and research protocol requirements.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposition rdf:type rdf:Property ;
    rdfs:label 'Disposition' ;
    rdfs:comment 'Final disposition or outcome of the specimen (e.g., stored for future use, analyzed and depleted, destroyed per protocol, shipped to external lab, transferred to another study).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingDate rdf:type rdf:Property ;
    rdfs:label 'Processing Date' ;
    rdfs:comment 'Date on which the specimen was processed or prepared for storage.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:processingMethod rdf:type rdf:Property ;
    rdfs:label 'Processing Method' ;
    rdfs:comment 'Method used to process the specimen after collection (e.g., centrifugation, aliquoting, fixation, freezing, RNA extraction).' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingTime rdf:type rdf:Property ;
    rdfs:label 'Processing Time' ;
    rdfs:comment 'Precise date and time when specimen processing was completed.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:qualityNotes rdf:type rdf:Property ;
    rdfs:label 'Quality Notes' ;
    rdfs:comment 'Free-text notes regarding specimen quality, integrity issues, or deviations from protocol during collection or processing.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rackPosition rdf:type rdf:Property ;
    rdfs:label 'Rack Position' ;
    rdfs:comment 'Position of the specimen within the storage rack or shelf (e.g., rack number, shelf level).' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shipmentDate rdf:type rdf:Property ;
    rdfs:label 'Shipment Date' ;
    rdfs:comment 'Date on which the specimen was shipped or transferred to another location or facility.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:shipmentTrackingNumber rdf:type rdf:Property ;
    rdfs:label 'Shipment Tracking Number' ;
    rdfs:comment 'Tracking number or waybill identifier for the shipment, used to trace the specimen during transport.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shippedToFacility rdf:type rdf:Property ;
    rdfs:label 'Shipped To Facility' ;
    rdfs:comment 'Name or identifier of the external facility, laboratory, or institution to which the specimen was shipped.' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specimenQuality rdf:type rdf:Property ;
    rdfs:label 'Specimen Quality' ;
    rdfs:comment 'Assessment of the specimen quality based on visual inspection, integrity, and suitability for analysis (e.g., acceptable, marginal, unacceptable, compromised).' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specimenStatus rdf:type rdf:Property ;
    rdfs:label 'Specimen Status' ;
    rdfs:comment 'Current lifecycle status of the specimen (e.g., collected, processed, stored, in analysis, analyzed, shipped, destroyed, depleted). [ENUM-REF-CANDIDATE: collected|processed|stored|in_analysis|analyzed|shipped|destroyed|depleted — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specimenSubtype rdf:type rdf:Property ;
    rdfs:label 'Specimen Subtype' ;
    rdfs:comment 'Further classification or subtype of the specimen (e.g., whole blood vs. EDTA plasma, fresh tissue vs. frozen tissue).' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageContainerType rdf:type rdf:Property ;
    rdfs:label 'Storage Container Type' ;
    rdfs:comment 'Type of storage container or environment (e.g., freezer, refrigerator, liquid nitrogen tank, ambient storage, cryogenic storage).' ;
    rdfs:domain ind:Biospecimen ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSafetyMonitoringId rdf:type rdf:Property ;
    rdfs:label 'Data Safety Monitoring Id' ;
    rdfs:comment 'Unique identifier for the data safety monitoring record. Primary key for this entity.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dsmbCommitteeId rdf:type rdf:Property ;
    rdfs:label 'Dsmb Committee Id' ;
    rdfs:comment 'Identifier of the Data Safety Monitoring Board or Data Monitoring Committee assigned to oversee this trial.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DsmbCommittee .

ind:primaryDataEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Data Employee Id' ;
    rdfs:comment 'Identifier of the user or system account that created this data safety monitoring record.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:researchDocumentId rdf:type rdf:Property ;
    rdfs:label 'Research Document Id' ;
    rdfs:comment 'Identifier or reference to the formal DSMB meeting minutes document stored in the document management system.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchDocument .

ind:adverseEventsReviewed rdf:type rdf:Property ;
    rdfs:label 'Adverse Events Reviewed' ;
    rdfs:comment 'Total count of adverse events reviewed by the DSMB during this meeting.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:charterVersion rdf:type rdf:Property ;
    rdfs:label 'Charter Version' ;
    rdfs:comment 'Version identifier of the DSMB charter document in effect at the time of this meeting.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataLockDate rdf:type rdf:Property ;
    rdfs:label 'Data Lock Date' ;
    rdfs:comment 'Date on which the clinical trial data was locked for this interim analysis and DSMB review.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dsmbRecommendation rdf:type rdf:Property ;
    rdfs:label 'Dsmb Recommendation' ;
    rdfs:comment 'Formal recommendation issued by the DSMB: continue trial as planned, modify protocol, suspend enrollment, terminate trial, or increase monitoring frequency.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fdaNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Fda Notification Date' ;
    rdfs:comment 'Date on which the FDA was formally notified of the DSMB recommendation and any safety actions taken.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fdaNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Fda Notification Required' ;
    rdfs:comment 'Indicates whether the DSMB recommendation requires formal notification to the FDA under IND safety reporting requirements.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:implementationActionTaken rdf:type rdf:Property ;
    rdfs:label 'Implementation Action Taken' ;
    rdfs:comment 'Description of the concrete actions taken by the sponsor to implement the DSMB recommendation (e.g., protocol amendment submitted, enrollment suspended, monitoring increased).' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interimAnalysisTrigger rdf:type rdf:Property ;
    rdfs:label 'Interim Analysis Trigger' ;
    rdfs:comment 'Description of the event or milestone that triggered the interim analysis (e.g., enrollment milestone, calendar-based, safety signal threshold).' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irbNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Irb Notification Date' ;
    rdfs:comment 'Date on which the IRB was formally notified of the DSMB recommendation and sponsor response.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:irbNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Irb Notification Required' ;
    rdfs:comment 'Indicates whether the DSMB recommendation and sponsor response require notification to the Institutional Review Board.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meetingDate rdf:type rdf:Property ;
    rdfs:label 'Meeting Date' ;
    rdfs:comment 'Date on which the Data Safety Monitoring Board meeting occurred to review trial safety data.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:meetingNumber rdf:type rdf:Property ;
    rdfs:label 'Meeting Number' ;
    rdfs:comment 'Sequential or coded identifier for the DSMB meeting (e.g., DSMB-001, Meeting 3).' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meetingType rdf:type rdf:Property ;
    rdfs:label 'Meeting Type' ;
    rdfs:comment 'Classification of the DSMB meeting: scheduled routine review, ad hoc safety review, interim analysis, final review, or emergency convening.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringStatus rdf:type rdf:Property ;
    rdfs:label 'Monitoring Status' ;
    rdfs:comment 'Current status of DSMB monitoring for this trial: active (ongoing), suspended (temporarily paused), completed (trial ended), or terminated (trial stopped early).' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextReviewScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Scheduled Date' ;
    rdfs:comment 'Scheduled date for the next DSMB review meeting as determined during this meeting.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:protocolModificationRequired rdf:type rdf:Property ;
    rdfs:label 'Protocol Modification Required' ;
    rdfs:comment 'Indicates whether the DSMB recommendation requires a formal protocol amendment.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recommendationRationale rdf:type rdf:Property ;
    rdfs:label 'Recommendation Rationale' ;
    rdfs:comment 'Detailed rationale and clinical/statistical justification for the DSMB recommendation.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordStatus rdf:type rdf:Property ;
    rdfs:label 'Record Status' ;
    rdfs:comment 'Lifecycle status of this data safety monitoring record: draft (in preparation), final (approved), amended (revised after finalization), or archived (historical).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyStoppingRuleEvaluated rdf:type rdf:Property ;
    rdfs:label 'Safety Stopping Rule Evaluated' ;
    rdfs:comment 'Indicates whether pre-defined safety stopping rules were formally evaluated during this DSMB meeting.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seriousAdverseEventsReviewed rdf:type rdf:Property ;
    rdfs:label 'Serious Adverse Events Reviewed' ;
    rdfs:comment 'Count of serious adverse events (SAEs) reviewed by the DSMB during this meeting.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sponsorResponse rdf:type rdf:Property ;
    rdfs:label 'Sponsor Response' ;
    rdfs:comment 'Sponsor\'s formal response to the DSMB recommendation: accepted, accepted with modifications, rejected, or under review.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorResponseDate rdf:type rdf:Property ;
    rdfs:label 'Sponsor Response Date' ;
    rdfs:comment 'Date on which the sponsor formally responded to the DSMB recommendation.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sponsorResponseRationale rdf:type rdf:Property ;
    rdfs:label 'Sponsor Response Rationale' ;
    rdfs:comment 'Detailed explanation of the sponsor\'s response, including justification for acceptance, modification, or rejection of the DSMB recommendation.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statisticalReportDocumentCode rdf:type rdf:Property ;
    rdfs:label 'Statistical Report Document Code' ;
    rdfs:comment 'Identifier or reference to the interim statistical analysis report reviewed by the DSMB.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stoppingRuleThresholdMet rdf:type rdf:Property ;
    rdfs:label 'Stopping Rule Threshold Met' ;
    rdfs:comment 'Indicates whether any safety stopping rule threshold was met or exceeded during this review.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subjectsCompletedAtReview rdf:type rdf:Property ;
    rdfs:label 'Subjects Completed At Review' ;
    rdfs:comment 'Number of subjects who had completed the study protocol at the time of this DSMB review.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:subjectsEnrolledAtReview rdf:type rdf:Property ;
    rdfs:label 'Subjects Enrolled At Review' ;
    rdfs:comment 'Total number of subjects enrolled in the trial at the time of this DSMB review.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unblindingEventOccurred rdf:type rdf:Property ;
    rdfs:label 'Unblinding Event Occurred' ;
    rdfs:comment 'Indicates whether treatment assignment unblinding occurred during this DSMB meeting for interim analysis purposes.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unblindingJustification rdf:type rdf:Property ;
    rdfs:label 'Unblinding Justification' ;
    rdfs:comment 'Business and regulatory justification for unblinding, including the safety or efficacy rationale.' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unblindingScope rdf:type rdf:Property ;
    rdfs:label 'Unblinding Scope' ;
    rdfs:comment 'Scope of unblinding performed: none, partial (selected subjects), full (all subjects), or treatment arm only (aggregate level).' ;
    rdfs:domain ind:DataSafetyMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingEventId rdf:type rdf:Property ;
    rdfs:label 'Billing Event Id' ;
    rdfs:comment 'Unique identifier for the research billing event record. Primary key.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageAnalysisId rdf:type rdf:Property ;
    rdfs:label 'Coverage Analysis Id' ;
    rdfs:comment 'Reference to the formal coverage analysis document that determined billing responsibility for this service.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoverageAnalysis .

ind:journalEntryId rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Id' ;
    rdfs:comment 'Foreign key linking to finance.journal_entry. Business justification: Research billing events generate accounting journal entries for revenue recognition, compliance tracking, and financial reporting. Essential for clinical trial billing compliance, Medicare coverage an' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JournalEntry .

ind:performingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Performing Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Performing clinician resolves research billing coverage analysis (Medicare NCD 310.1) and charge reconciliation. Healthcare operations require credentialed clinician link to determine standard-of-care' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:analysisDate rdf:type rdf:Property ;
    rdfs:label 'Analysis Date' ;
    rdfs:comment 'The date on which the coverage analysis was performed to determine billing responsibility for this service.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:analystName rdf:type rdf:Property ;
    rdfs:label 'Analyst Name' ;
    rdfs:comment 'The name of the research billing compliance analyst who performed the coverage determination for this service.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverName rdf:type rdf:Property ;
    rdfs:label 'Approver Name' ;
    rdfs:comment 'The name of the compliance officer or authorized personnel who approved the coverage determination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrail rdf:type rdf:Property ;
    rdfs:label 'Audit Trail' ;
    rdfs:comment 'Comprehensive audit trail capturing all changes to the coverage determination and billing status, including timestamps and user identifiers.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingDate rdf:type rdf:Property ;
    rdfs:label 'Billing Date' ;
    rdfs:comment 'The date on which the charge was submitted for billing to the determined responsible party.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:clinicalTrialPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Policy Number' ;
    rdfs:comment 'The institutional policy or procedure number governing research billing compliance for this trial, ensuring adherence to CMS and OIG guidance.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsNcdReference rdf:type rdf:Property ;
    rdfs:label 'Cms Ncd Reference' ;
    rdfs:comment 'Reference to the specific CMS NCD (e.g., NCD 310.1) that governs Medicare coverage for this clinical trial service.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceNotes rdf:type rdf:Property ;
    rdfs:label 'Compliance Notes' ;
    rdfs:comment 'Free-text notes documenting compliance review findings, escalations, or special handling instructions for this billing event.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:determinationRationale rdf:type rdf:Property ;
    rdfs:label 'Determination Rationale' ;
    rdfs:comment 'Detailed explanation of why this service was classified under the assigned coverage determination, referencing protocol requirements and payer policies.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantNumber rdf:type rdf:Property ;
    rdfs:label 'Grant Number' ;
    rdfs:comment 'The grant or contract number under which this research service is funded, used for financial reconciliation with sponsors.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerSpecificDetermination rdf:type rdf:Property ;
    rdfs:label 'Payer Specific Determination' ;
    rdfs:comment 'Additional payer-specific coverage determination details, capturing nuances in Medicare, Medicaid, or commercial payer policies for research services.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalInvestigatorNpi rdf:type rdf:Property ;
    rdfs:label 'Principal Investigator Npi' ;
    rdfs:comment 'The NPI of the principal investigator responsible for the clinical trial, used for research oversight and billing compliance.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protocolPhase rdf:type rdf:Property ;
    rdfs:label 'Protocol Phase' ;
    rdfs:comment 'The clinical trial phase designation at the time of service (e.g., Phase I, Phase II, Phase III, Phase IV).' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Service Timestamp' ;
    rdfs:comment 'The precise date and time when the research service was performed, used for detailed audit and reconciliation.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:grantExpenditureId rdf:type rdf:Property ;
    rdfs:label 'Grant Expenditure Id' ;
    rdfs:comment 'Unique identifier for the grant expenditure transaction record.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:grantId rdf:type rdf:Property ;
    rdfs:label 'Grant Id' ;
    rdfs:comment 'Reference to the research grant or contract against which this expenditure is charged.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchGrant .

ind:primaryGrantEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Grant Employee Id' ;
    rdfs:comment 'Reference to the employee or personnel member for whom salary or fringe benefit costs are charged, applicable only to personnel and fringe benefit expense categories.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accountingPeriod rdf:type rdf:Property ;
    rdfs:label 'Accounting Period' ;
    rdfs:comment 'The accounting period or month within the fiscal year when the expenditure was recorded.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocableFlag rdf:type rdf:Property ;
    rdfs:label 'Allocable Flag' ;
    rdfs:comment 'Indicates whether the expenditure is allocable to the grant according to the benefit received by the project (True if allocable, False if not allocable).' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowableFlag rdf:type rdf:Property ;
    rdfs:label 'Allowable Flag' ;
    rdfs:comment 'Indicates whether the expenditure is allowable under the grant terms and federal cost principles (True if allowable, False if unallowable or questioned).' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:awardNumber rdf:type rdf:Property ;
    rdfs:label 'Award Number' ;
    rdfs:comment 'The sponsor-assigned award or grant number under which the expenditure is charged.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costShareAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Share Amount' ;
    rdfs:comment 'The portion of the expenditure amount that represents institutional cost sharing or matching funds, if applicable.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costShareFlag rdf:type rdf:Property ;
    rdfs:label 'Cost Share Flag' ;
    rdfs:comment 'Indicates whether this expenditure represents institutional cost sharing or matching funds committed to the grant (True if cost share, False if sponsor-funded).' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grantExpenditureDescription rdf:type rdf:Property ;
    rdfs:label 'Grant Expenditure Description' ;
    rdfs:comment 'Detailed narrative description of the expenditure, including the purpose, justification, and business context for the charge.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directCostFlag rdf:type rdf:Property ;
    rdfs:label 'Direct Cost Flag' ;
    rdfs:comment 'Indicates whether the expenditure is a direct cost that can be specifically identified with the grant project (True) or an indirect cost allocated through the facilities and administrative rate (False).' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expenseCategory rdf:type rdf:Property ;
    rdfs:label 'Expense Category' ;
    rdfs:comment 'Classification of the expenditure according to sponsor-required cost categories: personnel costs (salary and wages), fringe benefits, supplies, equipment, travel, subcontract costs, other direct costs, or indirect costs (facilities and administrative). [ENUM-REF-CANDIDATE: personnel|fringe_benefits|supplies|equipment|travel|subcontract|other_direct|indirect — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundCode rdf:type rdf:Property ;
    rdfs:label 'Fund Code' ;
    rdfs:comment 'The fund or account code representing the source of funds for the expenditure, used in fund accounting for sponsored research.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generalLedgerAccount rdf:type rdf:Property ;
    rdfs:label 'General Ledger Account' ;
    rdfs:comment 'The general ledger account code to which the expenditure is posted in the financial system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indirectCostRate rdf:type rdf:Property ;
    rdfs:label 'Indirect Cost Rate' ;
    rdfs:comment 'The facilities and administrative (F&A) indirect cost rate applied to the expenditure, expressed as a percentage, used to calculate indirect cost recovery.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Invoice Number' ;
    rdfs:comment 'The vendor invoice number or billing document number associated with the expenditure transaction.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonableFlag rdf:type rdf:Property ;
    rdfs:label 'Reasonable Flag' ;
    rdfs:comment 'Indicates whether the expenditure is reasonable in nature and amount for the performance of the grant (True if reasonable, False if questioned).' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sponsorCode rdf:type rdf:Property ;
    rdfs:label 'Sponsor Code' ;
    rdfs:comment 'The code or identifier for the funding sponsor or agency (e.g., NIH, NSF, DOD, private foundation) that provided the grant.' ;
    rdfs:domain ind:GrantExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Date' ;
    rdfs:comment 'The date on which the expenditure transaction was posted or incurred in the financial system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Number' ;
    rdfs:comment 'Business identifier for the expenditure transaction, typically sourced from the financial system (SAP FI document number or Workday journal entry number).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studySponsorId rdf:type rdf:Property ;
    rdfs:label 'Study Sponsor Id' ;
    rdfs:comment 'Unique identifier for the study sponsor record. Primary key for the study sponsor entity.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StudySponsor .

ind:conflictOfInterestId rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Id' ;
    rdfs:comment 'Foreign key linking to compliance.conflict_of_interest. Business justification: Sponsor relationships require COI disclosure and management (financial interests, consulting arrangements, equity). Standard research integrity and FDA financial disclosure requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConflictOfInterest .

ind:agreementEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Agreement Effective Date' ;
    rdfs:comment 'Date on which the master agreement or clinical trial agreement with the sponsor became effective and binding.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agreementExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Agreement Expiration Date' ;
    rdfs:comment 'Date on which the master agreement with the sponsor expires or is scheduled for renewal. Nullable for evergreen agreements.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Budget Approval Date' ;
    rdfs:comment 'Date on which the study budget was formally approved by both the sponsor and the institution\'s research finance office.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:createdByUser rdf:type rdf:Property ;
    rdfs:label 'Created By User' ;
    rdfs:comment 'Username or identifier of the research administrator or system user who created the study sponsor record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:croRelationshipType rdf:type rdf:Property ;
    rdfs:label 'Cro Relationship Type' ;
    rdfs:comment 'Describes the sponsor\'s relationship with Contract Research Organizations. Direct Sponsor: sponsor manages study directly without CRO; CRO Delegated: CRO manages study on behalf of sponsor; Hybrid: shared responsibilities between sponsor and CRO; Not Applicable: no CRO involvement.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialDisclosureRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Financial Disclosure Required Flag' ;
    rdfs:comment 'Indicates whether the sponsor requires investigators to complete financial disclosure forms per FDA regulations (21 CFR Part 54) to identify potential financial conflicts of interest. True if required; False if not required.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:invoicingContactEmail rdf:type rdf:Property ;
    rdfs:label 'Invoicing Contact Email' ;
    rdfs:comment 'Email address for submitting invoices and payment inquiries to the sponsor\'s finance department.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoicingContactName rdf:type rdf:Property ;
    rdfs:label 'Invoicing Contact Name' ;
    rdfs:comment 'Full name of the sponsor\'s accounts payable or invoicing contact responsible for processing study-related invoices.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastModifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User' ;
    rdfs:comment 'Username or identifier of the research administrator or system user who last modified the study sponsor record.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:masterAgreementReference rdf:type rdf:Property ;
    rdfs:label 'Master Agreement Reference' ;
    rdfs:comment 'Reference number or identifier for the master clinical trial agreement (CTA) or master service agreement (MSA) governing the relationship between the sponsor and the institution. Links to institutional contract management system.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndaBlaHolderFlag rdf:type rdf:Property ;
    rdfs:label 'Nda Bla Holder Flag' ;
    rdfs:comment 'Indicates whether the sponsor holds an NDA or BLA with the FDA for the investigational product. True if sponsor is the regulatory holder; False if sponsor is not the holder (e.g., academic sponsor using an IND from another entity).' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:negotiatedCostFlag rdf:type rdf:Property ;
    rdfs:label 'Negotiated Cost Flag' ;
    rdfs:comment 'Indicates whether the budget terms represent negotiated rates specific to this sponsor (True) or standard institutional rates (False). Used to distinguish custom sponsor agreements from standard fee schedules.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overheadIndirectCostRate rdf:type rdf:Property ;
    rdfs:label 'Overhead Indirect Cost Rate' ;
    rdfs:comment 'Percentage rate applied to direct study costs to cover institutional overhead and indirect costs (e.g., facilities, administration, compliance). Expressed as a percentage (e.g., 25.00 for 25%).' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentMilestoneTerms rdf:type rdf:Property ;
    rdfs:label 'Payment Milestone Terms' ;
    rdfs:comment 'Narrative description of payment milestones and triggers defined in the sponsor agreement (e.g., payment upon enrollment, payment upon visit completion, payment upon database lock). Free-text field capturing negotiated payment schedule terms.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentScheduleFrequency rdf:type rdf:Property ;
    rdfs:label 'Payment Schedule Frequency' ;
    rdfs:comment 'Frequency at which the sponsor remits payments to the institution. Per Visit: payment after each completed visit; Monthly: consolidated monthly invoicing; Quarterly: quarterly invoicing cycle; Milestone Based: payments tied to specific study milestones; Study Completion: lump sum upon study closure.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perProcedureReimbursementRate rdf:type rdf:Property ;
    rdfs:label 'Per Procedure Reimbursement Rate' ;
    rdfs:comment 'Standard reimbursement amount paid by the sponsor for each protocol-specified procedure (e.g., lab test, imaging study, biopsy). Expressed in the currency specified in budget_currency_code.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perVisitReimbursementRate rdf:type rdf:Property ;
    rdfs:label 'Per Visit Reimbursement Rate' ;
    rdfs:comment 'Standard reimbursement amount paid by the sponsor for each completed study visit per protocol. Expressed in the currency specified in budget_currency_code.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:screenFailureAllowanceAmount rdf:type rdf:Property ;
    rdfs:label 'Screen Failure Allowance Amount' ;
    rdfs:comment 'Reimbursement amount paid by the sponsor for each patient who is screened but fails to meet eligibility criteria and is not enrolled. Expressed in the currency specified in budget_currency_code.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sponsorAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Sponsor Address Line1' ;
    rdfs:comment 'First line of the sponsor organization\'s primary business address, typically including street number and name.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Sponsor Address Line2' ;
    rdfs:comment 'Second line of the sponsor organization\'s address for suite, floor, building, or other secondary address details. Nullable.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorCity rdf:type rdf:Property ;
    rdfs:label 'Sponsor City' ;
    rdfs:comment 'City where the sponsor organization is headquartered or maintains its primary business address.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorCountryCode rdf:type rdf:Property ;
    rdfs:label 'Sponsor Country Code' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code for the sponsor\'s primary business location (e.g., USA, GBR, CAN, DEU).' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorNotes rdf:type rdf:Property ;
    rdfs:label 'Sponsor Notes' ;
    rdfs:comment 'Free-text field for additional notes, special instructions, or institutional knowledge about the sponsor relationship, budget terms, or payment history. Used for operational context and institutional memory.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorPostalCode rdf:type rdf:Property ;
    rdfs:label 'Sponsor Postal Code' ;
    rdfs:comment 'Postal or ZIP code for the sponsor\'s primary business address.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorStateProvince rdf:type rdf:Property ;
    rdfs:label 'Sponsor State Province' ;
    rdfs:comment 'State, province, or region of the sponsor\'s primary address. Use standard postal abbreviations (e.g., CA, NY, ON).' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsorStatus rdf:type rdf:Property ;
    rdfs:label 'Sponsor Status' ;
    rdfs:comment 'Current status of the sponsor relationship with the institution. Active: currently sponsoring studies; Inactive: no active studies but relationship maintained; Suspended: temporarily halted due to compliance or contractual issues; Terminated: relationship ended.' ;
    rdfs:domain ind:StudySponsor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startupCostAmount rdf:type rdf:Property ;
    rdfs:label 'Startup Cost Amount' ;
    rdfs:comment 'One-time startup cost paid by the sponsor to cover site initiation activities, including IRB submission, staff training, regulatory document preparation, and site activation. Expressed in the currency specified in budget_currency_code.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:analystEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Analyst Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Coverage analysts are institutional employees in research billing/compliance departments performing Medicare coverage determinations and routine-vs-research cost segregation. Required for workload tra' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryHcpcsCodeId rdf:type rdf:Property ;
    rdfs:label 'Primary Hcpcs Code Id' ;
    rdfs:comment 'Foreign key linking to reference.hcpcs_code. Business justification: Coverage analysis includes HCPCS codes for investigational devices, drugs, and supplies to determine payer coverage and billing strategy. Essential for research billing compliance. Removes denormalize' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HcpcsCode .

ind:supersededByCoverageAnalysisId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Coverage Analysis Id' ;
    rdfs:comment 'Foreign key reference to the coverage analysis document that supersedes this one, if applicable.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoverageAnalysis .

ind:analysisDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Analysis Document Number' ;
    rdfs:comment 'Formal document control number assigned to this coverage analysis for tracking and audit purposes.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analysisStatus rdf:type rdf:Property ;
    rdfs:label 'Analysis Status' ;
    rdfs:comment 'Current lifecycle status of the coverage analysis document.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analystTitle rdf:type rdf:Property ;
    rdfs:label 'Analyst Title' ;
    rdfs:comment 'Job title or role of the analyst who performed the coverage analysis (e.g., Research Billing Analyst, Clinical Research Coordinator).' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalTrialAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Clinical Trial Agreement Flag' ;
    rdfs:comment 'Indicates whether a formal clinical trial agreement exists that specifies sponsor responsibility for certain costs.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialCoverageDetermination rdf:type rdf:Property ;
    rdfs:label 'Commercial Coverage Determination' ;
    rdfs:comment 'Overall commercial insurance coverage determination for services in the protocol.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationalDeviceFlag rdf:type rdf:Property ;
    rdfs:label 'Investigational Device Flag' ;
    rdfs:comment 'Indicates whether the protocol involves an investigational device subject to FDA Investigational Device Exemption (IDE) regulations.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investigationalDrugFlag rdf:type rdf:Property ;
    rdfs:label 'Investigational Drug Flag' ;
    rdfs:comment 'Indicates whether the protocol involves an investigational drug subject to FDA Investigational New Drug (IND) regulations.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lcdReference rdf:type rdf:Property ;
    rdfs:label 'Lcd Reference' ;
    rdfs:comment 'Reference to applicable CMS Local Coverage Determination policies used in the analysis.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidCoverageDetermination rdf:type rdf:Property ;
    rdfs:label 'Medicaid Coverage Determination' ;
    rdfs:comment 'Overall Medicaid coverage determination for services in the protocol.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicareCoverageDetermination rdf:type rdf:Property ;
    rdfs:label 'Medicare Coverage Determination' ;
    rdfs:comment 'Overall Medicare coverage determination for services in the protocol: standard of care (billable to Medicare), research only (billable to sponsor), or mixed.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncdReference rdf:type rdf:Property ;
    rdfs:label 'Ncd Reference' ;
    rdfs:comment 'Reference to applicable CMS National Coverage Determination policies used in the analysis (e.g., NCD 310.1 for routine costs in clinical trials).' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndcCodesReviewed rdf:type rdf:Property ;
    rdfs:label 'Ndc Codes Reviewed' ;
    rdfs:comment 'Comma-separated list of NDC codes for investigational or standard drugs reviewed in the coverage analysis.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offLabelUseFlag rdf:type rdf:Property ;
    rdfs:label 'Off Label Use Flag' ;
    rdfs:comment 'Indicates whether the protocol involves off-label use of approved drugs or devices, which may affect coverage determinations.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payerPolicyReference rdf:type rdf:Property ;
    rdfs:label 'Payer Policy Reference' ;
    rdfs:comment 'Reference to specific commercial payer policies or medical policies used in the coverage determination.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchOnlyServicesCount rdf:type rdf:Property ;
    rdfs:label 'Research Only Services Count' ;
    rdfs:comment 'Number of services or procedures in the protocol determined to be research-specific and billable to sponsor or grant.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewerTitle rdf:type rdf:Property ;
    rdfs:label 'Reviewer Title' ;
    rdfs:comment 'Job title or role of the reviewer who validated the coverage analysis.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routineCostCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Routine Cost Coverage Flag' ;
    rdfs:comment 'Indicates whether routine costs of care in the clinical trial are covered by Medicare per NCD 310.1.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sponsorCoverageCommitment rdf:type rdf:Property ;
    rdfs:label 'Sponsor Coverage Commitment' ;
    rdfs:comment 'Description of services or costs that the study sponsor has committed to cover per the clinical trial agreement.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardOfCareServicesCount rdf:type rdf:Property ;
    rdfs:label 'Standard Of Care Services Count' ;
    rdfs:comment 'Number of services or procedures in the protocol determined to be standard of care and billable to insurance.' ;
    rdfs:domain ind:CoverageAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:researchRegulatorySubmissionId rdf:type rdf:Property ;
    rdfs:label 'Research Regulatory Submission Id' ;
    rdfs:comment 'Unique identifier for the regulatory submission record. Primary key for the research regulatory submission entity.' ;
    rdfs:domain ind:ResearchRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryResearchEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Research Employee Id' ;
    rdfs:comment 'Foreign key reference to the system user who prepared and submitted this regulatory submission on behalf of the organization.' ;
    rdfs:domain ind:ResearchRegulatorySubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:agencyDivision rdf:type rdf:Property ;
    rdfs:label 'Agency Division' ;
    rdfs:comment 'The specific division or office within the regulatory agency responsible for reviewing this submission (e.g., Center for Drug Evaluation and Research (CDER), Center for Biologics Evaluation and Research (CBER), Center for Devices and Radiological Health (CDRH)).' ;
    rdfs:domain ind:ResearchRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyResponseDate rdf:type rdf:Property ;
    rdfs:label 'Agency Response Date' ;
    rdfs:comment 'The date on which the regulatory agency provided an official response or determination regarding the submission.' ;
    rdfs:domain ind:ResearchRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:blaNumber rdf:type rdf:Property ;
    rdfs:label 'Bla Number' ;
    rdfs:comment 'The Biologics License Application (BLA) number assigned by the Food and Drug Administration (FDA) when seeking approval to market a biological product. Applicable for BLA submissions.' ;
    rdfs:domain ind:ResearchRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndaNumber rdf:type rdf:Property ;
    rdfs:label 'Nda Number' ;
    rdfs:comment 'The New Drug Application (NDA) number assigned by the Food and Drug Administration (FDA) when seeking approval to market a new drug. Applicable for NDA submissions.' ;
    rdfs:domain ind:ResearchRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalInvestigatorName rdf:type rdf:Property ;
    rdfs:label 'Principal Investigator Name' ;
    rdfs:comment 'The full name of the principal investigator responsible for the research study associated with this regulatory submission.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAgency rdf:type rdf:Property ;
    rdfs:label 'Regulatory Agency' ;
    rdfs:comment 'The federal regulatory agency to which this submission was made (e.g., Food and Drug Administration (FDA), National Institutes of Health (NIH), Office for Human Research Protections (OHRP), Centers for Medicare and Medicaid Services (CMS), Drug Enforcement Administration (DEA)).' ;
    rdfs:domain ind:ResearchRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionContactEmail rdf:type rdf:Property ;
    rdfs:label 'Submission Contact Email' ;
    rdfs:comment 'The email address of the primary contact person for this regulatory submission. Business-confidential organizational contact information.' ;
    rdfs:domain ind:ResearchRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionContactName rdf:type rdf:Property ;
    rdfs:label 'Submission Contact Name' ;
    rdfs:comment 'The name of the individual serving as the primary contact person for this regulatory submission.' ;
    rdfs:domain ind:ResearchRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionContactPhone rdf:type rdf:Property ;
    rdfs:label 'Submission Contact Phone' ;
    rdfs:comment 'The phone number of the primary contact person for this regulatory submission. Business-confidential organizational contact information.' ;
    rdfs:domain ind:ResearchRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringVisitId rdf:type rdf:Property ;
    rdfs:label 'Monitoring Visit Id' ;
    rdfs:comment 'Unique identifier for the clinical trial monitoring visit record. Primary key.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:monitorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Monitor Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: When monitors are institutional employees (vs. external CRO staff), tracking their credentials, GCP training currency, time allocation, and visit workload is required for quality assurance and resourc' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:adverseEventReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Adverse Event Review Flag' ;
    rdfs:comment 'Indicates whether Adverse Event (AE) and Serious Adverse Event (SAE) reporting and documentation were reviewed for timeliness and completeness.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveActionPlanReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Received Date' ;
    rdfs:comment 'Date on which the site submitted the Corrective Action Plan (CAP) or Corrective and Preventive Action (CAPA) response.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataDiscrepanciesNotedCount rdf:type rdf:Property ;
    rdfs:label 'Data Discrepancies Noted Count' ;
    rdfs:comment 'Number of data discrepancies or queries identified between case report forms and source documents during Source Data Verification (SDV).' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsSummary rdf:type rdf:Property ;
    rdfs:label 'Findings Summary' ;
    rdfs:comment 'Narrative summary of key findings, observations, protocol deviations, and data discrepancies identified during the monitoring visit.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpVisitRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Visit Required Flag' ;
    rdfs:comment 'Indicates whether a follow-up monitoring visit is required to verify implementation of corrective actions or address outstanding issues.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpVisitScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Visit Scheduled Date' ;
    rdfs:comment 'Scheduled date for the follow-up monitoring visit to verify corrective action implementation.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:informedConsentReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Informed Consent Review Flag' ;
    rdfs:comment 'Indicates whether informed consent documents were reviewed for completeness, signatures, and regulatory compliance during this visit.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investigationalProductAccountabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Investigational Product Accountability Flag' ;
    rdfs:comment 'Indicates whether investigational drug or device accountability records (receipt, dispensing, return, destruction logs) were reviewed and reconciled.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:majorFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Major Findings Count' ;
    rdfs:comment 'Number of major findings or critical issues identified during the visit that pose significant risk to subject safety, data integrity, or regulatory compliance.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minorFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Minor Findings Count' ;
    rdfs:comment 'Number of minor findings or observations identified during the visit that require attention but do not pose immediate risk.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:monitorOrganization rdf:type rdf:Property ;
    rdfs:label 'Monitor Organization' ;
    rdfs:comment 'Organization employing the monitor: sponsor, Contract Research Organization (CRO), or internal monitoring team.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitorType rdf:type rdf:Property ;
    rdfs:label 'Monitor Type' ;
    rdfs:comment 'Classification of the monitor: sponsor representative, CRO monitor, internal institutional monitor, or independent auditor.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protocolDeviationsIdentifiedCount rdf:type rdf:Property ;
    rdfs:label 'Protocol Deviations Identified Count' ;
    rdfs:comment 'Number of protocol deviations identified during the monitoring visit that require documentation and corrective action.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryDocumentReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Document Review Flag' ;
    rdfs:comment 'Indicates whether regulatory documents (Institutional Review Board (IRB) approvals, Food and Drug Administration (FDA) Form 1572, curriculum vitae, licenses) were reviewed for currency and completeness.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remoteMonitoringFlag rdf:type rdf:Property ;
    rdfs:label 'Remote Monitoring Flag' ;
    rdfs:comment 'Indicates whether this monitoring visit was conducted remotely (virtual) rather than on-site, using electronic systems and teleconference.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskBasedMonitoringFlag rdf:type rdf:Property ;
    rdfs:label 'Risk Based Monitoring Flag' ;
    rdfs:comment 'Indicates whether this visit was conducted under a Risk-Based Monitoring (RBM) approach with targeted review based on risk assessment.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sdvPercentage rdf:type rdf:Property ;
    rdfs:label 'Sdv Percentage' ;
    rdfs:comment 'Percentage of data points or subjects for which Source Data Verification (SDV) was performed during this visit.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:siteCoordinatorName rdf:type rdf:Property ;
    rdfs:label 'Site Coordinator Name' ;
    rdfs:comment 'Name of the site research coordinator or study coordinator who assisted during the monitoring visit.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDataVerificationPerformedFlag rdf:type rdf:Property ;
    rdfs:label 'Source Data Verification Performed Flag' ;
    rdfs:comment 'Indicates whether Source Data Verification (SDV) was performed during this monitoring visit to compare case report forms against source documents.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subjectsEnrolledCount rdf:type rdf:Property ;
    rdfs:label 'Subjects Enrolled Count' ;
    rdfs:comment 'Number of subjects enrolled at the site at the time of the monitoring visit.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:subjectsReviewedCount rdf:type rdf:Property ;
    rdfs:label 'Subjects Reviewed Count' ;
    rdfs:comment 'Number of subject records reviewed by the monitor during this visit for source data verification and compliance.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:visitDate rdf:type rdf:Property ;
    rdfs:label 'Visit Date' ;
    rdfs:comment 'The date on which the monitoring visit was conducted at the study site.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:visitEndTime rdf:type rdf:Property ;
    rdfs:label 'Visit End Time' ;
    rdfs:comment 'Timestamp when the monitoring visit concluded at the site.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:visitObjectives rdf:type rdf:Property ;
    rdfs:label 'Visit Objectives' ;
    rdfs:comment 'Documented objectives and scope of the monitoring visit, including specific areas of focus (e.g., informed consent review, source data verification, regulatory document review).' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visitReportCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Visit Report Completion Date' ;
    rdfs:comment 'Date on which the monitoring visit report was finalized and approved for distribution.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:visitReportDocumentCode rdf:type rdf:Property ;
    rdfs:label 'Visit Report Document Code' ;
    rdfs:comment 'Unique document identifier or reference number for the monitoring visit report in the document management system.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visitReportStatus rdf:type rdf:Property ;
    rdfs:label 'Visit Report Status' ;
    rdfs:comment 'Current status of the monitoring visit report document: draft, in review, finalized, approved, or distributed to stakeholders.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visitStartTime rdf:type rdf:Property ;
    rdfs:label 'Visit Start Time' ;
    rdfs:comment 'Timestamp when the monitoring visit commenced at the site.' ;
    rdfs:domain ind:MonitoringVisit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:protocolDeviationId rdf:type rdf:Property ;
    rdfs:label 'Protocol Deviation Id' ;
    rdfs:comment 'Unique identifier for the protocol deviation record. Primary key.' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responsibleClinicianId rdf:type rdf:Property ;
    rdfs:label 'Responsible Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Responsible clinician is tracked for protocol deviation root cause analysis, corrective action plans, and credentialing impact assessment. Healthcare operations require attribution to credentialed cli' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:auditFindingFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Finding Flag' ;
    rdfs:comment 'Indicates whether this protocol deviation was identified as a finding during an internal or external audit or regulatory inspection.' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveAction rdf:type rdf:Property ;
    rdfs:label 'Corrective Action' ;
    rdfs:comment 'Description of the immediate corrective action taken to address the specific protocol deviation.' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectedByRole rdf:type rdf:Property ;
    rdfs:label 'Detected By Role' ;
    rdfs:comment 'The role or title of the study personnel who detected or identified the protocol deviation (e.g., Clinical Research Coordinator, Principal Investigator, Monitor).' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviationDate rdf:type rdf:Property ;
    rdfs:label 'Deviation Date' ;
    rdfs:comment 'The date on which the protocol deviation actually occurred.' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deviationNotes rdf:type rdf:Property ;
    rdfs:label 'Deviation Notes' ;
    rdfs:comment 'Additional free-text notes, comments, or observations related to the protocol deviation, its investigation, or resolution.' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviationNumber rdf:type rdf:Property ;
    rdfs:label 'Deviation Number' ;
    rdfs:comment 'Unique business identifier assigned to this protocol deviation for tracking and reporting purposes.' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviationStatus rdf:type rdf:Property ;
    rdfs:label 'Deviation Status' ;
    rdfs:comment 'Current lifecycle status of the protocol deviation record (e.g., open, under review, closed, pending corrective and preventive action).' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fdaReportDate rdf:type rdf:Property ;
    rdfs:label 'Fda Report Date' ;
    rdfs:comment 'The date on which the protocol deviation was reported to the Food and Drug Administration (FDA), if applicable.' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fdaReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Fda Reportable Flag' ;
    rdfs:comment 'Indicates whether this protocol deviation meets the criteria for reporting to the Food and Drug Administration (FDA) under 21 CFR Part 312 or 21 CFR Part 812.' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gcpComplianceImpact rdf:type rdf:Property ;
    rdfs:label 'Gcp Compliance Impact' ;
    rdfs:comment 'Assessment of the impact of this protocol deviation on overall Good Clinical Practice (GCP) compliance and regulatory inspection readiness.' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringVisitNumber rdf:type rdf:Property ;
    rdfs:label 'Monitoring Visit Number' ;
    rdfs:comment 'The monitoring visit number during which the protocol deviation was identified, if detected during a monitoring visit.' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preventiveAction rdf:type rdf:Property ;
    rdfs:label 'Preventive Action' ;
    rdfs:comment 'Description of the preventive action implemented to prevent recurrence of similar protocol deviations in the future.' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protocolSectionReference rdf:type rdf:Property ;
    rdfs:label 'Protocol Section Reference' ;
    rdfs:comment 'Specific section, subsection, or clause of the protocol that was deviated from (e.g., Section 5.2.1).' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedDate rdf:type rdf:Property ;
    rdfs:label 'Reported Date' ;
    rdfs:comment 'The date on which the protocol deviation was formally reported to the appropriate parties (e.g., sponsor, IRB).' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewedByName rdf:type rdf:Property ;
    rdfs:label 'Reviewed By Name' ;
    rdfs:comment 'The name of the individual who reviewed and assessed the protocol deviation (typically the Principal Investigator or Quality Assurance personnel).' ;
    rdfs:domain ind:ProtocolDeviation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deidentifiedDatasetId rdf:type rdf:Property ;
    rdfs:label 'Deidentified Dataset Id' ;
    rdfs:comment 'Unique identifier for the de-identified research dataset record. Primary key for the dataset registry.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DeidentifiedDataset .

ind:fhirEndpointId rdf:type rdf:Property ;
    rdfs:label 'Fhir Endpoint Id' ;
    rdfs:comment 'Foreign key linking to interoperability.fhir_endpoint. Business justification: Deidentified research datasets published via FHIR endpoints for data sharing per NIH Data Sharing Policy and 21st Century Cures Act. Tracks which FHIR endpoint serves the dataset for access control an' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FhirEndpoint .

ind:primaryDeidentifiedEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Deidentified Employee Id' ;
    rdfs:comment 'Identifier of the user or system account that created this dataset record.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accessTier rdf:type rdf:Property ;
    rdfs:label 'Access Tier' ;
    rdfs:comment 'The access classification tier indicating the level of de-identification and corresponding access restrictions (internal, limited dataset per HIPAA, fully de-identified, public, controlled access).' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedUseCases rdf:type rdf:Property ;
    rdfs:label 'Approved Use Cases' ;
    rdfs:comment 'Description of the approved research use cases, purposes, or research questions for which this dataset may be accessed.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataDictionaryUrl rdf:type rdf:Property ;
    rdfs:label 'Data Dictionary Url' ;
    rdfs:comment 'URL or reference to the data dictionary or codebook documenting the structure, variables, and codes in the dataset.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataElementsIncluded rdf:type rdf:Property ;
    rdfs:label 'Data Elements Included' ;
    rdfs:comment 'Description or list of the data elements, fields, or variables included in the de-identified dataset.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSharingAgreementReference rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Agreement Reference' ;
    rdfs:comment 'Reference number or identifier for the master data sharing agreement or data use agreement template governing access to this dataset.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataStewardDepartment rdf:type rdf:Property ;
    rdfs:label 'Data Steward Department' ;
    rdfs:comment 'The department or organizational unit to which the data steward belongs.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataStewardEmail rdf:type rdf:Property ;
    rdfs:label 'Data Steward Email' ;
    rdfs:comment 'Email address of the data steward for dataset inquiries and access requests.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataStewardName rdf:type rdf:Property ;
    rdfs:label 'Data Steward Name' ;
    rdfs:comment 'Name of the individual or role responsible for the governance and oversight of this de-identified dataset.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataUseAgreementRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Data Use Agreement Required Flag' ;
    rdfs:comment 'Indicates whether a signed Data Use Agreement is required before granting access to this dataset.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:datasetCode rdf:type rdf:Property ;
    rdfs:label 'Dataset Code' ;
    rdfs:comment 'Unique business identifier or code assigned to the dataset for external reference and tracking.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:datasetCreationDate rdf:type rdf:Property ;
    rdfs:label 'Dataset Creation Date' ;
    rdfs:comment 'The date when this version of the de-identified dataset was created or extracted from source systems.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:datasetDescription rdf:type rdf:Property ;
    rdfs:label 'Dataset Description' ;
    rdfs:comment 'Detailed narrative description of the dataset content, purpose, population, and key characteristics for researchers and data governance.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:datasetExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Dataset Expiration Date' ;
    rdfs:comment 'The date when this dataset version expires and should no longer be used for new access requests, requiring refresh or retirement.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:datasetFormat rdf:type rdf:Property ;
    rdfs:label 'Dataset Format' ;
    rdfs:comment 'The file format or data structure format of the dataset (e.g., CSV, Parquet, SAS, FHIR, OMOP CDM).' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:datasetLocationPath rdf:type rdf:Property ;
    rdfs:label 'Dataset Location Path' ;
    rdfs:comment 'The file system path, cloud storage location, or repository URL where the de-identified dataset files are stored.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:datasetName rdf:type rdf:Property ;
    rdfs:label 'Dataset Name' ;
    rdfs:comment 'Human-readable name or title of the de-identified dataset for identification and cataloging purposes.' ;
    rdfs:domain ind:DeidentifiedDataset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:datasetSizeMb rdf:type rdf:Property ;
    rdfs:label 'Dataset Size Mb' ;
    rdfs:comment 'The total size of the dataset in megabytes, useful for storage planning and access provisioning.' ;
