ind:samSanctionsScreeningDate rdf:type rdf:Property ;
    rdfs:label 'Sam Sanctions Screening Date' ;
    rdfs:comment 'The date when the SAM exclusion list screening was performed.' ;
    rdfs:domain ind:RecredentialingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:samSanctionsResult rdf:type rdf:Property ;
    rdfs:label 'Sam Sanctions Result' ;
    rdfs:comment 'The result of the SAM exclusion list screening.' ;
    rdfs:domain ind:RecredentialingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerReferencesVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Peer References Verification Status' ;
    rdfs:comment 'The status of peer reference verification for this re-credentialing event.' ;
