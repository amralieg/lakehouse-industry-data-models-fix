    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreType rdf:type rdf:Property ;
    rdfs:label 'Score Type' ;
    rdfs:comment 'Type of calculation used to express measure performance (proportion, ratio, continuous variable, or rate).' ;
