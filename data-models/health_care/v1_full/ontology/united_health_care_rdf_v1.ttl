    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:makerTitle rdf:type rdf:Property ;
    rdfs:label 'Maker Title' ;
    rdfs:comment 'Professional title or role of the individual who made the credentialing decision.' ;
    rdfs:domain ind:CredentialingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rationale rdf:type rdf:Property ;
    rdfs:label 'Rationale' ;
    rdfs:comment 'Detailed explanation of the rationale and justification for the credentialing decision, including any conditions or restrictions.' ;
    rdfs:domain ind:CredentialingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalConditions rdf:type rdf:Property ;
    rdfs:label 'Approval Conditions' ;
    rdfs:comment 'Any conditions, restrictions, or limitations placed on the provider\'s approval, such as supervision requirements or scope of practice limitations.' ;
    rdfs:domain ind:CredentialingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:malpracticeAggregateAmount rdf:type rdf:Property ;
    rdfs:label 'Malpractice Aggregate Amount' ;
    rdfs:comment 'Total dollar amount of professional liability insurance coverage aggregate limit per policy period.' ;
    rdfs:domain ind:CredentialingDecision ;
    rdf:type owl:DatatypeProperty ;
