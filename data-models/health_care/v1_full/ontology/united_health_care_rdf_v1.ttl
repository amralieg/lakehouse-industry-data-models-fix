ind:sanctionsScreeningRequired rdf:type rdf:Property ;
    rdfs:label 'Sanctions Screening Required' ;
    rdfs:comment 'Indicates whether practitioners with this license type must be screened against federal and state sanctions lists (OIG, SAM, state exclusion lists).' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oigScreeningRequired rdf:type rdf:Property ;
    rdfs:label 'Oig Screening Required' ;
    rdfs:comment 'Indicates whether screening against the OIG List of Excluded Individuals and Entities (LEIE) is required for this license type.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:samScreeningRequired rdf:type rdf:Property ;
    rdfs:label 'Sam Screening Required' ;
    rdfs:comment 'Indicates whether screening against the federal System for Award Management (SAM) exclusion list is required for this license type.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:credentialingCommitteeReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Credentialing Committee Review Required' ;
    rdfs:comment 'Indicates whether applications for practitioners with this license type must be reviewed by the credentialing committee.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:npiRequired rdf:type rdf:Property ;
    rdfs:label 'Npi Required' ;
    rdfs:comment 'Indicates whether practitioners with this license type are required to have a National Provider Identifier (NPI) for billing purposes.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareEnrollmentEligible rdf:type rdf:Property ;
    rdfs:label 'Medicare Enrollment Eligible' ;
    rdfs:comment 'Indicates whether practitioners with this license type are eligible to enroll in Medicare as participating providers.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidEnrollmentEligible rdf:type rdf:Property ;
    rdfs:label 'Medicaid Enrollment Eligible' ;
    rdfs:comment 'Indicates whether practitioners with this license type are eligible to enroll in state Medicaid programs as participating providers.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supervisionRequired rdf:type rdf:Property ;
    rdfs:label 'Supervision Required' ;
    rdfs:comment 'Indicates whether practitioners with this license type must practice under supervision of another licensed professional.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collaborativeAgreementRequired rdf:type rdf:Property ;
    rdfs:label 'Collaborative Agreement Required' ;
    rdfs:comment 'Indicates whether practitioners with this license type require a collaborative practice agreement with a physician or other supervising practitioner.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalPrivilegesApplicable rdf:type rdf:Property ;
    rdfs:label 'Hospital Privileges Applicable' ;
    rdfs:comment 'Indicates whether practitioners with this license type typically require hospital privileges for inpatient care.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telemedicineEligible rdf:type rdf:Property ;
    rdfs:label 'Telemedicine Eligible' ;
    rdfs:comment 'Indicates whether practitioners with this license type are eligible to provide telemedicine services under applicable regulations.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interstateCompactEligible rdf:type rdf:Property ;
    rdfs:label 'Interstate Compact Eligible' ;
    rdfs:comment 'Indicates whether this license type is eligible for interstate licensure compacts (e.g., Nurse Licensure Compact, Interstate Medical Licensure Compact).' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verificationUrl rdf:type rdf:Property ;
    rdfs:label 'Verification Url' ;
    rdfs:comment 'Web address for online verification of licenses of this type through the issuing authority portal.' ;
    rdfs:domain ind:LicenseType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:malpracticeInsuranceId rdf:type rdf:Property ;
    rdfs:label 'Malpractice Insurance Id' ;
    rdfs:comment 'Unique identifier for the malpractice insurance record in the credentialing system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MalpracticeInsurance .

ind:carrierName rdf:type rdf:Property ;
    rdfs:label 'Carrier Name' ;
    rdfs:comment 'Name of the insurance company providing the malpractice coverage.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierNaicCode rdf:type rdf:Property ;
    rdfs:label 'Carrier Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code that uniquely identifies the insurance carrier.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierAmBestRating rdf:type rdf:Property ;
    rdfs:label 'Carrier Am Best Rating' ;
    rdfs:comment 'AM Best rating indicating the financial strength and creditworthiness of the insurance carrier.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perOccurrenceLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Per Occurrence Limit Amount' ;
    rdfs:comment 'Maximum dollar amount the insurance carrier will pay for a single malpractice claim or occurrence.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aggregateLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Amount' ;
    rdfs:comment 'Maximum total dollar amount the insurance carrier will pay for all malpractice claims during the policy period.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retroactiveDate rdf:type rdf:Property ;
    rdfs:label 'Retroactive Date' ;
    rdfs:comment 'Earliest date of service for which claims will be covered under a claims-made policy.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tailCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Tail Coverage Indicator' ;
    rdfs:comment 'Flag indicating whether extended reporting period (tail) coverage is included to cover claims reported after policy expiration for incidents that occurred during the policy period.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tailCoverageExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Tail Coverage Expiration Date' ;
    rdfs:comment 'Date when the extended reporting period (tail) coverage terminates.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:selfInsuredIndicator rdf:type rdf:Property ;
    rdfs:label 'Self Insured Indicator' ;
    rdfs:comment 'Flag indicating whether the provider or organization is self-insured for malpractice liability rather than purchasing commercial insurance.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:selfInsuredRetentionAmount rdf:type rdf:Property ;
    rdfs:label 'Self Insured Retention Amount' ;
    rdfs:comment 'Dollar amount of loss that the insured must pay before the insurance coverage applies, similar to a deductible but typically larger.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certificateIssueDate rdf:type rdf:Property ;
    rdfs:label 'Certificate Issue Date' ;
    rdfs:comment 'Date when the certificate of insurance was issued by the carrier or agent.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificateHolderName rdf:type rdf:Property ;
    rdfs:label 'Certificate Holder Name' ;
    rdfs:comment 'Name of the entity (typically the health plan or credentialing organization) that is listed as the certificate holder for notification purposes.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:additionalInsuredIndicator rdf:type rdf:Property ;
    rdfs:label 'Additional Insured Indicator' ;
    rdfs:comment 'Flag indicating whether the health plan or contracting entity is named as an additional insured on the policy.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageTerritory rdf:type rdf:Property ;
    rdfs:label 'Coverage Territory' ;
    rdfs:comment 'Geographic area or jurisdiction where the malpractice insurance coverage applies.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyCoverage rdf:type rdf:Property ;
    rdfs:label 'Specialty Coverage' ;
    rdfs:comment 'Medical specialty or specialties covered under the malpractice insurance policy.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedProcedures rdf:type rdf:Property ;
    rdfs:label 'Excluded Procedures' ;
    rdfs:comment 'Specific medical procedures or services that are explicitly excluded from coverage under the policy.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsHistoryIndicator rdf:type rdf:Property ;
    rdfs:label 'Claims History Indicator' ;
    rdfs:comment 'Flag indicating whether the provider has a history of malpractice claims filed against them.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementsCount rdf:type rdf:Property ;
    rdfs:label 'Settlements Count' ;
    rdfs:comment 'Total number of malpractice claims that resulted in settlements during the review period.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:judgmentsCount rdf:type rdf:Property ;
    rdfs:label 'Judgments Count' ;
    rdfs:comment 'Total number of malpractice claims that resulted in court judgments against the provider during the review period.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalSettlementsAmount rdf:type rdf:Property ;
    rdfs:label 'Total Settlements Amount' ;
    rdfs:comment 'Total dollar amount paid in settlements for malpractice claims during the review period.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:npdbReportIndicator rdf:type rdf:Property ;
    rdfs:label 'Npdb Report Indicator' ;
    rdfs:comment 'Flag indicating whether any malpractice payments or adverse actions were reported in the NPDB query.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brokerContactPhone rdf:type rdf:Property ;
    rdfs:label 'Broker Contact Phone' ;
    rdfs:comment 'Phone number for contacting the insurance broker or agent regarding the policy.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerContactEmail rdf:type rdf:Property ;
    rdfs:label 'Broker Contact Email' ;
    rdfs:comment 'Email address for contacting the insurance broker or agent regarding the policy.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierContactPhone rdf:type rdf:Property ;
    rdfs:label 'Carrier Contact Phone' ;
    rdfs:comment 'Phone number for contacting the insurance carrier directly regarding the policy.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierContactEmail rdf:type rdf:Property ;
    rdfs:label 'Carrier Contact Email' ;
    rdfs:comment 'Email address for contacting the insurance carrier directly regarding the policy.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentUploadDate rdf:type rdf:Property ;
    rdfs:label 'Document Upload Date' ;
    rdfs:comment 'Date when the malpractice insurance certificate or related documents were uploaded to the credentialing system.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumCoverageRequirementMetIndicator rdf:type rdf:Property ;
    rdfs:label 'Minimum Coverage Requirement Met Indicator' ;
    rdfs:comment 'Flag indicating whether the malpractice insurance coverage meets the health plan\'s minimum coverage requirements.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumPerOccurrenceRequirement rdf:type rdf:Property ;
    rdfs:label 'Minimum Per Occurrence Requirement' ;
    rdfs:comment 'Minimum per occurrence limit amount required by the health plan for provider credentialing.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumAggregateRequirement rdf:type rdf:Property ;
    rdfs:label 'Minimum Aggregate Requirement' ;
    rdfs:comment 'Minimum aggregate limit amount required by the health plan for provider credentialing.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alertNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Alert Notification Date' ;
    rdfs:comment 'Date when an alert notification should be sent regarding upcoming policy expiration or verification requirements.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:alertNotificationSentIndicator rdf:type rdf:Property ;
    rdfs:label 'Alert Notification Sent Indicator' ;
    rdfs:comment 'Flag indicating whether an alert notification has been sent to the provider or credentialing staff regarding policy expiration or verification.' ;
    rdfs:domain ind:MalpracticeInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:boardCertificationId rdf:type rdf:Property ;
    rdfs:label 'Board Certification Id' ;
    rdfs:comment 'Unique identifier for the board certification specialty record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BoardCertification .

ind:certificationName rdf:type rdf:Property ;
    rdfs:label 'Certification Name' ;
    rdfs:comment 'Full name of the board certification specialty (e.g., Internal Medicine, Cardiology, Family Medicine).' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationCode rdf:type rdf:Property ;
    rdfs:label 'Certification Code' ;
    rdfs:comment 'Standardized code representing the board certification specialty for system processing and data exchange.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditingBodyName rdf:type rdf:Property ;
    rdfs:label 'Accrediting Body Name' ;
    rdfs:comment 'Name of the organization that grants and maintains the board certification (e.g., American Board of Internal Medicine, American Board of Surgery).' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditingBodyCode rdf:type rdf:Property ;
    rdfs:label 'Accrediting Body Code' ;
    rdfs:comment 'Standardized code for the accrediting organization used in credentialing systems and data exchange.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditingBodyType rdf:type rdf:Property ;
    rdfs:label 'Accrediting Body Type' ;
    rdfs:comment 'Classification of the accrediting body (ABMS member board, AOA member board, other recognized, or international).' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:abmsRecognizedFlag rdf:type rdf:Property ;
    rdfs:label 'Abms Recognized Flag' ;
    rdfs:comment 'Indicates whether the certification is recognized by the American Board of Medical Specialties.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aoaRecognizedFlag rdf:type rdf:Property ;
    rdfs:label 'Aoa Recognized Flag' ;
    rdfs:comment 'Indicates whether the certification is recognized by the American Osteopathic Association.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ncqaCredentialingAcceptedFlag rdf:type rdf:Property ;
    rdfs:label 'Ncqa Credentialing Accepted Flag' ;
    rdfs:comment 'Indicates whether this certification is accepted for NCQA credentialing standards compliance.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsRecognizedFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Recognized Flag' ;
    rdfs:comment 'Indicates whether the certification is recognized by CMS for provider enrollment and reimbursement purposes.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recertificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Recertification Required Flag' ;
    rdfs:comment 'Indicates whether periodic recertification is required to maintain this board certification.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mocRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Moc Required Flag' ;
    rdfs:comment 'Indicates whether ongoing Maintenance of Certification activities are required for this board certification.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:initialCertificationExamRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Initial Certification Exam Required Flag' ;
    rdfs:comment 'Indicates whether an initial certification examination is required to obtain this board certification.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:residencyTrainingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Residency Training Required Flag' ;
    rdfs:comment 'Indicates whether completion of an accredited residency program is required for this certification.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fellowshipTrainingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Fellowship Training Required Flag' ;
    rdfs:comment 'Indicates whether completion of an accredited fellowship program is required for this certification.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumTrainingYears rdf:type rdf:Property ;
    rdfs:label 'Minimum Training Years' ;
    rdfs:comment 'Minimum number of years of post-graduate training required to be eligible for this board certification.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalFocusAreas rdf:type rdf:Property ;
    rdfs:label 'Clinical Focus Areas' ;
    rdfs:comment 'Specific clinical areas or conditions covered by this board certification specialty.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceSettingTypes rdf:type rdf:Property ;
    rdfs:label 'Practice Setting Types' ;
    rdfs:comment 'Typical practice settings where providers with this certification practice (e.g., hospital, outpatient clinic, surgical center).' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageGroupFocus rdf:type rdf:Property ;
    rdfs:label 'Age Group Focus' ;
    rdfs:comment 'Primary age group focus for this specialty certification (e.g., pediatric, adult, geriatric, all ages).' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingPriorityLevel rdf:type rdf:Property ;
    rdfs:label 'Credentialing Priority Level' ;
    rdfs:comment 'Priority level assigned by the health plan for credentialing purposes (required for certain specialties, preferred, accepted, or not recognized).' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkParticipationEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Network Participation Eligible Flag' ;
    rdfs:comment 'Indicates whether providers with this certification are eligible for network participation without additional requirements.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primarySourceVerificationUrl rdf:type rdf:Property ;
    rdfs:label 'Primary Source Verification Url' ;
    rdfs:comment 'Web address for primary source verification of this board certification with the accrediting body.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditingBodyContactPhone rdf:type rdf:Property ;
    rdfs:label 'Accrediting Body Contact Phone' ;
    rdfs:comment 'Primary contact phone number for the accrediting body for verification purposes.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditingBodyContactEmail rdf:type rdf:Property ;
    rdfs:label 'Accrediting Body Contact Email' ;
    rdfs:comment 'Primary contact email address for the accrediting body for verification purposes.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditingBodyWebsite rdf:type rdf:Property ;
    rdfs:label 'Accrediting Body Website' ;
    rdfs:comment 'Official website of the accrediting body providing certification information and verification services.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internationalEquivalentFlag rdf:type rdf:Property ;
    rdfs:label 'International Equivalent Flag' ;
    rdfs:comment 'Indicates whether this certification has recognized international equivalents for foreign-trained physicians.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timeLimitedCertificationFlag rdf:type rdf:Property ;
    rdfs:label 'Time Limited Certification Flag' ;
    rdfs:comment 'Indicates whether this is a time-limited certification that expires without recertification activities.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lifetimeCertificationFlag rdf:type rdf:Property ;
    rdfs:label 'Lifetime Certification Flag' ;
    rdfs:comment 'Indicates whether this certification is granted for lifetime without expiration or recertification requirements.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grandfatheredCertificationFlag rdf:type rdf:Property ;
    rdfs:label 'Grandfathered Certification Flag' ;
    rdfs:comment 'Indicates whether this certification includes grandfathered provisions for physicians certified under previous standards.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caqhSpecialtyCode rdf:type rdf:Property ;
    rdfs:label 'Caqh Specialty Code' ;
    rdfs:comment 'CAQH ProView specialty code mapping for this board certification used in provider data exchange.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedisSpecialtyMapping rdf:type rdf:Property ;
    rdfs:label 'Hedis Specialty Mapping' ;
    rdfs:comment 'HEDIS specialty category mapping for quality measure reporting and network adequacy analysis.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkAdequacySpecialtyFlag rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Specialty Flag' ;
    rdfs:comment 'Indicates whether this specialty is included in network adequacy reporting requirements for regulatory compliance.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorAuthorizationSpecialtyFlag rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Specialty Flag' ;
    rdfs:comment 'Indicates whether this specialty typically requires prior authorization for services under utilization management programs.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryCareSpecialtyFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Care Specialty Flag' ;
    rdfs:comment 'Indicates whether this certification qualifies as a primary care specialty for Primary Care Physician (PCP) assignment and network adequacy.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:behavioralHealthSpecialtyFlag rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Specialty Flag' ;
    rdfs:comment 'Indicates whether this certification is classified as a behavioral health or mental health specialty.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surgicalSpecialtyFlag rdf:type rdf:Property ;
    rdfs:label 'Surgical Specialty Flag' ;
    rdfs:comment 'Indicates whether this certification is classified as a surgical specialty for credentialing and privileging purposes.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalBasedSpecialtyFlag rdf:type rdf:Property ;
    rdfs:label 'Hospital Based Specialty Flag' ;
    rdfs:comment 'Indicates whether this specialty is typically hospital-based (e.g., anesthesiology, radiology, pathology) for contracting purposes.' ;
    rdfs:domain ind:BoardCertification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verificationFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Verification Frequency Days' ;
