    rdfs:label 'Document Number' ;
    rdfs:comment 'External business identifier assigned to the DUA document, often used in contracts and audits.' ;
    rdfs:domain ind:DuaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duaDocumentDescription rdf:type rdf:Property ;
