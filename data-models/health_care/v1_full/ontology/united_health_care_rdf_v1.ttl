    rdfs:range xsd:decimal .

ind:pharmacyTier1Copay rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Tier 1 Copay' ;
    rdfs:comment 'Copayment amount for Tier 1 preferred generic drugs in the Part D formulary.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pharmacyTier2Copay rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Tier 2 Copay' ;
    rdfs:comment 'Copayment amount for Tier 2 generic drugs in the Part D formulary.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pharmacyTier3Copay rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Tier 3 Copay' ;
    rdfs:comment 'Copayment amount for Tier 3 preferred brand drugs in the Part D formulary.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pharmacyTier4Copay rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Tier 4 Copay' ;
    rdfs:comment 'Copayment amount for Tier 4 non-preferred brand drugs in the Part D formulary.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pharmacyTier5CoinsurancePct rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Tier 5 Coinsurance Pct' ;
    rdfs:comment 'Coinsurance percentage for Tier 5 specialty drugs in the Part D formulary.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mailOrderPharmacyAvailable rdf:type rdf:Property ;
    rdfs:label 'Mail Order Pharmacy Available' ;
    rdfs:comment 'Indicates whether mail order pharmacy service is available for maintenance medications.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quantityLimitsApplied rdf:type rdf:Property ;
    rdfs:label 'Quantity Limits Applied' ;
    rdfs:comment 'Indicates whether quantity limits are applied to certain medications or supplies.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referralRequiredForSpecialist rdf:type rdf:Property ;
    rdfs:label 'Referral Required For Specialist' ;
    rdfs:comment 'Indicates whether a PCP referral is required to see a specialist physician.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfNetworkMoopAmount rdf:type rdf:Property ;
    rdfs:label 'Out Of Network Moop Amount' ;
    rdfs:comment 'Maximum annual out-of-pocket limit for out-of-network services if coverage is available.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:worldwideEmergencyCoverage rdf:type rdf:Property ;
    rdfs:label 'Worldwide Emergency Coverage' ;
    rdfs:comment 'Indicates whether emergency services are covered when traveling outside the United States.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partBPremiumReduction rdf:type rdf:Property ;
    rdfs:label 'Part B Premium Reduction' ;
    rdfs:comment 'Monthly reduction in Medicare Part B premium provided by the plan, if applicable.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:partBGivebackAmount rdf:type rdf:Property ;
    rdfs:label 'Part B Giveback Amount' ;
    rdfs:comment 'Monthly amount the plan pays toward member Part B premium as a supplemental benefit.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:careManagementProgramIncluded rdf:type rdf:Property ;
    rdfs:label 'Care Management Program Included' ;
    rdfs:comment 'Indicates whether disease management or care coordination programs are included in the benefit design.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nurseHotlineAvailable rdf:type rdf:Property ;
    rdfs:label 'Nurse Hotline Available' ;
    rdfs:comment 'Indicates whether 24/7 nurse advice hotline is available to members.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insulinCopayCap rdf:type rdf:Property ;
    rdfs:label 'Insulin Copay Cap' ;
    rdfs:comment 'Maximum monthly copayment amount for insulin products as mandated by federal law.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vaccinesCoveredAtNoCost rdf:type rdf:Property ;
    rdfs:label 'Vaccines Covered At No Cost' ;
    rdfs:comment 'Indicates whether Part D vaccines are covered with zero cost sharing as mandated by federal law.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lowIncomeSubsidyApplicable rdf:type rdf:Property ;
    rdfs:label 'Low Income Subsidy Applicable' ;
    rdfs:comment 'Indicates whether the benefit design accommodates low-income subsidy beneficiaries with reduced cost sharing.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareSecondaryPayerCoordination rdf:type rdf:Property ;
    rdfs:label 'Medicare Secondary Payer Coordination' ;
    rdfs:comment 'Indicates whether the benefit design includes coordination of benefits when Medicare is secondary payer.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sbcDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Sbc Document Url' ;
    rdfs:comment 'URL link to the Summary of Benefits and Coverage document for member access.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:anocDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Anoc Document Url' ;
    rdfs:comment 'URL link to the Annual Notice of Change document describing benefit modifications.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eocDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Eoc Document Url' ;
    rdfs:comment 'URL link to the Evidence of Coverage document detailing all plan benefits and rules.' ;
    rdfs:domain ind:BenefitDesign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceStatusCodeId rdf:type rdf:Property ;
    rdfs:label 'Service Status Code Id' ;
    rdfs:comment 'Unique identifier for the service status code reference record.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceStatusCode .

ind:isTerminal rdf:type rdf:Property ;
    rdfs:label 'Is Terminal' ;
    rdfs:comment 'Indicates whether this status represents a final state in the service case lifecycle (e.g., Closed, Resolved) where no further transitions are expected.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReopenable rdf:type rdf:Property ;
    rdfs:label 'Is Reopenable' ;
    rdfs:comment 'Indicates whether a case in this status can be reopened or transitioned back to an active state.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresAction rdf:type rdf:Property ;
    rdfs:label 'Requires Action' ;
    rdfs:comment 'Indicates whether cases in this status require immediate action or follow-up from service representatives.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaApplicable rdf:type rdf:Property ;
    rdfs:label 'Sla Applicable' ;
    rdfs:comment 'Indicates whether Service Level Agreement timers and metrics apply to cases in this status.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaPause rdf:type rdf:Property ;
    rdfs:label 'Sla Pause' ;
    rdfs:comment 'Indicates whether SLA timers should be paused when a case enters this status (e.g., Pending Member Response).' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationEligible rdf:type rdf:Property ;
    rdfs:label 'Escalation Eligible' ;
    rdfs:comment 'Indicates whether cases in this status can be escalated to higher support tiers or management.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fcrEligible rdf:type rdf:Property ;
    rdfs:label 'Fcr Eligible' ;
    rdfs:comment 'Indicates whether cases resolved in this status count toward First Call Resolution metrics.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:npsSurveyTrigger rdf:type rdf:Property ;
    rdfs:label 'Nps Survey Trigger' ;
    rdfs:comment 'Indicates whether transitioning to this status should trigger an NPS survey to be sent to the member.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:satisfactionSurveyTrigger rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Survey Trigger' ;
    rdfs:comment 'Indicates whether transitioning to this status should trigger a member satisfaction survey.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowedTransitions rdf:type rdf:Property ;
    rdfs:label 'Allowed Transitions' ;
    rdfs:comment 'Comma-separated list of status codes to which cases can transition from this status, enforcing workflow rules.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportable rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reportable' ;
    rdfs:comment 'Indicates whether cases in this status must be included in regulatory reporting to CMS, state departments of insurance, or other governing bodies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grievanceApplicable rdf:type rdf:Property ;
    rdfs:label 'Grievance Applicable' ;
    rdfs:comment 'Indicates whether this status is applicable to formal grievance cases requiring special handling under regulatory requirements.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealApplicable rdf:type rdf:Property ;
    rdfs:label 'Appeal Applicable' ;
    rdfs:comment 'Indicates whether this status is applicable to appeal cases requiring adherence to regulatory timelines and processes.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tatHours rdf:type rdf:Property ;
    rdfs:label 'Tat Hours' ;
    rdfs:comment 'Standard turnaround time in hours expected for cases in this status before transition to the next stage.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorityWeight rdf:type rdf:Property ;
    rdfs:label 'Priority Weight' ;
    rdfs:comment 'Numeric weight used in prioritization algorithms to determine case handling urgency when in this status.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agingThresholdDays rdf:type rdf:Property ;
    rdfs:label 'Aging Threshold Days' ;
    rdfs:comment 'Number of days after which a case in this status is considered aged and requires management attention or escalation.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiresReasonCode rdf:type rdf:Property ;
    rdfs:label 'Requires Reason Code' ;
    rdfs:comment 'Indicates whether a reason code or explanation must be provided when transitioning a case to this status.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalStatusMapping rdf:type rdf:Property ;
    rdfs:label 'External Status Mapping' ;
    rdfs:comment 'Mapping code used to translate this internal status to equivalent status codes in external systems or partner interfaces.' ;
    rdfs:domain ind:ServiceStatusCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inclusionCriteriaId rdf:type rdf:Property ;
    rdfs:label 'Inclusion Criteria Id' ;
    rdfs:comment 'Unique identifier for the inclusion criteria record.' ;
    rdfs:domain ind:InclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:criteriaCodeSystem rdf:type rdf:Property ;
    rdfs:label 'Criteria Code System' ;
    rdfs:comment 'The coding system used for the criteria code.' ;
    rdfs:domain ind:InclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criteriaDescription rdf:type rdf:Property ;
    rdfs:label 'Criteria Description' ;
    rdfs:comment 'Human readable description of the inclusion criteria.' ;
    rdfs:domain ind:InclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inclusionStatus rdf:type rdf:Property ;
    rdfs:label 'Inclusion Status' ;
    rdfs:comment 'Current status of the inclusion criteria.' ;
    rdfs:domain ind:InclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Eligibility Flag' ;
    rdfs:comment 'Indicates whether the criteria qualifies for reimbursement eligibility.' ;
    rdfs:domain ind:InclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiredFlag rdf:type rdf:Property ;
    rdfs:label 'Required Flag' ;
    rdfs:comment 'Indicates if the criteria is mandatory for claim acceptance.' ;
    rdfs:domain ind:InclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:frequencyLimit rdf:type rdf:Property ;
    rdfs:label 'Frequency Limit' ;
    rdfs:comment 'Maximum frequency the service/medication can be provided within a time period.' ;
    rdfs:domain ind:InclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthCode rdf:type rdf:Property ;
    rdfs:label 'Prior Auth Code' ;
    rdfs:comment 'Code used to request prior authorization.' ;
    rdfs:domain ind:InclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reimbursementUnit rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Unit' ;
    rdfs:comment 'Unit of measurement for the reimbursement rate.' ;
    rdfs:domain ind:InclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costSharingAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Amount' ;
    rdfs:comment 'Monetary amount the member must pay (e.g., copay).' ;
    rdfs:domain ind:InclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costSharingPercent rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Percent' ;
    rdfs:comment 'Percentage of the charge the member is responsible for (e.g., coinsurance).' ;
    rdfs:domain ind:InclusionCriteria ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:npsScoreId rdf:type rdf:Property ;
    rdfs:label 'Nps Score Id' ;
    rdfs:comment 'Unique identifier for each NPS score record collected via member or provider surveys.' ;
    rdfs:domain ind:NpsScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveyResponseId rdf:type rdf:Property ;
    rdfs:label 'Survey Response Id' ;
    rdfs:comment 'Unique identifier linking this NPS score to the originating survey response record in the survey management system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SurveyResponse .

ind:respondentType rdf:type rdf:Property ;
    rdfs:label 'Respondent Type' ;
    rdfs:comment 'Classification of the survey respondent indicating whether they are a member, provider, employer group contact, broker, or caregiver.' ;
    rdfs:domain ind:NpsScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npsCategory rdf:type rdf:Property ;
    rdfs:label 'Nps Category' ;
    rdfs:comment 'Classification of the respondent based on their NPS score: Promoter (9-10), Passive (7-8), or Detractor (0-6).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promoterFlag rdf:type rdf:Property ;
    rdfs:label 'Promoter Flag' ;
    rdfs:comment 'Boolean indicator set to true if the respondent is classified as a Promoter (score 9-10), false otherwise.' ;
    rdfs:domain ind:NpsScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detractorFlag rdf:type rdf:Property ;
    rdfs:label 'Detractor Flag' ;
    rdfs:comment 'Boolean indicator set to true if the respondent is classified as a Detractor (score 0-6), false otherwise.' ;
    rdfs:domain ind:NpsScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detractorReasonCode rdf:type rdf:Property ;
    rdfs:label 'Detractor Reason Code' ;
    rdfs:comment 'Standardized code representing the primary reason provided by a detractor for their low NPS score.' ;
    rdfs:domain ind:NpsScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detractorReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Detractor Reason Description' ;
    rdfs:comment 'Detailed textual description of the reason provided by a detractor for their low NPS score, captured from open-ended survey responses.' ;
    rdfs:domain ind:NpsScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedbackComment rdf:type rdf:Property ;
    rdfs:label 'Feedback Comment' ;
    rdfs:comment 'Open-ended textual feedback provided by the respondent explaining their NPS score or providing additional context about their experience.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:touchpointType rdf:type rdf:Property ;
    rdfs:label 'Touchpoint Type' ;
    rdfs:comment 'The specific type of member or provider interaction or service touchpoint that triggered the transactional NPS survey.' ;
    rdfs:domain ind:NpsScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionId rdf:type rdf:Property ;
    rdfs:label 'Interaction Id' ;
    rdfs:comment 'Unique identifier for the specific customer service interaction, claim, or transaction that triggered the NPS survey.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Interaction .

ind:memberTenureMonths rdf:type rdf:Property ;
    rdfs:label 'Member Tenure Months' ;
    rdfs:comment 'The number of months the member has been enrolled with UnitedHealthcare at the time of the NPS survey.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agentName rdf:type rdf:Property ;
    rdfs:label 'Agent Name' ;
    rdfs:comment 'Name of the customer service agent or representative who handled the interaction that triggered the NPS survey.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactCenterLocation rdf:type rdf:Property ;
    rdfs:label 'Contact Center Location' ;
    rdfs:comment 'Geographic location or site identifier of the contact center where the interaction occurred.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTeam rdf:type rdf:Property ;
    rdfs:label 'Service Team' ;
    rdfs:comment 'The specific service team or department responsible for the interaction that triggered the NPS survey (e.g., Claims, Enrollment, Appeals).' ;
    rdfs:domain ind:NpsScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstCallResolutionFlag rdf:type rdf:Property ;
    rdfs:label 'First Call Resolution Flag' ;
    rdfs:comment 'Boolean indicator set to true if the member\'s issue was resolved on the first contact without requiring follow-up.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surveyLanguage rdf:type rdf:Property ;
    rdfs:label 'Survey Language' ;
    rdfs:comment 'The language in which the NPS survey was presented and completed by the respondent.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyVendor rdf:type rdf:Property ;
    rdfs:label 'Survey Vendor' ;
    rdfs:comment 'Name of the third-party vendor or platform used to administer the NPS survey, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseValidityFlag rdf:type rdf:Property ;
    rdfs:label 'Response Validity Flag' ;
    rdfs:comment 'Boolean indicator set to true if the survey response passed all quality and validity checks, false if flagged as potentially fraudulent or invalid.' ;
    rdfs:domain ind:NpsScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpCaseId rdf:type rdf:Property ;
    rdfs:label 'Follow Up Case Id' ;
    rdfs:comment 'Unique identifier for the follow-up case created in response to a detractor NPS score or critical feedback.' ;
    rdfs:domain ind:NpsScore ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Case .

ind:followUpCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Completed Date' ;
    rdfs:comment 'The date on which follow-up action was completed in response to the NPS feedback.' ;
    rdfs:domain ind:NpsScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contactType rdf:type rdf:Property ;
    rdfs:label 'Contact Type' ;
    rdfs:comment 'Classification of the party initiating or involved in the interaction.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:direction rdf:type rdf:Property ;
    rdfs:label 'Direction' ;
