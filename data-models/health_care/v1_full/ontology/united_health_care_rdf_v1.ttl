    rdfs:comment 'Primary data source used for risk score calculation when multiple sources contain conflicting diagnosis information.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supplementalDiagnosisSource rdf:type rdf:Property ;
