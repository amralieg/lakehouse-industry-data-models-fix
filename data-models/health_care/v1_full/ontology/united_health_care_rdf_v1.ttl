ind:memberPortalAccessCoordination rdf:type rdf:Property ;
    rdfs:label 'Member Portal Access Coordination' ;
    rdfs:comment 'Method for coordinating member portal access and display of information for parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealsCoordinationRule rdf:type rdf:Property ;
    rdfs:label 'Appeals Coordination Rule' ;
    rdfs:comment 'Rule defining how appeals and grievances are coordinated between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudDetectionCoordination rdf:type rdf:Property ;
    rdfs:label 'Fraud Detection Coordination' ;
    rdfs:comment 'Method for coordinating fraud, waste, and abuse detection activities between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
