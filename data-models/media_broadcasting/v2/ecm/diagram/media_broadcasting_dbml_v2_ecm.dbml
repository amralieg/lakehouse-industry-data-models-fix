  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the invoice amount. | Column currency_code (STRING) in billing.billing_carriage_fee_invoice']
  dispute_adjustment_amount decimal(18,2) [note: 'Adjustment amount applied due to billing disputes or makegoods for service level failures. | Column dispute_adjustment_amount (DECIMAL(18,2)) in billing.billing_carriage_fee_invoice']
  due_date date [note: 'Date by which payment is due from the MVPD operator per contractual payment terms. | Column due_date (DATE) in billing.billing_carriage_fee_invoice']
  escalation_adjustment_amount decimal(18,2) [note: 'Adjustment amount applied due to contractual escalation clause (e.g., annual rate increase, CPI adjustment). | Column escalation_adjustment_amount (DECIMAL(18,2)) in billing.billing_carriage_fee_invoice']
