ind:escalationRecipient rdf:type rdf:Property ;
    rdfs:label 'Escalation Recipient' ;
    rdfs:comment 'Name or title of the individual or committee to whom the risk assessment was escalated.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachNotificationId rdf:type rdf:Property ;
    rdfs:label 'Breach Notification Id' ;
    rdfs:comment 'Unique identifier for each breach notification sent to members, regulators, or media following a data breach incident.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recipientMailingAddress rdf:type rdf:Property ;
    rdfs:label 'Recipient Mailing Address' ;
    rdfs:comment 'Physical mailing address of the notification recipient for postal delivery of breach notification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Required Notification Date' ;
    rdfs:comment 'Regulatory deadline by which the notification must be sent to comply with HIPAA breach notification requirements (typically 60 days from breach discovery).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationStatus rdf:type rdf:Property ;
    rdfs:label 'Notification Status' ;
    rdfs:comment 'Current status of the breach notification delivery (pending, sent, delivered, failed, bounced, returned, or acknowledged by recipient).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryConfirmationDate rdf:type rdf:Property ;
    rdfs:label 'Delivery Confirmation Date' ;
    rdfs:comment 'Date on which delivery of the breach notification was confirmed (e.g., certified mail receipt, email read receipt).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deliveryConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Delivery Confirmation Number' ;
    rdfs:comment 'Tracking or confirmation number provided by the delivery service (e.g., USPS certified mail number, email delivery ID).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationContent rdf:type rdf:Property ;
    rdfs:label 'Notification Content' ;
    rdfs:comment 'Full text content of the breach notification letter or message sent to the recipient, including all required elements per HIPAA regulations.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachDescription rdf:type rdf:Property ;
    rdfs:label 'Breach Description' ;
    rdfs:comment 'Brief description of the breach incident included in the notification, explaining what happened and what information was involved.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiTypesInvolved rdf:type rdf:Property ;
    rdfs:label 'Phi Types Involved' ;
    rdfs:comment 'Types of protected health information that were compromised in the breach (e.g., medical records, claims data, demographic information, financial information).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:individualsAffectedCount rdf:type rdf:Property ;
    rdfs:label 'Individuals Affected Count' ;
    rdfs:comment 'Number of individuals whose protected health information was affected by the breach incident.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breachDiscoveryDate rdf:type rdf:Property ;
    rdfs:label 'Breach Discovery Date' ;
    rdfs:comment 'Date on which the breach was discovered or should reasonably have been discovered by the covered entity or business associate.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:breachOccurrenceDate rdf:type rdf:Property ;
    rdfs:label 'Breach Occurrence Date' ;
    rdfs:comment 'Date on which the breach incident actually occurred or began, if known.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stepsTakenDescription rdf:type rdf:Property ;
    rdfs:label 'Steps Taken Description' ;
    rdfs:comment 'Description of steps the covered entity has taken to investigate the breach, mitigate harm, and protect against future breaches.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationActions rdf:type rdf:Property ;
    rdfs:label 'Mitigation Actions' ;
    rdfs:comment 'Specific mitigation actions taken by the organization to address the breach and prevent recurrence.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:individualActionsRecommended rdf:type rdf:Property ;
    rdfs:label 'Individual Actions Recommended' ;
    rdfs:comment 'Recommended actions for affected individuals to protect themselves from potential harm (e.g., credit monitoring, password changes, fraud alerts).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactInformation rdf:type rdf:Property ;
    rdfs:label 'Contact Information' ;
    rdfs:comment 'Contact information provided in the notification for individuals to ask questions or obtain additional information about the breach.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tollFreeNumber rdf:type rdf:Property ;
    rdfs:label 'Toll Free Number' ;
    rdfs:comment 'Toll-free phone number provided for affected individuals to contact the organization regarding the breach.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Required Flag' ;
    rdfs:comment 'Indicator of whether this notification requires concurrent filing with regulatory authorities (HHS OCR, state agencies).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mediaOutletName rdf:type rdf:Property ;
    rdfs:label 'Media Outlet Name' ;
    rdfs:comment 'Name of the media outlet to which the breach notification was sent (e.g., newspaper, television station, news service).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substituteNoticeFlag rdf:type rdf:Property ;
    rdfs:label 'Substitute Notice Flag' ;
    rdfs:comment 'Indicator of whether substitute notice methods were used due to insufficient or out-of-date contact information for affected individuals.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:substituteNoticeMethod rdf:type rdf:Property ;
    rdfs:label 'Substitute Notice Method' ;
    rdfs:comment 'Method used for substitute notice when direct notification is not feasible (website posting, major print or broadcast media, or both).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:websitePostingUrl rdf:type rdf:Property ;
    rdfs:label 'Website Posting Url' ;
    rdfs:comment 'URL of the website where the breach notification was posted for substitute notice purposes.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:websitePostingStartDate rdf:type rdf:Property ;
    rdfs:label 'Website Posting Start Date' ;
    rdfs:comment 'Date on which the breach notification was posted on the organization\'s website for substitute notice (must remain for 90 days).' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:websitePostingEndDate rdf:type rdf:Property ;
    rdfs:label 'Website Posting End Date' ;
    rdfs:comment 'Date on which the breach notification was removed from the organization\'s website after the required 90-day posting period.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:translationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Translation Required Flag' ;
    rdfs:comment 'Indicator of whether the notification required translation into a language other than English to serve the recipient population.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:urgencyLevel rdf:type rdf:Property ;
    rdfs:label 'Urgency Level' ;
    rdfs:comment 'Priority level assigned to the notification delivery based on the severity and immediacy of potential harm to affected individuals.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalReviewCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Review Completed Flag' ;
    rdfs:comment 'Indicator of whether the notification content underwent legal review and approval before being sent.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationCostAmount rdf:type rdf:Property ;
    rdfs:label 'Notification Cost Amount' ;
    rdfs:comment 'Total cost incurred for sending this breach notification, including postage, printing, credit monitoring, and other related expenses.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postageCostAmount rdf:type rdf:Property ;
    rdfs:label 'Postage Cost Amount' ;
    rdfs:comment 'Cost of postage for mailing the breach notification via first-class mail or certified mail.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:printingCostAmount rdf:type rdf:Property ;
    rdfs:label 'Printing Cost Amount' ;
    rdfs:comment 'Cost of printing the breach notification letters and envelopes.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vendorContractNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Contract Number' ;
    rdfs:comment 'Contract number or identifier for the business associate agreement with the vendor providing notification services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnToSenderFlag rdf:type rdf:Property ;
    rdfs:label 'Return To Sender Flag' ;
    rdfs:comment 'Indicator of whether the mailed notification was returned to sender due to undeliverable address or other postal service issue.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acknowledgmentReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Received Flag' ;
    rdfs:comment 'Indicator of whether the recipient acknowledged receipt of the breach notification.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Date' ;
    rdfs:comment 'Date on which the recipient acknowledged receipt of the breach notification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Response Received Flag' ;
    rdfs:comment 'Indicator of whether the recipient responded to the breach notification with questions or concerns.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expeditedNotificationFlag rdf:type rdf:Property ;
    rdfs:label 'Expedited Notification Flag' ;
    rdfs:comment 'Indicator of whether expedited notification was required due to imminent risk of harm to affected individuals.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationWaiverFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Waiver Flag' ;
    rdfs:comment 'Indicator of whether notification was waived based on a low probability of compromise determination by the covered entity.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationSentByName rdf:type rdf:Property ;
    rdfs:label 'Notification Sent By Name' ;
    rdfs:comment 'Name of the individual or department responsible for sending the breach notification.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationApprovedByName rdf:type rdf:Property ;
    rdfs:label 'Notification Approved By Name' ;
    rdfs:comment 'Name of the executive or officer who approved the breach notification for delivery.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationApprovedDate rdf:type rdf:Property ;
    rdfs:label 'Notification Approved Date' ;
    rdfs:comment 'Date on which the breach notification was approved for delivery by authorized personnel.' ;
    rdfs:domain ind:BreachNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:thirdPartyRiskId rdf:type rdf:Property ;
    rdfs:label 'Third Party Risk Id' ;
    rdfs:comment 'Unique identifier for the third-party risk assessment record. Primary key for the third_party_risk data product.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ThirdPartyRisk .

ind:vendorId rdf:type rdf:Property ;
    rdfs:label 'Vendor Id' ;
    rdfs:comment 'Unique identifier for the third-party vendor or business associate being assessed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:vendorType rdf:type rdf:Property ;
    rdfs:label 'Vendor Type' ;
    rdfs:comment 'Classification of the third-party vendor based on the nature of services provided and relationship type.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Date' ;
    rdfs:comment 'Date when the third-party risk assessment was conducted or completed.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overallRiskRating rdf:type rdf:Property ;
    rdfs:label 'Overall Risk Rating' ;
    rdfs:comment 'Composite risk rating assigned to the third-party vendor based on assessment findings across all risk domains.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataAccessLevel rdf:type rdf:Property ;
    rdfs:label 'Data Access Level' ;
    rdfs:comment 'Level and type of sensitive data the third-party vendor has access to as part of the business relationship.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Phi Access Flag' ;
    rdfs:comment 'Indicator of whether the vendor has access to Protected Health Information requiring HIPAA Business Associate Agreement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ephiAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Ephi Access Flag' ;
    rdfs:comment 'Indicator of whether the vendor has access to electronic Protected Health Information requiring HIPAA Security Rule compliance.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baaRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Baa Required Flag' ;
    rdfs:comment 'Indicator of whether a HIPAA Business Associate Agreement is required for this third-party relationship.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baaExecutedFlag rdf:type rdf:Property ;
    rdfs:label 'Baa Executed Flag' ;
    rdfs:comment 'Indicator of whether a valid Business Associate Agreement has been executed with the vendor.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baaExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Baa Execution Date' ;
    rdfs:comment 'Date when the Business Associate Agreement was executed with the third-party vendor.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:baaExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Baa Expiration Date' ;
    rdfs:comment 'Date when the current Business Associate Agreement expires and requires renewal.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractStartDate rdf:type rdf:Property ;
    rdfs:label 'Contract Start Date' ;
    rdfs:comment 'Effective start date of the contractual relationship with the third-party vendor.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractValueAmount rdf:type rdf:Property ;
    rdfs:label 'Contract Value Amount' ;
    rdfs:comment 'Total monetary value of the contract with the third-party vendor over the contract term.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualSpendAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Spend Amount' ;
    rdfs:comment 'Estimated or actual annual spending with the third-party vendor.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceCriticality rdf:type rdf:Property ;
    rdfs:label 'Service Criticality' ;
    rdfs:comment 'Criticality level of the services provided by the vendor to UnitedHealthcare operations and member services.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessContinuityRisk rdf:type rdf:Property ;
    rdfs:label 'Business Continuity Risk' ;
    rdfs:comment 'Risk rating for potential business continuity impact if the vendor relationship is disrupted or terminated.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cybersecurityRiskRating rdf:type rdf:Property ;
    rdfs:label 'Cybersecurity Risk Rating' ;
    rdfs:comment 'Risk rating for cybersecurity threats and vulnerabilities associated with the third-party vendor.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPrivacyRiskRating rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Risk Rating' ;
    rdfs:comment 'Risk rating for data privacy compliance and protection associated with the third-party vendor.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceRiskRating rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Risk Rating' ;
    rdfs:comment 'Risk rating for regulatory compliance issues associated with the third-party vendor relationship.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialRiskRating rdf:type rdf:Property ;
    rdfs:label 'Financial Risk Rating' ;
    rdfs:comment 'Risk rating for financial stability and viability concerns of the third-party vendor.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalRiskRating rdf:type rdf:Property ;
    rdfs:label 'Operational Risk Rating' ;
    rdfs:comment 'Risk rating for operational performance and service delivery issues with the third-party vendor.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reputationalRiskRating rdf:type rdf:Property ;
    rdfs:label 'Reputational Risk Rating' ;
    rdfs:comment 'Risk rating for potential reputational damage to UnitedHealthcare from the third-party vendor relationship.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicRiskRating rdf:type rdf:Property ;
    rdfs:label 'Geographic Risk Rating' ;
    rdfs:comment 'Risk rating based on geographic location of vendor operations including geopolitical and data sovereignty considerations.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorLocationCountryCode rdf:type rdf:Property ;
    rdfs:label 'Vendor Location Country Code' ;
    rdfs:comment 'Three-letter ISO country code representing the primary country where the vendor operates or is headquartered.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataStorageLocationCountryCode rdf:type rdf:Property ;
    rdfs:label 'Data Storage Location Country Code' ;
    rdfs:comment 'Three-letter ISO country code representing where the vendor stores UnitedHealthcare data.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offshoreOperationsFlag rdf:type rdf:Property ;
    rdfs:label 'Offshore Operations Flag' ;
    rdfs:comment 'Indicator of whether the vendor operates or stores data outside the United States.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:soc2CertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Soc2 Certified Flag' ;
    rdfs:comment 'Indicator of whether the vendor maintains current SOC 2 Type II certification for security and privacy controls.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:soc2ReportDate rdf:type rdf:Property ;
    rdfs:label 'Soc2 Report Date' ;
    rdfs:comment 'Date of the most recent SOC 2 Type II audit report received from the vendor.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:iso27001CertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Iso27001 Certified Flag' ;
    rdfs:comment 'Indicator of whether the vendor maintains current ISO 27001 information security management certification.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hitrustCertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Hitrust Certified Flag' ;
    rdfs:comment 'Indicator of whether the vendor maintains current HITRUST CSF certification for healthcare information security.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceCoverageVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Verified Flag' ;
    rdfs:comment 'Indicator of whether adequate liability and cyber insurance coverage has been verified for the vendor.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cyberInsuranceAmount rdf:type rdf:Property ;
    rdfs:label 'Cyber Insurance Amount' ;
    rdfs:comment 'Dollar amount of cyber liability insurance coverage maintained by the vendor.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:backgroundCheckCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Background Check Completed Flag' ;
    rdfs:comment 'Indicator of whether background checks have been completed for vendor personnel with access to sensitive data.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:securityAssessmentScore rdf:type rdf:Property ;
    rdfs:label 'Security Assessment Score' ;
    rdfs:comment 'Quantitative score from security assessment questionnaire or evaluation (typically 0-100 scale).' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:privacyAssessmentScore rdf:type rdf:Property ;
    rdfs:label 'Privacy Assessment Score' ;
    rdfs:comment 'Quantitative score from privacy assessment questionnaire or evaluation (typically 0-100 scale).' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceAssessmentScore rdf:type rdf:Property ;
    rdfs:label 'Compliance Assessment Score' ;
    rdfs:comment 'Quantitative score from regulatory compliance assessment questionnaire or evaluation (typically 0-100 scale).' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialStabilityScore rdf:type rdf:Property ;
    rdfs:label 'Financial Stability Score' ;
    rdfs:comment 'Quantitative score assessing the financial health and stability of the vendor (typically 0-100 scale).' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditRating rdf:type rdf:Property ;
    rdfs:label 'Credit Rating' ;
    rdfs:comment 'External credit rating assigned to the vendor by rating agencies (e.g., Moody\'s, S&P, Fitch).' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onsiteAuditRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Onsite Audit Required Flag' ;
    rdfs:comment 'Indicator of whether an onsite audit or assessment is required for this vendor based on risk tier.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastOnsiteAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Onsite Audit Date' ;
    rdfs:comment 'Date of the most recent onsite audit or assessment conducted at the vendor\'s facilities.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextAssessmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Assessment Due Date' ;
    rdfs:comment 'Scheduled date for the next periodic risk assessment of the third-party vendor.' ;
    rdfs:domain ind:ThirdPartyRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:findingsCount rdf:type rdf:Property ;
    rdfs:label 'Findings Count' ;
    rdfs:comment 'Total number of risk findings or issues identified in the current assessment.' ;
