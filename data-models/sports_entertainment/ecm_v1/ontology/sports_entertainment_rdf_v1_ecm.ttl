    rdfs:comment 'The unique transaction identifier assigned by the payment processing system or bank when the payment was executed.' ;
    rdfs:domain ind:PaymentProposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposalDate rdf:type rdf:Property ;
