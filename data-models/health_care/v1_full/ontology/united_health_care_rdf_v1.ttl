    rdfs:range xsd:string .

ind:complianceReviewed rdf:type rdf:Property ;
    rdfs:label 'Compliance Reviewed' ;
    rdfs:comment 'Indicates whether the notification content was reviewed for regulatory compliance before sending.' ;
    rdfs:domain ind:AuthNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceTypeId rdf:type rdf:Property ;
    rdfs:label 'Service Type Id' ;
    rdfs:comment 'Unique identifier for the service type subject to prior authorization. Primary key for the service type entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceType .

ind:authorizationType rdf:type rdf:Property ;
    rdfs:label 'Authorization Type' ;
    rdfs:comment 'Type of utilization management review required for this service (prior authorization, concurrent review during service delivery, retrospective review after service, or notification only).' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalNecessityCriteria rdf:type rdf:Property ;
    rdfs:label 'Medical Necessity Criteria' ;
    rdfs:comment 'Specific medical necessity criteria or guideline reference used to evaluate authorization requests for this service type.' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placeOfService rdf:type rdf:Property ;
    rdfs:label 'Place Of Service' ;
    rdfs:comment 'Standard place of service code(s) where this service type is typically rendered (e.g., 11 for office, 21 for inpatient hospital, 22 for outpatient hospital).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceSetting rdf:type rdf:Property ;
    rdfs:label 'Service Setting' ;
    rdfs:comment 'General setting where the service is delivered, used for authorization routing and review criteria selection.' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationTurnaroundTimeHours rdf:type rdf:Property ;
