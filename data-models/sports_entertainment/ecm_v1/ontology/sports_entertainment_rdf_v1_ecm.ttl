    rdfs:domain ind:PaymentProposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedByUserId rdf:type rdf:Property ;
    rdfs:label 'Modified By User Id' ;
    rdfs:comment 'Identifier of the user who last modified this payment proposal record.' ;
    rdfs:domain ind:PaymentProposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentBlockCode rdf:type rdf:Property ;
    rdfs:label 'Payment Block Code' ;
    rdfs:comment 'Code indicating if the payment is blocked from execution, and the reason for the block (e.g., dispute, compliance hold).' ;
    rdfs:domain ind:PaymentProposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPriority rdf:type rdf:Property ;
    rdfs:label 'Payment Priority' ;
    rdfs:comment 'The priority level assigned to this payment proposal for sequencing and cash flow management.' ;
    rdfs:domain ind:PaymentProposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTermCode rdf:type rdf:Property ;
