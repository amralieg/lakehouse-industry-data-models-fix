ind:preExistingConditions rdf:type rdf:Property ;
    rdfs:label 'Pre Existing Conditions' ;
    rdfs:comment 'A description of any pre-existing health conditions disclosed by the prospective member, used for care management planning.' ;
    rdfs:domain ind:Lead ;
    rdf:type owl:DatatypeProperty ;
