ind:lineupStatus rdf:type rdf:Property ;
    rdfs:label 'Lineup Status' ;
    rdfs:comment 'Current lifecycle status of the lineup indicating its readiness for gaming operations and wagering markets.' ;
    rdfs:domain ind:Lineup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineupType rdf:type rdf:Property ;
    rdfs:label 'Lineup Type' ;
    rdfs:comment 'Classification of the lineup indicating whether it represents starting players, bench players, injured reserve, or other roster categories.' ;
    rdfs:domain ind:Lineup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lockedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Locked Timestamp' ;
    rdfs:comment 'Date and time when the lineup was locked for wagering purposes, preventing further changes that would affect betting markets.' ;
    rdfs:domain ind:Lineup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:propBetEligibleFlag rdf:type rdf:Property ;
