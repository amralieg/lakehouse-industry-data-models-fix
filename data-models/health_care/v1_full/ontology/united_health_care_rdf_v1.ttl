    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetClosureDate rdf:type rdf:Property ;
    rdfs:label 'Target Closure Date' ;
    rdfs:comment 'Expected or planned date for case resolution and closure based on service level agreements, regulatory requirements, or case complexity.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estimatedSavingsAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Savings Amount' ;
    rdfs:comment 'Projected or actual cost savings achieved through case management interventions, fraud prevention, or utilization management activities, measured in US dollars.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCaseCost rdf:type rdf:Property ;
    rdfs:label 'Total Case Cost' ;
    rdfs:comment 'Total cost incurred for managing the case, including staff time, external resources, and administrative expenses, used for return on investment analysis.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:successfulContacts rdf:type rdf:Property ;
    rdfs:label 'Successful Contacts' ;
    rdfs:comment 'Number of successful contacts made with the member, provider, or other parties, indicating engagement level and case progress.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:grievanceFiled rdf:type rdf:Property ;
    rdfs:label 'Grievance Filed' ;
    rdfs:comment 'Indicator that the member has filed a formal grievance or complaint related to the case, service quality, or plan operations.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grievanceDate rdf:type rdf:Property ;
    rdfs:label 'Grievance Date' ;
    rdfs:comment 'Date when the member grievance or complaint was formally filed, establishing regulatory response timeframes.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportedToAgency rdf:type rdf:Property ;
    rdfs:label 'Reported To Agency' ;
    rdfs:comment 'Name of the regulatory agency, law enforcement entity, or external organization to which the case was reported.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationType rdf:type rdf:Property ;
    rdfs:label 'Investigation Type' ;
    rdfs:comment 'Classification of the investigation methodology and scope used for fraud, waste, or abuse cases.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalActionPending rdf:type rdf:Property ;
    rdfs:label 'Legal Action Pending' ;
    rdfs:comment 'Indicator that legal proceedings, prosecution, or civil litigation is pending or anticipated related to the case.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carePlanActive rdf:type rdf:Property ;
    rdfs:label 'Care Plan Active' ;
    rdfs:comment 'Indicator that an active care plan is in place and being executed for the member associated with this case.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:goalsIdentified rdf:type rdf:Property ;
    rdfs:label 'Goals Identified' ;
    rdfs:comment 'Number of specific, measurable care management goals established for the member in the care plan.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:goalsAchieved rdf:type rdf:Property ;
    rdfs:label 'Goals Achieved' ;
    rdfs:comment 'Number of care management goals that have been successfully achieved by the member, used for outcome measurement and quality reporting.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interventionsProvided rdf:type rdf:Property ;
    rdfs:label 'Interventions Provided' ;
    rdfs:comment 'Summary of care management interventions, services, or resources provided to the member during the case, such as education, care coordination, or community referrals.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readmissionOccurred rdf:type rdf:Property ;
    rdfs:label 'Readmission Occurred' ;
    rdfs:comment 'Indicator that the member was readmitted to a hospital within the tracking period, used for quality measurement and care management effectiveness analysis.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyDepartmentVisits rdf:type rdf:Property ;
    rdfs:label 'Emergency Department Visits' ;
    rdfs:comment 'Number of emergency department visits by the member during the case management period, indicating care utilization patterns and potential gaps in primary care.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medicationAdherenceRate rdf:type rdf:Property ;
    rdfs:label 'Medication Adherence Rate' ;
    rdfs:comment 'Percentage representing the member\'s adherence to prescribed medication regimens, calculated as proportion of days covered, used for chronic disease management evaluation.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:socialDeterminantsAssessed rdf:type rdf:Property ;
    rdfs:label 'Social Determinants Assessed' ;
    rdfs:comment 'Indicator that social determinants of health factors such as housing, food security, transportation, and social support have been formally assessed for the member.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:housingInstability rdf:type rdf:Property ;
    rdfs:label 'Housing Instability' ;
    rdfs:comment 'Indicator that the member is experiencing homelessness or unstable housing conditions affecting their health and care management.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:foodInsecurity rdf:type rdf:Property ;
    rdfs:label 'Food Insecurity' ;
    rdfs:comment 'Indicator that the member lacks consistent access to adequate food, impacting health outcomes and requiring social service referrals.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transportationBarrier rdf:type rdf:Property ;
    rdfs:label 'Transportation Barrier' ;
    rdfs:comment 'Indicator that the member lacks reliable transportation to medical appointments, requiring care coordination support or non-emergency medical transportation services.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communityResourcesReferred rdf:type rdf:Property ;
    rdfs:label 'Community Resources Referred' ;
    rdfs:comment 'List or description of community-based organizations, social services, or support programs to which the member was referred during case management.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:behavioralHealthNeeds rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Needs' ;
    rdfs:comment 'Indicator that the member has identified mental health or substance use disorder needs requiring specialized behavioral health case management or treatment.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:substanceUseDisorder rdf:type rdf:Property ;
    rdfs:label 'Substance Use Disorder' ;
    rdfs:comment 'Indicator that the member has a diagnosed or suspected substance use disorder requiring specialized treatment and care coordination.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:highRiskMedication rdf:type rdf:Property ;
    rdfs:label 'High Risk Medication' ;
    rdfs:comment 'Indicator that the member is taking medications requiring enhanced monitoring due to safety concerns, drug interactions, or potential for adverse events.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:polypharmacyIndicator rdf:type rdf:Property ;
    rdfs:label 'Polypharmacy Indicator' ;
    rdfs:comment 'Flag indicating that the member is taking multiple medications concurrently, requiring medication therapy management and drug interaction review.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:palliativeCare rdf:type rdf:Property ;
    rdfs:label 'Palliative Care' ;
    rdfs:comment 'Indicator that the member is receiving palliative care services focused on symptom management and quality of life for serious illness.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospiceCare rdf:type rdf:Property ;
    rdfs:label 'Hospice Care' ;
    rdfs:comment 'Indicator that the member is enrolled in hospice care for end-of-life support, affecting benefit coverage and care management approach.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:longTermServicesSupport rdf:type rdf:Property ;
    rdfs:label 'Long Term Services Support' ;
    rdfs:comment 'Indicator that the member requires or is receiving long-term services and supports such as home health, skilled nursing, or assisted living.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:durableMedicalEquipment rdf:type rdf:Property ;
    rdfs:label 'Durable Medical Equipment' ;
    rdfs:comment 'Indicator that the case involves durable medical equipment needs, authorization, or utilization review.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:homeHealthServices rdf:type rdf:Property ;
    rdfs:label 'Home Health Services' ;
    rdfs:comment 'Indicator that the member is receiving or requires home health nursing or therapy services as part of the care plan.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careCoordinationActivities rdf:type rdf:Property ;
    rdfs:label 'Care Coordination Activities' ;
    rdfs:comment 'Number of documented care coordination activities performed during the case, such as provider outreach, appointment scheduling, or information exchange.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:providerCollaboration rdf:type rdf:Property ;
    rdfs:label 'Provider Collaboration' ;
    rdfs:comment 'Indicator that the case manager actively collaborated with the member\'s healthcare providers to coordinate care and share information.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notesCount rdf:type rdf:Property ;
    rdfs:label 'Notes Count' ;
    rdfs:comment 'Total number of documentation entries or notes recorded in the case management system for this case, indicating activity level and thoroughness.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attachmentsCount rdf:type rdf:Property ;
    rdfs:label 'Attachments Count' ;
    rdfs:comment 'Number of supporting documents, medical records, or evidence files attached to the case record.' ;
    rdfs:domain ind:Case ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statusHistoryId rdf:type rdf:Property ;
    rdfs:label 'Status History Id' ;
    rdfs:comment 'Unique identifier for each status change record across all domains (credentialing, member, fraud case).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StatusHistory .

ind:previousStatus rdf:type rdf:Property ;
    rdfs:label 'Previous Status' ;
    rdfs:comment 'Status value before the change occurred. Values vary by entity type (e.g., active, pending, suspended, terminated for members; open, investigating, closed for fraud cases).' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newStatus rdf:type rdf:Property ;
    rdfs:label 'New Status' ;
    rdfs:comment 'Status value after the change occurred. Values vary by entity type and represent the current state following the transition.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusEndDate rdf:type rdf:Property ;
    rdfs:label 'Status End Date' ;
    rdfs:comment 'Date when the status ceased to be effective, marking the end of this status period. Null if current status.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statusEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Status End Timestamp' ;
    rdfs:comment 'Precise timestamp when the status period ended, including time zone information. Null if current status.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:initiatedByUserName rdf:type rdf:Property ;
    rdfs:label 'Initiated By User Name' ;
    rdfs:comment 'Name of the user who initiated the status change for audit and tracking purposes.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatedByRole rdf:type rdf:Property ;
    rdfs:label 'Initiated By Role' ;
    rdfs:comment 'Role or job function of the user who initiated the status change (e.g., Claims Adjudicator, Member Services Representative, System Administrator).' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCurrentStatus rdf:type rdf:Property ;
    rdfs:label 'Is Current Status' ;
    rdfs:comment 'Indicates whether this status record represents the current active status for the entity (true) or a historical status (false).' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversedByStatusHistoryId rdf:type rdf:Property ;
    rdfs:label 'Reversed By Status History Id' ;
    rdfs:comment 'Identifier of the subsequent status history record that reversed this status change, if applicable.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:History .

ind:dataSourceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Data Source Timestamp' ;
    rdfs:comment 'Timestamp when the status change was recorded in the source operational system.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:effectivePeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Effective Period Start Date' ;
    rdfs:comment 'Start date of the period during which this status was effective, used for temporal queries and reporting.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectivePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Effective Period End Date' ;
    rdfs:comment 'End date of the period during which this status was effective. Null or far-future date if currently active.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statusChangeType rdf:type rdf:Property ;
    rdfs:label 'Status Change Type' ;
    rdfs:comment 'Classification of the type of status change that occurred (e.g., initial enrollment, transition between active states, termination).' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxDetailId rdf:type rdf:Property ;
    rdfs:label 'Tax Detail Id' ;
    rdfs:comment 'Unique identifier for the tax detail record. Primary key for the tax detail entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TaxDetail .

ind:taxName rdf:type rdf:Property ;
    rdfs:label 'Tax Name' ;
    rdfs:comment 'Full descriptive name of the tax (e.g., California Premium Tax, Federal Health Insurance Tax).' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxCategory rdf:type rdf:Property ;
    rdfs:label 'Tax Category' ;
    rdfs:comment 'Governmental level at which the tax is imposed (federal, state, local, etc.).' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionType rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Type' ;
    rdfs:comment 'Type of governmental entity imposing the tax.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxRateType rdf:type rdf:Property ;
    rdfs:label 'Tax Rate Type' ;
    rdfs:comment 'Indicates whether the tax is calculated as a percentage, flat amount, or uses a tiered/graduated structure.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Tax Amount' ;
    rdfs:comment 'Minimum tax amount that must be collected regardless of the calculated tax, if applicable.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Tax Amount' ;
    rdfs:comment 'Maximum tax amount that can be collected, serving as a cap on the calculated tax, if applicable.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxableBase rdf:type rdf:Property ;
    rdfs:label 'Taxable Base' ;
    rdfs:comment 'The basis upon which the tax is calculated (e.g., premium amount, gross receipts, per member).' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberLocationType rdf:type rdf:Property ;
    rdfs:label 'Member Location Type' ;
    rdfs:comment 'Type of member location used to determine tax jurisdiction applicability (e.g., residence address, work location, service location).' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerLocationType rdf:type rdf:Property ;
    rdfs:label 'Employer Location Type' ;
    rdfs:comment 'Type of employer location used to determine tax jurisdiction for group policies, if applicable.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Tax Authority Name' ;
    rdfs:comment 'Name of the governmental agency or authority responsible for administering and collecting this tax (e.g., California Department of Insurance, IRS).' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxAuthorityIdentifier rdf:type rdf:Property ;
    rdfs:label 'Tax Authority Identifier' ;
    rdfs:comment 'Unique identifier or code assigned by the tax authority for this specific tax.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingFrequency rdf:type rdf:Property ;
    rdfs:label 'Filing Frequency' ;
    rdfs:comment 'Required frequency for filing tax returns and remitting collected taxes to the authority.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceDueDay rdf:type rdf:Property ;
    rdfs:label 'Remittance Due Day' ;
    rdfs:comment 'Day of the month (or days after period end) when tax payment is due to the authority.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exemptionRules rdf:type rdf:Property ;
    rdfs:label 'Exemption Rules' ;
    rdfs:comment 'Description of conditions under which this tax may be exempted or reduced (e.g., government employees, certain product types, low-income members).' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductionAllowed rdf:type rdf:Property ;
    rdfs:label 'Deduction Allowed' ;
    rdfs:comment 'Indicates whether certain deductions (e.g., reinsurance premiums, dividends) are allowed before calculating the taxable base.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deductionTypes rdf:type rdf:Property ;
    rdfs:label 'Deduction Types' ;
    rdfs:comment 'Comma-separated list of deduction types permitted when calculating the taxable base (e.g., reinsurance_ceded, dividends_paid, return_premiums).' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surchargeApplicable rdf:type rdf:Property ;
    rdfs:label 'Surcharge Applicable' ;
    rdfs:comment 'Indicates whether an additional surcharge is applied on top of the base tax rate.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surchargeRate rdf:type rdf:Property ;
    rdfs:label 'Surcharge Rate' ;
    rdfs:comment 'Additional surcharge rate applied to the base tax, if applicable. Expressed as a decimal.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surchargeDescription rdf:type rdf:Property ;
    rdfs:label 'Surcharge Description' ;
    rdfs:comment 'Description of the purpose or reason for the surcharge (e.g., disaster recovery fund, health initiative fund).' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retaliatoryTaxApplicable rdf:type rdf:Property ;
    rdfs:label 'Retaliatory Tax Applicable' ;
    rdfs:comment 'Indicates whether retaliatory tax provisions apply, where a state may impose taxes equal to what the insurer\'s home state would charge.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retaliatoryComparisonState rdf:type rdf:Property ;
    rdfs:label 'Retaliatory Comparison State' ;
    rdfs:comment 'Two-letter state code of the insurer\'s domicile state used for retaliatory tax comparison, if applicable.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compoundTaxIndicator rdf:type rdf:Property ;
    rdfs:label 'Compound Tax Indicator' ;
    rdfs:comment 'Indicates whether this tax is calculated on a base that includes other taxes (tax-on-tax scenario).' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxSequenceOrder rdf:type rdf:Property ;
    rdfs:label 'Tax Sequence Order' ;
    rdfs:comment 'Numeric order in which this tax should be calculated when multiple taxes apply to the same transaction.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statutoryReference rdf:type rdf:Property ;
    rdfs:label 'Statutory Reference' ;
    rdfs:comment 'Citation of the specific statute, regulation, or code section that establishes this tax requirement (e.g., California Revenue and Taxation Code Section 12202).' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Regulation Effective Date' ;
    rdfs:comment 'Date when the underlying regulation or statute establishing this tax became effective.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxPassThroughAllowed rdf:type rdf:Property ;
    rdfs:label 'Tax Pass Through Allowed' ;
    rdfs:comment 'Indicates whether the tax can be passed through to the member or employer as a separate line item on the premium invoice.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:passThroughMethod rdf:type rdf:Property ;
    rdfs:label 'Pass Through Method' ;
    rdfs:comment 'Method by which the tax is presented to the customer (included in premium amount vs. shown as separate charge).' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naicReportingLine rdf:type rdf:Property ;
    rdfs:label 'Naic Reporting Line' ;
    rdfs:comment 'Specific line number or code on the NAIC Annual Statement where this tax should be reported.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxCreditEligible rdf:type rdf:Property ;
    rdfs:label 'Tax Credit Eligible' ;
    rdfs:comment 'Indicates whether payments of this tax are eligible for credits against other tax obligations.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditAgainstTaxType rdf:type rdf:Property ;
    rdfs:label 'Credit Against Tax Type' ;
    rdfs:comment 'Type of tax against which this tax payment can be credited, if applicable.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyRate rdf:type rdf:Property ;
    rdfs:label 'Penalty Rate' ;
    rdfs:comment 'Penalty rate applied for late payment or non-payment of the tax, expressed as a decimal or percentage.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:electronicFilingRequired rdf:type rdf:Property ;
    rdfs:label 'Electronic Filing Required' ;
    rdfs:comment 'Indicates whether tax returns and payments must be submitted electronically.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:filingPortalUrl rdf:type rdf:Property ;
    rdfs:label 'Filing Portal Url' ;
    rdfs:comment 'Web address of the electronic portal used for filing tax returns and making payments.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByTaxDetailId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Tax Detail Id' ;
    rdfs:comment 'Reference to the tax_detail_id that supersedes this record when a new version is created.' ;
    rdfs:domain ind:TaxDetail ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TaxDetail .

ind:contractingPartyName rdf:type rdf:Property ;
    rdfs:label 'Contracting Party Name' ;
    rdfs:comment 'Legal name of the external party (provider, broker, vendor) entering into the contract with UnitedHealth Care.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractingPartyType rdf:type rdf:Property ;
    rdfs:label 'Contracting Party Type' ;
    rdfs:comment 'Classification of the external contracting party by organizational type.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityMeasures rdf:type rdf:Property ;
    rdfs:label 'Quality Measures' ;
    rdfs:comment 'Description or list of quality measures (e.g., HEDIS, CAHPS) used to evaluate performance under this contract.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicCoverage rdf:type rdf:Property ;
    rdfs:label 'Geographic Coverage' ;
    rdfs:comment 'Geographic area or regions where the contract terms apply (e.g., state, county, ZIP codes).' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueAmount rdf:type rdf:Property ;
    rdfs:label 'Value Amount' ;
    rdfs:comment 'Estimated total financial value or annual spend associated with this contract.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hipaaBaaIndicator rdf:type rdf:Property ;
    rdfs:label 'Hipaa Baa Indicator' ;
    rdfs:comment 'Flag indicating whether a HIPAA Business Associate Agreement is required and executed for this contract.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryApprovalRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Required Indicator' ;
    rdfs:comment 'Flag indicating whether state or federal regulatory approval is required for this contract.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceRequirementIndicator rdf:type rdf:Property ;
    rdfs:label 'Insurance Requirement Indicator' ;
    rdfs:comment 'Flag indicating whether the contracting party is required to maintain specific insurance coverage.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumInsuranceAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Insurance Amount' ;
    rdfs:comment 'Minimum insurance coverage amount required from the contracting party.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:electronicTransactionRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Electronic Transaction Required Indicator' ;
    rdfs:comment 'Flag indicating whether the contracting party is required to submit claims and other transactions electronically.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:utilizationReviewIndicator rdf:type rdf:Property ;
    rdfs:label 'Utilization Review Indicator' ;
    rdfs:comment 'Flag indicating whether services under this contract are subject to utilization review processes.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careCoordinationRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Care Coordination Required Indicator' ;
    rdfs:comment 'Flag indicating whether the contracting party is required to participate in care coordination activities.' ;
    rdfs:domain ind:Contract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaId rdf:type rdf:Property ;
    rdfs:label 'Sla Id' ;
    rdfs:comment 'Unique identifier for the SLA record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Sla .

ind:serviceName rdf:type rdf:Property ;
    rdfs:label 'Service Name' ;
    rdfs:comment 'Name of the service or product covered by the SLA.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetUptimePercent rdf:type rdf:Property ;
    rdfs:label 'Target Uptime Percent' ;
    rdfs:comment 'Promised service availability as a percentage.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetResponseTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Target Response Time Minutes' ;
    rdfs:comment 'Maximum allowed time to respond to a request, in minutes.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetResolutionTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Target Resolution Time Minutes' ;
    rdfs:comment 'Maximum allowed time to resolve an incident, in minutes.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measurementCriteria rdf:type rdf:Property ;
    rdfs:label 'Measurement Criteria' ;
    rdfs:comment 'Method used to measure SLA compliance.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyType rdf:type rdf:Property ;
    rdfs:label 'Penalty Type' ;
    rdfs:comment 'Type of penalty applied for SLA breach.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyCurrency rdf:type rdf:Property ;
    rdfs:label 'Penalty Currency' ;
    rdfs:comment 'Currency code for the penalty amount, e.g., USD.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationContactPhone rdf:type rdf:Property ;
    rdfs:label 'Escalation Contact Phone' ;
    rdfs:comment 'Phone number for escalation contact.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationContactEmail rdf:type rdf:Property ;
    rdfs:label 'Escalation Contact Email' ;
    rdfs:comment 'Email address for escalation contact.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringTool rdf:type rdf:Property ;
    rdfs:label 'Monitoring Tool' ;
    rdfs:comment 'Tool used to monitor SLA metrics.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringFrequencyMinutes rdf:type rdf:Property ;
    rdfs:label 'Monitoring Frequency Minutes' ;
    rdfs:comment 'How often the monitoring tool collects data, in minutes.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:availabilityActualPercent rdf:type rdf:Property ;
    rdfs:label 'Availability Actual Percent' ;
    rdfs:comment 'Measured service availability percentage over the reporting period.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responseTimeActualMinutes rdf:type rdf:Property ;
    rdfs:label 'Response Time Actual Minutes' ;
    rdfs:comment 'Average actual response time observed, in minutes.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resolutionTimeActualMinutes rdf:type rdf:Property ;
    rdfs:label 'Resolution Time Actual Minutes' ;
    rdfs:comment 'Average actual resolution time observed, in minutes.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breachCount rdf:type rdf:Property ;
    rdfs:label 'Breach Count' ;
    rdfs:comment 'Number of SLA breaches recorded in the reporting period.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breachLastDate rdf:type rdf:Property ;
    rdfs:label 'Breach Last Date' ;
    rdfs:comment 'Date of the most recent SLA breach.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:breachResolutionAction rdf:type rdf:Property ;
    rdfs:label 'Breach Resolution Action' ;
    rdfs:comment 'Action taken to resolve the most recent breach.' ;
    rdfs:domain ind:Sla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentDate rdf:type rdf:Property ;
    rdfs:label 'Incident Date' ;
    rdfs:comment 'Date when the incident or issue that prompted the complaint occurred.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:memberSatisfactionRating rdf:type rdf:Property ;
    rdfs:label 'Member Satisfaction Rating' ;
    rdfs:comment 'Member\'s satisfaction rating with the complaint resolution process, typically on a 1-5 scale.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specialNeedsAccommodation rdf:type rdf:Property ;
    rdfs:label 'Special Needs Accommodation' ;
    rdfs:comment 'Description of any special accommodations required for the member during the complaint process.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preventiveActionTaken rdf:type rdf:Property ;
    rdfs:label 'Preventive Action Taken' ;
    rdfs:comment 'Description of preventive measures implemented to avoid similar complaints in the future.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reimbursementIssuedFlag rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Issued Flag' ;
    rdfs:comment 'Indicates whether a financial reimbursement was issued to the member as part of the complaint resolution.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reimbursementDate rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Date' ;
    rdfs:comment 'Date when the reimbursement was issued to the member.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qualityOfCareFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Of Care Flag' ;
    rdfs:comment 'Indicates whether the complaint involves quality of care concerns requiring clinical review.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalReviewerAgentId rdf:type rdf:Property ;
    rdfs:label 'Clinical Reviewer Agent Id' ;
    rdfs:comment 'Unique identifier of the clinical professional who reviewed the complaint.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:clinicalReviewOutcome rdf:type rdf:Property ;
    rdfs:label 'Clinical Review Outcome' ;
    rdfs:comment 'Outcome or findings from the clinical review of the complaint.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerReviewDate rdf:type rdf:Property ;
    rdfs:label 'Peer Review Date' ;
    rdfs:comment 'Date when the peer review was completed.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:providerNotificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Provider Notification Sent Flag' ;
    rdfs:comment 'Indicates whether the provider was notified about the complaint filed against them.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerResponseReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Provider Response Received Flag' ;
    rdfs:comment 'Indicates whether a response was received from the provider regarding the complaint.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerResponseDescription rdf:type rdf:Property ;
    rdfs:label 'Provider Response Description' ;
    rdfs:comment 'Description of the provider\'s response or explanation regarding the complaint.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Completed Flag' ;
    rdfs:comment 'Indicates whether the scheduled follow-up action has been completed.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:withdrawnFlag rdf:type rdf:Property ;
    rdfs:label 'Withdrawn Flag' ;
    rdfs:comment 'Indicates whether the complaint was withdrawn by the member before resolution.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:withdrawnDate rdf:type rdf:Property ;
    rdfs:label 'Withdrawn Date' ;
    rdfs:comment 'Date when the complaint was withdrawn by the member.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:withdrawnReason rdf:type rdf:Property ;
    rdfs:label 'Withdrawn Reason' ;
    rdfs:comment 'Reason provided by the member for withdrawing the complaint.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationLogCount rdf:type rdf:Property ;
    rdfs:label 'Communication Log Count' ;
    rdfs:comment 'Number of communication interactions logged for this complaint.' ;
    rdfs:domain ind:Complaint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operationType rdf:type rdf:Property ;
    rdfs:label 'Operation Type' ;
    rdfs:comment 'Nature of the operation that triggered the audit event.' ;
    rdfs:domain ind:AuditLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Operation Timestamp' ;
    rdfs:comment 'Date and time when the audited operation occurred.' ;
    rdfs:domain ind:AuditLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:performedByUserName rdf:type rdf:Property ;
    rdfs:label 'Performed By User Name' ;
    rdfs:comment 'Full legal name of the individual who performed the operation.' ;
    rdfs:domain ind:AuditLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performedByRole rdf:type rdf:Property ;
    rdfs:label 'Performed By Role' ;
    rdfs:comment 'Role or function of the actor that performed the operation.' ;
    rdfs:domain ind:AuditLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changedFieldNames rdf:type rdf:Property ;
    rdfs:label 'Changed Field Names' ;
    rdfs:comment 'Pipe-separated list of field names that were modified.' ;
    rdfs:domain ind:AuditLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oldValues rdf:type rdf:Property ;
    rdfs:label 'Old Values' ;
    rdfs:comment 'Serialized representation of the values before the change.' ;
    rdfs:domain ind:AuditLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newValues rdf:type rdf:Property ;
    rdfs:label 'New Values' ;
    rdfs:comment 'Serialized representation of the values after the change.' ;
    rdfs:domain ind:AuditLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditSubcategory rdf:type rdf:Property ;
    rdfs:label 'Audit Subcategory' ;
    rdfs:comment 'More specific sub-category within the audit category.' ;
    rdfs:domain ind:AuditLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedEventId rdf:type rdf:Property ;
    rdfs:label 'Related Event Id' ;
    rdfs:comment 'Identifier of the related event (e.g., claim, enrollment) that triggered the alert.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnrollmentEvent .

ind:patientAge rdf:type rdf:Property ;
    rdfs:label 'Patient Age' ;
    rdfs:comment 'Age of the member at the time of the event.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pharmacyDrugNdc rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Drug Ndc' ;
    rdfs:comment 'NDC identifier for the drug involved in a pharmacy alert.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacyFillDate rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Fill Date' ;
    rdfs:comment 'Date when the prescription was filled.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qualityMetricName rdf:type rdf:Property ;
    rdfs:label 'Quality Metric Name' ;
    rdfs:comment 'Name of the quality metric (e.g., readmission_rate).' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityTargetValue rdf:type rdf:Property ;
    rdfs:label 'Quality Target Value' ;
    rdfs:comment 'Target value for the quality metric.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityActualValue rdf:type rdf:Property ;
    rdfs:label 'Quality Actual Value' ;
    rdfs:comment 'Observed quality metric value.' ;
    rdfs:domain ind:Alert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:questionId rdf:type rdf:Property ;
    rdfs:label 'Question Id' ;
    rdfs:comment 'Unique identifier of the specific survey question being answered within the survey instrument.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:questionText rdf:type rdf:Property ;
    rdfs:label 'Question Text' ;
    rdfs:comment 'Full text of the survey question as presented to the member. Captures the exact wording used in the survey administration.' ;
    rdfs:domain ind:Shared ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:questionCategory rdf:type rdf:Property ;
    rdfs:label 'Question Category' ;
    rdfs:comment 'Thematic category or domain that the survey question addresses, used for grouping and analysis of responses.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseValue rdf:type rdf:Property ;
    rdfs:label 'Response Value' ;
    rdfs:comment 'Raw response value provided by the member. May be numeric score, text response, or selected option depending on question type.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseScore rdf:type rdf:Property ;
    rdfs:label 'Response Score' ;
    rdfs:comment 'Numeric score assigned to the response for quantitative analysis. Standardized scoring based on survey methodology.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surveyAdministrationDate rdf:type rdf:Property ;
    rdfs:label 'Survey Administration Date' ;
    rdfs:comment 'Date when the survey was initially sent or made available to the member for completion.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Survey Completion Date' ;
    rdfs:comment 'Date when the member completed the entire survey instrument, marking the final submission of all responses.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isRequiredQuestion rdf:type rdf:Property ;
    rdfs:label 'Is Required Question' ;
    rdfs:comment 'Indicates whether this question was mandatory for survey completion. True if response was required, false if optional.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isValidated rdf:type rdf:Property ;
    rdfs:label 'Is Validated' ;
    rdfs:comment 'Indicates whether the response has passed data quality validation rules and is approved for analysis.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:validationErrorCode rdf:type rdf:Property ;
    rdfs:label 'Validation Error Code' ;
    rdfs:comment 'Code identifying the specific validation rule that failed if response did not pass quality checks.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationErrorDescription rdf:type rdf:Property ;
    rdfs:label 'Validation Error Description' ;
    rdfs:comment 'Detailed description of the validation error or data quality issue identified with this response.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberEnrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Member Enrollment Date' ;
    rdfs:comment 'Date when the member originally enrolled in the health plan, used to calculate tenure at time of survey.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:memberLanguagePreference rdf:type rdf:Property ;
    rdfs:label 'Member Language Preference' ;
    rdfs:comment 'Preferred language for member communications as indicated in enrollment records. Used to ensure culturally appropriate survey administration.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcpAssigned rdf:type rdf:Property ;
    rdfs:label 'Pcp Assigned' ;
    rdfs:comment 'Indicates whether the member had an assigned Primary Care Physician at the time of survey. Relevant for HMO and POS plans.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careManagementEnrolled rdf:type rdf:Property ;
    rdfs:label 'Care Management Enrolled' ;
    rdfs:comment 'Indicates whether the member was enrolled in a care management or disease management program at time of survey.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorYearClaimsCount rdf:type rdf:Property ;
    rdfs:label 'Prior Year Claims Count' ;
    rdfs:comment 'Total number of claims submitted for the member in the 12 months prior to survey administration. Indicates utilization level.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorYearTotalPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Year Total Paid Amount' ;
    rdfs:comment 'Total amount paid by the plan for member claims in the 12 months prior to survey. Used for cost-based stratification.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grievanceFiledIndicator rdf:type rdf:Property ;
    rdfs:label 'Grievance Filed Indicator' ;
    rdfs:comment 'Indicates whether the member filed a grievance or complaint in the 12 months prior to survey administration.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customerServiceContactCount rdf:type rdf:Property ;
    rdfs:label 'Customer Service Contact Count' ;
    rdfs:comment 'Number of times the member contacted customer service in the 12 months prior to survey administration.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveySampleType rdf:type rdf:Property ;
    rdfs:label 'Survey Sample Type' ;
    rdfs:comment 'Sampling methodology used to select this member for survey participation. Indicates whether random, stratified, or targeted sampling.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyWave rdf:type rdf:Property ;
    rdfs:label 'Survey Wave' ;
    rdfs:comment 'Identifier for the survey administration wave or batch in which this response was collected. Used for tracking survey campaigns.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incentiveOffered rdf:type rdf:Property ;
    rdfs:label 'Incentive Offered' ;
    rdfs:comment 'Indicates whether a financial or non-financial incentive was offered to the member for completing the survey.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responseTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Response Time Seconds' ;
    rdfs:comment 'Time in seconds taken by the member to answer this specific question. Used for quality assessment and fraud detection.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveyCompletionTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Survey Completion Time Minutes' ;
    rdfs:comment 'Total time in minutes taken by the member to complete the entire survey from start to submission.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responseSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Response Source System' ;
    rdfs:comment 'Name of the source system or application from which the survey response data was captured and loaded.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cahpsCompositeMeasure rdf:type rdf:Property ;
    rdfs:label 'Cahps Composite Measure' ;
    rdfs:comment 'CAHPS composite measure category to which this question belongs, if applicable. Used for HEDIS and Star Ratings reporting.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:starRatingMeasure rdf:type rdf:Property ;
    rdfs:label 'Star Rating Measure' ;
    rdfs:comment 'CMS Star Rating measure identifier to which this survey response contributes, if applicable to Medicare Advantage plans.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedFromReporting rdf:type rdf:Property ;
    rdfs:label 'Excluded From Reporting' ;
    rdfs:comment 'Indicates whether this response has been excluded from quality measure reporting due to validation issues or sampling criteria.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weightFactor rdf:type rdf:Property ;
    rdfs:label 'Weight Factor' ;
    rdfs:comment 'Statistical weight applied to this response for population-level analysis and reporting. Adjusts for sampling methodology.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commentText rdf:type rdf:Property ;
    rdfs:label 'Comment Text' ;
    rdfs:comment 'Free-text comment or feedback provided by the member in response to open-ended survey questions.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyMode rdf:type rdf:Property ;
    rdfs:label 'Survey Mode' ;
    rdfs:comment 'Survey administration mode protocol used for this member, indicating whether single-mode or mixed-mode approach was used.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumScheduleId rdf:type rdf:Property ;
    rdfs:label 'Premium Schedule Id' ;
    rdfs:comment 'Unique identifier for the premium schedule record. Primary key for the premium schedule entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumSchedule .

ind:scheduleType rdf:type rdf:Property ;
    rdfs:label 'Schedule Type' ;
    rdfs:comment 'The frequency or type of premium payment schedule (e.g., monthly, quarterly, annual installments).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstPaymentDueDate rdf:type rdf:Property ;
    rdfs:label 'First Payment Due Date' ;
    rdfs:comment 'The date when the first premium payment under this schedule is due.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPaymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Last Payment Due Date' ;
    rdfs:comment 'The date when the final premium payment under this schedule is due.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratePeriod rdf:type rdf:Property ;
    rdfs:label 'Rate Period' ;
    rdfs:comment 'The rating period identifier for which this premium schedule applies (e.g., 2024Q1, 2024-Annual).' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prorationFlag rdf:type rdf:Property ;
    rdfs:label 'Proration Flag' ;
    rdfs:comment 'Indicates whether the premium amount has been prorated for a partial coverage period.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prorationStartDate rdf:type rdf:Property ;
    rdfs:label 'Proration Start Date' ;
    rdfs:comment 'The start date of the partial period for which premium has been prorated.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:prorationEndDate rdf:type rdf:Property ;
    rdfs:label 'Proration End Date' ;
    rdfs:comment 'The end date of the partial period for which premium has been prorated.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentPlanCode rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Code' ;
    rdfs:comment 'The code identifying the specific payment plan arrangement for this premium schedule.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPlanDescription rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Description' ;
    rdfs:comment 'A description of the payment plan arrangement, including any special terms or conditions.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountCode rdf:type rdf:Property ;
    rdfs:label 'Discount Code' ;
    rdfs:comment 'The code identifying the type of discount applied to the premium.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surchargeCode rdf:type rdf:Property ;
    rdfs:label 'Surcharge Code' ;
    rdfs:comment 'The code identifying the type of surcharge applied to the premium.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementDate rdf:type rdf:Property ;
    rdfs:label 'Statement Date' ;
    rdfs:comment 'The date when the premium billing statement was generated for this schedule.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinstatementFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Fee Amount' ;
    rdfs:comment 'The fee charged to reinstate coverage after a lapse due to non-payment.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentReversalFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Reversal Flag' ;
    rdfs:comment 'Indicates whether a payment reversal (e.g., chargeback, returned check) has occurred for this schedule.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentReversalDate rdf:type rdf:Property ;
    rdfs:label 'Payment Reversal Date' ;
    rdfs:comment 'The date when a payment reversal occurred for this premium schedule.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentReversalReason rdf:type rdf:Property ;
    rdfs:label 'Payment Reversal Reason' ;
    rdfs:comment 'The reason for the payment reversal (e.g., insufficient funds, disputed charge, bank error).' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dunningDate rdf:type rdf:Property ;
    rdfs:label 'Dunning Date' ;
    rdfs:comment 'The date when the most recent dunning notice was sent for overdue premium payments.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:terminationNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Termination Notice Date' ;
    rdfs:comment 'The date when a termination notice was sent due to non-payment of premiums.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tobaccoUseFlag rdf:type rdf:Property ;
    rdfs:label 'Tobacco Use Flag' ;
    rdfs:comment 'Indicates whether the member is a tobacco user, which may affect premium rates through tobacco surcharges.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wellnessDiscountFlag rdf:type rdf:Property ;
    rdfs:label 'Wellness Discount Flag' ;
    rdfs:comment 'Indicates whether a wellness program discount has been applied to the premium.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wellnessDiscountPercentage rdf:type rdf:Property ;
    rdfs:label 'Wellness Discount Percentage' ;
    rdfs:comment 'The percentage discount applied to the premium for participation in wellness programs.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateGuaranteeFlag rdf:type rdf:Property ;
    rdfs:label 'Rate Guarantee Flag' ;
    rdfs:comment 'Indicates whether the premium rates in this schedule are guaranteed for a specific period.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateGuaranteeEndDate rdf:type rdf:Property ;
    rdfs:label 'Rate Guarantee End Date' ;
    rdfs:comment 'The date when the rate guarantee period ends and rates may be subject to change.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Minimum Participation Flag' ;
    rdfs:comment 'Indicates whether minimum participation requirements have been met for group coverage.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:compositeRateFlag rdf:type rdf:Property ;
    rdfs:label 'Composite Rate Flag' ;
    rdfs:comment 'Indicates whether composite rating (single rate for all members regardless of age) is used for this premium schedule.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ageRatedFlag rdf:type rdf:Property ;
    rdfs:label 'Age Rated Flag' ;
    rdfs:comment 'Indicates whether age-based rating is used to calculate premiums in this schedule.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:experienceRatedFlag rdf:type rdf:Property ;
    rdfs:label 'Experience Rated Flag' ;
    rdfs:comment 'Indicates whether experience rating (based on the group\'s claims history) is used for premium calculation.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communityRatedFlag rdf:type rdf:Property ;
    rdfs:label 'Community Rated Flag' ;
    rdfs:comment 'Indicates whether community rating (same rate for all members in a geographic area) is used for premium calculation.' ;
    rdfs:domain ind:PremiumSchedule ;
    rdf:type owl:DatatypeProperty ;
