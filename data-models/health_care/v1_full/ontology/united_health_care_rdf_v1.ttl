    rdfs:comment 'Indicates whether the provider disclosed any malpractice claims on their application.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:malpracticeClaimsCount rdf:type rdf:Property ;
    rdfs:label 'Malpractice Claims Count' ;
    rdfs:comment 'Number of malpractice claims disclosed or found during verification.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qualityReviewCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Quality Review Completed Date' ;
    rdfs:comment 'Date when the quality review was completed if required.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:siteVisitRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Site Visit Required Flag' ;
    rdfs:comment 'Indicates whether an on-site practice location visit is required for credentialing.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:siteVisitCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Site Visit Completed Date' ;
    rdfs:comment 'Date when the site visit was completed if required.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionPlanDescription rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Description' ;
    rdfs:comment 'Description of the corrective action plan required for conditional approval.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ongoingMonitoringFlag rdf:type rdf:Property ;
    rdfs:label 'Ongoing Monitoring Flag' ;
    rdfs:comment 'Indicates whether the provider is subject to ongoing monitoring between recredentialing cycles.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidOptOutFlag rdf:type rdf:Property ;
    rdfs:label 'Medicaid Opt Out Flag' ;
    rdfs:comment 'Indicates whether the provider has opted out of Medicaid participation.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telehealthCredentialedFlag rdf:type rdf:Property ;
    rdfs:label 'Telehealth Credentialed Flag' ;
    rdfs:comment 'Indicates whether the provider is credentialed to provide telehealth services.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:culturalCompetencyTrainingFlag rdf:type rdf:Property ;
    rdfs:label 'Cultural Competency Training Flag' ;
    rdfs:comment 'Indicates whether the provider has completed required cultural competency training.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaTrainingFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Training Flag' ;
    rdfs:comment 'Indicates whether the provider has completed required HIPAA privacy and security training.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudWasteAbuseTrainingFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Waste Abuse Training Flag' ;
    rdfs:comment 'Indicates whether the provider has completed required fraud, waste, and abuse prevention training.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudWasteAbuseTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Fraud Waste Abuse Training Date' ;
    rdfs:comment 'Date when the provider completed fraud, waste, and abuse prevention training.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialingSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Credentialing Source System' ;
    rdfs:comment 'Name of the source system or platform where the credentialing record originated.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingFileLocation rdf:type rdf:Property ;
    rdfs:label 'Credentialing File Location' ;
    rdfs:comment 'File path or document management system location where credentialing documents are stored.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:knowledgeUsageId rdf:type rdf:Property ;
    rdfs:label 'Knowledge Usage Id' ;
    rdfs:comment 'Unique identifier for each knowledge article usage event. Primary key for the knowledge usage transaction log.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:articleTitle rdf:type rdf:Property ;
    rdfs:label 'Article Title' ;
    rdfs:comment 'The title or headline of the knowledge article accessed by the user.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:articleCategory rdf:type rdf:Property ;
    rdfs:label 'Article Category' ;
    rdfs:comment 'The primary category or topic area of the knowledge article, aligned with service domain taxonomy.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:articleSubcategory rdf:type rdf:Property ;
    rdfs:label 'Article Subcategory' ;
    rdfs:comment 'The secondary classification or subcategory of the knowledge article for more granular topic identification.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:userAgentId rdf:type rdf:Property ;
    rdfs:label 'User Agent Id' ;
    rdfs:comment 'Unique identifier of the user who accessed the knowledge article. May represent a member, provider, or internal agent.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:userType rdf:type rdf:Property ;
    rdfs:label 'User Type' ;
    rdfs:comment 'Classification of the user accessing the knowledge article, indicating whether they are a member, provider, internal agent, or other user type.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageType rdf:type rdf:Property ;
    rdfs:label 'Usage Type' ;
    rdfs:comment 'The type of action performed on the knowledge article, such as viewing, searching, downloading, or providing feedback.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchQuery rdf:type rdf:Property ;
    rdfs:label 'Search Query' ;
    rdfs:comment 'The search terms or query text entered by the user that led to the article being accessed. Null for direct article views.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchResultPosition rdf:type rdf:Property ;
    rdfs:label 'Search Result Position' ;
    rdfs:comment 'The position or rank of the article in the search results list when accessed via search. Null for non-search access.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:searchResultCount rdf:type rdf:Property ;
    rdfs:label 'Search Result Count' ;
    rdfs:comment 'The total number of articles returned in the search results. Null for non-search access.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accessTimestamp rdf:type rdf:Property ;
    rdfs:label 'Access Timestamp' ;
    rdfs:comment 'The date and time when the knowledge article was accessed by the user, in format yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:accessDate rdf:type rdf:Property ;
    rdfs:label 'Access Date' ;
    rdfs:comment 'The calendar date when the knowledge article was accessed, in format yyyy-MM-dd, for date-based reporting and aggregation.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:timeSpentSeconds rdf:type rdf:Property ;
    rdfs:label 'Time Spent Seconds' ;
    rdfs:comment 'The duration in seconds that the user spent viewing or interacting with the knowledge article.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:articleVersion rdf:type rdf:Property ;
    rdfs:label 'Article Version' ;
    rdfs:comment 'The version number or identifier of the knowledge article at the time it was accessed, supporting version tracking and content evolution analysis.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:articleLanguage rdf:type rdf:Property ;
    rdfs:label 'Article Language' ;
    rdfs:comment 'The language in which the knowledge article was presented to the user, using 3-letter language codes.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:helpfulFlag rdf:type rdf:Property ;
    rdfs:label 'Helpful Flag' ;
    rdfs:comment 'Boolean indicator of whether the user marked the article as helpful. Null if no feedback was provided.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ratingScore rdf:type rdf:Property ;
    rdfs:label 'Rating Score' ;
    rdfs:comment 'Numeric rating score provided by the user for the knowledge article, typically on a scale of 1-5. Null if no rating was provided.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolvedIssueFlag rdf:type rdf:Property ;
    rdfs:label 'Resolved Issue Flag' ;
    rdfs:comment 'Boolean indicator of whether the knowledge article successfully resolved the user\'s issue or inquiry. Null if not tracked or not applicable.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referrerUrl rdf:type rdf:Property ;
    rdfs:label 'Referrer Url' ;
    rdfs:comment 'The URL or page from which the user navigated to access the knowledge article, supporting navigation path analysis.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:articleStatus rdf:type rdf:Property ;
    rdfs:label 'Article Status' ;
    rdfs:comment 'The publication status of the knowledge article at the time it was accessed.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:articleAuthor rdf:type rdf:Property ;
    rdfs:label 'Article Author' ;
    rdfs:comment 'The name or identifier of the person or team who authored the knowledge article.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:articlePublishedDate rdf:type rdf:Property ;
    rdfs:label 'Article Published Date' ;
    rdfs:comment 'The date when the knowledge article was originally published, in format yyyy-MM-dd.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:articleLastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Article Last Updated Date' ;
    rdfs:comment 'The date when the knowledge article was last updated or revised, in format yyyy-MM-dd.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:articleViewCount rdf:type rdf:Property ;
    rdfs:label 'Article View Count' ;
    rdfs:comment 'The cumulative number of times the article has been viewed at the time of this access event, supporting popularity analysis.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:articleHelpfulCount rdf:type rdf:Property ;
    rdfs:label 'Article Helpful Count' ;
    rdfs:comment 'The cumulative number of times the article has been marked as helpful at the time of this access event.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:articleUnhelpfulCount rdf:type rdf:Property ;
    rdfs:label 'Article Unhelpful Count' ;
    rdfs:comment 'The cumulative number of times the article has been marked as unhelpful at the time of this access event.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:articleAverageRating rdf:type rdf:Property ;
    rdfs:label 'Article Average Rating' ;
    rdfs:comment 'The average rating score of the article at the time of this access event, typically on a scale of 1.00 to 5.00.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accessMethod rdf:type rdf:Property ;
    rdfs:label 'Access Method' ;
    rdfs:comment 'The method by which the user discovered or accessed the knowledge article.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendationEngine rdf:type rdf:Property ;
    rdfs:label 'Recommendation Engine' ;
    rdfs:comment 'The name or identifier of the recommendation engine or algorithm that suggested the article, if applicable. Null for non-recommended access.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendationScore rdf:type rdf:Property ;
    rdfs:label 'Recommendation Score' ;
    rdfs:comment 'The relevance or confidence score assigned by the recommendation engine, typically between 0.0000 and 1.0000. Null for non-recommended access.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:caseType rdf:type rdf:Property ;
    rdfs:label 'Case Type' ;
    rdfs:comment 'The type of customer service case or interaction associated with this knowledge usage event. Null if not part of a case.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:casePriority rdf:type rdf:Property ;
    rdfs:label 'Case Priority' ;
    rdfs:comment 'The priority level of the customer service case associated with this knowledge usage event. Null if not part of a case.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:articleTags rdf:type rdf:Property ;
    rdfs:label 'Article Tags' ;
    rdfs:comment 'Comma-separated list of tags or keywords associated with the knowledge article for categorization and search optimization.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:articleFormat rdf:type rdf:Property ;
    rdfs:label 'Article Format' ;
    rdfs:comment 'The format or media type of the knowledge article content.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:articleLengthWords rdf:type rdf:Property ;
    rdfs:label 'Article Length Words' ;
    rdfs:comment 'The length of the knowledge article measured in word count, for content analysis purposes.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:articleReadabilityScore rdf:type rdf:Property ;
    rdfs:label 'Article Readability Score' ;
    rdfs:comment 'The readability score of the knowledge article, typically using Flesch-Kincaid or similar metrics, indicating content accessibility.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mobileOptimizedFlag rdf:type rdf:Property ;
    rdfs:label 'Mobile Optimized Flag' ;
    rdfs:comment 'Boolean indicator of whether the knowledge article is optimized for mobile device viewing.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ingestionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ingestion Timestamp' ;
    rdfs:comment 'The date and time when the usage event was ingested into the data lakehouse, in format yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:KnowledgeUsage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:serviceScheduleId rdf:type rdf:Property ;
    rdfs:label 'Service Schedule Id' ;
    rdfs:comment 'Unique identifier for the service agent schedule record. Primary key for the service schedule entity.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shiftStartTime rdf:type rdf:Property ;
    rdfs:label 'Shift Start Time' ;
    rdfs:comment 'The exact date and time when the agent\'s scheduled shift begins. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:shiftEndTime rdf:type rdf:Property ;
    rdfs:label 'Shift End Time' ;
    rdfs:comment 'The exact date and time when the agent\'s scheduled shift ends. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:shiftDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Shift Duration Minutes' ;
    rdfs:comment 'Total scheduled duration of the shift in minutes, calculated from start to end time.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shiftType rdf:type rdf:Property ;
    rdfs:label 'Shift Type' ;
    rdfs:comment 'Classification of the shift type indicating whether it is regular hours, overtime, on-call, split shift, weekend, holiday, or training.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftCode rdf:type rdf:Property ;
    rdfs:label 'Shift Code' ;
    rdfs:comment 'Internal code or identifier for the shift pattern or template used for this schedule (e.g., DAY1, NIGHT2, SWING).' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakStartTime1 rdf:type rdf:Property ;
    rdfs:label 'Break Start Time 1' ;
    rdfs:comment 'The scheduled start time for the agent\'s first break period during the shift. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:breakEndTime1 rdf:type rdf:Property ;
    rdfs:label 'Break End Time 1' ;
    rdfs:comment 'The scheduled end time for the agent\'s first break period during the shift. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:breakDurationMinutes1 rdf:type rdf:Property ;
    rdfs:label 'Break Duration Minutes 1' ;
    rdfs:comment 'Duration of the first break period in minutes.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breakType1 rdf:type rdf:Property ;
    rdfs:label 'Break Type 1' ;
    rdfs:comment 'Classification of the first break indicating whether it is paid, unpaid, a meal break, or a rest break.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakStartTime2 rdf:type rdf:Property ;
    rdfs:label 'Break Start Time 2' ;
    rdfs:comment 'The scheduled start time for the agent\'s second break period during the shift. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:breakEndTime2 rdf:type rdf:Property ;
    rdfs:label 'Break End Time 2' ;
    rdfs:comment 'The scheduled end time for the agent\'s second break period during the shift. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:breakDurationMinutes2 rdf:type rdf:Property ;
    rdfs:label 'Break Duration Minutes 2' ;
    rdfs:comment 'Duration of the second break period in minutes.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breakType2 rdf:type rdf:Property ;
    rdfs:label 'Break Type 2' ;
    rdfs:comment 'Classification of the second break indicating whether it is paid, unpaid, a meal break, or a rest break.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakStartTime3 rdf:type rdf:Property ;
    rdfs:label 'Break Start Time 3' ;
    rdfs:comment 'The scheduled start time for the agent\'s third break period during the shift. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:breakEndTime3 rdf:type rdf:Property ;
    rdfs:label 'Break End Time 3' ;
    rdfs:comment 'The scheduled end time for the agent\'s third break period during the shift. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:breakDurationMinutes3 rdf:type rdf:Property ;
    rdfs:label 'Break Duration Minutes 3' ;
    rdfs:comment 'Duration of the third break period in minutes.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breakType3 rdf:type rdf:Property ;
    rdfs:label 'Break Type 3' ;
    rdfs:comment 'Classification of the third break indicating whether it is paid, unpaid, a meal break, or a rest break.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalBreakDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Total Break Duration Minutes' ;
    rdfs:comment 'Total duration of all scheduled break periods in minutes for this shift.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:productiveHours rdf:type rdf:Property ;
    rdfs:label 'Productive Hours' ;
    rdfs:comment 'Total productive hours for the shift, calculated as shift duration minus break time.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assignedQueue1 rdf:type rdf:Property ;
    rdfs:label 'Assigned Queue 1' ;
    rdfs:comment 'Primary service queue or skill group assigned to the agent for this shift (e.g., Member Inquiries, Claims Support, Provider Services).' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedQueue2 rdf:type rdf:Property ;
    rdfs:label 'Assigned Queue 2' ;
    rdfs:comment 'Secondary service queue or skill group assigned to the agent for this shift.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedQueue3 rdf:type rdf:Property ;
    rdfs:label 'Assigned Queue 3' ;
    rdfs:comment 'Tertiary service queue or skill group assigned to the agent for this shift.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryLob rdf:type rdf:Property ;
    rdfs:label 'Primary Lob' ;
    rdfs:comment 'Primary line of business the agent is scheduled to support during this shift (Commercial, Medicare, Medicaid, Dual Eligible, Marketplace, ASO).' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceChannel rdf:type rdf:Property ;
    rdfs:label 'Service Channel' ;
    rdfs:comment 'Primary communication channel the agent is scheduled to handle during this shift (phone, email, chat, web, mobile app, SMS, video, social media).' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:DatatypeProperty ;
