    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientSafetyEventStatus rdf:type rdf:Property ;
    rdfs:label 'Patient Safety Event Status' ;
    rdfs:comment 'Current lifecycle status of the safety event.' ;
    rdfs:domain ind:PatientSafetyEvent ;
    rdf:type owl:DatatypeProperty ;
