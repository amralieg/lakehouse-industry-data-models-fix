    rdfs:range xsd:string .

ind:icd10CodeRange rdf:type rdf:Property ;
    rdfs:label 'Icd10 Code Range' ;
    rdfs:comment 'Representative range or list of ICD-10 diagnosis codes that map to this HCC category.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chronicConditionIndicator rdf:type rdf:Property ;
    rdfs:label 'Chronic Condition Indicator' ;
    rdfs:comment 'Indicates whether this HCC category represents a chronic condition requiring ongoing management.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acaModelIndicator rdf:type rdf:Property ;
    rdfs:label 'Aca Model Indicator' ;
    rdfs:comment 'Indicates whether this HCC category is used in the ACA marketplace risk adjustment model.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareAdvantageIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicare Advantage Indicator' ;
    rdfs:comment 'Indicates whether this HCC category is used in the Medicare Advantage risk adjustment model.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsAnnouncementDate rdf:type rdf:Property ;
    rdfs:label 'Cms Announcement Date' ;
    rdfs:comment 'The date when CMS officially announced this HCC category or changes to it.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:codingGuidance rdf:type rdf:Property ;
    rdfs:label 'Coding Guidance' ;
    rdfs:comment 'Official coding guidance and best practices for accurately capturing diagnoses in this HCC category.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalValidationRequired rdf:type rdf:Property ;
    rdfs:label 'Clinical Validation Required' ;
    rdfs:comment 'Indicates whether this HCC category requires clinical validation or chart review before submission.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rapsSubmissionEligible rdf:type rdf:Property ;
    rdfs:label 'Raps Submission Eligible' ;
    rdfs:comment 'Indicates whether this HCC category is eligible for submission via the RAPS system.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:edpsSubmissionEligible rdf:type rdf:Property ;
    rdfs:label 'Edps Submission Eligible' ;
    rdfs:comment 'Indicates whether this HCC category is eligible for submission via the EDPS encounter data system.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revenueImpactCategory rdf:type rdf:Property ;
