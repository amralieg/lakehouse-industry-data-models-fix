    rdfs:comment 'Tax Identification Number of the receiving provider\'s practice or organization.' ;
    rdfs:domain ind:ReferralNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationProviderTaxonomyCode rdf:type rdf:Property ;
    rdfs:label 'Destination Provider Taxonomy Code' ;
    rdfs:comment 'Healthcare Provider Taxonomy Code identifying the specialty and classification of the receiving provider.' ;
    rdfs:domain ind:ReferralNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationProviderSpecialty rdf:type rdf:Property ;
    rdfs:label 'Destination Provider Specialty' ;
    rdfs:comment 'Medical specialty or practice area of the receiving provider.' ;
    rdfs:domain ind:ReferralNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationProviderType rdf:type rdf:Property ;
    rdfs:label 'Destination Provider Type' ;
    rdfs:comment 'Classification of the receiving provider entity type.' ;
    rdfs:domain ind:ReferralNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralDate rdf:type rdf:Property ;
