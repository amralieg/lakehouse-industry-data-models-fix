    rdfs:comment 'Currency code for the premium amount, typically USD for United States operations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationRate rdf:type rdf:Property ;
    rdfs:label 'Participation Rate' ;
    rdfs:comment 'Percentage of eligible employees participating in the group health plan.' ;
    rdfs:domain ind:UnderwritingDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumEmployerContributionMet rdf:type rdf:Property ;
    rdfs:label 'Minimum Employer Contribution Met' ;
    rdfs:comment 'Indicates whether the employer meets the minimum contribution requirements.' ;
