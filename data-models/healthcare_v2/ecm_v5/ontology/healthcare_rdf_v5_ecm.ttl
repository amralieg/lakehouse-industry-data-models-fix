ind:restrictions rdf:type rdf:Property ;
    rdfs:label 'Restrictions' ;
    rdfs:comment 'Specific usage restrictions or prohibitions (e.g., no re-identification).' ;
    rdfs:domain ind:DuaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careGapId rdf:type rdf:Property ;
    rdfs:label 'Care Gap Id' ;
    rdfs:comment 'System-generated unique identifier for each care gap record.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareGap .

ind:evidenceObservationId rdf:type rdf:Property ;
    rdfs:label 'Evidence Observation Id' ;
    rdfs:comment 'Foreign key linking to clinical.observation. Business justification: Care gaps require clinical evidence (e.g., last HbA1c observation proving diabetes management gap). Links gap to the specific observation that triggered or evidences the gap for audit.' ;
    rdfs:domain ind:ClinicalAiCareGap ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Observation .

ind:gapSnomedConceptId rdf:type rdf:Property ;
    rdfs:label 'Gap Snomed Concept Id' ;
    rdfs:comment 'Foreign key linking to reference.snomed_concept. Business justification: HEDIS/quality measure care gap detection requires standardized clinical concept coding to align detected gaps with measure specifications and enable cross-system interoperability for gap closure workf' ;
    rdfs:domain ind:ClinicalAiCareGap ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SnomedConcept .

ind:populationHealthDynamicCohortDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Population Health Dynamic Cohort Definition Id' ;
    rdfs:comment 'Foreign key linking to population_health.dynamic_cohort_definition. Business justification: Population health programs define cohorts then identify care gaps within them. Tracking which cohort analysis detected a care gap enables program effectiveness reporting and gap closure workflows requ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PopulationHealthDynamicCohortDefinition .

ind:recommendedCptCodeId rdf:type rdf:Property ;
    rdfs:label 'Recommended Cpt Code Id' ;
    rdfs:comment 'Foreign key linking to reference.cpt_code. Business justification: Care gap closure workflows identify the specific billable procedure (CPT) that resolves the gap, enabling automated order suggestions, scheduling integration, and reimbursement tracking for value-base' ;
    rdfs:domain ind:ClinicalAiCareGap ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CptCode .

ind:responsibleClinicianId rdf:type rdf:Property ;
    rdfs:label 'Responsible Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Value-based care programs assign each care gap (missed screening, overdue lab) to a responsible clinician accountable for closure. HEDIS/Stars quality reporting requires clinician-level gap attributio' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:careGapCategory rdf:type rdf:Property ;
    rdfs:label 'Care Gap Category' ;
    rdfs:comment 'Higher-level classification of the gap (e.g., preventive, diagnostic).' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalAiCareGapStatus rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Care Gap Status' ;
    rdfs:comment 'Current lifecycle status of the care gap.' ;
    rdfs:domain ind:ClinicalAiCareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detection Timestamp' ;
    rdfs:comment 'Date and time when the care gap was first identified by the AI model.' ;
    rdfs:domain ind:ClinicalAiCareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:gapSeverity rdf:type rdf:Property ;
    rdfs:label 'Gap Severity' ;
    rdfs:comment 'Clinical severity rating of the identified care gap.' ;
    rdfs:domain ind:ClinicalAiCareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interventionDueDate rdf:type rdf:Property ;
    rdfs:label 'Intervention Due Date' ;
    rdfs:comment 'Target date by which the recommended intervention should be completed.' ;
    rdfs:domain ind:ClinicalAiCareGap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isCritical rdf:type rdf:Property ;
    rdfs:label 'Is Critical' ;
    rdfs:comment 'Indicates whether the care gap is flagged as critical for immediate action.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modelInferenceLogId rdf:type rdf:Property ;
    rdfs:label 'Model Inference Log Id' ;
    rdfs:comment 'Unique surrogate key for each model inference event record.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ModelInferenceLog .

ind:inferenceDurationMs rdf:type rdf:Property ;
    rdfs:label 'Inference Duration Ms' ;
    rdfs:comment 'Elapsed time in milliseconds for the inference to complete.' ;
    rdfs:domain ind:ClinicalAiModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inferenceStatus rdf:type rdf:Property ;
    rdfs:label 'Inference Status' ;
    rdfs:comment 'Result status of the inference execution.' ;
    rdfs:domain ind:ClinicalAi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inputFeaturesHash rdf:type rdf:Property ;
    rdfs:label 'Input Features Hash' ;
    rdfs:comment 'Hash of the input feature snapshot used for the inference to enable data lineage.' ;
    rdfs:domain ind:ClinicalAiModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nlpEntities rdf:type rdf:Property ;
    rdfs:label 'Nlp Entities' ;
    rdfs:comment 'JSON string of clinical entities extracted by NLP from unstructured text.' ;
    rdfs:domain ind:ClinicalAiModelInferenceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:predictionLabel rdf:type rdf:Property ;
