ind:workHistoryEndDate rdf:type rdf:Property ;
    rdfs:label 'Work History End Date' ;
    rdfs:comment 'End date of the provider\'s employment at the verified employer.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:malpracticeClaimsPaidCount rdf:type rdf:Property ;
    rdfs:label 'Malpractice Claims Paid Count' ;
    rdfs:comment 'Number of malpractice claims that resulted in payment on behalf of the provider.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:verificationRequestDate rdf:type rdf:Property ;
    rdfs:label 'Verification Request Date' ;
    rdfs:comment 'Date when the verification request was initiated or submitted to the primary source.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verificationResponseDate rdf:type rdf:Property ;
    rdfs:label 'Verification Response Date' ;
    rdfs:comment 'Date when the response was received from the primary source.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verificationTurnaroundDays rdf:type rdf:Property ;
    rdfs:label 'Verification Turnaround Days' ;
    rdfs:comment 'Number of days between verification request and response receipt.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:verificationDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Verification Document Url' ;
    rdfs:comment 'URL or file path where the verification document is stored in the document management system.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifierName rdf:type rdf:Property ;
    rdfs:label 'Verifier Name' ;
    rdfs:comment 'Name of the credentialing specialist or staff member who performed the verification.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerAgentId rdf:type rdf:Property ;
    rdfs:label 'Reviewer Agent Id' ;
    rdfs:comment 'Unique identifier for the supervisor or quality assurance staff who reviewed the verification.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:verificationNotes rdf:type rdf:Property ;
    rdfs:label 'Verification Notes' ;
    rdfs:comment 'Free-text notes or comments recorded by the verifier regarding the verification process or findings.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reVerificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Re Verification Due Date' ;
    rdfs:comment 'Date when this verification must be re-performed as part of ongoing monitoring or re-credentialing.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:committeeId rdf:type rdf:Property ;
    rdfs:label 'Committee Id' ;
    rdfs:comment 'Unique identifier for the credentialing committee record. Primary key for the credentialing committee entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Committee .

ind:charterDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Charter Document Reference' ;
    rdfs:comment 'Reference identifier or location of the committee\'s charter document that defines its authority and responsibilities.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formationDate rdf:type rdf:Property ;
    rdfs:label 'Formation Date' ;
    rdfs:comment 'Date when the credentialing committee was officially formed and authorized to operate.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dissolutionDate rdf:type rdf:Property ;
    rdfs:label 'Dissolution Date' ;
    rdfs:comment 'Date when the credentialing committee was officially dissolved or terminated.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:meetingFrequency rdf:type rdf:Property ;
    rdfs:label 'Meeting Frequency' ;
    rdfs:comment 'Scheduled frequency at which the credentialing committee convenes for regular meetings.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meetingDayOfWeek rdf:type rdf:Property ;
    rdfs:label 'Meeting Day Of Week' ;
    rdfs:comment 'Standard day of the week when committee meetings are scheduled.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meetingTime rdf:type rdf:Property ;
    rdfs:label 'Meeting Time' ;
    rdfs:comment 'Standard time of day when committee meetings are scheduled (e.g., 14:00, 2:00 PM).' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meetingFormat rdf:type rdf:Property ;
    rdfs:label 'Meeting Format' ;
    rdfs:comment 'Format in which committee meetings are conducted.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quorumRequirement rdf:type rdf:Property ;
    rdfs:label 'Quorum Requirement' ;
    rdfs:comment 'Minimum number of committee members required to be present for official business and voting.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quorumPercentage rdf:type rdf:Property ;
    rdfs:label 'Quorum Percentage' ;
    rdfs:comment 'Minimum percentage of committee members required to be present for official business and voting.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:votingThresholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Voting Threshold Percentage' ;
    rdfs:comment 'Percentage of votes required to approve credentialing decisions (e.g., simple majority 50%, supermajority 66.67%).' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chairNpi rdf:type rdf:Property ;
    rdfs:label 'Chair Npi' ;
    rdfs:comment 'National Provider Identifier of the committee chairperson.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chairName rdf:type rdf:Property ;
    rdfs:label 'Chair Name' ;
    rdfs:comment 'Full name of the committee chairperson.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:viceChairNpi rdf:type rdf:Property ;
    rdfs:label 'Vice Chair Npi' ;
    rdfs:comment 'National Provider Identifier of the committee vice chairperson.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:viceChairName rdf:type rdf:Property ;
    rdfs:label 'Vice Chair Name' ;
    rdfs:comment 'Full name of the committee vice chairperson.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secretaryNpi rdf:type rdf:Property ;
    rdfs:label 'Secretary Npi' ;
    rdfs:comment 'National Provider Identifier of the committee secretary responsible for meeting minutes and documentation.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secretaryName rdf:type rdf:Property ;
    rdfs:label 'Secretary Name' ;
    rdfs:comment 'Full name of the committee secretary.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:physicianMemberCount rdf:type rdf:Property ;
    rdfs:label 'Physician Member Count' ;
    rdfs:comment 'Number of physician members serving on the credentialing committee.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nonPhysicianMemberCount rdf:type rdf:Property ;
    rdfs:label 'Non Physician Member Count' ;
    rdfs:comment 'Number of non-physician members (e.g., nurses, administrators) serving on the credentialing committee.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scopeOfAuthority rdf:type rdf:Property ;
    rdfs:label 'Scope Of Authority' ;
    rdfs:comment 'Defines the credentialing activities and decisions the committee is authorized to make.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerTypesReviewed rdf:type rdf:Property ;
    rdfs:label 'Provider Types Reviewed' ;
    rdfs:comment 'Types of healthcare providers reviewed by this committee (e.g., physicians, nurse practitioners, physician assistants, dentists).' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyFocus rdf:type rdf:Property ;
    rdfs:label 'Specialty Focus' ;
    rdfs:comment 'Medical specialties or service lines that are the primary focus of this credentialing committee.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegatedAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Delegated Authority Flag' ;
    rdfs:comment 'Indicates whether this committee has delegated credentialing authority from the health plan\'s board or executive leadership.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:delegationSource rdf:type rdf:Property ;
    rdfs:label 'Delegation Source' ;
    rdfs:comment 'Entity or governing body that delegated credentialing authority to this committee (e.g., Board of Directors, Medical Director).' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Delegation Effective Date' ;
    rdfs:comment 'Date when the delegated credentialing authority became effective for this committee.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastAccreditationDate rdf:type rdf:Property ;
    rdfs:label 'Last Accreditation Date' ;
    rdfs:comment 'Date of the most recent accreditation review for the credentialing program.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextAccreditationDate rdf:type rdf:Property ;
    rdfs:label 'Next Accreditation Date' ;
    rdfs:comment 'Scheduled date for the next accreditation review of the credentialing program.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:administrativeSupportDepartment rdf:type rdf:Property ;
    rdfs:label 'Administrative Support Department' ;
    rdfs:comment 'Department or unit providing administrative support to the credentialing committee.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meetingNotificationDays rdf:type rdf:Property ;
    rdfs:label 'Meeting Notification Days' ;
    rdfs:comment 'Number of days in advance that committee members are notified of upcoming meetings.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agendaDistributionDays rdf:type rdf:Property ;
    rdfs:label 'Agenda Distribution Days' ;
    rdfs:comment 'Number of days in advance that meeting agendas and materials are distributed to committee members.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minutesApprovalTurnaroundDays rdf:type rdf:Property ;
    rdfs:label 'Minutes Approval Turnaround Days' ;
    rdfs:comment 'Number of days within which meeting minutes must be drafted, reviewed, and approved.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:decisionNotificationTurnaroundDays rdf:type rdf:Property ;
    rdfs:label 'Decision Notification Turnaround Days' ;
    rdfs:comment 'Number of days within which credentialing decisions must be communicated to providers after committee approval.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appealsProcessAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Appeals Process Available Flag' ;
    rdfs:comment 'Indicates whether providers have the right to appeal adverse credentialing decisions made by this committee.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerReviewProtectionFlag rdf:type rdf:Property ;
    rdfs:label 'Peer Review Protection Flag' ;
    rdfs:comment 'Indicates whether committee proceedings are protected under state peer review statutes.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:confidentialityAgreementRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Agreement Required Flag' ;
    rdfs:comment 'Indicates whether committee members are required to sign confidentiality agreements.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conflictOfInterestPolicyFlag rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Policy Flag' ;
    rdfs:comment 'Indicates whether the committee has a formal conflict of interest policy requiring member recusal when reviewing providers with whom they have relationships.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualTrainingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Annual Training Required Flag' ;
    rdfs:comment 'Indicates whether committee members are required to complete annual credentialing training.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Next Training Date' ;
    rdfs:comment 'Scheduled date for the next credentialing training session for committee members.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:caqhIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Caqh Integration Flag' ;
    rdfs:comment 'Indicates whether the committee utilizes CAQH ProView data in its credentialing reviews.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionsScreeningRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Sanctions Screening Required Flag' ;
    rdfs:comment 'Indicates whether the committee requires screening against OIG, SAM, and state sanctions databases.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:malpracticeInsuranceVerificationFlag rdf:type rdf:Property ;
    rdfs:label 'Malpractice Insurance Verification Flag' ;
    rdfs:comment 'Indicates whether the committee requires verification of current malpractice insurance coverage.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:boardCertificationVerificationFlag rdf:type rdf:Property ;
    rdfs:label 'Board Certification Verification Flag' ;
    rdfs:comment 'Indicates whether the committee requires verification of board certification status.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deaVerificationFlag rdf:type rdf:Property ;
    rdfs:label 'Dea Verification Flag' ;
    rdfs:comment 'Indicates whether the committee requires verification of DEA registration for prescribing providers.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateLicenseVerificationFlag rdf:type rdf:Property ;
    rdfs:label 'State License Verification Flag' ;
    rdfs:comment 'Indicates whether the committee requires verification of state medical licenses.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expeditedReviewAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Expedited Review Available Flag' ;
    rdfs:comment 'Indicates whether the committee offers expedited credentialing review for urgent provider needs.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:virtualVotingAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Virtual Voting Allowed Flag' ;
    rdfs:comment 'Indicates whether committee members are allowed to vote on credentialing decisions electronically or remotely.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:proxyVotingAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Proxy Voting Allowed Flag' ;
    rdfs:comment 'Indicates whether committee members can designate proxy voters in their absence.' ;
    rdfs:domain ind:Committee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:npdbQueryRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Npdb Query Required Flag' ;
    rdfs:comment 'Indicates whether the committee requires querying the National Practitioner Data Bank as part of credentialing reviews.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionScreeningId rdf:type rdf:Property ;
    rdfs:label 'Sanction Screening Id' ;
    rdfs:comment 'Unique identifier for the sanction screening record. Primary key for the sanction screening transaction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SanctionScreening .

ind:providerFirstName rdf:type rdf:Property ;
    rdfs:label 'Provider First Name' ;
    rdfs:comment 'First name of the individual provider being screened for sanctions. Used for matching against sanction lists.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerLastName rdf:type rdf:Property ;
    rdfs:label 'Provider Last Name' ;
    rdfs:comment 'Last name of the individual provider being screened for sanctions. Primary identifier for matching against sanction lists.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerMiddleName rdf:type rdf:Property ;
    rdfs:label 'Provider Middle Name' ;
    rdfs:comment 'Middle name or initial of the individual provider being screened. Used for enhanced matching accuracy.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerSuffix rdf:type rdf:Property ;
    rdfs:label 'Provider Suffix' ;
    rdfs:comment 'Suffix or credential designation for the provider name (e.g., Jr, Sr, MD, DO).' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerOrganizationName rdf:type rdf:Property ;
    rdfs:label 'Provider Organization Name' ;
    rdfs:comment 'Legal name of the provider organization or practice being screened for sanctions.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningDate rdf:type rdf:Property ;
    rdfs:label 'Screening Date' ;
    rdfs:comment 'The date on which the sanction screening was performed for the provider.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:screeningTimestamp rdf:type rdf:Property ;
    rdfs:label 'Screening Timestamp' ;
    rdfs:comment 'The precise date and time when the sanction screening was executed, including time zone information.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:screeningType rdf:type rdf:Property ;
    rdfs:label 'Screening Type' ;
    rdfs:comment 'The type or purpose of the sanction screening (e.g., initial credentialing, recredentialing, monthly monitoring, ad-hoc review).' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oigScreeningPerformed rdf:type rdf:Property ;
    rdfs:label 'Oig Screening Performed' ;
    rdfs:comment 'Indicates whether screening against the OIG List of Excluded Individuals and Entities (LEIE) was performed.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oigScreeningResult rdf:type rdf:Property ;
    rdfs:label 'Oig Screening Result' ;
    rdfs:comment 'The outcome of the OIG LEIE screening indicating whether the provider was found on the exclusion list.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samScreeningPerformed rdf:type rdf:Property ;
    rdfs:label 'Sam Screening Performed' ;
    rdfs:comment 'Indicates whether screening against the System for Award Management (SAM) exclusion database was performed.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:samScreeningResult rdf:type rdf:Property ;
    rdfs:label 'Sam Screening Result' ;
    rdfs:comment 'The outcome of the SAM exclusion screening indicating whether the provider was found on the federal exclusion list.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateMedicaidScreeningPerformed rdf:type rdf:Property ;
    rdfs:label 'State Medicaid Screening Performed' ;
    rdfs:comment 'Indicates whether screening against state-specific Medicaid exclusion lists was performed.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateMedicaidScreeningResult rdf:type rdf:Property ;
    rdfs:label 'State Medicaid Screening Result' ;
    rdfs:comment 'The outcome of state Medicaid exclusion screening indicating whether the provider was found on any state exclusion list.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacScreeningPerformed rdf:type rdf:Property ;
    rdfs:label 'Ofac Screening Performed' ;
    rdfs:comment 'Indicates whether screening against the OFAC Specially Designated Nationals (SDN) list was performed.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ofacScreeningResult rdf:type rdf:Property ;
    rdfs:label 'Ofac Screening Result' ;
    rdfs:comment 'The outcome of OFAC SDN screening indicating whether the provider was found on the sanctions list.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallScreeningResult rdf:type rdf:Property ;
    rdfs:label 'Overall Screening Result' ;
    rdfs:comment 'The consolidated outcome of all sanction screenings performed, indicating the overall status of the provider.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchFound rdf:type rdf:Property ;
    rdfs:label 'Match Found' ;
    rdfs:comment 'Boolean flag indicating whether any match (definitive or potential) was found across all sanction screening sources.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchType rdf:type rdf:Property ;
    rdfs:label 'Match Type' ;
    rdfs:comment 'The type of match identified during screening (e.g., exact match, partial match, fuzzy match based on similarity algorithms).' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchDetails rdf:type rdf:Property ;
    rdfs:label 'Match Details' ;
    rdfs:comment 'Detailed description of the match found, including the specific list, entry details, and reason for exclusion.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Exclusion Effective Date' ;
    rdfs:comment 'The date on which the provider\'s exclusion from federal healthcare programs became effective.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusionEndDate rdf:type rdf:Property ;
    rdfs:label 'Exclusion End Date' ;
    rdfs:comment 'The date on which the provider\'s exclusion is scheduled to end or was lifted, if applicable.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusionWaiverCode rdf:type rdf:Property ;
    rdfs:label 'Exclusion Waiver Code' ;
    rdfs:comment 'Code indicating whether a waiver was granted for the exclusion under specific circumstances.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningStatus rdf:type rdf:Property ;
    rdfs:label 'Screening Status' ;
    rdfs:comment 'The current status of the sanction screening process (e.g., completed, in progress, pending review, failed).' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningVendor rdf:type rdf:Property ;
    rdfs:label 'Screening Vendor' ;
    rdfs:comment 'The name of the third-party vendor or service used to perform the sanction screening, if applicable.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningMethod rdf:type rdf:Property ;
    rdfs:label 'Screening Method' ;
    rdfs:comment 'The method used to perform the sanction screening (e.g., automated system, manual review, API integration).' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextScreeningDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Screening Due Date' ;
    rdfs:comment 'The date by which the next sanction screening is required to be performed for this provider.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:screeningPerformedBy rdf:type rdf:Property ;
    rdfs:label 'Screening Performed By' ;
    rdfs:comment 'The name or identifier of the individual or system that performed the sanction screening.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningReviewedBy rdf:type rdf:Property ;
    rdfs:label 'Screening Reviewed By' ;
    rdfs:comment 'The name or identifier of the credentialing specialist or reviewer who validated the screening results.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:falsePositiveReason rdf:type rdf:Property ;
    rdfs:label 'False Positive Reason' ;
    rdfs:comment 'Explanation of why a potential match was determined to be a false positive (e.g., different person with same name, different NPI).' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committeeReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Committee Review Required' ;
    rdfs:comment 'Indicates whether the screening results require review by the credentialing committee.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:committeeDecisionNotes rdf:type rdf:Property ;
    rdfs:label 'Committee Decision Notes' ;
    rdfs:comment 'Detailed notes or rationale for the credentialing committee\'s decision regarding the sanction screening results.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingActionTaken rdf:type rdf:Property ;
    rdfs:label 'Credentialing Action Taken' ;
    rdfs:comment 'The specific credentialing action taken as a result of the sanction screening findings (e.g., termination, suspension, additional monitoring).' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Action Effective Date' ;
    rdfs:comment 'The date on which the credentialing action (e.g., termination, suspension) became effective.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:screeningTransactionId rdf:type rdf:Property ;
    rdfs:label 'Screening Transaction Id' ;
    rdfs:comment 'Unique transaction identifier assigned by the screening vendor or system for tracking and audit purposes.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Transaction .

ind:screeningRequestId rdf:type rdf:Property ;
    rdfs:label 'Screening Request Id' ;
    rdfs:comment 'Unique identifier for the screening request submitted to the sanction screening system or vendor.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Request .

ind:screeningResponseCode rdf:type rdf:Property ;
    rdfs:label 'Screening Response Code' ;
    rdfs:comment 'System response code returned by the screening vendor or API indicating the status of the screening request.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningErrorMessage rdf:type rdf:Property ;
    rdfs:label 'Screening Error Message' ;
    rdfs:comment 'Error message or description returned if the sanction screening process encountered an error or failure.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Screening Expiration Date' ;
    rdfs:comment 'The date on which the current sanction screening results expire and a new screening is required.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReportReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Reference' ;
    rdfs:comment 'Reference number or identifier for the regulatory report submitted regarding the sanction screening results.' ;
    rdfs:domain ind:SanctionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committeeReviewId rdf:type rdf:Property ;
    rdfs:label 'Committee Review Id' ;
    rdfs:comment 'Unique identifier for the credentialing committee review record.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:meetingDate rdf:type rdf:Property ;
    rdfs:label 'Meeting Date' ;
    rdfs:comment 'Date on which the committee meeting was held to review the provider credentials.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Approval Expiration Date' ;
    rdfs:comment 'Date on which the provider approval expires and re-credentialing is required.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deferralReason rdf:type rdf:Property ;
    rdfs:label 'Deferral Reason' ;
    rdfs:comment 'Reason for deferring the credentialing decision to a future committee meeting.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySourceVerificationComplete rdf:type rdf:Property ;
    rdfs:label 'Primary Source Verification Complete' ;
    rdfs:comment 'Indicates whether primary source verification of credentials was completed prior to committee review.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caqhDataReviewed rdf:type rdf:Property ;
    rdfs:label 'Caqh Data Reviewed' ;
    rdfs:comment 'Indicates whether CAQH ProView data was reviewed as part of the credentialing process.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oigExclusionScreeningStatus rdf:type rdf:Property ;
    rdfs:label 'Oig Exclusion Screening Status' ;
    rdfs:comment 'Result of screening against the OIG List of Excluded Individuals and Entities.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samExclusionScreeningStatus rdf:type rdf:Property ;
    rdfs:label 'Sam Exclusion Screening Status' ;
    rdfs:comment 'Result of screening against the SAM federal exclusion database.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerReferencesReviewed rdf:type rdf:Property ;
    rdfs:label 'Peer References Reviewed' ;
    rdfs:comment 'Indicates whether peer professional references were reviewed by the committee.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalPrivilegesVerified rdf:type rdf:Property ;
    rdfs:label 'Hospital Privileges Verified' ;
    rdfs:comment 'Indicates whether hospital admitting privileges were verified.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workHistoryGapsIdentified rdf:type rdf:Property ;
    rdfs:label 'Work History Gaps Identified' ;
    rdfs:comment 'Indicates whether unexplained gaps in work history were identified during review.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workHistoryGapsExplanation rdf:type rdf:Property ;
    rdfs:label 'Work History Gaps Explanation' ;
    rdfs:comment 'Explanation provided for any gaps in the provider work history.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:malpracticeClaimsHistoryReviewed rdf:type rdf:Property ;
    rdfs:label 'Malpractice Claims History Reviewed' ;
    rdfs:comment 'Indicates whether malpractice claims history was reviewed by the committee.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adverseActionsIdentified rdf:type rdf:Property ;
    rdfs:label 'Adverse Actions Identified' ;
    rdfs:comment 'Indicates whether any adverse actions against the provider were identified during review.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adverseActionsDescription rdf:type rdf:Property ;
    rdfs:label 'Adverse Actions Description' ;
    rdfs:comment 'Description of any adverse actions identified against the provider.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityConcernsIdentified rdf:type rdf:Property ;
    rdfs:label 'Quality Concerns Identified' ;
    rdfs:comment 'Indicates whether quality of care concerns were identified during the review.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityConcernsDescription rdf:type rdf:Property ;
    rdfs:label 'Quality Concerns Description' ;
    rdfs:comment 'Description of any quality of care concerns identified.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committeeNotes rdf:type rdf:Property ;
    rdfs:label 'Committee Notes' ;
    rdfs:comment 'Detailed notes and observations recorded by the committee during the review.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quorumMet rdf:type rdf:Property ;
    rdfs:label 'Quorum Met' ;
    rdfs:comment 'Indicates whether the required quorum was present for the committee meeting.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:votingMembersPresent rdf:type rdf:Property ;
    rdfs:label 'Voting Members Present' ;
    rdfs:comment 'Number of voting committee members present at the meeting.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:votesForApproval rdf:type rdf:Property ;
    rdfs:label 'Votes For Approval' ;
    rdfs:comment 'Number of committee votes in favor of approving the provider.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:votesAgainstApproval rdf:type rdf:Property ;
    rdfs:label 'Votes Against Approval' ;
    rdfs:comment 'Number of committee votes against approving the provider.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:votesAbstained rdf:type rdf:Property ;
    rdfs:label 'Votes Abstained' ;
    rdfs:comment 'Number of committee members who abstained from voting.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appealRightsProvided rdf:type rdf:Property ;
    rdfs:label 'Appeal Rights Provided' ;
    rdfs:comment 'Indicates whether the provider was informed of appeal rights following an adverse decision.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:delegationOversightCompleted rdf:type rdf:Property ;
    rdfs:label 'Delegation Oversight Completed' ;
    rdfs:comment 'Indicates whether oversight of delegated credentialing activities was completed.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkParticipationType rdf:type rdf:Property ;
    rdfs:label 'Network Participation Type' ;
    rdfs:comment 'Type of network participation granted to the provider upon approval.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participatingLob rdf:type rdf:Property ;
    rdfs:label 'Participating Lob' ;
    rdfs:comment 'Lines of business for which the provider is approved to participate.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceLocationReviewed rdf:type rdf:Property ;
    rdfs:label 'Practice Location Reviewed' ;
    rdfs:comment 'Primary practice location address reviewed by the committee.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteVisitRequired rdf:type rdf:Property ;
    rdfs:label 'Site Visit Required' ;
    rdfs:comment 'Indicates whether an on-site practice location visit is required as a condition of approval.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceTrainingRequired rdf:type rdf:Property ;
    rdfs:label 'Compliance Training Required' ;
    rdfs:comment 'Indicates whether compliance training is required as a condition of approval.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceTrainingCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Training Completed Date' ;
    rdfs:comment 'Date on which required compliance training was completed by the provider.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialingCycle rdf:type rdf:Property ;
    rdfs:label 'Credentialing Cycle' ;
    rdfs:comment 'Credentialing cycle period identifier for tracking and reporting purposes.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewTurnaroundTimeDays rdf:type rdf:Property ;
    rdfs:label 'Review Turnaround Time Days' ;
    rdfs:comment 'Number of days from application submission to committee decision.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stateRegulatoryComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'State Regulatory Compliance Flag' ;
    rdfs:comment 'Indicates whether the review process complied with applicable state regulatory requirements.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Compliance Flag' ;
    rdfs:comment 'Indicates whether the review process complied with CMS credentialing requirements for Medicare Advantage and Medicaid plans.' ;
    rdfs:domain ind:CommitteeReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recredentialingScheduleId rdf:type rdf:Property ;
    rdfs:label 'Recredentialing Schedule Id' ;
    rdfs:comment 'Unique identifier for the re-credentialing schedule record. Primary key for the schedule entity.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecredentialingSchedule .

ind:providerTypeCode rdf:type rdf:Property ;
    rdfs:label 'Provider Type Code' ;
    rdfs:comment 'Standardized code identifying the type of healthcare provider subject to this re-credentialing schedule (e.g., MD, DO, NP, PA, DDS, LCSW, PT, OT).' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerTypeDescription rdf:type rdf:Property ;
    rdfs:label 'Provider Type Description' ;
    rdfs:comment 'Human-readable description of the provider type (e.g., Physician, Nurse Practitioner, Physical Therapist, Dentist).' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recredentialingIntervalMonths rdf:type rdf:Property ;
    rdfs:label 'Recredentialing Interval Months' ;
    rdfs:comment 'Standard interval in months between re-credentialing cycles for this provider type. NCQA requires re-credentialing at least every 36 months.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recredentialingFrequencyDescription rdf:type rdf:Property ;
    rdfs:label 'Recredentialing Frequency Description' ;
    rdfs:comment 'Human-readable description of the re-credentialing frequency (e.g., annual, biennial, triennial).' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerType rdf:type rdf:Property ;
    rdfs:label 'Trigger Type' ;
    rdfs:comment 'Classification of what initiates the re-credentialing process: time-based (scheduled interval), event-based (specific occurrence), risk-based (quality concerns), regulatory mandate, or hybrid approach.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:advanceNotificationDays rdf:type rdf:Property ;
    rdfs:label 'Advance Notification Days' ;
    rdfs:comment 'Number of days before the re-credentialing due date that the provider should be notified to begin the process.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:licenseVerificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'License Verification Required Flag' ;
    rdfs:comment 'Indicates whether state medical license verification is required as part of this re-credentialing schedule.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:boardCertificationVerificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Board Certification Verification Required Flag' ;
    rdfs:comment 'Indicates whether board certification status must be verified during re-credentialing for this provider type.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deaVerificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Dea Verification Required Flag' ;
    rdfs:comment 'Indicates whether DEA registration verification is required for providers who prescribe controlled substances.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:malpracticeInsuranceVerificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Malpractice Insurance Verification Required Flag' ;
    rdfs:comment 'Indicates whether professional liability (malpractice) insurance coverage must be verified during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:malpracticeInsuranceMinimumCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Malpractice Insurance Minimum Coverage Amount' ;
    rdfs:comment 'Minimum required professional liability insurance coverage amount per occurrence for this provider type.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:malpracticeInsuranceAggregateMinimumAmount rdf:type rdf:Property ;
    rdfs:label 'Malpractice Insurance Aggregate Minimum Amount' ;
    rdfs:comment 'Minimum required aggregate professional liability insurance coverage amount for this provider type.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workHistoryVerificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Work History Verification Required Flag' ;
    rdfs:comment 'Indicates whether employment and work history verification is required during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workHistoryLookbackYears rdf:type rdf:Property ;
    rdfs:label 'Work History Lookback Years' ;
    rdfs:comment 'Number of years of work history that must be verified during re-credentialing (typically 5 years per NCQA).' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:educationVerificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Education Verification Required Flag' ;
    rdfs:comment 'Indicates whether medical education and training credentials must be re-verified during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caqhDataIntegrationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Caqh Data Integration Required Flag' ;
    rdfs:comment 'Indicates whether CAQH ProView data should be integrated as part of the re-credentialing process to streamline credential verification.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oigSanctionsScreeningRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Oig Sanctions Screening Required Flag' ;
    rdfs:comment 'Indicates whether screening against the OIG List of Excluded Individuals and Entities (LEIE) is required during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:samSanctionsScreeningRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Sam Sanctions Screening Required Flag' ;
    rdfs:comment 'Indicates whether screening against the federal SAM exclusion database is required during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateMedicaidExclusionScreeningRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'State Medicaid Exclusion Screening Required Flag' ;
    rdfs:comment 'Indicates whether screening against state Medicaid exclusion lists is required during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalPrivilegesVerificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Hospital Privileges Verification Required Flag' ;
    rdfs:comment 'Indicates whether current hospital admitting privileges must be verified during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerReferenceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Peer Reference Required Flag' ;
    rdfs:comment 'Indicates whether peer professional references must be obtained during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerReferenceMinimumCount rdf:type rdf:Property ;
    rdfs:label 'Peer Reference Minimum Count' ;
    rdfs:comment 'Minimum number of peer professional references required during re-credentialing (typically 2-3).' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:credentialingCommitteeReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Credentialing Committee Review Required Flag' ;
    rdfs:comment 'Indicates whether the re-credentialing application must be reviewed and approved by the credentialing committee.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityPerformanceReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Performance Review Required Flag' ;
    rdfs:comment 'Indicates whether provider quality and performance metrics must be reviewed during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMetricsLookbackMonths rdf:type rdf:Property ;
    rdfs:label 'Quality Metrics Lookback Months' ;
    rdfs:comment 'Number of months of quality and performance data to review during re-credentialing (e.g., 12, 24, or 36 months).' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberComplaintsReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Member Complaints Review Required Flag' ;
    rdfs:comment 'Indicates whether member complaints and grievances against the provider must be reviewed during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:continuingEducationVerificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Verification Required Flag' ;
    rdfs:comment 'Indicates whether continuing medical education credits must be verified during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:continuingEducationMinimumHours rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Minimum Hours' ;
    rdfs:comment 'Minimum number of continuing education hours required for re-credentialing for this provider type.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:physicalHealthAssessmentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Physical Health Assessment Required Flag' ;
    rdfs:comment 'Indicates whether a physical health assessment or certification of ability to perform clinical duties is required during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mentalHealthAssessmentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Mental Health Assessment Required Flag' ;
    rdfs:comment 'Indicates whether a mental health or behavioral health assessment is required during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:immunizationRecordsRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Immunization Records Required Flag' ;
    rdfs:comment 'Indicates whether proof of required immunizations must be provided during re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:culturalCompetencyTrainingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Cultural Competency Training Required Flag' ;
    rdfs:comment 'Indicates whether completion of cultural competency training is required for re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaTrainingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Training Required Flag' ;
    rdfs:comment 'Indicates whether completion of HIPAA privacy and security training is required for re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudWasteAbuseTrainingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Waste Abuse Training Required Flag' ;
    rdfs:comment 'Indicates whether completion of fraud, waste, and abuse prevention training is required for re-credentialing.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telemedicineCredentialingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Telemedicine Credentialing Required Flag' ;
    rdfs:comment 'Indicates whether specific telemedicine or telehealth credentialing requirements apply to this provider type.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:credentialingByProxyEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Credentialing By Proxy Eligible Flag' ;
    rdfs:comment 'Indicates whether this provider type is eligible for credentialing by proxy, where credentials verified by another accredited organization may be accepted.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expeditedRecredentialingEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Expedited Recredentialing Eligible Flag' ;
    rdfs:comment 'Indicates whether this provider type is eligible for expedited re-credentialing process based on clean history and performance.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkTierApplicability rdf:type rdf:Property ;
    rdfs:label 'Network Tier Applicability' ;
    rdfs:comment 'Network tier or product type to which this schedule applies (e.g., HMO, PPO, EPO, POS, Narrow Network, Tiered Network).' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Policy Reference Number' ;
    rdfs:comment 'Reference number of the organizational policy or procedure document that governs this re-credentialing schedule.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncqaStandardReference rdf:type rdf:Property ;
    rdfs:label 'Ncqa Standard Reference' ;
    rdfs:comment 'Specific NCQA credentialing standard or element that this schedule is designed to satisfy (e.g., CR Element A, CR Element B).' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateRegulatoryRequirement rdf:type rdf:Property ;
    rdfs:label 'State Regulatory Requirement' ;
    rdfs:comment 'Description of any state-specific regulatory requirements that influence this re-credentialing schedule.' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsRequirementReference rdf:type rdf:Property ;
    rdfs:label 'Cms Requirement Reference' ;
    rdfs:comment 'Reference to specific CMS requirements or guidance that apply to this re-credentialing schedule (e.g., Medicare Advantage requirements).' ;
    rdfs:domain ind:RecredentialingSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationCriteria rdf:type rdf:Property ;
    rdfs:label 'Escalation Criteria' ;
    rdfs:comment 'Description of circumstances that would trigger escalated or enhanced re-credentialing review (e.g., quality concerns, sanctions, malpractice claims).' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentTypeId rdf:type rdf:Property ;
    rdfs:label 'Document Type Id' ;
    rdfs:comment 'Unique identifier for the document type used in provider credentialing and re-credentialing processes.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DocumentType .

ind:isRequired rdf:type rdf:Property ;
    rdfs:label 'Is Required' ;
    rdfs:comment 'Indicates whether this document type is mandatory for credentialing application completion and approval.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimarySourceVerified rdf:type rdf:Property ;
    rdfs:label 'Is Primary Source Verified' ;
    rdfs:comment 'Indicates whether this document type requires primary source verification as part of the credentialing process per NCQA standards.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:validityPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Validity Period Months' ;
    rdfs:comment 'Standard validity period for this document type in months before renewal or re-verification is required. Null if document does not expire.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recredentialingRequired rdf:type rdf:Property ;
    rdfs:label 'Recredentialing Required' ;
    rdfs:comment 'Indicates whether this document type must be re-verified during the re-credentialing cycle (typically every 3 years per NCQA).' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acceptableFileFormats rdf:type rdf:Property ;
    rdfs:label 'Acceptable File Formats' ;
    rdfs:comment 'Comma-separated list of acceptable file formats for document submission (e.g., PDF, JPG, PNG, TIFF).' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxFileSizeMb rdf:type rdf:Property ;
    rdfs:label 'Max File Size Mb' ;
    rdfs:comment 'Maximum allowable file size in megabytes for document upload to ensure system performance and storage management.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:credentialingCommitteeReview rdf:type rdf:Property ;
    rdfs:label 'Credentialing Committee Review' ;
    rdfs:comment 'Indicates whether this document type requires review and approval by the credentialing committee as part of the credentialing decision process.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:npiValidationRequired rdf:type rdf:Property ;
    rdfs:label 'Npi Validation Required' ;
    rdfs:comment 'Indicates whether the document must contain or be validated against the provider\'s NPI number.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expirationTrackingRequired rdf:type rdf:Property ;
    rdfs:label 'Expiration Tracking Required' ;
    rdfs:comment 'Indicates whether the system must track expiration dates for this document type and generate renewal alerts.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expirationAlertDays rdf:type rdf:Property ;
    rdfs:label 'Expiration Alert Days' ;
    rdfs:comment 'Number of days before document expiration when the system should generate alerts to providers and credentialing staff. Null if expiration tracking is not required.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoSuspensionOnExpiration rdf:type rdf:Property ;
    rdfs:label 'Auto Suspension On Expiration' ;
    rdfs:comment 'Indicates whether provider privileges should be automatically suspended if this document type expires without renewal.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageAmountCurrency rdf:type rdf:Property ;
    rdfs:label 'Coverage Amount Currency' ;
    rdfs:comment 'Currency code for the minimum coverage amount. Defaults to USD for United States operations.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestationStatementRequired rdf:type rdf:Property ;
    rdfs:label 'Attestation Statement Required' ;
    rdfs:comment 'Indicates whether the provider must sign an attestation statement confirming the accuracy and completeness of this document type.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attestationStatementText rdf:type rdf:Property ;
    rdfs:label 'Attestation Statement Text' ;
    rdfs:comment 'Standard attestation statement text that the provider must acknowledge when submitting this document type. Null if attestation is not required.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureRequired rdf:type rdf:Property ;
    rdfs:label 'Disclosure Required' ;
    rdfs:comment 'Indicates whether this document type requires disclosure of specific information (e.g., malpractice history, sanctions, criminal background).' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:npdbQueryRequired rdf:type rdf:Property ;
    rdfs:label 'Npdb Query Required' ;
    rdfs:comment 'Indicates whether submission or verification of this document type requires a query to the National Practitioner Data Bank.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportingDocumentsRequired rdf:type rdf:Property ;
    rdfs:label 'Supporting Documents Required' ;
    rdfs:comment 'Indicates whether this document type requires additional supporting documentation for verification (e.g., explanation letters for gaps in employment).' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportingDocumentTypes rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Types' ;
    rdfs:comment 'Comma-separated list of document type codes that may be required as supporting documentation. Null if no supporting documents are required.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionControlRequired rdf:type rdf:Property ;
    rdfs:label 'Version Control Required' ;
    rdfs:comment 'Indicates whether the system must maintain version history for this document type to track updates and changes over time.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phiContained rdf:type rdf:Property ;
    rdfs:label 'Phi Contained' ;
    rdfs:comment 'Indicates whether this document type typically contains Protected Health Information requiring HIPAA privacy and security controls.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:piiContained rdf:type rdf:Property ;
    rdfs:label 'Pii Contained' ;
    rdfs:comment 'Indicates whether this document type typically contains Personally Identifiable Information requiring data protection controls.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accessRestrictionLevel rdf:type rdf:Property ;
    rdfs:label 'Access Restriction Level' ;
    rdfs:comment 'Classification level determining who can access this document type within the organization (public, internal, confidential, restricted).' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowStageApplicability rdf:type rdf:Property ;
    rdfs:label 'Workflow Stage Applicability' ;
    rdfs:comment 'Comma-separated list of credentialing workflow stages where this document type is required (e.g., Initial Application, Re-credentialing, Interim Update, Privilege Request).' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegatedEntityApplicable rdf:type rdf:Property ;
    rdfs:label 'Delegated Entity Applicable' ;
    rdfs:comment 'Indicates whether this document type requirement applies to providers credentialed through delegated credentialing arrangements.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsRequirement rdf:type rdf:Property ;
    rdfs:label 'Cms Requirement' ;
    rdfs:comment 'Indicates whether this document type is specifically required by CMS regulations for Medicare Advantage or Medicaid managed care participation.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ncqaRequirement rdf:type rdf:Property ;
    rdfs:label 'Ncqa Requirement' ;
    rdfs:comment 'Indicates whether this document type is specifically required by NCQA accreditation standards for health plan credentialing.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uracRequirement rdf:type rdf:Property ;
    rdfs:label 'Urac Requirement' ;
    rdfs:comment 'Indicates whether this document type is specifically required by URAC accreditation standards.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jointCommissionRequirement rdf:type rdf:Property ;
    rdfs:label 'Joint Commission Requirement' ;
    rdfs:comment 'Indicates whether this document type is specifically required by Joint Commission accreditation standards for healthcare organizations.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:validationRules rdf:type rdf:Property ;
    rdfs:label 'Validation Rules' ;
    rdfs:comment 'JSON or structured text describing automated validation rules applied to this document type (e.g., date range checks, required fields, format validation).' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasons rdf:type rdf:Property ;
    rdfs:label 'Rejection Reasons' ;
    rdfs:comment 'Comma-separated list of common reasons why this document type is rejected during credentialing review (e.g., expired, illegible, incomplete, not certified copy).' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaCritical rdf:type rdf:Property ;
    rdfs:label 'Sla Critical' ;
    rdfs:comment 'Indicates whether this document type is critical to meeting credentialing SLA commitments and requires priority processing.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costPerVerification rdf:type rdf:Property ;
    rdfs:label 'Cost Per Verification' ;
    rdfs:comment 'Average cost in USD for verifying this document type, including third-party verification service fees, staff time, and system costs.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thirdPartyVendor rdf:type rdf:Property ;
    rdfs:label 'Third Party Vendor' ;
    rdfs:comment 'Name of the third-party vendor or service used for verification of this document type (e.g., CAQH, AMS, ECFMG). Null if verified internally.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementDocumentTypeId rdf:type rdf:Property ;
    rdfs:label 'Replacement Document Type Id' ;
    rdfs:comment 'Identifier of the document type that replaces this one if deprecated or superseded. Null if no replacement exists.' ;
    rdfs:domain ind:DocumentType ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Type .

ind:credentialingApplicationId rdf:type rdf:Property ;
    rdfs:label 'Credentialing Application Id' ;
    rdfs:comment 'Identifier linking this document submission to the parent credentialing or re-credentialing application.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CredentialingApplication .

ind:documentName rdf:type rdf:Property ;
    rdfs:label 'Document Name' ;
    rdfs:comment 'Descriptive name or title of the submitted document.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentDescription rdf:type rdf:Property ;
    rdfs:label 'Document Description' ;
    rdfs:comment 'Detailed description of the document contents and purpose.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentStatus rdf:type rdf:Property ;
    rdfs:label 'Document Status' ;
    rdfs:comment 'Current processing status of the submitted document in the credentialing workflow.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySourceVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Source Verified Flag' ;
    rdfs:comment 'Indicates whether the document has been verified directly with the issuing organization (primary source verification).' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fileStorageLocation rdf:type rdf:Property ;
    rdfs:label 'File Storage Location' ;
    rdfs:comment 'Path or URI indicating where the document file is stored in the document management system.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentNumber rdf:type rdf:Property ;
    rdfs:label 'Document Number' ;
    rdfs:comment 'Official number or identifier on the document itself (e.g., license number, certificate number, policy number).' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingOrganization rdf:type rdf:Property ;
    rdfs:label 'Issuing Organization' ;
    rdfs:comment 'Name of the organization or authority that issued the document (e.g., state medical board, specialty board, insurance carrier).' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expirationAlertSentFlag rdf:type rdf:Property ;
    rdfs:label 'Expiration Alert Sent Flag' ;
    rdfs:comment 'Indicates whether an expiration alert notification has been sent to the provider.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:daysUntilExpiration rdf:type rdf:Property ;
    rdfs:label 'Days Until Expiration' ;
    rdfs:comment 'Number of days remaining until the document expires.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isExpiredFlag rdf:type rdf:Property ;
    rdfs:label 'Is Expired Flag' ;
    rdfs:comment 'Indicates whether the document has passed its expiration date.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:boardName rdf:type rdf:Property ;
    rdfs:label 'Board Name' ;
    rdfs:comment 'Name of the medical board or certifying body for board certification documents.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseStatus rdf:type rdf:Property ;
    rdfs:label 'License Status' ;
    rdfs:comment 'Current status of the professional license as reported by the licensing board.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oigScreeningDate rdf:type rdf:Property ;
    rdfs:label 'Oig Screening Date' ;
    rdfs:comment 'Date when the provider was screened against the OIG exclusion list.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:samScreeningDate rdf:type rdf:Property ;
    rdfs:label 'Sam Screening Date' ;
    rdfs:comment 'Date when the provider was screened against the SAM exclusion database.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resubmissionDueDate rdf:type rdf:Property ;
    rdfs:label 'Resubmission Due Date' ;
    rdfs:comment 'Date by which the document must be resubmitted.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:previousSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Previous Submission Id' ;
    rdfs:comment 'Identifier of the previous submission if this is a resubmission or replacement document.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DocumentSubmission .

ind:attestationSignature rdf:type rdf:Property ;
    rdfs:label 'Attestation Signature' ;
    rdfs:comment 'Electronic or digital signature of the provider attesting to the document.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentVersion rdf:type rdf:Property ;
    rdfs:label 'Document Version' ;
    rdfs:comment 'Version number of the document if multiple versions have been submitted.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededBySubmissionId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Submission Id' ;
    rdfs:comment 'Identifier of the submission that supersedes this document.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DocumentSubmission .

ind:accessControlLevel rdf:type rdf:Property ;
    rdfs:label 'Access Control Level' ;
    rdfs:comment 'Level of access control applied to this document.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAccessedBy rdf:type rdf:Property ;
    rdfs:label 'Last Accessed By' ;
    rdfs:comment 'Identifier of the user who last accessed the document.' ;
    rdfs:domain ind:DocumentSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingDecisionId rdf:type rdf:Property ;
    rdfs:label 'Credentialing Decision Id' ;
    rdfs:comment 'Unique identifier for the credentialing decision record. Primary key for the credentialing decision entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
