    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Date' ;
    rdfs:comment 'Date when the broker was formally appointed to sell the healthcare organizations insurance products.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentStatus rdf:type rdf:Property ;
    rdfs:label 'Appointment Status' ;
    rdfs:comment 'Status indicating whether the broker is formally appointed to represent the healthcare organizations insurance products.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckDate rdf:type rdf:Property ;
    rdfs:label 'Background Check Date' ;
    rdfs:comment 'Date when the most recent background check was completed for the broker.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:backgroundCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Background Check Status' ;
    rdfs:comment 'Status of the background check conducted on the broker for compliance and risk management purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerStatus rdf:type rdf:Property ;
    rdfs:label 'Broker Status' ;
    rdfs:comment 'Current operational status of the broker within the healthcare organizations network.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerType rdf:type rdf:Property ;
    rdfs:label 'Broker Type' ;
    rdfs:comment 'Classification of the broker entity based on organizational structure and business model.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Commission Rate Percentage' ;
    rdfs:comment 'Standard commission rate percentage paid to the broker for new business sales.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceTrainingCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Training Completion Date' ;
    rdfs:comment 'Date when the broker completed required compliance and regulatory training programs.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doingBusinessAsName rdf:type rdf:Property ;
    rdfs:label 'Doing Business As Name' ;
    rdfs:comment 'Trade name or fictitious business name under which the broker operates, if different from legal name.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorsAndOmissionsCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Errors And Omissions Coverage Amount' ;
    rdfs:comment 'Total coverage amount in US dollars for the brokers errors and omissions liability insurance policy.' ;
    rdfs:domain ind:Broker ;
