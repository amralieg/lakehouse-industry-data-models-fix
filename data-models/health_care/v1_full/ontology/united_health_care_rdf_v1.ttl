ind:memberConsentRequired rdf:type rdf:Property ;
    rdfs:label 'Member Consent Required' ;
    rdfs:comment 'Indicates whether explicit member consent is required before delivering this intervention type. Used for compliance with privacy and consent regulations.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phiDisclosureLevel rdf:type rdf:Property ;
    rdfs:label 'Phi Disclosure Level' ;
    rdfs:comment 'Indicates the level of PHI that may be disclosed or discussed during delivery of this intervention type. Used for HIPAA compliance and privacy protection.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcomeMeasure rdf:type rdf:Property ;
    rdfs:label 'Outcome Measure' ;
    rdfs:comment 'Primary outcome measure or metric used to evaluate the effectiveness of this intervention type. May include clinical, functional, or satisfaction measures.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationPathway rdf:type rdf:Property ;
    rdfs:label 'Escalation Pathway' ;
    rdfs:comment 'Describes the escalation pathway or next-level intervention if this intervention type is unsuccessful or member needs intensify. Supports care progression planning.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowTrigger rdf:type rdf:Property ;
    rdfs:label 'Workflow Trigger' ;
    rdfs:comment 'Describes the condition, event, or criteria that triggers assignment of this intervention type to a member. May include risk scores, diagnoses, or utilization patterns.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:automatedOutreachEnabled rdf:type rdf:Property ;
    rdfs:label 'Automated Outreach Enabled' ;
    rdfs:comment 'Indicates whether this intervention type can be delivered through automated outreach channels such as IVR, email campaigns, or mobile app notifications.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sdohDomain rdf:type rdf:Property ;
    rdfs:label 'Sdoh Domain' ;
    rdfs:comment 'Identifies the primary social determinant of health domain that this intervention type addresses. Used for population health and health equity programs.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communityResourceLinkage rdf:type rdf:Property ;
    rdfs:label 'Community Resource Linkage' ;
    rdfs:comment 'Indicates whether this intervention type involves connecting members to community-based resources or social services. Supports whole-person care approaches.' ;
    rdfs:domain ind:InterventionType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerSupportComponent rdf:type rdf:Property ;
