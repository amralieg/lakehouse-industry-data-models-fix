ind:escalationThresholdSeconds rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold Seconds' ;
    rdfs:comment 'Wait time in seconds after which interactions are automatically escalated to supervisor or specialized queues.' ;
    rdfs:domain ind:Queue ;
