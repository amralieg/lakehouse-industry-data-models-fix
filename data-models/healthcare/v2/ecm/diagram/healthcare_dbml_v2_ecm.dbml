  malpractice_expiration_date decimal(9,4) [note: 'Malpractice insurance expiration date.']
  malpractice_policy_number varchar [note: 'Malpractice insurance policy number.']
  medicaid_enrolled boolean [note: 'Medicaid enrollment status.']
  medical_degree varchar [note: 'Medical degree type (MD, DO, MBBS, etc.).']
  medical_school_graduation_date date [note: 'Medical school graduation date.']
  medical_school_name varchar [note: 'Medical school attended.']
  medicare_enrolled boolean [note: 'Medicare enrollment status.']
  middle_name varchar [note: 'Middle name or initial.']
  name_suffix varchar [note: 'Name suffix (Jr, Sr, III, etc.).']
  npi varchar [note: 'Npi for clinician.']
  oig_exclusion_check_date date [note: 'Date of OIG exclusion screening.']
  oig_exclusion_checked boolean [note: 'OIG exclusion screening completed.']
  payer_enrollment_status varchar [note: 'Payer enrollment status.']
  primary_source_verified boolean [note: 'Primary source verification completed.']
  professional_designation varchar [note: 'Professional designation (MD, DO, NP, PA, RN, etc.).']
  residency_acgme_accredited boolean [note: 'ACGME accreditation status of residency.']
  residency_completion_date date [note: 'Residency completion date.']
  residency_program_name varchar [note: 'Residency program name.']
  secondary_specialty varchar [note: 'Secondary clinical specialty.']
  state_license_number varchar [note: 'State medical license number.']
  termination_date date [note: 'Date of termination.']
  updated_timestamp timestamp [note: 'Record last update timestamp.']
  vibe_added_flag boolean [note: 'Added by VIBE mutator to ensure product is touched.']
  work_email varchar [note: 'Work email address.']
  work_phone varchar [note: 'Work phone number.']

  Note: 'Individual healthcare provider (physician, NP, PA, etc.) with credentialing, licensure, and employment details.'
}

