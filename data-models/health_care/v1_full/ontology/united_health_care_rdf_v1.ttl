ind:filingCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Filing Currency Code' ;
    rdfs:comment 'Three-letter ISO currency code for the currency in which the return is filed (e.g., USD).' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingScheduleCount rdf:type rdf:Property ;
    rdfs:label 'Supporting Schedule Count' ;
    rdfs:comment 'Number of supporting schedules and attachments filed with the tax return.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentRetentionDate rdf:type rdf:Property ;
    rdfs:label 'Document Retention Date' ;
    rdfs:comment 'Date until which tax return documentation must be retained per regulatory and internal policy requirements.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mlrCalculationId rdf:type rdf:Property ;
    rdfs:label 'Mlr Calculation Id' ;
    rdfs:comment 'Unique identifier for the MLR calculation record.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:marketType rdf:type rdf:Property ;
    rdfs:label 'Market Type' ;
    rdfs:comment 'The market classification for the insurance products included in this MLR calculation.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalEarnedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Total Earned Premium Amount' ;
    rdfs:comment 'The total premium revenue earned during the calculation period, including member premiums and employer contributions.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:federalAndStateTaxesAmount rdf:type rdf:Property ;
    rdfs:label 'Federal And State Taxes Amount' ;
    rdfs:comment 'The amount of federal and state taxes and licensing or regulatory fees paid during the calculation period, excluded from earned premium for MLR calculation.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustedEarnedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Adjusted Earned Premium Amount' ;
    rdfs:comment 'The earned premium after deducting federal and state taxes, used as the denominator in the MLR calculation.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incurredClaimsAmount rdf:type rdf:Property ;
    rdfs:label 'Incurred Claims Amount' ;
    rdfs:comment 'The total amount of medical claims incurred during the calculation period, including paid claims and changes in claim reserves.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidClaimsAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Claims Amount' ;
    rdfs:comment 'The total amount of medical claims paid during the calculation period.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimReservesBeginningBalance rdf:type rdf:Property ;
    rdfs:label 'Claim Reserves Beginning Balance' ;
    rdfs:comment 'The claim reserves balance at the beginning of the calculation period, used to calculate incurred claims.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimReservesEndingBalance rdf:type rdf:Property ;
    rdfs:label 'Claim Reserves Ending Balance' ;
    rdfs:comment 'The claim reserves balance at the end of the calculation period, used to calculate incurred claims.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityImprovementExpensesAmount rdf:type rdf:Property ;
    rdfs:label 'Quality Improvement Expenses Amount' ;
    rdfs:comment 'The amount spent on activities that improve health care quality, which can be included in the MLR numerator.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fraudReductionExpensesAmount rdf:type rdf:Property ;
    rdfs:label 'Fraud Reduction Expenses Amount' ;
    rdfs:comment 'The amount spent on fraud, waste, and abuse detection and prevention activities that qualify for MLR numerator inclusion.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:careCoordinationExpensesAmount rdf:type rdf:Property ;
    rdfs:label 'Care Coordination Expenses Amount' ;
    rdfs:comment 'The amount spent on care coordination and management programs that qualify as quality improvement activities.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalQualityImprovementAmount rdf:type rdf:Property ;
    rdfs:label 'Total Quality Improvement Amount' ;
    rdfs:comment 'The total amount of quality improvement expenses that can be added to the MLR numerator, subject to regulatory caps.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mlrNumeratorAmount rdf:type rdf:Property ;
    rdfs:label 'Mlr Numerator Amount' ;
    rdfs:comment 'The sum of incurred claims and allowable quality improvement expenses, used as the numerator in the MLR calculation.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mlrThresholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Mlr Threshold Percentage' ;
    rdfs:comment 'The minimum MLR percentage required by regulation for this line of business and market (typically 80% or 85%).' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mlrShortfallPercentage rdf:type rdf:Property ;
    rdfs:label 'Mlr Shortfall Percentage' ;
    rdfs:comment 'The percentage by which the calculated MLR falls short of the regulatory threshold, if applicable.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:credibilityAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Credibility Adjustment Factor' ;
    rdfs:comment 'The credibility factor applied to the MLR calculation based on the number of member months, as defined by CMS regulations.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:credibilityAdjustedMlrPercentage rdf:type rdf:Property ;
    rdfs:label 'Credibility Adjusted Mlr Percentage' ;
    rdfs:comment 'The MLR percentage after applying the credibility adjustment for small sample sizes.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskCorridorAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Risk Corridor Adjustment Amount' ;
    rdfs:comment 'The adjustment amount related to the ACA risk corridor program, if applicable to the calculation period.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceRecoveriesAmount rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recoveries Amount' ;
    rdfs:comment 'The amount recovered from reinsurance arrangements during the calculation period, which reduces net incurred claims.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:administrativeExpensesAmount rdf:type rdf:Property ;
    rdfs:label 'Administrative Expenses Amount' ;
    rdfs:comment 'The total administrative expenses incurred during the calculation period, used to assess compliance with MLR requirements.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:profitMarginAmount rdf:type rdf:Property ;
    rdfs:label 'Profit Margin Amount' ;
    rdfs:comment 'The profit or loss amount for the calculation period, derived from premium revenue minus claims, quality improvement, and administrative expenses.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculationStatus rdf:type rdf:Property ;
    rdfs:label 'Calculation Status' ;
    rdfs:comment 'The current status of the MLR calculation in the regulatory reporting workflow.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuerHiosCode rdf:type rdf:Property ;
    rdfs:label 'Issuer Hios Code' ;
    rdfs:comment 'The five-digit HIOS issuer identifier assigned by CMS for the insurance carrier.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:experiencePeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Experience Period Months' ;
    rdfs:comment 'The number of months of experience included in the MLR calculation period.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isGrandfatheredPlan rdf:type rdf:Property ;
    rdfs:label 'Is Grandfathered Plan' ;
    rdfs:comment 'Indicates whether the plans included in this MLR calculation are grandfathered under ACA provisions.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStudentHealthPlan rdf:type rdf:Property ;
    rdfs:label 'Is Student Health Plan' ;
    rdfs:comment 'Indicates whether this MLR calculation applies to student health insurance coverage.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMiniMedPlan rdf:type rdf:Property ;
    rdfs:label 'Is Mini Med Plan' ;
    rdfs:comment 'Indicates whether the plans included are limited benefit or mini-med plans subject to different MLR thresholds.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isExpatriatePlan rdf:type rdf:Property ;
    rdfs:label 'Is Expatriate Plan' ;
    rdfs:comment 'Indicates whether this MLR calculation applies to expatriate health plans.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rebateDistributionMethod rdf:type rdf:Property ;
    rdfs:label 'Rebate Distribution Method' ;
    rdfs:comment 'The method by which MLR rebates will be distributed to policyholders or subscribers.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebatePaymentDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Rebate Payment Deadline Date' ;
    rdfs:comment 'The regulatory deadline by which MLR rebates must be paid to policyholders (typically September 30).' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attestationOfficerName rdf:type rdf:Property ;
    rdfs:label 'Attestation Officer Name' ;
    rdfs:comment 'The name of the company officer who attested to the accuracy of the MLR calculation and filing.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestationOfficerTitle rdf:type rdf:Property ;
    rdfs:label 'Attestation Officer Title' ;
    rdfs:comment 'The title of the company officer who attested to the MLR calculation.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalAuditFirmName rdf:type rdf:Property ;
    rdfs:label 'External Audit Firm Name' ;
    rdfs:comment 'The name of the independent auditing firm that reviewed the MLR calculation, if applicable.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentDate rdf:type rdf:Property ;
    rdfs:label 'Amendment Date' ;
    rdfs:comment 'The date on which an amended MLR calculation was submitted to regulatory authorities.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calculationMethodologyVersion rdf:type rdf:Property ;
    rdfs:label 'Calculation Methodology Version' ;
    rdfs:comment 'The version identifier of the MLR calculation methodology and business rules applied.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialCertificationRequired rdf:type rdf:Property ;
    rdfs:label 'Actuarial Certification Required' ;
    rdfs:comment 'Indicates whether actuarial certification is required for this MLR calculation based on regulatory requirements.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:actuaryCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Actuary Certification Date' ;
    rdfs:comment 'The date on which the actuary certified the MLR calculation.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calculationRunTimestamp rdf:type rdf:Property ;
    rdfs:label 'Calculation Run Timestamp' ;
    rdfs:comment 'The timestamp when the MLR calculation was executed in the system.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:calculationEngineVersion rdf:type rdf:Property ;
    rdfs:label 'Calculation Engine Version' ;
    rdfs:comment 'The version of the calculation engine or software used to compute the MLR.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFinalCalculation rdf:type rdf:Property ;
    rdfs:label 'Is Final Calculation' ;
    rdfs:comment 'Indicates whether this is the final MLR calculation for the reporting period or a preliminary/draft calculation.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorYearCarryforwardAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Year Carryforward Amount' ;
    rdfs:comment 'The amount of MLR deficit or surplus carried forward from the prior reporting year, if applicable.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pharmacyClaimsAmount rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Claims Amount' ;
    rdfs:comment 'The portion of incurred claims attributable to pharmacy benefits during the calculation period.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicalClaimsAmount rdf:type rdf:Property ;
    rdfs:label 'Medical Claims Amount' ;
    rdfs:comment 'The portion of incurred claims attributable to medical services (excluding pharmacy) during the calculation period.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitationPaymentsAmount rdf:type rdf:Property ;
    rdfs:label 'Capitation Payments Amount' ;
    rdfs:comment 'The total amount of capitation payments made to providers during the calculation period, included in incurred claims.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incentivePaymentsAmount rdf:type rdf:Property ;
    rdfs:label 'Incentive Payments Amount' ;
    rdfs:comment 'The amount of quality-based or performance-based incentive payments made to providers, included in incurred claims.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subrogationRecoveriesAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Recoveries Amount' ;
    rdfs:comment 'The amount recovered through subrogation during the calculation period, which reduces net incurred claims.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coordinationOfBenefitsRecoveriesAmount rdf:type rdf:Property ;
    rdfs:label 'Coordination Of Benefits Recoveries Amount' ;
    rdfs:comment 'The amount recovered through coordination of benefits with other insurers, which reduces net incurred claims.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prescriptionDrugRebatesAmount rdf:type rdf:Property ;
    rdfs:label 'Prescription Drug Rebates Amount' ;
    rdfs:comment 'The amount of manufacturer rebates received for prescription drugs, which reduces net pharmacy claims.' ;
    rdfs:domain ind:MlrCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actuarialReserveId rdf:type rdf:Property ;
    rdfs:label 'Actuarial Reserve Id' ;
    rdfs:comment 'Unique identifier for the actuarial reserve record. Primary key for the actuarial reserve entity.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reserveAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Amount' ;
    rdfs:comment 'The monetary value of the actuarial reserve set aside for future claim payments and obligations, expressed in the reporting currency.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Reserve Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code indicating the currency in which the reserve amount is denominated.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationDate rdf:type rdf:Property ;
    rdfs:label 'Valuation Date' ;
    rdfs:comment 'The date as of which the actuarial reserve was calculated and valued, typically the end of an accounting period.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reserveStatus rdf:type rdf:Property ;
    rdfs:label 'Reserve Status' ;
    rdfs:comment 'Current lifecycle status of the actuarial reserve calculation indicating whether it is draft, preliminary, finalized, approved, or has been adjusted or superseded.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:developmentPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Development Period Months' ;
    rdfs:comment 'The number of months of claims development history used in the reserve calculation, representing the maturity period for claims runout analysis.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:confidenceLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Confidence Level Percent' ;
    rdfs:comment 'The statistical confidence level (as a percentage) associated with the reserve estimate, indicating the probability that actual claims will not exceed the reserve amount.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedPayoutDate rdf:type rdf:Property ;
    rdfs:label 'Expected Payout Date' ;
    rdfs:comment 'The anticipated date by which the reserved funds are expected to be paid out for claims settlement.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ibnrAmount rdf:type rdf:Property ;
    rdfs:label 'Ibnr Amount' ;
    rdfs:comment 'The estimated amount of claims that have been incurred but not yet reported to the insurer as of the valuation date.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossAdjustmentExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Loss Adjustment Expense Amount' ;
    rdfs:comment 'The estimated or actual costs associated with investigating, defending, and settling claims, including both allocated and unallocated loss adjustment expenses.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountRatePercent rdf:type rdf:Property ;
    rdfs:label 'Discount Rate Percent' ;
    rdfs:comment 'The discount rate applied to future claim payments to calculate the present value of the reserve, if discounting is used.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskMarginAmount rdf:type rdf:Property ;
    rdfs:label 'Risk Margin Amount' ;
    rdfs:comment 'An additional amount added to the best estimate reserve to account for uncertainty and variability in the reserve calculation.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorPeriodReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Period Reserve Amount' ;
    rdfs:comment 'The reserve amount established in the previous valuation period for comparison and reserve development analysis.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Adjustment Amount' ;
    rdfs:comment 'The amount by which the current reserve differs from the prior period reserve, representing reserve development (favorable or unfavorable).' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveDevelopmentPercent rdf:type rdf:Property ;
    rdfs:label 'Reserve Development Percent' ;
    rdfs:comment 'The percentage change in the reserve from the prior period, indicating reserve adequacy or deficiency.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicalLossRatioPercent rdf:type rdf:Property ;
    rdfs:label 'Medical Loss Ratio Percent' ;
    rdfs:comment 'The ratio of incurred claims and quality improvement expenses to earned premium, used to assess reserve adequacy in relation to premium revenue.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earnedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Earned Premium Amount' ;
    rdfs:comment 'The portion of premium that has been earned during the period covered by this reserve, used in MLR and reserve adequacy calculations.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimFrequencyRate rdf:type rdf:Property ;
    rdfs:label 'Claim Frequency Rate' ;
    rdfs:comment 'The rate of claim occurrences per unit of exposure (e.g., per 1,000 member months), used in frequency-severity reserve methodologies.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageClaimSeverityAmount rdf:type rdf:Property ;
    rdfs:label 'Average Claim Severity Amount' ;
    rdfs:comment 'The average cost per claim used in frequency-severity reserve calculations.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:completionFactor rdf:type rdf:Property ;
    rdfs:label 'Completion Factor' ;
    rdfs:comment 'The estimated percentage of ultimate claims that have been reported or paid as of the valuation date, used in reserve development calculations.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tailFactor rdf:type rdf:Property ;
    rdfs:label 'Tail Factor' ;
    rdfs:comment 'The factor applied to project claims development beyond the observed development period in chain ladder and similar methodologies.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:credibilityWeight rdf:type rdf:Property ;
    rdfs:label 'Credibility Weight' ;
    rdfs:comment 'The weight assigned to actual experience versus expected or industry benchmarks in the reserve calculation, reflecting the statistical credibility of the data.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diagnosisCategory rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Category' ;
    rdfs:comment 'The clinical diagnosis category or condition group (e.g., HCC category, chronic condition) for which this reserve is established, if applicable.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialAssumptionSetId rdf:type rdf:Property ;
    rdfs:label 'Actuarial Assumption Set Id' ;
    rdfs:comment 'Reference identifier for the set of actuarial assumptions (trend rates, completion factors, development patterns) used in this reserve calculation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ActuarialAssumptionSet .

ind:seasonalityFactor rdf:type rdf:Property ;
    rdfs:label 'Seasonality Factor' ;
    rdfs:comment 'Adjustment factor applied to account for seasonal variations in claim patterns (e.g., higher utilization in winter months).' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catastrophicEventFlag rdf:type rdf:Property ;
    rdfs:label 'Catastrophic Event Flag' ;
    rdfs:comment 'Indicator of whether this reserve includes provisions for catastrophic events or large claim occurrences.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinsuranceRecoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recoverable Amount' ;
    rdfs:comment 'The amount expected to be recovered from reinsurers, reducing the net reserve liability.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Net Reserve Amount' ;
    rdfs:comment 'The reserve amount net of reinsurance recoverables, representing the company\'s net liability.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveAdequacyIndicator rdf:type rdf:Property ;
    rdfs:label 'Reserve Adequacy Indicator' ;
    rdfs:comment 'Assessment of whether the reserve is adequate, deficient, or redundant based on actuarial analysis and historical development patterns.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opinionDate rdf:type rdf:Property ;
    rdfs:label 'Opinion Date' ;
    rdfs:comment 'The date on which the actuarial opinion regarding the reserve adequacy was issued.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:opinionType rdf:type rdf:Property ;
    rdfs:label 'Opinion Type' ;
    rdfs:comment 'The type of actuarial opinion issued regarding reserve adequacy (unqualified, qualified, adverse, or disclaimer).' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveBasis rdf:type rdf:Property ;
    rdfs:label 'Reserve Basis' ;
    rdfs:comment 'The accounting or regulatory basis under which the reserve is calculated (e.g., GAAP, Statutory, Tax, IFRS, Economic).' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Indicator' ;
    rdfs:comment 'Indicates whether this reserve calculation is used for regulatory filing purposes (e.g., NAIC Annual Statement, CMS bid submissions).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveNotes rdf:type rdf:Property ;
    rdfs:label 'Reserve Notes' ;
    rdfs:comment 'Free-text field for actuarial notes, assumptions, limitations, or special considerations related to this reserve calculation.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByReserveId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Reserve Id' ;
    rdfs:comment 'Reference to the actuarial_reserve_id that supersedes this reserve calculation, if applicable.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ActuarialReserve .

ind:reserveCategory rdf:type rdf:Property ;
    rdfs:label 'Reserve Category' ;
    rdfs:comment 'High-level categorization of the reserve for financial statement presentation and regulatory reporting purposes.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveSubcategory rdf:type rdf:Property ;
    rdfs:label 'Reserve Subcategory' ;
    rdfs:comment 'Detailed subcategory within the reserve category for granular financial analysis and reporting.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimLagMonths rdf:type rdf:Property ;
    rdfs:label 'Claim Lag Months' ;
    rdfs:comment 'The average time lag in months between service date and claim reporting, used in IBNR calculations.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentLagMonths rdf:type rdf:Property ;
    rdfs:label 'Payment Lag Months' ;
    rdfs:comment 'The average time lag in months between claim reporting and claim payment, used in cash flow projections.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ultimateLossRatioPercent rdf:type rdf:Property ;
    rdfs:label 'Ultimate Loss Ratio Percent' ;
    rdfs:comment 'The projected ultimate loss ratio (incurred claims divided by earned premium) for the period, used in reserve adequacy assessment.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveToPremiumRatioPercent rdf:type rdf:Property ;
    rdfs:label 'Reserve To Premium Ratio Percent' ;
    rdfs:comment 'The ratio of actuarial reserves to earned premium, used as a key financial metric for reserve adequacy and solvency assessment.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveModelVersion rdf:type rdf:Property ;
    rdfs:label 'Reserve Model Version' ;
    rdfs:comment 'Version identifier for the actuarial model or software used to calculate the reserve, supporting model governance and reproducibility.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sensitivityAnalysisFlag rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Analysis Flag' ;
    rdfs:comment 'Indicates whether sensitivity analysis was performed to assess the impact of assumption changes on the reserve estimate.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bestEstimateAmount rdf:type rdf:Property ;
    rdfs:label 'Best Estimate Amount' ;
    rdfs:comment 'The actuarial best estimate of the reserve without risk margins or conservatism adjustments.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:provisionForAdverseDeviationAmount rdf:type rdf:Property ;
    rdfs:label 'Provision For Adverse Deviation Amount' ;
    rdfs:comment 'Additional reserve amount added to the best estimate to provide for adverse deviation from expected experience.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveReleaseAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Release Amount' ;
    rdfs:comment 'The amount of reserve released back to income due to favorable development or reserve redundancy.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveStrengtheningAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Strengthening Amount' ;
    rdfs:comment 'Additional reserve amount added due to adverse development or reserve deficiency.' ;
    rdfs:domain ind:ActuarialReserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationDetailId rdf:type rdf:Property ;
    rdfs:label 'Allocation Detail Id' ;
    rdfs:comment 'Unique identifier for each allocation detail transaction record.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationRuleId rdf:type rdf:Property ;
    rdfs:label 'Allocation Rule Id' ;
    rdfs:comment 'Identifier of the allocation rule applied in this transaction.' ;
