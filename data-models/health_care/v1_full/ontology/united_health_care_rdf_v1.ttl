ind:slaComplianceTargetPct rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Target Pct' ;
    rdfs:comment 'Target percentage for Service Level Agreement (SLA) compliance for cases at this priority level, used for Key Performance Indicator (KPI) tracking and performance management.' ;
    rdfs:domain ind:Priority ;
