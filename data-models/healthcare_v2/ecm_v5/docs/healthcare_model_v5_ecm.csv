research,trial_matching,trial_matching,trial_clinician_id,trial_clinician_id,,BIGINT,,provider.clinician.clinician_id,,,,Identifier of the provider who referred the patient for clinical trial matching evaluation.,
research,trial_matching,trial_matching,trial_eligibility_criterion_id,trial_eligibility_criterion_id,,BIGINT,,research.trial_eligibility_criterion.trial_eligibility_criterion_id,,,,"Protocol-specific identifier of the criterion that caused ineligibility, enabling traceability back to the protocol document.",
research,trial_matching,trial_matching,trial_principal_investigator_clinician_id,trial_principal_investigator_clinician_id,,BIGINT,,provider.clinician.clinician_id,,,,Identifier of the principal investigator responsible for the clinical trial at the evaluating site.,
research,trial_matching,trial_matching,visit_id,visit_id,,BIGINT,,encounter.visit.visit_id,,,,Identifier of the clinical encounter during which the trial matching evaluation was initiated or performed.,
research,trial_matching,trial_matching,age_at_evaluation,age_at_evaluation,,INT,,,"restricted,pii_health",,,"Patients age in years at the time of eligibility evaluation, a common inclusion/exclusion criterion for clinical trials.",
research,trial_matching,trial_matching,biomarker_match_flag,biomarker_match_flag,,BOOLEAN,,,,,,"Indicates whether the patients biomarker profile matches the trials biomarker-based eligibility requirements, common in precision medicine trials.",
research,trial_matching,trial_matching,confidence_level,confidence_level,,"DECIMAL(5,4)",,,,,,"Statistical confidence level of the eligibility determination, expressed as a decimal between 0 and 1, indicating reliability of the matching algorithm output.",
research,trial_matching,trial_matching,consent_status,consent_status,,STRING,,,,,,Status of informed consent for trial participation at the time of matching evaluation.,
research,trial_matching,trial_matching,created_timestamp,created_timestamp,,TIMESTAMP,,,,,,Timestamp when this trial matching evaluation record was first created in the system.,
research,trial_matching,trial_matching,criteria_data_completeness_pct,criteria_data_completeness_pct,,"DECIMAL(5,2)",,,,,,"Percentage of eligibility criteria that could be evaluated based on available patient data, indicating data sufficiency for the matching decision.",
research,trial_matching,trial_matching,data_source,data_source,,STRING,,,,,,Primary source system from which patient clinical data was extracted for eligibility evaluation.,
research,trial_matching,trial_matching,decline_reason,decline_reason,,STRING,,,,,,"Reason provided by the patient for declining participation in the matched clinical trial, supporting recruitment analytics.",
research,trial_matching,trial_matching,distance_to_site_miles,distance_to_site_miles,,"DECIMAL(7,2)",,,,,,"Calculated distance in miles between the patients residence and the trial site, used to assess feasibility of patient participation and travel burden.",
research,trial_matching,trial_matching,eligibility_score,eligibility_score,,"DECIMAL(5,2)",,,,,,"Computed eligibility score representing the degree of match between patient characteristics and trial inclusion/exclusion criteria, typically on a 0-100 scale.",
research,trial_matching,trial_matching,enrollment_date,enrollment_date,,DATE,,,,,,Date on which the patient was formally enrolled into the clinical trial following successful matching and consent.,
research,trial_matching,trial_matching,evaluation_date,evaluation_date,,DATE,,,,,,Date on which the clinical trial eligibility evaluation was performed for this patient-trial combination.,
research,trial_matching,trial_matching,evaluation_timestamp,evaluation_timestamp,,TIMESTAMP,,,,,,"Precise timestamp when the eligibility evaluation was completed, used for audit trail and regulatory compliance.",
research,trial_matching,trial_matching,exclusion_criteria_total_count,exclusion_criteria_total_count,,INT,,,,,,Total number of exclusion criteria defined in the trial protocol against which the patient was evaluated.,
research,trial_matching,trial_matching,exclusion_criteria_triggered_count,exclusion_criteria_triggered_count,,INT,,,,,,"Number of protocol-defined exclusion criteria that the patient triggers, potentially disqualifying them from enrollment.",
research,trial_matching,trial_matching,expiration_date,expiration_date,,DATE,,,,,,Date after which this eligibility evaluation is no longer valid and must be re-assessed due to potential changes in patient clinical status or protocol amendments.,
research,trial_matching,trial_matching,inclusion_criteria_met_count,inclusion_criteria_met_count,,INT,,,,,,Number of protocol-defined inclusion criteria that the patient satisfies based on available clinical data.,
research,trial_matching,trial_matching,inclusion_criteria_total_count,inclusion_criteria_total_count,,INT,,,,,,Total number of inclusion criteria defined in the trial protocol against which the patient was evaluated.,
research,trial_matching,trial_matching,ineligibility_reason,ineligibility_reason,,STRING,,,"restricted,pii_health",,,"Primary reason the patient was determined ineligible for the trial, referencing the specific exclusion criterion or unmet inclusion criterion.",
research,trial_matching,trial_matching,irb_approval_number,irb_approval_number,,STRING,,,,,,"IRB approval reference number for the trial protocol at the evaluating institution, confirming ethical oversight.",
research,trial_matching,trial_matching,matching_algorithm_version,matching_algorithm_version,,STRING,,,,,,"Version identifier of the eligibility matching algorithm or rule engine used to produce this evaluation, supporting reproducibility and audit.",
research,trial_matching,trial_matching,matching_number,matching_number,,STRING,,,,,,Business-facing reference number assigned to this trial matching evaluation for tracking and communication purposes.,
research,trial_matching,trial_matching,matching_status,matching_status,,STRING,,,,,,Current status of the patient-to-trial matching evaluation workflow indicating eligibility determination outcome.,
research,trial_matching,trial_matching,matching_type,matching_type,,STRING,,,,,,"Method used to perform the eligibility matching evaluation, distinguishing automated algorithmic matching from manual clinical review.",
research,trial_matching,trial_matching,nct_number,nct_number,,STRING,,,,,,ClinicalTrials.gov NCT registration number of the trial being evaluated for patient matching.,
research,trial_matching,trial_matching,notes,notes,,STRING,,,"restricted,pii_health",,,"Free-text clinical notes documenting additional context, observations, or rationale related to the eligibility evaluation.",
research,trial_matching,trial_matching,override_flag,override_flag,,BOOLEAN,,,,,,Indicates whether the automated eligibility determination was manually overridden by a clinical reviewer.,
research,trial_matching,trial_matching,override_reason,override_reason,,STRING,,,,,,Clinical justification provided when a reviewer manually overrides the automated eligibility determination.,
research,trial_matching,trial_matching,patient_notification_date,patient_notification_date,,DATE,,,,,,Date on which the patient was notified about the trial matching opportunity and potential eligibility.,
research,trial_matching,trial_matching,patient_response,patient_response,,STRING,,,,,,Patients expressed interest or decision regarding participation in the matched clinical trial.,
research,trial_matching,trial_matching,primary_diagnosis_code,primary_diagnosis_code,,STRING,,,"restricted,pii_health",,,ICD-10 diagnosis code representing the patients primary condition relevant to trial eligibility determination.,
research,trial_matching,trial_matching,prior_treatment_match_flag,prior_treatment_match_flag,,BOOLEAN,,,"restricted,pii",,,Indicates whether the patients prior treatment history satisfies the trials requirements for previous therapy lines or washout periods.,
research,trial_matching,trial_matching,priority_rank,priority_rank,,INT,,,,,,"Relative priority ranking of this trial match for the patient when multiple trials are available, with 1 being highest priority.",
research,trial_matching,trial_matching,randomization_eligible_flag,randomization_eligible_flag,,BOOLEAN,,,,,,Indicates whether the patient has passed all screening requirements and is eligible for randomization into the trial.,
research,trial_matching,trial_matching,review_date,review_date,,DATE,,,,,,Date on which a clinical reviewer validated or overrode the automated matching determination.,
research,trial_matching,trial_matching,screening_visit_date,screening_visit_date,,DATE,,,,,,Date of the formal screening visit scheduled or completed as part of the trial enrollment process following positive matching.,
research,trial_matching,trial_matching,sponsor_name,sponsor_name,,STRING,,,,,,"Name of the pharmaceutical company, device manufacturer, or academic institution sponsoring the clinical trial.",
research,trial_matching,trial_matching,therapeutic_area,therapeutic_area,,STRING,,,,,,"Clinical therapeutic area or disease category targeted by the trial, used for high-level matching classification. [ENUM-REF-CANDIDATE: oncology|cardiology|neurology|immunology|endocrinology|pulmonology|infectious_disease|rare_disease|psychiatry — promote to reference product]",
research,trial_matching,trial_matching,trial_phase,trial_phase,,STRING,,,,,,"FDA-defined phase of the clinical trial, indicating the stage of drug or device development and influencing eligibility requirements.",
research,trial_matching,trial_matching,updated_timestamp,updated_timestamp,,TIMESTAMP,,,,,,"Timestamp when this trial matching evaluation record was last modified, supporting audit trail requirements.",
research,trial_matching,trial_matching,waiver_approved_flag,waiver_approved_flag,,BOOLEAN,,,,,,Indicates whether the eligibility waiver request was approved by the principal investigator and/or sponsor.,
research,trial_matching,trial_matching,waiver_requested_flag,waiver_requested_flag,,BOOLEAN,,,,,,Indicates whether a protocol eligibility waiver was requested for this patient despite not meeting all standard criteria.,
workforce,compensation_benefits,benefit_enrollment,benefit_enrollment_id,benefit_enrollment_id,Benefit Enrollment ID,BIGINT,Y,,,,transactional_data,Unique surrogate identifier for each benefit enrollment record in the workforce domain. Primary key for the benefit_enrollment data product.,
workforce,compensation_benefits,benefit_enrollment,benefit_plan_id,benefit_plan_id,Benefit Plan ID,BIGINT,,workforce.benefit_plan.benefit_plan_id,,,transactional_data,"Reference to the specific benefit plan elected by the worker (e.g., medical plan, dental plan, 403(b) retirement plan). Links to the benefit plan master record.",
workforce,compensation_benefits,benefit_enrollment,employee_id,employee_id,Worker ID,BIGINT,,workforce.employee.employee_id,"dbx_confidential, dbx_pii,employee_id=benefit_enrollment_employee_id",,transactional_data,employee_id (benefit enrollment),
workforce,compensation_benefits,benefit_enrollment,position_id,position_id,Position Id (Foreign Key),BIGINT,,workforce.position.position_id,,,transactional_data,"Foreign key linking to workforce.position. Business justification: Benefit eligibility and plan offerings often vary by position type (full-time vs. part-time, union vs. non-union, executive vs. staff). Adding position_id enables position-specific benefit analysis an",
workforce,compensation_benefits,benefit_enrollment,aca_affordability_flag,aca_affordability_flag,ACA Affordability Flag,BOOLEAN,,,,,transactional_data,Indicates whether the employees required contribution for the lowest-cost self-only coverage does not exceed the ACA affordability threshold (percentage of household income or safe harbor). Used for ACA employer mandate compliance and IRS Form 1095-C reporting.,
workforce,compensation_benefits,benefit_enrollment,aca_minimum_essential_coverage_flag,aca_minimum_essential_coverage_flag,ACA Minimum Essential Coverage (MEC) Flag,BOOLEAN,,,,,transactional_data,Indicates whether this medical benefit enrollment satisfies the Affordable Care Act (ACA) Minimum Essential Coverage (MEC) requirement. True for qualifying employer-sponsored health plans. Used for ACA employer mandate compliance reporting on IRS Forms 1094-C and 1095-C.,
workforce,compensation_benefits,benefit_enrollment,aca_minimum_value_flag,aca_minimum_value_flag,ACA Minimum Value (MV) Flag,BOOLEAN,,,,,transactional_data,"Indicates whether the elected medical plan meets the ACA Minimum Value (MV) standard, meaning the plan pays at least 60% of the total allowed cost of benefits. Required for ACA employer mandate compliance and IRS Form 1095-C Line 14 reporting.",
workforce,compensation_benefits,benefit_enrollment,annual_election_amount,annual_election_amount,Annual Election Amount,"DECIMAL(12,2)",,,dbx_confidential,,transactional_data,"The total annual dollar amount elected by the employee for spending accounts (FSA, HSA, dependent care FSA) or retirement plan contributions (403(b)/401(k)). Applicable primarily to FSA, HSA, and retirement benefit types. Null for insurance plan types.",
workforce,compensation_benefits,benefit_enrollment,beneficiary_name,beneficiary_name,Primary Beneficiary Name,STRING,,,"dbx_pii_name,dbx_restricted,pii_pii",,transactional_data,"Add pii_phi, pii_pii, pii_sensitive tags",
workforce,compensation_benefits,benefit_enrollment,beneficiary_relationship,beneficiary_relationship,Primary Beneficiary Relationship,STRING,,,,spouse|child|parent|sibling|domestic_partner|other,transactional_data,"Add pii_phi, pii_pii, pii_sensitive tags",
workforce,compensation_benefits,benefit_enrollment,benefit_type,benefit_type,Benefit Type,STRING,,,,,transactional_data,"Category of benefit plan elected by the worker. Classifies the enrollment into major benefit program types: medical, dental, vision, life insurance, disability (short-term or long-term), Flexible Spending Account (FSA), Health Savings Account (HSA), or retirement (403(b)/401(k)). [ENUM-REF-CANDIDATE: medical|dental|vision|life_insurance|disability|fsa|hsa|retirement — 8 candidates stripped; promote to reference product]",
workforce,compensation_benefits,benefit_enrollment,carrier_confirmation_date,carrier_confirmation_date,Carrier Confirmation Date,DATE,,,,,transactional_data,The date on which the insurance carrier confirmed receipt and processing of the enrollment eligibility record. Used to reconcile Workday enrollment records against carrier enrollment files and resolve discrepancies.,
workforce,compensation_benefits,benefit_enrollment,carrier_eligibility_sent_date,carrier_eligibility_sent_date,Carrier Eligibility File Sent Date,DATE,,,,,transactional_data,The date on which the eligibility file for this enrollment was transmitted to the insurance carrier or benefit administrator. Used to track carrier file transmission status and resolve eligibility discrepancies between Workday and the carrier.,
workforce,compensation_benefits,benefit_enrollment,carrier_group_number,carrier_group_number,Carrier Group Number,STRING,,,,,transactional_data,"The group policy number assigned by the insurance carrier to the healthcare organizations benefit plan. Used on insurance cards, claims submissions, and eligibility verification. Shared across all employees enrolled in the same plan.",
workforce,compensation_benefits,benefit_enrollment,carrier_member_number,carrier_member_number,Carrier Member ID,STRING,,,"dbx_pii_identifier,dbx_restricted,pii_pii",,transactional_data,"The unique member identification number assigned by the insurance carrier to the enrolled employee. Used for claims processing, eligibility verification, and member services. This is a PHI-adjacent identifier that can be used to access health information.",
workforce,compensation_benefits,benefit_enrollment,carrier_name,carrier_name,Benefit Carrier Name,STRING,,,,,transactional_data,"Name of the insurance carrier or benefit administrator providing the elected benefit plan (e.g., Blue Cross Blue Shield, Aetna, Delta Dental, Fidelity Investments). Used for carrier billing, eligibility file transmission, and member ID card generation.",
workforce,compensation_benefits,benefit_enrollment,cobra_eligible_flag,cobra_eligible_flag,COBRA Eligibility Flag,BOOLEAN,,,,,transactional_data,"Indicates whether the employee is eligible for COBRA (Consolidated Omnibus Budget Reconciliation Act) continuation coverage upon termination of this enrollment. True when the enrollment termination is due to a qualifying COBRA event (e.g., employment termination, reduction in hours). Drives COBRA notification workflow.",
workforce,compensation_benefits,benefit_enrollment,cobra_notification_date,cobra_notification_date,COBRA Notification Date,DATE,,,,,transactional_data,The date on which the COBRA election notice was sent to the employee following a qualifying event. The employer must provide notice within 14 days of being notified of the qualifying event. Required for COBRA compliance documentation.,
workforce,compensation_benefits,benefit_enrollment,coverage_tier,coverage_tier,Coverage Tier,STRING,,,,employee_only|employee_spouse|employee_children|family,transactional_data,"Coverage level elected by the employee indicating who is covered under the benefit plan. Drives premium calculation and payroll deduction amounts. Standard tiers: employee only, employee plus spouse, employee plus children, or full family coverage.",
workforce,compensation_benefits,benefit_enrollment,created_timestamp,created_timestamp,Record Created Timestamp,TIMESTAMP,,,,,transactional_data,The timestamp when this benefit enrollment record was first created in the system. Serves as the RECORD_AUDIT_CREATED field for this MASTER_AGREEMENT entity. Used for audit trail and data lineage.,
workforce,compensation_benefits,benefit_enrollment,deduction_frequency,deduction_frequency,Deduction Frequency,STRING,,,,weekly|biweekly|semimonthly|monthly,transactional_data,The payroll deduction frequency for the employees benefit premium contribution. Determines how often the employee_premium_amount is deducted from the employees paycheck. Must align with the employees pay frequency in Workday Payroll.,
workforce,compensation_benefits,benefit_enrollment,dependent_count,dependent_count,Enrolled Dependent Count,INT,,,,,transactional_data,"The number of dependents (spouse, children, domestic partner) enrolled under this benefit plan election. Used to validate coverage tier selection and for carrier eligibility file reconciliation.",
workforce,compensation_benefits,benefit_enrollment,disability_benefit_type,disability_benefit_type,Disability Benefit Type,STRING,,,"dbx_pii_health,dbx_restricted,pii_phi,pii_sensitive",short_term|long_term,transactional_data,"Specifies whether the disability benefit enrollment is for Short-Term Disability (STD) or Long-Term Disability (LTD) coverage. Applicable only when benefit_type is disability. Drives different elimination periods, benefit durations, and premium rates.",
workforce,compensation_benefits,benefit_enrollment,effective_date,effective_date,Enrollment Effective Date,DATE,,,,,transactional_data,The date on which the benefit coverage becomes effective and the employee is entitled to use the elected benefit plan. This is the MASTER_AGREEMENT EFFECTIVE_FROM date for this enrollment record.,
workforce,compensation_benefits,benefit_enrollment,employee_premium_amount,employee_premium_amount,Employee Premium Amount,"DECIMAL(12,2)",,,dbx_confidential,,transactional_data,"The employees share of the benefit plan premium per pay period, expressed in USD. This is the amount deducted from the employees paycheck via pre-tax or post-tax payroll deduction. Drives payroll deduction configuration in Workday Payroll.",
workforce,compensation_benefits,benefit_enrollment,employer_contribution_amount,employer_contribution_amount,Employer Contribution Amount,"DECIMAL(12,2)",,,dbx_confidential,,transactional_data,"The employers annual contribution to the employees HSA, FSA, or retirement account (403(b)/401(k) match), expressed in USD. Distinct from employer_premium_amount which applies to insurance plans. Used for IRS reporting and total compensation statements.",
workforce,compensation_benefits,benefit_enrollment,employer_match_rate,employer_match_rate,Employer Match Rate,"DECIMAL(5,4)",,,dbx_confidential,,transactional_data,"The employers matching contribution rate as a percentage of the employees retirement contribution, expressed as a decimal (e.g., 0.5000 = 50% match up to a cap). Applicable only when benefit_type is retirement. Used for total compensation reporting and retirement plan compliance.",
workforce,compensation_benefits,benefit_enrollment,employer_premium_amount,employer_premium_amount,Employer Premium Amount,"DECIMAL(12,2)",,,dbx_confidential,,transactional_data,"The employers contribution toward the benefit plan premium per pay period, expressed in USD. Represents the healthcare organizations cost of providing the benefit. Used in total compensation reporting and benefits cost analysis.",
workforce,compensation_benefits,benefit_enrollment,enrollment_confirmation_number,enrollment_confirmation_number,Enrollment Confirmation Number,STRING,,,,,transactional_data,The confirmation number generated by Workday HCM or the carriers enrollment portal upon successful submission of the benefit election. Provided to the employee as proof of enrollment. Used for audit and dispute resolution.,
workforce,compensation_benefits,benefit_enrollment,enrollment_number,enrollment_number,Enrollment Number,STRING,,,,^ENR-[0-9]{10}$,transactional_data,"Externally-known business identifier for this benefit enrollment record, used in correspondence with carriers, payroll, and HR operations. Sourced from Workday HCM Benefits module.",
workforce,compensation_benefits,benefit_enrollment,enrollment_source,enrollment_source,Enrollment Source,STRING,,,,open_enrollment|qualifying_life_event|new_hire|rehire|correction,transactional_data,"The business event or process that initiated this benefit enrollment. Distinguishes between annual open enrollment elections, mid-year qualifying life event (QLE) changes (e.g., marriage, birth, loss of other coverage), new hire enrollment, rehire enrollment, or administrative corrections.",
workforce,compensation_benefits,benefit_enrollment,enrollment_status,enrollment_status,Enrollment Status,STRING,,,,active|pending|terminated|waived|suspended,transactional_data,Current lifecycle state of the benefit enrollment record. Active indicates coverage is in force; pending indicates awaiting carrier confirmation; terminated indicates coverage has ended; waived indicates the employee declined coverage; suspended indicates coverage is temporarily paused.,
workforce,compensation_benefits,benefit_enrollment,enrollment_submitted_date,enrollment_submitted_date,Enrollment Submission Date,DATE,,,,,transactional_data,The date on which the employee submitted their benefit election in Workday HCM. Distinct from the effective_date (when coverage begins). Used to verify timely enrollment within the election window and for audit trail purposes.,
workforce,compensation_benefits,benefit_enrollment,fsa_plan_type,fsa_plan_type,Flexible Spending Account (FSA) Plan Type,STRING,,,,healthcare|dependent_care|limited_purpose,transactional_data,"Specifies the type of Flexible Spending Account (FSA) elected: healthcare FSA (for medical expenses), dependent care FSA (DCFSA for childcare/eldercare), or limited-purpose FSA (for dental/vision only, compatible with HSA). Applicable only when benefit_type is fsa.",
workforce,compensation_benefits,benefit_enrollment,hsa_contribution_limit,hsa_contribution_limit,Health Savings Account (HSA) Contribution Limit,"DECIMAL(10,2)",,,dbx_confidential,,transactional_data,The IRS-mandated annual contribution limit applicable to this HSA enrollment based on coverage tier (individual vs. family) and the employees age (catch-up contributions for age 55+). Used to validate that annual_election_amount does not exceed IRS limits. Applicable only when benefit_type is hsa.,
workforce,compensation_benefits,benefit_enrollment,last_updated_timestamp,last_updated_timestamp,Record Last Updated Timestamp,TIMESTAMP,,,,,transactional_data,"The timestamp when this benefit enrollment record was most recently modified in the system. Serves as the RECORD_AUDIT_UPDATED field. Used for change tracking, incremental ETL processing, and audit compliance.",
workforce,compensation_benefits,benefit_enrollment,life_insurance_coverage_amount,life_insurance_coverage_amount,Life Insurance Coverage Amount,"DECIMAL(14,2)",,,dbx_confidential,,transactional_data,"The face value (death benefit) of the life insurance policy elected by the employee, expressed in USD. Applicable only when benefit_type is life_insurance. May be a flat amount or a multiple of annual salary (e.g., 1x, 2x base salary).",
workforce,compensation_benefits,benefit_enrollment,open_enrollment_period,open_enrollment_period,Open Enrollment Period,STRING,,,,^OE-[0-9]{4}(-[0-9]{2})?$,transactional_data,"Identifier for the annual open enrollment window during which this election was made (e.g., OE-2024). Null for mid-year qualifying life event enrollments. Used to group and audit all elections made during a specific open enrollment campaign.",
workforce,compensation_benefits,benefit_enrollment,other_coverage_carrier,other_coverage_carrier,Other Coverage Carrier Name,STRING,,,,,transactional_data,Name of the insurance carrier providing the employees other coverage when the employee has waived the employers plan due to having coverage elsewhere. Used for coordination of benefits (COB) and ACA compliance documentation.,
workforce,compensation_benefits,benefit_enrollment,plan_year,plan_year,Benefit Plan Year,STRING,,,,^[0-9]{4}$,transactional_data,"The calendar or fiscal plan year to which this enrollment applies (e.g., 2024). Used to associate elections with the correct annual benefit period for reporting, compliance, and ACA employer mandate tracking.",
workforce,compensation_benefits,benefit_enrollment,pretax_flag,pretax_flag,Pre-Tax Deduction Flag,BOOLEAN,,,,,transactional_data,"Indicates whether the employees premium contribution is deducted on a pre-tax basis under a Section 125 Cafeteria Plan (True) or on a post-tax basis (False). Affects the employees taxable income and W-2 reporting. Most medical, dental, and vision premiums are pre-tax.",
workforce,compensation_benefits,benefit_enrollment,qualifying_life_event_type,qualifying_life_event_type,Qualifying Life Event (QLE) Type,STRING,,,,,transactional_data,"Specifies the type of qualifying life event (QLE) that triggered a mid-year benefit change, when enrollment_source is qualifying_life_event. Examples include marriage, divorce, birth, adoption, death of dependent, loss of other coverage, change in employment status. Null when enrollment_source is open_enrollment or new_hire. [ENUM-REF-CANDIDATE: marriage|divorce|birth|adoption|death_of_dependent|loss_of_coverage|employment_change|other — promote to reference product]",
workforce,compensation_benefits,benefit_enrollment,retirement_contribution_rate,retirement_contribution_rate,Retirement Contribution Rate,"DECIMAL(5,4)",,,dbx_confidential,,transactional_data,"The employees elected contribution rate as a percentage of gross pay for retirement plans (403(b)/401(k)), expressed as a decimal (e.g., 0.0600 = 6%). Used to calculate per-period retirement deductions in Workday Payroll. Applicable only when benefit_type is retirement.",
workforce,compensation_benefits,benefit_enrollment,termination_date,termination_date,Enrollment Termination Date,DATE,,,,,transactional_data,The date on which the benefit coverage ends and the employee is no longer entitled to the elected benefit plan. Null for currently active enrollments. This is the MASTER_AGREEMENT EFFECTIVE_UNTIL date. Triggers COBRA eligibility notification requirements under federal law.,
workforce,compensation_benefits,benefit_enrollment,total_premium_amount,total_premium_amount,Total Premium Amount,"DECIMAL(12,2)",,,dbx_confidential,,transactional_data,"The combined total premium for the benefit plan per pay period (employee share plus employer share), expressed in USD. Used for carrier billing reconciliation and total benefits cost reporting.",
workforce,compensation_benefits,benefit_enrollment,waiver_reason,waiver_reason,Benefit Waiver Reason,STRING,,,,,transactional_data,"The stated reason why the employee waived (declined) coverage for this benefit plan, when enrollment_status is waived. Common reasons include coverage through spouses employer, coverage through Medicare/Medicaid, or other qualifying coverage. Required for ACA employer mandate compliance documentation.",
workforce,compensation_benefits,benefit_plan,benefit_plan_id,benefit_plan_id,Benefit Plan Identifier,BIGINT,Y,,,,master_data,Primary key for benefit_plan,
workforce,compensation_benefits,benefit_plan,finance_financial_entity_id,finance_financial_entity_id,,BIGINT,,finance.financial_entity.financial_entity_id,,,master_data,FK to finance.financial_entity.financial_entity_id,
workforce,compensation_benefits,benefit_plan,superseded_benefit_plan_id,superseded_benefit_plan_id,Superseded Benefit Plan Id,BIGINT,,workforce.benefit_plan.benefit_plan_id,dbx_self_ref_fk,,master_data,Self-referencing FK on benefit_plan (superseded_benefit_plan_id),
workforce,compensation_benefits,benefit_plan,benefit_plan_status,benefit_plan_status,Status,STRING,,,,,master_data,Current lifecycle status of the benefit plan indicating availability for enrollment and administration.,
workforce,compensation_benefits,benefit_plan,carrier_name,carrier_name,Carrier Name,STRING,,,,,master_data,Name of the insurance carrier or third-party administrator providing the benefit plan.,
workforce,compensation_benefits,benefit_plan,carrier_policy_number,carrier_policy_number,Carrier Policy Number,STRING,,,dbx_confidential,,master_data,Unique policy or contract number assigned by the insurance carrier for this benefit plan.,
workforce,compensation_benefits,benefit_plan,coinsurance_percentage,coinsurance_percentage,Coinsurance Percentage,"DECIMAL(5,2)",,,,,master_data,Percentage of covered expenses the employee pays after meeting the deductible.,
workforce,compensation_benefits,benefit_plan,contribution_frequency,contribution_frequency,Contribution Frequency,STRING,,,,,master_data,Frequency at which employee and employer contributions are collected for this benefit plan.,
workforce,compensation_benefits,benefit_plan,copay_emergency_room,copay_emergency_room,Copay Emergency Room,"DECIMAL(10,2)",,,,,master_data,Fixed dollar amount the employee pays for emergency room visits under this plan.,
workforce,compensation_benefits,benefit_plan,copay_primary_care,copay_primary_care,Copay Primary Care,"DECIMAL(10,2)",,,,,master_data,Fixed dollar amount the employee pays for primary care physician visits under this plan.,
workforce,compensation_benefits,benefit_plan,copay_specialist,copay_specialist,Copay Specialist,"DECIMAL(10,2)",,,,,master_data,Fixed dollar amount the employee pays for specialist physician visits under this plan.,
workforce,compensation_benefits,benefit_plan,coverage_level,coverage_level,Coverage Level,STRING,,,,,master_data,"Tier of coverage indicating who is eligible under the plan (employee only, family, etc.).",
