    rdfs:comment 'Unique surrogate key for the safety event review record.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originatingSafetyEventPatientSafetyEventId rdf:type rdf:Property ;
    rdfs:label 'Originating Safety Event Patient Safety Event Id' ;
    rdfs:comment 'FK reference to the originating patient safety event being reviewed. Renamed from generic event_id to clarify business role per next_vibes priority.' ;
    rdfs:domain ind:SafetyEventReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PatientSafetyEvent .

ind:primaryPatientSafetyEventId rdf:type rdf:Property ;
