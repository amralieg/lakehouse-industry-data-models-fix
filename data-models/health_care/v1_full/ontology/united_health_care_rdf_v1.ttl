    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timelyFilingIndicator rdf:type rdf:Property ;
    rdfs:label 'Timely Filing Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment is due to timely filing limit violations.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timelyFilingLimitDays rdf:type rdf:Property ;
    rdfs:label 'Timely Filing Limit Days' ;
    rdfs:comment 'The number of days allowed for timely filing under the applicable policy when timely filing is the adjustment reason.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:duplicateClaimIndicator rdf:type rdf:Property ;
    rdfs:label 'Duplicate Claim Indicator' ;
    rdfs:comment 'Flag indicating whether this adjustment is due to identification of a duplicate claim submission.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Fraud Case Number' ;
    rdfs:comment 'The case number assigned by the Special Investigations Unit (SIU) when fraud is suspected.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
