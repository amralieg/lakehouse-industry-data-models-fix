ind:primaryMarketCountryCode rdf:type rdf:Property ;
    rdfs:label 'Primary Market Country Code' ;
    rdfs:comment 'Three-letter ISO country code representing the primary market where the brand has its strongest presence and fan base.' ;
    rdfs:domain ind:Brand ;
