    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalPartyOrganization rdf:type rdf:Property ;
    rdfs:label 'External Party Organization' ;
    rdfs:comment 'Organization or entity affiliation of the external party referenced in the case note.' ;
