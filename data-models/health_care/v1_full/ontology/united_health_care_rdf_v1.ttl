    rdfs:comment 'Primary market segment that this enrollment channel is designed to serve.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicAvailability rdf:type rdf:Property ;
