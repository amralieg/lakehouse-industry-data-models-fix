    rdfs:comment 'Classification of the financial impact this HCC category has on risk-based payments and revenue.' ;
    rdfs:domain ind:HccCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prevalenceRate rdf:type rdf:Property ;
    rdfs:label 'Prevalence Rate' ;
    rdfs:comment 'The prevalence rate of this HCC category in the Medicare Advantage population (expressed as decimal percentage).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:suspectConditionIndicator rdf:type rdf:Property ;
