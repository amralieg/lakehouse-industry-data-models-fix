    rdfs:domain ind:OutreachChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:characterLimit rdf:type rdf:Property ;
    rdfs:label 'Character Limit' ;
    rdfs:comment 'Maximum number of characters allowed in a single message sent through this channel (e.g., 160 for SMS, unlimited for email).' ;
    rdfs:domain ind:OutreachChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supportsAttachments rdf:type rdf:Property ;
    rdfs:label 'Supports Attachments' ;
    rdfs:comment 'Flag indicating whether the channel supports sending file attachments such as care plans, educational materials, or appointment reminders.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsRichMedia rdf:type rdf:Property ;
    rdfs:label 'Supports Rich Media' ;
    rdfs:comment 'Flag indicating whether the channel supports rich media content such as images, videos, or formatted HTML.' ;
    rdfs:domain ind:OutreachChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timeRestrictions rdf:type rdf:Property ;
    rdfs:label 'Time Restrictions' ;
    rdfs:comment 'Description of any time-of-day or day-of-week restrictions for using this channel (e.g., TCPA restrictions on calling times, business hours only).' ;
    rdfs:domain ind:OutreachChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicRestrictions rdf:type rdf:Property ;
    rdfs:label 'Geographic Restrictions' ;
    rdfs:comment 'Description of any geographic or jurisdictional restrictions on the use of this channel (e.g., state-specific regulations, international limitations).' ;
    rdfs:domain ind:OutreachChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageRestrictions rdf:type rdf:Property ;
    rdfs:label 'Age Restrictions' ;
    rdfs:comment 'Description of any age-related restrictions for using this channel (e.g., parental consent required for minors, senior-friendly alternatives).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encryptionRequired rdf:type rdf:Property ;
    rdfs:label 'Encryption Required' ;
    rdfs:comment 'Flag indicating whether end-to-end encryption is required for communications sent through this channel to protect PHI.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditLoggingEnabled rdf:type rdf:Property ;
