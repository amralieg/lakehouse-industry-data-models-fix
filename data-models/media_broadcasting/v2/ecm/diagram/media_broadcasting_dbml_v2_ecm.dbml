  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in talent.usage_right']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in talent.usage_right']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in talent.usage_right']
