ind:oopAppliesFlag rdf:type rdf:Property ;
    rdfs:label 'Oop Applies Flag' ;
    rdfs:comment 'Indicates whether costs for this benefit type and service category count toward the out-of-pocket maximum.' ;
    rdfs:domain ind:CostSharing ;
