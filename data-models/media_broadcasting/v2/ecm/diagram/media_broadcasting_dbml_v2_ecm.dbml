Table distribution.ott_platform {
  ott_platform_id varchar [pk, note: 'Unique surrogate identifier for each OTT service platform record in the master registry. Primary key for the ott_platform entity — all downstream distribution products reference this key. | Column ott_platform_id (BIGINT) in distribution.ott_platform']
  billing_account_id varchar [note: 'Foreign key linking to billing.account. Business justification: OTT platforms require billing account linkage for subscription billing setup, revenue recognition by platform, and financial reporting. Media broadcasting operations track platform-level billing confi | Column billing_account_id (BIGINT) in billing.ott_platform']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: OTT platforms originate from broadcast facilities housing master control and encoding infrastructure. Critical for NOC escalation routing, facility maintenance impact assessment, and disaster recovery | Column broadcast_facility_id (BIGINT) in technology.ott_platform']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: OTT platforms retransmitting broadcast content operate under specific broadcast licenses. Retransmission consent agreements and carriage rights require tracking which license authorizes the platform\'s | Column broadcast_license_id (BIGINT) in compliance.ott_platform']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: OTT platforms are distinct cost centers for P&L reporting and budget allocation. Monthly financial close allocates platform operating expenses (content, technology, marketing) to specific cost centers | Column cost_center_id (BIGINT) in finance.ott_platform']
  licensee_sales_account_id varchar [note: 'Foreign key linking to sales.sales_account. Business justification: OTT platforms are licensed to enterprise customers and distribution partners tracked as sales accounts. Supports B2B platform licensing deals, white-label OTT agreements, and enterprise streaming serv | Column licensee_sales_account_id (BIGINT) in sales.ott_platform']
  platform_manager_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: OTT platforms require operational ownership for launch management, SLA compliance monitoring, sunset decisions, and incident escalation. Platform managers are accountable for subscriber growth, ARPU t | Column platform_manager_employee_id (BIGINT) in workforce.ott_platform']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: OTT platforms are profit centers for revenue tracking and margin analysis. Quarterly earnings reports break out revenue, costs, and EBITDA by platform/service for investor reporting and segment perfor | Column profit_center_id (BIGINT) in finance.ott_platform']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Platform launches, service tier changes, and privacy policy updates trigger regulatory filings (FCC, FTC, state regulators). Platform lifecycle events generate compliance obligations requiring filing  | Column regulatory_filing_id (BIGINT) in compliance.ott_platform']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: OTT platforms operate in specific territories with distinct regulatory, content rating, and rights enforcement requirements. Replaces geographic_availability text with structured territory reference.  | Column rights_territory_id (BIGINT) in rights.ott_platform']
  tech_project_id varchar [note: 'Foreign key linking to technology.tech_project. Business justification: OTT platforms are launched via technology projects. Required for platform launch project tracking and capex budget allocation. | Column tech_project_id (BIGINT) in technology.ott_platform']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.ott_platform']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.ott_platform']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.ott_platform']
  adobe_property_code varchar [note: 'The unique property identifier assigned to this OTT platform within Adobe Experience Platform (AEP) for audience data collection, segmentation, and personalization. Used to link platform-level engagement events to subscriber profiles and Nielsen cross-platform measurement. | Column adobe_property_code (STRING) in distribution.ott_platform']
  arpu decimal(10,4) [note: 'Average monthly revenue generated per active subscriber on this platform, expressed in the platform\'s billing currency. Calculated at the platform level for strategic pricing and investor reporting. Confidential as a key financial performance indicator. Sourced from Zuora revenue recognition data. | Column arpu (DECIMAL(10,4)) in distribution.ott_platform']
  base_subscription_price decimal(10,2) [note: 'The standard monthly subscription price for this platform in the billing currency. Applicable for SVOD and HYBRID tiers. Null for AVOD and FAST platforms with no subscription fee. Used in Zuora plan configuration and financial forecasting in SAP S/4HANA. | Column base_subscription_price (DECIMAL(10,2)) in distribution.ott_platform']
  billing_currency varchar [note: 'ISO 4217 three-letter currency code for the primary billing currency used on this platform (e.g., \'USD\', \'GBP\', \'EUR\'). Governs Zuora subscription plan pricing, SAP S/4HANA financial reconciliation, and multi-currency revenue reporting. | Column billing_currency (STRING) in distribution.ott_platform']
  cdn_origin_url varchar [note: 'The base origin URL configured in the CDN for this platform\'s content delivery. Used by Akamai CDN to route requests to the correct media origin server. Critical for CDN configuration audits and incident troubleshooting. | Column cdn_origin_url (STRING) in distribution.ott_platform']
  cdn_provider varchar [note: 'The primary CDN provider contracted to deliver streaming content for this OTT platform. Drives SLA monitoring, peering agreements, and cost allocation. \'Multi-CDN\' indicates a load-balanced or failover configuration across multiple providers. Maps to Akamai CDN platform configuration records. | Column cdn_provider (STRING) in distribution.ott_platform']
  content_rating_system varchar [note: 'The content classification and rating system applied to content on this platform (e.g., MPAA for USA, BBFC for UK, FSK for Germany). Governs parental control enforcement, COPPA compliance for children\'s content, and MPA anti-piracy obligations. | Column content_rating_system (STRING) in distribution.ott_platform']
  coppa_compliant boolean [note: 'Indicates whether this platform is designated as COPPA-compliant, meaning it is directed at children under 13 and adheres to COPPA data collection restrictions. True = COPPA-compliant children\'s platform; False = general audience platform. Drives data collection policies in Adobe Experience Platform and ad targeting restrictions. | Column coppa_compliant (BOOLEAN) in distribution.ott_platform']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.ott_platform']
  created_timestamp timestamp [note: 'The timestamp when this OTT platform record was first created in the master registry. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Used for data lineage, audit trails, and Silver layer ingestion tracking. | Column created_timestamp (TIMESTAMP) in distribution.ott_platform']
  dai_enabled boolean [note: 'Indicates whether Dynamic Ad Insertion is active on this platform, enabling server-side ad stitching into the stream. True = DAI active (relevant for AVOD and HYBRID tiers); False = no DAI. Drives ad operations workflow in Wide Orbit and ad campaign targeting in Salesforce Media Cloud. | Column dai_enabled (BOOLEAN) in distribution.ott_platform']
  dai_provider varchar [note: 'The technology vendor or platform providing DAI services for this OTT platform (e.g., \'Google DAI\', \'FreeWheel\', \'Yospace\', \'Brightcove SSAI\'). Null if DAI is not enabled. Used for vendor management, SLA tracking, and ad revenue reconciliation. | Column dai_provider (STRING) in distribution.ott_platform']
  distribution_verified boolean [note: 'Flag indicating distribution verification']
  drm_system varchar [note: 'The DRM technology binding enforced on this platform for content protection. Widevine = Google DRM for Android/Chrome; FairPlay = Apple DRM for iOS/Safari; PlayReady = Microsoft DRM for Windows/Xbox; Multi-DRM = all three enforced simultaneously; NONE = no DRM (e.g., FAST free content). Directly linked to Rightsline rights window enforcement and content clearance workflows. | Column drm_system (STRING) in distribution.ott_platform']
  epg_feed_url varchar [note: 'The URL of the Electronic Program Guide data feed for this platform, used by third-party EPG aggregators, smart TV manufacturers, and vMVPD partners to display scheduling information. Null for pure VOD platforms without a linear schedule. Sourced from Ericsson MediaFirst playout system. | Column epg_feed_url (STRING) in distribution.ott_platform']
  fast_channel_enabled boolean [note: 'Indicates whether this platform operates or hosts FAST channels — linear-style, ad-supported free streaming channels. True = FAST channel delivery active; False = no FAST channel. Relevant for FAST syndication partnerships and Wide Orbit ad scheduling. | Column fast_channel_enabled (BOOLEAN) in distribution.ott_platform']
  free_trial_days varchar [note: 'Number of days in the free trial period offered to new subscribers on this platform. Zero or null if no free trial is offered. Configured in Zuora subscription plans and used in churn rate and LTV analysis. | Column free_trial_days (INT) in distribution.ott_platform']
  gdpr_applicable boolean [note: 'Indicates whether GDPR data protection obligations apply to this platform based on its geographic availability and subscriber base. True = GDPR applies (EU/EEA territories served); False = GDPR not applicable. Governs consent management, data subject rights workflows, and Adobe Experience Platform profile handling. | Column gdpr_applicable (BOOLEAN) in distribution.ott_platform']
  hdr_supported boolean [note: 'Indicates whether the platform supports High Dynamic Range video delivery (HDR10, Dolby Vision, or HLG). True = HDR delivery supported; False = SDR only. Relevant for premium content licensing negotiations and CTV device compatibility. | Column hdr_supported (BOOLEAN) in distribution.ott_platform']
  launch_date date [note: 'The calendar date on which the OTT platform was officially made available to the public or target subscriber base. Used for platform age calculations, anniversary promotions, and regulatory reporting of service commencement. | Column launch_date (DATE) in distribution.ott_platform']
  max_concurrent_streams varchar [note: 'The maximum number of simultaneous streams permitted per subscriber account on this platform. Enforced at the entitlement layer to prevent credential sharing and manage CDN bandwidth capacity. A key parameter in Zuora subscription plan configuration. | Column max_concurrent_streams (INT) in distribution.ott_platform']
  max_download_devices varchar [note: 'The maximum number of devices on which a subscriber may store downloaded content for offline viewing on this platform. Null if offline downloads are not supported. Governed by DRM policy and Rightsline windowing rules. | Column max_download_devices (INT) in distribution.ott_platform']
  max_video_resolution varchar [note: 'The highest video resolution tier supported for streaming on this platform. SD = Standard Definition (480p); HD = High Definition (720p); FHD = Full HD (1080p); 4K = Ultra HD (2160p); 8K = Super Hi-Vision (4320p). Drives ABR profile configuration, CDN bandwidth planning, and content ingest specifications in Dalet Galaxy. | Column max_video_resolution (STRING) in distribution.ott_platform']
  mvpd_carriage_eligible boolean [note: 'Indicates whether this OTT platform\'s content or channels are eligible for carriage by MVPD or vMVPD partners (cable, satellite, virtual pay-TV operators). True = eligible for carriage agreements; False = direct-to-consumer only. Governs retransmission consent and must-carry negotiations. | Column mvpd_carriage_eligible (BOOLEAN) in distribution.ott_platform']
  parent_brand varchar [note: 'The overarching corporate or media brand under which this OTT platform operates (e.g., \'Media Broadcasting Group\', \'MB Sports Network\'). Supports brand hierarchy reporting, consolidated audience measurement, and multi-brand advertising sales in Salesforce Media Cloud. | Column parent_brand (STRING) in distribution.ott_platform']
  platform_code varchar [note: 'Externally-known, human-readable unique code assigned to the OTT platform (e.g., \'MB_SVOD_WEB\', \'MB_AVOD_CTV\'). Used in operational systems, contracts, and partner integrations as the canonical platform identifier. Maps to the platform identifier used in Zuora subscription plans and Akamai CDN configuration. | Column platform_code (STRING) in distribution.ott_platform']
  platform_description varchar [note: 'Detailed narrative description of the platform\'s content offering, target audience, and service proposition. Used in partner onboarding documentation, regulatory filings, and internal product catalogues. | Column platform_description (STRING) in distribution.ott_platform']
  platform_name varchar [note: 'Official commercial brand name of the OTT platform as presented to subscribers and partners (e.g., \'MediaBroadcast+\', \'MB Sports Live\'). Used in marketing materials, EPG listings, and subscriber-facing interfaces. | Column platform_name (STRING) in distribution.ott_platform']
  platform_status varchar [note: 'Current lifecycle state of the OTT platform. \'active\' = live and serving audiences; \'beta\' = limited release for testing; \'sunset\' = scheduled for decommission; \'suspended\' = temporarily offline; \'inactive\' = decommissioned. Governs whether the platform is eligible for new subscriber acquisition, ad campaign targeting, and CDN resource allocation. | Column platform_status (STRING) in distribution.ott_platform']
  primary_streaming_protocol varchar [note: 'The primary adaptive bitrate streaming protocol used for content delivery on this platform. HLS = HTTP Live Streaming (Apple standard, widely supported); MPEG-DASH = Dynamic Adaptive Streaming over HTTP (ISO 23009 standard); RTMP = Real-Time Messaging Protocol (legacy live); SRT = Secure Reliable Transport (low-latency live). Drives CDN configuration in Akamai and player SDK selection. | Column primary_streaming_protocol (STRING) in distribution.ott_platform']
  programmatic_enabled boolean [note: 'Flag indicating programmatic advertising support']
  secondary_streaming_protocol varchar [note: 'Fallback or secondary adaptive bitrate streaming protocol supported by the platform for device compatibility or redundancy. Null or \'NONE\' if only one protocol is used. Supports multi-protocol CDN origin configuration in Akamai. | Column secondary_streaming_protocol (STRING) in distribution.ott_platform']
  service_tier varchar [note: 'Business model classification of the OTT platform. SVOD = Subscription Video On Demand (recurring fee, no ads); AVOD = Advertising-Supported Video On Demand (free with ads); TVOD = Transactional Video On Demand (pay-per-view); FAST = Free Ad-Supported Streaming Television (linear-style free channel); HYBRID = combination of tiers. Drives revenue recognition logic in Zuora and ad inventory management in Wide Orbit. | Column service_tier (STRING) in distribution.ott_platform']
  sla_uptime_target_pct decimal(5,2) [note: 'The contractually committed platform availability target expressed as a percentage (e.g., 99.95). Governs CDN SLA enforcement with Akamai, incident escalation thresholds, and operational reporting. Distinct from actual measured uptime. | Column sla_uptime_target_pct (DECIMAL(5,2)) in distribution.ott_platform']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.ott_platform']
  subscriber_count varchar [note: 'Current count of active paying or registered subscribers on this platform as of the last reconciliation cycle. A key operational metric for ARPU calculation, churn rate monitoring, and Zuora revenue reporting. Confidential as it represents commercially sensitive business performance data. | Column subscriber_count (BIGINT) in distribution.ott_platform']
  sunset_date date [note: 'Planned or actual date on which the OTT platform will be or was decommissioned. Null if the platform has no scheduled end-of-life. Used for subscriber migration planning, contract wind-down, and CDN resource deallocation. | Column sunset_date (DATE) in distribution.ott_platform']
  supported_device_classes varchar [note: 'Comma-separated list of device categories supported by this platform (e.g., \'web,mobile,ctv,stb,gaming_console\'). Drives device compatibility testing, app store distribution, and audience reach reporting. [ENUM-REF-CANDIDATE: web|mobile|ctv|stb|gaming_console|smart_tv|tablet — promote to reference product] | Column supported_device_classes (STRING) in distribution.ott_platform']
  target_start_bitrate_kbps varchar [note: 'The minimum target bitrate in kilobits per second at which the ABR player should initiate playback on this platform. Drives ABR profile ladder configuration in Akamai CDN and QoS monitoring thresholds. Key parameter for streaming quality benchmarking. | Column target_start_bitrate_kbps (INT) in distribution.ott_platform']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.ott_platform']
  updated_timestamp timestamp [note: 'The timestamp when this OTT platform record was most recently modified. Follows ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Used for change data capture (CDC) in the Databricks Silver layer pipeline and audit compliance. | Column updated_timestamp (TIMESTAMP) in distribution.ott_platform']
  zuora_product_code varchar [note: 'The product identifier in Zuora\'s subscription billing platform corresponding to this OTT platform\'s subscription offering. Used for revenue recognition, invoice generation, and subscription lifecycle management. Links the platform master record to Zuora\'s billing product catalogue. | Column zuora_product_code (STRING) in distribution.ott_platform']

  Note: 'Master registry of all OTT service platforms operated by Media Broadcasting — web, mobile, connected TV (CTV), and set-top box (STB). Captures platform identity, service tier (SVOD, AVOD, TVOD, FAST), launch date, supported protocols (HLS, MPEG-DASH), DRM system bindings, CDN provider assignments, geographic availability, regulatory jurisdiction, brand identity, and operational status. This is the SSOT anchor for the entire platform domain — all other platform products reference back to this entity. | Unity Catalog table: media_broadcasting_ecm.distribution.ott_platform'
}

Table distribution.device_type {
  device_type_id varchar [pk, note: 'Unique identifier for the device type record. Primary key. | Column device_type_id (BIGINT) in distribution.device_type']
  broadcast_standard_id varchar [note: 'Foreign key linking to technology.broadcast_standard. Business justification: Device types support specific broadcast standards (ATSC 3.0, DVB-T2). Required for device certification and broadcast standard support matrix. | Column broadcast_standard_id (BIGINT) in technology.device_type']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.device_type']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.device_type']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.device_type']
  abr_profile_dash boolean [note: 'Indicates whether the device supports MPEG-DASH (Dynamic Adaptive Streaming over HTTP) adaptive bitrate streaming protocol. | Column abr_profile_dash (BOOLEAN) in distribution.device_type']
  abr_profile_hls boolean [note: 'Indicates whether the device supports HLS (HTTP Live Streaming) adaptive bitrate streaming protocol. | Column abr_profile_hls (BOOLEAN) in distribution.device_type']
  abr_profile_smooth boolean [note: 'Indicates whether the device supports Microsoft Smooth Streaming adaptive bitrate protocol. | Column abr_profile_smooth (BOOLEAN) in distribution.device_type']
  active_install_base varchar [note: 'Estimated number of active devices of this type currently accessing the OTT platform, used for capacity planning and analytics. | Column active_install_base (BIGINT) in distribution.device_type']
  certification_date date [note: 'Date when the device successfully completed OTT platform certification testing. | Column certification_date (DATE) in distribution.device_type']
  certification_expiry_date date [note: 'Date when the device certification expires and requires re-certification for continued platform support. | Column certification_expiry_date (DATE) in distribution.device_type']
  certification_status varchar [note: 'Current certification status of the device for OTT platform compatibility (certified, pending, failed, not_tested). | Column certification_status (STRING) in distribution.device_type']
  codec_audio_support varchar [note: 'List of audio codecs supported by the device (e.g., AAC, Dolby Digital, Dolby Atmos, DTS). Pipe-separated list. | Column codec_audio_support (STRING) in distribution.device_type']
  codec_video_support varchar [note: 'List of video codecs supported by the device (e.g., H.264, H.265/HEVC, VP9, AV1). Pipe-separated list. | Column codec_video_support (STRING) in distribution.device_type']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.device_type']
  created_timestamp timestamp [note: 'Timestamp when this device type record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.device_type']
  dai_supported boolean [note: 'Indicates whether the device supports DAI (Dynamic Ad Insertion) for server-side ad stitching in streaming content. | Column dai_supported (BOOLEAN) in distribution.device_type']
  device_category varchar [note: 'High-level classification of the device type (e.g., smart TV, mobile phone, tablet, desktop browser, streaming stick, gaming console, set-top box). [ENUM-REF-CANDIDATE: smart_tv|mobile_phone|tablet|desktop_browser|streaming_stick|gaming_console|set_top_box — 7 candidates stripped; promote to reference product] | Column device_category (STRING) in distribution.device_type']
  drm_fairplay_supported boolean [note: 'Indicates whether the device supports Apple FairPlay DRM for content protection. | Column drm_fairplay_supported (BOOLEAN) in distribution.device_type']
  drm_playready_supported boolean [note: 'Indicates whether the device supports Microsoft PlayReady DRM for content protection. | Column drm_playready_supported (BOOLEAN) in distribution.device_type']
  drm_widevine_level varchar [note: 'Google Widevine DRM security level supported (L1 = hardware-backed, L2 = software-backed, L3 = software only, not_supported). | Column drm_widevine_level (STRING) in distribution.device_type']
  form_factor varchar [note: 'Physical form factor of the device (handheld, television, desktop, wearable, embedded). | Column form_factor (STRING) in distribution.device_type']
  hdr_capable boolean [note: 'Indicates whether the device supports HDR (High Dynamic Range) video playback for enhanced color and contrast. | Column hdr_capable (BOOLEAN) in distribution.device_type']
  hdr_format varchar [note: 'Specific HDR formats supported by the device (e.g., HDR10, HDR10+, Dolby Vision, HLG). Pipe-separated list if multiple formats are supported. | Column hdr_format (STRING) in distribution.device_type']
  input_method varchar [note: 'Primary input method(s) supported by the device (e.g., touchscreen, remote_control, keyboard_mouse, voice, gamepad). Pipe-separated list if multiple. | Column input_method (STRING) in distribution.device_type']
  is_active boolean [note: 'Indicates whether this device type is currently active and supported for OTT platform streaming. | Column is_active (BOOLEAN) in distribution.device_type']
  manufacturer varchar [note: 'Name of the device manufacturer or brand (e.g., Samsung, Apple, Roku, Amazon, LG, Sony). | Column manufacturer (STRING) in distribution.device_type']
  max_bitrate_mbps decimal(10,2) [note: 'Maximum streaming bitrate supported by the device in megabits per second (Mbps), used for ABR profile selection and QoS (Quality of Service) optimization. | Column max_bitrate_mbps (DECIMAL(10,2)) in distribution.device_type']
  model_name varchar [note: 'Specific model name or identifier assigned by the manufacturer (e.g., Galaxy S21, iPhone 13 Pro, Fire TV Stick 4K). | Column model_name (STRING) in distribution.device_type']
  model_number varchar [note: 'Technical model number or SKU (Stock Keeping Unit) used for precise device identification and inventory tracking. | Column model_number (STRING) in distribution.device_type']
  network_capability varchar [note: 'Network connectivity capabilities of the device (e.g., wifi, ethernet, cellular_4g, cellular_5g). Pipe-separated list if multiple. | Column network_capability (STRING) in distribution.device_type']
  os_family varchar [note: 'Operating system family running on the device (e.g., Android, iOS, tvOS, webOS, Tizen, Roku OS, Fire OS, Windows, macOS, Linux, PlayStation, Xbox). [ENUM-REF-CANDIDATE: android|ios|tvos|webos|tizen|roku_os|fire_os|windows|macos|linux|playstation|xbox — 12 candidates stripped; promote to reference product] | Column os_family (STRING) in distribution.device_type']
  os_version_max varchar [note: 'Maximum OS version tested and certified for compatibility. Null indicates no upper bound. | Column os_version_max (STRING) in distribution.device_type']
  os_version_min varchar [note: 'Minimum OS version required for OTT (Over-The-Top) platform compatibility and playback support. | Column os_version_min (STRING) in distribution.device_type']
  qos_tier varchar [note: 'QoS tier assigned to the device type for streaming quality segmentation and CDN (Content Delivery Network) routing (premium, standard, basic). | Column qos_tier (STRING) in distribution.device_type']
  screen_resolution_class varchar [note: 'Display resolution category supported by the device (SD, HD, Full HD, 4K UHD (Ultra High Definition), 8K UHD). | Column screen_resolution_class (STRING) in distribution.device_type']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.device_type']
  support_end_date date [note: 'Date when platform support for this device type will be discontinued, after which playback may no longer be guaranteed. | Column support_end_date (DATE) in distribution.device_type']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.device_type']
  updated_timestamp timestamp [note: 'Timestamp when this device type record was last modified. | Column updated_timestamp (TIMESTAMP) in distribution.device_type']
  user_agent_string varchar [note: 'Standard HTTP user agent string reported by the device, used for device detection and analytics. | Column user_agent_string (STRING) in distribution.device_type']

  Note: 'Reference catalog of all device categories and models supported across OTT platforms — smart TVs, mobile phones, tablets, desktop browsers, streaming sticks, gaming consoles, and STBs. Captures device category, manufacturer, OS family, OS version range, screen resolution class, HDR capability, DRM compatibility (Widevine, PlayReady, FairPlay), ABR profile support, and certification status. Used for device-specific playback configuration and QoS segmentation. | Unity Catalog table: media_broadcasting_ecm.distribution.device_type'
}

Table distribution.app_version {
  app_version_id varchar [pk, note: 'Unique identifier for each application version release. Primary key for the app_version product. | Column app_version_id (BIGINT) in distribution.app_version']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Each app version must demonstrate compliance with accessibility standards. Version-specific accessibility features (screen reader support, caption rendering) are validated against applicable obligatio | Column accessibility_obligation_id (BIGINT) in compliance.app_version']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Each app version is built for a specific OTT platform. app_version.platform is STRING but should FK to ott_platform master. Removes platform_type (derivable from ott_platform.platform_code). | Column ott_platform_id (BIGINT) in distribution.app_version']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.app_version']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.app_version']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.app_version']
  ab_test_cohort varchar [note: 'Identifier for the A/B test cohort or experiment group assigned to this application version. Used for controlled feature testing and user experience optimization. | Column ab_test_cohort (STRING) in distribution.app_version']
  active_install_count varchar [note: 'The current number of active installations of this application version across all users. Used for version adoption tracking and deprecation planning. | Column active_install_count (BIGINT) in distribution.app_version']
  analytics_sdk_version varchar [note: 'Version of the analytics SDK integrated for tracking user engagement, viewership metrics, and QoS (Quality of Service) data. | Column analytics_sdk_version (STRING) in distribution.app_version']
  app_size_mb decimal(10,2) [note: 'The total download size of the application package in megabytes. Important for user download experience and app store requirements. | Column app_size_mb (DECIMAL(10,2)) in distribution.app_version']
  build_number varchar [note: 'Internal build identifier assigned by the continuous integration system. Used for precise version tracking and debugging. May be numeric or alphanumeric. | Column build_number (STRING) in distribution.app_version']
  ccpa_compliant boolean [note: 'Indicates whether this application version meets CCPA (California Consumer Privacy Act) requirements for viewer data privacy in California. | Column ccpa_compliant (BOOLEAN) in distribution.app_version']
  cdn_endpoint_url varchar [note: 'The primary CDN (Content Delivery Network) endpoint URL configured for this application version. Determines content delivery infrastructure and streaming performance. | Column cdn_endpoint_url (STRING) in distribution.app_version']
  closed_caption_support boolean [note: 'Indicates whether this application version supports closed captioning and subtitles for accessibility compliance. | Column closed_caption_support (BOOLEAN) in distribution.app_version']
  crash_reporting_enabled boolean [note: 'Indicates whether automated crash reporting and error tracking is enabled for this application version. Critical for QoS root-cause analysis. | Column crash_reporting_enabled (BOOLEAN) in distribution.app_version']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.app_version']
  created_timestamp timestamp [note: 'The timestamp when this application version record was first created in the system. Used for audit trail and version history tracking. | Column created_timestamp (TIMESTAMP) in distribution.app_version']
  dai_enabled boolean [note: 'Indicates whether this application version supports DAI (Dynamic Ad Insertion) for server-side ad stitching in streaming content. | Column dai_enabled (BOOLEAN) in distribution.app_version']
  dash_support_enabled boolean [note: 'Indicates whether this application version supports MPEG-DASH (Dynamic Adaptive Streaming over HTTP) protocol for video streaming. | Column dash_support_enabled (BOOLEAN) in distribution.app_version']
  deprecation_date date [note: 'The date when this application version will be officially deprecated and no longer supported. Nullable for current production versions. | Column deprecation_date (DATE) in distribution.app_version']
  dolby_atmos_enabled boolean [note: 'Indicates whether this application version supports Dolby Atmos immersive audio technology. | Column dolby_atmos_enabled (BOOLEAN) in distribution.app_version']
  drm_library_version varchar [note: 'Version of the DRM (Digital Rights Management) library integrated into this application build. Critical for content protection and license enforcement compliance. | Column drm_library_version (STRING) in distribution.app_version']
  feature_flags varchar [note: 'Comma-separated list or JSON string of feature flags enabled in this application version. Controls experimental features, A/B test variants, and gradual rollout capabilities. | Column feature_flags (STRING) in distribution.app_version']
  force_upgrade_threshold varchar [note: 'The minimum application version number below which users will be forced to upgrade. Used to enforce critical security patches or deprecate incompatible versions. | Column force_upgrade_threshold (STRING) in distribution.app_version']
  gdpr_compliant boolean [note: 'Indicates whether this application version meets GDPR (General Data Protection Regulation) requirements for user data privacy and consent management in EU markets. | Column gdpr_compliant (BOOLEAN) in distribution.app_version']
  hdr_support_enabled boolean [note: 'Indicates whether this application version supports HDR (High Dynamic Range) video playback for enhanced picture quality. | Column hdr_support_enabled (BOOLEAN) in distribution.app_version']
  hls_support_enabled boolean [note: 'Indicates whether this application version supports HLS (HTTP Live Streaming) protocol for adaptive bitrate video delivery. | Column hls_support_enabled (BOOLEAN) in distribution.app_version']
  internal_notes varchar [note: 'Internal technical notes and documentation for this application version. Includes deployment instructions, known issues, and rollback procedures. | Column internal_notes (STRING) in distribution.app_version']
  max_bitrate_mbps decimal(8,2) [note: 'The maximum streaming bitrate supported by this application version in Mbps. Determines highest video quality available through ABR (Adaptive Bitrate Streaming). | Column max_bitrate_mbps (DECIMAL(8,2)) in distribution.app_version']
  minimum_os_version varchar [note: 'The minimum operating system version required to run this application version. Format varies by platform (e.g., iOS 14.0, Android 10, Roku OS 9.4). | Column minimum_os_version (STRING) in distribution.app_version']
  offline_playback_enabled boolean [note: 'Indicates whether this application version supports offline content download and playback for SVOD (Subscription Video On Demand) users. | Column offline_playback_enabled (BOOLEAN) in distribution.app_version']
  parental_control_enabled boolean [note: 'Indicates whether this application version includes parental control features for content rating enforcement and child safety. | Column parental_control_enabled (BOOLEAN) in distribution.app_version']
  platform varchar [note: 'The OTT (Over-The-Top) platform or operating system for which this application version was built. Determines device compatibility and distribution channel. [ENUM-REF-CANDIDATE: iOS|Android|tvOS|Roku|Fire TV|Samsung Tizen|LG webOS|Xbox|PlayStation|Web — 10 candidates stripped; promote to reference product] | Column platform (STRING) in distribution.app_version']
  player_sdk_version varchar [note: 'Version of the video player SDK embedded in this application. Determines streaming capabilities, ABR (Adaptive Bitrate Streaming) support, and playback features. | Column player_sdk_version (STRING) in distribution.app_version']
  release_date date [note: 'The date when this application version was officially released to production and made available to end users through app stores or distribution channels. | Column release_date (DATE) in distribution.app_version']
  release_notes varchar [note: 'User-facing description of new features, bug fixes, and improvements included in this application version. Published in app stores and update notifications. | Column release_notes (STRING) in distribution.app_version']
  release_status varchar [note: 'Current lifecycle status of the application version. Tracks progression from development through production release to eventual deprecation. [ENUM-REF-CANDIDATE: development|alpha|beta|release_candidate|released|deprecated|withdrawn — 7 candidates stripped; promote to reference product] | Column release_status (STRING) in distribution.app_version']
  rollout_percentage decimal(5,2) [note: 'The percentage of users to whom this application version is currently deployed. Used for gradual rollout and canary deployment strategies (0.00 to 100.00). | Column rollout_percentage (DECIMAL(5,2)) in distribution.app_version']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.app_version']
  supported_resolutions varchar [note: 'Comma-separated list of video resolutions supported by this application version (e.g., 480p, 720p, 1080p, 4K). Determines playback quality options. | Column supported_resolutions (STRING) in distribution.app_version']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.app_version']
  updated_timestamp timestamp [note: 'The timestamp when this application version record was last modified. Tracks changes to version metadata, status updates, and configuration changes. | Column updated_timestamp (TIMESTAMP) in distribution.app_version']
  version_number varchar [note: 'Semantic version number of the application release following major.minor.patch format (e.g., 3.2.1, 4.0.0-beta). This is the externally-known identifier for the release. | Column version_number (STRING) in distribution.app_version']

  Note: 'Tracks all released and in-flight versions of the Media Broadcasting OTT client applications across platforms (iOS, Android, tvOS, Roku, Fire TV, Samsung Tizen, LG webOS, Xbox, PlayStation). Captures app version number, platform target, release date, minimum OS version, feature flags enabled, DRM library version, player SDK version, A/B test cohort assignments, force-upgrade threshold, and deprecation date. Critical for QoS root-cause analysis and rollout management. | Unity Catalog table: media_broadcasting_ecm.distribution.app_version'
}

Table distribution.streaming_endpoint {
  streaming_endpoint_id varchar [pk, note: 'Unique identifier for the streaming endpoint. Primary key for the streaming endpoint master record. | Column streaming_endpoint_id (BIGINT) in distribution.streaming_endpoint']
  abr_profile_id varchar [note: 'Foreign key linking to distribution.abr_profile. Business justification: Streaming endpoints use specific ABR profiles. streaming_endpoint.abr_profile_reference is STRING but should FK to abr_profile master. Removes abr_profile_reference STRING. | Column abr_profile_id (BIGINT) in distribution.streaming_endpoint']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Streaming endpoints are physically hosted in broadcast facilities. Required for facility outage impact analysis, power/cooling capacity planning, and physical security management. | Column broadcast_facility_id (BIGINT) in technology.streaming_endpoint']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Streaming endpoints delivering broadcast content must comply with originating broadcast license terms for geographic restrictions, transmission standards, and regulatory reporting. License governs end | Column broadcast_license_id (BIGINT) in compliance.streaming_endpoint']
  cdn_configuration_id varchar [note: 'Foreign key linking to distribution.cdn_configuration. Business justification: Streaming endpoints use specific CDN configurations. streaming_endpoint.cdn_provider is STRING but should FK to cdn_configuration. Removes cdn_provider STRING. | Column cdn_configuration_id (BIGINT) in distribution.streaming_endpoint']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Streaming endpoints incur CDN and hosting costs that must be allocated to technology cost centers for chargeback and budget management. Monthly CDN invoice reconciliation allocates bandwidth and compu | Column cost_center_id (BIGINT) in finance.streaming_endpoint']
  dai_configuration_id varchar [note: 'Foreign key linking to distribution.dai_configuration. Business justification: Streaming endpoints can have default DAI configurations. Removes dai_provider STRING (derivable from dai_configuration). | Column dai_configuration_id (BIGINT) in distribution.streaming_endpoint']
  drm_policy_id varchar [note: 'Foreign key linking to distribution.drm_policy. Business justification: Streaming endpoints enforce specific DRM policies. streaming_endpoint.drm_system is STRING but should FK to drm_policy. Removes drm_system STRING (derivable from drm_policy.drm_system). | Column drm_policy_id (BIGINT) in distribution.streaming_endpoint']
  encoder_config_id varchar [note: 'Foreign key linking to technology.encoder_config. Business justification: Streaming endpoints receive feeds from encoder configurations. Required for encoder-endpoint signal routing and configuration management. | Column encoder_config_id (BIGINT) in technology.streaming_endpoint']
  failover_endpoint_id varchar [note: 'Reference to the backup streaming endpoint that should be used if this endpoint becomes unavailable. Supports high availability and disaster recovery. | Column failover_endpoint_id (BIGINT) in distribution.streaming_endpoint']
  maintenance_work_order_id varchar [note: 'Foreign key linking to technology.maintenance_work_order. Business justification: Streaming endpoints require maintenance work orders for updates and repairs. Required for endpoint maintenance history and downtime impact tracking. | Column maintenance_work_order_id (BIGINT) in technology.streaming_endpoint']
  market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: CDN endpoints serve specific DMAs for geo-restriction enforcement, local ad insertion, and market-specific content delivery. Required for retransmission consent compliance and must-carry obligations i | Column market_coverage_id (BIGINT) in audience.streaming_endpoint']
  network_circuit_id varchar [note: 'Foreign key linking to technology.network_circuit. Business justification: Streaming endpoints rely on network circuits for connectivity. Required for circuit capacity planning and endpoint failover configuration. | Column network_circuit_id (BIGINT) in technology.streaming_endpoint']
  noc_monitor_id varchar [note: 'Foreign key linking to technology.noc_monitor. Business justification: Streaming endpoints have assigned NOC monitors tracking uptime and latency. Required for NOC monitoring configuration and alert routing. | Column noc_monitor_id (BIGINT) in technology.streaming_endpoint']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Streaming endpoints are provisioned for specific OTT platforms. Each endpoint serves content for a platform. No visible platform_type column but relationship is essential for endpoint management. | Column ott_platform_id (BIGINT) in distribution.streaming_endpoint']
  outage_record_id varchar [note: 'Foreign key linking to technology.outage_record. Business justification: Streaming endpoints experience outages requiring tracking. Required for endpoint availability reporting and outage pattern analysis. | Column outage_record_id (BIGINT) in technology.streaming_endpoint']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Streaming endpoints serve specific geographic territories. Essential for enforcing geo-restriction rules per rights grants, validating territory-based rights compliance, and routing playback sessions  | Column rights_territory_id (BIGINT) in rights.streaming_endpoint']
  sla_definition_id varchar [note: 'Foreign key linking to distribution.sla_definition. Business justification: Streaming endpoints have SLA commitments. streaming_endpoint.sla_tier is STRING but should FK to sla_definition. Removes sla_tier STRING (derivable from sla_definition.sla_tier). | Column sla_definition_id (BIGINT) in distribution.streaming_endpoint']
  software_license_id varchar [note: 'Foreign key linking to technology.software_license. Business justification: Streaming endpoints run licensed CDN and DRM software. Required for software license compliance tracking and endpoint cost allocation. | Column software_license_id (BIGINT) in technology.streaming_endpoint']
  tech_project_id varchar [note: 'Foreign key linking to technology.tech_project. Business justification: Streaming endpoints are deployed via CDN expansion projects. Required for CDN project ROI analysis and endpoint deployment timeline tracking. | Column tech_project_id (BIGINT) in technology.streaming_endpoint']
  tech_sla_id varchar [note: 'Foreign key linking to technology.tech_sla. Business justification: Streaming endpoints have technology SLAs for uptime and latency. Required for endpoint SLA compliance reporting and performance benchmarking. | Column tech_sla_id (BIGINT) in technology.streaming_endpoint']
  technical_owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Streaming endpoints are critical infrastructure requiring technical ownership for incident response, maintenance windows, configuration changes, and failover testing. Essential for on-call rotations,  | Column technical_owner_employee_id (BIGINT) in workforce.streaming_endpoint']
  technical_standard_cert_id varchar [note: 'Foreign key linking to compliance.technical_standard_cert. Business justification: Streaming endpoints must be certified against technical standards (HLS spec, DASH spec, DRM robustness, accessibility). Each endpoint references its certification records for compliance validation. | Column technical_standard_cert_id (BIGINT) in compliance.streaming_endpoint']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Streaming endpoints rely on transmission equipment (encoders, transcoders). Required for equipment failure impact analysis and encoder capacity management. | Column transmission_equipment_id (BIGINT) in technology.streaming_endpoint']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.streaming_endpoint']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.streaming_endpoint']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.streaming_endpoint']
  activated_timestamp timestamp [note: 'The date and time when this endpoint was first activated and began serving live traffic. | Column activated_timestamp (TIMESTAMP) in distribution.streaming_endpoint']
  bandwidth_limit_gbps decimal(10,2) [note: 'Maximum aggregate bandwidth capacity in gigabits per second allocated to this endpoint. Used for capacity planning and cost management. | Column bandwidth_limit_gbps (DECIMAL(10,2)) in distribution.streaming_endpoint']
  cache_ttl_seconds varchar [note: 'The duration in seconds that content should be cached at edge locations before refreshing from origin. Balances freshness with CDN efficiency. | Column cache_ttl_seconds (INT) in distribution.streaming_endpoint']
  cost_per_gb decimal(10,4) [note: 'The CDN provider\'s charge per gigabyte of data transferred through this endpoint. Used for cost allocation and financial forecasting. | Column cost_per_gb (DECIMAL(10,4)) in distribution.streaming_endpoint']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.streaming_endpoint']
  created_timestamp timestamp [note: 'The date and time when this streaming endpoint record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.streaming_endpoint']
  dai_enabled boolean [note: 'Indicates whether this endpoint supports Dynamic Ad Insertion, allowing personalized ads to be stitched into the stream in real-time. | Column dai_enabled (BOOLEAN) in distribution.streaming_endpoint']
  deactivated_timestamp timestamp [note: 'The date and time when this endpoint was deactivated or taken out of service. Null if currently active. | Column deactivated_timestamp (TIMESTAMP) in distribution.streaming_endpoint']
  drm_license_server_url varchar [note: 'URL of the DRM license server that provides decryption keys and enforces content protection policies for this endpoint. Critical for securing premium content. | Column drm_license_server_url (STRING) in distribution.streaming_endpoint']
  endpoint_name varchar [note: 'Human-readable name or label for the streaming endpoint, used for identification and operational reference. | Column endpoint_name (STRING) in distribution.streaming_endpoint']
  endpoint_type varchar [note: 'Classification of the endpoint role within the CDN architecture. Origin endpoints serve as the source, edge endpoints serve end users, and backup endpoints provide failover capability. | Column endpoint_type (STRING) in distribution.streaming_endpoint']
  endpoint_url varchar [note: 'The full URL address of the streaming endpoint, including protocol, domain, and path. This is the technical delivery address for the stream. | Column endpoint_url (STRING) in distribution.streaming_endpoint']
  geo_restriction_mode varchar [note: 'Defines whether geo_restriction_rules represent an allow list (whitelist) or deny list (blacklist) for content delivery. | Column geo_restriction_mode (STRING) in distribution.streaming_endpoint']
  geo_restriction_rules varchar [note: 'Comma-separated list of ISO country codes or regions where content delivery is allowed or blocked. Enforces territorial licensing and rights management requirements. | Column geo_restriction_rules (STRING) in distribution.streaming_endpoint']
  health_check_interval_seconds varchar [note: 'Frequency in seconds at which automated health checks are performed against this endpoint. | Column health_check_interval_seconds (INT) in distribution.streaming_endpoint']
  health_check_url varchar [note: 'URL endpoint used for automated health monitoring and availability checks. Returns status codes indicating endpoint health. | Column health_check_url (STRING) in distribution.streaming_endpoint']
  ipv6_enabled boolean [note: 'Indicates whether this endpoint supports IPv6 addressing in addition to IPv4, enabling delivery to modern network infrastructures. | Column ipv6_enabled (BOOLEAN) in distribution.streaming_endpoint']
  last_health_check_timestamp timestamp [note: 'The date and time of the most recent successful health check performed on this endpoint. | Column last_health_check_timestamp (TIMESTAMP) in distribution.streaming_endpoint']
  manifest_format varchar [note: 'The streaming manifest file format used by this endpoint. m3u8 for HLS, mpd for MPEG-DASH, ism for Smooth Streaming, f4m for Adobe HDS. | Column manifest_format (STRING) in distribution.streaming_endpoint']
  max_bitrate_mbps decimal(10,2) [note: 'The maximum streaming bitrate in megabits per second that this endpoint can deliver. Defines the upper quality limit for adaptive streaming. | Column max_bitrate_mbps (DECIMAL(10,2)) in distribution.streaming_endpoint']
  modified_timestamp timestamp [note: 'The date and time when this streaming endpoint record was last modified or updated. | Column modified_timestamp (TIMESTAMP) in distribution.streaming_endpoint']
  operational_status varchar [note: 'Current operational state of the streaming endpoint. Active endpoints are serving traffic; inactive endpoints are provisioned but not in use; maintenance indicates scheduled downtime. | Column operational_status (STRING) in distribution.streaming_endpoint']
  provisioned_date date [note: 'The date when this streaming endpoint was initially provisioned and configured in the CDN infrastructure. | Column provisioned_date (DATE) in distribution.streaming_endpoint']
  sla_uptime_target_percent decimal(5,2) [note: 'The contractual uptime percentage target for this endpoint (e.g., 99.99%). Used for SLA compliance monitoring and vendor accountability. | Column sla_uptime_target_percent (DECIMAL(5,2)) in distribution.streaming_endpoint']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.streaming_endpoint']
  ssl_certificate_expiry_date date [note: 'Expiration date of the SSL/TLS certificate securing this endpoint. Critical for maintaining secure HTTPS delivery and avoiding service disruptions. | Column ssl_certificate_expiry_date (DATE) in distribution.streaming_endpoint']
  streaming_protocol varchar [note: 'The streaming protocol used by this endpoint for content delivery. HLS (HTTP Live Streaming) and MPEG-DASH (Dynamic Adaptive Streaming over HTTP) are the most common adaptive bitrate protocols. | Column streaming_protocol (STRING) in distribution.streaming_endpoint']
  supported_devices varchar [note: 'Comma-separated list of device types or platforms that this endpoint is optimized to serve (e.g., iOS, Android, Smart TV, Web Browser, Set-Top Box). | Column supported_devices (STRING) in distribution.streaming_endpoint']
  token_authentication_scheme varchar [note: 'The authentication mechanism used to secure access to the endpoint. Prevents unauthorized access and hotlinking through cryptographic token validation. | Column token_authentication_scheme (STRING) in distribution.streaming_endpoint']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.streaming_endpoint']

  Note: 'Master record of all streaming origin and edge endpoints managed across the CDN infrastructure (Akamai CDN). Captures endpoint URL, CDN provider, PoP (Point of Presence) region, protocol (HLS, MPEG-DASH), ABR ladder configuration reference, DRM license server URL, token authentication scheme, geo-restriction rules, failover endpoint reference, SLA tier, and operational status. SSOT for the technical delivery address of each stream. | Unity Catalog table: media_broadcasting_ecm.distribution.streaming_endpoint'
}

Table distribution.abr_profile {
  abr_profile_id varchar [pk, note: 'Unique identifier for the ABR encoding ladder profile. Primary key. | Column abr_profile_id (BIGINT) in distribution.abr_profile']
  broadcast_standard_id varchar [note: 'Foreign key linking to technology.broadcast_standard. Business justification: ABR profiles implement broadcast standards (HLS, DASH). Required for broadcast standard compliance verification and device interoperability testing. | Column broadcast_standard_id (BIGINT) in technology.abr_profile']
  encoder_config_id varchar [note: 'Foreign key linking to technology.encoder_config. Business justification: ABR profiles are generated by encoder configurations. Required for encoder profile assignment and video quality troubleshooting. | Column encoder_config_id (BIGINT) in technology.abr_profile']
  format_specification_id varchar [note: 'Foreign key linking to mediaasset.format_specification. Business justification: ABR profiles implement technical delivery standards (codec, bitrate ladder, resolution tiers) defined in format specifications. Broadcasters validate ABR configs against house specs for compliance. Qo | Column format_specification_id (BIGINT) in mediaasset.abr_profile']
  technical_standard_cert_id varchar [note: 'Foreign key linking to compliance.technical_standard_cert. Business justification: ABR profiles must comply with codec standards, streaming protocol specifications, and accessibility requirements. Profile certification validates compliance with technical standards before deployment. | Column technical_standard_cert_id (BIGINT) in compliance.abr_profile']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.abr_profile']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.abr_profile']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.abr_profile']
  audio_bitrate_kbps varchar [note: 'Audio bitrate in kilobits per second (e.g., 128, 192, 256). Defines audio quality. | Column audio_bitrate_kbps (INT) in distribution.abr_profile']
  audio_channel_config varchar [note: 'Audio channel layout (mono, stereo, 5.1 surround, 7.1 surround, Dolby Atmos). Defines spatial audio configuration. | Column audio_channel_config (STRING) in distribution.abr_profile']
  audio_codec varchar [note: 'Audio codec used for encoding (AAC, HE-AAC, AC-3/Dolby Digital, E-AC-3/Dolby Digital Plus, Opus). | Column audio_codec (STRING) in distribution.abr_profile']
  cdn_optimization_flag boolean [note: 'Indicates whether the profile is optimized for CDN delivery with caching-friendly segment naming and structure. True if CDN-optimized; false otherwise. | Column cdn_optimization_flag (BOOLEAN) in distribution.abr_profile']
  color_space varchar [note: 'Color space standard used for encoding (BT.709 for HD, BT.2020 for UHD/HDR, DCI-P3 for cinema). | Column color_space (STRING) in distribution.abr_profile']
  container_format varchar [note: 'Media container format for the encoded segments (fMP4 for DASH, TS for HLS, MP4, WebM). Defines how video and audio streams are packaged. | Column container_format (STRING) in distribution.abr_profile']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.abr_profile']
  created_timestamp timestamp [note: 'Timestamp when the ABR profile record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.abr_profile']
  drm_support_flag boolean [note: 'Indicates whether the profile supports DRM encryption. True if DRM is enabled; false otherwise. | Column drm_support_flag (BOOLEAN) in distribution.abr_profile']
  drm_system varchar [note: 'DRM system(s) supported by this profile (Widevine, PlayReady, FairPlay Streaming, Multi-DRM). Null if DRM is not enabled. | Column drm_system (STRING) in distribution.abr_profile']
  effective_date date [note: 'Date when the ABR profile became active and available for use in production encoding workflows. | Column effective_date (DATE) in distribution.abr_profile']
  encoding_preset varchar [note: 'Encoder speed/quality preset (fast, medium, slow, veryslow). Slower presets yield better compression but require more processing time. | Column encoding_preset (STRING) in distribution.abr_profile']
  expiration_date date [note: 'Date when the ABR profile is scheduled to be deprecated or retired. Null for profiles with no planned end date. | Column expiration_date (DATE) in distribution.abr_profile']
  frame_rate decimal(18,2) [note: 'Target frame rate for video renditions (e.g., \'23.976\', \'25\', \'29.97\', \'30\', \'50\', \'59.94\', \'60\'). May vary by rendition. | Column frame_rate (DECIMAL(18,2)) in distribution.abr_profile']
  hdr_format varchar [note: 'Specific HDR format supported (HDR10, HDR10+, Dolby Vision, HLG). Null if HDR is not supported. | Column hdr_format (STRING) in distribution.abr_profile']
  hdr_support_flag boolean [note: 'Indicates whether the profile supports HDR (High Dynamic Range) video. True if HDR is enabled; false for SDR (Standard Dynamic Range) only. | Column hdr_support_flag (BOOLEAN) in distribution.abr_profile']
  keyframe_interval_seconds varchar [note: 'Interval between keyframes (I-frames) in seconds. Aligns with segment duration for seamless ABR switching. | Column keyframe_interval_seconds (INT) in distribution.abr_profile']
  last_modified_timestamp timestamp [note: 'Timestamp when the ABR profile record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in distribution.abr_profile']
  manifest_template_reference varchar [note: 'Reference to the MPEG-DASH MPD or HLS M3U8 manifest template used for this profile. Defines playlist structure and metadata. | Column manifest_template_reference (STRING) in distribution.abr_profile']
  max_bitrate_kbps varchar [note: 'Highest video bitrate in kilobits per second across all renditions in the ladder. Used for high-quality streaming on fast connections. | Column max_bitrate_kbps (INT) in distribution.abr_profile']
  max_resolution varchar [note: 'Highest video resolution in the ladder (e.g., \'1920x1080\', \'3840x2160\'). Defines the top quality tier. | Column max_resolution (STRING) in distribution.abr_profile']
  min_bitrate_kbps varchar [note: 'Lowest video bitrate in kilobits per second across all renditions in the ladder. Used for low-bandwidth scenarios. | Column min_bitrate_kbps (INT) in distribution.abr_profile']
  min_resolution varchar [note: 'Lowest video resolution in the ladder (e.g., \'320x180\', \'640x360\'). Typically used for mobile or constrained bandwidth. | Column min_resolution (STRING) in distribution.abr_profile']
  owner_team varchar [note: 'Name of the engineering or operations team responsible for maintaining and updating this ABR profile. | Column owner_team (STRING) in distribution.abr_profile']
  profile_code varchar [note: 'Unique business identifier code for the ABR profile used in transcode job requests and CDN configuration. | Column profile_code (STRING) in distribution.abr_profile']
  profile_description varchar [note: 'Detailed description of the ABR profile, including use cases, target audience, and technical notes. | Column profile_description (STRING) in distribution.abr_profile']
  profile_name varchar [note: 'Human-readable name of the ABR profile (e.g., \'Premium 4K HDR\', \'Standard HD\', \'Mobile Optimized\'). | Column profile_name (STRING) in distribution.abr_profile']
  profile_status varchar [note: 'Current lifecycle status of the ABR profile. Active profiles are used in production encoding; deprecated profiles are phased out; testing profiles are under validation; inactive profiles are disabled. | Column profile_status (STRING) in distribution.abr_profile']
  qos_tier varchar [note: 'Quality of Service tier associated with this profile (premium, standard, basic). Influences CDN priority and SLA commitments. | Column qos_tier (STRING) in distribution.abr_profile']
  rendition_count varchar [note: 'Total number of video renditions (bitrate/resolution variants) in the ABR ladder. Typical range is 3-10 renditions. | Column rendition_count (INT) in distribution.abr_profile']
  segment_duration_seconds varchar [note: 'Duration of each media segment in seconds (e.g., 2, 4, 6, 10). Shorter segments enable faster ABR switching but increase overhead. | Column segment_duration_seconds (INT) in distribution.abr_profile']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.abr_profile']
  streaming_protocol varchar [note: 'Adaptive bitrate streaming protocol supported by this profile (HLS, MPEG-DASH, CMAF, Smooth Streaming). | Column streaming_protocol (STRING) in distribution.abr_profile']
  target_device_class varchar [note: 'Primary device class this profile is optimized for (mobile, tablet, desktop, smart TV, set-top box, gaming console). Influences resolution and bitrate choices. | Column target_device_class (STRING) in distribution.abr_profile']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.abr_profile']
  version_number varchar [note: 'Version number of the ABR profile. Incremented with each significant change to the encoding ladder or configuration. | Column version_number (INT) in distribution.abr_profile']
  video_codec varchar [note: 'Primary video codec used for encoding (H.264/AVC, H.265/HEVC, AV1, VP9). Determines compression efficiency and device compatibility. | Column video_codec (STRING) in distribution.abr_profile']

  Note: 'Defines Adaptive Bitrate (ABR) encoding ladder profiles used for multi-platform streaming delivery. Captures profile name, codec (H.264, H.265/HEVC, AV1, VP9), container format (fMP4, TS), rendition count, per-rendition bitrate/resolution/frame-rate specifications, audio codec and channel configuration, HDR/SDR flag, MPEG-DASH or HLS manifest template reference, and target device class. Governs the encoding farm (transcode) output specifications. | Unity Catalog table: media_broadcasting_ecm.distribution.abr_profile'
}

Table distribution.playback_session {
  playback_session_id varchar [pk, note: 'Unique identifier for each individual viewer playback session initiated on the OTT (Over-The-Top) platform. Primary key for the playback session record. | Column playback_session_id (BIGINT) in distribution.playback_session']
  abr_profile_id varchar [note: 'Foreign key linking to distribution.abr_profile. Business justification: Playback sessions should FK to abr_profile master to track which ABR profile was used. Removes abr_profile STRING (derivable from abr_profile.profile_code). | Column abr_profile_id (BIGINT) in distribution.playback_session']
  app_version_id varchar [note: 'Foreign key linking to distribution.app_version. Business justification: Playback sessions should FK to app_version master for version tracking and analytics. Removes app_version STRING (derivable from app_version.version_number). | Column app_version_id (BIGINT) in distribution.playback_session']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Playback sessions trace to originating facilities for root cause analysis of QoS issues. Essential for facility performance benchmarking and distributed CDN troubleshooting. | Column broadcast_facility_id (BIGINT) in technology.playback_session']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: When playback sessions include ad delivery (dai_enabled), linking to campaign enables campaign reach/frequency measurement, content-adjacency analysis, and cross-domain attribution. Critical for measu | Column campaign_id (BIGINT) in sales.playback_session']
  closed_caption_record_id varchar [note: 'Foreign key linking to compliance.closed_caption_record. Business justification: Individual playback sessions generate closed caption quality metrics (accuracy, synchronization, latency). Session-level caption performance data feeds FCC compliance reporting and quality assurance. | Column closed_caption_record_id (BIGINT) in compliance.playback_session']
  compliance_consent_record_id varchar [note: 'Foreign key linking to compliance.consent_record. Business justification: Playback sessions collect viewing data subject to consent (analytics, personalization, third-party sharing). Session initialization validates consent status before data collection begins. | Column compliance_consent_record_id (BIGINT) in compliance.playback_session']
  content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Every playback session must enforce content rating restrictions for parental controls, age-gating, and COPPA compliance. Real-time rating validation during session initialization is standard practice. | Column content_rating_id (BIGINT) in compliance.playback_session']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Nielsen C3/C7 ratings, GRP/TRP calculation, and programmatic ad targeting require demographic classification of every playback session. Essential for audience guarantee reconciliation and upfront comm | Column demographic_segment_id (BIGINT) in audience.playback_session']
  drm_policy_id varchar [note: 'Foreign key linking to distribution.drm_policy. Business justification: Playback sessions should FK to drm_policy master to track which DRM policy was applied. Removes drm_policy_applied STRING (derivable from drm_policy.policy_code). | Column drm_policy_id (BIGINT) in distribution.playback_session']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Playback sessions consume content under specific rights grants. Essential for per-stream royalty calculation, usage reporting to rights holders, and rights compliance verification. Media broadcasting  | Column grant_id (BIGINT) in rights.playback_session']
  market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: DMA attribution is mandatory for Nielsen ratings, local ad insertion, blackout enforcement, and retransmission consent compliance. Every streaming session must be assigned to a market for regulatory a | Column market_coverage_id (BIGINT) in audience.playback_session']
  media_asset_id varchar [note: 'Reference to the content asset being played in this session. Links to the digital asset management system for content metadata and rights verification. | Column media_asset_id (BIGINT) in mediaasset.playback_session']
  playback_device_device_type_id varchar [note: 'Reference to the device used for this playback session. Enables device-level analytics and QoS (Quality of Service) monitoring. | Column device_device_type_id (BIGINT) in distribution.playback_session']
  playback_device_type_id varchar [note: 'Foreign key linking to distribution.device_type. Business justification: Playback sessions should FK to device_type master for accurate device tracking. Removes device_type STRING (derivable from device_type.device_category). | Column device_type_id (BIGINT) in distribution.playback_session']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Playback sessions on ad-supported platforms generate advertising revenue that must be recognized. Monthly ad revenue reconciliation aggregates sessions by revenue stream for accrual accounting and rev | Column revenue_stream_id (BIGINT) in finance.playback_session']
  rights_territory_id varchar [note: 'Foreign key linking to rights.territory. Business justification: Playback sessions occur in specific territories. Essential for territory-based royalty calculation, rights compliance verification, and exploitation reporting to rights holders. Replaces geographic_co | Column rights_territory_id (BIGINT) in rights.playback_session']
  streaming_endpoint_id varchar [note: 'Foreign key linking to distribution.streaming_endpoint. Business justification: Playback sessions should FK to streaming_endpoint master to track which endpoint served the session. Removes streaming_endpoint_url STRING (derivable from streaming_endpoint.endpoint_url). | Column streaming_endpoint_id (BIGINT) in distribution.playback_session']
  subscriber_id varchar [note: 'Reference to the subscriber who initiated this playback session. Links to the subscriber master record for audience measurement and personalization. | Column subscriber_id (BIGINT) in subscriber.playback_session']
  tech_incident_id varchar [note: 'Foreign key linking to technology.tech_incident. Business justification: Playback sessions are impacted by technology incidents. Required for incident viewer impact assessment and session failure correlation. | Column tech_incident_id (BIGINT) in technology.playback_session']
  transaction_invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Playback sessions for TVOD, rental, and pay-per-view models generate per-transaction invoices. Real business process: transactional VOD billing, rental revenue recognition, PPV event billing. Role pre | Column transaction_invoice_id (BIGINT) in billing.playback_session']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.playback_session']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.playback_session']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.playback_session']
  ad_breaks_served_count varchar [note: 'Number of ad breaks (ad pods) served during this playback session. Used for advertising inventory management and revenue reconciliation. | Column ad_breaks_served_count (INT) in distribution.playback_session']
  audio_language varchar [note: 'ISO 639 language code for the audio track selected by the viewer. Supports multi-language content analytics and localization strategy. | Column audio_language (STRING) in distribution.playback_session']
  average_bitrate_kbps varchar [note: 'Average streaming bitrate in kilobits per second during the session. Indicates video quality delivered and network performance. | Column average_bitrate_kbps (INT) in distribution.playback_session']
  cdn_pop_location varchar [note: 'Geographic location identifier of the CDN point of presence that served this session. Critical for CDN performance optimization and SLA monitoring. | Column cdn_pop_location (STRING) in distribution.playback_session']
  closed_captions_enabled boolean [note: 'Indicates whether closed captions were enabled during the session. Critical for accessibility compliance reporting and user preference analysis. | Column closed_captions_enabled (BOOLEAN) in distribution.playback_session']
  completion_percentage decimal(5,2) [note: 'Percentage of content watched relative to total content duration. Key engagement metric for content performance and recommendation algorithms. | Column completion_percentage (DECIMAL(5,2)) in distribution.playback_session']
  content_duration_seconds varchar [note: 'Total duration of the content asset in seconds. Used to calculate completion rate and identify partial vs. full viewing sessions. | Column content_duration_seconds (INT) in distribution.playback_session']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.playback_session']
  dai_enabled boolean [note: 'Indicates whether Dynamic Ad Insertion was enabled for this playback session. Critical for advertising revenue attribution and campaign measurement. | Column dai_enabled (BOOLEAN) in distribution.playback_session']
  error_code varchar [note: 'Technical error code if the session ended due to an error. Enables root cause analysis and platform stability monitoring. | Column error_code (STRING) in distribution.playback_session']
  exit_reason varchar [note: 'The reason the playback session ended. Critical for distinguishing intentional exits from technical failures and optimizing viewer experience. | Column exit_reason (STRING) in distribution.playback_session']
  geographic_city varchar [note: 'City where the viewer is located during playback. Enables hyper-local audience analytics and targeted advertising campaigns. | Column geographic_city (STRING) in distribution.playback_session']
  geographic_postal_code varchar [note: 'Postal code derived from viewer location. Used for demographic overlay and targeted advertising. Subject to privacy regulations. | Column geographic_postal_code (STRING) in distribution.playback_session']
  initial_buffering_duration_ms varchar [note: 'Time in milliseconds from session start until playback began. Key QoS metric for measuring time-to-first-frame and viewer experience. | Column initial_buffering_duration_ms (INT) in distribution.playback_session']
  platform_type varchar [note: 'The platform category on which the playback session occurred. Enables cross-platform measurement and platform-specific QoS analysis. | Column platform_type (STRING) in distribution.playback_session']
  playback_mode varchar [note: 'The mode of content consumption: live linear broadcast, VOD (Video On Demand), DVR (time-shifted), or restart. Critical for audience measurement methodology and rights management. | Column playback_mode (STRING) in distribution.playback_session']
  rebuffering_events_count varchar [note: 'Number of rebuffering (stalling) events that occurred during the session. Critical QoS metric for viewer experience and churn prediction. | Column rebuffering_events_count (INT) in distribution.playback_session']
  session_created_timestamp timestamp [note: 'Timestamp when this playback session record was created in the system. Used for data lineage and operational monitoring. | Column session_created_timestamp (TIMESTAMP) in distribution.playback_session']
  session_end_timestamp timestamp [note: 'Precise timestamp when the playback session ended. Used to calculate total watch duration and session completion metrics. | Column session_end_timestamp (TIMESTAMP) in distribution.playback_session']
  session_start_timestamp timestamp [note: 'Precise timestamp when the viewer initiated the playback session. Critical for audience measurement, daypart analysis, and concurrent viewer calculations. | Column session_start_timestamp (TIMESTAMP) in distribution.playback_session']
  session_updated_timestamp timestamp [note: 'Timestamp when this playback session record was last updated. Supports audit trail and data quality monitoring. | Column session_updated_timestamp (TIMESTAMP) in distribution.playback_session']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.playback_session']
  streaming_protocol varchar [note: 'The ABR (Adaptive Bitrate Streaming) protocol used for content delivery. HLS (HTTP Live Streaming) or MPEG-DASH (Dynamic Adaptive Streaming over HTTP) are most common. | Column streaming_protocol (STRING) in distribution.playback_session']
  subtitle_language varchar [note: 'ISO 639 language code for subtitles displayed during the session. Null if no subtitles were enabled. Supports accessibility and localization analytics. | Column subtitle_language (STRING) in distribution.playback_session']
  total_ad_duration_seconds varchar [note: 'Cumulative duration of all advertisements served during the session. Essential for advertising billing and viewer experience analysis. | Column total_ad_duration_seconds (INT) in distribution.playback_session']
  total_rebuffering_duration_ms varchar [note: 'Cumulative time in milliseconds spent in rebuffering state during the session. Complements rebuffering count for comprehensive QoS analysis. | Column total_rebuffering_duration_ms (INT) in distribution.playback_session']
  total_watch_duration_seconds varchar [note: 'Total time in seconds the viewer actively watched content during this session. Primary metric for audience measurement and content engagement analysis. | Column total_watch_duration_seconds (INT) in distribution.playback_session']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.playback_session']
  video_resolution varchar [note: 'The video resolution delivered during the session (e.g., 1920x1080, 3840x2160). Indicates quality tier and device capability. | Column video_resolution (STRING) in distribution.playback_session']
  viewer_ip_address varchar [note: 'IP address of the viewer during the playback session. Used for geographic analysis, fraud detection, and blackout enforcement. Subject to GDPR and CCPA privacy regulations. | Column viewer_ip_address (STRING) in distribution.playback_session']

  Note: 'Transactional record of each individual viewer playback session initiated on the OTT platform. Captures session ID, subscriber/device reference, content asset reference, session start and end timestamps, platform and app version, device type, streaming endpoint used, ABR profile, DRM policy applied, initial buffering duration, average bitrate, rebuffering events count, total watch duration, exit reason (user-initiated, error, completion), CDN PoP served, and geographic location. Primary operational event for QoS monitoring and audience measurement. | Unity Catalog table: media_broadcasting_ecm.distribution.playback_session'
}

Table distribution.qos_event {
  qos_event_id varchar [pk, note: 'Unique identifier for the QoS event record. Primary key. | Column qos_event_id (BIGINT) in distribution.qos_event']
  closed_caption_record_id varchar [note: 'Foreign key linking to compliance.closed_caption_record. Business justification: QoS events capture caption-specific failures (caption dropout, synchronization errors, rendering issues). These events are linked to caption compliance records for remediation tracking and regulatory  | Column closed_caption_record_id (BIGINT) in compliance.qos_event']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: QoE analysis by demographic segment identifies service quality disparities, drives platform optimization for key demos, and supports Nielsen commercial ratings validation. Critical for audience guaran | Column demographic_segment_id (BIGINT) in audience.qos_event']
  market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: Market-level QoS monitoring supports DMA-specific SLA compliance, identifies regional CDN performance issues, and enables market-based service optimization for distribution partners and Nielsen measur | Column market_coverage_id (BIGINT) in audience.qos_event']
  noc_alert_id varchar [note: 'Foreign key linking to technology.noc_alert. Business justification: QoS events are generated in response to NOC alerts. Required for event correlation analysis and root cause determination. | Column noc_alert_id (BIGINT) in technology.qos_event']
  playback_session_id varchar [note: 'Reference to the parent playback session during which this QoS event occurred. Links to the session-level summary record. | Column playback_session_id (BIGINT) in distribution.qos_event']
  streaming_endpoint_id varchar [note: 'Foreign key linking to distribution.streaming_endpoint. Business justification: QoS events should reference the streaming endpoint for performance tracking. Removes cdn_edge_node STRING (derivable from streaming_endpoint.pop_region). | Column streaming_endpoint_id (BIGINT) in distribution.qos_event']
  title_id varchar [note: 'Unique identifier of the content asset being played during this event. Links to the content catalog for asset-level QoS analysis. | Column title_id (BIGINT) in content.qos_event']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: QoS events trace to specific transmission equipment failures. Critical for NOC rapid incident resolution and equipment health monitoring. | Column transmission_equipment_id (BIGINT) in technology.qos_event']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.qos_event']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.qos_event']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.qos_event']
  ad_pod_duration_seconds varchar [note: 'Total duration of the ad pod in seconds when event_type is ad_pod_insertion. Null for other event types. | Column ad_pod_duration_seconds (INT) in distribution.qos_event']
  ad_pod_position varchar [note: 'Position of the ad pod within the content stream when event_type is ad_pod_insertion. Null for other event types. Used for DAI analysis. | Column ad_pod_position (INT) in distribution.qos_event']
  bitrate_kbps varchar [note: 'Current streaming bitrate in kilobits per second at the time of the event. Reflects the ABR profile tier active during this event. | Column bitrate_kbps (INT) in distribution.qos_event']
  buffer_level_seconds decimal(8,3) [note: 'Amount of video content buffered in the player at the time of the event, measured in seconds. Indicates playback health and risk of stalling. | Column buffer_level_seconds (DECIMAL(8,3)) in distribution.qos_event']
  cdn_cache_status varchar [note: 'CDN cache status for the content segment at the time of the event: hit (served from cache), miss (fetched from origin), stale (expired cache), bypass (cache bypassed). | Column cdn_cache_status (STRING) in distribution.qos_event']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.qos_event']
  created_timestamp timestamp [note: 'Timestamp when this QoS event record was created in the data platform, in format yyyy-MM-ddTHH:mm:ss.SSSXXX. Used for data lineage and audit purposes. | Column created_timestamp (TIMESTAMP) in distribution.qos_event']
  device_type varchar [note: 'Type of device on which the playback event occurred: smart TV, mobile phone, tablet, desktop, set-top box, gaming console, etc. | Column device_type (STRING) in distribution.qos_event']
  download_throughput_kbps varchar [note: 'Measured download throughput in kilobits per second at the time of the event. Used by ABR algorithms to determine optimal bitrate. | Column download_throughput_kbps (INT) in distribution.qos_event']
  drm_system varchar [note: 'DRM system protecting the content stream: Widevine, FairPlay, PlayReady, or None for unprotected content. | Column drm_system (STRING) in distribution.qos_event']
  dropped_frames_count varchar [note: 'Number of video frames dropped by the player at the time of the event. Indicates rendering performance issues. | Column dropped_frames_count (INT) in distribution.qos_event']
  error_code varchar [note: 'Specific error code returned by the player or CDN when event_type is error. Null for non-error events. Used for detailed troubleshooting and root-cause analysis. | Column error_code (STRING) in distribution.qos_event']
  error_message varchar [note: 'Human-readable error message describing the failure when event_type is error. Null for non-error events. | Column error_message (STRING) in distribution.qos_event']
  event_severity varchar [note: 'Severity level of the QoS event indicating impact on user experience: critical (playback failure), high (significant degradation), medium (noticeable impact), low (minor impact), info (informational only). | Column event_severity (STRING) in distribution.qos_event']
  event_timestamp timestamp [note: 'Precise timestamp when the QoS event occurred during playback, in format yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column event_timestamp (TIMESTAMP) in distribution.qos_event']
  event_type varchar [note: 'Type of QoS event captured: buffering start/end, bitrate switch (up/down), error code, stall event, seek event, ad pod insertion signal, or heartbeat. [ENUM-REF-CANDIDATE: buffering_start|buffering_end|bitrate_switch_up|bitrate_switch_down|error|stall|seek|ad_pod_insertion|heartbeat — 9 candidates stripped; promote to reference product] | Column event_type (STRING) in distribution.qos_event']
  geographic_region varchar [note: 'Geographic region or market where the viewer is located at the time of the event. Used for regional QoS analysis and CDN optimization. | Column geographic_region (STRING) in distribution.qos_event']
  isp_name varchar [note: 'Name of the Internet Service Provider through which the viewer is connected. Used for ISP-level QoS analysis and peering optimization. | Column isp_name (STRING) in distribution.qos_event']
  network_latency_ms varchar [note: 'Network round-trip latency in milliseconds measured at the time of the event. Indicates network performance and potential delivery issues. | Column network_latency_ms (INT) in distribution.qos_event']
  new_bitrate_kbps varchar [note: 'Bitrate in kilobits per second after a bitrate switch event. Populated when event_type is bitrate_switch_up or bitrate_switch_down. Null for other event types. | Column new_bitrate_kbps (INT) in distribution.qos_event']
  origin_server_response_time_ms varchar [note: 'Response time in milliseconds from the origin server when CDN cache status is miss. Null for cache hits. Indicates origin performance. | Column origin_server_response_time_ms (INT) in distribution.qos_event']
  playback_position_seconds decimal(12,3) [note: 'Current playback position in seconds within the content at the time of the event. Used to correlate events with specific content segments. | Column playback_position_seconds (DECIMAL(12,3)) in distribution.qos_event']
  player_state varchar [note: 'State of the video player at the time of the event: playing, paused, buffering, seeking, idle, or error. | Column player_state (STRING) in distribution.qos_event']
  player_version varchar [note: 'Version identifier of the video player software that generated this QoS event. Used for player-specific issue analysis. | Column player_version (STRING) in distribution.qos_event']
  previous_bitrate_kbps varchar [note: 'Bitrate in kilobits per second before a bitrate switch event. Populated when event_type is bitrate_switch_up or bitrate_switch_down. Null for other event types. | Column previous_bitrate_kbps (INT) in distribution.qos_event']
  seek_position_seconds decimal(12,3) [note: 'Playback position in seconds to which the user seeked. Populated when event_type is seek. Null for other event types. | Column seek_position_seconds (DECIMAL(12,3)) in distribution.qos_event']
  session_start_timestamp timestamp [note: 'Timestamp when the parent playback session started, in format yyyy-MM-ddTHH:mm:ss.SSSXXX. Provides temporal context for event sequencing. | Column session_start_timestamp (TIMESTAMP) in distribution.qos_event']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.qos_event']
  stall_duration_ms varchar [note: 'Duration of the playback stall or buffering event in milliseconds. Populated when event_type is buffering_start, buffering_end, or stall. Null for other event types. | Column stall_duration_ms (INT) in distribution.qos_event']
  streaming_protocol varchar [note: 'Streaming protocol used for content delivery: HLS (HTTP Live Streaming), MPEG-DASH (Dynamic Adaptive Streaming over HTTP), RTMP, WebRTC, or Smooth Streaming. | Column streaming_protocol (STRING) in distribution.qos_event']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.qos_event']
  user_agent varchar [note: 'User agent string of the viewer device and browser/app at the time of the event. Used for device and platform-specific issue analysis. | Column user_agent (STRING) in distribution.qos_event']
  viewer_ip_address varchar [note: 'IP address of the viewer device at the time of the event. Used for network-level troubleshooting and geographic analysis. May be considered PII in some jurisdictions. | Column viewer_ip_address (STRING) in distribution.qos_event']

  Note: 'Granular Quality of Service (QoS) telemetry events captured during playback sessions — distinct from the session-level summary in playback_session. Each record captures a specific QoS signal: buffering start/end, bitrate switch (up/down), error code, stall event, seek event, ad pod insertion signal, or heartbeat. Includes timestamp, session reference, event type, severity, bitrate at event time, buffer level, CDN edge node, and player state. Enables root-cause analysis of streaming quality degradation. | Unity Catalog table: media_broadcasting_ecm.distribution.qos_event'
}

Table distribution.sla_definition {
  sla_definition_id varchar [pk, note: 'Unique identifier for the SLA definition record. Primary key. | Column sla_definition_id (BIGINT) in distribution.sla_definition']
  workforce_employee_id varchar [note: 'FK added per VREQ']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.sla_definition']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.sla_definition']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.sla_definition']
  applicable_platform varchar [note: 'The OTT platform, CDN, or service to which this SLA applies (e.g., \'OTT Web Platform\', \'Mobile App\', \'Akamai CDN\', \'All Platforms\'). | Column applicable_platform (STRING) in distribution.sla_definition']
  approval_status varchar [note: 'The approval state of the SLA definition (pending, approved, rejected). | Column approval_status (STRING) in distribution.sla_definition']
  approved_by varchar [note: 'Name or identifier of the person or role who approved this SLA definition. | Column approved_by (STRING) in distribution.sla_definition']
  approved_date date [note: 'The date on which this SLA definition was formally approved. | Column approved_date (DATE) in distribution.sla_definition']
  breach_penalty_amount decimal(18,2) [note: 'The monetary amount or percentage of the penalty applied per SLA breach incident. | Column breach_penalty_amount (DECIMAL(18,2)) in distribution.sla_definition']
  breach_penalty_currency varchar [note: 'The currency in which the breach penalty is denominated, using ISO 4217 three-letter currency code. | Column breach_penalty_currency (STRING) in distribution.sla_definition']
  breach_penalty_type varchar [note: 'The type of penalty or remedy applied when the SLA is breached (credit, refund, none, custom). | Column breach_penalty_type (STRING) in distribution.sla_definition']
  calculation_method varchar [note: 'Description of the formula or methodology used to calculate the SLA metric from raw measurements. | Column calculation_method (STRING) in distribution.sla_definition']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.sla_definition']
  created_timestamp timestamp [note: 'The date and time when this SLA definition record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.sla_definition']
  critical_threshold decimal(18,6) [note: 'The threshold value at which a critical alert is triggered, indicating an SLA breach has occurred or is imminent. | Column critical_threshold (DECIMAL(18,6)) in distribution.sla_definition']
  data_source varchar [note: 'The system or platform from which the SLA metric data is collected (e.g., \'Akamai CDN Monitoring\', \'Adobe Analytics\', \'Internal QoS System\'). | Column data_source (STRING) in distribution.sla_definition']
  effective_end_date date [note: 'The date on which this SLA definition expires or is superseded. Null indicates an open-ended SLA. | Column effective_end_date (DATE) in distribution.sla_definition']
  effective_start_date date [note: 'The date from which this SLA definition becomes active and enforceable. | Column effective_start_date (DATE) in distribution.sla_definition']
  escalation_procedure varchar [note: 'Description of the escalation process and contacts when an SLA breach occurs or is imminent. | Column escalation_procedure (STRING) in distribution.sla_definition']
  exclusion_criteria varchar [note: 'Conditions or events that are excluded from SLA measurement (e.g., scheduled maintenance, force majeure, third-party failures). | Column exclusion_criteria (STRING) in distribution.sla_definition']
  geographic_scope varchar [note: 'The geographic region or market to which this SLA applies (e.g., \'Global\', \'North America\', \'EMEA\', \'APAC\'). | Column geographic_scope (STRING) in distribution.sla_definition']
  measurement_frequency varchar [note: 'How often the metric is sampled and evaluated (real-time, hourly, daily, weekly, monthly). | Column measurement_frequency (STRING) in distribution.sla_definition']
  measurement_window varchar [note: 'The time period over which the SLA metric is calculated and evaluated (e.g., \'monthly\', \'daily\', \'rolling_30_days\', \'per_incident\'). | Column measurement_window (STRING) in distribution.sla_definition']
  metric_name varchar [note: 'Name of the specific performance metric being measured (e.g., \'Streaming Uptime\', \'Start Time Latency\', \'Rebuffering Ratio\', \'CDN Cache Hit Rate\', \'DRM License Issuance Latency\', \'API Response Time\'). | Column metric_name (STRING) in distribution.sla_definition']
  metric_type varchar [note: 'Classification of the metric being measured (uptime, latency, throughput, error rate, response time, availability). | Column metric_type (STRING) in distribution.sla_definition']
  modified_timestamp timestamp [note: 'The date and time when this SLA definition record was last modified. | Column modified_timestamp (TIMESTAMP) in distribution.sla_definition']
  notes varchar [note: 'Additional notes, comments, or operational guidance related to this SLA definition. | Column notes (STRING) in distribution.sla_definition']
  owner_department varchar [note: 'The business department or team responsible for managing and enforcing this SLA (e.g., \'Platform Operations\', \'Distribution\', \'Customer Success\'). | Column owner_department (STRING) in distribution.sla_definition']
  reporting_frequency varchar [note: 'How often SLA performance reports are generated and delivered to stakeholders (real-time, daily, weekly, monthly, quarterly). | Column reporting_frequency (STRING) in distribution.sla_definition']
  service_tier varchar [note: 'The subscription or service tier to which this SLA applies (premium, standard, basic, enterprise). | Column service_tier (STRING) in distribution.sla_definition']
  sla_code varchar [note: 'Unique business identifier or code for the SLA definition used in contracts and operational systems. | Column sla_code (STRING) in distribution.sla_definition']
  sla_definition_description varchar [note: 'Detailed description of the SLA, including business context, objectives, and any special conditions. | Column sla_definition_description (STRING) in distribution.sla_definition']
  sla_definition_status varchar [note: 'Current lifecycle status of the SLA definition (active, inactive, draft, superseded, retired). | Column sla_definition_status (STRING) in distribution.sla_definition']
  sla_name varchar [note: 'Human-readable name of the SLA definition (e.g., \'Premium Streaming Uptime SLA\', \'Standard CDN Performance SLA\'). | Column sla_name (STRING) in distribution.sla_definition']
  sla_type varchar [note: 'Category of SLA defining the nature of the service commitment (availability, performance, quality, capacity, support, security). | Column sla_type (STRING) in distribution.sla_definition']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.sla_definition']
  target_value decimal(18,6) [note: 'The target threshold value that defines the SLA commitment (e.g., 99.9 for 99.9% uptime, 2.0 for 2 seconds latency). | Column target_value (DECIMAL(18,6)) in distribution.sla_definition']
  unit_of_measure varchar [note: 'The unit in which the metric is measured (e.g., \'percent\', \'milliseconds\', \'seconds\', \'requests_per_second\', \'ratio\'). | Column unit_of_measure (STRING) in distribution.sla_definition']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.sla_definition']
  version_number varchar [note: 'Version identifier for this SLA definition, used to track revisions and changes over time. | Column version_number (STRING) in distribution.sla_definition']
  warning_threshold decimal(18,6) [note: 'The threshold value at which a warning alert is triggered, indicating performance is approaching but has not yet breached the SLA target. | Column warning_threshold (DECIMAL(18,6)) in distribution.sla_definition']

  Note: 'Defines Service Level Agreement (SLA) targets and thresholds for OTT platform performance obligations — covering streaming availability uptime, start-time latency, rebuffering ratio, CDN cache-hit rate, DRM license issuance latency, and API response time. Captures SLA name, metric type, target threshold, warning threshold, critical threshold, measurement window, applicable platform/service tier, and effective date range. Used for SLA performance tracking and breach alerting. | Unity Catalog table: media_broadcasting_ecm.distribution.sla_definition'
}

Table distribution.sla_performance {
  sla_performance_id varchar [pk, note: 'Unique identifier for the SLA performance measurement record. | Column sla_performance_id (BIGINT) in distribution.sla_performance']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: SLA measurements are facility-specific for uptime and latency reporting. Required for facility-level SLA compliance reporting and vendor performance reviews. | Column broadcast_facility_id (BIGINT) in technology.sla_performance']
  market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: SLA measurement is market-specific due to CDN topology, regional infrastructure differences, and DMA-level service commitments in distribution partner agreements. Required for carriage fee penalty cal | Column market_coverage_id (BIGINT) in audience.sla_performance']
  penalty_credit_memo_id varchar [note: 'Foreign key linking to billing.credit_memo. Business justification: SLA breaches trigger contractual penalties and service credits to distribution partners or advertisers. Real business process: SLA penalty assessment, makegood credit issuance, partner compensation fo | Column penalty_credit_memo_id (BIGINT) in billing.sla_performance']
  sla_definition_id varchar [note: 'Reference to the SLA definition that establishes the target thresholds and measurement criteria for this performance record. | Column sla_definition_id (BIGINT) in distribution.sla_performance']
  tech_incident_id varchar [note: 'The identifier of the incident management ticket or case associated with this SLA breach. Links to operational incident tracking systems. | Column tech_incident_id (BIGINT) in technology.sla_performance']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.sla_performance']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.sla_performance']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.sla_performance']
  actual_value decimal(18,4) [note: 'The actual measured value of the SLA metric during the measurement period. Unit of measure is defined in the associated SLA definition. | Column actual_value (DECIMAL(18,4)) in distribution.sla_performance']
  affected_platform varchar [note: 'The distribution platform affected by this SLA measurement (e.g., OTT streaming, linear broadcast, MVPD carriage, FAST channel, CDN endpoint). Identifies the delivery channel scope. | Column affected_platform (STRING) in distribution.sla_performance']
  affected_region varchar [note: 'The geographic region or market affected by this SLA measurement. May be a country code, region name, or CDN edge location identifier. | Column affected_region (STRING) in distribution.sla_performance']
  breach_duration_minutes varchar [note: 'The total duration in minutes that the SLA was in breach state during the measurement period. Null if no breach occurred. | Column breach_duration_minutes (INT) in distribution.sla_performance']
  breach_flag boolean [note: 'Boolean indicator of whether the SLA was breached during this measurement period. True indicates a breach occurred; False indicates SLA was met. | Column breach_flag (BOOLEAN) in distribution.sla_performance']
  breach_severity varchar [note: 'The severity classification of the SLA breach if one occurred. None indicates no breach; minor through critical indicate escalating severity levels based on business impact. | Column breach_severity (STRING) in distribution.sla_performance']
  cdn_provider varchar [note: 'The CDN provider responsible for content delivery during this measurement period (e.g., Akamai, Cloudflare, AWS CloudFront). Relevant for streaming and OTT SLA measurements. | Column cdn_provider (STRING) in distribution.sla_performance']
  contract_reference varchar [note: 'The contract or agreement reference number under which this SLA is defined. Links performance measurement to contractual obligations. | Column contract_reference (STRING) in distribution.sla_performance']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.sla_performance']
  created_timestamp timestamp [note: 'The timestamp when this SLA performance record was first created in the system. Part of audit trail for data lineage. | Column created_timestamp (TIMESTAMP) in distribution.sla_performance']
  device_category varchar [note: 'The category of end-user device for which this SLA performance was measured (e.g., smart TV, mobile, desktop, set-top box, gaming console). Relevant for device-specific QoS monitoring. | Column device_category (STRING) in distribution.sla_performance']
  dispute_flag boolean [note: 'Boolean indicator of whether this SLA performance measurement is under dispute by the distribution partner or internal stakeholders. True indicates active dispute. | Column dispute_flag (BOOLEAN) in distribution.sla_performance']
  dispute_reason varchar [note: 'Textual description of the reason for disputing this SLA performance measurement. Captures partner or stakeholder objections for resolution tracking. | Column dispute_reason (STRING) in distribution.sla_performance']
  last_modified_timestamp timestamp [note: 'The timestamp when this SLA performance record was last modified. Tracks updates through validation, dispute, and approval workflows. | Column last_modified_timestamp (TIMESTAMP) in distribution.sla_performance']
  measurement_granularity varchar [note: 'The time granularity at which this SLA performance measurement was captured (hourly, daily, weekly, monthly, quarterly, annual). | Column measurement_granularity (STRING) in distribution.sla_performance']
  measurement_period_end timestamp [note: 'The end timestamp of the measurement period for this SLA performance record. Represents the conclusion of the observation window. | Column measurement_period_end (TIMESTAMP) in distribution.sla_performance']
  measurement_period_start timestamp [note: 'The start timestamp of the measurement period for this SLA performance record. Represents the beginning of the observation window. | Column measurement_period_start (TIMESTAMP) in distribution.sla_performance']
  measurement_source varchar [note: 'The source system or monitoring tool that captured this SLA performance measurement (e.g., Akamai CDN analytics, Ericsson MediaFirst monitoring, custom QoS probe). Provides data lineage. | Column measurement_source (STRING) in distribution.sla_performance']
  measurement_status varchar [note: 'The workflow status of this SLA performance measurement record. Tracks progression from initial capture through validation, dispute resolution, and final approval. | Column measurement_status (STRING) in distribution.sla_performance']
  notes varchar [note: 'Free-form notes providing additional context, operational commentary, or special circumstances related to this SLA performance measurement. | Column notes (STRING) in distribution.sla_performance']
  partner_name varchar [note: 'The name of the distribution partner (MVPD, vMVPD, OTT platform, syndication partner) to whom this SLA applies. Used for partner-specific SLA reporting and governance. | Column partner_name (STRING) in distribution.sla_performance']
  penalty_amount decimal(15,2) [note: 'The monetary penalty or service credit amount assessed due to the SLA breach. Expressed in the contract currency. Null if no penalty applies. | Column penalty_amount (DECIMAL(15,2)) in distribution.sla_performance']
  penalty_applicable_flag boolean [note: 'Boolean indicator of whether a contractual penalty or service credit is applicable due to this SLA breach. True indicates financial or contractual consequences apply. | Column penalty_applicable_flag (BOOLEAN) in distribution.sla_performance']
  penalty_currency_code varchar [note: 'The three-letter ISO 4217 currency code for the penalty amount (e.g., USD, GBP, EUR). | Column penalty_currency_code (STRING) in distribution.sla_performance']
  remediation_action varchar [note: 'Description of the corrective action taken to address the SLA breach or performance degradation. Documents operational response and resolution steps. | Column remediation_action (STRING) in distribution.sla_performance']
  remediation_timestamp timestamp [note: 'The timestamp when remediation action was completed and normal service levels were restored. Null if remediation is pending or not applicable. | Column remediation_timestamp (TIMESTAMP) in distribution.sla_performance']
  root_cause_category varchar [note: 'The high-level category of the root cause for SLA breach or performance degradation (e.g., network congestion, origin server failure, CDN capacity, encoding issue, third-party dependency). [ENUM-REF-CANDIDATE: network|infrastructure|capacity|configuration|third-party|content|security|unknown — promote to reference product] | Column root_cause_category (STRING) in distribution.sla_performance']
  root_cause_description varchar [note: 'Detailed textual description of the root cause analysis findings for the SLA breach or performance issue. Provides operational context for remediation and reporting. | Column root_cause_description (STRING) in distribution.sla_performance']
  sample_size varchar [note: 'The number of individual observations or data points used to calculate the aggregated SLA metric value. Provides statistical context for measurement confidence. | Column sample_size (BIGINT) in distribution.sla_performance']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.sla_performance']
  streaming_protocol varchar [note: 'The streaming protocol used for content delivery during this measurement (HLS, MPEG-DASH, RTMP, WebRTC, Smooth Streaming). Applicable to OTT and streaming SLA measurements. | Column streaming_protocol (STRING) in distribution.sla_performance']
  target_value decimal(18,4) [note: 'The target value defined in the SLA definition that the actual performance is measured against. Represents the contractual or operational commitment. | Column target_value (DECIMAL(18,4)) in distribution.sla_performance']
  threshold_value decimal(18,4) [note: 'The threshold value at which an SLA breach is triggered. May differ from target value to allow for acceptable variance before breach declaration. | Column threshold_value (DECIMAL(18,4)) in distribution.sla_performance']
  unit_of_measure varchar [note: 'The unit of measure for the SLA metric values (e.g., milliseconds, percentage, Mbps, count, ratio). Provides context for interpreting actual, target, and threshold values. | Column unit_of_measure (STRING) in distribution.sla_performance']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.sla_performance']
  validated_by varchar [note: 'The username or identifier of the user who validated this SLA performance measurement. Part of the approval and sign-off workflow. | Column validated_by (STRING) in distribution.sla_performance']
  validated_timestamp timestamp [note: 'The timestamp when this SLA performance measurement was validated and approved. Null if validation is pending. | Column validated_timestamp (TIMESTAMP) in distribution.sla_performance']
  variance_percentage decimal(7,4) [note: 'The variance expressed as a percentage of the target value. Calculated as ((actual - target) / target) * 100. | Column variance_percentage (DECIMAL(7,4)) in distribution.sla_performance']
  variance_value decimal(18,4) [note: 'The calculated variance between actual value and target value (actual minus target). Positive values indicate over-performance, negative values indicate under-performance. | Column variance_value (DECIMAL(18,4)) in distribution.sla_performance']

  Note: 'Transactional records tracking actual SLA performance measurements against defined SLA targets over time. Captures SLA definition reference, measurement period (hourly/daily/monthly), actual metric value, target value, breach flag, breach severity, affected platform/region, root-cause category, remediation action taken, and sign-off status. Distinct from sla_definition (the target) — this is the operational record of measured performance. Supports SLA reporting to distribution partners and internal governance. | Unity Catalog table: media_broadcasting_ecm.distribution.sla_performance'
}

Table distribution.api_endpoint {
  api_endpoint_id varchar [pk, note: 'Unique identifier for the API endpoint. Primary key. | Column api_endpoint_id (BIGINT) in distribution.api_endpoint']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: API endpoints are hosted in specific facilities for disaster recovery and data residency compliance. Critical for DR planning and API geographic latency optimization. | Column broadcast_facility_id (BIGINT) in technology.api_endpoint']
  compliance_consent_record_id varchar [note: 'Foreign key linking to compliance.consent_record. Business justification: API endpoints accessing subscriber data must validate consent scope before processing. Endpoint authorization checks consent records in real-time to enforce GDPR, CCPA, and privacy policy requirements | Column compliance_consent_record_id (BIGINT) in compliance.api_endpoint']
  noc_monitor_id varchar [note: 'Foreign key linking to technology.noc_monitor. Business justification: API endpoints require NOC monitoring for availability. Required for API monitoring setup and SLA compliance measurement. | Column noc_monitor_id (BIGINT) in technology.api_endpoint']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: API endpoints are exposed by specific OTT platforms. Each API belongs to a platform service. Essential for API governance and platform-specific routing. | Column ott_platform_id (BIGINT) in distribution.api_endpoint']
  owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: API endpoints require engineering ownership for deprecation decisions, rate limit adjustments, SLA monitoring, and breaking change management. Essential for on-call rotations, API versioning accountab | Column owner_employee_id (BIGINT) in workforce.api_endpoint']
  tech_project_id varchar [note: 'Foreign key linking to technology.tech_project. Business justification: API endpoints are developed via technology projects. Required for API development project tracking and feature release management. | Column tech_project_id (BIGINT) in technology.api_endpoint']
  tech_sla_id varchar [note: 'Foreign key linking to technology.tech_sla. Business justification: API endpoints have technology SLAs for availability and response time. Required for API SLA compliance tracking and performance optimization. | Column tech_sla_id (BIGINT) in technology.api_endpoint']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.api_endpoint']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.api_endpoint']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.api_endpoint']
  activated_timestamp timestamp [note: 'The date and time when this endpoint was activated and made available for use. Null if the endpoint has never been activated or is still in development. | Column activated_timestamp (TIMESTAMP) in distribution.api_endpoint']
  allowed_origins varchar [note: 'Comma-separated list of allowed origin domains for CORS requests (e.g., https://www.example.com, https://app.example.com). Asterisk (*) indicates all origins are allowed. Null if CORS is disabled. | Column allowed_origins (STRING) in distribution.api_endpoint']
  api_version varchar [note: 'The version of the API that this endpoint belongs to (e.g., v1, v2, v3). Used for versioning and backward compatibility management. | Column api_version (STRING) in distribution.api_endpoint']
  authentication_scheme varchar [note: 'The authentication mechanism required to access this endpoint (OAuth2 for token-based, API key for simple key-based, JWT for JSON Web Token, basic auth for username/password, none for public endpoints). | Column authentication_scheme (STRING) in distribution.api_endpoint']
  authorization_scope varchar [note: 'The OAuth2 scope or permission level required to access this endpoint (e.g., read:content, write:profile, admin:all). Defines what actions the authenticated user is authorized to perform. | Column authorization_scope (STRING) in distribution.api_endpoint']
  cache_strategy varchar [note: 'The caching strategy applied to responses from this endpoint (no_cache for dynamic data, private for user-specific data, public for shared data, cdn for CDN-cacheable content). | Column cache_strategy (STRING) in distribution.api_endpoint']
  cache_ttl_seconds varchar [note: 'The time-to-live in seconds for cached responses from this endpoint. Defines how long the response can be cached before it must be revalidated. Null indicates no caching. | Column cache_ttl_seconds (INT) in distribution.api_endpoint']
  cors_enabled boolean [note: 'Indicates whether Cross-Origin Resource Sharing is enabled for this endpoint (true), allowing web browsers to make requests from different domains, or disabled (false) for same-origin only. | Column cors_enabled (BOOLEAN) in distribution.api_endpoint']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.api_endpoint']
  created_timestamp timestamp [note: 'The date and time when this API endpoint record was first created in the registry. Used for audit trail and lifecycle tracking. | Column created_timestamp (TIMESTAMP) in distribution.api_endpoint']
  deprecation_date date [note: 'The date when this endpoint was officially marked as deprecated. Used to track the deprecation timeline and communicate sunset schedules to API consumers. | Column deprecation_date (DATE) in distribution.api_endpoint']
  documentation_url varchar [note: 'The URL to the detailed API documentation for this endpoint, typically hosted in a developer portal or API documentation system (e.g., Swagger, Postman, Confluence). | Column documentation_url (STRING) in distribution.api_endpoint']
  endpoint_description varchar [note: 'Detailed description of the endpoint\'s purpose, functionality, and business use case. Explains what the endpoint does and when it should be used. | Column endpoint_description (STRING) in distribution.api_endpoint']
  endpoint_name varchar [note: 'Human-readable name or label for the API endpoint (e.g., Content Search, Playback Authorization, Subscriber Entitlement Check). | Column endpoint_name (STRING) in distribution.api_endpoint']
  endpoint_path varchar [note: 'The URI path of the API endpoint (e.g., /api/v2/content/search, /api/v1/playback/authorize). This is the resource path exposed to API consumers. | Column endpoint_path (STRING) in distribution.api_endpoint']
  endpoint_status varchar [note: 'The current operational status of the endpoint (active for production use, beta for testing with select partners, alpha for internal testing, inactive for disabled, maintenance for temporary unavailability). | Column endpoint_status (STRING) in distribution.api_endpoint']
  functional_category varchar [note: 'The business function or domain that this endpoint serves (e.g., content discovery for browsing, playback authorization for DRM, DAI for Dynamic Ad Insertion, EPG for Electronic Program Guide). [ENUM-REF-CANDIDATE: content_discovery|playback_authorization|subscriber_entitlement|epg|search|recommendation|dai|user_profile|analytics|billing — 10 candidates stripped; promote to reference product] | Column functional_category (STRING) in distribution.api_endpoint']
  http_method varchar [note: 'The HTTP method supported by this endpoint (GET for retrieval, POST for creation, PUT for full update, PATCH for partial update, DELETE for removal). [ENUM-REF-CANDIDATE: GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS — 7 candidates stripped; promote to reference product] | Column http_method (STRING) in distribution.api_endpoint']
  is_deprecated boolean [note: 'Indicates whether this endpoint has been marked as deprecated (true) and should no longer be used by new integrations. Deprecated endpoints are maintained for backward compatibility but will eventually be removed. | Column is_deprecated (BOOLEAN) in distribution.api_endpoint']
  is_public boolean [note: 'Indicates whether this endpoint is publicly accessible without authentication (true) or requires authentication (false). Public endpoints are typically used for content discovery and marketing. | Column is_public (BOOLEAN) in distribution.api_endpoint']
  last_modified_timestamp timestamp [note: 'The date and time when this API endpoint record was last updated. Used for change tracking and audit purposes. | Column last_modified_timestamp (TIMESTAMP) in distribution.api_endpoint']
  owning_service varchar [note: 'The name of the microservice or backend service that implements and owns this endpoint (e.g., content-service, playback-service, subscriber-service). Used for operational ownership and incident routing. | Column owning_service (STRING) in distribution.api_endpoint']
  owning_team varchar [note: 'The engineering team responsible for maintaining and supporting this endpoint (e.g., Content Platform Team, Playback Engineering, Subscriber Services). Used for escalation and change management. | Column owning_team (STRING) in distribution.api_endpoint']
  rate_limit_requests_per_day varchar [note: 'The maximum number of requests allowed per day for this endpoint under the assigned rate limit tier. Used for daily quota enforcement. | Column rate_limit_requests_per_day (INT) in distribution.api_endpoint']
  rate_limit_requests_per_minute varchar [note: 'The maximum number of requests allowed per minute for this endpoint under the assigned rate limit tier. Null indicates no specific limit or unlimited access. | Column rate_limit_requests_per_minute (INT) in distribution.api_endpoint']
  rate_limit_tier varchar [note: 'The rate limiting tier applied to this endpoint, determining how many requests per time window are allowed (e.g., public tier allows 100 req/min, enterprise allows 10000 req/min). | Column rate_limit_tier (STRING) in distribution.api_endpoint']
  replacement_endpoint_path varchar [note: 'The URI path of the replacement endpoint that should be used instead of this deprecated endpoint. Null if no direct replacement exists. Used to guide API consumers during migration. | Column replacement_endpoint_path (STRING) in distribution.api_endpoint']
  request_content_type varchar [note: 'The expected content type for the request body (e.g., application/json for JSON payloads, application/xml for XML). Null for endpoints that do not accept a request body (e.g., GET requests). | Column request_content_type (STRING) in distribution.api_endpoint']
  response_content_type varchar [note: 'The content type returned by this endpoint in the response body (e.g., application/json for JSON responses, application/xml for XML). Defines the format of the data returned to the client. | Column response_content_type (STRING) in distribution.api_endpoint']
  sla_response_time_ms varchar [note: 'The target response time in milliseconds for this endpoint under normal load conditions (e.g., 200ms for p95, 500ms for p99). Used for performance monitoring and alerting. | Column sla_response_time_ms (INT) in distribution.api_endpoint']
  sla_tier varchar [note: 'The service level agreement tier for this endpoint, defining uptime guarantees, response time targets, and support priority (e.g., mission_critical requires 99.99% uptime, gold requires 99.9%). | Column sla_tier (STRING) in distribution.api_endpoint']
  sla_uptime_percentage decimal(5,2) [note: 'The guaranteed uptime percentage for this endpoint as defined in the SLA (e.g., 99.99 for four nines, 99.9 for three nines). Measured monthly. | Column sla_uptime_percentage (DECIMAL(5,2)) in distribution.api_endpoint']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.api_endpoint']
  sunset_date date [note: 'The planned date when this endpoint will be permanently removed and no longer available. Null if no sunset is planned. Used to give API consumers advance notice for migration. | Column sunset_date (DATE) in distribution.api_endpoint']
  supports_filtering boolean [note: 'Indicates whether this endpoint supports query parameter filtering to narrow down results (true) or returns a fixed result set (false). Filtering allows clients to request specific subsets of data. | Column supports_filtering (BOOLEAN) in distribution.api_endpoint']
  supports_pagination boolean [note: 'Indicates whether this endpoint supports pagination for large result sets (true) or returns all results in a single response (false). Paginated endpoints typically accept page and page_size query parameters. | Column supports_pagination (BOOLEAN) in distribution.api_endpoint']
  supports_sorting boolean [note: 'Indicates whether this endpoint supports query parameter sorting to order results (true) or returns results in a default order (false). Sorting allows clients to control result ordering. | Column supports_sorting (BOOLEAN) in distribution.api_endpoint']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.api_endpoint']

  Note: 'Master registry of all business-facing API endpoints exposed by the OTT platform — content discovery, playback authorization, subscriber entitlement, EPG, search, recommendation, and DAI (Dynamic Ad Insertion) APIs. Captures endpoint path, HTTP method, API version, authentication scheme (OAuth2, API key, JWT), rate limit policy, SLA tier, deprecation date, owning service, and documentation URL. Distinct from streaming_endpoint (media delivery) — this governs the application API surface. | Unity Catalog table: media_broadcasting_ecm.distribution.api_endpoint'
}

Table distribution.personalization_engine {
  personalization_engine_id varchar [pk, note: 'Unique identifier for the personalization engine instance. Primary key for the personalization engine configuration record. | Column personalization_engine_id (BIGINT) in distribution.personalization_engine']
  compliance_consent_record_id varchar [note: 'Foreign key linking to compliance.consent_record. Business justification: Personalization engines processing user data must validate consent before profiling. Engine operations are gated by consent status for analytics, personalization, and third-party sharing. | Column compliance_consent_record_id (BIGINT) in compliance.personalization_engine']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Recommendation algorithms incorporate demographic signals for content discovery, cold-start personalization, and Nielsen-aligned performance prediction. Supports demographic-based A/B testing and enga | Column demographic_segment_id (BIGINT) in audience.personalization_engine']
  fallback_engine_personalization_engine_id varchar [note: 'Reference to an alternative personalization engine to use if this engine fails or returns insufficient recommendations. Ensures continuous user experience during engine failures or maintenance. | Column fallback_engine_personalization_engine_id (BIGINT) in distribution.personalization_engine']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: Personalization engines are deployed per OTT platform. Each engine instance serves a specific platform. Removes target_platform STRING (derivable from ott_platform). | Column ott_platform_id (BIGINT) in distribution.personalization_engine']
  owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Personalization engines require data science/ML engineering ownership for model training, A/B test analysis, performance monitoring, and GDPR/CCPA compliance. Essential for accountability in recommend | Column owner_employee_id (BIGINT) in workforce.personalization_engine']
  segment_id varchar [note: 'Foreign key linking to audience.audience_segment. Business justification: Modern personalization relies on behavioral segments for recommendation accuracy and engagement optimization. Supports genre affinity modeling, viewing pattern analysis, and cross-platform content dis | Column segment_id (BIGINT) in audience.personalization_engine']
  software_license_id varchar [note: 'Foreign key linking to technology.software_license. Business justification: Personalization engines use licensed ML frameworks. Required for ML software license compliance and engine cost allocation. | Column software_license_id (BIGINT) in technology.personalization_engine']
  tech_project_id varchar [note: 'Foreign key linking to technology.tech_project. Business justification: Personalization engines are deployed via ML projects. Required for personalization project ROI tracking and model deployment timeline management. | Column tech_project_id (BIGINT) in technology.personalization_engine']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.personalization_engine']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.personalization_engine']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.personalization_engine']
  ab_test_variant varchar [note: 'A/B test variant identifier if this engine is part of an experimentation framework (e.g., \'control\', \'variant_a\', \'variant_b\'). Null if not part of active testing. | Column ab_test_variant (STRING) in distribution.personalization_engine']
  algorithm_type varchar [note: 'The machine learning algorithm type used by the personalization engine. Collaborative filtering uses user behavior patterns, content-based uses content attributes, hybrid combines both approaches, matrix factorization decomposes user-item interactions, deep learning uses neural networks, and contextual bandit balances exploration and exploitation. | Column algorithm_type (STRING) in distribution.personalization_engine']
  api_endpoint_url varchar [note: 'Uniform Resource Locator (URL) of the Application Programming Interface (API) endpoint that serves recommendations from this engine. Used by client applications to request personalized content. | Column api_endpoint_url (STRING) in distribution.personalization_engine']
  business_justification varchar [note: 'Business rationale and expected outcomes for deploying this personalization engine (e.g., \'Increase Average Revenue Per User (ARPU) by 15%\', \'Reduce churn rate by improving content discovery\', \'Support new FAST channel launch\'). | Column business_justification (STRING) in distribution.personalization_engine']
  cache_ttl_seconds varchar [note: 'Time-To-Live (TTL) in seconds for cached recommendations. Balances recommendation freshness against system performance. Shorter TTL provides more current recommendations but increases computational load. | Column cache_ttl_seconds (INT) in distribution.personalization_engine']
  ccpa_compliant_flag boolean [note: 'Boolean indicator of whether this personalization engine complies with California Consumer Privacy Act (CCPA) requirements, including opt-out mechanisms and data sale restrictions. | Column ccpa_compliant_flag (BOOLEAN) in distribution.personalization_engine']
  cold_start_strategy varchar [note: 'Strategy used to generate recommendations for new users or content with insufficient interaction history. Popularity-based shows trending content, content similarity uses metadata matching, demographic default uses segment averages, hybrid fallback combines multiple approaches, and random exploration introduces serendipity. | Column cold_start_strategy (STRING) in distribution.personalization_engine']
  confidence_threshold decimal(5,2) [note: 'Minimum confidence score (0.00 to 1.00) required for a recommendation to be surfaced to users. Lower thresholds increase recommendation volume but may reduce relevance. | Column confidence_threshold (DECIMAL(5,2)) in distribution.personalization_engine']
  content_filter_rules varchar [note: 'Business rules defining content eligibility for recommendations (e.g., exclude expired rights, enforce parental controls, respect geographic blackouts, honor windowing restrictions). Stored as structured text or JSON. | Column content_filter_rules (STRING) in distribution.personalization_engine']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.personalization_engine']
  created_timestamp timestamp [note: 'Timestamp when this personalization engine configuration record was first created in the system. Used for audit trail and data lineage tracking. | Column created_timestamp (TIMESTAMP) in distribution.personalization_engine']
  deployment_date date [note: 'Date when this personalization engine instance was first deployed to production. Used for tracking engine age and performance trends over time. | Column deployment_date (DATE) in distribution.personalization_engine']
  diversity_threshold decimal(5,2) [note: 'Minimum diversity score (0.00 to 1.00) enforced in recommendation sets to prevent filter bubbles. Higher values ensure greater variety in content genres, formats, and themes. | Column diversity_threshold (DECIMAL(5,2)) in distribution.personalization_engine']
  engine_code varchar [note: 'Unique business identifier code for the personalization engine (e.g., \'HOME_REC_01\', \'CONT_DISC_02\'). Used for system integration and API references. | Column engine_code (STRING) in distribution.personalization_engine']
  engine_name varchar [note: 'Human-readable name of the personalization engine instance (e.g., \'Homepage Recommender\', \'Content Discovery Engine\', \'Next Episode Predictor\'). Used for operational identification and reporting. | Column engine_name (STRING) in distribution.personalization_engine']
  feature_set_configuration varchar [note: 'JSON or structured text describing the feature set used by the model (e.g., viewing history, genre preferences, time-of-day patterns, device type, engagement metrics). Defines the input variables for the recommendation algorithm. | Column feature_set_configuration (STRING) in distribution.personalization_engine']
  gdpr_compliant_flag boolean [note: 'Boolean indicator of whether this personalization engine complies with General Data Protection Regulation (GDPR) requirements for audience data processing, including consent management, data minimization, and right to erasure. | Column gdpr_compliant_flag (BOOLEAN) in distribution.personalization_engine']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to this personalization engine configuration record. Critical for change tracking and configuration management. | Column last_modified_timestamp (TIMESTAMP) in distribution.personalization_engine']
  last_training_timestamp timestamp [note: 'Timestamp of the most recent model training execution. Critical for monitoring model freshness and ensuring recommendations reflect current user behavior patterns. | Column last_training_timestamp (TIMESTAMP) in distribution.personalization_engine']
  model_version varchar [note: 'Semantic version number of the deployed machine learning model (e.g., \'v1.2.3\'). Follows semantic versioning convention for model lifecycle management and rollback capability. | Column model_version (STRING) in distribution.personalization_engine']
  operational_status varchar [note: 'Current operational state of the personalization engine. Active engines serve live traffic, inactive are disabled, testing are in validation phase, deprecated are scheduled for retirement, and maintenance indicates temporary unavailability. | Column operational_status (STRING) in distribution.personalization_engine']
  owner_team varchar [note: 'Name of the business or technical team responsible for this personalization engine instance. Used for operational accountability and incident escalation. | Column owner_team (STRING) in distribution.personalization_engine']
  performance_metric_target varchar [note: 'Primary business metric this personalization engine is optimized to maximize. Click-through rate measures initial engagement, watch time measures sustained viewing, completion rate measures content finish rate, engagement score is a composite metric, and revenue per user measures monetization impact. | Column performance_metric_target (STRING) in distribution.personalization_engine']
  personalization_scope varchar [note: 'Granularity level at which personalization is applied. User-level provides individual recommendations, segment-level groups similar users, household-level considers shared viewing, and device-level adapts to device context. | Column personalization_scope (STRING) in distribution.personalization_engine']
  recommendation_count_limit varchar [note: 'Maximum number of recommendations this engine will return per request. Typical values range from 10 to 100 depending on user interface requirements and performance constraints. | Column recommendation_count_limit (INT) in distribution.personalization_engine']
  refresh_cadence varchar [note: 'Frequency at which the personalization model is retrained or recommendations are regenerated. Real-time engines update continuously, while batch engines refresh on schedule. | Column refresh_cadence (STRING) in distribution.personalization_engine']
  response_time_sla_ms varchar [note: 'Maximum acceptable response time in milliseconds for recommendation requests as defined in the Service Level Agreement (SLA). Typical values range from 100ms to 500ms for real-time engines. | Column response_time_sla_ms (INT) in distribution.personalization_engine']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.personalization_engine']
  training_data_window_days varchar [note: 'Number of days of historical data used to train the personalization model. Typical values range from 30 to 365 days depending on content velocity and user behavior patterns. | Column training_data_window_days (INT) in distribution.personalization_engine']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.personalization_engine']

  Note: 'Master configuration record for each personalization and recommendation engine instance deployed on the OTT platform (Adobe Experience Platform integration). Captures engine name, algorithm type (collaborative filtering, content-based, hybrid), model version, training data window, feature set configuration, A/B test variant assignment, target platform, refresh cadence, cold-start strategy, and operational status. SSOT for the personalization layer configuration distinct from individual recommendation events. | Unity Catalog table: media_broadcasting_ecm.distribution.personalization_engine'
}

Table distribution.dai_configuration {
  dai_configuration_id varchar [pk, note: 'Unique identifier for the DAI configuration record. Primary key. | Column dai_configuration_id (BIGINT) in distribution.dai_configuration']
  configuration_owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: DAI configurations control ad insertion logic and revenue streams, requiring ownership for approval workflows, fill rate troubleshooting, blackout override decisions, and ad server contract compliance | Column configuration_owner_employee_id (BIGINT) in workforce.dai_configuration']
  ott_platform_id varchar [note: 'Foreign key linking to distribution.ott_platform. Business justification: DAI configurations are platform-specific. Each DAI config applies to a specific OTT platform for ad insertion rules and targeting. | Column ott_platform_id (BIGINT) in distribution.dai_configuration']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.dai_configuration']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.dai_configuration']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.dai_configuration']
  abr_profile_compatibility varchar [note: 'Comma-separated list of ABR streaming profiles this DAI configuration is compatible with (e.g., HLS, MPEG-DASH, Smooth Streaming). | Column abr_profile_compatibility (STRING) in distribution.dai_configuration']
  ad_decision_server_url varchar [note: 'Endpoint URL for the Ad Decision Server that determines which ads to serve based on targeting criteria and inventory availability. | Column ad_decision_server_url (STRING) in distribution.dai_configuration']
  ad_format_support varchar [note: 'Comma-separated list of supported ad formats for this configuration (e.g., VAST, VMAP, VPAID, SIMID). | Column ad_format_support (STRING) in distribution.dai_configuration']
  ad_pod_placement_rules varchar [note: 'Business rules defining where ad pods (groups of ads in a break) can be inserted within the content, including pre-roll, mid-roll, and post-roll positions. | Column ad_pod_placement_rules (STRING) in distribution.dai_configuration']
  ad_server_timeout_milliseconds varchar [note: 'Maximum time in milliseconds to wait for a response from the ad decision server before triggering fallback logic. | Column ad_server_timeout_milliseconds (INT) in distribution.dai_configuration']
  backup_ad_server_url varchar [note: 'Failover endpoint URL for ad decision requests when the primary ad server is unavailable or times out. | Column backup_ad_server_url (STRING) in distribution.dai_configuration']
  blackout_override_enabled boolean [note: 'Indicates whether this DAI configuration can override geographic blackout restrictions for ad insertion purposes. | Column blackout_override_enabled (BOOLEAN) in distribution.dai_configuration']
  cdn_integration_mode varchar [note: 'How the DAI system integrates with the CDN: direct (CDN serves pre-stitched streams), proxied (DAI proxies through CDN), or edge decisioning (ad decisions at CDN edge). | Column cdn_integration_mode (STRING) in distribution.dai_configuration']
  companion_ads_enabled boolean [note: 'Indicates whether companion banner ads are displayed alongside video ads to enhance engagement and click-through rates. | Column companion_ads_enabled (BOOLEAN) in distribution.dai_configuration']
  configuration_code varchar [note: 'Unique alphanumeric code identifying this DAI configuration across systems and platforms. | Column configuration_code (STRING) in distribution.dai_configuration']
  configuration_name varchar [note: 'Human-readable name for this DAI configuration, used for identification and reference by operations teams. | Column configuration_name (STRING) in distribution.dai_configuration']
  configuration_status varchar [note: 'Current lifecycle status of this DAI configuration: active (in production use), inactive (not in use), testing (under validation), or deprecated (scheduled for removal). | Column configuration_status (STRING) in distribution.dai_configuration']
  configuration_version varchar [note: 'Version number of this configuration, incremented with each modification to support change tracking and rollback capabilities. | Column configuration_version (INT) in distribution.dai_configuration']
  content_type varchar [note: 'Type of content this DAI configuration applies to: Video On Demand (VOD), live streaming, linear broadcast, or Free Ad-Supported Streaming Television (FAST) channels. | Column content_type (STRING) in distribution.dai_configuration']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.dai_configuration']
  created_timestamp timestamp [note: 'Timestamp when this DAI configuration record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.dai_configuration']
  device_targeting_enabled boolean [note: 'Indicates whether device-specific targeting is enabled to serve ads optimized for the viewers device type (mobile, tablet, TV, desktop). | Column device_targeting_enabled (BOOLEAN) in distribution.dai_configuration']
  drm_enforcement_mode varchar [note: 'Level of DRM enforcement applied to ad content: strict (full encryption), lenient (selective protection), or disabled (no DRM on ads). | Column drm_enforcement_mode (STRING) in distribution.dai_configuration']
  effective_end_date date [note: 'Date when this DAI configuration expires and is no longer eligible for use. Null indicates no expiration. | Column effective_end_date (DATE) in distribution.dai_configuration']
  effective_start_date date [note: 'Date when this DAI configuration becomes active and eligible for use in ad insertion workflows. | Column effective_start_date (DATE) in distribution.dai_configuration']
  fallback_creative_strategy varchar [note: 'Strategy for handling unfilled ad inventory: display house ads, show slate/filler, continue content, or repeat the last served ad. | Column fallback_creative_strategy (STRING) in distribution.dai_configuration']
  fill_rate_target_percentage decimal(5,2) [note: 'Target percentage of available ad inventory that should be filled with paid advertisements, used to measure monetization effectiveness. | Column fill_rate_target_percentage (DECIMAL(5,2)) in distribution.dai_configuration']
  frequency_cap_enabled boolean [note: 'Indicates whether frequency capping is enforced to limit the number of times a viewer sees the same ad within a session or time period. | Column frequency_cap_enabled (BOOLEAN) in distribution.dai_configuration']
  geo_targeting_enabled boolean [note: 'Indicates whether geographic targeting is enabled to serve location-specific ads based on viewer IP address or device location. | Column geo_targeting_enabled (BOOLEAN) in distribution.dai_configuration']
  last_modified_timestamp timestamp [note: 'Timestamp when this DAI configuration record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in distribution.dai_configuration']
  max_ad_pod_duration_seconds varchar [note: 'Maximum allowed duration in seconds for a single ad pod insertion, ensuring viewer experience and regulatory compliance. | Column max_ad_pod_duration_seconds (INT) in distribution.dai_configuration']
  max_impressions_per_hour varchar [note: 'Maximum number of times the same ad creative can be shown to a viewer within a one-hour period when frequency capping is enabled. | Column max_impressions_per_hour (INT) in distribution.dai_configuration']
  max_impressions_per_session varchar [note: 'Maximum number of times the same ad creative can be shown to a viewer within a single viewing session when frequency capping is enabled. | Column max_impressions_per_session (INT) in distribution.dai_configuration']
  min_ad_pod_duration_seconds varchar [note: 'Minimum required duration in seconds for an ad pod to be considered valid for insertion. | Column min_ad_pod_duration_seconds (INT) in distribution.dai_configuration']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this DAI configuration record. | Column modified_by_user (STRING) in distribution.dai_configuration']
  notes varchar [note: 'Free-text field for operational notes, special instructions, or context about this DAI configuration. | Column notes (STRING) in distribution.dai_configuration']
  priority_level varchar [note: 'Numeric priority level used to resolve conflicts when multiple DAI configurations could apply to the same content. Higher values indicate higher priority. | Column priority_level (INT) in distribution.dai_configuration']
  programmatic_enabled boolean [note: 'Flag indicating programmatic advertising support']
  scte35_signal_handling varchar [note: 'How SCTE-35 cue markers embedded in the content stream are processed: enabled (parse and act), disabled (ignore), or passthrough (forward without processing). | Column scte35_signal_handling (STRING) in distribution.dai_configuration']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.dai_configuration']
  stitching_mode varchar [note: 'Method used to insert ads into the content stream: server-side stitching (SSAI), client-side stitching (CSAI), or hybrid approach combining both. | Column stitching_mode (STRING) in distribution.dai_configuration']
  tracking_events_enabled boolean [note: 'Indicates whether ad tracking events (impressions, quartiles, completions, clicks) are captured and reported to measurement systems. | Column tracking_events_enabled (BOOLEAN) in distribution.dai_configuration']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.dai_configuration']

  Note: 'Configuration records for Dynamic Ad Insertion (DAI) on the OTT platform — defining ad pod placement rules, SCTE-35 signal handling, ad decision server (ADS) endpoints, fill-rate fallback logic, ad stitching mode (server-side vs client-side), blackout override rules, and frequency cap enforcement. Captures DAI config name, applicable content type (VOD, live), ad server URL, timeout thresholds, and effective date. Bridges the platform domain with the advertising domain\'s campaign delivery. | Unity Catalog table: media_broadcasting_ecm.distribution.dai_configuration'
}

Table distribution.feature_flag {
  feature_flag_id varchar [pk, note: 'Unique identifier for the feature flag configuration record. | Column feature_flag_id (BIGINT) in distribution.feature_flag']
  owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Feature flags control user experience and require product manager ownership for rollout decisions, kill switch activation during incidents, A/B test result analysis, and experiment hypothesis validati | Column owner_employee_id (BIGINT) in workforce.feature_flag']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.feature_flag']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.feature_flag']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.feature_flag']
  app_version_max varchar [note: 'Maximum Over-The-Top (OTT) application version for which this feature flag is active (semantic versioning format: major.minor.patch). Null if no upper bound. | Column app_version_max (STRING) in distribution.feature_flag']
  app_version_min varchar [note: 'Minimum Over-The-Top (OTT) application version required for this feature flag to be active (semantic versioning format: major.minor.patch). | Column app_version_min (STRING) in distribution.feature_flag']
  approval_status varchar [note: 'Approval workflow status for feature flag changes: pending (awaiting review), approved (authorized for deployment), rejected (change denied). | Column approval_status (STRING) in distribution.feature_flag']
  approved_by varchar [note: 'Username or identifier of the product owner or technical lead who approved this feature flag for deployment. Null if not yet approved. | Column approved_by (STRING) in distribution.feature_flag']
  approved_timestamp timestamp [note: 'Timestamp when this feature flag configuration was approved for deployment. Null if not yet approved. | Column approved_timestamp (TIMESTAMP) in distribution.feature_flag']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.feature_flag']
  created_timestamp timestamp [note: 'Timestamp when this feature flag record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.feature_flag']
  dependency_flags varchar [note: 'Comma-separated list of other feature flag keys that must be enabled for this flag to function correctly. Captures flag interdependencies. | Column dependency_flags (STRING) in distribution.feature_flag']
  effective_end_date timestamp [note: 'Timestamp when the feature flag expires and is automatically disabled. Null for indefinite flags. | Column effective_end_date (TIMESTAMP) in distribution.feature_flag']
  effective_start_date timestamp [note: 'Timestamp when the feature flag becomes active and begins controlling feature availability or behavior. | Column effective_start_date (TIMESTAMP) in distribution.feature_flag']
  enabled_flag boolean [note: 'Boolean indicator of whether the feature flag is currently enabled (True) or disabled (False) for the target audience. | Column enabled_flag (BOOLEAN) in distribution.feature_flag']
  evaluation_count varchar [note: 'Total number of times this feature flag has been evaluated by application code since activation. Used for usage analytics and cleanup decisions. | Column evaluation_count (BIGINT) in distribution.feature_flag']
  experiment_hypothesis varchar [note: 'Business hypothesis being tested when flag_type is \'experiment\' (e.g., \'Personalized content rail will increase engagement by 15%\'). Null for non-experiment flags. | Column experiment_hypothesis (STRING) in distribution.feature_flag']
  feature_flag_description varchar [note: 'Detailed business description of the feature controlled by this flag, including purpose, expected behavior, and rollout strategy. | Column feature_flag_description (STRING) in distribution.feature_flag']
  flag_key varchar [note: 'Unique programmatic identifier for the feature flag used in application code (e.g., \'new_player_ui\', \'personalized_rail_v2\'). Must be unique across the platform. | Column flag_key (STRING) in distribution.feature_flag']
  flag_name varchar [note: 'Human-readable display name for the feature flag shown in management dashboards and reporting interfaces. | Column flag_name (STRING) in distribution.feature_flag']
  flag_status varchar [note: 'Current lifecycle status of the feature flag: active (in use), inactive (temporarily disabled), archived (no longer needed but retained for audit), deprecated (scheduled for removal). | Column flag_status (STRING) in distribution.feature_flag']
  flag_type varchar [note: 'Classification of the feature flag purpose: release_toggle (gradual feature rollout), experiment (A/B test variant), ops_toggle (operational control), permission_toggle (access control), ux_variant (user experience configuration), kill_switch (emergency disable capability). | Column flag_type (STRING) in distribution.feature_flag']
  kill_switch_enabled boolean [note: 'Boolean indicator of whether this flag can be used as an emergency kill switch to rapidly disable a feature without application redeployment. | Column kill_switch_enabled (BOOLEAN) in distribution.feature_flag']
  last_evaluation_timestamp timestamp [note: 'Timestamp of the most recent evaluation of this feature flag by any application instance. Used to identify stale or unused flags. | Column last_evaluation_timestamp (TIMESTAMP) in distribution.feature_flag']
  modified_by varchar [note: 'Username or identifier of the user who last modified this feature flag configuration. | Column modified_by (STRING) in distribution.feature_flag']
  modified_timestamp timestamp [note: 'Timestamp when this feature flag record was last modified. | Column modified_timestamp (TIMESTAMP) in distribution.feature_flag']
  owning_product_team varchar [note: 'Name of the product team responsible for managing this feature flag and making rollout decisions (e.g., \'Player Experience Team\', \'Personalization Team\'). | Column owning_product_team (STRING) in distribution.feature_flag']
  priority_level varchar [note: 'Business priority classification for this feature flag indicating urgency and impact: critical (revenue-impacting or regulatory), high (major feature), medium (enhancement), low (minor tweak). | Column priority_level (STRING) in distribution.feature_flag']
  rollout_percentage decimal(5,2) [note: 'Percentage of the target audience to which the feature is rolled out (0.00 to 100.00). Enables gradual feature deployment and canary releases. | Column rollout_percentage (DECIMAL(5,2)) in distribution.feature_flag']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.feature_flag']
  tags varchar [note: 'Comma-separated list of tags for categorization and filtering (e.g., \'personalization\', \'monetization\', \'compliance\', \'performance\'). Enables flag discovery and governance. | Column tags (STRING) in distribution.feature_flag']
  target_audience_segment varchar [note: 'Audience segment or cohort identifier to which this feature flag applies (e.g., \'premium_subscribers\', \'beta_testers\', \'geo_usa_west\'). References audience segmentation taxonomy. | Column target_audience_segment (STRING) in distribution.feature_flag']
  target_platform varchar [note: 'Over-The-Top (OTT) platform or device type where this feature flag is deployed: web (browser-based), ios (Apple mobile), android (Android mobile), roku, fire_tv, apple_tv, samsung_tv, lg_tv, or all_platforms for cross-platform flags. [ENUM-REF-CANDIDATE: web|ios|android|roku|fire_tv|apple_tv|samsung_tv|lg_tv|all_platforms — 9 candidates stripped; promote to reference product] | Column target_platform (STRING) in distribution.feature_flag']
  traffic_split_percentage decimal(5,2) [note: 'Percentage of traffic allocated to variant B in A/B experiments (0.00 to 100.00). Remaining traffic goes to variant A. Null for non-experiment flags. | Column traffic_split_percentage (DECIMAL(5,2)) in distribution.feature_flag']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.feature_flag']
  ux_configuration_json varchar [note: 'JSON-encoded configuration parameters for user experience variants including rail ordering, theme selection, layout variant, navigation structure, and other UX-specific settings controlled by this flag. | Column ux_configuration_json (STRING) in distribution.feature_flag']
  variant_a_config varchar [note: 'Configuration parameters for variant A in A/B test experiments (typically the control group). JSON-encoded or plain text depending on complexity. | Column variant_a_config (STRING) in distribution.feature_flag']
  variant_b_config varchar [note: 'Configuration parameters for variant B in A/B test experiments (typically the treatment group). JSON-encoded or plain text depending on complexity. | Column variant_b_config (STRING) in distribution.feature_flag']
  created_by varchar [note: 'Username or identifier of the product manager or engineer who created this feature flag configuration. | Column created_by (STRING) in distribution.feature_flag']

  Note: 'Business configuration registry of feature flags, A/B test variants, UX experiments, and controlled rollout configurations deployed across OTT platform app versions. Captures flag name, flag type (release toggle, experiment, ops toggle, permission, UX variant), target platform, target audience segment or cohort, enabled/disabled state, rollout percentage, experiment hypothesis, UX configuration parameters (rail ordering, theme, layout variant), start and end dates, and owning product team. Enables controlled feature rollouts, UX experimentation, multivariate testing, and rapid kill-switch capability without app redeployment. | Unity Catalog table: media_broadcasting_ecm.distribution.feature_flag'
}

Table distribution.distribution_partner {
  distribution_partner_id varchar [pk, note: 'Unique identifier for the distribution partner. Primary key for the distribution partner entity. | Column distribution_partner_id (BIGINT) in distribution.distribution_partner']
  assigned_sales_territory_id varchar [note: 'Foreign key linking to sales.sales_territory. Business justification: Distribution partners (MVPDs, cable operators, streaming aggregators) are assigned to sales territories for account management. Supports territory-based partner relationship management, quota allocati | Column assigned_sales_territory_id (BIGINT) in sales.distribution_partner']
  billing_account_id varchar [note: 'Foreign key linking to billing.account. Business justification: Distribution partners (MVPDs, cable operators, streaming aggregators) are billing customers for carriage fees, retransmission consent, and content licensing. Real business process: partner invoicing,  | Column billing_account_id (BIGINT) in billing.distribution_partner']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Distribution partners have co-located equipment at broadcaster facilities. Required for partner technical integration coordination and facility access control management. | Column broadcast_facility_id (BIGINT) in technology.distribution_partner']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: MVPDs and distribution partners may operate under their own broadcast licenses when originating content or providing local broadcast services. Partner licensing status affects carriage eligibility and | Column broadcast_license_id (BIGINT) in compliance.distribution_partner']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Large distribution partners (MVPDs, cable operators) have dedicated cost centers for partner management expenses including account management, technical support, and integration costs. Monthly cost al | Column cost_center_id (BIGINT) in finance.distribution_partner']
  network_circuit_id varchar [note: 'Foreign key linking to technology.network_circuit. Business justification: Distribution partners connect via dedicated network circuits. Required for partner circuit billing reconciliation and SLA compliance tracking. | Column network_circuit_id (BIGINT) in technology.distribution_partner']
  partner_id varchar [note: 'FK to canonical partner entity | Column partner_id (BIGINT) in partner.distribution_partner']
  relationship_manager_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Distribution partnerships require dedicated relationship managers for contract negotiations, SLA dispute resolution, carriage fee negotiations, and technical integration oversight. Essential for escal | Column relationship_manager_employee_id (BIGINT) in workforce.distribution_partner']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.distribution_partner']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.distribution_partner']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.distribution_partner']
  abr_profile_support varchar [note: 'Description of Adaptive Bitrate streaming profiles and quality tiers supported by the distribution partner for OTT and streaming delivery. Includes resolution ranges, bitrate ladders, and codec support. | Column abr_profile_support (STRING) in distribution.distribution_partner']
  blackout_capability_flag boolean [note: 'Indicates whether the distribution partner has technical capability to enforce geographic broadcast restrictions and content blackouts based on licensing and rights windows. | Column blackout_capability_flag (BOOLEAN) in distribution.distribution_partner']
  carriage_capacity_channels varchar [note: 'Number of linear channels or content streams that the distribution partner has capacity to carry simultaneously. Relevant for MVPD, vMVPD, and cable operators. | Column carriage_capacity_channels (INT) in distribution.distribution_partner']
  carriage_fee_model varchar [note: 'Commercial model for carriage fees paid by or to the distribution partner. Per Subscriber indicates fees based on subscriber count, Flat Rate indicates fixed periodic payment, Revenue Share indicates percentage of advertising or subscription revenue, Hybrid indicates combination of models. | Column carriage_fee_model (STRING) in distribution.distribution_partner']
  cdn_provider varchar [note: 'Name of the Content Delivery Network provider used by the distribution partner for content streaming and delivery. May include Akamai, Cloudflare, AWS CloudFront, or partner-owned CDN infrastructure. | Column cdn_provider (STRING) in distribution.distribution_partner']
  contract_end_date date [note: 'Date when the current distribution agreement with the partner expires or is scheduled for renewal. Null indicates open-ended or evergreen agreement. | Column contract_end_date (DATE) in distribution.distribution_partner']
  contract_renewal_notice_days varchar [note: 'Number of days advance notice required for contract renewal or termination as specified in the distribution agreement. | Column contract_renewal_notice_days (INT) in distribution.distribution_partner']
  contract_start_date date [note: 'Date when the current distribution agreement with the partner became effective. | Column contract_start_date (DATE) in distribution.distribution_partner']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.distribution_partner']
  created_timestamp timestamp [note: 'Timestamp when this distribution partner record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.distribution_partner']
  dai_support_flag boolean [note: 'Indicates whether the distribution partner supports Dynamic Ad Insertion technology for server-side ad stitching in streaming content. | Column dai_support_flag (BOOLEAN) in distribution.distribution_partner']
  drm_capability varchar [note: 'Digital Rights Management systems and encryption standards supported by the distribution partner. May include Widevine, FairPlay, PlayReady, and other DRM technologies. | Column drm_capability (STRING) in distribution.distribution_partner']
  geographic_footprint varchar [note: 'Description of the geographic markets, regions, or territories served by this distribution partner. May include country codes, DMA (Designated Market Area) codes, or regional descriptors. | Column geographic_footprint (STRING) in distribution.distribution_partner']
  headquarters_address varchar [note: 'Physical address of the distribution partner\'s corporate headquarters or primary business location. | Column headquarters_address (STRING) in distribution.distribution_partner']
  headquarters_city varchar [note: 'City where the distribution partner\'s headquarters is located. | Column headquarters_city (STRING) in distribution.distribution_partner']
  headquarters_country_code varchar [note: 'Three-letter ISO country code representing the country where the distribution partner\'s headquarters is located. | Column headquarters_country_code (STRING) in distribution.distribution_partner']
  headquarters_postal_code varchar [note: 'Postal or ZIP code for the distribution partner\'s headquarters location. | Column headquarters_postal_code (STRING) in distribution.distribution_partner']
  headquarters_state_province varchar [note: 'State, province, or administrative region where the distribution partner\'s headquarters is located. | Column headquarters_state_province (STRING) in distribution.distribution_partner']
  last_modified_timestamp timestamp [note: 'Timestamp when this distribution partner record was most recently updated or modified. | Column last_modified_timestamp (TIMESTAMP) in distribution.distribution_partner']
  must_carry_obligation_flag boolean [note: 'Indicates whether the distribution partner has a must-carry obligation requiring mandatory inclusion of certain broadcast channels under FCC regulations. | Column must_carry_obligation_flag (BOOLEAN) in distribution.distribution_partner']
  notes varchar [note: 'Free-form text field for additional notes, special instructions, or contextual information about the distribution partner relationship. | Column notes (STRING) in distribution.distribution_partner']
  partner_tier varchar [note: 'Strategic classification of the partner based on reach, revenue contribution, and business importance. Tier 1 represents largest national/international partners, Tier 2 represents regional significant partners, Tier 3 represents local or niche partners. | Column partner_tier (STRING) in distribution.distribution_partner']
  partner_type varchar [note: 'Classification of the distribution partner based on delivery model. MVPD (Multichannel Video Programming Distributor) includes traditional cable, satellite, and telco providers. vMVPD (Virtual MVPD) includes internet-based multichannel services. OTT Platform includes direct-to-consumer streaming services. FAST Aggregator includes Free Ad-Supported Streaming Television channel aggregators. Syndication Outlet includes broadcast stations and regional networks. | Column partner_type (STRING) in distribution.distribution_partner']
  payment_terms_days varchar [note: 'Standard payment terms in days for invoices related to carriage fees, revenue share, or other financial transactions with the distribution partner. | Column payment_terms_days (INT) in distribution.distribution_partner']
  portal_url varchar [note: 'Web URL for the distribution partner\'s business portal, technical documentation, or partner management system. | Column portal_url (STRING) in distribution.distribution_partner']
  preferred_currency_code varchar [note: 'Three-letter ISO currency code for financial transactions and reporting with this distribution partner. | Column preferred_currency_code (STRING) in distribution.distribution_partner']
  primary_contact_email varchar [note: 'Email address of the primary business contact for distribution operations, technical coordination, and business communications. | Column primary_contact_email (STRING) in distribution.distribution_partner']
  primary_contact_name varchar [note: 'Full name of the primary business contact at the distribution partner organization for operational coordination and escalation. | Column primary_contact_name (STRING) in distribution.distribution_partner']
  primary_contact_phone varchar [note: 'Primary telephone number for reaching the distribution partner contact for urgent operational matters and coordination. | Column primary_contact_phone (STRING) in distribution.distribution_partner']
  qos_monitoring_enabled_flag boolean [note: 'Indicates whether active Quality of Service monitoring and reporting is enabled for content delivery through this distribution partner. | Column qos_monitoring_enabled_flag (BOOLEAN) in distribution.distribution_partner']
  relationship_status varchar [note: 'Current state of the commercial relationship and content distribution agreement with the partner. | Column relationship_status (STRING) in distribution.distribution_partner']
  retransmission_consent_status varchar [note: 'Status of retransmission consent authorization allowing the distribution partner to rebroadcast content. Relevant for MVPD and cable operators under FCC regulations. | Column retransmission_consent_status (STRING) in distribution.distribution_partner']
  sla_latency_target_ms varchar [note: 'Maximum acceptable latency in milliseconds for content delivery as defined in the distribution Service Level Agreement. Critical for live streaming and low-latency applications. | Column sla_latency_target_ms (INT) in distribution.distribution_partner']
  sla_uptime_target_percent decimal(5,2) [note: 'Contractual uptime percentage target defined in the distribution Service Level Agreement. Represents the minimum availability commitment for content delivery. | Column sla_uptime_target_percent (DECIMAL(5,2)) in distribution.distribution_partner']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.distribution_partner']
  subscriber_reach_estimate varchar [note: 'Estimated number of subscribers, households, or unique users that can access content through this distribution partner. Used for reach analysis and revenue forecasting. | Column subscriber_reach_estimate (BIGINT) in distribution.distribution_partner']
  technical_delivery_standards varchar [note: 'Comma-separated list of technical broadcast and streaming standards supported by the partner. May include DVB (Digital Video Broadcasting), ATSC (Advanced Television Systems Committee), QAM (Quadrature Amplitude Modulation), HLS (HTTP Live Streaming), MPEG-DASH (Dynamic Adaptive Streaming over HTTP), and other delivery protocols. | Column technical_delivery_standards (STRING) in distribution.distribution_partner']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.distribution_partner']

  Note: 'Master record for all distribution partners including MVPDs (cable, satellite, telco), vMVPDs, OTT platform operators, FAST aggregators, and syndication outlets. Captures partner identity, tier classification, distribution footprint (geographic markets served), carriage capacity, technical delivery capabilities (DVB, ATSC, HLS, MPEG-DASH), and commercial relationship status. SSOT for distribution partner identity within the distribution domain — distinct from the enterprise partner domain which owns broader commercial relationships. | Unity Catalog table: media_broadcasting_ecm.distribution.distribution_partner'
}

Table distribution.carriage_agreement {
  carriage_agreement_id varchar [pk, note: 'Unique identifier for the carriage agreement record. Primary key. | Column carriage_agreement_id (BIGINT) in distribution.carriage_agreement']
  assigned_sales_rep_id varchar [note: 'Foreign key linking to sales.rep. Business justification: Carriage agreements are managed by assigned sales reps who negotiate terms and maintain partner relationships. Critical for rep commission calculation on carriage fees, account ownership tracking, and | Column assigned_sales_rep_id (BIGINT) in sales.carriage_agreement']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Retransmission consent agreements are legally tied to specific broadcast licenses. Must-carry elections, carriage fees, and retransmission consent status are license-specific regulatory obligations re | Column broadcast_license_id (BIGINT) in compliance.carriage_agreement']
  channel_id varchar [note: 'Reference to the channel or content package covered by this carriage agreement. | Column channel_id (BIGINT) in scheduling.carriage_agreement']
  contract_owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Carriage agreements are high-value contracts requiring business/legal owner for amendments, renewal negotiations, retransmission consent disputes, and must-carry elections. Essential for approval work | Column contract_owner_employee_id (BIGINT) in workforce.carriage_agreement']
  distribution_partner_id varchar [note: 'Reference to the MVPD, vMVPD, or OTT platform carrying the content under this agreement. | Column distribution_partner_id (BIGINT) in distribution.carriage_agreement']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Carriage agreements with MVPDs/distributors reference underlying content license agreements that authorize the carriage. Critical for rights chain validation, ensuring distribution partners have prope | Column license_agreement_id (BIGINT) in rights.carriage_agreement']
  market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: Retransmission consent and carriage agreements are negotiated per DMA with market-specific subscriber counts, fees, and blackout provisions mandated by FCC regulations. Essential for must-carry compli | Column market_coverage_id (BIGINT) in audience.carriage_agreement']
  master_invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Carriage agreements generate master invoices for services beyond specialized carriage fee invoices (setup fees, equipment, technical services). Real business process: comprehensive agreement billing,  | Column master_invoice_id (BIGINT) in billing.carriage_agreement']
  network_circuit_id varchar [note: 'Foreign key linking to technology.network_circuit. Business justification: Carriage agreements specify dedicated network circuits for content delivery. Required for technical compliance verification and circuit cost allocation. | Column network_circuit_id (BIGINT) in technology.carriage_agreement']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Carriage agreements often require regulatory filings (retransmission consent elections, program carriage complaints, must-carry notifications). Agreement execution and amendments trigger FCC filing wo | Column regulatory_filing_id (BIGINT) in compliance.carriage_agreement']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Carriage agreements generate specific revenue streams (retransmission consent fees, carriage fees) that must be recognized under ASC 606. Monthly carriage fee invoicing posts to specific revenue strea | Column revenue_stream_id (BIGINT) in finance.carriage_agreement']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Sports and news broadcasting frequently ties talent compensation (commentators, anchors) to distribution reach via carriage agreements. Talent contracts may include bonuses based on subscriber reach o | Column talent_profile_id (BIGINT) in talent.carriage_agreement']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.carriage_agreement']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.carriage_agreement']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.carriage_agreement']
  agreement_number varchar [note: 'Externally-known unique identifier or contract number for this carriage agreement, used in business communications and legal references. | Column agreement_number (STRING) in distribution.carriage_agreement']
  agreement_status varchar [note: 'Current lifecycle status of the carriage agreement: draft (being prepared), active (in force), suspended (temporarily paused), expired (term ended), terminated (cancelled before expiry), or under negotiation (renewal or amendment in progress). | Column agreement_status (STRING) in distribution.carriage_agreement']
  agreement_type varchar [note: 'Classification of the carriage agreement: retransmission consent (FCC-regulated authorization for MVPDs to rebroadcast OTA signals), must-carry (mandatory carriage under FCC rules), voluntary carriage (negotiated carriage without must-carry obligation), or platform carriage (OTT/vMVPD distribution agreement). | Column agreement_type (STRING) in distribution.carriage_agreement']
  auto_renewal_flag boolean [note: 'Indicates whether the agreement automatically renews at the end of the term unless either party provides termination notice. | Column auto_renewal_flag (BOOLEAN) in distribution.carriage_agreement']
  blackout_provisions varchar [note: 'Geographic or temporal restrictions on content availability, such as sports blackout rules, local market exclusions, or event-specific restrictions required by rights holders or league rules. | Column blackout_provisions (STRING) in distribution.carriage_agreement']
  carriage_fee_amount decimal(15,2) [note: 'Monetary compensation paid by the distribution partner to the content provider for the right to carry the channel or content package. May be per-subscriber, flat fee, or tiered based on subscriber count. | Column carriage_fee_amount (DECIMAL(15,2)) in distribution.carriage_agreement']
  carriage_fee_currency varchar [note: 'Three-letter ISO 4217 currency code for the carriage fee amount (e.g., USD, GBP, EUR). | Column carriage_fee_currency (STRING) in distribution.carriage_agreement']
  carriage_fee_structure varchar [note: 'Pricing model for the carriage fee: per-subscriber (fee per active subscriber), flat monthly (fixed monthly payment), tiered (rate varies by subscriber volume), revenue share (percentage of ad or subscription revenue), or barter (non-cash compensation such as promotional commitments or channel positioning). | Column carriage_fee_structure (STRING) in distribution.carriage_agreement']
  channel_number_assignment varchar [note: 'The channel number or dial position assigned to the channel on the distribution platform. May vary by market or headend. | Column channel_number_assignment (STRING) in distribution.carriage_agreement']
  channel_positioning_tier varchar [note: 'The service tier or package in which the channel is positioned (e.g., basic, expanded basic, premium, sports tier). Affects channel visibility and subscriber reach. | Column channel_positioning_tier (STRING) in distribution.carriage_agreement']
  compensation_terms varchar [note: 'Detailed description of all compensation provided under the agreement, including cash payments, barter arrangements (e.g., promotional commitments, ad inventory exchange), channel carriage reciprocity, or other non-monetary considerations. | Column compensation_terms (STRING) in distribution.carriage_agreement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.carriage_agreement']
  created_timestamp timestamp [note: 'Timestamp when this carriage agreement record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.carriage_agreement']
  dispute_resolution_mechanism varchar [note: 'Agreed method for resolving disputes arising under the agreement: arbitration (binding third-party decision), mediation (facilitated negotiation), litigation (court proceedings), or negotiation (direct party-to-party resolution). | Column dispute_resolution_mechanism (STRING) in distribution.carriage_agreement']
  drm_requirements varchar [note: 'DRM and content protection requirements mandated under the agreement, such as encryption standards, conditional access systems, watermarking, and anti-piracy measures. | Column drm_requirements (STRING) in distribution.carriage_agreement']
  effective_date date [note: 'Date when the carriage agreement becomes binding and the distribution partner is authorized to carry the channel or content package. | Column effective_date (DATE) in distribution.carriage_agreement']
  exclusivity_window varchar [note: 'Period during which the distribution partner has exclusive carriage rights within a defined geographic territory or platform category (e.g., exclusive MVPD rights in a DMA, exclusive vMVPD rights nationally). | Column exclusivity_window (STRING) in distribution.carriage_agreement']
  expiration_date date [note: 'Date when the carriage agreement term ends. Nullable for open-ended or evergreen agreements subject to termination notice. | Column expiration_date (DATE) in distribution.carriage_agreement']
  geographic_coverage varchar [note: 'Geographic scope of the carriage agreement, typically expressed as authorized DMAs (Designated Market Areas), states, regions, or national coverage. Defines where the distribution partner is authorized to carry the content. | Column geographic_coverage (STRING) in distribution.carriage_agreement']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction and governing law applicable to the agreement (e.g., State of New York, England and Wales). Determines which courts and laws apply in case of dispute. | Column governing_law_jurisdiction (STRING) in distribution.carriage_agreement']
  holdback_restrictions varchar [note: 'Restrictions on when or where content may be made available on other platforms or windows. Protects the distribution partners investment by limiting competing distribution during the agreement term. | Column holdback_restrictions (STRING) in distribution.carriage_agreement']
  last_amendment_date date [note: 'Date of the most recent amendment or modification to the carriage agreement. | Column last_amendment_date (DATE) in distribution.carriage_agreement']
  last_modified_timestamp timestamp [note: 'Timestamp when this carriage agreement record was last updated in the system. | Column last_modified_timestamp (TIMESTAMP) in distribution.carriage_agreement']
  minimum_subscriber_guarantee varchar [note: 'Minimum number of subscribers the distribution partner guarantees to deliver for the channel. Used in per-subscriber fee calculations and performance commitments. | Column minimum_subscriber_guarantee (INT) in distribution.carriage_agreement']
  must_carry_election boolean [note: 'Indicates whether the broadcaster has elected must-carry status under FCC rules, requiring the MVPD to carry the signal without negotiation. Applicable to qualified broadcast stations. | Column must_carry_election (BOOLEAN) in distribution.carriage_agreement']
  negotiation_history varchar [note: 'Summary of key negotiation milestones, amendments, and material changes to the agreement over its lifecycle. Provides context for current terms and future renegotiations. | Column negotiation_history (STRING) in distribution.carriage_agreement']
  promotional_commitment varchar [note: 'Marketing and promotional obligations agreed by either party, such as on-air promotion, co-marketing campaigns, EPG placement guarantees, or cross-platform promotion. | Column promotional_commitment (STRING) in distribution.carriage_agreement']
  renewal_terms varchar [note: 'Conditions and terms governing agreement renewal, including renewal period length, rate adjustments, renegotiation triggers, and notice requirements. | Column renewal_terms (STRING) in distribution.carriage_agreement']
  retransmission_consent_granted boolean [note: 'Indicates whether retransmission consent has been granted under FCC regulations, authorizing the MVPD to rebroadcast over-the-air signals. Applicable only to retransmission consent agreement types. | Column retransmission_consent_granted (BOOLEAN) in distribution.carriage_agreement']
  service_level_agreement varchar [note: 'Performance commitments and service quality standards, including uptime guarantees, signal quality metrics, fault resolution times, and penalties for non-compliance. | Column service_level_agreement (STRING) in distribution.carriage_agreement']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.carriage_agreement']
  technical_delivery_requirements varchar [note: 'Technical specifications for content delivery, including signal format (HD, 4K, HDR), encoding standards (MPEG-2, MPEG-4, HEVC), delivery method (satellite, fiber, IP), and quality parameters (bitrate, resolution, audio channels). | Column technical_delivery_requirements (STRING) in distribution.carriage_agreement']
  termination_notice_days varchar [note: 'Number of days advance notice required by either party to terminate the agreement. Protects both parties from abrupt service disruption. | Column termination_notice_days (INT) in distribution.carriage_agreement']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.carriage_agreement']

  Note: 'Contractual record governing the terms under which a channel or content package is carried by an MVPD, vMVPD, or OTT platform. Covers both retransmission consent agreements (FCC-regulated authorization for MVPDs to rebroadcast OTA signals) and standard carriage contracts. Captures agreement type (retransmission consent, must-carry, voluntary carriage), retransmission consent terms, must-carry election status, carriage fee rates, channel positioning tiers, geographic coverage (authorized DMAs), exclusivity windows, holdback restrictions, compensation terms (cash, channel carriage, promotional commitments), contract effective/expiry dates, and negotiation history. Links to distribution partner and channel master. Distinct from rights licensing contracts owned by the rights domain. | Unity Catalog table: media_broadcasting_ecm.distribution.carriage_agreement'
}

Table distribution.distribution_carriage_fee_invoice {
  distribution_carriage_fee_invoice_id varchar [pk, note: 'Unique identifier for the carriage fee invoice record. Primary key for this transactional billing entity. | Column distribution_carriage_fee_invoice_id (BIGINT) in distribution.distribution_carriage_fee_invoice']
  accounts_receivable_id varchar [note: 'Foreign key linking to finance.accounts_receivable. Business justification: Carriage fee invoices create A/R entries when billed to distribution partners. Monthly A/R aging reports include outstanding carriage fee invoices for cash flow management and collections tracking in  | Column accounts_receivable_id (BIGINT) in finance.distribution_carriage_fee_invoice']
  billing_carriage_fee_invoice_id varchar [note: 'FK to canonical billing carriage fee invoice | Column billing_carriage_fee_invoice_id (BIGINT) in billing.distribution_carriage_fee_invoice']
  carriage_agreement_id varchar [note: 'Reference to the master carriage agreement under which this invoice is issued. Links to the contractual relationship governing carriage fees. | Column carriage_agreement_id (BIGINT) in distribution.distribution_carriage_fee_invoice']
  distribution_partner_id varchar [note: 'Reference to the MVPD, vMVPD, cable operator, or OTT platform partner who is the counterparty to this invoice. The party being billed or paying the carriage fee. | Column distribution_partner_id (BIGINT) in distribution.distribution_carriage_fee_invoice']
  responsible_sales_rep_id varchar [note: 'Foreign key linking to sales.rep. Business justification: Carriage fee invoices are tracked by responsible sales rep for commission calculation and dispute resolution. Essential for rep compensation on recurring carriage revenue, account health monitoring, a | Column responsible_sales_rep_id (BIGINT) in sales.distribution_carriage_fee_invoice']
  revenue_recognition_event_id varchar [note: 'Foreign key linking to finance.revenue_recognition_event. Business justification: Carriage fee invoices trigger revenue recognition events under ASC 606/IFRS 15. Monthly revenue recognition close ties invoices to recognition events for financial statement preparation and revenue as | Column revenue_recognition_event_id (BIGINT) in finance.distribution_carriage_fee_invoice']
  subscriber_count_report_id varchar [note: 'Foreign key linking to distribution.subscriber_count_report. Business justification: Carriage fee invoices are based on subscriber count reports. Billing uses reported subscriber counts for fee calculation. Removes subscriber_count BIGINT (derivable from subscriber_count_report.report | Column subscriber_count_report_id (BIGINT) in distribution.distribution_carriage_fee_invoice']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.distribution_carriage_fee_invoice']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.distribution_carriage_fee_invoice']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.distribution_carriage_fee_invoice']
  adjustment_amount decimal(18,2) [note: 'Total adjustments applied to the base fee, including discounts, credits, penalties, or promotional adjustments. May be positive or negative. | Column adjustment_amount (DECIMAL(18,2)) in distribution.distribution_carriage_fee_invoice']
  base_fee_amount decimal(18,2) [note: 'The base carriage fee amount before any adjustments, discounts, or taxes. Represents the core contractual fee for the billing period. | Column base_fee_amount (DECIMAL(18,2)) in distribution.distribution_carriage_fee_invoice']
  billing_period_end_date date [note: 'The last date of the period for which carriage fees are being billed. Defines the end of the service or subscription window covered by this invoice. | Column billing_period_end_date (DATE) in distribution.distribution_carriage_fee_invoice']
  billing_period_start_date date [note: 'The first date of the period for which carriage fees are being billed. Defines the beginning of the service or subscription window covered by this invoice. | Column billing_period_start_date (DATE) in distribution.distribution_carriage_fee_invoice']
  cost_center_code varchar [note: 'The cost center or profit center to which this invoice is allocated for internal financial reporting and management accounting. | Column cost_center_code (STRING) in distribution.distribution_carriage_fee_invoice']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.distribution_carriage_fee_invoice']
  created_by_user varchar [note: 'The username or identifier of the user or system process that created this invoice record. Used for audit and accountability. | Column created_by_user (STRING) in distribution.distribution_carriage_fee_invoice']
  created_timestamp timestamp [note: 'The timestamp when this invoice record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in distribution.distribution_carriage_fee_invoice']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency in which the invoice is denominated (e.g., USD, EUR, GBP). | Column currency_code (STRING) in distribution.distribution_carriage_fee_invoice']
  dispute_date date [note: 'The date on which the dispute was formally raised by the distribution partner. Null if the invoice has never been disputed. | Column dispute_date (DATE) in distribution.distribution_carriage_fee_invoice']
  dispute_flag boolean [note: 'Boolean indicator of whether the invoice is currently under dispute by the distribution partner. True if disputed, false otherwise. | Column dispute_flag (BOOLEAN) in distribution.distribution_carriage_fee_invoice']
  dispute_reason varchar [note: 'Free-text description of the reason for the dispute, if the invoice is disputed. Captures the distribution partners objection or concern. | Column dispute_reason (STRING) in distribution.distribution_carriage_fee_invoice']
  due_date date [note: 'The date by which payment is contractually required. Used to determine overdue status and trigger late payment processes. | Column due_date (DATE) in distribution.distribution_carriage_fee_invoice']
  fee_basis varchar [note: 'The pricing model or calculation method used to determine the carriage fee amount. Defines whether the fee is per-subscriber, flat-rate, tiered by volume, revenue-share, or a hybrid structure. | Column fee_basis (STRING) in distribution.distribution_carriage_fee_invoice']
  general_ledger_account_code varchar [note: 'The GL account code to which this carriage fee invoice is posted in the financial system. Used for financial reporting and revenue recognition. | Column general_ledger_account_code (STRING) in distribution.distribution_carriage_fee_invoice']
  invoice_date date [note: 'The date on which the invoice was officially issued to the distribution partner. This is the principal business event timestamp for the invoice transaction. | Column invoice_date (DATE) in distribution.distribution_carriage_fee_invoice']
  invoice_number varchar [note: 'Externally-visible unique invoice number used for billing correspondence, payment reconciliation, and financial reporting. Typically follows a sequential or structured numbering scheme. | Column invoice_number (STRING) in distribution.distribution_carriage_fee_invoice']
  invoice_status varchar [note: 'Current lifecycle status of the carriage fee invoice. Tracks progression from draft through issuance, acknowledgment, payment, and potential dispute or cancellation. [ENUM-REF-CANDIDATE: draft|issued|sent|acknowledged|paid|partially_paid|overdue|disputed|cancelled|void — 10 candidates stripped; promote to reference product] | Column invoice_status (STRING) in distribution.distribution_carriage_fee_invoice']
  notes varchar [note: 'Free-text notes or comments related to the invoice. May include special instructions, explanations of adjustments, or internal remarks. | Column notes (STRING) in distribution.distribution_carriage_fee_invoice']
  payment_method varchar [note: 'The payment instrument or mechanism used or expected for settling this invoice (e.g., wire transfer, ACH, check). | Column payment_method (STRING) in distribution.distribution_carriage_fee_invoice']
  payment_received_date date [note: 'The date on which payment was received and applied to this invoice. Null if the invoice has not been paid. | Column payment_received_date (DATE) in distribution.distribution_carriage_fee_invoice']
  payment_reference_number varchar [note: 'External reference number or transaction identifier provided by the payer or payment processor. Used for payment reconciliation and traceability. | Column payment_reference_number (STRING) in distribution.distribution_carriage_fee_invoice']
  payment_status varchar [note: 'Current payment status of the invoice. Tracks whether the invoice has been paid in full, partially paid, remains unpaid, or is overdue or disputed. | Column payment_status (STRING) in distribution.distribution_carriage_fee_invoice']
  payment_terms varchar [note: 'Contractual payment terms for this invoice, such as Net 30, Net 60, or custom terms. Defines the expected payment timeline and conditions. | Column payment_terms (STRING) in distribution.distribution_carriage_fee_invoice']
  reconciliation_date date [note: 'The date on which the invoice was successfully reconciled against subscriber data, payments, and contractual obligations. Null if reconciliation is pending or failed. | Column reconciliation_date (DATE) in distribution.distribution_carriage_fee_invoice']
  reconciliation_status varchar [note: 'Status of the revenue assurance reconciliation process for this invoice. Indicates whether the invoice has been matched to subscriber reports, payments, and contractual terms. | Column reconciliation_status (STRING) in distribution.distribution_carriage_fee_invoice']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.distribution_carriage_fee_invoice']
  tax_amount decimal(18,2) [note: 'Total tax amount applied to the invoice, including sales tax, VAT, or other applicable taxes based on jurisdiction and tax rules. | Column tax_amount (DECIMAL(18,2)) in distribution.distribution_carriage_fee_invoice']
  total_amount decimal(18,2) [note: 'The final total amount due on the invoice, calculated as base fee plus adjustments plus taxes. This is the amount the distribution partner must pay. | Column total_amount (DECIMAL(18,2)) in distribution.distribution_carriage_fee_invoice']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.distribution_carriage_fee_invoice']
  updated_by_user varchar [note: 'The username or identifier of the user or system process that last modified this invoice record. Used for audit and accountability. | Column updated_by_user (STRING) in distribution.distribution_carriage_fee_invoice']
  updated_timestamp timestamp [note: 'The timestamp when this invoice record was last modified. Used for audit trail and change tracking. | Column updated_timestamp (TIMESTAMP) in distribution.distribution_carriage_fee_invoice']

  Note: 'Transactional billing record for carriage fees owed by or to distribution partners under active carriage agreements. Captures invoice period, fee amount, fee basis (per-subscriber, flat-rate, tiered), currency, payment due date, payment status, and reconciliation flags. Supports revenue assurance and financial reconciliation processes. Distinct from subscriber invoices (owned by billing domain) and advertising invoices (owned by advertising domain). | Unity Catalog table: media_broadcasting_ecm.distribution.distribution_carriage_fee_invoice'
}

Table distribution.delivery_channel {
  delivery_channel_id varchar [pk, note: 'Unique identifier for the delivery channel. Primary key. | Column delivery_channel_id (BIGINT) in distribution.delivery_channel']
  abr_profile_id varchar [note: 'Foreign key linking to distribution.abr_profile. Business justification: Delivery channels use specific ABR profiles. delivery_channel.abr_profile is STRING but should FK to abr_profile master. Removes abr_profile STRING. | Column abr_profile_id (BIGINT) in distribution.delivery_channel']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Linear channels have specific closed captioning, audio description, and accessibility compliance obligations under FCC CVAA rules. Each channel tracks its applicable obligations for compliance reporti | Column accessibility_obligation_id (BIGINT) in compliance.delivery_channel']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Linear channels originate from specific facilities with master control. Required for FCC license compliance (facility identification) and channel origination tracking. | Column broadcast_facility_id (BIGINT) in technology.delivery_channel']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Linear delivery channels operate under specific broadcast licenses. FCC compliance, public inspection files, EAS participation, and closed captioning obligations all require linking channels to their  | Column broadcast_license_id (BIGINT) in compliance.delivery_channel']
  cdn_configuration_id varchar [note: 'Foreign key linking to distribution.cdn_configuration. Business justification: Delivery channels use specific CDN configurations. delivery_channel.cdn_provider is STRING but should FK to cdn_configuration. Removes cdn_provider STRING. | Column cdn_configuration_id (BIGINT) in distribution.delivery_channel']
  drm_policy_id varchar [note: 'Foreign key linking to distribution.drm_policy. Business justification: Delivery channels enforce specific DRM policies. delivery_channel.drm_system is STRING but should FK to drm_policy. Removes drm_system STRING. | Column drm_policy_id (BIGINT) in distribution.delivery_channel']
  encoder_config_id varchar [note: 'Foreign key linking to technology.encoder_config. Business justification: Delivery channels use encoder configurations for video/audio encoding. Required for channel encoding configuration and quality assurance. | Column encoder_config_id (BIGINT) in technology.delivery_channel']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.delivery_channel']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.delivery_channel']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.delivery_channel']
  ad_insertion_method varchar [note: 'Technical method used for inserting advertisements into the content stream: server-side stitching, client-side insertion, DAI (Dynamic Ad Insertion), SCTE-35 marker-based, or none for ad-free channels. | Column ad_insertion_method (STRING) in distribution.delivery_channel']
  aspect_ratio varchar [note: 'Display aspect ratio of the channel content (4:3 legacy, 16:9 widescreen standard, 21:9 cinematic). | Column aspect_ratio (NUMERIC) in distribution.delivery_channel']
  audio_format varchar [note: 'Audio encoding and delivery format supported by the channel (stereo, Dolby Digital 5.1, Dolby Atmos, DTS, AAC). | Column audio_format (STRING) in distribution.delivery_channel']
  blackout_rules_enabled boolean [note: 'Indicates whether geographic or rights-based blackout restrictions are enforced for this channel (true) or not (false). | Column blackout_rules_enabled (BOOLEAN) in distribution.delivery_channel']
  carriage_fee_usd decimal(12,2) [note: 'Monthly or per-subscriber carriage fee paid by MVPDs or vMVPDs to carry this channel, expressed in USD. Confidential commercial data. | Column carriage_fee_usd (DECIMAL(12,2)) in distribution.delivery_channel']
  channel_name varchar [note: 'The official brand name of the delivery channel as presented to audiences (e.g., \'HBO Max\', \'NBC Sports\', \'Pluto TV Comedy\'). | Column channel_name (STRING) in distribution.delivery_channel']
  channel_number varchar [note: 'Logical channel number or position in the Electronic Program Guide (EPG) lineup (e.g., \'7.1\', \'502\', \'virtual 12\'). | Column channel_number (STRING) in distribution.delivery_channel']
  channel_type varchar [note: 'Classification of the delivery channel by distribution model: linear (traditional broadcast), OTT (over-the-top streaming), FAST (free ad-supported streaming TV), simulcast (simultaneous multi-platform), VOD (video on demand), or hybrid. | Column channel_type (STRING) in distribution.delivery_channel']
  content_refresh_cadence varchar [note: 'Frequency at which the channel programming lineup or content library is updated with new material. | Column content_refresh_cadence (STRING) in distribution.delivery_channel']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.delivery_channel']
  created_timestamp timestamp [note: 'Timestamp when this delivery channel record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.delivery_channel']
  delivery_technology varchar [note: 'The technical transmission standard used for content delivery. DVB (Digital Video Broadcasting) variants for European broadcast, ATSC (Advanced Television Systems Committee) for North American broadcast, QAM (Quadrature Amplitude Modulation) for cable, HLS (HTTP Live Streaming) and MPEG-DASH for adaptive bitrate streaming. [ENUM-REF-CANDIDATE: dvb-t|dvb-s|dvb-c|atsc|qam|hls|mpeg-dash|smooth-streaming|rtmp|webrtc — 10 candidates stripped; promote to reference product] | Column delivery_technology (STRING) in distribution.delivery_channel']
  epg_source_code varchar [note: 'External identifier linking this channel to its Electronic Program Guide (EPG) metadata feed provider (e.g., Gracenote, Tribune Media Services). | Column epg_source_code (STRING) in distribution.delivery_channel']
  fast_aggregator_platform varchar [note: 'Name of the FAST platform aggregator hosting the channel (e.g., \'Pluto TV\', \'Tubi\', \'Samsung TV Plus\', \'Roku Channel\', \'Xumo\'). Applicable only to FAST channel types. | Column fast_aggregator_platform (STRING) in distribution.delivery_channel']
  fast_playlist_type varchar [note: 'Content scheduling model for FAST channels: linear-loop (repeating content block), scheduled (traditional time-based EPG), dynamic (algorithm-driven), or hybrid. Applicable only to FAST channel types. | Column fast_playlist_type (STRING) in distribution.delivery_channel']
  genre_category varchar [note: 'Primary content genre or programming category of the channel. [ENUM-REF-CANDIDATE: news|sports|entertainment|kids|lifestyle|documentary|music|movies|drama|comedy — 10 candidates stripped; promote to reference product] | Column genre_category (STRING) in distribution.delivery_channel']
  is_active boolean [note: 'Indicates whether the channel is currently active and operational (true) or inactive/retired (false). | Column is_active (BOOLEAN) in distribution.delivery_channel']
  launch_date date [note: 'Date when the channel first went live and began broadcasting or streaming to audiences. | Column launch_date (DATE) in distribution.delivery_channel']
  max_bitrate_mbps decimal(6,2) [note: 'Maximum streaming bitrate supported by the channel in megabits per second, representing the highest quality tier in the ABR ladder. | Column max_bitrate_mbps (DECIMAL(6,2)) in distribution.delivery_channel']
  monetization_model varchar [note: 'Revenue model for the channel: AVOD (Advertising-Supported Video On Demand), SVOD (Subscription Video On Demand), TVOD (Transactional Video On Demand), hybrid (multiple models), or free (no monetization). | Column monetization_model (STRING) in distribution.delivery_channel']
  operational_status varchar [note: 'Current operational state of the delivery channel in the distribution infrastructure. | Column operational_status (STRING) in distribution.delivery_channel']
  parental_control_rating varchar [note: 'TV Parental Guidelines rating assigned to the channel for content filtering and parental control systems. | Column parental_control_rating (STRING) in distribution.delivery_channel']
  primary_language varchar [note: 'ISO 639-3 three-letter code for the primary broadcast language of the channel (e.g., \'eng\' for English, \'spa\' for Spanish, \'fra\' for French). | Column primary_language (STRING) in distribution.delivery_channel']
  qos_tier varchar [note: 'Service level tier defining performance guarantees, uptime SLA, and priority for this channel (premium, standard, basic). | Column qos_tier (STRING) in distribution.delivery_channel']
  resolution_format varchar [note: 'Video resolution tier supported by the channel: SD (standard definition 480p), HD (720p), Full HD (1080p), 4K UHD (2160p), 8K UHD (4320p). | Column resolution_format (STRING) in distribution.delivery_channel']
  retirement_date date [note: 'Date when the channel ceased operations or was decommissioned. Null for active channels. | Column retirement_date (DATE) in distribution.delivery_channel']
  retransmission_consent_required boolean [note: 'Indicates whether retransmission consent agreements are required for MVPDs to rebroadcast this channel (true) or if must-carry rules apply (false). | Column retransmission_consent_required (BOOLEAN) in distribution.delivery_channel']
  secondary_language varchar [note: 'ISO 639-3 three-letter code for the secondary audio track or subtitle language, if available (e.g., SAP - Secondary Audio Program). | Column secondary_language (STRING) in distribution.delivery_channel']
  sla_uptime_percent decimal(5,2) [note: 'Contractual uptime guarantee for the channel expressed as a percentage (e.g., 99.95 for \'four nines\' availability). | Column sla_uptime_percent (DECIMAL(5,2)) in distribution.delivery_channel']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.delivery_channel']
  streaming_endpoint_url varchar [note: 'Primary streaming endpoint URL or manifest URL for OTT and FAST channels. Confidential operational data. | Column streaming_endpoint_url (STRING) in distribution.delivery_channel']
  target_demographic varchar [note: 'Primary audience demographic segment targeted by the channel programming (e.g., \'Adults 18-49\', \'Kids 6-11\', \'Women 25-54\'). | Column target_demographic (STRING) in distribution.delivery_channel']
  target_market varchar [note: 'ISO 3166-1 alpha-3 country code representing the primary geographic market for the channel (e.g., \'USA\', \'GBR\', \'CAN\'). | Column target_market (STRING) in distribution.delivery_channel']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.delivery_channel']
  updated_timestamp timestamp [note: 'Timestamp when this delivery channel record was last modified. | Column updated_timestamp (TIMESTAMP) in distribution.delivery_channel']

  Note: 'Master definition of a logical distribution channel — a named, configured delivery pathway through which content is transmitted to audiences. Covers linear broadcast channels (DVB-T, DVB-S, ATSC, QAM), OTT streaming channels, FAST channels (Pluto TV, Tubi, Samsung TV Plus, Roku Channel), and simulcast feeds. Captures channel name, call sign, channel number, channel type (linear, OTT, FAST, simulcast), delivery technology standard, resolution/format, language, target market, EPG linkage, operational status, and FAST-specific attributes where applicable (aggregator platform, playlist type, ad insertion method, content refresh cadence, monetization model). SSOT for channel identity within the distribution domain. | Unity Catalog table: media_broadcasting_ecm.distribution.delivery_channel'
}

Table distribution.drm_policy {
  drm_policy_id varchar [pk, note: 'Primary key for drm_policy | Column drm_policy_id (BIGINT) in distribution.drm_policy']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.drm_policy']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.drm_policy']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.drm_policy']
  airplay_enabled boolean [note: 'Flag indicating whether Apple AirPlay streaming to external devices is permitted. | Column airplay_enabled (BOOLEAN) in distribution.drm_policy']
  allowed_countries varchar [note: 'Comma-separated list of ISO 3166-1 alpha-3 country codes where content playback is permitted. | Column allowed_countries (STRING) in distribution.drm_policy']
  analog_output_control varchar [note: 'Policy governing analog video output (allowed, restricted with downscaling, or completely blocked). | Column analog_output_control (STRING) in distribution.drm_policy']
  analog_sunset_enabled boolean [note: 'Flag indicating whether analog output is progressively restricted or disabled (analog sunset policy). | Column analog_sunset_enabled (BOOLEAN) in distribution.drm_policy']
  blocked_countries varchar [note: 'Comma-separated list of ISO 3166-1 alpha-3 country codes where content playback is explicitly blocked. | Column blocked_countries (STRING) in distribution.drm_policy']
  chromecast_enabled boolean [note: 'Flag indicating whether Google Chromecast streaming to external devices is permitted. | Column chromecast_enabled (BOOLEAN) in distribution.drm_policy']
  concurrent_stream_limit varchar [note: 'The maximum number of simultaneous streams allowed per user account or license. | Column concurrent_stream_limit (INT) in distribution.drm_policy']
  content_key_reference varchar [note: 'The unique identifier for the encryption key used to protect the content. | Column content_key_reference (STRING) in distribution.drm_policy']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.drm_policy']
  created_timestamp timestamp [note: 'The timestamp when this DRM policy record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.drm_policy']
  device_binding_enabled boolean [note: 'Flag indicating whether licenses are bound to specific devices to prevent unauthorized sharing. | Column device_binding_enabled (BOOLEAN) in distribution.drm_policy']
  drm_system varchar [note: 'The DRM technology platform used for content protection (Widevine, PlayReady, FairPlay, Primetime, Marlin, ClearKey). | Column drm_system (STRING) in distribution.drm_policy']
  drm_vendor varchar [note: 'The vendor or provider of the DRM solution (e.g., Google, Microsoft, Apple, Adobe). | Column drm_vendor (STRING) in distribution.drm_policy']
  effective_end_date date [note: 'The date when this DRM policy expires or is no longer enforceable. Null indicates indefinite validity. | Column effective_end_date (DATE) in distribution.drm_policy']
  effective_start_date date [note: 'The date when this DRM policy becomes active and enforceable for content protection. | Column effective_start_date (DATE) in distribution.drm_policy']
  encryption_scheme varchar [note: 'The encryption scheme used for content protection (CENC, CBC1, CENS, CBCS) as defined by Common Encryption standards. | Column encryption_scheme (STRING) in distribution.drm_policy']
  geo_restriction_enabled boolean [note: 'Flag indicating whether geographic restrictions are enforced for content delivery based on viewer location. | Column geo_restriction_enabled (BOOLEAN) in distribution.drm_policy']
  hdcp_level_required varchar [note: 'The minimum HDCP version required for output protection to prevent unauthorized digital copying. [ENUM-REF-CANDIDATE: none|hdcp_1_0|hdcp_1_1|hdcp_1_2|hdcp_1_3|hdcp_1_4|hdcp_2_0|hdcp_2_1|hdcp_2_2|hdcp_2_3 — 10 candidates stripped; promote to reference product] | Column hdcp_level_required (STRING) in distribution.drm_policy']
  key_rotation_interval_hours varchar [note: 'The frequency in hours at which encryption keys are rotated for enhanced security. | Column key_rotation_interval_hours (INT) in distribution.drm_policy']
  license_duration_seconds varchar [note: 'The validity period in seconds for a DRM license before it must be renewed. | Column license_duration_seconds (INT) in distribution.drm_policy']
  license_server_endpoint varchar [note: 'The URL endpoint of the DRM license server that issues decryption keys to authorized clients. | Column license_server_endpoint (STRING) in distribution.drm_policy']
  max_device_registrations varchar [note: 'The maximum number of devices that can be registered for content playback per user account. | Column max_device_registrations (INT) in distribution.drm_policy']
  offline_license_duration_hours varchar [note: 'The maximum duration in hours that offline downloaded content remains playable before license expiration. | Column offline_license_duration_hours (INT) in distribution.drm_policy']
  offline_playback_enabled boolean [note: 'Flag indicating whether content can be downloaded and played offline without an active internet connection. | Column offline_playback_enabled (BOOLEAN) in distribution.drm_policy']
  offline_playback_window_hours varchar [note: 'The time window in hours during which offline content must be played once playback begins. | Column offline_playback_window_hours (INT) in distribution.drm_policy']
  persistent_license_enabled boolean [note: 'Flag indicating whether licenses can be stored persistently on the device for offline or repeated playback. | Column persistent_license_enabled (BOOLEAN) in distribution.drm_policy']
  playback_duration_hours varchar [note: 'The time window in hours during which content must be consumed once playback begins for rental content. | Column playback_duration_hours (INT) in distribution.drm_policy']
  policy_code varchar [note: 'Unique business code or identifier for the DRM policy used across systems and platforms. | Column policy_code (STRING) in distribution.drm_policy']
  policy_name varchar [note: 'Human-readable name of the DRM policy for identification and reference purposes. | Column policy_name (STRING) in distribution.drm_policy']
  policy_priority varchar [note: 'The priority ranking of this policy when multiple policies could apply. Lower numbers indicate higher priority. | Column policy_priority (INT) in distribution.drm_policy']
  policy_status varchar [note: 'The current lifecycle status of the DRM policy (draft, active, suspended, deprecated, retired). | Column policy_status (STRING) in distribution.drm_policy']
  rental_duration_hours varchar [note: 'The total rental period in hours during which content is accessible for Transactional Video On Demand (TVOD) rentals. | Column rental_duration_hours (INT) in distribution.drm_policy']
  screen_capture_blocked boolean [note: 'Flag indicating whether screen capture and recording are blocked during content playback. | Column screen_capture_blocked (BOOLEAN) in distribution.drm_policy']
  security_level varchar [note: 'The security level required for DRM implementation (software or hardware-based cryptography and decoding). | Column security_level (STRING) in distribution.drm_policy']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.drm_policy']
  token_expiry_seconds varchar [note: 'The expiration time in seconds for authentication tokens used in DRM license acquisition. | Column token_expiry_seconds (INT) in distribution.drm_policy']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.drm_policy']
  updated_timestamp timestamp [note: 'The timestamp when this DRM policy record was last modified. | Column updated_timestamp (TIMESTAMP) in distribution.drm_policy']
  widevine_security_level varchar [note: 'The Widevine-specific security level (L1 hardware-backed, L2 software-backed, L3 software only). | Column widevine_security_level (STRING) in distribution.drm_policy']
  created_by varchar [note: 'The user or system identifier that created this DRM policy record. | Column created_by (STRING) in distribution.drm_policy']

  Note: 'Reference master defining Digital Rights Management packaging and enforcement policies applied to content streams. Captures DRM system (Widevine, PlayReady, FairPlay), license server endpoint, key rotation interval, output control rules (HDCP level, analog sunset), geo-restriction enforcement flag, offline download permissions, concurrent stream limits, and token expiry settings. Governs how content is protected during OTT and MVPD delivery. | Unity Catalog table: media_broadcasting_ecm.distribution.drm_policy'
}

Table distribution.cdn_configuration {
  cdn_configuration_id varchar [pk, note: 'Unique identifier for the CDN configuration record. Primary key for the cdn_configuration product. | Column cdn_configuration_id (BIGINT) in distribution.cdn_configuration']
  channel_id varchar [note: 'Reference to the delivery channel or OTT service to which this CDN configuration is assigned. | Column channel_id (BIGINT) in scheduling.cdn_configuration']
  technology_broadcast_facility_id varchar [note: 'FK added per VREQ']
  workforce_employee_id varchar [note: 'FK added per VREQ']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.cdn_configuration']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.cdn_configuration']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.cdn_configuration']
  activated_timestamp timestamp [note: 'The timestamp when this CDN configuration was activated and began serving live traffic. | Column activated_timestamp (TIMESTAMP) in distribution.cdn_configuration']
  bandwidth_limit_gbps decimal(10,2) [note: 'The maximum bandwidth capacity provisioned for this CDN configuration in gigabits per second. Exceeding this limit may trigger throttling or overage charges. | Column bandwidth_limit_gbps (DECIMAL(10,2)) in distribution.cdn_configuration']
  cache_control_header varchar [note: 'HTTP Cache-Control header directives applied to CDN responses, controlling caching behavior at edge and client levels. | Column cache_control_header (STRING) in distribution.cdn_configuration']
  cache_ttl_seconds varchar [note: 'Duration in seconds that content is cached at the CDN edge before revalidation with the origin. Controls freshness and origin load. | Column cache_ttl_seconds (INT) in distribution.cdn_configuration']
  cdn_provider varchar [note: 'The CDN vendor providing content delivery services for this configuration. Akamai is the primary provider per operational systems of record. | Column cdn_provider (STRING) in distribution.cdn_configuration']
  compression_enabled boolean [note: 'Indicates whether content compression (gzip, brotli) is enabled at the CDN edge to reduce bandwidth consumption and improve delivery performance. | Column compression_enabled (BOOLEAN) in distribution.cdn_configuration']
  configuration_name varchar [note: 'Human-readable name for this CDN configuration, used for operational identification and management. | Column configuration_name (STRING) in distribution.cdn_configuration']
  cost_per_gb decimal(10,4) [note: 'The contracted cost per gigabyte of data transferred through this CDN configuration. Used for cost allocation and financial reconciliation. | Column cost_per_gb (DECIMAL(10,4)) in distribution.cdn_configuration']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.cdn_configuration']
  created_timestamp timestamp [note: 'The timestamp when this CDN configuration record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.cdn_configuration']
  deactivated_timestamp timestamp [note: 'The timestamp when this CDN configuration was deactivated and stopped serving traffic. Null for active configurations. | Column deactivated_timestamp (TIMESTAMP) in distribution.cdn_configuration']
  failover_origin_url varchar [note: 'Secondary origin server URL used for redundancy and failover when the primary origin is unavailable. | Column failover_origin_url (STRING) in distribution.cdn_configuration']
  geo_blocking_countries varchar [note: 'Comma-separated list of ISO 3166-1 alpha-3 country codes subject to geo-blocking rules (allowed or denied based on mode). | Column geo_blocking_countries (STRING) in distribution.cdn_configuration']
  geo_blocking_enabled boolean [note: 'Indicates whether geographic content restrictions are enforced at the CDN edge based on viewer location. | Column geo_blocking_enabled (BOOLEAN) in distribution.cdn_configuration']
  geo_blocking_mode varchar [note: 'Specifies whether the geo-blocking rules operate as an allow-list (whitelist) or deny-list (blacklist) of countries. | Column geo_blocking_mode (STRING) in distribution.cdn_configuration']
  health_check_interval_seconds varchar [note: 'Frequency in seconds at which health checks are performed against this CDN configuration to detect outages or degradation. | Column health_check_interval_seconds (INT) in distribution.cdn_configuration']
  health_check_url varchar [note: 'The URL endpoint used by monitoring systems to verify CDN configuration availability and responsiveness. | Column health_check_url (STRING) in distribution.cdn_configuration']
  http2_enabled boolean [note: 'Indicates whether HTTP/2 protocol is enabled for this CDN configuration to improve streaming performance through multiplexing and header compression. | Column http2_enabled (BOOLEAN) in distribution.cdn_configuration']
  ipv6_enabled boolean [note: 'Indicates whether IPv6 addressing is enabled for this CDN configuration to support next-generation internet protocol delivery. | Column ipv6_enabled (BOOLEAN) in distribution.cdn_configuration']
  last_health_check_timestamp timestamp [note: 'The timestamp of the most recent successful health check performed against this CDN configuration. | Column last_health_check_timestamp (TIMESTAMP) in distribution.cdn_configuration']
  modified_timestamp timestamp [note: 'The timestamp when this CDN configuration record was last modified or updated. | Column modified_timestamp (TIMESTAMP) in distribution.cdn_configuration']
  operational_status varchar [note: 'Current operational state of this CDN configuration. Active configurations are serving live traffic; inactive configurations are not in use. | Column operational_status (STRING) in distribution.cdn_configuration']
  origin_pull_url varchar [note: 'The origin server URL from which the CDN pulls content when not cached. Typically points to the media asset management system or playout server. | Column origin_pull_url (STRING) in distribution.cdn_configuration']
  prefetch_enabled boolean [note: 'Indicates whether content prefetching is enabled to proactively cache content at edge locations before viewer requests. | Column prefetch_enabled (BOOLEAN) in distribution.cdn_configuration']
  property_hostname varchar [note: 'The fully qualified domain name (FQDN) of the CDN property or edge hostname used for content delivery. | Column property_hostname (STRING) in distribution.cdn_configuration']
  provisioned_date date [note: 'The date when this CDN configuration was initially provisioned and deployed to the CDN provider infrastructure. | Column provisioned_date (DATE) in distribution.cdn_configuration']
  query_string_caching_mode varchar [note: 'Defines how URL query string parameters are handled in cache key generation. Controls cache efficiency and personalization support. | Column query_string_caching_mode (STRING) in distribution.cdn_configuration']
  sla_tier varchar [note: 'The contracted service level tier for this CDN configuration, determining uptime guarantees, support response times, and performance commitments. | Column sla_tier (STRING) in distribution.cdn_configuration']
  sla_uptime_target_percent decimal(5,2) [note: 'The contracted uptime percentage guarantee for this CDN configuration (e.g., 99.99%). Used for SLA compliance monitoring and reporting. | Column sla_uptime_target_percent (DECIMAL(5,2)) in distribution.cdn_configuration']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.cdn_configuration']
  ssl_certificate_expiry_date date [note: 'The expiration date of the SSL/TLS certificate. Operations teams must renew certificates before this date to prevent service disruption. | Column ssl_certificate_expiry_date (DATE) in distribution.cdn_configuration']
  ssl_certificate_reference varchar [note: 'Reference identifier or serial number of the SSL/TLS certificate deployed on the CDN property for secure HTTPS delivery. | Column ssl_certificate_reference (STRING) in distribution.cdn_configuration']
  token_authentication_enabled boolean [note: 'Indicates whether token-based authentication is enabled for this CDN configuration to prevent unauthorized access to content. | Column token_authentication_enabled (BOOLEAN) in distribution.cdn_configuration']
  token_authentication_scheme varchar [note: 'The method by which authentication tokens are passed to the CDN edge for validation (query parameter, cookie, or HTTP header). | Column token_authentication_scheme (STRING) in distribution.cdn_configuration']
  token_secret_key varchar [note: 'The cryptographic secret key used to generate and validate authentication tokens. Must be kept confidential and rotated regularly. | Column token_secret_key (STRING) in distribution.cdn_configuration']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.cdn_configuration']

  Note: 'Master configuration record for CDN (Akamai) delivery properties assigned to a delivery channel or OTT service. Captures CDN provider, property hostname, origin pull URL, caching rules (TTL, cache-control headers), token authentication settings, geo-blocking rules, failover origin configuration, SSL certificate reference, and SLA tier. Enables operations teams to manage Akamai CDN settings per channel and delivery endpoint. | Unity Catalog table: media_broadcasting_ecm.distribution.cdn_configuration'
}

Table distribution.delivery_sla {
  delivery_sla_id varchar [pk, note: 'Unique identifier for the delivery SLA record. Primary key. | Column delivery_sla_id (BIGINT) in distribution.delivery_sla']
  sla_owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Delivery SLAs require ownership for target setting, measurement validation, penalty negotiation, and partner contract alignment. Essential for accountability in service quality, escalation paths, perf | Column sla_owner_employee_id (BIGINT) in workforce.delivery_sla']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.delivery_sla']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.delivery_sla']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.delivery_sla']
  applicable_platform varchar [note: 'Specific platform, device type, or streaming protocol this SLA applies to (e.g., HLS, MPEG-DASH, mobile, smart TV). | Column applicable_platform (STRING) in distribution.delivery_sla']
  approval_status varchar [note: 'Current approval status of the SLA document or agreement. | Column approval_status (STRING) in distribution.delivery_sla']
  approved_by varchar [note: 'Name or identifier of the person or role who approved this SLA. | Column approved_by (STRING) in distribution.delivery_sla']
  approved_date date [note: 'Date when this SLA was formally approved. | Column approved_date (DATE) in distribution.delivery_sla']
  cdn_availability_target_percent decimal(5,2) [note: 'Target availability percentage for CDN infrastructure supporting content delivery. | Column cdn_availability_target_percent (DECIMAL(5,2)) in distribution.delivery_sla']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.delivery_sla']
  created_timestamp timestamp [note: 'Timestamp when this SLA record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.delivery_sla']
  data_source varchar [note: 'System or platform from which SLA performance metrics are collected (e.g., CDN analytics, QoS monitoring system). | Column data_source (STRING) in distribution.delivery_sla']
  delivery_sla_description varchar [note: 'Detailed description of the SLA scope, objectives, and key commitments. | Column delivery_sla_description (STRING) in distribution.delivery_sla']
  delivery_sla_status varchar [note: 'Current lifecycle status of the SLA record (e.g., active, inactive, suspended, expired, draft, pending approval). | Column delivery_sla_status (STRING) in distribution.delivery_sla']
  distribution_channel varchar [note: 'The distribution channel or platform type this SLA applies to (e.g., linear broadcast, OTT streaming, MVPD carriage, vMVPD, FAST channel, CDN). | Column distribution_channel (STRING) in distribution.delivery_sla']
  effective_end_date date [note: 'Date when this SLA expires or is no longer enforceable. Null indicates an open-ended agreement. | Column effective_end_date (DATE) in distribution.delivery_sla']
  effective_start_date date [note: 'Date when this SLA becomes active and enforceable. | Column effective_start_date (DATE) in distribution.delivery_sla']
  error_rate_threshold_percent decimal(5,2) [note: 'Maximum allowable error rate percentage for delivery failures, buffering events, or playback errors. | Column error_rate_threshold_percent (DECIMAL(5,2)) in distribution.delivery_sla']
  escalation_contact_email varchar [note: 'Email address of the escalation contact for SLA breach notifications and coordination. | Column escalation_contact_email (STRING) in distribution.delivery_sla']
  escalation_contact_name varchar [note: 'Name of the primary contact person for SLA breach escalation and resolution. | Column escalation_contact_name (STRING) in distribution.delivery_sla']
  escalation_contact_phone varchar [note: 'Phone number of the escalation contact for urgent SLA breach communications. | Column escalation_contact_phone (STRING) in distribution.delivery_sla']
  exclusion_criteria varchar [note: 'Conditions or events excluded from SLA measurement (e.g., planned maintenance, force majeure, third-party failures). | Column exclusion_criteria (STRING) in distribution.delivery_sla']
  geographic_scope varchar [note: 'Geographic regions or markets where this SLA applies (e.g., North America, EMEA, APAC, or specific country codes). | Column geographic_scope (STRING) in distribution.delivery_sla']
  max_latency_ms varchar [note: 'Maximum allowable latency in milliseconds for content delivery from origin to edge or end-user device. | Column max_latency_ms (INT) in distribution.delivery_sla']
  measurement_frequency varchar [note: 'Frequency at which SLA performance metrics are collected and reported. | Column measurement_frequency (STRING) in distribution.delivery_sla']
  measurement_window varchar [note: 'Time window over which SLA metrics are measured and evaluated (e.g., monthly, quarterly). | Column measurement_window (STRING) in distribution.delivery_sla']
  modified_timestamp timestamp [note: 'Timestamp when this SLA record was last modified or updated. | Column modified_timestamp (TIMESTAMP) in distribution.delivery_sla']
  notes varchar [note: 'Additional notes, comments, or special instructions related to this SLA. | Column notes (STRING) in distribution.delivery_sla']
  owner_department varchar [note: 'Business department or team responsible for managing and enforcing this SLA (e.g., Distribution Operations, Partner Management). | Column owner_department (STRING) in distribution.delivery_sla']
  partner_name varchar [note: 'Name of the distribution partner, MVPD, vMVPD, or OTT platform to which this SLA applies. | Column partner_name (STRING) in distribution.delivery_sla']
  penalty_amount decimal(15,2) [note: 'Monetary penalty amount applied per SLA breach incident or measurement period. | Column penalty_amount (DECIMAL(15,2)) in distribution.delivery_sla']
  penalty_clause varchar [note: 'Description of financial or service penalties applied when SLA commitments are breached. | Column penalty_clause (STRING) in distribution.delivery_sla']
  penalty_currency varchar [note: 'Three-letter ISO 4217 currency code for penalty amounts (e.g., USD, EUR, GBP). | Column penalty_currency (STRING) in distribution.delivery_sla']
  reporting_frequency varchar [note: 'Frequency at which SLA performance reports are delivered to stakeholders and partners. | Column reporting_frequency (STRING) in distribution.delivery_sla']
  service_tier varchar [note: 'Service tier classification indicating the level of delivery service provided under this SLA. | Column service_tier (STRING) in distribution.delivery_sla']
  sla_code varchar [note: 'Short alphanumeric code uniquely identifying the SLA tier for operational reference and system integration. | Column sla_code (STRING) in distribution.delivery_sla']
  sla_name varchar [note: 'Business-friendly name of the SLA tier or agreement (e.g., Premium Delivery SLA, Standard OTT SLA). | Column sla_name (STRING) in distribution.delivery_sla']
  sla_tier varchar [note: 'Classification tier of the SLA indicating the level of service commitment (e.g., platinum for highest priority, bronze for basic service). | Column sla_tier (STRING) in distribution.delivery_sla']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.delivery_sla']
  stream_start_time_target_ms varchar [note: 'Target time in milliseconds for stream initialization and first frame delivery to the viewer. | Column stream_start_time_target_ms (INT) in distribution.delivery_sla']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.delivery_sla']
  uptime_commitment_percent decimal(5,2) [note: 'Guaranteed uptime percentage for content delivery availability (e.g., 99.95% uptime commitment). | Column uptime_commitment_percent (DECIMAL(5,2)) in distribution.delivery_sla']
  version_number varchar [note: 'Version number of the SLA document for change tracking and audit purposes. | Column version_number (STRING) in distribution.delivery_sla']

  Note: 'Master record defining Service Level Agreements governing content delivery performance commitments per distribution channel or partner. Captures SLA tier name, uptime commitment (%), maximum allowable latency (ms), stream start time target, error rate threshold, CDN availability target, measurement window, penalty clauses, and escalation contacts. Used to monitor and enforce delivery quality obligations with MVPDs, vMVPDs, and OTT platform partners. | Unity Catalog table: media_broadcasting_ecm.distribution.delivery_sla'
}

Table distribution.signal_route {
  signal_route_id varchar [pk, note: 'Unique identifier for the signal routing path. Primary key for the signal route entity. | Column signal_route_id (BIGINT) in distribution.signal_route']
  abr_profile_id varchar [note: 'Identifier of the Adaptive Bitrate (ABR) profile applied to this signal route, defining rendition ladder, bitrates, and encoding parameters for streaming delivery. | Column abr_profile_id (BIGINT) in distribution.signal_route']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Signal routes originate/terminate at broadcast facilities. Complements existing satellite_transponder_id FK for complete path topology and signal troubleshooting. | Column broadcast_facility_id (BIGINT) in technology.signal_route']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Signal routing from broadcast facilities to distribution points must track originating broadcast license for compliance with transmission power, coverage area, frequency allocation, and technical stan | Column broadcast_license_id (BIGINT) in compliance.signal_route']
  cdn_configuration_id varchar [note: 'Unique identifier for the CDN configuration profile applied to this signal route, defining caching, security, and delivery policies. | Column cdn_configuration_id (BIGINT) in distribution.signal_route']
  network_circuit_id varchar [note: 'Foreign key linking to technology.network_circuit. Business justification: Signal routes traverse specific network circuits. Required for signal path redundancy design and circuit failover testing. | Column network_circuit_id (BIGINT) in technology.signal_route']
  playout_channel_id varchar [note: 'Identifier of the specific playout channel within the playout system that originates the signal for this route. | Column playout_channel_id (BIGINT) in scheduling.signal_route']
  satellite_transponder_id varchar [note: 'Identifier of the satellite transponder used for uplink or downlink transmission in satellite-based signal routes. | Column satellite_transponder_id (BIGINT) in technology.signal_route']
  sla_definition_id varchar [note: 'Identifier of the Service Level Agreement (SLA) definition governing uptime, performance, and quality commitments for this signal route. | Column sla_definition_id (BIGINT) in distribution.signal_route']
  streaming_endpoint_id varchar [note: 'Foreign key linking to distribution.streaming_endpoint. Business justification: Signal routes originate from streaming endpoints. signal_route.origin_endpoint_url is STRING but should FK to streaming_endpoint. Removes origin_endpoint_url STRING. | Column streaming_endpoint_id (BIGINT) in distribution.signal_route']
  technical_owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Signal routes are broadcast infrastructure requiring technical ownership for failover testing, maintenance windows, satellite coordination, and IRD management. Essential for FCC compliance ownership,  | Column technical_owner_employee_id (BIGINT) in workforce.signal_route']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.signal_route']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.signal_route']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.signal_route']
  activated_timestamp timestamp [note: 'Timestamp when the signal route was activated and made operational for live signal transmission. | Column activated_timestamp (TIMESTAMP) in distribution.signal_route']
  backup_path_description varchar [note: 'Detailed description of the backup or redundant signal routing path used for failover in case of primary path failure. | Column backup_path_description (STRING) in distribution.signal_route']
  bandwidth_mbps decimal(10,2) [note: 'Allocated bandwidth capacity for this signal route in megabits per second (Mbps), defining the maximum throughput for signal transmission. | Column bandwidth_mbps (DECIMAL(10,2)) in distribution.signal_route']
  cdn_provider varchar [note: 'Name of the Content Delivery Network provider handling signal distribution for OTT and streaming routes (e.g., Akamai, Cloudflare, AWS CloudFront). | Column cdn_provider (STRING) in distribution.signal_route']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.signal_route']
  created_timestamp timestamp [note: 'Timestamp when the signal route record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.signal_route']
  deactivated_timestamp timestamp [note: 'Timestamp when the signal route was deactivated or taken out of service, if applicable. | Column deactivated_timestamp (TIMESTAMP) in distribution.signal_route']
  destination_endpoint_url varchar [note: 'Uniform Resource Locator (URL) of the destination endpoint where the signal is delivered (CDN origin, distribution partner, or broadcast facility). | Column destination_endpoint_url (STRING) in distribution.signal_route']
  downlink_frequency_mhz decimal(10,3) [note: 'Downlink reception frequency in megahertz (MHz) for satellite signal routes. | Column downlink_frequency_mhz (DECIMAL(10,3)) in distribution.signal_route']
  drm_license_server_url varchar [note: 'Uniform Resource Locator (URL) of the DRM license server that issues decryption keys for protected content delivered via this route. | Column drm_license_server_url (STRING) in distribution.signal_route']
  drm_system varchar [note: 'Digital Rights Management (DRM) system applied to the signal route for content protection (e.g., Widevine, PlayReady, FairPlay). | Column drm_system (STRING) in distribution.signal_route']
  encryption_algorithm varchar [note: 'Cryptographic algorithm used for signal encryption (e.g., AES-128, AES-256). | Column encryption_algorithm (STRING) in distribution.signal_route']
  encryption_enabled boolean [note: 'Boolean flag indicating whether signal encryption is enabled for this route to protect content during transmission. | Column encryption_enabled (BOOLEAN) in distribution.signal_route']
  failover_mode varchar [note: 'Method by which the signal route switches from primary to backup path during a failure event (automatic, manual, or hybrid). | Column failover_mode (STRING) in distribution.signal_route']
  failover_priority varchar [note: 'Numeric priority ranking determining the order in which this route is selected during failover scenarios (lower number indicates higher priority). | Column failover_priority (INT) in distribution.signal_route']
  failover_threshold_seconds varchar [note: 'Maximum allowable signal interruption duration in seconds before automatic failover to backup path is triggered. | Column failover_threshold_seconds (INT) in distribution.signal_route']
  geographic_region varchar [note: 'Geographic region or market served by this signal route (e.g., North America, EMEA, APAC, specific country or metro area). | Column geographic_region (STRING) in distribution.signal_route']
  ird_model varchar [note: 'Model name and identifier of the Integrated Receiver Decoder (IRD) equipment used to receive and decode the satellite or terrestrial signal. | Column ird_model (STRING) in distribution.signal_route']
  ird_serial_number varchar [note: 'Serial number of the IRD equipment deployed for this signal route, used for asset tracking and maintenance. | Column ird_serial_number (STRING) in distribution.signal_route']
  latency_target_ms varchar [note: 'Target end-to-end latency in milliseconds for signal delivery from origin to destination, critical for live broadcast and low-latency streaming. | Column latency_target_ms (INT) in distribution.signal_route']
  modified_timestamp timestamp [note: 'Timestamp when the signal route record was last modified or updated. | Column modified_timestamp (TIMESTAMP) in distribution.signal_route']
  operational_status varchar [note: 'Current operational state of the signal route indicating availability and readiness for broadcast or streaming delivery. | Column operational_status (STRING) in distribution.signal_route']
  playout_system_code varchar [note: 'Identifier of the playout automation system serving as the origin source for this signal route (e.g., Ericsson MediaFirst instance). | Column playout_system_code (BIGINT) in distribution.signal_route']
  polarization varchar [note: 'Polarization mode of the satellite signal transmission (horizontal, vertical, left circular, right circular). | Column polarization (STRING) in distribution.signal_route']
  primary_path_description varchar [note: 'Detailed description of the primary signal routing path, including intermediate hops, network segments, and infrastructure components. | Column primary_path_description (STRING) in distribution.signal_route']
  provisioned_date date [note: 'Date when the signal route was initially provisioned and configured in the broadcast or streaming infrastructure. | Column provisioned_date (DATE) in distribution.signal_route']
  qos_tier varchar [note: 'Quality of Service tier assigned to this signal route, determining priority, bandwidth allocation, and service level guarantees. | Column qos_tier (STRING) in distribution.signal_route']
  route_code varchar [note: 'Standardized alphanumeric code uniquely identifying the signal route in operational systems and documentation. | Column route_code (STRING) in distribution.signal_route']
  route_name varchar [note: 'Human-readable name identifying the signal routing path, typically describing the source-to-destination flow (e.g., \'Studio-A-to-East-Coast-Uplink\'). | Column route_name (STRING) in distribution.signal_route']
  route_type varchar [note: 'Classification of the signal routing path based on delivery technology and infrastructure (linear broadcast, OTT streaming, hybrid, satellite uplink, terrestrial transmission, IP interconnect). | Column route_type (STRING) in distribution.signal_route']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.signal_route']
  streaming_protocol varchar [note: 'Application-layer streaming protocol used for adaptive bitrate delivery in OTT scenarios (e.g., HLS, DASH, Smooth Streaming). | Column streaming_protocol (STRING) in distribution.signal_route']
  transport_protocol varchar [note: 'Technical protocol used for signal transport and delivery across the routing path. Includes HTTP Live Streaming (HLS), MPEG Dynamic Adaptive Streaming over HTTP (MPEG-DASH), User Datagram Protocol/Transport Stream (UDP/TS), Digital Video Broadcasting Satellite Second Generation (DVB-S2), and others. [ENUM-REF-CANDIDATE: HLS|MPEG-DASH|UDP/TS|DVB-S2|DVB-T2|ATSC|RTP|RTMP|SRT — 9 candidates stripped; promote to reference product] | Column transport_protocol (STRING) in distribution.signal_route']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.signal_route']
  uplink_frequency_mhz decimal(10,3) [note: 'Uplink transmission frequency in megahertz (MHz) for satellite signal routes. | Column uplink_frequency_mhz (DECIMAL(10,3)) in distribution.signal_route']

  Note: 'Master record defining the end-to-end signal routing path for a broadcast or streaming feed — from playout origin through satellite uplink, terrestrial transmission, CDN origin, or IP interconnect to the distribution endpoint. Captures source playout system (Ericsson MediaFirst), transport protocol (HLS, MPEG-DASH, UDP/TS, DVB-S2), uplink/downlink transponder details, IRD configuration, primary and backup path definitions, and failover priority. Critical for linear broadcast operations. | Unity Catalog table: media_broadcasting_ecm.distribution.signal_route'
}

Table distribution.release_window {
  release_window_id varchar [pk, note: 'Primary key for release_window | Column release_window_id (BIGINT) in distribution.release_window']
  content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Distribution windows have rating-specific restrictions (R-rated content excluded from daytime windows, TV-Y required for children\'s blocks). Content rating determines window eligibility and ad inserti | Column content_rating_id (BIGINT) in compliance.release_window']
  contract_id varchar [note: 'Foreign key linking to talent.talent_contract. Business justification: Distribution windows (theatrical, streaming, syndication) are often governed by talent contract terms including exclusivity clauses, holdback periods, and platform restrictions. Rights clearance workf | Column contract_id (BIGINT) in talent.release_window']
  coppa_declaration_id varchar [note: 'Foreign key linking to compliance.coppa_declaration. Business justification: Distribution windows for children\'s content require COPPA declarations. Window-specific data collection practices (viewing analytics, personalization) must be declared and parental consent obtained. | Column coppa_declaration_id (BIGINT) in compliance.release_window']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Windowing strategies target specific demographics to maximize revenue across release windows. Theatrical windows target A18-49, SVOD windows target families, and AVOD windows target broader demos for  | Column demographic_segment_id (BIGINT) in audience.release_window']
  distribution_partner_id varchar [note: 'Foreign key linking to distribution.distribution_partner. Business justification: Release windows are negotiated with distribution partners. release_window.platform_name is STRING but should FK to distribution_partner. Removes platform_name STRING. | Column distribution_partner_id (BIGINT) in distribution.release_window']
  drm_policy_id varchar [note: 'Foreign key linking to distribution.drm_policy. Business justification: Release windows have DRM requirements. release_window.drm_requirement is STRING but should FK to drm_policy. Removes drm_requirement STRING. | Column drm_policy_id (BIGINT) in distribution.release_window']
  license_agreement_id varchar [note: 'Reference to the underlying rights and licensing agreement that governs this distribution window. | Column license_agreement_id (BIGINT) in rights.release_window']
  licensing_invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Release windows (theatrical, home video, SVOD, AVOD) have associated platform licensing fees that generate invoices. Real business process: windowing revenue recognition, platform licensing billing, m | Column licensing_invoice_id (BIGINT) in billing.release_window']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Distribution windows define platform/territory/pricing rules per-asset. Windowing strategy (SVOD→TVOD→AVOD progression) requires asset-level binding. Media-broadcasting operators manage release calend | Column media_asset_id (BIGINT) in mediaasset.release_window']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Distribution windows (theatrical, SVOD, AVOD, TVOD) represent distinct revenue streams with different recognition methods and GL accounts. Content licensing revenue is recognized differently by window | Column revenue_stream_id (BIGINT) in finance.release_window']
  segment_id varchar [note: 'Foreign key linking to audience.audience_segment. Business justification: Advanced windowing uses behavioral segments for platform-specific releases and personalized availability windows. Supports binge-release strategies, sports fan exclusives, and genre-based holdback opt | Column segment_id (BIGINT) in audience.release_window']
  source_opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Distribution windows are negotiated as part of content licensing opportunities. Links windowing strategy (theatrical, SVOD, AVOD, linear) to original sales deal structure. Critical for rights manageme | Column source_opportunity_id (BIGINT) in sales.release_window']
  title_id varchar [note: 'Reference to the content title (film, series, episode, or program) subject to this distribution window. | Column title_id (BIGINT) in content.release_window']
  windowing_manager_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Release windows are strategic revenue decisions requiring business owner for holdback negotiations, pricing decisions, exclusivity terms, and PVOD/TVOD strategy. Essential for P&L accountability, righ | Column windowing_manager_employee_id (BIGINT) in workforce.release_window']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.release_window']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.release_window']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.release_window']
  ad_insertion_enabled boolean [note: 'Indicates whether Dynamic Ad Insertion (DAI) is enabled for this distribution window, allowing targeted advertising within the content stream. | Column ad_insertion_enabled (BOOLEAN) in distribution.release_window']
  ad_load_minutes decimal(5,2) [note: 'Total minutes of advertising permitted per hour of content in this distribution window. Applicable for AVOD, linear, and FAST windows. | Column ad_load_minutes (DECIMAL(5,2)) in distribution.release_window']
  audio_description_required boolean [note: 'Indicates whether audio description track is required for visually impaired accessibility in this distribution window. | Column audio_description_required (BOOLEAN) in distribution.release_window']
  blackout_rules varchar [note: 'Geographic or temporal blackout restrictions applied to this distribution window, preventing broadcast in specific regions or time periods (e.g., sports blackout rules). | Column blackout_rules (STRING) in distribution.release_window']
  carriage_fee_amount decimal(15,2) [note: 'Fixed carriage fee paid by the distributor or MVPD for the right to carry this content during the window period. | Column carriage_fee_amount (DECIMAL(15,2)) in distribution.release_window']
  closed_caption_required boolean [note: 'Indicates whether closed captioning is required for accessibility compliance in this distribution window. | Column closed_caption_required (BOOLEAN) in distribution.release_window']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.release_window']
  created_timestamp timestamp [note: 'Timestamp when this distribution window record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.release_window']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for pricing in this distribution window (e.g., USD, EUR, GBP). | Column currency_code (STRING) in distribution.release_window']
  dubbing_languages varchar [note: 'Comma-separated list of dubbing/audio track languages available for this distribution window (ISO 639-1 codes). | Column dubbing_languages (STRING) in distribution.release_window']
  effective_timestamp timestamp [note: 'Precise timestamp when this distribution window record became effective and operational for scheduling and delivery systems. | Column effective_timestamp (TIMESTAMP) in distribution.release_window']
  exclusivity_flag boolean [note: 'Indicates whether this distribution window grants exclusive rights to the platform, preventing simultaneous distribution on competing platforms during the window period. | Column exclusivity_flag (BOOLEAN) in distribution.release_window']
  expiration_timestamp timestamp [note: 'Precise timestamp when this distribution window record expires and is no longer valid for operational use. Nullable for indefinite windows. | Column expiration_timestamp (TIMESTAMP) in distribution.release_window']
  hdr_enabled boolean [note: 'Indicates whether High Dynamic Range video format is enabled for this distribution window, providing enhanced color and contrast. | Column hdr_enabled (BOOLEAN) in distribution.release_window']
  holdback_period_days varchar [note: 'Number of days between the close of the previous window and the open of this window, enforcing exclusivity periods per rights agreements. | Column holdback_period_days (INT) in distribution.release_window']
  language_version varchar [note: 'Primary language version of the content distributed in this window (e.g., English, Spanish, French). ISO 639-1 two-letter language codes preferred. | Column language_version (STRING) in distribution.release_window']
  max_resolution varchar [note: 'Maximum video resolution permitted for distribution in this window. SD = Standard Definition (480p); HD = High Definition (720p); Full HD = 1080p; 4K = Ultra HD (2160p); 8K = 4320p. | Column max_resolution (STRING) in distribution.release_window']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum guaranteed payment amount from the distributor or platform for this distribution window, regardless of actual performance. | Column minimum_guarantee_amount (DECIMAL(15,2)) in distribution.release_window']
  modified_timestamp timestamp [note: 'Timestamp when this distribution window record was last modified or updated. | Column modified_timestamp (TIMESTAMP) in distribution.release_window']
  platform_type varchar [note: 'Classification of the distribution platform. OTT = Over-The-Top streaming; Linear Broadcast = traditional scheduled TV; Theatrical = cinema exhibition; MVPD = Multichannel Video Programming Distributor; vMVPD = Virtual MVPD; FAST Channel = Free Ad-Supported Streaming Television channel; Syndication Network = content resale network. [ENUM-REF-CANDIDATE: ott|linear_broadcast|theatrical|mvpd|vmvpd|fast_channel|syndication_network — 7 candidates stripped; promote to reference product] | Column platform_type (STRING) in distribution.release_window']
  pricing_model varchar [note: 'Revenue model for this distribution window. Subscription = SVOD flat fee; Transactional = TVOD pay-per-view or rental; Advertising = AVOD ad-supported; Free = no charge to viewer; Hybrid = combination of models. | Column pricing_model (STRING) in distribution.release_window']
  purchase_price decimal(10,2) [note: 'Price charged to viewers for permanent purchase/download during this window (EST model). Nullable if not applicable. | Column purchase_price (DECIMAL(10,2)) in distribution.release_window']
  rental_price decimal(10,2) [note: 'Price charged to viewers for transactional rental access during this window (TVOD model). Nullable if not applicable. | Column rental_price (DECIMAL(10,2)) in distribution.release_window']
  revenue_share_percent decimal(5,2) [note: 'Percentage of revenue shared with the platform or distributor for this window, per the commercial distribution agreement. | Column revenue_share_percent (DECIMAL(5,2)) in distribution.release_window']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.release_window']
  streaming_protocol varchar [note: 'Primary streaming protocol used for content delivery in this window. HLS = HTTP Live Streaming; MPEG-DASH = Dynamic Adaptive Streaming over HTTP; Smooth Streaming = Microsoft Smooth Streaming; RTMP = Real-Time Messaging Protocol; Progressive Download = traditional file download. | Column streaming_protocol (STRING) in distribution.release_window']
  subtitle_languages varchar [note: 'Comma-separated list of subtitle languages available for this distribution window (ISO 639-1 codes). | Column subtitle_languages (STRING) in distribution.release_window']
  territory_scope varchar [note: 'Geographic territory or market where this distribution window applies. May be a single country code (ISO 3166-1 alpha-3), region, or \'WORLDWIDE\' for global distribution. | Column territory_scope (STRING) in distribution.release_window']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.release_window']
  window_close_date date [note: 'Date when the distribution window closes and content is no longer available on the specified platform or channel. Nullable for open-ended windows. | Column window_close_date (DATE) in distribution.release_window']
  window_code varchar [note: 'Business identifier code for the distribution window, used for operational scheduling and reporting. | Column window_code (STRING) in distribution.release_window']
  window_open_date date [note: 'Date when the distribution window opens and content becomes available on the specified platform or channel. | Column window_open_date (DATE) in distribution.release_window']
  window_priority varchar [note: 'Numeric priority ranking of this window in the overall release strategy, where 1 = highest priority (typically theatrical), incrementing for subsequent windows. | Column window_priority (INT) in distribution.release_window']
  window_status varchar [note: 'Current lifecycle status of the distribution window. Planned = scheduled but not yet open; Active = currently in distribution; Closed = window period has ended; Suspended = temporarily paused; Cancelled = window will not proceed. | Column window_status (STRING) in distribution.release_window']
  window_type varchar [note: 'Type of distribution window defining the release strategy. Theatrical = cinema release; SVOD = Subscription Video On Demand; AVOD = Advertising-Supported Video On Demand; TVOD = Transactional Video On Demand; Linear = traditional broadcast; FAST = Free Ad-Supported Streaming Television; Syndication = content resale to multiple outlets; PPV = Pay-Per-View; EST = Electronic Sell-Through. [ENUM-REF-CANDIDATE: theatrical|svod|avod|tvod|linear|fast|syndication|vod|ppv|est — 10 candidates stripped; promote to reference product] | Column window_type (STRING) in distribution.release_window']

  Note: 'Master record defining the sequential release windowing strategy for a content title across distribution platforms and channels. Captures window type (theatrical, SVOD, AVOD, TVOD, linear, FAST, syndication), platform or channel assignment, window open date, window close date, holdback period, exclusivity flag, and territory scope. Implements the windowing strategy derived from rights agreements and commercial distribution deals. Complements the rights domain\'s window records by focusing on operational delivery scheduling. | Unity Catalog table: media_broadcasting_ecm.distribution.release_window'
}

Table distribution.delivery_event {
  delivery_event_id varchar [pk, note: 'Unique identifier for the delivery event record. Primary key. | Column delivery_event_id (BIGINT) in distribution.delivery_event']
  abr_profile_id varchar [note: 'Reference to the ABR profile configuration used for this adaptive streaming delivery. | Column abr_profile_id (BIGINT) in distribution.delivery_event']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: When delivery_event records ad delivery (dai_enabled flag), linking to campaign enables campaign-level delivery verification and performance tracking. Essential for bridging distribution delivery logs | Column campaign_id (BIGINT) in sales.delivery_event']
  channel_id varchar [note: 'Reference to the distribution channel through which content was delivered (linear broadcast channel, OTT platform, FAST channel). | Column channel_id (BIGINT) in scheduling.delivery_event']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Content delivery logs require demographic context for Nielsen measurement reconciliation, audience guarantee validation, and cross-platform deduplication. Supports C3/C7 commercial ratings and makegoo | Column demographic_segment_id (BIGINT) in audience.delivery_event']
  device_type_id varchar [note: 'Reference to the device type used by the viewer for this delivery event. | Column device_type_id (BIGINT) in distribution.delivery_event']
  eas_log_id varchar [note: 'Foreign key linking to compliance.eas_log. Business justification: Delivery events for emergency alert system messages must be logged for FCC compliance. Each EAS delivery creates a compliance log entry documenting transmission, relay, and attention signal. | Column eas_log_id (BIGINT) in compliance.delivery_event']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: Delivery events represent actual content delivery under specific rights grants. Essential for usage tracking, run count enforcement, and royalty calculation based on actual exploitation. Enables right | Column grant_id (BIGINT) in rights.delivery_event']
  market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: Market attribution of delivery events enables DMA-level reporting, geographic blackout enforcement, local advertising compliance, and Nielsen station index measurement for broadcast and streaming conv | Column market_coverage_id (BIGINT) in audience.delivery_event']
  media_asset_id varchar [note: 'Reference to the content asset being delivered in this event. | Column media_asset_id (BIGINT) in mediaasset.delivery_event']
  playback_session_id varchar [note: 'Reference to the playback session associated with this delivery event for OTT/streaming deliveries. | Column playback_session_id (BIGINT) in distribution.delivery_event']
  streaming_endpoint_id varchar [note: 'Reference to the streaming endpoint used for OTT delivery events. | Column streaming_endpoint_id (BIGINT) in distribution.delivery_event']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Delivery events link to transmission equipment for performance tracking. Required for equipment performance reporting and failure pattern analysis. | Column transmission_equipment_id (BIGINT) in technology.delivery_event']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.delivery_event']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.delivery_event']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.delivery_event']
  ad_fill_rate_percent decimal(5,2) [note: 'Percentage of available ad inventory that was successfully filled during this DAI event (0.00 to 100.00). | Column ad_fill_rate_percent (DECIMAL(5,2)) in distribution.delivery_event']
  ad_pod_position varchar [note: 'Position of the ad pod within the content stream for DAI events (e.g., pre-roll=1, mid-roll=2, post-roll=3). | Column ad_pod_position (INT) in distribution.delivery_event']
  audio_codec varchar [note: 'Audio codec used for the delivered content (e.g., AAC, AC-3, E-AC-3, Dolby Atmos). | Column audio_codec (STRING) in distribution.delivery_event']
  bitrate_kbps varchar [note: 'Stream bitrate in kilobits per second at the time of this delivery event. | Column bitrate_kbps (INT) in distribution.delivery_event']
  bytes_delivered varchar [note: 'Total number of bytes delivered to the viewer during this event. | Column bytes_delivered (BIGINT) in distribution.delivery_event']
  cdn_cache_status varchar [note: 'CDN cache status for this delivery (hit, miss, stale, bypass). | Column cdn_cache_status (STRING) in distribution.delivery_event']
  cdn_node_code varchar [note: 'Identifier of the CDN edge node that served the content for this delivery event. | Column cdn_node_code (STRING) in distribution.delivery_event']
  cdn_pop_location varchar [note: 'Geographic location identifier of the CDN point of presence that served this delivery. | Column cdn_pop_location (STRING) in distribution.delivery_event']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.delivery_event']
  created_timestamp timestamp [note: 'Timestamp when this delivery event record was created in the system. | Column created_timestamp (TIMESTAMP) in distribution.delivery_event']
  dai_enabled boolean [note: 'Flag indicating whether dynamic ad insertion was enabled for this delivery event. | Column dai_enabled (BOOLEAN) in distribution.delivery_event']
  delivery_channel_type varchar [note: 'Classification of the delivery channel type (linear broadcast, OTT streaming, VOD, FAST channel, MVPD, vMVPD). | Column delivery_channel_type (STRING) in distribution.delivery_event']
  delivery_status varchar [note: 'Outcome status of the delivery event (success, failure, degraded quality, partial delivery). | Column delivery_status (STRING) in distribution.delivery_event']
  delivery_technology varchar [note: 'Technical protocol or standard used for content delivery (HLS, MPEG-DASH, DVB, ATSC, QAM, Smooth Streaming, RTMP). [ENUM-REF-CANDIDATE: hls|mpeg_dash|dvb|atsc|qam|smooth_streaming|rtmp — 7 candidates stripped; promote to reference product] | Column delivery_technology (STRING) in distribution.delivery_event']
  drm_system varchar [note: 'DRM system applied to protect the content during delivery (Widevine, PlayReady, FairPlay, or none for unprotected content). | Column drm_system (STRING) in distribution.delivery_event']
  error_code varchar [note: 'System error code if the delivery event encountered a failure or degradation. | Column error_code (STRING) in distribution.delivery_event']
  error_message varchar [note: 'Human-readable error message describing the delivery failure or issue. | Column error_message (STRING) in distribution.delivery_event']
  event_timestamp timestamp [note: 'Precise timestamp when the delivery event occurred (stream start, broadcast transmission, VOD delivery initiation). | Column event_timestamp (TIMESTAMP) in distribution.delivery_event']
  event_type varchar [note: 'Type of delivery event being recorded (stream start, VOD delivery, broadcast transmission, DAI insertion, stream end, playback error, buffer event). [ENUM-REF-CANDIDATE: stream_start|vod_delivery|broadcast_tx|dai_insertion|stream_end|playback_error|buffer_event — 7 candidates stripped; promote to reference product] | Column event_type (STRING) in distribution.delivery_event']
  geographic_country_code varchar [note: 'ISO 3166-1 alpha-3 country code where the delivery occurred (e.g., USA, GBR, CAN). | Column geographic_country_code (STRING) in distribution.delivery_event']
  geographic_region varchar [note: 'Geographic region where the content was delivered (e.g., North America, EMEA, APAC, or specific country/state codes). | Column geographic_region (STRING) in distribution.delivery_event']
  network_latency_ms varchar [note: 'Network latency measured in milliseconds between CDN edge and viewer device. | Column network_latency_ms (INT) in distribution.delivery_event']
  origin_server_response_time_ms varchar [note: 'Response time from origin server in milliseconds for cache-miss scenarios. | Column origin_server_response_time_ms (INT) in distribution.delivery_event']
  resolution varchar [note: 'Video resolution delivered (e.g., 1920x1080, 3840x2160, 1280x720). | Column resolution (STRING) in distribution.delivery_event']
  scte35_signal_type varchar [note: 'Type of SCTE-35 signal that triggered the DAI event (e.g., splice_insert, time_signal). | Column scte35_signal_type (STRING) in distribution.delivery_event']
  session_duration_seconds varchar [note: 'Total duration of the delivery session in seconds for streaming events. | Column session_duration_seconds (INT) in distribution.delivery_event']
  sla_tier varchar [note: 'SLA tier classification applicable to this delivery event (e.g., premium, standard, basic). | Column sla_tier (STRING) in distribution.delivery_event']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.delivery_event']
  streaming_protocol varchar [note: 'Specific streaming protocol used for OTT delivery (HLS, DASH, Smooth Streaming, RTMP, WebRTC). | Column streaming_protocol (STRING) in distribution.delivery_event']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.delivery_event']
  updated_timestamp timestamp [note: 'Timestamp when this delivery event record was last updated. | Column updated_timestamp (TIMESTAMP) in distribution.delivery_event']
  user_agent varchar [note: 'User agent string from the viewer device identifying browser/app and operating system. | Column user_agent (STRING) in distribution.delivery_event']
  video_codec varchar [note: 'Video codec used for encoding the delivered content (e.g., H.264, H.265/HEVC, VP9, AV1). | Column video_codec (STRING) in distribution.delivery_event']
  viewer_ip_address varchar [note: 'IP address of the viewer device that received the content delivery. | Column viewer_ip_address (STRING) in distribution.delivery_event']

  Note: 'Transactional record capturing each discrete content delivery event — including stream session initiations, linear broadcast transmissions, VOD asset deliveries, FAST channel playout events, and dynamic ad insertion (DAI) sessions. Captures event timestamp, event type (stream_start, vod_delivery, broadcast_tx, dai_insertion), delivery channel, content asset reference, delivery technology (HLS, MPEG-DASH, DVB, ATSC), CDN node, geographic region, stream quality (bitrate, resolution), delivery status (success, failure, degraded), error codes, and DAI-specific attributes (ad pod position, SCTE-35 signal, fill rate) where applicable. Feeds delivery SLA monitoring, CDN performance reporting, and AVOD/FAST monetization reconciliation. | Unity Catalog table: media_broadcasting_ecm.distribution.delivery_event'
}

Table distribution.sla_breach {
  sla_breach_id varchar [pk, note: 'Unique identifier for the SLA breach record. Primary key for the sla_breach product. | Column sla_breach_id (BIGINT) in distribution.sla_breach']
  accounts_payable_id varchar [note: 'Foreign key linking to finance.accounts_payable. Business justification: SLA breaches with distribution partners trigger penalty payments or makegood obligations, creating A/P liabilities. Quarterly SLA review creates A/P accruals for penalties owed to partners per carriag | Column accounts_payable_id (BIGINT) in finance.sla_breach']
  compliance_incident_id varchar [note: 'Foreign key linking to compliance.incident. Business justification: SLA breaches violating regulatory commitments (accessibility uptime, emergency alert delivery, closed caption availability) escalate to compliance incidents. Breach severity and regulatory impact dete | Column compliance_incident_id (BIGINT) in compliance.sla_breach']
  incident_owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: SLA breaches require incident ownership for root cause analysis, remediation coordination, partner communication, and penalty mitigation. Essential for on-call rotations, incident postmortems, perform | Column incident_owner_employee_id (BIGINT) in workforce.sla_breach']
  noc_alert_id varchar [note: 'Foreign key linking to technology.noc_alert. Business justification: SLA breaches are triggered by NOC alerts. Required for breach root cause analysis and penalty dispute resolution traceability. | Column noc_alert_id (BIGINT) in technology.sla_breach']
  sla_definition_id varchar [note: 'Reference to the SLA definition that was breached, linking to the specific SLA commitment and thresholds. | Column sla_definition_id (BIGINT) in distribution.sla_breach']
  streaming_endpoint_id varchar [note: 'Reference to the streaming endpoint where the breach occurred, identifying the specific delivery channel affected. | Column streaming_endpoint_id (BIGINT) in distribution.sla_breach']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.sla_breach']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.sla_breach']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.sla_breach']
  affected_platform varchar [note: 'The distribution platform or service tier affected by the breach, such as OTT, MVPD, or FAST channel. | Column affected_platform (STRING) in distribution.sla_breach']
  affected_region varchar [note: 'The geographic region or CDN Point of Presence (POP) where the breach occurred, identifying the scope of impact. | Column affected_region (STRING) in distribution.sla_breach']
  breach_duration_minutes varchar [note: 'The total duration of the SLA breach in minutes, from detection to restoration of service within SLA parameters. | Column breach_duration_minutes (INT) in distribution.sla_breach']
  breach_severity varchar [note: 'The severity classification of the breach based on business impact, used for prioritization and escalation. | Column breach_severity (STRING) in distribution.sla_breach']
  breach_status varchar [note: 'Current state of the breach in its resolution lifecycle, tracking progress from detection through closure. | Column breach_status (STRING) in distribution.sla_breach']
  breach_timestamp timestamp [note: 'The exact date and time when the SLA breach was detected and recorded. This is the principal business event timestamp for the breach. | Column breach_timestamp (TIMESTAMP) in distribution.sla_breach']
  cdn_provider varchar [note: 'The CDN provider responsible for content delivery at the time of the breach, used for vendor accountability. | Column cdn_provider (STRING) in distribution.sla_breach']
  contract_reference varchar [note: 'Reference to the contract or service agreement under which the SLA commitment was made, used for dispute resolution. | Column contract_reference (STRING) in distribution.sla_breach']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.sla_breach']
  created_timestamp timestamp [note: 'The date and time when this breach record was first created in the system for audit trail purposes. | Column created_timestamp (TIMESTAMP) in distribution.sla_breach']
  detection_method varchar [note: 'The method by which the SLA breach was detected, indicating whether it was proactive monitoring or reactive reporting. | Column detection_method (STRING) in distribution.sla_breach']
  dispute_flag boolean [note: 'Indicates whether the breach determination or penalty is under dispute by the partner or service provider. | Column dispute_flag (BOOLEAN) in distribution.sla_breach']
  dispute_reason varchar [note: 'Explanation provided for disputing the breach determination, penalty calculation, or responsibility assignment. | Column dispute_reason (STRING) in distribution.sla_breach']
  escalation_level varchar [note: 'The escalation tier reached during breach resolution, indicating the organizational level involved in remediation. | Column escalation_level (STRING) in distribution.sla_breach']
  last_modified_timestamp timestamp [note: 'The date and time when this breach record was last updated, tracking changes throughout the breach lifecycle. | Column last_modified_timestamp (TIMESTAMP) in distribution.sla_breach']
  makegood_triggered_flag boolean [note: 'Indicates whether a makegood (compensatory delivery or ad spot) was triggered as a result of this breach. | Column makegood_triggered_flag (BOOLEAN) in distribution.sla_breach']
  measured_value decimal(18,6) [note: 'The actual measured value of the metric at the time of breach, representing the performance level that violated the SLA threshold. | Column measured_value (DECIMAL(18,6)) in distribution.sla_breach']
  metric_name varchar [note: 'The specific SLA metric that was breached, such as uptime percentage, latency, error rate, or availability. | Column metric_name (STRING) in distribution.sla_breach']
  metric_type varchar [note: 'Category of the SLA metric that was breached, classifying the nature of the performance issue. | Column metric_type (STRING) in distribution.sla_breach']
  notes varchar [note: 'Additional free-text notes or comments regarding the breach, investigation, or resolution for operational context. | Column notes (STRING) in distribution.sla_breach']
  notification_sent_flag boolean [note: 'Indicates whether breach notification was sent to affected partners, stakeholders, or customers as required by SLA terms. | Column notification_sent_flag (BOOLEAN) in distribution.sla_breach']
  notification_timestamp timestamp [note: 'The date and time when breach notification was sent to affected parties. | Column notification_timestamp (TIMESTAMP) in distribution.sla_breach']
  partner_name varchar [note: 'The name of the distribution partner or MVPD affected by the breach, relevant for partner SLA reporting. | Column partner_name (STRING) in distribution.sla_breach']
  penalty_amount decimal(15,2) [note: 'The monetary penalty or service credit amount triggered by the breach, as defined in the SLA contract. | Column penalty_amount (DECIMAL(15,2)) in distribution.sla_breach']
  penalty_applicable_flag boolean [note: 'Indicates whether a contractual penalty or credit is applicable for this breach based on SLA terms. | Column penalty_applicable_flag (BOOLEAN) in distribution.sla_breach']
  penalty_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the penalty amount. | Column penalty_currency_code (STRING) in distribution.sla_breach']
  remediation_action varchar [note: 'Description of the corrective action taken to resolve the breach and restore service to acceptable levels. | Column remediation_action (STRING) in distribution.sla_breach']
  resolution_timestamp timestamp [note: 'The date and time when the breach was resolved and service was restored to within SLA parameters. | Column resolution_timestamp (TIMESTAMP) in distribution.sla_breach']
  root_cause_category varchar [note: 'High-level categorization of the underlying cause of the SLA breach, used for trend analysis and preventive action. | Column root_cause_category (STRING) in distribution.sla_breach']
  root_cause_description varchar [note: 'Detailed narrative explanation of the root cause identified through investigation, providing context for the breach. | Column root_cause_description (STRING) in distribution.sla_breach']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.sla_breach']
  streaming_protocol varchar [note: 'The streaming protocol in use when the breach occurred, such as HLS or MPEG-DASH. | Column streaming_protocol (STRING) in distribution.sla_breach']
  threshold_value decimal(18,6) [note: 'The SLA threshold value that was violated, representing the minimum acceptable performance level defined in the SLA commitment. | Column threshold_value (DECIMAL(18,6)) in distribution.sla_breach']
  unit_of_measure varchar [note: 'The unit in which the metric is measured, such as percentage, milliseconds, Mbps, or requests per second. | Column unit_of_measure (STRING) in distribution.sla_breach']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.sla_breach']
  validated_by varchar [note: 'The user or system that validated the breach measurement and determination, ensuring accuracy for reporting. | Column validated_by (STRING) in distribution.sla_breach']
  validated_timestamp timestamp [note: 'The date and time when the breach record was validated and approved for reporting or penalty processing. | Column validated_timestamp (TIMESTAMP) in distribution.sla_breach']
  variance_percentage decimal(10,4) [note: 'The variance expressed as a percentage of the threshold, providing a normalized measure of breach severity. | Column variance_percentage (DECIMAL(10,4)) in distribution.sla_breach']
  variance_value decimal(18,6) [note: 'The calculated difference between the measured value and the threshold value, quantifying the magnitude of the breach. | Column variance_value (DECIMAL(18,6)) in distribution.sla_breach']

  Note: 'Transactional record capturing instances where a delivery SLA commitment was violated for a distribution channel or partner. Captures breach timestamp, affected delivery channel, SLA metric breached (uptime, latency, error rate), measured value, SLA threshold, breach duration, root cause category, resolution timestamp, and whether a makegood or penalty was triggered. Supports partner SLA reporting, dispute resolution, and operational improvement tracking. | Unity Catalog table: media_broadcasting_ecm.distribution.sla_breach'
}

Table distribution.dai_session {
  dai_session_id varchar [pk, note: 'Unique identifier for the DAI session. Primary key for the dai_session product. | Column dai_session_id (BIGINT) in distribution.dai_session']
  ad_order_id varchar [note: 'Foreign key linking to sales.ad_order. Business justification: DAI sessions fulfill contracted ad orders. Linking to ad_order enables order-level delivery tracking, contracted-vs-actual reconciliation, billing verification, and order fulfillment reporting. Essent | Column ad_order_id (BIGINT) in sales.dai_session']
  campaign_id varchar [note: 'Foreign key linking to sales.campaign. Business justification: Distribution DAI sessions serve ads from specific advertising campaigns. Linking enables campaign-level delivery reporting, pacing analysis, cross-domain revenue attribution, and campaign performance  | Column campaign_id (BIGINT) in sales.dai_session']
  channel_id varchar [note: 'Reference to the linear or FAST channel on which the DAI session occurred. Applicable for live broadcast and FAST channel monetization. | Column channel_id (BIGINT) in scheduling.dai_session']
  content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Dynamic ad insertion must respect content rating for ad appropriateness (no alcohol ads in children\'s programming). Real-time rating checks during ad decisioning ensure compliance. | Column content_rating_id (BIGINT) in compliance.dai_session']
  dai_configuration_id varchar [note: 'Foreign key linking to distribution.dai_configuration. Business justification: DAI sessions should reference the configuration used. Tracks which DAI config was applied during the session. Removes dai_provider STRING (derivable from dai_configuration). | Column dai_configuration_id (BIGINT) in distribution.dai_session']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Real-time demographic targeting drives programmatic ad decisioning, frequency capping by demo, and guaranteed audience delivery. Essential for upfront commitment fulfillment and Nielsen-rated commerci | Column demographic_segment_id (BIGINT) in audience.dai_session']
  grant_id varchar [note: 'Foreign key linking to rights.rights_grant. Business justification: DAI sessions insert ads into content governed by specific rights grants. Ad insertion rights, ad load limits, and ad revenue share calculations depend on the underlying rights grant. Essential for rig | Column grant_id (BIGINT) in rights.dai_session']
  media_asset_id varchar [note: 'Reference to the content asset (video, live stream, FAST channel) being delivered when the DAI session was executed. | Column media_asset_id (BIGINT) in mediaasset.dai_session']
  playback_session_id varchar [note: 'Reference to the parent streaming playback session during which this DAI session occurred. Links DAI monetization events to viewer streaming activity. | Column playback_session_id (BIGINT) in distribution.dai_session']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: DAI (dynamic ad insertion) sessions generate advertising revenue streams. Daily ad revenue reconciliation ties DAI sessions to revenue streams for accrual accounting and reconciliation with ad server  | Column revenue_stream_id (BIGINT) in finance.dai_session']
  segment_id varchar [note: 'Foreign key linking to audience.audience_segment. Business justification: Behavioral audience segments enable advanced programmatic targeting beyond demographics, supporting lookalike modeling, cross-platform campaign optimization, and addressable advertising in modern ad t | Column segment_id (BIGINT) in audience.dai_session']
  streaming_endpoint_id varchar [note: 'Reference to the streaming endpoint (CDN edge, origin server) that served the DAI-enabled stream. | Column streaming_endpoint_id (BIGINT) in distribution.dai_session']
  subscriber_id varchar [note: 'Unique identifier for the subscriber or viewer associated with this DAI session. Enables personalized ad targeting and frequency capping. | Column subscriber_id (BIGINT) in subscriber.dai_session']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Backend gross participation clauses in talent contracts require tracking ad revenue generated during content delivery featuring specific talent. Broadcasters must link dynamic ad insertion sessions to | Column talent_profile_id (BIGINT) in talent.dai_session']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.dai_session']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.dai_session']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.dai_session']
  ad_decision_server_response_time_ms varchar [note: 'Time in milliseconds taken by the ad decision server to respond with ad selection. Critical for measuring DAI latency and QoS. | Column ad_decision_server_response_time_ms (INT) in distribution.dai_session']
  ad_decision_server_url varchar [note: 'URL of the ad decision server (ADS) that was queried to determine which ads to insert. Typically a VAST or VMAP endpoint. | Column ad_decision_server_url (STRING) in distribution.dai_session']
  ad_pod_duration_seconds decimal(10,3) [note: 'Total duration of the ad pod in seconds. Represents the available inventory window for ad insertion. | Column ad_pod_duration_seconds (DECIMAL(10,3)) in distribution.dai_session']
  ad_pod_position varchar [note: 'Position of the ad pod within the content stream. Indicates whether ads were served before content (pre-roll), during content (mid-roll), or after content (post-roll). | Column ad_pod_position (STRING) in distribution.dai_session']
  ad_pod_sequence_number varchar [note: 'Sequential number of this ad pod within the content playback session. Enables tracking of multiple ad breaks within a single viewing session. | Column ad_pod_sequence_number (INT) in distribution.dai_session']
  ad_targeting_segment_ids varchar [note: 'Comma-separated list of audience segment IDs applied for ad targeting during this DAI session. Links to audience segmentation and personalization strategies. | Column ad_targeting_segment_ids (STRING) in distribution.dai_session']
  ads_fallback_count varchar [note: 'Number of fallback or house ads served when primary ad inventory was unavailable. Indicates unfilled demand. | Column ads_fallback_count (INT) in distribution.dai_session']
  ads_inserted_count varchar [note: 'Number of ads successfully inserted and delivered during this DAI session. Used to calculate fill rate and monetization efficiency. | Column ads_inserted_count (INT) in distribution.dai_session']
  ads_requested_count varchar [note: 'Number of ad slots requested from the ad decision server for this DAI session. Represents the maximum fill capacity of the ad pod. | Column ads_requested_count (INT) in distribution.dai_session']
  app_version varchar [note: 'Version of the streaming application or player that executed the DAI session. Used for troubleshooting and feature compatibility analysis. | Column app_version (STRING) in distribution.dai_session']
  blackout_override_flag boolean [note: 'Indicates whether geographic blackout restrictions were overridden for this DAI session. True if blackout rules were bypassed (e.g., for authenticated subscribers). | Column blackout_override_flag (BOOLEAN) in distribution.dai_session']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.dai_session']
  created_timestamp timestamp [note: 'Timestamp when this DAI session record was first created in the system. Used for data lineage and audit trail. | Column created_timestamp (TIMESTAMP) in distribution.dai_session']
  device_type varchar [note: 'Type of device on which the DAI session was delivered. Influences ad format compatibility and targeting strategies. [ENUM-REF-CANDIDATE: smart_tv|mobile|tablet|desktop|set_top_box|gaming_console|streaming_stick|other — 8 candidates stripped; promote to reference product] | Column device_type (STRING) in distribution.dai_session']
  drm_enforcement_flag boolean [note: 'Indicates whether DRM protection was enforced on the ad-stitched stream. True if ads were delivered with DRM encryption. | Column drm_enforcement_flag (BOOLEAN) in distribution.dai_session']
  error_code varchar [note: 'Error code returned if the DAI session encountered a failure. Used for troubleshooting ad delivery issues and optimizing fill rates. | Column error_code (STRING) in distribution.dai_session']
  error_message varchar [note: 'Human-readable error message describing the failure reason if the DAI session did not complete successfully. | Column error_message (STRING) in distribution.dai_session']
  fill_rate_percentage decimal(5,2) [note: 'Percentage of requested ad slots that were successfully filled with paid ads. Calculated as (ads_inserted_count / ads_requested_count) * 100. Key monetization metric. | Column fill_rate_percentage (DECIMAL(5,2)) in distribution.dai_session']
  frequency_cap_applied_flag boolean [note: 'Indicates whether frequency capping rules were applied to limit ad repetition for this viewer. True if frequency cap was enforced. | Column frequency_cap_applied_flag (BOOLEAN) in distribution.dai_session']
  geographic_country_code varchar [note: 'Three-letter ISO country code representing the viewers geographic location. Derived from IP address or device GPS. Used for geo-targeted ad campaigns. | Column geographic_country_code (STRING) in distribution.dai_session']
  geographic_dma_code varchar [note: 'Nielsen Designated Market Area code representing the viewers media market. Critical for local advertising sales and audience measurement alignment. | Column geographic_dma_code (STRING) in distribution.dai_session']
  geographic_region varchar [note: 'State, province, or region where the viewer was located during the DAI session. Enables regional ad targeting and compliance with local advertising regulations. | Column geographic_region (STRING) in distribution.dai_session']
  platform_type varchar [note: 'Operating system or platform on which the DAI-enabled player was running. Critical for device-specific ad targeting and compatibility. [ENUM-REF-CANDIDATE: web|ios|android|roku|fire_tv|apple_tv|samsung_tizen|lg_webos|xbox|playstation|other — 11 candidates stripped; promote to reference product] | Column platform_type (STRING) in distribution.dai_session']
  scte35_cue_type varchar [note: 'Type of SCTE-35 cue message that triggered the DAI session. Indicates the nature of the ad opportunity (splice insert, time signal, segmentation descriptor). [ENUM-REF-CANDIDATE: splice_insert|time_signal|segmentation_descriptor|provider_advertisement|distributor_advertisement|program_start|program_end|chapter_start|break_start|break_end — 10 candidates stripped; promote to reference product] | Column scte35_cue_type (STRING) in distribution.dai_session']
  scte35_signal_timestamp timestamp [note: 'Timestamp of the SCTE-35 cue message that triggered the DAI opportunity. Critical for synchronizing ad insertion with content breaks. | Column scte35_signal_timestamp (TIMESTAMP) in distribution.dai_session']
  session_end_timestamp timestamp [note: 'Timestamp when the DAI session completed. Marks the end of ad pod delivery and return to content. | Column session_end_timestamp (TIMESTAMP) in distribution.dai_session']
  session_start_timestamp timestamp [note: 'Timestamp when the DAI session was initiated. Represents the moment the ad decision server was queried for this ad opportunity. | Column session_start_timestamp (TIMESTAMP) in distribution.dai_session']
  session_status varchar [note: 'Final status of the DAI session. Indicates whether the session completed successfully, partially filled, failed, timed out, or was abandoned by the viewer. | Column session_status (STRING) in distribution.dai_session']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.dai_session']
  stitching_mode varchar [note: 'Method used to insert ads into the stream. Server-side stitching (SSAI) integrates ads at the CDN level; client-side stitching occurs in the player. | Column stitching_mode (STRING) in distribution.dai_session']
  streaming_protocol varchar [note: 'Adaptive bitrate streaming protocol used for DAI delivery (HLS, MPEG-DASH, Smooth Streaming). Affects manifest manipulation and ad stitching approach. | Column streaming_protocol (STRING) in distribution.dai_session']
  total_ad_duration_seconds decimal(10,3) [note: 'Total duration of all ads actually delivered during this DAI session. May differ from ad_pod_duration_seconds if pod was not fully filled. | Column total_ad_duration_seconds (DECIMAL(10,3)) in distribution.dai_session']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.dai_session']
  updated_timestamp timestamp [note: 'Timestamp when this DAI session record was last modified. Tracks changes to session status or post-session reconciliation updates. | Column updated_timestamp (TIMESTAMP) in distribution.dai_session']
  viewer_ip_address varchar [note: 'IP address of the viewer device at the time of the DAI session. Used for geo-targeting and fraud detection. May be considered PII under GDPR. | Column viewer_ip_address (STRING) in distribution.dai_session']

  Note: 'Transactional record capturing Dynamic Ad Insertion (DAI) sessions executed during streaming delivery. Captures session identifier, delivery channel or stream, viewer session reference, ad pod position (pre-roll, mid-roll, post-roll), SCTE-35 signal timestamp, ad decision server response, number of ads inserted, fill rate, fallback ad flag, and DAI provider (e.g., Google DAI, Yospace). Supports AVOD and FAST channel monetization reconciliation and ad fill rate optimization. | Unity Catalog table: media_broadcasting_ecm.distribution.dai_session'
}

Table distribution.retransmission_consent {
  retransmission_consent_id varchar [pk, note: 'Primary key for retransmission_consent | Column retransmission_consent_id (BIGINT) in distribution.retransmission_consent']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Retransmission consent records must directly reference broadcast license for FCC filing, public inspection file inclusion, and must-carry election tracking. License is the regulatory anchor for consen | Column broadcast_license_id (BIGINT) in compliance.retransmission_consent']
  carriage_agreement_id varchar [note: 'Foreign key linking to distribution.carriage_agreement. Business justification: Retransmission consent is often tied to carriage agreements. Consent enables carriage under specific agreement terms. Essential for legal compliance tracking. | Column carriage_agreement_id (BIGINT) in distribution.retransmission_consent']
  distribution_partner_id varchar [note: 'Foreign key linking to distribution.distribution_partner. Business justification: Retransmission consent is granted to specific MVPD partners (MVPDs are distribution partners). retransmission_consent.mvpd_id should FK to distribution_partner. Removes mvpd_id BIGINT and mvpd_name ST | Column distribution_partner_id (BIGINT) in distribution.retransmission_consent']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Retransmission consent agreements are specialized broadcast rights licenses. Linking enables rights chain validation, ensures MVPDs have proper authorization, and supports fee reconciliation between r | Column license_agreement_id (BIGINT) in rights.retransmission_consent']
  negotiator_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Retransmission consent agreements are regulatory/legal contracts requiring negotiator ownership for FCC compliance, blackout coordination, must-carry elections, and good-faith negotiation requirements | Column negotiator_employee_id (BIGINT) in workforce.retransmission_consent']
  partner_id varchar [note: 'Identifier of the broadcast station granting retransmission consent authorization. | Column partner_id (BIGINT) in partner.retransmission_consent']
  source_opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Retransmission consent agreements originate from sales opportunities during broadcaster-MVPD negotiations. Tracks negotiation lifecycle from opportunity through executed consent agreement. Critical fo | Column source_opportunity_id (BIGINT) in sales.retransmission_consent']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.retransmission_consent']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.retransmission_consent']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.retransmission_consent']
  approval_date date [note: 'Date when the retransmission consent agreement received final internal approval and authorization for execution. | Column approval_date (DATE) in distribution.retransmission_consent']
  approved_by varchar [note: 'Name or identifier of the executive or legal authority who approved the retransmission consent agreement on behalf of the broadcaster. | Column approved_by (STRING) in distribution.retransmission_consent']
  authorized_dma_list varchar [note: 'Comma-separated list of Nielsen DMA codes where the MVPD is authorized to retransmit the broadcast signal (e.g., 501,602,803). | Column authorized_dma_list (STRING) in distribution.retransmission_consent']
  blackout_provision_flag boolean [note: 'Indicates whether the agreement includes geographic blackout provisions restricting retransmission in certain markets or during specific events. | Column blackout_provision_flag (BOOLEAN) in distribution.retransmission_consent']
  blackout_terms varchar [note: 'Detailed description of blackout restrictions, including affected content types, geographic areas, and triggering conditions. | Column blackout_terms (STRING) in distribution.retransmission_consent']
  cash_compensation_amount decimal(15,2) [note: 'Monetary compensation amount paid by the MVPD to the broadcaster per billing period. Null if compensation is non-cash. | Column cash_compensation_amount (DECIMAL(15,2)) in distribution.retransmission_consent']
  channel_carriage_commitment varchar [note: 'Description of channel carriage commitments provided by the MVPD as part of the retransmission consent agreement (e.g., carriage of affiliated digital subchannels). | Column channel_carriage_commitment (STRING) in distribution.retransmission_consent']
  compensation_currency_code varchar [note: 'ISO 4217 three-letter currency code for cash compensation (e.g., USD, CAD, GBP). | Column compensation_currency_code (STRING) in distribution.retransmission_consent']
  compensation_frequency varchar [note: 'Billing frequency for cash compensation payments from MVPD to broadcaster. | Column compensation_frequency (STRING) in distribution.retransmission_consent']
  compensation_type varchar [note: 'Primary form of compensation provided by the MVPD to the broadcaster in exchange for retransmission consent. | Column compensation_type (STRING) in distribution.retransmission_consent']
  consent_agreement_number varchar [note: 'Externally-known unique business identifier for the retransmission consent agreement, typically formatted as RTC-YYYYNNNN. | Column consent_agreement_number (STRING) in distribution.retransmission_consent']
  consent_status varchar [note: 'Current lifecycle status of the retransmission consent agreement. [ENUM-REF-CANDIDATE: draft|negotiation|active|expired|terminated|suspended|disputed — 7 candidates stripped; promote to reference product] | Column consent_status (STRING) in distribution.retransmission_consent']
  consent_type varchar [note: 'Type of carriage authorization: retransmission consent (negotiated) or must-carry (mandatory under FCC rules). | Column consent_type (STRING) in distribution.retransmission_consent']
  contract_document_reference varchar [note: 'Reference identifier or file path to the executed retransmission consent contract document in the document management system. | Column contract_document_reference (STRING) in distribution.retransmission_consent']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.retransmission_consent']
  created_timestamp timestamp [note: 'Timestamp when this retransmission consent record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.retransmission_consent']
  dispute_resolution_method varchar [note: 'Agreed-upon method for resolving disputes arising from the retransmission consent agreement. | Column dispute_resolution_method (STRING) in distribution.retransmission_consent']
  effective_date date [note: 'Date when the retransmission consent agreement becomes legally binding and carriage authorization begins. | Column effective_date (DATE) in distribution.retransmission_consent']
  expiry_date date [note: 'Date when the retransmission consent agreement terminates and carriage authorization ends. Nullable for indefinite agreements. | Column expiry_date (DATE) in distribution.retransmission_consent']
  fcc_filing_reference varchar [note: 'Reference number or identifier for any FCC filings, notifications, or complaints associated with this retransmission consent agreement. | Column fcc_filing_reference (STRING) in distribution.retransmission_consent']
  geographic_scope varchar [note: 'Geographic coverage scope of the retransmission consent agreement. | Column geographic_scope (STRING) in distribution.retransmission_consent']
  good_faith_negotiation_flag boolean [note: 'Indicates whether both parties certified compliance with FCC good faith negotiation requirements during retransmission consent discussions. | Column good_faith_negotiation_flag (BOOLEAN) in distribution.retransmission_consent']
  last_modified_timestamp timestamp [note: 'Timestamp when this retransmission consent record was last updated or modified. | Column last_modified_timestamp (TIMESTAMP) in distribution.retransmission_consent']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this retransmission consent record. | Column modified_by_user (STRING) in distribution.retransmission_consent']
  must_carry_election_date date [note: 'Date when the broadcaster formally elected must-carry status with the MVPD. Null if retransmission consent was negotiated. | Column must_carry_election_date (DATE) in distribution.retransmission_consent']
  must_carry_election_flag boolean [note: 'Indicates whether the broadcaster elected must-carry status instead of negotiating retransmission consent. True if must-carry was elected. | Column must_carry_election_flag (BOOLEAN) in distribution.retransmission_consent']
  mvpd_type varchar [note: 'Classification of the MVPD platform type receiving retransmission consent. | Column mvpd_type (STRING) in distribution.retransmission_consent']
  negotiation_completion_date date [note: 'Date when retransmission consent negotiations were successfully concluded and agreement was reached. | Column negotiation_completion_date (DATE) in distribution.retransmission_consent']
  negotiation_start_date date [note: 'Date when retransmission consent negotiations formally commenced between broadcaster and MVPD. | Column negotiation_start_date (DATE) in distribution.retransmission_consent']
  notes varchar [note: 'Free-text field for additional notes, special conditions, or contextual information regarding the retransmission consent agreement. | Column notes (STRING) in distribution.retransmission_consent']
  promotional_commitment varchar [note: 'Description of promotional support commitments provided by the MVPD (e.g., on-air promotion, co-marketing campaigns). | Column promotional_commitment (STRING) in distribution.retransmission_consent']
  renewal_notice_days varchar [note: 'Number of days advance notice required before expiry date to trigger renewal or renegotiation process. | Column renewal_notice_days (INT) in distribution.retransmission_consent']
  renewal_option_flag boolean [note: 'Indicates whether the agreement includes an automatic renewal option or requires renegotiation at expiry. | Column renewal_option_flag (BOOLEAN) in distribution.retransmission_consent']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.retransmission_consent']
  termination_clause varchar [note: 'Description of conditions under which either party may terminate the retransmission consent agreement prior to expiry date. | Column termination_clause (STRING) in distribution.retransmission_consent']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.retransmission_consent']

  Note: 'Master record documenting retransmission consent authorizations granted to MVPDs and vMVPDs to rebroadcast over-the-air broadcast signals. Captures grantor broadcaster, grantee MVPD/vMVPD, authorized markets (DMAs), consent effective date, consent expiry date, compensation terms (cash, channel carriage, promotional commitments), must-carry election status, and negotiation history flags. Governed by FCC retransmission consent regulations. | Unity Catalog table: media_broadcasting_ecm.distribution.retransmission_consent Akamai CDN integration supported.'
}

Table distribution.subscriber_count_report {
  subscriber_count_report_id varchar [pk, note: 'Unique identifier for the subscriber count report record. Primary key. | Column subscriber_count_report_id (BIGINT) in distribution.subscriber_count_report']
  auditor_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Subscriber count reports drive carriage fee invoicing and require auditor ownership for variance investigation, dispute resolution, audit rights exercise, and third-party auditor coordination. Essenti | Column auditor_employee_id (BIGINT) in workforce.subscriber_count_report']
  carriage_agreement_id varchar [note: 'Foreign key linking to distribution.carriage_agreement. Business justification: Subscriber count reports validate carriage agreement terms. Reports are submitted per agreement for billing purposes. Removes contract_reference STRING (derivable from carriage_agreement.agreement_num | Column carriage_agreement_id (BIGINT) in distribution.subscriber_count_report']
  channel_id varchar [note: 'Reference to the specific channel or channel tier for which subscriber counts are being reported. | Column channel_id (BIGINT) in scheduling.subscriber_count_report']
  distribution_partner_id varchar [note: 'Reference to the MVPD (Multichannel Video Programming Distributor) or vMVPD (Virtual Multichannel Video Programming Distributor) partner submitting the subscriber count report. | Column distribution_partner_id (BIGINT) in distribution.subscriber_count_report']
  market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: Subscriber counts are reported by DMA for carriage fee calculation, retransmission consent compliance, and Nielsen universe estimation. Market-level reporting is mandated in distribution partner contr | Column market_coverage_id (BIGINT) in audience.subscriber_count_report']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.subscriber_count_report']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.subscriber_count_report']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.subscriber_count_report']
  approval_date date [note: 'Date on which the subscriber count report was formally approved for use in carriage fee invoice generation. | Column approval_date (DATE) in distribution.subscriber_count_report']
  approval_status varchar [note: 'Current approval status of the subscriber count report in the verification and reconciliation workflow. | Column approval_status (STRING) in distribution.subscriber_count_report']
  approved_by varchar [note: 'Name or identifier of the internal user or role who approved the subscriber count report for carriage fee calculation. | Column approved_by (STRING) in distribution.subscriber_count_report']
  audit_report_reference varchar [note: 'Reference identifier to the formal audit report document associated with this subscriber count verification, if a third-party audit was conducted. | Column audit_report_reference (STRING) in distribution.subscriber_count_report']
  audit_rights_exercised boolean [note: 'Indicator of whether contractual audit rights were formally exercised for this reporting period, triggering enhanced verification procedures. | Column audit_rights_exercised (BOOLEAN) in distribution.subscriber_count_report']
  auditor_notes varchar [note: 'Internal notes and observations recorded by the auditor or verification team during the subscriber count review process. | Column auditor_notes (STRING) in distribution.subscriber_count_report']
  carriage_fee_per_subscriber decimal(10,4) [note: 'Contractual per-subscriber carriage fee rate applicable to this reporting period, used to calculate total carriage fee invoice amount. | Column carriage_fee_per_subscriber (DECIMAL(10,4)) in distribution.subscriber_count_report']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.subscriber_count_report']
  created_timestamp timestamp [note: 'Date and time when this subscriber count report record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.subscriber_count_report']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the carriage fee amount (e.g., USD, EUR, GBP). | Column currency_code (STRING) in distribution.subscriber_count_report']
  dispute_flag boolean [note: 'Indicator of whether the distribution partner has formally disputed the verified subscriber count or variance findings. | Column dispute_flag (BOOLEAN) in distribution.subscriber_count_report']
  dispute_reason varchar [note: 'Explanation provided by the distribution partner for disputing the verified subscriber count or audit findings. | Column dispute_reason (STRING) in distribution.subscriber_count_report']
  dispute_resolution_status varchar [note: 'Current status of any dispute resolution process related to this subscriber count report. | Column dispute_resolution_status (STRING) in distribution.subscriber_count_report']
  invoice_generated_flag boolean [note: 'Indicator of whether a carriage fee invoice has been generated based on this subscriber count report. | Column invoice_generated_flag (BOOLEAN) in distribution.subscriber_count_report']
  invoice_reference varchar [note: 'Reference identifier to the carriage fee invoice generated from this subscriber count report. | Column invoice_reference (STRING) in distribution.subscriber_count_report']
  modified_timestamp timestamp [note: 'Date and time when this subscriber count report record was last modified or updated. | Column modified_timestamp (TIMESTAMP) in distribution.subscriber_count_report']
  notes varchar [note: 'General notes and comments related to this subscriber count report, capturing additional context or special circumstances. | Column notes (STRING) in distribution.subscriber_count_report']
  report_number varchar [note: 'Externally-known unique identifier for this subscriber count report, used for contractual reference and audit tracking. | Column report_number (STRING) in distribution.subscriber_count_report']
  report_status varchar [note: 'Current lifecycle status of the subscriber count report in the end-to-end reporting and reconciliation process. | Column report_status (STRING) in distribution.subscriber_count_report']
  reported_subscriber_count varchar [note: 'Total number of subscribers reported by the distribution partner for the specified channel and period, as submitted by the MVPD or vMVPD. | Column reported_subscriber_count (BIGINT) in distribution.subscriber_count_report']
  reporting_period_end_date date [note: 'Last day of the period covered by this subscriber count report. | Column reporting_period_end_date (DATE) in distribution.subscriber_count_report']
  reporting_period_start_date date [note: 'First day of the period covered by this subscriber count report. | Column reporting_period_start_date (DATE) in distribution.subscriber_count_report']
  reporting_period_type varchar [note: 'Frequency of the subscriber count reporting period as defined in the carriage agreement (monthly, quarterly, annual, or custom). | Column reporting_period_type (STRING) in distribution.subscriber_count_report']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.subscriber_count_report']
  submission_date date [note: 'Date on which the distribution partner submitted the subscriber count report to the broadcaster. | Column submission_date (DATE) in distribution.subscriber_count_report']
  submission_timestamp timestamp [note: 'Precise date and time when the subscriber count report was received by the broadcaster\'s system. | Column submission_timestamp (TIMESTAMP) in distribution.subscriber_count_report']
  third_party_auditor varchar [note: 'Name of the external audit firm or third-party verification service engaged to validate subscriber counts, if applicable. | Column third_party_auditor (STRING) in distribution.subscriber_count_report']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.subscriber_count_report']
  variance_count varchar [note: 'Numerical difference between reported subscriber count and verified subscriber count (verified minus reported). | Column variance_count (BIGINT) in distribution.subscriber_count_report']
  variance_explanation varchar [note: 'Detailed explanation provided by the distribution partner or internal audit team describing the reason for any variance between reported and verified counts. | Column variance_explanation (STRING) in distribution.subscriber_count_report']
  variance_flag boolean [note: 'Indicator of whether a material variance exists between reported and verified subscriber counts, triggering additional review or dispute resolution. | Column variance_flag (BOOLEAN) in distribution.subscriber_count_report']
  variance_percentage decimal(5,2) [note: 'Percentage variance between reported and verified subscriber counts, calculated as (variance_count / reported_subscriber_count) * 100. | Column variance_percentage (DECIMAL(5,2)) in distribution.subscriber_count_report']
  verification_date date [note: 'Date on which the internal verification and audit process was completed for this subscriber count report. | Column verification_date (DATE) in distribution.subscriber_count_report']
  verification_method varchar [note: 'Method used to verify the reported subscriber count (automated system check, manual review, third-party audit, statistical sampling, or full audit). | Column verification_method (STRING) in distribution.subscriber_count_report']
  verified_subscriber_count varchar [note: 'Subscriber count after internal verification and audit processes, used as the basis for carriage fee calculation. | Column verified_subscriber_count (BIGINT) in distribution.subscriber_count_report']

  Note: 'Transactional record capturing periodic subscriber count certifications submitted by MVPD and vMVPD partners, used as the basis for per-subscriber carriage fee calculation. Captures reporting period (monthly/quarterly), distribution partner, channel or channel tier, reported subscriber count, verified subscriber count, variance flag, variance explanation, submission date, verification date, approval status, and auditor notes. Feeds carriage_fee_invoice generation and revenue assurance reconciliation. Subject to contractual audit rights. Distinct from subscriber master data owned by the subscriber domain. | Unity Catalog table: media_broadcasting_ecm.distribution.subscriber_count_report'
}

Table distribution.channel_lineup {
  channel_lineup_id varchar [pk, note: 'Primary key for channel_lineup | Column channel_lineup_id (BIGINT) in distribution.channel_lineup']
  carriage_agreement_id varchar [note: 'Foreign key linking to distribution.carriage_agreement. Business justification: Channel lineups are defined by carriage agreements. Lineup terms and channel positioning come from agreements. Removes contract_reference_number STRING (derivable from carriage_agreement.agreement_num | Column carriage_agreement_id (BIGINT) in distribution.channel_lineup']
  channel_id varchar [note: 'Reference to the specific broadcast or streaming channel included in this lineup. | Column channel_id (BIGINT) in scheduling.channel_lineup']
  distribution_partner_id varchar [note: 'Foreign key linking to distribution.distribution_partner. Business justification: Channel lineups belong to distribution partners. channel_lineup.partner_id should FK to distribution_partner. Removes partner_id BIGINT (replaced by distribution_partner_id FK). | Column distribution_partner_id (BIGINT) in distribution.channel_lineup']
  market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: Channel lineups vary by DMA due to must-carry rules, local station carriage, blackout restrictions, and market-specific programming rights. Required for FCC compliance and retransmission consent enfor | Column market_coverage_id (BIGINT) in audience.channel_lineup']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.channel_lineup']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.channel_lineup']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.channel_lineup']
  audio_description_available boolean [note: 'Indicates whether audio description (descriptive video service) is available for visually impaired subscribers. | Column audio_description_available (BOOLEAN) in distribution.channel_lineup']
  blackout_region_codes varchar [note: 'Comma-separated list of geographic region codes where blackout restrictions apply for this channel (e.g., DMA codes, postal codes, state codes). | Column blackout_region_codes (STRING) in distribution.channel_lineup']
  blackout_rules_applicable boolean [note: 'Indicates whether geographic broadcast restriction (blackout) rules apply to this channel within the lineup. | Column blackout_rules_applicable (BOOLEAN) in distribution.channel_lineup']
  carriage_fee_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the carriage fee (e.g., USD, EUR, GBP). | Column carriage_fee_currency_code (STRING) in distribution.channel_lineup']
  carriage_fee_per_subscriber decimal(12,4) [note: 'Monthly fee paid by the MVPD/vMVPD to the content provider per subscriber who has access to this channel within the lineup. Used for carriage fee calculation and revenue assurance. | Column carriage_fee_per_subscriber (DECIMAL(12,4)) in distribution.channel_lineup']
  carriage_type varchar [note: 'Legal basis for the channel\'s inclusion in the lineup: must-carry (mandatory FCC requirement), retransmission consent (negotiated rebroadcast authorization), or negotiated carriage agreement. | Column carriage_type (STRING) in distribution.channel_lineup']
  channel_display_name varchar [note: 'The branded name of the channel as displayed to subscribers in the EPG (Electronic Program Guide) for this specific lineup. | Column channel_display_name (STRING) in distribution.channel_lineup']
  channel_position_number varchar [note: 'Logical channel number or position assigned to the channel within this lineup (e.g., channel 101, channel 502). Used for Electronic Program Guide (EPG) display and subscriber navigation. | Column channel_position_number (INT) in distribution.channel_lineup']
  closed_caption_required boolean [note: 'Indicates whether closed captioning is mandated for this channel per FCC accessibility requirements. | Column closed_caption_required (BOOLEAN) in distribution.channel_lineup']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.channel_lineup']
  created_timestamp timestamp [note: 'Timestamp when this channel lineup record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.channel_lineup']
  dma_code varchar [note: 'Nielsen Designated Market Area code identifying the specific television market where this lineup is offered (e.g., \'501\' for New York). | Column dma_code (STRING) in distribution.channel_lineup']
  dvr_enabled boolean [note: 'Indicates whether subscribers can record content from this channel using DVR functionality. | Column dvr_enabled (BOOLEAN) in distribution.channel_lineup']
  effective_end_date date [note: 'Date when this channel lineup configuration expires or is replaced. Null indicates an open-ended active lineup. | Column effective_end_date (DATE) in distribution.channel_lineup']
  effective_start_date date [note: 'Date when this channel lineup configuration becomes active and available to subscribers. | Column effective_start_date (DATE) in distribution.channel_lineup']
  geographic_restriction_rules varchar [note: 'Detailed description of geographic restrictions, including allowed and blocked regions, for subscriber entitlement validation. | Column geographic_restriction_rules (STRING) in distribution.channel_lineup']
  hd_available boolean [note: 'Indicates whether the channel is available in high definition (HD) format within this lineup. | Column hd_available (BOOLEAN) in distribution.channel_lineup']
  last_modified_timestamp timestamp [note: 'Timestamp when this channel lineup record was most recently updated. | Column last_modified_timestamp (TIMESTAMP) in distribution.channel_lineup']
  lineup_code varchar [note: 'Short alphanumeric code uniquely identifying the lineup within the partner\'s system (e.g., \'BASIC-01\', \'PREM-SPORTS\'). | Column lineup_code (STRING) in distribution.channel_lineup']
  lineup_name varchar [note: 'Business name of the channel lineup or package (e.g., \'Basic Cable\', \'Premium Sports Tier\', \'Expanded Basic\'). | Column lineup_name (STRING) in distribution.channel_lineup']
  lineup_status varchar [note: 'Current operational status of the channel lineup configuration. | Column lineup_status (STRING) in distribution.channel_lineup']
  market_applicability varchar [note: 'Geographic scope of the lineup: national (available across all markets), regional (multi-state region), local (single market), or DMA-specific (Designated Market Area). | Column market_applicability (STRING) in distribution.channel_lineup']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this channel lineup record. | Column modified_by_user (STRING) in distribution.channel_lineup']
  notes varchar [note: 'Free-text field for additional operational notes, special instructions, or business context related to this channel lineup configuration. | Column notes (STRING) in distribution.channel_lineup']
  parental_control_rating varchar [note: 'Content rating classification for parental control enforcement at the channel level within the lineup. [ENUM-REF-CANDIDATE: TV-Y|TV-Y7|TV-G|TV-PG|TV-14|TV-MA|not_rated — 7 candidates stripped; promote to reference product] | Column parental_control_rating (STRING) in distribution.channel_lineup']
  priority_rank varchar [note: 'Relative priority or importance ranking of this channel within the lineup, used for EPG display ordering and promotional emphasis. | Column priority_rank (INT) in distribution.channel_lineup']
  promotional_end_date date [note: 'Date when the promotional offering for this channel expires, after which standard pricing or availability rules apply. | Column promotional_end_date (DATE) in distribution.channel_lineup']
  promotional_flag boolean [note: 'Indicates whether this channel is being offered as part of a promotional campaign or limited-time offer within the lineup. | Column promotional_flag (BOOLEAN) in distribution.channel_lineup']
  service_tier varchar [note: 'Service level classification indicating the quality or feature set of the lineup (e.g., standard definition, high definition, 4K). | Column service_tier (STRING) in distribution.channel_lineup']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.channel_lineup']
  subscriber_count_estimate varchar [note: 'Estimated number of subscribers who have access to this channel through this lineup. Used for carriage fee calculation and audience reach estimation. | Column subscriber_count_estimate (INT) in distribution.channel_lineup']
  tier_type varchar [note: 'Classification of the channel tier or package type offered to subscribers. [ENUM-REF-CANDIDATE: basic|expanded_basic|premium|sports|news|entertainment|international|a_la_carte — 8 candidates stripped; promote to reference product] | Column tier_type (STRING) in distribution.channel_lineup']
  uhd_4k_available boolean [note: 'Indicates whether the channel is available in 4K ultra high definition format within this lineup. | Column uhd_4k_available (BOOLEAN) in distribution.channel_lineup']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.channel_lineup']
  vod_enabled boolean [note: 'Indicates whether Video On Demand (VOD) content is available for this channel within the lineup. | Column vod_enabled (BOOLEAN) in distribution.channel_lineup']

  Note: 'Master record defining the channel package or tier lineup offered by an MVPD or vMVPD partner, specifying which delivery channels are included in each subscriber tier (basic, expanded basic, premium, sports, etc.). Captures partner, tier name, tier type, included channels, channel position number, effective date, and market applicability. Used for carriage fee calculation, blackout enforcement, and subscriber entitlement validation. | Unity Catalog table: media_broadcasting_ecm.distribution.channel_lineup'
}

Table distribution.playout_feed {
  playout_feed_id varchar [pk, note: 'Unique identifier for the playout feed. Primary key for the playout feed entity representing a discrete output stream from the playout automation system. | Column playout_feed_id (BIGINT) in distribution.playout_feed']
  abr_profile_id varchar [note: 'Foreign key linking to distribution.abr_profile. Business justification: Playout feeds use ABR profiles for encoding. Each feed has a specific ABR profile for multi-bitrate delivery. Essential for encoding configuration. | Column abr_profile_id (BIGINT) in distribution.playout_feed']
  broadcast_facility_id varchar [note: 'Foreign key linking to technology.broadcast_facility. Business justification: Playout feeds originate from facilities housing playout automation. Required for playout system maintenance scheduling and facility failover coordination. | Column broadcast_facility_id (BIGINT) in technology.playout_feed']
  channel_id varchar [note: 'Reference to the broadcast channel associated with this playout feed. Links the feed to its delivery channel configuration. | Column channel_id (BIGINT) in scheduling.playout_feed']
  drm_policy_id varchar [note: 'Foreign key linking to distribution.drm_policy. Business justification: Playout feeds enforce DRM policies. Each feed has DRM requirements for content protection. Removes encryption_enabled BOOLEAN and encryption_method STRING (derivable from drm_policy). | Column drm_policy_id (BIGINT) in distribution.playout_feed']
  encoder_config_id varchar [note: 'Foreign key linking to technology.encoder_config. Business justification: Playout feeds are encoded by encoder configurations. Required for playout signal chain tracking and encoder assignment management. | Column encoder_config_id (BIGINT) in technology.playout_feed']
  failover_feed_id varchar [note: 'Reference to the backup playout feed that will take over in case of failure of this primary feed, enabling high availability and business continuity. | Column failover_feed_id (BIGINT) in distribution.playout_feed']
  playout_engineer_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Playout feeds are broadcast operations infrastructure requiring engineering ownership for failover testing, graphics overlay management, SCTE-35 configuration, and automation system integration. Essen | Column playout_engineer_employee_id (BIGINT) in workforce.playout_feed']
  signal_route_id varchar [note: 'Foreign key linking to distribution.signal_route. Business justification: Playout feeds are routed via signal routes. Each feed uses a signal route for distribution. Essential for feed routing and failover management. | Column signal_route_id (BIGINT) in distribution.playout_feed']
  streaming_endpoint_id varchar [note: 'Foreign key linking to distribution.streaming_endpoint. Business justification: Playout feeds output to streaming endpoints. Each feed targets a specific endpoint for distribution. Removes output_destination_url STRING (derivable from streaming_endpoint.endpoint_url). | Column streaming_endpoint_id (BIGINT) in distribution.playout_feed']
  transmission_equipment_id varchar [note: 'Foreign key linking to technology.transmission_equipment. Business justification: Playout feeds are generated by specific transmission equipment. Required for equipment lifecycle management and redundancy planning. | Column transmission_equipment_id (BIGINT) in technology.playout_feed']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.playout_feed']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.playout_feed']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.playout_feed']
  activated_timestamp timestamp [note: 'Timestamp when the playout feed was activated and began operational broadcasting, marking the start of live service. | Column activated_timestamp (TIMESTAMP) in distribution.playout_feed']
  aspect_ratio varchar [note: 'Video aspect ratio for the playout feed output: 4:3 for standard definition, 16:9 for widescreen HD/UHD, or 21:9 for ultra-widescreen cinema formats. | Column aspect_ratio (NUMERIC) in distribution.playout_feed']
  audio_bitrate_kbps varchar [note: 'Target audio bitrate in kilobits per second (kbps) for the playout feed audio output, determining audio quality and bandwidth consumption. | Column audio_bitrate_kbps (INT) in distribution.playout_feed']
  audio_channel_config varchar [note: 'Audio channel layout configuration for the playout feed: mono, stereo, 5.1 surround, 7.1 surround, or Dolby Atmos immersive audio. | Column audio_channel_config (STRING) in distribution.playout_feed']
  audio_codec varchar [note: 'Audio compression codec used for encoding the playout feed audio: Advanced Audio Coding (AAC), Dolby Digital (AC-3), Dolby Digital Plus (E-AC-3), MPEG-1 Layer II, or Opus. | Column audio_codec (STRING) in distribution.playout_feed']
  automation_mode varchar [note: 'Level of automation for playout operations: fully automated with no operator intervention, semi-automated requiring operator approval for certain events, or manual requiring operator control for all playout actions. | Column automation_mode (STRING) in distribution.playout_feed']
  branding_profile varchar [note: 'Name or identifier of the branding profile applied to this playout feed, controlling channel logos, watermarks, and visual identity elements. | Column branding_profile (STRING) in distribution.playout_feed']
  closed_caption_enabled boolean [note: 'Indicates whether closed captioning (CEA-608, CEA-708) is enabled and embedded in the playout feed output for accessibility compliance. | Column closed_caption_enabled (BOOLEAN) in distribution.playout_feed']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.playout_feed']
  created_timestamp timestamp [note: 'Timestamp when the playout feed record was first created in the system, capturing the initial data entry event for audit and tracking purposes. | Column created_timestamp (TIMESTAMP) in distribution.playout_feed']
  deactivated_timestamp timestamp [note: 'Timestamp when the playout feed was deactivated and ceased broadcasting operations, marking the end of service or transition to offline status. | Column deactivated_timestamp (TIMESTAMP) in distribution.playout_feed']
  failover_trigger_mode varchar [note: 'Method by which failover to the backup feed is initiated: automatic based on health monitoring, manual operator intervention, or scheduled for planned maintenance. | Column failover_trigger_mode (STRING) in distribution.playout_feed']
  feed_code varchar [note: 'Unique business identifier code for the playout feed used in scheduling systems, traffic systems, and operational workflows. | Column feed_code (STRING) in distribution.playout_feed']
  feed_name varchar [note: 'Human-readable name of the playout feed used for identification and operational reference within the playout automation system. | Column feed_name (STRING) in distribution.playout_feed']
  feed_type varchar [note: 'Classification of the playout feed indicating its operational role: primary broadcast feed, backup feed for failover, redundant feed for high availability, test feed for validation, or preview feed for quality control. | Column feed_type (STRING) in distribution.playout_feed']
  frame_rate decimal(18,2) [note: 'Video frame rate in frames per second (fps) for the playout feed output, following broadcast standards for different regions and formats. | Column frame_rate (DECIMAL(18,2)) in distribution.playout_feed']
  graphics_overlay_enabled boolean [note: 'Indicates whether real-time graphics overlay (bugs, tickers, lower thirds, branding elements) is enabled for this playout feed. | Column graphics_overlay_enabled (BOOLEAN) in distribution.playout_feed']
  graphics_template_code varchar [note: 'Reference to the graphics template configuration used for branding, bugs, and overlay elements on this playout feed. | Column graphics_template_code (STRING) in distribution.playout_feed']
  last_health_check_timestamp timestamp [note: 'Timestamp of the most recent automated health check performed on the playout feed to verify operational status and signal quality. | Column last_health_check_timestamp (TIMESTAMP) in distribution.playout_feed']
  modified_timestamp timestamp [note: 'Timestamp when the playout feed record was last modified, capturing the most recent update event for change tracking and audit compliance. | Column modified_timestamp (TIMESTAMP) in distribution.playout_feed']
  multicast_address varchar [note: 'Multicast IP address used for distributing the playout feed to multiple receivers simultaneously in IP-based broadcast networks. | Column multicast_address (STRING) in distribution.playout_feed']
  operational_status varchar [note: 'Current operational state of the playout feed indicating whether it is actively broadcasting, on standby for failover, offline, under maintenance, experiencing errors, or in testing mode. | Column operational_status (STRING) in distribution.playout_feed']
  output_format varchar [note: 'Physical or network output format of the playout feed: Serial Digital Interface (SDI) for baseband video, Internet Protocol (IP) for network streaming, Asynchronous Serial Interface (ASI) for MPEG transport streams, Secure Reliable Transport (SRT), Reliable Internet Stream Transport (RIST), or Network Device Interface (NDI). | Column output_format (STRING) in distribution.playout_feed']
  playout_server_code varchar [note: 'Identifier of the physical or virtual playout server assigned to generate this feed. Links the feed to the automation infrastructure. | Column playout_server_code (STRING) in distribution.playout_feed']
  port_number varchar [note: 'Network port number used for the playout feed output connection in IP-based delivery configurations. | Column port_number (INT) in distribution.playout_feed']
  provisioned_date date [note: 'Date when the playout feed was initially provisioned and configured in the playout automation system. | Column provisioned_date (DATE) in distribution.playout_feed']
  redundancy_mode varchar [note: 'Redundancy configuration for the playout feed: none (single feed), hot standby (backup ready to take over), active-active (both feeds broadcasting simultaneously), or N+1 (shared backup for multiple feeds). | Column redundancy_mode (STRING) in distribution.playout_feed']
  scte35_enabled boolean [note: 'Indicates whether SCTE-35 digital program insertion cue messages are enabled in the playout feed for Dynamic Ad Insertion (DAI) and program segmentation. | Column scte35_enabled (BOOLEAN) in distribution.playout_feed']
  service_identifier varchar [note: 'DVB Service ID or ATSC program number identifying the service within the transport stream for Electronic Program Guide (EPG) and receiver tuning. | Column service_identifier (INT) in distribution.playout_feed']
  sla_tier varchar [note: 'Service level tier assigned to this playout feed defining uptime guarantees, response times, and support priority: platinum (highest), gold, silver, bronze, or standard. | Column sla_tier (STRING) in distribution.playout_feed']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.playout_feed']
  subtitle_format varchar [note: 'Subtitle or closed caption format embedded in the playout feed: DVB subtitles, Teletext, CEA-608, CEA-708, Timed Text Markup Language (TTML), or Web Video Text Tracks (WebVTT). | Column subtitle_format (STRING) in distribution.playout_feed']
  transport_stream_identifier varchar [note: 'MPEG Transport Stream ID (TSID) assigned to this playout feed for multiplexing and demultiplexing in broadcast distribution networks. | Column transport_stream_identifier (INT) in distribution.playout_feed']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.playout_feed']
  uptime_target_percent decimal(5,2) [note: 'Target uptime percentage for the playout feed as defined in the Service Level Agreement (SLA), typically 99.9% or higher for mission-critical broadcast feeds. | Column uptime_target_percent (DECIMAL(5,2)) in distribution.playout_feed']
  video_bitrate_mbps decimal(8,3) [note: 'Target video bitrate in megabits per second (Mbps) for the playout feed output, determining video quality and bandwidth consumption. | Column video_bitrate_mbps (DECIMAL(8,3)) in distribution.playout_feed']
  video_codec varchar [note: 'Video compression codec used for encoding the playout feed output: H.264 (AVC), H.265 (HEVC), MPEG-2, AV1, or VP9. | Column video_codec (STRING) in distribution.playout_feed']
  video_resolution varchar [note: 'Output video resolution class: Standard Definition (SD), High Definition (HD), Full High Definition (FHD), Ultra High Definition (UHD), 4K, or 8K. | Column video_resolution (STRING) in distribution.playout_feed']

  Note: 'Master record for each discrete playout feed managed through Ericsson MediaFirst, representing a configured output stream from the playout automation system. Captures feed name, associated delivery channel, playout server assignment, output format (SDI, IP, ASI), transport stream parameters, graphics/branding overlay configuration, automation mode (fully automated, semi-automated, manual), redundancy configuration, and current operational status. The operational anchor linking scheduling to physical signal delivery. | Unity Catalog table: media_broadcasting_ecm.distribution.playout_feed'
}

Table distribution.deal {
  deal_id varchar [pk, note: 'Primary key for deal | Column deal_id (BIGINT) in distribution.deal']
  distribution_partner_id varchar [note: 'Reference to the OTT platform, FAST aggregator, syndication buyer, or international distributor party to this deal. | Column distribution_partner_id (BIGINT) in distribution.deal']
  dsp_id varchar [note: 'FK to demand-side platform']
  exchange_id varchar [note: 'FK to ad exchange']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Distribution deals with partners are governed by underlying content license agreements. Critical for validating distribution rights chain, ensuring revenue share terms align with license obligations,  | Column license_agreement_id (BIGINT) in rights.deal']
  owner_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Distribution deals are high-value contracts requiring business development owner for negotiations, revenue forecasting, MG tracking, and relationship management. Essential for commission tracking, app | Column owner_employee_id (BIGINT) in workforce.deal']
  programmatic_deal_id varchar [note: 'External programmatic deal ID for OpenRTB']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Distribution deals define revenue models (rev share, flat fee, minimum guarantee) that map to specific revenue streams for accounting purposes. Contract setup creates revenue stream mappings for autom | Column revenue_stream_id (BIGINT) in finance.deal']
  source_opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Distribution deals originate from sales opportunities in the deal lifecycle. Tracks opportunity-to-contract conversion for distribution partnerships, platform licensing, and carriage agreements. Essen | Column source_opportunity_id (BIGINT) in sales.deal']
  ssp_id varchar [note: 'FK to supply-side platform']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.deal']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.deal']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.deal']
  auto_renewal_flag boolean [note: 'Indicates whether the deal automatically renews at expiration unless terminated. True = auto-renews; False = requires explicit renewal. | Column auto_renewal_flag (BOOLEAN) in distribution.deal']
  content_scope varchar [note: 'Description of the content assets included in this deal. May reference specific titles, series, libraries, or content categories covered by the agreement. | Column content_scope (STRING) in distribution.deal']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.deal']
  created_timestamp timestamp [note: 'Timestamp when this deal record was first created in the system. | Column created_timestamp (TIMESTAMP) in distribution.deal']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values in this deal (e.g., USD, EUR, GBP). | Column currency_code (STRING) in distribution.deal']
  deal_name varchar [note: 'Human-readable name or title of the distribution deal for identification and reporting purposes. | Column deal_name (STRING) in distribution.deal']
  deal_number varchar [note: 'Externally-known unique business identifier for the distribution deal, used in contracts and communications. | Column deal_number (STRING) in distribution.deal']
  deal_status varchar [note: 'Current lifecycle status of the distribution deal. Tracks progression from initial draft through negotiation, approval, active operation, and eventual closure or renewal. [ENUM-REF-CANDIDATE: draft|negotiation|pending approval|active|suspended|expired|terminated|renewed — 8 candidates stripped; promote to reference product] | Column deal_status (STRING) in distribution.deal']
  deal_type varchar [note: 'Classification of the distribution deal structure. SVOD licensing = Subscription Video On Demand content licensing; AVOD revenue share = Advertising-Supported Video On Demand with revenue sharing; FAST syndication = Free Ad-Supported Streaming Television channel syndication; linear carriage = traditional broadcast carriage; TVOD licensing = Transactional Video On Demand licensing; international distribution = cross-border content distribution agreements. | Column deal_type (STRING) in distribution.deal']
  dispute_resolution_mechanism varchar [note: 'Agreed method for resolving disputes arising from this deal. | Column dispute_resolution_mechanism (STRING) in distribution.deal']
  drm_requirements varchar [note: 'Specification of DRM systems and protection levels required for content delivery under this deal (e.g., Widevine L1, PlayReady SL3000, FairPlay). | Column drm_requirements (STRING) in distribution.deal']
  effective_date date [note: 'Date when the distribution deal becomes active and content distribution rights commence. | Column effective_date (DATE) in distribution.deal']
  exclusivity_flag boolean [note: 'Indicates whether this deal grants exclusive distribution rights to the partner within the specified territory and platform type. True = exclusive; False = non-exclusive. | Column exclusivity_flag (BOOLEAN) in distribution.deal']
  exclusivity_window_days varchar [note: 'Duration in days of the exclusivity period or holdback window during which content cannot be distributed through competing channels. | Column exclusivity_window_days (INT) in distribution.deal']
  expiration_date date [note: 'Date when the distribution deal expires and content distribution rights terminate. Nullable for open-ended or perpetual deals. | Column expiration_date (DATE) in distribution.deal']
  flat_fee_amount decimal(15,2) [note: 'Fixed payment amount for flat fee deal structures. Represents total or periodic payment value. | Column flat_fee_amount (DECIMAL(15,2)) in distribution.deal']
  floor_price_cpm decimal(10,4) [note: 'Floor price in CPM for programmatic']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose laws govern the interpretation and enforcement of this deal (e.g., State of California, England and Wales). | Column governing_law_jurisdiction (STRING) in distribution.deal']
  last_amendment_date date [note: 'Date of the most recent amendment or modification to the deal terms. | Column last_amendment_date (DATE) in distribution.deal']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum Guarantee amount paid upfront or over the deal term, recoupable against future revenue share or royalties. | Column minimum_guarantee_amount (DECIMAL(15,2)) in distribution.deal']
  minimum_subscriber_guarantee varchar [note: 'Minimum number of subscribers or active users the distribution partner guarantees for revenue calculation purposes. | Column minimum_subscriber_guarantee (BIGINT) in distribution.deal']
  negotiation_start_date date [note: 'Date when commercial negotiations for this deal commenced. | Column negotiation_start_date (DATE) in distribution.deal']
  notes varchar [note: 'Free-form text field for additional context, special conditions, or internal comments about the deal. | Column notes (STRING) in distribution.deal']
  payment_terms varchar [note: 'Description of payment schedule, frequency, and conditions (e.g., net 30, quarterly in arrears, monthly advance). | Column payment_terms (STRING) in distribution.deal']
  platform_type varchar [note: 'Type of distribution platform. OTT = Over-The-Top streaming; FAST = Free Ad-Supported Streaming Television; MVPD = Multichannel Video Programming Distributor; vMVPD = Virtual MVPD; linear broadcast = traditional broadcast; syndication = content resale; international = cross-border distribution. [ENUM-REF-CANDIDATE: OTT|FAST|MVPD|vMVPD|linear broadcast|syndication|international — 7 candidates stripped; promote to reference product] | Column platform_type (STRING) in distribution.deal']
  programmatic_deal_type varchar [note: 'Programmatic deal type (PMP, PG, open auction)']
  promotional_commitment varchar [note: 'Description of marketing and promotional activities the distribution partner has committed to perform (e.g., homepage placement, email campaigns, social media promotion). | Column promotional_commitment (STRING) in distribution.deal']
  renewal_notice_days varchar [note: 'Number of days advance notice required to exercise or decline renewal option before expiration. | Column renewal_notice_days (INT) in distribution.deal']
  reporting_frequency varchar [note: 'Frequency at which the distribution partner must provide performance and revenue reports. | Column reporting_frequency (STRING) in distribution.deal']
  revenue_model varchar [note: 'Commercial structure defining how revenue is generated and shared. Flat fee = fixed payment; revenue share = percentage of platform revenue; minimum guarantee = MG against future royalties; hybrid = combination of models; cost per stream = per-view payment; cost per subscriber = per-subscriber payment. | Column revenue_model (STRING) in distribution.deal']
  revenue_share_percentage decimal(5,2) [note: 'Percentage of revenue allocated to the content owner under revenue share agreements. Expressed as a percentage (e.g., 65.00 represents 65%). | Column revenue_share_percentage (DECIMAL(5,2)) in distribution.deal']
  signed_date date [note: 'Date when the distribution deal contract was executed by all parties. | Column signed_date (DATE) in distribution.deal']
  sla_tier varchar [note: 'Service level tier defining uptime, performance, and support commitments for content delivery under this deal. | Column sla_tier (STRING) in distribution.deal']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.deal']
  technical_delivery_requirements varchar [note: 'Technical specifications for content delivery including format, resolution, bitrate, codec, and delivery method (e.g., HLS 1080p H.264, DASH 4K HEVC). | Column technical_delivery_requirements (STRING) in distribution.deal']
  term_months varchar [note: 'Duration of the deal term expressed in months. Calculated from effective date to expiration date. | Column term_months (INT) in distribution.deal']
  termination_notice_days varchar [note: 'Number of days advance notice required by either party to terminate the deal prior to natural expiration. | Column termination_notice_days (INT) in distribution.deal']
  territory varchar [note: 'Geographic territory or territories covered by this distribution deal. May be a single country code, multiple countries, or regional designation (e.g., USA, CAN|MEX, EMEA). | Column territory (STRING) in distribution.deal']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.deal']
  updated_timestamp timestamp [note: 'Timestamp when this deal record was last modified in the system. | Column updated_timestamp (TIMESTAMP) in distribution.deal']

  Note: 'Master record for commercial distribution deals negotiated with OTT platforms, FAST aggregators, syndication buyers, and international distributors. Captures deal name, deal type (SVOD licensing, AVOD revenue share, FAST syndication, linear carriage), counterparty, territory, content scope, revenue model (flat fee, revenue share percentage, MG against royalty), deal effective date, expiry date, and deal status. Distinct from carriage_agreement (which is MVPD-specific) — this covers broader OTT and digital distribution commercial arrangements. | Unity Catalog table: media_broadcasting_ecm.distribution.deal'
}

Table distribution.content_delivery_order {
  content_delivery_order_id varchar [pk, note: 'Unique identifier for the content delivery order. Primary key for this transactional record representing a formal order to deliver content assets to distribution partners or platforms. | Column content_delivery_order_id (BIGINT) in distribution.content_delivery_order']
  abr_profile_id varchar [note: 'Reference to the Adaptive Bitrate streaming profile defining the rendition ladder and streaming configuration for OTT delivery. | Column abr_profile_id (BIGINT) in distribution.content_delivery_order']
  asset_version_id varchar [note: 'Foreign key linking to mediaasset.asset_version. Business justification: Delivery orders specify exact rendition (proxy/mezzanine/distribution master) for partner fulfillment. Broadcasters track which version was delivered for audit/quality purposes. Existing content_asset | Column asset_version_id (BIGINT) in mediaasset.content_delivery_order']
  carriage_agreement_id varchar [note: 'Reference to the underlying carriage or distribution agreement that authorizes this content delivery. Links order to contractual obligations. | Column carriage_agreement_id (BIGINT) in distribution.content_delivery_order']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Content delivery operations (transcoding, QC, distribution) incur costs allocated to technology or operations cost centers. Monthly cost allocation for content operations charges cost centers based on | Column cost_center_id (BIGINT) in finance.content_delivery_order']
  distribution_partner_id varchar [note: 'Reference to the distribution partner or platform receiving the content. Identifies the counterparty in this delivery transaction. | Column distribution_partner_id (BIGINT) in distribution.content_delivery_order']
  drm_policy_id varchar [note: 'Reference to the DRM policy governing content protection, encryption, and playback restrictions for this delivery. | Column drm_policy_id (BIGINT) in distribution.content_delivery_order']
  fulfillment_coordinator_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Content delivery orders require operations ownership for prioritization, troubleshooting delivery failures, SLA compliance, and partner communication. Essential for on-call rotations, delivery metrics | Column fulfillment_coordinator_employee_id (BIGINT) in workforce.content_delivery_order']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Delivery orders fulfill content distribution under specific license agreements. Essential for pre-delivery rights compliance verification, ensuring delivery parameters match license terms, and authori | Column license_agreement_id (BIGINT) in rights.content_delivery_order']
  media_asset_id varchar [note: 'Reference to the specific content asset or package being delivered. Links to the master content asset record in the Digital Assets domain. | Column media_asset_id (BIGINT) in mediaasset.content_delivery_order']
  rights_availability_window_id varchar [note: 'Reference to the rights and licensing window that permits this content delivery. Ensures delivery complies with windowing and holdback restrictions. | Column rights_availability_window_id (BIGINT) in rights.content_delivery_order']
  service_invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Content delivery orders for encoding, transcoding, QC, and distribution services are billable to content owners or internal cost centers. Real business process: content services billing, delivery fee  | Column service_invoice_id (BIGINT) in billing.content_delivery_order']
  source_opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Content delivery orders fulfill closed content licensing opportunities. Tracks opportunity-to-fulfillment lifecycle for syndication deals, content licensing agreements, and distribution contracts. Ess | Column source_opportunity_id (BIGINT) in sales.content_delivery_order']
  streaming_endpoint_id varchar [note: 'Reference to the target streaming endpoint or Content Delivery Network (CDN) origin where content will be published. | Column streaming_endpoint_id (BIGINT) in distribution.content_delivery_order']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.content_delivery_order']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.content_delivery_order']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.content_delivery_order']
  actual_delivery_timestamp timestamp [note: 'Timestamp when the content was actually delivered and confirmed received by the distribution partner. Used for SLA performance measurement. | Column actual_delivery_timestamp (TIMESTAMP) in distribution.content_delivery_order']
  approved_by_user varchar [note: 'Username or identifier of the user who approved this delivery order for fulfillment. Tracks authorization and approval workflow. | Column approved_by_user (STRING) in distribution.content_delivery_order']
  approved_timestamp timestamp [note: 'Timestamp when this delivery order was approved for fulfillment. Marks the transition from draft to active status. | Column approved_timestamp (TIMESTAMP) in distribution.content_delivery_order']
  audio_configuration varchar [note: 'Audio channel configuration and format for the delivered content. Defines the immersive audio capabilities and speaker layout. | Column audio_configuration (STRING) in distribution.content_delivery_order']
  audio_languages varchar [note: 'Comma-separated list of ISO 639-2 language codes for audio tracks included in the delivery. Supports multi-language distribution requirements. | Column audio_languages (STRING) in distribution.content_delivery_order']
  closed_captions_included boolean [note: 'Indicates whether closed captions are included in the delivered content. Required for FCC compliance and accessibility standards. | Column closed_captions_included (BOOLEAN) in distribution.content_delivery_order']
  content_duration_seconds varchar [note: 'Total runtime duration of the content asset being delivered, measured in seconds. Used for capacity planning and delivery time estimation. | Column content_duration_seconds (INT) in distribution.content_delivery_order']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.content_delivery_order']
  created_by_user varchar [note: 'Username or identifier of the user who created this delivery order. Provides accountability and audit trail for order origination. | Column created_by_user (STRING) in distribution.content_delivery_order']
  created_timestamp timestamp [note: 'Timestamp when this delivery order record was first created in the system. Audit trail for record lifecycle tracking. | Column created_timestamp (TIMESTAMP) in distribution.content_delivery_order']
  delivery_deadline_timestamp timestamp [note: 'Precise deadline timestamp for content delivery. Used for Service Level Agreement (SLA) compliance tracking and penalty calculations. | Column delivery_deadline_timestamp (TIMESTAMP) in distribution.content_delivery_order']
  delivery_format varchar [note: 'Required content format for delivery. Specifies the container format, codec, and packaging standard expected by the distribution partner. [ENUM-REF-CANDIDATE: hls|mpeg_dash|smooth_streaming|mxf|mp4|prores|imf — 7 candidates stripped; promote to reference product] | Column delivery_format (STRING) in distribution.content_delivery_order']
  delivery_method varchar [note: 'Technical method or protocol used to transfer the content to the distribution partner. Defines the transport mechanism for content delivery. | Column delivery_method (STRING) in distribution.content_delivery_order']
  delivery_notes varchar [note: 'Free-text notes and special instructions for the delivery order. Captures partner-specific requirements, technical considerations, or operational alerts. | Column delivery_notes (STRING) in distribution.content_delivery_order']
  estimated_delivery_duration_minutes varchar [note: 'Estimated time required to complete the content delivery, measured in minutes. Based on file size, bandwidth, and delivery method. | Column estimated_delivery_duration_minutes (INT) in distribution.content_delivery_order']
  failure_reason varchar [note: 'Description of the reason for delivery failure if order status is failed. Used for root cause analysis and process improvement. | Column failure_reason (STRING) in distribution.content_delivery_order']
  file_size_gb decimal(12,3) [note: 'Total file size of the content package being delivered, measured in gigabytes. Used for bandwidth planning and cost estimation. | Column file_size_gb (DECIMAL(12,3)) in distribution.content_delivery_order']
  fulfillment_confirmation_number varchar [note: 'Unique confirmation identifier provided upon successful delivery completion. Used for proof of delivery and reconciliation with distribution partners. | Column fulfillment_confirmation_number (STRING) in distribution.content_delivery_order']
  geographic_restrictions varchar [note: 'Comma-separated list of ISO 3166-1 alpha-3 country codes where content delivery is restricted or permitted. Enforces territorial rights and blackout rules. | Column geographic_restrictions (STRING) in distribution.content_delivery_order']
  hdr_format varchar [note: 'High Dynamic Range format specification for the delivered content. Defines the color space and dynamic range capabilities. | Column hdr_format (STRING) in distribution.content_delivery_order']
  order_date timestamp [note: 'Timestamp when the delivery order was created or placed. Represents the principal business event time for this transaction. | Column order_date (TIMESTAMP) in distribution.content_delivery_order']
  order_number varchar [note: 'Externally-known unique business identifier for this delivery order. Used for tracking, communication, and reconciliation with distribution partners. | Column order_number (STRING) in distribution.content_delivery_order']
  order_status varchar [note: 'Current lifecycle status of the delivery order. Tracks the order through its workflow from creation to fulfillment or cancellation. [ENUM-REF-CANDIDATE: draft|pending|approved|in_progress|delivered|failed|cancelled — 7 candidates stripped; promote to reference product] | Column order_status (STRING) in distribution.content_delivery_order']
  order_type varchar [note: 'Classification of the delivery order type. Indicates the nature and urgency of the content delivery request. | Column order_type (STRING) in distribution.content_delivery_order']
  priority_level varchar [note: 'Business priority assigned to this delivery order. Determines resource allocation and scheduling precedence in the delivery queue. | Column priority_level (STRING) in distribution.content_delivery_order']
  requested_delivery_date date [note: 'Target date by which the content must be delivered to the distribution partner. Drives scheduling and prioritization of delivery tasks. | Column requested_delivery_date (DATE) in distribution.content_delivery_order']
  retry_count varchar [note: 'Number of delivery attempts made for this order. Tracks resilience and reliability of the delivery process. | Column retry_count (INT) in distribution.content_delivery_order']
  sla_tier varchar [note: 'Service level tier assigned to this delivery order. Determines performance targets, priority, and penalty provisions. | Column sla_tier (STRING) in distribution.content_delivery_order']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.content_delivery_order']
  subtitle_languages varchar [note: 'Comma-separated list of ISO 639-2 language codes for subtitle tracks included in the delivery. Supports accessibility and international distribution. | Column subtitle_languages (STRING) in distribution.content_delivery_order']
  target_platform varchar [note: 'Type of distribution platform or channel where the content will be delivered. Determines technical delivery requirements and format specifications. | Column target_platform (STRING) in distribution.content_delivery_order']
  transcode_profile_code varchar [note: 'Reference to the transcode profile specifying encoding parameters, bitrates, resolutions, and quality settings for content preparation. | Column transcode_profile_code (BIGINT) in distribution.content_delivery_order']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.content_delivery_order']
  updated_timestamp timestamp [note: 'Timestamp when this delivery order record was last modified. Tracks the most recent change to any field in the record. | Column updated_timestamp (TIMESTAMP) in distribution.content_delivery_order']
  video_resolution varchar [note: 'Target video resolution for the delivered content. Specifies the quality tier and display format for the distribution platform. | Column video_resolution (STRING) in distribution.content_delivery_order']

  Note: 'Transactional record representing a formal order to deliver a specific content asset or package to a distribution partner or platform by a specified deadline. Captures order type (new release, refresh, replacement, emergency), content asset reference, target distribution platform, required delivery format, transcode profile, DRM policy, delivery deadline, delivery method (CDN push, FTP, Aspera, satellite uplink), order status, and fulfillment confirmation. Operationalizes the distribution deal and window commitments into actionable delivery tasks. | Unity Catalog table: media_broadcasting_ecm.distribution.content_delivery_order'
}

Table distribution.platform_distribution_agreement {
  platform_distribution_agreement_id varchar [pk, note: 'Unique surrogate identifier for each platform distribution agreement record | Column platform_distribution_agreement_id (BIGINT) in distribution.platform_distribution_agreement']
  ott_platform_id varchar [note: 'Foreign key linking to the OTT platform being distributed through this agreement | Column ott_platform_id (BIGINT) in distribution.platform_distribution_agreement']
  partner_id varchar [note: 'Foreign key linking to the distribution partner carrying the platform | Column partner_id (BIGINT) in partner.platform_distribution_agreement']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in distribution.platform_distribution_agreement']
  _source_code varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in distribution.platform_distribution_agreement']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in distribution.platform_distribution_agreement']
  agreement_status varchar [note: 'Current lifecycle status of the distribution agreement. Active = live and operational, Pending = signed but not yet launched, Suspended = temporarily paused, Terminated = ended early, Expired = reached natural end date | Column agreement_status (STRING) in distribution.platform_distribution_agreement']
  auto_renewal_flag boolean [note: 'Indicates whether the distribution agreement automatically renews at the end of the contract term unless either party provides notice | Column auto_renewal_flag (BOOLEAN) in distribution.platform_distribution_agreement']
  carriage_fee_amount decimal(12,2) [note: 'Fixed periodic fee paid to the distribution partner for carrying the platform, independent of subscriber volume. Typically monthly or annual. | Column carriage_fee_amount (DECIMAL(12,2)) in distribution.platform_distribution_agreement']
  carriage_fee_currency varchar [note: 'ISO 4217 three-letter currency code for the carriage fee amount | Column carriage_fee_currency (STRING) in distribution.platform_distribution_agreement']
  contract_end_date date [note: 'The expiration or termination date of the distribution agreement contract. May be null for evergreen agreements. | Column contract_end_date (DATE) in distribution.platform_distribution_agreement']
  contract_start_date date [note: 'The effective start date of the distribution agreement contract between the platform and partner | Column contract_start_date (DATE) in distribution.platform_distribution_agreement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in distribution.platform_distribution_agreement']
  created_timestamp timestamp [note: 'System timestamp when this distribution agreement record was first created in the system | Column created_timestamp (TIMESTAMP) in distribution.platform_distribution_agreement']
  distribution_territories varchar [note: 'Comma-separated list of ISO country codes or geographic regions where this partner is authorized to distribute the platform under this agreement | Column distribution_territories (STRING) in distribution.platform_distribution_agreement']
  exclusivity_end_date date [note: 'End date of the exclusivity window if exclusivity_flag is true | Column exclusivity_end_date (DATE) in distribution.platform_distribution_agreement']
  exclusivity_flag boolean [note: 'Indicates whether this distribution partner has exclusive rights to distribute the platform in specific territories or device categories during the exclusivity window | Column exclusivity_flag (BOOLEAN) in distribution.platform_distribution_agreement']
  exclusivity_start_date date [note: 'Start date of the exclusivity window if exclusivity_flag is true | Column exclusivity_start_date (DATE) in distribution.platform_distribution_agreement']
  minimum_subscriber_commitment varchar [note: 'Minimum number of subscribers the partner commits to deliver or the platform commits to maintain through this distribution channel, if applicable | Column minimum_subscriber_commitment (BIGINT) in distribution.platform_distribution_agreement']
  platform_launch_date date [note: 'The date on which the OTT platform was made available through this specific distribution partner channel. May differ from the platforms overall launch date. | Column platform_launch_date (DATE) in distribution.platform_distribution_agreement']
  revenue_share_percentage decimal(5,2) [note: 'The percentage of subscription or transaction revenue that is shared with the distribution partner under this agreement. Expressed as a percentage (e.g., 15.00 for 15%). | Column revenue_share_percentage (DECIMAL(5,2)) in distribution.platform_distribution_agreement']
  sla_tier varchar [note: 'Service level agreement tier negotiated with this distribution partner, defining uptime commitments, support response times, and technical integration requirements | Column sla_tier (STRING) in distribution.platform_distribution_agreement']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in distribution.platform_distribution_agreement']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in distribution.platform_distribution_agreement']
  updated_timestamp timestamp [note: 'System timestamp when this distribution agreement record was last modified | Column updated_timestamp (TIMESTAMP) in distribution.platform_distribution_agreement']

  Note: 'This association product represents the contractual distribution agreement between an OTT platform and an external partner (app store, device manufacturer, MVPD, aggregator, ISP). It captures platform-partner-specific commercial terms, technical SLA commitments, revenue sharing arrangements, carriage fees, launch coordination, and exclusivity windows. Each record links one OTT platform to one distribution partner with attributes that exist only in the context of this specific distribution relationship.. Existence Justification: In media broadcasting operations, OTT platforms are distributed through multiple partner channels simultaneously (app stores like Apple/Google, device manufacturers like Roku/Samsung, MVPDs, ISPs, aggregators), and each distribution partner carries multiple OTT platforms. The business actively manages platform-partner distribution agreements as distinct contractual entities with partner-specific commercial terms, revenue sharing models, carriage fees, SLA commitments, launch coordination, and exclusivity windows that vary by partner relationship. | Unity Catalog table: media_broadcasting_ecm.distribution.platform_distribution_agreement'
}

