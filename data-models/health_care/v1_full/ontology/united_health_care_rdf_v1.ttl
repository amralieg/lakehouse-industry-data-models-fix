    rdfs:comment 'Indicates whether the specialty drug must be dispensed through a designated specialty pharmacy network rather than retail pharmacies.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
