    rdfs:range xsd:date .

ind:feePaymentMethod rdf:type rdf:Property ;
    rdfs:label 'Fee Payment Method' ;
    rdfs:comment 'Method used to pay the filing fee (e.g., check, wire transfer, credit card, ACH).' ;
