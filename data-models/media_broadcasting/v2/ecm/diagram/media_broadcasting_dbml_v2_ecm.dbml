  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Deals are evaluated against profit center P&L targets for strategic prioritization, EBITDA impact analysis, and segment performance reporting. Critical for content investment ROI tracking and business | Column profit_center_id (BIGINT) in finance.deal_negotiation']
  resulting_acquisition_deal_id varchar [note: 'Foreign key linking to partner.acquisition_deal. Business justification: deal_negotiation tracks the negotiation lifecycle. When negotiation completes successfully, it results in an executed deal. New FK: resulting_acquisition_deal_id → acquisition_deal.acquisition_deal_id | Column resulting_acquisition_deal_id (BIGINT) in partner.deal_negotiation']
  resulting_affiliate_agreement_id varchar [note: 'Foreign key linking to partner.affiliate_agreement. Business justification: deal_negotiation can result in affiliate_agreement. New FK: resulting_affiliate_agreement_id → affiliate_agreement.affiliate_agreement_id. Nullable (populated only when negotiation results in affiliat | Column resulting_affiliate_agreement_id (BIGINT) in partner.deal_negotiation']
  resulting_coproduction_agreement_id varchar [note: 'Foreign key linking to partner.coproduction_agreement. Business justification: deal_negotiation can result in coproduction_agreement. New FK: resulting_coproduction_agreement_id → coproduction_agreement.coproduction_agreement_id. Nullable (populated only when negotiation results | Column resulting_coproduction_agreement_id (BIGINT) in partner.deal_negotiation']
  resulting_distribution_agreement_id varchar [note: 'Foreign key linking to partner.distribution_agreement. Business justification: deal_negotiation can result in distribution_agreement. New FK: resulting_distribution_agreement_id → distribution_agreement.distribution_agreement_id. Nullable (populated only when negotiation results | Column resulting_distribution_agreement_id (BIGINT) in partner.deal_negotiation']
  resulting_syndication_agreement_id varchar [note: 'Foreign key linking to partner.syndication_agreement. Business justification: deal_negotiation can result in syndication_agreement. New FK: resulting_syndication_agreement_id → syndication_agreement.syndication_agreement_id. Nullable (populated only when negotiation results in  | Column resulting_syndication_agreement_id (BIGINT) in partner.deal_negotiation']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Deal negotiations often reference specific sweeps periods for performance guarantees and pricing (e.g., \'guaranteed 5.0 rating in May sweeps\'). Critical for upfront deal structuring and performance-ba | Column sweeps_period_id (BIGINT) in audience.deal_negotiation']
  target_genre_id varchar [note: 'Foreign key linking to content.genre. Business justification: Deal negotiations target specific content genres for portfolio strategy. Pipeline forecasting by genre, content gap analysis, competitive positioning assessment, and strategic acquisition planning req | Column target_genre_id (BIGINT) in content.deal_negotiation']
  tertiary_deal_legal_reviewer_employee_id varchar [note: 'Reference to the legal counsel or attorney assigned to review this deal negotiation. | Column tertiary_deal_legal_reviewer_employee_id (BIGINT) in workforce.deal_negotiation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.deal_negotiation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.deal_negotiation']
  actual_close_date date [note: 'Actual date on which the deal was finalized and executed. Null if deal is still in negotiation or was not closed. | Column actual_close_date (DATE) in partner.deal_negotiation']
  agreed_deal_value decimal(18,2) [note: 'Final agreed total monetary value of the deal after negotiation, in the deal currency. Null until deal is finalized. | Column agreed_deal_value (DECIMAL(18,2)) in partner.deal_negotiation']
  approval_chain varchar [note: 'Comma-separated list of approval roles or levels required for this deal (e.g., Business Unit Head, Legal, CFO, CEO, Board) based on deal value and risk. | Column approval_chain (STRING) in partner.deal_negotiation']
  approval_conditions varchar [note: 'Specific conditions or requirements that must be met before final approval can be granted (e.g., legal clearance, budget confirmation, board ratification). | Column approval_conditions (STRING) in partner.deal_negotiation']
  business_unit varchar [note: 'The business unit or division sponsoring this deal negotiation (e.g., Linear Broadcasting, Streaming, News, Sports). | Column business_unit (STRING) in partner.deal_negotiation']
  contract_effective_date date [note: 'Date on which the finalized contract becomes legally effective and binding on the parties. | Column contract_effective_date (DATE) in partner.deal_negotiation']
  contract_expiration_date date [note: 'Date on which the contract term ends and rights revert or require renewal. | Column contract_expiration_date (DATE) in partner.deal_negotiation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.deal_negotiation']
  created_timestamp timestamp [note: 'Timestamp when this deal negotiation record was first created in the system. | Column created_timestamp (TIMESTAMP) in partner.deal_negotiation']
  deal_currency varchar [note: 'Three-letter ISO 4217 currency code for all monetary values in this deal negotiation. | Column deal_currency (STRING) in partner.deal_negotiation']
  deal_name varchar [note: 'Human-readable name or title for the deal negotiation, typically including partner name and content description. | Column deal_name (STRING) in partner.deal_negotiation']
  deal_number varchar [note: 'Externally-visible unique business identifier for the deal negotiation, used in communications and contract references. | Column deal_number (STRING) in partner.deal_negotiation']
  deal_type varchar [note: 'Classification of the deal negotiation by business purpose: content acquisition, licensing, distribution, co-production, syndication, or carriage agreement. | Column deal_type (STRING) in partner.deal_negotiation']
  escalation_flag boolean [note: 'Indicates whether this negotiation has been escalated to senior management or executive leadership for resolution (True) or is proceeding normally (False). | Column escalation_flag (BOOLEAN) in partner.deal_negotiation']
  escalation_reason varchar [note: 'Explanation of why the negotiation was escalated, including specific issues requiring executive intervention. | Column escalation_reason (STRING) in partner.deal_negotiation']
  exclusivity_flag boolean [note: 'Indicates whether the deal includes exclusive rights (True) or non-exclusive rights (False). | Column exclusivity_flag (BOOLEAN) in partner.deal_negotiation']
  key_open_issues varchar [note: 'Summary of the primary unresolved issues or sticking points in the negotiation that require resolution before deal closure. | Column key_open_issues (STRING) in partner.deal_negotiation']
  last_modified_timestamp timestamp [note: 'Timestamp when this deal negotiation record was most recently updated. | Column last_modified_timestamp (TIMESTAMP) in partner.deal_negotiation']
  legal_review_status varchar [note: 'Current status of the legal departments review of the deal terms and contract language. | Column legal_review_status (STRING) in partner.deal_negotiation']
  negotiation_stage varchar [note: 'Current stage in the deal negotiation workflow lifecycle, from initial term sheet through final execution or closure. [ENUM-REF-CANDIDATE: term_sheet|initial_proposal|counter_offer|redline_review|legal_review|business_approval|executive_approval|board_approval|final_execution|closed_won|closed_lost — 11 candidates stripped; promote to reference product] | Column negotiation_stage (STRING) in partner.deal_negotiation']
  negotiation_start_date date [note: 'Date on which formal negotiation discussions began for this deal. | Column negotiation_start_date (DATE) in partner.deal_negotiation']
  negotiation_status varchar [note: 'Current operational status of the negotiation indicating whether it is actively progressing, on hold, escalated, or completed. [ENUM-REF-CANDIDATE: active|on_hold|escalated|pending_approval|approved|rejected|cancelled|completed — 8 candidates stripped; promote to reference product] | Column negotiation_status (STRING) in partner.deal_negotiation']
  notes varchar [note: 'Free-text field for capturing additional context, negotiation history, or special considerations relevant to this deal. | Column notes (STRING) in partner.deal_negotiation']
  payment_structure varchar [note: 'Description of the proposed or agreed payment terms and structure (e.g., upfront, milestone-based, revenue share, minimum guarantee plus percentage). | Column payment_structure (STRING) in partner.deal_negotiation']
  proposed_deal_value decimal(18,2) [note: 'Total monetary value proposed by the initiating party for this deal, in the deal currency. | Column proposed_deal_value (DECIMAL(18,2)) in partner.deal_negotiation']
  redline_version_count varchar [note: 'Number of redlined contract versions exchanged during the negotiation process, indicating negotiation complexity. | Column redline_version_count (INT) in partner.deal_negotiation']
  rights_duration_years varchar [note: 'Duration in years for which content rights are being negotiated or agreed. | Column rights_duration_years (INT) in partner.deal_negotiation']
  rights_territory varchar [note: 'Geographic territory or territories for which content rights are being negotiated (e.g., USA, North America, Worldwide excluding China). | Column rights_territory (STRING) in partner.deal_negotiation']
  risk_rating varchar [note: 'Overall risk assessment for this deal negotiation based on financial exposure, legal complexity, and strategic importance. | Column risk_rating (STRING) in partner.deal_negotiation']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.deal_negotiation']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.deal_negotiation']
  sox_control_flag boolean [note: 'Indicates whether this deal negotiation is subject to SOX-compliant authorization controls due to materiality thresholds (True) or not (False). | Column sox_control_flag (BOOLEAN) in partner.deal_negotiation']
  target_close_date date [note: 'Target date by which the parties aim to finalize and execute the deal agreement. | Column target_close_date (DATE) in partner.deal_negotiation']
  term_sheet_date date [note: 'Date on which the initial term sheet was presented or agreed upon by the parties. | Column term_sheet_date (DATE) in partner.deal_negotiation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.deal_negotiation']
  windowing_strategy varchar [note: 'Description of the sequential release strategy and holdback periods being negotiated (e.g., theatrical window, SVOD window, linear broadcast window). | Column windowing_strategy (STRING) in partner.deal_negotiation']

  Note: 'Tracks the full deal workflow lifecycle from initial term sheet through counter-offers, redlines, legal review, internal approval routing, and final execution. Captures negotiation stage, assigned negotiator, key open issues, proposed vs. agreed terms, escalation flags, approval chain (business unit, legal, CFO, board), approval conditions, and target close date. Supports SOX-compliant deal authorization controls and integrates with Salesforce Media Cloud opportunity-to-contract workflows. | Unity Catalog table: media_broadcasting_ecm.partner.deal_negotiation'
}

Table partner.deal_amendment {
  deal_amendment_id varchar [pk, note: 'Unique identifier for the deal amendment record. Primary key. | Column deal_amendment_id (BIGINT) in partner.deal_amendment']
  distribution_agreement_id varchar [note: 'Reference to the parent partner agreement being amended. Links to the original acquisition deal, distribution agreement, syndication agreement, or co-production arrangement. | Column distribution_agreement_id (BIGINT) in partner.deal_amendment']
  initiated_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Contract amendments require structured tracking of internal initiator for audit trail, approval workflow routing, and accountability. Replaces text field initiator_contact_name with proper FK for work | Column initiated_by_employee_id (BIGINT) in workforce.deal_amendment']
  superseded_by_amendment_deal_amendment_id varchar [note: 'Reference to a subsequent amendment that replaces or supersedes this amendment. Null if this amendment is still current. | Column superseded_by_amendment_deal_amendment_id (BIGINT) in partner.deal_amendment']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.deal_amendment']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.deal_amendment']
  amendment_number varchar [note: 'Business identifier for the amendment, typically following a sequential or hierarchical numbering scheme (e.g., AMD-001, AMD-002). Used for external reference and tracking. | Column amendment_number (STRING) in partner.deal_amendment']
  amendment_status varchar [note: 'Current lifecycle state of the amendment: draft (in preparation), pending_approval (submitted for review), approved (authorized but not yet signed), executed (fully signed and in effect), rejected (declined by one or both parties), superseded (replaced by a newer amendment). | Column amendment_status (STRING) in partner.deal_amendment']
  amendment_type varchar [note: 'Classification of the amendment by its primary purpose: financial (pricing, payment terms, royalty rates), territorial (geographic rights expansion or restriction), term_extension (contract duration changes), content_scope (addition or removal of titles/episodes), rights_modification (windowing, exclusivity, sublicensing changes), or technical (delivery specifications, format requirements). | Column amendment_type (STRING) in partner.deal_amendment']
  approval_chain varchar [note: 'Structured or comma-separated list of internal approvers and their approval status (e.g., \'Legal:Approved, Finance:Approved, VP Content:Pending\'). Tracks the internal authorization workflow. | Column approval_chain (STRING) in partner.deal_amendment']
  business_justification varchar [note: 'Narrative explanation of the business rationale for the amendment, including strategic objectives, market conditions, performance issues, or regulatory requirements driving the change. | Column business_justification (STRING) in partner.deal_amendment']
  clauses_modified varchar [note: 'Comma-separated list or structured reference to the specific contract clauses, sections, or articles being amended (e.g., \'Section 3.2 Payment Terms, Section 5.1 Territory, Exhibit A Content Schedule\'). | Column clauses_modified (STRING) in partner.deal_amendment']
  content_scope_change varchar [note: 'Description of changes to the content covered by the agreement, including titles, episodes, seasons, or genres added or removed. Null for amendments that do not modify content scope. | Column content_scope_change (STRING) in partner.deal_amendment']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.deal_amendment']
  created_timestamp timestamp [note: 'Timestamp when the amendment record was first created in the system. Follows format yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column created_timestamp (TIMESTAMP) in partner.deal_amendment']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the financial_impact_amount (e.g., USD, GBP, EUR). Null if no financial impact. | Column currency_code (STRING) in partner.deal_amendment']
  document_reference varchar [note: 'File path, document management system identifier, or URI pointing to the executed amendment document (PDF, DOCX, or scanned image). | Column document_reference (STRING) in partner.deal_amendment']
  effective_date date [note: 'The date on which the amendment terms become binding and enforceable. May be retroactive, concurrent with execution, or future-dated. | Column effective_date (DATE) in partner.deal_amendment']
  execution_date date [note: 'The date on which all required parties signed the amendment, making it legally binding. Distinct from effective_date which governs when terms apply. | Column execution_date (DATE) in partner.deal_amendment']
  expiration_date date [note: 'The date on which the amendment terms cease to apply, if the amendment has a defined term. Null for amendments that permanently modify the agreement. | Column expiration_date (DATE) in partner.deal_amendment']
  financial_impact_amount decimal(18,2) [note: 'The net financial impact of the amendment in the agreement\'s base currency. Positive values indicate increased cost or revenue commitment; negative values indicate savings or reduced revenue. Null for non-financial amendments. | Column financial_impact_amount (DECIMAL(18,2)) in partner.deal_amendment']
  initiated_by varchar [note: 'Indicates which party requested the amendment: internal (broadcaster initiated), partner (studio/syndicator/distributor initiated), or mutual (jointly proposed). | Column initiated_by (STRING) in partner.deal_amendment']
  internal_signatory_name varchar [note: 'Name of the authorized representative from the broadcasting organization who signed the amendment. | Column internal_signatory_name (STRING) in partner.deal_amendment']
  internal_signatory_title varchar [note: 'Job title or role of the internal signatory (e.g., \'SVP Content Acquisition\', \'Chief Business Officer\'). | Column internal_signatory_title (STRING) in partner.deal_amendment']
  legal_review_date date [note: 'Date on which legal review was completed and the amendment was cleared for execution. | Column legal_review_date (DATE) in partner.deal_amendment']
  legal_reviewer_name varchar [note: 'Name of the legal counsel or attorney who reviewed and approved the amendment language for compliance and risk. | Column legal_reviewer_name (STRING) in partner.deal_amendment']
  modified_by varchar [note: 'User identifier or name of the individual who last modified the amendment record. | Column modified_by (STRING) in partner.deal_amendment']
  modified_timestamp timestamp [note: 'Timestamp of the most recent update to the amendment record. Follows format yyyy-MM-ddTHH:mm:ss.SSSXXX. | Column modified_timestamp (TIMESTAMP) in partner.deal_amendment']
  notes varchar [note: 'Free-text field for additional context, special conditions, or internal commentary related to the amendment negotiation, execution, or impact. | Column notes (STRING) in partner.deal_amendment']
  partner_signatory_name varchar [note: 'Name of the authorized representative from the partner organization who signed the amendment. | Column partner_signatory_name (STRING) in partner.deal_amendment']
  partner_signatory_title varchar [note: 'Job title or role of the partner signatory (e.g., \'VP Business Affairs\', \'Director of Distribution\'). | Column partner_signatory_title (STRING) in partner.deal_amendment']
  rights_modification_description varchar [note: 'Narrative description of changes to rights granted, including windowing adjustments, exclusivity modifications, sublicensing permissions, or platform restrictions. Null for amendments that do not modify rights. | Column rights_modification_description (STRING) in partner.deal_amendment']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.deal_amendment']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.deal_amendment']
  term_extension_months varchar [note: 'Number of months by which the agreement term is extended (positive) or shortened (negative). Null for amendments that do not modify the agreement duration. | Column term_extension_months (INT) in partner.deal_amendment']
  territory_change_description varchar [note: 'Narrative description of territorial rights changes, including countries or regions added or removed from the agreement scope. Null for non-territorial amendments. | Column territory_change_description (STRING) in partner.deal_amendment']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.deal_amendment']
  created_by varchar [note: 'User identifier or name of the individual who created the amendment record in the system. | Column created_by (STRING) in partner.deal_amendment']

  Note: 'Formal amendments and modifications to executed partner agreements — acquisition deals, distribution agreements, syndication agreements, and co-production arrangements. Tracks amendment type (financial, territorial, term extension, content scope change), effective date, approval chain, and the specific clauses modified. Maintains a complete amendment history for each agreement. | Unity Catalog table: media_broadcasting_ecm.partner.deal_amendment'
}

Table partner.delivery_obligation {
  delivery_obligation_id varchar [pk, note: 'Primary key for delivery_obligation | Column delivery_obligation_id (BIGINT) in partner.delivery_obligation']
  closed_caption_record_id varchar [note: 'Foreign key linking to compliance.closed_caption_record. Business justification: Content delivery obligations include captioning deliverables (caption files, format specs, accuracy requirements). Acceptance testing verifies caption files meet FCC technical and quality standards be | Column closed_caption_record_id (BIGINT) in compliance.delivery_obligation']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Content delivery specifications include rating certification requirements. Delivered assets must include on-screen rating cards, content descriptor overlays, and rating certification documentation. Ac | Column compliance_content_rating_id (BIGINT) in compliance.delivery_obligation']
  content_title_id varchar [note: 'Reference to the content title that must be delivered under this obligation. | Column content_title_id (BIGINT) in content.delivery_obligation']
  content_version_id varchar [note: 'Foreign key linking to content.version. Business justification: Delivery obligations specify exact technical versions (resolution, codec, bitrate, DRM). QC acceptance workflows, redelivery tracking, and technical compliance verification require version-level preci | Column content_version_id (BIGINT) in content.delivery_obligation']
  delivered_asset_version_id varchar [note: 'Foreign key linking to mediaasset.asset_version. Business justification: Delivery obligations specify exact version/format requirements (HD vs 4K, dubbed vs subtitled). Tracks which specific version satisfies contractual delivery for acceptance sign-off, QC validation, and | Column delivered_asset_version_id (BIGINT) in mediaasset.delivery_obligation']
  distribution_agreement_id varchar [note: 'Reference to the parent partner agreement under which this delivery obligation exists. | Column distribution_agreement_id (BIGINT) in partner.delivery_obligation']
  license_agreement_id varchar [note: 'Foreign key linking to rights.license_agreement. Business justification: Delivery obligations are contractual commitments tied to specific license agreements. Direct FK enables delivery tracking against license terms, SLA compliance monitoring, and penalty calculation base | Column license_agreement_id (BIGINT) in rights.delivery_obligation']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Core business process: partners have contractual obligations to deliver specific assets. Direct asset link enables MAM integration for delivery tracking, acceptance workflows, automated compliance rep | Column media_asset_id (BIGINT) in mediaasset.delivery_obligation']
  partner_id varchar [note: 'Reference to the partner to whom content must be delivered or from whom content is expected. | Column partner_id (BIGINT) in partner.delivery_obligation']
  program_schedule_id varchar [note: 'Foreign key linking to scheduling.program_schedule. Business justification: Content delivery obligations tie to specific broadcast schedules for fulfillment tracking (e.g., deliver episode 3 days before scheduled air date). Critical for partner SLA compliance, on-time deliver | Column program_schedule_id (BIGINT) in scheduling.delivery_obligation']
  responsible_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Content delivery obligations require assigned internal owner for accountability, escalation routing, and performance tracking. Critical for SLA compliance monitoring and breach response in content sup | Column responsible_employee_id (BIGINT) in workforce.delivery_obligation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.delivery_obligation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.delivery_obligation']
  acceptance_date date [note: 'Date on which the partner formally accepted the delivered content as meeting technical and contractual specifications. | Column acceptance_date (DATE) in partner.delivery_obligation']
  actual_delivery_date date [note: 'Date on which the content was actually delivered to the partner, null if not yet delivered. | Column actual_delivery_date (DATE) in partner.delivery_obligation']
  audio_description_required boolean [note: 'Indicates whether audio description track must be included for visually impaired audiences. | Column audio_description_required (BOOLEAN) in partner.delivery_obligation']
  audio_track_languages varchar [note: 'Comma-separated list of audio track languages that must be included in the delivery, using ISO 639 codes. | Column audio_track_languages (STRING) in partner.delivery_obligation']
  closed_caption_required boolean [note: 'Indicates whether closed captioning must be included in the delivered content to meet accessibility and regulatory requirements. | Column closed_caption_required (BOOLEAN) in partner.delivery_obligation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.delivery_obligation']
  created_timestamp timestamp [note: 'Timestamp when this delivery obligation record was first created in the system. | Column created_timestamp (TIMESTAMP) in partner.delivery_obligation']
  delivery_deadline date [note: 'Contractually agreed date by which the content must be delivered to the partner. | Column delivery_deadline (DATE) in partner.delivery_obligation']
  delivery_location varchar [note: 'Physical or network location where the content must be delivered, such as FTP server address, CDN endpoint, or facility address. | Column delivery_location (STRING) in partner.delivery_obligation']
  delivery_method varchar [note: 'Technical method or channel through which the content will be delivered to the partner. | Column delivery_method (STRING) in partner.delivery_obligation']
  delivery_status varchar [note: 'Current lifecycle status of the delivery obligation indicating progress toward fulfillment. | Column delivery_status (STRING) in partner.delivery_obligation']
  drm_requirement varchar [note: 'Digital rights management protection required for the delivered content to prevent unauthorized access and distribution. | Column drm_requirement (STRING) in partner.delivery_obligation']
  eidr_identifier varchar [note: 'Universal unique identifier from the Entertainment Identifier Registry for the content being delivered. | Column eidr_identifier (STRING) in partner.delivery_obligation']
  episode_count varchar [note: 'Number of episodes included in this delivery obligation for series or multi-episode content. | Column episode_count (INT) in partner.delivery_obligation']
  file_size_gb decimal(12,2) [note: 'Total file size in gigabytes of the content package to be delivered. | Column file_size_gb (DECIMAL(12,2)) in partner.delivery_obligation']
  isan_identifier varchar [note: 'International Standard Audiovisual Number uniquely identifying the audiovisual work being delivered. | Column isan_identifier (STRING) in partner.delivery_obligation']
  language_version varchar [note: 'Primary language version of the content to be delivered, using ISO 639 language codes. | Column language_version (STRING) in partner.delivery_obligation']
  last_modified_timestamp timestamp [note: 'Timestamp when this delivery obligation record was most recently updated. | Column last_modified_timestamp (TIMESTAMP) in partner.delivery_obligation']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this delivery obligation record. | Column modified_by_user (STRING) in partner.delivery_obligation']
  notes varchar [note: 'Free-form notes capturing additional context, special instructions, or issues related to this delivery obligation. | Column notes (STRING) in partner.delivery_obligation']
  obligation_number varchar [note: 'Business identifier for the delivery obligation, typically referenced in contracts and communications. | Column obligation_number (STRING) in partner.delivery_obligation']
  obligation_type varchar [note: 'Classification of the delivery obligation indicating the direction and nature of content flow. | Column obligation_type (STRING) in partner.delivery_obligation']
  penalty_amount decimal(15,2) [note: 'Financial penalty amount incurred for late delivery or non-compliance with delivery specifications, in the contract currency. | Column penalty_amount (DECIMAL(15,2)) in partner.delivery_obligation']
  priority_level varchar [note: 'Business priority assigned to this delivery obligation to guide resource allocation and scheduling. | Column priority_level (STRING) in partner.delivery_obligation']
  qc_completion_date date [note: 'Date on which quality control review was completed and content was approved for delivery. | Column qc_completion_date (DATE) in partner.delivery_obligation']
  quality_control_status varchar [note: 'Status of quality control review process for the content before delivery to ensure technical compliance. | Column quality_control_status (STRING) in partner.delivery_obligation']
  redelivery_required boolean [note: 'Indicates whether the content must be redelivered due to rejection or technical issues with the initial delivery. | Column redelivery_required (BOOLEAN) in partner.delivery_obligation']
  rejection_reason varchar [note: 'Detailed explanation provided by the partner for rejecting the delivered content, typically citing technical or contractual non-compliance. | Column rejection_reason (STRING) in partner.delivery_obligation']
  required_bitrate_mbps decimal(10,2) [note: 'Minimum or target bitrate in megabits per second required for the delivered content to meet quality standards. | Column required_bitrate_mbps (DECIMAL(10,2)) in partner.delivery_obligation']
  required_codec varchar [note: 'Video and audio codec specifications required for the delivery, such as H.264, H.265, AAC, or Dolby Digital. | Column required_codec (STRING) in partner.delivery_obligation']
  required_format varchar [note: 'Technical delivery format required by the partner, such as HLS (HTTP Live Streaming), MPEG-DASH (Dynamic Adaptive Streaming over HTTP), or mezzanine file format. | Column required_format (STRING) in partner.delivery_obligation']
  required_resolution varchar [note: 'Video resolution specification required for delivery, ranging from standard definition to ultra-high definition. | Column required_resolution (STRING) in partner.delivery_obligation']
  sla_compliance boolean [note: 'Indicates whether the delivery was completed within the service level agreement timeframe specified in the partner contract. | Column sla_compliance (BOOLEAN) in partner.delivery_obligation']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.delivery_obligation']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.delivery_obligation']
  subtitle_languages varchar [note: 'Comma-separated list of subtitle language tracks that must be included in the delivery, using ISO 639 codes. | Column subtitle_languages (STRING) in partner.delivery_obligation']
  technical_standard varchar [note: 'Broadcasting or streaming technical standard that the delivery must comply with, such as ATSC (Advanced Television Systems Committee) or DVB (Digital Video Broadcasting). | Column technical_standard (STRING) in partner.delivery_obligation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.delivery_obligation']

  Note: 'Tracks specific content delivery obligations owed to or from partners under acquisition, syndication, and co-production agreements. Captures required delivery format (HLS, MPEG-DASH, ISAN-tagged mezzanine), delivery deadline, technical specification compliance (ATSC, DVB), delivery status, and acceptance confirmation. Bridges partner agreements with the digital asset and distribution domains. | Unity Catalog table: media_broadcasting_ecm.partner.delivery_obligation'
}

Table partner.carriage_fee_schedule {
  carriage_fee_schedule_id varchar [pk, note: 'Unique identifier for the carriage fee schedule. Primary key for this entity. | Column carriage_fee_schedule_id (BIGINT) in partner.carriage_fee_schedule']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Carriage fee schedules for broadcast retransmission consent agreements reference specific licensed stations by call sign, facility ID, and market designation. Fee structures are negotiated per-station | Column broadcast_license_id (BIGINT) in compliance.carriage_fee_schedule']
  carriage_agreement_id varchar [note: 'Reference to the parent carriage agreement that governs this fee schedule. Links to the master distribution agreement between Media Broadcasting and the MVPD or vMVPD. | Column carriage_agreement_id (BIGINT) in distribution.carriage_fee_schedule']
  channel_id varchar [note: 'Reference to the specific Media Broadcasting channel covered by this fee schedule. A single carriage agreement may have multiple schedules for different channels. | Column channel_id (BIGINT) in scheduling.carriage_fee_schedule']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Carriage fees are sometimes tiered based on the demographic performance of the channel (e.g., higher fees for channels delivering key demos). Essential for carriage fee negotiation and optimization. | Column demographic_segment_id (BIGINT) in audience.carriage_fee_schedule']
  genre_id varchar [note: 'Foreign key linking to content.genre. Business justification: Carriage fees vary by content genre (sports premium vs general entertainment). Rate card negotiation, subscriber value modeling, and per-genre revenue allocation in distribution agreements require gen | Column genre_id (BIGINT) in content.carriage_fee_schedule']
  partner_id varchar [note: 'Reference to the MVPD, vMVPD, or distribution partner who pays carriage fees under this schedule. | Column partner_id (BIGINT) in partner.carriage_fee_schedule']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: Carriage fees are recognized through defined revenue streams with specific accounting treatment, commission structures, and subscriber-based revenue recognition. Critical for distribution revenue acco | Column revenue_stream_id (BIGINT) in finance.carriage_fee_schedule']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.carriage_fee_schedule']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.carriage_fee_schedule']
  audit_rights_flag boolean [note: 'Boolean indicator of whether Media Broadcasting retains the right to audit the distributors subscriber counts and fee calculations to ensure compliance with the schedule terms. | Column audit_rights_flag (BOOLEAN) in partner.carriage_fee_schedule']
  auto_renewal_flag boolean [note: 'Boolean indicator of whether this fee schedule automatically renews at the end of its term unless either party provides termination notice. | Column auto_renewal_flag (BOOLEAN) in partner.carriage_fee_schedule']
  base_fee_per_subscriber decimal(15,4) [note: 'The baseline carriage fee amount charged per subscriber per month. This is the foundational rate before any escalations, discounts, or adjustments are applied. | Column base_fee_per_subscriber (DECIMAL(15,4)) in partner.carriage_fee_schedule']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.carriage_fee_schedule']
  created_timestamp timestamp [note: 'Timestamp when this fee schedule record was first created in the system. Used for audit trail and data lineage purposes. | Column created_timestamp (TIMESTAMP) in partner.carriage_fee_schedule']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which carriage fees are denominated and invoiced. | Column currency_code (STRING) in partner.carriage_fee_schedule']
  effective_end_date date [note: 'Date on which this fee schedule expires or is superseded. Nullable for open-ended schedules that remain in force until renegotiated or terminated. | Column effective_end_date (DATE) in partner.carriage_fee_schedule']
  effective_start_date date [note: 'Date on which this fee schedule becomes effective and carriage fees begin to be calculated according to its terms. | Column effective_start_date (DATE) in partner.carriage_fee_schedule']
  escalation_frequency varchar [note: 'Frequency at which fee escalations are applied. Defines how often the base fee is adjusted according to the escalation type and rate. | Column escalation_frequency (STRING) in partner.carriage_fee_schedule']
  escalation_rate_percentage decimal(5,2) [note: 'Annual percentage rate by which the base fee per subscriber increases, if escalation type is fixed percentage. Expressed as a percentage (e.g., 3.00 for 3% annual increase). | Column escalation_rate_percentage (DECIMAL(5,2)) in partner.carriage_fee_schedule']
  escalation_type varchar [note: 'Method by which carriage fees increase over time. Options include no escalation, fixed annual percentage increase, Consumer Price Index (CPI) indexing, negotiated increases at specified intervals, or tiered increases based on subscriber growth. | Column escalation_type (STRING) in partner.carriage_fee_schedule']
  fee_type varchar [note: 'Classification of the fee structure. Indicates whether fees are charged per subscriber, as a flat monthly rate, in tiers based on subscriber count, volume-based with discounts, a hybrid model, or as a percentage of revenue share. | Column fee_type (STRING) in partner.carriage_fee_schedule']
  last_modified_timestamp timestamp [note: 'Timestamp when this fee schedule record was last updated. Tracks the most recent change to any field in the record for audit and compliance purposes. | Column last_modified_timestamp (TIMESTAMP) in partner.carriage_fee_schedule']
  late_payment_penalty_rate decimal(5,2) [note: 'Percentage rate applied as a penalty for late payment of carriage fees beyond the payment terms. Expressed as an annual percentage rate or per-period rate. | Column late_payment_penalty_rate (DECIMAL(5,2)) in partner.carriage_fee_schedule']
  maximum_fee_cap decimal(15,2) [note: 'The maximum total carriage fee amount per billing period, regardless of subscriber count. Protects the distributor from excessive fees in high-subscriber scenarios. | Column maximum_fee_cap (DECIMAL(15,2)) in partner.carriage_fee_schedule']
  mfn_provision_flag boolean [note: 'Boolean indicator of whether this schedule includes a Most-Favored-Nation clause. If true, the distributor is entitled to the most favorable carriage fee terms that Media Broadcasting offers to any comparable distributor. | Column mfn_provision_flag (BOOLEAN) in partner.carriage_fee_schedule']
  mfn_scope varchar [note: 'Defines the scope and conditions under which the MFN provision applies, including comparable distributor criteria, geographic limitations, and exclusions. | Column mfn_scope (STRING) in partner.carriage_fee_schedule']
  minimum_guaranteed_fee decimal(15,2) [note: 'The minimum total carriage fee amount guaranteed per billing period, regardless of subscriber count. Protects Media Broadcasting revenue in low-subscriber scenarios. | Column minimum_guaranteed_fee (DECIMAL(15,2)) in partner.carriage_fee_schedule']
  notes varchar [note: 'Free-text field for additional notes, special conditions, exceptions, or clarifications related to this fee schedule that do not fit structured fields. | Column notes (STRING) in partner.carriage_fee_schedule']
  payment_frequency varchar [note: 'Frequency at which carriage fees are invoiced and paid by the distributor. Defines the billing cycle for this fee schedule. | Column payment_frequency (STRING) in partner.carriage_fee_schedule']
  payment_terms_days varchar [note: 'Number of days from invoice date within which payment is due. Standard payment terms such as Net 30, Net 60, or custom terms. | Column payment_terms_days (INT) in partner.carriage_fee_schedule']
  schedule_name varchar [note: 'Business-friendly name or identifier for this fee schedule, used for internal reference and reporting purposes. | Column schedule_name (STRING) in partner.carriage_fee_schedule']
  schedule_status varchar [note: 'Current lifecycle status of the fee schedule. Indicates whether the schedule is in draft, actively in force, temporarily suspended, expired, terminated early, or superseded by a newer version. | Column schedule_status (STRING) in partner.carriage_fee_schedule']
  schedule_version varchar [note: 'Version identifier for this fee schedule, used to track amendments, renegotiations, and historical changes to fee structures over the life of the agreement. | Column schedule_version (STRING) in partner.carriage_fee_schedule']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.carriage_fee_schedule']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.carriage_fee_schedule']
  subscriber_count_source varchar [note: 'Source of subscriber count data used to calculate carriage fees. Options include distributor self-reporting, third-party audit, Nielsen measurement, or Media Broadcasting internal estimates. | Column subscriber_count_source (STRING) in partner.carriage_fee_schedule']
  termination_notice_days varchar [note: 'Number of days advance notice required by either party to terminate this fee schedule prior to its natural expiration date. | Column termination_notice_days (INT) in partner.carriage_fee_schedule']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.carriage_fee_schedule']
  volume_discount_tier_1_rate decimal(15,4) [note: 'Discounted per-subscriber fee rate applicable when subscriber count exceeds the Tier 1 threshold. | Column volume_discount_tier_1_rate (DECIMAL(15,4)) in partner.carriage_fee_schedule']
  volume_discount_tier_1_threshold varchar [note: 'Subscriber count threshold at which the first volume discount tier is triggered. Distributors exceeding this subscriber count qualify for a reduced per-subscriber fee. | Column volume_discount_tier_1_threshold (BIGINT) in partner.carriage_fee_schedule']
  volume_discount_tier_2_rate decimal(15,4) [note: 'Discounted per-subscriber fee rate applicable when subscriber count exceeds the Tier 2 threshold. | Column volume_discount_tier_2_rate (DECIMAL(15,4)) in partner.carriage_fee_schedule']
  volume_discount_tier_2_threshold varchar [note: 'Subscriber count threshold at which the second volume discount tier is triggered, offering further per-subscriber fee reduction. | Column volume_discount_tier_2_threshold (BIGINT) in partner.carriage_fee_schedule']
  volume_discount_tier_3_rate decimal(15,4) [note: 'Discounted per-subscriber fee rate applicable when subscriber count exceeds the Tier 3 threshold. | Column volume_discount_tier_3_rate (DECIMAL(15,4)) in partner.carriage_fee_schedule']
  volume_discount_tier_3_threshold varchar [note: 'Subscriber count threshold at which the third volume discount tier is triggered, offering the deepest per-subscriber fee reduction. | Column volume_discount_tier_3_threshold (BIGINT) in partner.carriage_fee_schedule']

  Note: 'Fee schedule governing carriage payments from MVPDs and vMVPDs for distribution of Media Broadcasting channels. Defines per-subscriber fee tiers, escalation clauses, most-favored-nation (MFN) provisions, volume discount thresholds, and payment frequency. Reference entity used to calculate carriage fee invoices in the billing domain. | Unity Catalog table: media_broadcasting_ecm.partner.carriage_fee_schedule'
}

Table partner.performance_obligation {
  performance_obligation_id varchar [pk, note: 'Unique identifier for the partner performance obligation record. Primary key. | Column performance_obligation_id (BIGINT) in partner.performance_obligation']
  accessibility_obligation_id varchar [note: 'Foreign key linking to compliance.accessibility_obligation. Business justification: Partner SLAs for content delivery include accessibility obligations (captioning accuracy thresholds, audio description delivery, caption format compliance) that map to FCC/CVAA regulatory accessibilit | Column accessibility_obligation_id (BIGINT) in compliance.performance_obligation']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Performance obligations often specify demographic delivery targets (e.g., \'must deliver 3.0 A18-49 rating\'). Essential for SLA monitoring, compliance verification, and makegood determination. | Column demographic_segment_id (BIGINT) in audience.performance_obligation']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Performance obligations (minimum plays, promotional commitments, playlist inclusion) are measured against specific assets. Direct asset link enables automated compliance monitoring, breach detection,  | Column media_asset_id (BIGINT) in mediaasset.performance_obligation']
  partner_agreement_id varchar [note: 'Reference to the parent partner agreement under which this performance obligation is defined. | Column partner_agreement_id (BIGINT) in partner.performance_obligation']
  partner_id varchar [note: 'Reference to the partner entity responsible for fulfilling this performance obligation. | Column partner_id (BIGINT) in partner.performance_obligation']
  responsible_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: SLA obligations require structured employee assignment for breach monitoring, cure period management, and escalation. Replaces text field responsible_party with FK for workload reporting, performance  | Column responsible_employee_id (BIGINT) in workforce.performance_obligation']
  sweeps_period_id varchar [note: 'Foreign key linking to audience.sweeps_period. Business justification: Performance obligations often reference sweeps periods for measurement (e.g., \'must achieve X rating during November sweeps\'). Essential for contract compliance verification during key measurement win | Column sweeps_period_id (BIGINT) in audience.performance_obligation']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.performance_obligation']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.performance_obligation']
  breach_count varchar [note: 'The cumulative number of times this performance obligation has been breached since the effective start date or last reset. | Column breach_count (INT) in partner.performance_obligation']
  compliance_status varchar [note: 'Current compliance state of the performance obligation based on the most recent measurement period. | Column compliance_status (STRING) in partner.performance_obligation']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.performance_obligation']
  created_timestamp timestamp [note: 'The date and time when this performance obligation record was first created in the system. | Column created_timestamp (TIMESTAMP) in partner.performance_obligation']
  cure_deadline_date date [note: 'The calculated deadline by which the partner must cure the most recent breach to avoid penalties. Null if no active breach exists. | Column cure_deadline_date (DATE) in partner.performance_obligation']
  cure_period_days varchar [note: 'The number of days allowed for the partner to remedy a breach before penalties or escalation actions are triggered, as defined in the agreement. | Column cure_period_days (INT) in partner.performance_obligation']
  effective_end_date date [note: 'The date when this performance obligation expires or is no longer enforceable. Null indicates an open-ended obligation tied to the agreement term. | Column effective_end_date (DATE) in partner.performance_obligation']
  effective_start_date date [note: 'The date when this performance obligation becomes active and enforceable under the partner agreement. | Column effective_start_date (DATE) in partner.performance_obligation']
  escalation_level varchar [note: 'The current escalation level for this performance obligation based on breach severity and frequency, as defined in the agreement escalation matrix. | Column escalation_level (STRING) in partner.performance_obligation']
  last_breach_date date [note: 'The date of the most recent breach event for this performance obligation. | Column last_breach_date (DATE) in partner.performance_obligation']
  last_measured_date date [note: 'The date when the performance obligation was last evaluated for compliance. | Column last_measured_date (DATE) in partner.performance_obligation']
  last_measured_value decimal(18,4) [note: 'The actual measured value from the most recent compliance evaluation period. | Column last_measured_value (DECIMAL(18,4)) in partner.performance_obligation']
  last_notification_date date [note: 'The date when the partner was last notified regarding the compliance status or breach of this performance obligation. | Column last_notification_date (DATE) in partner.performance_obligation']
  last_updated_timestamp timestamp [note: 'The date and time when this performance obligation record was last modified. | Column last_updated_timestamp (TIMESTAMP) in partner.performance_obligation']
  makegood_provision_flag boolean [note: 'Indicates whether this obligation includes a makegood provision requiring compensatory ad spots or content delivery in case of non-compliance. | Column makegood_provision_flag (BOOLEAN) in partner.performance_obligation']
  makegood_spots_required varchar [note: 'The number of compensatory advertising spots or content deliveries required to remedy a breach, if makegood provision applies. | Column makegood_spots_required (INT) in partner.performance_obligation']
  measurement_period varchar [note: 'The time period over which the performance obligation is measured and evaluated for compliance. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|annually|per_broadcast|per_delivery — 7 candidates stripped; promote to reference product] | Column measurement_period (STRING) in partner.performance_obligation']
  monitoring_system varchar [note: 'The name or identifier of the system or platform used to monitor and measure compliance with this performance obligation (e.g., Nielsen, Akamai CDN, internal monitoring tool). | Column monitoring_system (STRING) in partner.performance_obligation']
  notes varchar [note: 'Additional notes, comments, or context regarding this performance obligation, including special conditions, waivers, or historical context. | Column notes (STRING) in partner.performance_obligation']
  notification_required_flag boolean [note: 'Indicates whether the partner must be formally notified of compliance status or breach events for this obligation. | Column notification_required_flag (BOOLEAN) in partner.performance_obligation']
  obligation_code varchar [note: 'Business identifier code for the performance obligation, used for tracking and reporting purposes. | Column obligation_code (STRING) in partner.performance_obligation']
  obligation_description varchar [note: 'Detailed description of the performance obligation, including specific terms, conditions, and expectations as stated in the partner agreement. | Column obligation_description (STRING) in partner.performance_obligation']
  obligation_name varchar [note: 'Human-readable name describing the performance obligation (e.g., \'Uptime Guarantee\', \'Content Delivery Timeliness\', \'Ratings Performance Threshold\'). | Column obligation_name (STRING) in partner.performance_obligation']
  obligation_type varchar [note: 'Category of performance obligation as defined in the partner agreement. Determines the measurement and compliance framework applied. | Column obligation_type (STRING) in partner.performance_obligation']
  penalty_amount decimal(15,2) [note: 'The monetary value of the penalty applied per breach or per measurement period, if the penalty type is financial. Expressed in the agreement currency. | Column penalty_amount (DECIMAL(15,2)) in partner.performance_obligation']
  penalty_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the penalty amount (e.g., USD, GBP, EUR). | Column penalty_currency_code (STRING) in partner.performance_obligation']
  penalty_type varchar [note: 'The type of penalty or remedy applied when this performance obligation is breached, as specified in the partner agreement. | Column penalty_type (STRING) in partner.performance_obligation']
  reporting_frequency varchar [note: 'The frequency at which compliance reporting is required for this performance obligation, as specified in the partner agreement. | Column reporting_frequency (STRING) in partner.performance_obligation']
  sla_metric varchar [note: 'The specific metric being measured for this obligation (e.g., \'System Uptime Percentage\', \'Content Delivery Time\', \'Average Rating Points\', \'Subscriber Count\'). | Column sla_metric (STRING) in partner.performance_obligation']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.performance_obligation']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.performance_obligation']
  threshold_operator varchar [note: 'The comparison operator used to evaluate compliance against the threshold value (e.g., greater than or equal to 99.9% uptime). | Column threshold_operator (STRING) in partner.performance_obligation']
  threshold_value decimal(18,4) [note: 'The numeric threshold or target value that must be met or exceeded to satisfy the performance obligation. | Column threshold_value (DECIMAL(18,4)) in partner.performance_obligation']
  unit_of_measure varchar [note: 'The unit in which the threshold value is expressed (e.g., \'percentage\', \'hours\', \'rating points\', \'subscriber count\', \'minutes\'). | Column unit_of_measure (STRING) in partner.performance_obligation']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.performance_obligation']

  Note: 'Tracks contractual performance obligations and SLA commitments within partner agreements — uptime guarantees, content delivery timeliness, ratings performance thresholds, subscriber penetration targets, and makegood provisions. Monitors compliance status, breach events, and cure period tracking. Supports revenue assurance and financial reconciliation processes. | Unity Catalog table: media_broadcasting_ecm.partner.performance_obligation'
}

Table partner.minimum_guarantee {
  minimum_guarantee_id varchar [pk, note: 'Unique identifier for the minimum guarantee commitment within a content acquisition deal. | Column minimum_guarantee_id (BIGINT) in partner.minimum_guarantee']
  acquisition_deal_id varchar [note: 'Reference to the parent content acquisition deal that contains this minimum guarantee commitment. | Column acquisition_deal_id (BIGINT) in partner.minimum_guarantee']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: MG advances post to specific GL accounts for balance sheet classification, amortization tracking, and recoupment accounting. Critical for content asset accounting and deferred cost management. | Column chart_of_accounts_id (BIGINT) in finance.minimum_guarantee']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: MG recoupment is calculated against specific asset performance (views, revenue, plays). Direct asset link enables automated royalty accounting, overage calculation, and partner statements showing whic | Column media_asset_id (BIGINT) in mediaasset.minimum_guarantee']
  partner_id varchar [note: 'Reference to the studio, syndicator, or content provider receiving the minimum guarantee payment. | Column partner_id (BIGINT) in partner.minimum_guarantee']
  recoupment_invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: MG recoupment tracking requires linking actual invoiced revenue (syndication fees, royalty statements) back to the guarantee for overage calculation, royalty true-ups, and partner financial reporting. | Column recoupment_invoice_id (BIGINT) in billing.minimum_guarantee']
  revenue_stream_id varchar [note: 'Foreign key linking to finance.revenue_stream. Business justification: MG recoupment flows through specific revenue streams for ASC 606 compliance, performance obligation tracking, and royalty accounting. Essential for revenue recognition method determination and deferre | Column revenue_stream_id (BIGINT) in finance.minimum_guarantee']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.minimum_guarantee']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.minimum_guarantee']
  accounting_treatment_code varchar [note: 'The financial accounting classification for the minimum guarantee: asset (capitalized content cost), expense (immediate P&L impact), deferred expense (amortized over time), prepaid (advance payment), or liability (obligation to provider). | Column accounting_treatment_code (STRING) in partner.minimum_guarantee']
  amortization_method varchar [note: 'The method used to amortize the minimum guarantee cost over its useful life: straight-line (equal periods), usage-based (viewership-driven), revenue-based (proportional to earnings), accelerated (front-loaded), or none (expensed immediately). | Column amortization_method (STRING) in partner.minimum_guarantee']
  contract_reference_number varchar [note: 'The master contract or agreement number that governs this minimum guarantee commitment. Links to the legal contract document for audit and compliance. | Column contract_reference_number (STRING) in partner.minimum_guarantee']
  cost_center_code varchar [note: 'The cost center or business unit responsible for the minimum guarantee commitment. Used for internal financial allocation and performance tracking. | Column cost_center_code (STRING) in partner.minimum_guarantee']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.minimum_guarantee']
  created_timestamp timestamp [note: 'The date and time when this minimum guarantee record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in partner.minimum_guarantee']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the minimum guarantee amount (e.g., USD, GBP, EUR). | Column currency_code (STRING) in partner.minimum_guarantee']
  effective_end_date date [note: 'The date when the minimum guarantee commitment expires or the recoupment period ends. After this date, overage terms may continue but the MG obligation is closed. | Column effective_end_date (DATE) in partner.minimum_guarantee']
  effective_start_date date [note: 'The date when the minimum guarantee commitment becomes active and revenue recoupment begins. Typically aligned with content delivery or first broadcast date. | Column effective_start_date (DATE) in partner.minimum_guarantee']
  final_payment_date date [note: 'The date when the last scheduled minimum guarantee payment was made or is due. Relevant for installment or milestone-based payment structures. | Column final_payment_date (DATE) in partner.minimum_guarantee']
  first_payment_date date [note: 'The date when the initial minimum guarantee payment was made or is scheduled to be made to the content provider. | Column first_payment_date (DATE) in partner.minimum_guarantee']
  fully_recouped_date date [note: 'The date when the minimum guarantee was fully recouped and the outstanding balance reached zero. After this date, overage royalty terms apply to additional revenue. | Column fully_recouped_date (DATE) in partner.minimum_guarantee']
  general_ledger_account_code varchar [note: 'The general ledger account code in the ERP system where minimum guarantee transactions are recorded for financial reporting and reconciliation. | Column general_ledger_account_code (STRING) in partner.minimum_guarantee']
  is_cross_collateralized boolean [note: 'Indicates whether this minimum guarantee can be recouped from revenue generated by other content titles or deals with the same provider (true) or is isolated to this specific deal (false). | Column is_cross_collateralized (BOOLEAN) in partner.minimum_guarantee']
  is_recoupable boolean [note: 'Indicates whether the minimum guarantee can be recouped from revenue (true) or is a non-recoupable floor payment (false). Non-recoupable MGs are paid regardless of performance with no offset. | Column is_recoupable (BOOLEAN) in partner.minimum_guarantee']
  last_modified_timestamp timestamp [note: 'The date and time when this minimum guarantee record was last updated. Tracks changes to amounts, status, or recoupment calculations. | Column last_modified_timestamp (TIMESTAMP) in partner.minimum_guarantee']
  last_recoupment_calculation_date date [note: 'The date when the most recent recoupment calculation was performed, updating the recouped to date and outstanding balance amounts. | Column last_recoupment_calculation_date (DATE) in partner.minimum_guarantee']
  mg_amount decimal(18,2) [note: 'The floor payment amount owed to the content provider regardless of actual viewership or revenue performance. This is the baseline financial commitment. | Column mg_amount (DECIMAL(18,2)) in partner.minimum_guarantee']
  mg_number varchar [note: 'Business identifier for the minimum guarantee commitment, used in contracts and financial reconciliation. | Column mg_number (STRING) in partner.minimum_guarantee']
  mg_status varchar [note: 'Current lifecycle state of the minimum guarantee: draft (under negotiation), active (in effect), partially recouped (some revenue applied), fully recouped (MG threshold met), overage (revenue exceeds MG), expired (term ended), or terminated (contract cancelled). [ENUM-REF-CANDIDATE: draft|active|partially_recouped|fully_recouped|overage|expired|terminated — 7 candidates stripped; promote to reference product] | Column mg_status (STRING) in partner.minimum_guarantee']
  mg_type varchar [note: 'Classification of the minimum guarantee structure: flat (single fixed payment), tiered (stepped payments based on milestones), performance-based (adjusted by viewership), hybrid (combination), recoupable (can be offset by revenue share), or non-recoupable (floor payment regardless of performance). | Column mg_type (STRING) in partner.minimum_guarantee']
  next_recoupment_calculation_date date [note: 'The scheduled date for the next recoupment calculation cycle. Typically aligned with monthly, quarterly, or annual reporting periods. | Column next_recoupment_calculation_date (DATE) in partner.minimum_guarantee']
  notes varchar [note: 'Free-text field for additional context, special terms, exceptions, or business notes related to the minimum guarantee commitment. Used for operational communication and audit trail. | Column notes (STRING) in partner.minimum_guarantee']
  outstanding_balance_amount decimal(18,2) [note: 'Remaining minimum guarantee amount not yet recouped. Calculated as MG amount minus recouped to date amount. When zero, the MG is fully recouped. | Column outstanding_balance_amount (DECIMAL(18,2)) in partner.minimum_guarantee']
  overage_amount decimal(18,2) [note: 'Revenue earned beyond the minimum guarantee threshold. Once the MG is fully recouped, additional revenue share payments are calculated on this overage amount per the contract terms. | Column overage_amount (DECIMAL(18,2)) in partner.minimum_guarantee']
  overage_royalty_rate decimal(5,2) [note: 'The percentage rate applied to overage revenue to calculate additional royalty payments owed to the content provider after the minimum guarantee is fully recouped. Typically ranges from 0.00 to 100.00 percent. | Column overage_royalty_rate (DECIMAL(5,2)) in partner.minimum_guarantee']
  payment_schedule_type varchar [note: 'The timing structure for minimum guarantee payments: upfront (single payment at signing), milestone (tied to delivery/broadcast events), installment (fixed periodic payments), quarterly, annual, upon delivery (when content is delivered), or upon broadcast (when content airs). [ENUM-REF-CANDIDATE: upfront|milestone|installment|quarterly|annual|upon_delivery|upon_broadcast — 7 candidates stripped; promote to reference product] | Column payment_schedule_type (STRING) in partner.minimum_guarantee']
  payment_terms_description varchar [note: 'Detailed narrative of the payment schedule, milestones, and conditions governing the minimum guarantee disbursement. Includes specific dates, amounts, and triggering events. | Column payment_terms_description (STRING) in partner.minimum_guarantee']
  recouped_to_date_amount decimal(18,2) [note: 'Cumulative revenue amount that has been applied against the minimum guarantee as of the current reporting period. Tracks progress toward full recoupment. | Column recouped_to_date_amount (DECIMAL(18,2)) in partner.minimum_guarantee']
  recoupment_basis varchar [note: 'The revenue or performance metric against which the minimum guarantee is recouped: gross revenue (total), net revenue (after costs), advertising revenue (CPM/GRP-based), subscription revenue (SVOD/ARPU), combined revenue (multi-stream), or viewership metric (Nielsen ratings, reach). | Column recoupment_basis (STRING) in partner.minimum_guarantee']
  recoupment_percentage decimal(5,2) [note: 'The percentage of revenue (based on recoupment basis) that is applied toward recouping the minimum guarantee. Typically ranges from 0.00 to 100.00 percent. | Column recoupment_percentage (DECIMAL(5,2)) in partner.minimum_guarantee']
  recoupment_period_months varchar [note: 'The duration in months over which the minimum guarantee can be recouped from revenue. Common periods are 12, 24, 36, or 60 months depending on content type and windowing strategy. | Column recoupment_period_months (INT) in partner.minimum_guarantee']
  recoupment_waterfall_description varchar [note: 'Detailed explanation of the revenue allocation sequence and priority order for recouping the minimum guarantee. Defines which revenue streams are applied first and how costs are deducted before recoupment. | Column recoupment_waterfall_description (STRING) in partner.minimum_guarantee']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.minimum_guarantee']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.minimum_guarantee']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.minimum_guarantee']

  Note: 'Minimum guarantee (MG) commitments within content acquisition deals — the floor payment owed to a content provider regardless of actual viewership or revenue performance. Tracks MG amount, recoupment schedule, earned-against-MG balance, recoupment waterfall, and overage terms. Critical for financial reconciliation and royalty management in the finance and rights domains. | Unity Catalog table: media_broadcasting_ecm.partner.minimum_guarantee'
}

Table partner.payment_term {
  payment_term_id varchar [pk, note: 'Unique identifier for the partner payment term record. Primary key. | Column payment_term_id (BIGINT) in partner.payment_term']
  approved_by_employee_id varchar [note: 'Foreign key linking to workforce.employee. Business justification: Payment terms require approver tracking for financial controls, SOX compliance, and audit trail. Approval_required_flag exists but no FK to capture who approved - essential for segregation of duties r | Column approved_by_employee_id (BIGINT) in workforce.payment_term']
  chart_of_accounts_id varchar [note: 'Foreign key linking to finance.chart_of_accounts. Business justification: Payment terms specify GL accounts for AP posting, cash flow forecasting, and financial statement classification. Essential for accounts payable automation, payment processing, and balance sheet accura | Column chart_of_accounts_id (BIGINT) in finance.payment_term']
  milestone_invoice_id varchar [note: 'Foreign key linking to billing.invoice. Business justification: Partner payment terms define milestone-based invoicing (delivery milestones, window activation, subscriber thresholds). Linking actual invoices to terms enables payment compliance tracking, late payme | Column milestone_invoice_id (BIGINT) in billing.payment_term']
  partner_id varchar [note: 'Reference to the partner (studio, syndicator, content provider, MVPD, or third-party distributor) to whom this payment term applies. | Column partner_id (BIGINT) in partner.payment_term']
  payment_schedule_id varchar [note: 'Reference to a detailed payment schedule record that breaks down this term into multiple installments or recurring payments. | Column payment_schedule_id (BIGINT) in partner.payment_term']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.payment_term']
