    rdfs:range xsd:string .

ind:revenueCodes rdf:type rdf:Property ;
    rdfs:label 'Revenue Codes' ;
    rdfs:comment 'Comma-separated list of UB-04 revenue codes used to identify specific services or accommodations in measure specifications.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placeOfServiceCodes rdf:type rdf:Property ;
    rdfs:label 'Place Of Service Codes' ;
    rdfs:comment 'Comma-separated list of two-digit codes identifying the location where services were rendered for measure evaluation.' ;
