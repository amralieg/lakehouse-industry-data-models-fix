  annual_content_volume_hours decimal(12,2) [note: 'Estimated or actual annual volume of content hours acquired from or distributed through this partner. Used for capacity planning, content pipeline forecasting, and partner performance evaluation. | Column annual_content_volume_hours (DECIMAL(12,2)) in partner.partner_partner']
  annual_revenue_contribution_usd decimal(18,2) [note: 'Estimated or actual annual revenue contribution from this partner relationship in USD. Includes content licensing fees, distribution revenue share, advertising revenue, or other monetization streams. Used for partner valuation and ROI analysis. | Column annual_revenue_contribution_usd (DECIMAL(18,2)) in partner.partner_partner']
  content_specialization varchar [note: 'Primary content genres, formats, or categories that the partner specializes in producing or distributing. Examples include scripted drama, unscripted reality, sports, news, children\'s programming, documentary, or multi-genre. Supports content acquisition strategy and partner matching. | Column content_specialization (STRING) in partner.partner_partner']
  contract_renewal_date date [note: 'Next scheduled date for master agreement renewal or renegotiation with this partner. Used for relationship management planning, contract pipeline tracking, and ensuring continuity of content supply or distribution. | Column contract_renewal_date (DATE) in partner.partner_partner']
  corporate_hierarchy_level varchar [note: 'Numeric level in the corporate hierarchy tree where 1 represents the ultimate parent entity and higher numbers represent deeper subsidiary levels. Used for roll-up reporting and consolidated analytics. | Column corporate_hierarchy_level (INT) in partner.partner_partner']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.partner_partner']
  created_timestamp timestamp [note: 'Timestamp when this partner record was first created in the system. Used for audit trail, data lineage tracking, and record age analysis. | Column created_timestamp (TIMESTAMP) in partner.partner_partner']
  credit_rating varchar [note: 'External credit rating assigned by rating agencies such as Moody\'s, S&P, or Fitch. Used for financial risk assessment, contract negotiation, and determining payment terms or guarantees required. | Column credit_rating (STRING) in partner.partner_partner']
  distribution_territories varchar [note: 'Geographic territories or markets where the partner operates or holds distribution rights. Stored as comma-separated list of country codes or region identifiers. Critical for rights management and windowing strategy. | Column distribution_territories (STRING) in partner.partner_partner']
  domicile_country_code varchar [note: 'Three-letter ISO country code representing the legal domicile jurisdiction where the partner entity is incorporated or registered. Determines applicable regulatory frameworks and tax treaties. | Column domicile_country_code (STRING) in partner.partner_partner']
  duns_number varchar [note: 'Nine-digit unique identifier assigned by Dun & Bradstreet to identify business entities globally. Used for credit assessment, vendor management, and corporate hierarchy tracking. | Column duns_number (STRING) in partner.partner_partner']
  headquarters_address_line1 varchar [note: 'First line of the physical headquarters address including street number and street name. Used for legal correspondence, contract execution, and regulatory filings. | Column headquarters_address_line1 (STRING) in partner.partner_partner']
  headquarters_address_line2 varchar [note: 'Second line of the physical headquarters address for suite, floor, building name, or other secondary address details. | Column headquarters_address_line2 (STRING) in partner.partner_partner']
  headquarters_city varchar [note: 'City or municipality where the partner headquarters is located. | Column headquarters_city (STRING) in partner.partner_partner']
  headquarters_country_code varchar [note: 'Three-letter ISO country code for the headquarters location. May differ from domicile_country_code if the operational headquarters is in a different jurisdiction than legal incorporation. | Column headquarters_country_code (STRING) in partner.partner_partner']
  headquarters_postal_code varchar [note: 'Postal or ZIP code for the headquarters address. Format varies by country postal system. | Column headquarters_postal_code (STRING) in partner.partner_partner']
  headquarters_state_province varchar [note: 'State, province, or primary administrative subdivision where the partner headquarters is located. Format varies by country. | Column headquarters_state_province (STRING) in partner.partner_partner']
  is_exclusive boolean [note: 'Indicates whether the partnership includes exclusivity provisions that restrict either party from engaging with competing partners in specified territories, content categories, or distribution channels. Critical for rights management and competitive strategy. | Column is_exclusive (BOOLEAN) in partner.partner_partner']
  last_modified_by varchar [note: 'User identifier or system account that performed the most recent modification to this partner record. Used for audit trail and accountability. | Column last_modified_by (STRING) in partner.partner_partner']
  last_modified_timestamp timestamp [note: 'Timestamp when this partner record was most recently updated. Used for change tracking, data freshness monitoring, and audit trail. | Column last_modified_timestamp (TIMESTAMP) in partner.partner_partner']
  notes varchar [note: 'Free-text field for capturing additional context, special considerations, relationship history, or operational notes about the partner that do not fit structured fields. Used by relationship managers for institutional knowledge capture. | Column notes (STRING) in partner.partner_partner']
  onboarding_stage varchar [note: 'Current stage in the partner onboarding workflow. Tracks progression from initial prospect through due diligence, contract negotiation, legal review, approval, and final onboarding completion. | Column onboarding_stage (STRING) in partner.partner_partner']
  partner_code varchar [note: 'Externally-known unique business identifier for the partner used in operational systems, contracts, and inter-company communications. Typically assigned during onboarding. | Column partner_code (STRING) in partner.partner_partner']
  partner_name varchar [note: 'The full legal name of the partner organization as registered with governing authorities. Used for contracts, invoicing, and legal documentation. | Column partner_name (STRING) in partner.partner_partner']
  partner_type varchar [note: 'Primary classification of the partner based on their role in the media ecosystem. Studios produce original content, syndicators distribute content to multiple outlets, content providers supply licensed material, MVPDs are traditional cable/satellite distributors, vMVPDs are virtual distributors, and OTT aggregators operate streaming platforms. | Column partner_type (STRING) in partner.partner_partner']
  preferred_payment_terms varchar [note: 'Standard payment terms negotiated with the partner for content licensing, royalties, or service fees. Examples include Net 30, Net 60, advance against royalties, or milestone-based payments. Feeds into accounts payable and cash flow planning. | Column preferred_payment_terms (STRING) in partner.partner_partner']
  primary_contact_email varchar [note: 'Primary email address for the main business contact at the partner organization. Used for operational communications, contract notifications, and relationship management. | Column primary_contact_email (STRING) in partner.partner_partner']
  primary_contact_name varchar [note: 'Full name of the primary business contact at the partner organization responsible for day-to-day relationship management and operational coordination. | Column primary_contact_name (STRING) in partner.partner_partner']
  primary_contact_phone varchar [note: 'Primary telephone number for the main business contact at the partner organization. Includes country code and extension where applicable. | Column primary_contact_phone (STRING) in partner.partner_partner']
  relationship_end_date date [note: 'Date when the business relationship with this partner was formally terminated or is scheduled to end. Null for active ongoing relationships. Used for historical analysis and transition planning. | Column relationship_end_date (DATE) in partner.partner_partner']
  relationship_start_date date [note: 'Date when the business relationship with this partner was formally established, typically corresponding to the first executed agreement or onboarding completion. Used for relationship tenure analysis and anniversary tracking. | Column relationship_start_date (DATE) in partner.partner_partner']
  relationship_status varchar [note: 'Current lifecycle state of the business relationship. Active indicates ongoing business, pending indicates onboarding in progress, suspended indicates temporary hold, inactive indicates no current agreements, and terminated indicates relationship ended. | Column relationship_status (STRING) in partner.partner_partner']
  risk_tier varchar [note: 'Internal risk classification based on financial stability, contract compliance history, operational reliability, and strategic importance. Used for relationship management prioritization and escalation protocols. | Column risk_tier (STRING) in partner.partner_partner']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.partner_partner']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.partner_partner']
  strategic_tier varchar [note: 'Classification of the partner\'s strategic importance to the business. Tier 1 represents critical strategic partners with significant content volume or distribution reach, Tier 2 represents important but not critical partners, Tier 3 represents transactional relationships, and emerging represents new partners under evaluation. | Column strategic_tier (STRING) in partner.partner_partner']
  subtype varchar [note: 'Secondary classification providing additional granularity within the partner type. Examples include major studio vs independent studio, first-run syndicator vs off-network syndicator, FAST channel operator, co-production house, or affiliate network. | Column subtype (STRING) in partner.partner_partner']
  tax_identifier varchar [note: 'Government-issued tax identification number for the partner entity. Format varies by jurisdiction (e.g., EIN in USA, VAT number in EU, GST number in other regions). Used for tax reporting and compliance. | Column tax_identifier (STRING) in partner.partner_partner']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.partner_partner']

  Note: 'Master record for all external business partners including studios, syndicators, content providers, MVPDs, vMVPDs, FAST channel operators, and third-party distribution partners. Serves as the SSOT for partner identity, classification, legal entity details, and relationship status. Tracks partner type (studio, syndicator, MVPD, OTT aggregator, co-production house), corporate hierarchy, domicile jurisdiction, and onboarding lifecycle stage. | Unity Catalog table: media_broadcasting_ecm.partner.partner_partner'
}

Table partner.partner_contact {
  partner_contact_id varchar [pk, note: 'Unique identifier for the partner contact record. Primary key. | Column partner_contact_id (BIGINT) in partner.partner_contact']
  compliance_consent_record_id varchar [note: 'Foreign key linking to compliance.consent_record. Business justification: Partner contacts (especially EU/UK/California partners) require GDPR/CCPA consent records for marketing communications, data processing agreements, and third-party data sharing. B2B consent tracking e | Column compliance_consent_record_id (BIGINT) in compliance.partner_contact']
  employee_id varchar [note: 'Reference to the internal Media Broadcasting employee who owns and manages the relationship with this partner contact. Typically a business development manager or account executive. | Column employee_id (BIGINT) in workforce.partner_contact']
  partner_id varchar [note: 'Reference to the partner organization this contact is associated with. Links to the partner master record. | Column partner_id (BIGINT) in partner.partner_contact']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: In media broadcasting, partner contacts are sometimes talent themselves (producer-directors, showrunners with production companies, talent-owned studios). Essential for dual-role tracking, conflict of | Column talent_profile_id (BIGINT) in talent.partner_contact']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.partner_contact']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.partner_contact']
  assistant_email varchar [note: 'The email address of the contacts executive assistant, used for meeting coordination and scheduling. | Column assistant_email (STRING) in partner.partner_contact']
  assistant_name varchar [note: 'The name of the contacts executive assistant or administrative support person, if applicable. Used for scheduling and coordination. | Column assistant_name (STRING) in partner.partner_contact']
  assistant_phone varchar [note: 'The phone number of the contacts executive assistant, used for urgent scheduling needs and coordination. | Column assistant_phone (STRING) in partner.partner_contact']
  communication_language varchar [note: 'The preferred language for business communications with this contact, specified using ISO 639-1 two-letter language codes (e.g., EN, ES, FR). | Column communication_language (STRING) in partner.partner_contact']
  contact_status varchar [note: 'Current lifecycle status of the partner contact. Indicates whether the contact is actively engaged, temporarily unavailable, or no longer with the partner organization. | Column contact_status (STRING) in partner.partner_contact']
  contract_signatory boolean [note: 'Boolean flag indicating whether this contact has legal authority to sign contracts and binding agreements on behalf of the partner organization. | Column contract_signatory (BOOLEAN) in partner.partner_contact']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.partner_contact']
  created_timestamp timestamp [note: 'The timestamp when this partner contact record was first created in the system. Used for audit trail and data lineage. | Column created_timestamp (TIMESTAMP) in partner.partner_contact']
  decision_making_authority varchar [note: 'The level of decision-making authority the contact has within their organization for partnership matters, contract negotiations, and business agreements. | Column decision_making_authority (STRING) in partner.partner_contact']
  department varchar [note: 'The department or division within the partner organization where the contact works (e.g., Legal, Finance, Content Operations, Business Development). | Column department (STRING) in partner.partner_contact']
  email_address varchar [note: 'Primary email address for the partner contact. Used for official communications, contract negotiations, and business correspondence. | Column email_address (STRING) in partner.partner_contact']
  end_date date [note: 'The date when this individual ceased to be an active contact, either due to role change, departure from the partner organization, or relationship termination. | Column end_date (DATE) in partner.partner_contact']
  first_name varchar [note: 'The first name or given name of the partner contact individual. | Column first_name (STRING) in partner.partner_contact']
  full_name varchar [note: 'The complete formatted name of the partner contact, typically combining first, middle, and last names. | Column full_name (STRING) in partner.partner_contact']
  is_primary_contact boolean [note: 'Boolean flag indicating whether this contact is the primary or main point of contact for the partner organization. | Column is_primary_contact (BOOLEAN) in partner.partner_contact']
  job_title varchar [note: 'The official job title or position of the contact within the partner organization (e.g., Vice President of Content Acquisition, Director of Business Development, Legal Counsel). | Column job_title (STRING) in partner.partner_contact']
  last_contact_date date [note: 'The date of the most recent business interaction or communication with this partner contact. Used for relationship health tracking. | Column last_contact_date (DATE) in partner.partner_contact']
  last_name varchar [note: 'The last name or family name of the partner contact individual. | Column last_name (STRING) in partner.partner_contact']
  linkedin_profile_url varchar [note: 'The URL to the contacts professional LinkedIn profile, used for professional networking and background verification. | Column linkedin_profile_url (STRING) in partner.partner_contact']
  mobile_number varchar [note: 'Mobile or cell phone number for the partner contact, used for urgent communications and on-the-go accessibility. | Column mobile_number (STRING) in partner.partner_contact']
  nda_signed_date date [note: 'The date when the contact signed a non-disclosure agreement with Media Broadcasting, if applicable. Used to track confidentiality obligations. | Column nda_signed_date (DATE) in partner.partner_contact']
  next_scheduled_contact_date date [note: 'The planned date for the next scheduled interaction or follow-up with this partner contact. Supports proactive relationship management. | Column next_scheduled_contact_date (DATE) in partner.partner_contact']
  notes varchar [note: 'Free-form text field for capturing additional information, preferences, interaction history, or special considerations related to the partner contact. | Column notes (STRING) in partner.partner_contact']
  office_location varchar [note: 'The physical office location or city where the contact is based within the partner organization. | Column office_location (STRING) in partner.partner_contact']
  phone_number varchar [note: 'Primary business phone number for the partner contact, including country code and extension if applicable. | Column phone_number (STRING) in partner.partner_contact']
  preferred_communication_method varchar [note: 'The contacts preferred method of communication for business interactions and negotiations. | Column preferred_communication_method (STRING) in partner.partner_contact']
  role_type varchar [note: 'The functional role category of the contact within the partnership context. Defines the primary area of responsibility and engagement. [ENUM-REF-CANDIDATE: executive|legal|business_development|technical|finance|operations|marketing — 7 candidates stripped; promote to reference product] | Column role_type (STRING) in partner.partner_contact']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.partner_contact']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.partner_contact']
  start_date date [note: 'The date when this individual became a contact for the partner organization or when the relationship with Media Broadcasting began. | Column start_date (DATE) in partner.partner_contact']
  time_zone varchar [note: 'The time zone where the contact is primarily located, using IANA time zone database format (e.g., America/New_York, Europe/London). Used for scheduling meetings and calls. | Column time_zone (STRING) in partner.partner_contact']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.partner_contact']
  updated_by varchar [note: 'The user identifier or name of the person who last modified this partner contact record. | Column updated_by (STRING) in partner.partner_contact']
  updated_timestamp timestamp [note: 'The timestamp when this partner contact record was last modified. Used for audit trail and change tracking. | Column updated_timestamp (TIMESTAMP) in partner.partner_contact']
  created_by varchar [note: 'The user identifier or name of the person who created this partner contact record in the system. | Column created_by (STRING) in partner.partner_contact']

  Note: 'Individual contacts associated with a partner organization — executives, legal representatives, business development leads, technical liaisons, and finance contacts. Tracks name, title, role type, communication preferences, and relationship owner within Media Broadcasting. Supports negotiation workflows and partner relationship management. | Unity Catalog table: media_broadcasting_ecm.partner.partner_contact'
}

Table partner.acquisition_deal {
  acquisition_deal_id varchar [pk, note: 'Unique identifier for the content acquisition deal. Primary key for the acquisition deal entity. | Column acquisition_deal_id (BIGINT) in partner.acquisition_deal']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Acquisition deals for broadcast distribution must verify licensed coverage matches contracted territories. Compliance officers cross-reference deal territories against FCC-licensed footprints to ensur | Column broadcast_license_id (BIGINT) in compliance.acquisition_deal']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Acquisition deals often specify target broadcast channels for content placement (e.g., primetime slot on flagship channel). Critical for content scheduling coordination, deal fulfillment tracking, and | Column channel_id (BIGINT) in scheduling.acquisition_deal']
  cost_center_id varchar [note: 'Foreign key linking to finance.cost_center. Business justification: Content acquisition costs are allocated to cost centers for budget management, variance analysis, and content spend tracking. Essential for production vs. acquisition cost analysis and departmental bu | Column cost_center_id (BIGINT) in finance.acquisition_deal']
  demographic_segment_id varchar [note: 'Foreign key linking to audience.demographic_segment. Business justification: Acquisition deals are evaluated and priced based on target demographic appeal of the content being acquired. Essential for content acquisition ROI analysis and portfolio strategy. | Column demographic_segment_id (BIGINT) in audience.acquisition_deal']
  employee_id varchar [note: 'Reference to the internal business development or acquisitions executive responsible for negotiating and managing this deal. | Column employee_id (BIGINT) in workforce.acquisition_deal']
  legal_entity_id varchar [note: 'Reference to the broadcaster\'s legal entity that is the contracting party for this acquisition deal, relevant for multi-entity corporate structures. | Column legal_entity_id (BIGINT) in finance.acquisition_deal']
  partner_id varchar [note: 'Reference to the studio, syndicator, or independent content provider from whom content is being acquired. Links to partner master data. | Column partner_id (BIGINT) in partner.acquisition_deal']
  profit_center_id varchar [note: 'Foreign key linking to finance.profit_center. Business justification: Acquisition deals impact specific profit center EBITDA through content amortization and revenue generation. Critical for segment P&L reporting, content ROI analysis, and business unit performance meas | Column profit_center_id (BIGINT) in finance.acquisition_deal']
  source_opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Acquisition deals for content rights often originate from identified sales opportunities when proactively pursuing content for the portfolio. Tracks deal pipeline from opportunity identification throu | Column source_opportunity_id (BIGINT) in sales.acquisition_deal']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.acquisition_deal']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.acquisition_deal']
  content_delivery_format varchar [note: 'Technical specifications for content delivery including file formats, resolution standards, and delivery methods (e.g., HD 1080p ProRes, 4K HEVC, physical media, digital file transfer). | Column content_delivery_format (STRING) in partner.acquisition_deal']
  content_package_scope varchar [note: 'Detailed description of the content included in this acquisition deal, including series titles, episode counts, seasons, or film packages. | Column content_package_scope (STRING) in partner.acquisition_deal']
  contract_document_reference varchar [note: 'Reference identifier or file path to the executed contract document stored in the document management system. | Column contract_document_reference (STRING) in partner.acquisition_deal']
  contract_execution_date date [note: 'Date when the acquisition deal contract was formally signed and executed by all parties, marking the transition from negotiation to binding agreement. | Column contract_execution_date (DATE) in partner.acquisition_deal']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.acquisition_deal']
  created_timestamp timestamp [note: 'Timestamp when this acquisition deal record was first created in the system, supporting audit trail and data lineage requirements. | Column created_timestamp (TIMESTAMP) in partner.acquisition_deal']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this acquisition deal (e.g., USD, GBP, EUR). | Column currency_code (STRING) in partner.acquisition_deal']
  deal_effective_date date [note: 'Date when the acquisition deal terms become effective and rights begin to accrue, which may differ from execution date. | Column deal_effective_date (DATE) in partner.acquisition_deal']
  deal_expiration_date date [note: 'Date when the acquisition deal expires and rights revert to the content provider, marking the end of the license period. | Column deal_expiration_date (DATE) in partner.acquisition_deal']
  deal_number varchar [note: 'Externally-known business identifier for the acquisition deal, typically formatted with prefix and sequential number for tracking and reference in contracts and communications. | Column deal_number (STRING) in partner.acquisition_deal']
  deal_status varchar [note: 'Current lifecycle status of the acquisition deal from initial draft through negotiation, execution, and eventual expiration or termination. [ENUM-REF-CANDIDATE: draft|negotiation|legal_review|approved|executed|active|expired|terminated|cancelled — 9 candidates stripped; promote to reference product] | Column deal_status (STRING) in partner.acquisition_deal']
  deal_title varchar [note: 'Human-readable name or title of the acquisition deal, typically reflecting the content package or series being acquired. | Column deal_title (STRING) in partner.acquisition_deal']
  deal_type varchar [note: 'Classification of the deal structure indicating the financial arrangement: flat fee (fixed payment), revenue share (percentage of revenue), minimum guarantee (MG with upside), hybrid (combination), or barter (exchange of services/inventory). | Column deal_type (STRING) in partner.acquisition_deal']
  deal_value_amount decimal(18,2) [note: 'Total monetary value of the acquisition deal in the specified currency, representing the gross commitment before adjustments. | Column deal_value_amount (DECIMAL(18,2)) in partner.acquisition_deal']
  distribution_rights varchar [note: 'Comma-separated list of distribution platforms and methods covered by this deal (e.g., linear, SVOD, AVOD, TVOD, FAST, syndication, VOD). | Column distribution_rights (STRING) in partner.acquisition_deal']
  episode_count varchar [note: 'Total number of episodes included in the acquisition deal for episodic content such as television series. | Column episode_count (INT) in partner.acquisition_deal']
  exclusivity_flag boolean [note: 'Indicates whether the acquisition deal grants exclusive rights within the specified territory, preventing the content provider from licensing to competitors. | Column exclusivity_flag (BOOLEAN) in partner.acquisition_deal']
  exclusivity_scope varchar [note: 'Detailed description of exclusivity terms, including platform restrictions, genre exclusivity, or time-based exclusivity windows. | Column exclusivity_scope (STRING) in partner.acquisition_deal']
  holdback_period_days varchar [note: 'Number of days during which content must be withheld from certain distribution channels or platforms as part of windowing strategy or exclusivity terms. | Column holdback_period_days (INT) in partner.acquisition_deal']
  last_modified_timestamp timestamp [note: 'Timestamp when this acquisition deal record was most recently updated, supporting audit trail and change tracking requirements. | Column last_modified_timestamp (TIMESTAMP) in partner.acquisition_deal']
  license_term_months varchar [note: 'Duration of the content license in months, representing the period during which the broadcaster has rights to exploit the acquired content. | Column license_term_months (INT) in partner.acquisition_deal']
  marketing_materials_included_flag boolean [note: 'Indicates whether the deal includes delivery of marketing and promotional materials such as trailers, key art, press kits, and promotional clips. | Column marketing_materials_included_flag (BOOLEAN) in partner.acquisition_deal']
  metadata_requirements varchar [note: 'Specifications for content metadata to be delivered with the content package, including descriptive, technical, and rights metadata standards. | Column metadata_requirements (STRING) in partner.acquisition_deal']
  minimum_guarantee_amount decimal(18,2) [note: 'Minimum guaranteed payment to the content provider regardless of performance, applicable for minimum guarantee and hybrid deal structures. | Column minimum_guarantee_amount (DECIMAL(18,2)) in partner.acquisition_deal']
  negotiation_start_date date [note: 'Date when formal negotiations for this acquisition deal commenced. | Column negotiation_start_date (DATE) in partner.acquisition_deal']
  notes varchar [note: 'Free-form text field for additional notes, special terms, or contextual information about the acquisition deal not captured in structured fields. | Column notes (STRING) in partner.acquisition_deal']
  payment_schedule varchar [note: 'Detailed schedule of payment milestones and amounts, including upfront payments, delivery payments, and ongoing royalty schedules. | Column payment_schedule (STRING) in partner.acquisition_deal']
  performance_guarantees varchar [note: 'Contractual performance commitments such as minimum broadcast hours, promotional support, or audience delivery guarantees required by the content provider. | Column performance_guarantees (STRING) in partner.acquisition_deal']
  renewal_option_flag boolean [note: 'Indicates whether the broadcaster has the option to renew or extend the acquisition deal beyond the initial term. | Column renewal_option_flag (BOOLEAN) in partner.acquisition_deal']
  renewal_terms varchar [note: 'Detailed terms governing deal renewal, including notice periods, pricing adjustments, and conditions for exercising renewal options. | Column renewal_terms (STRING) in partner.acquisition_deal']
  revenue_share_percentage decimal(5,2) [note: 'Percentage of revenue shared with the content provider for revenue share and hybrid deal structures, typically applied after minimum guarantee recoupment. | Column revenue_share_percentage (DECIMAL(5,2)) in partner.acquisition_deal']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.acquisition_deal']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.acquisition_deal']
  sublicensing_allowed_flag boolean [note: 'Indicates whether the broadcaster is permitted to sublicense the acquired content to third parties such as MVPDs, vMVPDs, or international distributors. | Column sublicensing_allowed_flag (BOOLEAN) in partner.acquisition_deal']
  sublicensing_terms varchar [note: 'Detailed terms and restrictions governing sublicensing rights, including revenue sharing with original content provider and territorial limitations. | Column sublicensing_terms (STRING) in partner.acquisition_deal']
  territory_coverage varchar [note: 'Geographic territories or markets covered by this acquisition deal, specified as comma-separated ISO 3166-1 alpha-3 country codes or regional designations (e.g., USA, CAN, GBR, or NORTH_AMERICA). | Column territory_coverage (STRING) in partner.acquisition_deal']
  total_runtime_hours decimal(10,2) [note: 'Aggregate runtime of all content included in the acquisition deal, measured in hours, used for inventory planning and scheduling. | Column total_runtime_hours (DECIMAL(10,2)) in partner.acquisition_deal']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.acquisition_deal']
  windowing_strategy varchar [note: 'Sequential release strategy defining the order and timing of content availability across different platforms and distribution channels. | Column windowing_strategy (STRING) in partner.acquisition_deal']

  Note: 'Master record for content acquisition deals negotiated with studios, syndicators, and independent content providers. Captures deal structure (flat fee, revenue share, MG/minimum guarantee), content package scope, exclusivity terms, territory coverage, windowing strategy (SVOD, AVOD, TVOD, linear), and deal status through the full negotiation-to-execution lifecycle. Source of truth for content acquisition commitments feeding into the rights and finance domains. | Unity Catalog table: media_broadcasting_ecm.partner.acquisition_deal'
}

Table partner.acquisition_deal_line {
  acquisition_deal_line_id varchar [pk, note: 'Unique identifier for the acquisition deal line item. Primary key for this entity. | Column acquisition_deal_line_id (BIGINT) in partner.acquisition_deal_line']
  acquisition_deal_id varchar [note: 'Reference to the parent acquisition deal that contains this line item. Links this line to the master deal agreement. | Column acquisition_deal_id (BIGINT) in partner.acquisition_deal_line']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Individual titles and episodes in acquisition deal lines have specific rating requirements for the licensed territory and platform. Compliance verification at the line-item level ensures each delivere | Column compliance_content_rating_id (BIGINT) in compliance.acquisition_deal_line']
  content_title_id varchar [note: 'Reference to the specific content title, episode, season, or package being acquired in this line item. | Column content_title_id (BIGINT) in content.acquisition_deal_line']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Deal lines license specific assets, not just titles. MAM systems must link assets to deal lines for automated rights validation, windowing enforcement, royalty calculation, and compliance reporting in | Column media_asset_id (BIGINT) in mediaasset.acquisition_deal_line']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Content acquisition deals often include attached talent as a key deal point—star power drives content valuation and marketing strategy. Essential for deal valuation models, marketing rights clearance, | Column talent_profile_id (BIGINT) in talent.acquisition_deal_line']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.acquisition_deal_line']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.acquisition_deal_line']
  content_rating varchar [note: 'Age or content rating classification for this content line item (e.g., G, PG, PG-13, R, TV-Y, TV-PG, TV-14, TV-MA). Determines broadcast daypart and audience targeting. | Column content_rating (STRING) in partner.acquisition_deal_line']
  content_type varchar [note: 'Classification of the content being acquired in this line item. Determines rights structure and windowing strategy. [ENUM-REF-CANDIDATE: film|series|season|episode|documentary|special|sports_event|news_package|music_video|short_form — 10 candidates stripped; promote to reference product] | Column content_type (STRING) in partner.acquisition_deal_line']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.acquisition_deal_line']
  created_by_user varchar [note: 'Username or identifier of the user who created this acquisition deal line record. Supports audit and accountability. | Column created_by_user (STRING) in partner.acquisition_deal_line']
  created_timestamp timestamp [note: 'Timestamp when this acquisition deal line record was first created in the system. Audit trail for data lineage. | Column created_timestamp (TIMESTAMP) in partner.acquisition_deal_line']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this line item. | Column currency_code (STRING) in partner.acquisition_deal_line']
  delivery_due_date date [note: 'The date by which the content provider must deliver the content asset for this line item. Critical for production scheduling and playout planning. | Column delivery_due_date (DATE) in partner.acquisition_deal_line']
  delivery_format varchar [note: 'Technical format and delivery method for the content asset associated with this line item. Determines ingest and playout requirements. [ENUM-REF-CANDIDATE: hd|4k|sd|film|digital_file|tape|satellite|ftp|aspera|physical_media — 10 candidates stripped; promote to reference product] | Column delivery_format (STRING) in partner.acquisition_deal_line']
  delivery_status varchar [note: 'Current status of content delivery for this line item. Tracks the fulfillment lifecycle from order to ingest. | Column delivery_status (STRING) in partner.acquisition_deal_line']
  distribution_rights varchar [note: 'Comma-separated list of distribution rights granted for this content line item. May include linear, VOD, SVOD, AVOD, TVOD, theatrical, home video, digital download, streaming, broadcast, cable, satellite, OTT, FAST, syndication, etc. [ENUM-REF-CANDIDATE: promote to reference product and junction table for complex rights matrices] | Column distribution_rights (STRING) in partner.acquisition_deal_line']
  dubbing_languages varchar [note: 'Comma-separated list of ISO 639 language codes for dubbed audio tracks included with this content line item. Supports multi-territory distribution. | Column dubbing_languages (STRING) in partner.acquisition_deal_line']
  eidr_identifier varchar [note: 'Unique EIDR identifier for the content in this line item. Global standard for audiovisual content identification. | Column eidr_identifier (STRING) in partner.acquisition_deal_line']
  episode_count varchar [note: 'Number of episodes included in this line item if the content type is series or season. Null for single-title content. | Column episode_count (INT) in partner.acquisition_deal_line']
  exclusivity_flag boolean [note: 'Indicates whether the rights granted for this line item are exclusive (true) or non-exclusive (false). Impacts windowing and competitive distribution. | Column exclusivity_flag (BOOLEAN) in partner.acquisition_deal_line']
  genre_primary varchar [note: 'Primary genre classification for the content in this line item. Used for programming strategy and audience analytics. | Column genre_primary (STRING) in partner.acquisition_deal_line']
  holdback_restrictions varchar [note: 'Description of any holdback periods or exclusivity restrictions that limit when or how this content can be exploited. Includes blackout periods and sequential windowing constraints. | Column holdback_restrictions (STRING) in partner.acquisition_deal_line']
  language_code varchar [note: 'Primary language of the content in this line item. ISO 639 two or three-letter language code. | Column language_code (STRING) in partner.acquisition_deal_line']
  license_duration_months varchar [note: 'Total duration of the license term expressed in months. Calculated from start and end dates for reporting and windowing analysis. | Column license_duration_months (INT) in partner.acquisition_deal_line']
  license_fee_amount decimal(18,2) [note: 'The base license fee amount for this specific content line item. Represents the core acquisition cost before adjustments. | Column license_fee_amount (DECIMAL(18,2)) in partner.acquisition_deal_line']
  license_term_end_date date [note: 'The date when the license rights for this content line item expire. Marks the end of the rights window. | Column license_term_end_date (DATE) in partner.acquisition_deal_line']
  license_term_start_date date [note: 'The date when the license rights for this content line item become effective. Marks the beginning of the rights window. | Column license_term_start_date (DATE) in partner.acquisition_deal_line']
  line_number varchar [note: 'Sequential line number within the parent acquisition deal. Used for ordering and referencing specific line items within the deal. | Column line_number (INT) in partner.acquisition_deal_line']
  line_status varchar [note: 'Current lifecycle status of this acquisition deal line item. Tracks progression from negotiation through fulfillment and expiration. | Column line_status (STRING) in partner.acquisition_deal_line']
  minimum_guarantee_amount decimal(18,2) [note: 'Minimum guarantee payment amount for this line item. Represents the floor payment regardless of performance or usage. | Column minimum_guarantee_amount (DECIMAL(18,2)) in partner.acquisition_deal_line']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this acquisition deal line record. Supports audit and accountability. | Column modified_by_user (STRING) in partner.acquisition_deal_line']
  modified_timestamp timestamp [note: 'Timestamp when this acquisition deal line record was last modified. Audit trail for change tracking. | Column modified_timestamp (TIMESTAMP) in partner.acquisition_deal_line']
  notes varchar [note: 'Free-text notes or comments related to this acquisition deal line item. Captures special terms, exceptions, or operational instructions. | Column notes (STRING) in partner.acquisition_deal_line']
  payment_schedule varchar [note: 'Payment structure for this line item. Defines when and how license fees and guarantees are paid to the content provider. | Column payment_schedule (STRING) in partner.acquisition_deal_line']
  payment_terms_days varchar [note: 'Number of days from invoice or delivery milestone until payment is due for this line item. Standard commercial payment terms. | Column payment_terms_days (INT) in partner.acquisition_deal_line']
  production_year varchar [note: 'Year the content was originally produced or released. Used for catalog management and rights valuation. | Column production_year (INT) in partner.acquisition_deal_line']
  royalty_rate_percent decimal(5,2) [note: 'Percentage rate for revenue-sharing or usage-based royalty payments on this content line item. Applied to calculate residuals beyond minimum guarantee. | Column royalty_rate_percent (DECIMAL(5,2)) in partner.acquisition_deal_line']
  runs_allowed varchar [note: 'Maximum number of broadcast or exhibition runs permitted for this content line item during the license term. Null indicates unlimited runs. | Column runs_allowed (INT) in partner.acquisition_deal_line']
  runtime_minutes varchar [note: 'Total runtime duration in minutes for the content in this line item. Used for scheduling and inventory management. | Column runtime_minutes (INT) in partner.acquisition_deal_line']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.acquisition_deal_line']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.acquisition_deal_line']
  subtitle_languages varchar [note: 'Comma-separated list of ISO 639 language codes for subtitles or closed captions included with this content line item. Supports accessibility and localization requirements. | Column subtitle_languages (STRING) in partner.acquisition_deal_line']
  territory_code varchar [note: 'Geographic territory or market where rights are granted for this content line item. May be country code, region code, or multi-territory identifier. [ENUM-REF-CANDIDATE: promote to reference product for complex territory hierarchies] | Column territory_code (STRING) in partner.acquisition_deal_line']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.acquisition_deal_line']

  Note: 'Individual line items within a content acquisition deal, each representing a specific title, episode, season, or content package with its own financial terms, window schedule, territory rights, and delivery obligations. Enables granular tracking of per-title economics within a multi-title deal and feeds rights windowing and royalty calculation processes. | Unity Catalog table: media_broadcasting_ecm.partner.acquisition_deal_line'
}

Table partner.distribution_agreement {
  distribution_agreement_id varchar [pk, note: 'Unique identifier for the distribution agreement. Primary key. | Column distribution_agreement_id (BIGINT) in partner.distribution_agreement']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Distribution agreements for linear broadcast channels reference specific licensed facilities. Retransmission consent agreements, carriage deals, and network distribution contracts all specify call sig | Column broadcast_license_id (BIGINT) in compliance.distribution_agreement']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Distribution agreements specify which channels carry content (e.g., cable carriage agreements, affiliate distribution). Fundamental to carriage fee calculation, must-carry compliance, channel position | Column channel_id (BIGINT) in scheduling.distribution_agreement']
  contracting_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Distribution agreements are executed by specific legal entities for proper revenue recognition, tax jurisdiction determination, and SOX compliance. Essential for carriage fee revenue allocation and in | Column contracting_legal_entity_id (BIGINT) in finance.distribution_agreement']
  market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: Distribution agreements specify which DMAs/markets the partner can distribute content in. Essential for territorial rights management and ensuring distribution partners operate within contracted geogr | Column market_coverage_id (BIGINT) in audience.distribution_agreement']
  partner_id varchar [note: 'Reference to the distribution partner (MVPD, vMVPD, cable operator, satellite provider, OTT aggregator) that is party to this agreement. | Column partner_id (BIGINT) in partner.distribution_agreement']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.distribution_agreement']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.distribution_agreement']
  agreement_number varchar [note: 'Externally-known business identifier for the distribution agreement, used in contracts and communications with distribution partners. | Column agreement_number (STRING) in partner.distribution_agreement']
  agreement_status varchar [note: 'Current lifecycle status of the distribution agreement indicating its operational state. [ENUM-REF-CANDIDATE: draft|negotiation|active|suspended|terminated|expired|renewal_pending — 7 candidates stripped; promote to reference product] | Column agreement_status (STRING) in partner.distribution_agreement']
  agreement_type varchar [note: 'Classification of the distribution agreement based on the nature of the relationship and regulatory framework (e.g., carriage, retransmission consent, must-carry, syndication, OTT distribution, affiliate). | Column agreement_type (STRING) in partner.distribution_agreement']
  approval_date date [note: 'Date when the distribution agreement received final internal approval before execution. | Column approval_date (DATE) in partner.distribution_agreement']
  approved_by varchar [note: 'Name or identifier of the executive who provided final approval for this distribution agreement. | Column approved_by (STRING) in partner.distribution_agreement']
  audit_rights_included boolean [note: 'Indicates whether Media Broadcasting retains the right to audit the distributors subscriber counts, revenue reports, and compliance with agreement terms. | Column audit_rights_included (BOOLEAN) in partner.distribution_agreement']
  blackout_restrictions varchar [note: 'Description of geographic or content-based blackout restrictions that apply to this distribution agreement (e.g., sports blackouts, regional exclusions). | Column blackout_restrictions (STRING) in partner.distribution_agreement']
  carriage_fee_amount decimal(15,2) [note: 'Base carriage fee amount per the agreement structure. Interpretation depends on carriage_fee_structure (e.g., per-subscriber monthly rate, annual flat fee). | Column carriage_fee_amount (DECIMAL(15,2)) in partner.distribution_agreement']
  carriage_fee_structure varchar [note: 'Pricing model for carriage fees paid by the distributor to Media Broadcasting (per-subscriber, flat rate, tiered, revenue share, hybrid). | Column carriage_fee_structure (STRING) in partner.distribution_agreement']
  channel_positioning_tier varchar [note: 'Service tier or package level where the channels must be positioned in the distributors lineup (basic, expanded basic, digital, premium, sports tier, custom). | Column channel_positioning_tier (STRING) in partner.distribution_agreement']
  channels_included varchar [note: 'List or description of Media Broadcasting channels covered by this distribution agreement (e.g., primary network, secondary channels, HD feeds, regional variants). | Column channels_included (STRING) in partner.distribution_agreement']
  contract_document_url varchar [note: 'URL or file path to the signed distribution agreement contract document stored in the document management system. | Column contract_document_url (STRING) in partner.distribution_agreement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.distribution_agreement']
  created_timestamp timestamp [note: 'Timestamp when this distribution agreement record was first created in the system. | Column created_timestamp (TIMESTAMP) in partner.distribution_agreement']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this agreement. | Column currency_code (STRING) in partner.distribution_agreement']
  effective_date date [note: 'Date when the distribution agreement becomes legally binding and operational. | Column effective_date (DATE) in partner.distribution_agreement']
  expiration_date date [note: 'Date when the distribution agreement terminates or expires. Nullable for evergreen agreements. | Column expiration_date (DATE) in partner.distribution_agreement']
  last_modified_timestamp timestamp [note: 'Timestamp when this distribution agreement record was last updated in the system. | Column last_modified_timestamp (TIMESTAMP) in partner.distribution_agreement']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum guaranteed payment amount from the distributor over the agreement term, regardless of actual subscriber counts or usage. | Column minimum_guarantee_amount (DECIMAL(15,2)) in partner.distribution_agreement']
  must_carry_obligation boolean [note: 'Indicates whether this agreement includes must-carry obligations under FCC regulations requiring the distributor to carry the broadcast signal. | Column must_carry_obligation (BOOLEAN) in partner.distribution_agreement']
  negotiated_by varchar [note: 'Name or identifier of the Media Broadcasting executive or team responsible for negotiating this distribution agreement. | Column negotiated_by (STRING) in partner.distribution_agreement']
  payment_terms_days varchar [note: 'Number of days from invoice date within which the distributor must remit carriage fees to Media Broadcasting. | Column payment_terms_days (INT) in partner.distribution_agreement']
  renewal_terms varchar [note: 'Description of renewal terms including automatic renewal provisions, notice periods, and renegotiation triggers. | Column renewal_terms (STRING) in partner.distribution_agreement']
  reporting_frequency varchar [note: 'Frequency at which the distributor must provide subscriber counts, viewership data, and revenue reports to Media Broadcasting. | Column reporting_frequency (STRING) in partner.distribution_agreement']
  retransmission_consent_granted boolean [note: 'Indicates whether Media Broadcasting has granted retransmission consent allowing the distributor to rebroadcast the signal. | Column retransmission_consent_granted (BOOLEAN) in partner.distribution_agreement']
  sla_response_time_hours varchar [note: 'Maximum response time in hours for addressing service disruptions or technical issues under the SLA. | Column sla_response_time_hours (INT) in partner.distribution_agreement']
  sla_uptime_percentage decimal(5,2) [note: 'Minimum uptime percentage guaranteed under the Service Level Agreement (SLA) for signal delivery and availability. | Column sla_uptime_percentage (DECIMAL(5,2)) in partner.distribution_agreement']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.distribution_agreement']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.distribution_agreement']
  streaming_rights_included boolean [note: 'Indicates whether the agreement includes rights for the distributor to offer live streaming or simulcast of Media Broadcasting channels via OTT platforms. | Column streaming_rights_included (BOOLEAN) in partner.distribution_agreement']
  svod_rights_included boolean [note: 'Indicates whether the agreement includes rights for the distributor to offer Subscription Video On Demand (SVOD) access as part of a subscription package. | Column svod_rights_included (BOOLEAN) in partner.distribution_agreement']
  termination_date date [note: 'Actual date when the agreement was terminated, if applicable. Nullable for active agreements. | Column termination_date (DATE) in partner.distribution_agreement']
  termination_notice_days varchar [note: 'Number of days advance notice required by either party to terminate the agreement prior to expiration. | Column termination_notice_days (INT) in partner.distribution_agreement']
  termination_reason varchar [note: 'Reason for early termination of the agreement, if applicable (e.g., breach of contract, mutual agreement, business closure). | Column termination_reason (STRING) in partner.distribution_agreement']
  territory varchar [note: 'Geographic territory or market covered by this distribution agreement. May include country codes, DMA codes, or regional descriptors. | Column territory (STRING) in partner.distribution_agreement']
  tvod_rights_included boolean [note: 'Indicates whether the agreement includes rights for the distributor to offer Transactional Video On Demand (TVOD) access where viewers pay per transaction. | Column tvod_rights_included (BOOLEAN) in partner.distribution_agreement']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.distribution_agreement']
  vod_rights_included boolean [note: 'Indicates whether the agreement includes rights for the distributor to offer Video On Demand (VOD) access to Media Broadcasting content. | Column vod_rights_included (BOOLEAN) in partner.distribution_agreement']
  vod_window_days varchar [note: 'Number of days that content remains available in the distributors VOD library after initial broadcast, if VOD rights are included. | Column vod_window_days (INT) in partner.distribution_agreement']

  Note: 'Formal distribution agreements with MVPDs, vMVPDs, cable operators, satellite providers, and OTT aggregators governing carriage of Media Broadcasting channels and content. Tracks carriage fee structures, must-carry obligations, retransmission consent terms, blackout restrictions, channel positioning commitments, and SLA obligations. Distinct from content acquisition deals — this governs outbound distribution rather than inbound content. | Unity Catalog table: media_broadcasting_ecm.partner.distribution_agreement'
}

Table partner.syndication_agreement {
  syndication_agreement_id varchar [pk, note: 'Unique identifier for the syndication agreement. Primary key. | Column syndication_agreement_id (BIGINT) in partner.syndication_agreement']
  broadcast_license_id varchar [note: 'Foreign key linking to compliance.broadcast_license. Business justification: Syndication agreements for broadcast distribution require the syndicating station to hold valid FCC licenses covering the agreed territories. Clearance obligations and territorial exclusivity are defi | Column broadcast_license_id (BIGINT) in compliance.syndication_agreement']
  channel_id varchar [note: 'Foreign key linking to scheduling.channel. Business justification: Syndication deals specify broadcast channels for content airing (e.g., off-network syndication to local stations). Essential for syndication scheduling, clearance tracking, run limit enforcement, and  | Column channel_id (BIGINT) in scheduling.syndication_agreement']
  compliance_content_rating_id varchar [note: 'Foreign key linking to compliance.content_rating. Business justification: Syndication agreements specify acceptable content ratings for target dayparts and audience demographics. Syndicators require content rated appropriately for early fringe, access, or late-night windows | Column compliance_content_rating_id (BIGINT) in compliance.syndication_agreement']
  content_title_id varchar [note: 'Reference to the primary content title being syndicated under this agreement. | Column content_title_id (BIGINT) in content.syndication_agreement']
  contracting_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Syndication deals require legal entity tracking for revenue allocation, tax treatment, and intercompany elimination. Critical for ASC 606 performance obligation tracking and multi-territory revenue re | Column contracting_legal_entity_id (BIGINT) in finance.syndication_agreement']
  coppa_declaration_id varchar [note: 'Foreign key linking to compliance.coppa_declaration. Business justification: Syndication of children\'s programming requires COPPA declarations covering data collection practices on associated digital platforms, companion websites, and mobile apps. Syndicators must ensure stati | Column coppa_declaration_id (BIGINT) in compliance.syndication_agreement']
  market_coverage_id varchar [note: 'Foreign key linking to audience.market_coverage. Business justification: Syndication agreements grant rights to specific markets/DMAs. Essential for syndication clearance tracking and ensuring syndication partners broadcast only in contracted markets. | Column market_coverage_id (BIGINT) in audience.syndication_agreement']
  media_asset_id varchar [note: 'Foreign key linking to mediaasset.media_asset. Business justification: Syndication agreements grant rights to specific asset packages (e.g., 100-episode library). Direct asset link enables automated rights clearance in playout systems, run-limit enforcement, and syndicat | Column media_asset_id (BIGINT) in mediaasset.syndication_agreement']
  negotiated_by_employee_id varchar [note: 'Reference to the Media Broadcasting employee who negotiated and finalized this syndication agreement. | Column negotiated_by_employee_id (BIGINT) in workforce.syndication_agreement']
  source_opportunity_id varchar [note: 'Foreign key linking to sales.opportunity. Business justification: Syndication agreements for selling content distribution rights originate from sales opportunities when the sales team identifies potential syndication partners. Links the sales pipeline to executed sy | Column source_opportunity_id (BIGINT) in sales.syndication_agreement']
  syndication_partner_id varchar [note: 'Reference to the third-party broadcaster, regional station, or international network acquiring syndication rights. | Column syndication_partner_id (BIGINT) in partner.syndication_agreement']
  talent_profile_id varchar [note: 'Foreign key linking to talent.talent_profile. Business justification: Syndication deals may require talent consent/clearance for promotional use and residual payment routing, especially for above-the-line talent with approval rights. Essential for talent clearance workf | Column talent_profile_id (BIGINT) in talent.syndication_agreement']
  _created_at timestamp [note: 'Medallion lineage column for _created_at | Column _created_at (TIMESTAMP) in partner.syndication_agreement']
  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in partner.syndication_agreement']
  agreement_number varchar [note: 'Externally-known business identifier for the syndication agreement, used in contracts and communications with syndication partners. | Column agreement_number (STRING) in partner.syndication_agreement']
  agreement_status varchar [note: 'Current lifecycle status of the syndication agreement. [ENUM-REF-CANDIDATE: draft|negotiation|pending_approval|active|suspended|terminated|expired — 7 candidates stripped; promote to reference product] | Column agreement_status (STRING) in partner.syndication_agreement']
  agreement_type varchar [note: 'Classification of the syndication agreement based on geographic scope and compensation structure. | Column agreement_type (STRING) in partner.syndication_agreement']
  audit_rights_flag boolean [note: 'Indicates whether Media Broadcasting retains the right to audit the syndication partner\'s broadcast logs and financial records. | Column audit_rights_flag (BOOLEAN) in partner.syndication_agreement']
  barter_spot_count varchar [note: 'Number of advertising spots retained by Media Broadcasting per episode in barter syndication arrangements. | Column barter_spot_count (INT) in partner.syndication_agreement']
  broadcast_standard varchar [note: 'Technical broadcast standard required for content delivery in the syndication territory. | Column broadcast_standard (STRING) in partner.syndication_agreement']
  clearance_obligation varchar [note: 'Party responsible for obtaining broadcast clearances and rights verification in the syndication territory. | Column clearance_obligation (STRING) in partner.syndication_agreement']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in partner.syndication_agreement']
  created_timestamp timestamp [note: 'Timestamp when this syndication agreement record was first created in the system. | Column created_timestamp (TIMESTAMP) in partner.syndication_agreement']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this agreement. | Column currency_code (STRING) in partner.syndication_agreement']
  delivery_format varchar [note: 'Technical format and specifications for content delivery to the syndication partner (e.g., HD 1080p, 4K, file-based, tape). | Column delivery_format (STRING) in partner.syndication_agreement']
  effective_end_date date [note: 'Date when the syndication agreement expires and content rights revert. Nullable for open-ended agreements subject to termination clauses. | Column effective_end_date (DATE) in partner.syndication_agreement']
  effective_start_date date [note: 'Date when the syndication agreement becomes binding and content rights become available for syndication. | Column effective_start_date (DATE) in partner.syndication_agreement']
  episode_count varchar [note: 'Total number of episodes included in the syndication agreement. Applicable for series content. | Column episode_count (INT) in partner.syndication_agreement']
  exclusivity_flag boolean [note: 'Indicates whether the syndication partner has exclusive broadcast rights in the granted territory during the agreement period. | Column exclusivity_flag (BOOLEAN) in partner.syndication_agreement']
  exclusivity_window_end_date date [note: 'End date of the exclusivity period. Nullable if exclusivity_flag is false. | Column exclusivity_window_end_date (DATE) in partner.syndication_agreement']
  exclusivity_window_start_date date [note: 'Start date of the exclusivity period during which no other syndication partner may broadcast the content in the granted territory. Nullable if exclusivity_flag is false. | Column exclusivity_window_start_date (DATE) in partner.syndication_agreement']
  flat_fee_amount decimal(15,2) [note: 'Total flat fee amount for the entire syndication agreement. Applicable when syndication_fee_structure is flat_fee or hybrid. | Column flat_fee_amount (DECIMAL(15,2)) in partner.syndication_agreement']
  holdback_period_days varchar [note: 'Number of days after original broadcast during which content cannot be syndicated, protecting the original broadcast window. | Column holdback_period_days (INT) in partner.syndication_agreement']
  last_modified_timestamp timestamp [note: 'Timestamp when this syndication agreement record was last updated. | Column last_modified_timestamp (TIMESTAMP) in partner.syndication_agreement']
  minimum_guarantee_amount decimal(15,2) [note: 'Minimum guaranteed payment amount regardless of actual revenue or performance. Applicable in revenue-share agreements. | Column minimum_guarantee_amount (DECIMAL(15,2)) in partner.syndication_agreement']
  notes varchar [note: 'Free-form notes capturing special terms, amendments, or contextual information about the syndication agreement. | Column notes (STRING) in partner.syndication_agreement']
  payment_terms varchar [note: 'Detailed payment schedule and terms, including milestones, installments, and due dates. | Column payment_terms (STRING) in partner.syndication_agreement']
  per_episode_fee_amount decimal(15,2) [note: 'Fee amount charged per episode. Applicable when syndication_fee_structure is per_episode or hybrid. | Column per_episode_fee_amount (DECIMAL(15,2)) in partner.syndication_agreement']
  performance_guarantee varchar [note: 'Minimum performance commitments required from the syndication partner, such as minimum broadcast frequency or audience reach targets. | Column performance_guarantee (STRING) in partner.syndication_agreement']
  renewal_notice_days varchar [note: 'Number of days prior to expiration that the syndication partner must provide notice to exercise renewal option. | Column renewal_notice_days (INT) in partner.syndication_agreement']
  renewal_option_flag boolean [note: 'Indicates whether the syndication partner has an option to renew the agreement upon expiration. | Column renewal_option_flag (BOOLEAN) in partner.syndication_agreement']
  reporting_frequency varchar [note: 'Frequency at which the syndication partner must provide broadcast logs, audience metrics, and revenue reports. | Column reporting_frequency (STRING) in partner.syndication_agreement']
  revenue_share_percentage decimal(5,2) [note: 'Percentage of advertising or subscription revenue shared with Media Broadcasting. Applicable when syndication_fee_structure is revenue_share or hybrid. | Column revenue_share_percentage (DECIMAL(5,2)) in partner.syndication_agreement']
  run_limit varchar [note: 'Maximum number of times each episode may be broadcast by the syndication partner during the agreement term. | Column run_limit (INT) in partner.syndication_agreement']
  signed_date date [note: 'Date when the syndication agreement was executed by all parties. | Column signed_date (DATE) in partner.syndication_agreement']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.syndication_agreement']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.syndication_agreement']
  syndication_fee_structure varchar [note: 'Compensation model governing how the syndication partner pays for content rights. | Column syndication_fee_structure (STRING) in partner.syndication_agreement']
  termination_clause varchar [note: 'Conditions and procedures under which either party may terminate the agreement prior to the effective end date. | Column termination_clause (STRING) in partner.syndication_agreement']
  territory_grant varchar [note: 'Geographic territories where the syndication partner is granted broadcast rights. Pipe-separated list of ISO 3166-1 alpha-3 country codes or regional designations. [ENUM-REF-CANDIDATE: USA|CAN|GBR|AUS|DEU|FRA|JPN|BRA|MEX|IND|CHN — promote to reference product] | Column territory_grant (STRING) in partner.syndication_agreement']
  updated_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column updated_at (TIMESTAMP) in partner.syndication_agreement']

  Note: 'Agreements governing the syndication of Media Broadcasting content to third-party broadcasters, regional stations, and international networks. Captures syndication fee structure, exclusivity windows, holdback periods, territory grants, episode count, run limitations, and clearance obligations. Feeds the scheduling and rights domains for cleared content availability. | Unity Catalog table: media_broadcasting_ecm.partner.syndication_agreement'
}

Table partner.coproduction_agreement {
  coproduction_agreement_id varchar [pk, note: 'Unique identifier for the co-production agreement record. Primary key. | Column coproduction_agreement_id (BIGINT) in partner.coproduction_agreement']
  contracting_legal_entity_id varchar [note: 'Foreign key linking to finance.legal_entity. Business justification: Co-production investments are capitalized and tracked at legal entity level for consolidation, IP ownership accounting, and residuals liability. Essential for balance sheet classification and intercom | Column contracting_legal_entity_id (BIGINT) in finance.coproduction_agreement']
