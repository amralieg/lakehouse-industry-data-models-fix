    rdfs:range xsd:string .

ind:utilizationReviewDate rdf:type rdf:Property ;
    rdfs:label 'Utilization Review Date' ;
    rdfs:comment 'The date when utilization patterns were reviewed for this re-credentialing event.' ;
    rdfs:domain ind:RecredentialingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:siteVisitResult rdf:type rdf:Property ;
    rdfs:label 'Site Visit Result' ;
    rdfs:comment 'The result of the site visit inspection.' ;
    rdfs:domain ind:RecredentialingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expeditedProcessing rdf:type rdf:Property ;
    rdfs:label 'Expedited Processing' ;
    rdfs:comment 'Indicates whether this re-credentialing event was processed on an expedited basis.' ;
    rdfs:domain ind:RecredentialingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:delegationOversightAuditDate rdf:type rdf:Property ;
    rdfs:label 'Delegation Oversight Audit Date' ;
    rdfs:comment 'The date of the most recent delegation oversight audit for this re-credentialing event.' ;
    rdfs:domain ind:RecredentialingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:networkEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Network Effective Date' ;
    rdfs:comment 'The effective date of the provider\'s network participation status following re-credentialing.' ;
    rdfs:domain ind:RecredentialingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conditionsOrRestrictions rdf:type rdf:Property ;
    rdfs:label 'Conditions Or Restrictions' ;
    rdfs:comment 'Any conditions or restrictions placed on the provider as a result of re-credentialing.' ;
    rdfs:domain ind:RecredentialingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedCredentialingSpecialist rdf:type rdf:Property ;
    rdfs:label 'Assigned Credentialing Specialist' ;
    rdfs:comment 'The name of the credentialing specialist assigned to this re-credentialing event.' ;
    rdfs:domain ind:RecredentialingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedCredentialingSpecialistId rdf:type rdf:Property ;
    rdfs:label 'Assigned Credentialing Specialist Id' ;
    rdfs:comment 'The unique identifier of the credentialing specialist assigned to this re-credentialing event.' ;
    rdfs:domain ind:RecredentialingEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CredentialingSpecialist .

ind:integrationType rdf:type rdf:Property ;
    rdfs:label 'Integration Type' ;
    rdfs:comment 'The type of data integration transaction performed with CAQH ProView, indicating the purpose and trigger of the data exchange.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrationStatus rdf:type rdf:Property ;
    rdfs:label 'Integration Status' ;
    rdfs:comment 'Current status of the CAQH ProView data integration transaction, tracking the lifecycle from initiation to completion.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:syncDate rdf:type rdf:Property ;
    rdfs:label 'Sync Date' ;
    rdfs:comment 'The business date on which the CAQH ProView data synchronization was performed, used for tracking and reporting purposes.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastSuccessfulSyncDate rdf:type rdf:Property ;
    rdfs:label 'Last Successful Sync Date' ;
    rdfs:comment 'The date of the most recent successful data synchronization with CAQH ProView for this provider, used to determine data freshness.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:apiEndpoint rdf:type rdf:Property ;
    rdfs:label 'Api Endpoint' ;
    rdfs:comment 'The specific CAQH ProView API endpoint URL used for this data integration transaction.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apiVersion rdf:type rdf:Property ;
    rdfs:label 'Api Version' ;
    rdfs:comment 'The version of the CAQH ProView API used for this integration transaction, ensuring compatibility and tracking API changes.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldsRequested rdf:type rdf:Property ;
    rdfs:label 'Fields Requested' ;
    rdfs:comment 'Comma-separated list of specific data fields requested from CAQH ProView in this integration transaction (e.g., licenses, certifications, malpractice insurance).' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldsRetrieved rdf:type rdf:Property ;
    rdfs:label 'Fields Retrieved' ;
    rdfs:comment 'Comma-separated list of data fields successfully retrieved from CAQH ProView in this integration transaction.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldsMissing rdf:type rdf:Property ;
    rdfs:label 'Fields Missing' ;
    rdfs:comment 'Comma-separated list of requested data fields that were not available or not returned by CAQH ProView, indicating data gaps.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profileStatus rdf:type rdf:Property ;
    rdfs:label 'Profile Status' ;
    rdfs:comment 'The current status of the provider\'s profile in CAQH ProView system at the time of data retrieval.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationDate rdf:type rdf:Property ;
    rdfs:label 'Authorization Date' ;
    rdfs:comment 'The date when the provider authorized UnitedHealthcare to access their CAQH ProView credentialing data.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responseMessage rdf:type rdf:Property ;
    rdfs:label 'Response Message' ;
    rdfs:comment 'Detailed response message returned by CAQH ProView API, providing additional context about the integration transaction outcome.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Retry Timestamp' ;
    rdfs:comment 'The date and time of the most recent retry attempt for this integration transaction.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:completenessPercentage rdf:type rdf:Property ;
    rdfs:label 'Completeness Percentage' ;
    rdfs:comment 'Percentage of requested fields that were successfully retrieved and populated from CAQH ProView.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:processingDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Processing Duration Seconds' ;
    rdfs:comment 'Total time in seconds taken to complete the CAQH ProView integration transaction from request to response.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:payloadSizeBytes rdf:type rdf:Property ;
    rdfs:label 'Payload Size Bytes' ;
    rdfs:comment 'Size of the data payload received from CAQH ProView in bytes, used for monitoring and capacity planning.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primarySourceVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Primary Source Verification Required' ;
    rdfs:comment 'Flag indicating whether primary source verification is required for the data retrieved from CAQH ProView.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseDataRetrieved rdf:type rdf:Property ;
    rdfs:label 'License Data Retrieved' ;
    rdfs:comment 'Flag indicating whether professional license information was successfully retrieved from CAQH ProView.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificationDataRetrieved rdf:type rdf:Property ;
    rdfs:label 'Certification Data Retrieved' ;
    rdfs:comment 'Flag indicating whether board certification information was successfully retrieved from CAQH ProView.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:educationDataRetrieved rdf:type rdf:Property ;
    rdfs:label 'Education Data Retrieved' ;
    rdfs:comment 'Flag indicating whether education and training information was successfully retrieved from CAQH ProView.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:malpracticeInsuranceDataRetrieved rdf:type rdf:Property ;
    rdfs:label 'Malpractice Insurance Data Retrieved' ;
    rdfs:comment 'Flag indicating whether professional liability/malpractice insurance information was successfully retrieved from CAQH ProView.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workHistoryDataRetrieved rdf:type rdf:Property ;
    rdfs:label 'Work History Data Retrieved' ;
    rdfs:comment 'Flag indicating whether employment and work history information was successfully retrieved from CAQH ProView.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionsDataRetrieved rdf:type rdf:Property ;
    rdfs:label 'Sanctions Data Retrieved' ;
    rdfs:comment 'Flag indicating whether sanctions and exclusions information was successfully retrieved from CAQH ProView.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deaDataRetrieved rdf:type rdf:Property ;
    rdfs:label 'Dea Data Retrieved' ;
    rdfs:comment 'Flag indicating whether DEA registration information was successfully retrieved from CAQH ProView.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalAffiliationsDataRetrieved rdf:type rdf:Property ;
    rdfs:label 'Hospital Affiliations Data Retrieved' ;
    rdfs:comment 'Flag indicating whether hospital affiliation and privileges information was successfully retrieved from CAQH ProView.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerReferencesDataRetrieved rdf:type rdf:Property ;
    rdfs:label 'Peer References Data Retrieved' ;
    rdfs:comment 'Flag indicating whether peer reference information was successfully retrieved from CAQH ProView.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataChangeDetected rdf:type rdf:Property ;
    rdfs:label 'Data Change Detected' ;
    rdfs:comment 'Flag indicating whether any changes were detected in the provider\'s CAQH data compared to the previous synchronization.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workflowTriggered rdf:type rdf:Property ;
    rdfs:label 'Workflow Triggered' ;
    rdfs:comment 'Flag indicating whether a downstream credentialing workflow was automatically triggered based on this integration transaction.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workflowStepId rdf:type rdf:Property ;
    rdfs:label 'Workflow Step Id' ;
    rdfs:comment 'Identifier of the downstream credentialing workflow that was triggered by this CAQH integration transaction.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkflowStep .

ind:dataStoredLocation rdf:type rdf:Property ;
    rdfs:label 'Data Stored Location' ;
    rdfs:comment 'File path or storage location where the raw CAQH ProView response data is archived for audit and compliance purposes.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:archiveRetentionDate rdf:type rdf:Property ;
    rdfs:label 'Archive Retention Date' ;
    rdfs:comment 'The date until which this CAQH integration transaction record must be retained per regulatory and compliance requirements.' ;
    rdfs:domain ind:CaqhIntegration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialingStatusId rdf:type rdf:Property ;
    rdfs:label 'Credentialing Status Id' ;
    rdfs:comment 'Unique identifier for the credentialing status code. Primary key for the credentialing status reference table.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CredentialingStatus .

ind:lifecycleStage rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Stage' ;
    rdfs:comment 'Specific stage within the credentialing lifecycle workflow indicating where the provider application stands in the review process.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowsClaimsSubmission rdf:type rdf:Property ;
    rdfs:label 'Allows Claims Submission' ;
    rdfs:comment 'Indicates whether providers with this credentialing status are permitted to submit claims for reimbursement.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsPatientAssignment rdf:type rdf:Property ;
    rdfs:label 'Allows Patient Assignment' ;
    rdfs:comment 'Indicates whether providers with this status can accept new patient assignments or Primary Care Physician (PCP) designations.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresCommitteeReview rdf:type rdf:Property ;
    rdfs:label 'Requires Committee Review' ;
    rdfs:comment 'Indicates whether this status requires formal credentialing committee review and approval before progression.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationTemplateCode rdf:type rdf:Property ;
    rdfs:label 'Notification Template Code' ;
    rdfs:comment 'Code identifying the standard notification template to be used when communicating this status change to providers.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Appeal Period Days' ;
    rdfs:comment 'Number of calendar days the provider has to file an appeal after being notified of this status assignment.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defaultDurationDays rdf:type rdf:Property ;
    rdfs:label 'Default Duration Days' ;
    rdfs:comment 'Standard number of days this status typically remains in effect before requiring review or automatic transition.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ncqaReportable rdf:type rdf:Property ;
    rdfs:label 'Ncqa Reportable' ;
    rdfs:comment 'Indicates whether this status must be reported to NCQA for accreditation and quality measurement purposes.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triggersSanctionsCheck rdf:type rdf:Property ;
    rdfs:label 'Triggers Sanctions Check' ;
    rdfs:comment 'Indicates whether assignment of this status automatically triggers sanctions screening against Office of Inspector General (OIG) and System for Award Management (SAM) exclusion lists.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triggersPrimarySourceVerification rdf:type rdf:Property ;
    rdfs:label 'Triggers Primary Source Verification' ;
    rdfs:comment 'Indicates whether this status requires initiation or renewal of primary source verification for licenses, certifications, and credentials.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triggersCaqhUpdate rdf:type rdf:Property ;
    rdfs:label 'Triggers Caqh Update' ;
    rdfs:comment 'Indicates whether this status change requires pulling updated provider data from the CAQH ProView credentialing database.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresMalpracticeVerification rdf:type rdf:Property ;
    rdfs:label 'Requires Malpractice Verification' ;
    rdfs:comment 'Indicates whether this status requires verification of current professional liability (malpractice) insurance coverage.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresDeaVerification rdf:type rdf:Property ;
    rdfs:label 'Requires Dea Verification' ;
    rdfs:comment 'Indicates whether this status requires verification of valid DEA registration for providers who prescribe controlled substances.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresBoardCertificationCheck rdf:type rdf:Property ;
    rdfs:label 'Requires Board Certification Check' ;
    rdfs:comment 'Indicates whether this status requires verification of board certification status with the appropriate medical specialty board.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsProvisionalPrivileges rdf:type rdf:Property ;
    rdfs:label 'Allows Provisional Privileges' ;
    rdfs:comment 'Indicates whether providers in this status can be granted provisional or temporary clinical privileges pending full credentialing completion.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:directoryListingAllowed rdf:type rdf:Property ;
    rdfs:label 'Directory Listing Allowed' ;
    rdfs:comment 'Indicates whether providers with this credentialing status can be listed in member-facing provider directories and search tools.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:effectiveDateRequired rdf:type rdf:Property ;
    rdfs:label 'Effective Date Required' ;
    rdfs:comment 'Indicates whether an explicit effective date must be recorded when assigning this status to a provider.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expirationDateRequired rdf:type rdf:Property ;
    rdfs:label 'Expiration Date Required' ;
    rdfs:comment 'Indicates whether an expiration or review date must be set when assigning this status to ensure timely recredentialing.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reasonCodeRequired rdf:type rdf:Property ;
    rdfs:label 'Reason Code Required' ;
    rdfs:comment 'Indicates whether a specific reason code must be documented when assigning this status to a provider.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportingDocumentationRequired rdf:type rdf:Property ;
    rdfs:label 'Supporting Documentation Required' ;
    rdfs:comment 'Indicates whether supporting documentation must be attached when assigning this credentialing status.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditTrailLevel rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Level' ;
    rdfs:comment 'Level of audit logging and tracking required for status changes, with enhanced levels for sensitive transitions like suspensions or terminations.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blocksContractExecution rdf:type rdf:Property ;
    rdfs:label 'Blocks Contract Execution' ;
    rdfs:comment 'Indicates whether this credentialing status prevents execution of new provider contracts or contract amendments.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:blocksPaymentProcessing rdf:type rdf:Property ;
    rdfs:label 'Blocks Payment Processing' ;
    rdfs:comment 'Indicates whether this status blocks payment processing for claims submitted by the provider.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaReportableEvent rdf:type rdf:Property ;
    rdfs:label 'Hipaa Reportable Event' ;
    rdfs:comment 'Indicates whether this status change constitutes a reportable event under HIPAA regulations requiring notification to affected parties.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDeprecated rdf:type rdf:Property ;
    rdfs:label 'Is Deprecated' ;
    rdfs:comment 'Indicates whether this status code is deprecated and should no longer be used for new credentialing assignments.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:replacementStatusCode rdf:type rdf:Property ;
    rdfs:label 'Replacement Status Code' ;
    rdfs:comment 'Code of the status that replaces this deprecated status for new assignments.' ;
    rdfs:domain ind:CredentialingStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeId rdf:type rdf:Property ;
    rdfs:label 'Fee Id' ;
    rdfs:comment 'Unique identifier for the credentialing fee transaction record.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:credentialingType rdf:type rdf:Property ;
    rdfs:label 'Credentialing Type' ;
    rdfs:comment 'The type of credentialing process for which the fee is charged (initial credentialing, re-credentialing, expedited review, emergency credentialing, or provisional credentialing).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amountPaid rdf:type rdf:Property ;
    rdfs:label 'Amount Paid' ;
    rdfs:comment 'The actual amount paid by the provider toward the credentialing fee.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:refundIndicator rdf:type rdf:Property ;
    rdfs:label 'Refund Indicator' ;
    rdfs:comment 'Indicates whether a refund was issued for this credentialing fee.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refundReason rdf:type rdf:Property ;
    rdfs:label 'Refund Reason' ;
    rdfs:comment 'The business reason or justification for issuing a refund of the credentialing fee.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeResolutionOutcome rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Outcome' ;
    rdfs:comment 'The outcome of the fee dispute resolution process.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Application Submission Date' ;
    rdfs:comment 'The date the provider submitted the credentialing or re-credentialing application.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Application Completion Date' ;
    rdfs:comment 'The date the credentialing application was deemed complete with all required documentation.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primarySourceVerificationIndicator rdf:type rdf:Property ;
    rdfs:label 'Primary Source Verification Indicator' ;
    rdfs:comment 'Indicates whether primary source verification was performed as part of the credentialing process for which this fee was charged.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionsScreeningIndicator rdf:type rdf:Property ;
    rdfs:label 'Sanctions Screening Indicator' ;
    rdfs:comment 'Indicates whether sanctions screening (OIG, SAM, state exclusion lists) was performed as part of the credentialing process.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expeditedProcessingIndicator rdf:type rdf:Property ;
    rdfs:label 'Expedited Processing Indicator' ;
    rdfs:comment 'Indicates whether expedited processing was requested and applied for this credentialing application.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:latePaymentFeeIndicator rdf:type rdf:Property ;
    rdfs:label 'Late Payment Fee Indicator' ;
    rdfs:comment 'Indicates whether a late payment fee was assessed for this credentialing fee.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:discountIndicator rdf:type rdf:Property ;
    rdfs:label 'Discount Indicator' ;
    rdfs:comment 'Indicates whether a discount was applied to the credentialing fee.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:discountReason rdf:type rdf:Property ;
    rdfs:label 'Discount Reason' ;
    rdfs:comment 'The business reason or justification for applying a discount to the credentialing fee.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepCode rdf:type rdf:Property ;
    rdfs:label 'Step Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the workflow step type (e.g., PSV_LICENSE, CAQH_VERIFY, COMMITTEE_REVIEW).' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepName rdf:type rdf:Property ;
    rdfs:label 'Step Name' ;
    rdfs:comment 'Full descriptive name of the credentialing workflow step (e.g., Primary Source Verification - License, CAQH Data Integration, Credentialing Committee Review).' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepDescription rdf:type rdf:Property ;
    rdfs:label 'Step Description' ;
    rdfs:comment 'Detailed description of the purpose, activities, and requirements for this workflow step.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepCategory rdf:type rdf:Property ;
    rdfs:label 'Step Category' ;
    rdfs:comment 'High-level category classifying the type of workflow step (verification, committee review, decision, notification, etc.).' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepType rdf:type rdf:Property ;
    rdfs:label 'Step Type' ;
    rdfs:comment 'Indicates whether the step is performed manually by staff, automated by system, or a hybrid approach.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isNcqaRequired rdf:type rdf:Property ;
    rdfs:label 'Is Ncqa Required' ;
    rdfs:comment 'Indicates whether this workflow step is explicitly required by NCQA credentialing and recredentialing standards.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCmsRequired rdf:type rdf:Property ;
    rdfs:label 'Is Cms Required' ;
    rdfs:comment 'Indicates whether this workflow step is required by CMS regulations for Medicare Advantage or Medicaid managed care provider credentialing.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStateRequired rdf:type rdf:Property ;
    rdfs:label 'Is State Required' ;
    rdfs:comment 'Indicates whether this workflow step is required by state insurance department regulations.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalSystemIntegrationType rdf:type rdf:Property ;
    rdfs:label 'External System Integration Type' ;
    rdfs:comment 'Type of integration method used to connect with external verification systems.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardDurationDays rdf:type rdf:Property ;
    rdfs:label 'Standard Duration Days' ;
    rdfs:comment 'Expected number of calendar days required to complete this workflow step under normal circumstances.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:committeeType rdf:type rdf:Property ;
    rdfs:label 'Committee Type' ;
    rdfs:comment 'Type of committee responsible for reviewing this workflow step if committee review is required.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionCriteria rdf:type rdf:Property ;
    rdfs:label 'Decision Criteria' ;
    rdfs:comment 'Detailed description of the criteria, standards, or rules used to make approval/denial decisions in this workflow step.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passCriteria rdf:type rdf:Property ;
    rdfs:label 'Pass Criteria' ;
    rdfs:comment 'Specific conditions or requirements that must be met for the workflow step to be marked as passed or approved.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failCriteria rdf:type rdf:Property ;
    rdfs:label 'Fail Criteria' ;
    rdfs:comment 'Specific conditions or findings that would result in the workflow step being marked as failed or requiring remediation.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationTiming rdf:type rdf:Property ;
    rdfs:label 'Notification Timing' ;
    rdfs:comment 'Timing or trigger for when provider notification should be sent for this workflow step.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredDocumentTypes rdf:type rdf:Property ;
    rdfs:label 'Required Document Types' ;
    rdfs:comment 'Comma-separated list of document types that must be collected or verified in this workflow step (e.g., license copy, CV, malpractice certificate).' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentRetentionYears rdf:type rdf:Property ;
    rdfs:label 'Document Retention Years' ;
    rdfs:comment 'Number of years that documentation related to this workflow step must be retained per regulatory requirements.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allowsDelegation rdf:type rdf:Property ;
    rdfs:label 'Allows Delegation' ;
    rdfs:comment 'Indicates whether this workflow step can be delegated to a third-party credentialing verification organization (CVO).' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:delegationOversightRequired rdf:type rdf:Property ;
    rdfs:label 'Delegation Oversight Required' ;
    rdfs:comment 'Indicates whether delegated performance of this workflow step requires ongoing oversight and audit by the health plan.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recredentialingApplicable rdf:type rdf:Property ;
    rdfs:label 'Recredentialing Applicable' ;
    rdfs:comment 'Indicates whether this workflow step is also applicable during provider recredentialing cycles.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:continuousMonitoringEnabled rdf:type rdf:Property ;
    rdfs:label 'Continuous Monitoring Enabled' ;
    rdfs:comment 'Indicates whether this workflow step is subject to continuous monitoring between credentialing cycles (e.g., ongoing sanctions screening).' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionsDatabases rdf:type rdf:Property ;
    rdfs:label 'Sanctions Databases' ;
    rdfs:comment 'Comma-separated list of sanctions databases that must be checked in this workflow step (e.g., OIG LEIE, SAM, State Medicaid Exclusions).' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:malpracticeVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Malpractice Verification Required' ;
    rdfs:comment 'Indicates whether this workflow step includes verification of professional liability (malpractice) insurance coverage.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'License Verification Required' ;
    rdfs:comment 'Indicates whether this workflow step includes primary source verification of professional licenses.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:boardCertificationVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Board Certification Verification Required' ;
    rdfs:comment 'Indicates whether this workflow step includes verification of board certification status with the appropriate specialty board.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deaVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Dea Verification Required' ;
    rdfs:comment 'Indicates whether this workflow step includes verification of DEA registration for controlled substance prescribing.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:educationVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Education Verification Required' ;
    rdfs:comment 'Indicates whether this workflow step includes verification of medical education and training credentials.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workHistoryVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Work History Verification Required' ;
    rdfs:comment 'Indicates whether this workflow step includes verification of provider work history and practice locations.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caqhIntegrationEnabled rdf:type rdf:Property ;
    rdfs:label 'Caqh Integration Enabled' ;
    rdfs:comment 'Indicates whether this workflow step utilizes CAQH ProView data integration for provider information.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fairHearingRightsApplicable rdf:type rdf:Property ;
    rdfs:label 'Fair Hearing Rights Applicable' ;
    rdfs:comment 'Indicates whether adverse decisions in this workflow step trigger provider fair hearing and appeal rights.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costPerExecution rdf:type rdf:Property ;
    rdfs:label 'Cost Per Execution' ;
    rdfs:comment 'Average cost in USD to execute this workflow step, including labor, system costs, and external verification fees.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:automationPercentage rdf:type rdf:Property ;
    rdfs:label 'Automation Percentage' ;
    rdfs:comment 'Percentage of this workflow step that is automated versus requiring manual intervention.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageCompletionRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Average Completion Rate Percentage' ;
    rdfs:comment 'Historical average percentage of credentialing applications that successfully complete this workflow step without issues.' ;
    rdfs:domain ind:WorkflowStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:networkEligibilityId rdf:type rdf:Property ;
    rdfs:label 'Network Eligibility Id' ;
    rdfs:comment 'Unique identifier for the network eligibility record indicating a provider\'s eligibility to participate in a specific health plan network.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NetworkEligibility .

ind:caqhLastAttestationDate rdf:type rdf:Property ;
    rdfs:label 'Caqh Last Attestation Date' ;
    rdfs:comment 'The date on which the provider last attested to the accuracy of their CAQH profile information.' ;
    rdfs:domain ind:NetworkEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:participationType rdf:type rdf:Property ;
    rdfs:label 'Participation Type' ;
    rdfs:comment 'The type of participation the provider has in the network (Par, Non-Par, Out of Network, Preferred, Tiered).' ;
    rdfs:domain ind:NetworkEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costTierDesignation rdf:type rdf:Property ;
    rdfs:label 'Cost Tier Designation' ;
    rdfs:comment 'The cost tier designation assigned to the provider based on cost efficiency metrics (Low Cost, Average Cost, High Cost, Not Rated).' ;
    rdfs:domain ind:NetworkEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcpDesignationFlag rdf:type rdf:Property ;
    rdfs:label 'Pcp Designation Flag' ;
    rdfs:comment 'Indicates whether the provider is designated as a Primary Care Physician in this network (true/false).' ;
    rdfs:domain ind:NetworkEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialistDesignationFlag rdf:type rdf:Property ;
    rdfs:label 'Specialist Designation Flag' ;
    rdfs:comment 'Indicates whether the provider is designated as a specialist in this network (true/false).' ;
    rdfs:domain ind:NetworkEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkAdequacyIndicator rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Indicator' ;
    rdfs:comment 'Indicates the provider\'s role in meeting network adequacy requirements (Essential, Standard, Supplemental, Not Applicable).' ;
    rdfs:domain ind:NetworkEligibility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expirationNotificationId rdf:type rdf:Property ;
    rdfs:label 'Expiration Notification Id' ;
    rdfs:comment 'Unique identifier for the expiration notification record. Primary key for tracking automated notifications sent for upcoming credential expirations.' ;
    rdfs:domain ind:ExpirationNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationSentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Timestamp' ;
    rdfs:comment 'The exact date and time when the expiration notification was sent to the provider.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recipientAddress rdf:type rdf:Property ;
    rdfs:label 'Recipient Address' ;
    rdfs:comment 'The postal mailing address to which the expiration notification was sent (for postal mail notifications).' ;
    rdfs:domain ind:ExpirationNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryConfirmationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Delivery Confirmation Timestamp' ;
    rdfs:comment 'The date and time when delivery of the notification was confirmed (e.g., email opened, SMS delivered).' ;
    rdfs:domain ind:ExpirationNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:renewalSubmittedFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Submitted Flag' ;
    rdfs:comment 'Boolean flag indicating whether the provider has submitted renewal documentation for the expiring credential.' ;
    rdfs:domain ind:ExpirationNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalSubmittedDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Submitted Date' ;
    rdfs:comment 'The date on which the provider submitted renewal documentation for the expiring credential.' ;
    rdfs:domain ind:ExpirationNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escalatedToUserId rdf:type rdf:Property ;
    rdfs:label 'Escalated To User Id' ;
    rdfs:comment 'Unique identifier for the credentialing staff member or manager to whom the expiration notification was escalated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:notificationBatchId rdf:type rdf:Property ;
    rdfs:label 'Notification Batch Id' ;
    rdfs:comment 'Unique identifier for the batch or group of notifications sent together as part of a scheduled notification run.' ;
    rdfs:domain ind:ExpirationNotification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Batch .

ind:notificationLanguage rdf:type rdf:Property ;
    rdfs:label 'Notification Language' ;
    rdfs:comment 'The two-letter ISO language code indicating the language in which the notification was sent (e.g., en for English, es for Spanish).' ;
    rdfs:domain ind:ExpirationNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerPortalUserId rdf:type rdf:Property ;
    rdfs:label 'Provider Portal User Id' ;
    rdfs:comment 'Unique identifier for the provider\'s user account in the provider portal system, used for portal-based notifications.' ;
    rdfs:domain ind:ExpirationNotification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PortalUser .

ind:notificationPreference rdf:type rdf:Property ;
    rdfs:label 'Notification Preference' ;
    rdfs:comment 'The provider\'s preferred method for receiving notifications as indicated in their profile or preferences.' ;
    rdfs:domain ind:ExpirationNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationCost rdf:type rdf:Property ;
    rdfs:label 'Notification Cost' ;
    rdfs:comment 'The cost incurred to send the notification, applicable for SMS, postal mail, or third-party notification services.' ;
    rdfs:domain ind:ExpirationNotification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaTargetDays rdf:type rdf:Property ;
    rdfs:label 'Sla Target Days' ;
    rdfs:comment 'The target number of days before expiration that the notification should be sent according to the service level agreement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:credentialingPolicyId rdf:type rdf:Property ;
    rdfs:label 'Credentialing Policy Id' ;
    rdfs:comment 'Unique identifier for the credentialing policy record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CredentialingPolicy .

ind:specialtyScope rdf:type rdf:Property ;
    rdfs:label 'Specialty Scope' ;
    rdfs:comment 'Medical specialties or subspecialties to which this credentialing policy applies, or \'all\' if applicable to all specialties.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewCycleMonths rdf:type rdf:Property ;
    rdfs:label 'Review Cycle Months' ;
    rdfs:comment 'Number of months between scheduled reviews of the credentialing policy to ensure it remains current and compliant.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumMalpracticeCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Malpractice Coverage Amount' ;
    rdfs:comment 'Minimum dollar amount of malpractice insurance coverage required per occurrence under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumAggregateCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Aggregate Coverage Amount' ;
    rdfs:comment 'Minimum dollar amount of aggregate malpractice insurance coverage required annually under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trainingVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Training Verification Required' ;
    rdfs:comment 'Indicates whether verification of residency, fellowship, or other post-graduate training is required under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oigExclusionScreeningRequired rdf:type rdf:Property ;
    rdfs:label 'Oig Exclusion Screening Required' ;
    rdfs:comment 'Indicates whether screening against the OIG List of Excluded Individuals and Entities is required under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:samExclusionScreeningRequired rdf:type rdf:Property ;
    rdfs:label 'Sam Exclusion Screening Required' ;
    rdfs:comment 'Indicates whether screening against the SAM federal exclusion database is required under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateExclusionScreeningRequired rdf:type rdf:Property ;
    rdfs:label 'State Exclusion Screening Required' ;
    rdfs:comment 'Indicates whether screening against state Medicaid exclusion lists is required under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalPrivilegesVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Hospital Privileges Verification Required' ;
    rdfs:comment 'Indicates whether verification of current hospital admitting privileges is required under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerReferencesRequired rdf:type rdf:Property ;
    rdfs:label 'Peer References Required' ;
    rdfs:comment 'Indicates whether peer professional references must be obtained and verified under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumPeerReferencesCount rdf:type rdf:Property ;
    rdfs:label 'Minimum Peer References Count' ;
    rdfs:comment 'Minimum number of peer professional references required under this policy, typically 2-3 per NCQA standards.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:delegatedCredentialingAllowed rdf:type rdf:Property ;
    rdfs:label 'Delegated Credentialing Allowed' ;
    rdfs:comment 'Indicates whether credentialing activities may be delegated to another entity under this policy, subject to oversight requirements.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expeditedCredentialingAllowed rdf:type rdf:Property ;
    rdfs:label 'Expedited Credentialing Allowed' ;
    rdfs:comment 'Indicates whether an expedited credentialing process is permitted under this policy for specific circumstances.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:provisionalCredentialingAllowed rdf:type rdf:Property ;
    rdfs:label 'Provisional Credentialing Allowed' ;
    rdfs:comment 'Indicates whether provisional credentialing status may be granted pending completion of full verification under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:continuousMonitoringRequired rdf:type rdf:Property ;
    rdfs:label 'Continuous Monitoring Required' ;
    rdfs:comment 'Indicates whether continuous monitoring of provider credentials and sanctions is required between re-credentialing cycles under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:continuousMonitoringFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Continuous Monitoring Frequency Days' ;
    rdfs:comment 'Frequency in days at which continuous monitoring checks are performed for sanctions and license status under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicationCompletenessStandardDays rdf:type rdf:Property ;
    rdfs:label 'Application Completeness Standard Days' ;
    rdfs:comment 'Maximum number of days allowed for a credentialing application to be deemed complete under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:decisionTimeframeDays rdf:type rdf:Property ;
    rdfs:label 'Decision Timeframe Days' ;
    rdfs:comment 'Maximum number of days allowed to make a credentialing decision after application completeness under this policy, typically 60-90 days.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appealProcessAvailable rdf:type rdf:Property ;
    rdfs:label 'Appeal Process Available' ;
    rdfs:comment 'Indicates whether providers have the right to appeal adverse credentialing decisions under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nondiscriminationComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Nondiscrimination Compliance Required' ;
    rdfs:comment 'Indicates whether credentialing decisions must comply with non-discrimination requirements under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:culturalCompetencyAssessmentRequired rdf:type rdf:Property ;
    rdfs:label 'Cultural Competency Assessment Required' ;
    rdfs:comment 'Indicates whether assessment of provider cultural competency is required under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telemedicineCredentialingIncluded rdf:type rdf:Property ;
    rdfs:label 'Telemedicine Credentialing Included' ;
    rdfs:comment 'Indicates whether this policy includes specific requirements for credentialing telemedicine providers.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:credentialingByProxyAllowed rdf:type rdf:Property ;
    rdfs:label 'Credentialing By Proxy Allowed' ;
    rdfs:comment 'Indicates whether credentialing by proxy is permitted under this policy, allowing reliance on another organization\'s credentialing decision.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareOptOutVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Medicare Opt Out Verification Required' ;
    rdfs:comment 'Indicates whether verification of provider Medicare opt-out status is required under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidEnrollmentVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Medicaid Enrollment Verification Required' ;
    rdfs:comment 'Indicates whether verification of provider Medicaid enrollment status is required under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaComplianceVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Hipaa Compliance Verification Required' ;
    rdfs:comment 'Indicates whether verification of provider HIPAA compliance training and policies is required under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ehrCapabilityVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Ehr Capability Verification Required' ;
    rdfs:comment 'Indicates whether verification of provider electronic health record system capability is required under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMetricsReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Quality Metrics Review Required' ;
    rdfs:comment 'Indicates whether review of provider quality performance metrics is required during credentialing under this policy.' ;
    rdfs:domain ind:CredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adverseEventReviewRequired rdf:type rdf:Property ;
