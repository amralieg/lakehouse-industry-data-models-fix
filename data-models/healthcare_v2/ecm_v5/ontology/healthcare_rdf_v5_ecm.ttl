ind:evaluationMetricTimestamp rdf:type rdf:Property ;
    rdfs:label 'Evaluation Metric Timestamp' ;
    rdfs:comment 'Date-time when the evaluation metric was recorded.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:evaluationMetricValue rdf:type rdf:Property ;
    rdfs:label 'Evaluation Metric Value' ;
    rdfs:comment 'Numeric value of the primary performance metric.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:framework rdf:type rdf:Property ;
    rdfs:label 'Framework' ;
    rdfs:comment 'Machine-learning framework used to develop the model.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hyperparameters rdf:type rdf:Property ;
    rdfs:label 'Hyperparameters' ;
    rdfs:comment 'JSON string capturing all hyperparameter key-value pairs used for training.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inputFeatures rdf:type rdf:Property ;
    rdfs:label 'Input Features' ;
    rdfs:comment 'JSON list of feature names and data types used as inputs.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isProduction rdf:type rdf:Property ;
    rdfs:label 'Is Production' ;
    rdfs:comment 'Indicates whether the version is currently deployed in production.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modelVersionDescription rdf:type rdf:Property ;
    rdfs:label 'Model Version Description' ;
    rdfs:comment 'Detailed narrative describing the purpose, scope, and changes in this version.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelVersionStatus rdf:type rdf:Property ;
    rdfs:label 'Model Version Status' ;
    rdfs:comment 'Current lifecycle state of the model version.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outputSchema rdf:type rdf:Property ;
    rdfs:label 'Output Schema' ;
    rdfs:comment 'JSON definition of the model\'s output structure.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releasedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Released Timestamp' ;
    rdfs:comment 'Date-time when the model version was promoted to production or made available.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceCodeVersion rdf:type rdf:Property ;
    rdfs:label 'Source Code Version' ;
    rdfs:comment 'Version control tag/commit hash of the source code used to build the model.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetVariable rdf:type rdf:Property ;
    rdfs:label 'Target Variable' ;
    rdfs:comment 'Name of the outcome variable the model predicts.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingDatasetSnapshotReference rdf:type rdf:Property ;
    rdfs:label 'Training Dataset Snapshot Reference' ;
    rdfs:comment 'Identifier of the immutable dataset snapshot used for training this version.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Training End Timestamp' ;
    rdfs:comment 'Date-time when model training completed.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:trainingStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Training Start Timestamp' ;
    rdfs:comment 'Date-time when model training began.' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:versionLabel rdf:type rdf:Property ;
    rdfs:label 'Version Label' ;
    rdfs:comment 'Human-readable label for the model version (e.g., "Baseline", "Improved").' ;
    rdfs:domain ind:ModelVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cfr42ConsentId rdf:type rdf:Property ;
    rdfs:label 'Cfr42 Consent Id' ;
    rdfs:comment 'Reference to the 42 CFR Part 2 consent record linked to this episode.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Cfr42Consent .

ind:matPrescriptionId rdf:type rdf:Property ;
    rdfs:label 'Mat Prescription Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.prescription. Business justification: SAMHSA/DEA regulations require SUD treatment episodes to maintain traceable links to MAT prescriptions (buprenorphine/naltrexone) for X-waiver compliance reporting and treatment outcome tracking.' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Prescription .

ind:populationHealthCohortManagementCohortMembershipId rdf:type rdf:Property ;
    rdfs:label 'Population Health Cohort Management Cohort Membership Id' ;
    rdfs:comment 'Foreign key linking to population_health_cohort_management.cohort_membership. Business justification: Value-based care programs use population health cohorts to identify high-risk SUD patients for targeted intervention. ACOs and managed behavioral health organizations track which cohort identification' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PopulationHealthCohortManagementCohortMembership .

ind:sudEpisodeId rdf:type rdf:Property ;
    rdfs:label 'Sud Episode Id' ;
    rdfs:comment 'Unique surrogate key for the SUD treatment episode.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SudEpisode .

ind:treatingGroupId rdf:type rdf:Property ;
    rdfs:label 'Treating Group Id' ;
    rdfs:comment 'Foreign key linking to provider.group. Business justification: SUD treatment programs are delivered by provider groups (addiction treatment centers). Required for SAMHSA program reporting, network adequacy analysis, and value-based care attribution at the group p' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Group .

ind:behavioralHealthSudEpisodeStatus rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Sud Episode Status' ;
    rdfs:comment 'Current lifecycle status of the episode.' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:episodeNumber rdf:type rdf:Property ;
    rdfs:label 'Episode Number' ;
    rdfs:comment 'Business identifier for the episode, often used in clinical documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:episodeType rdf:type rdf:Property ;
    rdfs:label 'Episode Type' ;
    rdfs:comment 'Classification of the episode lifecycle.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matEndDate rdf:type rdf:Property ;
    rdfs:label 'Mat End Date' ;
    rdfs:comment 'Date MAT medication was discontinued.' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:matMedication rdf:type rdf:Property ;
    rdfs:label 'Mat Medication' ;
    rdfs:comment 'Name of the MAT medication used (e.g., buprenorphine, methadone).' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matStartDate rdf:type rdf:Property ;
    rdfs:label 'Mat Start Date' ;
    rdfs:comment 'Date MAT medication was initiated.' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicationAssistedTreatmentFlag rdf:type rdf:Property ;
    rdfs:label 'Medication Assisted Treatment Flag' ;
    rdfs:comment 'Indicates if medication-assisted treatment (MAT) was part of the episode.' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outcomeScore rdf:type rdf:Property ;
    rdfs:label 'Outcome Score' ;
    rdfs:comment 'Clinician-assigned outcome score (1-5) for the episode.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySubstance rdf:type rdf:Property ;
    rdfs:label 'Primary Substance' ;
    rdfs:comment 'Primary substance of abuse documented for the episode. [ENUM-REF-CANDIDATE: alcohol|opioid|cocaine|methamphetamine|benzodiazepine|cannabis|other — promote to reference product]' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programEnrollmentFlag rdf:type rdf:Property ;
    rdfs:label 'Program Enrollment Flag' ;
    rdfs:comment 'Indicates enrollment in a specific SUD program (e.g., intensive outpatient).' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relapseDate rdf:type rdf:Property ;
    rdfs:label 'Relapse Date' ;
    rdfs:comment 'Date of documented relapse event.' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:relapseFlag rdf:type rdf:Property ;
    rdfs:label 'Relapse Flag' ;
    rdfs:comment 'Indicates whether the patient experienced a relapse during the episode.' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondarySubstances rdf:type rdf:Property ;
    rdfs:label 'Secondary Substances' ;
    rdfs:comment 'Comma-separated list of additional substances of abuse identified.' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalDaysOfCare rdf:type rdf:Property ;
    rdfs:label 'Total Days Of Care' ;
    rdfs:comment 'Total days of care delivered in the episode.' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalVisits rdf:type rdf:Property ;
    rdfs:label 'Total Visits' ;
    rdfs:comment 'Total number of clinical visits within the episode.' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:urineDrugScreenFlag rdf:type rdf:Property ;
    rdfs:label 'Urine Drug Screen Flag' ;
    rdfs:comment 'Indicates if urine drug screening was performed.' ;
    rdfs:domain ind:BehavioralHealthSudEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:administeredDrugMasterId rdf:type rdf:Property ;
    rdfs:label 'Administered Drug Master Id' ;
    rdfs:comment 'Foreign key linking to pharmacy.drug_master. Business justification: Crisis interventions (IM haloperidol, lorazepam, ketamine) require tracking administered medications for patient safety, drug interaction checks, and billing. Emergency psych medication administration' ;
    rdfs:domain ind:BehavioralHealthCrisisEpisode ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrugMaster .

ind:behavioralEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Behavioral Employee Id' ;
    rdfs:comment 'Identifier of the user who created the record.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:crisisEpisodeId rdf:type rdf:Property ;
    rdfs:label 'Crisis Episode Id' ;
    rdfs:comment 'Unique identifier for the crisis episode record.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CrisisEpisode .

ind:priorEpisodeCrisisEpisodeBehavioralHealthCrisisEpisodeId rdf:type rdf:Property ;
    rdfs:label 'Prior Episode Crisis Episode Behavioral Health Crisis Episode Id' ;
    rdfs:comment 'Reference to a prior related crisis episode, if any.' ;
    rdfs:domain ind:BehavioralHealthCrisisEpisode ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BehavioralHealthCrisisEpisode .

ind:crisisEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Crisis End Timestamp' ;
    rdfs:comment 'Date-time when the crisis episode ended or was resolved.' ;
    rdfs:domain ind:BehavioralHealthCrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:crisisOutcome rdf:type rdf:Property ;
    rdfs:label 'Crisis Outcome' ;
    rdfs:comment 'Overall outcome of the crisis management.' ;
    rdfs:domain ind:BehavioralHealthCrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crisisStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Crisis Start Timestamp' ;
    rdfs:comment 'Date-time when the crisis episode began.' ;
    rdfs:domain ind:BehavioralHealthCrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:crisisType rdf:type rdf:Property ;
    rdfs:label 'Crisis Type' ;
    rdfs:comment 'Categorization of the crisis event.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationSource rdf:type rdf:Property ;
    rdfs:label 'Documentation Source' ;
    rdfs:comment 'Source system or method used to capture the episode data.' ;
    rdfs:domain ind:BehavioralHealthCrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpPlan rdf:type rdf:Property ;
    rdfs:label 'Follow Up Plan' ;
    rdfs:comment 'Planned follow-up actions or appointments.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRepeatEpisode rdf:type rdf:Property ;
    rdfs:label 'Is Repeat Episode' ;
    rdfs:comment 'Indicates if this episode is a repeat occurrence for the same patient within 30 days.' ;
    rdfs:domain ind:BehavioralHealthCrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicationAdministered rdf:type rdf:Property ;
    rdfs:label 'Medication Administered' ;
    rdfs:comment 'Medication(s) given during the episode (e.g., lorazepam).' ;
    rdfs:domain ind:BehavioralHealthCrisisEpisode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralDestination rdf:type rdf:Property ;
