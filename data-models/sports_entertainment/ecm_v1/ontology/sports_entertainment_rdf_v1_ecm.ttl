    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costPerAcquisitionAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Per Acquisition Amount' ;
    rdfs:comment 'Fixed monetary amount paid to the affiliate for each qualified player acquisition, applicable when commission model includes CPA.' ;
    rdfs:domain ind:Affiliate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicFocus rdf:type rdf:Property ;
    rdfs:label 'Geographic Focus' ;
    rdfs:comment 'Comma-separated list of three-letter ISO country codes representing the affiliate\'s primary geographic markets and audience reach.' ;
    rdfs:domain ind:Affiliate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPerformanceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Performance Review Date' ;
    rdfs:comment 'Date of the most recent performance evaluation and partnership review conducted with the affiliate.' ;
