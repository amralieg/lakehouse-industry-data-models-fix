  resolution_type varchar [note: 'Resolution type (resolved, unresolved, duplicate, cancelled)']
  resolved_at timestamp
  resolved_timestamp timestamp [note: 'When case was resolved']
  retention_offer_made_flag boolean [note: 'Whether retention offer was made']
  updated_at timestamp
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Customer support case tracking for D2C contact center operations and churn analytics'
}

