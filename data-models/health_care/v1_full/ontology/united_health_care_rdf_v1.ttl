ind:medicalPolicyReference rdf:type rdf:Property ;
    rdfs:label 'Medical Policy Reference' ;
    rdfs:comment 'Reference identifier or URL to the detailed medical policy document that governs authorization decisions for this service type.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerTypeRestriction rdf:type rdf:Property ;
    rdfs:label 'Provider Type Restriction' ;
    rdfs:comment 'Restriction on the type of provider who can perform this service type (e.g., must be board-certified specialist, must be facility-based).' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityTypeRestriction rdf:type rdf:Property ;
    rdfs:label 'Facility Type Restriction' ;
    rdfs:comment 'Restriction on the type of facility where this service type can be performed (e.g., must be accredited surgical center, must be hospital-based).' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:experimentalInvestigationalFlag rdf:type rdf:Property ;
    rdfs:label 'Experimental Investigational Flag' ;
    rdfs:comment 'Indicates whether this service type is classified as experimental or investigational and typically not covered by insurance.' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cosmeticExclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Cosmetic Exclusion Flag' ;
    rdfs:comment 'Indicates whether this service type is typically excluded from coverage as cosmetic (not medically necessary) unless specific criteria are met.' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:updatedByUser rdf:type rdf:Property ;
    rdfs:label 'Updated By User' ;
    rdfs:comment 'User identifier of the person who last updated this service type configuration.' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccCategoryId rdf:type rdf:Property ;
    rdfs:label 'Hcc Category Id' ;
    rdfs:comment 'Unique identifier for the HCC category used in CMS risk adjustment models.' ;
