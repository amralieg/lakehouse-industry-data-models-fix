    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleGamingCertified rdf:type rdf:Property ;
    rdfs:label 'Responsible Gaming Certified' ;
    rdfs:comment 'Indicates whether the operator holds current responsible gaming certification from a recognized authority.' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxWithholdingRate rdf:type rdf:Property ;
    rdfs:label 'Tax Withholding Rate' ;
    rdfs:comment 'Default tax withholding rate applied to customer winnings by the operator as required by jurisdiction tax laws.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketId rdf:type rdf:Property ;
    rdfs:label 'Market Id' ;
    rdfs:comment 'Reference to the betting market that contains this selection.' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BettingMarket .

ind:currentOddsAmerican rdf:type rdf:Property ;
    rdfs:label 'Current Odds American' ;
    rdfs:comment 'Most recent odds for this selection, expressed in American moneyline format. Updated in real-time during live betting.' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:currentOddsDecimal rdf:type rdf:Property ;
    rdfs:label 'Current Odds Decimal' ;
    rdfs:comment 'Most recent odds for this selection, expressed in decimal format. Updated in real-time during live betting.' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective End Timestamp' ;
    rdfs:comment 'Timestamp when this selection is no longer available for wagering (e.g., event start time, market close time). Null for open-ended selections.' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:effectiveStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Start Timestamp' ;
    rdfs:comment 'Timestamp when this selection becomes available for wagering.' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:externalProviderCode rdf:type rdf:Property ;
    rdfs:label 'External Provider Code' ;
    rdfs:comment 'Unique identifier for this selection in the external odds feed provider system for data reconciliation and integration.' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFavorite rdf:type rdf:Property ;
    rdfs:label 'Is Favorite' ;
    rdfs:comment 'Indicates whether this selection is the favorite (expected winner) in the market based on odds.' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRestricted rdf:type rdf:Property ;
    rdfs:label 'Is Restricted' ;
    rdfs:comment 'Indicates whether this selection has betting restrictions applied (e.g., limited stake, excluded from promotions) for responsible gaming or regulatory compliance.' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oddsLastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Odds Last Updated Timestamp' ;
    rdfs:comment 'Timestamp when the current odds were last updated, critical for live betting and odds feed reconciliation.' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:openingOddsAmerican rdf:type rdf:Property ;
    rdfs:label 'Opening Odds American' ;
    rdfs:comment 'Initial odds offered for this selection when the market opened, expressed in American moneyline format (e.g., +150, -200).' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:openingOddsDecimal rdf:type rdf:Property ;
    rdfs:label 'Opening Odds Decimal' ;
    rdfs:comment 'Initial odds offered for this selection when the market opened, expressed in decimal format (e.g., 2.50).' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:providerName rdf:type rdf:Property ;
    rdfs:label 'Provider Name' ;
    rdfs:comment 'Name of the external odds feed provider supplying data for this selection (e.g., SportsRadar, Betgenius, Don Best).' ;
    rdfs:domain ind:Gaming ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionReason rdf:type rdf:Property ;
    rdfs:label 'Restriction Reason' ;
    rdfs:comment 'Explanation for why betting restrictions are applied to this selection (e.g., regulatory requirement, integrity concern, responsible gaming measure). Null if not restricted.' ;
    rdfs:domain ind:Selection ;
    rdf:type owl:DatatypeProperty ;
