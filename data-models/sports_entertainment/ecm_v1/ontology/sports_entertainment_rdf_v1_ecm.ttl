    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dvrStorageHours rdf:type rdf:Property ;
    rdfs:label 'Dvr Storage Hours' ;
    rdfs:comment 'Maximum hours of content that can be stored in cloud DVR. Null indicates DVR is not available or unlimited storage.' ;
