    rdfs:range xsd:string .

ind:annualMarketingBudgetUsd rdf:type rdf:Property ;
    rdfs:label 'Annual Marketing Budget Usd' ;
    rdfs:comment 'Estimated annual marketing budget for the brand in USD. Used for sponsor qualification, deal sizing, and partnership opportunity assessment.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brandCode rdf:type rdf:Property ;
    rdfs:label 'Brand Code' ;
    rdfs:comment 'Short alphanumeric code used as an external business identifier for the brand in contracts, activation materials, and reporting systems.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandEquityScore rdf:type rdf:Property ;
    rdfs:label 'Brand Equity Score' ;
    rdfs:comment 'Quantitative score representing the brand\'s market strength, consumer perception, and overall equity. Used for partnership valuation and sponsor portfolio optimization.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brandLogoUrl rdf:type rdf:Property ;
    rdfs:label 'Brand Logo Url' ;
    rdfs:comment 'Web URL pointing to the official brand logo asset used for digital activations, broadcast integrations, and marketing materials.' ;
