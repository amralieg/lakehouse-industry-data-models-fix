    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataBreachHistory rdf:type rdf:Property ;
    rdfs:label 'Data Breach History' ;
    rdfs:comment 'Summary of any reported data breaches or security incidents involving the TPA including dates, scope, and remediation actions taken.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityContractEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Effective Date' ;
    rdfs:comment 'Date when the administrative services agreement between the healthcare organization and the TPA became effective.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilityContractTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Termination Date' ;
    rdfs:comment 'Date when the administrative services agreement with the TPA is scheduled to terminate or was actually terminated.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilityServiceScopeDescription rdf:type rdf:Property ;
    rdfs:label 'Facility Service Scope Description' ;
    rdfs:comment 'Detailed description of the administrative services the TPA is contracted to provide including claims processing, utilization review, network management, and member services.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialRating rdf:type rdf:Property ;
    rdfs:label 'Financial Rating' ;
    rdfs:comment 'Credit or financial strength rating assigned to the TPA by independent rating agencies such as AM Best, Moodys, or Standard & Poors.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaComplianceCertified rdf:type rdf:Property ;
    rdfs:label 'Hipaa Compliance Certified' ;
    rdfs:comment 'Indicates whether the TPA has been certified as compliant with HIPAA privacy and security regulations through independent audit or attestation.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Last Verification Date' ;
    rdfs:comment 'Date when the TPA information was last verified for accuracy and completeness through outreach or data quality review process.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'License Effective Date' ;
    rdfs:comment 'Date when the TPAs license became effective and the TPA was authorized to begin operations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:memberServicesCapability rdf:type rdf:Property ;
    rdfs:label 'Member Services Capability' ;
    rdfs:comment 'Indicates whether the TPA provides member-facing services including enrollment support, benefit inquiries, and grievance handling.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nationalProviderIdentifier rdf:type rdf:Property ;
    rdfs:label 'National Provider Identifier' ;
    rdfs:comment 'Ten-digit NPI assigned to the TPA if registered as a healthcare entity under HIPAA administrative simplification standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkManagementCapability rdf:type rdf:Property ;
    rdfs:label 'Network Management Capability' ;
    rdfs:comment 'Indicates whether the TPA manages provider networks including credentialing, contracting, and network adequacy monitoring.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentOrganizationName rdf:type rdf:Property ;
    rdfs:label 'Parent Organization Name' ;
    rdfs:comment 'Name of the parent company or holding organization if the TPA is a subsidiary or division of a larger corporate entity.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceGuaranteeTerms rdf:type rdf:Property ;
    rdfs:label 'Performance Guarantee Terms' ;
    rdfs:comment 'Description of contractual performance guarantees and service level agreements (SLAs) the TPA must meet including claims turnaround time, accuracy rates, and customer service metrics.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Email' ;
    rdfs:comment 'Email address of the primary business contact at the TPA for electronic communication and notifications.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Phone' ;
    rdfs:comment 'Primary telephone number for reaching the TPA business contact during normal business operations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soc2Certified rdf:type rdf:Property ;
    rdfs:label 'Soc2 Certified' ;
    rdfs:comment 'Indicates whether the TPA has achieved SOC 2 Type II certification demonstrating controls for security, availability, processing integrity, confidentiality, and privacy.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateProvince rdf:type rdf:Property ;
    rdfs:label 'State Province' ;
    rdfs:comment 'State or province code of the TPAs primary business location using standard two-letter abbreviations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyAdministratorStatus rdf:type rdf:Property ;
    rdfs:label 'Third Party Administrator Status' ;
    rdfs:comment 'Current operational status of the TPA relationship indicating whether the TPA is actively servicing plans or has been suspended, terminated, or is pending approval.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tpaCode rdf:type rdf:Property ;
    rdfs:label 'Tpa Code' ;
    rdfs:comment 'Unique business identifier code assigned to the TPA for operational reference and system integration.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tpaName rdf:type rdf:Property ;
    rdfs:label 'Tpa Name' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tpaType rdf:type rdf:Property ;
    rdfs:label 'Tpa Type' ;
    rdfs:comment 'Classification of the TPA based on the scope of administrative services provided (full service, claims processing only, utilization management, network management, specialty services, or hybrid).' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utilizationManagementCapability rdf:type rdf:Property ;
    rdfs:label 'Utilization Management Capability' ;
    rdfs:comment 'Indicates whether the TPA provides utilization management services including prior authorization, concurrent review, and case management.' ;
    rdfs:domain ind:ThirdPartyAdministrator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceAccountableCareOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Insurance Accountable Care Organization Id' ;
    rdfs:comment 'Primary key for accountable_care_organization' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuranceAccountableCareOrganization .

ind:facilityOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Facility Organization Id' ;
    rdfs:comment 'Self-referencing FK on accountable_care_organization (parent_accountable_care_organization_id)' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FacilityOrganization .

ind:parentAcoAccountableCareOrganizationInsuranceAccountableCareOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Parent Aco Accountable Care Organization Insurance Accountable Care Organization Id' ;
    rdfs:comment 'Identifier of the parent health system, integrated delivery network, or corporate entity that owns or governs the ACO, if applicable.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuranceAccountableCareOrganization .

ind:accountableCareOrganizationStatus rdf:type rdf:Property ;
    rdfs:label 'Accountable Care Organization Status' ;
    rdfs:comment 'Current operational status of the ACO in its lifecycle with the payer or regulatory program.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acoIdentifier rdf:type rdf:Property ;
    rdfs:label 'Aco Identifier' ;
    rdfs:comment 'External business identifier assigned by CMS or other regulatory body for the ACO. Used for regulatory reporting and cross-system identification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acoName rdf:type rdf:Property ;
    rdfs:label 'Aco Name' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acoType rdf:type rdf:Property ;
    rdfs:label 'Aco Type' ;
    rdfs:comment 'Classification of the ACO based on the program model and payer type it operates under.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualExpenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Expenditure Amount' ;
    rdfs:comment 'Actual per-beneficiary expenditure amount incurred by the ACO during the performance period.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:advancePaymentEligible rdf:type rdf:Property ;
    rdfs:label 'Advance Payment Eligible' ;
    rdfs:comment 'Indicates whether the ACO is eligible to receive advance or upfront payments to support care coordination infrastructure.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:agreementEndDate rdf:type rdf:Property ;
    rdfs:label 'Agreement End Date' ;
    rdfs:comment 'Date when the ACO agreement or contract with the payer expires or is scheduled to terminate. Null for open-ended agreements.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agreementStartDate rdf:type rdf:Property ;
    rdfs:label 'Agreement Start Date' ;
    rdfs:comment 'Date when the ACO agreement or contract with the payer becomes effective and the organization begins operating under the program.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attributedBeneficiaryCount rdf:type rdf:Property ;
    rdfs:label 'Attributed Beneficiary Count' ;
    rdfs:comment 'Number of Medicare or other payer beneficiaries attributed to the ACO for the current performance period.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benchmarkExpenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Benchmark Expenditure Amount' ;
    rdfs:comment 'Target per-beneficiary expenditure amount established as the cost benchmark for the ACO performance evaluation.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityServiceAreaDescription rdf:type rdf:Property ;
    rdfs:label 'Facility Service Area Description' ;
    rdfs:comment 'Textual description of the geographic service area covered by the ACO, including counties, regions, or states served.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityName rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Name' ;
    rdfs:comment 'Full legal name of the corporate or organizational entity that holds the ACO agreement, which may differ from the ACO operating name.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationStructure rdf:type rdf:Property ;
    rdfs:label 'Organization Structure' ;
    rdfs:comment 'Governance and ownership structure of the ACO indicating the primary organizational model and leadership.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participatingProviderCount rdf:type rdf:Property ;
    rdfs:label 'Participating Provider Count' ;
    rdfs:comment 'Total number of healthcare providers (physicians, specialists, facilities) participating in the ACO network.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programModel rdf:type rdf:Property ;
    rdfs:label 'Program Model' ;
    rdfs:comment 'Specific CMS or commercial program model under which the ACO operates, defining risk-sharing and payment arrangements.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sharedSavingsAmount rdf:type rdf:Property ;
    rdfs:label 'Shared Savings Amount' ;
    rdfs:comment 'Dollar amount of shared savings earned by the ACO in the most recent performance period, if applicable.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trackLevel rdf:type rdf:Property ;
    rdfs:label 'Track Level' ;
    rdfs:comment 'Risk track or level within the program model indicating the degree of financial risk and reward sharing.' ;
    rdfs:domain ind:InsuranceAccountableCareOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalAiModelCardId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Model Card Id' ;
    rdfs:comment 'Foreign key linking to clinical_ai.model_card. Business justification: AI-triggered consent workflows (e.g., model identifies need for genetic testing consent) require traceability to the recommending model for audit trails and AI transparency compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalAiModelCard .

ind:consentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Consent Employee Id' ;
    rdfs:comment 'The unique identifier or credential number of the interpreter who assisted, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:consentMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Consent Mpi Record Id' ;
    rdfs:comment 'Reference to the patient who provided or is the subject of this consent. Links to the Master Patient Index (MPI).' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:consentPatientMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Consent Patient Mpi Record Id' ;
    rdfs:comment 'description' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:consentPolicyId rdf:type rdf:Property ;
    rdfs:label 'Consent Policy Id' ;
    rdfs:comment 'Foreign key linking to consent.consent_policy. Business justification: Every consent record is governed by a specific consent policy that defines requirements, retention, revocation rules, etc. This is a fundamental relationship - the core consent record must link to the' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentPolicy .

ind:insuranceCoverageId rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Id' ;
    rdfs:comment 'Foreign key linking to patient.insurance_coverage. Business justification: Treatment and procedure consents require payer prior authorization verification and billing coordination. Consent validity often depends on active coverage. Links consent to specific insurance plan fo' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuranceCoverage .

ind:interfaceChannelId rdf:type rdf:Property ;
    rdfs:label 'Interface Channel Id' ;
    rdfs:comment 'Foreign key linking to interoperability.interface_channel. Business justification: Consent records transmitted via HIE or EHR interfaces need tracking of which channel carried the consent directive. Required for audit trails showing how consent information was exchanged with trading' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InterfaceChannel .

ind:primaryConsentRecordCapacityAssessorProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Consent Record Capacity Assessor Provider Clinician Id' ;
    rdfs:comment 'Reference to the provider who performed the capacity assessment, if applicable.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:primaryEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Employee Id' ;
    rdfs:comment 'FK to workforce.employee.employee_id' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:researchStudyId rdf:type rdf:Property ;
    rdfs:label 'Research Study Id' ;
    rdfs:comment 'The unique identifier of the research study or clinical trial for which this consent was obtained, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchStudy .

ind:supersededConsentRecordId rdf:type rdf:Property ;
    rdfs:label 'Superseded Consent Record Id' ;
    rdfs:comment 'Self-referencing FK on record (superseded_record_id)' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentRecord .

ind:authorizedRepresentativeFlag rdf:type rdf:Property ;
    rdfs:label 'Authorized Representative Flag' ;
    rdfs:comment 'Indicates whether the consent was signed by an authorized representative (legal guardian, power of attorney, healthcare proxy) rather than the patient directly.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorizedRepresentativeName rdf:type rdf:Property ;
    rdfs:label 'Authorized Representative Name' ;
    rdfs:comment 'The full name of the authorized representative who signed on behalf of the patient, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedRepresentativeRelationship rdf:type rdf:Property ;
    rdfs:label 'Authorized Representative Relationship' ;
    rdfs:comment 'The relationship of the authorized representative to the patient: parent, legal guardian, power of attorney, healthcare proxy, spouse, next of kin, or other. [ENUM-REF-CANDIDATE: parent|legal_guardian|power_of_attorney|healthcare_proxy|spouse|next_of_kin|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityAssessmentPerformedFlag rdf:type rdf:Property ;
    rdfs:label 'Capacity Assessment Performed Flag' ;
    rdfs:comment 'Indicates whether a formal assessment of the patients decision-making capacity was performed prior to obtaining consent.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityAssessmentResult rdf:type rdf:Property ;
    rdfs:label 'Capacity Assessment Result' ;
    rdfs:comment 'The outcome of the capacity assessment: patient has capacity, lacks capacity, has partial capacity, or assessment was not performed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentDecision rdf:type rdf:Property ;
    rdfs:label 'Consent Decision' ;
    rdfs:comment 'The patients decision regarding the consent: permit (consent granted), deny (consent refused), opt-in (patient agrees to participate), or opt-out (patient declines participation).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Consent Document Reference' ;
    rdfs:comment 'Reference identifier or URI to the scanned or electronically stored consent document in the document management system or Electronic Health Record (EHR).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentEffectiveEndDate rdf:type rdf:Property ;
    rdfs:label 'Consent Effective End Date' ;
    rdfs:comment 'The date on which this consent expires or is no longer valid. Null indicates open-ended consent.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentEffectiveStartDate rdf:type rdf:Property ;
    rdfs:label 'Consent Effective Start Date' ;
    rdfs:comment 'The date from which this consent becomes effective and enforceable.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentExpirationNotificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Consent Expiration Notification Sent Flag' ;
    rdfs:comment 'Indicates whether an expiration notification was sent to the patient or care team prior to consent expiration.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentFormVersion rdf:type rdf:Property ;
    rdfs:label 'Consent Form Version' ;
    rdfs:comment 'The version number or identifier of the consent form template used at the time of consent capture. Critical for regulatory compliance and audit trails.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentLanguage rdf:type rdf:Property ;
    rdfs:label 'Consent Language' ;
    rdfs:comment 'The language in which the consent form was presented and explained to the patient (ISO 639-1 two-letter code or full language name).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentMethod rdf:type rdf:Property ;
    rdfs:label 'Consent Method' ;
    rdfs:comment 'The method by which consent was obtained: written (paper signature), verbal (documented oral consent), electronic (digital signature via patient portal or kiosk), or implied (emergency treatment).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentNotes rdf:type rdf:Property ;
    rdfs:label 'Consent Notes' ;
    rdfs:comment 'Free-text clinical or administrative notes related to the consent process, including any special circumstances, patient questions, or clarifications provided.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentObtainedDatetime rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained Datetime' ;
    rdfs:comment 'The date and time when the consent was obtained from the patient or authorized representative. This is the principal business event timestamp for the consent record.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:consentPurpose rdf:type rdf:Property ;
    rdfs:label 'Consent Purpose' ;
    rdfs:comment 'Free-text description of the specific purpose or procedure for which this consent was obtained (e.g., Total Knee Replacement Surgery, Participation in Clinical Trial XYZ, Release of Records to Insurance Provider).' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentRenewalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Consent Renewal Required Flag' ;
    rdfs:comment 'Indicates whether this consent requires periodic renewal per institutional policy or regulatory requirements.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentRestrictions rdf:type rdf:Property ;
    rdfs:label 'Consent Restrictions' ;
    rdfs:comment 'Free-text description of any restrictions, limitations, or special conditions the patient placed on the consent (e.g., Do not share mental health records, Limit disclosure to dates of service only).' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentRevocationDatetime rdf:type rdf:Property ;
    rdfs:label 'Consent Revocation Datetime' ;
    rdfs:comment 'The date and time when the patient revoked or withdrew this consent, if applicable.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:consentRevocationReason rdf:type rdf:Property ;
    rdfs:label 'Consent Revocation Reason' ;
    rdfs:comment 'Free-text explanation or reason provided by the patient for revoking the consent.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentScope rdf:type rdf:Property ;
    rdfs:label 'Consent Scope' ;
    rdfs:comment 'The scope or domain to which this consent applies: patient privacy (HIPAA), research participation, treatment decisions, or advanced directive registry (ADR).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Consent Source System' ;
    rdfs:comment 'The name or identifier of the source system from which this consent record originated (e.g., Epic, Cerner, patient portal, research management system).' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentSourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Consent Source System Code' ;
    rdfs:comment 'The unique identifier for this consent record in the source system, used for data lineage and reconciliation.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentStatus rdf:type rdf:Property ;
    rdfs:label 'Consent Status' ;
    rdfs:comment 'Current lifecycle status of the consent: draft (being prepared), proposed (awaiting signature), active (in effect), rejected (patient declined), inactive (no longer applicable), revoked (patient withdrew), or expired (past validity period). [ENUM-REF-CANDIDATE: draft|proposed|active|rejected|inactive|revoked|expired — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentType rdf:type rdf:Property ;
    rdfs:label 'Consent Type' ;
    rdfs:comment 'The category or type of consent being captured: treatment consent, surgical consent, research consent, HIPAA authorization, data sharing agreement, Health Information Exchange (HIE) opt-in/opt-out, telehealth consent, photography consent, or release of information. [ENUM-REF-CANDIDATE: treatment|surgical_procedure|anesthesia|research|hipaa_authorization|data_sharing|hie_opt_in|hie_opt_out|telehealth|photography|release_of_information — 11 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaAuthorizationFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization Flag' ;
    rdfs:comment 'Indicates whether this consent record includes a formal HIPAA authorization for use and disclosure of Protected Health Information (PHI).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interpreterName rdf:type rdf:Property ;
    rdfs:label 'Interpreter Name' ;
    rdfs:comment 'The name of the interpreter who assisted in the consent process, if applicable.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Interpreter Required Flag' ;
    rdfs:comment 'Indicates whether a medical interpreter was required and used during the consent process due to language barriers.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:irbApprovalNumber rdf:type rdf:Property ;
    rdfs:label 'Irb Approval Number' ;
    rdfs:comment 'The IRB approval number associated with the research study consent, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mrn rdf:type rdf:Property ;
    rdfs:label 'Mrn' ;
    rdfs:comment 'The patients Medical Record Number at the time consent was obtained. Used for cross-referencing and audit purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientSignatureDatetime rdf:type rdf:Property ;
    rdfs:label 'Patient Signature Datetime' ;
    rdfs:comment 'The date and time when the patient (or authorized representative) signed the consent form.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:researchConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Research Consent Flag' ;
    rdfs:comment 'Indicates whether this consent is specifically for participation in a research study or clinical trial.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:witnessName rdf:type rdf:Property ;
    rdfs:label 'Witness Name' ;
    rdfs:comment 'The name of the individual who witnessed the consent signing, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Witness Required Flag' ;
    rdfs:comment 'Indicates whether a witness was required for this consent per institutional policy or regulatory requirements.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:witnessSignatureDatetime rdf:type rdf:Property ;
    rdfs:label 'Witness Signature Datetime' ;
    rdfs:comment 'The date and time when the witness signed the consent form.' ;
    rdfs:domain ind:ConsentRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:exchangeStandardId rdf:type rdf:Property ;
    rdfs:label 'Exchange Standard Id' ;
    rdfs:comment 'Foreign key linking to interoperability.exchange_standard. Business justification: Consent form templates must conform to specific exchange standards (C-CDA Consent Directive template 2.16.840.1.113883.10.20.22.2.64, FHIR Consent resource profiles). Required for interoperability des' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExchangeStandard .

ind:supersededByTemplateFormTemplateConsentFormTemplateId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Template Form Template Consent Form Template Id' ;
    rdfs:comment 'Reference to the consent_form_template_id of the newer version that supersedes this template. Null if this is the current active version.' ;
    rdfs:domain ind:ConsentFormTemplate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentFormTemplate .

ind:applicableFacilityTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Facility Types' ;
    rdfs:comment 'Comma-separated list or description of facility types where this consent form template is applicable (e.g., inpatient hospital, outpatient clinic, emergency department, ambulatory surgery center, telehealth platform).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableServiceLines rdf:type rdf:Property ;
    rdfs:label 'Applicable Service Lines' ;
    rdfs:comment 'Comma-separated list or description of clinical service lines or departments where this consent form template is used (e.g., cardiology, oncology, behavioral health, radiology, laboratory).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalAuthority rdf:type rdf:Property ;
    rdfs:label 'Approval Authority' ;
    rdfs:comment 'Name or title of the individual, committee, or department that approved this consent form template for use (e.g., Chief Compliance Officer, Legal Department, Privacy Officer, IRB Chair).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentCategory rdf:type rdf:Property ;
    rdfs:label 'Consent Category' ;
    rdfs:comment 'Primary category of consent this form template addresses: treatment (general medical treatment), surgical (procedure-specific), research (clinical trials and studies), hipaa_authorization (PHI disclosure), hie_opt_in_out (Health Information Exchange participation), telehealth (virtual care consent), data_sharing (third-party data use). [ENUM-REF-CANDIDATE: treatment|surgical|research|hipaa_authorization|hie_opt_in_out|telehealth|data_sharing — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentSubcategory rdf:type rdf:Property ;
    rdfs:label 'Consent Subcategory' ;
    rdfs:comment 'Optional subcategory or specialization within the primary consent category (e.g., anesthesia, blood transfusion, genetic testing, marketing communications).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByUser rdf:type rdf:Property ;
    rdfs:label 'Created By User' ;
    rdfs:comment 'Username or identifier of the system user who created this consent form template record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electronicSignatureEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Electronic Signature Enabled Flag' ;
    rdfs:comment 'Indicates whether this consent form template supports electronic signature capture in compliance with ESIGN Act and state electronic signature laws. True if electronic signature is enabled, False if wet signature is required.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'Date when this consent form template version is no longer valid for new consent collection. Nullable for forms without predetermined expiration.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:formChecksum rdf:type rdf:Property ;
    rdfs:label 'Form Checksum' ;
    rdfs:comment 'Cryptographic hash (e.g., SHA-256) of the form document file to ensure integrity and detect unauthorized modifications. Used for audit and compliance verification.' ;
    rdfs:domain ind:ConsentFormTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formCode rdf:type rdf:Property ;
    rdfs:label 'Form Code' ;
    rdfs:comment 'Unique business identifier code for the consent form template used for reference across systems (e.g., HIPAA_AUTH_2024, SURG_CONSENT_V3).' ;
    rdfs:domain ind:ConsentFormTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Form Document Url' ;
    rdfs:comment 'URL or file path to the digital master copy of the consent form template document (PDF, Word, or other format) stored in the document management system.' ;
    rdfs:domain ind:ConsentFormTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formName rdf:type rdf:Property ;
    rdfs:label 'Form Name' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:ConsentFormTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formPurpose rdf:type rdf:Property ;
    rdfs:label 'Form Purpose' ;
    rdfs:comment 'Detailed description of the business and clinical purpose of this consent form template, including what actions or disclosures it authorizes and what patient rights it addresses.' ;
    rdfs:domain ind:ConsentFormTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formStatus rdf:type rdf:Property ;
    rdfs:label 'Form Status' ;
    rdfs:comment 'Current lifecycle status of the consent form template: draft (under development), pending_approval (awaiting review), active (approved for use), superseded (replaced by newer version), retired (no longer in use), withdrawn (removed from circulation).' ;
    rdfs:domain ind:ConsentFormTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irbApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Irb Approval Date' ;
    rdfs:comment 'Date when the IRB approved this research consent form template. Applicable only to research consent forms.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:irbExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Irb Expiration Date' ;
    rdfs:comment 'Date when the IRB approval for this research consent form expires and requires renewal. Applicable only to research consent forms.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:languageCode rdf:type rdf:Property ;
    rdfs:label 'Language Code' ;
    rdfs:comment 'ISO 639-1 two-letter language code (with optional ISO 3166-1 country code) indicating the language of the consent form template (e.g., en, es, zh-CN, fr-CA).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalRepresentativeAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Representative Allowed Flag' ;
    rdfs:comment 'Indicates whether a legal representative (guardian, power of attorney, parent) may sign this consent form on behalf of the patient. True if representative signature is permitted, False if patient signature is strictly required.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumAgeRequirement rdf:type rdf:Property ;
    rdfs:label 'Minimum Age Requirement' ;
    rdfs:comment 'Minimum age (in years) at which a patient may provide consent under this form template without parental or guardian involvement. Null if no age restriction applies or if form is not age-dependent.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minorAssentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Minor Assent Required Flag' ;
    rdfs:comment 'Indicates whether assent from a minor patient (in addition to parental consent) is required for this consent form. Applicable primarily to research and certain treatment contexts. True if minor assent is required, False otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Modified By User' ;
    rdfs:comment 'Username or identifier of the system user who last modified this consent form template record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Modified Timestamp' ;
    rdfs:comment 'Timestamp when this consent form template record was last modified.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:readingLevel rdf:type rdf:Property ;
    rdfs:label 'Reading Level' ;
    rdfs:comment 'Assessed reading comprehension level required to understand the consent form content, typically expressed as grade level (e.g., 6th grade, 8th grade) or readability score (Flesch-Kincaid). Important for health literacy compliance.' ;
    rdfs:domain ind:ConsentFormTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Retention Period Years' ;
    rdfs:comment 'Number of years that signed instances of this consent form must be retained per regulatory and legal requirements (e.g., 6 years per HIPAA, 7 years per state law, indefinitely for certain research consents).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revocationAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Revocation Allowed Flag' ;
    rdfs:comment 'Indicates whether the patient has the right to revoke consent given under this form template. True if revocation is permitted, False if consent is irrevocable (rare, typically only in certain research contexts).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revocationInstructions rdf:type rdf:Property ;
    rdfs:label 'Revocation Instructions' ;
    rdfs:comment 'Instructions provided to patients on how to revoke consent if revocation is allowed (e.g., written notice to Privacy Officer, submission of revocation form).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeOfConsent rdf:type rdf:Property ;
    rdfs:label 'Scope Of Consent' ;
    rdfs:comment 'Textual description of what the patient is consenting to, including specific procedures, data uses, disclosures, or participation activities covered by this form.' ;
    rdfs:domain ind:ConsentFormTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentEventId rdf:type rdf:Property ;
    rdfs:label 'Consent Event Id' ;
    rdfs:comment 'Unique identifier for the consent event record. Primary key for the consent event transaction.' ;
    rdfs:domain ind:ConsentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentSessionId rdf:type rdf:Property ;
    rdfs:label 'Consent Session Id' ;
    rdfs:comment 'Unique identifier for the user session during which the consent event was captured. Used for audit trail correlation.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentSession .

ind:delegationId rdf:type rdf:Property ;
    rdfs:label 'Delegation Id' ;
    rdfs:comment 'Reference to the legal representative or guardian who executed the consent on behalf of the patient, if applicable.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Delegation .

ind:primaryConsentRecordId rdf:type rdf:Property ;
    rdfs:label 'Primary Consent Record Id' ;
    rdfs:comment 'Reference to the parent consent record for which this event occurred. Links to the master consent entity.' ;
    rdfs:domain ind:ConsentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentRecord .

ind:priorConsentEventId rdf:type rdf:Property ;
    rdfs:label 'Prior Consent Event Id' ;
    rdfs:comment 'Reference to the immediately preceding consent event in the lifecycle chain. Used to construct the complete audit trail and event sequence.' ;
    rdfs:domain ind:ConsentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentEvent .

ind:triggeringMessageLogId rdf:type rdf:Property ;
    rdfs:label 'Triggering Message Log Id' ;
    rdfs:comment 'Foreign key linking to interoperability.message_log. Business justification: Consent events (obtain, revoke, amend) often trigger ADT^A31 updates or consent directive messages to HIE/trading partners. Regulatory audit requirement to trace which interoperability message was gen' ;
    rdfs:domain ind:ConsentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MessageLog .

ind:auditTrailReference rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Reference' ;
    rdfs:comment 'Reference or URI to the detailed audit log entry or provenance record for this consent event in the audit system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channel rdf:type rdf:Property ;
    rdfs:label 'Channel' ;
    rdfs:comment 'The channel or interface through which the consent event was captured or executed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceIdentifier rdf:type rdf:Property ;
    rdfs:label 'Device Identifier' ;
    rdfs:comment 'Identifier of the device (tablet, kiosk, workstation) used to capture the consent event. Used for audit and security tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Document Reference Code' ;
    rdfs:comment 'Reference to the scanned or electronic consent document associated with this event, if applicable. Links to document management system.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDate rdf:type rdf:Property ;
    rdfs:label 'Event Date' ;
    rdfs:comment 'The calendar date when the consent event occurred. Used for day-level reporting and analytics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Timestamp' ;
    rdfs:comment 'The precise date and time when the consent event occurred in the real world. This is the business event time, distinct from audit timestamps.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventType rdf:type rdf:Property ;
    rdfs:label 'Event Type' ;
    rdfs:comment 'The type of consent lifecycle event that occurred. Captures the specific action or state transition in the consent workflow. [ENUM-REF-CANDIDATE: presented|signed|witnessed|revoked|expired|renewed|amended|declined|deferred|superseded|verified — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipAddress rdf:type rdf:Property ;
    rdfs:label 'Ip Address' ;
    rdfs:comment 'The IP address from which the consent event was initiated, if captured electronically. Used for audit trail and fraud detection.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalRepresentativeFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Representative Flag' ;
    rdfs:comment 'Indicates whether the consent event was executed by a legal representative or guardian on behalf of the patient.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Flag' ;
    rdfs:comment 'Indicates whether an automated notification (email, SMS, portal message) was sent to the patient or relevant parties following this consent event.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Timestamp' ;
    rdfs:comment 'The date and time when the notification was sent following the consent event, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:performingUserRole rdf:type rdf:Property ;
    rdfs:label 'Performing User Role' ;
    rdfs:comment 'The role or capacity in which the performing user acted during the consent event. [ENUM-REF-CANDIDATE: patient|nurse|physician|registration_clerk|research_coordinator|legal_representative|guardian|witness|administrator|compliance_officer — promote to reference product]' ;
    rdfs:domain ind:ConsentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonCode rdf:type rdf:Property ;
    rdfs:label 'Reason Code' ;
    rdfs:comment 'Coded reason for the consent event, particularly for revocations, amendments, or declines. May reference standard code systems.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Free-text description of the reason for the consent event, providing additional context beyond the coded reason.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signatureCapturedFlag rdf:type rdf:Property ;
    rdfs:label 'Signature Captured Flag' ;
    rdfs:comment 'Indicates whether a signature was successfully captured during this consent event.' ;
    rdfs:domain ind:ConsentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signatureImageReference rdf:type rdf:Property ;
    rdfs:label 'Signature Image Reference' ;
    rdfs:comment 'Reference or URI to the stored signature image or digital signature artifact, if captured. Used for audit and legal verification.' ;
    rdfs:domain ind:ConsentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signatureMethod rdf:type rdf:Property ;
    rdfs:label 'Signature Method' ;
    rdfs:comment 'The method by which the consent was signed or acknowledged during this event.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemEventCode rdf:type rdf:Property ;
    rdfs:label 'Source System Event Code' ;
    rdfs:comment 'The unique identifier for this consent event in the source operational system. Used for data lineage and reconciliation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationMethod rdf:type rdf:Property ;
    rdfs:label 'Verification Method' ;
    rdfs:comment 'Method used to verify the identity of the person executing the consent event.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationStatus rdf:type rdf:Property ;
    rdfs:label 'Verification Status' ;
    rdfs:comment 'Status of identity verification or consent verification performed during this event. Critical for fraud prevention and compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaAuthorizationId rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization Id' ;
    rdfs:comment 'Unique identifier for the HIPAA authorization record. Primary key for the authorization entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HipaaAuthorization .

ind:demographicsId rdf:type rdf:Property ;
    rdfs:label 'Demographics Id' ;
    rdfs:comment 'Reference to the patient who is granting the HIPAA authorization for use or disclosure of their Protected Health Information (PHI).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Demographics .

ind:supersededHipaaAuthorizationId rdf:type rdf:Property ;
    rdfs:label 'Superseded Hipaa Authorization Id' ;
    rdfs:comment 'Self-referencing FK on hipaa_authorization (superseded_hipaa_authorization_id)' ;
    rdfs:domain ind:HipaaAuthorization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HipaaAuthorization .

ind:transmittedCdaDocumentId rdf:type rdf:Property ;
    rdfs:label 'Transmitted Cda Document Id' ;
    rdfs:comment 'Foreign key linking to interoperability.cda_document. Business justification: HIPAA authorizations are transmitted as CDA documents during care transitions, especially for specialty referrals and discharge summaries. Tracking which CDA document contained the authorization is re' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CdaDocument .

ind:authorizationPurpose rdf:type rdf:Property ;
    rdfs:label 'Authorization Purpose' ;
    rdfs:comment 'The specific purpose for which the patient is authorizing the use or disclosure of PHI beyond treatment, payment, and operations (TPO). Must be one of the purposes requiring explicit HIPAA authorization under 45 CFR 164.508.' ;
    rdfs:domain ind:HipaaAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationPurposeDescription rdf:type rdf:Property ;
    rdfs:label 'Authorization Purpose Description' ;
    rdfs:comment 'Detailed free-text description of the specific purpose for the authorization, providing additional context beyond the categorical purpose code.' ;
    rdfs:domain ind:HipaaAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compensationDisclosureFlag rdf:type rdf:Property ;
    rdfs:label 'Compensation Disclosure Flag' ;
    rdfs:comment 'Indicates whether the authorization includes disclosure that the covered entity will receive direct or indirect remuneration from a third party in exchange for using or disclosing PHI. Required for authorizations involving sale of PHI.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disclosingPartyName rdf:type rdf:Property ;
    rdfs:label 'Disclosing Party Name' ;
    rdfs:comment 'Name of the covered entity or individual authorized to make the disclosure of PHI (typically the healthcare organization or provider).' ;
    rdfs:domain ind:HipaaAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosingPartyNpi rdf:type rdf:Property ;
    rdfs:label 'Disclosing Party Npi' ;
    rdfs:comment 'National Provider Identifier of the disclosing party, if applicable. Used for provider identification and compliance tracking.' ;
    rdfs:domain ind:HipaaAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentReference rdf:type rdf:Property ;
    rdfs:label 'Document Reference' ;
    rdfs:comment 'Reference identifier or URI to the scanned or electronically stored copy of the signed authorization form in the document management system.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expirationEvent rdf:type rdf:Property ;
    rdfs:label 'Expiration Event' ;
    rdfs:comment 'Description of the event that will cause the authorization to expire (e.g., end of research study, completion of legal proceeding). Used when expiration is event-based rather than date-based.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formVersion rdf:type rdf:Property ;
    rdfs:label 'Form Version' ;
    rdfs:comment 'Version identifier of the HIPAA authorization form template used. Used for tracking form updates and ensuring compliance with current regulatory requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personalRepresentativeFlag rdf:type rdf:Property ;
    rdfs:label 'Personal Representative Flag' ;
    rdfs:comment 'Indicates whether the authorization was signed by a personal representative on behalf of the patient (e.g., parent, guardian, power of attorney).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:personalRepresentativeName rdf:type rdf:Property ;
    rdfs:label 'Personal Representative Name' ;
    rdfs:comment 'Name of the personal representative who signed the authorization on behalf of the patient, if applicable.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personalRepresentativeRelationship rdf:type rdf:Property ;
    rdfs:label 'Personal Representative Relationship' ;
    rdfs:comment 'Relationship of the personal representative to the patient (e.g., parent, legal guardian, power of attorney).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiCategory rdf:type rdf:Property ;
    rdfs:label 'Phi Category' ;
    rdfs:comment 'High-level categorization of the type of PHI covered by this authorization. Used for reporting and compliance tracking. [ENUM-REF-CANDIDATE: complete_medical_record|specific_encounter|lab_results|radiology_images|psychotherapy_notes|substance_abuse_records|hiv_aids_records|mental_health_records|genetic_information|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiDescription rdf:type rdf:Property ;
    rdfs:label 'Phi Description' ;
    rdfs:comment 'Detailed description of the specific PHI elements or categories authorized for disclosure (e.g., medical records from specific dates, lab results, psychotherapy notes, HIV status, substance abuse treatment records).' ;
    rdfs:domain ind:HipaaAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientAddress rdf:type rdf:Property ;
    rdfs:label 'Recipient Address' ;
    rdfs:comment 'Mailing address of the recipient authorized to receive the PHI disclosure.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientName rdf:type rdf:Property ;
    rdfs:label 'Recipient Name' ;
    rdfs:comment 'Name of the person or entity authorized to receive the disclosed PHI (e.g., research institution, attorney, insurance company, marketing firm).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientOrganization rdf:type rdf:Property ;
    rdfs:label 'Recipient Organization' ;
    rdfs:comment 'Organization name of the recipient entity, if the recipient is an organization rather than an individual.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redisclosureStatement rdf:type rdf:Property ;
    rdfs:label 'Redisclosure Statement' ;
    rdfs:comment 'Statement informing the patient that information disclosed pursuant to the authorization may be subject to redisclosure by the recipient and may no longer be protected by HIPAA.' ;
    rdfs:domain ind:HipaaAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightToRevokeStatement rdf:type rdf:Property ;
    rdfs:label 'Right To Revoke Statement' ;
    rdfs:comment 'Statement informing the patient of their right to revoke the authorization and any exceptions to that right (e.g., if action has already been taken in reliance on the authorization).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signatureDate rdf:type rdf:Property ;
    rdfs:label 'Signature Date' ;
    rdfs:comment 'Date on which the patient signed the HIPAA authorization form.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:signatureObtainedFlag rdf:type rdf:Property ;
    rdfs:label 'Signature Obtained Flag' ;
    rdfs:comment 'Indicates whether the required patient signature has been obtained on the authorization form. HIPAA requires a valid signature for the authorization to be effective.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:witnessSignatureDate rdf:type rdf:Property ;
    rdfs:label 'Witness Signature Date' ;
    rdfs:comment 'Date on which the witness signed the authorization form, if applicable.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hieDirectiveId rdf:type rdf:Property ;
    rdfs:label 'Hie Directive Id' ;
    rdfs:comment 'Unique identifier for the HIE directive record. Primary key.' ;
    rdfs:domain ind:HieDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hieParticipationId rdf:type rdf:Property ;
    rdfs:label 'Hie Participation Id' ;
    rdfs:comment 'Foreign key linking to interoperability.hie_participation. Business justification: HIE directives are scoped to specific organizational HIE participation agreements. Business needs to enforce which HIE network participation governs each patient directive, especially when organizatio' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HieParticipation .

ind:supersededHieDirectiveId rdf:type rdf:Property ;
    rdfs:label 'Superseded Hie Directive Id' ;
    rdfs:comment 'Self-referencing FK on hie_directive (superseded_hie_directive_id)' ;
    rdfs:domain ind:HieDirective ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HieDirective .

ind:tradingPartnerId rdf:type rdf:Property ;
    rdfs:label 'Trading Partner Id' ;
    rdfs:comment 'Foreign key linking to interoperability.trading_partner. Business justification: HIE directives specify which trading partners (specific hospitals, health systems, HIEs) can access patient data. Required for operational enforcement of patient restrictions—when patient opts out of ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TradingPartner .

ind:auditLogReference rdf:type rdf:Property ;
    rdfs:label 'Audit Log Reference' ;
    rdfs:comment 'Reference identifier linking this directive to detailed audit logs of HIE access events.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakGlassEventsCount rdf:type rdf:Property ;
    rdfs:label 'Break Glass Events Count' ;
    rdfs:comment 'Number of times emergency break-glass access has been invoked to override this directive.' ;
    rdfs:domain ind:HieDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataTypeRestrictions rdf:type rdf:Property ;
    rdfs:label 'Data Type Restrictions' ;
    rdfs:comment 'Comma-separated list of specific data types or categories the patient has restricted from sharing (e.g., mental health, substance abuse, HIV status, genetic information).' ;
    rdfs:domain ind:HieDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directiveType rdf:type rdf:Property ;
    rdfs:label 'Directive Type' ;
    rdfs:comment 'Type of HIE directive: opt-in (patient consents to share), opt-out (patient declines to share), opt-out with exceptions (patient declines except for specified cases), or conditional (patient sets specific conditions).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyAccessOverride rdf:type rdf:Property ;
    rdfs:label 'Emergency Access Override' ;
    rdfs:comment 'Indicates whether emergency access provisions allow providers to override this directive in life-threatening situations.' ;
    rdfs:domain ind:HieDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:federalOverrideApplicable rdf:type rdf:Property ;
    rdfs:label 'Federal Override Applicable' ;
    rdfs:comment 'Indicates whether federal regulations (e.g., 42 CFR Part 2 for substance abuse) override state HIE consent laws for this directive.' ;
    rdfs:domain ind:HieDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interpreterUsed rdf:type rdf:Property ;
    rdfs:label 'Interpreter Used' ;
    rdfs:comment 'Indicates whether a medical interpreter was used to explain the HIE directive to the patient.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastBreakGlassDate rdf:type rdf:Property ;
    rdfs:label 'Last Break Glass Date' ;
    rdfs:comment 'Timestamp of the most recent emergency break-glass access event.' ;
    rdfs:domain ind:HieDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastVerifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Verified Timestamp' ;
    rdfs:comment 'Timestamp when the directive was last verified with the patient or confirmed as still valid.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:legalRepresentativeName rdf:type rdf:Property ;
    rdfs:label 'Legal Representative Name' ;
    rdfs:comment 'Name of the legal representative (guardian, power of attorney) who provided consent on behalf of the patient, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalRepresentativeRelationship rdf:type rdf:Property ;
    rdfs:label 'Legal Representative Relationship' ;
    rdfs:comment 'Relationship of the legal representative to the patient (e.g., parent, guardian, healthcare proxy, power of attorney).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Date' ;
    rdfs:comment 'Scheduled date for the next review or reconfirmation of this HIE directive with the patient.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:patientEducationProvided rdf:type rdf:Property ;
    rdfs:label 'Patient Education Provided' ;
    rdfs:comment 'Indicates whether educational materials about HIE participation were provided to the patient.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientInstructions rdf:type rdf:Property ;
    rdfs:label 'Patient Instructions' ;
    rdfs:comment 'Free-text field capturing any additional instructions or conditions specified by the patient regarding HIE participation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerRestrictions rdf:type rdf:Property ;
    rdfs:label 'Provider Restrictions' ;
    rdfs:comment 'Comma-separated list of specific provider organizations or individuals the patient has restricted from accessing their data via HIE.' ;
    rdfs:domain ind:HieDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purposeOfUseRestrictions rdf:type rdf:Property ;
    rdfs:label 'Purpose Of Use Restrictions' ;
    rdfs:comment 'Comma-separated list of purposes for which data sharing is restricted or permitted (e.g., treatment, payment, operations, research, public health).' ;
    rdfs:domain ind:HieDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeOfSharing rdf:type rdf:Property ;
    rdfs:label 'Scope Of Sharing' ;
    rdfs:comment 'Defines the breadth of data sharing permitted: all records, specific data types only, specific providers only, emergency situations only, or treatment purposes only.' ;
    rdfs:domain ind:HieDirective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Code' ;
    rdfs:comment 'Unique identifier of this directive in the source system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateJurisdiction rdf:type rdf:Property ;
    rdfs:label 'State Jurisdiction' ;
    rdfs:comment 'Two-letter state code indicating the jurisdiction whose HIE consent laws govern this directive.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentConsentId rdf:type rdf:Property ;
    rdfs:label 'Treatment Consent Id' ;
    rdfs:comment 'Unique identifier for the treatment consent record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreatmentConsent .

ind:cptCodeId rdf:type rdf:Property ;
    rdfs:label 'Cpt Code Id' ;
    rdfs:comment 'The CPT or ICD-10-PCS code identifying the specific procedure or treatment being consented to. Applicable for procedure-specific consent types.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CptCode .

ind:primaryTreatmentClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Treatment Clinician Id' ;
    rdfs:comment 'Reference to the provider who performed the clinical assessment of the patients decision-making capacity.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:supersededTreatmentConsentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Treatment Consent Id' ;
    rdfs:comment 'Self-referencing FK on treatment_consent (superseded_treatment_consent_id)' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreatmentConsent .

ind:tertiaryTreatmentPerformingProviderClinicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Treatment Performing Provider Clinician Id' ;
    rdfs:comment 'Reference to the provider who will perform the procedure or treatment for which consent was obtained.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:treatmentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Treatment Employee Id' ;
    rdfs:comment 'Identifier of the system user who created this treatment consent record.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:alternativesDocumented rdf:type rdf:Property ;
    rdfs:label 'Alternatives Documented' ;
    rdfs:comment 'Narrative documentation of alternative treatment options that were disclosed to and discussed with the patient or authorized representative.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitsDocumented rdf:type rdf:Property ;
    rdfs:label 'Benefits Documented' ;
    rdfs:comment 'Narrative documentation of the expected benefits of the procedure or treatment that were disclosed to and discussed with the patient or authorized representative.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityDetermination rdf:type rdf:Property ;
    rdfs:label 'Capacity Determination' ;
    rdfs:comment 'Clinical determination of whether the patient has decision-making capacity to provide informed consent for the treatment or procedure.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentDocumentLocation rdf:type rdf:Property ;
    rdfs:label 'Consent Document Location' ;
    rdfs:comment 'Reference to the location or system where the signed consent document is stored (e.g., EMR document ID, scanned document repository path).' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentFormNumber rdf:type rdf:Property ;
    rdfs:label 'Consent Form Number' ;
    rdfs:comment 'The externally-known unique identifier or form number for this treatment consent document.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentVersion rdf:type rdf:Property ;
    rdfs:label 'Consent Version' ;
    rdfs:comment 'Version identifier of the consent form template used, for tracking form revisions and ensuring compliance with current organizational policies.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdDatetime rdf:type rdf:Property ;
    rdfs:label 'Created Datetime' ;
    rdfs:comment 'The date and time when this treatment consent record was first created in the system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:emergencyExceptionFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Exception Flag' ;
    rdfs:comment 'Indicates whether treatment was provided under emergency exception provisions when informed consent could not be obtained due to the patients condition and no authorized representative was available.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyExceptionJustification rdf:type rdf:Property ;
    rdfs:label 'Emergency Exception Justification' ;
    rdfs:comment 'Clinical documentation justifying why treatment was provided without informed consent under emergency exception provisions.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterLanguage rdf:type rdf:Property ;
    rdfs:label 'Interpreter Language' ;
    rdfs:comment 'The language in which interpretation services were provided during the consent process.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedDatetime rdf:type rdf:Property ;
    rdfs:label 'Last Updated Datetime' ;
    rdfs:comment 'The date and time when this treatment consent record was last modified in the system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:legalRepresentativePhone rdf:type rdf:Property ;
    rdfs:label 'Legal Representative Phone' ;
    rdfs:comment 'Contact phone number for the legal representative or authorized decision-maker.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalRepresentativeRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Representative Required Flag' ;
    rdfs:comment 'Indicates whether a legal representative or authorized decision-maker was required to provide consent on behalf of the patient due to lack of capacity.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientQuestionsAddressedFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Questions Addressed Flag' ;
    rdfs:comment 'Indicates whether the patient or authorized representative had the opportunity to ask questions and all questions were addressed prior to obtaining consent.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientQuestionsNotes rdf:type rdf:Property ;
    rdfs:label 'Patient Questions Notes' ;
    rdfs:comment 'Free-text documentation of specific questions asked by the patient or authorized representative and the responses provided.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revokedByName rdf:type rdf:Property ;
    rdfs:label 'Revoked By Name' ;
    rdfs:comment 'Name of the individual (patient or authorized representative) who revoked the consent.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:risksDocumented rdf:type rdf:Property ;
    rdfs:label 'Risks Documented' ;
    rdfs:comment 'Narrative documentation of the material risks of the procedure or treatment that were disclosed to and discussed with the patient or authorized representative.' ;
    rdfs:domain ind:TreatmentConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialInstructions rdf:type rdf:Property ;
    rdfs:label 'Special Instructions' ;
    rdfs:comment 'Any special instructions, limitations, or conditions specified by the patient or authorized representative as part of the consent (e.g., no blood products, specific anesthesia preferences).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessRole rdf:type rdf:Property ;
    rdfs:label 'Witness Role' ;
    rdfs:comment 'The role or title of the witness (e.g., registered nurse, social worker, patient advocate).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchConsentId rdf:type rdf:Property ;
    rdfs:label 'Research Consent Id' ;
    rdfs:comment 'Unique identifier for the research consent record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchConsent .

ind:supersededResearchConsentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Research Consent Id' ;
    rdfs:comment 'Self-referencing FK on research_consent (superseded_research_consent_id)' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchConsent .

ind:biospecimenCollectionAuthorized rdf:type rdf:Property ;
    rdfs:label 'Biospecimen Collection Authorized' ;
    rdfs:comment 'Indicates whether the subject authorized collection and storage of biospecimens (blood, tissue, DNA) for research purposes.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:comprehensionAssessmentMethod rdf:type rdf:Property ;
    rdfs:label 'Comprehension Assessment Method' ;
    rdfs:comment 'Method used to assess subject comprehension (e.g., teach-back, quiz, verbal confirmation).' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comprehensionAssessmentResult rdf:type rdf:Property ;
    rdfs:label 'Comprehension Assessment Result' ;
    rdfs:comment 'Result of the comprehension assessment indicating whether the subject demonstrated adequate understanding of the study.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentDiscussionDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Consent Discussion Duration Minutes' ;
    rdfs:comment 'Duration in minutes of the informed consent discussion between the consenting provider and the research subject.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Consent Document Url' ;
    rdfs:comment 'URL or file path to the signed consent document stored in the document management system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentLocation rdf:type rdf:Property ;
    rdfs:label 'Consent Location' ;
    rdfs:comment 'Physical location or facility where the consent process took place (e.g., clinic name, hospital unit, research center).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentingProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Consenting Provider Npi' ;
    rdfs:comment 'National Provider Identifier of the provider who obtained consent. 10-digit unique identifier.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactForFutureStudiesAuthorized rdf:type rdf:Property ;
    rdfs:label 'Contact For Future Studies Authorized' ;
    rdfs:comment 'Indicates whether the subject authorized being contacted for participation in future research studies.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSharingAuthorized rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Authorized' ;
    rdfs:comment 'Indicates whether the subject authorized sharing of their de-identified research data with external researchers or repositories.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:electronicSignatureCode rdf:type rdf:Property ;
    rdfs:label 'Electronic Signature Code' ;
    rdfs:comment 'Unique identifier of the electronic signature captured during the consent process, if applicable.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:futureResearchAuthorized rdf:type rdf:Property ;
    rdfs:label 'Future Research Authorized' ;
    rdfs:comment 'Indicates whether the subject authorized use of their data and biospecimens for future unspecified research studies.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geneticTestingAuthorized rdf:type rdf:Property ;
    rdfs:label 'Genetic Testing Authorized' ;
    rdfs:comment 'Indicates whether the subject authorized genetic testing and analysis of their biospecimens.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaAuthorizationIncluded rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization Included' ;
    rdfs:comment 'Indicates whether HIPAA authorization for use and disclosure of protected health information was included in the research consent.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:irbProtocolNumber rdf:type rdf:Property ;
    rdfs:label 'Irb Protocol Number' ;
    rdfs:comment 'IRB protocol number under which this consent was obtained. Links consent to the approved research protocol.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:larContactPhone rdf:type rdf:Property ;
    rdfs:label 'Lar Contact Phone' ;
    rdfs:comment 'Contact phone number of the legally authorized representative.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:larName rdf:type rdf:Property ;
    rdfs:label 'Lar Name' ;
    rdfs:comment 'Full name of the legally authorized representative who provided consent on behalf of the subject.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:larRelationship rdf:type rdf:Property ;
    rdfs:label 'Lar Relationship' ;
    rdfs:comment 'Relationship of the LAR to the research subject (e.g., parent, guardian, healthcare proxy, power of attorney).' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:larUsed rdf:type rdf:Property ;
    rdfs:label 'Lar Used' ;
    rdfs:comment 'Indicates whether a legally authorized representative provided consent on behalf of an incapacitated or minor subject.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minorAssentDate rdf:type rdf:Property ;
    rdfs:label 'Minor Assent Date' ;
    rdfs:comment 'Date on which assent was obtained from the minor subject.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minorAssentObtained rdf:type rdf:Property ;
    rdfs:label 'Minor Assent Obtained' ;
    rdfs:comment 'Indicates whether assent was obtained from a minor subject in addition to parental consent, as required by IRB protocol.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconsentDate rdf:type rdf:Property ;
    rdfs:label 'Reconsent Date' ;
    rdfs:comment 'Date on which reconsent was obtained following a protocol amendment or other triggering event.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reconsentReason rdf:type rdf:Property ;
    rdfs:label 'Reconsent Reason' ;
    rdfs:comment 'Reason for requiring reconsent (e.g., protocol amendment, new safety information, change in study procedures).' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconsentRequired rdf:type rdf:Property ;
    rdfs:label 'Reconsent Required' ;
    rdfs:comment 'Indicates whether reconsent is required due to protocol amendment, new risks identified, or other changes to the study.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnOfResultsRequested rdf:type rdf:Property ;
    rdfs:label 'Return Of Results Requested' ;
    rdfs:comment 'Indicates whether the subject requested to receive individual research results or incidental findings from the study.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:studyArm rdf:type rdf:Property ;
    rdfs:label 'Study Arm' ;
    rdfs:comment 'The specific arm or cohort of the study to which the subject was assigned (e.g., treatment, control, placebo).' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectComprehensionAssessed rdf:type rdf:Property ;
    rdfs:label 'Subject Comprehension Assessed' ;
    rdfs:comment 'Indicates whether the research subjects comprehension of the study risks, benefits, and procedures was formally assessed during the consent process.' ;
    rdfs:domain ind:ResearchConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:witnessRequired rdf:type rdf:Property ;
    rdfs:label 'Witness Required' ;
    rdfs:comment 'Indicates whether a witness signature was required for the consent process (e.g., for illiterate subjects or per IRB protocol).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telehealthConsentId rdf:type rdf:Property ;
    rdfs:label 'Telehealth Consent Id' ;
    rdfs:comment 'Unique identifier for the telehealth consent record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TelehealthConsent .

ind:supersededTelehealthConsentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Telehealth Consent Id' ;
    rdfs:comment 'Self-referencing FK on telehealth_consent (superseded_telehealth_consent_id)' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TelehealthConsent .

ind:cmsConditionMet rdf:type rdf:Property ;
    rdfs:label 'Cms Condition Met' ;
    rdfs:comment 'Indicates whether this telehealth consent satisfies CMS Conditions of Participation for telehealth service delivery and reimbursement.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentDocumentCode rdf:type rdf:Property ;
    rdfs:label 'Consent Document Code' ;
    rdfs:comment 'Unique identifier or reference to the scanned or electronically signed consent document stored in the document management system.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentObtainedBy rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained By' ;
    rdfs:comment 'Name or identifier of the staff member, provider, or system that obtained and documented the telehealth consent.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentObtainedMethod rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained Method' ;
    rdfs:comment 'The method by which the patients telehealth consent was captured (e.g., signed paper form, electronic signature, verbal consent documented in EHR).' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRetentionPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Data Retention Period Days' ;
    rdfs:comment 'Number of days that telehealth session recordings and data will be retained, as disclosed to and consented by the patient.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emergencyOverrideApplicable rdf:type rdf:Property ;
    rdfs:label 'Emergency Override Applicable' ;
    rdfs:comment 'Indicates whether this telehealth consent was obtained under emergency circumstances where standard consent procedures were modified per EMTALA or state emergency laws.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interstateCompactApplicable rdf:type rdf:Property ;
    rdfs:label 'Interstate Compact Applicable' ;
    rdfs:comment 'Indicates whether an interstate medical licensure compact (e.g., IMLC) applies to this telehealth consent, allowing cross-state practice.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalGuardianName rdf:type rdf:Property ;
    rdfs:label 'Legal Guardian Name' ;
    rdfs:comment 'Name of the legal guardian who provided consent on behalf of a minor or incapacitated patient.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalGuardianRelationship rdf:type rdf:Property ;
    rdfs:label 'Legal Guardian Relationship' ;
    rdfs:comment 'The relationship of the legal guardian to the patient (e.g., parent, court-appointed guardian, healthcare proxy).' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minorConsentApplicable rdf:type rdf:Property ;
    rdfs:label 'Minor Consent Applicable' ;
    rdfs:comment 'Indicates whether this consent involves a minor patient and requires parental or guardian authorization.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientLocationState rdf:type rdf:Property ;
    rdfs:label 'Patient Location State' ;
    rdfs:comment 'Two-letter state code where the patient will be physically located during telehealth services. Determines applicable state telehealth laws.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerLicensureState rdf:type rdf:Property ;
    rdfs:label 'Provider Licensure State' ;
    rdfs:comment 'Two-letter state code where the provider holds active medical licensure. Critical for interstate telehealth compliance.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerNpi rdf:type rdf:Property ;
    rdfs:label 'Provider Npi' ;
    rdfs:comment 'The 10-digit National Provider Identifier of the provider delivering telehealth services. Required for billing and licensure verification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingConsentProvided rdf:type rdf:Property ;
    rdfs:label 'Recording Consent Provided' ;
    rdfs:comment 'Indicates whether the patient consented to audio or video recording of telehealth sessions for quality, training, or medical record purposes.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rightToRefuseDisclosed rdf:type rdf:Property ;
    rdfs:label 'Right To Refuse Disclosed' ;
    rdfs:comment 'Indicates whether the patient was informed of their right to refuse telehealth services and receive in-person care instead.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scopeOfServices rdf:type rdf:Property ;
    rdfs:label 'Scope Of Services' ;
    rdfs:comment 'Description of the types of clinical services covered under this telehealth consent (e.g., primary care visits, behavioral health, chronic disease management).' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateSpecificRequirementsMet rdf:type rdf:Property ;
    rdfs:label 'State Specific Requirements Met' ;
    rdfs:comment 'Flag indicating whether all state-specific telehealth consent requirements have been satisfied (e.g., informed consent elements, parental consent for minors).' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:technologyRisksDisclosed rdf:type rdf:Property ;
    rdfs:label 'Technology Risks Disclosed' ;
    rdfs:comment 'Indicates whether the patient was informed of technology risks including potential for technical failure, privacy breaches, and limitations of virtual examination.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telehealthModality rdf:type rdf:Property ;
    rdfs:label 'Telehealth Modality' ;
    rdfs:comment 'The type of telehealth technology and interaction method the patient consents to use. Determines the mode of virtual care delivery.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telehealthPlatform rdf:type rdf:Property ;
    rdfs:label 'Telehealth Platform' ;
    rdfs:comment 'Name or identifier of the telehealth technology platform the patient will use for virtual visits (e.g., Epic MyChart Video, Zoom for Healthcare, Doxy.me).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyDisclosureAuthorized rdf:type rdf:Property ;
    rdfs:label 'Third Party Disclosure Authorized' ;
    rdfs:comment 'Indicates whether the patient authorized disclosure of telehealth session information to third parties such as family members, caregivers, or other providers.' ;
    rdfs:domain ind:TelehealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minorConsentId rdf:type rdf:Property ;
    rdfs:label 'Minor Consent Id' ;
    rdfs:comment 'Unique identifier for the minor consent record. Primary key.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededMinorConsentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Minor Consent Id' ;
    rdfs:comment 'Self-referencing FK on minor_consent (superseded_minor_consent_id)' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MinorConsent .

ind:basis rdf:type rdf:Property ;
    rdfs:label 'Basis' ;
    rdfs:comment 'The legal basis under which consent is being obtained or documented: mature minor doctrine, emancipated minor status, state-specific minor consent laws (e.g., STI treatment, substance abuse, mental health, reproductive health), parental/guardian consent, or court-ordered consent.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityObligationToMinorFlag rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Obligation To Minor Flag' ;
    rdfs:comment 'Indicates whether the healthcare provider has a legal or ethical obligation to maintain confidentiality of the minors health information from parents/guardians (e.g., when minor consents independently under state law for sensitive services).' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentScopeDescription rdf:type rdf:Property ;
    rdfs:label 'Consent Scope Description' ;
    rdfs:comment 'Detailed description of what the consent covers, including specific treatments, procedures, data sharing purposes, or research protocols.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtOrderReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Court Order Reference Number' ;
    rdfs:comment 'Reference number or case number of the court order governing consent authority or restrictions, if applicable.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtOrderedConsentRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Court Ordered Consent Restriction Flag' ;
    rdfs:comment 'Indicates whether there are court-ordered restrictions on who may provide consent for the minor (e.g., one parent prohibited from consenting due to custody order).' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:custodialParentVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Custodial Parent Verified Flag' ;
    rdfs:comment 'Indicates whether the consenting parent has been verified as having legal custody and authority to consent on behalf of the minor, particularly important in cases of divorce or separation.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:custodyDocumentationType rdf:type rdf:Property ;
    rdfs:label 'Custody Documentation Type' ;
    rdfs:comment 'The type of documentation reviewed to verify custodial parent or guardian status.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSharingScope rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Scope' ;
    rdfs:comment 'Description of the scope and purpose of data sharing authorized by this consent (e.g., specific recipients, purposes, data elements).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emancipatedMinorFlag rdf:type rdf:Property ;
    rdfs:label 'Emancipated Minor Flag' ;
    rdfs:comment 'Indicates whether the minor has been legally emancipated and therefore has full consent rights as an adult.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emancipationDocumentationType rdf:type rdf:Property ;
    rdfs:label 'Emancipation Documentation Type' ;
    rdfs:comment 'The type of documentation provided to verify emancipated minor status, if applicable.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hieParticipationStatus rdf:type rdf:Property ;
    rdfs:label 'Hie Participation Status' ;
    rdfs:comment 'Indicates whether the minor (or parent/guardian on their behalf) has opted in or out of Health Information Exchange participation.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterUsedFlag rdf:type rdf:Property ;
    rdfs:label 'Interpreter Used Flag' ;
    rdfs:comment 'Indicates whether a medical interpreter was used during the consent process to ensure understanding.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minorAgeAtConsent rdf:type rdf:Property ;
    rdfs:label 'Minor Age At Consent' ;
    rdfs:comment 'The age of the minor patient at the time consent was obtained, used to determine applicability of age-based consent rules.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minorAssentObtainedFlag rdf:type rdf:Property ;
    rdfs:label 'Minor Assent Obtained Flag' ;
    rdfs:comment 'Indicates whether the minors assent (agreement) was obtained in addition to parental consent, particularly relevant for research participation and certain clinical procedures.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minorConsentingIndependentlyFlag rdf:type rdf:Property ;
    rdfs:label 'Minor Consenting Independently Flag' ;
    rdfs:comment 'Indicates whether the minor is providing consent independently without parental/guardian involvement, based on mature minor doctrine, emancipation, or state-specific minor consent rights.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentGuardianName rdf:type rdf:Property ;
    rdfs:label 'Parent Guardian Name' ;
    rdfs:comment 'Full name of the parent or legal guardian providing consent, if applicable.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentalConsentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Parental Consent Required Flag' ;
    rdfs:comment 'Indicates whether parental or guardian consent is required for the treatment or service being provided.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentalNotificationPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Parental Notification Permitted Flag' ;
    rdfs:comment 'Indicates whether parental notification of the minors care is permitted under applicable law and the minors consent preferences.' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revocationReason rdf:type rdf:Property ;
    rdfs:label 'Revocation Reason' ;
    rdfs:comment 'Free-text explanation of why the consent was revoked, if provided.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revokedBy rdf:type rdf:Property ;
    rdfs:label 'Revoked By' ;
    rdfs:comment 'Identifies who revoked the consent: the minor themselves, parent, guardian, court order, or system (e.g., automatic expiration).' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateSpecificMinorConsentCategory rdf:type rdf:Property ;
    rdfs:label 'State Specific Minor Consent Category' ;
    rdfs:comment 'The specific category of care for which state law permits minors to consent independently without parental involvement (e.g., sexually transmitted infection treatment, reproductive health services, substance abuse treatment, mental health services). [ENUM-REF-CANDIDATE: sti_treatment|reproductive_health|substance_abuse|mental_health|prenatal_care|sexual_assault|not_applicable — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:MinorConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegationEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Delegation Employee Id' ;
    rdfs:comment 'Identifier of the user or staff member who created the consent delegation record.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:delegationMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Delegation Mpi Record Id' ;
    rdfs:comment 'Identifier of the patient for whom consent delegation authority is being granted. Links to the patient master record.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:supersededDelegationId rdf:type rdf:Property ;
    rdfs:label 'Superseded Delegation Id' ;
    rdfs:comment 'Self-referencing FK on delegation (superseded_delegation_id)' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Delegation .

ind:tertiaryEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Employee Id' ;
    rdfs:comment 'Identifier of the user or staff member who last modified the consent delegation record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:appliesToMinor rdf:type rdf:Property ;
    rdfs:label 'Applies To Minor' ;
    rdfs:comment 'Boolean flag indicating whether this delegation applies to a minor patient. True if the patient is a minor and the delegate has parental or guardian authority.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Consent Verification Date' ;
    rdfs:comment 'Date when the delegation authority was verified by authorized staff. Used for audit and compliance tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Consent Verification Status' ;
    rdfs:comment 'Status of verification of the delegation authority and supporting documentation. Indicates whether the legal authority has been confirmed by appropriate staff or legal review.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegateAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Delegate Address Line1' ;
    rdfs:comment 'First line of the delegates mailing address (street address, PO Box).' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegateAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Delegate Address Line2' ;
    rdfs:comment 'Second line of the delegates mailing address (apartment, suite, unit number). Nullable if not applicable.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegateCity rdf:type rdf:Property ;
    rdfs:label 'Delegate City' ;
    rdfs:comment 'City of the delegates mailing address.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegateContactEmail rdf:type rdf:Property ;
    rdfs:label 'Delegate Contact Email' ;
    rdfs:comment 'Primary email address for the delegate. Used for electronic communication regarding consent matters.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegateContactPhone rdf:type rdf:Property ;
    rdfs:label 'Delegate Contact Phone' ;
    rdfs:comment 'Primary contact phone number for the delegate. Used to reach the authorized representative for consent decisions.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegateCountry rdf:type rdf:Property ;
    rdfs:label 'Delegate Country' ;
    rdfs:comment 'Country of the delegates mailing address. Three-letter ISO 3166-1 alpha-3 country code.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegateName rdf:type rdf:Property ;
    rdfs:label 'Delegate Name' ;
    rdfs:comment 'Full legal name of the authorized representative or surrogate decision-maker.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegatePostalCode rdf:type rdf:Property ;
    rdfs:label 'Delegate Postal Code' ;
    rdfs:comment 'Postal code or ZIP code of the delegates mailing address.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegateRelationship rdf:type rdf:Property ;
    rdfs:label 'Delegate Relationship' ;
    rdfs:comment 'Relationship of the delegate to the patient (e.g., spouse, parent, legal guardian, healthcare proxy). [ENUM-REF-CANDIDATE: spouse|parent|adult_child|sibling|legal_guardian|healthcare_proxy|power_of_attorney|court_appointed_guardian|next_of_kin|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegateState rdf:type rdf:Property ;
    rdfs:label 'Delegate State' ;
    rdfs:comment 'State or province of the delegates mailing address. Two-letter state code for US addresses.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegationScope rdf:type rdf:Property ;
    rdfs:label 'Delegation Scope' ;
    rdfs:comment 'Scope of authority granted to the delegate. Defines what types of consent decisions the delegate is authorized to make (e.g., full medical decisions, treatment consent only, research consent, data sharing, financial decisions, emergency-only). [ENUM-REF-CANDIDATE: full_medical_decisions|treatment_consent_only|research_consent_only|data_sharing_authorization|financial_decisions|limited_scope|emergency_only — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegationStatus rdf:type rdf:Property ;
    rdfs:label 'Delegation Status' ;
    rdfs:comment 'Current lifecycle status of the delegation authority. Indicates whether the delegation is currently in effect, has been revoked, has expired, or is pending verification.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delegationType rdf:type rdf:Property ;
    rdfs:label 'Delegation Type' ;
    rdfs:comment 'Type of legal authority granted to the delegate. Distinguishes between healthcare proxy, durable power of attorney for healthcare (DPOA-HC), legal guardianship, court-appointed guardianship, next-of-kin surrogate per state law, and parental authority for minors.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveEndDate rdf:type rdf:Property ;
    rdfs:label 'Effective End Date' ;
    rdfs:comment 'Date when the delegation authority expires or terminates. Nullable for open-ended delegations. The delegate is no longer authorized to provide consent after this date.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveStartDate rdf:type rdf:Property ;
    rdfs:label 'Effective Start Date' ;
    rdfs:comment 'Date when the delegation authority becomes effective. The delegate is authorized to provide consent on or after this date.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:emergencyContactFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Flag' ;
    rdfs:comment 'Boolean flag indicating whether the delegate should also be contacted in medical emergencies. True if the delegate is designated as an emergency contact.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalDocumentDate rdf:type rdf:Property ;
    rdfs:label 'Legal Document Date' ;
    rdfs:comment 'Date the legal document was executed, signed, or issued by the court. Establishes the legal validity timeline.' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Legal Document Reference' ;
    rdfs:comment 'Reference identifier or location of the supporting legal documentation (e.g., document ID in document management system, court case number, file path). Used to retrieve the original legal instrument.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalDocumentType rdf:type rdf:Property ;
    rdfs:label 'Legal Document Type' ;
    rdfs:comment 'Type of legal documentation supporting the delegation authority (e.g., advance directive, healthcare proxy form, durable power of attorney document, guardianship court order, birth certificate for parental authority). [ENUM-REF-CANDIDATE: advance_directive|healthcare_proxy_form|power_of_attorney_document|guardianship_order|court_order|birth_certificate|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitationsDescription rdf:type rdf:Property ;
    rdfs:label 'Limitations Description' ;
    rdfs:comment 'Free-text description of any limitations or restrictions on the delegates authority (e.g., cannot consent to experimental treatments, cannot authorize organ donation, specific procedures excluded).' ;
    rdfs:domain ind:Delegation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityOrder rdf:type rdf:Property ;
    rdfs:label 'Priority Order' ;
    rdfs:comment 'Priority ranking when multiple delegates exist for the same patient. Lower numbers indicate higher priority. Used to determine which delegate has primary authority when conflicts arise.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revocationDate rdf:type rdf:Property ;
    rdfs:label 'Revocation Date' ;
    rdfs:comment 'Date when the delegation authority was revoked by the patient, delegate, or legal authority. Nullable if delegation has not been revoked.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revocationId rdf:type rdf:Property ;
    rdfs:label 'Revocation Id' ;
    rdfs:comment 'Unique identifier for the consent revocation record. Primary key for the consent revocation entity.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorRevocationId rdf:type rdf:Property ;
    rdfs:label 'Prior Revocation Id' ;
    rdfs:comment 'Self-referencing FK on revocation (prior_revocation_id)' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Revocation .

ind:complianceNotes rdf:type rdf:Property ;
    rdfs:label 'Compliance Notes' ;
    rdfs:comment 'Internal notes regarding compliance considerations, special handling requirements, or regulatory reporting obligations related to this revocation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentRecordCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Consent Record Created Timestamp' ;
    rdfs:comment 'The date and time when this consent revocation record was first created in the data warehouse or lakehouse.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:consentRecordUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Consent Record Updated Timestamp' ;
    rdfs:comment 'The date and time when this consent revocation record was last updated in the data warehouse or lakehouse.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataAccessRestrictedFlag rdf:type rdf:Property ;
    rdfs:label 'Data Access Restricted Flag' ;
    rdfs:comment 'Indicates whether data access controls have been updated to restrict access based on the revoked consent.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataAccessRestrictedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Data Access Restricted Timestamp' ;
    rdfs:comment 'The date and time when data access restrictions were implemented in response to the consent revocation.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:disclosuresHaltedFlag rdf:type rdf:Property ;
    rdfs:label 'Disclosures Halted Flag' ;
    rdfs:comment 'Indicates whether ongoing or future disclosures of Protected Health Information (PHI) have been halted as a result of this revocation.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disclosuresHaltedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Disclosures Halted Timestamp' ;
    rdfs:comment 'The date and time when disclosure processes were halted in response to the consent revocation.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:effectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Timestamp' ;
    rdfs:comment 'The date and time when the revocation became legally effective and operational systems began enforcing the withdrawal of consent. May differ from revocation_timestamp due to processing delays.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:irrevocableActionsDescription rdf:type rdf:Property ;
    rdfs:label 'Irrevocable Actions Description' ;
    rdfs:comment 'Free-text description of any actions taken under the original consent that cannot be reversed or undone despite the revocation (e.g., data already shared with third parties, research already conducted).' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalReviewCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Review Completed Flag' ;
    rdfs:comment 'Indicates whether required legal review has been completed for this revocation.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Review Required Flag' ;
    rdfs:comment 'Indicates whether this revocation requires legal review before being processed (e.g., complex partial revocations, disputes, or high-risk scenarios).' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalReviewTimestamp rdf:type rdf:Property ;
    rdfs:label 'Legal Review Timestamp' ;
    rdfs:comment 'The date and time when legal review of the revocation was completed.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:legalReviewerNotes rdf:type rdf:Property ;
    rdfs:label 'Legal Reviewer Notes' ;
    rdfs:comment 'Confidential notes from legal counsel regarding the revocation review, including any special handling instructions or risk assessments.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationSentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Timestamp' ;
    rdfs:comment 'The date and time when notifications regarding the consent revocation were sent to affected parties.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:partialRevocationDetails rdf:type rdf:Property ;
    rdfs:label 'Partial Revocation Details' ;
    rdfs:comment 'Free-text description of which specific portions of the consent are being revoked when revocation_scope is partial. Null when revocation is full.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientNotificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Notification Sent Flag' ;
    rdfs:comment 'Indicates whether confirmation notification was sent to the patient acknowledging receipt and processing of their revocation.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Patient Notification Timestamp' ;
    rdfs:comment 'The date and time when confirmation notification was sent to the patient regarding their consent revocation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:priorDisclosuresCount rdf:type rdf:Property ;
    rdfs:label 'Prior Disclosures Count' ;
    rdfs:comment 'The number of disclosures that occurred under the original consent prior to revocation and that cannot be undone or recalled.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorDisclosuresSummary rdf:type rdf:Property ;
    rdfs:label 'Prior Disclosures Summary' ;
    rdfs:comment 'Summary description of disclosures that occurred prior to revocation and cannot be undone, maintained for legal audit trail and patient notification.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reason rdf:type rdf:Property ;
    rdfs:label 'Reason' ;
    rdfs:comment 'Optional free-text explanation provided by the patient describing why they are revoking consent. May be blank if patient chose not to provide a reason.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationMethod rdf:type rdf:Property ;
    rdfs:label 'Revocation Method' ;
    rdfs:comment 'The method or channel through which the patient submitted the consent revocation (e.g., written form, verbal communication, patient portal, email, fax, in-person). [ENUM-REF-CANDIDATE: written|verbal|electronic|portal|email|fax|in_person — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationNumber rdf:type rdf:Property ;
    rdfs:label 'Revocation Number' ;
    rdfs:comment 'Business-facing unique identifier or tracking number assigned to this consent revocation for reference and audit purposes.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationScope rdf:type rdf:Property ;
    rdfs:label 'Revocation Scope' ;
    rdfs:comment 'Indicates whether the revocation applies to the entire consent (full) or only specific portions of the consent (partial).' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationStatus rdf:type rdf:Property ;
    rdfs:label 'Revocation Status' ;
    rdfs:comment 'Current processing status of the consent revocation within the organizations workflow (e.g., pending review, processed and effective, rejected due to invalid submission).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Revocation Timestamp' ;
    rdfs:comment 'The precise date and time when the consent revocation was submitted or recorded in the system. Provides exact temporal audit trail for legal compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:witnessSignatureFlag rdf:type rdf:Property ;
    rdfs:label 'Witness Signature Flag' ;
    rdfs:comment 'Indicates whether a witness signature was obtained on the revocation document.' ;
    rdfs:domain ind:Revocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentExceptionId rdf:type rdf:Property ;
    rdfs:label 'Consent Exception Id' ;
    rdfs:comment 'Unique identifier for the consent exception record. Primary key.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentConsentExceptionId rdf:type rdf:Property ;
    rdfs:label 'Parent Consent Exception Id' ;
    rdfs:comment 'Self-referencing FK on exception (related_exception_id)' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentException .

ind:accountingOfDisclosureFlag rdf:type rdf:Property ;
    rdfs:label 'Accounting Of Disclosure Flag' ;
    rdfs:comment 'Indicates whether this exception must be included in the patients Accounting of Disclosures report per HIPAA requirements.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:activeFlag rdf:type rdf:Property ;
    rdfs:label 'Active Flag' ;
    rdfs:comment 'Indicates whether the consent exception record is currently active and valid in the system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalJustification rdf:type rdf:Property ;
    rdfs:label 'Clinical Justification' ;
    rdfs:comment 'Clinical rationale and circumstances that necessitated invoking the consent exception, including patient condition, urgency, and why obtaining consent was not feasible.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentExceptionNumber rdf:type rdf:Property ;
    rdfs:label 'Consent Exception Number' ;
    rdfs:comment 'Business identifier for the consent exception record, used for tracking and audit purposes across systems.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentExceptionStatus rdf:type rdf:Property ;
    rdfs:label 'Consent Exception Status' ;
    rdfs:comment 'Current lifecycle status of the consent exception record, tracking from invocation through documentation and patient notification.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentExceptionType rdf:type rdf:Property ;
    rdfs:label 'Consent Exception Type' ;
    rdfs:comment 'Category of legal exception under which PHI was used or disclosed without patient consent. Aligns with HIPAA Privacy Rule permitted uses and disclosures. [ENUM-REF-CANDIDATE: emergency_treatment|public_health_reporting|law_enforcement|judicial_order|patient_incapacity|imminent_danger|abuse_neglect_reporting|workers_compensation|coroner_medical_examiner|organ_donation|research_waiver|facility_directory — 12 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentCode rdf:type rdf:Property ;
    rdfs:label 'Department Code' ;
    rdfs:comment 'Code identifying the clinical department or unit where the consent exception was invoked (e.g., ED for Emergency Department, ICU for Intensive Care Unit).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeNotes rdf:type rdf:Property ;
    rdfs:label 'Dispute Notes' ;
    rdfs:comment 'Details of the patients dispute regarding the consent exception, including their concerns and the organizations response.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Documented Timestamp' ;
    rdfs:comment 'Date and time when the consent exception was formally documented in the system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:emergencyTreatmentFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Treatment Flag' ;
    rdfs:comment 'Indicates whether the exception was invoked in the context of emergency medical treatment where delay to obtain consent would jeopardize patient health or safety.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:imminentDangerFlag rdf:type rdf:Property ;
    rdfs:label 'Imminent Danger Flag' ;
    rdfs:comment 'Indicates whether the disclosure was made to prevent or lessen a serious and imminent threat to the health or safety of a person or the public.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:invokedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Invoked Timestamp' ;
    rdfs:comment 'Date and time when the consent exception was invoked and the provider authorized the use or disclosure of PHI without explicit patient consent.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:legalBasisCode rdf:type rdf:Property ;
    rdfs:label 'Legal Basis Code' ;
    rdfs:comment 'Specific legal citation or regulatory code that authorizes the use or disclosure of PHI without patient consent (e.g., 45 CFR 164.512(j) for law enforcement, state-specific statutes).' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalBasisDescription rdf:type rdf:Property ;
    rdfs:label 'Legal Basis Description' ;
    rdfs:comment 'Detailed explanation of the legal or regulatory basis that permits the use or disclosure of PHI without patient consent in this specific circumstance.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientIncapacityFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Incapacity Flag' ;
    rdfs:comment 'Indicates whether the patient was incapacitated or unable to provide consent at the time the exception was invoked (e.g., unconscious, mentally incompetent).' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Patient Notification Date' ;
    rdfs:comment 'Date on which the patient was notified of the PHI use or disclosure under the consent exception.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:patientNotificationMethod rdf:type rdf:Property ;
    rdfs:label 'Patient Notification Method' ;
    rdfs:comment 'Method by which the patient was notified of the PHI use or disclosure (e.g., written letter, secure patient portal message, in-person conversation).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Notification Required Flag' ;
    rdfs:comment 'Indicates whether the patient must be notified after the fact that their PHI was used or disclosed under an exception, per HIPAA and organizational policy.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientNotifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Notified Flag' ;
    rdfs:comment 'Indicates whether the patient has been notified that their PHI was used or disclosed under a consent exception.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phiDisclosedDescription rdf:type rdf:Property ;
    rdfs:label 'Phi Disclosed Description' ;
    rdfs:comment 'Description of the specific Protected Health Information that was used or disclosed under the exception, including type and scope of information.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privacyOfficerNotes rdf:type rdf:Property ;
    rdfs:label 'Privacy Officer Notes' ;
    rdfs:comment 'Confidential notes and observations recorded by the Privacy Officer during review of the consent exception.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privacyOfficerReviewDate rdf:type rdf:Property ;
    rdfs:label 'Privacy Officer Review Date' ;
    rdfs:comment 'Date on which the Privacy Officer reviewed the consent exception for compliance and appropriateness.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recipientContactName rdf:type rdf:Property ;
    rdfs:label 'Recipient Contact Name' ;
    rdfs:comment 'Name of the individual at the recipient organization who received the PHI disclosure.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientContactPhone rdf:type rdf:Property ;
    rdfs:label 'Recipient Contact Phone' ;
    rdfs:comment 'Phone number of the recipient contact for follow-up and audit trail purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewedByPrivacyOfficerFlag rdf:type rdf:Property ;
    rdfs:label 'Reviewed By Privacy Officer Flag' ;
    rdfs:comment 'Indicates whether the consent exception has been reviewed and approved by the organizational Privacy Officer or designee.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surrogateUnavailableFlag rdf:type rdf:Property ;
    rdfs:label 'Surrogate Unavailable Flag' ;
    rdfs:comment 'Indicates whether a legally authorized surrogate decision-maker was unavailable to provide consent on behalf of an incapacitated patient.' ;
    rdfs:domain ind:ConsentException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nppAcknowledgmentId rdf:type rdf:Property ;
    rdfs:label 'Npp Acknowledgment Id' ;
    rdfs:comment 'Unique identifier for the NPP acknowledgment transaction. Primary key.' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:noticeOfPrivacyPracticesId rdf:type rdf:Property ;
    rdfs:label 'Notice Of Privacy Practices Id' ;
    rdfs:comment 'Foreign key linking to compliance.notice_of_privacy_practices. Business justification: Direct relationship - NPP acknowledgments in consent domain track patient acknowledgment of the NPP document managed in compliance domain. Essential for HIPAA compliance, demonstrating good faith effo' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NoticeOfPrivacyPractices .

ind:orgUnitId rdf:type rdf:Property ;
    rdfs:label 'Org Unit Id' ;
    rdfs:comment 'Identifier of the department within the facility where the NPP acknowledgment was obtained (e.g., registration, emergency department, outpatient clinic).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:priorNppAcknowledgmentId rdf:type rdf:Property ;
    rdfs:label 'Prior Npp Acknowledgment Id' ;
    rdfs:comment 'Identifier of the previous NPP acknowledgment record for this patient, if this is a re-acknowledgment following a material change.' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NppAcknowledgment .

ind:accessibilityAccommodation rdf:type rdf:Property ;
    rdfs:label 'Accessibility Accommodation' ;
    rdfs:comment 'Description of any accessibility accommodations provided (e.g., large print, Braille, audio recording, sign language interpreter).' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Date' ;
    rdfs:comment 'Date on which the patient acknowledged receipt of the NPP.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:acknowledgmentLocation rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Location' ;
    rdfs:comment 'Physical or virtual location where the acknowledgment was obtained. [ENUM-REF-CANDIDATE: registration_desk|patient_room|emergency_department|outpatient_clinic|patient_portal|home|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgmentMethod rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Method' ;
    rdfs:comment 'Method by which the patient provided acknowledgment (paper signature, electronic signature, patient portal click-through, email confirmation, kiosk acceptance, verbal acknowledgment documented by staff).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgmentStatus rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Status' ;
    rdfs:comment 'Current status of the NPP acknowledgment transaction. Acknowledged indicates patient signed or electronically accepted; unable_to_obtain indicates good-faith effort was made but acknowledgment could not be secured per regulatory allowance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Timestamp' ;
    rdfs:comment 'Precise date and time when the patient acknowledged receipt of the NPP, particularly important for electronic acknowledgments.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
    rdfs:comment 'Method by which the NPP was delivered to the patient (paper handout, electronic via patient portal, email, kiosk, verbal explanation).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceType rdf:type rdf:Property ;
    rdfs:label 'Device Type' ;
    rdfs:comment 'Type of device used for electronic acknowledgment (desktop computer, mobile phone, tablet, kiosk).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goodFaithEffortDocumentation rdf:type rdf:Property ;
    rdfs:label 'Good Faith Effort Documentation' ;
    rdfs:comment 'Free-text documentation of the good-faith effort made to obtain acknowledgment when it could not be secured.' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goodFaithEffortReason rdf:type rdf:Property ;
    rdfs:label 'Good Faith Effort Reason' ;
    rdfs:comment 'Reason why acknowledgment could not be obtained despite good-faith effort, as permitted under 45 CFR 164.520(c)(2)(ii).' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFirstServiceAcknowledgment rdf:type rdf:Property ;
    rdfs:label 'Is First Service Acknowledgment' ;
    rdfs:comment 'Indicates whether this acknowledgment was obtained at the first service delivery as required by 45 CFR 164.520(c)(1).' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialChangeAcknowledgment rdf:type rdf:Property ;
    rdfs:label 'Material Change Acknowledgment' ;
    rdfs:comment 'Indicates whether this acknowledgment was obtained following a material change to the NPP, requiring re-acknowledgment.' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientPortalSessionCode rdf:type rdf:Property ;
    rdfs:label 'Patient Portal Session Code' ;
    rdfs:comment 'Session identifier from the patient portal if the acknowledgment was obtained electronically via the portal.' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:representativeAuthorityDocumented rdf:type rdf:Property ;
    rdfs:label 'Representative Authority Documented' ;
    rdfs:comment 'Indicates whether the authority of a personal representative to act on behalf of the patient was documented and verified.' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retentionExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Retention Expiration Date' ;
    rdfs:comment 'Date after which this acknowledgment record may be destroyed per retention policy.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:signatureCaptured rdf:type rdf:Property ;
    rdfs:label 'Signature Captured' ;
    rdfs:comment 'Indicates whether a patient or representative signature was captured as part of the acknowledgment.' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signatureType rdf:type rdf:Property ;
    rdfs:label 'Signature Type' ;
    rdfs:comment 'Type of signature captured (wet ink on paper, electronic stylus, digital certificate-based, biometric, or none if acknowledgment was obtained without signature).' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signerName rdf:type rdf:Property ;
    rdfs:label 'Signer Name' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signerRelationship rdf:type rdf:Property ;
    rdfs:label 'Signer Relationship' ;
    rdfs:comment 'Relationship of the signer to the patient (self if patient signed, or representative role). [ENUM-REF-CANDIDATE: self|parent|legal_guardian|power_of_attorney|healthcare_proxy|personal_representative|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:NppAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionRequestId rdf:type rdf:Property ;
    rdfs:label 'Restriction Request Id' ;
    rdfs:comment 'Unique identifier for the patient consent restriction request record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RestrictionRequest .

ind:supersededRestrictionRequestId rdf:type rdf:Property ;
    rdfs:label 'Superseded Restriction Request Id' ;
    rdfs:comment 'Self-referencing FK on restriction_request (superseded_restriction_request_id)' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RestrictionRequest .

ind:complianceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Date' ;
    rdfs:comment 'The date of the most recent compliance review of this restriction request to ensure ongoing adherence to HIPAA and HITECH requirements.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decisionDate rdf:type rdf:Property ;
    rdfs:label 'Decision Date' ;
    rdfs:comment 'The date the covered entity made the decision to accept or deny the restriction request.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decisionMadeBy rdf:type rdf:Property ;
    rdfs:label 'Decision Made By' ;
    rdfs:comment 'The name or role of the individual or committee who made the decision on the restriction request (e.g., Privacy Officer, HIM Director).' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionRationale rdf:type rdf:Property ;
    rdfs:label 'Decision Rationale' ;
    rdfs:comment 'The business and regulatory rationale for the organizations decision to accept or deny the restriction request. Required for audit and patient communication.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalInstructions rdf:type rdf:Property ;
    rdfs:label 'Operational Instructions' ;
    rdfs:comment 'Detailed operational instructions for clinical, billing, and administrative staff on how to honor the restriction across Electronic Health Record (EHR), Revenue Cycle Management (RCM), Health Information Exchange (HIE), and other systems.' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationDecision rdf:type rdf:Property ;
    rdfs:label 'Organization Decision' ;
    rdfs:comment 'The covered entitys decision on whether to accept or deny the restriction request. HITECH out-of-pocket restrictions must be accepted; other restrictions are discretionary.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outOfPocketPaymentVerified rdf:type rdf:Property ;
    rdfs:label 'Out Of Pocket Payment Verified' ;
    rdfs:comment 'Indicates whether the patients claim of out-of-pocket payment has been verified for HITECH mandatory restrictions. True if verified, False if not applicable or not verified.' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Payment Verification Date' ;
    rdfs:comment 'The date the out-of-pocket payment was verified for HITECH mandatory restrictions, if applicable.' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestDate rdf:type rdf:Property ;
    rdfs:label 'Request Date' ;
    rdfs:comment 'The date the patient submitted the restriction request to the covered entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestMethod rdf:type rdf:Property ;
    rdfs:label 'Request Method' ;
    rdfs:comment 'The method by which the patient submitted the restriction request. [ENUM-REF-CANDIDATE: written_form|verbal|patient_portal|email|fax|mail|in_person|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestNumber rdf:type rdf:Property ;
    rdfs:label 'Request Number' ;
    rdfs:comment 'Business-assigned unique identifier for the restriction request, used for tracking and reference in correspondence and workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestTimestamp rdf:type rdf:Property ;
    rdfs:label 'Request Timestamp' ;
    rdfs:comment 'The precise date and time the restriction request was received and recorded in the system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:requestingPartyRelationship rdf:type rdf:Property ;
    rdfs:label 'Requesting Party Relationship' ;
    rdfs:comment 'The relationship of the individual submitting the restriction request to the patient, if not the patient themselves.' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictedPhiCategory rdf:type rdf:Property ;
    rdfs:label 'Restricted Phi Category' ;
    rdfs:comment 'The category of Protected Health Information (PHI) the patient is requesting to restrict. Used for operational filtering and enforcement. [ENUM-REF-CANDIDATE: all_phi|diagnosis_codes|procedure_codes|lab_results|radiology_reports|medication_records|mental_health_records|substance_abuse_records|genetic_information|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictedPurpose rdf:type rdf:Property ;
    rdfs:label 'Restricted Purpose' ;
    rdfs:comment 'The purpose of use or disclosure that the patient is requesting to restrict (e.g., restrict disclosure for payment purposes to a specific payer). [ENUM-REF-CANDIDATE: treatment|payment|healthcare_operations|research|public_health|all_purposes|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictedRecipientName rdf:type rdf:Property ;
    rdfs:label 'Restricted Recipient Name' ;
    rdfs:comment 'The specific name of the individual, organization, or health plan to whom the restriction applies, if identified by the patient.' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictedRecipientType rdf:type rdf:Property ;
    rdfs:label 'Restricted Recipient Type' ;
    rdfs:comment 'The type of recipient or entity to whom the patient is requesting disclosure restrictions apply. [ENUM-REF-CANDIDATE: health_plan|family_member|employer|specific_provider|health_information_exchange|research_entity|public_health_authority|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionScope rdf:type rdf:Property ;
    rdfs:label 'Restriction Scope' ;
    rdfs:comment 'Detailed narrative describing the scope of the requested restriction, including specific Protected Health Information (PHI) data elements, recipients, purposes, or time periods the patient wishes to restrict.' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionStatus rdf:type rdf:Property ;
    rdfs:label 'Restriction Status' ;
    rdfs:comment 'The current lifecycle status of the restriction. Active restrictions must be enforced across all clinical and administrative systems.' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionType rdf:type rdf:Property ;
    rdfs:label 'Restriction Type' ;
    rdfs:comment 'The category of restriction requested by the patient. HITECH out-of-pocket payer restriction is mandatory per 45 CFR 164.522(a)(1)(vi); other types are discretionary.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentationReference rdf:type rdf:Property ;
    rdfs:label 'Supporting Documentation Reference' ;
    rdfs:comment 'Reference identifier or location of supporting documentation submitted with the restriction request (e.g., signed forms, proof of out-of-pocket payment for HITECH restrictions).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemEnforcementFlag rdf:type rdf:Property ;
    rdfs:label 'System Enforcement Flag' ;
    rdfs:comment 'Indicates whether the restriction is actively enforced through automated system controls (True) or requires manual staff intervention (False).' ;
    rdfs:domain ind:RestrictionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentVerificationId rdf:type rdf:Property ;
    rdfs:label 'Consent Verification Id' ;
    rdfs:comment 'Unique identifier for the consent verification event. Primary key for the consent verification record.' ;
    rdfs:domain ind:ConsentVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fhirResourceLogId rdf:type rdf:Property ;
    rdfs:label 'Fhir Resource Log Id' ;
    rdfs:comment 'Foreign key linking to interoperability.fhir_resource_log. Business justification: Real-time consent verification via FHIR Consent resource queries (GET /Consent?patient=X) is standard for CDS Hooks and SMART on FHIR apps. Tracking which FHIR operation verified consent is required f' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FhirResourceLog .

ind:monitoringActivityId rdf:type rdf:Property ;
    rdfs:label 'Monitoring Activity Id' ;
    rdfs:comment 'Foreign key linking to compliance.monitoring_activity. Business justification: Consent verification processes are monitored as part of compliance monitoring programs to ensure systematic verification occurs. Links individual verification events to monitoring activities for sampl' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MonitoringActivity .

ind:priorConsentVerificationId rdf:type rdf:Property ;
    rdfs:label 'Prior Consent Verification Id' ;
    rdfs:comment 'Self-referencing FK on verification (prior_verification_id)' ;
    rdfs:domain ind:ConsentVerification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentVerification .

ind:actionTaken rdf:type rdf:Property ;
    rdfs:label 'Action Taken' ;
    rdfs:comment 'Action taken by the verifying user or system following the verification result. Indicates whether the workflow proceeded, new consent was obtained, the issue was escalated to supervisor, access was blocked, or the action was deferred pending resolution.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalContext rdf:type rdf:Property ;
    rdfs:label 'Clinical Context' ;
    rdfs:comment 'Description of the clinical or operational context that triggered the consent verification check. Free-text field capturing the reason for verification (e.g., pre-surgical clearance, lab order entry, medical records release request, HIE query for ED visit).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Flag' ;
    rdfs:comment 'Boolean indicator of whether the consent verification event met all regulatory and organizational compliance requirements. True indicates full compliance; False indicates a compliance gap requiring review.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Consent Effective Date' ;
    rdfs:comment 'Effective start date of the consent record that was verified. Captured at verification time for audit and historical analysis. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Consent Expiration Date' ;
    rdfs:comment 'Expiration date of the consent record that was verified. Captured at verification time to support expiration detection and renewal workflows. Null if consent has no expiration. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:daysUntilExpiration rdf:type rdf:Property ;
    rdfs:label 'Days Until Expiration' ;
    rdfs:comment 'Number of days remaining until the consent expires, calculated at the time of verification. Negative values indicate expired consent. Null if consent has no expiration date. Used for proactive renewal alerts.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:durationSeconds rdf:type rdf:Property ;
    rdfs:label 'Duration Seconds' ;
    rdfs:comment 'Time elapsed in seconds to complete the consent verification check, from initiation to result return. Used for performance monitoring and system optimization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorCode rdf:type rdf:Property ;
    rdfs:label 'Error Code' ;
    rdfs:comment 'System error code if the consent verification process encountered a technical failure. Null if verification completed successfully. Used for troubleshooting and system reliability monitoring.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorMessage rdf:type rdf:Property ;
    rdfs:label 'Error Message' ;
    rdfs:comment 'Human-readable error message describing any technical failure encountered during consent verification. Null if verification completed successfully.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrationTransactionCode rdf:type rdf:Property ;
    rdfs:label 'Integration Transaction Code' ;
    rdfs:comment 'Unique transaction identifier from the source system or integration layer that initiated the consent verification. Used for end-to-end traceability across system boundaries and troubleshooting integration issues.' ;
    rdfs:domain ind:ConsentVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideAuthorizedBy rdf:type rdf:Property ;
    rdfs:label 'Override Authorized By' ;
    rdfs:comment 'Reference to the supervisor or authorized user who approved the consent verification override. Required when override_flag is True. Links to the user master record.' ;
    rdfs:domain ind:ConsentVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overrideFlag rdf:type rdf:Property ;
    rdfs:label 'Override Flag' ;
    rdfs:comment 'Boolean indicator of whether the verification result was overridden by authorized personnel. True indicates an override occurred (e.g., emergency access, break-the-glass scenario); False indicates normal verification workflow.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideReason rdf:type rdf:Property ;
    rdfs:label 'Override Reason' ;
    rdfs:comment 'Free-text justification for overriding the consent verification result. Required when override_flag is True. Captures the business or clinical reason for proceeding despite verification failure (e.g., emergency treatment, life-threatening situation, patient verbal authorization pending documentation).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionDetails rdf:type rdf:Property ;
    rdfs:label 'Restriction Details' ;
    rdfs:comment 'Free-text description of any restrictions or limitations on the consent. Captures specific constraints such as data categories excluded, time-bound limitations, or recipient restrictions. Null if no restrictions apply.' ;
    rdfs:domain ind:ConsentVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Restriction Flag' ;
    rdfs:comment 'Boolean indicator of whether the verified consent has scope restrictions or limitations that constrain its use. True indicates restrictions are present; False indicates unrestricted consent.' ;
    rdfs:domain ind:ConsentVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verificationResult rdf:type rdf:Property ;
    rdfs:label 'Verification Result' ;
    rdfs:comment 'Outcome of the consent verification check. Indicates whether the consent was found to be valid and active, expired, revoked by patient, missing entirely, restricted by scope limitations, or pending completion.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationSource rdf:type rdf:Property ;
    rdfs:label 'Verification Source' ;
    rdfs:comment 'System or source from which the consent status was retrieved during verification. Indicates the authoritative source consulted (Electronic Medical Record, consent management registry, Health Information Exchange, patient portal, paper records, or external system).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Verification Timestamp' ;
    rdfs:comment 'Date and time when the consent verification check was performed. Recorded in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Critical for audit trail and compliance reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:verifyingUserNpi rdf:type rdf:Property ;
    rdfs:label 'Verifying User Npi' ;
    rdfs:comment 'National Provider Identifier (NPI) of the healthcare provider who performed the consent verification, if applicable. Ten-digit unique identifier assigned by CMS.' ;
    rdfs:domain ind:ConsentVerification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureLogId rdf:type rdf:Property ;
    rdfs:label 'Disclosure Log Id' ;
    rdfs:comment 'Unique identifier for the consent disclosure log entry. Primary key for the consent disclosure log product.' ;
    rdfs:domain ind:DisclosureLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:messageLogId rdf:type rdf:Property ;
    rdfs:label 'Message Log Id' ;
    rdfs:comment 'Foreign key linking to interoperability.message_log. Business justification: HIPAA accounting of disclosures requires linking each disclosure log entry to the actual message transmission event. When PHI is disclosed via HL7/FHIR/Direct, the message_log provides technical proof' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MessageLog .

ind:parentDisclosureLogId rdf:type rdf:Property ;
    rdfs:label 'Parent Disclosure Log Id' ;
    rdfs:comment 'Self-referencing FK on disclosure_log (related_disclosure_log_id)' ;
    rdfs:domain ind:DisclosureLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DisclosureLog .

ind:phiAccessLogId rdf:type rdf:Property ;
    rdfs:label 'Phi Access Log Id' ;
    rdfs:comment 'Foreign key linking to compliance.phi_access_log. Business justification: Disclosures based on consent should be traceable to access logs for complete audit trail of PHI movement. Essential for accounting of disclosures, breach investigation, and demonstrating that disclosu' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PhiAccessLog .

ind:disclosureDate rdf:type rdf:Property ;
    rdfs:label 'Disclosure Date' ;
    rdfs:comment 'The date on which the Protected Health Information (PHI) disclosure occurred. Required for HIPAA Accounting of Disclosures per 45 CFR 164.528.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disclosureInitiatedBy rdf:type rdf:Property ;
    rdfs:label 'Disclosure Initiated By' ;
    rdfs:comment 'The name or identifier of the individual or system that initiated the disclosure. Supports audit trail and accountability.' ;
    rdfs:domain ind:DisclosureLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureInitiatedByRole rdf:type rdf:Property ;
    rdfs:label 'Disclosure Initiated By Role' ;
    rdfs:comment 'The role or job title of the individual who initiated the disclosure, such as physician, nurse, HIM specialist, or system administrator. Supports role-based access auditing.' ;
    rdfs:domain ind:DisclosureLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureMethod rdf:type rdf:Property ;
    rdfs:label 'Disclosure Method' ;
    rdfs:comment 'The method or channel by which the Protected Health Information (PHI) was disclosed. Supports security analysis and breach risk assessment. [ENUM-REF-CANDIDATE: electronic|paper|verbal|fax|secure_email|hie|api|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:DisclosureLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureNotes rdf:type rdf:Property ;
    rdfs:label 'Disclosure Notes' ;
    rdfs:comment 'Additional notes, comments, or context regarding the disclosure. Provides supplementary information for audit and compliance review.' ;
    rdfs:domain ind:DisclosureLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosurePurpose rdf:type rdf:Property ;
    rdfs:label 'Disclosure Purpose' ;
    rdfs:comment 'The stated purpose or reason for the Protected Health Information (PHI) disclosure. Required for HIPAA Accounting of Disclosures per 45 CFR 164.528.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosurePurposeCategory rdf:type rdf:Property ;
    rdfs:label 'Disclosure Purpose Category' ;
    rdfs:comment 'The standardized category of the disclosure purpose. Enables aggregation and reporting of disclosures by purpose type for compliance and analytics. [ENUM-REF-CANDIDATE: treatment|payment|operations|research|public_health|legal|patient_request|court_order|law_enforcement|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureStatus rdf:type rdf:Property ;
    rdfs:label 'Disclosure Status' ;
    rdfs:comment 'The current status of the disclosure transaction. Tracks the lifecycle state of the disclosure event.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Disclosure Timestamp' ;
    rdfs:comment 'The precise date and time when the Protected Health Information (PHI) disclosure occurred. Provides granular audit trail for compliance and security investigations.' ;
    rdfs:domain ind:DisclosureLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isAccountingRequired rdf:type rdf:Property ;
    rdfs:label 'Is Accounting Required' ;
    rdfs:comment 'Indicates whether this disclosure must be included in the HIPAA Accounting of Disclosures report provided to patients upon request. Non-TPO disclosures are subject to accounting per 45 CFR 164.528.' ;
    rdfs:domain ind:DisclosureLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTpoDisclosure rdf:type rdf:Property ;
    rdfs:label 'Is Tpo Disclosure' ;
    rdfs:comment 'Indicates whether the disclosure was made for Treatment, Payment, or Operations (TPO) purposes. TPO disclosures are exempt from HIPAA Accounting of Disclosures requirements per 45 CFR 164.528.' ;
    rdfs:domain ind:DisclosureLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalBasis rdf:type rdf:Property ;
    rdfs:label 'Legal Basis' ;
    rdfs:comment 'The legal or regulatory basis that permitted or required the disclosure, such as court order, subpoena, public health reporting requirement, or patient authorization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumNecessaryApplied rdf:type rdf:Property ;
    rdfs:label 'Minimum Necessary Applied' ;
    rdfs:comment 'Indicates whether the minimum necessary standard was applied to limit the Protected Health Information (PHI) disclosed to only what was reasonably necessary for the stated purpose, as required by 45 CFR 164.502(b).' ;
    rdfs:domain ind:DisclosureLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modifiedBy rdf:type rdf:Property ;
    rdfs:label 'Modified By' ;
    rdfs:comment 'The user ID or system identifier that last modified this disclosure log record. Supports audit trail and accountability.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Patient Notification Required' ;
    rdfs:comment 'Indicates whether the patient must be notified of this disclosure under HIPAA or organizational policy. Certain disclosures require patient notification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phiElementsDisclosed rdf:type rdf:Property ;
    rdfs:label 'Phi Elements Disclosed' ;
    rdfs:comment 'Description of the specific Protected Health Information (PHI) elements or data categories that were disclosed. Required for HIPAA Accounting of Disclosures.' ;
    rdfs:domain ind:DisclosureLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientIdentifier rdf:type rdf:Property ;
    rdfs:label 'Recipient Identifier' ;
    rdfs:comment 'The unique identifier for the recipient, such as National Provider Identifier (NPI), Tax ID, or organizational identifier. Enables precise tracking of disclosure recipients.' ;
    rdfs:domain ind:DisclosureLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientType rdf:type rdf:Property ;
    rdfs:label 'Recipient Type' ;
    rdfs:comment 'The category of recipient to whom the Protected Health Information (PHI) was disclosed. Supports classification and reporting of disclosure patterns. [ENUM-REF-CANDIDATE: individual|organization|government_agency|health_plan|clearinghouse|business_associate|research_institution|public_health_authority|law_enforcement|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemSource rdf:type rdf:Property ;
    rdfs:label 'System Source' ;
    rdfs:comment 'The name or identifier of the source system or application that recorded the disclosure event, such as Epic EHR, Cerner Millennium, or HIE platform.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Capacity Assessment Id' ;
    rdfs:comment 'Unique identifier for the consent capacity assessment record. Primary key for this entity.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assessingClinicianId rdf:type rdf:Property ;
    rdfs:label 'Assessing Clinician Id' ;
    rdfs:comment 'Identifier of the clinician who performed the capacity assessment. Typically a physician, psychiatrist, or psychologist qualified to assess decision-making capacity.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:priorCapacityAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Prior Capacity Assessment Id' ;
    rdfs:comment 'Self-referencing FK on capacity_assessment (prior_capacity_assessment_id)' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapacityAssessment .

ind:amendmentReason rdf:type rdf:Property ;
    rdfs:label 'Amendment Reason' ;
    rdfs:comment 'Reason for amendment if the assessment record was modified after initial completion.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appreciationAbility rdf:type rdf:Property ;
    rdfs:label 'Appreciation Ability' ;
    rdfs:comment 'Assessment of the patients ability to appreciate how the information applies to their own situation.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessingClinicianSpecialty rdf:type rdf:Property ;
    rdfs:label 'Assessing Clinician Specialty' ;
    rdfs:comment 'Medical specialty of the clinician who performed the assessment (e.g., Psychiatry, Neurology, Internal Medicine).' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Assessment Duration Minutes' ;
    rdfs:comment 'Duration of the capacity assessment in minutes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assessmentLocation rdf:type rdf:Property ;
    rdfs:label 'Assessment Location' ;
    rdfs:comment 'Physical location where the capacity assessment was conducted (e.g., patient room, consultation room, emergency department).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assessment Timestamp' ;
    rdfs:comment 'Precise date and time when the capacity assessment was completed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assessmentToolUsed rdf:type rdf:Property ;
    rdfs:label 'Assessment Tool Used' ;
    rdfs:comment 'Name of the standardized assessment instrument or tool used to evaluate capacity (e.g., MacCAT-T, Aid to Capacity Evaluation, UBACC).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentToolVersion rdf:type rdf:Property ;
    rdfs:label 'Assessment Tool Version' ;
    rdfs:comment 'Version number or edition of the assessment tool used.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityScore rdf:type rdf:Property ;
    rdfs:label 'Capacity Score' ;
    rdfs:comment 'Numerical score from the assessment tool, if applicable. Range and interpretation depend on the specific tool used.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:choiceExpressionAbility rdf:type rdf:Property ;
    rdfs:label 'Choice Expression Ability' ;
    rdfs:comment 'Assessment of the patients ability to express a clear and consistent choice.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalBasisForDetermination rdf:type rdf:Property ;
    rdfs:label 'Clinical Basis For Determination' ;
    rdfs:comment 'Clinical rationale and evidence supporting the capacity determination, including relevant medical history, mental status findings, and observed behaviors.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributingConditions rdf:type rdf:Property ;
    rdfs:label 'Contributing Conditions' ;
    rdfs:comment 'Medical or psychiatric conditions that may be affecting the patients decision-making capacity (e.g., dementia, delirium, depression, psychosis).' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributingMedications rdf:type rdf:Property ;
    rdfs:label 'Contributing Medications' ;
    rdfs:comment 'Medications that may be affecting the patients cognitive function or decision-making capacity.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Documentation Reference Code' ;
    rdfs:comment 'Reference identifier to the full clinical documentation of the capacity assessment in the Electronic Health Record (EHR).' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ethicsConsultationObtainedFlag rdf:type rdf:Property ;
    rdfs:label 'Ethics Consultation Obtained Flag' ;
    rdfs:comment 'Indicates whether an ethics committee consultation was obtained regarding this capacity assessment.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalAuthorityType rdf:type rdf:Property ;
    rdfs:label 'Legal Authority Type' ;
    rdfs:comment 'Type of legal authority the surrogate decision-maker holds, if applicable.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalConsultationObtainedFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Consultation Obtained Flag' ;
    rdfs:comment 'Indicates whether legal consultation was obtained regarding this capacity assessment.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reasoningAbility rdf:type rdf:Property ;
    rdfs:label 'Reasoning Ability' ;
    rdfs:comment 'Assessment of the patients ability to reason about treatment options and their consequences.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reassessmentRecommendedFlag rdf:type rdf:Property ;
    rdfs:label 'Reassessment Recommended Flag' ;
    rdfs:comment 'Indicates whether a follow-up capacity reassessment is recommended.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reassessmentTimeframe rdf:type rdf:Property ;
    rdfs:label 'Reassessment Timeframe' ;
    rdfs:comment 'Recommended timeframe for reassessment if indicated (e.g., 24 hours, 72 hours, after treatment of delirium).' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRecordCode rdf:type rdf:Property ;
    rdfs:label 'Source System Record Code' ;
    rdfs:comment 'Unique identifier of this capacity assessment record in the source system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specificDeficitsIdentified rdf:type rdf:Property ;
    rdfs:label 'Specific Deficits Identified' ;
    rdfs:comment 'Detailed description of specific cognitive or decision-making deficits identified during the assessment.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surrogateDecisionMakerEngagedFlag rdf:type rdf:Property ;
    rdfs:label 'Surrogate Decision Maker Engaged Flag' ;
    rdfs:comment 'Indicates whether a surrogate decision-maker was identified and engaged as a result of this capacity assessment.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surrogateRelationship rdf:type rdf:Property ;
    rdfs:label 'Surrogate Relationship' ;
    rdfs:comment 'Relationship of the surrogate decision-maker to the patient (e.g., spouse, adult child, legal guardian, healthcare proxy).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:understandingAbility rdf:type rdf:Property ;
    rdfs:label 'Understanding Ability' ;
    rdfs:comment 'Assessment of the patients ability to understand relevant information about the treatment or decision.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessPresentFlag rdf:type rdf:Property ;
    rdfs:label 'Witness Present Flag' ;
    rdfs:comment 'Indicates whether a witness was present during the capacity assessment.' ;
    rdfs:domain ind:CapacityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentTranslationId rdf:type rdf:Property ;
    rdfs:label 'Consent Translation Id' ;
    rdfs:comment 'Unique identifier for the consent translation record. Primary key.' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interpreterVendorId rdf:type rdf:Property ;
    rdfs:label 'Interpreter Vendor Id' ;
    rdfs:comment 'Unique identifier assigned by the interpreter vendor for tracking and billing purposes.' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:supersededConsentTranslationId rdf:type rdf:Property ;
    rdfs:label 'Superseded Consent Translation Id' ;
    rdfs:comment 'Self-referencing FK on translation (superseded_translation_id)' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentTranslation .

ind:auxiliaryAidDescription rdf:type rdf:Property ;
    rdfs:label 'Auxiliary Aid Description' ;
    rdfs:comment 'Description of any auxiliary aids or services provided to facilitate communication during the consent process.' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auxiliaryAidProvidedFlag rdf:type rdf:Property ;
    rdfs:label 'Auxiliary Aid Provided Flag' ;
    rdfs:comment 'Indicates whether auxiliary aids or services were provided in addition to language translation (e.g., sign language interpreter, assistive listening devices) (True/False).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communicationBarrierType rdf:type rdf:Property ;
    rdfs:label 'Communication Barrier Type' ;
    rdfs:comment 'Type of communication barrier that necessitated translation services (e.g., limited English proficiency, hearing impairment, speech impairment, visual impairment, cognitive impairment, multiple barriers).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentTranslationMethod rdf:type rdf:Property ;
    rdfs:label 'Consent Translation Method' ;
    rdfs:comment 'Method used to provide translation services during the consent process (e.g., certified written translation, qualified in-person interpreter, telephonic interpreter, video remote interpreting, bilingual staff, family member interpreter).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Amount' ;
    rdfs:comment 'Cost incurred for the translation or interpretation services, used for financial tracking and vendor billing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Cost Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the translation cost (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationMinutes rdf:type rdf:Property ;
    rdfs:label 'Duration Minutes' ;
    rdfs:comment 'Total duration of the interpretation session in minutes, used for billing and quality tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endTimestamp rdf:type rdf:Property ;
    rdfs:label 'End Timestamp' ;
    rdfs:comment 'Date and time when the translation or interpretation session ended.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:interpreterAttestationFlag rdf:type rdf:Property ;
    rdfs:label 'Interpreter Attestation Flag' ;
    rdfs:comment 'Indicates whether the interpreter attested that they accurately conveyed the consent information in the target language (True/False).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interpreterAttestationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Interpreter Attestation Timestamp' ;
    rdfs:comment 'Date and time when the interpreter provided their attestation of accurate translation.' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:interpreterCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Interpreter Certification Number' ;
    rdfs:comment 'Certification or credential number of the interpreter, if applicable (e.g., Certified Medical Interpreter credential number).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterSessionCode rdf:type rdf:Property ;
    rdfs:label 'Interpreter Session Code' ;
    rdfs:comment 'Unique session identifier provided by the interpreter service vendor for this specific interpretation session.' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterType rdf:type rdf:Property ;
    rdfs:label 'Interpreter Type' ;
    rdfs:comment 'Classification of the interpreter used (e.g., certified medical interpreter, qualified interpreter, ad hoc bilingual staff, family member, not applicable for written translation only).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lepComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Lep Compliance Flag' ;
    rdfs:comment 'Indicates whether this translation record meets CMS Limited English Proficiency compliance requirements (True/False).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientPreferredLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Patient Preferred Language Code' ;
    rdfs:comment 'ISO 639-1 or ISO 639-2 language code representing the patients stated preferred language for healthcare communication.' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientPreferredLanguageConfirmedFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Preferred Language Confirmed Flag' ;
    rdfs:comment 'Indicates whether the patients preferred language was explicitly confirmed at the time of consent (True/False).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientUnderstandingAttestationFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Understanding Attestation Flag' ;
    rdfs:comment 'Indicates whether the patient attested that they understood the consent information in their preferred language (True/False). Required by CMS LEP requirements.' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientUnderstandingAttestationMethod rdf:type rdf:Property ;
    rdfs:label 'Patient Understanding Attestation Method' ;
    rdfs:comment 'Method by which the patient confirmed understanding of the translated consent (e.g., verbal confirmation, written signature, electronic signature, witnessed verbal, teach-back method).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Review Flag' ;
    rdfs:comment 'Indicates whether the translation underwent a quality review process (True/False).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityReviewTimestamp rdf:type rdf:Property ;
    rdfs:label 'Quality Review Timestamp' ;
    rdfs:comment 'Date and time when the translation quality review was completed.' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceSystemTranslationCode rdf:type rdf:Property ;
    rdfs:label 'Source System Translation Code' ;
    rdfs:comment 'Unique identifier for this translation record in the source system.' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startTimestamp rdf:type rdf:Property ;
    rdfs:label 'Start Timestamp' ;
    rdfs:comment 'Date and time when the translation or interpretation session began.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:targetLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Target Language Code' ;
    rdfs:comment 'ISO 639-1 or ISO 639-2 language code representing the language into which the consent form was translated (e.g., es for Spanish, zh-CN for Simplified Chinese).' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetLanguageName rdf:type rdf:Property ;
    rdfs:label 'Target Language Name' ;
    rdfs:comment 'Full name of the target language (e.g., Spanish, Mandarin Chinese, Vietnamese).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleViComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Title Vi Compliance Flag' ;
    rdfs:comment 'Indicates whether this translation record meets Title VI of the Civil Rights Act compliance requirements for language access (True/False).' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:translatedDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Translated Document Reference' ;
    rdfs:comment 'Reference identifier or URI to the translated consent document stored in the document management system.' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:translatedDocumentVersion rdf:type rdf:Property ;
    rdfs:label 'Translated Document Version' ;
    rdfs:comment 'Version number or identifier of the translated consent document used.' ;
    rdfs:domain ind:ConsentTranslation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentCompliancePolicyId rdf:type rdf:Property ;
    rdfs:label 'Parent Compliance Policy Id' ;
    rdfs:comment 'Foreign key linking to compliance.policy. Business justification: Consent-specific policies are often subordinate to or reference broader organizational compliance policies. Establishes policy hierarchy for governance, ensures consent policies align with enterprise ' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompliancePolicy .

ind:supersededByConsentPolicyId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Consent Policy Id' ;
    rdfs:comment 'Reference to the consent policy that supersedes this policy. Populated when policy status is superseded. Null for active policies.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentPolicy .

ind:capacityAssessmentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Capacity Assessment Required Flag' ;
    rdfs:comment 'Indicates whether a formal capacity assessment is required before obtaining consent under this policy. True if capacity assessment is mandatory, False otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityAssessmentTriggers rdf:type rdf:Property ;
    rdfs:label 'Capacity Assessment Triggers' ;
    rdfs:comment 'Specific conditions or circumstances that trigger the requirement for a capacity assessment (e.g., cognitive impairment, altered mental status, high-risk procedure). Multiple triggers separated by semicolons.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationRequirements rdf:type rdf:Property ;
    rdfs:label 'Documentation Requirements' ;
    rdfs:comment 'Detailed description of documentation requirements for consent obtained under this policy, including required forms, signatures, attestations, and supporting materials.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyCode rdf:type rdf:Property ;
    rdfs:label 'Policy Code' ;
    rdfs:comment 'Unique business identifier code for the consent policy, used for external reference and system integration.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyDescription rdf:type rdf:Property ;
    rdfs:label 'Policy Description' ;
    rdfs:comment 'Detailed narrative describing the consent policy scope, applicability, and regulatory basis for the consent requirement.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyName rdf:type rdf:Property ;
    rdfs:label 'Policy Name' ;
    rdfs:comment 'Cleaned boilerplate phrase from attribute description' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyStatus rdf:type rdf:Property ;
    rdfs:label 'Policy Status' ;
    rdfs:comment 'Current lifecycle status of the consent policy: draft (under development), active (in use), suspended (temporarily inactive), retired (no longer used), or superseded (replaced by newer policy).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconsentIntervalMonths rdf:type rdf:Property ;
    rdfs:label 'Reconsent Interval Months' ;
    rdfs:comment 'Number of months after which consent must be renewed if time-based re-consent is required. Null if time-based re-consent does not apply.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reconsentTriggerNewRisk rdf:type rdf:Property ;
    rdfs:label 'Reconsent Trigger New Risk' ;
    rdfs:comment 'Indicates whether the discovery of significant new risks triggers the requirement for re-consent under this policy. True if new risk requires re-consent, False otherwise.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconsentTriggerProtocolAmendment rdf:type rdf:Property ;
    rdfs:label 'Reconsent Trigger Protocol Amendment' ;
    rdfs:comment 'Indicates whether a protocol amendment triggers the requirement for re-consent under this policy (primarily applicable to research consent). True if protocol amendment requires re-consent, False otherwise.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconsentTriggerTimeBased rdf:type rdf:Property ;
    rdfs:label 'Reconsent Trigger Time Based' ;
    rdfs:comment 'Indicates whether consent expires after a defined time period and requires renewal under this policy. True if time-based re-consent is required, False otherwise.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryCitations rdf:type rdf:Property ;
    rdfs:label 'Regulatory Citations' ;
    rdfs:comment 'Specific regulatory citations, statutes, or code sections that apply to this consent policy (e.g., 45 CFR 164.508, 21 CFR 50.25). Multiple citations separated by semicolons.' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredConsentElements rdf:type rdf:Property ;
    rdfs:label 'Required Consent Elements' ;
    rdfs:comment 'Comma-separated list of mandatory elements that must be included in consent documentation governed by this policy (e.g., purpose, risks, benefits, alternatives, right to refuse, right to revoke).' ;
    rdfs:domain ind:ConsentPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentWorkflowEntityId rdf:type rdf:Property ;
    rdfs:label 'Consent Workflow Entity Id' ;
    rdfs:comment 'Unique identifier for the consent workflow configuration. Primary key for the consent workflow master record.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentWorkflowEntity .

ind:parentWorkflowConsentWorkflowEntityId rdf:type rdf:Property ;
    rdfs:label 'Parent Workflow Consent Workflow Entity Id' ;
    rdfs:comment 'Self-referencing FK on workflow (parent_workflow_id)' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentWorkflowEntity .

ind:primarySupersededByConsentWorkflowConsentWorkflowEntityId rdf:type rdf:Property ;
    rdfs:label 'Primary Superseded By Consent Workflow Consent Workflow Entity Id' ;
    rdfs:comment 'Reference to the consent workflow that replaces this workflow configuration. Supports workflow version history and transition management.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentWorkflowEntity .

ind:applicableCareSetting rdf:type rdf:Property ;
    rdfs:label 'Applicable Care Setting' ;
    rdfs:comment 'Healthcare delivery setting where this consent workflow applies. Determines the operational context and location-specific requirements for consent execution. [ENUM-REF-CANDIDATE: inpatient|outpatient|emergency|surgical|ambulatory|telehealth|research|all — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableServiceLine rdf:type rdf:Property ;
    rdfs:label 'Applicable Service Line' ;
    rdfs:comment 'Clinical service line or specialty area where this consent workflow is used. Enables service-specific consent process customization.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentWorkflowDescription rdf:type rdf:Property ;
    rdfs:label 'Consent Workflow Description' ;
    rdfs:comment 'Detailed description of the consent workflow process, including its purpose, scope, and business context. Provides comprehensive documentation for workflow configuration and usage.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentWorkflowStatus rdf:type rdf:Property ;
    rdfs:label 'Consent Workflow Status' ;
    rdfs:comment 'Current lifecycle status of the consent workflow configuration. Determines whether the workflow is available for use in clinical and administrative systems.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ehrEventMapping rdf:type rdf:Property ;
    rdfs:label 'Ehr Event Mapping' ;
    rdfs:comment 'Technical mapping or configuration that links Electronic Health Record (EHR) system events to this consent workflow. Defines the integration touchpoints and data exchange requirements.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ehrIntegrationEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Ehr Integration Enabled Flag' ;
    rdfs:comment 'Indicates whether this consent workflow is integrated with Electronic Health Record (EHR) systems for automated triggering and documentation. Enables seamless consent management within clinical workflows.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ehrModuleName rdf:type rdf:Property ;
    rdfs:label 'Ehr Module Name' ;
    rdfs:comment 'Specific module or component within the Electronic Health Record (EHR) system that triggers or consumes this consent workflow. Examples include Cadence (scheduling), ClinDoc (clinical documentation), or Healthy Planet (population health).' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ehrSystemName rdf:type rdf:Property ;
    rdfs:label 'Ehr System Name' ;
    rdfs:comment 'Name of the Electronic Health Record (EHR) system integrated with this consent workflow. Identifies the source system for workflow triggering and consent documentation.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Enabled Flag' ;
    rdfs:comment 'Indicates whether workflow escalation rules are active for this consent workflow. Enables automated notification and intervention when consent is not obtained within required timeframes.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationRecipientRole rdf:type rdf:Property ;
    rdfs:label 'Escalation Recipient Role' ;
    rdfs:comment 'Role or position that receives escalation notifications when consent workflow is not completed within required timeframes. Enables supervisory oversight and intervention.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationThresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold Unit' ;
    rdfs:comment 'Unit of measure for the escalation threshold value. Defines the temporal granularity for escalation timing.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold Value' ;
    rdfs:comment 'Numeric value representing when escalation should occur. Used with escalation_threshold_unit to define escalation timing.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:irbApprovalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Irb Approval Required Flag' ;
    rdfs:comment 'Indicates whether Institutional Review Board (IRB) approval is required for this consent workflow. Applies primarily to research consent workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiredStepsSequence rdf:type rdf:Property ;
    rdfs:label 'Required Steps Sequence' ;
    rdfs:comment 'Ordered list of workflow steps that must be completed for consent execution. Defines the procedural sequence and dependencies for consent collection and documentation.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleRole rdf:type rdf:Property ;
    rdfs:label 'Responsible Role' ;
    rdfs:comment 'Primary clinical or administrative role responsible for executing this consent workflow. Defines accountability and access control requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationWorkflowCode rdf:type rdf:Property ;
    rdfs:label 'Revocation Workflow Code' ;
    rdfs:comment 'Reference to the consent workflow used for processing consent revocations. Links to another consent_workflow record that defines the revocation process.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryRole rdf:type rdf:Property ;
    rdfs:label 'Secondary Role' ;
    rdfs:comment 'Supporting or backup role that can execute this consent workflow. Provides operational flexibility and coverage for workflow execution.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepCount rdf:type rdf:Property ;
    rdfs:label 'Step Count' ;
    rdfs:comment 'Total number of discrete steps in the consent workflow process. Used for workflow complexity assessment and progress tracking.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:timeConstraintDirection rdf:type rdf:Property ;
    rdfs:label 'Time Constraint Direction' ;
    rdfs:comment 'Temporal relationship of the time constraint to the triggering event. Specifies whether consent must be obtained before, after, or within a time window of the event.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeConstraintUnit rdf:type rdf:Property ;
    rdfs:label 'Time Constraint Unit' ;
    rdfs:comment 'Unit of measure for the time constraint value. Defines the temporal granularity for consent timing requirements.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeConstraintValue rdf:type rdf:Property ;
    rdfs:label 'Time Constraint Value' ;
    rdfs:comment 'Numeric value representing the time constraint for consent completion. Used with time_constraint_unit to define when consent must be obtained relative to the triggering event.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:triggeringEventCode rdf:type rdf:Property ;
    rdfs:label 'Triggering Event Code' ;
    rdfs:comment 'System-specific code or identifier for the triggering event. Used for integration with Electronic Health Record (EHR) scheduling, registration, and order management systems.' ;
    rdfs:domain ind:ConsentWorkflowEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeringEventType rdf:type rdf:Property ;
    rdfs:label 'Triggering Event Type' ;
    rdfs:comment 'Clinical or administrative event that initiates this consent workflow. Defines the business context in which consent must be obtained.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyId rdf:type rdf:Property ;
    rdfs:label 'Deficiency Id' ;
    rdfs:comment 'Unique identifier for the consent deficiency record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Deficiency .

ind:auditFindingId rdf:type rdf:Property ;
    rdfs:label 'Audit Finding Id' ;
    rdfs:comment 'Foreign key linking to compliance.audit_finding. Business justification: Consent deficiencies discovered during operations often become formal audit findings requiring corrective action plans. Natural progression from operational issue to compliance finding. Essential for ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditFinding .

ind:correctiveActionPlanId rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Id' ;
    rdfs:comment 'Foreign key linking to compliance.corrective_action_plan. Business justification: Deficiencies requiring remediation link to CAPs that document resolution actions, timelines, and verification. Essential for tracking remediation progress, demonstrating systematic issue resolution, a' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorrectiveActionPlan .

ind:deficiencyEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Deficiency Employee Id' ;
    rdfs:comment 'Reference to the user or authority who approved the waiver of the consent deficiency.' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentDeficiencyId rdf:type rdf:Property ;
    rdfs:label 'Parent Deficiency Id' ;
    rdfs:comment 'Self-referencing FK on deficiency (related_deficiency_id)' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Deficiency .

ind:tertiaryDeficiencyEscalatedToUserBigintSurrogateKeyForCleanKeying rdf:type rdf:Property ;
    rdfs:label 'Tertiary Deficiency Escalated To User Bigint Surrogate Key For Clean Keying' ;
    rdfs:comment 'Reference to the user or authority to whom the consent deficiency was escalated.' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:auditReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Audit Reference Number' ;
    rdfs:comment 'Reference number linking the consent deficiency to a formal audit or accreditation survey.' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyCategory rdf:type rdf:Property ;
    rdfs:label 'Deficiency Category' ;
    rdfs:comment 'High-level category of the consent deficiency aligned with consent management domains.' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyNumber rdf:type rdf:Property ;
    rdfs:label 'Deficiency Number' ;
    rdfs:comment 'Business identifier for the consent deficiency, used for tracking and reporting purposes.' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyStatus rdf:type rdf:Property ;
    rdfs:label 'Deficiency Status' ;
    rdfs:comment 'Current lifecycle status of the consent deficiency in the remediation workflow.' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyType rdf:type rdf:Property ;
    rdfs:label 'Deficiency Type' ;
    rdfs:comment 'Classification of the type of consent deficiency identified. [ENUM-REF-CANDIDATE: not_obtained|improperly_documented|expired|incomplete|missing_signature|missing_witness|invalid_representative|capacity_not_assessed|language_barrier_not_addressed — promote to reference product]' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveredByRole rdf:type rdf:Property ;
    rdfs:label 'Discovered By Role' ;
    rdfs:comment 'Role or job function of the individual who discovered the deficiency (e.g., HIM Specialist, Nurse, Compliance Officer).' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveryDate rdf:type rdf:Property ;
    rdfs:label 'Discovery Date' ;
    rdfs:comment 'Date on which the consent deficiency was identified.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:discoveryMethod rdf:type rdf:Property ;
    rdfs:label 'Discovery Method' ;
    rdfs:comment 'Method or process by which the consent deficiency was identified. [ENUM-REF-CANDIDATE: pre_procedure_checklist|him_audit|accreditation_survey|patient_complaint|peer_review|quality_audit|compliance_review|incident_report — promote to reference product]' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Discovery Timestamp' ;
    rdfs:comment 'Precise date and time when the consent deficiency was identified.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:escalationDate rdf:type rdf:Property ;
    rdfs:label 'Escalation Date' ;
    rdfs:comment 'Date on which the consent deficiency was escalated for higher-level review.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escalationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Required Flag' ;
    rdfs:comment 'Indicates whether the consent deficiency requires escalation to senior management or compliance leadership.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientSafetyImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Safety Impact Flag' ;
    rdfs:comment 'Indicates whether the consent deficiency posed a risk to patient safety or care quality.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:procedureDescription rdf:type rdf:Property ;
    rdfs:label 'Procedure Description' ;
    rdfs:comment 'Textual description of the procedure or service associated with the consent deficiency.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Impact Flag' ;
    rdfs:comment 'Indicates whether the consent deficiency has potential regulatory or accreditation implications.' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediationActionTaken rdf:type rdf:Property ;
    rdfs:label 'Remediation Action Taken' ;
    rdfs:comment 'Description of the corrective action taken to remediate the consent deficiency.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Date' ;
    rdfs:comment 'Date on which the consent deficiency was remediated or corrected.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remediationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Remediation Required Flag' ;
    rdfs:comment 'Indicates whether remediation action is required to address the consent deficiency.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Remediation Timestamp' ;
    rdfs:comment 'Precise date and time when the consent deficiency was remediated.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resolutionDate rdf:type rdf:Property ;
    rdfs:label 'Resolution Date' ;
    rdfs:comment 'Date on which the consent deficiency was fully resolved (either remediated, waived, or closed).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionNotes rdf:type rdf:Property ;
    rdfs:label 'Resolution Notes' ;
    rdfs:comment 'Additional notes or comments regarding the resolution of the consent deficiency.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleDepartmentCode rdf:type rdf:Property ;
    rdfs:label 'Responsible Department Code' ;
    rdfs:comment 'Code identifying the department or service line responsible for the consent deficiency.' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledProcedureDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Procedure Date' ;
    rdfs:comment 'Date on which the procedure requiring consent was scheduled or performed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:severityLevel rdf:type rdf:Property ;
    rdfs:label 'Severity Level' ;
    rdfs:comment 'Severity classification of the consent deficiency based on risk and regulatory impact.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemDeficiencyCode rdf:type rdf:Property ;
    rdfs:label 'Source System Deficiency Code' ;
    rdfs:comment 'Unique identifier for the consent deficiency in the source system.' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Date' ;
    rdfs:comment 'Date on which the consent deficiency waiver was approved.' ;
    rdfs:domain ind:Deficiency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverReason rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason' ;
    rdfs:comment 'Explanation or justification for waiving the consent deficiency without remediation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substanceUseConsentId rdf:type rdf:Property ;
    rdfs:label 'Substance Use Consent Id' ;
    rdfs:comment 'Unique identifier for the substance use disorder consent record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SubstanceUseConsent .

ind:behavioralHealthSudEpisodeId rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Sud Episode Id' ;
    rdfs:comment 'Foreign key linking to behavioral_health.sud_episode. Business justification: 42 CFR Part 2 requires consent to be tied to specific SUD treatment episodes for disclosure scope enforcement, compliance auditing, and ensuring consent covers the correct treatment context.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BehavioralHealthSudEpisode .

ind:directMessageId rdf:type rdf:Property ;
    rdfs:label 'Direct Message Id' ;
    rdfs:comment 'Foreign key linking to interoperability.direct_message. Business justification: 42 CFR Part 2 consents for substance use disorder treatment are frequently transmitted via Direct messaging to coordinate care with external providers. Required to track which Direct message carried t' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DirectMessage .

ind:supersededSubstanceUseConsentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Substance Use Consent Id' ;
    rdfs:comment 'Self-referencing FK on substance_use_consent (superseded_substance_use_consent_id)' ;
    rdfs:domain ind:SubstanceUseConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SubstanceUseConsent .

ind:caresActCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Cares Act Compliant Flag' ;
    rdfs:comment 'Indicates whether this substance use disorder consent authorization complies with the 2020 CARES Act amendments to 42 CFR Part 2, which permit disclosure for treatment, payment, and healthcare operations.' ;
    rdfs:domain ind:SubstanceUseConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:informationDisclosedDescription rdf:type rdf:Property ;
    rdfs:label 'Information Disclosed Description' ;
    rdfs:comment 'Detailed description of the specific substance use disorder treatment information to be disclosed, as required by 42 CFR Part 2 Section 2.31(a)(3).' ;
    rdfs:domain ind:SubstanceUseConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientNpi rdf:type rdf:Property ;
    rdfs:label 'Recipient Npi' ;
    rdfs:comment 'The National Provider Identifier of the recipient organization or provider authorized to receive substance use disorder treatment information.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redisclosureProhibitionIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Redisclosure Prohibition Included Flag' ;
    rdfs:comment 'Indicates whether the required redisclosure prohibition notice was included with this consent authorization, as mandated by 42 CFR Part 2 Section 2.32.' ;
    rdfs:domain ind:SubstanceUseConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:redisclosureProhibitionNotice rdf:type rdf:Property ;
    rdfs:label 'Redisclosure Prohibition Notice' ;
    rdfs:comment 'The required notice to recipients that substance use disorder treatment information is protected by federal law and cannot be redisclosed without patient consent, as mandated by 42 CFR Part 2 Section 2.32.' ;
    rdfs:domain ind:SubstanceUseConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sudProgramName rdf:type rdf:Property ;
    rdfs:label 'Sud Program Name' ;
    rdfs:comment 'The specific name of the substance use disorder treatment program or facility making the disclosure, as required by 42 CFR Part 2.' ;
    rdfs:domain ind:SubstanceUseConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sudProgramNpi rdf:type rdf:Property ;
    rdfs:label 'Sud Program Npi' ;
    rdfs:comment 'The National Provider Identifier of the substance use disorder treatment program or facility.' ;
    rdfs:domain ind:SubstanceUseConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:behavioralHealthConsentId rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Consent Id' ;
    rdfs:comment 'Unique identifier for the behavioral health consent record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BehavioralHealthConsent .

ind:supersededBehavioralHealthConsentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Behavioral Health Consent Id' ;
    rdfs:comment 'Self-referencing FK on behavioral_health_consent (superseded_behavioral_health_consent_id)' ;
    rdfs:domain ind:BehavioralHealthConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BehavioralHealthConsent .

ind:authorizedRecipientAddress rdf:type rdf:Property ;
    rdfs:label 'Authorized Recipient Address' ;
    rdfs:comment 'Mailing or physical address of the authorized recipient organization or individual.' ;
    rdfs:domain ind:BehavioralHealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedRecipientName rdf:type rdf:Property ;
    rdfs:label 'Authorized Recipient Name' ;
    rdfs:comment 'Name of the individual, organization, or entity authorized to receive the behavioral health information under this consent.' ;
    rdfs:domain ind:BehavioralHealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedRecipientNpi rdf:type rdf:Property ;
    rdfs:label 'Authorized Recipient Npi' ;
    rdfs:comment 'National Provider Identifier of the authorized recipient if the recipient is a healthcare provider or organization.' ;
    rdfs:domain ind:BehavioralHealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedRecipientType rdf:type rdf:Property ;
    rdfs:label 'Authorized Recipient Type' ;
    rdfs:comment 'Classification of the authorized recipient (individual provider, healthcare organization, insurance payer, legal entity, research institution).' ;
    rdfs:domain ind:BehavioralHealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentNumber rdf:type rdf:Property ;
    rdfs:label 'Consent Number' ;
    rdfs:comment 'Externally-known unique identifier or tracking number for this behavioral health consent authorization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mentalHealthDataElementsCovered rdf:type rdf:Property ;
    rdfs:label 'Mental Health Data Elements Covered' ;
    rdfs:comment 'Specific categories of behavioral health information covered by this consent (e.g., psychotherapy notes, psychiatric hospitalization records, mental illness medications, substance abuse treatment records). Pipe-delimited list.' ;
    rdfs:domain ind:BehavioralHealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obtainingProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Obtaining Provider Npi' ;
    rdfs:comment 'National Provider Identifier of the provider who obtained this consent.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientImposedRestrictions rdf:type rdf:Property ;
    rdfs:label 'Patient Imposed Restrictions' ;
    rdfs:comment 'Free-text description of any specific restrictions or limitations the patient has placed on the disclosure of their behavioral health information.' ;
    rdfs:domain ind:BehavioralHealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:psychotherapyNotesIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Psychotherapy Notes Included Flag' ;
    rdfs:comment 'Indicates whether HIPAA-protected psychotherapy notes are explicitly included in the scope of this consent authorization.' ;
    rdfs:domain ind:BehavioralHealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:redisclosureProhibitionStatement rdf:type rdf:Property ;
    rdfs:label 'Redisclosure Prohibition Statement' ;
    rdfs:comment 'Statement informing the recipient that the disclosed behavioral health information is protected by state and federal law and may not be redisclosed without patient authorization.' ;
    rdfs:domain ind:BehavioralHealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateLawBasis rdf:type rdf:Property ;
    rdfs:label 'State Law Basis' ;
    rdfs:comment 'Citation of the specific state statute or regulation governing heightened confidentiality protections for behavioral health records in the applicable jurisdiction.' ;
    rdfs:domain ind:BehavioralHealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substanceAbuseRecordsIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Substance Abuse Records Included Flag' ;
    rdfs:comment 'Indicates whether substance abuse treatment records subject to 42 CFR Part 2 protections are included in this consent.' ;
    rdfs:domain ind:BehavioralHealthConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expirationAlertId rdf:type rdf:Property ;
    rdfs:label 'Expiration Alert Id' ;
    rdfs:comment 'Unique identifier for the consent expiration alert record. Primary key for the consent expiration alert operational tracking entity.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorExpirationAlertId rdf:type rdf:Property ;
    rdfs:label 'Prior Expiration Alert Id' ;
    rdfs:comment 'Self-referencing FK on expiration_alert (prior_expiration_alert_id)' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExpirationAlert .

ind:alertGenerationDate rdf:type rdf:Property ;
    rdfs:label 'Alert Generation Date' ;
    rdfs:comment 'The date on which this expiration alert was generated by the consent monitoring system. Establishes alert creation timeline for SLA tracking.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:alertGenerationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Alert Generation Timestamp' ;
    rdfs:comment 'Precise date and time when the alert was created by the automated consent expiration monitoring process. Used for audit trail and alert latency analysis.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:alertNumber rdf:type rdf:Property ;
    rdfs:label 'Alert Number' ;
    rdfs:comment 'Human-readable business identifier for the consent expiration alert. Format: CEA-XXXXXXXXXX where X is a digit. Used for tracking and reference in workflows and communications.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertPriority rdf:type rdf:Property ;
    rdfs:label 'Alert Priority' ;
    rdfs:comment 'Business priority level assigned to the alert based on consent type, patient care impact, and time to expiration. Drives workflow routing and staff assignment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertStatus rdf:type rdf:Property ;
    rdfs:label 'Alert Status' ;
    rdfs:comment 'Current lifecycle status of the consent expiration alert. Open indicates new alert requiring attention; acknowledged indicates staff awareness; in progress indicates renewal workflow initiated; resolved indicates consent renewed or issue addressed; escalated indicates elevated priority; cancelled indicates alert no longer applicable.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertType rdf:type rdf:Property ;
    rdfs:label 'Alert Type' ;
    rdfs:comment 'Classification of the expiration alert based on urgency and timing. Approaching expiration indicates consent nearing end date; expired indicates consent has lapsed; renewal required indicates proactive action needed; grace period indicates post-expiration window; critical indicates immediate action required to prevent care disruption.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoRenewalEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Eligible Flag' ;
    rdfs:comment 'Indicates whether the consent is eligible for automatic renewal without patient re-signature based on consent type and organizational policy. True if auto-renewal allowed; false if patient action required.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Care Impact Flag' ;
    rdfs:comment 'Indicates whether the expiring consent has direct impact on patient care delivery. True if consent expiration would delay or prevent scheduled treatment, procedures, or services; false if administrative only.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Flag' ;
    rdfs:comment 'Indicates whether this alert has been escalated to higher authority or management due to unresolved status, patient unreachability, or care impact. True if escalated; false if standard workflow.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationReason rdf:type rdf:Property ;
    rdfs:label 'Escalation Reason' ;
    rdfs:comment 'The reason or justification for escalating the alert. Examples: Patient unreachable after multiple attempts, consent critical for scheduled procedure, regulatory compliance risk, patient dispute.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReminderDate rdf:type rdf:Property ;
    rdfs:label 'Last Reminder Date' ;
    rdfs:comment 'The date of the most recent reminder notification sent for this alert. Used to schedule follow-up reminders and assess communication frequency.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextActionDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Action Due Date' ;
    rdfs:comment 'The target date by which the next action (patient contact, escalation, resolution) should be completed. Drives workflow task scheduling and SLA monitoring.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationChannel rdf:type rdf:Property ;
    rdfs:label 'Notification Channel' ;
    rdfs:comment 'Primary communication channel used to deliver the expiration alert notification. Patient portal for patient-facing alerts; staff worklist for clinical team alerts; EHR alert for in-system notifications; email, SMS, phone, mail for direct outreach; none if alert is internal only. [ENUM-REF-CANDIDATE: patient_portal|staff_worklist|ehr_alert|email|sms|phone|mail|none — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationDeliveryStatus rdf:type rdf:Property ;
    rdfs:label 'Notification Delivery Status' ;
    rdfs:comment 'Detailed status of notification delivery attempt. Pending indicates queued; sent indicates transmitted; delivered indicates confirmed receipt; failed indicates delivery error; bounced indicates invalid recipient; read indicates recipient opened notification.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientContactAttemptedFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Contact Attempted Flag' ;
    rdfs:comment 'Indicates whether staff have attempted to contact the patient regarding consent renewal. True if outreach initiated; false if no contact attempt made.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientContactDate rdf:type rdf:Property ;
    rdfs:label 'Patient Contact Date' ;
    rdfs:comment 'The date on which staff successfully contacted the patient regarding the expiring consent. Null if contact not yet made or unsuccessful.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:patientResponse rdf:type rdf:Property ;
    rdfs:label 'Patient Response' ;
    rdfs:comment 'The patients response to the consent renewal request. Agreed to renew indicates patient consent to continue; declined renewal indicates patient wishes to revoke or not extend; requested modification indicates patient wants changes; no response indicates patient has not replied; unreachable indicates contact attempts failed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Flag' ;
    rdfs:comment 'Indicates whether the expiring consent is required for regulatory compliance (HIPAA, research IRB, state law). True if regulatory mandate; false if organizational policy only.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reminderCount rdf:type rdf:Property ;
    rdfs:label 'Reminder Count' ;
    rdfs:comment 'The number of reminder notifications sent to patient or staff regarding this expiring consent. Used to track outreach intensity and prevent notification fatigue.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalMethod rdf:type rdf:Property ;
    rdfs:label 'Renewal Method' ;
    rdfs:comment 'The method or channel through which consent renewal should be obtained. In-person for clinic visit; patient portal for electronic signature; telehealth for virtual visit; mail for postal forms; phone for verbal consent; email for electronic forms; not applicable if renewal not required. [ENUM-REF-CANDIDATE: in_person|patient_portal|telehealth|mail|phone|email|not_applicable — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Required Flag' ;
    rdfs:comment 'Indicates whether the expiring consent requires active patient re-consent or renewal action. True if patient signature or new authorization needed; false if consent can be administratively extended or is not renewable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resolutionStatus rdf:type rdf:Property ;
    rdfs:label 'Resolution Status' ;
    rdfs:comment 'The outcome or resolution of the consent expiration alert. Pending indicates unresolved; consent renewed indicates patient re-consented; consent revoked indicates patient declined continuation; consent expired indicates lapsed without renewal; administrative extension indicates organizational extension granted; patient unreachable indicates contact failure; no action required indicates alert cancelled or superseded. [ENUM-REF-CANDIDATE: pending|consent_renewed|consent_revoked|consent_expired|administrative_extension|patient_unreachable|no_action_required — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolution Timestamp' ;
    rdfs:comment 'Precise date and time when the alert was resolved or closed. Used for alert resolution time analysis and Service Level Agreement (SLA) compliance tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responsibleStaffRole rdf:type rdf:Property ;
    rdfs:label 'Responsible Staff Role' ;
    rdfs:comment 'The functional role or job title of the staff member assigned to this alert. Examples: Consent Coordinator, Case Manager, Primary Care Physician (PCP), Nurse Navigator, Health Information Management (HIM) Specialist.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Breach Flag' ;
    rdfs:comment 'Indicates whether the alert resolution exceeded the SLA target resolution time. True if SLA breached; false if resolved within target.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaTargetResolutionHours rdf:type rdf:Property ;
    rdfs:label 'Sla Target Resolution Hours' ;
    rdfs:comment 'The number of hours within which this alert should be resolved per organizational Service Level Agreement (SLA). Based on alert priority and consent type.' ;
    rdfs:domain ind:ExpirationAlert ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geneticTestingConsentId rdf:type rdf:Property ;
    rdfs:label 'Genetic Testing Consent Id' ;
    rdfs:comment 'Unique identifier for the genetic testing consent record. Primary key for this entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeneticTestingConsent .

ind:genomicsGenomicOrderId rdf:type rdf:Property ;
    rdfs:label 'Genomics Genomic Order Id' ;
    rdfs:comment 'Foreign key linking to genomics.genomic_order. Business justification: Genetic testing consent authorizes a specific genomic order. Labs require consent-to-order traceability for GINA compliance, pre-test counseling verification, and billing authorization before processi' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GenomicsGenomicOrder .

ind:supersededGeneticTestingConsentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Genetic Testing Consent Id' ;
    rdfs:comment 'Self-referencing FK on genetic_testing_consent (superseded_genetic_testing_consent_id)' ;
    rdfs:domain ind:GeneticTestingConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeneticTestingConsent .

ind:biobankStorageConsent rdf:type rdf:Property ;
    rdfs:label 'Biobank Storage Consent' ;
    rdfs:comment 'The patients authorization for their biological samples to be stored in a biobank for future use. Defines duration and conditions of sample storage.' ;
    rdfs:domain ind:GeneticTestingConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commercialUseConsent rdf:type rdf:Property ;
    rdfs:label 'Commercial Use Consent' ;
    rdfs:comment 'The patients authorization for their genetic data or samples to be used for commercial purposes such as drug development or diagnostic test development. Defines scope of commercial use.' ;
    rdfs:domain ind:GeneticTestingConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counselingDate rdf:type rdf:Property ;
    rdfs:label 'Counseling Date' ;
    rdfs:comment 'The date on which genetic counseling was provided to the patient. Null if counseling was not provided.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:counselingProvidedFlag rdf:type rdf:Property ;
    rdfs:label 'Counseling Provided Flag' ;
    rdfs:comment 'Indicates whether genetic counseling was provided to the patient prior to obtaining consent. True if counseling occurred, false otherwise.' ;
    rdfs:domain ind:GeneticTestingConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataRetentionPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Data Retention Period Years' ;
    rdfs:comment 'The number of years for which the genetic data and samples will be retained. May be null for indefinite retention or as specified by patient preference.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:familyImplicationsDisclosedFlag rdf:type rdf:Property ;
    rdfs:label 'Family Implications Disclosed Flag' ;
    rdfs:comment 'Indicates whether the patient was informed that genetic test results may have implications for biological family members. True if disclosure occurred, false otherwise.' ;
    rdfs:domain ind:GeneticTestingConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:familyNotificationConsent rdf:type rdf:Property ;
    rdfs:label 'Family Notification Consent' ;
    rdfs:comment 'The patients authorization for the healthcare provider to contact biological family members if test results reveal hereditary conditions. Defines scope of family outreach.' ;
    rdfs:domain ind:GeneticTestingConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ginaDisclosureFlag rdf:type rdf:Property ;
    rdfs:label 'Gina Disclosure Flag' ;
    rdfs:comment 'Indicates whether the patient was informed about GINA protections and limitations regarding genetic discrimination by health insurers and employers. True if disclosure occurred, false otherwise.' ;
    rdfs:domain ind:GeneticTestingConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incidentalFindingsConsent rdf:type rdf:Property ;
    rdfs:label 'Incidental Findings Consent' ;
    rdfs:comment 'The patients preference regarding the return of incidental or secondary findings discovered during genetic testing. Defines what types of unexpected findings should be disclosed.' ;
    rdfs:domain ind:GeneticTestingConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceDiscriminationRiskDisclosedFlag rdf:type rdf:Property ;
    rdfs:label 'Insurance Discrimination Risk Disclosed Flag' ;
    rdfs:comment 'Indicates whether the patient was informed about potential risks of genetic discrimination by life, disability, or long-term care insurers not covered by GINA. True if disclosure occurred, false otherwise.' ;
    rdfs:domain ind:GeneticTestingConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recontactConsent rdf:type rdf:Property ;
    rdfs:label 'Recontact Consent' ;
    rdfs:comment 'The patients authorization for the healthcare provider or research team to recontact them in the future if new clinically significant findings emerge from their genetic data. Defines scope of future communication.' ;
    rdfs:domain ind:GeneticTestingConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchRegistrySharingConsent rdf:type rdf:Property ;
    rdfs:label 'Research Registry Sharing Consent' ;
    rdfs:comment 'The patients authorization for their genetic data to be shared with external research registries or databases. Defines scope of data sharing permissions.' ;
    rdfs:domain ind:GeneticTestingConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchUseConsent rdf:type rdf:Property ;
    rdfs:label 'Research Use Consent' ;
    rdfs:comment 'The patients authorization for their genetic data and samples to be used in future research studies. Defines scope and limitations of research use.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testName rdf:type rdf:Property ;
    rdfs:label 'Test Name' ;
    rdfs:comment 'The specific name or description of the genetic test to be performed. May include gene panel names, specific gene targets, or test methodology.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testPurpose rdf:type rdf:Property ;
    rdfs:label 'Test Purpose' ;
    rdfs:comment 'The primary clinical or research purpose for performing the genetic test. Defines the intended use of the test results. [ENUM-REF-CANDIDATE: clinical_diagnosis|risk_assessment|treatment_selection|family_planning|research|ancestry|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:GeneticTestingConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testType rdf:type rdf:Property ;
    rdfs:label 'Test Type' ;
    rdfs:comment 'The category of genetic testing for which consent is being obtained. Defines the scope and purpose of the genetic analysis to be performed. [ENUM-REF-CANDIDATE: diagnostic|predictive|carrier|pharmacogenomic|whole_genome_sequencing|whole_exome_sequencing|targeted_panel|prenatal|newborn_screening|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:photographyMediaConsentId rdf:type rdf:Property ;
    rdfs:label 'Photography Media Consent Id' ;
    rdfs:comment 'Unique identifier for the photography and media consent record. Primary key.' ;
    rdfs:domain ind:PhotographyMediaConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededPhotographyMediaConsentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Photography Media Consent Id' ;
    rdfs:comment 'Self-referencing FK on photography_media_consent (superseded_photography_media_consent_id)' ;
    rdfs:domain ind:PhotographyMediaConsent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PhotographyMediaConsent .

ind:compensationDescription rdf:type rdf:Property ;
    rdfs:label 'Compensation Description' ;
    rdfs:comment 'Description of any compensation, payment, or consideration provided to the patient in exchange for consent to use their images or media.' ;
    rdfs:domain ind:PhotographyMediaConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionChannels rdf:type rdf:Property ;
    rdfs:label 'Distribution Channels' ;
    rdfs:comment 'Comma-separated list or description of authorized distribution channels where the media may be shared, such as internal presentations, peer-reviewed journals, conferences, websites, social media platforms, or educational materials.' ;
    rdfs:domain ind:PhotographyMediaConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifiableFlag rdf:type rdf:Property ;
    rdfs:label 'Identifiable Flag' ;
    rdfs:comment 'Indicates whether the patient will be identifiable in the media. True if patient identity is visible or disclosed; False if media will be de-identified or anonymized.' ;
    rdfs:domain ind:PhotographyMediaConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:intendedUse rdf:type rdf:Property ;
    rdfs:label 'Intended Use' ;
    rdfs:comment 'The primary intended purpose for which the patient images or media will be used, such as clinical documentation, medical education, research, publication, marketing, social media, quality improvement, or legal proceedings. [ENUM-REF-CANDIDATE: clinical_documentation|medical_education|research|publication|marketing|social_media|quality_improvement|legal_proceedings — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaType rdf:type rdf:Property ;
    rdfs:label 'Media Type' ;
    rdfs:comment 'Type of media for which consent is granted, such as photography, video recording, audio recording, digital imaging, or mixed media formats.' ;
    rdfs:domain ind:PhotographyMediaConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightToWithdrawStatement rdf:type rdf:Property ;
    rdfs:label 'Right To Withdraw Statement' ;
    rdfs:comment 'Text of the statement provided to the patient explaining their right to withdraw or revoke consent at any time and the process for doing so.' ;
    rdfs:domain ind:PhotographyMediaConsent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeDescription rdf:type rdf:Property ;
    rdfs:label 'Scope Description' ;
    rdfs:comment 'Detailed description of the scope of consent, including what body parts, procedures, or contexts are covered by the photography or media authorization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentRequestId rdf:type rdf:Property ;
    rdfs:label 'Amendment Request Id' ;
    rdfs:comment 'Unique identifier for the consent amendment request. Primary key for this entity.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalAmendmentRequestId rdf:type rdf:Property ;
    rdfs:label 'Original Amendment Request Id' ;
    rdfs:comment 'Self-referencing FK on amendment_request (original_amendment_request_id)' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AmendmentRequest .

ind:amendmentAppliedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Amendment Applied Timestamp' ;
    rdfs:comment 'The precise date and time when the amendment was actually applied to the consent record or PHI documentation in the system.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:amendmentScope rdf:type rdf:Property ;
    rdfs:label 'Amendment Scope' ;
    rdfs:comment 'The scope of the amendment request: whether it applies to the consent record itself, associated PHI documentation, authorization details, consent restrictions, disclosure log, or all related records.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentType rdf:type rdf:Property ;
    rdfs:label 'Amendment Type' ;
    rdfs:comment 'The type of amendment being requested: correction of inaccurate information, addition of missing information, clarification, deletion, or general update.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Decision Timestamp' ;
    rdfs:comment 'The precise date and time when the organizations decision was finalized and recorded in the system.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:extensionGrantedFlag rdf:type rdf:Property ;
    rdfs:label 'Extension Granted Flag' ;
    rdfs:comment 'Indicates whether the organization granted itself a 30-day extension to respond to the amendment request, as permitted under HIPAA when unable to respond within the initial 60-day period.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:extensionNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Extension Notification Date' ;
    rdfs:comment 'The date on which the patient was notified of the extension. Must occur within the initial 60-day period.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extensionReason rdf:type rdf:Property ;
    rdfs:label 'Extension Reason' ;
    rdfs:comment 'The reason provided to the patient for granting an extension to the response timeframe. Required when an extension is granted.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationRebuttal rdf:type rdf:Property ;
    rdfs:label 'Organization Rebuttal' ;
    rdfs:comment 'The organizations rebuttal to the patients statement of disagreement, if applicable. Must be prepared and maintained with the patients statement.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientStatementOfDisagreement rdf:type rdf:Property ;
    rdfs:label 'Patient Statement Of Disagreement' ;
    rdfs:comment 'If the amendment request was denied, the patients statement of disagreement with the denial. Patient has the right to submit a statement of disagreement per HIPAA.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonForAmendment rdf:type rdf:Property ;
    rdfs:label 'Reason For Amendment' ;
    rdfs:comment 'The patients stated reason or justification for requesting the amendment. Required to support the amendment request under HIPAA.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestChannel rdf:type rdf:Property ;
    rdfs:label 'Request Channel' ;
    rdfs:comment 'The specific channel or interface through which the amendment request was submitted (e.g., patient portal, mobile app, mail). [ENUM-REF-CANDIDATE: patient_portal|hie|mobile_app|web|phone|mail|fax|in_person|email — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestStatus rdf:type rdf:Property ;
    rdfs:label 'Request Status' ;
    rdfs:comment 'Current status of the amendment request in the review and decision workflow. Tracks the lifecycle from submission through final disposition. [ENUM-REF-CANDIDATE: submitted|under_review|accepted|denied|partially_accepted|withdrawn|pending_information — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedChangeDescription rdf:type rdf:Property ;
    rdfs:label 'Requested Change Description' ;
    rdfs:comment 'Detailed description of the specific change the patient is requesting to their consent record or associated PHI documentation. Captures the nature and rationale for the amendment.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Third Party Notification Date' ;
    rdfs:comment 'The date on which third parties who received the original consent-based disclosure were notified of the amendment to the consent record.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:thirdPartyNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Third Party Notification Required Flag' ;
    rdfs:comment 'Indicates whether notification to third parties who received the original consent-based disclosure is required as part of the amendment process.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thirdPartyRecipientsNotified rdf:type rdf:Property ;
    rdfs:label 'Third Party Recipients Notified' ;
    rdfs:comment 'List or description of third-party recipients who were notified of the amendment. Supports compliance with requirement to inform persons identified by the patient and those who may have relied on the original information.' ;
    rdfs:domain ind:AmendmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withdrawalDate rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Date' ;
    rdfs:comment 'The date on which the patient withdrew their amendment request, if applicable. Captures voluntary withdrawal before a decision was made.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:withdrawalReason rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Reason' ;
    rdfs:comment 'The reason provided by the patient for withdrawing their amendment request, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resumedConsentSessionId rdf:type rdf:Property ;
    rdfs:label 'Resumed Consent Session Id' ;
    rdfs:comment 'Self-referencing FK on consent_session (resumed_consent_session_id)' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentSession .

ind:allConsentsObtainedFlag rdf:type rdf:Property ;
    rdfs:label 'All Consents Obtained Flag' ;
    rdfs:comment 'Indicates whether all required consents were successfully obtained during this session. True if all required consents collected, False if any required consent was declined or not completed.' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentCollectionChannel rdf:type rdf:Property ;
    rdfs:label 'Consent Collection Channel' ;
    rdfs:comment 'Interface or location through which the consent session was conducted: patient portal, mobile application, self-service kiosk, clinic, hospital, call center, or mail.' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentCollectionMethod rdf:type rdf:Property ;
    rdfs:label 'Consent Collection Method' ;
    rdfs:comment 'Method by which consent was collected during this session: in-person (face-to-face), electronic (patient portal or kiosk), telephonic (phone call), written (paper form), or verbal (oral consent documented by staff).' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentCount rdf:type rdf:Property ;
    rdfs:label 'Consent Count' ;
    rdfs:comment 'Total number of individual consent items collected during this session. A single session may capture multiple consent decisions.' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentingPartyName rdf:type rdf:Property ;
    rdfs:label 'Consenting Party Name' ;
    rdfs:comment 'Full name of the individual who provided consent during this session. May differ from patient name if consent was provided by a legal representative.' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentingPartyRelationship rdf:type rdf:Property ;
    rdfs:label 'Consenting Party Relationship' ;
    rdfs:comment 'Relationship of the consenting party to the patient: self (patient consenting for themselves), spouse, parent, child, sibling, legal guardian, attorney, or other authorized relationship.' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentingPartyType rdf:type rdf:Property ;
    rdfs:label 'Consenting Party Type' ;
    rdfs:comment 'Classification of the individual providing consent: patient (self-consent), legal guardian, power of attorney, parent (for minor), or authorized representative.' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electronicSignatureMethod rdf:type rdf:Property ;
    rdfs:label 'Electronic Signature Method' ;
    rdfs:comment 'Method used to capture electronic signature during the session: typed name, drawn signature (stylus or touch), biometric (fingerprint/facial), digital certificate, PIN, or none (paper signature).' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Session Duration Minutes' ;
    rdfs:comment 'Total duration of the consent session in minutes, calculated from start to end timestamp. Used for compliance tracking and session timeout management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sessionEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Session End Timestamp' ;
    rdfs:comment 'Date and time when the consent session was completed, cancelled, or expired. Null for active sessions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sessionNotes rdf:type rdf:Property ;
    rdfs:label 'Session Notes' ;
    rdfs:comment 'Free-text notes documenting special circumstances, patient questions, clarifications provided, or other relevant details about the consent session.' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionNumber rdf:type rdf:Property ;
    rdfs:label 'Session Number' ;
    rdfs:comment 'Human-readable business identifier for the consent session, formatted as CS- followed by 10 digits.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Session Start Timestamp' ;
    rdfs:comment 'Date and time when the consent session was initiated. Represents the business event time when the patient or authorized representative began the consent process.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sessionStatus rdf:type rdf:Property ;
    rdfs:label 'Session Status' ;
    rdfs:comment 'Current lifecycle status of the consent session: initiated (session started), in_progress (consent being collected), completed (all consents finalized), cancelled (session terminated before completion), expired (session timed out), or withdrawn (patient withdrew from session).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionTimeoutMinutes rdf:type rdf:Property ;
    rdfs:label 'Session Timeout Minutes' ;
    rdfs:comment 'Configured timeout period in minutes for this consent session. Session automatically expires if not completed within this timeframe.' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sessionType rdf:type rdf:Property ;
    rdfs:label 'Session Type' ;
    rdfs:comment 'Classification of the consent session indicating the primary purpose: treatment consent, research consent, data sharing authorization, HIPAA authorization, Health Information Exchange (HIE) participation, or telehealth consent.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:staffRole rdf:type rdf:Property ;
    rdfs:label 'Staff Role' ;
    rdfs:comment 'Role of the staff member who facilitated the consent session: physician, nurse, research coordinator, consent specialist, administrative staff, or other.' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:userAgent rdf:type rdf:Property ;
    rdfs:label 'User Agent' ;
    rdfs:comment 'Browser or application user agent string captured during electronic consent session. Used for technical audit and troubleshooting. Null for non-electronic sessions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessSignatureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Witness Signature Timestamp' ;
    rdfs:comment 'Date and time when the witness signed or acknowledged the consent. Null if no witness was required.' ;
    rdfs:domain ind:ConsentSession ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:supersededExchangeStandardId rdf:type rdf:Property ;
    rdfs:label 'Superseded Exchange Standard Id' ;
    rdfs:comment 'Self-referencing FK on exchange_standard (superseded_exchange_standard_id)' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExchangeStandard .

ind:backwardCompatibility rdf:type rdf:Property ;
    rdfs:label 'Backward Compatibility' ;
    rdfs:comment 'Boolean flag indicating whether this version of the exchange standard is backward compatible with previous versions (True) or requires breaking changes (False).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificationDate rdf:type rdf:Property ;
    rdfs:label 'Certification Date' ;
    rdfs:comment 'Date when ONC Health IT Certification or other third-party certification was achieved for this exchange standard implementation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationStatus rdf:type rdf:Property ;
    rdfs:label 'Certification Status' ;
    rdfs:comment 'Status of ONC Health IT Certification or other third-party certification for this exchange standard implementation: certified (passed certification), pending (under review), not_required (certification not applicable), failed (did not pass).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:characterSet rdf:type rdf:Property ;
    rdfs:label 'Character Set' ;
    rdfs:comment 'Character encoding standard used for text data in this exchange standard (e.g., UTF-8, ASCII, ISO-8859-1).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conformanceProfile rdf:type rdf:Property ;
    rdfs:label 'Conformance Profile' ;
    rdfs:comment 'Name or identifier of the conformance profile, implementation guide, or constraint specification applied to this standard (e.g., US Core, IHE PIX, Carequality Framework).' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Email' ;
    rdfs:comment 'Email address of the technical lead or subject matter expert responsible for this exchange standard.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPerson rdf:type rdf:Property ;
    rdfs:label 'Contact Person' ;
    rdfs:comment 'Name of the technical lead, integration architect, or subject matter expert responsible for this exchange standard within the organization.' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationUrl rdf:type rdf:Property ;
    rdfs:label 'Documentation Url' ;
    rdfs:comment 'Web URL to internal implementation guides, mapping documentation, or configuration instructions for this exchange standard.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encodingFormat rdf:type rdf:Property ;
    rdfs:label 'Encoding Format' ;
    rdfs:comment 'Data encoding format used by this exchange standard: pipe_delimited (HL7v2), xml (CDA, FHIR XML), json (FHIR JSON), edi (X12), binary (DICOM).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endDate rdf:type rdf:Property ;
    rdfs:label 'End Date' ;
    rdfs:comment 'Date when this exchange standard version was deprecated or retired from active use. Null if still active.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exchangeStandardStatus rdf:type rdf:Property ;
    rdfs:label 'Exchange Standard Status' ;
    rdfs:comment 'Current lifecycle status of the exchange standard within the organization: active (in production use), deprecated (supported but discouraged), retired (no longer supported), planned (approved for future implementation), testing (under evaluation).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingBody rdf:type rdf:Property ;
    rdfs:label 'Governing Body' ;
    rdfs:comment 'Name of the standards development organization or governing body responsible for maintaining this exchange standard (e.g., HL7 International, ANSI ASC X12, NEMA, IHE).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hieParticipation rdf:type rdf:Property ;
    rdfs:label 'Hie Participation' ;
    rdfs:comment 'Comma-separated list of Health Information Exchange networks or frameworks that require or support this exchange standard (e.g., Carequality, CommonWell, eHealth Exchange, State HIE).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interfaceEngineSupport rdf:type rdf:Property ;
    rdfs:label 'Interface Engine Support' ;
    rdfs:comment 'Name and version of the interface engine or integration platform that supports this exchange standard (e.g., Epic Bridges, Cerner Millennium Interface Engine, Rhapsody, Mirth Connect).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMandatory rdf:type rdf:Property ;
    rdfs:label 'Is Mandatory' ;
    rdfs:comment 'Boolean flag indicating whether support for this exchange standard is mandatory for regulatory compliance or organizational policy (True) or optional (False).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:messageTypesSupported rdf:type rdf:Property ;
    rdfs:label 'Message Types Supported' ;
    rdfs:comment 'Comma-separated list of message types, event codes, or transaction sets supported under this standard (e.g., ADT^A01, ADT^A04, ORM^O01, ORU^R01, MDM^T02, SIU^S12, DFT^P03 for HL7v2; 837I, 837P, 835, 270, 271, 278 for X12).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:migrationPath rdf:type rdf:Property ;
    rdfs:label 'Migration Path' ;
    rdfs:comment 'Description of the migration or upgrade path from previous versions of this exchange standard, including transformation rules and mapping guidance.' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicationDate rdf:type rdf:Property ;
    rdfs:label 'Publication Date' ;
    rdfs:comment 'Date when this version of the exchange standard was officially published or released by the governing body.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryRequirement rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement' ;
    rdfs:comment 'Name of the regulatory mandate, certification requirement, or compliance framework that requires support for this exchange standard (e.g., ONC 2015 Edition, CMS Interoperability Rule, Carequality Framework).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceTypesSupported rdf:type rdf:Property ;
    rdfs:label 'Resource Types Supported' ;
    rdfs:comment 'Comma-separated list of FHIR resource types or CDA document types supported (e.g., Patient, Observation, Encounter, MedicationRequest for FHIR; CCD, C-CDA, QRDA for CDA).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityProfile rdf:type rdf:Property ;
    rdfs:label 'Security Profile' ;
    rdfs:comment 'Name of the security profile or framework applied to protect data exchanged using this standard (e.g., IHE ATNA, SMART on FHIR, OAuth 2.0, SAML 2.0).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specificationUrl rdf:type rdf:Property ;
    rdfs:label 'Specification Url' ;
    rdfs:comment 'Web URL to the official specification documentation for this exchange standard version.' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardCode rdf:type rdf:Property ;
    rdfs:label 'Standard Code' ;
    rdfs:comment 'Short code or abbreviation for the exchange standard used in system configurations and interface mappings (e.g., HL7V2, FHIR, CDA, X12, DICOM).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardName rdf:type rdf:Property ;
    rdfs:label 'Standard Name' ;
    rdfs:comment 'Official name of the healthcare data exchange standard (e.g., HL7 Version 2, FHIR R4, CDA R2, X12 EDI, DICOM).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardType rdf:type rdf:Property ;
    rdfs:label 'Standard Type' ;
    rdfs:comment 'Category of the exchange standard indicating its primary purpose: messaging (HL7v2), document (CDA), transaction (X12 EDI), imaging (DICOM), or API (FHIR).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminologyBinding rdf:type rdf:Property ;
    rdfs:label 'Terminology Binding' ;
    rdfs:comment 'Comma-separated list of standard code systems and value sets bound to this exchange standard (e.g., SNOMED CT, LOINC, RxNorm, ICD-10-CM, CPT, CVX).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testingTool rdf:type rdf:Property ;
    rdfs:label 'Testing Tool' ;
    rdfs:comment 'Name of the testing or validation tool used to verify conformance to this exchange standard (e.g., NIST HL7v2 Validator, Touchstone FHIR Testing, X12 EDI Validator).' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transportProtocol rdf:type rdf:Property ;
    rdfs:label 'Transport Protocol' ;
    rdfs:comment 'Network transport protocol(s) used to transmit messages conforming to this standard (e.g., MLLP, HTTPS, SFTP, AS2, Direct Secure Messaging).' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:useCaseDescription rdf:type rdf:Property ;
    rdfs:label 'Use Case Description' ;
    rdfs:comment 'Detailed description of the primary business use cases and clinical workflows supported by this exchange standard (e.g., patient admission/discharge/transfer notifications, lab result delivery, claims submission, clinical document exchange).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationRules rdf:type rdf:Property ;
    rdfs:label 'Validation Rules' ;
    rdfs:comment 'Description of validation rules, schematron constraints, or conformance checks applied to messages or documents conforming to this standard.' ;
    rdfs:domain ind:ExchangeStandard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:version rdf:type rdf:Property ;
    rdfs:label 'Version' ;
    rdfs:comment 'Version number or release identifier of the exchange standard (e.g., 2.5.1, R4, STU3, 5010, 2021e).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interfaceEngineId rdf:type rdf:Property ;
    rdfs:label 'Interface Engine Id' ;
    rdfs:comment 'Reference identifier for the interface engine configuration profile associated with this trading partner. Links to specific message routing, transformation, and validation rules.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InterfaceEngine .

ind:parentTradingPartnerId rdf:type rdf:Property ;
    rdfs:label 'Parent Trading Partner Id' ;
    rdfs:comment 'Self-referencing FK on trading_partner (parent_trading_partner_id)' ;
    rdfs:domain ind:TradingPartner ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TradingPartner .

ind:cdaEndpointUrl rdf:type rdf:Property ;
    rdfs:label 'Cda Endpoint Url' ;
    rdfs:comment 'Endpoint URL for exchanging CDA documents (C-CDA) with the trading partner. Used for continuity of care documents and clinical summaries.' ;
    rdfs:domain ind:TradingPartner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Certification Expiration Date' ;
    rdfs:comment 'Date on which the trading partners current interoperability certification expires. Null if not certified or certification does not expire.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataSharingAgreementReference rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Agreement Reference' ;
    rdfs:comment 'Reference identifier or document number for the executed data sharing agreement, business associate agreement, or memorandum of understanding governing the interoperability relationship.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataTransformationMappingReference rdf:type rdf:Property ;
    rdfs:label 'Data Transformation Mapping Reference' ;
    rdfs:comment 'Reference identifier or document name for the data transformation and mapping specifications used to translate data formats between internal systems and the trading partners expected format.' ;
    rdfs:domain ind:TradingPartner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directAddress rdf:type rdf:Property ;
    rdfs:label 'Direct Address' ;
    rdfs:comment 'Direct Protocol email-style address for secure, encrypted health information exchange. Used for point-to-point clinical messaging.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeVolumeLast30Days rdf:type rdf:Property ;
    rdfs:label 'Exchange Volume Last 30 Days' ;
    rdfs:comment 'Total count of messages or transactions exchanged with this trading partner in the last 30 days. Used for capacity planning and relationship monitoring.' ;
    rdfs:domain ind:TradingPartner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fhirEndpointUrl rdf:type rdf:Property ;
    rdfs:label 'Fhir Endpoint Url' ;
    rdfs:comment 'Base URL for the trading partners FHIR API endpoint. Used for RESTful FHIR-based data exchange and queries.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hieNetworkName rdf:type rdf:Property ;
    rdfs:label 'Hie Network Name' ;
    rdfs:comment 'Name of the primary HIE network through which data is exchanged with this trading partner (e.g., regional HIE, CommonWell, Carequality).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hieParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Hie Participation Flag' ;
    rdfs:comment 'Indicates whether the trading partner actively participates in one or more regional or national Health Information Exchanges.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hl7v2EndpointUrl rdf:type rdf:Property ;
    rdfs:label 'Hl7v2 Endpoint Url' ;
    rdfs:comment 'Network endpoint (MLLP, HTTPS, or other transport) for HL7 Version 2 message exchange with the trading partner.' ;
    rdfs:domain ind:TradingPartner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastSuccessfulExchangeTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Successful Exchange Timestamp' ;
    rdfs:comment 'Timestamp of the most recent successful data exchange (message sent or received) with this trading partner. Used for monitoring connectivity and operational health.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:messageTrackingEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Message Tracking Enabled Flag' ;
    rdfs:comment 'Indicates whether detailed message-level tracking and logging is enabled for exchanges with this trading partner. Used for audit, troubleshooting, and compliance monitoring.' ;
    rdfs:domain ind:TradingPartner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oid rdf:type rdf:Property ;
    rdfs:label 'Oid' ;
    rdfs:comment 'HL7 Object Identifier uniquely identifying the trading partner in HL7 message exchanges. Hierarchical dotted-decimal format per ISO/IEC 8824 standard.' ;
    rdfs:domain ind:TradingPartner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onboardingStatus rdf:type rdf:Property ;
    rdfs:label 'Onboarding Status' ;
    rdfs:comment 'Current lifecycle status of the trading partner onboarding and integration process. Tracks progression from initial planning through active data exchange.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalContactEmail rdf:type rdf:Property ;
    rdfs:label 'Operational Contact Email' ;
    rdfs:comment 'Email address of the primary operational contact for technical coordination, interface troubleshooting, and data exchange issue escalation.' ;
    rdfs:domain ind:TradingPartner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalContactName rdf:type rdf:Property ;
    rdfs:label 'Operational Contact Name' ;
    rdfs:comment 'Full name of the primary operational contact at the trading partner organization responsible for interoperability coordination and issue resolution.' ;
    rdfs:domain ind:TradingPartner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalContactPhone rdf:type rdf:Property ;
    rdfs:label 'Operational Contact Phone' ;
    rdfs:comment 'Primary phone number for the operational contact at the trading partner organization.' ;
    rdfs:domain ind:TradingPartner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partnerName rdf:type rdf:Property ;
    rdfs:label 'Partner Name' ;
    rdfs:comment 'Official legal or business name of the external trading partner organization (hospital, clinic, HIE, payer, lab, pharmacy, public health agency, ACO partner).' ;
    rdfs:domain ind:TradingPartner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partnerType rdf:type rdf:Property ;
    rdfs:label 'Partner Type' ;
    rdfs:comment 'Classification of the trading partner entity type. Determines the nature of the interoperability relationship and data exchange patterns. [ENUM-REF-CANDIDATE: hospital|clinic|hie|payer|lab|pharmacy|public_health_agency|aco_partner — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:TradingPartner ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaResponseTimeHours rdf:type rdf:Property ;
    rdfs:label 'Sla Response Time Hours' ;
    rdfs:comment 'Contractual or agreed-upon maximum response time in hours for the trading partner to acknowledge or respond to data exchange requests.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supportedStandards rdf:type rdf:Property ;
    rdfs:label 'Supported Standards' ;
    rdfs:comment 'Comma-separated list of interoperability standards and versions supported by the trading partner (e.g., HL7v2.5.1, FHIR R4, C-CDA R2.1, X12 5010).' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicalContactEmail rdf:type rdf:Property ;
    rdfs:label 'Technical Contact Email' ;
    rdfs:comment 'Email address of the technical contact for interface specifications, HL7 message troubleshooting, and API integration support.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicalContactName rdf:type rdf:Property ;
    rdfs:label 'Technical Contact Name' ;
    rdfs:comment 'Full name of the technical contact responsible for interface engine configuration, message format specifications, and technical integration support.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicalContactPhone rdf:type rdf:Property ;
    rdfs:label 'Technical Contact Phone' ;
    rdfs:comment 'Primary phone number for the technical contact at the trading partner organization.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacedInterfaceEngineId rdf:type rdf:Property ;
    rdfs:label 'Replaced Interface Engine Id' ;
    rdfs:comment 'Self-referencing FK on interface_engine (replaced_interface_engine_id)' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InterfaceEngine .

ind:adminUrl rdf:type rdf:Property ;
    rdfs:label 'Admin Url' ;
    rdfs:comment 'Web-based administrative console URL used by technical staff to configure and monitor the interface engine.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditLoggingEnabled rdf:type rdf:Property ;
    rdfs:label 'Audit Logging Enabled' ;
    rdfs:comment 'Indicates whether comprehensive audit logging is enabled to track all message processing activities and system access.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cloudProvider rdf:type rdf:Property ;
    rdfs:label 'Cloud Provider' ;
    rdfs:comment 'Name of the cloud service provider hosting the interface engine, if applicable to cloud or hybrid deployments. [ENUM-REF-CANDIDATE: AWS|Azure|Google Cloud|Oracle Cloud|IBM Cloud|On-Premise|Not Applicable — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decommissionDate rdf:type rdf:Property ;
    rdfs:label 'Decommission Date' ;
    rdfs:comment 'Date when the interface engine was retired from service and removed from active operations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deploymentEnvironment rdf:type rdf:Property ;
    rdfs:label 'Deployment Environment' ;
    rdfs:comment 'Environment classification indicating the operational tier where this interface engine instance is deployed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disasterRecoveryEnabled rdf:type rdf:Property ;
    rdfs:label 'Disaster Recovery Enabled' ;
    rdfs:comment 'Indicates whether disaster recovery capabilities are configured for this interface engine instance.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:encryptionEnabled rdf:type rdf:Property ;
    rdfs:label 'Encryption Enabled' ;
    rdfs:comment 'Indicates whether data encryption is enabled for messages in transit and at rest within the interface engine.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:engineCode rdf:type rdf:Property ;
    rdfs:label 'Engine Code' ;
    rdfs:comment 'Short alphanumeric code or abbreviation used to uniquely identify the interface engine in technical documentation and system configurations.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engineName rdf:type rdf:Property ;
    rdfs:label 'Engine Name' ;
    rdfs:comment 'Business-friendly name assigned to this interface engine instance for identification and operational reference.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirVersionSupport rdf:type rdf:Property ;
    rdfs:label 'Fhir Version Support' ;
    rdfs:comment 'Fast Healthcare Interoperability Resources (FHIR) specification versions supported, such as DSTU2, STU3, R4, R5.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goLiveDate rdf:type rdf:Property ;
    rdfs:label 'Go Live Date' ;
    rdfs:comment 'Date when the interface engine was activated for production message processing and integration workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:highAvailabilityEnabled rdf:type rdf:Property ;
    rdfs:label 'High Availability Enabled' ;
    rdfs:comment 'Indicates whether the interface engine is configured with high availability features such as clustering or failover.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaCompliant rdf:type rdf:Property ;
    rdfs:label 'Hipaa Compliant' ;
    rdfs:comment 'Indicates whether the interface engine configuration meets Health Insurance Portability and Accountability Act (HIPAA) compliance requirements for Protected Health Information (PHI) transmission.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hitrustCertified rdf:type rdf:Property ;
    rdfs:label 'Hitrust Certified' ;
    rdfs:comment 'Indicates whether the interface engine has achieved Health Information Trust Alliance Common Security Framework (HITRUST CSF) certification.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hl7VersionSupport rdf:type rdf:Property ;
    rdfs:label 'Hl7 Version Support' ;
    rdfs:comment 'Specific HL7 message versions supported by the interface engine, such as 2.3, 2.4, 2.5, 2.6, 2.7, 2.8.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hostingModel rdf:type rdf:Property ;
    rdfs:label 'Hosting Model' ;
    rdfs:comment 'Infrastructure deployment model describing where and how the interface engine is hosted and managed.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installationDate rdf:type rdf:Property ;
    rdfs:label 'Installation Date' ;
    rdfs:comment 'Date when the interface engine software was initially installed and configured in the environment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastMaintenanceDate rdf:type rdf:Property ;
    rdfs:label 'Last Maintenance Date' ;
    rdfs:comment 'Date when the most recent scheduled maintenance or system update was performed on the interface engine.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseType rdf:type rdf:Property ;
    rdfs:label 'License Type' ;
    rdfs:comment 'Type of software license under which the interface engine is deployed and operated.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxConcurrentConnections rdf:type rdf:Property ;
    rdfs:label 'Max Concurrent Connections' ;
    rdfs:comment 'Maximum number of simultaneous interface connections or channels that this engine instance can support.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:messageThroughputCapacity rdf:type rdf:Property ;
    rdfs:label 'Message Throughput Capacity' ;
    rdfs:comment 'Maximum number of messages per hour that the interface engine is designed to process under normal operating conditions.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nextScheduledMaintenanceDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Maintenance Date' ;
    rdfs:comment 'Date when the next planned maintenance window or system upgrade is scheduled for this interface engine.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:operationalStatus rdf:type rdf:Property ;
    rdfs:label 'Operational Status' ;
    rdfs:comment 'Current operational state of the interface engine indicating its availability and readiness for message processing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryHostname rdf:type rdf:Property ;
    rdfs:label 'Primary Hostname' ;
    rdfs:comment 'Fully qualified domain name or hostname used to access the primary interface engine instance.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryIpAddress rdf:type rdf:Property ;
    rdfs:label 'Primary Ip Address' ;
    rdfs:comment 'Primary Internet Protocol address assigned to the interface engine instance for network communication.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productName rdf:type rdf:Property ;
    rdfs:label 'Product Name' ;
    rdfs:comment 'Specific product name or edition of the interface engine software as designated by the vendor.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleTeam rdf:type rdf:Property ;
    rdfs:label 'Responsible Team' ;
    rdfs:comment 'Name of the IT or integration team responsible for managing, maintaining, and supporting this interface engine instance.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportContractExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Support Contract Expiration Date' ;
    rdfs:comment 'Date when the current vendor support and maintenance contract expires.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supportContractStatus rdf:type rdf:Property ;
    rdfs:label 'Support Contract Status' ;
    rdfs:comment 'Current status of the vendor support and maintenance contract for this interface engine instance.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportedProtocols rdf:type rdf:Property ;
    rdfs:label 'Supported Protocols' ;
    rdfs:comment 'Comma-separated list of communication protocols supported by this interface engine instance, such as HL7v2, FHIR, CDA, DICOM, X12.' ;
    rdfs:domain ind:InterfaceEngine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorName rdf:type rdf:Property ;
    rdfs:label 'Vendor Name' ;
    rdfs:comment 'Name of the software vendor or manufacturer that provides the interface engine platform. [ENUM-REF-CANDIDATE: Mirth Connect|NextGen Connect|Rhapsody|Qvera|Ensemble|HealthShare|Cloverleaf|Corepoint|Azure API for FHIR|AWS HealthLake|Google Cloud Healthcare API|Custom Built|Other — 13 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interoperabilityInterfaceEngineId rdf:type rdf:Property ;
    rdfs:label 'Interoperability Interface Engine Id' ;
    rdfs:comment 'FK to interoperability.interface_engine.interface_engine_id' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InterfaceEngine .

ind:interoperabilityTradingPartnerId rdf:type rdf:Property ;
    rdfs:label 'Interoperability Trading Partner Id' ;
    rdfs:comment 'FK to interoperability.trading_partner.trading_partner_id' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TradingPartner .

ind:replacedInterfaceChannelId rdf:type rdf:Property ;
    rdfs:label 'Replaced Interface Channel Id' ;
    rdfs:comment 'Self-referencing FK on interface_channel (replaced_interface_channel_id)' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InterfaceChannel .

ind:acknowledgmentRequired rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Required' ;
    rdfs:comment 'Indicates whether the interface channel requires acknowledgment messages (ACK/NACK) from the receiving system to confirm successful message receipt and processing per HL7 protocol.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acknowledgmentTimeoutSeconds rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Timeout Seconds' ;
    rdfs:comment 'Maximum time in seconds the interface engine will wait for an acknowledgment message before treating the transmission as failed.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authenticationMethod rdf:type rdf:Property ;
    rdfs:label 'Authentication Method' ;
    rdfs:comment 'Security authentication mechanism used to verify identity when establishing connection through this interface channel.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessOwnerName rdf:type rdf:Property ;
    rdfs:label 'Business Owner Name' ;
    rdfs:comment 'Name of the business stakeholder or department responsible for the functional requirements and operational oversight of this interface channel.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelCode rdf:type rdf:Property ;
    rdfs:label 'Channel Code' ;
    rdfs:comment 'Unique business identifier or code for the interface channel, often used in operational monitoring and troubleshooting.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelName rdf:type rdf:Property ;
    rdfs:label 'Channel Name' ;
    rdfs:comment 'Human-readable name assigned to this interface channel for identification and management purposes within the interface engine.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelStatus rdf:type rdf:Property ;
    rdfs:label 'Channel Status' ;
    rdfs:comment 'Current operational status of the interface channel indicating whether it is actively processing messages, temporarily disabled, under testing, or in an error state.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelType rdf:type rdf:Property ;
    rdfs:label 'Channel Type' ;
    rdfs:comment 'Directional classification of the interface channel indicating whether it receives data (inbound), sends data (outbound), or supports both directions (bidirectional).' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:connectionHost rdf:type rdf:Property ;
    rdfs:label 'Connection Host' ;
    rdfs:comment 'Network host address (IP address or hostname) used to establish connection with the remote system for message transmission.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:connectionPort rdf:type rdf:Property ;
    rdfs:label 'Connection Port' ;
    rdfs:comment 'Network port number used for establishing connection with the remote system. Standard MLLP ports are typically in the range 5000-6000.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:destinationFacilityIdentifier rdf:type rdf:Property ;
    rdfs:label 'Destination Facility Identifier' ;
    rdfs:comment 'Identifier of the destination facility or organization receiving messages, often corresponding to the MSH-6 receiving facility field in HL7v2 messages.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationSystemIdentifier rdf:type rdf:Property ;
    rdfs:label 'Destination System Identifier' ;
    rdfs:comment 'Technical identifier or code for the destination system as configured in the interface engine, often corresponding to the MSH-5 receiving application field in HL7v2 messages.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationSystemName rdf:type rdf:Property ;
    rdfs:label 'Destination System Name' ;
    rdfs:comment 'Name of the receiving system or application that consumes messages from this interface channel (e.g., laboratory information system, radiology information system, health information exchange).' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encryptionProtocol rdf:type rdf:Property ;
    rdfs:label 'Encryption Protocol' ;
    rdfs:comment 'Specific encryption protocol or cipher suite used for securing data transmission (e.g., TLS 1.2, TLS 1.3, AES-256).' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hieParticipantFlag rdf:type rdf:Property ;
    rdfs:label 'Hie Participant Flag' ;
    rdfs:comment 'Indicates whether this interface channel is used for participation in a regional or national Health Information Exchange network for sharing patient data across organizations.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastTestedDate rdf:type rdf:Property ;
    rdfs:label 'Last Tested Date' ;
    rdfs:comment 'Most recent date when this interface channel underwent testing or validation to ensure continued operational integrity.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maxMessageSizeKb rdf:type rdf:Property ;
    rdfs:label 'Max Message Size Kb' ;
    rdfs:comment 'Maximum allowed size in kilobytes for a single message transmitted through this channel. Large messages (e.g., CDA documents with embedded images) may require higher limits.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:messageArchivalDays rdf:type rdf:Property ;
    rdfs:label 'Message Archival Days' ;
    rdfs:comment 'Number of days that transmitted messages are retained in the interface engine archive for audit, troubleshooting, and compliance purposes before purging.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:messageEncoding rdf:type rdf:Property ;
    rdfs:label 'Message Encoding' ;
    rdfs:comment 'Data encoding format used for message serialization. ER7 (pipe-delimited) is standard for HL7v2, XML for CDA and some HL7v2, JSON for FHIR REST APIs.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:messageEventType rdf:type rdf:Property ;
    rdfs:label 'Message Event Type' ;
    rdfs:comment 'Specific message event or trigger type handled by this channel (e.g., ADT^A01 for patient admission, ORU^R01 for lab results, SIU^S12 for appointment notification). Defines the business transaction supported.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:messageRetryCount rdf:type rdf:Property ;
    rdfs:label 'Message Retry Count' ;
    rdfs:comment 'Number of automatic retry attempts the interface engine will make if message transmission fails before escalating to error handling.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phiTransmittedFlag rdf:type rdf:Property ;
    rdfs:label 'Phi Transmitted Flag' ;
    rdfs:comment 'Indicates whether this interface channel transmits Protected Health Information subject to HIPAA privacy and security regulations, requiring enhanced monitoring and audit controls.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retryIntervalSeconds rdf:type rdf:Property ;
    rdfs:label 'Retry Interval Seconds' ;
    rdfs:comment 'Time interval in seconds between automatic retry attempts for failed message transmissions.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaTier rdf:type rdf:Property ;
    rdfs:label 'Sla Tier' ;
    rdfs:comment 'Priority tier assigned to this interface channel defining expected uptime, response time, and support escalation procedures. Critical tier for life-safety interfaces (e.g., ED admissions), standard for routine reporting.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaUptimeTargetPercent rdf:type rdf:Property ;
    rdfs:label 'Sla Uptime Target Percent' ;
    rdfs:comment 'Target uptime percentage defined in the service level agreement for this interface channel (e.g., 99.9% for critical interfaces, 99.0% for standard).' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceFacilityIdentifier rdf:type rdf:Property ;
    rdfs:label 'Source Facility Identifier' ;
    rdfs:comment 'Identifier of the source facility or organization sending messages, often corresponding to the MSH-4 sending facility field in HL7v2 messages.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemIdentifier rdf:type rdf:Property ;
    rdfs:label 'Source System Identifier' ;
    rdfs:comment 'Technical identifier or code for the source system as configured in the interface engine, often corresponding to the MSH-3 sending application field in HL7v2 messages.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemName rdf:type rdf:Property ;
    rdfs:label 'Source System Name' ;
    rdfs:comment 'Name of the originating system or application that sends messages through this interface channel (e.g., Epic EHR, Cerner Millennium, MEDITECH, PACS).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportContactEmail rdf:type rdf:Property ;
    rdfs:label 'Support Contact Email' ;
    rdfs:comment 'Primary email address for technical support escalation and incident notification related to this interface channel.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportContactPhone rdf:type rdf:Property ;
    rdfs:label 'Support Contact Phone' ;
    rdfs:comment 'Primary phone number for technical support escalation and incident notification related to this interface channel.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicalOwnerName rdf:type rdf:Property ;
    rdfs:label 'Technical Owner Name' ;
    rdfs:comment 'Name of the technical team or individual responsible for configuration, maintenance, and troubleshooting of this interface channel.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transformationMapName rdf:type rdf:Property ;
    rdfs:label 'Transformation Map Name' ;
    rdfs:comment 'Name of the data transformation or mapping configuration applied to messages passing through this channel to convert between different formats, vocabularies, or data structures.' ;
    rdfs:domain ind:InterfaceChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mappingRuleId rdf:type rdf:Property ;
    rdfs:label 'Mapping Rule Id' ;
    rdfs:comment 'Identifier of the transformation rule set or mapping configuration applied to this message. Used for transformation audit trails and troubleshooting data mapping issues.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MappingRule .

ind:originalMessageLogId rdf:type rdf:Property ;
    rdfs:label 'Original Message Log Id' ;
    rdfs:comment 'Reference to the message_log_id of the original message if this is a duplicate or retry. Used for linking duplicate messages and retry attempts back to the original transaction for audit trail completeness.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MessageLog .

ind:primaryMessageCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Primary Message Care Site Id' ;
    rdfs:comment 'Identifier of the healthcare facility or system that originated and sent the message. Corresponds to MSH-4 in HL7 v2.x. Used for routing and source system identification.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:receivingFacilityCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Receiving Facility Care Site Id' ;
    rdfs:comment 'Identifier of the healthcare facility or system that is the intended recipient of the message. Corresponds to MSH-6 in HL7 v2.x. Used for routing and destination system identification.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:schedulingAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Scheduling Appointment Id' ;
    rdfs:comment 'Foreign key linking to scheduling.scheduling_appointment. Business justification: ADT messages (A04 admit, A08 update, A11 cancel) reference the triggering appointment. Interface engines log appointment_id for reconciliation when inbound/outbound scheduling messages fail. Real-worl' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SchedulingAppointment .

ind:ackCode rdf:type rdf:Property ;
    rdfs:label 'Ack Code' ;
    rdfs:comment 'The acknowledgment code returned by the receiving system indicating message acceptance status. AA=Application Accept, AE=Application Error, AR=Application Reject, CA=Commit Accept, CE=Commit Error, CR=Commit Reject. Corresponds to MSA-1 in HL7 v2.x ACK messages.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ackTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ack Timestamp' ;
    rdfs:comment 'The date and time when the acknowledgment (ACK) message was received from the destination system. Used for round-trip latency measurement and SLA compliance verification.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:businessEventType rdf:type rdf:Property ;
    rdfs:label 'Business Event Type' ;
    rdfs:comment 'High-level business event classification derived from the message type (e.g., Patient Admission, Lab Result, Medication Order, Appointment Scheduling, Charge Posting). Used for business-level reporting and analytics independent of technical message type codes.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationIpAddress rdf:type rdf:Property ;
    rdfs:label 'Destination Ip Address' ;
    rdfs:comment 'IP address of the receiving system that accepted the message. Used for routing verification, network troubleshooting, and security audit trails.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateCheckPerformed rdf:type rdf:Property ;
    rdfs:label 'Duplicate Check Performed' ;
    rdfs:comment 'Indicates whether the interface engine performed duplicate message detection based on message_control_id or other unique identifiers. True if duplicate check was performed, False otherwise. Used for idempotency verification.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:encryptionApplied rdf:type rdf:Property ;
    rdfs:label 'Encryption Applied' ;
    rdfs:comment 'Indicates whether the message was encrypted during transmission (e.g., TLS/SSL for transport encryption, message-level encryption). True if encryption was applied, False otherwise. Critical for HIPAA Security Rule compliance verification.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:errorDescription rdf:type rdf:Property ;
    rdfs:label 'Error Description' ;
    rdfs:comment 'Detailed human-readable description of the error or rejection reason. Includes validation failures, parsing errors, business rule violations, or system connectivity issues. Critical for troubleshooting and resolution.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorSeverity rdf:type rdf:Property ;
    rdfs:label 'Error Severity' ;
    rdfs:comment 'Severity classification of the error or issue encountered during message processing. Information=informational only, Warning=non-blocking issue, Error=processing failed but recoverable, Fatal=unrecoverable failure requiring manual intervention.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hieTransactionCode rdf:type rdf:Property ;
    rdfs:label 'Hie Transaction Code' ;
    rdfs:comment 'Unique transaction identifier assigned by the Health Information Exchange when the message is part of an HIE data exchange. Used for cross-organizational message tracking and HIE audit compliance.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDuplicate rdf:type rdf:Property ;
    rdfs:label 'Is Duplicate' ;
    rdfs:comment 'Indicates whether this message was identified as a duplicate of a previously processed message. True if duplicate detected, False otherwise. Duplicate messages may be rejected or logged depending on interface configuration.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:messageControlNumber rdf:type rdf:Property ;
    rdfs:label 'Message Control Number' ;
    rdfs:comment 'Unique message control identifier assigned by the sending system, corresponding to MSH-10 segment in HL7 v2.x messages. Used for message tracking and acknowledgment correlation.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:messagePriority rdf:type rdf:Property ;
    rdfs:label 'Message Priority' ;
    rdfs:comment 'Priority level assigned to the message for processing queue management. STAT=immediate life-threatening, ASAP=as soon as possible, Urgent=expedited processing, Routine=normal processing. May be derived from ORC-7 or OBR-5 in HL7 v2.x order messages.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:messageSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Message Sequence Number' ;
    rdfs:comment 'Sequential number assigned by the interface engine for message ordering and gap detection. Used to identify missing messages in a sequence and ensure proper message ordering for dependent transactions.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:messageStandard rdf:type rdf:Property ;
    rdfs:label 'Message Standard' ;
    rdfs:comment 'The interoperability standard protocol used for the message transmission (HL7v2 for traditional interface messages, FHIR for modern RESTful API exchanges, CDA for clinical document architecture, X12 for claims and eligibility, NCPDP for pharmacy transactions, DICOM for imaging).' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:messageTimestamp rdf:type rdf:Property ;
    rdfs:label 'Message Timestamp' ;
    rdfs:comment 'The date and time when the message was originally created by the sending system. Corresponds to MSH-7 in HL7 v2.x. This is the business event timestamp, distinct from processing timestamps.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:messageType rdf:type rdf:Property ;
    rdfs:label 'Message Type' ;
    rdfs:comment 'The type and trigger event of the healthcare message in standard format (e.g., ADT^A01 for patient admission, ORU^R01 for observation result, DFT^P03 for charge posting, SIU^S12 for appointment notification). Corresponds to MSH-9 in HL7 v2.x.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:messageVersion rdf:type rdf:Property ;
    rdfs:label 'Message Version' ;
    rdfs:comment 'Version of the messaging standard used (e.g., 2.3, 2.5.1, 2.7 for HL7 v2.x; R4, STU3 for FHIR; Release 2 for CDA). Corresponds to MSH-12 in HL7 v2.x.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientMrn rdf:type rdf:Property ;
    rdfs:label 'Patient Mrn' ;
    rdfs:comment 'The Medical Record Number of the patient referenced in the message, extracted from PID-3 in HL7 v2.x messages. Used for patient-centric message tracking and audit trails. Protected Health Information (PHI) under HIPAA.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payloadSizeBytes rdf:type rdf:Property ;
    rdfs:label 'Payload Size Bytes' ;
    rdfs:comment 'Size of the message payload in bytes. Used for capacity planning, bandwidth analysis, and identifying unusually large messages that may impact performance.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phiPresent rdf:type rdf:Property ;
    rdfs:label 'Phi Present' ;
    rdfs:comment 'Indicates whether the message contains Protected Health Information as defined by HIPAA Privacy Rule. True if PHI is present, False otherwise. Used for security classification, audit logging, and breach notification workflows.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:processingEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processing End Timestamp' ;
    rdfs:comment 'The date and time when the interface engine completed processing the message (successfully or with error). Used for latency calculation and throughput analysis.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:processingLatencyMs rdf:type rdf:Property ;
    rdfs:label 'Processing Latency Ms' ;
    rdfs:comment 'Total time in milliseconds from message receipt to processing completion. Calculated as the difference between processing_end_timestamp and received_timestamp. Key metric for SLA monitoring and performance optimization.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:processingStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processing Start Timestamp' ;
    rdfs:comment 'The date and time when the interface engine began processing the message (parsing, validation, transformation). Used for performance monitoring and bottleneck identification.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:processingStatus rdf:type rdf:Property ;
    rdfs:label 'Processing Status' ;
    rdfs:comment 'Current processing state of the message in the interface engine workflow. Tracks the message lifecycle from receipt through final disposition. Critical for operational monitoring and error investigation. [ENUM-REF-CANDIDATE: received|processing|processed|acknowledged|errored|rejected|retrying|failed — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Received Timestamp' ;
    rdfs:comment 'The date and time when the message was received by the interface engine infrastructure. Used for latency calculation and SLA monitoring.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:receivingApplication rdf:type rdf:Property ;
    rdfs:label 'Receiving Application' ;
    rdfs:comment 'Name or identifier of the destination application system that should receive and process the message. Corresponds to MSH-5 in HL7 v2.x.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retryCount rdf:type rdf:Property ;
    rdfs:label 'Retry Count' ;
    rdfs:comment 'Number of times the interface engine has attempted to reprocess this message after initial failure. Used for identifying chronic failures and triggering escalation workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sendingApplication rdf:type rdf:Property ;
    rdfs:label 'Sending Application' ;
    rdfs:comment 'Name or identifier of the source application system that generated the message (e.g., Epic, Cerner, MEDITECH module name). Corresponds to MSH-3 in HL7 v2.x.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaMet rdf:type rdf:Property ;
    rdfs:label 'Sla Met' ;
    rdfs:comment 'Indicates whether the message processing met the defined SLA threshold. True if processing_latency_ms is less than or equal to sla_threshold_ms, False otherwise. Key metric for operational performance reporting and vendor accountability.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaThresholdMs rdf:type rdf:Property ;
    rdfs:label 'Sla Threshold Ms' ;
    rdfs:comment 'The maximum allowed processing latency in milliseconds for this message type as defined by the interface SLA. Used for automated SLA compliance monitoring and alerting when processing_latency_ms exceeds this threshold.' ;
    rdfs:domain ind:MessageLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceIpAddress rdf:type rdf:Property ;
    rdfs:label 'Source Ip Address' ;
    rdfs:comment 'IP address of the sending system that transmitted the message. Used for security auditing, network troubleshooting, and access control verification.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transformationApplied rdf:type rdf:Property ;
    rdfs:label 'Transformation Applied' ;
    rdfs:comment 'Indicates whether data transformation or mapping rules were applied to the message during processing (e.g., code set translation, field mapping, data enrichment). True if transformations were applied, False if message was passed through unchanged.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationErrors rdf:type rdf:Property ;
    rdfs:label 'Validation Errors' ;
    rdfs:comment 'Detailed list of validation errors or warnings encountered during message validation. Includes schema violations, missing required fields, invalid code values, and business rule failures. Used for data quality monitoring and sender feedback.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationStatus rdf:type rdf:Property ;
    rdfs:label 'Validation Status' ;
    rdfs:comment 'Result of message validation against the applicable standard schema and business rules. Passed=all validations successful, Failed=validation errors prevent processing, Warning=non-critical validation issues, Not_Validated=validation was skipped.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:messageErrorId rdf:type rdf:Property ;
    rdfs:label 'Message Error Id' ;
    rdfs:comment 'Unique identifier for the message error record. Primary key.' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentMessageErrorId rdf:type rdf:Property ;
    rdfs:label 'Parent Message Error Id' ;
    rdfs:comment 'Self-referencing FK on message_error (related_message_error_id)' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MessageError .

ind:acknowledgmentCode rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Code' ;
    rdfs:comment 'The HL7 acknowledgment code returned or expected: AA (Application Accept), AE (Application Error), AR (Application Reject), CA (Commit Accept), CE (Commit Error), CR (Commit Reject).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualResolutionMinutes rdf:type rdf:Property ;
    rdfs:label 'Actual Resolution Minutes' ;
    rdfs:comment 'The actual time in minutes from error detection to resolution, used for SLA compliance tracking and performance measurement.' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:businessImpactDescription rdf:type rdf:Property ;
    rdfs:label 'Business Impact Description' ;
    rdfs:comment 'Description of the operational or clinical impact of the error, such as delayed lab results, missed patient admissions, billing delays, or care coordination disruptions.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorCategory rdf:type rdf:Property ;
    rdfs:label 'Error Category' ;
    rdfs:comment 'The high-level classification of the error type: parsing (message structure issues), validation (business rule violations), routing (destination resolution failures), transformation (mapping errors), delivery (transmission failures), authentication, authorization, timeout, or system errors. [ENUM-REF-CANDIDATE: parsing|validation|routing|transformation|delivery|authentication|authorization|timeout|system — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorStackTrace rdf:type rdf:Property ;
    rdfs:label 'Error Stack Trace' ;
    rdfs:comment 'The technical stack trace or detailed exception log captured at the point of failure, used for root cause analysis and debugging.' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorTimestamp rdf:type rdf:Property ;
    rdfs:label 'Error Timestamp' ;
    rdfs:comment 'The precise date and time when the message processing error was detected by the interface engine.' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:escalationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Escalation Timestamp' ;
    rdfs:comment 'The date and time when the error was escalated for additional support or management attention.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fieldPositionError rdf:type rdf:Property ;
    rdfs:label 'Field Position Error' ;
    rdfs:comment 'The specific field position or element path within the segment or resource where the error occurred (e.g., PID-5 for patient name, Patient.name.family).' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interfaceEngineVersion rdf:type rdf:Property ;
    rdfs:label 'Interface Engine Version' ;
    rdfs:comment 'The version of the interface engine software (e.g., Rhapsody, Mirth Connect, Cloverleaf, Ensemble) that processed the message when the error occurred.' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:messageSegmentError rdf:type rdf:Property ;
    rdfs:label 'Message Segment Error' ;
    rdfs:comment 'The specific HL7 segment (e.g., PID, OBR, DG1) or FHIR resource element path where the error was detected.' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rawMessagePayload rdf:type rdf:Property ;
    rdfs:label 'Raw Message Payload' ;
    rdfs:comment 'The complete raw message content (HL7 pipe-delimited text, FHIR JSON/XML, CDA document) that failed processing, stored for forensic analysis and replay. Contains Protected Health Information (PHI).' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retryEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Retry Eligible Flag' ;
    rdfs:comment 'Indicates whether the message is eligible for automatic or manual retry based on error type and business rules.' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rootCauseCategory rdf:type rdf:Property ;
    rdfs:label 'Root Cause Category' ;
    rdfs:comment 'The classified root cause of the error: data_quality (source data issues), configuration (interface setup problems), mapping (transformation logic errors), network (connectivity failures), system_outage (application downtime), third_party (external system issues), user_error (manual process mistakes), or unknown (cause not determined). [ENUM-REF-CANDIDATE: data_quality|configuration|mapping|network|system_outage|third_party|user_error|unknown — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaTargetResolutionMinutes rdf:type rdf:Property ;
    rdfs:label 'Sla Target Resolution Minutes' ;
    rdfs:comment 'The target resolution time in minutes defined by the SLA for this error category and severity level.' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validationRuleViolated rdf:type rdf:Property ;
    rdfs:label 'Validation Rule Violated' ;
    rdfs:comment 'The specific business or technical validation rule that was violated, causing the error (e.g., required field missing, invalid code value, referential integrity failure).' ;
    rdfs:domain ind:MessageError ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirEndpointId rdf:type rdf:Property ;
    rdfs:label 'Fhir Endpoint Id' ;
    rdfs:comment 'Unique identifier for the FHIR API endpoint record. Primary key for the FHIR endpoint registry.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FhirEndpoint .

ind:dataSharingAgreementId rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Agreement Id' ;
    rdfs:comment 'Identifier of the legal data sharing agreement or Business Associate Agreement (BAA) governing data exchange through this endpoint. Links to compliance and legal documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DataSharingAgreement .

ind:supersededFhirEndpointId rdf:type rdf:Property ;
    rdfs:label 'Superseded Fhir Endpoint Id' ;
    rdfs:comment 'Self-referencing FK on fhir_endpoint (superseded_fhir_endpoint_id)' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FhirEndpoint .

ind:averageResponseTimeMs rdf:type rdf:Property ;
    rdfs:label 'Average Response Time Ms' ;
    rdfs:comment 'Average response time in milliseconds for API requests to this endpoint over a defined measurement period. Used for performance monitoring and optimization.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bulkDataExportSupportFlag rdf:type rdf:Property ;
    rdfs:label 'Bulk Data Export Support Flag' ;
    rdfs:comment 'Indicates whether this endpoint supports FHIR Bulk Data Access (Flat FHIR) for large-scale data export operations. True if bulk export is supported, False otherwise.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capabilityStatementUrl rdf:type rdf:Property ;
    rdfs:label 'Capability Statement Url' ;
    rdfs:comment 'URL to the FHIR CapabilityStatement resource that describes the functionality and supported operations of this endpoint. Typically accessed via [base_url]/metadata.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Compliance Flag' ;
    rdfs:comment 'Indicates whether this endpoint is compliant with CMS Interoperability and Patient Access Final Rule requirements (21st Century Cures Act). True if compliant, False otherwise.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:connectionType rdf:type rdf:Property ;
    rdfs:label 'Connection Type' ;
    rdfs:comment 'The protocol or connection type used by this endpoint (e.g., HL7 FHIR REST, HL7 FHIR Messaging, Direct messaging, IHE XDS, HL7 v2, custom integration).' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deprecationDate rdf:type rdf:Property ;
    rdfs:label 'Deprecation Date' ;
    rdfs:comment 'Date when this endpoint was marked as deprecated and scheduled for retirement. Used for migration planning and stakeholder communication.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endpointName rdf:type rdf:Property ;
    rdfs:label 'Endpoint Name' ;
    rdfs:comment 'Human-readable name or label for the FHIR endpoint, used for identification and management purposes.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endpointType rdf:type rdf:Property ;
    rdfs:label 'Endpoint Type' ;
    rdfs:comment 'Classification of the FHIR endpoint based on its primary use case and audience (e.g., patient-facing SMART on FHIR apps, payer FHIR APIs for CMS Interoperability Rule, provider directory endpoints, internal FHIR server instances, HIE gateways).' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endpointUrl rdf:type rdf:Property ;
    rdfs:label 'Endpoint Url' ;
    rdfs:comment 'The full URL of the FHIR API endpoint, including protocol, domain, and base path. This is the technical address where FHIR requests are sent.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environment rdf:type rdf:Property ;
    rdfs:label 'Environment' ;
    rdfs:comment 'The deployment environment of this FHIR endpoint (e.g., production, staging, testing, development, sandbox). Used to distinguish live endpoints from test environments.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirVersion rdf:type rdf:Property ;
    rdfs:label 'Fhir Version' ;
    rdfs:comment 'The version of the FHIR specification that this endpoint implements (e.g., R4, STU3, DSTU2, R5).' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAvailabilityCheckTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Availability Check Timestamp' ;
    rdfs:comment 'Timestamp of the most recent automated availability or health check performed on this endpoint. Used for monitoring and alerting.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastAvailabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Last Availability Status' ;
    rdfs:comment 'Result of the most recent availability check (e.g., available, unavailable, degraded, timeout, error). Used for operational monitoring and incident response.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oauthAuthorizationUrl rdf:type rdf:Property ;
    rdfs:label 'Oauth Authorization Url' ;
    rdfs:comment 'The OAuth 2.0 authorization endpoint URL used for user authorization flows when authentication_method is OAuth2 or SMART on FHIR.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oauthTokenUrl rdf:type rdf:Property ;
    rdfs:label 'Oauth Token Url' ;
    rdfs:comment 'The OAuth 2.0 token endpoint URL used for obtaining access tokens when authentication_method is OAuth2 or SMART on FHIR.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oncCertificationFlag rdf:type rdf:Property ;
    rdfs:label 'Onc Certification Flag' ;
    rdfs:comment 'Indicates whether this endpoint is part of an ONC-certified Health IT Module under the 21st Century Cures Act certification criteria.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientAccessApiFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Access Api Flag' ;
    rdfs:comment 'Indicates whether this endpoint is designated as a Patient Access API under CMS Interoperability Rule requirements. True if it provides patient-facing access to health data, False otherwise.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payerToPayerApiFlag rdf:type rdf:Property ;
    rdfs:label 'Payer To Payer Api Flag' ;
    rdfs:comment 'Indicates whether this endpoint is designated as a Payer-to-Payer API under CMS Interoperability Rule requirements. True if it supports payer-to-payer data exchange, False otherwise.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerAccessApiFlag rdf:type rdf:Property ;
    rdfs:label 'Provider Access Api Flag' ;
    rdfs:comment 'Indicates whether this endpoint is designated as a Provider Access API under CMS Interoperability Rule requirements. True if it provides provider-to-provider data exchange, False otherwise.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicEndpointFlag rdf:type rdf:Property ;
    rdfs:label 'Public Endpoint Flag' ;
    rdfs:comment 'Indicates whether this endpoint is publicly accessible without authentication (e.g., for provider directory lookups). True if public, False if authentication is required.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateLimitRequestsPerDay rdf:type rdf:Property ;
    rdfs:label 'Rate Limit Requests Per Day' ;
    rdfs:comment 'Maximum number of API requests allowed per day for this endpoint. Used for capacity planning and fair use enforcement.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rateLimitRequestsPerMinute rdf:type rdf:Property ;
    rdfs:label 'Rate Limit Requests Per Minute' ;
    rdfs:comment 'Maximum number of API requests allowed per minute for this endpoint. Used for throttling and capacity management.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:registrationDate rdf:type rdf:Property ;
    rdfs:label 'Registration Date' ;
    rdfs:comment 'Date when this FHIR endpoint was first registered in the organizations endpoint inventory. Used for tracking endpoint lifecycle and governance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retirementDate rdf:type rdf:Property ;
    rdfs:label 'Retirement Date' ;
    rdfs:comment 'Date when this endpoint was or will be retired and decommissioned. Used for lifecycle management and historical tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:securityCertificateExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Security Certificate Expiry Date' ;
    rdfs:comment 'Expiration date of the SSL/TLS security certificate used by this endpoint. Critical for maintaining secure communications and avoiding service disruptions.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:smartAppLaunchSupportFlag rdf:type rdf:Property ;
    rdfs:label 'Smart App Launch Support Flag' ;
    rdfs:comment 'Indicates whether this endpoint supports the SMART App Launch Framework for third-party application integration. True if SMART launch is supported, False otherwise.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportedResourceTypes rdf:type rdf:Property ;
    rdfs:label 'Supported Resource Types' ;
    rdfs:comment 'Comma-separated list of FHIR resource types supported by this endpoint (e.g., Patient, Observation, Condition, MedicationRequest, Encounter, Coverage, ExplanationOfBenefit). Derived from the CapabilityStatement.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalRequestsLast30Days rdf:type rdf:Property ;
    rdfs:label 'Total Requests Last 30 Days' ;
    rdfs:comment 'Total number of API requests received by this endpoint in the last 30 days. Used for usage analytics and capacity planning.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:uptimePercentage rdf:type rdf:Property ;
    rdfs:label 'Uptime Percentage' ;
    rdfs:comment 'Calculated uptime percentage for this endpoint over a defined measurement period (typically 30 days). Used for Service Level Agreement (SLA) tracking and performance reporting.' ;
    rdfs:domain ind:FhirEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clinicalAiModelInferenceLogId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Model Inference Log Id' ;
    rdfs:comment 'Foreign key linking to clinical_ai.model_inference_log. Business justification: FHIR RiskAssessment/Observation resources served via API that originate from AI inferences must trace to the generating inference for 21st Century Cures Act algorithmic transparency and patient access' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalAiModelInferenceLog .

ind:parentFhirResourceLogId rdf:type rdf:Property ;
    rdfs:label 'Parent Fhir Resource Log Id' ;
    rdfs:comment 'Self-referencing FK on fhir_resource_log (related_fhir_resource_log_id)' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FhirResourceLog .

ind:accessDecision rdf:type rdf:Property ;
    rdfs:label 'Access Decision' ;
    rdfs:comment 'The access control decision made by the authorization engine (granted, denied, conditional). Supports security audit and access policy effectiveness analysis.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationScope rdf:type rdf:Property ;
    rdfs:label 'Authorization Scope' ;
    rdfs:comment 'The OAuth 2.0 scopes granted to the requesting client for this operation (e.g., patient/*.read, user/Observation.write). Defines the access permissions under which the operation was performed.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimDenialReason rdf:type rdf:Property ;
    rdfs:label 'Claim Denial Reason' ;
    rdfs:comment 'The reason code or message explaining why access was denied or the operation failed. Used for troubleshooting and identifying access control issues.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conformanceValidationResult rdf:type rdf:Property ;
    rdfs:label 'Conformance Validation Result' ;
    rdfs:comment 'Indicates whether the FHIR resource in the request or response passed conformance validation against the applicable FHIR profile or implementation guide (passed, failed, not_validated). Supports data quality monitoring and interoperability compliance.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentExceptionReason rdf:type rdf:Property ;
    rdfs:label 'Consent Exception Reason' ;
    rdfs:comment 'The specific exception category or reason code under the 21st Century Cures Act that justified restricting access or blocking information (e.g., privacy, security, infeasibility). Required when cures_act_exception_flag is True.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentPolicyApplied rdf:type rdf:Property ;
    rdfs:label 'Consent Policy Applied' ;
    rdfs:comment 'Identifier or reference to the patient consent policy that was evaluated and applied during this operation. Supports consent-based access control and HIPAA minimum necessary compliance.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curesActExceptionFlag rdf:type rdf:Property ;
    rdfs:label 'Cures Act Exception Flag' ;
    rdfs:comment 'Indicates whether this operation involved an exception to the information blocking prohibition under the 21st Century Cures Act (e.g., privacy exception, security exception). True if an exception was invoked, False otherwise.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSegmentationApplied rdf:type rdf:Property ;
    rdfs:label 'Data Segmentation Applied' ;
    rdfs:comment 'Indicates whether data segmentation for privacy (DS4P) was applied to filter sensitive data elements from the response based on patient consent or policy. True if segmentation occurred, False otherwise.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fhirProfileUrl rdf:type rdf:Property ;
    rdfs:label 'Fhir Profile Url' ;
    rdfs:comment 'The canonical URL of the FHIR profile or implementation guide against which the resource was validated (e.g., US Core, IPS). Identifies the conformance standard applied.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirResourceIdentifier rdf:type rdf:Property ;
    rdfs:label 'Fhir Resource Identifier' ;
    rdfs:comment 'The logical identifier of the specific FHIR resource instance being accessed (e.g., Patient/12345, Observation/67890). Empty for search or create operations that do not target a specific resource instance.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirResourceType rdf:type rdf:Property ;
    rdfs:label 'Fhir Resource Type' ;
    rdfs:comment 'The type of FHIR resource being accessed or manipulated (e.g., Patient, Observation, Condition, MedicationRequest). Defines the clinical or administrative entity subject to the operation. [ENUM-REF-CANDIDATE: Patient|Observation|Condition|MedicationRequest|Procedure|Encounter|AllergyIntolerance|DiagnosticReport|Immunization|CarePlan|DocumentReference|Practitioner|Organization|Location|Device|Appointment|ServiceRequest|Coverage|Claim|ExplanationOfBenefit|CareTeam|Goal|Medication|Substance|Specimen|Task|Communication|Consent|Provenance|AuditEvent|Bundle — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirVersionCode rdf:type rdf:Property ;
    rdfs:label 'Fhir Version Code' ;
    rdfs:comment 'The version identifier of the FHIR resource instance accessed via vread or returned in response. Supports resource versioning and history tracking per FHIR specification.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:httpStatusCode rdf:type rdf:Property ;
    rdfs:label 'Http Status Code' ;
    rdfs:comment 'The HTTP response status code returned by the FHIR server (e.g., 200 for success, 404 for not found, 401 for unauthorized, 500 for server error). Indicates the outcome of the API operation.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operationOutcome rdf:type rdf:Property ;
    rdfs:label 'Operation Outcome' ;
    rdfs:comment 'High-level categorization of the operation result (success, client_error, server_error, not_found, unauthorized, forbidden, validation_error). Derived from HTTP status code for simplified reporting and alerting. [ENUM-REF-CANDIDATE: success|client_error|server_error|not_found|unauthorized|forbidden|validation_error — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationType rdf:type rdf:Property ;
    rdfs:label 'Operation Type' ;
    rdfs:comment 'The RESTful interaction type performed on the FHIR resource (read, vread, update, patch, delete, create, search-type, history-instance, history-type, or custom $operation). Aligns with FHIR RESTful API interaction definitions. [ENUM-REF-CANDIDATE: read|vread|update|patch|delete|create|search-type|history-instance|history-type|operation — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestBodySizeBytes rdf:type rdf:Property ;
    rdfs:label 'Request Body Size Bytes' ;
    rdfs:comment 'The size of the HTTP request body payload in bytes. Used for bandwidth monitoring and identifying large resource submissions.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requestUrl rdf:type rdf:Property ;
    rdfs:label 'Request Url' ;
    rdfs:comment 'The full URL path of the FHIR API request, including query parameters for search operations. Captures the exact API endpoint and parameters used for detailed audit and debugging.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingApplicationCode rdf:type rdf:Property ;
    rdfs:label 'Requesting Application Code' ;
    rdfs:comment 'Identifier of the client application or system that initiated the FHIR API request (e.g., mobile app, EHR module, third-party application). Used for access tracking and application-level analytics.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingClientCode rdf:type rdf:Property ;
    rdfs:label 'Requesting Client Code' ;
    rdfs:comment 'OAuth 2.0 client identifier or API key associated with the requesting application. Supports authentication audit and client-level access control.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseBodySizeBytes rdf:type rdf:Property ;
    rdfs:label 'Response Body Size Bytes' ;
    rdfs:comment 'The size of the HTTP response body payload in bytes. Used for bandwidth monitoring and identifying large resource retrievals.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responseTimeMs rdf:type rdf:Property ;
    rdfs:label 'Response Time Ms' ;
    rdfs:comment 'The elapsed time in milliseconds between request receipt and response transmission. Key performance indicator for FHIR API latency and service level agreement (SLA) monitoring.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Response Timestamp' ;
    rdfs:comment 'The date and time when the FHIR API response was sent back to the client. Used to calculate response time and monitor API performance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:searchParameters rdf:type rdf:Property ;
    rdfs:label 'Search Parameters' ;
    rdfs:comment 'The query string parameters used in FHIR search operations (e.g., _id, _lastUpdated, patient, code). Captured for search pattern analysis and optimization.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchResultCount rdf:type rdf:Property ;
    rdfs:label 'Search Result Count' ;
    rdfs:comment 'The number of FHIR resources returned in response to a search operation. Used to analyze search effectiveness and identify overly broad queries.' ;
    rdfs:domain ind:FhirResourceLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fallbackMappingRuleId rdf:type rdf:Property ;
    rdfs:label 'Fallback Mapping Rule Id' ;
    rdfs:comment 'Self-referencing FK on mapping_rule (fallback_mapping_rule_id)' ;
    rdfs:domain ind:MappingRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MappingRule .

ind:interoperabilityMappingDefinitionId rdf:type rdf:Property ;
    rdfs:label 'Interoperability Mapping Definition Id' ;
    rdfs:comment 'Reference to the parent mapping definition container that groups related transformation rules. Links this atomic rule to its parent mapping context.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InteroperabilityMappingDefinition .

ind:sourceCrosswalkId rdf:type rdf:Property ;
    rdfs:label 'Source Crosswalk Id' ;
    rdfs:comment 'Foreign key linking to reference.crosswalk. Business justification: Interface transformation rules reference crosswalk tables for code-to-code mappings. Real-world: mapping rules execute crosswalk lookups during message transformation to translate between code systems' ;
    rdfs:domain ind:MappingRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Crosswalk .

ind:sourceExchangeStandardId rdf:type rdf:Property ;
    rdfs:label 'Source Exchange Standard Id' ;
    rdfs:comment 'Foreign key linking to interoperability.exchange_standard. Business justification: Mapping rules transform data FROM a source exchange standard. Adding this FK provides authoritative linkage to the standard definition (HL7v2, FHIR, CDA, etc.) and enables validation that the source_e' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExchangeStandard .

ind:approvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approved Timestamp' ;
    rdfs:comment 'The date and time when this transformation rule was approved for production use. Supports governance and change control processes for interface engine configurations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:conditionExpression rdf:type rdf:Property ;
    rdfs:label 'Condition Expression' ;
    rdfs:comment 'Boolean expression or predicate that determines when this rule should be applied. If empty or null, the rule applies unconditionally. Supports conditional transformation logic.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataTypeConversion rdf:type rdf:Property ;
    rdfs:label 'Data Type Conversion' ;
    rdfs:comment 'Specific instructions or function calls for converting the source data type to the target data type. May include format strings, parsing rules, or precision handling.' ;
    rdfs:domain ind:MappingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultValue rdf:type rdf:Property ;
    rdfs:label 'Default Value' ;
    rdfs:comment 'The value to assign to the target field when the source value is missing, null, or does not meet the condition expression. Supports fallback behavior in transformation logic.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equivalenceType rdf:type rdf:Property ;
    rdfs:label 'Equivalence Type' ;
    rdfs:comment 'Describes the semantic relationship between the source and target concepts in terminology mapping. Follows HL7 FHIR ConceptMapEquivalence value set for interoperability standards. [ENUM-REF-CANDIDATE: equivalent|equal|wider|subsumes|narrower|specializes|inexact|unmatched|disjoint — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorHandlingAction rdf:type rdf:Property ;
    rdfs:label 'Error Handling Action' ;
    rdfs:comment 'Defines the action to take when this rule encounters an error during execution. Options: abort (stop processing), log (record error and continue), skip (ignore rule), retry (attempt again), default (use default_value).' ;
    rdfs:domain ind:MappingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nullHandlingStrategy rdf:type rdf:Property ;
    rdfs:label 'Null Handling Strategy' ;
    rdfs:comment 'Defines how the transformation engine should handle null or missing source values. Options: skip (do not write target), default (use default_value), error (raise exception), empty_string (write empty string), preserve_null (write null to target).' ;
    rdfs:domain ind:MappingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleDescription rdf:type rdf:Property ;
    rdfs:label 'Rule Description' ;
    rdfs:comment 'Detailed explanation of the transformation logic, business rationale, and expected behavior of this mapping rule. Documents the purpose and context for future maintenance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rulePriority rdf:type rdf:Property ;
    rdfs:label 'Rule Priority' ;
    rdfs:comment 'Priority level for rule execution when multiple rules could apply to the same source-target pair. Higher values indicate higher priority. Used for conflict resolution.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ruleSequence rdf:type rdf:Property ;
    rdfs:label 'Rule Sequence' ;
    rdfs:comment 'Ordinal position of this transformation rule within the parent mapping definition. Determines execution order when multiple rules apply to the same source-target pair.' ;
    rdfs:domain ind:MappingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ruleStatus rdf:type rdf:Property ;
    rdfs:label 'Rule Status' ;
    rdfs:comment 'Current lifecycle status of the transformation rule. Determines whether the rule is executed by the interface engine during message processing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleVersion rdf:type rdf:Property ;
    rdfs:label 'Rule Version' ;
    rdfs:comment 'Version identifier for this transformation rule. Supports granular versioning and change tracking of individual rules independent of the parent mapping definition.' ;
    rdfs:domain ind:MappingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDataType rdf:type rdf:Property ;
    rdfs:label 'Source Data Type' ;
    rdfs:comment 'The data type of the source field as defined in the source system schema or message specification. Used for type validation and conversion planning.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceExpression rdf:type rdf:Property ;
    rdfs:label 'Source Expression' ;
    rdfs:comment 'The source field path, XPath, JSONPath, or HL7 segment/field reference that identifies the input data element to be transformed. May include extraction logic or functions.' ;
    rdfs:domain ind:MappingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCodeSystem rdf:type rdf:Property ;
    rdfs:label 'Target Code System' ;
    rdfs:comment 'The terminology or code system used in the target field. Examples: ICD-10, SNOMED CT, LOINC, NDC, CPT. Used for terminology mapping and value set translation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDataType rdf:type rdf:Property ;
    rdfs:label 'Target Data Type' ;
    rdfs:comment 'The data type of the target field as defined in the target system schema or message specification. Used for type conversion and validation.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetExpression rdf:type rdf:Property ;
    rdfs:label 'Target Expression' ;
    rdfs:comment 'The target field path, XPath, JSONPath, or HL7 segment/field reference that identifies where the transformed value should be written. May include assignment logic or functions.' ;
    rdfs:domain ind:MappingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testCaseReference rdf:type rdf:Property ;
    rdfs:label 'Test Case Reference' ;
    rdfs:comment 'Reference to the test case or test suite that validates this transformation rule. Links rule to quality assurance artifacts for regression testing and validation.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transformationFunction rdf:type rdf:Property ;
    rdfs:label 'Transformation Function' ;
    rdfs:comment 'The function, method, or algorithm applied to convert the source value to the target format. May reference built-in interface engine functions, custom scripts, or standard conversion routines.' ;
    rdfs:domain ind:MappingRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationRule rdf:type rdf:Property ;
    rdfs:label 'Validation Rule' ;
    rdfs:comment 'Post-transformation validation expression or constraint that the target value must satisfy. Used to ensure data quality and conformance to target system requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAssociateAgreementId rdf:type rdf:Property ;
    rdfs:label 'Business Associate Agreement Id' ;
    rdfs:comment 'Reference to the Business Associate Agreement governing the HIE relationship, if the HIE is acting as a business associate.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BusinessAssociateAgreement .

ind:financialEntityId rdf:type rdf:Property ;
    rdfs:label 'Financial Entity Id' ;
    rdfs:comment 'Reference to the healthcare organization participating in the HIE. Links to the organization master data.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialEntity .

ind:hieOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Hie Organization Id' ;
    rdfs:comment 'Unique identifier assigned by the HIE network to this participating organization. Used for routing and identification within the HIE.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HieOrganization .

ind:renewedHieParticipationId rdf:type rdf:Property ;
    rdfs:label 'Renewed Hie Participation Id' ;
    rdfs:comment 'Self-referencing FK on hie_participation (renewed_hie_participation_id)' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HieParticipation .

ind:annualParticipationFee rdf:type rdf:Property ;
    rdfs:label 'Annual Participation Fee' ;
    rdfs:comment 'Annual fee charged by the HIE network for participation, if applicable.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceAttestationDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Attestation Date' ;
    rdfs:comment 'Date when the organization attested to compliance with HIE policies, HIPAA requirements, and technical standards.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceAttestationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Attestation Expiration Date' ;
    rdfs:comment 'Date when the current compliance attestation expires and must be renewed.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contributionVolumeMonthlyAvg rdf:type rdf:Property ;
    rdfs:label 'Contribution Volume Monthly Avg' ;
    rdfs:comment 'Average number of clinical documents or messages contributed to the HIE per month by this organization.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataUseAgreementExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Data Use Agreement Expiration Date' ;
    rdfs:comment 'Date when the current Data Use Agreement expires and must be renewed.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataUseAgreementSignedDate rdf:type rdf:Property ;
    rdfs:label 'Data Use Agreement Signed Date' ;
    rdfs:comment 'Date when the organization signed the Data Use Agreement or Participation Agreement with the HIE.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hieNetworkType rdf:type rdf:Property ;
    rdfs:label 'Hie Network Type' ;
    rdfs:comment 'Classification of the HIE network by geographic or organizational scope: state HIE, regional HIE, national network, private exchange, or vendor-specific network.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interfaceEngineEndpoint rdf:type rdf:Property ;
    rdfs:label 'Interface Engine Endpoint' ;
    rdfs:comment 'Technical endpoint URL or address configured in the interface engine for HIE connectivity (e.g., FHIR base URL, Direct address, HL7 MLLP endpoint).' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onboardingDate rdf:type rdf:Property ;
    rdfs:label 'Onboarding Date' ;
    rdfs:comment 'Date when the organization formally joined the HIE network and completed technical onboarding.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:participationStatus rdf:type rdf:Property ;
    rdfs:label 'Participation Status' ;
    rdfs:comment 'Current status of the organizations participation in the HIE network: active (exchanging data), inactive (not exchanging), suspended (temporarily halted), pending onboarding (in setup), or terminated (ended).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationTier rdf:type rdf:Property ;
    rdfs:label 'Participation Tier' ;
    rdfs:comment 'Level of participation in the HIE: query-only (read access), contribute-only (write access), query-and-contribute (bidirectional), or full bidirectional with advanced services.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientConsentModel rdf:type rdf:Property ;
    rdfs:label 'Patient Consent Model' ;
    rdfs:comment 'Consent framework governing patient data sharing: opt-in (explicit consent required), opt-out (default sharing unless patient objects), no consent required (permitted by law), or emergency-only access.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryVolumeMonthlyAvg rdf:type rdf:Property ;
    rdfs:label 'Query Volume Monthly Avg' ;
    rdfs:comment 'Average number of queries sent to the HIE per month by this organization.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:suspensionReason rdf:type rdf:Property ;
    rdfs:label 'Suspension Reason' ;
    rdfs:comment 'Reason for suspension or termination of HIE participation (e.g., compliance violation, technical issues, voluntary withdrawal, contract expiration).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicalConnectionType rdf:type rdf:Property ;
    rdfs:label 'Technical Connection Type' ;
    rdfs:comment 'Technical method used to connect to the HIE: Direct Messaging (SMTP/S-MIME), FHIR API, HL7v2 interface, CDA document exchange, or proprietary protocol.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionFeeModel rdf:type rdf:Property ;
    rdfs:label 'Transaction Fee Model' ;
    rdfs:comment 'Pricing model for HIE transactions: flat rate, per-transaction fee, tiered pricing based on volume, or no fee.' ;
    rdfs:domain ind:HieParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hieQueryId rdf:type rdf:Property ;
    rdfs:label 'Hie Query Id' ;
    rdfs:comment 'Unique identifier for each HIE query transaction. Primary key for the HIE query record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HieQuery .

ind:followUpHieQueryId rdf:type rdf:Property ;
    rdfs:label 'Follow Up Hie Query Id' ;
    rdfs:comment 'Self-referencing FK on hie_query (follow_up_hie_query_id)' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HieQuery .

ind:primaryHieCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Primary Hie Care Site Id' ;
    rdfs:comment 'Identifier of the healthcare facility that initiated the HIE query request.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:auditLogged rdf:type rdf:Property ;
    rdfs:label 'Audit Logged' ;
    rdfs:comment 'Indicates whether the HIE query transaction was logged in the audit trail for compliance and security monitoring.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalPurposeCode rdf:type rdf:Property ;
    rdfs:label 'Clinical Purpose Code' ;
    rdfs:comment 'Code indicating the clinical purpose for which the HIE query was performed, used for consent enforcement and audit logging.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentVerified rdf:type rdf:Property ;
    rdfs:label 'Consent Verified' ;
    rdfs:comment 'Indicates whether patient consent was verified before the HIE query was executed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSensitivityLevel rdf:type rdf:Property ;
    rdfs:label 'Data Sensitivity Level' ;
    rdfs:comment 'Sensitivity classification of the data requested or returned in the HIE query.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentsReturnedCount rdf:type rdf:Property ;
    rdfs:label 'Documents Returned Count' ;
    rdfs:comment 'Number of clinical documents returned by the responding facility in response to the HIE query.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:initiatingFacilityNpi rdf:type rdf:Property ;
    rdfs:label 'Initiating Facility Npi' ;
    rdfs:comment 'National Provider Identifier of the facility that initiated the query.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Match Algorithm' ;
    rdfs:comment 'Name or identifier of the patient matching algorithm used by the HIE to determine patient identity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Match Confidence Score' ;
    rdfs:comment 'Confidence score (0-100) indicating the likelihood that the patient demographics matched the correct patient record in the responding system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:patientDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Patient Date Of Birth' ;
    rdfs:comment 'Date of birth of the patient used in the HIE query for demographic matching.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:patientFirstName rdf:type rdf:Property ;
    rdfs:label 'Patient First Name' ;
    rdfs:comment 'First name of the patient submitted in the HIE query for demographic matching.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientGender rdf:type rdf:Property ;
    rdfs:label 'Patient Gender' ;
    rdfs:comment 'Gender of the patient submitted in the HIE query for demographic matching.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientLastName rdf:type rdf:Property ;
    rdfs:label 'Patient Last Name' ;
    rdfs:comment 'Last name of the patient submitted in the HIE query for demographic matching.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientSsnLastFour rdf:type rdf:Property ;
    rdfs:label 'Patient Ssn Last Four' ;
    rdfs:comment 'Last four digits of the patient Social Security Number used for matching in the HIE query.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientZipCode rdf:type rdf:Property ;
    rdfs:label 'Patient Zip Code' ;
    rdfs:comment 'ZIP code of the patient address used in the HIE query for demographic matching.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryMessageControlNumber rdf:type rdf:Property ;
    rdfs:label 'Query Message Control Number' ;
    rdfs:comment 'Unique message identifier for the query request as defined by the messaging protocol.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryPriority rdf:type rdf:Property ;
    rdfs:label 'Query Priority' ;
    rdfs:comment 'Priority level assigned to the HIE query indicating urgency of the information request.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryProtocol rdf:type rdf:Property ;
    rdfs:label 'Query Protocol' ;
    rdfs:comment 'Interoperability protocol used to submit and receive the HIE query.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryResponseTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Query Response Time Seconds' ;
    rdfs:comment 'Time in seconds taken for the HIE network to return a response to the query request.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:querySourceSystem rdf:type rdf:Property ;
    rdfs:label 'Query Source System' ;
    rdfs:comment 'Name or identifier of the source system (EMR/EHR) from which the HIE query was initiated.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryStatus rdf:type rdf:Property ;
    rdfs:label 'Query Status' ;
    rdfs:comment 'Current processing status of the HIE query transaction.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:queryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Query Timestamp' ;
    rdfs:comment 'Date and time when the HIE query was submitted to the health information exchange network.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:queryType rdf:type rdf:Property ;
    rdfs:label 'Query Type' ;
    rdfs:comment 'Type of query submitted to the HIE network. [ENUM-REF-CANDIDATE: patient_discovery|document_query|document_retrieve|patient_demographics_query|clinical_data_query|medication_history_query|immunization_query|lab_results_query|radiology_query|care_summary_query — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Requesting Provider Npi' ;
    rdfs:comment 'National Provider Identifier of the provider who requested the HIE query.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:respondingFacilityNpi rdf:type rdf:Property ;
    rdfs:label 'Responding Facility Npi' ;
    rdfs:comment 'National Provider Identifier of the facility that responded to the query.' ;
    rdfs:domain ind:HieQuery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdaDocumentId rdf:type rdf:Property ;
    rdfs:label 'Cda Document Id' ;
    rdfs:comment 'Unique identifier for the CDA document record in the interoperability layer. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CdaDocument .

ind:authorClinicianId rdf:type rdf:Property ;
    rdfs:label 'Author Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: CDA documents require linking to authoring clinician for credentialing privileging reviews, peer review case attribution, and Promoting Interoperability attestation. Author_provider_npi exists but lac' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:consentReferenceId rdf:type rdf:Property ;
    rdfs:label 'Consent Reference Id' ;
    rdfs:comment 'Identifier of the patient consent record authorizing the exchange of this CDA document.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentReference .

ind:custodianOrgProviderId rdf:type rdf:Property ;
    rdfs:label 'Custodian Org Provider Id' ;
    rdfs:comment 'Foreign key linking to provider.org_provider. Business justification: CDA documents have custodian organization (legal entity responsible for the document). Custodian_organization_name exists but lacks FK. Healthcare compliance, legal health record management, and breac' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgProvider .

ind:primaryCdaCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Primary Cda Care Site Id' ;
    rdfs:comment 'Identifier of the healthcare facility or organization that authored or generated this CDA document.' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:problemId rdf:type rdf:Property ;
    rdfs:label 'Problem Id' ;
    rdfs:comment 'Foreign key linking to clinical.problem. Business justification: Problem lists are core C-CDA content (Problem List section required in many document types). Linking cda_document to problem enables tracking which problems were transmitted in care transitions, suppo' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Problem .

ind:supersededCdaDocumentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Cda Document Id' ;
    rdfs:comment 'Self-referencing FK on cda_document (superseded_cda_document_id)' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CdaDocument .

ind:cdaVersion rdf:type rdf:Property ;
    rdfs:label 'Cda Version' ;
    rdfs:comment 'Version of the CDA standard used for this document (e.g., CDA R2, C-CDA R1.1, C-CDA R2.1, C-CDA R3.0).' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityCode rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Code' ;
    rdfs:comment 'HL7 confidentiality code indicating the privacy level of the document (e.g., N=Normal, R=Restricted, V=Very Restricted).' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentCreationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Document Creation Timestamp' ;
    rdfs:comment 'Date and time when the CDA document was originally created or authored, as recorded in the CDA effectiveTime element.' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:documentHash rdf:type rdf:Property ;
    rdfs:label 'Document Hash' ;
    rdfs:comment 'Cryptographic hash (e.g., SHA-256) of the CDA document content for integrity verification and tamper detection.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentSizeBytes rdf:type rdf:Property ;
    rdfs:label 'Document Size Bytes' ;
    rdfs:comment 'Size of the CDA document file in bytes.' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentStatus rdf:type rdf:Property ;
    rdfs:label 'Document Status' ;
    rdfs:comment 'Current lifecycle status of the CDA document indicating its completeness and validity for clinical use.' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentTitle rdf:type rdf:Property ;
    rdfs:label 'Document Title' ;
    rdfs:comment 'Human-readable title of the CDA document as specified in the title element.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentTypeCode rdf:type rdf:Property ;
    rdfs:label 'Document Type Code' ;
    rdfs:comment 'LOINC code representing the type of clinical document (e.g., 34133-9 for Summarization of Episode Note, 11488-4 for Consultation Note, 18842-5 for Discharge Summary).' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentTypeName rdf:type rdf:Property ;
    rdfs:label 'Document Type Name' ;
    rdfs:comment 'Human-readable name of the CDA document type (e.g., Continuity of Care Document (CCD), Consolidated CDA (C-CDA), Quality Reporting Document Architecture (QRDA) Category I, QRDA Category III, Referral Note, Discharge Summary, Progress Note, Operative Note).' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentUniqueIdentifier rdf:type rdf:Property ;
    rdfs:label 'Document Unique Identifier' ;
    rdfs:comment 'Globally unique identifier for the CDA document, typically an Object Identifier (OID) conforming to ISO/IEC 8824 standard. This is the CDA documents id element value.' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentVersionNumber rdf:type rdf:Property ;
    rdfs:label 'Document Version Number' ;
    rdfs:comment 'Sequential version number of this CDA document within its document set. Increments with each amendment or update.' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exchangeDirection rdf:type rdf:Property ;
    rdfs:label 'Exchange Direction' ;
    rdfs:comment 'Direction of document exchange relative to the organization: inbound (received from external source) or outbound (sent to external recipient).' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityServiceEndDate rdf:type rdf:Property ;
    rdfs:label 'Facility Service End Date' ;
    rdfs:comment 'End date of the clinical service period documented in this CDA document.' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilityServiceStartDate rdf:type rdf:Property ;
    rdfs:label 'Facility Service Start Date' ;
    rdfs:comment 'Start date of the clinical service period documented in this CDA document.' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hipaaCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Compliant Flag' ;
    rdfs:comment 'Indicates whether the CDA document exchange complies with HIPAA Privacy and Security Rules.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:purposeOfUseCode rdf:type rdf:Property ;
    rdfs:label 'Purpose Of Use Code' ;
    rdfs:comment 'HL7 PurposeOfUse code indicating the reason for document exchange (e.g., TREATMENT, PAYMENT, OPERATIONS, RESEARCH).' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptTimestamp rdf:type rdf:Property ;
    rdfs:label 'Receipt Timestamp' ;
    rdfs:comment 'Date and time when the CDA document was received by the destination system for inbound exchanges.' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:storageLocationUri rdf:type rdf:Property ;
    rdfs:label 'Storage Location Uri' ;
    rdfs:comment 'Uniform Resource Identifier or file path indicating where the CDA document XML file is stored in the document repository or object storage system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transmission Timestamp' ;
    rdfs:comment 'Date and time when the CDA document was transmitted through the interface engine or HIE.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:validationErrorCount rdf:type rdf:Property ;
    rdfs:label 'Validation Error Count' ;
    rdfs:comment 'Number of validation errors identified during CDA schema and implementation guide validation.' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Validation Timestamp' ;
    rdfs:comment 'Date and time when CDA document validation was performed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:validationWarningCount rdf:type rdf:Property ;
    rdfs:label 'Validation Warning Count' ;
    rdfs:comment 'Number of validation warnings identified during CDA document validation.' ;
    rdfs:domain ind:CdaDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cdaValidationResultId rdf:type rdf:Property ;
    rdfs:label 'Cda Validation Result Id' ;
    rdfs:comment 'Unique identifier for the CDA validation result record. Primary key.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revalidatedCdaValidationResultId rdf:type rdf:Property ;
    rdfs:label 'Revalidated Cda Validation Result Id' ;
    rdfs:comment 'Self-referencing FK on cda_validation_result (revalidated_cda_validation_result_id)' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CdaValidationResult .

ind:certificationRequirementMet rdf:type rdf:Property ;
    rdfs:label 'Certification Requirement Met' ;
    rdfs:comment 'Indicates whether the validation results demonstrate that certification requirements (e.g., ONC Health IT Certification) are met.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalErrorList rdf:type rdf:Property ;
    rdfs:label 'Critical Error List' ;
    rdfs:comment 'Comma-separated or structured list of critical error codes that must be resolved before document can be accepted.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationSystem rdf:type rdf:Property ;
    rdfs:label 'Destination System' ;
    rdfs:comment 'Name of the destination system or Health Information Exchange (HIE) that will receive the validated document.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentAuthorNpi rdf:type rdf:Property ;
    rdfs:label 'Document Author Npi' ;
    rdfs:comment 'National Provider Identifier of the clinician or provider who authored the CDA document.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentSizeKb rdf:type rdf:Property ;
    rdfs:label 'Document Size Kb' ;
    rdfs:comment 'Size of the CDA document in kilobytes. Used for performance analysis and capacity planning.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:documentType rdf:type rdf:Property ;
    rdfs:label 'Document Type' ;
    rdfs:comment 'Type of CDA document validated (e.g., Continuity of Care Document, Discharge Summary, Progress Note). [ENUM-REF-CANDIDATE: continuity_of_care|discharge_summary|progress_note|consultation_note|operative_note|history_and_physical|referral_note — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingDetails rdf:type rdf:Property ;
    rdfs:label 'Finding Details' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatorySubmissionType rdf:type rdf:Property ;
    rdfs:label 'Regulatory Submission Type' ;
    rdfs:comment 'Type of regulatory submission this validation supports (e.g., Meaningful Use, MIPS, HEDIS, CMS Quality Reporting).' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationAssignedTo rdf:type rdf:Property ;
    rdfs:label 'Remediation Assigned To' ;
    rdfs:comment 'Username or identifier of the user or team assigned to remediate validation errors.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationCompletedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Remediation Completed Timestamp' ;
    rdfs:comment 'Date and time when document remediation was completed and the document was re-validated successfully.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:schemaValidationPassed rdf:type rdf:Property ;
    rdfs:label 'Schema Validation Passed' ;
    rdfs:comment 'Indicates whether the document passed XML schema validation against the CDA schema definition.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:schematronValidationPassed rdf:type rdf:Property ;
    rdfs:label 'Schematron Validation Passed' ;
    rdfs:comment 'Indicates whether the document passed Schematron rule-based validation for conformance profile requirements.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:structuralValidationPassed rdf:type rdf:Property ;
    rdfs:label 'Structural Validation Passed' ;
    rdfs:comment 'Indicates whether the document passed structural validation for required sections, entries, and document hierarchy.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:submissionReadinessFlag rdf:type rdf:Property ;
    rdfs:label 'Submission Readiness Flag' ;
    rdfs:comment 'Indicates whether the document is ready for regulatory submission or external exchange based on validation results.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalErrorCount rdf:type rdf:Property ;
    rdfs:label 'Total Error Count' ;
    rdfs:comment 'Total number of errors identified during validation. Errors represent critical conformance failures that prevent document acceptance.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalInformationalCount rdf:type rdf:Property ;
    rdfs:label 'Total Informational Count' ;
    rdfs:comment 'Total number of informational findings identified during validation. Informational findings provide guidance for document quality improvement.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalWarningCount rdf:type rdf:Property ;
    rdfs:label 'Total Warning Count' ;
    rdfs:comment 'Total number of warnings identified during validation. Warnings represent non-critical issues that should be reviewed but do not prevent document acceptance.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validationExecutionTimeMs rdf:type rdf:Property ;
    rdfs:label 'Validation Execution Time Ms' ;
    rdfs:comment 'Time taken to complete the validation process measured in milliseconds. Used for performance monitoring.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validationInitiatedBy rdf:type rdf:Property ;
    rdfs:label 'Validation Initiated By' ;
    rdfs:comment 'Username or identifier of the user or system process that initiated the validation.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationPurpose rdf:type rdf:Property ;
    rdfs:label 'Validation Purpose' ;
    rdfs:comment 'Business purpose for performing the validation (e.g., trading partner onboarding, regulatory submission readiness, quality assurance).' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validatorToolName rdf:type rdf:Property ;
    rdfs:label 'Validator Tool Name' ;
    rdfs:comment 'Name of the validation tool or engine used to perform the conformance check (e.g., NIST CDA Validator, Schematron Validator, C-CDA Validator).' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validatorToolVersion rdf:type rdf:Property ;
    rdfs:label 'Validator Tool Version' ;
    rdfs:comment 'Version number of the validation tool used to ensure traceability of validation logic.' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vocabularyValidationPassed rdf:type rdf:Property ;
    rdfs:label 'Vocabulary Validation Passed' ;
    rdfs:comment 'Indicates whether the document passed vocabulary validation for coded elements (SNOMED CT, LOINC, RxNorm, ICD-10).' ;
    rdfs:domain ind:CdaValidationResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientIdentityMatchId rdf:type rdf:Property ;
    rdfs:label 'Patient Identity Match Id' ;
    rdfs:comment 'Unique identifier for the patient identity matching event. Primary key for this transactional record.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededPatientIdentityMatchId rdf:type rdf:Property ;
    rdfs:label 'Superseded Patient Identity Match Id' ;
    rdfs:comment 'Self-referencing FK on patient_identity_match (superseded_patient_identity_match_id)' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PatientIdentityMatch .

ind:candidateCount rdf:type rdf:Property ;
    rdfs:label 'Candidate Count' ;
    rdfs:comment 'Number of candidate patient records identified during the matching process before final match determination.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Consent Override Flag' ;
    rdfs:comment 'Indicates whether patient consent restrictions were overridden for this match request due to emergency or break-the-glass access (True=override applied, False=normal consent rules applied).' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentOverrideReason rdf:type rdf:Property ;
    rdfs:label 'Consent Override Reason' ;
    rdfs:comment 'Reason documented for overriding patient consent restrictions during the match request (e.g., emergency treatment, break-the-glass).' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateRecordFlag rdf:type rdf:Property ;
    rdfs:label 'Duplicate Record Flag' ;
    rdfs:comment 'Indicates whether the match process identified a potential duplicate patient record that should be investigated for merging (True=duplicate detected, False=no duplicate).' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:manualReviewAssignedTo rdf:type rdf:Property ;
    rdfs:label 'Manual Review Assigned To' ;
    rdfs:comment 'User ID or name of the HIM staff member assigned to manually review this match result.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manualReviewCompletedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Manual Review Completed Timestamp' ;
    rdfs:comment 'Date and time when manual review of the match result was completed.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:manualReviewNotes rdf:type rdf:Property ;
    rdfs:label 'Manual Review Notes' ;
    rdfs:comment 'Free-text notes entered by the reviewer documenting the rationale for the manual review decision.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manualReviewOutcome rdf:type rdf:Property ;
    rdfs:label 'Manual Review Outcome' ;
    rdfs:comment 'Outcome of the manual review process (CONFIRMED=match confirmed, REJECTED=match rejected, MERGED=records merged, NEW_RECORD_CREATED=new MPI record created).' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manualReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Manual Review Required Flag' ;
    rdfs:comment 'Indicates whether the match result requires manual review by HIM staff due to ambiguous or low-confidence matching (True=manual review required, False=automated match accepted).' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchAlgorithmCode rdf:type rdf:Property ;
    rdfs:label 'Match Algorithm Code' ;
    rdfs:comment 'Code identifying the specific matching algorithm or rule set used to perform the patient identity match (e.g., deterministic, probabilistic, hybrid).' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchAlgorithmVersion rdf:type rdf:Property ;
    rdfs:label 'Match Algorithm Version' ;
    rdfs:comment 'Version number of the matching algorithm used, enabling traceability and audit of algorithm changes over time.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchConfidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Match Confidence Level' ;
    rdfs:comment 'Categorical confidence level of the match result based on match score thresholds (HIGH=score above high threshold, MEDIUM=score in middle range, LOW=score below medium threshold).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchMethod rdf:type rdf:Property ;
    rdfs:label 'Match Method' ;
    rdfs:comment 'Method used to perform the patient identity match (DETERMINISTIC=exact match on key identifiers, PROBABILISTIC=statistical matching, HYBRID=combination, MANUAL=human review).' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchProcessingTimeMs rdf:type rdf:Property ;
    rdfs:label 'Match Processing Time Ms' ;
    rdfs:comment 'Time taken to process the identity match request, measured in milliseconds. Used for performance monitoring and SLA tracking.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:matchRequestTimestamp rdf:type rdf:Property ;
    rdfs:label 'Match Request Timestamp' ;
    rdfs:comment 'The date and time when the patient identity match request was initiated during cross-organizational data exchange. Represents the principal business event time for this transaction.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:matchResultStatus rdf:type rdf:Property ;
    rdfs:label 'Match Result Status' ;
    rdfs:comment 'Outcome of the patient identity matching process (MATCH=definitive match found, POSSIBLE_MATCH=potential match requiring review, NO_MATCH=no match found, MULTIPLE_MATCH=multiple candidates found, ERROR=matching process failed).' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchScore rdf:type rdf:Property ;
    rdfs:label 'Match Score' ;
    rdfs:comment 'Numerical score representing the confidence level of the patient identity match, typically expressed as a percentage or weighted score. Higher scores indicate stronger matches.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchedDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Matched Date Of Birth' ;
    rdfs:comment 'Date of birth from the matched MPI record, used to validate the match quality.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:matchedPatientFirstName rdf:type rdf:Property ;
    rdfs:label 'Matched Patient First Name' ;
    rdfs:comment 'First name of the patient from the matched MPI record, returned as part of the match result.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchedPatientLastName rdf:type rdf:Property ;
    rdfs:label 'Matched Patient Last Name' ;
    rdfs:comment 'Last name of the patient from the matched MPI record, returned as part of the match result.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingUserNpi rdf:type rdf:Property ;
    rdfs:label 'Requesting User Npi' ;
    rdfs:comment 'National Provider Identifier of the healthcare provider who initiated the match request, if applicable.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Submitted Address Line 1' ;
    rdfs:comment 'First line of the patient address submitted in the match request.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedCity rdf:type rdf:Property ;
    rdfs:label 'Submitted City' ;
    rdfs:comment 'City of the patient address submitted in the match request.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Submitted Date Of Birth' ;
    rdfs:comment 'Date of birth of the patient submitted in the match request, used as a key demographic matching attribute.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submittedGender rdf:type rdf:Property ;
    rdfs:label 'Submitted Gender' ;
    rdfs:comment 'Gender of the patient submitted in the match request (M=Male, F=Female, U=Unknown, O=Other).' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedMrn rdf:type rdf:Property ;
    rdfs:label 'Submitted Mrn' ;
    rdfs:comment 'The Medical Record Number submitted as part of the match request from the source system. May be facility-specific.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedPatientFirstName rdf:type rdf:Property ;
    rdfs:label 'Submitted Patient First Name' ;
    rdfs:comment 'First name of the patient submitted in the match request for identity matching purposes.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedPatientLastName rdf:type rdf:Property ;
    rdfs:label 'Submitted Patient Last Name' ;
    rdfs:comment 'Last name of the patient submitted in the match request for identity matching purposes.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedPhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Submitted Phone Number' ;
    rdfs:comment 'Phone number of the patient submitted in the match request.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedPostalCode rdf:type rdf:Property ;
    rdfs:label 'Submitted Postal Code' ;
    rdfs:comment 'Postal code of the patient address submitted in the match request.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedSsn rdf:type rdf:Property ;
    rdfs:label 'Submitted Ssn' ;
    rdfs:comment 'Social Security Number submitted in the match request, if available. Used as a strong identifier for matching.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittedState rdf:type rdf:Property ;
    rdfs:label 'Submitted State' ;
    rdfs:comment 'State or province of the patient address submitted in the match request.' ;
    rdfs:domain ind:PatientIdentityMatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionType rdf:type rdf:Property ;
    rdfs:label 'Transaction Type' ;
    rdfs:comment 'Type of interoperability transaction that triggered the identity match (PIX Query, PDQ Query, MPI Lookup, EMPI Match, FHIR Patient Match, HL7 ADT).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repliedToDirectMessageId rdf:type rdf:Property ;
    rdfs:label 'Replied To Direct Message Id' ;
    rdfs:comment 'Self-referencing FK on direct_message (replied_to_direct_message_id)' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DirectMessage .

ind:senderDirectAddressId rdf:type rdf:Property ;
    rdfs:label 'Sender Direct Address Id' ;
    rdfs:comment 'Foreign key linking to interoperability.direct_address. Business justification: Direct messages are sent FROM managed Direct addresses. Currently sender_direct_address is a STRING column. Adding sender_direct_address_id FK links the message to the managed address record in direct' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DirectAddress .

ind:certificateValidationResult rdf:type rdf:Property ;
    rdfs:label 'Certificate Validation Result' ;
    rdfs:comment 'Result of the digital certificate validation process for both sender and recipient certificates, ensuring trust and authenticity of the Direct message exchange.' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimAttachmentCount rdf:type rdf:Property ;
    rdfs:label 'Claim Attachment Count' ;
    rdfs:comment 'Number of file attachments included with the Direct message (e.g., CDA documents, PDF reports, DICOM images). Zero indicates message body only.' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimAttachmentTypes rdf:type rdf:Property ;
    rdfs:label 'Claim Attachment Types' ;
    rdfs:comment 'Comma-separated list of MIME types for all attachments included in the Direct message (e.g., application/xml, application/pdf, image/jpeg).' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Clinical Document Reference' ;
    rdfs:comment 'Reference identifier or pointer to the associated clinical document (CDA, FHIR document, or other format) that was transmitted within or attached to the Direct message.' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryStatus rdf:type rdf:Property ;
    rdfs:label 'Delivery Status' ;
    rdfs:comment 'Current delivery status of the Direct message indicating whether it was successfully delivered, failed, bounced, or is pending delivery confirmation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Delivery Timestamp' ;
    rdfs:comment 'The date and time when the Direct message was successfully delivered to the recipient system, or when a delivery failure was confirmed. Null if delivery is still pending.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:encryptionAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Encryption Algorithm' ;
    rdfs:comment 'The cryptographic algorithm used to encrypt the Direct message (e.g., AES-256, 3DES). Supports security audit and compliance verification.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encryptionStatus rdf:type rdf:Property ;
    rdfs:label 'Encryption Status' ;
    rdfs:comment 'Indicates whether the Direct message was successfully encrypted using S/MIME encryption standards as required by the Direct Protocol for Protected Health Information (PHI) transmission.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureReason rdf:type rdf:Property ;
    rdfs:label 'Failure Reason' ;
    rdfs:comment 'Detailed description of the reason for message delivery failure, including SMTP error codes, certificate validation errors, or recipient system unavailability. Null for successful deliveries.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meaningfulUseEligible rdf:type rdf:Property ;
    rdfs:label 'Meaningful Use Eligible' ;
    rdfs:comment 'Boolean flag indicating whether this Direct message transaction qualifies for Meaningful Use or Promoting Interoperability attestation requirements under CMS programs.' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:messageSizeBytes rdf:type rdf:Property ;
    rdfs:label 'Message Size Bytes' ;
    rdfs:comment 'Total size of the Direct message including all attachments and headers, measured in bytes. Used for capacity planning and transmission monitoring.' ;
    rdfs:domain ind:Interoperability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:readReceiptReceived rdf:type rdf:Property ;
    rdfs:label 'Read Receipt Received' ;
    rdfs:comment 'Boolean flag indicating whether a read receipt (Message Disposition Notification) was received from the recipient, confirming the message was opened.' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readReceiptRequested rdf:type rdf:Property ;
    rdfs:label 'Read Receipt Requested' ;
    rdfs:comment 'Boolean flag indicating whether the sender requested a read receipt (Message Disposition Notification) to confirm the recipient opened and read the message.' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readTimestamp rdf:type rdf:Property ;
    rdfs:label 'Read Timestamp' ;
    rdfs:comment 'The date and time when the recipient opened and read the Direct message, as reported by the Message Disposition Notification. Null if no read receipt was received.' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recipientCertificateSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Recipient Certificate Serial Number' ;
    rdfs:comment 'Serial number of the digital certificate used by the recipient to decrypt the Direct message. Used for certificate tracking and audit trails.' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientDirectAddress rdf:type rdf:Property ;
    rdfs:label 'Recipient Direct Address' ;
    rdfs:comment 'The Direct Protocol email address of the intended recipient (provider, organization, or system) receiving the secure message. Format follows standard email address structure with DirectTrust-accredited domain.' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recipientOrganizationName rdf:type rdf:Property ;
    rdfs:label 'Recipient Organization Name' ;
    rdfs:comment 'Name of the healthcare organization or facility that received the Direct message. Supports care coordination tracking and organizational analytics.' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sendTimestamp rdf:type rdf:Property ;
    rdfs:label 'Send Timestamp' ;
    rdfs:comment 'The date and time when the Direct message was sent from the originating system. Represents the business event time of message transmission.' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:senderCertificateSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Sender Certificate Serial Number' ;
    rdfs:comment 'Serial number of the digital certificate used by the sender to sign and encrypt the Direct message. Used for certificate tracking and audit trails.' ;
    rdfs:domain ind:DirectMessage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectLine rdf:type rdf:Property ;
    rdfs:label 'Subject Line' ;
    rdfs:comment 'Subject line of the Direct message providing a brief description of the message content or purpose. May contain patient identifiers or clinical context.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directAddressId rdf:type rdf:Property ;
    rdfs:label 'Direct Address Id' ;
    rdfs:comment 'Unique identifier for the Direct Secure Messaging address record. Primary key.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:replacedDirectAddressId rdf:type rdf:Property ;
    rdfs:label 'Replaced Direct Address Id' ;
    rdfs:comment 'Self-referencing FK on direct_address (replaced_direct_address_id)' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DirectAddress .

ind:activationDate rdf:type rdf:Property ;
    rdfs:label 'Activation Date' ;
    rdfs:comment 'The date on which this Direct address was activated and became operational for sending and receiving secure messages.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:addressStatus rdf:type rdf:Property ;
    rdfs:label 'Address Status' ;
    rdfs:comment 'Current operational status of the Direct address. Active addresses can send and receive messages; inactive, suspended, or revoked addresses cannot.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressType rdf:type rdf:Property ;
    rdfs:label 'Address Type' ;
    rdfs:comment 'Classification of the Direct address by entity type. Indicates whether the address belongs to an individual provider, a facility, a patient, an organizational unit, a department, or an application endpoint.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administrativeContactEmail rdf:type rdf:Property ;
    rdfs:label 'Administrative Contact Email' ;
    rdfs:comment 'The email address of the administrative contact responsible for this Direct address. Used for notifications and operational communications.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administrativeContactName rdf:type rdf:Property ;
    rdfs:label 'Administrative Contact Name' ;
    rdfs:comment 'The name of the administrative contact responsible for managing this Direct address. Used for operational coordination and issue resolution.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administrativeContactPhone rdf:type rdf:Property ;
    rdfs:label 'Administrative Contact Phone' ;
    rdfs:comment 'The phone number of the administrative contact responsible for this Direct address. Used for urgent operational communications.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoRenewalEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Enabled Flag' ;
    rdfs:comment 'Indicates whether automatic certificate renewal is enabled for this Direct address. True if auto-renewal is configured, False if manual renewal is required.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Certificate Expiration Date' ;
    rdfs:comment 'The date on which the digital certificate for this Direct address will expire. Certificates must be renewed before this date to maintain secure messaging capability.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificateIssueDate rdf:type rdf:Property ;
    rdfs:label 'Certificate Issue Date' ;
    rdfs:comment 'The date on which the digital certificate for this Direct address was issued by the Certificate Authority.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificateIssuerDn rdf:type rdf:Property ;
    rdfs:label 'Certificate Issuer Dn' ;
    rdfs:comment 'The Distinguished Name of the Certificate Authority that issued the certificate for this Direct address. Identifies the trusted CA in the PKI hierarchy.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificateSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Certificate Serial Number' ;
    rdfs:comment 'The unique serial number of the X.509 digital certificate issued for this Direct address. Used for certificate identification and revocation checking.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificateStatus rdf:type rdf:Property ;
    rdfs:label 'Certificate Status' ;
    rdfs:comment 'Current status of the X.509 digital certificate associated with this Direct address. Valid certificates are required for secure message encryption and signing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deactivationDate rdf:type rdf:Property ;
    rdfs:label 'Deactivation Date' ;
    rdfs:comment 'The date on which this Direct address was deactivated and ceased to be operational. Null if the address is currently active.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:departmentName rdf:type rdf:Property ;
    rdfs:label 'Department Name' ;
    rdfs:comment 'The name of the clinical or administrative department associated with this Direct address when the address type is department or organization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displayName rdf:type rdf:Property ;
    rdfs:label 'Display Name' ;
    rdfs:comment 'The human-readable display name associated with this Direct address, typically shown in message headers and address books (e.g., Dr. John Smith, Cardiology Department).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hispDomain rdf:type rdf:Property ;
    rdfs:label 'Hisp Domain' ;
    rdfs:comment 'The domain name of the HISP that manages this Direct address (e.g., direct.hospital.org). Used for routing and trust validation.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hispName rdf:type rdf:Property ;
    rdfs:label 'Hisp Name' ;
    rdfs:comment 'The name of the Health Information Service Provider that hosts and manages the Direct messaging infrastructure for this address.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hitrustCertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Hitrust Certified Flag' ;
    rdfs:comment 'Indicates whether the HISP managing this Direct address holds HITRUST CSF certification. True if certified, False otherwise.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastMessageReceivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Message Received Timestamp' ;
    rdfs:comment 'The timestamp of the most recent message received by this Direct address. Used for activity tracking and dormant address identification.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastMessageSentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Message Sent Timestamp' ;
    rdfs:comment 'The timestamp of the most recent message sent from this Direct address. Used for activity tracking and dormant address identification.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:messageVolumeLast30Days rdf:type rdf:Property ;
    rdfs:label 'Message Volume Last 30 Days' ;
    rdfs:comment 'The total number of messages sent or received by this Direct address in the last 30 days. Used for activity monitoring and capacity planning.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationEmail rdf:type rdf:Property ;
    rdfs:label 'Notification Email' ;
    rdfs:comment 'The email address to which operational notifications about this Direct address are sent (e.g., certificate expiration warnings, delivery failures).' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryUseCase rdf:type rdf:Property ;
    rdfs:label 'Primary Use Case' ;
    rdfs:comment 'The primary clinical or operational use case for which this Direct address is utilized. Helps categorize messaging patterns and workflows. [ENUM-REF-CANDIDATE: care_coordination|referral|lab_results|radiology_results|discharge_summary|continuity_of_care|patient_portal|public_health_reporting — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signatureAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Signature Algorithm' ;
    rdfs:comment 'The cryptographic algorithm used for digitally signing messages from this Direct address (e.g., RSA-SHA256). Ensures message integrity and non-repudiation.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialty rdf:type rdf:Property ;
    rdfs:label 'Specialty' ;
    rdfs:comment 'The clinical specialty of the provider associated with this Direct address when the address type is provider (e.g., Cardiology, Family Medicine, Radiology).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trustBundleMembershipStatus rdf:type rdf:Property ;
    rdfs:label 'Trust Bundle Membership Status' ;
    rdfs:comment 'Current status of this Direct address membership in the trust bundle. Active membership is required for trusted message exchange.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trustBundleName rdf:type rdf:Property ;
    rdfs:label 'Trust Bundle Name' ;
    rdfs:comment 'The name of the trust bundle or trust anchor bundle that this Direct address belongs to. Trust bundles define the set of trusted Certificate Authorities for secure message exchange.' ;
    rdfs:domain ind:DirectAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaSecurityRiskId rdf:type rdf:Property ;
    rdfs:label 'Hipaa Security Risk Id' ;
    rdfs:comment 'Unique identifier for the HIPAA Security Rule risk analysis record. Primary key for the risk register.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:digitalHealthDeviceId rdf:type rdf:Property ;
    rdfs:label 'Digital Health Device Id' ;
    rdfs:comment 'Foreign key linking to digital_health.device. Business justification: HIPAA security risk assessments must enumerate connected patient devices handling ePHI. RPM/IoT devices with firmware vulnerabilities or insecure protocols require individual risk entries linking to t' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Device .

ind:equipmentAssetId rdf:type rdf:Property ;
    rdfs:label 'Equipment Asset Id' ;
    rdfs:comment 'Reference to the specific IT asset, facility, or resource in the asset inventory that is exposed to this risk.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EquipmentAsset .

ind:hipaaEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Hipaa Employee Id' ;
    rdfs:comment 'Reference to the employee or role accountable for managing and monitoring this risk. Typically a department head, system owner, or security officer.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:hipaaPrivacyIncidentId rdf:type rdf:Property ;
    rdfs:label 'Hipaa Privacy Incident Id' ;
    rdfs:comment 'Reference to a security incident or breach event that triggered the identification of this risk, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HipaaPrivacyIncident .

ind:priorHipaaSecurityRiskId rdf:type rdf:Property ;
    rdfs:label 'Prior Hipaa Security Risk Id' ;
    rdfs:comment 'Self-referencing FK on hipaa_security_risk (prior_hipaa_security_risk_id)' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HipaaSecurityRisk .

ind:affectedEphiSystem rdf:type rdf:Property ;
    rdfs:label 'Affected Ephi System' ;
    rdfs:comment 'Name or identifier of the information system, application, or asset that contains or processes ePHI and is subject to this risk. Examples include EHR system, billing system, patient portal, or backup storage.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Closed Timestamp' ;
    rdfs:comment 'System timestamp when this risk was formally closed or resolved, indicating it is no longer an active concern.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:controlEffectiveness rdf:type rdf:Property ;
    rdfs:label 'Control Effectiveness' ;
    rdfs:comment 'Assessment of how well existing controls are functioning to mitigate the risk. Rated as effective, partially effective, ineffective, or not implemented.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:existingControls rdf:type rdf:Property ;
    rdfs:label 'Existing Controls' ;
    rdfs:comment 'Description of current safeguards, policies, procedures, or technical controls already in place that reduce the likelihood or impact of this risk.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identificationMethod rdf:type rdf:Property ;
    rdfs:label 'Identification Method' ;
    rdfs:comment 'Method or source through which the risk was identified, such as vulnerability scan, penetration test, internal audit, external audit, incident investigation, or self-assessment.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifiedDate rdf:type rdf:Property ;
    rdfs:label 'Identified Date' ;
    rdfs:comment 'Date when this risk was first identified and documented in the risk register.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:impactRating rdf:type rdf:Property ;
    rdfs:label 'Impact Rating' ;
    rdfs:comment 'Qualitative assessment of the potential harm or damage if the risk is realized. Considers confidentiality, integrity, and availability impact on ePHI, as well as financial, reputational, and regulatory consequences.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactScore rdf:type rdf:Property ;
    rdfs:label 'Impact Score' ;
    rdfs:comment 'Numeric score representing the magnitude of impact if the risk occurs, typically on a scale of 1-5 or 1-10, used for quantitative risk calculation.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inherentRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Inherent Risk Level' ;
    rdfs:comment 'Overall risk level before considering existing controls, calculated from likelihood and impact. Categorized as critical, high, medium, or low. Represents the raw exposure.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inherentRiskScore rdf:type rdf:Property ;
    rdfs:label 'Inherent Risk Score' ;
    rdfs:comment 'Numeric inherent risk score, typically calculated as likelihood_score multiplied by impact_score, representing the risk exposure before mitigation.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Review Date' ;
    rdfs:comment 'Date when this risk was last reviewed and reassessed by the risk owner or security team.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:likelihoodRating rdf:type rdf:Property ;
    rdfs:label 'Likelihood Rating' ;
    rdfs:comment 'Qualitative assessment of the probability that the threat will exploit the vulnerability. Rated as very low, low, medium, high, or very high based on threat frequency, vulnerability severity, and existing controls.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:likelihoodScore rdf:type rdf:Property ;
    rdfs:label 'Likelihood Score' ;
    rdfs:comment 'Numeric score representing the likelihood of occurrence, typically on a scale of 1-5 or 1-10, used for quantitative risk calculation.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mitigationActualCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Mitigation Actual Completion Date' ;
    rdfs:comment 'Actual date when mitigation controls were fully implemented and verified as operational.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mitigationControlsImplemented rdf:type rdf:Property ;
    rdfs:label 'Mitigation Controls Implemented' ;
    rdfs:comment 'List or description of new safeguards, policies, procedures, or technical controls that have been implemented to mitigate this risk.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationPlan rdf:type rdf:Property ;
    rdfs:label 'Mitigation Plan' ;
    rdfs:comment 'Detailed description of the action plan to reduce the risk, including specific controls to be implemented, responsible parties, and timelines.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationStartDate rdf:type rdf:Property ;
    rdfs:label 'Mitigation Start Date' ;
    rdfs:comment 'Date when mitigation activities began or are scheduled to begin.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mitigationTargetCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Mitigation Target Completion Date' ;
    rdfs:comment 'Planned or target date by which mitigation controls should be fully implemented and operational.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryCitation rdf:type rdf:Property ;
    rdfs:label 'Regulatory Citation' ;
    rdfs:comment 'Specific HIPAA Security Rule section or other regulatory requirement that this risk relates to, such as §164.308(a)(3) for workforce security or §164.312(a)(1) for access control.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Residual Risk Level' ;
    rdfs:comment 'Overall risk level after considering existing and planned mitigation controls. Categorized as critical, high, medium, or low. Represents the remaining exposure after treatment.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualRiskScore rdf:type rdf:Property ;
    rdfs:label 'Residual Risk Score' ;
    rdfs:comment 'Numeric residual risk score after mitigation, calculated from adjusted likelihood and impact scores, representing the remaining risk exposure.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskAcceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Risk Acceptance Date' ;
    rdfs:comment 'Date when the risk acceptance decision was formally approved by management.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskAcceptanceJustification rdf:type rdf:Property ;
    rdfs:label 'Risk Acceptance Justification' ;
    rdfs:comment 'Business rationale and approval documentation for accepting a risk without further mitigation, including cost-benefit analysis and management sign-off.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAssessmentCycleCode rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Cycle Code' ;
    rdfs:comment 'Reference to the annual or periodic risk assessment cycle during which this risk was identified. Links to the broader compliance assessment program.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskCategory rdf:type rdf:Property ;
    rdfs:label 'Risk Category' ;
    rdfs:comment 'High-level classification of the risk aligned with HIPAA Security Rule safeguard categories: administrative, physical, technical, or organizational.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskNumber rdf:type rdf:Property ;
    rdfs:label 'Risk Number' ;
    rdfs:comment 'Business-facing unique identifier for the risk, typically formatted as a human-readable code (e.g., RISK-2024-001) for tracking and reporting purposes.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskOwnerDepartment rdf:type rdf:Property ;
    rdfs:label 'Risk Owner Department' ;
    rdfs:comment 'Department or business unit responsible for managing this risk, such as IT, Compliance, Clinical Operations, or Health Information Management (HIM).' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskStatus rdf:type rdf:Property ;
    rdfs:label 'Risk Status' ;
    rdfs:comment 'Current lifecycle status of the risk: open (newly identified), in progress (mitigation underway), mitigated (controls implemented), accepted (risk tolerance decision made), or closed (risk no longer applicable).' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskSubcategory rdf:type rdf:Property ;
    rdfs:label 'Risk Subcategory' ;
    rdfs:comment 'Detailed classification of the risk within the category, such as access control, encryption, workforce security, or facility access.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskTitle rdf:type rdf:Property ;
    rdfs:label 'Risk Title' ;
    rdfs:comment 'Short descriptive title of the identified risk, summarizing the threat or vulnerability in business terms.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskTreatmentDecision rdf:type rdf:Property ;
    rdfs:label 'Risk Treatment Decision' ;
    rdfs:comment 'Strategic decision on how to address the risk: accept (tolerate the risk), mitigate (implement controls to reduce risk), transfer (shift risk via insurance or contract), or avoid (eliminate the activity causing the risk).' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threatDescription rdf:type rdf:Property ;
    rdfs:label 'Threat Description' ;
    rdfs:comment 'Detailed description of the threat agent or event that could exploit the vulnerability and cause harm to ePHI (Electronic Protected Health Information). Examples include malware, unauthorized access, natural disaster, or insider threat.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vulnerabilityDescription rdf:type rdf:Property ;
    rdfs:label 'Vulnerability Description' ;
    rdfs:comment 'Detailed description of the weakness or gap in controls that could be exploited by the threat. Examples include unpatched systems, weak passwords, lack of encryption, or inadequate physical security.' ;
    rdfs:domain ind:HipaaSecurityRisk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingId rdf:type rdf:Property ;
    rdfs:label 'Training Id' ;
    rdfs:comment 'Unique identifier for the compliance training program. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Training .

ind:costCenterId rdf:type rdf:Property ;
    rdfs:label 'Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Training programs are delivered by specific departments and funded through their cost centers. Training costs (development, delivery, vendor fees) must be allocated for financial tracking, budget mana' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:icdCodeId rdf:type rdf:Property ;
    rdfs:label 'Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: Compliance training modules focus on specific high-risk or frequently misused diagnosis codes (sepsis, MI, diabetes with complications), requiring direct code references for targeted coder education.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:prerequisiteTrainingId rdf:type rdf:Property ;
    rdfs:label 'Prerequisite Training Id' ;
    rdfs:comment 'Self-referencing FK on training (prerequisite_training_id)' ;
    rdfs:domain ind:Training ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Training .

ind:accreditationBody rdf:type rdf:Property ;
    rdfs:label 'Accreditation Body' ;
    rdfs:comment 'Organization that has accredited or certified this training program. Examples: ANCC, AMA, AAFP. Null if not accredited.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationNumber rdf:type rdf:Property ;
    rdfs:label 'Accreditation Number' ;
    rdfs:comment 'Unique accreditation or certification number assigned by the accrediting body. Used for external reporting and audit.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Assessment Required Flag' ;
    rdfs:comment 'Indicates whether the training includes a graded assessment that must be passed for completion. True if assessment is required, False if completion is based on participation only.' ;
    rdfs:domain ind:Training ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attestationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Attestation Required Flag' ;
    rdfs:comment 'Indicates whether the learner must sign an attestation statement acknowledging understanding and commitment to comply. Common for Code of Conduct and policy-based training.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateIssuedFlag rdf:type rdf:Property ;
    rdfs:label 'Certificate Issued Flag' ;
    rdfs:comment 'Indicates whether a completion certificate is issued upon successful completion of the training. True if certificate is generated, False otherwise.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contentAuthor rdf:type rdf:Property ;
    rdfs:label 'Content Author' ;
    rdfs:comment 'Name of the individual or team who developed the training content.' ;
    rdfs:domain ind:Training ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentLocationUrl rdf:type rdf:Property ;
    rdfs:label 'Content Location Url' ;
    rdfs:comment 'URL or file path where the training content is hosted. Used by learning management systems to launch the training.' ;
    rdfs:domain ind:Training ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentOwner rdf:type rdf:Property ;
    rdfs:label 'Content Owner' ;
    rdfs:comment 'Department or role responsible for maintaining the training content and ensuring accuracy and regulatory alignment. Examples: Compliance Department, Infection Prevention, Human Resources.' ;
    rdfs:domain ind:Training ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationThresholdDays rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold Days' ;
    rdfs:comment 'Number of days past the due date after which non-completion triggers an escalation to management. Used for compliance enforcement.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:format rdf:type rdf:Property ;
    rdfs:label 'Format' ;
    rdfs:comment 'Delivery method for the training program. Determines how learners access and complete the training. [ENUM-REF-CANDIDATE: Online|In-Person|Blended|Simulation|On-the-Job|Self-Study|Webinar|Video — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequency rdf:type rdf:Property ;
    rdfs:label 'Frequency' ;
    rdfs:comment 'How often the training must be completed to maintain compliance. Drives recurrence scheduling and assignment logic. [ENUM-REF-CANDIDATE: Annual|Biennial|One-Time|Upon Hire|Upon Role Change|Quarterly|As Needed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Frequency Months' ;
    rdfs:comment 'Numeric representation of training recurrence interval in months. Used for automated scheduling. Examples: 12 for annual, 24 for biennial, null for one-time.' ;
    rdfs:domain ind:Training ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:keywords rdf:type rdf:Property ;
    rdfs:label 'Keywords' ;
    rdfs:comment 'Comma-separated list of keywords and tags used for training catalog search and discovery.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:learningObjectives rdf:type rdf:Property ;
    rdfs:label 'Learning Objectives' ;
    rdfs:comment 'Summary of the key learning outcomes and competencies the training is designed to achieve. Used for curriculum mapping and competency tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonComplianceConsequence rdf:type rdf:Property ;
    rdfs:label 'Non Compliance Consequence' ;
    rdfs:comment 'Description of the organizational consequence for failing to complete required training. Examples: Loss of system access, disciplinary action, termination.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passingScoreThreshold rdf:type rdf:Property ;
    rdfs:label 'Passing Score Threshold' ;
    rdfs:comment 'Minimum score required to successfully complete the training, expressed as a percentage (0.00 to 100.00). Null if no assessment is required.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyReference rdf:type rdf:Property ;
    rdfs:label 'Policy Reference' ;
    rdfs:comment 'Reference to the organizational policy or policies that this training supports. Links training to the governance framework.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityLevel rdf:type rdf:Property ;
    rdfs:label 'Priority Level' ;
    rdfs:comment 'Business priority assigned to this training program. Critical and High priority training may trigger escalation workflows for non-completion.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAuthority rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority' ;
    rdfs:comment 'The governing body or agency that mandates this training requirement. Examples: HHS Office for Civil Rights, OSHA, CMS, The Joint Commission, State Department of Health.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryMandate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Mandate' ;
    rdfs:comment 'The specific regulation, statute, or accreditation standard that requires this training. Examples: HIPAA Privacy Rule 45 CFR 164.530(b), OSHA 29 CFR 1910.1030, Joint Commission HR.01.06.01.' ;
    rdfs:domain ind:Training ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retiredReason rdf:type rdf:Property ;
    rdfs:label 'Retired Reason' ;
    rdfs:comment 'Explanation for why the training program was retired. Examples: Superseded by new version, Regulatory requirement removed, Content no longer relevant.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retiredTimestamp rdf:type rdf:Property ;
    rdfs:label 'Retired Timestamp' ;
    rdfs:comment 'Timestamp when this training program was retired and removed from active use. Null if the training is still active or suspended.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reviewCycleMonths rdf:type rdf:Property ;
    rdfs:label 'Review Cycle Months' ;
    rdfs:comment 'Frequency in months at which the training content must be reviewed for accuracy and regulatory alignment. Examples: 12, 24, 36.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersedesTrainingNumber rdf:type rdf:Property ;
    rdfs:label 'Supersedes Training Number' ;
    rdfs:comment 'Training program number that this version replaces. Used to track training evolution and ensure learners complete the most current version.' ;
    rdfs:domain ind:Training ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetAudience rdf:type rdf:Property ;
    rdfs:label 'Target Audience' ;
    rdfs:comment 'Description of the workforce population required to complete this training. May specify roles, departments, or all staff. Examples: All Staff, Clinical Staff, Physicians, Nurses, Environmental Services, IT Staff, Revenue Cycle Staff.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDepartment rdf:type rdf:Property ;
    rdfs:label 'Target Department' ;
    rdfs:comment 'Specific department or service line required to complete this training. Used for automated assignment rules.' ;
    rdfs:domain ind:Training ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetRole rdf:type rdf:Property ;
    rdfs:label 'Target Role' ;
    rdfs:comment 'Specific job role or role category required to complete this training. Used for automated assignment rules.' ;
    rdfs:domain ind:Training ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingDescription rdf:type rdf:Property ;
    rdfs:label 'Training Description' ;
    rdfs:comment 'Detailed description of the training program content, scope, and purpose. Displayed to learners and used for catalog search.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingName rdf:type rdf:Property ;
    rdfs:label 'Training Name' ;
    rdfs:comment 'Full name of the compliance training program as displayed to learners and in catalogs.' ;
    rdfs:domain ind:Training ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingNumber rdf:type rdf:Property ;
    rdfs:label 'Training Number' ;
    rdfs:comment 'Business identifier for the training program, used for external reference and reporting. Typically follows format TRN-XXXXXX.' ;
    rdfs:domain ind:Training ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingStatus rdf:type rdf:Property ;
    rdfs:label 'Training Status' ;
    rdfs:comment 'Current lifecycle status of the training program. Active programs are available for assignment and completion.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingType rdf:type rdf:Property ;
    rdfs:label 'Training Type' ;
    rdfs:comment 'Category of compliance training program. Defines the subject matter and regulatory domain covered by the training. [ENUM-REF-CANDIDATE: HIPAA Privacy|HIPAA Security|Corporate Compliance|OSHA Bloodborne Pathogens|Fire Safety|Abuse and Neglect|Cultural Competency|Code of Conduct|Emergency Preparedness|Infection Control|Patient Rights|Workplace Violence Prevention|Hazardous Materials|Radiation Safety|Respiratory Protection|Other — 16 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorCourseCode rdf:type rdf:Property ;
    rdfs:label 'Vendor Course Code' ;
    rdfs:comment 'Unique identifier assigned by the external vendor for this training course. Used for integration and reporting with vendor learning management systems.' ;
    rdfs:domain ind:Training ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingCompletionId rdf:type rdf:Property ;
    rdfs:label 'Training Completion Id' ;
    rdfs:comment 'Unique identifier for the training completion record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrainingCompletion .

ind:reattemptedTrainingCompletionId rdf:type rdf:Property ;
    rdfs:label 'Reattempted Training Completion Id' ;
    rdfs:comment 'Self-referencing FK on training_completion (reattempted_training_completion_id)' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TrainingCompletion .

ind:assignedDate rdf:type rdf:Property ;
    rdfs:label 'Assigned Date' ;
    rdfs:comment 'Date when the training program was assigned to the employee. Marks the start of the compliance obligation period.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attemptNumber rdf:type rdf:Property ;
    rdfs:label 'Attempt Number' ;
    rdfs:comment 'Sequential attempt number for this training completion. Increments when an employee retakes a failed training.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificateIssuedDate rdf:type rdf:Property ;
    rdfs:label 'Certificate Issued Date' ;
    rdfs:comment 'Date when the training certificate was officially issued. May differ from completion date for trainings requiring manual review or approval.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificateNumber rdf:type rdf:Property ;
    rdfs:label 'Certificate Number' ;
    rdfs:comment 'Unique certificate or credential number issued upon successful completion. Used for external verification and audit documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionDate rdf:type rdf:Property ;
    rdfs:label 'Completion Date' ;
    rdfs:comment 'Date when the employee successfully completed the training program. Null if training is not yet completed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:completionNumber rdf:type rdf:Property ;
    rdfs:label 'Completion Number' ;
    rdfs:comment 'Business identifier for this training completion event. May be used for certificate tracking and audit trails.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionStatus rdf:type rdf:Property ;
    rdfs:label 'Completion Status' ;
    rdfs:comment 'Current lifecycle status of the training completion record. Tracks progression from assignment through completion or expiration. [ENUM-REF-CANDIDATE: assigned|in_progress|completed|overdue|waived|expired|not_started — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Completion Timestamp' ;
    rdfs:comment 'Precise timestamp when the training was marked complete in the Learning Management System (LMS). Used for audit trail and time-sensitive compliance verification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:continuingEducationCredits rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Credits' ;
    rdfs:comment 'Number of Continuing Education (CE) or Continuing Medical Education (CME) credits awarded for this training completion. Used for professional licensure maintenance.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditType rdf:type rdf:Property ;
    rdfs:label 'Credit Type' ;
    rdfs:comment 'Type of continuing education credit awarded. CME (Continuing Medical Education) for physicians, CEU (Continuing Education Unit) for general staff, CNE (Continuing Nursing Education) for nurses, or contact hours.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'Date by which the training must be completed to maintain compliance. Used for overdue tracking and escalation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employeeDepartment rdf:type rdf:Property ;
    rdfs:label 'Employee Department' ;
    rdfs:comment 'Department or organizational unit of the employee at the time of training completion. Captured for compliance reporting by department.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeFacility rdf:type rdf:Property ;
    rdfs:label 'Employee Facility' ;
    rdfs:comment 'Healthcare facility or location where the employee is assigned. Used for facility-level compliance reporting and Joint Commission readiness.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeRole rdf:type rdf:Property ;
    rdfs:label 'Employee Role' ;
    rdfs:comment 'Job role or title of the employee at the time of training completion. Used for role-based compliance reporting and gap analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instructorName rdf:type rdf:Property ;
    rdfs:label 'Instructor Name' ;
    rdfs:comment 'Name of the instructor or facilitator who delivered the training. Applicable for in-person and instructor-led sessions.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReminderSentDate rdf:type rdf:Property ;
    rdfs:label 'Last Reminder Sent Date' ;
    rdfs:comment 'Date when the most recent reminder notification was sent to the employee. Used for escalation timing and communication tracking.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:passFailStatus rdf:type rdf:Property ;
    rdfs:label 'Pass Fail Status' ;
    rdfs:comment 'Indicates whether the employee passed or failed the training assessment. Not applicable for trainings without assessments.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementSatisfied rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Satisfied' ;
    rdfs:comment 'Citation or reference to the specific regulatory requirement satisfied by this training completion. Examples include HIPAA Privacy Rule, OSHA Bloodborne Pathogens Standard, Joint Commission standards.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reminderSentCount rdf:type rdf:Property ;
    rdfs:label 'Reminder Sent Count' ;
    rdfs:comment 'Number of reminder notifications sent to the employee for this training assignment. Used for tracking engagement and escalation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scoreAchieved rdf:type rdf:Property ;
    rdfs:label 'Score Achieved' ;
    rdfs:comment 'Numeric score or percentage achieved by the employee on the training assessment. Null if training does not include a scored assessment.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trainingDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Training Duration Minutes' ;
    rdfs:comment 'Total time in minutes the employee spent completing the training. Captured from Learning Management System (LMS) tracking data.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingLocation rdf:type rdf:Property ;
    rdfs:label 'Training Location' ;
    rdfs:comment 'Physical or virtual location where the training was conducted. May be a facility name, room number, or online platform identifier.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingMethod rdf:type rdf:Property ;
    rdfs:label 'Training Method' ;
    rdfs:comment 'Method by which the training was delivered to the employee. Used for effectiveness analysis and compliance documentation.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Approval Date' ;
    rdfs:comment 'Date when the training waiver was officially approved. Part of the compliance audit trail.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Waiver Approved By' ;
    rdfs:comment 'Name or identifier of the authority who approved the training waiver. Required for audit trail when waiver is granted.' ;
    rdfs:domain ind:TrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Flag' ;
    rdfs:comment 'Indicates whether the training requirement was waived for this employee. True if waived, False otherwise.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceRegulatorySubmissionId rdf:type rdf:Property ;
    rdfs:label 'Compliance Regulatory Submission Id' ;
    rdfs:comment 'Unique identifier for the regulatory submission record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceRegulatorySubmission .

ind:chartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Chart Of Accounts Id' ;
    rdfs:comment 'Foreign key linking to finance.chart_of_accounts. Business justification: Regulatory submissions with penalties or fees must post to specific GL accounts. Currently has penalty_currency_code but no GL account FK. Enables proper financial recording of regulatory penalties, s' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:codeSetVersionId rdf:type rdf:Property ;
    rdfs:label 'Code Set Version Id' ;
    rdfs:comment 'Foreign key linking to reference.code_set_version. Business justification: Regulatory submissions (CMS quality reporting, state claims data, HEDIS) must document which ICD/CPT/HCPCS code set versions were used for the reporting period, required for data validation and audit ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CodeSetVersion .

ind:obligationId rdf:type rdf:Property ;
    rdfs:label 'Obligation Id' ;
    rdfs:comment 'Identifier linking this submission to the specific regulatory requirement or obligation it satisfies.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Obligation .

ind:originalComplianceRegulatorySubmissionId rdf:type rdf:Property ;
    rdfs:label 'Original Compliance Regulatory Submission Id' ;
    rdfs:comment 'Identifier of the original submission record if this is a resubmission or correction. Links to the prior submission that was rejected or withdrawn.' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceRegulatorySubmission .

ind:publicHealthReportId rdf:type rdf:Property ;
    rdfs:label 'Public Health Report Id' ;
    rdfs:comment 'Foreign key linking to interoperability.public_health_report. Business justification: Many regulatory submissions to CMS, CDC, and state agencies are transmitted via public health reporting interfaces. Linking submissions to their transmission records enables tracking of submission sta' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PublicHealthReport .

ind:regulatoryChangeId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Change Id' ;
    rdfs:comment 'Foreign key linking to compliance.regulatory_change. Business justification: Regulatory submissions may be triggered by new regulatory changes (e.g., new CMS reporting requirement). Each submission should optionally link to the regulatory change that triggered it. This allows ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryChange .

ind:acknowledgmentNumber rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Number' ;
    rdfs:comment 'Confirmation or tracking number provided by the receiving agency upon acknowledgment of the submission.' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgmentReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Received Flag' ;
    rdfs:comment 'Indicates whether the receiving agency has acknowledged receipt of the submission. True = acknowledgment received, False = no acknowledgment received.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attestationDate rdf:type rdf:Property ;
    rdfs:label 'Attestation Date' ;
    rdfs:comment 'Date on which the authorized officer attested to the accuracy and completeness of the submission.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attestationOfficerName rdf:type rdf:Property ;
    rdfs:label 'Attestation Officer Name' ;
    rdfs:comment 'Name of the authorized officer (e.g., Chief Executive Officer, Chief Compliance Officer, Chief Medical Officer) who attested to the submission.' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditDate rdf:type rdf:Property ;
    rdfs:label 'Audit Date' ;
    rdfs:comment 'Date on which the external audit or validation of the submission was conducted.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditResult rdf:type rdf:Property ;
    rdfs:label 'Audit Result' ;
    rdfs:comment 'Outcome of the external audit or validation. PASSED = submission validated as accurate, FAILED = submission found to be inaccurate or non-compliant, CONDITIONAL = passed with conditions or corrective actions required, PENDING = audit in progress, NOT_AUDITED = no audit conducted.' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionDueDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Due Date' ;
    rdfs:comment 'Deadline by which corrective actions must be completed and documented in response to audit findings or agency feedback.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Required Flag' ;
    rdfs:comment 'Indicates whether corrective actions are required as a result of audit findings or agency feedback. True = corrective action required, False = no corrective action required.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentLocationUrl rdf:type rdf:Property ;
    rdfs:label 'Document Location Url' ;
    rdfs:comment 'File path, URL, or document management system reference where the submitted regulatory report or supporting documentation is stored.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalAuditFlag rdf:type rdf:Property ;
    rdfs:label 'External Audit Flag' ;
    rdfs:comment 'Indicates whether this submission is subject to external audit or validation by the regulatory agency or third-party auditor. True = subject to external audit, False = not subject to external audit.' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount' ;
    rdfs:comment 'Monetary penalty assessed by the regulatory agency for late, incomplete, or non-compliant submission, in US dollars.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Penalty Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the penalty amount (e.g., USD for US dollars).' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingAgency rdf:type rdf:Property ;
    rdfs:label 'Receiving Agency' ;
    rdfs:comment 'Name of the government agency, accrediting body, or regulatory authority receiving the submission (e.g., CMS, State Department of Health, OSHA, OCR, Joint Commission, CDC).' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingAgencyCode rdf:type rdf:Property ;
    rdfs:label 'Receiving Agency Code' ;
    rdfs:comment 'Standardized code or abbreviation for the receiving regulatory agency (e.g., CMS, OCR, OSHA, TJC, CDC).' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End Date' ;
    rdfs:comment 'End date of the time period covered by the regulatory submission.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start Date' ;
    rdfs:comment 'Start date of the time period covered by the regulatory submission (e.g., calendar quarter, fiscal year, annual period).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resubmissionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Resubmission Required Flag' ;
    rdfs:comment 'Indicates whether the submission must be corrected and resubmitted. True = resubmission required, False = no resubmission required.' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskLevel rdf:type rdf:Property ;
    rdfs:label 'Risk Level' ;
    rdfs:comment 'Assessment of the compliance risk associated with this submission, including potential penalties for non-compliance or late filing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDocumentTitle rdf:type rdf:Property ;
    rdfs:label 'Submission Document Title' ;
    rdfs:comment 'description' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionFormat rdf:type rdf:Property ;
    rdfs:label 'Submission Format' ;
    rdfs:comment 'Data format or file type of the regulatory submission. XML = Extensible Markup Language, JSON = JavaScript Object Notation, CSV = comma-separated values, PDF = Portable Document Format, HL7_V2 = Health Level Seven Version 2 message, FHIR = Fast Healthcare Interoperability Resources. [ENUM-REF-CANDIDATE: XML|JSON|CSV|PDF|HL7_V2|FHIR|PAPER|OTHER — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionPriority rdf:type rdf:Property ;
    rdfs:label 'Submission Priority' ;
    rdfs:comment 'Priority level assigned to the regulatory submission based on urgency, risk, or regulatory importance. CRITICAL = immediate action required, HIGH = high importance, MEDIUM = standard priority, LOW = routine submission.' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittingEntityName rdf:type rdf:Property ;
    rdfs:label 'Submitting Entity Name' ;
    rdfs:comment 'Legal or business name of the healthcare facility or organizational unit submitting the report.' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submittingEntityNpi rdf:type rdf:Property ;
    rdfs:label 'Submitting Entity Npi' ;
    rdfs:comment 'Ten-digit National Provider Identifier (NPI) of the submitting healthcare organization, as assigned by CMS.' ;
    rdfs:domain ind:ComplianceRegulatorySubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionScreeningId rdf:type rdf:Property ;
    rdfs:label 'Exclusion Screening Id' ;
    rdfs:comment 'Unique identifier for the exclusion screening record.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorExclusionScreeningId rdf:type rdf:Property ;
    rdfs:label 'Prior Exclusion Screening Id' ;
    rdfs:comment 'Self-referencing FK on exclusion_screening (prior_exclusion_screening_id)' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExclusionScreening .

ind:referenceNpiRegistryId rdf:type rdf:Property ;
    rdfs:label 'Reference Npi Registry Id' ;
    rdfs:comment 'Foreign key linking to reference.npi_registry. Business justification: Exclusion screening validates NPIs against the national registry to ensure screened providers are correctly identified (name, address, taxonomy) before checking OIG/SAM exclusion databases for complia' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NpiRegistry .

ind:screenedPayerId rdf:type rdf:Property ;
    rdfs:label 'Screened Payer Id' ;
    rdfs:comment 'Foreign key linking to insurance.payer. Business justification: Healthcare organizations must screen payers and health plans for OIG/SAM exclusions to ensure they are not contracting with excluded entities. This is a regulatory requirement for federal program part' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:auditTrail rdf:type rdf:Property ;
    rdfs:label 'Audit Trail' ;
    rdfs:comment 'Comprehensive audit trail documenting all actions, reviews, and decisions related to this screening record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionAuthority rdf:type rdf:Property ;
    rdfs:label 'Exclusion Authority' ;
    rdfs:comment 'Government agency or authority that imposed the exclusion (e.g., OIG, GSA, State Medicaid).' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionDate rdf:type rdf:Property ;
    rdfs:label 'Exclusion Date' ;
    rdfs:comment 'Date when the exclusion was imposed by the regulatory authority.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusionType rdf:type rdf:Property ;
    rdfs:label 'Exclusion Type' ;
    rdfs:comment 'Type or category of exclusion found (e.g., mandatory, permissive, conviction-related, license revocation).' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionWaiverState rdf:type rdf:Property ;
    rdfs:label 'Exclusion Waiver State' ;
    rdfs:comment 'Two-letter state code where a waiver from the exclusion may apply, if applicable.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchDetails rdf:type rdf:Property ;
    rdfs:label 'Match Details' ;
    rdfs:comment 'Detailed information about the exclusion match found, including name matched, identifier matched, and exclusion reason.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchFoundFlag rdf:type rdf:Property ;
    rdfs:label 'Match Found Flag' ;
    rdfs:comment 'Boolean indicator of whether a match was found on any exclusion list during screening.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextScreeningDate rdf:type rdf:Property ;
    rdfs:label 'Next Screening Date' ;
    rdfs:comment 'Scheduled date for the next exclusion screening check for this individual or entity.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinstatementDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Date' ;
    rdfs:comment 'Date when the excluded individual or entity is eligible for reinstatement to federal healthcare programs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionAction rdf:type rdf:Property ;
    rdfs:label 'Resolution Action' ;
    rdfs:comment 'Action taken in response to the screening result (e.g., employment terminated, contract cancelled, credentialing denied, further investigation required).' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screenedBusinessName rdf:type rdf:Property ;
    rdfs:label 'Screened Business Name' ;
    rdfs:comment 'Legal business name of the vendor or organization being screened.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screenedDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Screened Date Of Birth' ;
    rdfs:comment 'Date of birth of the individual being screened, used for identity verification and matching.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:screenedEntityType rdf:type rdf:Property ;
    rdfs:label 'Screened Entity Type' ;
    rdfs:comment 'Type of entity being screened for exclusion status (employee, contractor, vendor, medical staff, volunteer, or board member).' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screenedFirstName rdf:type rdf:Property ;
    rdfs:label 'Screened First Name' ;
    rdfs:comment 'First name of the individual being screened for exclusion status.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screenedLastName rdf:type rdf:Property ;
    rdfs:label 'Screened Last Name' ;
    rdfs:comment 'Last name of the individual being screened for exclusion status.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screenedMiddleName rdf:type rdf:Property ;
    rdfs:label 'Screened Middle Name' ;
    rdfs:comment 'Middle name or initial of the individual being screened.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screenedSsn rdf:type rdf:Property ;
    rdfs:label 'Screened Ssn' ;
    rdfs:comment 'Social Security Number of the individual being screened, used for matching against exclusion lists.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screenedState rdf:type rdf:Property ;
    rdfs:label 'Screened State' ;
    rdfs:comment 'Two-letter state code where the screened individual or business is located or licensed.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningDate rdf:type rdf:Property ;
    rdfs:label 'Screening Date' ;
    rdfs:comment 'Date when the exclusion screening check was performed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:screeningFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Screening Frequency Months' ;
    rdfs:comment 'Number of months between required exclusion screening checks for this entity type.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:screeningMethod rdf:type rdf:Property ;
    rdfs:label 'Screening Method' ;
    rdfs:comment 'Method used to perform the exclusion screening (automated system, manual search, or third-party vendor service).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningResult rdf:type rdf:Property ;
    rdfs:label 'Screening Result' ;
    rdfs:comment 'Outcome of the exclusion screening check indicating whether the entity is clear, a match was found, result is inconclusive, or an error occurred.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningSource rdf:type rdf:Property ;
    rdfs:label 'Screening Source' ;
    rdfs:comment 'Source database used for the exclusion screening check (OIG LEIE, SAM.gov, state Medicaid exclusion list, or combined search).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningTransactionNumber rdf:type rdf:Property ;
    rdfs:label 'Screening Transaction Number' ;
    rdfs:comment 'Unique transaction identifier from the screening vendor or system for audit trail purposes.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningVendorName rdf:type rdf:Property ;
    rdfs:label 'Screening Vendor Name' ;
    rdfs:comment 'Name of the third-party vendor or service used to perform the exclusion screening, if applicable.' ;
    rdfs:domain ind:ExclusionScreening ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictOfInterestId rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Id' ;
    rdfs:comment 'Unique identifier for the conflict of interest disclosure record.' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:conflictEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Conflict Employee Id' ;
    rdfs:comment 'Identifier of the employee, medical staff member, board member, or contractor submitting the disclosure.' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:priorConflictOfInterestId rdf:type rdf:Property ;
    rdfs:label 'Prior Conflict Of Interest Id' ;
    rdfs:comment 'Self-referencing FK on conflict_of_interest (prior_conflict_of_interest_id)' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConflictOfInterest .

ind:reviewerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Reviewer Employee Id' ;
    rdfs:comment 'Identifier of the compliance officer or committee member who reviewed the disclosure.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:attestationStatement rdf:type rdf:Property ;
    rdfs:label 'Attestation Statement' ;
    rdfs:comment 'Text of the attestation statement signed by the disclosing individual affirming the accuracy and completeness of the disclosure.' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrailNotes rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Notes' ;
    rdfs:comment 'Free-text notes capturing key events, decisions, and communications throughout the disclosure lifecycle for audit and compliance tracking purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityLevel rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Level' ;
    rdfs:comment 'Data classification level for the disclosure record: restricted (highest sensitivity), confidential (business-sensitive), or internal (standard operational data).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosedEntityName rdf:type rdf:Property ;
    rdfs:label 'Disclosed Entity Name' ;
    rdfs:comment 'Name of the external organization, vendor, research sponsor, or individual with whom the conflict of interest relationship exists.' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosedEntityType rdf:type rdf:Property ;
    rdfs:label 'Disclosed Entity Type' ;
    rdfs:comment 'Classification of the disclosed entity: vendor, supplier, competitor, research sponsor, pharmaceutical company, device manufacturer, consulting firm, healthcare provider, or other. [ENUM-REF-CANDIDATE: vendor|supplier|competitor|research_sponsor|pharmaceutical_company|device_manufacturer|consulting_firm|healthcare_provider|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosingIndividualRole rdf:type rdf:Property ;
    rdfs:label 'Disclosing Individual Role' ;
    rdfs:comment 'Role or affiliation of the individual submitting the disclosure: employee, medical staff, board member, contractor, volunteer, or vendor representative.' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureNumber rdf:type rdf:Property ;
    rdfs:label 'Disclosure Number' ;
    rdfs:comment 'Externally-known unique business identifier for the conflict of interest disclosure.' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureType rdf:type rdf:Property ;
    rdfs:label 'Disclosure Type' ;
    rdfs:comment 'Type of disclosure submission: initial disclosure, annual recertification, material change update, or ad-hoc disclosure.' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedValueAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Value Amount' ;
    rdfs:comment 'Estimated monetary value of the financial interest or relationship in US dollars.' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastRecertificationDate rdf:type rdf:Property ;
    rdfs:label 'Last Recertification Date' ;
    rdfs:comment 'Date of the most recent annual recertification submission for this conflict of interest.' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mitigationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Mitigation Effective Date' ;
    rdfs:comment 'Date when the mitigation plan became effective and enforceable.' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mitigationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Mitigation Required Flag' ;
    rdfs:comment 'Indicates whether a mitigation plan is required to manage the conflict of interest (True) or not (False).' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recertificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Recertification Due Date' ;
    rdfs:comment 'Date by which the individual must submit an annual recertification or update of the conflict of interest disclosure.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryRequirementReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Reference' ;
    rdfs:comment 'Citation of the specific regulatory requirement or compliance program element that mandates this disclosure, such as Stark Law, Anti-Kickback Statute, or OIG guidance.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipDescription rdf:type rdf:Property ;
    rdfs:label 'Relationship Description' ;
    rdfs:comment 'Detailed narrative description of the nature of the conflict of interest relationship, including roles, responsibilities, and interactions.' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipType rdf:type rdf:Property ;
    rdfs:label 'Relationship Type' ;
    rdfs:comment 'Category of the conflict of interest relationship being disclosed: financial interest, outside employment, family relationship with vendor or employee, vendor relationship, research sponsorship, or consulting arrangement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewStartDate rdf:type rdf:Property ;
    rdfs:label 'Review Start Date' ;
    rdfs:comment 'Date when the compliance review of the disclosure began.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supportingDocumentationUrl rdf:type rdf:Property ;
    rdfs:label 'Supporting Documentation Url' ;
    rdfs:comment 'URL or file path to supporting documentation provided with the disclosure, such as contracts, financial statements, or correspondence.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueRange rdf:type rdf:Property ;
    rdfs:label 'Value Range' ;
    rdfs:comment 'Categorical range of the estimated value: under $5,000, $5,000 to $25,000, $25,000 to $100,000, over $100,000, or not applicable for non-financial relationships.' ;
    rdfs:domain ind:ConflictOfInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hotlineReportId rdf:type rdf:Property ;
    rdfs:label 'Hotline Report Id' ;
    rdfs:comment 'Unique identifier for the compliance hotline report. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HotlineReport .

ind:hotlineEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Hotline Employee Id' ;
    rdfs:comment 'Employee identifier of the reporter if they are an internal employee. Null if external reporter or anonymous.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:originalHotlineReportId rdf:type rdf:Property ;
    rdfs:label 'Original Hotline Report Id' ;
    rdfs:comment 'Self-referencing FK on hotline_report (original_hotline_report_id)' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HotlineReport .

ind:allegationCategory rdf:type rdf:Property ;
    rdfs:label 'Allegation Category' ;
    rdfs:comment 'Primary category of the compliance concern or ethics violation alleged: billing fraud, privacy violation, workplace safety, abuse/neglect, conflict of interest, retaliation, or code of conduct violation. [ENUM-REF-CANDIDATE: billing_fraud|privacy_violation|workplace_safety|abuse_neglect|conflict_of_interest|retaliation|code_of_conduct|discrimination|harassment|data_breach|regulatory_violation|quality_of_care|environmental_safety — promote to reference product]' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allegationDescription rdf:type rdf:Property ;
    rdfs:label 'Allegation Description' ;
    rdfs:comment 'Detailed narrative description of the compliance concern, potential violation, or ethics issue as reported by the submitter.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allegationSubcategory rdf:type rdf:Property ;
    rdfs:label 'Allegation Subcategory' ;
    rdfs:comment 'More specific classification of the allegation within the primary category, providing additional detail on the nature of the concern.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedInvestigatorName rdf:type rdf:Property ;
    rdfs:label 'Assigned Investigator Name' ;
    rdfs:comment 'Name of the compliance officer or investigator assigned to this case.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseNotes rdf:type rdf:Property ;
    rdfs:label 'Case Notes' ;
    rdfs:comment 'Internal notes and documentation maintained by the compliance team throughout the investigation lifecycle.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Completion Date' ;
    rdfs:comment 'Actual date when all required corrective actions were completed and verified.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionDescription rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Description' ;
    rdfs:comment 'Description of the corrective actions taken or planned in response to substantiated compliance concerns.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentImplicated rdf:type rdf:Property ;
    rdfs:label 'Department Implicated' ;
    rdfs:comment 'Name or code of the department or unit where the alleged compliance concern occurred.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposition rdf:type rdf:Property ;
    rdfs:label 'Disposition' ;
    rdfs:comment 'Final determination of the investigation: substantiated (violation confirmed), unsubstantiated (no violation found), inconclusive (insufficient evidence), or pending (investigation ongoing).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionNotes rdf:type rdf:Property ;
    rdfs:label 'Disposition Notes' ;
    rdfs:comment 'Detailed explanation of the investigation findings, rationale for the disposition, and any supporting evidence or context.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Date' ;
    rdfs:comment 'Scheduled date for follow-up communication with the reporter or additional investigation activities.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Required Flag' ;
    rdfs:comment 'Indicates whether additional follow-up with the reporter or further investigation is required. True if follow-up needed, False otherwise.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incidentDate rdf:type rdf:Property ;
    rdfs:label 'Incident Date' ;
    rdfs:comment 'Date when the alleged incident or compliance violation occurred, as reported or estimated.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incidentDateRangeEnd rdf:type rdf:Property ;
    rdfs:label 'Incident Date Range End' ;
    rdfs:comment 'End date of the period during which the alleged incident occurred, if the incident spanned multiple dates.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incidentDateRangeStart rdf:type rdf:Property ;
    rdfs:label 'Incident Date Range Start' ;
    rdfs:comment 'Start date of the period during which the alleged incident occurred, if the incident spanned multiple dates.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:individualImplicatedName rdf:type rdf:Property ;
    rdfs:label 'Individual Implicated Name' ;
    rdfs:comment 'Name of the individual(s) allegedly involved in the compliance concern, if identified in the report.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Completion Date' ;
    rdfs:comment 'Date when the investigation was completed and findings were documented.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investigationStartDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Start Date' ;
    rdfs:comment 'Date when the formal investigation into the reported concern was initiated.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investigationStatus rdf:type rdf:Property ;
    rdfs:label 'Investigation Status' ;
    rdfs:comment 'Current status of the investigation into the reported compliance concern: new, assigned, in progress, pending additional information, completed, or closed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAuthorityNotified rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority Notified' ;
    rdfs:comment 'Name of the external regulatory authority or governing body that was notified of the substantiated violation (e.g., CMS, OIG, OCR, state health department).' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Date' ;
    rdfs:comment 'Date when the external regulatory authority was formally notified of the substantiated violation.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required Flag' ;
    rdfs:comment 'Indicates whether the substantiated violation requires mandatory reporting to external regulatory authorities (CMS, OIG, state health department, etc.). True if external reporting required, False otherwise.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportChannel rdf:type rdf:Property ;
    rdfs:label 'Report Channel' ;
    rdfs:comment 'Method through which the compliance concern was reported: hotline, online portal, direct report to compliance officer, email, mail, or in-person.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportDate rdf:type rdf:Property ;
    rdfs:label 'Report Date' ;
    rdfs:comment 'Date when the compliance concern or ethics report was submitted through the hotline or reporting system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportNumber rdf:type rdf:Property ;
    rdfs:label 'Report Number' ;
    rdfs:comment 'Business identifier for the hotline report, formatted as HR- followed by 8 digits. Used for external reference and tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportTimestamp rdf:type rdf:Property ;
    rdfs:label 'Report Timestamp' ;
    rdfs:comment 'Precise date and time when the report was received by the compliance system.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reporterAnonymityFlag rdf:type rdf:Property ;
    rdfs:label 'Reporter Anonymity Flag' ;
    rdfs:comment 'Indicates whether the reporter chose to remain anonymous. True if anonymous, False if reporter provided identity.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reporterContactEmail rdf:type rdf:Property ;
    rdfs:label 'Reporter Contact Email' ;
    rdfs:comment 'Email address of the reporter for follow-up communication, if provided. Null if anonymous or not provided.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reporterContactPhone rdf:type rdf:Property ;
    rdfs:label 'Reporter Contact Phone' ;
    rdfs:comment 'Phone number of the reporter for follow-up, if provided. Null if anonymous or not provided.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reporterName rdf:type rdf:Property ;
    rdfs:label 'Reporter Name' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retaliationConcernFlag rdf:type rdf:Property ;
    rdfs:label 'Retaliation Concern Flag' ;
    rdfs:comment 'Indicates whether the reporter expressed concern about potential retaliation for making the report. True if retaliation concern noted, False otherwise.' ;
    rdfs:domain ind:HotlineReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investigationId rdf:type rdf:Property ;
    rdfs:label 'Investigation Id' ;
    rdfs:comment 'Unique identifier for the compliance investigation record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investigation .

ind:investigationEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Investigation Employee Id' ;
    rdfs:comment 'System user identifier of the person who last modified this investigation record. Used for audit trail and accountability.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentInvestigationId rdf:type rdf:Property ;
    rdfs:label 'Parent Investigation Id' ;
    rdfs:comment 'Self-referencing FK on investigation (related_investigation_id)' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investigation .

ind:breachNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Breach Notification Required Flag' ;
    rdfs:comment 'Indicator of whether the investigation findings triggered mandatory breach notification to patients, HHS OCR, or media under HIPAA Breach Notification Rule. True indicates notification obligation exists.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closeDate rdf:type rdf:Property ;
    rdfs:label 'Close Date' ;
    rdfs:comment 'Date on which the investigation was formally concluded and final determination documented. Null for open investigations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conclusion rdf:type rdf:Property ;
    rdfs:label 'Conclusion' ;
    rdfs:comment 'Final determination of the investigation outcome. Violation confirmed indicates substantiated compliance breach. No violation indicates allegation not supported by evidence. Inconclusive indicates insufficient evidence to make determination. Pending review indicates investigation complete but awaiting final approval or legal review.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentInvolved rdf:type rdf:Property ;
    rdfs:label 'Department Involved' ;
    rdfs:comment 'Primary department or business unit where the alleged violation occurred or that is the subject of the investigation.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplinaryActionTakenFlag rdf:type rdf:Property ;
    rdfs:label 'Disciplinary Action Taken Flag' ;
    rdfs:comment 'Indicator of whether employee disciplinary action was taken as a result of investigation findings, including counseling, suspension, termination, or other personnel action.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalReferralAgency rdf:type rdf:Property ;
    rdfs:label 'External Referral Agency' ;
    rdfs:comment 'Name of external regulatory, law enforcement, or oversight agency to which the investigation was referred, such as HHS OIG, DOJ, FBI, OCR, state attorney general, or state health department.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalReferralDate rdf:type rdf:Property ;
    rdfs:label 'External Referral Date' ;
    rdfs:comment 'Date on which the investigation was formally referred to external authority. Null if no external referral made.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financialImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Amount' ;
    rdfs:comment 'Estimated or calculated financial impact of the violation in US dollars, including overpayments, penalties, refunds, or potential liability exposure. Used for self-disclosure calculations and reserve estimation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:findingsSummary rdf:type rdf:Property ;
    rdfs:label 'Findings Summary' ;
    rdfs:comment 'Comprehensive narrative summary of the investigation findings, including evidence reviewed, interviews conducted, timeline of events, root cause analysis, and factual determinations. This field supports legal privilege and compliance program documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationNumber rdf:type rdf:Property ;
    rdfs:label 'Investigation Number' ;
    rdfs:comment 'Business-facing unique investigation case number assigned at initiation, formatted as INV-YYYYNNNN for tracking and reference in compliance documentation and legal proceedings.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationType rdf:type rdf:Property ;
    rdfs:label 'Investigation Type' ;
    rdfs:comment 'Classification of the investigation based on the nature of the alleged compliance violation. Privacy breach covers HIPAA violations and unauthorized PHI disclosure. Billing fraud includes upcoding, unbundling, and false claims. Workplace safety covers OSHA violations. Abuse/neglect includes patient harm and mistreatment. Anti-kickback covers illegal remuneration. Stark violation covers physician self-referral violations.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigatorName rdf:type rdf:Property ;
    rdfs:label 'Investigator Name' ;
    rdfs:comment 'Full name of the primary investigator assigned to this case for business reporting and audit trail purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalPrivilegeAssertedFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Privilege Asserted Flag' ;
    rdfs:comment 'Indicator of whether attorney-client privilege or attorney work product privilege has been asserted over investigation materials. True indicates privileged status requiring special handling and access controls.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientCount rdf:type rdf:Property ;
    rdfs:label 'Patient Count' ;
    rdfs:comment 'Number of distinct patients affected by or involved in the alleged violation. Used to assess breach notification requirements under HIPAA and scope of potential harm.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientInvolvedFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Involved Flag' ;
    rdfs:comment 'Indicator of whether the investigation involves a specific patient or patient PHI. True indicates patient-specific investigation requiring additional privacy protections and breach notification assessment.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recommendedActions rdf:type rdf:Property ;
    rdfs:label 'Recommended Actions' ;
    rdfs:comment 'Detailed recommendations for corrective and preventive actions resulting from investigation findings, including policy revisions, training requirements, system controls, disciplinary actions, and process improvements.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskRating rdf:type rdf:Property ;
    rdfs:label 'Risk Rating' ;
    rdfs:comment 'Assessment of the potential organizational risk exposure associated with the alleged violation, considering financial, reputational, regulatory, and patient safety dimensions.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selfDisclosureDate rdf:type rdf:Property ;
    rdfs:label 'Self Disclosure Date' ;
    rdfs:comment 'Date on which voluntary self-disclosure was submitted to the applicable regulatory authority. Null if no disclosure required or not yet submitted.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:selfDisclosureRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Self Disclosure Required Flag' ;
    rdfs:comment 'Indicator of whether the investigation findings require voluntary self-disclosure to regulatory authority such as OIG, CMS, or OCR under self-disclosure protocols. True indicates disclosure obligation exists.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:startDate rdf:type rdf:Property ;
    rdfs:label 'Start Date' ;
    rdfs:comment 'Date on which the formal investigation was officially opened and investigative activities commenced. Used to track timeliness of investigation response and compliance with regulatory reporting deadlines.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetDueDate rdf:type rdf:Property ;
    rdfs:label 'Target Due Date' ;
    rdfs:comment 'Target completion date for the investigation based on regulatory timelines, internal SLA, or urgency classification. Used to monitor investigation timeliness and escalate overdue cases.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:triggerSource rdf:type rdf:Property ;
    rdfs:label 'Trigger Source' ;
    rdfs:comment 'Origin or channel through which the investigation was initiated. Hotline report indicates anonymous or named report through compliance hotline. Audit finding indicates discovery during internal or external audit. Self-disclosure indicates proactive identification by organization. External referral indicates notification from regulatory body, payer, or law enforcement. Patient complaint indicates grievance filed by patient or family. Employee report indicates direct report from staff member. Regulatory inquiry indicates investigation prompted by CMS, OCR, or state agency request. [ENUM-REF-CANDIDATE: hotline_report|audit_finding|self_disclosure|external_referral|patient_complaint|employee_report|regulatory_inquiry — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationConfirmedFlag rdf:type rdf:Property ;
    rdfs:label 'Violation Confirmed Flag' ;
    rdfs:comment 'Boolean indicator of whether the investigation substantiated a compliance violation. True indicates confirmed violation requiring corrective action and potential self-disclosure.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:starkArrangementId rdf:type rdf:Property ;
    rdfs:label 'Stark Arrangement Id' ;
    rdfs:comment 'Unique identifier for the Stark Law financial arrangement record. Primary key for the stark_arrangement product.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StarkArrangement .

ind:renewedStarkArrangementId rdf:type rdf:Property ;
    rdfs:label 'Renewed Stark Arrangement Id' ;
    rdfs:comment 'Self-referencing FK on stark_arrangement (renewed_stark_arrangement_id)' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StarkArrangement .

ind:arrangementNumber rdf:type rdf:Property ;
    rdfs:label 'Arrangement Number' ;
    rdfs:comment 'Business-assigned unique identifier or reference number for the Stark arrangement, used for tracking and reporting purposes.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arrangementStatus rdf:type rdf:Property ;
    rdfs:label 'Arrangement Status' ;
    rdfs:comment 'Current lifecycle status of the Stark arrangement indicating whether it is in force, under compliance review, or has ended.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arrangementType rdf:type rdf:Property ;
    rdfs:label 'Arrangement Type' ;
    rdfs:comment 'Classification of the financial arrangement between the physician and entity. Determines which Stark exception may apply. [ENUM-REF-CANDIDATE: employment|personal_services|fair_market_value_lease|equipment_lease|recruitment|indirect_compensation|space_rental|medical_director|call_coverage|academic_medical_center|other — 11 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commercialReasonablenessDetermination rdf:type rdf:Property ;
    rdfs:label 'Commercial Reasonableness Determination' ;
    rdfs:comment 'Assessment of whether the arrangement is commercially reasonable and would make sense even in the absence of referrals between the parties.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commercialReasonablenessRationale rdf:type rdf:Property ;
    rdfs:label 'Commercial Reasonableness Rationale' ;
    rdfs:comment 'Business justification and rationale supporting the commercial reasonableness determination.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compensationAmount rdf:type rdf:Property ;
    rdfs:label 'Compensation Amount' ;
    rdfs:comment 'Total annual or per-period compensation amount paid to the physician under the arrangement, in US dollars.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compensationFrequency rdf:type rdf:Property ;
    rdfs:label 'Compensation Frequency' ;
    rdfs:comment 'Frequency at which compensation is paid to the physician under the arrangement.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compensationStructure rdf:type rdf:Property ;
    rdfs:label 'Compensation Structure' ;
    rdfs:comment 'Method by which the physician is compensated under the arrangement. Critical for determining compliance with volume or value of referrals standards. [ENUM-REF-CANDIDATE: fixed_salary|hourly_rate|per_service|percentage_of_revenue|productivity_based|hybrid|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentExceptionCriteriaMet rdf:type rdf:Property ;
    rdfs:label 'Consent Exception Criteria Met' ;
    rdfs:comment 'Detailed documentation of how the arrangement satisfies all required elements of the claimed Stark exception.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designatedHealthServicesInvolved rdf:type rdf:Property ;
    rdfs:label 'Designated Health Services Involved' ;
    rdfs:comment 'List of designated health services (clinical lab, radiology, DME, etc.) to which the physician may refer under this arrangement, triggering Stark Law applicability.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Disclosure Reference Number' ;
    rdfs:comment 'CMS-assigned reference number for the self-referral disclosure submission, if applicable.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Disclosure Required Flag' ;
    rdfs:comment 'Indicates whether the arrangement must be disclosed to CMS under the Self-Referral Disclosure Protocol due to potential non-compliance.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fmvCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Fmv Compliant Flag' ;
    rdfs:comment 'Indicates whether the compensation has been determined to be consistent with fair market value based on the valuation performed.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fmvDeterminationMethod rdf:type rdf:Property ;
    rdfs:label 'Fmv Determination Method' ;
    rdfs:comment 'Methodology used to establish that the compensation is consistent with fair market value and not determined in a manner that takes into account the volume or value of referrals.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fmvOpinionDate rdf:type rdf:Property ;
    rdfs:label 'Fmv Opinion Date' ;
    rdfs:comment 'Date on which the FMV opinion or valuation was issued.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fmvOpinionSource rdf:type rdf:Property ;
    rdfs:label 'Fmv Opinion Source' ;
    rdfs:comment 'Name of the independent valuation firm, consultant, or survey source that provided the FMV opinion or benchmark data.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Legal Approval Status' ;
    rdfs:comment 'Outcome of the legal compliance review indicating whether the arrangement has been approved as Stark-compliant.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalReviewDate rdf:type rdf:Property ;
    rdfs:label 'Legal Review Date' ;
    rdfs:comment 'Date on which the arrangement was last reviewed by legal counsel or compliance department for Stark Law compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalReviewerName rdf:type rdf:Property ;
    rdfs:label 'Legal Reviewer Name' ;
    rdfs:comment 'Name of the attorney or compliance officer who conducted the Stark Law compliance review.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralVolumeTrackingRequired rdf:type rdf:Property ;
    rdfs:label 'Referral Volume Tracking Required' ;
    rdfs:comment 'Indicates whether ongoing monitoring of referral volume and value is required to ensure continued compliance with the exception.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Review Frequency Months' ;
    rdfs:comment 'Number of months between required compliance reviews of the arrangement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:starkExceptionApplied rdf:type rdf:Property ;
    rdfs:label 'Stark Exception Applied' ;
    rdfs:comment 'Specific Stark Law exception (by CFR citation or common name) that the arrangement relies upon for compliance, such as employment exception, personal services exception, or fair market value compensation exception.' ;
    rdfs:domain ind:StarkArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaSafetyProgramId rdf:type rdf:Property ;
    rdfs:label 'Osha Safety Program Id' ;
    rdfs:comment 'Unique identifier for the OSHA safety program record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OshaSafetyProgram .

ind:parentOshaSafetyProgramId rdf:type rdf:Property ;
    rdfs:label 'Parent Osha Safety Program Id' ;
    rdfs:comment 'Self-referencing FK on osha_safety_program (parent_osha_safety_program_id)' ;
    rdfs:domain ind:OshaSafetyProgram ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OshaSafetyProgram .

ind:attestationFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Attestation Frequency Months' ;
    rdfs:comment 'The frequency in months at which attestation must be completed for this safety program. Null if attestation is one-time or not required.' ;
    rdfs:domain ind:OshaSafetyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enforcementMechanism rdf:type rdf:Property ;
    rdfs:label 'Enforcement Mechanism' ;
    rdfs:comment 'Description of how compliance with this safety program is monitored and enforced (e.g., audits, inspections, incident investigations, self-assessments).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalAuditScopeFlag rdf:type rdf:Property ;
    rdfs:label 'External Audit Scope Flag' ;
    rdfs:comment 'Indicates whether this safety program is within the scope of external regulatory audits or inspections (True) or only subject to internal review (False).' ;
    rdfs:domain ind:OshaSafetyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:findingCount rdf:type rdf:Property ;
    rdfs:label 'Finding Count' ;
    rdfs:comment 'The number of audit findings or deficiencies identified during the most recent audit of this safety program.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastAuditResult rdf:type rdf:Property ;
    rdfs:label 'Last Audit Result' ;
    rdfs:comment 'The outcome of the most recent audit of this safety program, indicating the level of compliance found.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaStandardCitation rdf:type rdf:Property ;
    rdfs:label 'Osha Standard Citation' ;
    rdfs:comment 'The specific OSHA regulatory citation (e.g., 29 CFR 1910.1030 for Bloodborne Pathogens) that mandates or guides this safety program.' ;
    rdfs:domain ind:OshaSafetyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programName rdf:type rdf:Property ;
    rdfs:label 'Program Name' ;
    rdfs:comment 'Official name of the OSHA safety program (e.g., Bloodborne Pathogens Exposure Control Plan, Hazard Communication Program, Respiratory Protection Program).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programNumber rdf:type rdf:Property ;
    rdfs:label 'Program Number' ;
    rdfs:comment 'Business identifier for the safety program, used for external reference and reporting to regulatory authorities.' ;
    rdfs:domain ind:OshaSafetyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programOwnerDepartment rdf:type rdf:Property ;
    rdfs:label 'Program Owner Department' ;
    rdfs:comment 'The department responsible for maintaining and overseeing the safety program (e.g., Environmental Health and Safety, Infection Control, Facilities Management).' ;
    rdfs:domain ind:OshaSafetyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programPurpose rdf:type rdf:Property ;
    rdfs:label 'Program Purpose' ;
    rdfs:comment 'Detailed statement of the business and regulatory purpose of the safety program, including the hazards or risks it addresses.' ;
    rdfs:domain ind:OshaSafetyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programScope rdf:type rdf:Property ;
    rdfs:label 'Program Scope' ;
    rdfs:comment 'Description of the organizational scope and applicability of the safety program, including which facilities, departments, or employee groups are covered.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programStatus rdf:type rdf:Property ;
    rdfs:label 'Program Status' ;
    rdfs:comment 'Current lifecycle status of the safety program indicating whether it is operational, under revision, or retired.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programSummary rdf:type rdf:Property ;
    rdfs:label 'Program Summary' ;
    rdfs:comment 'A brief summary of the safety programs purpose, key requirements, and objectives.' ;
    rdfs:domain ind:OshaSafetyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programType rdf:type rdf:Property ;
    rdfs:label 'Program Type' ;
    rdfs:comment 'Classification of the safety program based on OSHA-mandated or voluntary program categories.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedPolicyReferences rdf:type rdf:Property ;
    rdfs:label 'Related Policy References' ;
    rdfs:comment 'Comma-separated list of related organizational policy numbers or identifiers that support or are supported by this safety program.' ;
    rdfs:domain ind:OshaSafetyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedProcedureReferences rdf:type rdf:Property ;
    rdfs:label 'Related Procedure References' ;
    rdfs:comment 'Comma-separated list of related procedure identifiers or standard operating procedures (SOPs) that implement this safety program.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersedesProgramNumber rdf:type rdf:Property ;
    rdfs:label 'Supersedes Program Number' ;
    rdfs:comment 'The program number of the previous version of this safety program that this version replaces, if applicable.' ;
    rdfs:domain ind:OshaSafetyProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Training Frequency Months' ;
    rdfs:comment 'The frequency in months at which employees must complete training for this safety program (e.g., 12 for annual training). Null if training is one-time or not required.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Training Required Flag' ;
    rdfs:comment 'Indicates whether employee training is required as part of this safety program (True) or not (False).' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oshaExposureIncidentId rdf:type rdf:Property ;
    rdfs:label 'Osha Exposure Incident Id' ;
    rdfs:comment 'Unique identifier for the occupational exposure incident record. Primary key for the OSHA exposure incident entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OshaExposureIncident .

ind:oshaEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Osha Employee Id' ;
    rdfs:comment 'Reference to the healthcare worker who experienced the occupational exposure incident.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentOshaExposureIncidentId rdf:type rdf:Property ;
    rdfs:label 'Parent Osha Exposure Incident Id' ;
    rdfs:comment 'Self-referencing FK on osha_exposure_incident (related_osha_exposure_incident_id)' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OshaExposureIncident .

ind:procedureEventId rdf:type rdf:Property ;
    rdfs:label 'Procedure Event Id' ;
    rdfs:comment 'Foreign key linking to clinical.procedure_event. Business justification: Sharps injuries and exposure incidents often occur during specific surgical or invasive procedures. Root cause analysis and OSHA reporting require linking exposure incidents to the procedural context ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProcedureEvent .

ind:baselineTestingCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Baseline Testing Completed Flag' ;
    rdfs:comment 'Indicates whether baseline bloodborne pathogen testing was completed for the exposed employee immediately following the exposure. Required to establish pre-exposure status.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveActionsImplemented rdf:type rdf:Property ;
    rdfs:label 'Corrective Actions Implemented' ;
    rdfs:comment 'Description of corrective actions implemented to prevent recurrence of similar exposure incidents. May include process changes, equipment changes, or additional training.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysAwayFromWork rdf:type rdf:Property ;
    rdfs:label 'Days Away From Work' ;
    rdfs:comment 'Number of calendar days the exposed employee was unable to work as a result of the exposure incident. Required for OSHA 300 log column entries.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysOfJobTransferRestriction rdf:type rdf:Property ;
    rdfs:label 'Days Of Job Transfer Restriction' ;
    rdfs:comment 'Number of calendar days the exposed employee was on restricted work activity or job transfer as a result of the exposure. Required for OSHA 300 log column entries.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exposedEmployeeDepartment rdf:type rdf:Property ;
    rdfs:label 'Exposed Employee Department' ;
    rdfs:comment 'Department or unit where the exposed employee was working at the time of the incident. Critical for departmental safety metrics and targeted training.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposedEmployeeJobTitle rdf:type rdf:Property ;
    rdfs:label 'Exposed Employee Job Title' ;
    rdfs:comment 'Job title or role of the exposed employee at the time of the incident. Used for risk analysis and prevention planning by occupational category.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureRoute rdf:type rdf:Property ;
    rdfs:label 'Exposure Route' ;
    rdfs:comment 'Route by which the exposure occurred. Percutaneous (needlestick, sharps injury) and mucous membrane exposures have different post-exposure prophylaxis protocols.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureType rdf:type rdf:Property ;
    rdfs:label 'Exposure Type' ;
    rdfs:comment 'Primary category of occupational exposure. Bloodborne pathogen exposures are the most common in healthcare and trigger specific OSHA Bloodborne Pathogens Standard requirements.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Completed Flag' ;
    rdfs:comment 'Indicates whether all required follow-up testing and medical evaluations have been completed for the exposed employee. Used to track compliance with post-exposure protocols.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpTestingSchedule rdf:type rdf:Property ;
    rdfs:label 'Follow Up Testing Schedule' ;
    rdfs:comment 'Scheduled follow-up testing timeline for the exposed employee (e.g., 6 weeks, 3 months, 6 months post-exposure). Protocol varies by exposure type and source patient status.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentLocation rdf:type rdf:Property ;
    rdfs:label 'Incident Location' ;
    rdfs:comment 'Specific location within the healthcare facility where the exposure occurred (e.g., Emergency Department Room 3, Operating Room 5, Patient Room 412). Used for environmental risk assessment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentNumber rdf:type rdf:Property ;
    rdfs:label 'Incident Number' ;
    rdfs:comment 'Business identifier assigned to the exposure incident for tracking and reporting purposes. Used in OSHA 300 log and internal incident management systems.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Incident Resolution Date' ;
    rdfs:comment 'Date when the exposure incident case was closed and all follow-up activities completed. Used for case closure tracking and outcome analysis.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incidentStatus rdf:type rdf:Property ;
    rdfs:label 'Incident Status' ;
    rdfs:comment 'Current status of the exposure incident case management. Tracks the incident through investigation, follow-up care, and final resolution.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentTime rdf:type rdf:Property ;
    rdfs:label 'Incident Time' ;
    rdfs:comment 'Precise date and time when the exposure incident occurred. Used for shift analysis, staffing pattern review, and post-exposure prophylaxis timing calculations.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:investigationNotes rdf:type rdf:Property ;
    rdfs:label 'Investigation Notes' ;
    rdfs:comment 'Detailed narrative of the incident investigation findings, including circumstances leading to the exposure, witness statements, and contributing factors. Used for root cause analysis and prevention planning.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaRecordableDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Osha Recordable Determination Date' ;
    rdfs:comment 'Date when the OSHA recordability determination was made. Must be within 7 calendar days of receiving information that a recordable injury or illness has occurred.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:oshaRecordableFlag rdf:type rdf:Property ;
    rdfs:label 'Osha Recordable Flag' ;
    rdfs:comment 'Indicates whether the exposure incident meets OSHA criteria for recordability on the OSHA 300 log. Recordability determination based on whether the incident resulted in medical treatment beyond first aid, days away from work, or job transfer/restriction.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pepInitiatedFlag rdf:type rdf:Property ;
    rdfs:label 'Pep Initiated Flag' ;
    rdfs:comment 'Indicates whether post-exposure prophylaxis treatment was initiated for the exposed employee. Required for OSHA compliance and employee health tracking.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pepStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Pep Start Timestamp' ;
    rdfs:comment 'Date and time when post-exposure prophylaxis was initiated. Timing is critical for PEP effectiveness, particularly for HIV exposure (ideally within 2 hours, no later than 72 hours).' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:pepType rdf:type rdf:Property ;
    rdfs:label 'Pep Type' ;
    rdfs:comment 'Type of post-exposure prophylaxis administered (e.g., HIV PEP antiretroviral therapy, Hepatitis B immune globulin, Hepatitis B vaccination). Free text to accommodate multiple concurrent treatments.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureBeingPerformed rdf:type rdf:Property ;
    rdfs:label 'Procedure Being Performed' ;
    rdfs:comment 'Clinical procedure or task being performed when the exposure occurred. Used for procedural risk analysis and targeted training interventions.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reported Timestamp' ;
    rdfs:comment 'Date and time when the exposure incident was first reported to management or employee health. Used to track reporting timeliness and compliance with immediate reporting requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rootCauseAnalysisCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis Completed Flag' ;
    rdfs:comment 'Indicates whether a formal root cause analysis was conducted for the exposure incident. Required for serious incidents and used to drive systemic safety improvements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyEngineeredDeviceFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Engineered Device Flag' ;
    rdfs:comment 'Indicates whether the device involved had safety-engineered sharps injury protection features. Critical for evaluating effectiveness of safety device adoption.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sharpsDeviceBrand rdf:type rdf:Property ;
    rdfs:label 'Sharps Device Brand' ;
    rdfs:comment 'Manufacturer and brand name of the sharp device involved. Used for product safety evaluation and vendor performance tracking.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sharpsDeviceType rdf:type rdf:Property ;
    rdfs:label 'Sharps Device Type' ;
    rdfs:comment 'Type of sharp device involved in the exposure (e.g., hollow-bore needle, suture needle, scalpel, lancet). Required for OSHA Sharps Injury Log and device evaluation.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcePatientHbvStatus rdf:type rdf:Property ;
    rdfs:label 'Source Patient Hbv Status' ;
    rdfs:comment 'Hepatitis B test result for the source patient. Protected health information. Determines need for Hepatitis B immune globulin and vaccination for exposed employee.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcePatientHcvStatus rdf:type rdf:Property ;
    rdfs:label 'Source Patient Hcv Status' ;
    rdfs:comment 'Hepatitis C test result for the source patient. Protected health information. Determines baseline and follow-up testing protocol for exposed employee.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcePatientHivStatus rdf:type rdf:Property ;
    rdfs:label 'Source Patient Hiv Status' ;
    rdfs:comment 'HIV test result for the source patient. Protected health information. Critical for determining post-exposure prophylaxis regimen for the exposed employee.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcePatientKnownFlag rdf:type rdf:Property ;
    rdfs:label 'Source Patient Known Flag' ;
    rdfs:comment 'Indicates whether the source patient could be identified. Unknown source exposures require different post-exposure prophylaxis risk assessment.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourcePatientTestedFlag rdf:type rdf:Property ;
    rdfs:label 'Source Patient Tested Flag' ;
    rdfs:comment 'Indicates whether the source patient was tested for bloodborne pathogens (HIV, Hepatitis B, Hepatitis C) following the exposure incident.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workersCompClaimFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Workers Comp Claim Filed Flag' ;
    rdfs:comment 'Indicates whether a workers compensation claim was filed for the exposure incident. Links occupational health incident to workers compensation case management.' ;
    rdfs:domain ind:OshaExposureIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workersCompClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Workers Comp Claim Number' ;
    rdfs:comment 'Workers compensation claim number associated with the exposure incident, if a claim was filed. Used for cross-referencing with workers compensation system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsConditionStatusId rdf:type rdf:Property ;
    rdfs:label 'Cms Condition Status Id' ;
    rdfs:comment 'Unique identifier for the CMS Condition of Participation or Condition for Coverage compliance status tracking record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CmsConditionStatus .

ind:auditId rdf:type rdf:Property ;
    rdfs:label 'Audit Id' ;
    rdfs:comment 'Foreign key linking to compliance.audit. Business justification: CMS Condition of Participation status records are assessed during CMS surveys/audits. Each cms_condition_status record should link to the audit/survey that assessed it (last_survey_date, last_survey_t' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Audit .

ind:postAcuteLocationId rdf:type rdf:Property ;
    rdfs:label 'Post Acute Location Id' ;
    rdfs:comment 'Foreign key linking to post_acute_care.post_acute_location. Business justification: Every Medicare-certified SNF/HHA/hospice must maintain CMS Conditions of Participation. CMS certification status is tracked per PAC facility for Medicare enrollment, survey readiness, and enforcement ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PostAcuteLocation .

ind:priorCmsConditionStatusId rdf:type rdf:Property ;
    rdfs:label 'Prior Cms Condition Status Id' ;
    rdfs:comment 'Self-referencing FK on cms_condition_status (prior_cms_condition_status_id)' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CmsConditionStatus .

ind:responsibleCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Responsible Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: CMS condition compliance is typically owned by specific departments (Quality, Infection Control, etc.). Remediation costs must be tracked against the responsible cost center for budget management, cos' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:certificationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Certification Effective Date' ;
    rdfs:comment 'The date on which the current CMS certification status for this provider type became effective.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:civilMonetaryPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Civil Monetary Penalty Amount' ;
    rdfs:comment 'The total dollar amount of civil monetary penalties imposed by CMS for deficiencies cited under this Condition of Participation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cmsProviderType rdf:type rdf:Property ;
    rdfs:label 'Cms Provider Type' ;
    rdfs:comment 'Type of healthcare provider subject to this CMS condition of participation (e.g., hospital, SNF, home health agency).' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsStatusCode rdf:type rdf:Property ;
    rdfs:label 'Cms Status Code' ;
    rdfs:comment 'description' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionCategory rdf:type rdf:Property ;
    rdfs:label 'Condition Category' ;
    rdfs:comment 'The functional category or domain of the CMS Condition of Participation (e.g., patient rights, quality assurance, infection control, nursing services, medical staff, pharmaceutical services). [ENUM-REF-CANDIDATE: patient_rights|quality_assurance|infection_control|nursing_services|medical_staff|pharmaceutical_services|dietary_services|emergency_services|surgical_services|anesthesia_services|radiologic_services|laboratory_services|medical_record_services|physical_environment|life_safety|governance|administration — 17 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionName rdf:type rdf:Property ;
    rdfs:label 'Condition Name' ;
    rdfs:comment 'Add PII/PHI classification tags to all PHI-containing attributes.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copCitation rdf:type rdf:Property ;
    rdfs:label 'Cop Citation' ;
    rdfs:comment 'The official CMS regulatory citation for the Condition of Participation or Condition for Coverage (e.g., 42 CFR 482.13, 42 CFR 483.10) that this status record tracks.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctionCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Correction Completion Date' ;
    rdfs:comment 'The date by which the facility must complete all corrective actions for deficiencies cited under this condition, as specified in the accepted Plan of Correction.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctionVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Correction Verified Date' ;
    rdfs:comment 'The date on which CMS or the state survey agency verified that all corrective actions for this condition have been successfully implemented and deficiencies resolved.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deficiencyTagNumbers rdf:type rdf:Property ;
    rdfs:label 'Deficiency Tag Numbers' ;
    rdfs:comment 'Comma-separated list of CMS deficiency tag numbers (e.g., K0001, K0021, A0115) cited under this Condition of Participation during the last survey.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enforcementActionFlag rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Flag' ;
    rdfs:comment 'Indicates whether CMS or the state survey agency has imposed enforcement actions (remedies) on the facility related to deficiencies under this condition (True if enforcement actions are active, False otherwise).' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enforcementActionType rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Type' ;
    rdfs:comment 'The type of CMS enforcement remedy imposed for deficiencies under this condition (e.g., civil monetary penalty, denial of payment for new admissions, temporary management, termination of provider agreement). Multiple actions may be listed if applicable.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalAuditFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Internal Audit Frequency Months' ;
    rdfs:comment 'The frequency in months at which the organization conducts internal compliance audits or self-assessments for this CMS Condition of Participation.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastInternalAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Internal Audit Date' ;
    rdfs:comment 'The date of the most recent internal compliance audit or self-assessment conducted for this CMS Condition of Participation.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastInternalAuditResult rdf:type rdf:Property ;
    rdfs:label 'Last Internal Audit Result' ;
    rdfs:comment 'The outcome of the most recent internal compliance audit for this condition: compliant, minor gaps identified, significant gaps identified, or non-compliant.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Last Survey Date' ;
    rdfs:comment 'The date of the most recent CMS certification survey or validation survey during which this Condition of Participation was evaluated.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastSurveyOutcome rdf:type rdf:Property ;
    rdfs:label 'Last Survey Outcome' ;
    rdfs:comment 'The overall outcome of the last CMS survey for this condition: no deficiencies found, deficiencies cited (standard level), condition-level deficiencies cited, immediate jeopardy cited, or termination recommended.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastSurveyType rdf:type rdf:Property ;
    rdfs:label 'Last Survey Type' ;
    rdfs:comment 'The type of CMS survey during which this condition was last evaluated (e.g., initial certification, recertification, complaint investigation, validation, life safety code, revisit).' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextInternalAuditDate rdf:type rdf:Property ;
    rdfs:label 'Next Internal Audit Date' ;
    rdfs:comment 'The scheduled date for the next internal compliance audit or self-assessment for this CMS Condition of Participation.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextSurveyWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Next Survey Window End' ;
    rdfs:comment 'The latest date within the window when the next CMS certification or recertification survey for this condition must occur to maintain compliance with survey frequency requirements.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextSurveyWindowStart rdf:type rdf:Property ;
    rdfs:label 'Next Survey Window Start' ;
    rdfs:comment 'The earliest date within the window when the next CMS certification or recertification survey for this condition is expected to occur, based on regulatory survey cycles.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:openDeficiencyCount rdf:type rdf:Property ;
    rdfs:label 'Open Deficiency Count' ;
    rdfs:comment 'The current number of open (uncorrected) deficiencies cited under this Condition of Participation that require corrective action.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planOfCorrectionAcceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Plan Of Correction Acceptance Date' ;
    rdfs:comment 'The date on which CMS or the state survey agency formally accepted the facilitys Plan of Correction.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planOfCorrectionDueDate rdf:type rdf:Property ;
    rdfs:label 'Plan Of Correction Due Date' ;
    rdfs:comment 'The deadline by which the facility must submit its Plan of Correction to CMS or the state survey agency for deficiencies cited under this condition.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planOfCorrectionStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Of Correction Status' ;
    rdfs:comment 'The current status of the Plan of Correction for deficiencies cited under this condition: not required, required, submitted, under review by CMS/state agency, accepted, rejected, implemented, or verified as corrected. [ENUM-REF-CANDIDATE: not_required|required|submitted|under_review|accepted|rejected|implemented|verified — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planOfCorrectionSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Plan Of Correction Submission Date' ;
    rdfs:comment 'The date on which the facility submitted its Plan of Correction to CMS or the state survey agency.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsibleDepartment rdf:type rdf:Property ;
    rdfs:label 'Responsible Department' ;
    rdfs:comment 'The internal department or service line responsible for maintaining compliance with this CMS Condition of Participation (e.g., Nursing, Infection Prevention, Quality, Medical Staff Services).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleOfficerName rdf:type rdf:Property ;
    rdfs:label 'Responsible Officer Name' ;
    rdfs:comment 'The name of the executive or director responsible for oversight of compliance with this CMS Condition of Participation.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleOfficerTitle rdf:type rdf:Property ;
    rdfs:label 'Responsible Officer Title' ;
    rdfs:comment 'The job title of the executive or director responsible for oversight of compliance with this CMS Condition of Participation (e.g., Chief Nursing Officer, Director of Quality, Chief Medical Officer).' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeAndSeverityLevel rdf:type rdf:Property ;
    rdfs:label 'Scope And Severity Level' ;
    rdfs:comment 'The CMS scope and severity matrix level assigned to the most serious deficiency under this condition (A through L, where A is isolated/no harm and L is widespread/immediate jeopardy). [ENUM-REF-CANDIDATE: A|B|C|D|E|F|G|H|I|J|K|L — 12 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateSurveyAgency rdf:type rdf:Property ;
    rdfs:label 'State Survey Agency' ;
    rdfs:comment 'The name of the state health department or survey agency responsible for conducting CMS certification surveys for this facility.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyorName rdf:type rdf:Property ;
    rdfs:label 'Surveyor Name' ;
    rdfs:comment 'The name of the lead CMS or state survey agency surveyor who conducted the last survey evaluation of this condition.' ;
    rdfs:domain ind:CmsConditionStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationStatusId rdf:type rdf:Property ;
    rdfs:label 'Accreditation Status Id' ;
    rdfs:comment 'Unique identifier for the accreditation status record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccreditationStatus .

ind:priorAccreditationStatusId rdf:type rdf:Property ;
    rdfs:label 'Prior Accreditation Status Id' ;
    rdfs:comment 'Self-referencing FK on accreditation_status (prior_accreditation_status_id)' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccreditationStatus .

ind:accreditationAwardDate rdf:type rdf:Property ;
    rdfs:label 'Accreditation Award Date' ;
    rdfs:comment 'Date on which the accreditation status was officially awarded or conferred by the accrediting body following survey completion and decision.' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accreditationCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Accreditation Certificate Number' ;
    rdfs:comment 'Unique certificate or accreditation number issued by the accrediting body to identify this specific accreditation award.' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationCostAmount rdf:type rdf:Property ;
    rdfs:label 'Accreditation Cost Amount' ;
    rdfs:comment 'Total cost in US dollars (USD) associated with obtaining and maintaining this accreditation, including survey fees, application fees, annual fees, and consulting costs.' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accreditationCycleYears rdf:type rdf:Property ;
    rdfs:label 'Accreditation Cycle Years' ;
    rdfs:comment 'Number of years in the accreditation cycle before re-survey is required. Typically 3 years for hospital accreditation, may vary by program type.' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accreditationDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Accreditation Decision Date' ;
    rdfs:comment 'Date on which the accrediting body made the formal accreditation decision following survey review and any appeals process.' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accreditationLevel rdf:type rdf:Property ;
    rdfs:label 'Accreditation Level' ;
    rdfs:comment 'Level or tier of accreditation awarded, if the accrediting body uses tiered accreditation (e.g., gold, silver, bronze for some programs; level I, II, III for trauma centers).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditationScope rdf:type rdf:Property ;
    rdfs:label 'Accreditation Scope' ;
    rdfs:comment 'Description of the scope of services, departments, or programs covered by this accreditation (e.g., acute care hospital services, emergency department, surgical services, laboratory services, radiology services).' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditingBodyCode rdf:type rdf:Property ;
    rdfs:label 'Accrediting Body Code' ;
    rdfs:comment 'Standardized code identifying the accrediting organization (e.g., TJC for The Joint Commission, DNV for DNV GL, HFAP for Healthcare Facilities Accreditation Program, CARF for Commission on Accreditation of Rehabilitation Facilities, CAP for College of American Pathologists, ACR for American College of Radiology, AAAHC for Accreditation Association for Ambulatory Health Care).' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accreditingBodyName rdf:type rdf:Property ;
    rdfs:label 'Accrediting Body Name' ;
    rdfs:comment 'Full legal name of the accrediting organization (e.g., The Joint Commission, DNV GL Healthcare, Healthcare Facilities Accreditation Program).' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualMaintenanceFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Maintenance Fee Amount' ;
    rdfs:comment 'Annual fee in US dollars (USD) charged by the accrediting body to maintain active accreditation status between surveys.' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimAppealFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Claim Appeal Filed Flag' ;
    rdfs:comment 'Indicates whether the organization filed an appeal of the accreditation decision or survey findings. True if appeal was filed; false otherwise.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimAppealOutcome rdf:type rdf:Property ;
    rdfs:label 'Claim Appeal Outcome' ;
    rdfs:comment 'Outcome of the appeal process if an appeal was filed. Upheld indicates original decision stands; overturned indicates decision reversed; modified indicates decision changed; pending indicates appeal in progress; not applicable if no appeal filed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Cms Certification Number' ;
    rdfs:comment 'CMS-issued certification number (CCN) associated with this accreditation when deemed status applies. Used for Medicare and Medicaid billing and provider enrollment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPersonEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Person Email' ;
    rdfs:comment 'Email address of the primary organizational contact person for this accreditation.' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPersonName rdf:type rdf:Property ;
    rdfs:label 'Contact Person Name' ;
    rdfs:comment 'Name of the primary organizational contact person responsible for managing this accreditation relationship and survey coordination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPersonPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Person Phone' ;
    rdfs:comment 'Phone number of the primary organizational contact person for this accreditation.' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPersonTitle rdf:type rdf:Property ;
    rdfs:label 'Contact Person Title' ;
    rdfs:comment 'Job title or role of the primary organizational contact person for this accreditation (e.g., Director of Regulatory Compliance, Chief Quality Officer, Accreditation Coordinator).' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Critical Findings Count' ;
    rdfs:comment 'Number of critical or immediate threat to health and safety findings identified during the last survey. Critical findings may result in conditional accreditation or denial.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deemedStatusFlag rdf:type rdf:Property ;
    rdfs:label 'Deemed Status Flag' ;
    rdfs:comment 'Indicates whether this accreditation confers deemed status for Centers for Medicare and Medicaid Services (CMS) Conditions of Participation (CoP), allowing the facility to participate in Medicare and Medicaid programs without separate CMS certification. True if deemed status is granted; false otherwise.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusions rdf:type rdf:Property ;
    rdfs:label 'Exclusions' ;
    rdfs:comment 'Description of any services, departments, or programs explicitly excluded from the scope of this accreditation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Completion Date' ;
    rdfs:comment 'Date on which the required follow-up activity (evidence submission, corrective action plan, or follow-up survey) was completed and accepted by the accrediting body.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpDueDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Due Date' ;
    rdfs:comment 'Date by which the organization must submit evidence of standards compliance, corrective action plan, or complete a follow-up survey to maintain accreditation status.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextSurveyWindowEndDate rdf:type rdf:Property ;
    rdfs:label 'Next Survey Window End Date' ;
    rdfs:comment 'Latest date within the window by which the next accreditation survey must be completed to maintain continuous accreditation.' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextSurveyWindowStartDate rdf:type rdf:Property ;
    rdfs:label 'Next Survey Window Start Date' ;
    rdfs:comment 'Earliest date within the window when the next accreditation survey may be scheduled or conducted.' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicDisclosureFlag rdf:type rdf:Property ;
    rdfs:label 'Public Disclosure Flag' ;
    rdfs:comment 'Indicates whether this accreditation status is publicly disclosed on the accrediting bodys website or public database. True if publicly disclosed; false if confidential.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityReportUrl rdf:type rdf:Property ;
    rdfs:label 'Quality Report Url' ;
    rdfs:comment 'Web address (URL) where the public quality report or accreditation details can be accessed on the accrediting bodys website (e.g., The Joint Commission Quality Check).' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateLicensureAlignmentFlag rdf:type rdf:Property ;
    rdfs:label 'State Licensure Alignment Flag' ;
    rdfs:comment 'Indicates whether this accreditation is recognized by the state health department for facility licensure purposes or whether it satisfies state licensure requirements. True if aligned; false otherwise.' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surveyFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Survey Findings Count' ;
    rdfs:comment 'Total number of findings, deficiencies, or requirements for improvement identified during the last accreditation survey.' ;
    rdfs:domain ind:AccreditationStatus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveyType rdf:type rdf:Property ;
    rdfs:label 'Survey Type' ;
    rdfs:comment 'Type of survey that resulted in this accreditation status. Initial for first-time accreditation; triennial for standard 3-year re-accreditation; mid-cycle for periodic review; unannounced for random unannounced surveys; for-cause for complaint-driven surveys; follow-up for post-finding validation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewedBusinessAssociateAgreementId rdf:type rdf:Property ;
    rdfs:label 'Renewed Business Associate Agreement Id' ;
    rdfs:comment 'Self-referencing FK on business_associate_agreement (renewed_business_associate_agreement_id)' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BusinessAssociateAgreement .

ind:agreementNumber rdf:type rdf:Property ;
    rdfs:label 'Agreement Number' ;
    rdfs:comment 'Externally-known unique identifier or reference number assigned to this BAA for tracking and reference purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditRightsGrantedFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Rights Granted Flag' ;
    rdfs:comment 'Indicates whether the covered entity has the right to audit the business associates compliance with the BAA and HIPAA requirements.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:breachNotificationTimeframeDays rdf:type rdf:Property ;
    rdfs:label 'Breach Notification Timeframe Days' ;
    rdfs:comment 'Number of days within which the business associate must notify the covered entity of a breach of unsecured PHI.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:businessAssociateAddress rdf:type rdf:Property ;
    rdfs:label 'Business Associate Address' ;
    rdfs:comment 'Full mailing address of the business associate organization, including street, city, state, and postal code.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAssociateAgreementStatus rdf:type rdf:Property ;
    rdfs:label 'Business Associate Agreement Status' ;
    rdfs:comment 'Current lifecycle status of the BAA indicating whether it is in force, expired, terminated, or pending action.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAssociateContactEmail rdf:type rdf:Property ;
    rdfs:label 'Business Associate Contact Email' ;
    rdfs:comment 'Email address of the primary contact person at the business associate organization for BAA-related matters.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAssociateContactName rdf:type rdf:Property ;
    rdfs:label 'Business Associate Contact Name' ;
    rdfs:comment 'Name of the primary contact person at the business associate organization for BAA-related matters.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAssociateContactPhone rdf:type rdf:Property ;
    rdfs:label 'Business Associate Contact Phone' ;
    rdfs:comment 'Phone number of the primary contact person at the business associate organization for BAA-related matters.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAssociateSignatoryName rdf:type rdf:Property ;
    rdfs:label 'Business Associate Signatory Name' ;
    rdfs:comment 'Name of the individual who signed the BAA on behalf of the business associate.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAssociateSignatoryTitle rdf:type rdf:Property ;
    rdfs:label 'Business Associate Signatory Title' ;
    rdfs:comment 'Job title or role of the individual who signed the BAA on behalf of the business associate.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAssociateTaxNumber rdf:type rdf:Property ;
    rdfs:label 'Business Associate Tax Number' ;
    rdfs:comment 'Federal tax identification number (EIN) of the business associate for legal and financial tracking.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coveredEntitySignatoryName rdf:type rdf:Property ;
    rdfs:label 'Covered Entity Signatory Name' ;
    rdfs:comment 'Name of the individual who signed the BAA on behalf of the covered entity.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coveredEntitySignatoryTitle rdf:type rdf:Property ;
    rdfs:label 'Covered Entity Signatory Title' ;
    rdfs:comment 'Job title or role of the individual who signed the BAA on behalf of the covered entity.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionDate rdf:type rdf:Property ;
    rdfs:label 'Execution Date' ;
    rdfs:comment 'Date on which the BAA was signed and executed by both the covered entity and the business associate.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:indemnificationClauseIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Indemnification Clause Included Flag' ;
    rdfs:comment 'Indicates whether the BAA includes an indemnification clause protecting the covered entity from liability arising from the business associates actions.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Amount' ;
    rdfs:comment 'Minimum dollar amount of liability or cyber insurance coverage the business associate must maintain.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insuranceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Insurance Required Flag' ;
    rdfs:comment 'Indicates whether the business associate is required to maintain liability or cyber insurance as a condition of the BAA.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:permittedDisclosures rdf:type rdf:Property ;
    rdfs:label 'Permitted Disclosures' ;
    rdfs:comment 'Specific disclosures of PHI that the business associate is permitted to make under the terms of this BAA.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permittedUses rdf:type rdf:Property ;
    rdfs:label 'Permitted Uses' ;
    rdfs:comment 'Specific uses of PHI that the business associate is permitted to perform under the terms of this BAA.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiRetentionPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Phi Retention Period Years' ;
    rdfs:comment 'Number of years the business associate is permitted or required to retain PHI after termination of services, if return or destruction is not feasible.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:phiTypesShared rdf:type rdf:Property ;
    rdfs:label 'Phi Types Shared' ;
    rdfs:comment 'Categories and types of PHI that will be disclosed to or accessed by the business associate under this agreement (e.g., demographic, clinical, billing).' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnOrDestroyPhiFlag rdf:type rdf:Property ;
    rdfs:label 'Return Or Destroy Phi Flag' ;
    rdfs:comment 'Indicates whether the business associate is required to return or destroy all PHI upon termination of the agreement.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safeguardsRequired rdf:type rdf:Property ;
    rdfs:label 'Safeguards Required' ;
    rdfs:comment 'Description of the administrative, physical, and technical safeguards the business associate must implement to protect PHI.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicesProvided rdf:type rdf:Property ;
    rdfs:label 'Services Provided' ;
    rdfs:comment 'Detailed description of the services the business associate will provide that involve access to, use of, or disclosure of PHI.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subcontractorBaaChain rdf:type rdf:Property ;
    rdfs:label 'Subcontractor Baa Chain' ;
    rdfs:comment 'List or description of subcontractors with whom the business associate has executed downstream BAAs, maintaining the chain of HIPAA compliance.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subcontractorBaaRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Subcontractor Baa Required Flag' ;
    rdfs:comment 'Indicates whether the business associate is required to obtain BAAs from any subcontractors who will have access to PHI.' ;
    rdfs:domain ind:BusinessAssociateAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supersededNoticeOfPrivacyPracticesId rdf:type rdf:Property ;
    rdfs:label 'Superseded Notice Of Privacy Practices Id' ;
    rdfs:comment 'Self-referencing FK on notice_of_privacy_practices (superseded_notice_of_privacy_practices_id)' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NoticeOfPrivacyPractices .

ind:acknowledgmentType rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Type' ;
    rdfs:comment 'Type of acknowledgment received from the patient. HIPAA requires good faith effort to obtain written acknowledgment but allows documentation of refusal or inability to obtain.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:availableOnWebsiteFlag rdf:type rdf:Property ;
    rdfs:label 'Available On Website Flag' ;
    rdfs:comment 'Indicates whether this NPP version is available on the organizations website. HIPAA requires covered entities with websites to post NPP prominently.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentRecordModifiedBy rdf:type rdf:Property ;
    rdfs:label 'Consent Record Modified By' ;
    rdfs:comment 'Identifier or name of the user who last modified this NPP record. Required for audit trail and accountability.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentRecordModifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Consent Record Modified Timestamp' ;
    rdfs:comment 'Date and time when this NPP record was last modified. Supports audit trail and compliance verification.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:distributionDate rdf:type rdf:Property ;
    rdfs:label 'Distribution Date' ;
    rdfs:comment 'Date when the NPP was provided or made available to the patient. Required for compliance documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:distributionMethod rdf:type rdf:Property ;
    rdfs:label 'Distribution Method' ;
    rdfs:comment 'Method by which the NPP was provided to the patient. HIPAA requires covered entities to provide NPP at first service delivery and make good faith effort to obtain acknowledgment. [ENUM-REF-CANDIDATE: paper|electronic|portal|email|mail|in_person|kiosk — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Distribution Timestamp' ;
    rdfs:comment 'Precise date and time when the NPP was distributed to the patient, particularly important for electronic and portal distributions.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:emergencyExceptionReason rdf:type rdf:Property ;
    rdfs:label 'Emergency Exception Reason' ;
    rdfs:comment 'Description of the emergency circumstances that prevented obtaining NPP acknowledgment at the time of service.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Material Change Flag' ;
    rdfs:comment 'Indicates whether this NPP version contains material changes to privacy practices. HIPAA requires prompt revision and redistribution if material changes occur.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nppDocumentTitle rdf:type rdf:Property ;
    rdfs:label 'Npp Document Title' ;
    rdfs:comment 'Official title of the NPP document (e.g., Notice of Privacy Practices for Protected Health Information).' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nppDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Npp Document Url' ;
    rdfs:comment 'Storage location or URL where the NPP document is maintained (e.g., document management system path, web portal URL).' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nppEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Npp Effective Date' ;
    rdfs:comment 'Date when this version of the NPP became effective and legally binding. Required to be printed on the notice per HIPAA regulations.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nppExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Npp Expiration Date' ;
    rdfs:comment 'Date when this NPP version was superseded or retired. Null for the current active version.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nppLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Npp Language Code' ;
    rdfs:comment 'ISO 639-2 three-letter language code for the NPP document (e.g., ENG for English, SPA for Spanish). Organizations must provide NPP in languages spoken by patient populations.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nppVersionNumber rdf:type rdf:Property ;
    rdfs:label 'Npp Version Number' ;
    rdfs:comment 'Version identifier for the NPP document (e.g., 1.0, 2.1, 3.0). Tracks revisions to the notice over time as regulations or organizational practices change.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedInFacilityFlag rdf:type rdf:Property ;
    rdfs:label 'Posted In Facility Flag' ;
    rdfs:comment 'Indicates whether this NPP version is posted prominently in the facility where patients can view it. HIPAA requires posting in clear and prominent location.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refusalDocumentedBy rdf:type rdf:Property ;
    rdfs:label 'Refusal Documented By' ;
    rdfs:comment 'Name or identifier of the staff member who documented the patients refusal to acknowledge the NPP.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refusalReason rdf:type rdf:Property ;
    rdfs:label 'Refusal Reason' ;
    rdfs:comment 'Documented reason why the patient refused to acknowledge receipt of the NPP. HIPAA requires documentation of good faith effort and reason for non-acknowledgment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionReason rdf:type rdf:Property ;
    rdfs:label 'Revision Reason' ;
    rdfs:comment 'Reason for creating a new version of the NPP (e.g., regulatory change, organizational policy update, new service offerings). Required when material changes are made.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signatureImageUrl rdf:type rdf:Property ;
    rdfs:label 'Signature Image Url' ;
    rdfs:comment 'Storage location or URL for the scanned or electronic signature image capturing the patients acknowledgment.' ;
    rdfs:domain ind:NoticeOfPrivacyPractices ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:behavioralHealthCfr42ConsentId rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Cfr42 Consent Id' ;
    rdfs:comment 'Foreign key linking to behavioral_health.cfr42_consent. Business justification: PHI access to 42 CFR Part 2 protected SUD records must be validated against active consent. Compliance officers audit access logs to verify each disclosure was authorized under a specific Part 2 conse' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BehavioralHealth .

ind:genomicsGenomicSequenceId rdf:type rdf:Property ;
    rdfs:label 'Genomics Genomic Sequence Id' ;
    rdfs:comment 'Foreign key linking to genomics.genomic_sequence. Business justification: HIPAA requires tracking access to specific genomic PHI. When staff access a patient\'s genomic sequence data, the phi_access_log must record which sequence was accessed for breach investigation and aud' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GenomicsGenomicSequence .

ind:memberEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Member Enrollment Id' ;
    rdfs:comment 'Foreign key linking to insurance.member_enrollment. Business justification: PHI access logs must track which specific insurance enrollment record was accessed for audit trails, break-the-glass monitoring, and inappropriate access detection. Links patient access context to the' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberEnrollment .

ind:noteId rdf:type rdf:Property ;
    rdfs:label 'Note Id' ;
    rdfs:comment 'Foreign key linking to clinical.clinical_note. Business justification: Access audit trails must track which specific clinical notes were viewed for inappropriate access monitoring and breach investigation. Healthcare organizations audit access logs against clinical note ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Note .

ind:parentPhiAccessLogId rdf:type rdf:Property ;
    rdfs:label 'Parent Phi Access Log Id' ;
    rdfs:comment 'Self-referencing FK on phi_access_log (related_phi_access_log_id)' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PhiAccessLog .

ind:accessReason rdf:type rdf:Property ;
    rdfs:label 'Access Reason' ;
    rdfs:comment 'Business reason or justification for accessing the PHI, either system-captured or user-provided. Used to validate legitimate treatment, payment, or healthcare operations purposes.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessReasonCode rdf:type rdf:Property ;
    rdfs:label 'Access Reason Code' ;
    rdfs:comment 'Standardized code representing the category of access reason. Enables systematic analysis of access patterns and compliance with minimum necessary standards. [ENUM-REF-CANDIDATE: treatment|payment|operations|research|legal|emergency|patient_request|quality_review|audit|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessTimestamp rdf:type rdf:Property ;
    rdfs:label 'Access Timestamp' ;
    rdfs:comment 'Date and time when the PHI access event occurred. Critical for audit trail reconstruction and compliance investigations per HIPAA Security Rule audit control requirements.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:accessType rdf:type rdf:Property ;
    rdfs:label 'Access Type' ;
    rdfs:comment 'Type of action performed on the PHI (view, print, export, modify, create, delete). Critical for assessing the nature and risk level of the access event.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditLogSource rdf:type rdf:Property ;
    rdfs:label 'Audit Log Source' ;
    rdfs:comment 'Source system or mechanism that generated this audit log entry (e.g., EHR native audit, SIEM correlation, access governance tool). Identifies the technical origin of the compliance record.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachDetermination rdf:type rdf:Property ;
    rdfs:label 'Breach Determination' ;
    rdfs:comment 'Determination of whether the access event constitutes a breach of unsecured PHI requiring notification under the HIPAA Breach Notification Rule. Critical for regulatory reporting obligations.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachReportedDate rdf:type rdf:Property ;
    rdfs:label 'Breach Reported Date' ;
    rdfs:comment 'Date when the breach was reported to affected individuals, HHS, or media, if applicable. Tracks compliance with breach notification timelines.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentRecordType rdf:type rdf:Property ;
    rdfs:label 'Consent Record Type' ;
    rdfs:comment 'Type of PHI record accessed. Categorizes the nature of protected health information viewed for compliance analysis and minimum necessary reviews. [ENUM-REF-CANDIDATE: clinical_note|lab_result|radiology_report|medication_order|diagnosis|procedure|demographic|insurance|billing|appointment|immunization|allergy|vital_sign|problem_list|care_plan|discharge_summary|operative_note|pathology_report|consent_form — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionRequired rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Required' ;
    rdfs:comment 'Indicates whether corrective action or workforce sanctions are required as a result of this access event. True if the review determined policy violations requiring remediation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveActionTaken rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Taken' ;
    rdfs:comment 'Description of corrective actions or sanctions applied (e.g., counseling, retraining, access suspension, termination). Confidential workforce management information documenting compliance enforcement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataClassification rdf:type rdf:Property ;
    rdfs:label 'Data Classification' ;
    rdfs:comment 'Classification level of the PHI accessed, indicating heightened sensitivity requiring additional protections under federal or state law (e.g., 42 CFR Part 2 substance abuse records, state mental health laws). [ENUM-REF-CANDIDATE: phi|sensitive_phi|substance_abuse|mental_health|hiv_aids|genetic|reproductive_health — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureTrackingRequired rdf:type rdf:Property ;
    rdfs:label 'Disclosure Tracking Required' ;
    rdfs:comment 'Indicates whether this access event must be tracked as a disclosure for patient accounting of disclosures purposes under HIPAA. True for disclosures outside of treatment, payment, and operations.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Access Flag' ;
    rdfs:comment 'Indicates whether this was an emergency or break-the-glass access event where normal access controls were overridden for patient safety reasons. True for emergency access requiring post-hoc review.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:flagReason rdf:type rdf:Property ;
    rdfs:label 'Flag Reason' ;
    rdfs:comment 'Reason why the access was flagged for review (e.g., no patient relationship, VIP patient access, excessive access volume, after-hours access, break-the-glass override). Guides privacy officer investigation priorities.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flaggedForReview rdf:type rdf:Property ;
    rdfs:label 'Flagged For Review' ;
    rdfs:comment 'Indicates whether this access event was flagged by automated monitoring rules for privacy officer review. True if the access triggered compliance alerts based on access patterns, break-the-glass scenarios, or policy violations.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientConsentOnFile rdf:type rdf:Property ;
    rdfs:label 'Patient Consent On File' ;
    rdfs:comment 'Indicates whether valid patient consent or authorization was on file at the time of access, if required. Used to validate compliance with consent requirements for specific uses and disclosures.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patientRelationship rdf:type rdf:Property ;
    rdfs:label 'Patient Relationship' ;
    rdfs:comment 'Nature of the users relationship to the patient at the time of access. Used to assess appropriateness of access based on legitimate need-to-know and minimum necessary principles. [ENUM-REF-CANDIDATE: direct_care_provider|care_team_member|consulting_provider|administrative_staff|billing_staff|no_relationship|emergency_access — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDate rdf:type rdf:Property ;
    rdfs:label 'Review Date' ;
    rdfs:comment 'Date when the compliance review of this access event was completed. Used to track review timeliness and compliance program effectiveness.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewNotes rdf:type rdf:Property ;
    rdfs:label 'Review Notes' ;
    rdfs:comment 'Confidential notes documented by the privacy officer during the review of this access event. Contains investigation findings, user explanations, and compliance determinations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewedBy rdf:type rdf:Property ;
    rdfs:label 'Reviewed By' ;
    rdfs:comment 'Name or identifier of the privacy officer or compliance staff member who reviewed this access event. Establishes accountability for compliance review activities.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionCode rdf:type rdf:Property ;
    rdfs:label 'Session Code' ;
    rdfs:comment 'Unique identifier for the user session during which the access occurred. Enables correlation of multiple access events within a single login session.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemAccessed rdf:type rdf:Property ;
    rdfs:label 'System Accessed' ;
    rdfs:comment 'Name or identifier of the electronic health information system accessed (e.g., Epic EHR, Cerner Millennium, PACS, LIS). Identifies the source system containing the ePHI.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemModule rdf:type rdf:Property ;
    rdfs:label 'System Module' ;
    rdfs:comment 'Specific module or application within the system accessed (e.g., ClinDoc, Orders, Beaker, PowerChart). Provides granular detail on the type of PHI accessed.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:userDepartment rdf:type rdf:Property ;
    rdfs:label 'User Department' ;
    rdfs:comment 'Department or organizational unit to which the accessing user belongs. Supports departmental compliance reporting and access pattern analysis.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:userName rdf:type rdf:Property ;
    rdfs:label 'User Name' ;
    rdfs:comment 'Full name of the user who accessed the PHI. Captured for human-readable audit reporting and privacy officer investigations.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:userRole rdf:type rdf:Property ;
    rdfs:label 'User Role' ;
    rdfs:comment 'Job role or function of the user at the time of access (e.g., Physician, Nurse, Billing Specialist, Registration Clerk). Used to assess appropriateness of access based on role-based access control policies.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationType rdf:type rdf:Property ;
    rdfs:label 'Violation Type' ;
    rdfs:comment 'Type of HIPAA violation identified during review, if applicable (e.g., unauthorized access, snooping, minimum necessary violation, breach of confidentiality). Used for workforce sanctions and corrective action tracking.' ;
    rdfs:domain ind:PhiAccessLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workstationCode rdf:type rdf:Property ;
    rdfs:label 'Workstation Code' ;
    rdfs:comment 'Identifier of the physical or virtual workstation from which the access occurred. Supports technical security investigations and physical safeguard compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestationId rdf:type rdf:Property ;
    rdfs:label 'Attestation Id' ;
    rdfs:comment 'Unique identifier for the compliance attestation record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Attestation .

ind:attestationEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Attestation Employee Id' ;
    rdfs:comment 'Identifier of the workforce member submitting the attestation. Links to the employee or medical staff member making the formal certification.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:reattestedAttestationId rdf:type rdf:Property ;
    rdfs:label 'Reattested Attestation Id' ;
    rdfs:comment 'Self-referencing FK on attestation (reattested_attestation_id)' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Attestation .

ind:acknowledgmentFlag rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Flag' ;
    rdfs:comment 'Indicates whether the attesting individual has acknowledged receipt and understanding of the policy or requirement. True if acknowledged, False otherwise.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attestationNumber rdf:type rdf:Property ;
    rdfs:label 'Attestation Number' ;
    rdfs:comment 'Business-facing unique identifier or tracking number for the attestation, used for reference in compliance documentation and audit trails.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestationScope rdf:type rdf:Property ;
    rdfs:label 'Attestation Scope' ;
    rdfs:comment 'Description of the scope or coverage of the attestation. Defines what activities, locations, or responsibilities are covered by this certification.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestationStatus rdf:type rdf:Property ;
    rdfs:label 'Attestation Status' ;
    rdfs:comment 'Current lifecycle state of the attestation. Tracks whether the certification is awaiting submission, has been completed, is past due, or has been rejected.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestationType rdf:type rdf:Property ;
    rdfs:label 'Attestation Type' ;
    rdfs:comment 'Category of attestation being submitted. Defines the specific compliance requirement or policy being certified.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestingIndividualDepartment rdf:type rdf:Property ;
    rdfs:label 'Attesting Individual Department' ;
    rdfs:comment 'Department or organizational unit to which the attesting individual belongs. Used for compliance reporting and departmental attestation tracking.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestingIndividualEmail rdf:type rdf:Property ;
    rdfs:label 'Attesting Individual Email' ;
    rdfs:comment 'Email address of the person submitting the attestation. Used for communication, reminders, and audit trail documentation.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestingIndividualName rdf:type rdf:Property ;
    rdfs:label 'Attesting Individual Name' ;
    rdfs:comment 'Full name of the person submitting the attestation. Captured for audit trail and compliance documentation purposes.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestingIndividualTitle rdf:type rdf:Property ;
    rdfs:label 'Attesting Individual Title' ;
    rdfs:comment 'Job title or role of the person submitting the attestation at the time of certification. Provides context for the authority and scope of the attestation.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electronicSignatureReference rdf:type rdf:Property ;
    rdfs:label 'Electronic Signature Reference' ;
    rdfs:comment 'Reference identifier or token for the electronic signature applied to the attestation. Links to the digital signature system for non-repudiation and legal validity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextRecertificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Recertification Due Date' ;
    rdfs:comment 'Date by which the next recertification attestation must be submitted. Used to schedule and track recurring compliance certifications.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodEndDate rdf:type rdf:Property ;
    rdfs:label 'Period End Date' ;
    rdfs:comment 'Ending date of the time period covered by this attestation. Defines when the compliance certification period concludes.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodStartDate rdf:type rdf:Property ;
    rdfs:label 'Period Start Date' ;
    rdfs:comment 'Beginning date of the time period covered by this attestation. Defines the effective start of the compliance certification period.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recertificationFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Recertification Frequency Months' ;
    rdfs:comment 'Number of months between required recertifications for this attestation type. Null if recertification is not required.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recertificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Recertification Required Flag' ;
    rdfs:comment 'Indicates whether this attestation requires periodic recertification. True if recertification is required, False if it is a one-time attestation.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signatureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Signature Timestamp' ;
    rdfs:comment 'Precise date and time when the electronic signature was applied to the attestation. Provides legal timestamp for compliance and audit purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:statement rdf:type rdf:Property ;
    rdfs:label 'Statement' ;
    rdfs:comment 'Full text of the attestation statement or certification language that the individual is affirming. Captures the exact wording of the compliance commitment.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingCompletionFlag rdf:type rdf:Property ;
    rdfs:label 'Training Completion Flag' ;
    rdfs:comment 'Indicates whether required training associated with this attestation has been completed. True if training is complete, False otherwise.' ;
    rdfs:domain ind:Attestation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supersededRegulatoryChangeId rdf:type rdf:Property ;
    rdfs:label 'Superseded Regulatory Change Id' ;
    rdfs:comment 'Self-referencing FK on regulatory_change (superseded_regulatory_change_id)' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryChange .

ind:actualCostAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Cost Amount' ;
    rdfs:comment 'Actual financial cost incurred by the organization for implementing this regulatory change.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:affectedCompliancePrograms rdf:type rdf:Property ;
    rdfs:label 'Affected Compliance Programs' ;
    rdfs:comment 'Comma-separated list or description of all compliance programs impacted by this regulatory change.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedFacilities rdf:type rdf:Property ;
    rdfs:label 'Affected Facilities' ;
    rdfs:comment 'List or description of healthcare facilities affected by this regulatory change.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedSystems rdf:type rdf:Property ;
    rdfs:label 'Affected Systems' ;
    rdfs:comment 'Information systems and applications that require modification to comply with this regulatory change (e.g., EHR, billing system, reporting tools).' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedDepartment rdf:type rdf:Property ;
    rdfs:label 'Assigned Department' ;
    rdfs:comment 'The primary department responsible for implementing the regulatory change.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeDescription rdf:type rdf:Property ;
    rdfs:label 'Change Description' ;
    rdfs:comment 'Detailed description of the regulatory change, including what is being modified, added, or removed.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeNumber rdf:type rdf:Property ;
    rdfs:label 'Change Number' ;
    rdfs:comment 'Business identifier for the regulatory change, typically assigned by the compliance office or derived from the regulatory bodys reference number.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeTitle rdf:type rdf:Property ;
    rdfs:label 'Change Title' ;
    rdfs:comment 'The official title or name of the regulatory change as published by the regulatory body.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeType rdf:type rdf:Property ;
    rdfs:label 'Change Type' ;
    rdfs:comment 'The nature of the regulatory change being tracked.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Comment Period End Date' ;
    rdfs:comment 'The deadline by which public comments must be submitted to the regulatory body.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Comment Period Start Date' ;
    rdfs:comment 'The date when the public comment period opens for proposed regulatory changes.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commentSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Comment Submission Date' ;
    rdfs:comment 'The date when organizational comments were submitted to the regulatory body.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commentSubmittedFlag rdf:type rdf:Property ;
    rdfs:label 'Comment Submitted Flag' ;
    rdfs:comment 'Indicates whether the organization submitted comments during the public comment period.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commentSummary rdf:type rdf:Property ;
    rdfs:label 'Comment Summary' ;
    rdfs:comment 'Summary of the comments submitted by the organization during the comment period.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentUrl rdf:type rdf:Property ;
    rdfs:label 'Document Url' ;
    rdfs:comment 'URL or file path to the official regulatory change document or Federal Register notice.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCostAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Amount' ;
    rdfs:comment 'Estimated financial cost to the organization for implementing this regulatory change, including system modifications, training, and process changes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalConsultationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'External Consultation Required Flag' ;
    rdfs:comment 'Indicates whether external legal or compliance consultation was or will be required for this regulatory change.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impactAssessmentCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment Completion Date' ;
    rdfs:comment 'The date when the impact assessment was completed.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:impactAssessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment Status' ;
    rdfs:comment 'Current status of the organizational impact assessment for this regulatory change.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactSummary rdf:type rdf:Property ;
    rdfs:label 'Impact Summary' ;
    rdfs:comment 'Summary of the organizational impact including affected departments, systems, processes, and estimated effort.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Implementation Completion Date' ;
    rdfs:comment 'The date when all implementation activities were completed and verified.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:implementationDeadline rdf:type rdf:Property ;
    rdfs:label 'Implementation Deadline' ;
    rdfs:comment 'The date by which the organization must have fully implemented the regulatory change to achieve compliance.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:implementationStartDate rdf:type rdf:Property ;
    rdfs:label 'Implementation Start Date' ;
    rdfs:comment 'The date when implementation activities began.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:implementationStatus rdf:type rdf:Property ;
    rdfs:label 'Implementation Status' ;
    rdfs:comment 'Current status of the organizations implementation of the regulatory change. [ENUM-REF-CANDIDATE: identified|under review|planning|in progress|implemented|verified|closed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalDocumentationUrl rdf:type rdf:Property ;
    rdfs:label 'Internal Documentation Url' ;
    rdfs:comment 'URL or file path to internal organizational documentation related to this regulatory change (impact assessments, implementation plans, meeting notes).' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Monitoring Required Flag' ;
    rdfs:comment 'Indicates whether ongoing monitoring is required after implementation to ensure sustained compliance.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Exposure Amount' ;
    rdfs:comment 'Estimated financial penalty exposure if the organization fails to comply with this regulatory change.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyUpdatesRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Policy Updates Required Flag' ;
    rdfs:comment 'Indicates whether organizational policies must be updated to comply with this regulatory change.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryFramework rdf:type rdf:Property ;
    rdfs:label 'Regulatory Framework' ;
    rdfs:comment 'The overarching regulatory framework or program under which this change falls (e.g., HIPAA, CMS Conditions of Participation, Joint Commission Standards, OSHA Healthcare Worker Safety).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseActionsRequired rdf:type rdf:Property ;
    rdfs:label 'Response Actions Required' ;
    rdfs:comment 'Description of the specific actions the organization must take to comply with the regulatory change (e.g., policy updates, system changes, training, reporting modifications).' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededRegulation rdf:type rdf:Property ;
    rdfs:label 'Superseded Regulation' ;
    rdfs:comment 'Reference to the previous regulation or standard that this change supersedes or replaces.' ;
    rdfs:domain ind:RegulatoryChange ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpMonitoringActivityId rdf:type rdf:Property ;
    rdfs:label 'Follow Up Monitoring Activity Id' ;
    rdfs:comment 'Self-referencing FK on monitoring_activity (follow_up_monitoring_activity_id)' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MonitoringActivity .

ind:monitoringCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Monitoring Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Monitoring activities consume departmental resources. Monitoring costs (staff time, audit tools, sampling) should be tracked against the responsible cost centers budget for cost allocation, program e' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:activityName rdf:type rdf:Property ;
    rdfs:label 'Activity Name' ;
    rdfs:comment 'Descriptive name or title of the monitoring activity that clearly identifies the focus and scope of the review.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityNumber rdf:type rdf:Property ;
    rdfs:label 'Activity Number' ;
    rdfs:comment 'Business-facing unique identifier or tracking number assigned to the monitoring activity for reference and reporting purposes.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityStatus rdf:type rdf:Property ;
    rdfs:label 'Activity Status' ;
    rdfs:comment 'Current lifecycle status of the monitoring activity indicating its progress through the monitoring workflow.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityType rdf:type rdf:Property ;
    rdfs:label 'Activity Type' ;
    rdfs:comment 'Classification of the monitoring activity by its primary focus area. Supports categorization and trend analysis of compliance monitoring efforts. [ENUM-REF-CANDIDATE: medical_record_review|hipaa_access_audit|billing_compliance_spot_check|coding_accuracy_review|policy_adherence_observation|department_self_assessment|claims_audit|documentation_review|privacy_monitoring|security_monitoring|quality_review|operational_audit — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Completion Date' ;
    rdfs:comment 'The actual date when the monitoring activity was completed. Used to track schedule adherence and cycle time metrics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualStartDate rdf:type rdf:Property ;
    rdfs:label 'Actual Start Date' ;
    rdfs:comment 'The actual date when the monitoring activity execution began. Used to track schedule adherence and performance metrics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Compliance Rate Percentage' ;
    rdfs:comment 'Calculated percentage representing the proportion of reviewed items that were found to be compliant with the applicable standard or requirement. Key performance indicator for compliance effectiveness.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:correctiveActionPlanRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Required Flag' ;
    rdfs:comment 'Indicates whether a formal corrective action plan is required to address the issues identified during the monitoring activity.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalIssuesCount rdf:type rdf:Property ;
    rdfs:label 'Critical Issues Count' ;
    rdfs:comment 'The number of issues identified that are classified as critical or high-severity, requiring immediate attention and remediation.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:departmentMonitored rdf:type rdf:Property ;
    rdfs:label 'Department Monitored' ;
    rdfs:comment 'The name of the department, unit, or functional area that is the subject of the monitoring activity.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalAuditorInvolvementFlag rdf:type rdf:Property ;
    rdfs:label 'External Auditor Involvement Flag' ;
    rdfs:comment 'Indicates whether external auditors or consultants participated in or reviewed the monitoring activity.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalAuditorOrganization rdf:type rdf:Property ;
    rdfs:label 'External Auditor Organization' ;
    rdfs:comment 'Name of the external auditing firm or consulting organization involved in the monitoring activity, if applicable.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpActionDescription rdf:type rdf:Property ;
    rdfs:label 'Follow Up Action Description' ;
    rdfs:comment 'Detailed description of the follow-up actions, corrective measures, or remediation steps required or recommended based on the monitoring findings.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuesIdentifiedCount rdf:type rdf:Property ;
    rdfs:label 'Issues Identified Count' ;
    rdfs:comment 'The total number of compliance issues, deficiencies, or non-conformances identified during the monitoring activity.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leadMonitorName rdf:type rdf:Property ;
    rdfs:label 'Lead Monitor Name' ;
    rdfs:comment 'Full name of the employee leading the monitoring activity. Provides quick reference without requiring a join to the employee table.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringMethodology rdf:type rdf:Property ;
    rdfs:label 'Monitoring Methodology' ;
    rdfs:comment 'Description of the approach, techniques, and procedures used to conduct the monitoring activity (e.g., random sampling, targeted review, automated scanning, observation).' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Monitoring Period End Date' ;
    rdfs:comment 'The ending date of the time period being reviewed or monitored for compliance. Defines the temporal scope of the monitoring activity.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:monitoringPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Monitoring Period Start Date' ;
    rdfs:comment 'The beginning date of the time period being reviewed or monitored for compliance. Defines the temporal scope of the monitoring activity.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:monitoringTeamSize rdf:type rdf:Property ;
    rdfs:label 'Monitoring Team Size' ;
    rdfs:comment 'The number of individuals involved in conducting the monitoring activity. Used for resource planning and workload analysis.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:populationSize rdf:type rdf:Property ;
    rdfs:label 'Population Size' ;
    rdfs:comment 'The total number of records, transactions, or cases in the population from which the sample was drawn.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:processMonitored rdf:type rdf:Property ;
    rdfs:label 'Process Monitored' ;
    rdfs:comment 'Description of the specific business process, workflow, or operational activity being monitored for compliance (e.g., patient registration, order entry, billing submission).' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportDocumentPath rdf:type rdf:Property ;
    rdfs:label 'Report Document Path' ;
    rdfs:comment 'File system path or URL to the detailed monitoring activity report document for reference and audit trail purposes.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportIssuedDate rdf:type rdf:Property ;
    rdfs:label 'Report Issued Date' ;
    rdfs:comment 'The date when the formal monitoring activity report was issued or published to stakeholders.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sampleSize rdf:type rdf:Property ;
    rdfs:label 'Sample Size' ;
    rdfs:comment 'The number of records, transactions, or cases reviewed as part of the monitoring activity. Used to assess statistical validity and coverage.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduledCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Completion Date' ;
    rdfs:comment 'The planned date by which the monitoring activity is expected to be completed.' ;
    rdfs:domain ind:MonitoringActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledStartDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Date' ;
    rdfs:comment 'The planned date when the monitoring activity is scheduled to begin execution.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:programPolicyAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Program Policy Assignment Id' ;
    rdfs:comment 'Unique identifier for this program-policy assignment record. Primary key.' ;
    rdfs:domain ind:ProgramPolicyAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryComplianceProgramId rdf:type rdf:Property ;
    rdfs:label 'Primary Compliance Program Id' ;
    rdfs:comment 'Foreign key to compliance_program. Identifies which compliance program this policy is assigned to.' ;
    rdfs:domain ind:ProgramPolicyAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceProgram .

ind:assignedBy rdf:type rdf:Property ;
    rdfs:label 'Assigned By' ;
    rdfs:comment 'Name or role of the individual or committee that assigned this policy to this compliance program (e.g., Chief Compliance Officer, Compliance Committee).' ;
    rdfs:domain ind:ProgramPolicyAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programScopeApplicability rdf:type rdf:Property ;
    rdfs:label 'Program Scope Applicability' ;
    rdfs:comment 'Description of how this policy applies within the scope of this specific compliance program. Captures program-specific applicability rules, exceptions, or scope limitations that may not apply when the same policy is governed under a different program.' ;
    rdfs:domain ind:ProgramPolicyAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerAssignmentDate rdf:type rdf:Property ;
    rdfs:label 'Provider Assignment Date' ;
    rdfs:comment 'Date when this policy was formally assigned to this compliance program. Tracks the governance decision date.' ;
    rdfs:domain ind:ProgramPolicyAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:providerAssignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Provider Assignment Status' ;
    rdfs:comment 'Current status of this program-policy assignment. Active assignments are in effect; suspended assignments are temporarily inactive; retired assignments are no longer in effect; under_review assignments are being evaluated for continued relevance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyRegulatoryImpactId rdf:type rdf:Property ;
    rdfs:label 'Policy Regulatory Impact Id' ;
    rdfs:comment 'Unique identifier for this policy regulatory impact record. Primary key.' ;
    rdfs:domain ind:PolicyRegulatoryImpact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:changeSummary rdf:type rdf:Property ;
    rdfs:label 'Change Summary' ;
    rdfs:comment 'Summary of the specific changes made to this policy in response to this regulatory change. Describes what was added, modified, or removed from the policy to achieve compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment Date' ;
    rdfs:comment 'The date when the impact assessment for this regulatory change on this specific policy was completed.' ;
    rdfs:domain ind:PolicyRegulatoryImpact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:implementationDate rdf:type rdf:Property ;
    rdfs:label 'Implementation Date' ;
    rdfs:comment 'The date when the policy changes required by this regulatory change were fully implemented and operationalized across the organization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyVersionCreated rdf:type rdf:Property ;
    rdfs:label 'Policy Version Created' ;
    rdfs:comment 'The version number of the policy that was created or updated as a result of this regulatory change. Links the regulatory change to the specific policy version it triggered.' ;
    rdfs:domain ind:PolicyRegulatoryImpact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseType rdf:type rdf:Property ;
    rdfs:label 'Response Type' ;
    rdfs:comment 'The type of policy action taken in response to this regulatory change. Indicates whether a new policy was created, an existing policy was updated, a policy was retired, or no policy action was required.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyPayerApplicabilityId rdf:type rdf:Property ;
    rdfs:label 'Policy Payer Applicability Id' ;
    rdfs:comment 'Unique identifier for this policy-payer applicability record. Primary key.' ;
    rdfs:domain ind:PolicyPayerApplicability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attestationRequired rdf:type rdf:Property ;
    rdfs:label 'Attestation Required' ;
    rdfs:comment 'Indicates whether the payer is required to formally attest to compliance with this policy as part of the contractual relationship. True for policies with regulatory or contractual attestation requirements.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastComplianceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Compliance Review Date' ;
    rdfs:comment 'Date on which compliance with this policy was most recently assessed for this payer relationship. Used for audit tracking and review cycle management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextComplianceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Compliance Review Date' ;
    rdfs:comment 'Scheduled date for the next compliance review of this payer against this policy. Calculated based on policy review cycle and payer contract terms.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payerAcknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Payer Acknowledgment Date' ;
    rdfs:comment 'Date on which the payer formally acknowledged receipt and acceptance of this policy as part of the contractual relationship. Required for contract compliance and audit trail.' ;
    rdfs:domain ind:PolicyPayerApplicability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payerSpecificVersion rdf:type rdf:Property ;
    rdfs:label 'Payer Specific Version' ;
    rdfs:comment 'Version identifier for the payer-specific adaptation or addendum to the base policy. Some payers require customized policy language or additional requirements beyond the base organizational policy.' ;
    rdfs:domain ind:PolicyPayerApplicability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverApprovalAuthority rdf:type rdf:Property ;
    rdfs:label 'Waiver Approval Authority' ;
    rdfs:comment 'Individual, role, or committee that approved the waiver for this payer-policy combination. Nullable if no waiver granted.' ;
    rdfs:domain ind:PolicyPayerApplicability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverGrantedFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Granted Flag' ;
    rdfs:comment 'Indicates whether a formal waiver or exception has been granted exempting this payer from this policy requirement. True indicates waiver in effect.' ;
    rdfs:domain ind:PolicyPayerApplicability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverJustification rdf:type rdf:Property ;
    rdfs:label 'Waiver Justification' ;
    rdfs:comment 'Business or regulatory justification for granting a waiver exempting this payer from this policy. Nullable if no waiver granted. Required for audit and governance documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Id' ;
    rdfs:comment 'Primary key for regulatory_requirement' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryRequirement .

ind:parentRegulatoryRequirementId rdf:type rdf:Property ;
    rdfs:label 'Parent Regulatory Requirement Id' ;
    rdfs:comment 'Self-referencing FK on regulatory_requirement (parent_regulatory_requirement_id)' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryRequirement .

ind:primarySupersededByRequirementRegulatoryRequirementId rdf:type rdf:Property ;
    rdfs:label 'Primary Superseded By Requirement Regulatory Requirement Id' ;
    rdfs:comment 'Identifier of the regulatory requirement that supersedes this requirement, if applicable. Null if not superseded.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryRequirement .

ind:applicabilityScope rdf:type rdf:Property ;
    rdfs:label 'Applicability Scope' ;
    rdfs:comment 'Description of which organizational units, facilities, or business processes this requirement applies to (e.g., all hospitals, outpatient clinics only, laboratories, covered entities).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditRequired rdf:type rdf:Property ;
    rdfs:label 'Audit Required' ;
    rdfs:comment 'Indicates whether periodic audits or assessments are required to verify compliance with this requirement (True) or not (False).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceFrequency rdf:type rdf:Property ;
    rdfs:label 'Compliance Frequency' ;
    rdfs:comment 'Frequency at which compliance with this requirement must be demonstrated or assessed (e.g., continuous, annual, quarterly, monthly, event-driven, one-time).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlFramework rdf:type rdf:Property ;
    rdfs:label 'Control Framework' ;
    rdfs:comment 'Name of the internal control framework or compliance program that governs this requirement (e.g., HIPAA Compliance Program, Patient Safety Program, Infection Control Program).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationRetentionYears rdf:type rdf:Property ;
    rdfs:label 'Documentation Retention Years' ;
    rdfs:comment 'Number of years that documentation demonstrating compliance with this requirement must be retained.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:implementationGuidance rdf:type rdf:Property ;
    rdfs:label 'Implementation Guidance' ;
    rdfs:comment 'Guidance notes or instructions for implementing this requirement within the organization.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdiction rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction' ;
    rdfs:comment 'Geographic or governmental scope of the requirement: federal, state, local, or international.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionDetail rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Detail' ;
    rdfs:comment 'Specific jurisdiction detail (e.g., state name, country code) when the requirement applies to a specific geographic area.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReviewedDate rdf:type rdf:Property ;
    rdfs:label 'Last Reviewed Date' ;
    rdfs:comment 'Date when this regulatory requirement record was last reviewed for accuracy and currency.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:penaltyAmountMax rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount Max' ;
    rdfs:comment 'Maximum monetary penalty amount for noncompliance, if applicable. Null if no monetary penalty or penalty is not quantified.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyAmountMin rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount Min' ;
    rdfs:comment 'Minimum monetary penalty amount for noncompliance, if applicable. Null if no monetary penalty or penalty is not quantified.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyForNoncompliance rdf:type rdf:Property ;
    rdfs:label 'Penalty For Noncompliance' ;
    rdfs:comment 'Description of penalties, fines, sanctions, or enforcement actions that may result from noncompliance with this requirement.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulationCitation rdf:type rdf:Property ;
    rdfs:label 'Regulation Citation' ;
    rdfs:comment 'Full legal citation or reference to the regulation section (e.g., 45 CFR 164.308(a)(1)(i), 42 CFR 482.13, 29 CFR 1910.1030).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulationName rdf:type rdf:Property ;
    rdfs:label 'Regulation Name' ;
    rdfs:comment 'Name of the parent regulation, standard, or framework to which this requirement belongs (e.g., HIPAA Privacy Rule, CMS Conditions of Participation, Joint Commission National Patient Safety Goals).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Status' ;
    rdfs:comment 'Current lifecycle status of the regulatory requirement.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedRequirements rdf:type rdf:Property ;
    rdfs:label 'Related Requirements' ;
    rdfs:comment 'Comma-separated list of related requirement codes or identifiers that are connected to or dependent on this requirement.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingRequired rdf:type rdf:Property ;
    rdfs:label 'Reporting Required' ;
    rdfs:comment 'Indicates whether this requirement mandates formal reporting to a regulatory body (True) or not (False).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requirementCategory rdf:type rdf:Property ;
    rdfs:label 'Requirement Category' ;
    rdfs:comment 'High-level classification of the regulatory requirement by domain (e.g., privacy, security, safety, quality, operational, financial, reporting).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementCode rdf:type rdf:Property ;
    rdfs:label 'Requirement Code' ;
    rdfs:comment 'Externally-known unique code or identifier for the regulatory requirement (e.g., HIPAA-164.308, CMS-CoP-482.13, OSHA-1910.1030).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementDescription rdf:type rdf:Property ;
    rdfs:label 'Requirement Description' ;
    rdfs:comment 'Detailed description of the regulatory requirement, including scope, obligations, and compliance expectations.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementTitle rdf:type rdf:Property ;
    rdfs:label 'Requirement Title' ;
    rdfs:comment 'Human-readable title or name of the regulatory requirement.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementType rdf:type rdf:Property ;
    rdfs:label 'Requirement Type' ;
    rdfs:comment 'Classification of the requirement by enforcement level: mandatory (must comply), conditional (applies under certain conditions), recommended (best practice), or voluntary (optional).' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Source Document Url' ;
    rdfs:comment 'URL or hyperlink to the official source document or regulatory text for this requirement.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingFrequency rdf:type rdf:Property ;
    rdfs:label 'Training Frequency' ;
    rdfs:comment 'Frequency at which staff training must be completed for this requirement, if training is required.' ;
    rdfs:domain ind:RegulatoryRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingRequired rdf:type rdf:Property ;
    rdfs:label 'Training Required' ;
    rdfs:comment 'Indicates whether staff training is required to comply with this requirement (True) or not (False).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:generalLedgerId rdf:type rdf:Property ;
    rdfs:label 'General Ledger Id' ;
    rdfs:comment 'Unique identifier for the general ledger. Primary key for the general ledger data product.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeneralLedger .

ind:parentGeneralLedgerId rdf:type rdf:Property ;
    rdfs:label 'Parent General Ledger Id' ;
    rdfs:comment 'Self-referencing FK on general_ledger (parent_general_ledger_id)' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeneralLedger .

ind:accountingBasis rdf:type rdf:Property ;
    rdfs:label 'Accounting Basis' ;
    rdfs:comment 'The fundamental accounting method applied to this ledger. Accrual basis recognizes revenue when earned and expenses when incurred, cash basis recognizes transactions when cash changes hands, and modified accrual is a hybrid approach used primarily in governmental accounting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrailLevel rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Level' ;
    rdfs:comment 'The level of audit trail detail maintained for this ledger. None indicates no audit logging, summary captures high-level changes, detailed tracks all field-level modifications, and comprehensive includes full before/after values and user context.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetControlEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Budget Control Enabled Flag' ;
    rdfs:comment 'Indicates whether budget control and funds management is enabled for this ledger. When true, transactions are validated against available budget before posting to prevent overspending.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consolidationGroupCode rdf:type rdf:Property ;
    rdfs:label 'Consolidation Group Code' ;
    rdfs:comment 'The code identifying the consolidation group to which this ledger belongs. Used to aggregate financial results across multiple legal entities or business units for enterprise-wide reporting.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Cost Center Enabled Flag' ;
    rdfs:comment 'Indicates whether cost center accounting is enabled for this ledger. When true, all journal entries must include cost center assignments for departmental expense tracking and allocation.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fiscalYearStartMonth rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year Start Month' ;
    rdfs:comment 'The calendar month (1-12) in which the fiscal year begins for this ledger. Used to align financial periods with organizational planning cycles and regulatory reporting requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalYearVariant rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year Variant' ;
    rdfs:comment 'The fiscal calendar configuration code defining the number of periods, period lengths, and special period rules for this ledger. Aligns with enterprise resource planning system fiscal calendar structures.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Functional Currency Code' ;
    rdfs:comment 'The three-letter ISO 4217 currency code representing the primary currency in which this ledger operates and reports financial results. All transactions are translated to this currency for consolidation and reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generalLedgerDescription rdf:type rdf:Property ;
    rdfs:label 'General Ledger Description' ;
    rdfs:comment 'A detailed narrative description of the general ledgers purpose, scope, and usage within the healthcare organizations financial management framework. Provides context for financial analysts and auditors.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intercompanyEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Intercompany Enabled Flag' ;
    rdfs:comment 'Indicates whether intercompany transaction tracking is enabled for this ledger. When true, transactions between legal entities are identified and reconciled for consolidated financial reporting.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastClosedPeriod rdf:type rdf:Property ;
    rdfs:label 'Last Closed Period' ;
    rdfs:comment 'The most recent fiscal period (YYYY-MM format) that has been closed for this ledger. Closed periods are locked from further posting to ensure financial statement integrity.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPostingDate rdf:type rdf:Property ;
    rdfs:label 'Last Posting Date' ;
    rdfs:comment 'The date of the most recent journal entry posted to this ledger. Used to monitor ledger activity and identify dormant or inactive ledgers.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leadingLedgerFlag rdf:type rdf:Property ;
    rdfs:label 'Leading Ledger Flag' ;
    rdfs:comment 'Indicates whether this is the leading (primary) ledger for the organization. The leading ledger serves as the authoritative source for financial reporting and drives consolidation processes.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ledgerCode rdf:type rdf:Property ;
    rdfs:label 'Ledger Code' ;
    rdfs:comment 'The unique alphanumeric code identifying this general ledger within the enterprise chart of accounts structure. Used as the business identifier for journal entry postings and financial reporting.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ledgerName rdf:type rdf:Property ;
    rdfs:label 'Ledger Name' ;
    rdfs:comment 'The full descriptive name of the general ledger, providing human-readable identification for financial reporting and analysis.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ledgerStatus rdf:type rdf:Property ;
    rdfs:label 'Ledger Status' ;
    rdfs:comment 'Current operational state of the general ledger. Active ledgers accept new postings, inactive ledgers are temporarily disabled, closed ledgers are finalized for a fiscal period, suspended ledgers are under review or audit, and archived ledgers are retained for historical reference only.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ledgerType rdf:type rdf:Property ;
    rdfs:label 'Ledger Type' ;
    rdfs:comment 'Classification of the general ledger by its primary purpose. Corporate ledgers support consolidated financial statements, management ledgers support internal decision-making, statutory ledgers meet regulatory reporting requirements, consolidation ledgers aggregate multi-entity financials, budget ledgers track planned allocations, and forecast ledgers project future performance.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parallelAccountingEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Parallel Accounting Enabled Flag' ;
    rdfs:comment 'Indicates whether parallel accounting is enabled, allowing simultaneous posting to multiple ledgers with different accounting principles (e.g., GAAP and IFRS). Supports organizations with multi-jurisdictional reporting requirements.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:profitCenterEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Profit Center Enabled Flag' ;
    rdfs:comment 'Indicates whether profit center accounting is enabled for this ledger. When true, revenue and expense transactions are tracked by profit center for segment profitability analysis.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:projectAccountingEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Project Accounting Enabled Flag' ;
    rdfs:comment 'Indicates whether project-based accounting is enabled for this ledger. When true, costs and revenues can be tracked at the project level for capital budgeting and grant management.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingEntityCode rdf:type rdf:Property ;
    rdfs:label 'Reporting Entity Code' ;
    rdfs:comment 'The code identifying the reporting entity for external financial statement preparation. Maps this ledger to the appropriate regulatory and stakeholder reporting requirements.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentReportingEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Segment Reporting Enabled Flag' ;
    rdfs:comment 'Indicates whether segment reporting dimensions are enabled for this ledger. When true, financial results can be analyzed by business segment for FASB ASC 280 segment disclosure requirements.' ;
    rdfs:domain ind:GeneralLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Parent Chart Of Accounts Id' ;
    rdfs:comment 'Self-referencing FK on chart_of_accounts (parent_chart_of_accounts_id)' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:accountCategory rdf:type rdf:Property ;
    rdfs:label 'Account Category' ;
    rdfs:comment 'High-level grouping of accounts for reporting and analysis purposes. Examples include patient service revenue, supply expense, labor expense, administrative expense.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountCode rdf:type rdf:Property ;
    rdfs:label 'Account Code' ;
    rdfs:comment 'The unique alphanumeric code identifying the general ledger account. This is the primary business identifier used in journal entries, budgets, and financial statements.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountDescription rdf:type rdf:Property ;
    rdfs:label 'Account Description' ;
    rdfs:comment 'Detailed textual description of the account purpose, usage guidelines, and any special instructions for posting transactions. Provides context for finance staff and auditors.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountName rdf:type rdf:Property ;
    rdfs:label 'Account Name' ;
    rdfs:comment 'The full descriptive name of the general ledger account. Human-readable label used in financial reports and user interfaces.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountOwner rdf:type rdf:Property ;
    rdfs:label 'Account Owner' ;
    rdfs:comment 'The name or identifier of the department, role, or individual responsible for managing and monitoring this account. Supports accountability and financial stewardship.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountStatus rdf:type rdf:Property ;
    rdfs:label 'Account Status' ;
    rdfs:comment 'Current lifecycle status of the account. Active accounts are available for use in transactions; inactive accounts are closed and cannot be used in new entries.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountSubcategory rdf:type rdf:Property ;
    rdfs:label 'Account Subcategory' ;
    rdfs:comment 'Detailed grouping within the account category providing additional analytical granularity. Supports drill-down reporting and variance analysis.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountSubtype rdf:type rdf:Property ;
    rdfs:label 'Account Subtype' ;
    rdfs:comment 'The secondary classification providing additional granularity within the account type. Examples include current asset, fixed asset, operating expense, non-operating revenue, etc.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountType rdf:type rdf:Property ;
    rdfs:label 'Account Type' ;
    rdfs:comment 'The primary classification of the account according to the fundamental accounting equation. Determines which financial statement the account appears on and its natural balance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternateAccountCode rdf:type rdf:Property ;
    rdfs:label 'Alternate Account Code' ;
    rdfs:comment 'An alternate or legacy account code used for cross-reference purposes during system migrations or for integration with external systems.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Approval Required Flag' ;
    rdfs:comment 'Indicates whether transactions posted to this account require additional approval beyond standard posting authority. True for sensitive or high-risk accounts.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:budgetControlFlag rdf:type rdf:Property ;
    rdfs:label 'Budget Control Flag' ;
    rdfs:comment 'Indicates whether transactions against this account are subject to budget availability checking. True for expense accounts with budget controls.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consolidationAccountCode rdf:type rdf:Property ;
    rdfs:label 'Consolidation Account Code' ;
    rdfs:comment 'The account code used in consolidated financial statements when multiple legal entities are combined. Supports multi-entity healthcare system reporting.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Cost Center Applicable Flag' ;
    rdfs:comment 'Indicates whether this account requires a cost center assignment when used in journal entries or budget allocations. True for departmental expense and revenue accounts.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:departmentApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Department Applicable Flag' ;
    rdfs:comment 'Indicates whether this account requires a department assignment when used in transactions. Supports departmental financial reporting and cost allocation.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drgCostAllocationFlag rdf:type rdf:Property ;
    rdfs:label 'Drg Cost Allocation Flag' ;
    rdfs:comment 'Indicates whether costs in this account are allocated to DRG-based cost accounting for case mix analysis and reimbursement optimization.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalReportingCode rdf:type rdf:Property ;
    rdfs:label 'External Reporting Code' ;
    rdfs:comment 'The code or identifier used for external regulatory reporting such as Medicare Cost Reports, state financial reporting, or bond covenant reporting.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialStatementClassification rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Classification' ;
    rdfs:comment 'Identifies which primary financial statement this account appears on. Critical for automated financial statement generation and reporting.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialStatementLineItem rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Line Item' ;
    rdfs:comment 'The specific line item or section within the financial statement where this account balance is reported. Examples include current assets, operating expenses, net patient service revenue.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Fund Applicable Flag' ;
    rdfs:comment 'Indicates whether this account requires a fund assignment for fund accounting purposes. Relevant for healthcare organizations with restricted grants, endowments, or governmental funding.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gaapClassification rdf:type rdf:Property ;
    rdfs:label 'Gaap Classification' ;
    rdfs:comment 'The specific GAAP classification code or category for this account. Ensures compliance with US GAAP financial reporting requirements.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasbClassification rdf:type rdf:Property ;
    rdfs:label 'Gasb Classification' ;
    rdfs:comment 'The GASB classification for governmental and not-for-profit healthcare entities. Applicable for public hospitals and healthcare systems.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intercompanyFlag rdf:type rdf:Property ;
    rdfs:label 'Intercompany Flag' ;
    rdfs:comment 'Indicates whether this account is used for intercompany transactions between legal entities within the healthcare system. Supports consolidation and elimination entries.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:naturalBalance rdf:type rdf:Property ;
    rdfs:label 'Natural Balance' ;
    rdfs:comment 'Indicates whether the account normally carries a debit or credit balance. Assets and expenses have debit natural balances; liabilities, equity, and revenue have credit natural balances.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingRestriction rdf:type rdf:Property ;
    rdfs:label 'Posting Restriction' ;
    rdfs:comment 'Defines restrictions on how transactions can be posted to this account. Manual-only accounts prevent automated postings; system-only accounts prevent manual journal entries.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Project Applicable Flag' ;
    rdfs:comment 'Indicates whether this account can be used for project-based accounting and requires a project code assignment. Common for capital projects, research grants, and special initiatives.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Required Flag' ;
    rdfs:comment 'Indicates whether this account requires periodic reconciliation to external statements or subsidiary ledgers. True for cash, accounts receivable, accounts payable, and other balance sheet accounts.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rollupAccountCode rdf:type rdf:Property ;
    rdfs:label 'Rollup Account Code' ;
    rdfs:comment 'The parent or summary account code to which this account rolls up for consolidated reporting. Supports hierarchical financial statement presentation.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rvuAllocationFlag rdf:type rdf:Property ;
    rdfs:label 'Rvu Allocation Flag' ;
    rdfs:comment 'Indicates whether costs in this account are allocated based on relative value units for physician productivity and compensation analysis.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statisticalAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Statistical Account Flag' ;
    rdfs:comment 'Indicates whether this is a statistical account used to track non-monetary metrics such as patient days, procedures performed, or full-time equivalents (FTEs). Statistical accounts do not carry monetary balances.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxReportingCategory rdf:type rdf:Property ;
    rdfs:label 'Tax Reporting Category' ;
    rdfs:comment 'The tax reporting classification for this account. Used for IRS Form 990 reporting for not-for-profit healthcare entities and other tax compliance purposes.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundId rdf:type rdf:Property ;
    rdfs:label 'Fund Id' ;
    rdfs:comment 'FK to finance.fund' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:generalLedgerChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'General Ledger Chart Of Accounts Id' ;
    rdfs:comment 'Foreign key linking to finance.chart_of_accounts. Business justification: cost_center has general_ledger_account (STRING) which should be normalized to FK to chart_of_accounts. Using general_ledger_chart_of_accounts_id as the FK name to be explicit. Enables joining to get' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:parentCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Parent Cost Center Id' ;
    rdfs:comment 'Reference to the parent cost center in the organizational cost center hierarchy. Enables roll-up reporting and hierarchical cost allocation. Null for top-level cost centers.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:budgetAmount rdf:type rdf:Property ;
    rdfs:label 'Budget Amount' ;
    rdfs:comment 'The approved annual budget allocation for this cost center in US dollars. Used for budget variance analysis, financial planning, and departmental performance measurement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetFiscalYear rdf:type rdf:Property ;
    rdfs:label 'Budget Fiscal Year' ;
    rdfs:comment 'The fiscal year for which the budget amount is allocated. Enables multi-year budget tracking and year-over-year cost center performance comparison.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cmsProviderNumber rdf:type rdf:Property ;
    rdfs:label 'Cms Provider Number' ;
    rdfs:comment 'The CMS-assigned provider number for the facility or organizational unit associated with this cost center. Used for Medicare cost reporting and regulatory compliance.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costAllocationMethod rdf:type rdf:Property ;
    rdfs:label 'Cost Allocation Method' ;
    rdfs:comment 'The methodology used to allocate indirect costs to this cost center. Direct allocation assigns costs directly, step-down allocation cascades costs through support departments, activity-based costing allocates based on resource consumption, and RVU-based allocation uses relative value units for clinical departments.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterCategory rdf:type rdf:Property ;
    rdfs:label 'Cost Center Category' ;
    rdfs:comment 'Additional categorical classification for specialized cost center grouping beyond the primary type. Examples include inpatient, outpatient, emergency, surgical, diagnostic, therapeutic, administrative. Used for detailed financial analysis and reporting.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterCode rdf:type rdf:Property ;
    rdfs:label 'Cost Center Code' ;
    rdfs:comment 'The externally-known unique alphanumeric code identifying the cost center within the healthcare organizations chart of accounts. Used for financial reporting, budget tracking, and departmental cost allocation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterName rdf:type rdf:Property ;
    rdfs:label 'Cost Center Name' ;
    rdfs:comment 'The full descriptive name of the cost center, representing the department, unit, or functional area for which costs are tracked and budgeted.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterStatus rdf:type rdf:Property ;
    rdfs:label 'Cost Center Status' ;
    rdfs:comment 'Current lifecycle status of the cost center. Active cost centers are operational and accepting charges, inactive cost centers are temporarily disabled, pending cost centers are awaiting approval, closed cost centers are permanently retired, and suspended cost centers are on hold pending review.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterType rdf:type rdf:Property ;
    rdfs:label 'Cost Center Type' ;
    rdfs:comment 'Classification of the cost center by its primary business function. Clinical cost centers provide direct patient care, administrative cost centers support operations, ancillary cost centers provide diagnostic or therapeutic services, overhead cost centers represent shared services, support cost centers provide enabling functions, and revenue cost centers generate billable services.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costPerUnit rdf:type rdf:Property ;
    rdfs:label 'Cost Per Unit' ;
    rdfs:comment 'The average cost per unit of service delivered by this cost center. Unit definition varies by cost center type (e.g., cost per patient day, cost per procedure, cost per visit). Used for efficiency benchmarking and pricing analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drgWeight rdf:type rdf:Property ;
    rdfs:label 'Drg Weight' ;
    rdfs:comment 'The average DRG case mix weight for patients treated in this cost center. Used for case mix index calculation, reimbursement analysis, and clinical complexity adjustment. Applicable primarily to inpatient clinical cost centers.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityServiceLine rdf:type rdf:Property ;
    rdfs:label 'Facility Service Line' ;
    rdfs:comment 'The clinical or operational service line to which this cost center contributes. Examples include cardiology, orthopedics, oncology, emergency services, surgical services. Used for service line profitability analysis and strategic planning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fteAllocation rdf:type rdf:Property ;
    rdfs:label 'Fte Allocation' ;
    rdfs:comment 'The approved number of full-time equivalent positions allocated to this cost center. Used for workforce planning, labor cost analysis, and productivity measurement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCapitalIntensive rdf:type rdf:Property ;
    rdfs:label 'Is Capital Intensive' ;
    rdfs:comment 'Indicates whether this cost center requires significant capital equipment investment. True for departments with major medical equipment (e.g., radiology, surgical services, laboratory), false for labor-intensive departments. Used for capital budgeting and depreciation allocation.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDirectPatientCare rdf:type rdf:Property ;
    rdfs:label 'Is Direct Patient Care' ;
    rdfs:comment 'Indicates whether this cost center provides direct patient care services. True for clinical departments with patient contact, false for support and administrative departments. Used for clinical cost allocation and quality reporting.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRevenueGenerating rdf:type rdf:Property ;
    rdfs:label 'Is Revenue Generating' ;
    rdfs:comment 'Indicates whether this cost center generates billable revenue through patient services. True for clinical and ancillary departments that bill for services, false for administrative and overhead departments.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastModifiedBy rdf:type rdf:Property ;
    rdfs:label 'Last Modified By' ;
    rdfs:comment 'The user ID or name of the person who last modified this cost center record. Used for accountability and audit trail purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required' ;
    rdfs:comment 'Indicates whether this cost center is subject to specific regulatory reporting requirements (e.g., CMS cost reports, state health department reporting, Joint Commission reporting). Used for compliance tracking and audit preparation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rvuTarget rdf:type rdf:Property ;
    rdfs:label 'Rvu Target' ;
    rdfs:comment 'The target number of relative value units this cost center is expected to generate annually. Used for physician productivity measurement, reimbursement forecasting, and clinical efficiency analysis. Applicable to clinical cost centers with physician services.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Unit Of Measure' ;
    rdfs:comment 'The unit of service used to measure cost center activity and calculate cost per unit. Examples include patient days, procedures, visits, tests, hours, admissions. Varies by cost center type and service line.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financeJournalEntryId rdf:type rdf:Property ;
    rdfs:label 'Finance Journal Entry Id' ;
    rdfs:comment 'Unique identifier for the journal entry record. Primary key for the journal entry entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceJournalEntry .

ind:financeEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Finance Employee Id' ;
    rdfs:comment 'FK to workforce.employee identifying the primary approver of this journal entry' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:fiscalPeriodId rdf:type rdf:Property ;
    rdfs:label 'Fiscal Period Id' ;
    rdfs:comment 'Foreign key linking to finance.fiscal_period. Business justification: journal_entry has accounting_period (STRING) which should be normalized to FK to fiscal_period master. Enables joining to get period details (start_date, end_date, period_status, close_date) and ensur' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FiscalPeriod .

ind:primaryReversalJournalEntryFinanceJournalEntryId rdf:type rdf:Property ;
    rdfs:label 'Primary Reversal Journal Entry Finance Journal Entry Id' ;
    rdfs:comment 'Reference to the journal entry that reversed this entry, if applicable. Null if the entry has not been reversed.' ;
    rdfs:domain ind:FinanceJournalEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceJournalEntry .

ind:recurringScheduleId rdf:type rdf:Property ;
    rdfs:label 'Recurring Schedule Id' ;
    rdfs:comment 'Identifier of the recurring schedule template from which this entry was generated, if applicable. Null for non-recurring entries.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecurringSchedule .

ind:adjustmentType rdf:type rdf:Property ;
    rdfs:label 'Adjustment Type' ;
    rdfs:comment 'Classification of adjustment entries. Identifies whether the entry is a standard posting, prior period adjustment, audit adjustment, reclassification, or error correction.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:batchCode rdf:type rdf:Property ;
    rdfs:label 'Batch Code' ;
    rdfs:comment 'Identifier for the batch or group of journal entries processed together. Used for bulk posting and batch reconciliation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consolidationIndicator rdf:type rdf:Property ;
    rdfs:label 'Consolidation Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this journal entry is included in consolidated financial reporting. True if included, False if excluded.' ;
    rdfs:domain ind:FinanceJournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:entryDate rdf:type rdf:Property ;
    rdfs:label 'Entry Date' ;
    rdfs:comment 'Date the journal entry was recorded' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exchangeRate rdf:type rdf:Property ;
    rdfs:label 'Exchange Rate' ;
    rdfs:comment 'The foreign exchange rate applied to convert foreign currency amounts to the functional currency, if applicable. Null for entries in functional currency.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fiscalYear rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year' ;
    rdfs:comment 'The fiscal year to which this journal entry belongs. Used for annual financial reporting and multi-year analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:glInterfaceStatus rdf:type rdf:Property ;
    rdfs:label 'Gl Interface Status' ;
    rdfs:comment 'Status of the journal entry in the interface process to the general ledger system. Tracks whether the entry has been successfully transmitted and accepted.' ;
    rdfs:domain ind:FinanceJournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intercompanyIndicator rdf:type rdf:Property ;
    rdfs:label 'Intercompany Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this journal entry represents an intercompany transaction between related entities. True for intercompany, False otherwise.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:journalCategory rdf:type rdf:Property ;
    rdfs:label 'Journal Category' ;
    rdfs:comment 'Classification of the journal entry by accounting treatment type. Common categories include accrual entries, cash receipts, payroll postings, depreciation calculations, intercompany transactions, and adjusting entries.' ;
    rdfs:domain ind:FinanceJournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:journalEntryDescription rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Description' ;
    rdfs:comment 'Detailed narrative description of the purpose and nature of the journal entry. Provides business context for the accounting transaction.' ;
    rdfs:domain ind:FinanceJournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:journalEntryNumber rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Number' ;
    rdfs:comment 'Business identifier for the journal entry, typically a sequential or formatted number used for external reference and audit trails.' ;
    rdfs:domain ind:FinanceJournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:journalSource rdf:type rdf:Property ;
    rdfs:label 'Journal Source' ;
    rdfs:comment 'Origin or method by which the journal entry was created. Indicates whether the entry was manually entered, automatically generated by a system process, part of a recurring schedule, or a reversing entry.' ;
    rdfs:domain ind:FinanceJournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Posted Timestamp' ;
    rdfs:comment 'System timestamp indicating when this journal entry was posted to the general ledger. Null for entries not yet posted.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:postingDate rdf:type rdf:Property ;
    rdfs:label 'Posting Date' ;
    rdfs:comment 'The date on which the journal entry was posted to the general ledger. This is the system date when the entry became part of the official accounting records.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:postingStatus rdf:type rdf:Property ;
    rdfs:label 'Posting Status' ;
    rdfs:comment 'Current lifecycle status of the journal entry. Tracks progression from draft through approval, posting, and potential reversal.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurringEntryIndicator rdf:type rdf:Property ;
    rdfs:label 'Recurring Entry Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this journal entry is part of a recurring schedule. True for recurring entries, False for one-time entries.' ;
    rdfs:domain ind:FinanceJournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReportingIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this journal entry impacts regulatory reporting requirements such as CMS cost reports or state financial filings. True if reportable, False otherwise.' ;
    rdfs:domain ind:FinanceJournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalDate rdf:type rdf:Property ;
    rdfs:label 'Reversal Date' ;
    rdfs:comment 'The date on which this journal entry was reversed. Null if the entry has not been reversed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalIndicator rdf:type rdf:Property ;
    rdfs:label 'Reversal Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this journal entry has been reversed. True if reversed, False if active.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason Code' ;
    rdfs:comment 'Code indicating the reason for reversing this journal entry, if applicable. Examples include error correction, period adjustment, or policy change.' ;
    rdfs:domain ind:FinanceJournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Reference' ;
    rdfs:comment 'Identifier of the originating transaction in the source system that triggered this journal entry. Used for traceability and reconciliation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Reference' ;
    rdfs:comment 'Reference identifier or URI to supporting documentation for this journal entry, such as invoices, contracts, or approval memos. Used for audit and compliance.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCreditAmount rdf:type rdf:Property ;
    rdfs:label 'Total Credit Amount' ;
    rdfs:comment 'The sum of all credit amounts across all line items in this journal entry. Must equal total debit amount for a balanced entry.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDebitAmount rdf:type rdf:Property ;
    rdfs:label 'Total Debit Amount' ;
    rdfs:comment 'The sum of all debit amounts across all line items in this journal entry. Must equal total credit amount for a balanced entry.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financeJournalEntryLineId rdf:type rdf:Property ;
    rdfs:label 'Finance Journal Entry Line Id' ;
    rdfs:comment 'Unique identifier for the journal entry line. Primary key for the journal entry line product.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceJournalEntryLine .

ind:priorJournalEntryLineFinanceJournalEntryLineId rdf:type rdf:Property ;
    rdfs:label 'Prior Journal Entry Line Finance Journal Entry Line Id' ;
    rdfs:comment 'Reference to the original journal entry line that this line reverses. Null if this is not a reversal entry. Provides audit trail for corrections.' ;
    rdfs:domain ind:FinanceJournalEntryLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceJournalEntryLine .

ind:creditAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Amount' ;
    rdfs:comment 'The credit amount for this journal entry line in functional currency. Zero or null if this is a debit line. Credits increase liability, equity, and revenue accounts.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:debitAmount rdf:type rdf:Property ;
    rdfs:label 'Debit Amount' ;
    rdfs:comment 'The debit amount for this journal entry line in functional currency. Zero or null if this is a credit line. Debits increase asset and expense accounts.' ;
    rdfs:domain ind:FinanceJournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intercompanyEntityCode rdf:type rdf:Property ;
    rdfs:label 'Intercompany Entity Code' ;
    rdfs:comment 'The code of the counterparty legal entity for intercompany transactions. Used for intercompany reconciliation and elimination entries during consolidation.' ;
    rdfs:domain ind:FinanceJournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineDescription rdf:type rdf:Property ;
    rdfs:label 'Line Description' ;
    rdfs:comment 'Detailed description of the purpose and nature of this specific journal entry line. Provides audit trail and business context for the posting.' ;
    rdfs:domain ind:FinanceJournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineNumber rdf:type rdf:Property ;
    rdfs:label 'Line Number' ;
    rdfs:comment 'Sequential line number within the journal entry' ;
    rdfs:domain ind:FinanceJournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:locationCode rdf:type rdf:Property ;
    rdfs:label 'Location Code' ;
    rdfs:comment 'Physical location or facility code where the transaction occurred. Used for multi-site healthcare systems to track financial activity by hospital, clinic, or facility.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:naturalAccountCode rdf:type rdf:Property ;
    rdfs:label 'Natural Account Code' ;
    rdfs:comment 'Natural account classification code representing the type of expense or revenue (e.g., salaries, supplies, utilities). Part of the chart of accounts structure.' ;
    rdfs:domain ind:FinanceJournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerCode rdf:type rdf:Property ;
    rdfs:label 'Payer Code' ;
    rdfs:comment 'Payer or insurance plan code for revenue and receivables tracking. Used to analyze financial performance by payer mix (Medicare, Medicaid, commercial, self-pay).' ;
    rdfs:domain ind:FinanceJournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programCode rdf:type rdf:Property ;
    rdfs:label 'Program Code' ;
    rdfs:comment 'Program or service line code for program-based reporting. Examples include cardiology, oncology, orthopedics, or community health programs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectCode rdf:type rdf:Property ;
    rdfs:label 'Project Code' ;
    rdfs:comment 'Project or grant identifier for project-based accounting. Used to track capital projects, research grants, and special initiatives.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sequence Number' ;
    rdfs:comment 'Sequential line number within the journal entry, used for ordering and referencing individual lines within the entry.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Source Document Number' ;
    rdfs:comment 'The reference number of the source document that generated this journal entry line (e.g., invoice number, payment batch number, payroll run ID). Provides audit trail to originating transaction.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statisticalAmount rdf:type rdf:Property ;
    rdfs:label 'Statistical Amount' ;
    rdfs:comment 'Non-monetary statistical quantity associated with this line, such as patient days, procedures performed, or full-time equivalents (FTE). Used for cost allocation and unit cost analysis.' ;
    rdfs:domain ind:FinanceJournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statisticalUom rdf:type rdf:Property ;
    rdfs:label 'Statistical Uom' ;
    rdfs:comment 'The unit of measure for the statistical amount. Common healthcare units include patient days, procedures, FTE (full-time equivalents), visits, admissions, discharges, bed days, and RVUs (relative value units). [ENUM-REF-CANDIDATE: patient_days|procedures|fte|visits|admissions|discharges|bed_days|rvus|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FinanceJournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionAmount rdf:type rdf:Property ;
    rdfs:label 'Transaction Amount' ;
    rdfs:comment 'The original transaction amount in transaction currency before conversion to functional currency. Used for foreign currency accounting and reconciliation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Transaction Currency Code' ;
    rdfs:comment 'The original transaction currency if different from functional currency. Three-letter ISO 4217 currency code. Used for foreign currency transactions.' ;
    rdfs:domain ind:FinanceJournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentFiscalPeriodId rdf:type rdf:Property ;
    rdfs:label 'Parent Fiscal Period Id' ;
    rdfs:comment 'Reference to the parent fiscal period in a hierarchical structure (e.g., a monthly period references its parent quarter, a quarter references its parent year). Null for top-level periods.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FiscalPeriod .

ind:primaryPriorFiscalPeriodId rdf:type rdf:Property ;
    rdfs:label 'Primary Prior Fiscal Period Id' ;
    rdfs:comment 'Reference to the immediately preceding fiscal period of the same type. Used for period-over-period comparisons and sequential processing.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FiscalPeriod .

ind:adjustmentPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Adjustment Period Flag' ;
    rdfs:comment 'Indicates whether this is an adjustment period used for year-end closing entries. True if adjustment period, False otherwise.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:budgetPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Budget Period Flag' ;
    rdfs:comment 'Indicates whether this fiscal period is used for budget planning and allocation. True if budget period, False otherwise.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:businessDaysInPeriod rdf:type rdf:Property ;
    rdfs:label 'Business Days In Period' ;
    rdfs:comment 'The total number of business days (excluding weekends and holidays) in the fiscal period. Used for operational and productivity metrics.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendarMonth rdf:type rdf:Property ;
    rdfs:label 'Calendar Month' ;
    rdfs:comment 'The calendar month in which the fiscal period starts (1-12). Null for non-monthly periods.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendarQuarter rdf:type rdf:Property ;
    rdfs:label 'Calendar Quarter' ;
    rdfs:comment 'The calendar quarter in which the fiscal period starts (1, 2, 3, or 4). Null for non-monthly periods.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendarYear rdf:type rdf:Property ;
    rdfs:label 'Calendar Year' ;
    rdfs:comment 'The calendar year in which the fiscal period starts (e.g., 2024). May differ from fiscal_year for organizations with non-calendar fiscal years.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closeApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Close Approved By' ;
    rdfs:comment 'The username or identifier of the user who approved the period close. Used for segregation of duties and audit trail.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeInitiatedBy rdf:type rdf:Property ;
    rdfs:label 'Close Initiated By' ;
    rdfs:comment 'The username or identifier of the user who initiated the period close process. Used for audit trail and accountability.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsReportingPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Reporting Period Flag' ;
    rdfs:comment 'Indicates whether this fiscal period is used for CMS cost reporting and reimbursement submissions. True if CMS reporting period, False otherwise.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:daysInPeriod rdf:type rdf:Property ;
    rdfs:label 'Days In Period' ;
    rdfs:comment 'The total number of calendar days in the fiscal period. Calculated as end_date minus start_date plus one.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalPeriodDescription rdf:type rdf:Property ;
    rdfs:label 'Fiscal Period Description' ;
    rdfs:comment 'Additional descriptive text or notes about the fiscal period, such as special circumstances, adjustments, or business context.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodEndCloseChecklistCompleteFlag rdf:type rdf:Property ;
    rdfs:label 'Period End Close Checklist Complete Flag' ;
    rdfs:comment 'Indicates whether all period-end close checklist tasks have been completed for this period. True if complete, False otherwise.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:periodName rdf:type rdf:Property ;
    rdfs:label 'Period Name' ;
    rdfs:comment 'Human-readable name of the fiscal period (e.g., January 2024, Q1 FY2024, FY2024).' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodNumber rdf:type rdf:Property ;
    rdfs:label 'Period Number' ;
    rdfs:comment 'Sequential number of the period within the fiscal year (e.g., 1 for January, 2 for February, or 1 for Q1).' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:periodStatus rdf:type rdf:Property ;
    rdfs:label 'Period Status' ;
    rdfs:comment 'Current status of the fiscal period: future (not yet started), open (available for journal entry posting), closed (temporarily closed, can be reopened), permanently_closed (locked, no further entries allowed).' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodType rdf:type rdf:Property ;
    rdfs:label 'Period Type' ;
    rdfs:comment 'Type of fiscal period: month (monthly period), quarter (quarterly period), year (annual period), or adjustment (adjustment period for year-end entries).' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permanentCloseDate rdf:type rdf:Property ;
    rdfs:label 'Permanent Close Date' ;
    rdfs:comment 'The date when the fiscal period was permanently closed and locked from further entries. Null if not permanently closed. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:quarterNumber rdf:type rdf:Property ;
    rdfs:label 'Quarter Number' ;
    rdfs:comment 'The fiscal quarter number within the fiscal year (1, 2, 3, or 4). Null for non-monthly periods or adjustment periods.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reopenDate rdf:type rdf:Property ;
    rdfs:label 'Reopen Date' ;
    rdfs:comment 'The date when a previously closed period was reopened for adjustments. Null if never reopened. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Flag' ;
    rdfs:comment 'Indicates whether this fiscal period is used for external financial reporting (e.g., quarterly earnings, annual reports). True if reporting period, False otherwise.' ;
    rdfs:domain ind:FiscalPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:budgetId rdf:type rdf:Property ;
    rdfs:label 'Budget Id' ;
    rdfs:comment 'Unique identifier for the budget record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Budget .

ind:budgetEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Budget Employee Id' ;
    rdfs:comment 'FK to workforce.employee identifying the primary approver of this budget' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:fteBudgetId rdf:type rdf:Property ;
    rdfs:label 'Fte Budget Id' ;
    rdfs:comment 'Foreign key linking to workforce.fte_budget. Business justification: Master budget consolidates detailed FTE budgets. Links operational workforce budget detail to enterprise budget for labor cost rollup, budget-to-actual variance analysis, and consolidated financial re' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FteBudget .

ind:parentBudgetId rdf:type rdf:Property ;
    rdfs:label 'Parent Budget Id' ;
    rdfs:comment 'Reference to a parent or master budget if this budget is a sub-budget or departmental allocation within a larger organizational budget.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Budget .

ind:positionId rdf:type rdf:Property ;
    rdfs:label 'Position Id' ;
    rdfs:comment 'Foreign key linking to workforce.position. Business justification: Budgets are allocated to positions (budgeted headcount). Links budget line items to specific authorized positions for variance analysis, vacancy tracking, and position control reporting required for w' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Position .

ind:primaryPriorBudgetId rdf:type rdf:Property ;
    rdfs:label 'Primary Prior Budget Id' ;
    rdfs:comment 'Self-referencing FK on budget (prior_budget_id)' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Budget .

ind:assumptions rdf:type rdf:Property ;
    rdfs:label 'Assumptions' ;
    rdfs:comment 'Key assumptions underlying the budget (e.g., inflation rate, patient volume growth, reimbursement rate changes).' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetCategory rdf:type rdf:Property ;
    rdfs:label 'Budget Category' ;
    rdfs:comment 'High-level expense category classification for the budget: personnel (salaries, benefits), supplies (medical and office), equipment (capital purchases), facilities (rent, utilities), services (contracted), overhead (indirect costs), or other. [ENUM-REF-CANDIDATE: personnel|supplies|equipment|facilities|services|overhead|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetName rdf:type rdf:Property ;
    rdfs:label 'Budget Name' ;
    rdfs:comment 'Human-readable name or title of the budget (e.g., FY2024 Operating Budget - Cardiology Department).' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetNumber rdf:type rdf:Property ;
    rdfs:label 'Budget Number' ;
    rdfs:comment 'Externally-known unique business identifier for the budget, used in financial reporting and communications.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetStatus rdf:type rdf:Property ;
    rdfs:label 'Budget Status' ;
    rdfs:comment 'Current lifecycle status of the budget: draft (being prepared), submitted (awaiting review), under_review (in approval process), approved (authorized but not yet active), active (in effect), closed (fiscal period ended), cancelled (withdrawn). [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|active|closed|cancelled — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetType rdf:type rdf:Property ;
    rdfs:label 'Budget Type' ;
    rdfs:comment 'Classification of the budget by its purpose: operating (day-to-day expenses), capital (long-term investments), cash flow (liquidity planning), grant (externally funded), project (specific initiative), or departmental (unit-level).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetedCmi rdf:type rdf:Property ;
    rdfs:label 'Budgeted Cmi' ;
    rdfs:comment 'Projected average case mix index reflecting the expected complexity and resource intensity of patient cases.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetedFteCount rdf:type rdf:Property ;
    rdfs:label 'Budgeted Fte Count' ;
    rdfs:comment 'Total number of full-time equivalent staff positions budgeted for the period.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetedNetIncome rdf:type rdf:Property ;
    rdfs:label 'Budgeted Net Income' ;
    rdfs:comment 'Projected net income (revenue minus expenses) for the fiscal period, in USD.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetedPatientVolume rdf:type rdf:Property ;
    rdfs:label 'Budgeted Patient Volume' ;
    rdfs:comment 'Projected number of patient encounters or admissions for the fiscal period, used for volume-based budgeting.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fundingSource rdf:type rdf:Property ;
    rdfs:label 'Funding Source' ;
    rdfs:comment 'Primary source of funding for this budget: internal operations, federal grant, state grant, private foundation, donor contribution, research contract, or other. [ENUM-REF-CANDIDATE: internal|federal_grant|state_grant|private_foundation|donor|research_contract|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBaselineBudget rdf:type rdf:Property ;
    rdfs:label 'Is Baseline Budget' ;
    rdfs:comment 'Indicates whether this is the baseline (original approved) budget used for variance analysis. True if baseline, False otherwise.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:methodology rdf:type rdf:Property ;
    rdfs:label 'Methodology' ;
    rdfs:comment 'Budgeting approach used: zero_based (justify all expenses from zero), incremental (adjust prior year), activity_based (cost by activity), value_based (align with value drivers), rolling (continuous forecast).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:narrative rdf:type rdf:Property ;
    rdfs:label 'Narrative' ;
    rdfs:comment 'Detailed textual description or justification of the budget, including assumptions, strategic priorities, and key drivers.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchGrantNumber rdf:type rdf:Property ;
    rdfs:label 'Research Grant Number' ;
    rdfs:comment 'External grant or funding source identifier if this budget is associated with a specific grant award.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalBudgetedCapital rdf:type rdf:Property ;
    rdfs:label 'Total Budgeted Capital' ;
    rdfs:comment 'Total capital expenditure amount budgeted for long-term investments (equipment, facilities, technology), in USD.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalBudgetedExpense rdf:type rdf:Property ;
    rdfs:label 'Total Budgeted Expense' ;
    rdfs:comment 'Total operating expense amount budgeted for the fiscal period, in USD.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalBudgetedRevenue rdf:type rdf:Property ;
    rdfs:label 'Total Budgeted Revenue' ;
    rdfs:comment 'Total revenue amount budgeted for the fiscal period, in USD.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Variance Threshold Percent' ;
    rdfs:comment 'Acceptable variance percentage threshold for budget-to-actual monitoring; triggers review if exceeded.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetLineId rdf:type rdf:Property ;
    rdfs:label 'Budget Line Id' ;
    rdfs:comment 'Unique identifier for the budget line item. Primary key for the budget line entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BudgetLine .

ind:parentBudgetLineId rdf:type rdf:Property ;
    rdfs:label 'Parent Budget Line Id' ;
    rdfs:comment 'Self-referencing FK on budget_line (parent_budget_line_id)' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BudgetLine .

ind:allocationMethod rdf:type rdf:Property ;
    rdfs:label 'Allocation Method' ;
    rdfs:comment 'Method used to allocate indirect costs or shared expenses to this budget line (e.g., direct, step-down, activity-based, proportional).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Allocation Percentage' ;
    rdfs:comment 'Percentage of total cost allocated to this budget line when using proportional or percentage-based allocation methods.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalStatus rdf:type rdf:Property ;
    rdfs:label 'Approval Status' ;
    rdfs:comment 'Current approval status of this budget line item in the budget approval workflow.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedDate rdf:type rdf:Property ;
    rdfs:label 'Approved Date' ;
    rdfs:comment 'Date on which this budget line item was approved.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetedAmount rdf:type rdf:Property ;
    rdfs:label 'Budgeted Amount' ;
    rdfs:comment 'The approved budgeted dollar amount allocated to this line item for the specified period. Primary financial measure for variance analysis.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimLineNotes rdf:type rdf:Property ;
    rdfs:label 'Claim Line Notes' ;
    rdfs:comment 'Free-text notes or comments providing additional context, assumptions, or justification for this budget line item.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityServiceLineCode rdf:type rdf:Property ;
    rdfs:label 'Facility Service Line Code' ;
    rdfs:comment 'Clinical or operational service line code (e.g., cardiology, orthopedics, emergency services) for service line profitability and budget management.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalPeriod rdf:type rdf:Property ;
    rdfs:label 'Fiscal Period' ;
    rdfs:comment 'The fiscal period within the year (e.g., Q1, Q2, M01, M02, FY for full year). Enables period-level budget tracking and variance analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fteCount rdf:type rdf:Property ;
    rdfs:label 'Fte Count' ;
    rdfs:comment 'Number of full-time equivalent positions budgeted for this line item. Applicable primarily to salary and benefits budget lines.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCapital rdf:type rdf:Property ;
    rdfs:label 'Is Capital' ;
    rdfs:comment 'Boolean flag indicating whether this budget line represents a capital expenditure (True) or operating expenditure (False).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRestricted rdf:type rdf:Property ;
    rdfs:label 'Is Restricted' ;
    rdfs:comment 'Boolean flag indicating whether this budget line is funded by restricted funds (True) or unrestricted funds (False). Common in not-for-profit healthcare organizations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorYearActual rdf:type rdf:Property ;
    rdfs:label 'Prior Year Actual' ;
    rdfs:comment 'Actual expenditure amount for this line item in the prior fiscal year. Used for trend analysis and budget variance comparison.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statisticalBasis rdf:type rdf:Property ;
    rdfs:label 'Statistical Basis' ;
    rdfs:comment 'Description of the statistical or actuarial basis used to calculate this budget line (e.g., historical trend, regression model, industry benchmark, clinical guideline).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volumeAssumption rdf:type rdf:Property ;
    rdfs:label 'Volume Assumption' ;
    rdfs:comment 'The volume metric assumption underlying this budget line (e.g., patient days, procedures, visits, admissions). Used for flexible budgeting and variance analysis.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volumeUnit rdf:type rdf:Property ;
    rdfs:label 'Volume Unit' ;
    rdfs:comment 'Unit of measure for the volume assumption (e.g., patient days, procedures, visits, admissions, discharges, RVUs).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financeBudgetTransferId rdf:type rdf:Property ;
    rdfs:label 'Finance Budget Transfer Id' ;
    rdfs:comment 'Unique identifier for the budget transfer transaction. Primary key for the budget transfer record.' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:destinationBudgetLineId rdf:type rdf:Property ;
    rdfs:label 'Destination Budget Line Id' ;
    rdfs:comment 'Identifier of the specific budget line item to which funds are being transferred. Links to the budget line master data.' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BudgetLine .

ind:destinationChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Destination Chart Of Accounts Id' ;
    rdfs:comment 'Identifier of the general ledger account to which budget funds are being transferred. Links to the chart of accounts.' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:destinationCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Destination Cost Center Id' ;
    rdfs:comment 'Identifier of the cost center, department, or organizational unit to which budget funds are being transferred. Links to the cost center master data.' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:originalBudgetTransferFinanceBudgetTransferId rdf:type rdf:Property ;
    rdfs:label 'Original Budget Transfer Finance Budget Transfer Id' ;
    rdfs:comment 'If this transfer is a reversal or correction of a previous transfer, this field contains the budget_transfer_id of the original transfer being reversed. Null for original transfers.' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceBudgetTransfer .

ind:sourceBudgetLineId rdf:type rdf:Property ;
    rdfs:label 'Source Budget Line Id' ;
    rdfs:comment 'Identifier of the specific budget line item from which funds are being transferred. Links to the budget line master data.' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BudgetLine .

ind:sourceChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Source Chart Of Accounts Id' ;
    rdfs:comment 'Identifier of the general ledger account from which budget funds are being transferred. Links to the chart of accounts.' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:sourceCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Source Cost Center Id' ;
    rdfs:comment 'Identifier of the cost center, department, or organizational unit from which budget funds are being transferred. Links to the cost center master data.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:approvalLevel rdf:type rdf:Property ;
    rdfs:label 'Approval Level' ;
    rdfs:comment 'The organizational level at which the budget transfer was approved, indicating the authority level required based on transfer amount and type: department_manager, director, vice_president, chief_financial_officer (CFO), or board_of_directors.' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverName rdf:type rdf:Property ;
    rdfs:label 'Approver Name' ;
    rdfs:comment 'Full name of the employee who approved the budget transfer, captured for audit trail and accountability.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comments rdf:type rdf:Property ;
    rdfs:label 'Comments' ;
    rdfs:comment 'Additional free-text comments, notes, or context about the budget transfer that do not fit in other structured fields. Used for collaboration and documentation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorDepartment rdf:type rdf:Property ;
    rdfs:label 'Requestor Department' ;
    rdfs:comment 'Name of the department or organizational unit of the employee who requested the transfer, for organizational analysis and reporting.' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorName rdf:type rdf:Property ;
    rdfs:label 'Requestor Name' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Flag' ;
    rdfs:comment 'Boolean indicator of whether this budget transfer has been reversed or undone. True if reversed, False if still in effect.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalReason rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason' ;
    rdfs:comment 'Narrative explanation of why the budget transfer was reversed, including business justification and corrective action taken.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferAmount rdf:type rdf:Property ;
    rdfs:label 'Transfer Amount' ;
    rdfs:comment 'Cleaned boilerplate phrase from attribute description' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferDate rdf:type rdf:Property ;
    rdfs:label 'Transfer Date' ;
    rdfs:comment 'The business date when the budget transfer was initiated or became effective. This is the principal business event timestamp for the transaction, distinct from audit timestamps.' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transferNumber rdf:type rdf:Property ;
    rdfs:label 'Transfer Number' ;
    rdfs:comment 'Externally-visible unique business identifier for the budget transfer, typically formatted as BT-YYYYNNNN for tracking and audit purposes.' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferReasonCode rdf:type rdf:Property ;
    rdfs:label 'Transfer Reason Code' ;
    rdfs:comment 'Standardized code indicating the primary business reason for the budget transfer: operational_need (operational requirements changed), cost_overrun (original budget insufficient), revenue_shortfall (revenue below projections), strategic_priority (strategic initiative funding), regulatory_requirement (compliance mandate), or emergency_response (urgent unplanned need).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Transfer Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of the business justification for the budget transfer, including context, impact, and supporting rationale. Critical for audit trail and management review.' ;
    rdfs:domain ind:FinanceBudgetTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferStatus rdf:type rdf:Property ;
    rdfs:label 'Transfer Status' ;
    rdfs:comment 'Current lifecycle state of the budget transfer: draft (being prepared), pending_approval (submitted for review), approved (authorized to proceed), rejected (denied), in_progress (being executed), completed (fully processed), cancelled (withdrawn before completion), or reversed (undone after completion). [ENUM-REF-CANDIDATE: draft|pending_approval|approved|rejected|in_progress|completed|cancelled|reversed — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferType rdf:type rdf:Property ;
    rdfs:label 'Transfer Type' ;
    rdfs:comment 'Classification of the budget modification: budget amendment (formal change to approved budget), budget transfer (movement between cost centers), budget revision (adjustment to budget assumptions), budget reallocation (redistribution within same department), supplemental appropriation (additional funding), or technical adjustment (correction without policy change).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Ap Invoice Id' ;
    rdfs:comment 'Unique identifier for the accounts payable invoice record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApInvoice .

ind:apEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Ap Employee Id' ;
    rdfs:comment 'FK to workforce.employee identifying the AP clerk responsible for processing this invoice' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:creditedApInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Credited Ap Invoice Id' ;
    rdfs:comment 'Self-referencing FK on ap_invoice (credited_ap_invoice_id)' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApInvoice .

ind:requesterEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Requester Employee Id' ;
    rdfs:comment 'FK to workforce.employee identifying the employee who requested or initiated this AP invoice' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:vendorId rdf:type rdf:Property ;
    rdfs:label 'Vendor Id' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:vendorSiteId rdf:type rdf:Property ;
    rdfs:label 'Vendor Site Id' ;
    rdfs:comment 'Identifier of the specific vendor site or remit-to location associated with this invoice.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VendorSite .

ind:apInvoiceDescription rdf:type rdf:Property ;
    rdfs:label 'Ap Invoice Description' ;
    rdfs:comment 'A free-text description of the goods or services covered by this invoice.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountAmount rdf:type rdf:Property ;
    rdfs:label 'Discount Amount' ;
    rdfs:comment 'The total discount amount applied to the invoice (early payment discounts, volume discounts, or negotiated price reductions).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:freightAmount rdf:type rdf:Property ;
    rdfs:label 'Freight Amount' ;
    rdfs:comment 'The shipping and freight charges included in the invoice.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:functionalCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Functional Currency Amount' ;
    rdfs:comment 'The total invoice amount converted to the organizations functional currency using the exchange rate, for consolidated financial reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glAccountCode rdf:type rdf:Property ;
    rdfs:label 'Gl Account Code' ;
    rdfs:comment 'The general ledger account code to which this invoice is posted in the chart of accounts.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glDate rdf:type rdf:Property ;
    rdfs:label 'Gl Date' ;
    rdfs:comment 'The accounting period date when this invoice is posted to the general ledger.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:holdDate rdf:type rdf:Property ;
    rdfs:label 'Hold Date' ;
    rdfs:comment 'The date the invoice was placed on hold.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:holdReasonCode rdf:type rdf:Property ;
    rdfs:label 'Hold Reason Code' ;
    rdfs:comment 'The code indicating why the invoice is on hold (e.g., pricing variance, missing receipt, duplicate invoice, vendor on hold, budget exceeded).' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdReleasedDate rdf:type rdf:Property ;
    rdfs:label 'Hold Released Date' ;
    rdfs:comment 'The date the hold was released and the invoice was returned to normal processing.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceAmount rdf:type rdf:Property ;
    rdfs:label 'Invoice Amount' ;
    rdfs:comment 'The gross total amount of the invoice before taxes and freight, representing the base charge for goods or services.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Invoice Currency Code' ;
    rdfs:comment 'The three-letter ISO 4217 currency code in which the invoice is denominated (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Date' ;
    rdfs:comment 'The date the vendor issued the invoice. This is the principal business event timestamp for the invoice transaction.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceSource rdf:type rdf:Property ;
    rdfs:label 'Invoice Source' ;
    rdfs:comment 'The channel through which the invoice was received: manual_entry (keyed by AP clerk), edi (Electronic Data Interchange), email (scanned attachment), ocr (Optical Character Recognition from paper), supplier_portal (vendor self-service portal), or api (system-to-system integration).' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceStatus rdf:type rdf:Property ;
    rdfs:label 'Invoice Status' ;
    rdfs:comment 'The current lifecycle status of the invoice in the accounts payable workflow: received (entered into system), validated (passed data quality checks), matched (matched to PO and receipt), approved (approved for payment), on_hold (payment hold applied), scheduled_for_payment (queued for payment run), paid (payment issued), cancelled (invoice voided), or rejected (invoice returned to vendor). [ENUM-REF-CANDIDATE: received|validated|matched|approved|on_hold|scheduled_for_payment|paid|cancelled|rejected — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceType rdf:type rdf:Property ;
    rdfs:label 'Invoice Type' ;
    rdfs:comment 'The classification of the invoice transaction: standard invoice for goods/services, credit memo for returns/adjustments, debit memo for additional charges, prepayment for advance payments, expense report for employee reimbursements, or recurring for subscription-based invoices.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTerms rdf:type rdf:Property ;
    rdfs:label 'Payment Terms' ;
    rdfs:comment 'The payment terms agreed with the vendor (e.g., Net 30, Net 60, 2/10 Net 30) that define the due date and any early payment discounts.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poMatchIndicator rdf:type rdf:Property ;
    rdfs:label 'Po Match Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this invoice has been matched to a purchase order (True) or is a non-PO invoice (False).' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:poNumber rdf:type rdf:Property ;
    rdfs:label 'Po Number' ;
    rdfs:comment 'The purchase order number that this invoice is matched against, if applicable. Used for three-way matching (PO, receipt, invoice).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivedDate rdf:type rdf:Property ;
    rdfs:label 'Received Date' ;
    rdfs:comment 'The date the healthcare organization received the invoice from the vendor.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Amount' ;
    rdfs:comment 'The total tax amount charged on the invoice (sales tax, VAT, GST, or other applicable taxes).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxCode rdf:type rdf:Property ;
    rdfs:label 'Tax Code' ;
    rdfs:comment 'The tax jurisdiction or tax rate code applied to this invoice for sales tax, VAT, or GST calculation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threeWayMatchStatus rdf:type rdf:Property ;
    rdfs:label 'Three Way Match Status' ;
    rdfs:comment 'The status of the three-way match process (PO, receipt, invoice): not_applicable (non-PO invoice), pending (match in progress), matched (all three documents reconciled), variance (discrepancies identified within tolerance), or failed (discrepancies exceed tolerance).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAmount rdf:type rdf:Property ;
    rdfs:label 'Total Amount' ;
    rdfs:comment 'The net total amount payable to the vendor, calculated as invoice_amount + tax_amount + freight_amount - discount_amount.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voucherNumber rdf:type rdf:Property ;
    rdfs:label 'Voucher Number' ;
    rdfs:comment 'The internal accounting voucher number assigned to this invoice for general ledger posting and audit trail purposes.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apInvoiceLineId rdf:type rdf:Property ;
    rdfs:label 'Ap Invoice Line Id' ;
    rdfs:comment 'Unique identifier for the accounts payable invoice line item. Primary key for this entity.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:creditedApInvoiceLineId rdf:type rdf:Property ;
    rdfs:label 'Credited Ap Invoice Line Id' ;
    rdfs:comment 'Self-referencing FK on ap_invoice_line (credited_ap_invoice_line_id)' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApInvoiceLine .

ind:goodsReceiptId rdf:type rdf:Property ;
    rdfs:label 'Goods Receipt Id' ;
    rdfs:comment 'Foreign key linking to supply.goods_receipt. Business justification: Invoice lines link to goods receipt for three-way match completion, quantity/quality verification, and received-not-invoiced accrual reconciliation. Required for accurate period-end accruals and AP au' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GoodsReceipt .

ind:purchaseOrderLineId rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Line Id' ;
    rdfs:comment 'Foreign key linking to supply.purchase_order_line. Business justification: Invoice lines must link to PO lines for three-way match validation (PO-receipt-invoice), price variance analysis, and automated GL account inheritance from PO. Core AP matching process.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PurchaseOrderLine .

ind:assetCategory rdf:type rdf:Property ;
    rdfs:label 'Asset Category' ;
    rdfs:comment 'Asset category or class for capital items. Determines depreciation method, useful life, and financial statement classification for capitalized purchases.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetFlag rdf:type rdf:Property ;
    rdfs:label 'Asset Flag' ;
    rdfs:comment 'Indicates whether this line item represents a capital asset purchase that should be capitalized rather than expensed. Triggers asset tracking and depreciation processes.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimLineAmount rdf:type rdf:Property ;
    rdfs:label 'Claim Line Amount' ;
    rdfs:comment 'Total amount for this line item before taxes and adjustments. Typically calculated as quantity multiplied by unit price.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimLineDescription rdf:type rdf:Property ;
    rdfs:label 'Claim Line Description' ;
    rdfs:comment 'Detailed textual description of the goods or services being billed on this line. Provides context for the charge and supports audit and reconciliation activities.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimLineStatus rdf:type rdf:Property ;
    rdfs:label 'Claim Line Status' ;
    rdfs:comment 'Current processing status of this invoice line item. Tracks the line through the approval, matching, and payment workflow.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionStatus rdf:type rdf:Property ;
    rdfs:label 'Distribution Status' ;
    rdfs:comment 'Status of general ledger distribution for this line item. Indicates whether the expense has been posted to the general ledger and financial statements.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityServicePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Facility Service Period End Date' ;
    rdfs:comment 'End date of the service period covered by this line item. Used with start date to determine expense allocation across accounting periods for prepaid services.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilityServicePeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Facility Service Period Start Date' ;
    rdfs:comment 'Start date of the service period covered by this line item. Used for service-based invoices to determine the period of benefit and expense recognition timing.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:holdFlag rdf:type rdf:Property ;
    rdfs:label 'Hold Flag' ;
    rdfs:comment 'Indicates whether this line item is on hold and blocked from payment. Used to prevent payment pending resolution of issues or additional approvals.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holdReason rdf:type rdf:Property ;
    rdfs:label 'Hold Reason' ;
    rdfs:comment 'Reason code or description explaining why this line item is on hold. Documents the issue preventing payment and guides resolution activities.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemCode rdf:type rdf:Property ;
    rdfs:label 'Item Code' ;
    rdfs:comment 'Vendor or internal catalog item code identifying the specific product or service being purchased. Used for inventory tracking and spend analysis.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchExceptionReason rdf:type rdf:Property ;
    rdfs:label 'Match Exception Reason' ;
    rdfs:comment 'Reason code or description for match exceptions or variances. Documents why the invoice line does not match the PO or receipt (e.g., price variance, quantity variance).' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchStatus rdf:type rdf:Property ;
    rdfs:label 'Match Status' ;
    rdfs:comment 'Status of three-way matching (PO-receipt-invoice) for this line item. Indicates whether the invoice line has been successfully matched to purchase order and goods receipt.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantity rdf:type rdf:Property ;
    rdfs:label 'Quantity' ;
    rdfs:comment 'Quantity of items or units of service being billed on this line. Used in conjunction with unit price to calculate line amount.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalLineAmount rdf:type rdf:Property ;
    rdfs:label 'Total Line Amount' ;
    rdfs:comment 'Final total amount for this line item including taxes and discounts. Represents the net amount payable to the vendor for this line.' ;
    rdfs:domain ind:ApInvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitPrice rdf:type rdf:Property ;
    rdfs:label 'Unit Price' ;
    rdfs:comment 'Price per unit of measure for this line item. Multiplied by quantity to derive the line amount before taxes and adjustments.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:apPaymentId rdf:type rdf:Property ;
    rdfs:label 'Ap Payment Id' ;
    rdfs:comment 'Unique identifier for the accounts payable payment transaction. Primary key.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApPayment .

ind:paymentBatchId rdf:type rdf:Property ;
    rdfs:label 'Payment Batch Id' ;
    rdfs:comment 'Identifier of the payment batch or payment run in which this payment was processed. Used for grouping payments processed together.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentBatch .

ind:primaryApVendorBankAccountId rdf:type rdf:Property ;
    rdfs:label 'Primary Ap Vendor Bank Account Id' ;
    rdfs:comment 'Identifier of the vendor bank account to which this payment was sent. Links to vendor banking information.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankAccount .

ind:voidedApPaymentId rdf:type rdf:Property ;
    rdfs:label 'Voided Ap Payment Id' ;
    rdfs:comment 'Self-referencing FK on ap_payment (voided_ap_payment_id)' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ApPayment .

ind:achTraceNumber rdf:type rdf:Property ;
    rdfs:label 'Ach Trace Number' ;
    rdfs:comment 'ACH trace number assigned by the bank for ACH/EFT payments. Used for tracking and reconciliation. Null for non-ACH payment methods.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkNumber rdf:type rdf:Property ;
    rdfs:label 'Check Number' ;
    rdfs:comment 'Physical check number if payment method is check. Null for electronic payment methods.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedDate rdf:type rdf:Property ;
    rdfs:label 'Cleared Date' ;
    rdfs:comment 'Date on which the payment cleared the bank and funds were successfully transferred to the vendor. Null if payment has not yet cleared.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:discountTakenAmount rdf:type rdf:Property ;
    rdfs:label 'Discount Taken Amount' ;
    rdfs:comment 'Total early payment discount amount taken on this payment if vendor offered discount terms (e.g., 2% discount for payment within 10 days).' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDate rdf:type rdf:Property ;
    rdfs:label 'Payment Date' ;
    rdfs:comment 'Date on which the payment was issued or disbursed to the vendor. Principal business event timestamp for the payment transaction.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentDescription rdf:type rdf:Property ;
    rdfs:label 'Payment Description' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Number' ;
    rdfs:comment 'Business-facing unique payment identifier or check number assigned by the financial system. Used for external reference and reconciliation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPriority rdf:type rdf:Property ;
    rdfs:label 'Payment Priority' ;
    rdfs:comment 'Priority level assigned to the payment for processing. Values: standard (normal processing), urgent (high priority), expedited (rush processing).' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Reconciliation Status' ;
    rdfs:comment 'Bank reconciliation status of the payment. Values: unreconciled (not yet matched to bank statement), reconciled (matched and cleared), exception (discrepancy identified).' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Payment Source System' ;
    rdfs:comment 'Name or identifier of the source financial system that originated this payment record (e.g., SAP S/4HANA FI, Epic Resolute PB).' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentType rdf:type rdf:Property ;
    rdfs:label 'Payment Type' ;
    rdfs:comment 'Classification of the payment transaction type. Values: invoice_payment (standard vendor invoice payment), prepayment (advance payment), refund (return of funds), expense_reimbursement (employee expense reimbursement).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciledDate rdf:type rdf:Property ;
    rdfs:label 'Reconciled Date' ;
    rdfs:comment 'Date on which the payment was reconciled against the bank statement. Null if not yet reconciled.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remittanceAdviceReference rdf:type rdf:Property ;
    rdfs:label 'Remittance Advice Reference' ;
    rdfs:comment 'Reference number or identifier for the remittance advice document sent to the vendor detailing which invoices this payment settles.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidDate rdf:type rdf:Property ;
    rdfs:label 'Void Date' ;
    rdfs:comment 'Date on which the payment was voided or cancelled. Null if payment has not been voided.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:voidReason rdf:type rdf:Property ;
    rdfs:label 'Void Reason' ;
    rdfs:comment 'Business reason or explanation for why the payment was voided. Null if payment has not been voided.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wireConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Wire Confirmation Number' ;
    rdfs:comment 'Bank confirmation or reference number for wire transfer payments. Null for non-wire payment methods.' ;
    rdfs:domain ind:ApPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arAccountId rdf:type rdf:Property ;
    rdfs:label 'Ar Account Id' ;
    rdfs:comment 'Unique identifier for the accounts receivable account. Primary key for non-patient-billing receivables including grants, rental income, intercompany receivables, and physician practice management fees.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ArAccount .

ind:arEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Ar Employee Id' ;
    rdfs:comment 'Identifier of the internal staff member or external collection agency assigned to manage collection activities for this account. Used for workload distribution, performance tracking, and accountability.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentArAccountId rdf:type rdf:Property ;
    rdfs:label 'Parent Ar Account Id' ;
    rdfs:comment 'Self-referencing FK on ar_account (parent_ar_account_id)' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ArAccount .

ind:accountNumber rdf:type rdf:Property ;
    rdfs:label 'Account Number' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agingBucket rdf:type rdf:Property ;
    rdfs:label 'Aging Bucket' ;
    rdfs:comment 'Categorization of the receivable based on the number of days outstanding since the original invoice or billing date. Used for aging analysis, collection prioritization, and allowance for doubtful accounts estimation. Current indicates not yet due; subsequent buckets indicate days past due.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionAgencyName rdf:type rdf:Property ;
    rdfs:label 'Collection Agency Name' ;
    rdfs:comment 'Name of the external third-party collection agency to which this account has been referred, if applicable. Null if account is managed internally or not yet in collections.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentBalance rdf:type rdf:Property ;
    rdfs:label 'Current Balance' ;
    rdfs:comment 'The outstanding receivable balance as of the current date. Reflects original balance minus payments received, plus any adjustments, interest, or fees. This is the amount currently owed. Denominated in USD unless otherwise specified in currency_code.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysOutstanding rdf:type rdf:Property ;
    rdfs:label 'Days Outstanding' ;
    rdfs:comment 'The number of calendar days that have elapsed since the original invoice or billing date. Used to calculate aging bucket and assess collection risk. Key metric for Days Sales Outstanding (DSO) reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:debtorName rdf:type rdf:Property ;
    rdfs:label 'Debtor Name' ;
    rdfs:comment 'The legal or business name of the entity or individual that owes payment on this receivable account. May be a payer organization, self-pay patient, affiliated entity, grantor, or other debtor.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debtorType rdf:type rdf:Property ;
    rdfs:label 'Debtor Type' ;
    rdfs:comment 'Categorical classification of the debtor entity. Segments debtors into commercial insurance payers, government payers (Medicare, Medicaid), self-pay individuals, affiliated healthcare entities, grant-making organizations, corporate tenants, and other categories for reporting and collection strategy purposes. [ENUM-REF-CANDIDATE: commercial_payer|government_payer|self_pay_individual|affiliated_entity|grant_organization|corporate_tenant|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeReason rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason' ;
    rdfs:comment 'Description of the reason provided by the debtor for disputing the receivable, such as services not rendered, incorrect billing amount, duplicate invoice, or contractual disagreement. Used to guide dispute resolution process.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestRate rdf:type rdf:Property ;
    rdfs:label 'Interest Rate' ;
    rdfs:comment 'The annual interest rate applied to overdue balances on this account, expressed as a decimal (e.g., 0.0500 for 5%). Null if no interest is charged. Used to calculate interest charges on past-due amounts per contractual terms or state regulations.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastActivityDate rdf:type rdf:Property ;
    rdfs:label 'Last Activity Date' ;
    rdfs:comment 'The most recent date on which any activity occurred on this account, including payments received, adjustments posted, collection calls made, correspondence sent, or status changes. Used to identify dormant accounts and prioritize follow-up.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Last Payment Amount' ;
    rdfs:comment 'The monetary amount of the most recent payment received on this account. Denominated in the accounts currency_code. Used for payment trend analysis and debtor behavior assessment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Payment Date' ;
    rdfs:comment 'The date on which the most recent payment was received and posted to this account. Used to assess payment patterns and predict future payment likelihood.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalActionDate rdf:type rdf:Property ;
    rdfs:label 'Legal Action Date' ;
    rdfs:comment 'The date on which legal action was initiated for collection of this receivable. Null if no legal action has been taken. Used for legal case tracking and statute of limitations monitoring.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalActionFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Action Flag' ;
    rdfs:comment 'Boolean indicator of whether legal action (lawsuit, lien, garnishment) has been initiated to collect this receivable. True indicates active legal proceedings; false indicates no legal action. Used for legal department coordination and risk management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalBalance rdf:type rdf:Property ;
    rdfs:label 'Original Balance' ;
    rdfs:comment 'The initial receivable amount established when the account was opened. Represents the total amount originally owed before any payments, adjustments, or write-offs. Denominated in USD unless otherwise specified in currency_code.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementAcceptedFlag rdf:type rdf:Property ;
    rdfs:label 'Settlement Accepted Flag' ;
    rdfs:comment 'Boolean indicator of whether the debtor has accepted a settlement offer. True indicates acceptance; false indicates no acceptance or no offer made. Used to track settlement negotiations and finalize account closure.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementOfferAmount rdf:type rdf:Property ;
    rdfs:label 'Settlement Offer Amount' ;
    rdfs:comment 'The reduced amount offered to the debtor as a settlement to close the account, if applicable. Typically less than current_balance. Null if no settlement has been offered. Denominated in the accounts currency_code.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAdjustments rdf:type rdf:Property ;
    rdfs:label 'Total Adjustments' ;
    rdfs:comment 'The cumulative sum of all adjustments (positive or negative) applied to this account, including billing corrections, contractual allowances, courtesy adjustments, and dispute resolutions. Denominated in the accounts currency_code.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalFeesAssessed rdf:type rdf:Property ;
    rdfs:label 'Total Fees Assessed' ;
    rdfs:comment 'The cumulative amount of late fees, collection fees, administrative fees, or other charges assessed on this account. Included in the current_balance. Denominated in the accounts currency_code.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalInterestAccrued rdf:type rdf:Property ;
    rdfs:label 'Total Interest Accrued' ;
    rdfs:comment 'The cumulative amount of interest that has accrued on this account due to late payment. Included in the current_balance. Denominated in the accounts currency_code.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPaymentsReceived rdf:type rdf:Property ;
    rdfs:label 'Total Payments Received' ;
    rdfs:comment 'The cumulative sum of all payments received on this account since inception. Used to calculate current_balance and assess payment history. Denominated in the accounts currency_code.' ;
    rdfs:domain ind:ArAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffAmount rdf:type rdf:Property ;
    rdfs:label 'Write Off Amount' ;
    rdfs:comment 'The amount written off as uncollectible bad debt. Populated when account_status is written_off. Represents the portion of the receivable removed from active AR and recognized as a loss. Denominated in the accounts currency_code.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffDate rdf:type rdf:Property ;
    rdfs:label 'Write Off Date' ;
    rdfs:comment 'The date on which the receivable was written off as uncollectible. Null if the account has not been written off. Used for bad debt reporting and financial statement preparation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:writeOffReason rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason' ;
    rdfs:comment 'Explanation or categorization of why the receivable was written off, such as debtor bankruptcy, inability to locate debtor, cost of collection exceeds balance, statute of limitations expired, or management decision. Used for root cause analysis and process improvement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financeAppliedToArTransactionId rdf:type rdf:Property ;
    rdfs:label 'Finance Applied To Ar Transaction Id' ;
    rdfs:comment 'FK to the AR transaction this payment or credit memo is applied against (e.g., the invoice being paid). References finance.finance_ar_transaction.ar_transaction_id.' ;
    rdfs:domain ind:FinanceArTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceArTransaction .

ind:financePriorArTransactionId rdf:type rdf:Property ;
    rdfs:label 'Finance Prior Ar Transaction Id' ;
    rdfs:comment 'FK to the chronologically preceding AR transaction in a sequence (e.g., the previous payment application). References finance.finance_ar_transaction.ar_transaction_id.' ;
    rdfs:domain ind:FinanceArTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceArTransaction .

ind:financeReversedByArTransactionId rdf:type rdf:Property ;
    rdfs:label 'Finance Reversed By Ar Transaction Id' ;
    rdfs:comment 'FK to the AR transaction that reverses/voids this transaction. References finance.finance_ar_transaction.ar_transaction_id.' ;
    rdfs:domain ind:FinanceArTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceArTransaction .

ind:parentArTransactionFinanceArTransactionId rdf:type rdf:Property ;
    rdfs:label 'Parent Ar Transaction Finance Ar Transaction Id' ;
    rdfs:comment 'FK to the parent AR transaction in a hierarchy (e.g., original invoice that spawned this adjustment). References finance.finance_ar_transaction.ar_transaction_id.' ;
    rdfs:domain ind:FinanceArTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceArTransaction .

ind:transactionBatchId rdf:type rdf:Property ;
    rdfs:label 'Transaction Batch Id' ;
    rdfs:comment 'Identifier for the batch or group of transactions processed together. Used for batch reconciliation and control totals validation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransactionBatch .

ind:adjustmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason Code' ;
    rdfs:comment 'Standardized code indicating the business reason for adjustment transactions: billing error, pricing correction, contractual adjustment, goodwill credit. Null for non-adjustment transactions.' ;
    rdfs:domain ind:FinanceArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalAmount rdf:type rdf:Property ;
    rdfs:label 'Functional Amount' ;
    rdfs:comment 'The transaction amount converted to the organizations functional reporting currency (typically USD) using the exchange rate at transaction date. Used for consolidated financial reporting.' ;
    rdfs:domain ind:FinanceArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referenceDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Document Number' ;
    rdfs:comment 'External reference number linking this AR transaction to source documents such as invoices, payment receipts, credit memos, or adjustment authorizations.' ;
    rdfs:domain ind:FinanceArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Source System Transaction Reference' ;
    rdfs:comment 'The unique transaction identifier from the source system. Used for data lineage tracking and reconciliation back to operational systems.' ;
    rdfs:domain ind:FinanceArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Date' ;
    rdfs:comment 'The business date when the AR transaction event occurred. This is the principal event timestamp for aging analysis and financial period assignment.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionDescription rdf:type rdf:Property ;
    rdfs:label 'Transaction Description' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:FinanceArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Number' ;
    rdfs:comment 'Business-facing unique transaction number or document reference assigned to this AR transaction for external communication and reconciliation purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffReasonCode rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason Code' ;
    rdfs:comment 'Standardized code indicating the business reason for write-off transactions: bad debt, small balance, bankruptcy, deceased, statute of limitations. Null for non-write-off transactions.' ;
    rdfs:domain ind:FinanceArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fixedAssetId rdf:type rdf:Property ;
    rdfs:label 'Fixed Asset Id' ;
    rdfs:comment 'Unique identifier for the fixed asset record. Primary key for the fixed asset entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FixedAsset .

ind:parentFixedAssetId rdf:type rdf:Property ;
    rdfs:label 'Parent Fixed Asset Id' ;
    rdfs:comment 'Self-referencing FK on fixed_asset (parent_fixed_asset_id)' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FixedAsset .

ind:accumulatedDepreciation rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation' ;
    rdfs:comment 'Total depreciation expense recognized to date since the asset was placed in service. Contra-asset account that reduces the gross book value. Recorded in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acquisitionCost rdf:type rdf:Property ;
    rdfs:label 'Acquisition Cost' ;
    rdfs:comment 'Total capitalized cost of acquiring the fixed asset including purchase price, installation costs, freight, and other costs necessary to prepare the asset for its intended use. Recorded in USD.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acquisitionDate rdf:type rdf:Property ;
    rdfs:label 'Acquisition Date' ;
    rdfs:comment 'Date on which the healthcare organization legally acquired ownership or control of the fixed asset through purchase, donation, or construction completion.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assetDescription rdf:type rdf:Property ;
    rdfs:label 'Asset Description' ;
    rdfs:comment 'Clean boilerplate phrase from description' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetName rdf:type rdf:Property ;
    rdfs:label 'Asset Name' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetStatus rdf:type rdf:Property ;
    rdfs:label 'Asset Status' ;
    rdfs:comment 'Current lifecycle status of the fixed asset. Active indicates in-service use; disposed indicates sold or scrapped; transferred indicates moved to another entity; fully depreciated indicates zero net book value but still in use; under construction indicates not yet placed in service; retired indicates removed from service.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetSubcategory rdf:type rdf:Property ;
    rdfs:label 'Asset Subcategory' ;
    rdfs:comment 'Secondary classification providing additional granularity within the asset category (e.g., MRI scanner, CT scanner, ultrasound machine for medical equipment category).' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetTagNumber rdf:type rdf:Property ;
    rdfs:label 'Asset Tag Number' ;
    rdfs:comment 'Unique physical identifier affixed to the asset for tracking and inventory purposes. Externally visible barcode or RFID tag number used in physical audits.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalizationThresholdMet rdf:type rdf:Property ;
    rdfs:label 'Capitalization Threshold Met' ;
    rdfs:comment 'Flag indicating whether the asset acquisition cost met or exceeded the organizations capitalization threshold policy. True indicates the asset was properly capitalized; False would indicate an expense treatment.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:depreciationMethod rdf:type rdf:Property ;
    rdfs:label 'Depreciation Method' ;
    rdfs:comment 'Accounting method used to systematically allocate the cost of the fixed asset over its useful life. Straight-line allocates evenly; declining balance accelerates early depreciation; MACRS (Modified Accelerated Cost Recovery System) follows IRS tax rules; units of production bases depreciation on usage; sum of years digits accelerates depreciation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposalDate rdf:type rdf:Property ;
    rdfs:label 'Disposal Date' ;
    rdfs:comment 'Date on which the fixed asset was disposed of through sale, donation, scrapping, or other removal from service. Null for active assets.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disposalMethod rdf:type rdf:Property ;
    rdfs:label 'Disposal Method' ;
    rdfs:comment 'Method by which the fixed asset was disposed. Sold indicates sale to third party; donated indicates charitable contribution; scrapped indicates destruction; traded in indicates exchange for new asset; returned to lessor indicates lease termination; transferred indicates internal move to another entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposalProceeds rdf:type rdf:Property ;
    rdfs:label 'Disposal Proceeds' ;
    rdfs:comment 'Cash or fair value of consideration received from disposal of the fixed asset. Used to calculate gain or loss on disposal. Recorded in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fdaDeviceClass rdf:type rdf:Property ;
    rdfs:label 'Fda Device Class' ;
    rdfs:comment 'FDA classification of the medical device based on risk level. Class I is low risk; Class II is moderate risk; Class III is high risk. Not applicable for non-medical equipment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fdaRegulatedIndicator rdf:type rdf:Property ;
    rdfs:label 'Fda Regulated Indicator' ;
    rdfs:comment 'Flag indicating whether the fixed asset is a medical device or equipment subject to FDA regulatory oversight and compliance requirements. True for FDA-regulated medical equipment.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insurancePolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Insurance Policy Number' ;
    rdfs:comment 'Policy number of the insurance coverage protecting the fixed asset against loss, damage, or theft. Used for risk management and claims processing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPhysicalInventoryDate rdf:type rdf:Property ;
    rdfs:label 'Last Physical Inventory Date' ;
    rdfs:comment 'Date of the most recent physical inventory audit or verification confirming the existence and condition of the fixed asset.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leaseEndDate rdf:type rdf:Property ;
    rdfs:label 'Lease End Date' ;
    rdfs:comment 'Date on which the lease agreement for the fixed asset expires. Null for owned assets. Used for lease renewal planning and return logistics.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leaseIndicator rdf:type rdf:Property ;
    rdfs:label 'Lease Indicator' ;
    rdfs:comment 'Flag indicating whether the fixed asset is leased (True) or owned (False). Determines accounting treatment under ASC 842 lease accounting standards.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leaseType rdf:type rdf:Property ;
    rdfs:label 'Lease Type' ;
    rdfs:comment 'Classification of the lease agreement if the asset is leased. Operating lease transfers use rights; finance/capital lease transfers substantially all risks and rewards of ownership. Not applicable for owned assets.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceSchedule rdf:type rdf:Property ;
    rdfs:label 'Maintenance Schedule' ;
    rdfs:comment 'Frequency of scheduled preventive maintenance required for the fixed asset to ensure safe operation and regulatory compliance. Critical for medical equipment and life safety systems. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|as_needed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufacturerName rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Name' ;
    rdfs:comment 'Name of the original equipment manufacturer (OEM) who produced the fixed asset. May differ from vendor if purchased through a distributor.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelNumber rdf:type rdf:Property ;
    rdfs:label 'Model Number' ;
    rdfs:comment 'Manufacturer-assigned model number or designation that identifies the specific product configuration and specifications of the fixed asset.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netBookValue rdf:type rdf:Property ;
    rdfs:label 'Net Book Value' ;
    rdfs:comment 'Current carrying value of the fixed asset calculated as acquisition cost minus accumulated depreciation. Represents the undepreciated balance on the balance sheet. Recorded in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextMaintenanceDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Maintenance Due Date' ;
    rdfs:comment 'Scheduled date for the next preventive maintenance service based on the maintenance schedule and last service date. Used for maintenance planning and compliance tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:physicalLocation rdf:type rdf:Property ;
    rdfs:label 'Physical Location' ;
    rdfs:comment 'Current physical location of the fixed asset including facility name, building, floor, room number, or department where the asset is deployed and in use.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placedInServiceDate rdf:type rdf:Property ;
    rdfs:label 'Placed In Service Date' ;
    rdfs:comment 'Date on which the fixed asset was ready and available for its intended use and depreciation began. May differ from acquisition date for assets requiring installation or construction.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:purchaseOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Number' ;
    rdfs:comment 'Purchase order number under which the fixed asset was procured. Links the asset to the original procurement transaction and vendor contract.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsiblePartyName rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Name' ;
    rdfs:comment 'Name of the individual or role responsible for the custody, maintenance, and proper use of the fixed asset. Typically a department manager or equipment coordinator.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageValue rdf:type rdf:Property ;
    rdfs:label 'Salvage Value' ;
    rdfs:comment 'Estimated residual value of the fixed asset at the end of its useful life. Amount expected to be recovered through sale or disposal. Recorded in USD.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serialNumber rdf:type rdf:Property ;
    rdfs:label 'Serial Number' ;
    rdfs:comment 'Manufacturer-assigned unique serial number that identifies the individual unit of the fixed asset for warranty, service, and tracking purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Useful Life Years' ;
    rdfs:comment 'Estimated number of years the fixed asset is expected to provide economic benefit to the healthcare organization. Used to calculate depreciation expense.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Warranty Expiration Date' ;
    rdfs:comment 'Date on which the manufacturer or vendor warranty coverage for the fixed asset expires. Used for maintenance planning and service contract decisions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:depreciationScheduleId rdf:type rdf:Property ;
    rdfs:label 'Depreciation Schedule Id' ;
    rdfs:comment 'Unique identifier for the depreciation schedule entry. Primary key for this transactional record of periodic depreciation calculation and posting.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depreciationRunId rdf:type rdf:Property ;
    rdfs:label 'Depreciation Run Id' ;
    rdfs:comment 'Reference to the batch depreciation calculation run that generated this entry. Links all depreciation entries processed together.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DepreciationRun .

ind:expenseChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Expense Chart Of Accounts Id' ;
    rdfs:comment 'Foreign key linking to finance.chart_of_accounts. Business justification: depreciation_schedule has depreciation_expense_gl_account (STRING) which should be normalized to FK to chart_of_accounts. Using expense_chart_of_accounts_id as the FK name to distinguish from the ac' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:priorDepreciationScheduleId rdf:type rdf:Property ;
    rdfs:label 'Prior Depreciation Schedule Id' ;
    rdfs:comment 'Self-referencing FK on depreciation_schedule (prior_depreciation_schedule_id)' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DepreciationSchedule .

ind:accumulatedDepreciationBalance rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation Balance' ;
    rdfs:comment 'The cumulative total of all depreciation expense recognized on this asset from acquisition through the current period. Contra-asset account balance.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accumulatedDepreciationGlAccount rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation Gl Account' ;
    rdfs:comment 'The general ledger account code credited for accumulated depreciation. Contra-asset account that offsets the fixed asset account.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Adjustment Flag' ;
    rdfs:comment 'Indicates whether this entry represents an adjustment to a previously posted depreciation calculation. True if adjustment, False if original entry.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:beginningNetBookValue rdf:type rdf:Property ;
    rdfs:label 'Beginning Net Book Value' ;
    rdfs:comment 'The net book value of the asset at the beginning of the depreciation period. Calculated as original cost minus accumulated depreciation from prior periods.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookTaxDifference rdf:type rdf:Property ;
    rdfs:label 'Book Tax Difference' ;
    rdfs:comment 'The difference between book depreciation expense and tax depreciation amount for this period. Used for deferred tax calculations.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationDate rdf:type rdf:Property ;
    rdfs:label 'Depreciation Date' ;
    rdfs:comment 'The specific date on which this depreciation calculation was performed and recognized. Typically the last day of the fiscal period.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:depreciationExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Depreciation Expense Amount' ;
    rdfs:comment 'The depreciation expense amount calculated and recognized for this period. This amount is debited to the depreciation expense account.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endingNetBookValue rdf:type rdf:Property ;
    rdfs:label 'Ending Net Book Value' ;
    rdfs:comment 'The net book value of the asset at the end of the depreciation period. Calculated as beginning net book value minus current period depreciation expense.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityCode rdf:type rdf:Property ;
    rdfs:label 'Facility Code' ;
    rdfs:comment 'The facility or location code where the asset is deployed. Enables facility-level capital asset and depreciation reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impairmentAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Impairment Adjustment Amount' ;
    rdfs:comment 'Any impairment loss recognized in this period that reduces the carrying value of the asset below its recoverable amount. Zero if no impairment occurred.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postedBy rdf:type rdf:Property ;
    rdfs:label 'Posted By' ;
    rdfs:comment 'The user ID or name of the person who posted this depreciation entry to the general ledger. Supports audit trail and accountability.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedDate rdf:type rdf:Property ;
    rdfs:label 'Posted Date' ;
    rdfs:comment 'The date on which this depreciation entry was posted to the general ledger. May differ from the depreciation date for timing reasons.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxDepreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Depreciation Amount' ;
    rdfs:comment 'The depreciation amount calculated for tax reporting purposes, which may differ from book depreciation due to tax regulations such as MACRS.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usefulLifeRemainingMonths rdf:type rdf:Property ;
    rdfs:label 'Useful Life Remaining Months' ;
    rdfs:comment 'The number of months of useful life remaining for the asset after this depreciation period. Used for forecasting future depreciation.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capitalProjectId rdf:type rdf:Property ;
    rdfs:label 'Capital Project Id' ;
    rdfs:comment 'Unique identifier for the capital project record. Primary key for the capital project entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitalProject .

ind:capitalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Capital Employee Id' ;
    rdfs:comment 'Identifier of the user who created this capital project record. Links to the employee or user record for audit purposes.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentCapitalProjectId rdf:type rdf:Property ;
    rdfs:label 'Parent Capital Project Id' ;
    rdfs:comment 'Self-referencing FK on capital_project (parent_capital_project_id)' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitalProject .

ind:researchGrantAwardId rdf:type rdf:Property ;
    rdfs:label 'Research Grant Award Id' ;
    rdfs:comment 'Foreign key linking to research.grant. Business justification: Capital projects can be funded by research grants requiring tracking for compliance, financial reporting, and audit trails. Essential for grant-funded capital equipment purchases, facility constructio' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchGrantAward .

ind:approvedCapitalBudget rdf:type rdf:Property ;
    rdfs:label 'Approved Capital Budget' ;
    rdfs:comment 'Total capital budget amount approved by the board or authorized approver for this project. Represents the spending authority ceiling.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetClass rdf:type rdf:Property ;
    rdfs:label 'Asset Class' ;
    rdfs:comment 'Classification of the resulting capital asset for depreciation and financial reporting: building, building improvement, land improvement, equipment, software, or infrastructure.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bondIssueNumber rdf:type rdf:Property ;
    rdfs:label 'Bond Issue Number' ;
    rdfs:comment 'Bond issue identifier if this project is funded through bond financing. Links to the bond issuance record for debt service tracking.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessJustification rdf:type rdf:Property ;
    rdfs:label 'Business Justification' ;
    rdfs:comment 'Business case and rationale for the capital investment, including expected benefits, return on investment, and strategic alignment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalizationStatus rdf:type rdf:Property ;
    rdfs:label 'Capitalization Status' ;
    rdfs:comment 'Accounting treatment status for project costs: not_capitalized (project not yet eligible), in_progress (costs accumulating in construction-in-progress), capitalized (asset placed in service and capitalized), or expensed (costs expensed rather than capitalized).' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedAnnualRevenue rdf:type rdf:Property ;
    rdfs:label 'Expected Annual Revenue' ;
    rdfs:comment 'Projected annual revenue to be generated by this capital project once operational. Used for return on investment analysis.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedAnnualSavings rdf:type rdf:Property ;
    rdfs:label 'Expected Annual Savings' ;
    rdfs:comment 'Projected annual cost savings or expense reduction resulting from this capital project (e.g., energy efficiency, labor reduction, supply chain optimization).' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isRegulatoryRequired rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Required' ;
    rdfs:comment 'Indicates whether this capital project is required to meet regulatory compliance, accreditation standards, or legal mandates (e.g., Joint Commission, CMS Conditions of Participation, OSHA, fire code).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:projectDescription rdf:type rdf:Property ;
    rdfs:label 'Project Description' ;
    rdfs:comment 'Detailed narrative description of the capital project scope, objectives, and deliverables. Provides context for stakeholders and auditors.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectName rdf:type rdf:Property ;
    rdfs:label 'Project Name' ;
    rdfs:comment 'Descriptive name of the capital project for identification and reporting purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectNotes rdf:type rdf:Property ;
    rdfs:label 'Project Notes' ;
    rdfs:comment 'Free-text field for additional notes, comments, or context about the capital project. Used for project history and knowledge transfer.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectNumber rdf:type rdf:Property ;
    rdfs:label 'Project Number' ;
    rdfs:comment 'Business identifier for the capital project, used for external reference and reporting. Unique across all capital projects.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectPhase rdf:type rdf:Property ;
    rdfs:label 'Project Phase' ;
    rdfs:comment 'Current phase of the project lifecycle: initiation (concept development), planning (detailed planning), design (architectural/engineering design), procurement (vendor selection), construction (build/implementation), testing (commissioning), or closeout (final documentation). [ENUM-REF-CANDIDATE: initiation|planning|design|procurement|construction|testing|closeout — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectPriority rdf:type rdf:Property ;
    rdfs:label 'Project Priority' ;
    rdfs:comment 'Strategic priority level assigned to this capital project for resource allocation and scheduling: critical (immediate need), high (near-term priority), medium (planned investment), or low (deferred opportunity).' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectStartDate rdf:type rdf:Property ;
    rdfs:label 'Project Start Date' ;
    rdfs:comment 'Date when the capital project officially commenced or is scheduled to commence. Represents the beginning of the project timeline.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectStatus rdf:type rdf:Property ;
    rdfs:label 'Project Status' ;
    rdfs:comment 'Current lifecycle status of the capital project: planning (initial scoping), approved (budget authorized), in progress (active construction or implementation), on hold (temporarily suspended), completed (project closed), or cancelled (project terminated).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectType rdf:type rdf:Property ;
    rdfs:label 'Project Type' ;
    rdfs:comment 'Classification of the capital project by nature of investment: construction (new building), renovation (facility upgrade), equipment acquisition (medical or operational equipment), IT implementation (technology systems), leasehold improvement (tenant improvements), or infrastructure (utilities, parking, grounds).' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectedCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Projected Completion Date' ;
    rdfs:comment 'Planned or forecasted date for project completion. Updated as project progresses and schedule changes occur.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:strategicInitiative rdf:type rdf:Property ;
    rdfs:label 'Strategic Initiative' ;
    rdfs:comment 'Name or identifier of the strategic initiative or program that this capital project supports. Links project to organizational strategy.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalActualCosts rdf:type rdf:Property ;
    rdfs:label 'Total Actual Costs' ;
    rdfs:comment 'Cumulative amount of actual expenditures incurred and recorded against this project. Represents cash outflows and accrued expenses.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCommittedCosts rdf:type rdf:Property ;
    rdfs:label 'Total Committed Costs' ;
    rdfs:comment 'Cumulative amount of costs committed through purchase orders, contracts, and other binding obligations for this project. Represents encumbered funds.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variancePercent rdf:type rdf:Property ;
    rdfs:label 'Variance Percent' ;
    rdfs:comment 'Current budget variance expressed as a percentage of approved budget. Used for variance threshold monitoring and escalation.' ;
    rdfs:domain ind:CapitalProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalExpenditureId rdf:type rdf:Property ;
    rdfs:label 'Capital Expenditure Id' ;
    rdfs:comment 'Unique identifier for the capital expenditure transaction record.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modalityId rdf:type rdf:Property ;
    rdfs:label 'Modality Id' ;
    rdfs:comment 'Foreign key linking to radiology.modality. Business justification: Capital expenditures for imaging equipment purchases must link to the resulting operational modality asset to track project-to-asset lifecycle, verify capitalization upon installation, enable acquisit' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Modality .

ind:reversedCapitalExpenditureId rdf:type rdf:Property ;
    rdfs:label 'Reversed Capital Expenditure Id' ;
    rdfs:comment 'Self-referencing FK on capital_expenditure (reversed_capital_expenditure_id)' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitalExpenditure .

ind:assetPlacedInServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Asset Placed In Service Flag' ;
    rdfs:comment 'Indicates whether the capital asset associated with this expenditure has been placed into active service and is ready for depreciation.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capitalizationEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Capitalization Eligible Flag' ;
    rdfs:comment 'Indicates whether this expenditure meets the criteria for capitalization as a fixed asset per GAAP standards.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cipCategory rdf:type rdf:Property ;
    rdfs:label 'Cip Category' ;
    rdfs:comment 'Classification of the capital expenditure within the Construction In Progress accounting category, used for tracking costs before capitalization.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Expenditure Amount' ;
    rdfs:comment 'Monetary value of the capital expenditure transaction in the specified currency.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenditureDate rdf:type rdf:Property ;
    rdfs:label 'Expenditure Date' ;
    rdfs:comment 'The date on which the capital expenditure transaction occurred or was recorded.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expenditureDescription rdf:type rdf:Property ;
    rdfs:label 'Expenditure Description' ;
    rdfs:comment 'Detailed narrative description of the capital expenditure transaction, including purpose and justification.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureNumber rdf:type rdf:Property ;
    rdfs:label 'Expenditure Number' ;
    rdfs:comment 'Business identifier for the capital expenditure transaction, used for tracking and reference.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureStatus rdf:type rdf:Property ;
    rdfs:label 'Expenditure Status' ;
    rdfs:comment 'Current lifecycle status of the capital expenditure transaction in the financial system.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureType rdf:type rdf:Property ;
    rdfs:label 'Expenditure Type' ;
    rdfs:comment 'Classification of the capital expenditure transaction indicating the nature of the cost incurred.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalLaborFlag rdf:type rdf:Property ;
    rdfs:label 'Internal Labor Flag' ;
    rdfs:comment 'Indicates whether this expenditure represents internal labor costs allocated to the capital project.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laborHours rdf:type rdf:Property ;
    rdfs:label 'Labor Hours' ;
    rdfs:comment 'Number of labor hours charged to this capital expenditure for internal labor costs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laborRate rdf:type rdf:Property ;
    rdfs:label 'Labor Rate' ;
    rdfs:comment 'Hourly rate applied to internal labor hours for calculating the labor cost component of this capital expenditure.' ;
    rdfs:domain ind:CapitalExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costAllocationId rdf:type rdf:Property ;
    rdfs:label 'Cost Allocation Id' ;
    rdfs:comment 'Unique identifier for the cost allocation transaction record.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationMethodId rdf:type rdf:Property ;
    rdfs:label 'Allocation Method Id' ;
    rdfs:comment 'FK to finance.allocation_method' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AllocationMethod .

ind:allocationRunId rdf:type rdf:Property ;
    rdfs:label 'Allocation Run Id' ;
    rdfs:comment 'Identifier for the batch allocation run that generated this allocation record. Groups all allocations processed in a single execution cycle.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AllocationRun .

ind:costEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Cost Employee Id' ;
    rdfs:comment 'FK to workforce.employee identifying the employee who prepared/executed this cost allocation entry' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:priorCostAllocationId rdf:type rdf:Property ;
    rdfs:label 'Prior Cost Allocation Id' ;
    rdfs:comment 'Self-referencing FK to the prior period cost allocation record this entry supersedes, enabling allocation version tracking' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostAllocation .

ind:targetCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Target Cost Center Id' ;
    rdfs:comment 'The direct patient care or revenue-generating cost center receiving the allocated costs. Represents departments such as surgery, emergency, radiology, or inpatient units.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:allocatedAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Amount' ;
    rdfs:comment 'The dollar amount of overhead or indirect cost allocated from the source cost center to the target cost center in this transaction. Calculated as source cost pool multiplied by allocation basis percentage.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Allocation Adjustment Amount' ;
    rdfs:comment 'Any manual adjustment applied to the calculated allocated amount. Used for corrections, policy adjustments, or rounding reconciliation.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationBasis rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis' ;
    rdfs:comment 'The statistical or financial metric used to distribute costs from source to target cost centers. Square footage for facilities costs, FTE for HR costs, revenue for administrative overhead, RVU for clinical support, patient days for nursing, labor hours for supervision, transactions for IT, direct cost for proportional allocation, bed count for capacity-based allocation, and visits for outpatient services. [ENUM-REF-CANDIDATE: square_footage|fte|revenue|rvu|patient_days|labor_hours|transactions|direct_cost|bed_count|visits — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationBasisPercentage rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis Percentage' ;
    rdfs:comment 'The percentage of the total allocation basis that the target cost center represents. Calculated as target quantity divided by sum of all target quantities. Used to distribute source costs proportionally.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationBasisQuantity rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis Quantity' ;
    rdfs:comment 'The numeric quantity of the allocation basis metric for the target cost center. For example, 5000 square feet, 25.5 FTEs, 1200 patient days, or 8500 RVUs.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationCategory rdf:type rdf:Property ;
    rdfs:label 'Allocation Category' ;
    rdfs:comment 'The functional category of overhead cost being allocated. Groups allocations by the type of support service provided. [ENUM-REF-CANDIDATE: facilities|information_technology|human_resources|administration|finance|legal|compliance|quality|marketing — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Date' ;
    rdfs:comment 'The business date on which this cost allocation was executed and recorded. Typically the last day of the fiscal period being allocated.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationNotes rdf:type rdf:Property ;
    rdfs:label 'Allocation Notes' ;
    rdfs:comment 'Free-text field for documenting special circumstances, adjustments, or explanations related to this specific allocation transaction.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationRunStatus rdf:type rdf:Property ;
    rdfs:label 'Allocation Run Status' ;
    rdfs:comment 'The current lifecycle status of this allocation record. Draft indicates preliminary calculation, pending approval awaits finance review, approved is ready for posting, posted means committed to GL, reversed indicates correction, and cancelled means voided.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationSequence rdf:type rdf:Property ;
    rdfs:label 'Allocation Sequence' ;
    rdfs:comment 'The order in which this allocation was processed within the allocation run. Critical for step-down methodology where sequence determines which cost centers allocate first.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationTier rdf:type rdf:Property ;
    rdfs:label 'Allocation Tier' ;
    rdfs:comment 'The hierarchical tier or level of this allocation in multi-tier allocation methodologies. Tier 1 represents first-level overhead, tier 2 represents second-level, and so on.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationVersion rdf:type rdf:Property ;
    rdfs:label 'Allocation Version' ;
    rdfs:comment 'Version identifier for the allocation run. Supports multiple allocation scenarios such as budget, forecast, actual, or what-if analysis.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMedicareReportable rdf:type rdf:Property ;
    rdfs:label 'Is Medicare Reportable' ;
    rdfs:comment 'Indicates whether this allocation must be reported on the Medicare Cost Report (CMS-2552-10) for reimbursement calculation purposes.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReciprocalAllocation rdf:type rdf:Property ;
    rdfs:label 'Is Reciprocal Allocation' ;
    rdfs:comment 'Indicates whether this allocation is part of a reciprocal allocation cycle where two or more cost centers provide mutual services to each other.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceCostPoolAmount rdf:type rdf:Property ;
    rdfs:label 'Source Cost Pool Amount' ;
    rdfs:comment 'The total amount of costs available in the source cost center for allocation before distribution. Represents the full overhead pool being allocated across all target cost centers.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Allocation Employee Id' ;
    rdfs:comment 'Identifier of the user who created this allocation method record. Links to workforce or user management system for accountability.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:ownerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Owner Employee Id' ;
    rdfs:comment 'Identifier of the cost accounting analyst or finance manager responsible for maintaining and updating this allocation method. Links to workforce or user management system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supersededAllocationMethodId rdf:type rdf:Property ;
    rdfs:label 'Superseded Allocation Method Id' ;
    rdfs:comment 'Identifier of the previous allocation method that this method replaces. Creates a lineage chain for tracking method evolution and supporting historical cost report reconstruction.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AllocationMethod .

ind:activityDriverDescription rdf:type rdf:Property ;
    rdfs:label 'Activity Driver Description' ;
    rdfs:comment 'For activity-based costing (ABC) methods, describes the specific activity or cost driver that causes costs to be incurred. Examples include number of purchase orders processed, number of patient admissions, number of surgical procedures performed. Provides transparency into ABC methodology.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationBasisType rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis Type' ;
    rdfs:comment 'The statistical or financial measure used as the basis for distributing costs. Square footage for facility costs; FTE (Full-Time Equivalent) count for HR costs; revenue for administrative overhead; RVU (Relative Value Unit) for physician services; patient days for nursing; procedures for surgical services; direct cost for proportional allocation; labor hours for labor-intensive departments; visits for outpatient services; discharges for inpatient services. [ENUM-REF-CANDIDATE: square_footage|fte_count|revenue|rvu|patient_days|procedures|direct_cost|labor_hours|visits|discharges — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationFrequency rdf:type rdf:Property ;
    rdfs:label 'Allocation Frequency' ;
    rdfs:comment 'How often this allocation method is executed. Monthly for routine cost accounting; quarterly for less frequent allocations; annually for year-end adjustments; as needed for special allocations; real-time for continuous allocation in advanced systems.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationPercentageCap rdf:type rdf:Property ;
    rdfs:label 'Allocation Percentage Cap' ;
    rdfs:comment 'Maximum percentage of source cost that can be allocated to any single target cost center. Used to prevent disproportionate allocation and ensure equitable distribution. Expressed as a percentage (e.g., 25.00 for 25%).' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditTrailRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Required Flag' ;
    rdfs:comment 'Indicates whether detailed audit trail logging is required for allocations using this method. True for regulatory or high-value allocations requiring full traceability; false for routine internal allocations.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:basisDataSource rdf:type rdf:Property ;
    rdfs:label 'Basis Data Source' ;
    rdfs:comment 'The system, report, or data source from which the allocation basis statistics are obtained. Examples include facility management system for square footage, HR system for FTE counts, general ledger for revenue, clinical system for RVUs and patient days.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationFormula rdf:type rdf:Property ;
    rdfs:label 'Calculation Formula' ;
    rdfs:comment 'The mathematical formula or algorithm used to calculate allocation amounts. May reference basis statistics, weighting factors, and cost pools. Provides transparency and reproducibility for cost accounting calculations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsCostReportSchedule rdf:type rdf:Property ;
    rdfs:label 'Cms Cost Report Schedule' ;
    rdfs:comment 'The specific Medicare Cost Report worksheet or schedule to which this allocation method applies. Examples include Worksheet A (Reclassification and Adjustment of Trial Balance), Worksheet B (Cost Allocation), Worksheet C (Departmental Cost Allocation). Critical for regulatory compliance and reimbursement.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decimalPrecision rdf:type rdf:Property ;
    rdfs:label 'Decimal Precision' ;
    rdfs:comment 'Number of decimal places to which allocation amounts are calculated and stored. Typically 2 for dollar amounts, but may be higher for statistical allocations or percentage calculations.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gaapCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Gaap Compliant Flag' ;
    rdfs:comment 'Indicates whether this allocation method complies with Generally Accepted Accounting Principles (GAAP) for financial statement preparation. True for methods acceptable under GAAP; false for methods used only for internal or regulatory purposes.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:methodCode rdf:type rdf:Property ;
    rdfs:label 'Method Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the allocation method for system processing and reporting. Used in cost accounting transactions and Medicare Cost Report preparation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodDescription rdf:type rdf:Property ;
    rdfs:label 'Method Description' ;
    rdfs:comment 'Detailed narrative description of the allocation method, including business rationale, calculation approach, and any special considerations. Used for documentation, training, and audit support.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodName rdf:type rdf:Property ;
    rdfs:label 'Method Name' ;
    rdfs:comment 'Full descriptive name of the cost allocation method. Human-readable label used in financial reports and cost accounting documentation.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodStatus rdf:type rdf:Property ;
    rdfs:label 'Method Status' ;
    rdfs:comment 'Current lifecycle status of the allocation method. Active methods are in use; inactive methods are retired; pending approval methods await finance leadership sign-off; deprecated methods are being phased out; under review methods are being evaluated for changes.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodType rdf:type rdf:Property ;
    rdfs:label 'Method Type' ;
    rdfs:comment 'Classification of the cost allocation methodology. Step-down allocates overhead sequentially; direct allocates without intermediate steps; reciprocal accounts for mutual service exchanges; activity-based costing (ABC) allocates based on cost drivers; simultaneous solves all allocations concurrently; double distribution performs two-pass allocation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPeriodAdjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Prior Period Adjustment Flag' ;
    rdfs:comment 'Indicates whether this allocation method supports retroactive adjustments to prior accounting periods. True for methods that allow historical corrections; false for methods that only allocate current period costs.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reciprocalAllocationFlag rdf:type rdf:Property ;
    rdfs:label 'Reciprocal Allocation Flag' ;
    rdfs:comment 'Indicates whether this method supports reciprocal allocation where departments can allocate costs to each other. True for methods that handle mutual service exchanges; false for unidirectional allocation methods.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roundingRule rdf:type rdf:Property ;
    rdfs:label 'Rounding Rule' ;
    rdfs:comment 'Specifies how calculated allocation amounts are rounded. Round half up rounds 0.5 and above up; round half down rounds 0.5 and below down; round up always rounds up; round down always rounds down; truncate drops decimals; no rounding preserves full precision. Critical for ensuring allocation totals reconcile to source costs.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceCostCenterCategory rdf:type rdf:Property ;
    rdfs:label 'Source Cost Center Category' ;
    rdfs:comment 'Classification of the cost centers from which costs are allocated using this method. Overhead includes facilities and utilities; administrative includes finance and HR; support services includes IT and housekeeping; ancillary includes lab and radiology; clinical includes nursing and therapy; revenue-producing vs non-revenue-producing distinguishes direct patient care from support functions. [ENUM-REF-CANDIDATE: overhead|administrative|support_services|ancillary|clinical|revenue_producing|non_revenue_producing — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCostCenterCategory rdf:type rdf:Property ;
    rdfs:label 'Target Cost Center Category' ;
    rdfs:comment 'Classification of the cost centers to which costs are allocated using this method. Defines the recipient departments for overhead distribution. Patient care only excludes further allocation to administrative departments.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageNotes rdf:type rdf:Property ;
    rdfs:label 'Usage Notes' ;
    rdfs:comment 'Free-text field for cost accounting analysts to document special instructions, exceptions, or considerations when applying this allocation method. Supports knowledge transfer and operational continuity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightingFactor rdf:type rdf:Property ;
    rdfs:label 'Weighting Factor' ;
    rdfs:comment 'Numeric multiplier applied to the allocation basis to adjust for intensity, complexity, or other factors. Used to refine allocation precision when raw statistics do not fully reflect cost consumption patterns.' ;
    rdfs:domain ind:AllocationMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Cash Chart Of Accounts Id' ;
    rdfs:comment 'Foreign key linking to finance.chart_of_accounts. Business justification: bank_account has gl_cash_account_code (STRING) which should be normalized to FK to chart_of_accounts. Enables joining to get the GL cash account details. Using cash_chart_of_accounts_id as the FK na' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:parentBankAccountId rdf:type rdf:Property ;
    rdfs:label 'Parent Bank Account Id' ;
    rdfs:comment 'Self-referencing FK on bank_account (parent_bank_account_id)' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankAccount .

ind:accountClosedDate rdf:type rdf:Property ;
    rdfs:label 'Account Closed Date' ;
    rdfs:comment 'The date on which the bank account was officially closed and is no longer available for transactions. Null if the account is still active.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountNotes rdf:type rdf:Property ;
    rdfs:label 'Account Notes' ;
    rdfs:comment 'Free-text field for capturing additional information, special instructions, or operational notes related to the bank account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountOpenedDate rdf:type rdf:Property ;
    rdfs:label 'Account Opened Date' ;
    rdfs:comment 'The date on which the bank account was originally opened with the financial institution.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountPurpose rdf:type rdf:Property ;
    rdfs:label 'Account Purpose' ;
    rdfs:comment 'The designated business purpose or functional use of the bank account within the healthcare organizations treasury operations.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:achEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Ach Enabled Flag' ;
    rdfs:comment 'Indicates whether the account is enabled to send and receive ACH electronic funds transfers for payroll, vendor payments, and other automated transactions.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:availableBalance rdf:type rdf:Property ;
    rdfs:label 'Available Balance' ;
    rdfs:comment 'The amount of funds available for immediate withdrawal or payment, accounting for pending transactions and holds.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankBranchAddress rdf:type rdf:Property ;
    rdfs:label 'Bank Branch Address' ;
    rdfs:comment 'The physical street address of the bank branch where the account is maintained.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankBranchName rdf:type rdf:Property ;
    rdfs:label 'Bank Branch Name' ;
    rdfs:comment 'The name of the specific bank branch where the account is domiciled and serviced.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankContactEmail rdf:type rdf:Property ;
    rdfs:label 'Bank Contact Email' ;
    rdfs:comment 'The email address of the bank relationship manager or primary contact for electronic communication regarding the account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankContactName rdf:type rdf:Property ;
    rdfs:label 'Bank Contact Name' ;
    rdfs:comment 'The name of the primary relationship manager or contact person at the financial institution for this account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankContactPhone rdf:type rdf:Property ;
    rdfs:label 'Bank Contact Phone' ;
    rdfs:comment 'The telephone number of the bank relationship manager or primary contact for account inquiries and issue resolution.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankName rdf:type rdf:Property ;
    rdfs:label 'Bank Name' ;
    rdfs:comment 'The legal name of the financial institution where the account is maintained.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Routing Number' ;
    rdfs:comment 'The nine-digit American Bankers Association (ABA) routing transit number that identifies the financial institution for electronic funds transfers and check processing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankSwiftCode rdf:type rdf:Property ;
    rdfs:label 'Bank Swift Code' ;
    rdfs:comment 'The Society for Worldwide Interbank Financial Telecommunication (SWIFT) Business Identifier Code (BIC) used for international wire transfers and cross-border payments.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dualSignatureRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Dual Signature Required Flag' ;
    rdfs:comment 'Indicates whether transactions above a certain threshold require two authorized signatures for approval and execution.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dualSignatureThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Dual Signature Threshold Amount' ;
    rdfs:comment 'The monetary threshold above which dual signature authorization is required for transactions on this account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fdicCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Fdic Certificate Number' ;
    rdfs:comment 'The unique FDIC certificate number assigned to the financial institution, used to verify insurance coverage.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fdicInsuredFlag rdf:type rdf:Property ;
    rdfs:label 'Fdic Insured Flag' ;
    rdfs:comment 'Indicates whether the bank account is covered by FDIC insurance protection up to the statutory limit.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Interest Calculation Method' ;
    rdfs:comment 'The frequency and methodology used by the financial institution to calculate and credit interest to the account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Last Reconciliation Date' ;
    rdfs:comment 'The date of the most recent bank reconciliation performed for this account, ensuring alignment between bank statement and general ledger balances.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumBalanceRequired rdf:type rdf:Property ;
    rdfs:label 'Minimum Balance Required' ;
    rdfs:comment 'The minimum account balance that must be maintained to avoid fees or meet contractual requirements with the financial institution.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextReconciliationDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Reconciliation Due Date' ;
    rdfs:comment 'The scheduled date by which the next bank reconciliation must be completed per organizational policy and internal controls.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:onlineBankingEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Online Banking Enabled Flag' ;
    rdfs:comment 'Indicates whether online banking access and electronic transaction capabilities are enabled for this account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:positivePayEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Positive Pay Enabled Flag' ;
    rdfs:comment 'Indicates whether positive pay fraud prevention service is enabled, requiring pre-authorization of checks and ACH transactions before they are honored by the bank.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primarySignatoryName rdf:type rdf:Property ;
    rdfs:label 'Primary Signatory Name' ;
    rdfs:comment 'The name of the primary authorized signatory who has authority to execute transactions and sign checks on this bank account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySignatoryTitle rdf:type rdf:Property ;
    rdfs:label 'Primary Signatory Title' ;
    rdfs:comment 'The job title or position of the primary authorized signatory within the healthcare organization.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictedFundFlag rdf:type rdf:Property ;
    rdfs:label 'Restricted Fund Flag' ;
    rdfs:comment 'Indicates whether the account holds restricted funds that are subject to donor restrictions, grant requirements, or regulatory limitations on use.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restrictionDescription rdf:type rdf:Property ;
    rdfs:label 'Restriction Description' ;
    rdfs:comment 'A detailed description of any restrictions placed on the use of funds in this account, including donor stipulations, grant conditions, or regulatory requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondarySignatoryName rdf:type rdf:Property ;
    rdfs:label 'Secondary Signatory Name' ;
    rdfs:comment 'The name of the secondary authorized signatory who has backup authority to execute transactions on this bank account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wireTransferEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Wire Transfer Enabled Flag' ;
    rdfs:comment 'Indicates whether the account is authorized to initiate and receive domestic and international wire transfers.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financeBankReconciliationId rdf:type rdf:Property ;
    rdfs:label 'Finance Bank Reconciliation Id' ;
    rdfs:comment 'Unique identifier for the bank reconciliation record. Primary key for the bank reconciliation transaction.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorReconciliationBankReconciliationFinanceBankReconciliationId rdf:type rdf:Property ;
    rdfs:label 'Prior Reconciliation Bank Reconciliation Finance Bank Reconciliation Id' ;
    rdfs:comment 'Self-referencing FK to the immediately preceding bank reconciliation for this account, enabling period-over-period continuity tracking' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceBankReconciliation .

ind:autoReconciliationFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Reconciliation Flag' ;
    rdfs:comment 'Indicates whether this reconciliation was performed automatically by the system using matching algorithms or manually by an accountant. True indicates automated reconciliation, false indicates manual reconciliation.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bankErrorsTotal rdf:type rdf:Property ;
    rdfs:label 'Bank Errors Total' ;
    rdfs:comment 'Total amount of errors identified on the bank statement, such as incorrect charges, duplicate transactions, or processing mistakes by the bank. Positive values indicate bank overstatements, negative values indicate understatements.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankServiceCharges rdf:type rdf:Property ;
    rdfs:label 'Bank Service Charges' ;
    rdfs:comment 'Total bank fees and service charges deducted by the bank during the statement period, including monthly maintenance fees, transaction fees, and wire transfer charges.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookErrorsTotal rdf:type rdf:Property ;
    rdfs:label 'Book Errors Total' ;
    rdfs:comment 'Total amount of errors identified in the organizations general ledger records, such as recording errors, duplicate entries, or omitted transactions. Requires correcting journal entries.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consentExceptionFlag rdf:type rdf:Property ;
    rdfs:label 'Consent Exception Flag' ;
    rdfs:comment 'Indicates whether this reconciliation contains exceptions or unusual items requiring management attention. True indicates exceptions exist, false indicates a clean reconciliation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:depositsInTransitTotal rdf:type rdf:Property ;
    rdfs:label 'Deposits In Transit Total' ;
    rdfs:comment 'Total amount of deposits recorded in the GL but not yet reflected on the bank statement as of the statement date. Represents timing differences between internal recording and bank processing.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glBookBalance rdf:type rdf:Property ;
    rdfs:label 'Gl Book Balance' ;
    rdfs:comment 'The cash account balance as recorded in the general ledger for the reconciliation period. This is the organizations internal record of the account balance.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestEarned rdf:type rdf:Property ;
    rdfs:label 'Interest Earned' ;
    rdfs:comment 'Interest income earned on the bank account during the statement period as reported by the bank. Requires recording in the general ledger if not previously captured.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nsfChecksTotal rdf:type rdf:Property ;
    rdfs:label 'Nsf Checks Total' ;
    rdfs:comment 'Total amount of checks deposited by the organization that were returned by the bank due to insufficient funds in the payers account. Requires reversal of the original deposit entry.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherAdjustmentsTotal rdf:type rdf:Property ;
    rdfs:label 'Other Adjustments Total' ;
    rdfs:comment 'Total amount of miscellaneous adjustments not categorized elsewhere, including electronic fund transfers, automatic payments, or other reconciling items identified during the reconciliation process.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingChecksTotal rdf:type rdf:Property ;
    rdfs:label 'Outstanding Checks Total' ;
    rdfs:comment 'Total amount of checks issued by the organization that have been recorded in the GL but have not yet cleared the bank as of the statement date.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingItemsCount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Items Count' ;
    rdfs:comment 'Total number of outstanding reconciling items identified during the reconciliation process, including outstanding checks, deposits in transit, and other uncleared transactions.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preparationDate rdf:type rdf:Property ;
    rdfs:label 'Preparation Date' ;
    rdfs:comment 'The date on which the reconciliation was initially prepared and completed by the preparer. Distinct from the reconciliation date which represents the business period being reconciled.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:preparerName rdf:type rdf:Property ;
    rdfs:label 'Preparer Name' ;
    rdfs:comment 'Full name of the employee who prepared the bank reconciliation. Provides human-readable identification for reporting and audit purposes.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciledBalance rdf:type rdf:Property ;
    rdfs:label 'Reconciled Balance' ;
    rdfs:comment 'The final adjusted balance after applying all reconciling items to either the bank statement balance or the GL book balance. Both adjusted balances should equal this amount when reconciliation is complete.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciliationNotes rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Notes' ;
    rdfs:comment 'Free-text field for documenting significant findings, unusual items, explanations of variances, or other relevant information discovered during the reconciliation process. Supports audit trail and knowledge transfer.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationNumber rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Number' ;
    rdfs:comment 'Business identifier for the reconciliation transaction, typically formatted as a sequential or date-based reference number used for tracking and audit purposes.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementDate rdf:type rdf:Property ;
    rdfs:label 'Statement Date' ;
    rdfs:comment 'The ending date of the bank statement being reconciled. Represents the cutoff date for transactions included in the bank statement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statementEndingBalance rdf:type rdf:Property ;
    rdfs:label 'Statement Ending Balance' ;
    rdfs:comment 'The ending balance as reported on the bank statement for the statement date. This is the banks record of the account balance.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unreconciledVariance rdf:type rdf:Property ;
    rdfs:label 'Unreconciled Variance' ;
    rdfs:comment 'The remaining difference between the adjusted bank balance and adjusted book balance after all known reconciling items have been applied. A non-zero variance indicates unresolved discrepancies requiring investigation.' ;
    rdfs:domain ind:FinanceBankReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialPeriodCloseId rdf:type rdf:Property ;
    rdfs:label 'Financial Period Close Id' ;
    rdfs:comment 'Unique identifier for the financial period close record. Primary key.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:financialEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Financial Employee Id' ;
    rdfs:comment 'Reference to the employee or user who approved the final close of this period.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:priorFinancialPeriodCloseId rdf:type rdf:Property ;
    rdfs:label 'Prior Financial Period Close Id' ;
    rdfs:comment 'Self-referencing FK on financial_period_close (prior_financial_period_close_id)' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriodClose .

ind:accountsPayableCloseStatus rdf:type rdf:Property ;
    rdfs:label 'Accounts Payable Close Status' ;
    rdfs:comment 'Status of accounts payable close activities, including vendor invoice processing and accrual verification.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accrualCompletionStatus rdf:type rdf:Property ;
    rdfs:label 'Accrual Completion Status' ;
    rdfs:comment 'Status of accrual entries for the period, ensuring all revenue and expenses are recorded in the correct period per accrual accounting.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualCloseDate rdf:type rdf:Property ;
    rdfs:label 'Actual Close Date' ;
    rdfs:comment 'Actual date when the financial period close was completed and the period was locked.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approval Timestamp' ;
    rdfs:comment 'Date and time when the period close was formally approved.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:auditFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Audit Findings Count' ;
    rdfs:comment 'Number of audit findings or exceptions identified during the close process that require resolution.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:balanceSheetReconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Balance Sheet Reconciliation Status' ;
    rdfs:comment 'Status of balance sheet account reconciliations for this period, ensuring all asset, liability, and equity accounts are reconciled.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetVarianceReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Budget Variance Review Status' ;
    rdfs:comment 'Status of budget-to-actual variance analysis and review for this period.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeChecklistCompletedItems rdf:type rdf:Property ;
    rdfs:label 'Close Checklist Completed Items' ;
    rdfs:comment 'Number of checklist items that have been completed for this period close.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closeChecklistCompletionPercentage rdf:type rdf:Property ;
    rdfs:label 'Close Checklist Completion Percentage' ;
    rdfs:comment 'Percentage of close checklist items completed, calculated as (completed_items / total_items) * 100.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closeChecklistTotalItems rdf:type rdf:Property ;
    rdfs:label 'Close Checklist Total Items' ;
    rdfs:comment 'Total number of checklist items that must be completed for this period close.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closeCompletedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Close Completed Timestamp' ;
    rdfs:comment 'Date and time when the period close process was fully completed.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:closeDelayReason rdf:type rdf:Property ;
    rdfs:label 'Close Delay Reason' ;
    rdfs:comment 'Explanation for any delay in completing the period close beyond the planned close date.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeEfficiencyRating rdf:type rdf:Property ;
    rdfs:label 'Close Efficiency Rating' ;
    rdfs:comment 'Qualitative assessment of the efficiency and timeliness of this period close process.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeInitiatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Close Initiated Timestamp' ;
    rdfs:comment 'Date and time when the period close process was initiated.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:closeNotes rdf:type rdf:Property ;
    rdfs:label 'Close Notes' ;
    rdfs:comment 'Additional notes, comments, or observations related to this period close process.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeNumber rdf:type rdf:Property ;
    rdfs:label 'Close Number' ;
    rdfs:comment 'Business identifier for the period close event, typically formatted as YYYY-MM-CLOSE or similar.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeStatus rdf:type rdf:Property ;
    rdfs:label 'Close Status' ;
    rdfs:comment 'Current status of the period close process. Soft close allows limited adjustments; hard close is final and locked.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeType rdf:type rdf:Property ;
    rdfs:label 'Close Type' ;
    rdfs:comment 'Type of financial close being performed: monthly, quarterly, annual, or adjustment period close.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsCostReportStatus rdf:type rdf:Property ;
    rdfs:label 'Cms Cost Report Status' ;
    rdfs:comment 'Status of CMS cost report preparation and submission for this period, required for Medicare reimbursement.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysToClose rdf:type rdf:Property ;
    rdfs:label 'Days To Close' ;
    rdfs:comment 'Number of calendar days taken to complete the close from period end date to actual close date.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:externalAuditStatus rdf:type rdf:Property ;
    rdfs:label 'External Audit Status' ;
    rdfs:comment 'Status of external audit review for this period, typically applicable for year-end closes.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialStatementPreparationStatus rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Preparation Status' ;
    rdfs:comment 'Status of financial statement preparation for this period, including balance sheet, income statement, and cash flow statement.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fixedAssetsCloseStatus rdf:type rdf:Property ;
    rdfs:label 'Fixed Assets Close Status' ;
    rdfs:comment 'Status of fixed asset close activities, including depreciation calculation and asset reconciliation.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hardCloseDate rdf:type rdf:Property ;
    rdfs:label 'Hard Close Date' ;
    rdfs:comment 'Date when the period was permanently closed and locked from further adjustments.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:intercompanyReconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Intercompany Reconciliation Status' ;
    rdfs:comment 'Status of intercompany account reconciliation for this period, ensuring balances between entities are matched.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openItemsCount rdf:type rdf:Property ;
    rdfs:label 'Open Items Count' ;
    rdfs:comment 'Number of outstanding issues or tasks that must be resolved before the period can be closed.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:payrollCloseStatus rdf:type rdf:Property ;
    rdfs:label 'Payroll Close Status' ;
    rdfs:comment 'Status of payroll close activities for this period, ensuring all payroll expenses and liabilities are properly recorded.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedCloseDate rdf:type rdf:Property ;
    rdfs:label 'Planned Close Date' ;
    rdfs:comment 'Target date by which the financial period close should be completed per the close calendar.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReportingStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Status' ;
    rdfs:comment 'Status of regulatory reporting submissions required for this period, such as CMS cost reports or state financial filings.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueCycleCloseStatus rdf:type rdf:Property ;
    rdfs:label 'Revenue Cycle Close Status' ;
    rdfs:comment 'Status of revenue cycle close activities, including patient accounts receivable reconciliation and revenue recognition.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:softCloseDate rdf:type rdf:Property ;
    rdfs:label 'Soft Close Date' ;
    rdfs:comment 'Date when the period was soft closed, allowing limited adjustments before final hard close.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:unpostedJournalsCount rdf:type rdf:Property ;
    rdfs:label 'Unposted Journals Count' ;
    rdfs:comment 'Number of journal entries that have been entered but not yet posted to the general ledger for this period.' ;
    rdfs:domain ind:FinancialPeriodClose ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intercompanyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Intercompany Transaction Id' ;
    rdfs:comment 'Unique identifier for the intercompany transaction record within the integrated delivery network (IDN).' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intercompanyAgreementId rdf:type rdf:Property ;
    rdfs:label 'Intercompany Agreement Id' ;
    rdfs:comment 'Reference to the master intercompany agreement or service level agreement that governs the terms of this transaction.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IntercompanyAgreement .

ind:originatingChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Originating Chart Of Accounts Id' ;
    rdfs:comment 'Foreign key linking to finance.chart_of_accounts. Business justification: intercompany_transaction has originating_gl_account_code (STRING) which should be normalized to FK to chart_of_accounts. Using originating_chart_of_accounts_id as the FK name to distinguish from the' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:primaryIntercompanyFinancialEntityId rdf:type rdf:Property ;
    rdfs:label 'Primary Intercompany Financial Entity Id' ;
    rdfs:comment 'Identifier of the legal entity within the IDN that initiated or is the source of the intercompany transaction.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialEntity .

ind:receivingEntityFinancialEntityId rdf:type rdf:Property ;
    rdfs:label 'Receiving Entity Financial Entity Id' ;
    rdfs:comment 'Identifier of the legal entity within the IDN that receives or is the destination of the intercompany transaction.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialEntity .

ind:reversedIntercompanyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Reversed Intercompany Transaction Id' ;
    rdfs:comment 'Reference to the original intercompany transaction that this record reverses, if applicable.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IntercompanyTransaction .

ind:eliminationIndicator rdf:type rdf:Property ;
    rdfs:label 'Elimination Indicator' ;
    rdfs:comment 'Flag indicating whether this intercompany transaction requires elimination during the consolidated financial statement preparation process.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eliminationPeriod rdf:type rdf:Property ;
    rdfs:label 'Elimination Period' ;
    rdfs:comment 'The fiscal period identifier in which the intercompany elimination entry will be or was recorded for consolidation purposes.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intercompanyTransactionDescription rdf:type rdf:Property ;
    rdfs:label 'Intercompany Transaction Description' ;
    rdfs:comment 'Detailed narrative description of the intercompany transaction explaining the business purpose and nature of the transfer.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originatingEntityCode rdf:type rdf:Property ;
    rdfs:label 'Originating Entity Code' ;
    rdfs:comment 'Business code or abbreviation of the originating legal entity for reporting and identification purposes.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingEntityCode rdf:type rdf:Property ;
    rdfs:label 'Receiving Entity Code' ;
    rdfs:comment 'Business code or abbreviation of the receiving legal entity for reporting and identification purposes.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingGlAccountCode rdf:type rdf:Property ;
    rdfs:label 'Receiving Gl Account Code' ;
    rdfs:comment 'The general ledger account code in the receiving entitys chart of accounts to which this transaction is posted.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Variance Amount' ;
    rdfs:comment 'The monetary difference identified during reconciliation between the originating and receiving entity records for this transaction.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionStatus rdf:type rdf:Property ;
    rdfs:label 'Transaction Status' ;
    rdfs:comment 'Current lifecycle status of the intercompany transaction indicating its processing state and readiness for consolidation. [ENUM-REF-CANDIDATE: draft|pending_approval|approved|posted|reconciled|eliminated|rejected — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentEntityFinancialEntityId rdf:type rdf:Property ;
    rdfs:label 'Parent Entity Financial Entity Id' ;
    rdfs:comment 'Reference to the parent financial entity in the corporate hierarchy. Null for top-level holding companies.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialEntity .

ind:parentFinancialEntityId rdf:type rdf:Property ;
    rdfs:label 'Parent Financial Entity Id' ;
    rdfs:comment 'Self-referencing FK on financial_entity (parent_financial_entity_id)' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialEntity .

ind:consolidationMethod rdf:type rdf:Property ;
    rdfs:label 'Consolidation Method' ;
    rdfs:comment 'Accounting method used to consolidate this entity into parent financial statements.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dunsNumber rdf:type rdf:Property ;
    rdfs:label 'Duns Number' ;
    rdfs:comment 'Nine-digit Dun & Bradstreet identifier used for business credit and vendor management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityCode rdf:type rdf:Property ;
    rdfs:label 'Entity Code' ;
    rdfs:comment 'Unique business identifier code for the legal entity used across financial systems and reporting.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityDescription rdf:type rdf:Property ;
    rdfs:label 'Entity Description' ;
    rdfs:comment 'Detailed narrative description of the entitys business purpose, services, and role within the corporate structure.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityName rdf:type rdf:Property ;
    rdfs:label 'Entity Name' ;
    rdfs:comment 'The full legal name of the entity as registered with regulatory authorities.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityStatus rdf:type rdf:Property ;
    rdfs:label 'Entity Status' ;
    rdfs:comment 'Current operational and legal status of the entity within the corporate structure.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entitySubtype rdf:type rdf:Property ;
    rdfs:label 'Entity Subtype' ;
    rdfs:comment 'Additional classification detail for the entity type (e.g., acute care hospital, specialty clinic, MSSP ACO).' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityType rdf:type rdf:Property ;
    rdfs:label 'Entity Type' ;
    rdfs:comment 'Classification of the legal entity type within the healthcare organization structure. ACO = Accountable Care Organization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalAuditorName rdf:type rdf:Property ;
    rdfs:label 'External Auditor Name' ;
    rdfs:comment 'Name of the external audit firm responsible for auditing this entitys financial statements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalYearEndDay rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year End Day' ;
    rdfs:comment 'Day of month (1-31) representing the end of the entitys fiscal year.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalYearEndMonth rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year End Month' ;
    rdfs:comment 'Month number (1-12) representing the end of the entitys fiscal year for financial reporting purposes.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:incorporationDate rdf:type rdf:Property ;
    rdfs:label 'Incorporation Date' ;
    rdfs:comment 'Date the entity was legally incorporated or established.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:intercompanyEliminationFlag rdf:type rdf:Property ;
    rdfs:label 'Intercompany Elimination Flag' ;
    rdfs:comment 'Indicates whether intercompany transactions involving this entity require elimination entries during consolidation.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jointVentureFlag rdf:type rdf:Property ;
    rdfs:label 'Joint Venture Flag' ;
    rdfs:comment 'Indicates whether this entity is a joint venture with external partners requiring special consolidation treatment.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalEntityAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Address Line1' ;
    rdfs:comment 'Primary street address line for the entitys legal registered address.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Address Line2' ;
    rdfs:comment 'Secondary address line (suite, floor, building) for the entitys legal registered address.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityCity rdf:type rdf:Property ;
    rdfs:label 'Legal Entity City' ;
    rdfs:comment 'City name for the entitys legal registered address.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityCountryCode rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Country Code' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code for the entitys legal registered address.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityPostalCode rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Postal Code' ;
    rdfs:comment 'ZIP or postal code for the entitys legal registered address.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityState rdf:type rdf:Property ;
    rdfs:label 'Legal Entity State' ;
    rdfs:comment 'Two-letter US state code for the entitys legal registered address.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicareCostReportRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Medicare Cost Report Required Flag' ;
    rdfs:comment 'Indicates whether this entity is required to file an annual Medicare cost report with CMS.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ownershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Ownership Percentage' ;
    rdfs:comment 'Percentage of ownership interest held by the parent entity, used for consolidation calculations.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportingTier rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Tier' ;
    rdfs:comment 'Classification tier determining the level of regulatory reporting required for this entity based on size, revenue, or patient volume.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingEntityFlag rdf:type rdf:Property ;
    rdfs:label 'Reporting Entity Flag' ;
    rdfs:comment 'Indicates whether this entity produces standalone financial statements for external reporting.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateOfIncorporation rdf:type rdf:Property ;
    rdfs:label 'State Of Incorporation' ;
    rdfs:comment 'Two-letter US state code where the entity is legally incorporated or registered.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxExemptStatus rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Status' ;
    rdfs:comment 'IRS tax-exempt classification for the entity. 501(c)(3) is common for nonprofit hospitals and foundations.' ;
    rdfs:domain ind:FinancialEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdentifier rdf:type rdf:Property ;
    rdfs:label 'Tax Identifier' ;
    rdfs:comment 'Federal Employer Identification Number (EIN) assigned by the IRS for tax reporting purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:donorId rdf:type rdf:Property ;
    rdfs:label 'Donor Id' ;
    rdfs:comment 'Reference to the donor entity in the donor management system for restricted and endowment funds.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Donor .

ind:parentFundId rdf:type rdf:Property ;
    rdfs:label 'Parent Fund Id' ;
    rdfs:comment 'Reference to a parent fund if this fund is a sub-fund or component of a larger fund structure.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:primaryConsolidationFundId rdf:type rdf:Property ;
    rdfs:label 'Primary Consolidation Fund Id' ;
    rdfs:comment 'Reference to the fund into which this fund rolls up for consolidated financial reporting.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:balance rdf:type rdf:Property ;
    rdfs:label 'Balance' ;
    rdfs:comment 'Current balance of the fund representing the difference between fund assets and liabilities. For endowments, represents the corpus and accumulated earnings.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beginningBalance rdf:type rdf:Property ;
    rdfs:label 'Beginning Balance' ;
    rdfs:comment 'Fund balance at the start of the current fiscal period, used for reconciliation and variance analysis.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closureDate rdf:type rdf:Property ;
    rdfs:label 'Closure Date' ;
    rdfs:comment 'Date when the fund was formally closed and all balances transferred or depleted.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closureReason rdf:type rdf:Property ;
    rdfs:label 'Closure Reason' ;
    rdfs:comment 'Explanation for why the fund was closed, such as purpose fulfilled, grant expired, or donor request.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:donorRestrictionIndicator rdf:type rdf:Property ;
    rdfs:label 'Donor Restriction Indicator' ;
    rdfs:comment 'Flag indicating whether the fund is subject to donor-imposed restrictions requiring separate tracking and reporting.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:endowmentCorpusAmount rdf:type rdf:Property ;
    rdfs:label 'Endowment Corpus Amount' ;
    rdfs:comment 'Original principal amount of an endowment fund that must be maintained in perpetuity per donor restrictions.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:establishmentDate rdf:type rdf:Property ;
    rdfs:label 'Establishment Date' ;
    rdfs:comment 'Date when the fund was originally established or created in the financial system.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fundCategory rdf:type rdf:Property ;
    rdfs:label 'Fund Category' ;
    rdfs:comment 'Broad category grouping for the fund used for financial statement presentation and consolidation. [ENUM-REF-CANDIDATE: operating|restricted|endowment|capital|agency|plant|debt_service — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundCode rdf:type rdf:Property ;
    rdfs:label 'Fund Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the fund for identification in financial transactions and reporting. This is the externally-known business identifier used across systems.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundName rdf:type rdf:Property ;
    rdfs:label 'Fund Name' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundStatus rdf:type rdf:Property ;
    rdfs:label 'Fund Status' ;
    rdfs:comment 'Current lifecycle status of the fund indicating whether it is available for transactions and reporting.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundType rdf:type rdf:Property ;
    rdfs:label 'Fund Type' ;
    rdfs:comment 'Classification of the fund based on restriction and purpose. Determines accounting treatment and reporting requirements for not-for-profit healthcare organizations.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentPolicyCode rdf:type rdf:Property ;
    rdfs:label 'Investment Policy Code' ;
    rdfs:comment 'Code referencing the investment policy governing how fund assets may be invested, particularly for endowment and capital funds.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purpose rdf:type rdf:Property ;
    rdfs:label 'Purpose' ;
    rdfs:comment 'Business purpose and intended use of the fund, describing the programs, services, or capital projects it supports.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spendingPolicyRate rdf:type rdf:Property ;
    rdfs:label 'Spending Policy Rate' ;
    rdfs:comment 'Annual percentage rate at which endowment earnings may be spent, as defined by board policy or donor agreement.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialForecastId rdf:type rdf:Property ;
    rdfs:label 'Financial Forecast Id' ;
    rdfs:comment 'Unique identifier for the financial forecast record. Primary key.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialForecast .

ind:parentFinancialForecastId rdf:type rdf:Property ;
    rdfs:label 'Parent Financial Forecast Id' ;
    rdfs:comment 'Identifier of the parent forecast if this forecast is a component of a larger consolidated forecast. Supports hierarchical financial planning structures.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialForecast .

ind:primarySupersededByFinancialForecastId rdf:type rdf:Property ;
    rdfs:label 'Primary Superseded By Financial Forecast Id' ;
    rdfs:comment 'Identifier of the newer forecast that supersedes this one. Null if this is the current active forecast. Supports version history and audit trail.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialForecast .

ind:assumptionsNarrative rdf:type rdf:Property ;
    rdfs:label 'Assumptions Narrative' ;
    rdfs:comment 'Detailed narrative documenting the key assumptions, drivers, and rationale underlying the forecast. Includes market conditions, volume assumptions, rate assumptions, cost inflation factors, strategic initiatives, and risk factors.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselineFlag rdf:type rdf:Property ;
    rdfs:label 'Baseline Flag' ;
    rdfs:comment 'Indicates whether this forecast version is the official baseline plan of record against which actual performance will be measured. True if baseline, False otherwise.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:boardPresentationDate rdf:type rdf:Property ;
    rdfs:label 'Board Presentation Date' ;
    rdfs:comment 'Date on which this forecast was presented to the board of directors or trustees. Null if not presented.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:boardPresentationFlag rdf:type rdf:Property ;
    rdfs:label 'Board Presentation Flag' ;
    rdfs:comment 'Indicates whether this forecast was presented to the board of directors or trustees. True if presented, False otherwise. Used for governance and reporting tracking.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:forecastMethodology rdf:type rdf:Property ;
    rdfs:label 'Forecast Methodology' ;
    rdfs:comment 'The forecasting technique or approach used to develop the projections. Trend analysis extrapolates historical patterns, driver-based links to operational metrics, zero-based builds from scratch, activity-based costs by activity, regression uses statistical models. [ENUM-REF-CANDIDATE: trend_analysis|driver_based|zero_based|activity_based|regression_model|scenario_planning|hybrid — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastName rdf:type rdf:Property ;
    rdfs:label 'Forecast Name' ;
    rdfs:comment 'Descriptive name of the financial forecast, typically indicating the planning cycle or scenario (e.g., FY2024 Q2 Rolling Forecast, Long-Range Strategic Plan 2024-2028).' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastNumber rdf:type rdf:Property ;
    rdfs:label 'Forecast Number' ;
    rdfs:comment 'Business-assigned unique identifier for the forecast, used for external reference and tracking across financial planning cycles.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Period End Date' ;
    rdfs:comment 'The last date of the period covered by this forecast. Defines the end of the planning horizon.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Forecast Period Months' ;
    rdfs:comment 'Number of months covered by the forecast period. Typical values include 12 for annual plans, 18-24 for rolling forecasts, and 36-60 for long-range plans.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:forecastPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Period Start Date' ;
    rdfs:comment 'The first date of the period covered by this forecast. Defines the beginning of the planning horizon.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastStatus rdf:type rdf:Property ;
    rdfs:label 'Forecast Status' ;
    rdfs:comment 'Current lifecycle state of the forecast. Draft indicates work in progress, submitted awaits review, approved is finalized, baseline is the official plan of record, superseded has been replaced by a newer version. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|baseline|superseded|archived — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastType rdf:type rdf:Property ;
    rdfs:label 'Forecast Type' ;
    rdfs:comment 'Classification of the forecast methodology and planning horizon. Rolling forecasts update continuously, annual operating plans cover a single fiscal year, long-range plans span multiple years, and scenario analyses model alternative futures.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastVersion rdf:type rdf:Property ;
    rdfs:label 'Forecast Version' ;
    rdfs:comment 'Version identifier for the forecast, enabling tracking of iterations and revisions (e.g., V1.0, V2.1, Q2 Update). Supports audit trail and version control.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastedCmi rdf:type rdf:Property ;
    rdfs:label 'Forecasted Cmi' ;
    rdfs:comment 'Projected average case mix index for the forecast period, reflecting the expected complexity and resource intensity of patient cases. Used for revenue and cost modeling under DRG-based payment systems.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastedFteCount rdf:type rdf:Property ;
    rdfs:label 'Forecasted Fte Count' ;
    rdfs:comment 'Projected total full-time equivalent staffing levels for the forecast period. Critical for labor cost planning and productivity analysis.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastedPatientVolume rdf:type rdf:Property ;
    rdfs:label 'Forecasted Patient Volume' ;
    rdfs:comment 'Projected total patient encounters or admissions for the forecast period. Key volume driver for revenue and resource planning.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scenarioDescription rdf:type rdf:Property ;
    rdfs:label 'Scenario Description' ;
    rdfs:comment 'Description of the scenario being modeled (e.g., base case, best case, worst case, strategic initiative impact). Used for scenario analysis and sensitivity testing.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalForecastedCapitalExpenditure rdf:type rdf:Property ;
    rdfs:label 'Total Forecasted Capital Expenditure' ;
    rdfs:comment 'Total projected capital spending for the forecast period, including facility construction, equipment purchases, technology investments, and major renovations.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalForecastedExpense rdf:type rdf:Property ;
    rdfs:label 'Total Forecasted Expense' ;
    rdfs:comment 'Total projected operating expenses for the forecast period, including salaries and benefits, supplies, purchased services, depreciation, and other operating costs.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalForecastedNetIncome rdf:type rdf:Property ;
    rdfs:label 'Total Forecasted Net Income' ;
    rdfs:comment 'Projected net income after all revenues, expenses, non-operating items, and taxes. Bottom line of the forecasted income statement.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalForecastedOperatingIncome rdf:type rdf:Property ;
    rdfs:label 'Total Forecasted Operating Income' ;
    rdfs:comment 'Projected operating income (revenue minus expenses) for the forecast period. Key performance metric for financial sustainability and operational efficiency.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalForecastedRevenue rdf:type rdf:Property ;
    rdfs:label 'Total Forecasted Revenue' ;
    rdfs:comment 'Total projected operating revenue for the forecast period, including patient service revenue, capitation revenue, and other operating income. Represents the top line of the forecasted income statement.' ;
    rdfs:domain ind:FinancialForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastLineId rdf:type rdf:Property ;
    rdfs:label 'Forecast Line Id' ;
    rdfs:comment 'Unique identifier for the forecast line item. Primary key for the forecast line entity.' ;
    rdfs:domain ind:ForecastLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorForecastLineId rdf:type rdf:Property ;
    rdfs:label 'Prior Forecast Line Id' ;
    rdfs:comment 'Self-referencing FK on forecast_line (prior_forecast_line_id)' ;
    rdfs:domain ind:ForecastLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ForecastLine .

ind:currentBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Current Budget Amount' ;
    rdfs:comment 'The approved budget amount for the same GL account, cost center, and fiscal period. Enables forecast-to-budget variance analysis.' ;
    rdfs:domain ind:ForecastLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastCategory rdf:type rdf:Property ;
    rdfs:label 'Forecast Category' ;
    rdfs:comment 'High-level classification of the forecast line into major financial statement categories: revenue, salary expense, non-salary expense, capital expenditure, or other.' ;
    rdfs:domain ind:ForecastLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastConfidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Forecast Confidence Level' ;
    rdfs:comment 'Qualitative assessment of the reliability and certainty of this forecast line (high, medium, low). Reflects data quality, volatility, and external risk factors.' ;
    rdfs:domain ind:ForecastLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastScenario rdf:type rdf:Property ;
    rdfs:label 'Forecast Scenario' ;
    rdfs:comment 'Scenario or case identifier for this forecast line (e.g., base case, best case, worst case, strategic initiative). Supports scenario planning and sensitivity analysis.' ;
    rdfs:domain ind:ForecastLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastedAmount rdf:type rdf:Property ;
    rdfs:label 'Forecasted Amount' ;
    rdfs:comment 'The projected financial amount for this GL account, cost center, and fiscal period combination. Represents the best estimate of future financial performance.' ;
    rdfs:domain ind:ForecastLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorYearActualAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Year Actual Amount' ;
    rdfs:comment 'The actual financial result for the same GL account, cost center, and fiscal period in the prior year. Provides historical baseline for variance analysis.' ;
    rdfs:domain ind:ForecastLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceToBudget rdf:type rdf:Property ;
    rdfs:label 'Variance To Budget' ;
    rdfs:comment 'Calculated variance between the forecasted amount and the current budget amount (forecast minus budget). Highlights deviations from the approved financial plan.' ;
    rdfs:domain ind:ForecastLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceToPriorYear rdf:type rdf:Property ;
    rdfs:label 'Variance To Prior Year' ;
    rdfs:comment 'Calculated variance between the forecasted amount and the prior year actual amount (forecast minus prior year). Measures year-over-year growth or decline.' ;
    rdfs:domain ind:ForecastLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volumeDriverAssumption rdf:type rdf:Property ;
    rdfs:label 'Volume Driver Assumption' ;
    rdfs:comment 'Description of the key volume or activity driver underlying this forecast (e.g., patient days, surgical cases, outpatient visits, Full-Time Equivalents). Provides transparency into forecast methodology.' ;
    rdfs:domain ind:ForecastLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volumeQuantity rdf:type rdf:Property ;
    rdfs:label 'Volume Quantity' ;
    rdfs:comment 'Numeric quantity of the volume driver assumed in this forecast line. Enables calculation of per-unit rates and variance analysis.' ;
    rdfs:domain ind:ForecastLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoicePaymentApplicationId rdf:type rdf:Property ;
    rdfs:label 'Invoice Payment Application Id' ;
    rdfs:comment 'Unique identifier for this payment application record. Primary key.' ;
    rdfs:domain ind:InvoicePaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amountApplied rdf:type rdf:Property ;
    rdfs:label 'Amount Applied' ;
    rdfs:comment 'The monetary amount of this payment that was applied to settle this specific invoice. For partial payments, this will be less than the total payment amount. For split payments across multiple invoices, the sum of amount_applied across all applications equals the total payment amount.' ;
    rdfs:domain ind:InvoicePaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amountPaid rdf:type rdf:Property ;
    rdfs:label 'Amount Paid' ;
    rdfs:comment 'The total amount that has been paid against this invoice to date. May be less than total_amount for partial payments. [Moved from ap_invoice: This attribute represents the total amount paid against an invoice, which is actually the SUM of amount_applied across all payment applications for this invoice. It is a derived/calculated value that belongs in the association layer, not as a standalone attribute on the invoice.]' ;
    rdfs:domain ind:InvoicePaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amountRemaining rdf:type rdf:Property ;
    rdfs:label 'Amount Remaining' ;
    rdfs:comment 'The outstanding balance remaining to be paid on this invoice, calculated as total_amount - amount_paid. [Moved from ap_invoice: This attribute represents the outstanding balance on an invoice, which is calculated as total_amount minus the sum of amount_applied from all payment applications. It is a derived value that should be calculated from the association data, not stored redundantly on the invoice.]' ;
    rdfs:domain ind:InvoicePaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicationDate rdf:type rdf:Property ;
    rdfs:label 'Application Date' ;
    rdfs:comment 'The date on which this payment was applied to this invoice in the accounts payable system. This is the business event date for the payment allocation and may differ from the payment_date if payments are applied retroactively or in batch processes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationSequence rdf:type rdf:Property ;
    rdfs:label 'Application Sequence' ;
    rdfs:comment 'The sequence number of this application when a single payment is applied to multiple invoices. Used to track the order in which payment funds were allocated across invoices, which is important for cash application rules and aging calculations.' ;
    rdfs:domain ind:InvoicePaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicationStatus rdf:type rdf:Property ;
    rdfs:label 'Application Status' ;
    rdfs:comment 'The current status of this payment application. Values: applied (payment successfully applied to invoice), reversed (application was reversed due to payment void or correction), pending (application awaiting approval or clearing), cleared (application confirmed and reconciled).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountTaken rdf:type rdf:Property ;
    rdfs:label 'Discount Taken' ;
    rdfs:comment 'The early payment discount amount taken on this specific invoice as part of this payment application. If a payment covers multiple invoices, each invoice may have a different discount amount based on its payment terms and timing.' ;
    rdfs:domain ind:InvoicePaymentApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundAllocationId rdf:type rdf:Property ;
    rdfs:label 'Fund Allocation Id' ;
    rdfs:comment 'Unique surrogate identifier for the fund allocation record. Primary key for the association.' ;
    rdfs:domain ind:FundAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationAmount rdf:type rdf:Property ;
    rdfs:label 'Allocation Amount' ;
    rdfs:comment 'Fixed dollar amount allocated to this organizational provider from the fund, if allocation is amount-based rather than percentage-based. Mutually exclusive with allocation_percentage in business logic.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationPurpose rdf:type rdf:Property ;
    rdfs:label 'Allocation Purpose' ;
    rdfs:comment 'Specific purpose or program for which this fund is allocated to the organizational provider. May be more granular than the fund-level purpose, capturing provider-specific use cases (e.g., Cardiology equipment upgrade within a broader capital fund).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundAllocationStatus rdf:type rdf:Property ;
    rdfs:label 'Fund Allocation Status' ;
    rdfs:comment 'Current lifecycle status of the fund allocation. Drives whether transactions can be posted against this allocation.' ;
    rdfs:domain ind:FundAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Restriction Compliance Status' ;
    rdfs:comment 'Current compliance status of this allocation with respect to donor restrictions, grant stipulations, or regulatory requirements. Drives audit flags and reporting requirements.' ;
    rdfs:domain ind:FundAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Payment Employee Id' ;
    rdfs:comment 'Reference to the user who created this payment batch record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryOriginalPaymentBatchId rdf:type rdf:Property ;
    rdfs:label 'Primary Original Payment Batch Id' ;
    rdfs:comment 'Reference to the original payment batch that this batch is reversing or correcting, if applicable.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentBatch .

ind:primaryPaymentFinancialEntityId rdf:type rdf:Property ;
    rdfs:label 'Primary Payment Financial Entity Id' ;
    rdfs:comment 'Reference to the organization making the payments in this batch, such as an insurance company or employer.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialEntity .

ind:actualProcessingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Processing Timestamp' ;
    rdfs:comment 'The precise date and time when the payment batch processing was completed.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:batchDate rdf:type rdf:Property ;
    rdfs:label 'Batch Date' ;
    rdfs:comment 'The business date on which the payment batch was created or scheduled for processing.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:batchNumber rdf:type rdf:Property ;
    rdfs:label 'Batch Number' ;
    rdfs:comment 'Externally-known unique business identifier for the payment batch, used for tracking and reconciliation across systems.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:batchType rdf:type rdf:Property ;
    rdfs:label 'Batch Type' ;
    rdfs:comment 'Classification of the payment batch by its purpose and source. Determines processing rules and reconciliation requirements.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electronicFundsTransferTraceNumber rdf:type rdf:Property ;
    rdfs:label 'Electronic Funds Transfer Trace Number' ;
    rdfs:comment 'The trace number assigned by the Automated Clearing House (ACH) network for tracking electronic fund transfers.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalBatchReference rdf:type rdf:Property ;
    rdfs:label 'External Batch Reference' ;
    rdfs:comment 'External reference number or identifier provided by the payer or payment processor for cross-system reconciliation.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failedPaymentCount rdf:type rdf:Property ;
    rdfs:label 'Failed Payment Count' ;
    rdfs:comment 'The number of payment transactions that failed processing within this batch.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:generalLedgerAccountCode rdf:type rdf:Property ;
    rdfs:label 'General Ledger Account Code' ;
    rdfs:comment 'The general ledger account code to which this payment batch is posted for financial reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isReversal rdf:type rdf:Property ;
    rdfs:label 'Is Reversal' ;
    rdfs:comment 'Indicates whether this payment batch represents a reversal or correction of a previously processed batch.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lockboxNumber rdf:type rdf:Property ;
    rdfs:label 'Lockbox Number' ;
    rdfs:comment 'The lockbox identifier used for processing mailed payments, typically assigned by the bank providing lockbox services.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netBatchAmount rdf:type rdf:Property ;
    rdfs:label 'Net Batch Amount' ;
    rdfs:comment 'The final net monetary value of the payment batch after all adjustments have been applied.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentBatchStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Batch Status' ;
    rdfs:comment 'Current lifecycle status of the payment batch in the processing workflow.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentChannel rdf:type rdf:Property ;
    rdfs:label 'Payment Channel' ;
    rdfs:comment 'The interface or channel through which the payment batch was initiated or received.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingNotes rdf:type rdf:Property ;
    rdfs:label 'Processing Notes' ;
    rdfs:comment 'Free-text notes documenting special instructions, issues, or observations related to the processing of this payment batch.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceAdviceNumber rdf:type rdf:Property ;
    rdfs:label 'Remittance Advice Number' ;
    rdfs:comment 'The unique identifier for the remittance advice document associated with this payment batch, used for payment application.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledProcessingDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Processing Date' ;
    rdfs:comment 'The target date when the payment batch is scheduled to be processed and funds transferred.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:successfulPaymentCount rdf:type rdf:Property ;
    rdfs:label 'Successful Payment Count' ;
    rdfs:comment 'The number of payment transactions that were successfully processed within this batch.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalBatchAmount rdf:type rdf:Property ;
    rdfs:label 'Total Batch Amount' ;
    rdfs:comment 'The total monetary value of all payments included in this batch before any adjustments.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPaymentCount rdf:type rdf:Property ;
    rdfs:label 'Total Payment Count' ;
    rdfs:comment 'The total number of individual payment transactions included in this batch.' ;
    rdfs:domain ind:PaymentBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryOriginalTransactionBatchId rdf:type rdf:Property ;
    rdfs:label 'Primary Original Transaction Batch Id' ;
    rdfs:comment 'Reference to the original batch if this batch is a reversal or correction of another batch.' ;
    rdfs:domain ind:TransactionBatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransactionBatch .

ind:reversedTransactionBatchId rdf:type rdf:Property ;
    rdfs:label 'Reversed Transaction Batch Id' ;
    rdfs:comment 'Self-referencing FK on transaction_batch (reversed_transaction_batch_id)' ;
    rdfs:domain ind:TransactionBatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransactionBatch .

ind:transactionEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Transaction Employee Id' ;
    rdfs:comment 'Reference to the user who approved this transaction batch for posting.' ;
    rdfs:domain ind:TransactionBatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:batchDescription rdf:type rdf:Property ;
    rdfs:label 'Batch Description' ;
    rdfs:comment 'Cleaned boilerplate phrase from finance.transaction_batch.batch_description' ;
    rdfs:domain ind:TransactionBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:batchStatus rdf:type rdf:Property ;
    rdfs:label 'Batch Status' ;
    rdfs:comment 'Current lifecycle status of the transaction batch in the approval and posting workflow.' ;
    rdfs:domain ind:TransactionBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlTotal rdf:type rdf:Property ;
    rdfs:label 'Control Total' ;
    rdfs:comment 'Expected control total for validation purposes, used to verify batch integrity before posting.' ;
    rdfs:domain ind:TransactionBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'External Reference Number' ;
    rdfs:comment 'External reference identifier from source systems or third-party systems for cross-system reconciliation.' ;
    rdfs:domain ind:TransactionBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAutoGenerated rdf:type rdf:Property ;
    rdfs:label 'Is Auto Generated' ;
    rdfs:comment 'Indicates whether the batch was automatically generated by a system process (true) or manually created by a user (false).' ;
    rdfs:domain ind:TransactionBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isBalanced rdf:type rdf:Property ;
    rdfs:label 'Is Balanced' ;
    rdfs:comment 'Indicates whether the batch debits and credits are in balance (true) or out of balance (false).' ;
    rdfs:domain ind:TransactionBatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRecurring rdf:type rdf:Property ;
    rdfs:label 'Is Recurring' ;
    rdfs:comment 'Indicates whether this batch is part of a recurring batch series (true) or a one-time batch (false).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netAmount rdf:type rdf:Property ;
    rdfs:label 'Net Amount' ;
    rdfs:comment 'The net amount of the batch (total debits minus total credits), should be zero for balanced batches.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reversedAllocationRunId rdf:type rdf:Property ;
    rdfs:label 'Reversed Allocation Run Id' ;
    rdfs:comment 'Reference to the original allocation run that this run is reversing, if applicable.' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AllocationRun .

ind:actualEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual End Timestamp' ;
    rdfs:comment 'Actual date and time when the allocation run execution completed or terminated.' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Start Timestamp' ;
    rdfs:comment 'Actual date and time when the allocation run execution commenced, representing the principal business event timestamp for this transaction.' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:allocationPercentageTotal rdf:type rdf:Property ;
    rdfs:label 'Allocation Percentage Total' ;
    rdfs:comment 'Sum of all allocation percentages applied across target cost centers, should equal 100.00 for validation purposes.' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:errorCount rdf:type rdf:Property ;
    rdfs:label 'Error Count' ;
    rdfs:comment 'Number of errors encountered during the allocation run execution.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:executionDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Execution Duration Seconds' ;
    rdfs:comment 'Total elapsed time in seconds for the allocation run execution, used for performance monitoring and optimization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glBatchNumber rdf:type rdf:Property ;
    rdfs:label 'Gl Batch Number' ;
    rdfs:comment 'General ledger batch identifier associated with the journal entries created from this allocation run.' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glPostingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Gl Posting Timestamp' ;
    rdfs:comment 'Date and time when the allocation run results were posted to the general ledger system.' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:postedToGlFlag rdf:type rdf:Property ;
    rdfs:label 'Posted To Gl Flag' ;
    rdfs:comment 'Indicator whether the allocation results have been posted to the general ledger.' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordsProcessedCount rdf:type rdf:Property ;
    rdfs:label 'Records Processed Count' ;
    rdfs:comment 'Total number of allocation detail records or transactions processed in this run.' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Flag' ;
    rdfs:comment 'Indicator whether this allocation run is used for regulatory cost reporting purposes (e.g., Medicare Cost Report).' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:runName rdf:type rdf:Property ;
    rdfs:label 'Run Name' ;
    rdfs:comment 'Descriptive name assigned to the allocation run for identification and reporting purposes, often includes period and allocation type context.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runNumber rdf:type rdf:Property ;
    rdfs:label 'Run Number' ;
    rdfs:comment 'Business-facing unique identifier for the allocation run, typically formatted with prefix and sequence number for external reference and audit trails.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runStatus rdf:type rdf:Property ;
    rdfs:label 'Run Status' ;
    rdfs:comment 'Current lifecycle status of the allocation run indicating its stage in the execution and approval workflow.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runType rdf:type rdf:Property ;
    rdfs:label 'Run Type' ;
    rdfs:comment 'Classification of the allocation run indicating its purpose and finality within the financial close process.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Timestamp' ;
    rdfs:comment 'Planned date and time when the allocation run was scheduled to begin execution.' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:simulationFlag rdf:type rdf:Property ;
    rdfs:label 'Simulation Flag' ;
    rdfs:comment 'Indicator whether this allocation run is a simulation or what-if scenario rather than an actual financial posting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetCostCentersCount rdf:type rdf:Property ;
    rdfs:label 'Target Cost Centers Count' ;
    rdfs:comment 'Number of distinct cost centers that received allocated costs in this run.' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalAmountAllocated rdf:type rdf:Property ;
    rdfs:label 'Total Amount Allocated' ;
    rdfs:comment 'Total monetary value of costs allocated across all target cost centers in this run, representing the gross base amount for this allocation transaction.' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:warningCount rdf:type rdf:Property ;
    rdfs:label 'Warning Count' ;
    rdfs:comment 'Number of warnings generated during the allocation run execution.' ;
    rdfs:domain ind:AllocationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depreciationEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Depreciation Employee Id' ;
    rdfs:comment 'Reference to the user who approved the depreciation run for posting to the general ledger.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:financeAssetBookId rdf:type rdf:Property ;
    rdfs:label 'Finance Asset Book Id' ;
    rdfs:comment 'Reference to the asset book (corporate, tax, IFRS, etc.) for which this depreciation run is executed.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceAssetBook .

ind:reversedDepreciationRunId rdf:type rdf:Property ;
    rdfs:label 'Reversed Depreciation Run Id' ;
    rdfs:comment 'Reference to the original depreciation run that this run reverses, if applicable.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DepreciationRun .

ind:assetCount rdf:type rdf:Property ;
    rdfs:label 'Asset Count' ;
    rdfs:comment 'The total number of assets included in this depreciation run.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoPostFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Post Flag' ;
    rdfs:comment 'Indicates whether the depreciation entries from this run are automatically posted to the general ledger upon completion.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:calculationMethod rdf:type rdf:Property ;
    rdfs:label 'Calculation Method' ;
    rdfs:comment 'The accounting method used to calculate depreciation in this run, such as straight-line, declining balance, or units of production.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failedAssetCount rdf:type rdf:Property ;
    rdfs:label 'Failed Asset Count' ;
    rdfs:comment 'The number of assets that failed processing during this depreciation run.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:journalBatchReference rdf:type rdf:Property ;
    rdfs:label 'Journal Batch Reference' ;
    rdfs:comment 'Reference to the journal batch containing the depreciation entries generated by this run.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:processedAssetCount rdf:type rdf:Property ;
    rdfs:label 'Processed Asset Count' ;
    rdfs:comment 'The number of assets successfully processed in this depreciation run.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:runDate rdf:type rdf:Property ;
    rdfs:label 'Run Date' ;
    rdfs:comment 'The business date on which the depreciation run was executed or scheduled to execute.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:runDescription rdf:type rdf:Property ;
    rdfs:label 'Run Description' ;
    rdfs:comment 'Free-text description providing additional context or notes about the purpose and scope of this depreciation run.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalDepreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Total Depreciation Amount' ;
    rdfs:comment 'The total depreciation expense calculated across all assets in this run.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mergedDonorId rdf:type rdf:Property ;
    rdfs:label 'Merged Donor Id' ;
    rdfs:comment 'Self-referencing FK on donor (merged_donor_id)' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Donor .

ind:acknowledgmentPreference rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Preference' ;
    rdfs:comment 'Donors preference for public recognition of their contributions in donor lists, annual reports, and naming opportunities.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affinityScore rdf:type rdf:Property ;
    rdfs:label 'Affinity Score' ;
    rdfs:comment 'Quantitative score representing the donors affinity and connection to the healthcare organization based on engagement history, volunteer activity, and relationship depth.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:boardMemberFlag rdf:type rdf:Property ;
    rdfs:label 'Board Member Flag' ;
    rdfs:comment 'Boolean indicator of whether the donor currently serves or has served on the healthcare organizations board of directors or advisory board.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:donorName rdf:type rdf:Property ;
    rdfs:label 'Donor Name' ;
    rdfs:comment 'Remove redundant product-name prefixes from non-PK attributes in finance.donor.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:donorSource rdf:type rdf:Property ;
    rdfs:label 'Donor Source' ;
    rdfs:comment 'Original source or channel through which the donor was acquired or first engaged with the healthcare organizations fundraising programs.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:donorStatus rdf:type rdf:Property ;
    rdfs:label 'Donor Status' ;
    rdfs:comment 'Current lifecycle status of the donor relationship indicating whether the donor is actively contributing, inactive, temporarily suspended, deceased, or merged with another donor record.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:donorType rdf:type rdf:Property ;
    rdfs:label 'Donor Type' ;
    rdfs:comment 'Classification of the donor entity type indicating whether the donor is an individual person, corporate entity, charitable foundation, government agency, or anonymous contributor.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerName rdf:type rdf:Property ;
    rdfs:label 'Employer Name' ;
    rdfs:comment 'Name of the donors employer organization, relevant for corporate matching gift programs and workplace giving campaigns.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstGiftDate rdf:type rdf:Property ;
    rdfs:label 'First Gift Date' ;
    rdfs:comment 'Date when the donor made their first recorded contribution to the healthcare organization.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastGiftDate rdf:type rdf:Property ;
    rdfs:label 'Last Gift Date' ;
    rdfs:comment 'Date of the most recent contribution received from the donor.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lifetimeGivingAmount rdf:type rdf:Property ;
    rdfs:label 'Lifetime Giving Amount' ;
    rdfs:comment 'Total cumulative amount of all contributions made by the donor since the inception of the donor relationship, expressed in the organizations functional currency.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchingGiftEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Matching Gift Eligible Flag' ;
    rdfs:comment 'Boolean indicator of whether the donor is eligible for corporate matching gift programs through their employer.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memorialHonoreeName rdf:type rdf:Property ;
    rdfs:label 'Memorial Honoree Name' ;
    rdfs:comment 'Name of the individual being honored or memorialized through the donors contributions, if applicable.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientFlag rdf:type rdf:Property ;
    rdfs:label 'Patient Flag' ;
    rdfs:comment 'Boolean indicator of whether the donor is or has been a patient of the healthcare organization, relevant for grateful patient programs.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plannedGivingFlag rdf:type rdf:Property ;
    rdfs:label 'Planned Giving Flag' ;
    rdfs:comment 'Boolean indicator of whether the donor has established a planned gift commitment such as a bequest, charitable trust, or life insurance designation.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferredCommunicationMethod rdf:type rdf:Property ;
    rdfs:label 'Preferred Communication Method' ;
    rdfs:comment 'Donors preferred method of communication for stewardship, solicitation, and acknowledgment correspondence.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segment rdf:type rdf:Property ;
    rdfs:label 'Segment' ;
    rdfs:comment 'Fundraising segment classification of the donor based on giving capacity and engagement level for targeted stewardship and solicitation strategies.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:solicitationOptOutFlag rdf:type rdf:Property ;
    rdfs:label 'Solicitation Opt Out Flag' ;
    rdfs:comment 'Boolean indicator of whether the donor has requested to opt out of future fundraising solicitations and appeals.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxIdNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Id Number' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volunteerFlag rdf:type rdf:Property ;
    rdfs:label 'Volunteer Flag' ;
    rdfs:comment 'Boolean indicator of whether the donor actively volunteers or has volunteered for the healthcare organization.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wealthCapacityRating rdf:type rdf:Property ;
    rdfs:label 'Wealth Capacity Rating' ;
    rdfs:comment 'Estimated wealth capacity rating or score for the donor based on wealth screening and prospect research, used for major gift identification and cultivation strategies.' ;
    rdfs:domain ind:Donor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentAgreementIntercompanyAgreementId rdf:type rdf:Property ;
    rdfs:label 'Parent Agreement Intercompany Agreement Id' ;
    rdfs:comment 'Identifier of the parent or master agreement if this is a subsidiary or amendment agreement. Nullable for standalone agreements.' ;
    rdfs:domain ind:IntercompanyAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IntercompanyAgreement .

ind:primarySupersededIntercompanyAgreementId rdf:type rdf:Property ;
    rdfs:label 'Primary Superseded Intercompany Agreement Id' ;
    rdfs:comment 'Self-referencing FK on intercompany_agreement (superseded_intercompany_agreement_id)' ;
    rdfs:domain ind:IntercompanyAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IntercompanyAgreement .

ind:agreementName rdf:type rdf:Property ;
    rdfs:label 'Agreement Name' ;
    rdfs:comment 'Human-readable name or title of the intercompany agreement describing its purpose or scope.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementType rdf:type rdf:Property ;
    rdfs:label 'Agreement Type' ;
    rdfs:comment 'Classification of the intercompany agreement based on its business purpose (e.g., service agreement, cost allocation, revenue sharing, transfer pricing, licensing, or intercompany loan).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualContractValue rdf:type rdf:Property ;
    rdfs:label 'Annual Contract Value' ;
    rdfs:comment 'Total estimated or committed annual value of the intercompany agreement in the specified currency.' ;
    rdfs:domain ind:IntercompanyAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Required Flag' ;
    rdfs:comment 'Indicates whether this agreement requires periodic audit review for compliance or financial accuracy.' ;
    rdfs:domain ind:IntercompanyAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costAllocationBasis rdf:type rdf:Property ;
    rdfs:label 'Cost Allocation Basis' ;
    rdfs:comment 'Description of the basis or formula used for allocating costs between entities (e.g., headcount, revenue, square footage, usage metrics).' ;
    rdfs:domain ind:IntercompanyAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeResolutionMethod rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Method' ;
    rdfs:comment 'Method specified in the agreement for resolving disputes between the provider and receiver entities.' ;
    rdfs:domain ind:IntercompanyAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentReferenceUrl rdf:type rdf:Property ;
    rdfs:label 'Document Reference Url' ;
    rdfs:comment 'URL or file path to the signed agreement document or contract repository location.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityServiceDescription rdf:type rdf:Property ;
    rdfs:label 'Facility Service Description' ;
    rdfs:comment 'Detailed description of the services, goods, or resources covered by this intercompany agreement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingLawJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Governing Law Jurisdiction' ;
    rdfs:comment 'Legal jurisdiction whose laws govern the interpretation and enforcement of this intercompany agreement.' ;
    rdfs:domain ind:IntercompanyAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intercompanyAgreementStatus rdf:type rdf:Property ;
    rdfs:label 'Intercompany Agreement Status' ;
    rdfs:comment 'Current lifecycle status of the intercompany agreement indicating its operational state.' ;
    rdfs:domain ind:IntercompanyAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricingMethod rdf:type rdf:Property ;
    rdfs:label 'Pricing Method' ;
    rdfs:comment 'Method used to determine pricing for services or goods exchanged under this intercompany agreement.' ;
    rdfs:domain ind:IntercompanyAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Flag' ;
    rdfs:comment 'Indicates whether the agreement is eligible for automatic renewal upon expiration.' ;
    rdfs:domain ind:IntercompanyAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxJurisdictionCode rdf:type rdf:Property ;
    rdfs:label 'Tax Jurisdiction Code' ;
    rdfs:comment 'Code representing the primary tax jurisdiction governing this intercompany agreement.' ;
    rdfs:domain ind:IntercompanyAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationClause rdf:type rdf:Property ;
    rdfs:label 'Termination Clause' ;
    rdfs:comment 'Summary of the conditions and procedures under which the agreement may be terminated by either party.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferPricingCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Transfer Pricing Compliant Flag' ;
    rdfs:comment 'Indicates whether the agreement has been reviewed and approved as compliant with transfer pricing regulations.' ;
    rdfs:domain ind:IntercompanyAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurringEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Recurring Employee Id' ;
    rdfs:comment 'Reference to the employee who owns and is accountable for this recurring schedule.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supersededRecurringScheduleId rdf:type rdf:Property ;
    rdfs:label 'Superseded Recurring Schedule Id' ;
    rdfs:comment 'Self-referencing FK on recurring_schedule (superseded_recurring_schedule_id)' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecurringSchedule .

ind:adjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Adjustment Factor' ;
    rdfs:comment 'A multiplier applied to the scheduled amount for adjustments such as inflation, escalation, or volume changes. Default is 1.0 (no adjustment).' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approverRoleCode rdf:type rdf:Property ;
    rdfs:label 'Approver Role Code' ;
    rdfs:comment 'Reference to the role or user group responsible for approving activities generated by this schedule. Null if approval is not required.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoGenerateFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Generate Flag' ;
    rdfs:comment 'Indicates whether scheduled activities are automatically generated by the system (true) or require manual creation (false).' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dayOfMonth rdf:type rdf:Property ;
    rdfs:label 'Day Of Month' ;
    rdfs:comment 'For monthly or less frequent schedules, the specific day of the month when the activity occurs (1-31). Null if not applicable.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dayOfWeek rdf:type rdf:Property ;
    rdfs:label 'Day Of Week' ;
    rdfs:comment 'For weekly or biweekly schedules, the specific day of the week when the activity occurs. Null if not applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastGeneratedDate rdf:type rdf:Property ;
    rdfs:label 'Last Generated Date' ;
    rdfs:comment 'The date when the most recent scheduled activity was generated from this recurring schedule. Null if no activities have been generated yet.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maxOccurrences rdf:type rdf:Property ;
    rdfs:label 'Max Occurrences' ;
    rdfs:comment 'The maximum number of times this schedule should generate activities before automatically completing. Null indicates unlimited occurrences.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:monthOfQuarter rdf:type rdf:Property ;
    rdfs:label 'Month Of Quarter' ;
    rdfs:comment 'For quarterly schedules, the specific month within the quarter when the activity occurs (1-3). Null if not applicable.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nextScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Date' ;
    rdfs:comment 'The date when the next scheduled activity is due to be generated from this recurring schedule.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:occurrenceCount rdf:type rdf:Property ;
    rdfs:label 'Occurrence Count' ;
    rdfs:comment 'The total number of times activities have been generated from this recurring schedule since its inception.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prorationRule rdf:type rdf:Property ;
    rdfs:label 'Proration Rule' ;
    rdfs:comment 'The rule used to prorate amounts for partial periods (none, daily proration, monthly proration, actual days, or business days only).' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quarterOfYear rdf:type rdf:Property ;
    rdfs:label 'Quarter Of Year' ;
    rdfs:comment 'For annual schedules, the specific quarter of the year when the activity occurs (1-4). Null if not applicable.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recurringScheduleDescription rdf:type rdf:Property ;
    rdfs:label 'Recurring Schedule Description' ;
    rdfs:comment 'Detailed textual description of the recurring schedule, including its purpose, scope, and any special instructions or business rules.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurringScheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Recurring Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the recurring schedule indicating whether it is in draft, actively generating activities, temporarily suspended, completed, or cancelled.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleAmount rdf:type rdf:Property ;
    rdfs:label 'Schedule Amount' ;
    rdfs:comment 'The standard monetary amount associated with each recurrence of this schedule. Used for budgeting, allocation, or accrual purposes.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleCategory rdf:type rdf:Property ;
    rdfs:label 'Schedule Category' ;
    rdfs:comment 'High-level categorization of the schedule based on the nature of financial activities it governs.' ;
    rdfs:domain ind:RecurringSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleCode rdf:type rdf:Property ;
    rdfs:label 'Schedule Code' ;
    rdfs:comment 'Business identifier code for the recurring schedule, used for external reference and reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financeFinancialEntityId rdf:type rdf:Property ;
    rdfs:label 'Finance Financial Entity Id' ;
    rdfs:comment 'FK to finance.financial_entity.financial_entity_id' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialEntity .

ind:financeFiscalPeriodId rdf:type rdf:Property ;
    rdfs:label 'Finance Fiscal Period Id' ;
    rdfs:comment 'FK to finance.fiscal_period.fiscal_period_id' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FiscalPeriod .

ind:parentAssetBookFinanceAssetBookId rdf:type rdf:Property ;
    rdfs:label 'Parent Asset Book Finance Asset Book Id' ;
    rdfs:comment 'Self-referencing FK on asset_book (parent_asset_book_id)' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceAssetBook .

ind:parentBookAssetBookFinanceAssetBookId rdf:type rdf:Property ;
    rdfs:label 'Parent Book Asset Book Finance Asset Book Id' ;
    rdfs:comment 'Reference to a parent asset book if this book is a subsidiary or specialized book derived from a master book. Null for top-level books.' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceAssetBook .

ind:quaternaryFinanceResponsibleBigintSurrogateKeyForCleanKeying rdf:type rdf:Property ;
    rdfs:label 'Quaternary Finance Responsible Bigint Surrogate Key For Clean Keying' ;
    rdfs:comment 'Rename generic employee_id FK to role-specific column' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accountingStandard rdf:type rdf:Property ;
    rdfs:label 'Accounting Standard' ;
    rdfs:comment 'The accounting standard or framework governing depreciation and valuation rules for assets in this book.' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowManualDepreciation rdf:type rdf:Property ;
    rdfs:label 'Allow Manual Depreciation' ;
    rdfs:comment 'Indicates whether manual depreciation adjustments are permitted for assets in this book, or if all depreciation must be system-calculated.' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalRequired rdf:type rdf:Property ;
    rdfs:label 'Approval Required' ;
    rdfs:comment 'Indicates whether asset assignments or depreciation changes in this book require managerial or financial approval before posting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assetBookDescription rdf:type rdf:Property ;
    rdfs:label 'Asset Book Description' ;
    rdfs:comment 'Detailed description of the asset book purpose, scope, and any special accounting rules or business context.' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetBookStatus rdf:type rdf:Property ;
    rdfs:label 'Asset Book Status' ;
    rdfs:comment 'Current operational status of the asset book indicating whether it is actively used for asset tracking and depreciation calculations.' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrailEnabled rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Enabled' ;
    rdfs:comment 'Indicates whether detailed audit logging is enabled for all transactions and changes affecting assets in this book.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bookCode rdf:type rdf:Property ;
    rdfs:label 'Book Code' ;
    rdfs:comment 'Unique alphanumeric code identifying the asset book for external reference and reporting purposes.' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bookName rdf:type rdf:Property ;
    rdfs:label 'Book Name' ;
    rdfs:comment 'Full descriptive name of the asset book used for identification and reporting.' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bookType rdf:type rdf:Property ;
    rdfs:label 'Book Type' ;
    rdfs:comment 'Classification of the asset book based on its accounting purpose and regulatory framework.' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consolidationRequired rdf:type rdf:Property ;
    rdfs:label 'Consolidation Required' ;
    rdfs:comment 'Indicates whether asset values and depreciation from this book must be included in consolidated financial reporting.' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prorateDepreciation rdf:type rdf:Property ;
    rdfs:label 'Prorate Depreciation' ;
    rdfs:comment 'Indicates whether depreciation is prorated based on the asset acquisition date within the fiscal period.' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Regulatory Jurisdiction' ;
    rdfs:comment 'The geographic or regulatory jurisdiction governing the accounting rules for this asset book (e.g., federal, state, international).' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageValueRequired rdf:type rdf:Property ;
    rdfs:label 'Salvage Value Required' ;
    rdfs:comment 'Indicates whether assets assigned to this book must have a salvage value specified for depreciation calculations.' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Tax Reporting Required' ;
    rdfs:comment 'Indicates whether assets in this book are subject to tax reporting requirements and must be included in tax filings.' ;
    rdfs:domain ind:FinanceAssetBook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentPayerId rdf:type rdf:Property ;
    rdfs:label 'Parent Payer Id' ;
    rdfs:comment 'Self-referencing FK on payer (parent_payer_id)' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:primarySuccessorPayerId rdf:type rdf:Property ;
    rdfs:label 'Primary Successor Payer Id' ;
    rdfs:comment 'Reference to the payer record that replaces this payer in the event of merger, acquisition, or consolidation. Used to redirect claims and maintain continuity. Null if no successor exists.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:acceptsAssignment rdf:type rdf:Property ;
    rdfs:label 'Accepts Assignment' ;
    rdfs:comment 'Indicates whether the payer accepts assignment of benefits, meaning the payer pays the provider directly rather than reimbursing the patient. True for most contracted payers; false for some out-of-network or self-pay arrangements.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimAppealLimitDays rdf:type rdf:Property ;
    rdfs:label 'Claim Appeal Limit Days' ;
    rdfs:comment 'Number of days from claim denial date within which appeals must be submitted to this payer. Common values are 30, 60, 90, 180 days. Null if payer does not specify appeal deadlines.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimScrubbingVendor rdf:type rdf:Property ;
    rdfs:label 'Claim Scrubbing Vendor' ;
    rdfs:comment 'Name of the third-party claim scrubbing or editing vendor used to validate claims before submission to this payer. Null if no scrubbing vendor is used or if internal scrubbing is performed.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsInquiryPhone rdf:type rdf:Property ;
    rdfs:label 'Claims Inquiry Phone' ;
    rdfs:comment 'Dedicated phone number for claim status inquiries and claim-related questions. May differ from general customer service phone.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsSubmissionEndpoint rdf:type rdf:Property ;
    rdfs:label 'Claims Submission Endpoint' ;
    rdfs:comment 'URL, EDI address, or mailing address for submitting claims to this payer. Format varies by submission method.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearinghouseCode rdf:type rdf:Property ;
    rdfs:label 'Clearinghouse Code' ;
    rdfs:comment 'Identifier for the clearinghouse or intermediary used to submit claims to this payer. Null if claims are submitted directly to the payer.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinationOfBenefitsRequired rdf:type rdf:Property ;
    rdfs:label 'Coordination Of Benefits Required' ;
    rdfs:comment 'Indicates whether this payer requires coordination of benefits information when the patient has multiple insurance coverages. True if COB is required; false if payer does not coordinate benefits or is always primary.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ediPayerCode rdf:type rdf:Property ;
    rdfs:label 'Edi Payer Code' ;
    rdfs:comment 'Payer identifier used in EDI transactions, typically the ISA06 qualifier value in X12 837 claim submissions and 835 remittance advice. May differ from NPI or external payer ID.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electronicFundsTransferFlag rdf:type rdf:Property ;
    rdfs:label 'Electronic Funds Transfer Flag' ;
    rdfs:comment 'Indicates whether payments from this payer are received via electronic funds transfer (EFT) directly to the organizations bank account. True if EFT is enabled; false if payments are received by check or other method.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eligibilityVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verification Method' ;
    rdfs:comment 'Primary method for verifying patient eligibility and benefits with this payer. EDI 270/271 indicates HIPAA-compliant electronic eligibility inquiry and response; portal indicates web-based lookup; phone indicates manual call to payer; real-time API indicates direct system integration.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:idExternal rdf:type rdf:Property ;
    rdfs:label 'Id External' ;
    rdfs:comment 'Payers own identifier for their organization, often used in their systems and communications. May be a CPID (Carrier Payer ID), plan code, or other payer-assigned identifier.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inactivationDate rdf:type rdf:Property ;
    rdfs:label 'Inactivation Date' ;
    rdfs:comment 'Date on which this payer record was marked inactive. Null if payer is currently active. Used for audit trail and historical analysis.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inactivationReason rdf:type rdf:Property ;
    rdfs:label 'Inactivation Reason' ;
    rdfs:comment 'Explanation for why this payer record was inactivated. Common reasons include contract termination, payer merger or acquisition, payer out of business, or duplicate record consolidation. Null if payer is active.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerCategory rdf:type rdf:Property ;
    rdfs:label 'Payer Category' ;
    rdfs:comment 'High-level categorization of the payer organization. Government includes federal and state programs; commercial includes private insurance carriers; managed care includes HMOs, PPOs, and ACOs; TPA (Third Party Administrator) processes claims on behalf of self-insured employers; other includes specialty programs.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerName rdf:type rdf:Property ;
    rdfs:label 'Payer Name' ;
    rdfs:comment 'Official registered name of the insurance payer organization.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerType rdf:type rdf:Property ;
    rdfs:label 'Payer Type' ;
    rdfs:comment 'Classification of the payer by program type. Determines billing rules, claim formats, and regulatory requirements. Commercial includes private insurance carriers and employer-sponsored plans; Medicare includes traditional Medicare and Medicare Advantage; Medicaid includes state Medicaid programs and managed Medicaid; CHIP is Childrens Health Insurance Program; TRICARE is military health system; workers compensation covers occupational injuries; self-pay represents uninsured patients. [ENUM-REF-CANDIDATE: commercial|medicare|medicaid|chip|tricare|workers_compensation|self_pay — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerRelationsEmail rdf:type rdf:Property ;
    rdfs:label 'Provider Relations Email' ;
    rdfs:comment 'Email address for the payers provider relations or network management team. Used for contract inquiries, credentialing issues, and provider communications.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Remittance Address Line1' ;
    rdfs:comment 'First line of the payers remittance mailing address where paper checks and EOBs are sent. Includes street number and street name.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Remittance Address Line2' ;
    rdfs:comment 'Second line of the payers remittance mailing address. Typically contains suite, floor, department, or other secondary address information. Null if not applicable.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceCity rdf:type rdf:Property ;
    rdfs:label 'Remittance City' ;
    rdfs:comment 'City name for the payers remittance mailing address.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Remittance Delivery Method' ;
    rdfs:comment 'Method by which the payer delivers remittance advice. EDI 835 indicates electronic remittance advice via X12 835 transaction; ERA (Electronic Remittance Advice) is synonym for EDI 835; paper EOB (Explanation of Benefits) indicates physical mail; portal indicates download from payer website.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittancePostalCode rdf:type rdf:Property ;
    rdfs:label 'Remittance Postal Code' ;
    rdfs:comment 'ZIP code or ZIP+4 code for the payers remittance mailing address. Format: XXXXX or XXXXX-XXXX.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceState rdf:type rdf:Property ;
    rdfs:label 'Remittance State' ;
    rdfs:comment 'Two-letter state or territory abbreviation for the payers remittance mailing address. Follows USPS state abbreviation standards.' ;
    rdfs:domain ind:Payer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortName rdf:type rdf:Property ;
    rdfs:label 'Short Name' ;
    rdfs:comment 'Abbreviated or commonly used name for the payer for display purposes in user interfaces and reports.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tier rdf:type rdf:Property ;
    rdfs:label 'Tier' ;
    rdfs:comment 'Internal classification of payer by volume, strategic importance, or contract terms. Tier 1 represents highest volume or most favorable contract terms; Tier 4 represents lowest volume or least favorable terms. Used for prioritization in revenue cycle operations and contract negotiations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:predecessorHealthPlanId rdf:type rdf:Property ;
    rdfs:label 'Predecessor Health Plan Id' ;
    rdfs:comment 'Self-referencing FK on health_plan (predecessor_health_plan_id)' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HealthPlan .

ind:cmsContractNumber rdf:type rdf:Property ;
    rdfs:label 'Cms Contract Number' ;
    rdfs:comment 'The unique contract identifier assigned by CMS for Medicare Advantage, Medicare Part D, or Medicaid managed care plans. Used for regulatory reporting and plan identification.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobOrder rdf:type rdf:Property ;
    rdfs:label 'Cob Order' ;
    rdfs:comment 'The order in which this plan pays when a member has multiple insurance coverages. Primary pays first, Secondary pays after primary, Tertiary pays after secondary. Used for COB adjudication logic.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coinsurancePercentage rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Percentage' ;
    rdfs:comment 'The percentage of allowed charges that the member is responsible for paying after the deductible is met. Expressed as a percentage (e.g., 20.00 for 20% member responsibility).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emergencyRoomCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Emergency Room Copay Amount' ;
    rdfs:comment 'The fixed dollar amount in USD that a member pays for an emergency department visit. May be waived if admitted. Null if the plan uses coinsurance instead of copay.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:familyDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Family Deductible Amount' ;
    rdfs:comment 'The annual deductible amount in USD that a family unit must collectively pay out-of-pocket before the plan begins cost-sharing for covered services.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:familyOopMaxAmount rdf:type rdf:Property ;
    rdfs:label 'Family Oop Max Amount' ;
    rdfs:comment 'The annual maximum amount in USD that a family unit will collectively pay out-of-pocket for covered services. After reaching this limit, the plan pays 100% of covered costs for the remainder of the benefit year.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fsaEligible rdf:type rdf:Property ;
    rdfs:label 'Fsa Eligible' ;
    rdfs:comment 'Indicates whether this plan allows members to participate in a Flexible Spending Account for pre-tax healthcare or dependent care expenses.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundingType rdf:type rdf:Property ;
    rdfs:label 'Funding Type' ;
    rdfs:comment 'The financial arrangement model for the plan. Fully Insured means the payer assumes all risk; Self-Funded means the employer assumes risk and payer provides administrative services only (ASO); Level Funded is a hybrid with predictable monthly costs; Partially Self-Funded shares risk between employer and payer.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hraEligible rdf:type rdf:Property ;
    rdfs:label 'Hra Eligible' ;
    rdfs:comment 'Indicates whether this plan is paired with an employer-funded Health Reimbursement Arrangement that reimburses employees for qualified medical expenses.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hsaEligible rdf:type rdf:Property ;
    rdfs:label 'Hsa Eligible' ;
    rdfs:comment 'Indicates whether this plan is HSA-qualified, meaning it meets IRS requirements for high-deductible health plans that allow members to contribute to a tax-advantaged Health Savings Account.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:individualDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Individual Deductible Amount' ;
    rdfs:comment 'The annual deductible amount in USD that an individual member must pay out-of-pocket before the plan begins cost-sharing for covered services.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:individualOopMaxAmount rdf:type rdf:Property ;
    rdfs:label 'Individual Oop Max Amount' ;
    rdfs:comment 'The annual maximum amount in USD that an individual member will pay out-of-pocket for covered services. After reaching this limit, the plan pays 100% of covered costs for the remainder of the benefit year.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inpatientHospitalCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Inpatient Hospital Copay Amount' ;
    rdfs:comment 'The fixed dollar amount in USD that a member pays per inpatient hospital admission or per day. Null if the plan uses coinsurance instead of copay.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:issuerState rdf:type rdf:Property ;
    rdfs:label 'Issuer State' ;
    rdfs:comment 'The two-letter state code where this health plan is issued and regulated. Used for multi-state payers to track jurisdiction-specific plan configurations.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metalTier rdf:type rdf:Property ;
    rdfs:label 'Metal Tier' ;
    rdfs:comment 'The actuarial value tier for ACA (Affordable Care Act) marketplace plans indicating the percentage of covered healthcare costs the plan pays on average. Bronze (60%), Silver (70%), Gold (80%), Platinum (90%), Catastrophic (minimal coverage for under-30 or hardship exemption). Not Applicable for non-ACA plans.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openEnrollmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Open Enrollment End Date' ;
    rdfs:comment 'The last date of the annual open enrollment period during which eligible individuals can enroll in or change their health plan selection without a qualifying life event.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:openEnrollmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Open Enrollment Start Date' ;
    rdfs:comment 'The first date of the annual open enrollment period during which eligible individuals can enroll in or change their health plan selection without a qualifying life event.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outOfNetworkCoverage rdf:type rdf:Property ;
    rdfs:label 'Out Of Network Coverage' ;
    rdfs:comment 'Indicates whether this plan provides any coverage for out-of-network providers and facilities. True for PPO and POS plans, false for HMO and EPO plans (except emergency services).' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfNetworkDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Out Of Network Deductible Amount' ;
    rdfs:comment 'The annual deductible amount in USD for out-of-network services. Typically higher than in-network deductible. Null if plan does not cover out-of-network services.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outOfNetworkOopMaxAmount rdf:type rdf:Property ;
    rdfs:label 'Out Of Network Oop Max Amount' ;
    rdfs:comment 'The annual maximum out-of-pocket amount in USD for out-of-network services. Typically higher than in-network OOP max. Null if plan does not cover out-of-network services.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Plan Document Url' ;
    rdfs:comment 'The web URL where the official plan document, Summary of Benefits and Coverage (SBC), or Evidence of Coverage (EOC) can be accessed by members and providers.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planIdentifier rdf:type rdf:Property ;
    rdfs:label 'Plan Identifier' ;
    rdfs:comment 'The externally-recognized unique identifier for this plan. May be HIOS (Health Insurance Oversight System) Plan ID for ACA marketplace plans, CMS contract number for Medicare Advantage or Part D plans, or state-assigned Medicaid plan ID.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planName rdf:type rdf:Property ;
    rdfs:label 'Plan Name' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Status' ;
    rdfs:comment 'The current lifecycle status of the health plan. Active means the plan is currently offered and accepting enrollments; Suspended means temporarily unavailable; Terminated means no longer offered; Pending Approval means awaiting regulatory approval; Grandfathered means exempt from certain ACA requirements; Closed to New Enrollment means existing members can renew but new members cannot enroll.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planType rdf:type rdf:Property ;
    rdfs:label 'Plan Type' ;
    rdfs:comment 'The structural type of the health plan indicating network and coverage model. HMO (Health Maintenance Organization) requires PCP and referrals; PPO (Preferred Provider Organization) allows out-of-network care; EPO (Exclusive Provider Organization) requires in-network only; POS (Point of Service) hybrid model; HDHP (High Deductible Health Plan) paired with HSA; Medicare Advantage (MA) for Medicare beneficiaries; Medicare Part D for prescription drug coverage; Medicaid Managed Care for state Medicaid programs; CHIP (Childrens Health Insurance Program); Self-Funded for employer-administered plans. [ENUM-REF-CANDIDATE: HMO|PPO|EPO|POS|HDHP|Medicare Advantage|Medicare Part D|Medicaid Managed Care|CHIP|Self-Funded — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prescriptionTier1CopayAmount rdf:type rdf:Property ;
    rdfs:label 'Prescription Tier1 Copay Amount' ;
    rdfs:comment 'The fixed dollar amount in USD that a member pays for a Tier 1 (typically generic) prescription drug. Null if the plan uses coinsurance for pharmacy benefits.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prescriptionTier2CopayAmount rdf:type rdf:Property ;
    rdfs:label 'Prescription Tier2 Copay Amount' ;
    rdfs:comment 'The fixed dollar amount in USD that a member pays for a Tier 2 (typically preferred brand) prescription drug. Null if the plan uses coinsurance for pharmacy benefits.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prescriptionTier3CopayAmount rdf:type rdf:Property ;
    rdfs:label 'Prescription Tier3 Copay Amount' ;
    rdfs:comment 'The fixed dollar amount in USD that a member pays for a Tier 3 (typically non-preferred brand) prescription drug. Null if the plan uses coinsurance for pharmacy benefits.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prescriptionTier4CopayAmount rdf:type rdf:Property ;
    rdfs:label 'Prescription Tier4 Copay Amount' ;
    rdfs:comment 'The fixed dollar amount in USD that a member pays for a Tier 4 (typically specialty) prescription drug. Null if the plan uses coinsurance for pharmacy benefits.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preventiveCareCovered rdf:type rdf:Property ;
    rdfs:label 'Preventive Care Covered' ;
    rdfs:comment 'Indicates whether preventive care services (annual physicals, immunizations, screenings) are covered at 100% with no member cost-sharing, as required by ACA for non-grandfathered plans.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryCareCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Primary Care Copay Amount' ;
    rdfs:comment 'The fixed dollar amount in USD that a member pays for a primary care physician office visit. Null if the plan uses coinsurance instead of copay.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requiresPcpSelection rdf:type rdf:Property ;
    rdfs:label 'Requires Pcp Selection' ;
    rdfs:comment 'Indicates whether members are required to select and maintain a designated primary care physician. Typically true for HMO and POS plans, false for PPO and EPO plans.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresReferralForSpecialist rdf:type rdf:Property ;
    rdfs:label 'Requires Referral For Specialist' ;
    rdfs:comment 'Indicates whether members must obtain a referral from their PCP before seeing a specialist. Typically true for HMO plans, false for PPO, EPO, and POS plans.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialistCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Specialist Copay Amount' ;
    rdfs:comment 'The fixed dollar amount in USD that a member pays for a specialist physician office visit. Null if the plan uses coinsurance instead of copay.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateFilingNumber rdf:type rdf:Property ;
    rdfs:label 'State Filing Number' ;
    rdfs:comment 'The unique filing or approval number assigned by the state insurance department for this health plan product. Required for regulatory compliance and rate filings.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:urgentCareCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Urgent Care Copay Amount' ;
    rdfs:comment 'The fixed dollar amount in USD that a member pays for an urgent care facility visit. Null if the plan uses coinsurance instead of copay.' ;
    rdfs:domain ind:HealthPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benefitId rdf:type rdf:Property ;
    rdfs:label 'Benefit Id' ;
    rdfs:comment 'Removed redundant prefix "product_" from insurance.benefit.product_benefit_id.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:diagnosisIcdCodeId rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: Benefits often require specific diagnoses for coverage (e.g., CGM for diabetes, PT for specific conditions). Medical necessity validation and claims auto-adjudication depend on diagnosis-benefit linka' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:parentBenefitId rdf:type rdf:Property ;
    rdfs:label 'Parent Benefit Id' ;
    rdfs:comment 'Self-referencing FK on benefit (parent_benefit_id)' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Benefit .

ind:procedureCptCodeId rdf:type rdf:Property ;
    rdfs:label 'Procedure Cpt Code Id' ;
    rdfs:comment 'Foreign key linking to reference.cpt_code. Business justification: Benefits are defined by specific CPT procedures with associated copays, coinsurance, and authorization requirements. Core to claims adjudication engine and member cost-sharing calculation in every pay' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CptCode .

ind:procedureHcpcsCodeId rdf:type rdf:Property ;
    rdfs:label 'Procedure Hcpcs Code Id' ;
    rdfs:comment 'Foreign key linking to reference.hcpcs_code. Business justification: Benefits for DME, supplies, and non-physician services are defined by HCPCS codes. Essential for benefit determination, prior authorization rules, and claims payment calculation in healthcare payer op' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HcpcsCode .

ind:allowedAmountBasis rdf:type rdf:Property ;
    rdfs:label 'Allowed Amount Basis' ;
    rdfs:comment 'Method used to determine the allowed amount for benefit adjudication. Defines how the plan calculates the maximum payable amount for a service.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitCategory rdf:type rdf:Property ;
    rdfs:label 'Benefit Category' ;
    rdfs:comment 'High-level classification of the healthcare service category covered by this benefit. [ENUM-REF-CANDIDATE: inpatient_hospital|outpatient_surgery|primary_care|specialist|emergency|mental_health|substance_use|preventive|durable_medical_equipment|home_health|hospice|vision|dental|pharmacy|rehabilitation|skilled_nursing — promote to reference product]' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitCode rdf:type rdf:Property ;
    rdfs:label 'Benefit Code' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitDescription rdf:type rdf:Property ;
    rdfs:label 'Benefit Description' ;
    rdfs:comment 'Detailed text describing the scope, limitations, and clinical applicability of this benefit.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitName rdf:type rdf:Property ;
    rdfs:label 'Benefit Name' ;
    rdfs:comment 'Display name of the benefit as presented to members and providers.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitStatus rdf:type rdf:Property ;
    rdfs:label 'Benefit Status' ;
    rdfs:comment 'Current lifecycle status of the benefit component. Active benefits are available for adjudication; inactive benefits are historical or discontinued.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copayAmount rdf:type rdf:Property ;
    rdfs:label 'Copay Amount' ;
    rdfs:comment 'Fixed dollar amount the member pays per service or visit as defined by the benefit. Null if benefit uses coinsurance instead of copay.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costSharingTier rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Tier' ;
    rdfs:comment 'Actuarial value tier of the benefit indicating the percentage of costs the plan covers on average. Used for ACA marketplace plans.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coveragePercentage rdf:type rdf:Property ;
    rdfs:label 'Coverage Percentage' ;
    rdfs:comment 'Percentage of allowed amount the plan pays for this benefit. Expressed as percentage (e.g., 80.00 for 80% plan payment). Inverse of coinsurance_percentage.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dayLimitCount rdf:type rdf:Property ;
    rdfs:label 'Day Limit Count' ;
    rdfs:comment 'Maximum number of days covered per benefit period for services measured in days (e.g., 90 days skilled nursing facility per benefit period). Null if no day limit applies.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dayLimitPeriod rdf:type rdf:Property ;
    rdfs:label 'Day Limit Period' ;
    rdfs:comment 'Time period over which the day limit count applies. Example: per_admission for inpatient stays, per_year for annual day limits.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysSupplyLimit rdf:type rdf:Property ;
    rdfs:label 'Days Supply Limit' ;
    rdfs:comment 'Maximum number of days supply allowed per prescription fill for pharmacy benefits. Common limits are 30, 60, or 90 days. Null if not applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deductibleAppliesFlag rdf:type rdf:Property ;
    rdfs:label 'Deductible Applies Flag' ;
    rdfs:comment 'Indicates whether the plan deductible must be met before this benefit pays. True if deductible applies, False if benefit is not subject to deductible (e.g., preventive services).' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diagnosisCodeType rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Code Type' ;
    rdfs:comment 'Type of diagnosis coding system used for medical necessity determination and benefit eligibility. ICD-10-CM is current standard in US; ICD-9-CM is legacy.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dollarLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Dollar Limit Amount' ;
    rdfs:comment 'Maximum dollar amount the plan will pay for this benefit per limit period. Null if no dollar limit applies. Note: ACA prohibits lifetime and annual dollar limits on essential health benefits.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dollarLimitPeriod rdf:type rdf:Property ;
    rdfs:label 'Dollar Limit Period' ;
    rdfs:comment 'Time period over which the dollar limit amount applies. Used for non-essential benefits where dollar limits are permitted.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:essentialHealthBenefitFlag rdf:type rdf:Property ;
    rdfs:label 'Essential Health Benefit Flag' ;
    rdfs:comment 'Indicates whether this benefit is classified as an Essential Health Benefit under ACA. EHBs cannot have annual or lifetime dollar limits.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionsText rdf:type rdf:Property ;
    rdfs:label 'Exclusions Text' ;
    rdfs:comment 'Narrative description of services or conditions explicitly excluded from this benefit. Critical for claims denial and member communication.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityServiceTypeCode rdf:type rdf:Property ;
    rdfs:label 'Facility Service Type Code' ;
    rdfs:comment 'Standard code identifying the type of healthcare service covered by this benefit. Aligns with X12 837 claim service type codes for electronic transactions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formularyTier rdf:type rdf:Property ;
    rdfs:label 'Formulary Tier' ;
    rdfs:comment 'Pharmacy formulary tier for drug benefits indicating cost-sharing level. Tier 1 typically generic, Tier 2 preferred brand, Tier 3 non-preferred brand, Tier 4 specialty drugs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hsaEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Hsa Eligible Flag' ;
    rdfs:comment 'Indicates whether this benefit is compatible with Health Savings Account (HSA) requirements. True if benefit meets HSA-qualified high-deductible health plan (HDHP) rules.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:limitationsText rdf:type rdf:Property ;
    rdfs:label 'Limitations Text' ;
    rdfs:comment 'Narrative description of limitations, restrictions, or conditions that apply to this benefit beyond the structured limit fields.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailOrderAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Mail Order Available Flag' ;
    rdfs:comment 'Indicates whether this pharmacy benefit can be fulfilled through mail order pharmacy with potentially different cost-sharing. True if mail order option available.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfPocketAppliesFlag rdf:type rdf:Property ;
    rdfs:label 'Out Of Pocket Applies Flag' ;
    rdfs:comment 'Indicates whether member cost-sharing for this benefit counts toward the annual out-of-pocket maximum. True if it counts, False if excluded (e.g., non-covered services).' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preventiveCareFlag rdf:type rdf:Property ;
    rdfs:label 'Preventive Care Flag' ;
    rdfs:comment 'Indicates whether this benefit is classified as preventive care under ACA requirements. Preventive services must be covered at 100% with no cost-sharing when delivered in-network.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorAuthorizationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Required Flag' ;
    rdfs:comment 'Indicates whether prior authorization from the health plan is required before the service is covered. True if PA required, False otherwise.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quantityLimitFlag rdf:type rdf:Property ;
    rdfs:label 'Quantity Limit Flag' ;
    rdfs:comment 'Indicates whether this benefit has quantity or frequency limits (e.g., maximum number of visits, days supply, units per fill). True if limits apply.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referralRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Referral Required Flag' ;
    rdfs:comment 'Indicates whether a referral from Primary Care Physician (PCP) is required to access this benefit. Common in Health Maintenance Organization (HMO) plans.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stepTherapyRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Step Therapy Required Flag' ;
    rdfs:comment 'Indicates whether step therapy protocol must be followed (trying lower-cost alternatives before higher-cost treatments). Primarily used for pharmacy benefits.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subcategory rdf:type rdf:Property ;
    rdfs:label 'Subcategory' ;
    rdfs:comment 'Detailed subcategory within the benefit category providing granular service classification. Example: Acute Inpatient, Observation Stay, Ambulatory Surgery.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:visitLimitCount rdf:type rdf:Property ;
    rdfs:label 'Visit Limit Count' ;
    rdfs:comment 'Maximum number of visits or services allowed per benefit period (e.g., 20 physical therapy visits per year). Null if no visit limit applies.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:visitLimitPeriod rdf:type rdf:Property ;
    rdfs:label 'Visit Limit Period' ;
    rdfs:comment 'Time period over which the visit limit count applies. Example: per_year for annual limits, per_lifetime for lifetime maximums.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentProviderNetworkId rdf:type rdf:Property ;
    rdfs:label 'Parent Provider Network Id' ;
    rdfs:comment 'Self-referencing FK on provider_network (parent_provider_network_id)' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProviderNetwork .

ind:acceptingNewPatientsFlag rdf:type rdf:Property ;
    rdfs:label 'Accepting New Patients Flag' ;
    rdfs:comment 'Indicates whether the network as a whole has capacity to accept new members. True if sufficient providers are accepting new patients. False if network is at capacity. Used for enrollment management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adequacyReviewDate rdf:type rdf:Property ;
    rdfs:label 'Adequacy Review Date' ;
    rdfs:comment 'Date of the most recent network adequacy assessment by CMS or state regulators. Networks must be reviewed annually or when material changes occur.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:behavioralHealthIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Included Flag' ;
    rdfs:comment 'Indicates whether this network includes behavioral health and mental health providers. True if behavioral health services are covered. False if behavioral health is carved out to a separate network.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Cms Approval Date' ;
    rdfs:comment 'Date when CMS approved the network adequacy filing. Null if not yet approved or not required.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cmsFilingDate rdf:type rdf:Property ;
    rdfs:label 'Cms Filing Date' ;
    rdfs:comment 'Date when the network adequacy filing was submitted to CMS. Required for Medicare Advantage and Marketplace plans.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cmsFilingStatus rdf:type rdf:Property ;
    rdfs:label 'Cms Filing Status' ;
    rdfs:comment 'Status of the network adequacy filing with CMS for Medicare Advantage or Marketplace plans. Filed indicates submission. Approved indicates CMS acceptance. Rejected indicates CMS denial. Pending indicates under CMS review. Not required for non-CMS regulated plans.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingStandard rdf:type rdf:Property ;
    rdfs:label 'Credentialing Standard' ;
    rdfs:comment 'Accreditation or regulatory standard used for provider credentialing in this network. NCQA (National Committee for Quality Assurance) is most common. URAC is utilization review accreditation. AAAHC (Accreditation Association for Ambulatory Health Care) for ambulatory settings. TJC (The Joint Commission) for hospitals. State-specific for state-mandated standards. Internal for payer-defined standards.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dentalNetworkIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Dental Network Included Flag' ;
    rdfs:comment 'Indicates whether this network includes dental providers or if dental benefits are managed separately. True if dental is included. False if dental is carved out.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:directoryLastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Directory Last Updated Date' ;
    rdfs:comment 'Date when the provider directory was last updated with current network participation information. CMS requires directories to be updated at least monthly.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilityCount rdf:type rdf:Property ;
    rdfs:label 'Facility Count' ;
    rdfs:comment 'Total number of facilities (hospitals, clinics, surgery centers, imaging centers) participating in this network. Used for network adequacy assessment and member communications.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:facilityServiceAreaType rdf:type rdf:Property ;
    rdfs:label 'Facility Service Area Type' ;
    rdfs:comment 'Classification of the geographic service area scope. Statewide covers entire state. Regional covers multiple counties or regions. County covers specific counties. ZIP code covers specific ZIP codes. MSA (Metropolitan Statistical Area) covers census-defined metro areas. National covers multiple states or entire country.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legacyParentNetworkCode rdf:type rdf:Property ;
    rdfs:label 'Legacy Parent Network Code' ;
    rdfs:comment 'Identifier of the parent or umbrella network if this network is a subset or regional variant. Used for hierarchical network structures where a national network has regional sub-networks. Null for top-level networks.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:networkAdequacyStatus rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Status' ;
    rdfs:comment 'Assessment of whether the provider network meets regulatory standards for provider availability, geographic access, and appointment wait times. Adequate networks meet all standards. Inadequate networks require corrective action. Conditionally adequate networks meet standards with exceptions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkDescription rdf:type rdf:Property ;
    rdfs:label 'Network Description' ;
    rdfs:comment 'Detailed description of the provider network, including key features, geographic coverage, specialty availability, and member benefits. Used in plan marketing materials and member communications.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkDirectoryUrl rdf:type rdf:Property ;
    rdfs:label 'Network Directory Url' ;
    rdfs:comment 'Web address of the online provider directory for this network. Members use this to search for in-network providers. Required by CMS for Medicare Advantage and Marketplace plans.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkIdentifierCode rdf:type rdf:Property ;
    rdfs:label 'Network Identifier Code' ;
    rdfs:comment 'Unique business code identifying this provider network for cross-system reference and plan-network linkage.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkModel rdf:type rdf:Property ;
    rdfs:label 'Network Model' ;
    rdfs:comment 'Organizational structure of the provider network. Staff model employs providers directly. Group model contracts with multi-specialty groups. Network model contracts with multiple IPAs. IPA (Independent Practice Association) is a physician-owned network. Direct contract is payer-to-provider agreements. Rental network leases access to another payers network.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkName rdf:type rdf:Property ;
    rdfs:label 'Network Name' ;
    rdfs:comment 'Human-readable name of the provider network, used in member communications, plan documents, and provider directories.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkStatus rdf:type rdf:Property ;
    rdfs:label 'Network Status' ;
    rdfs:comment 'Current lifecycle status of the provider network. Active networks are available for member enrollment and claim adjudication. Pending networks are under development or regulatory review. Suspended networks are temporarily unavailable. Terminated networks are closed and no longer accepting new members.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcpCount rdf:type rdf:Property ;
    rdfs:label 'Pcp Count' ;
    rdfs:comment 'Total number of primary care physicians in this network. Critical metric for HMO and POS networks that require PCP selection. Used for network adequacy assessment.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pharmacyNetworkIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Network Included Flag' ;
    rdfs:comment 'Indicates whether this network includes pharmacy providers or if pharmacy benefits are managed separately. True if pharmacy is included. False if pharmacy is carved out.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityTierMethodology rdf:type rdf:Property ;
    rdfs:label 'Quality Tier Methodology' ;
    rdfs:comment 'Description of the methodology used to assign providers to quality or performance tiers within this network. May reference HEDIS measures, patient satisfaction scores, cost efficiency, or clinical outcomes. Used in tiered network designs.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recredentialingCycleMonths rdf:type rdf:Property ;
    rdfs:label 'Recredentialing Cycle Months' ;
    rdfs:comment 'Number of months between provider recredentialing reviews. Typically 24 or 36 months per NCQA standards. Used to schedule provider credential verification and quality reviews.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskArrangement rdf:type rdf:Property ;
    rdfs:label 'Risk Arrangement' ;
    rdfs:comment 'Financial risk-sharing arrangement between payer and network providers. Full risk transfers all financial risk to providers. Shared risk splits risk between payer and providers. Upside only allows providers to share savings but not losses. Downside risk requires providers to cover losses. No risk is traditional fee-for-service.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialistCount rdf:type rdf:Property ;
    rdfs:label 'Specialist Count' ;
    rdfs:comment 'Total number of specialist physicians in this network. Used for network adequacy assessment and member communications.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:telehealthEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Telehealth Enabled Flag' ;
    rdfs:comment 'Indicates whether this network includes telehealth or virtual care providers. True if telehealth services are available. False if only in-person care is covered.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:visionNetworkIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Vision Network Included Flag' ;
    rdfs:comment 'Indicates whether this network includes vision providers or if vision benefits are managed separately. True if vision is included. False if vision is carved out.' ;
    rdfs:domain ind:ProviderNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planNetworkId rdf:type rdf:Property ;
    rdfs:label 'Plan Network Id' ;
    rdfs:comment 'Unique identifier for the plan-network association record. Primary key.' ;
    rdfs:domain ind:PlanNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededPlanNetworkId rdf:type rdf:Property ;
    rdfs:label 'Superseded Plan Network Id' ;
    rdfs:comment 'Self-referencing FK on plan_network (superseded_plan_network_id)' ;
    rdfs:domain ind:PlanNetwork ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PlanNetwork .

ind:claimsProcessingPriority rdf:type rdf:Property ;
    rdfs:label 'Claims Processing Priority' ;
    rdfs:comment 'Priority level for processing claims from this network within the plan. Lower numbers indicate higher priority for adjudication workflows.' ;
    rdfs:domain ind:PlanNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:copayTierCode rdf:type rdf:Property ;
    rdfs:label 'Copay Tier Code' ;
    rdfs:comment 'Code identifying the copayment tier structure applicable to this network within the plan. Links to benefit copay schedules for member cost-sharing calculations.' ;
    rdfs:domain ind:PlanNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicRegion rdf:type rdf:Property ;
    rdfs:label 'Geographic Region' ;
    rdfs:comment 'Geographic region or service area where this network is applicable for the plan. May include state, county, or custom region codes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberCommunicationRequired rdf:type rdf:Property ;
    rdfs:label 'Member Communication Required' ;
    rdfs:comment 'Indicates whether plan members must be notified about this network association or changes to it. Used for regulatory compliance with member notification requirements.' ;
    rdfs:domain ind:PlanNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkAdequacyCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Certification Date' ;
    rdfs:comment 'Date when network adequacy certification was granted for this plan-network association. Used for regulatory reporting and compliance tracking.' ;
    rdfs:domain ind:PlanNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:networkAdequacyCertified rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Certified' ;
    rdfs:comment 'Indicates whether this network has been certified as meeting network adequacy standards for the plan service area. Required for CMS (Centers for Medicare and Medicaid Services) and state regulatory compliance.' ;
    rdfs:domain ind:PlanNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkPriority rdf:type rdf:Property ;
    rdfs:label 'Network Priority' ;
    rdfs:comment 'Numeric priority ranking of this network within the plan when multiple networks are available. Lower numbers indicate higher priority for benefit determination.' ;
    rdfs:domain ind:PlanNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:networkRole rdf:type rdf:Property ;
    rdfs:label 'Network Role' ;
    rdfs:comment 'Role or function of this network within the plan structure. Indicates whether the network serves as the primary, secondary, or specialized network for plan members.' ;
    rdfs:domain ind:PlanNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outOfPocketMaxApplies rdf:type rdf:Property ;
    rdfs:label 'Out Of Pocket Max Applies' ;
    rdfs:comment 'Indicates whether member cost-sharing for services in this network counts toward the plan out-of-pocket maximum. Critical for Affordable Care Act (ACA) compliance.' ;
    rdfs:domain ind:PlanNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pcpSelectionRequired rdf:type rdf:Property ;
    rdfs:label 'Pcp Selection Required' ;
    rdfs:comment 'Indicates whether members enrolled in this plan-network combination must select a Primary Care Physician (PCP) from the network.' ;
    rdfs:domain ind:PlanNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planNetworkStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Network Status' ;
    rdfs:comment 'Current lifecycle status of the plan-network association. Indicates whether the association is currently in effect for benefit determination and claim adjudication.' ;
    rdfs:domain ind:PlanNetwork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralRequired rdf:type rdf:Property ;
    rdfs:label 'Referral Required' ;
    rdfs:comment 'Indicates whether specialist referrals are required for members using this network under the plan. Common in HMO (Health Maintenance Organization) configurations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceCoveragePolicyId rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Policy Id' ;
    rdfs:comment 'Add pii_phi, pii_pii, pii_sensitive tags for PHI compliance' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuranceCoveragePolicy .

ind:supersededByCoveragePolicyInsuranceCoveragePolicyId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Coverage Policy Insurance Coverage Policy Id' ;
    rdfs:comment 'Reference to the coverage policy that replaces this policy when it is retired or superseded. Nullable if the policy is still active or has not been replaced.' ;
    rdfs:domain ind:InsuranceCoveragePolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuranceCoveragePolicy .

ind:ageRestrictions rdf:type rdf:Property ;
    rdfs:label 'Age Restrictions' ;
    rdfs:comment 'Age-based limitations or requirements for coverage under this policy (e.g., covered for patients 18 years and older, pediatric use only).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealsAllowed rdf:type rdf:Property ;
    rdfs:label 'Appeals Allowed' ;
    rdfs:comment 'Indicates whether coverage denials based on this policy can be appealed by the provider or patient. True = appeals allowed; False = no appeals allowed.' ;
    rdfs:domain ind:InsuranceCoveragePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealsProcessDescription rdf:type rdf:Property ;
    rdfs:label 'Appeals Process Description' ;
    rdfs:comment 'Detailed description of the appeals process for coverage denials based on this policy, including timelines, required documentation, and contact information.' ;
    rdfs:domain ind:InsuranceCoveragePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalEvidenceSource rdf:type rdf:Property ;
    rdfs:label 'Clinical Evidence Source' ;
    rdfs:comment 'Reference to the clinical evidence, guidelines, or literature that supports the coverage determination (e.g., NCCN Guidelines, FDA approval, peer-reviewed clinical trial).' ;
    rdfs:domain ind:InsuranceCoveragePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageDetermination rdf:type rdf:Property ;
    rdfs:label 'Coverage Determination' ;
    rdfs:comment 'Final determination of whether the service, procedure, or technology is covered under this policy. Covered = reimbursable; Non-Covered = not reimbursable; Conditional = covered only if specific criteria met; Investigational/Experimental = not covered due to lack of evidence; Not Medically Necessary = does not meet medical necessity criteria.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyLimitations rdf:type rdf:Property ;
    rdfs:label 'Frequency Limitations' ;
    rdfs:comment 'Limitations on how often the service or procedure can be performed and reimbursed within a specified time period (e.g., once per calendar year, maximum 12 visits per year).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderRestrictions rdf:type rdf:Property ;
    rdfs:label 'Gender Restrictions' ;
    rdfs:comment 'Gender-based limitations or requirements for coverage under this policy (e.g., female patients only, male patients only, no gender restrictions).' ;
    rdfs:domain ind:InsuranceCoveragePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCoveragePolicyCategory rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Policy Category' ;
    rdfs:comment 'High-level categorization of the coverage policy by clinical domain or service type (e.g., Radiology, Pharmacy, Surgical Procedures, Durable Medical Equipment).' ;
    rdfs:domain ind:InsuranceCoveragePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCoveragePolicyDescription rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Policy Description' ;
    rdfs:comment 'Cleaned boilerplate phrase from insurance.coverage_policy.policy_description' ;
    rdfs:domain ind:InsuranceCoveragePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCoveragePolicyStatus rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Policy Status' ;
    rdfs:comment 'Current lifecycle status of the coverage policy. Active = in effect and enforceable; Inactive = temporarily suspended; Draft = not yet finalized; Under Review = being evaluated or updated; Retired = no longer in use; Superseded = replaced by a newer policy version.' ;
    rdfs:domain ind:InsuranceCoveragePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalNecessityCriteria rdf:type rdf:Property ;
    rdfs:label 'Medical Necessity Criteria' ;
    rdfs:comment 'Clinical criteria defining when the service or procedure is considered medically necessary and therefore eligible for coverage under this policy.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkRestrictions rdf:type rdf:Property ;
    rdfs:label 'Network Restrictions' ;
    rdfs:comment 'Indicates whether the service or procedure must be performed by an in-network provider to be covered. In-Network Only = only in-network providers eligible; Out-of-Network Allowed = both in-network and out-of-network providers eligible (may have different reimbursement); No Restriction = network status does not affect coverage.' ;
    rdfs:domain ind:InsuranceCoveragePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placeOfServiceRestrictions rdf:type rdf:Property ;
    rdfs:label 'Place Of Service Restrictions' ;
    rdfs:comment 'Restrictions on where the service or procedure can be performed to be eligible for coverage (e.g., inpatient hospital only, outpatient facility or office, home health setting).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyNumber rdf:type rdf:Property ;
    rdfs:label 'Policy Number' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyOwner rdf:type rdf:Property ;
    rdfs:label 'Policy Owner' ;
    rdfs:comment 'Name or identifier of the individual or department responsible for maintaining and updating this coverage policy.' ;
    rdfs:domain ind:InsuranceCoveragePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyType rdf:type rdf:Property ;
    rdfs:label 'Policy Type' ;
    rdfs:comment 'Classification of the coverage policy. Medical Policy = internal payer medical necessity policy; Coverage Determination = specific coverage decision; LCD = Local Coverage Determination (Medicare contractor-specific); NCD = National Coverage Determination (CMS national policy); Administrative Policy = non-clinical coverage rule; Clinical Guideline = evidence-based clinical criteria.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthorizationCriteria rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Criteria' ;
    rdfs:comment 'Detailed clinical and administrative criteria that must be met to obtain prior authorization for the service or procedure covered by this policy.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerSpecialtyRestrictions rdf:type rdf:Property ;
    rdfs:label 'Provider Specialty Restrictions' ;
    rdfs:comment 'Restrictions on which provider specialties are authorized to perform the service or procedure under this policy (e.g., board-certified cardiologist only, licensed physical therapist).' ;
    rdfs:domain ind:InsuranceCoveragePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityLimitations rdf:type rdf:Property ;
    rdfs:label 'Quantity Limitations' ;
    rdfs:comment 'Limitations on the quantity or dosage of the service, supply, or medication that can be provided and reimbursed under this policy (e.g., maximum 30-day supply, up to 10 units per month).' ;
    rdfs:domain ind:InsuranceCoveragePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryMemberSubscriberId rdf:type rdf:Property ;
    rdfs:label 'Primary Member Subscriber Id' ;
    rdfs:comment 'External subscriber identifier assigned by the payer or health plan. Used for eligibility verification and claim adjudication.' ;
    rdfs:domain ind:MemberEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Subscriber .

ind:priorMemberEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Prior Member Enrollment Id' ;
    rdfs:comment 'Self-referencing FK on member_enrollment (prior_member_enrollment_id)' ;
    rdfs:domain ind:MemberEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberEnrollment .

ind:coverageTier rdf:type rdf:Property ;
    rdfs:label 'Coverage Tier' ;
    rdfs:comment 'Coverage tier indicating the scope of family members covered under this enrollment. Affects premium calculation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentChannel rdf:type rdf:Property ;
    rdfs:label 'Enrollment Channel' ;
    rdfs:comment 'Channel or interface through which the member completed the enrollment process.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Enrollment Created Timestamp' ;
    rdfs:comment 'Timestamp when this enrollment record was first created in the system. Used for audit and data lineage tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:enrollmentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Effective Date' ;
    rdfs:comment 'Date when the member coverage becomes effective and benefits are available. Used for eligibility determination.' ;
    rdfs:domain ind:MemberEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentNotes rdf:type rdf:Property ;
    rdfs:label 'Enrollment Notes' ;
    rdfs:comment 'Free-text notes or comments related to this enrollment. Used for documenting special circumstances or exceptions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Enrollment Source System' ;
    rdfs:comment 'Name of the source system that originated this enrollment record. Used for data lineage and reconciliation.' ;
    rdfs:domain ind:MemberEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Termination Date' ;
    rdfs:comment 'Date when the member coverage ends and benefits are no longer available. Nullable for active enrollments.' ;
    rdfs:domain ind:MemberEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentType rdf:type rdf:Property ;
    rdfs:label 'Enrollment Type' ;
    rdfs:comment 'Type of enrollment event that initiated this coverage. Determines eligibility rules and enrollment period constraints.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Enrollment Updated Timestamp' ;
    rdfs:comment 'Timestamp when this enrollment record was last modified. Used for audit and change tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastPremiumPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Premium Payment Date' ;
    rdfs:comment 'Date of the most recent premium payment received for this enrollment. Used for grace period and termination calculations.' ;
    rdfs:domain ind:MemberEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicaidNumber rdf:type rdf:Property ;
    rdfs:label 'Medicaid Number' ;
    rdfs:comment 'State-assigned Medicaid identifier for dual-eligible members. Used for coordination of benefits and claim adjudication.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicarePartAEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Medicare Part A Effective Date' ;
    rdfs:comment 'Effective date of Medicare Part A coverage for dual-eligible members. Used for coordination of benefits.' ;
    rdfs:domain ind:MemberEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicarePartBEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Medicare Part B Effective Date' ;
    rdfs:comment 'Effective date of Medicare Part B coverage for dual-eligible members. Used for coordination of benefits.' ;
    rdfs:domain ind:MemberEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:premiumPaymentStatus rdf:type rdf:Property ;
    rdfs:label 'Premium Payment Status' ;
    rdfs:comment 'Current status of premium payments for this enrollment. Affects coverage eligibility and claim payment.' ;
    rdfs:domain ind:MemberEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorSubscriberId rdf:type rdf:Property ;
    rdfs:label 'Prior Subscriber Id' ;
    rdfs:comment 'Self-referencing FK on subscriber (prior_subscriber_id)' ;
    rdfs:domain ind:Subscriber ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Subscriber .

ind:cobraEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Cobra Eligible Flag' ;
    rdfs:comment 'Indicates whether the subscriber is eligible for COBRA continuation coverage after employment termination. True=eligible, False=not eligible.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraEndDate rdf:type rdf:Property ;
    rdfs:label 'Cobra End Date' ;
    rdfs:comment 'Date when COBRA continuation coverage ends, if applicable. Null if not on COBRA or coverage is ongoing.' ;
    rdfs:domain ind:Subscriber ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobraStartDate rdf:type rdf:Property ;
    rdfs:label 'Cobra Start Date' ;
    rdfs:comment 'Date when COBRA continuation coverage began, if applicable. Null if not on COBRA.' ;
    rdfs:domain ind:Subscriber ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Status' ;
    rdfs:comment 'Current lifecycle status of the subscribers coverage. Active=currently covered, Inactive=coverage lapsed, Suspended=temporarily paused, Terminated=permanently ended, Pending=awaiting activation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Date Of Birth' ;
    rdfs:comment 'Date of birth of the subscriber. Used for eligibility verification and age-based benefit determination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dualEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Dual Eligible Flag' ;
    rdfs:comment 'Indicates whether the subscriber is dually eligible for both Medicare and Medicaid. True=dual eligible, False=not dual eligible. Critical for coordination of benefits and cost-sharing determination.' ;
    rdfs:domain ind:Subscriber ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:firstName rdf:type rdf:Property ;
    rdfs:label 'First Name' ;
    rdfs:comment 'Legal first name of the subscriber as registered with the payer.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gender rdf:type rdf:Property ;
    rdfs:label 'Gender' ;
    rdfs:comment 'Administrative gender of the subscriber. M=Male, F=Female, U=Unknown, O=Other.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastName rdf:type rdf:Property ;
    rdfs:label 'Last Name' ;
    rdfs:comment 'Legal last name (family name) of the subscriber as registered with the payer.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Medicaid Eligible Flag' ;
    rdfs:comment 'Indicates whether the subscriber is eligible for Medicaid coverage. True=eligible, False=not eligible. Used for coordination of benefits and dual eligibility determination.' ;
    rdfs:domain ind:Subscriber ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Medicare Eligible Flag' ;
    rdfs:comment 'Indicates whether the subscriber is eligible for Medicare coverage. True=eligible, False=not eligible. Used for coordination of benefits.' ;
    rdfs:domain ind:Subscriber ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareNumber rdf:type rdf:Property ;
    rdfs:label 'Medicare Number' ;
    rdfs:comment 'Medicare Beneficiary Identifier (MBI) assigned by CMS, if the subscriber is Medicare-eligible. Used for coordination of benefits between Medicare and commercial insurance.' ;
    rdfs:domain ind:Subscriber ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:middleName rdf:type rdf:Property ;
    rdfs:label 'Middle Name' ;
    rdfs:comment 'Middle name or initial of the subscriber, if provided.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumFrequency rdf:type rdf:Property ;
    rdfs:label 'Premium Frequency' ;
    rdfs:comment 'Frequency at which the subscriber pays premiums.' ;
    rdfs:domain ind:Subscriber ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCarePhysicianNpi rdf:type rdf:Property ;
    rdfs:label 'Primary Care Physician Npi' ;
    rdfs:comment 'National Provider Identifier (NPI) of the subscribers designated primary care physician, if applicable. Used in managed care plans requiring PCP assignment.' ;
    rdfs:domain ind:Subscriber ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipToInsured rdf:type rdf:Property ;
    rdfs:label 'Relationship To Insured' ;
    rdfs:comment 'Relationship of the subscriber to the primary insured. For subscriber records, this is typically self since the subscriber IS the insured party. Used when subscriber may be a dependent on another policy.' ;
    rdfs:domain ind:Subscriber ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssn rdf:type rdf:Property ;
    rdfs:label 'Ssn' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suffix rdf:type rdf:Property ;
    rdfs:label 'Suffix' ;
    rdfs:comment 'Name suffix of the subscriber (Jr, Sr, II, III, etc.), if applicable.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceDependentId rdf:type rdf:Property ;
    rdfs:label 'Insurance Dependent Id' ;
    rdfs:comment 'Unique identifier for the dependent record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuranceDependent .

ind:coverageEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Coverage Effective Date' ;
    rdfs:comment 'Date when the dependents coverage under the subscribers health plan becomes effective.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Coverage Termination Date' ;
    rdfs:comment 'Date when the dependents coverage under the subscribers health plan terminates. Null if coverage is currently active.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Disability Status' ;
    rdfs:comment 'Indicates whether the dependent has a qualifying disability that extends eligibility beyond standard age or relationship limits.' ;
    rdfs:domain ind:InsuranceDependent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disabilityVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Disability Verification Date' ;
    rdfs:comment 'Date when the dependents disability status was last verified for extended eligibility purposes.' ;
    rdfs:domain ind:InsuranceDependent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Date' ;
    rdfs:comment 'Date when the dependent was enrolled in the health plan.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastEligibilityVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Last Eligibility Verification Date' ;
    rdfs:comment 'Date when the dependents eligibility was last verified by the health plan.' ;
    rdfs:domain ind:InsuranceDependent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:studentStatus rdf:type rdf:Property ;
    rdfs:label 'Student Status' ;
    rdfs:comment 'Indicates whether the dependent is a full-time or part-time student, which may extend eligibility beyond standard age limits (e.g., up to age 26).' ;
    rdfs:domain ind:InsuranceDependent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studentVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Student Verification Date' ;
    rdfs:comment 'Date when the dependents student status was last verified for eligibility extension purposes.' ;
    rdfs:domain ind:InsuranceDependent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tobaccoUseIndicator rdf:type rdf:Property ;
    rdfs:label 'Tobacco Use Indicator' ;
    rdfs:comment 'Indicates whether the dependent uses tobacco products, which may affect premium calculations.' ;
    rdfs:domain ind:InsuranceDependent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentEmployerGroupId rdf:type rdf:Property ;
    rdfs:label 'Parent Employer Group Id' ;
    rdfs:comment 'Self-referencing FK on employer_group (parent_employer_group_id)' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmployerGroup .

ind:acaApplicableLargeEmployerIndicator rdf:type rdf:Property ;
    rdfs:label 'Aca Applicable Large Employer Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this employer group meets the ACA definition of an Applicable Large Employer (50 or more full-time equivalent employees). ALEs are subject to the employer shared responsibility mandate and must offer affordable minimum essential coverage or face penalties.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraAdministrator rdf:type rdf:Property ;
    rdfs:label 'Cobra Administrator' ;
    rdfs:comment 'The entity responsible for administering COBRA continuation coverage for terminated employees and qualifying dependents. Payer: health plan administers. Employer: employer self-administers. TPA: third party administrator handles. External vendor: specialized COBRA vendor.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeCount rdf:type rdf:Property ;
    rdfs:label 'Employee Count' ;
    rdfs:comment 'The number of eligible employees (subscribers) in the employer group, excluding dependents. Used for group size classification, premium calculations, and regulatory reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:employerContributionPercentage rdf:type rdf:Property ;
    rdfs:label 'Employer Contribution Percentage' ;
    rdfs:comment 'The percentage of the employee-only premium that the employer pays. The employee pays the remainder. Typical employer contributions range from 50% to 100%. Used for ACA affordability calculations and premium billing.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerEin rdf:type rdf:Property ;
    rdfs:label 'Employer Ein' ;
    rdfs:comment 'The federal Employer Identification Number (EIN) assigned by the IRS, also known as the Federal Tax Identification Number. This nine-digit number uniquely identifies the employer for tax reporting and regulatory purposes. Format: XX-XXXXXXX.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erisaPlanIndicator rdf:type rdf:Property ;
    rdfs:label 'Erisa Plan Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this employer groups health plan is subject to ERISA federal regulations. True for most private employer plans. False for government and church plans which are ERISA-exempt.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gracePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Grace Period Days' ;
    rdfs:comment 'The number of days after the premium due date during which the employer group can make payment without coverage lapsing. Typically 30 days for group coverage. During the grace period, coverage remains active but claims may be pended.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:groupName rdf:type rdf:Property ;
    rdfs:label 'Group Name' ;
    rdfs:comment 'The legal or doing-business-as name of the employer organization that sponsors the health insurance coverage for its employees. This is the primary human-readable identifier for the group.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupSize rdf:type rdf:Property ;
    rdfs:label 'Group Size' ;
    rdfs:comment 'The total number of enrolled lives (employees and dependents) covered under this employer group. This count determines small group vs. large group classification for regulatory purposes and impacts premium rating methodologies.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:groupStatus rdf:type rdf:Property ;
    rdfs:label 'Group Status' ;
    rdfs:comment 'The current lifecycle status of the employer group contract. Active: coverage in force. Pending: application submitted, not yet effective. Suspended: temporarily inactive, may be reinstated. Terminated: contract ended by mutual agreement. Cancelled: contract ended by payer. Lapsed: contract ended due to non-payment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hsaEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Hsa Eligible Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this employer groups benefit plan is HSA-qualified (high deductible health plan meeting IRS requirements). If true, employees can contribute pre-tax dollars to a Health Savings Account.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:industryRiskClass rdf:type rdf:Property ;
    rdfs:label 'Industry Risk Class' ;
    rdfs:comment 'The risk classification based on the employers industry and occupation mix. Used in underwriting and premium rating. Low: office/professional. Moderate: light manufacturing/retail. High: construction/transportation. Hazardous: mining/heavy industrial.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumParticipationPercentage rdf:type rdf:Property ;
    rdfs:label 'Minimum Participation Percentage' ;
    rdfs:comment 'The minimum percentage of eligible employees that must enroll in the health plan for the group to qualify for coverage. Typically 75% for small groups. Used during initial underwriting and at renewal to prevent adverse selection.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:naicsCode rdf:type rdf:Property ;
    rdfs:label 'Naics Code' ;
    rdfs:comment 'The six-digit NAICS code that classifies the employers industry sector. NAICS has largely replaced SIC for statistical and regulatory purposes. Used for industry analysis, risk stratification, and regulatory reporting.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planSponsorType rdf:type rdf:Property ;
    rdfs:label 'Plan Sponsor Type' ;
    rdfs:comment 'The category of organization that sponsors the health plan. Private employer: for-profit or non-profit business. Union trust: labor union-sponsored plan. Government employer: federal, state, or local government entity. Association: group of small employers. Taft-Hartley: jointly trusteed union-management plan. MEWA: Multiple Employer Welfare Arrangement.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateGuaranteeMonths rdf:type rdf:Property ;
    rdfs:label 'Rate Guarantee Months' ;
    rdfs:comment 'The number of months for which the premium rates are guaranteed not to increase. Typically 12 months (annual rate guarantee) for most groups. Some large groups may negotiate multi-year rate guarantees.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sicCode rdf:type rdf:Property ;
    rdfs:label 'Sic Code' ;
    rdfs:comment 'The four-digit Standard Industrial Classification code that categorizes the employers primary line of business or industry. Used for risk assessment, underwriting, and industry benchmarking.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:situsStateCode rdf:type rdf:Property ;
    rdfs:label 'Situs State Code' ;
    rdfs:comment 'The state code that determines which state insurance regulations apply to this employer group. For fully insured plans, this is typically the state where the policy is issued. For self-funded ERISA plans, this may differ from the employers physical location. Format: two uppercase letters.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingTier rdf:type rdf:Property ;
    rdfs:label 'Underwriting Tier' ;
    rdfs:comment 'The risk classification assigned to this employer group during underwriting. Standard: average risk. Preferred: lower than average risk, may receive rate discounts. Substandard: higher than average risk, may have rate loadings or exclusions. Declined: group was not accepted for coverage.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wellnessProgramIndicator rdf:type rdf:Property ;
    rdfs:label 'Wellness Program Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this employer group has an active wellness or health promotion program integrated with their health plan. Wellness programs may include biometric screenings, health risk assessments, smoking cessation, weight management, and premium incentives.' ;
    rdfs:domain ind:EmployerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ageHigh rdf:type rdf:Property ;
    rdfs:label 'Age High' ;
    rdfs:comment 'The maximum patient age (in years) for which this ICD code is clinically appropriate. Used for coding validation and quality checks. Null if no maximum age restriction applies.' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageLow rdf:type rdf:Property ;
    rdfs:label 'Age Low' ;
    rdfs:comment 'The minimum patient age (in years) for which this ICD code is clinically appropriate. Used for coding validation and quality checks. Null if no minimum age restriction applies.' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:billableFlag rdf:type rdf:Property ;
    rdfs:label 'Billable Flag' ;
    rdfs:comment 'Indicates whether this ICD code is valid for billing and reimbursement purposes. Only billable codes may be submitted on claims to payers. Non-billable codes are typically higher-level category codes used for classification only.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ccFlag rdf:type rdf:Property ;
    rdfs:label 'Cc Flag' ;
    rdfs:comment 'Indicates whether this diagnosis code is classified as a Complication or Comorbidity (CC) for DRG assignment and severity adjustment purposes.' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chapter rdf:type rdf:Property ;
    rdfs:label 'Chapter' ;
    rdfs:comment 'The ICD-10 chapter to which this code belongs, representing the highest-level clinical category (e.g., Chapter 1: Certain infectious and parasitic diseases, Chapter 9: Diseases of the circulatory system).' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chapterCode rdf:type rdf:Property ;
    rdfs:label 'Chapter Code' ;
    rdfs:comment 'The alphanumeric range defining the chapter boundaries (e.g., A00-B99 for infectious diseases). Used for hierarchical grouping and reporting.' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeType rdf:type rdf:Property ;
    rdfs:label 'Code Type' ;
    rdfs:comment 'Indicates whether this code represents a diagnosis (ICD-10-CM) or a procedure (ICD-10-PCS).' ;
    rdfs:domain ind:Reference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:etiologyCodeFlag rdf:type rdf:Property ;
    rdfs:label 'Etiology Code Flag' ;
    rdfs:comment 'Indicates whether this code represents the underlying etiology or cause of a condition and should be sequenced before manifestation codes per ICD-10-CM coding conventions.' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:genderSpecificFlag rdf:type rdf:Property ;
    rdfs:label 'Gender Specific Flag' ;
    rdfs:comment 'Indicates whether this ICD code is applicable only to male patients, only to female patients, or to both. Used for clinical validation and coding accuracy.' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hacFlag rdf:type rdf:Property ;
    rdfs:label 'Hac Flag' ;
    rdfs:comment 'Indicates whether this diagnosis code represents a Hospital-Acquired Condition (HAC) as defined by CMS. HACs may result in payment penalties under the Hospital-Acquired Condition Reduction Program.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:icdCodeCategory rdf:type rdf:Property ;
    rdfs:label 'Icd Code Category' ;
    rdfs:comment 'The three-character category code representing a group of related conditions or procedures within a chapter (e.g., A01 for typhoid and paratyphoid fevers).' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icdCodeCode rdf:type rdf:Property ;
    rdfs:label 'Icd Code Code' ;
    rdfs:comment 'The full ICD-10-CM diagnosis code or ICD-10-PCS procedure code as published by WHO and maintained by CMS. Format follows alphanumeric pattern with optional decimal subdivision (e.g., A01.0, Z99.89).' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:longDescription rdf:type rdf:Property ;
    rdfs:label 'Long Description' ;
    rdfs:comment 'STRING' ;
    rdfs:domain ind:Reference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manifestationCodeFlag rdf:type rdf:Property ;
    rdfs:label 'Manifestation Code Flag' ;
    rdfs:comment 'Indicates whether this code represents a manifestation of an underlying disease and must be sequenced after the underlying condition code per ICD-10-CM coding conventions.' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mccFlag rdf:type rdf:Property ;
    rdfs:label 'Mcc Flag' ;
    rdfs:comment 'Indicates whether this diagnosis code is classified as a Major Complication or Comorbidity (MCC) for DRG assignment and severity adjustment purposes. MCCs have greater impact on reimbursement than standard CCs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentCode rdf:type rdf:Property ;
    rdfs:label 'Parent Code' ;
    rdfs:comment 'The immediate parent code in the ICD-10 hierarchy, enabling hierarchical rollup and drill-down navigation for reporting and analytics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poaExemptFlag rdf:type rdf:Property ;
    rdfs:label 'Poa Exempt Flag' ;
    rdfs:comment 'Indicates whether this diagnosis code is exempt from the CMS Present on Admission (POA) reporting requirement for inpatient claims. POA-exempt codes do not require a POA indicator on UB-04 claims.' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:replacementCode rdf:type rdf:Property ;
    rdfs:label 'Replacement Code' ;
    rdfs:comment 'The ICD code that replaces this code if the code has been retired or superseded. Used for code mapping and historical claims reprocessing.' ;
    rdfs:domain ind:Reference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortDescription rdf:type rdf:Property ;
    rdfs:label 'Short Description' ;
    rdfs:comment 'Abbreviated clinical description of the diagnosis or procedure code, typically used in constrained display contexts such as billing forms and summary reports.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snomedCtMapping rdf:type rdf:Property ;
    rdfs:label 'Snomed Ct Mapping' ;
    rdfs:comment 'The corresponding SNOMED CT concept identifier(s) mapped to this ICD code, enabling interoperability with clinical terminology systems and EHR platforms.' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unacceptablePrincipalDxFlag rdf:type rdf:Property ;
    rdfs:label 'Unacceptable Principal Dx Flag' ;
    rdfs:comment 'Indicates whether this diagnosis code is prohibited from being used as the principal diagnosis on an inpatient claim per CMS coding guidelines.' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:validForCodingFlag rdf:type rdf:Property ;
    rdfs:label 'Valid For Coding Flag' ;
    rdfs:comment 'Indicates whether this code is valid for use in clinical documentation and coding. Codes may be invalid due to retirement, replacement, or administrative reasons.' ;
    rdfs:domain ind:IcdCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ageRangeHigh rdf:type rdf:Property ;
    rdfs:label 'Age Range High' ;
    rdfs:comment 'Maximum patient age (in years) for which the CPT code is clinically appropriate. Null if no upper age restriction applies. Used for claims editing and clinical decision support.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageRangeLow rdf:type rdf:Property ;
    rdfs:label 'Age Range Low' ;
    rdfs:comment 'Minimum patient age (in years) for which the CPT code is clinically appropriate. Null if no lower age restriction applies. Used for claims editing and clinical decision support.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clinicalFamily rdf:type rdf:Property ;
    rdfs:label 'Clinical Family' ;
    rdfs:comment 'Grouping of clinically related CPT codes, such as all codes for a specific type of surgery or diagnostic test. Used for clinical pathway design, order sets, and utilization management.' ;
    rdfs:domain ind:Reference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cptCode rdf:type rdf:Property ;
    rdfs:label 'Cpt Code' ;
    rdfs:comment 'Five-digit numeric code published by the American Medical Association (AMA) that identifies medical, surgical, and diagnostic services. This is the authoritative business identifier used on CMS-1500 claims, in CPOE systems, and for professional billing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cptCodeCategory rdf:type rdf:Property ;
    rdfs:label 'Cpt Code Category' ;
    rdfs:comment 'Classification of the CPT code. Category I codes describe established procedures and services. Category II codes are supplemental tracking codes for performance measurement. Category III codes are temporary codes for emerging technology, services, and procedures.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cptCodeStatus rdf:type rdf:Property ;
    rdfs:label 'Cpt Code Status' ;
    rdfs:comment 'Current lifecycle status of the CPT code. Active codes are valid for billing. Inactive codes have been retired but retained for historical claims. Deleted codes are no longer recognized. Pending codes are scheduled for future activation.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Facility Indicator' ;
    rdfs:comment 'Indicates whether the CPT code is typically performed in a facility setting (hospital, ASC) or non-facility setting (physician office). Affects practice expense RVU calculation.' ;
    rdfs:domain ind:Reference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fullDescriptor rdf:type rdf:Property ;
    rdfs:label 'Full Descriptor' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderSpecific rdf:type rdf:Property ;
    rdfs:label 'Gender Specific' ;
    rdfs:comment 'Indicates whether the procedure is anatomically or clinically specific to male or female patients. Used for claims editing and clinical decision support.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:globalPeriod rdf:type rdf:Property ;
    rdfs:label 'Global Period' ;
    rdfs:comment 'Number of days of post-operative care included in the procedure payment. 000 = endoscopic or minor procedure with 0-day follow-up. 010 = minor procedure with 10-day follow-up. 090 = major surgery with 90-day follow-up. XXX = global concept does not apply. YYY = carrier determines global period. ZZZ = add-on code. MMM = maternity codes with global period. [ENUM-REF-CANDIDATE: 000|010|090|XXX|YYY|ZZZ|MMM — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Reference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:malpracticeRvu rdf:type rdf:Property ;
    rdfs:label 'Malpractice Rvu' ;
    rdfs:comment 'Relative Value Unit representing the professional liability insurance component. Reflects the relative risk and cost of malpractice insurance for the service.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicallyUnlikelyEditValue rdf:type rdf:Property ;
    rdfs:label 'Medically Unlikely Edit Value' ;
    rdfs:comment 'Maximum number of units of service that CMS considers medically reasonable for a single patient on a single date of service. Used for claims editing and fraud detection.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modifierIndicator rdf:type rdf:Property ;
    rdfs:label 'Modifier Indicator' ;
    rdfs:comment 'Indicates whether bilateral surgery, assistant surgeon, or co-surgeon modifiers are applicable. 0 = not subject to modifier rules. 1 = bilateral surgery applies. 2 = assistant surgeon may not be paid. 3 = assistant surgeon and co-surgeon rules apply. 9 = concept does not apply.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:multipleProcedureIndicator rdf:type rdf:Property ;
    rdfs:label 'Multiple Procedure Indicator' ;
    rdfs:comment 'Indicates payment adjustment rules when multiple procedures are performed in the same session. 0 = no payment adjustment. 1 = standard payment adjustment applies. 2 = bilateral adjustment applies. 3 = assistant surgeon adjustment. 4 = diagnostic imaging adjustment. 5 = therapy adjustment. 9 = concept does not apply. [ENUM-REF-CANDIDATE: 0|1|2|3|4|5|9 — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Reference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nationalPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'National Payment Amount' ;
    rdfs:comment 'National average Medicare payment amount for the CPT code, calculated as total RVU multiplied by the conversion factor. Actual payment varies by geographic locality. Used for budgeting and benchmarking.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ncciEditIndicator rdf:type rdf:Property ;
    rdfs:label 'Ncci Edit Indicator' ;
    rdfs:comment 'Indicates whether this CPT code is subject to National Correct Coding Initiative edits, which prevent inappropriate code combinations from being billed together. Used for claims scrubbing and compliance.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:physicianSupervisionRequired rdf:type rdf:Property ;
    rdfs:label 'Physician Supervision Required' ;
    rdfs:comment 'Level of physician supervision required for the service to be billable. Direct = physician must be present in the room. General = physician must be immediately available. Personal = physician must perform the service. None = no supervision required.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placeOfServiceRestriction rdf:type rdf:Property ;
    rdfs:label 'Place Of Service Restriction' ;
    rdfs:comment 'Comma-separated list of valid CMS Place of Service codes where this CPT code may be performed and billed. Used for claims editing and compliance validation.' ;
    rdfs:domain ind:Reference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceExpenseRvu rdf:type rdf:Property ;
    rdfs:label 'Practice Expense Rvu' ;
    rdfs:comment 'Relative Value Unit representing the practice expense component, including clinical staff, medical supplies, and equipment costs. Varies by facility vs non-facility setting.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:section rdf:type rdf:Property ;
    rdfs:label 'Section' ;
    rdfs:comment 'High-level section of the CPT code set to which this code belongs, such as Evaluation and Management, Anesthesia, Surgery, Radiology, Pathology and Laboratory, or Medicine. Used for reporting and analytics grouping.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortDescriptor rdf:type rdf:Property ;
    rdfs:label 'Short Descriptor' ;
    rdfs:comment 'Abbreviated description of the procedure or service, typically 28 characters or fewer, used in billing systems and charge capture interfaces for space-constrained displays.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subsection rdf:type rdf:Property ;
    rdfs:label 'Subsection' ;
    rdfs:comment 'Subsection within the CPT section, providing more granular classification such as Digestive System, Cardiovascular System, or Office Visits. Used for clinical analytics and charge capture workflows.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telemedicineEligible rdf:type rdf:Property ;
    rdfs:label 'Telemedicine Eligible' ;
    rdfs:comment 'Indicates whether the service can be delivered via telemedicine or telehealth platforms and remain eligible for reimbursement. Updated based on CMS and payer policies.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalRvu rdf:type rdf:Property ;
    rdfs:label 'Total Rvu' ;
    rdfs:comment 'Sum of work RVU, practice expense RVU, and malpractice RVU. Used to calculate Medicare reimbursement and benchmark physician productivity.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workRvu rdf:type rdf:Property ;
    rdfs:label 'Work Rvu' ;
    rdfs:comment 'Relative Value Unit representing the physician work component, including time, technical skill, physical effort, mental effort, and judgment required to perform the service. Used in MIPS reporting and physician compensation models.' ;
    rdfs:domain ind:CptCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ageRestriction rdf:type rdf:Property ;
    rdfs:label 'Age Restriction' ;
    rdfs:comment 'Indicates any age-based coverage restrictions for this HCPCS code (e.g., pediatric only, adult only, age 65+). Defines patient age eligibility criteria.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ascPaymentIndicator rdf:type rdf:Property ;
    rdfs:label 'Asc Payment Indicator' ;
    rdfs:comment 'Indicates the payment methodology for this HCPCS code when performed in an Ambulatory Surgical Center setting. Defines whether the code is separately payable, bundled, or excluded from ASC payment.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assistantSurgeonIndicator rdf:type rdf:Property ;
    rdfs:label 'Assistant Surgeon Indicator' ;
    rdfs:comment 'Indicates whether an assistant surgeon is allowed for this HCPCS code and the applicable payment percentage for assistant surgeon services.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bilateralSurgeryIndicator rdf:type rdf:Property ;
    rdfs:label 'Bilateral Surgery Indicator' ;
    rdfs:comment 'Indicates whether this HCPCS code is eligible for bilateral surgery payment adjustment when performed on both sides of the body during the same operative session.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coSurgeonIndicator rdf:type rdf:Property ;
    rdfs:label 'Co Surgeon Indicator' ;
    rdfs:comment 'Indicates whether co-surgeons are allowed for this HCPCS code, where two surgeons perform distinct portions of a complex procedure.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Coverage Indicator' ;
    rdfs:comment 'Indicates whether the HCPCS code is covered by Medicare: covered codes are reimbursable, not_covered codes are excluded, carrier_discretion allows local Medicare Administrative Contractor (MAC) determination, bundled codes are included in other services, conditional codes require specific clinical criteria.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisRequirementIndicator rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Requirement Indicator' ;
    rdfs:comment 'Indicates whether this HCPCS code requires specific ICD-10 diagnosis codes for coverage. True if diagnosis-based medical necessity criteria apply, false otherwise.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dmeIndicator rdf:type rdf:Property ;
    rdfs:label 'Dme Indicator' ;
    rdfs:comment 'Indicates whether this HCPCS code represents durable medical equipment as defined by Medicare. True for DME items (typically E-codes), false for other categories.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drugIndicator rdf:type rdf:Property ;
    rdfs:label 'Drug Indicator' ;
    rdfs:comment 'Indicates whether this HCPCS code represents a pharmaceutical drug or biological product (typically J-codes). True for drug codes, false for equipment, supplies, and services.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hcpcsCodeCategory rdf:type rdf:Property ;
    rdfs:label 'Hcpcs Code Category' ;
    rdfs:comment 'The major category of the HCPCS code based on the first letter: A=Transportation/Medical Supplies, B=Enteral/Parenteral, C=Outpatient PPS, D=Dental, E=DME, G=Temporary Procedures, H=Alcohol/Drug, J=Drugs, K=Temporary Codes, L=Orthotics/Prosthetics, M=Medical Services, P=Pathology/Lab, Q=Temporary Codes, R=Diagnostic Radiology, S=Private Payer, T=State Medicaid, V=Vision/Hearing. [ENUM-REF-CANDIDATE: A|B|C|D|E|G|H|J|K|L|M|P|Q|R|S|T|V — 17 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hcpcsCodeCode rdf:type rdf:Property ;
    rdfs:label 'Hcpcs Code Code' ;
    rdfs:comment 'The five-character alphanumeric HCPCS Level II code (e.g., E0601, J1234). First character is always a letter (A-V), followed by four digits. Used to identify durable medical equipment, prosthetics, orthotics, supplies, drugs, and non-physician services.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intraoperativePercentage rdf:type rdf:Property ;
    rdfs:label 'Intraoperative Percentage' ;
    rdfs:comment 'The percentage of the total payment allocated to intraoperative services for this HCPCS code within the global surgical package.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifierRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Modifier Required Indicator' ;
    rdfs:comment 'Indicates whether a modifier is required when billing this HCPCS code. True if a modifier is mandatory for proper claims adjudication, false otherwise.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ndcCrosswalkIndicator rdf:type rdf:Property ;
    rdfs:label 'Ndc Crosswalk Indicator' ;
    rdfs:comment 'Indicates whether this HCPCS code has an associated NDC crosswalk mapping. True for drug codes that map to specific NDC products, false otherwise.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oppsPaymentIndicator rdf:type rdf:Property ;
    rdfs:label 'Opps Payment Indicator' ;
    rdfs:comment 'Indicates the payment status for this HCPCS code under the Hospital Outpatient Prospective Payment System. Defines whether the code is separately payable, packaged, or excluded from OPPS payment.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postoperativePercentage rdf:type rdf:Property ;
    rdfs:label 'Postoperative Percentage' ;
    rdfs:comment 'The percentage of the total payment allocated to postoperative services for this HCPCS code within the global surgical package.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preoperativePercentage rdf:type rdf:Property ;
    rdfs:label 'Preoperative Percentage' ;
    rdfs:comment 'The percentage of the total payment allocated to preoperative services for this HCPCS code within the global surgical package.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pricingIndicator rdf:type rdf:Property ;
    rdfs:label 'Pricing Indicator' ;
    rdfs:comment 'Indicates the pricing methodology for the HCPCS code: fee_schedule uses CMS published rates, asc uses Ambulatory Surgical Center payment, reasonable_charge uses historical pricing, not_priced has no established rate, contractor_priced is determined by local MAC.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthorizationIndicator rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Indicator' ;
    rdfs:comment 'Indicates whether this HCPCS code requires prior authorization from the payer before services can be rendered. True if pre-approval is required, false otherwise.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:professionalComponentIndicator rdf:type rdf:Property ;
    rdfs:label 'Professional Component Indicator' ;
    rdfs:comment 'Indicates whether this HCPCS code has separate professional and technical components (e.g., for radiology and pathology services). Defines billing options for split or global billing.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByCode rdf:type rdf:Property ;
    rdfs:label 'Superseded By Code' ;
    rdfs:comment 'The HCPCS code that replaces this code if it has been superseded or deleted. Null for active codes that have not been replaced.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamSurgeryIndicator rdf:type rdf:Property ;
    rdfs:label 'Team Surgery Indicator' ;
    rdfs:comment 'Indicates whether team surgery is allowed for this HCPCS code, where multiple surgeons of different specialties are medically necessary.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicalComponentIndicator rdf:type rdf:Property ;
    rdfs:label 'Technical Component Indicator' ;
    rdfs:comment 'Indicates whether this HCPCS code includes a technical component representing facility resources, equipment, and supplies.' ;
    rdfs:domain ind:HcpcsCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:majorDiagnosticCategoryId rdf:type rdf:Property ;
    rdfs:label 'Major Diagnostic Category Id' ;
    rdfs:comment 'Foreign key reference to the parent Major Diagnostic Category under which this DRG is classified.' ;
    rdfs:domain ind:Reference ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MajorDiagnosticCategory .

ind:arithmeticMeanLos rdf:type rdf:Property ;
    rdfs:label 'Arithmetic Mean Los' ;
    rdfs:comment 'The arithmetic mean (average) length of stay in days for cases in this DRG. Used for benchmarking and operational performance analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bundledPaymentFlag rdf:type rdf:Property ;
    rdfs:label 'Bundled Payment Flag' ;
    rdfs:comment 'Indicates whether this DRG is included in bundled payment initiatives such as the Bundled Payments for Care Improvement (BPCI) program or Comprehensive Care for Joint Replacement (CJR) model.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complicationLevel rdf:type rdf:Property ;
    rdfs:label 'Complication Level' ;
    rdfs:comment 'Indicates the severity level of complications or comorbidities included in this DRG definition: without CC/MCC, with CC (moderate complications), or with MCC (major complications). Drives relative weight differentiation.' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costOutlierThreshold rdf:type rdf:Property ;
    rdfs:label 'Cost Outlier Threshold' ;
    rdfs:comment 'The dollar threshold above which a case qualifies for additional outlier payment. Calculated as: (DRG payment × fixed loss ratio) + fixed loss amount.' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drgCode rdf:type rdf:Property ;
    rdfs:label 'Drg Code' ;
    rdfs:comment 'The official numeric code assigned to this DRG by the grouper system (e.g., 470, 871). Used as the business identifier for reimbursement and case mix reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgDescription rdf:type rdf:Property ;
    rdfs:label 'Drg Description' ;
    rdfs:comment 'Extended narrative description of the DRG, including clinical context, typical procedures, and coding guidance. Used for clinical documentation improvement (CDI) and coder education.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgType rdf:type rdf:Property ;
    rdfs:label 'Drg Type' ;
    rdfs:comment 'Classification of the DRG as medical (non-surgical), surgical, or procedure-based. Used for service line segmentation and resource planning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geometricMeanLos rdf:type rdf:Property ;
    rdfs:label 'Geometric Mean Los' ;
    rdfs:comment 'The geometric mean length of stay in days for cases in this DRG, calculated from national claims data. Used as the threshold for identifying outlier cases and calculating outlier payments.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grouperSystem rdf:type rdf:Property ;
    rdfs:label 'Grouper System' ;
    rdfs:comment 'The DRG grouper classification system under which this DRG is defined: MS-DRG (Medicare Severity), AP-DRG (All Patient), APR-DRG (All Patient Refined), or IR-DRG (International Refined).' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nationalAverageCharges rdf:type rdf:Property ;
    rdfs:label 'National Average Charges' ;
    rdfs:comment 'The national average total charges (not payments) for cases in this DRG. Used for charge benchmarking and cost-to-charge ratio analysis.' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nationalAveragePayment rdf:type rdf:Property ;
    rdfs:label 'National Average Payment' ;
    rdfs:comment 'The national average Medicare payment amount for this DRG, calculated as: national base rate × relative weight. Used for benchmarking and financial forecasting.' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nationalCaseVolume rdf:type rdf:Property ;
    rdfs:label 'National Case Volume' ;
    rdfs:comment 'The total number of Medicare cases nationally that grouped to this DRG in the most recent fiscal year. Used for prevalence analysis and market sizing.' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operatingRoomProcedureFlag rdf:type rdf:Property ;
    rdfs:label 'Operating Room Procedure Flag' ;
    rdfs:comment 'Indicates whether this DRG is classified as an OR procedure DRG, which affects payment and resource allocation.' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postAcuteTransferFlag rdf:type rdf:Property ;
    rdfs:label 'Post Acute Transfer Flag' ;
    rdfs:comment 'Indicates whether this DRG is subject to the post-acute care transfer policy, which adjusts payment when a patient is discharged to a post-acute care setting (SNF, IRF, LTCH, HHA) before the geometric mean LOS.' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:principalDiagnosisRangeEnd rdf:type rdf:Property ;
    rdfs:label 'Principal Diagnosis Range End' ;
    rdfs:comment 'The ending ICD-10-CM diagnosis code in the range of principal diagnoses that can group to this DRG.' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:principalDiagnosisRangeStart rdf:type rdf:Property ;
    rdfs:label 'Principal Diagnosis Range Start' ;
    rdfs:comment 'The starting ICD-10-CM diagnosis code in the range of principal diagnoses that can group to this DRG. Used for grouper logic validation and clinical documentation improvement.' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Procedure Requirement Flag' ;
    rdfs:comment 'Indicates whether this DRG requires the presence of a specific ICD-10-PCS procedure code to group (true for surgical DRGs, false for medical DRGs).' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMeasureFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Flag' ;
    rdfs:comment 'Indicates whether this DRG is associated with specific quality measures under the Hospital Value-Based Purchasing (VBP) or Hospital-Acquired Condition (HAC) Reduction Programs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:readmissionPenaltyFlag rdf:type rdf:Property ;
    rdfs:label 'Readmission Penalty Flag' ;
    rdfs:comment 'Indicates whether this DRG is included in the Hospital Readmissions Reduction Program (HRRP) and subject to payment penalties for excess readmissions.' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relativeWeight rdf:type rdf:Property ;
    rdfs:label 'Relative Weight' ;
    rdfs:comment 'The DRG relative weight representing the average resource intensity for cases in this DRG compared to the national average (1.0000). Used to calculate expected reimbursement: base rate × relative weight.' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specialPayFlag rdf:type rdf:Property ;
    rdfs:label 'Special Pay Flag' ;
    rdfs:comment 'Indicates whether this DRG has special payment rules or adjustments (e.g., new technology add-on payments, device-intensive procedures).' ;
    rdfs:domain ind:Drg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:snomedConceptId rdf:type rdf:Property ;
    rdfs:label 'Snomed Concept Id' ;
    rdfs:comment 'Unique identifier for the SNOMED CT concept as assigned by SNOMED International. This is the primary key and corresponds to the SCTID (SNOMED CT Identifier) in the SNOMED CT release files.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SnomedConcept .

ind:parentConceptSnomedConceptId rdf:type rdf:Property ;
    rdfs:label 'Parent Concept Snomed Concept Id' ;
    rdfs:comment 'Identifier of the immediate parent concept in the SNOMED CT IS-A hierarchy. Used to navigate the taxonomy and determine subsumption relationships. A concept may have multiple parents in a polyhierarchy.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SnomedConcept .

ind:clinicalDocumentationSection rdf:type rdf:Property ;
    rdfs:label 'Clinical Documentation Section' ;
    rdfs:comment 'The typical section(s) of clinical documentation where this concept is used (e.g., Problem List, Allergies, Past Medical History, Assessment, Plan, Procedures). Supports context-aware search and documentation templates.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conceptClass rdf:type rdf:Property ;
    rdfs:label 'Concept Class' ;
    rdfs:comment 'Additional classification of the concept beyond the semantic tag, used for grouping and filtering (e.g., diagnosis, symptom, surgical procedure, medication, laboratory test). May be derived from semantic tag or additional metadata.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conceptDefinition rdf:type rdf:Property ;
    rdfs:label 'Concept Definition' ;
    rdfs:comment 'A formal textual definition of the concept providing clinical context and meaning. May be sourced from SNOMED International or supplemented with organizational definitions for clarity.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conceptStatus rdf:type rdf:Property ;
    rdfs:label 'Concept Status' ;
    rdfs:comment 'Current lifecycle status of the SNOMED CT concept. Active concepts are available for use in clinical documentation; inactive concepts are deprecated and should not be used for new entries but may appear in historical data.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cptMapTarget rdf:type rdf:Property ;
    rdfs:label 'Cpt Map Target' ;
    rdfs:comment 'The CPT code(s) to which this SNOMED CT procedure concept is mapped, if applicable. Supports billing and revenue cycle management by linking clinical procedures to reimbursable CPT codes.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:definitionStatus rdf:type rdf:Property ;
    rdfs:label 'Definition Status' ;
    rdfs:comment 'Indicates whether the concept is primitive (defined only by its stated relationships) or fully defined (sufficient conditions provided for automated classification). Fully defined concepts can be automatically classified by description logic reasoners.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveTime rdf:type rdf:Property ;
    rdfs:label 'Effective Time' ;
    rdfs:comment 'The date on which this version of the concept became effective in the SNOMED CT release. Represents the snapshot date of the concept state in the release cycle (typically in YYYYMMDD format in source, stored as DATE).' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fhirValueSetMembership rdf:type rdf:Property ;
    rdfs:label 'Fhir Value Set Membership' ;
    rdfs:comment 'Comma-separated list of FHIR value set identifiers (URIs) to which this concept belongs. Used to support FHIR-based interoperability and constrain coded elements in FHIR resources.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fullySpecifiedName rdf:type rdf:Property ;
    rdfs:label 'Fully Specified Name' ;
    rdfs:comment 'The complete, unambiguous name of the SNOMED CT concept including the semantic tag in parentheses (e.g., Pneumonia (disorder)). The FSN uniquely identifies the concept and includes the semantic category to distinguish homonyms.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Level' ;
    rdfs:comment 'The depth of this concept in the SNOMED CT hierarchy, with the root concept at level 0. Used for hierarchy traversal, rollup queries, and determining concept granularity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10MapCorrelation rdf:type rdf:Property ;
    rdfs:label 'Icd10 Map Correlation' ;
    rdfs:comment 'The correlation type between the SNOMED CT concept and the ICD-10 map target, indicating the semantic equivalence of the mapping (e.g., exact match, SNOMED concept is narrower than ICD-10 code, SNOMED concept is broader, partial overlap, or not mappable).' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10MapTarget rdf:type rdf:Property ;
    rdfs:label 'Icd10 Map Target' ;
    rdfs:comment 'The ICD-10 code(s) to which this SNOMED CT concept is mapped, if applicable. Supports billing, reporting, and interoperability with systems that use ICD-10 for diagnosis coding. Multiple codes may be pipe-separated.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEhrPreferred rdf:type rdf:Property ;
    rdfs:label 'Is Ehr Preferred' ;
    rdfs:comment 'Boolean flag indicating whether this concept is designated as a preferred term for use in the organizations EHR system. Preferred concepts are promoted in search results and pick lists to standardize documentation.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLeafConcept rdf:type rdf:Property ;
    rdfs:label 'Is Leaf Concept' ;
    rdfs:comment 'Boolean flag indicating whether this concept is a leaf node in the hierarchy (has no child concepts). Leaf concepts represent the most granular clinical terms available.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimitive rdf:type rdf:Property ;
    rdfs:label 'Is Primitive' ;
    rdfs:comment 'Boolean flag indicating whether the concept is primitive (true) or fully defined (false). Primitive concepts require manual classification; fully defined concepts can be automatically classified by reasoners.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReportable rdf:type rdf:Property ;
    rdfs:label 'Is Reportable' ;
    rdfs:comment 'Boolean flag indicating whether this concept represents a condition that must be reported to public health authorities (e.g., notifiable diseases, healthcare-associated infections). Used to trigger automated reporting workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastUsedDate rdf:type rdf:Property ;
    rdfs:label 'Last Used Date' ;
    rdfs:comment 'The most recent date on which this concept was used in clinical documentation within the organization. Used to identify obsolete or rarely used concepts for potential retirement or training needs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:loincMapTarget rdf:type rdf:Property ;
    rdfs:label 'Loinc Map Target' ;
    rdfs:comment 'The LOINC code(s) to which this SNOMED CT concept is mapped, if applicable. Used for laboratory and clinical observations to support interoperability with laboratory information systems and FHIR resources.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moduleCode rdf:type rdf:Property ;
    rdfs:label 'Module Code' ;
    rdfs:comment 'Identifier of the SNOMED CT module (namespace) to which this concept belongs. Modules represent different editions or extensions (e.g., International Edition, US Edition, UK Edition) and control versioning and governance.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patientFriendlyTerm rdf:type rdf:Property ;
    rdfs:label 'Patient Friendly Term' ;
    rdfs:comment 'A simplified, patient-friendly description of the concept for use in patient portals, after-visit summaries, and patient education materials. Avoids medical jargon and uses plain language.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredTerm rdf:type rdf:Property ;
    rdfs:label 'Preferred Term' ;
    rdfs:comment 'The preferred human-readable term for the concept in the default language (typically English). This is the term most commonly used in clinical documentation and user interfaces, without the semantic tag.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityMeasureInclusion rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Inclusion' ;
    rdfs:comment 'Comma-separated list of quality measure identifiers (e.g., HEDIS, CMS, MIPS) for which this concept is included in the numerator, denominator, or exclusion criteria. Supports automated quality reporting and value-based care programs.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipCount rdf:type rdf:Property ;
    rdfs:label 'Relationship Count' ;
    rdfs:comment 'The total number of active relationships (both stated and inferred) associated with this concept. Relationships define the concepts meaning and position in the ontology.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rxnormMapTarget rdf:type rdf:Property ;
    rdfs:label 'Rxnorm Map Target' ;
    rdfs:comment 'The RxNorm code(s) to which this SNOMED CT pharmaceutical/biologic product concept is mapped, if applicable. Enables medication interoperability and e-prescribing by linking to the NLM RxNorm drug terminology.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:semanticTag rdf:type rdf:Property ;
    rdfs:label 'Semantic Tag' ;
    rdfs:comment 'The high-level semantic category of the concept extracted from the FSN (e.g., disorder, procedure, finding, body structure, substance, organism). Used to classify concepts into broad clinical domains.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyRelevance rdf:type rdf:Property ;
    rdfs:label 'Specialty Relevance' ;
    rdfs:comment 'Comma-separated list of medical specialties for which this concept is particularly relevant (e.g., Cardiology, Oncology, Pediatrics, Emergency Medicine). Used to customize pick lists and search results by provider specialty.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:synonymCount rdf:type rdf:Property ;
    rdfs:label 'Synonym Count' ;
    rdfs:comment 'The number of active synonym descriptions associated with this concept. Synonyms provide alternative terms for the same concept to support varied clinical documentation styles and search.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:topLevelHierarchy rdf:type rdf:Property ;
    rdfs:label 'Top Level Hierarchy' ;
    rdfs:comment 'The top-level SNOMED CT hierarchy to which this concept belongs (e.g., Clinical Finding, Procedure, Body Structure, Pharmaceutical / Biologic Product, Organism, Substance, Physical Object, Qualifier Value, Observable Entity, Situation, Event, Environment, Social Context, Staging and Scales, Linkage Concept, Special Concept, Navigational Concept, Record Artifact). Derived from the root ancestor in the IS-A hierarchy.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageFrequencyRank rdf:type rdf:Property ;
    rdfs:label 'Usage Frequency Rank' ;
    rdfs:comment 'Rank of this concept based on usage frequency in clinical documentation within the organization. Lower numbers indicate higher usage. Used to prioritize search results and optimize user interfaces.' ;
    rdfs:domain ind:SnomedConcept ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:loincCodeId rdf:type rdf:Property ;
    rdfs:label 'Loinc Code Id' ;
    rdfs:comment 'Unique identifier for the LOINC code record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LoincCode .

ind:class rdf:type rdf:Property ;
    rdfs:label 'Class' ;
    rdfs:comment 'The high-level category or domain of the observation (e.g., CHEM=Chemistry, HEM/BC=Hematology/Blood Count, MICRO=Microbiology, RAD=Radiology, VITALS=Vital Signs).' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:component rdf:type rdf:Property ;
    rdfs:label 'Component' ;
    rdfs:comment 'The substance or entity being measured or observed (e.g., Glucose, Hemoglobin, Creatinine). This is the analyte, the target of the measurement.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consumerName rdf:type rdf:Property ;
    rdfs:label 'Consumer Name' ;
    rdfs:comment 'A patient-friendly, lay-language name for the observation or test, used in patient portals and consumer-facing applications.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deprecatedDate rdf:type rdf:Property ;
    rdfs:label 'Deprecated Date' ;
    rdfs:comment 'The date when this LOINC code was deprecated or retired. Null if the code is still active.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exampleUcumUnits rdf:type rdf:Property ;
    rdfs:label 'Example Ucum Units' ;
    rdfs:comment 'The standardized UCUM representation of the example units. Used for interoperability and unit conversion.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exampleUnits rdf:type rdf:Property ;
    rdfs:label 'Example Units' ;
    rdfs:comment 'Common units of measure for this observation (e.g., mg/dL, mmol/L, %). Provides guidance for result reporting.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalCopyrightNotice rdf:type rdf:Property ;
    rdfs:label 'External Copyright Notice' ;
    rdfs:comment 'Copyright or licensing information for LOINC codes that incorporate third-party content (e.g., SNOMED CT, CPT). Required for compliance with external terminology licenses.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hl7FieldSubfieldCode rdf:type rdf:Property ;
    rdfs:label 'Hl7 Field Subfield Code' ;
    rdfs:comment 'The HL7 v2.x message field identifier where this LOINC code is typically used (e.g., OBX-3 for observation identifier). Supports HL7 message mapping.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hl7V3CodeSystemOid rdf:type rdf:Property ;
    rdfs:label 'Hl7 V3 Code System Oid' ;
    rdfs:comment 'The HL7 v3 object identifier for the LOINC code system (typically 2.16.840.1.113883.6.1). Used in CDA documents and HL7 v3 messages.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:localCode rdf:type rdf:Property ;
    rdfs:label 'Local Code' ;
    rdfs:comment 'Organization-specific internal code or identifier mapped to this LOINC code. Used for legacy system integration and local terminology management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loincNumber rdf:type rdf:Property ;
    rdfs:label 'Loinc Number' ;
    rdfs:comment 'The unique LOINC code identifier assigned by Regenstrief Institute. Format: numeric-numeric (e.g., 2345-7). This is the authoritative external identifier for the observation or test.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:longCommonName rdf:type rdf:Property ;
    rdfs:label 'Long Common Name' ;
    rdfs:comment 'The full, human-readable display name for the LOINC code. This is the primary display term used in clinical systems and reports.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderObservationFlag rdf:type rdf:Property ;
    rdfs:label 'Order Observation Flag' ;
    rdfs:comment 'Indicates whether this LOINC code is used for ordering tests, recording observations, or both. Order=orderable panel or test, Observation=result only, Both=can be used for ordering and results.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:panelType rdf:type rdf:Property ;
    rdfs:label 'Panel Type' ;
    rdfs:comment 'Indicates if this LOINC code represents a panel (group of related tests), battery (predefined test group), or set (collection of observations). Null for individual observations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:property rdf:type rdf:Property ;
    rdfs:label 'Property' ;
    rdfs:comment 'The characteristic or attribute of the analyte being measured (e.g., Mass Concentration, Substance Concentration, Presence, Volume).' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedNames rdf:type rdf:Property ;
    rdfs:label 'Related Names' ;
    rdfs:comment 'Synonyms, alternate names, or legacy names for this observation. Supports search and mapping from legacy systems.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scaleType rdf:type rdf:Property ;
    rdfs:label 'Scale Type' ;
    rdfs:comment 'The scale of measurement for the observation result. Qn=Quantitative (numeric), Ord=Ordinal (ranked), Nom=Nominal (named categories), Nar=Narrative (free text), Doc=Document (attached file).' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyQuestionSource rdf:type rdf:Property ;
    rdfs:label 'Survey Question Source' ;
    rdfs:comment 'The source instrument or questionnaire from which the survey question originates (e.g., PHQ-9, PROMIS, CAHPS).' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyQuestionText rdf:type rdf:Property ;
    rdfs:label 'Survey Question Text' ;
    rdfs:comment 'For LOINC codes representing survey or assessment questions, this field contains the full question text as presented to the patient or clinician.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:system rdf:type rdf:Property ;
    rdfs:label 'System' ;
    rdfs:comment 'The specimen or body system from which the observation was made (e.g., Blood, Serum, Urine, Plasma, Cerebrospinal fluid).' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeAspect rdf:type rdf:Property ;
    rdfs:label 'Time Aspect' ;
    rdfs:comment 'The time dimension of the measurement (e.g., Point in time, 24 hour, 8 hour). Indicates whether the observation is a single point measurement or collected over a time interval.' ;
    rdfs:domain ind:LoincCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activeIngredient rdf:type rdf:Property ;
    rdfs:label 'Active Ingredient' ;
    rdfs:comment 'The chemical substance or compound responsible for the therapeutic effect of the drug.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationNumber rdf:type rdf:Property ;
    rdfs:label 'Application Number' ;
    rdfs:comment 'The FDA application number associated with the drug approval (e.g., NDA number, ANDA number, BLA number).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:atcCode rdf:type rdf:Property ;
    rdfs:label 'Atc Code' ;
    rdfs:comment 'The WHO Anatomical Therapeutic Chemical classification code, used internationally for drug classification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biosimilarFlag rdf:type rdf:Property ;
    rdfs:label 'Biosimilar Flag' ;
    rdfs:comment 'Indicates whether the drug is a biosimilar product, highly similar to an already-approved biological product.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:blackBoxWarningFlag rdf:type rdf:Property ;
    rdfs:label 'Black Box Warning Flag' ;
    rdfs:comment 'Indicates whether the drug carries an FDA black box warning, the strictest warning for serious or life-threatening risks.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deaSchedule rdf:type rdf:Property ;
    rdfs:label 'Dea Schedule' ;
    rdfs:comment 'The controlled substance schedule classification assigned by the DEA (CI through CV), indicating the drugs potential for abuse and accepted medical use. Empty if not a controlled substance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dosageForm rdf:type rdf:Property ;
    rdfs:label 'Dosage Form' ;
    rdfs:comment 'The physical form in which the drug is administered (e.g., tablet, capsule, injection, solution, cream, inhaler).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirMedicationCode rdf:type rdf:Property ;
    rdfs:label 'Fhir Medication Code' ;
    rdfs:comment 'The standardized medication code used in FHIR MedicationRequest and Medication resources for interoperability.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formularyStatus rdf:type rdf:Property ;
    rdfs:label 'Formulary Status' ;
    rdfs:comment 'Indicates whether the drug is included in the organizations formulary and any restrictions or preferences applied.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpiCode rdf:type rdf:Property ;
    rdfs:label 'Gpi Code' ;
    rdfs:comment 'The Medi-Span Generic Product Identifier, a 14-character hierarchical classification code used in pharmacy systems.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:highAlertMedicationFlag rdf:type rdf:Property ;
    rdfs:label 'High Alert Medication Flag' ;
    rdfs:comment 'Indicates whether the drug is classified as a high-alert medication by ISMP, requiring special handling and verification procedures.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:labelerName rdf:type rdf:Property ;
    rdfs:label 'Labeler Name' ;
    rdfs:comment 'The name of the company or entity that manufactures, repackages, or distributes the drug product.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketingCategory rdf:type rdf:Property ;
    rdfs:label 'Marketing Category' ;
    rdfs:comment 'The regulatory pathway under which the drug was approved (e.g., NDA, ANDA, BLA, OTC Monograph).' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketingEndDate rdf:type rdf:Property ;
    rdfs:label 'Marketing End Date' ;
    rdfs:comment 'The date on which the drug product was discontinued or withdrawn from the market. Null if still active.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketingStartDate rdf:type rdf:Property ;
    rdfs:label 'Marketing Start Date' ;
    rdfs:comment 'The date on which the drug product was first marketed or made available for distribution.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ndcCode rdf:type rdf:Property ;
    rdfs:label 'Ndc Code' ;
    rdfs:comment 'The 11-digit National Drug Code assigned by the FDA, uniquely identifying the labeler, product, and package size. Format: 5-4-2 (labeler-product-package).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonproprietaryName rdf:type rdf:Property ;
    rdfs:label 'Nonproprietary Name' ;
    rdfs:comment 'The generic or non-proprietary name of the drug, typically the active ingredient name established by the United States Adopted Names (USAN) Council.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orangeBookCode rdf:type rdf:Property ;
    rdfs:label 'Orange Book Code' ;
    rdfs:comment 'The therapeutic equivalence code from the FDA Orange Book, indicating whether a generic drug is therapeutically equivalent to the brand-name drug.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overTheCounterFlag rdf:type rdf:Property ;
    rdfs:label 'Over The Counter Flag' ;
    rdfs:comment 'Indicates whether the drug is available for purchase without a prescription.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:packageDescription rdf:type rdf:Property ;
    rdfs:label 'Package Description' ;
    rdfs:comment 'A textual description of the package size and configuration (e.g., bottle of 100 tablets, box of 10 vials).' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packageQuantity rdf:type rdf:Property ;
    rdfs:label 'Package Quantity' ;
    rdfs:comment 'The numeric quantity of units contained in the package.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:packageUnit rdf:type rdf:Property ;
    rdfs:label 'Package Unit' ;
    rdfs:comment 'The unit of measure for the package quantity (e.g., tablet, capsule, mL, vial).' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pregnancyCategory rdf:type rdf:Property ;
    rdfs:label 'Pregnancy Category' ;
    rdfs:comment 'The FDA pregnancy category classification indicating the risk of fetal harm (A=safest, X=contraindicated, N=not classified). Note: FDA replaced this with narrative labeling in 2015.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proprietaryName rdf:type rdf:Property ;
    rdfs:label 'Proprietary Name' ;
    rdfs:comment 'The brand or trade name under which the drug is marketed to consumers and healthcare providers.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refrigerationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Refrigeration Required Flag' ;
    rdfs:comment 'Indicates whether the drug requires refrigerated storage to maintain stability and efficacy.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:routeOfAdministration rdf:type rdf:Property ;
    rdfs:label 'Route Of Administration' ;
    rdfs:comment 'The path by which the drug is administered into the body (e.g., oral, intravenous, topical, subcutaneous, intramuscular).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rxcui rdf:type rdf:Property ;
    rdfs:label 'Rxcui' ;
    rdfs:comment 'The RxNorm Concept Unique Identifier assigned by the National Library of Medicine, providing a normalized drug concept mapping for interoperability.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rxnormName rdf:type rdf:Property ;
    rdfs:label 'Rxnorm Name' ;
    rdfs:comment 'The normalized drug name as defined in RxNorm, representing the clinical drug concept.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rxnormSourceVocabulary rdf:type rdf:Property ;
    rdfs:label 'Rxnorm Source Vocabulary' ;
    rdfs:comment 'The source vocabulary from which the RxNorm concept was derived (e.g., RXNORM, VANDF, MMSL, NDDF).' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rxnormSuppressFlag rdf:type rdf:Property ;
    rdfs:label 'Rxnorm Suppress Flag' ;
    rdfs:comment 'Indicates whether the RxNorm concept is suppressed from use (N=not suppressed, Y=suppressed, O=obsolete, E=entry term).' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rxnormTermType rdf:type rdf:Property ;
    rdfs:label 'Rxnorm Term Type' ;
    rdfs:comment 'The RxNorm term type classification (e.g., IN for ingredient, BN for brand name, SCD for semantic clinical drug, GPCK for generic pack).' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strength rdf:type rdf:Property ;
    rdfs:label 'Strength' ;
    rdfs:comment 'The concentration or potency of the active ingredient(s) in the drug product, expressed as a numeric value with unit (e.g., 500 mg, 10 mg/mL).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strengthUnit rdf:type rdf:Property ;
    rdfs:label 'Strength Unit' ;
    rdfs:comment 'The unit of measure for the drug strength (e.g., mg, mL, mcg, IU, %).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapeuticClass rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Class' ;
    rdfs:comment 'The therapeutic or pharmacological classification of the drug (e.g., antibiotic, antihypertensive, analgesic).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uniiCode rdf:type rdf:Property ;
    rdfs:label 'Unii Code' ;
    rdfs:comment 'The FDA Unique Ingredient Identifier code for the active ingredient, used for substance identification.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vaccineFlag rdf:type rdf:Property ;
    rdfs:label 'Vaccine Flag' ;
    rdfs:comment 'Indicates whether the drug product is a vaccine used for immunization.' ;
    rdfs:domain ind:NdcDrug ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fhirValueSetId rdf:type rdf:Property ;
    rdfs:label 'Fhir Value Set Id' ;
    rdfs:comment 'Unique identifier for the FHIR value set record. Primary key.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interoperabilityExchangeStandardId rdf:type rdf:Property ;
    rdfs:label 'Interoperability Exchange Standard Id' ;
    rdfs:comment 'FK to interoperability.exchange_standard.exchange_standard_id' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExchangeStandard .

ind:bindingStrength rdf:type rdf:Property ;
    rdfs:label 'Binding Strength' ;
    rdfs:comment 'Defines how strictly FHIR resources must conform to this value set. Required = must use codes from this set only, Extensible = should use but may extend, Preferred = recommended but not enforced, Example = illustrative only.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:canonicalUrl rdf:type rdf:Property ;
    rdfs:label 'Canonical Url' ;
    rdfs:comment 'Globally unique canonical URL that permanently identifies this value set across all FHIR implementations. Used for terminology server lookups and resource references.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:composeExcludeCount rdf:type rdf:Property ;
    rdfs:label 'Compose Exclude Count' ;
    rdfs:comment 'Number of exclude rules defined in the value set composition. Exclude rules remove specific concepts from the included set.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:composeIncludeCount rdf:type rdf:Property ;
    rdfs:label 'Compose Include Count' ;
    rdfs:comment 'Number of include rules defined in the value set composition. Each include rule specifies a code system and filter criteria for selecting concepts.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contactJson rdf:type rdf:Property ;
    rdfs:label 'Contact Json' ;
    rdfs:comment 'JSON-encoded contact details for the publisher or steward of this value set, including name, email, phone, and URL. Used for support and governance inquiries.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copyright rdf:type rdf:Property ;
    rdfs:label 'Copyright' ;
    rdfs:comment 'Legal copyright and licensing terms governing the use of this value set. Critical for code systems like SNOMED CT, CPT, and ICD-10 that require licensing agreements.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expansionIdentifier rdf:type rdf:Property ;
    rdfs:label 'Expansion Identifier' ;
    rdfs:comment 'Unique identifier for the current expansion of this value set. Changes each time the value set is expanded by a terminology server to reflect the current set of member concepts.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expansionOffset rdf:type rdf:Property ;
    rdfs:label 'Expansion Offset' ;
    rdfs:comment 'Paging offset used when the expansion was generated. Supports large value sets that cannot be returned in a single response.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expansionParameterJson rdf:type rdf:Property ;
    rdfs:label 'Expansion Parameter Json' ;
    rdfs:comment 'JSON-encoded parameters used during the expansion operation, such as language, display variant, or active-only filters. Stored as text for auditability.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expansionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Expansion Timestamp' ;
    rdfs:comment 'Date and time when the value set was last expanded by a terminology server to produce the current list of member concepts. Critical for cache invalidation and version control.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:expansionTotalConcepts rdf:type rdf:Property ;
    rdfs:label 'Expansion Total Concepts' ;
    rdfs:comment 'Total number of coded concepts included in the current expansion of this value set. Used for validation and performance optimization.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:experimentalFlag rdf:type rdf:Property ;
    rdfs:label 'Experimental Flag' ;
    rdfs:comment 'Indicates whether this value set is for testing or experimental purposes and should not be used in production clinical systems. True means not approved for operational use.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fhirElementPath rdf:type rdf:Property ;
    rdfs:label 'Fhir Element Path' ;
    rdfs:comment 'Specific element path within the FHIR resource where this value set binding applies, using dot notation. Example: Observation.code, Condition.clinicalStatus, Procedure.category.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fhirValueSetDescription rdf:type rdf:Property ;
    rdfs:label 'Fhir Value Set Description' ;
    rdfs:comment 'Detailed narrative description of the value set purpose, scope, and intended use cases. Provides clinical and business context for terminology consumers.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:immutableFlag rdf:type rdf:Property ;
    rdfs:label 'Immutable Flag' ;
    rdfs:comment 'Indicates whether the value set definition is immutable and will never change once published. True means the expansion will always produce the same set of codes.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionCodes rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Codes' ;
    rdfs:comment 'Comma-separated list of ISO 3166 country codes or jurisdiction identifiers where this value set is intended for use. Examples: USA, CAN, GBR. Supports regional terminology requirements.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publisher rdf:type rdf:Property ;
    rdfs:label 'Publisher' ;
    rdfs:comment 'Name of the organization or individual responsible for publishing and maintaining this value set. Examples include HL7, SNOMED International, LOINC, or internal enterprise teams.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:useContextJson rdf:type rdf:Property ;
    rdfs:label 'Use Context Json' ;
    rdfs:comment 'JSON-encoded array of usage contexts defining when and where this value set should be applied. Includes clinical specialty, care setting, patient demographics, and workflow phase.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueSetName rdf:type rdf:Property ;
    rdfs:label 'Value Set Name' ;
    rdfs:comment 'Computer-friendly name for the value set, typically used in code generation and system identifiers. Must be alphanumeric without spaces.' ;
    rdfs:domain ind:FhirValueSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueSetOid rdf:type rdf:Property ;
    rdfs:label 'Value Set Oid' ;
    rdfs:comment 'ISO object identifier uniquely identifying this value set in the global OID registry. Format follows ISO/IEC 8824 dotted decimal notation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npiRegistryId rdf:type rdf:Property ;
    rdfs:label 'Npi Registry Id' ;
    rdfs:comment 'Primary key for npi_registry' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:practiceLocationGeographicRegionId rdf:type rdf:Property ;
    rdfs:label 'Practice Location Geographic Region Id' ;
    rdfs:comment 'Foreign key linking to reference.geographic_region. Business justification: NPI registry contains practice location addresses with postal codes that should be normalized to geographic_region for ZIP-based analytics (RUCA codes, HSA/HRR assignments, CMS region mapping). The np' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeographicRegion .

ind:authorizedOfficialFirstName rdf:type rdf:Property ;
    rdfs:label 'Authorized Official First Name' ;
    rdfs:comment 'The first name of the authorized official for the organizational provider (Type 2 NPIs only). Used for credentialing verification and organizational accountability.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedOfficialLastName rdf:type rdf:Property ;
    rdfs:label 'Authorized Official Last Name' ;
    rdfs:comment 'The last name of the authorized official who is legally responsible for the organizational provider (Type 2 NPIs only). This individual has authority to bind the organization and attest to the accuracy of NPI application information.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedOfficialMiddleName rdf:type rdf:Property ;
    rdfs:label 'Authorized Official Middle Name' ;
    rdfs:comment 'The middle name of the authorized official for the organizational provider (Type 2 NPIs only). Optional field for complete identification.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedOfficialTelephoneNumber rdf:type rdf:Property ;
    rdfs:label 'Authorized Official Telephone Number' ;
    rdfs:comment 'The telephone number of the authorized official for the organizational provider. Used for credentialing verification, attestation confirmation, and regulatory inquiries.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedOfficialTitle rdf:type rdf:Property ;
    rdfs:label 'Authorized Official Title' ;
    rdfs:comment 'The job title or position of the authorized official within the organization (e.g., CEO, CFO, Administrator, President, Medical Director). Used to verify organizational authority and credentialing compliance.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Employer Identification Number' ;
    rdfs:comment 'The IRS Employer Identification Number (EIN) for organizational providers (Type 2 only). Used for tax reporting and organizational identification. Also known as Federal Tax ID.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityTypeCode rdf:type rdf:Property ;
    rdfs:label 'Entity Type Code' ;
    rdfs:comment 'Indicates whether the NPI is assigned to an individual provider (Type 1) or an organization (Type 2). Type 1 = Individual healthcare provider (physician, nurse, therapist). Type 2 = Healthcare organization (hospital, clinic, group practice, pharmacy).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enumerationDate rdf:type rdf:Property ;
    rdfs:label 'Enumeration Date' ;
    rdfs:comment 'The date the NPI was originally assigned to the provider by NPPES. Represents the providers initial enrollment in the national provider registry. Critical for credentialing timelines and provider history tracking.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Last Update Date' ;
    rdfs:comment 'The date the NPI record was last updated in NPPES. Reflects the most recent change to provider demographic information, address, taxonomy, or other registry data. Used to track data freshness and trigger downstream updates.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mailingAddressCity rdf:type rdf:Property ;
    rdfs:label 'Mailing Address City' ;
    rdfs:comment 'The city name for the providers mailing address. Used for geographic segmentation and correspondence routing.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressCountryCode rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Country Code' ;
    rdfs:comment 'The three-letter ISO country code for the providers mailing address (e.g., USA, CAN, MEX). Used for international provider tracking and cross-border claims.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressFaxNumber rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Fax Number' ;
    rdfs:comment 'The fax number associated with the providers mailing address. Used for document transmission during credentialing, prior authorization, and claims correspondence.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line 1' ;
    rdfs:comment 'The first line of the providers mailing address (street address, PO Box, or suite number). Used for official correspondence, credentialing documents, and regulatory communications.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line 2' ;
    rdfs:comment 'The second line of the providers mailing address (apartment, suite, building, floor). Optional field for additional address detail.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressPostalCode rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Postal Code' ;
    rdfs:comment 'The ZIP code or ZIP+4 code for the providers mailing address. Used for mail delivery, geographic analysis, and service area determination.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressState rdf:type rdf:Property ;
    rdfs:label 'Mailing Address State' ;
    rdfs:comment 'The two-letter state or territory code for the providers mailing address (e.g., CA, NY, TX). Used for state-level reporting and regulatory compliance.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressTelephoneNumber rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Telephone Number' ;
    rdfs:comment 'The telephone number associated with the providers mailing address. Used for provider contact and verification during credentialing and claims inquiries.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationName rdf:type rdf:Property ;
    rdfs:label 'Organization Name' ;
    rdfs:comment 'The legal business name of the healthcare organization for Type 2 (organizational) NPIs. Examples: hospital name, clinic name, group practice name, pharmacy name.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationOtherName rdf:type rdf:Property ;
    rdfs:label 'Organization Other Name' ;
    rdfs:comment 'Alternate name, trade name, or doing-business-as (DBA) name for the healthcare organization. Used when the organization operates under a name different from its legal name.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceLocationAddressCountryCode rdf:type rdf:Property ;
    rdfs:label 'Practice Location Address Country Code' ;
    rdfs:comment 'The three-letter ISO country code for the providers practice location (e.g., USA, CAN, MEX). Used for international provider tracking and cross-border service delivery.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceLocationAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Practice Location Address Line 1' ;
    rdfs:comment 'The first line of the providers primary practice location address (street address, suite number). This is the physical location where the provider sees patients or delivers services. Used for provider directories, patient navigation, and service area mapping.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceLocationAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Practice Location Address Line 2' ;
    rdfs:comment 'The second line of the providers practice location address (apartment, suite, building, floor). Optional field for additional address detail.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceLocationFaxNumber rdf:type rdf:Property ;
    rdfs:label 'Practice Location Fax Number' ;
    rdfs:comment 'The fax number for the providers practice location. Used for medical records transmission, referral coordination, and prior authorization requests.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceLocationTelephoneNumber rdf:type rdf:Property ;
    rdfs:label 'Practice Location Telephone Number' ;
    rdfs:comment 'The telephone number for the providers practice location. Used for patient appointment scheduling, provider directory listings, and referral coordination.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryTaxonomyCode rdf:type rdf:Property ;
    rdfs:label 'Primary Taxonomy Code' ;
    rdfs:comment 'The primary NUCC Health Care Provider Taxonomy code assigned to this NPI. A 10-digit alphanumeric code that classifies the providers type, classification, and specialization (e.g., 207Q00000X = Family Medicine, 208D00000X = General Practice). This is the providers main specialty for claims submission and network assignment.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryTaxonomySwitch rdf:type rdf:Property ;
    rdfs:label 'Primary Taxonomy Switch' ;
    rdfs:comment 'Indicates whether the taxonomy code is designated as the providers primary taxonomy. Y = Yes (primary), N = No (secondary). Used to distinguish the main specialty from additional specialties for claims routing and network credentialing.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerCredential rdf:type rdf:Property ;
    rdfs:label 'Provider Credential' ;
    rdfs:comment 'The professional credential or designation of the individual provider (e.g., MD, DO, RN, DDS, PharmD, PhD, LCSW). Indicates the providers professional qualifications and licensure type.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerFirstName rdf:type rdf:Property ;
    rdfs:label 'Provider First Name' ;
    rdfs:comment 'The legal first name (given name) of the individual healthcare provider for Type 1 NPIs. Used for provider identification, credentialing, and claims submission.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerGenderCode rdf:type rdf:Property ;
    rdfs:label 'Provider Gender Code' ;
    rdfs:comment 'The gender of the individual provider for Type 1 NPIs. M = Male, F = Female. Used for provider demographic reporting and patient preference matching.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerLastName rdf:type rdf:Property ;
    rdfs:label 'Provider Last Name' ;
    rdfs:comment 'The legal last name (family name or surname) of the individual healthcare provider for Type 1 NPIs. Used for provider identification, credentialing, and claims submission.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerMiddleName rdf:type rdf:Property ;
    rdfs:label 'Provider Middle Name' ;
    rdfs:comment 'The middle name of the individual healthcare provider for Type 1 NPIs. Optional field used for complete provider identification.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerNamePrefix rdf:type rdf:Property ;
    rdfs:label 'Provider Name Prefix' ;
    rdfs:comment 'The name prefix or title for the individual provider (e.g., Dr., Mr., Ms., Rev.). Used for formal provider identification and correspondence.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerNameSuffix rdf:type rdf:Property ;
    rdfs:label 'Provider Name Suffix' ;
    rdfs:comment 'The name suffix for the individual provider (e.g., Jr., Sr., II, III). Used for complete provider identification and to distinguish between providers with similar names.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerOtherCredential rdf:type rdf:Property ;
    rdfs:label 'Provider Other Credential' ;
    rdfs:comment 'An alternate or additional professional credential for the individual provider. Used when a provider holds multiple credentials or has changed credentials.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerOtherFirstName rdf:type rdf:Property ;
    rdfs:label 'Provider Other First Name' ;
    rdfs:comment 'An alternate or previous first name for the individual provider. Used to track provider name changes and maintain historical continuity.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerOtherLastName rdf:type rdf:Property ;
    rdfs:label 'Provider Other Last Name' ;
    rdfs:comment 'An alternate or previous last name for the individual provider (e.g., maiden name, former married name). Used to track provider name changes and maintain historical continuity.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerOtherMiddleName rdf:type rdf:Property ;
    rdfs:label 'Provider Other Middle Name' ;
    rdfs:comment 'An alternate or previous middle name for the individual provider. Used to track provider name changes and maintain historical continuity.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerOtherNamePrefix rdf:type rdf:Property ;
    rdfs:label 'Provider Other Name Prefix' ;
    rdfs:comment 'An alternate name prefix for the individual provider. Used to track provider name changes.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerOtherNameSuffix rdf:type rdf:Property ;
    rdfs:label 'Provider Other Name Suffix' ;
    rdfs:comment 'An alternate name suffix for the individual provider. Used to track provider name changes.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reactivationDate rdf:type rdf:Property ;
    rdfs:label 'Reactivation Date' ;
    rdfs:comment 'The date a previously deactivated NPI was reactivated. Indicates the provider has resumed use of this identifier. Used to track provider status changes and maintain accurate active provider lists.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:replacementNpi rdf:type rdf:Property ;
    rdfs:label 'Replacement Npi' ;
    rdfs:comment 'The NPI that has replaced this NPI if the provider has been assigned a new identifier. Used to track provider identifier changes and maintain continuity in claims and credentialing systems.' ;
    rdfs:domain ind:NpiRegistry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicRegionId rdf:type rdf:Property ;
    rdfs:label 'Geographic Region Id' ;
    rdfs:comment 'Unique identifier for the geographic region entity. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeographicRegion .

ind:parentRegionGeographicRegionId rdf:type rdf:Property ;
    rdfs:label 'Parent Region Geographic Region Id' ;
    rdfs:comment 'Reference to the parent geographic region in the hierarchy (e.g., a ZIP codes parent county, a countys parent state). Null for top-level regions (e.g., country).' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeographicRegion .

ind:acoServiceAreaFlag rdf:type rdf:Property ;
    rdfs:label 'Aco Service Area Flag' ;
    rdfs:comment 'Indicates whether this region is part of an ACO service area. True if the region is included in one or more ACO service territories; false otherwise. Used for value-based care program eligibility and population attribution.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cbsaCode rdf:type rdf:Property ;
    rdfs:label 'Cbsa Code' ;
    rdfs:comment 'The U.S. Census Bureau Core-Based Statistical Area code. Used for metropolitan and micropolitan statistical area analysis, market segmentation, and payer contracting territories.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbsaName rdf:type rdf:Property ;
    rdfs:label 'Cbsa Name' ;
    rdfs:comment 'The human-readable name of the CBSA (e.g., New York-Newark-Jersey City, NY-NJ-PA). Null for non-CBSA region types.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:censusDivision rdf:type rdf:Property ;
    rdfs:label 'Census Division' ;
    rdfs:comment 'The U.S. Census Bureau division classification, a finer granularity than census_region. Values: new_england, middle_atlantic, east_north_central, west_north_central, south_atlantic, east_south_central, west_south_central, mountain, pacific. [ENUM-REF-CANDIDATE: new_england|middle_atlantic|east_north_central|west_north_central|south_atlantic|east_south_central|west_south_central|mountain|pacific — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:censusRegion rdf:type rdf:Property ;
    rdfs:label 'Census Region' ;
    rdfs:comment 'The U.S. Census Bureau region classification: northeast, midwest, south, west. Used for demographic and statistical analysis.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsRegionNumber rdf:type rdf:Property ;
    rdfs:label 'Cms Region Number' ;
    rdfs:comment 'The CMS administrative region number (1-10). Used for regulatory reporting, Quality Payment Program (QPP) reporting, and CMS regional office alignment.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fipsCode rdf:type rdf:Property ;
    rdfs:label 'Fips Code' ;
    rdfs:comment 'The Federal Information Processing Standards code for this region. Used for counties (5-digit) and states (2-digit). Null for non-FIPS region types.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hrrCode rdf:type rdf:Property ;
    rdfs:label 'Hrr Code' ;
    rdfs:comment 'The CMS Hospital Referral Region code representing a regional health care market for tertiary medical care. Used for population health management, quality benchmarking, and regional variation analysis.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hsaCode rdf:type rdf:Property ;
    rdfs:label 'Hsa Code' ;
    rdfs:comment 'The CMS Hospital Service Area code representing a collection of ZIP codes whose residents receive most of their hospitalizations from the hospitals in that area. Used for facility service area definitions and market share analysis.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latitude rdf:type rdf:Property ;
    rdfs:label 'Latitude' ;
    rdfs:comment 'The geographic latitude coordinate (decimal degrees) representing the centroid or representative point of the region. Used for mapping, distance calculations, and geospatial analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:longitude rdf:type rdf:Property ;
    rdfs:label 'Longitude' ;
    rdfs:comment 'The geographic longitude coordinate (decimal degrees) representing the centroid or representative point of the region. Used for mapping, distance calculations, and geospatial analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medianHouseholdIncome rdf:type rdf:Property ;
    rdfs:label 'Median Household Income' ;
    rdfs:comment 'The median household income (in USD) for this region, sourced from U.S. Census or American Community Survey data. Used for Social Determinants of Health (SDOH) analysis, financial assistance program eligibility, and health equity reporting.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:populationEstimate rdf:type rdf:Property ;
    rdfs:label 'Population Estimate' ;
    rdfs:comment 'The estimated total population residing in this geographic region, sourced from the most recent U.S. Census or American Community Survey data. Used for population health stratification, capacity planning, and per-capita rate calculations.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:povertyRatePercent rdf:type rdf:Property ;
    rdfs:label 'Poverty Rate Percent' ;
    rdfs:comment 'The percentage of the population living below the federal poverty line in this region. Used for SDOH analysis, charity care program targeting, and community health needs assessments.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regionCode rdf:type rdf:Property ;
    rdfs:label 'Region Code' ;
    rdfs:comment 'The standardized code representing this geographic region (e.g., ZIP code, FIPS code, CBSA code, HSA code, HRR code, state abbreviation). Format and length vary by region_type.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regionName rdf:type rdf:Property ;
    rdfs:label 'Region Name' ;
    rdfs:comment 'The human-readable name of the geographic region (e.g., city name for ZIP, county name, CBSA name, state name).' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regionType rdf:type rdf:Property ;
    rdfs:label 'Region Type' ;
    rdfs:comment 'Discriminator indicating the type of geographic region: zip_code (5-digit ZIP), county, state, cbsa (Core-Based Statistical Area), hsa (Hospital Service Area), hrr (Hospital Referral Region), cms_region (CMS administrative region), aco_service_area (Accountable Care Organization service area), zcta (ZIP Code Tabulation Area), country. [ENUM-REF-CANDIDATE: zip_code|county|state|cbsa|hsa|hrr|cms_region|aco_service_area|zcta|country — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rucaCode rdf:type rdf:Property ;
    rdfs:label 'Ruca Code' ;
    rdfs:comment 'The Rural-Urban Commuting Area code classifying the region by urbanization and commuting patterns. Used for population health stratification and Social Determinants of Health (SDOH) analysis.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateAbbreviation rdf:type rdf:Property ;
    rdfs:label 'State Abbreviation' ;
    rdfs:comment 'The two-letter U.S. state abbreviation (e.g., CA, NY, TX). Populated for U.S. regions; null for non-U.S. or non-state region types.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uninsuredRatePercent rdf:type rdf:Property ;
    rdfs:label 'Uninsured Rate Percent' ;
    rdfs:comment 'The percentage of the population without health insurance coverage in this region. Used for access-to-care analysis, payer mix forecasting, and community benefit program planning.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:urbanRuralClassification rdf:type rdf:Property ;
    rdfs:label 'Urban Rural Classification' ;
    rdfs:comment 'High-level classification of the region as urban, suburban, rural, or frontier. Derived from RUCA codes or other urbanization metrics. Used for access-to-care analysis and health equity reporting.' ;
    rdfs:domain ind:GeographicRegion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionCodeId rdf:type rdf:Property ;
    rdfs:label 'Condition Code Id' ;
    rdfs:comment 'Unique identifier for the condition code record. Primary key.' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amaIndicator rdf:type rdf:Property ;
    rdfs:label 'Ama Indicator' ;
    rdfs:comment 'For discharge disposition codes, indicates whether the disposition represents a discharge against medical advice.' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimFormType rdf:type rdf:Property ;
    rdfs:label 'Claim Form Type' ;
    rdfs:comment 'Identifies which claim form(s) this code is applicable to: UB-04 for facility claims, CMS-1500 for professional claims, or BOTH for codes used across both forms.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commercialPayerFlag rdf:type rdf:Property ;
    rdfs:label 'Commercial Payer Flag' ;
    rdfs:comment 'Indicates whether this code is commonly accepted by commercial insurance payers for claims adjudication.' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionCodeCategory rdf:type rdf:Property ;
    rdfs:label 'Condition Code Category' ;
    rdfs:comment 'Logical grouping or category for the code within its code_type. Examples: Patient Status for certain condition codes, Facility Services for revenue codes, Anatomical Modifiers for CPT modifiers.' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionCodeCode rdf:type rdf:Property ;
    rdfs:label 'Condition Code Code' ;
    rdfs:comment 'The standardized alphanumeric code value as defined by NUBC, CMS, or AMA. Examples: 01 for condition code, A1 for occurrence code, 01 for revenue code, LT for modifier code.' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionCodeDescription rdf:type rdf:Property ;
    rdfs:label 'Condition Code Description' ;
    rdfs:comment 'Full business description of the code explaining its meaning and usage context. Example: Patient is homeless for condition code 60.' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Expired Indicator' ;
    rdfs:comment 'For discharge disposition codes, indicates whether the disposition represents patient death (expired).' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospiceIndicator rdf:type rdf:Property ;
    rdfs:label 'Hospice Indicator' ;
    rdfs:comment 'For discharge disposition codes, indicates whether the disposition represents a hospice discharge (home hospice or hospice facility).' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidApprovedFlag rdf:type rdf:Property ;
    rdfs:label 'Medicaid Approved Flag' ;
    rdfs:comment 'Indicates whether this code is recognized and accepted by Medicaid programs for claims processing and reimbursement.' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareApprovedFlag rdf:type rdf:Property ;
    rdfs:label 'Medicare Approved Flag' ;
    rdfs:comment 'Indicates whether this code is recognized and accepted by Medicare for claims processing and reimbursement.' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pricingImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Pricing Impact Flag' ;
    rdfs:comment 'Indicates whether this code affects reimbursement calculation, DRG assignment, or payment adjustment. True for codes that trigger pricing logic in claims adjudication.' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:professionalIndicator rdf:type rdf:Property ;
    rdfs:label 'Professional Indicator' ;
    rdfs:comment 'Flag indicating whether this code is applicable to professional (physician) claims submitted on CMS-1500 forms.' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresValueFlag rdf:type rdf:Property ;
    rdfs:label 'Requires Value Flag' ;
    rdfs:comment 'For value codes and occurrence codes, indicates whether the code must be accompanied by a numeric value or date on the claim form.' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telehealthEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Telehealth Eligible Flag' ;
    rdfs:comment 'For place of service (POS) codes, indicates whether the location is eligible for telehealth service delivery and reimbursement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ub04FormLocator rdf:type rdf:Property ;
    rdfs:label 'Ub04 Form Locator' ;
    rdfs:comment 'The specific field location on the UB-04 claim form where this code appears. Examples: FL 18-28 for condition codes, FL 31-36 for occurrence codes, FL 39-41 for value codes, FL 42 for revenue codes.' ;
    rdfs:domain ind:ConditionCode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByVersionCodeSetVersionId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Version Code Set Version Id' ;
    rdfs:comment 'Reference to the code_set_version_id of the newer version that replaces this one. Nullable if this is the current active version.' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CodeSetVersion .

ind:checksumAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Checksum Algorithm' ;
    rdfs:comment 'The cryptographic hash algorithm used to generate the file_hash for integrity verification: MD5, SHA256, or SHA512.' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeSetName rdf:type rdf:Property ;
    rdfs:label 'Code Set Name' ;
    rdfs:comment 'The name of the reference code set (e.g., ICD-10-CM, CPT, HCPCS, SNOMED CT, LOINC, NDC, RxNorm, DRG Grouper, HL7 Value Set, FHIR Value Set).' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeSetType rdf:type rdf:Property ;
    rdfs:label 'Code Set Type' ;
    rdfs:comment 'The functional category of the code set: diagnosis (ICD-10), procedure (CPT/HCPCS), drug (NDC/RxNorm), observation (LOINC), terminology (SNOMED CT), or grouper (DRG/APR-DRG).' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceYear rdf:type rdf:Property ;
    rdfs:label 'Compliance Year' ;
    rdfs:comment 'The fiscal or calendar year for which this code set version is required for regulatory compliance and reimbursement (e.g., 2024 for FY2024 ICD-10-CM).' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentRecordCount rdf:type rdf:Property ;
    rdfs:label 'Consent Record Count' ;
    rdfs:comment 'The total number of individual codes or entries contained in this code set version.' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:copyrightNotice rdf:type rdf:Property ;
    rdfs:label 'Copyright Notice' ;
    rdfs:comment 'Legal copyright and licensing information for this code set version, including usage restrictions and attribution requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:downloadTimestamp rdf:type rdf:Property ;
    rdfs:label 'Download Timestamp' ;
    rdfs:comment 'The date and time when this code set version file was downloaded from the source authority.' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fileHash rdf:type rdf:Property ;
    rdfs:label 'File Hash' ;
    rdfs:comment 'Cryptographic hash (SHA-256 or MD5) of the source file, used to verify data integrity and detect unauthorized modifications.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileName rdf:type rdf:Property ;
    rdfs:label 'File Name' ;
    rdfs:comment 'Cleaned boilerplate phrase from attribute description' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formatType rdf:type rdf:Property ;
    rdfs:label 'Format Type' ;
    rdfs:comment 'The file format or data structure of the source code set: csv (comma-separated values), xml (extensible markup language), json (JavaScript object notation), fhir (FHIR CodeSystem resource), hl7 (HL7 v2 table), proprietary (vendor-specific format).' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isHipaaCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Hipaa Compliant' ;
    rdfs:comment 'Indicates whether this code set version meets HIPAA transaction and code set standards for electronic healthcare transactions.' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadStatus rdf:type rdf:Property ;
    rdfs:label 'Load Status' ;
    rdfs:comment 'The current status of the ETL process for loading this code set version into the enterprise data platform: pending (queued), in_progress (loading), completed (successfully loaded), failed (load error), validated (post-load quality checks passed).' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadTimestamp rdf:type rdf:Property ;
    rdfs:label 'Load Timestamp' ;
    rdfs:comment 'The date and time when this code set version was successfully loaded into the enterprise reference data repository.' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:releaseNotes rdf:type rdf:Property ;
    rdfs:label 'Release Notes' ;
    rdfs:comment 'Summary of changes, additions, deletions, and updates included in this code set version compared to the previous version.' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceAuthority rdf:type rdf:Property ;
    rdfs:label 'Source Authority' ;
    rdfs:comment 'The governing body or organization that publishes and maintains this code set (e.g., WHO, AMA, CMS, SNOMED International, Regenstrief Institute, FDA, NLM).' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceUrl rdf:type rdf:Property ;
    rdfs:label 'Source Url' ;
    rdfs:comment 'The official download or reference URL from which this code set version was obtained.' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageScope rdf:type rdf:Property ;
    rdfs:label 'Usage Scope' ;
    rdfs:comment 'The primary business domain(s) for which this code set version is intended: clinical (EHR documentation), billing (claims and revenue cycle), research (clinical trials and studies), quality (HEDIS/quality reporting), or all (enterprise-wide).' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionIdentifier rdf:type rdf:Property ;
    rdfs:label 'Version Identifier' ;
    rdfs:comment 'The official version number or release identifier assigned by the source authority (e.g., 2024, v3.5, FY2024, 20240101).' ;
    rdfs:domain ind:CodeSetVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionStatus rdf:type rdf:Property ;
    rdfs:label 'Version Status' ;
    rdfs:comment 'Current lifecycle status of this code set version: draft (not yet effective), active (currently in use), superseded (replaced by newer version), retired (no longer valid), deprecated (scheduled for retirement).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crosswalkId rdf:type rdf:Property ;
    rdfs:label 'Crosswalk Id' ;
    rdfs:comment 'Unique identifier for the terminology crosswalk mapping record.' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crosswalkCodeSetVersionId rdf:type rdf:Property ;
    rdfs:label 'Crosswalk Code Set Version Id' ;
    rdfs:comment 'Foreign key linking to reference.code_set_version. Business justification: Crosswalk mappings are version-specific - ICD-10-CM to SNOMED CT mappings change with each release of both terminologies. The crosswalk table has source_code_system_version (STRING), target_code_syste' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CodeSetVersion .

ind:sourceCodeSetVersionId rdf:type rdf:Property ;
    rdfs:label 'Source Code Set Version Id' ;
    rdfs:comment 'FK to reference.code_set_version.code_set_version_id' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CodeSetVersion .

ind:approximateFlag rdf:type rdf:Property ;
    rdfs:label 'Approximate Flag' ;
    rdfs:comment 'Indicates whether the mapping is an approximate or inexact match (True) requiring clinical review, or an exact semantic match (False).' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:choiceListIndicator rdf:type rdf:Property ;
    rdfs:label 'Choice List Indicator' ;
    rdfs:comment 'Indicates whether the target code is one of multiple valid choices for the source code, requiring clinical judgment to select the most appropriate target.' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:combinationFlag rdf:type rdf:Property ;
    rdfs:label 'Combination Flag' ;
    rdfs:comment 'Indicates whether this mapping requires multiple target codes to fully represent the source code (True) or is a single 1:1 or 1:0 mapping (False).' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:directionality rdf:type rdf:Property ;
    rdfs:label 'Directionality' ;
    rdfs:comment 'Indicates whether the mapping is valid in one direction (forward: source to target only, backward: target to source only) or both directions (bidirectional).' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastValidatedDate rdf:type rdf:Property ;
    rdfs:label 'Last Validated Date' ;
    rdfs:comment 'The most recent date on which this mapping was reviewed and validated by clinical or coding subject matter experts.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mapGroup rdf:type rdf:Property ;
    rdfs:label 'Map Group' ;
    rdfs:comment 'Grouping identifier for related mappings that should be considered together (e.g., all mappings for a specific clinical domain or use case).' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mapPriority rdf:type rdf:Property ;
    rdfs:label 'Map Priority' ;
    rdfs:comment 'Numeric ranking indicating the preferred order when multiple target codes are valid for a single source code (lower numbers indicate higher priority).' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mappingAuthority rdf:type rdf:Property ;
    rdfs:label 'Mapping Authority' ;
    rdfs:comment 'The authoritative source or organization that published or validated this mapping (e.g., CMS, NLM, SNOMED International, Regenstrief Institute, internal clinical terminology team).' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mappingPurpose rdf:type rdf:Property ;
    rdfs:label 'Mapping Purpose' ;
    rdfs:comment 'The intended use case or business purpose for this mapping (e.g., claims submission, clinical documentation, quality reporting, SDOH screening, interoperability, legacy system migration).' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mappingQuality rdf:type rdf:Property ;
    rdfs:label 'Mapping Quality' ;
    rdfs:comment 'The confidence or precision level of the mapping: exact (perfect semantic match), high (strong clinical equivalence), moderate (acceptable with context), low (weak or conditional match).' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mappingRule rdf:type rdf:Property ;
    rdfs:label 'Mapping Rule' ;
    rdfs:comment 'Textual description of any conditional logic, clinical context, or business rules that govern when and how this mapping should be applied.' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mappingType rdf:type rdf:Property ;
    rdfs:label 'Mapping Type' ;
    rdfs:comment 'The semantic relationship between source and target codes: equivalent (1:1 exact match), broader (source is more specific than target), narrower (source is more general than target), related (associated but not hierarchical), inexact (approximate match), unmatched (no suitable target).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noMapFlag rdf:type rdf:Property ;
    rdfs:label 'No Map Flag' ;
    rdfs:comment 'Indicates whether the source code has no suitable equivalent in the target code system (True) or a valid mapping exists (False).' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scenarioFlag rdf:type rdf:Property ;
    rdfs:label 'Scenario Flag' ;
    rdfs:comment 'Identifies specific clinical or billing scenarios where this mapping applies (e.g., inpatient vs outpatient, primary vs secondary diagnosis).' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceCode rdf:type rdf:Property ;
    rdfs:label 'Source Code' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceCodeDisplay rdf:type rdf:Property ;
    rdfs:label 'Source Code Display' ;
    rdfs:comment 'Human-readable display text or description for the source code.' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceCodeSystem rdf:type rdf:Property ;
    rdfs:label 'Source Code System' ;
    rdfs:comment 'The originating terminology or code system from which the mapping is derived (e.g., ICD-10-CM, SNOMED CT, CPT, LOINC, NDC, RxNorm).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCode rdf:type rdf:Property ;
    rdfs:label 'Target Code' ;
    rdfs:comment 'The specific code value in the target code system being mapped to (e.g., 73211009 for SNOMED CT, 99213 for CPT).' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCodeDisplay rdf:type rdf:Property ;
    rdfs:label 'Target Code Display' ;
    rdfs:comment 'Human-readable display text or description for the target code.' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageCount rdf:type rdf:Property ;
    rdfs:label 'Usage Count' ;
    rdfs:comment 'The number of times this crosswalk mapping has been applied in production systems, used for mapping quality assessment and optimization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validatedBy rdf:type rdf:Property ;
    rdfs:label 'Validated By' ;
    rdfs:comment 'The name or identifier of the clinical or coding expert who last validated this mapping.' ;
    rdfs:domain ind:Crosswalk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentMajorDiagnosticCategoryId rdf:type rdf:Property ;
    rdfs:label 'Parent Major Diagnostic Category Id' ;
    rdfs:comment 'Self-referencing FK on major_diagnostic_category (parent_major_diagnostic_category_id)' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MajorDiagnosticCategory .

ind:averageLengthOfStayDays rdf:type rdf:Property ;
    rdfs:label 'Average Length Of Stay Days' ;
    rdfs:comment 'National average length of stay in days for cases grouped to this MDC. Used for benchmarking and utilization management.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bodySystem rdf:type rdf:Property ;
    rdfs:label 'Body System' ;
    rdfs:comment 'Primary anatomical body system or organ system associated with this MDC (e.g., Cardiovascular, Respiratory, Musculoskeletal).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseVolumeRank rdf:type rdf:Property ;
    rdfs:label 'Case Volume Rank' ;
    rdfs:comment 'National ranking of this MDC by case volume (1 = highest volume). Used for prioritization and resource planning.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:classificationType rdf:type rdf:Property ;
    rdfs:label 'Classification Type' ;
    rdfs:comment 'Type of classification logic used for this MDC: organ_system (anatomical), procedure_based (surgical/procedural), condition_based (disease-focused), or special_category (pre-MDC, ungroupable).' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalNotes rdf:type rdf:Property ;
    rdfs:label 'Clinical Notes' ;
    rdfs:comment 'Additional clinical context, coding guidance, or special considerations for this MDC. Used by HIM and coding staff.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complicationComorbidityLogic rdf:type rdf:Property ;
    rdfs:label 'Complication Comorbidity Logic' ;
    rdfs:comment 'Type of CC/MCC logic applied within this MDC: standard (uses CC/MCC lists), modified (custom logic), or not_applicable (no CC partitioning).' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgCount rdf:type rdf:Property ;
    rdfs:label 'Drg Count' ;
    rdfs:comment 'Total number of DRGs contained within this MDC. Used for reference and validation.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:icd10CmRangeEnd rdf:type rdf:Property ;
    rdfs:label 'Icd 10 Cm Range End' ;
    rdfs:comment 'Ending ICD-10-CM diagnosis code that maps to this MDC (e.g., G99). Used for grouper logic.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10CmRangeStart rdf:type rdf:Property ;
    rdfs:label 'Icd 10 Cm Range Start' ;
    rdfs:comment 'Starting ICD-10-CM diagnosis code that maps to this MDC (e.g., G00). Used for grouper logic.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10PcsRangeEnd rdf:type rdf:Property ;
    rdfs:label 'Icd 10 Pcs Range End' ;
    rdfs:comment 'Ending ICD-10-PCS procedure code that maps to this MDC. Used for surgical partition assignment.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10PcsRangeStart rdf:type rdf:Property ;
    rdfs:label 'Icd 10 Pcs Range Start' ;
    rdfs:comment 'Starting ICD-10-PCS procedure code that maps to this MDC. Used for surgical partition assignment.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:majorDiagnosticCategoryDescription rdf:type rdf:Property ;
    rdfs:label 'Major Diagnostic Category Description' ;
    rdfs:comment 'Detailed clinical and administrative description of the MDC scope, including typical diagnoses, procedures, and patient populations covered.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:majorDiagnosticCategoryName rdf:type rdf:Property ;
    rdfs:label 'Major Diagnostic Category Name' ;
    rdfs:comment 'Full descriptive name of the major diagnostic category (e.g., Diseases and Disorders of the Nervous System).' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:majorDiagnosticCategoryStatus rdf:type rdf:Property ;
    rdfs:label 'Major Diagnostic Category Status' ;
    rdfs:comment 'Current lifecycle status of this MDC in the reference system. Active MDCs are used in current grouper logic.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mdcCode rdf:type rdf:Property ;
    rdfs:label 'Mdc Code' ;
    rdfs:comment 'Standard MDC code used in DRG grouping (e.g., MDC01, MDC02). This is the externally-known unique identifier for the category.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mdcNumber rdf:type rdf:Property ;
    rdfs:label 'Mdc Number' ;
    rdfs:comment 'Numeric representation of the MDC (1-25). Used for sorting and grouping logic.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preMdcIndicator rdf:type rdf:Property ;
    rdfs:label 'Pre Mdc Indicator' ;
    rdfs:comment 'Indicates whether this is a pre-MDC assignment (e.g., transplants, tracheostomy, ECMO) that bypasses standard MDC logic. True for special high-resource cases.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reimbursementImpactLevel rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Impact Level' ;
    rdfs:comment 'Relative financial impact of this MDC on hospital reimbursement: high (high-cost, high-volume), medium, or low.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relativeWeightAverage rdf:type rdf:Property ;
    rdfs:label 'Relative Weight Average' ;
    rdfs:comment 'Average relative weight of all DRGs within this MDC. Used for cost and resource intensity analysis.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surgicalMedicalPartition rdf:type rdf:Property ;
    rdfs:label 'Surgical Medical Partition' ;
    rdfs:comment 'Indicates whether this MDC contains surgical DRGs, medical DRGs, or both. Not applicable for pre-MDC categories.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ungroupableIndicator rdf:type rdf:Property ;
    rdfs:label 'Ungroupable Indicator' ;
    rdfs:comment 'Indicates whether this MDC represents ungroupable cases that do not fit standard classification logic. True for error DRGs.' ;
    rdfs:domain ind:MajorDiagnosticCategory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentComplianceProgramId rdf:type rdf:Property ;
    rdfs:label 'Parent Compliance Program Id' ;
    rdfs:comment 'Self-referencing FK on compliance_program (parent_compliance_program_id)' ;
    rdfs:domain ind:ComplianceProgram ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceProgram .

ind:accreditationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Accreditation Expiration Date' ;
    rdfs:comment 'Date when the current accreditation expires and must be renewed. Null for non-accreditation programs or indefinite accreditations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:charterDocument rdf:type rdf:Property ;
    rdfs:label 'Charter Document' ;
    rdfs:comment 'Reference identifier or file path to the official program charter document that defines the programs mission, objectives, governance structure, and authority. May be a document management system identifier or URL.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:objectives rdf:type rdf:Property ;
    rdfs:label 'Objectives' ;
    rdfs:comment 'High-level objectives and goals of the compliance program, such as ensuring HIPAA compliance, maintaining Joint Commission accreditation, preventing fraud and abuse, or meeting CMS Conditions of Participation.' ;
    rdfs:domain ind:ComplianceProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyCount rdf:type rdf:Property ;
    rdfs:label 'Policy Count' ;
    rdfs:comment 'Total number of formal policies and procedures associated with this compliance program. Used to track program complexity and governance scope.' ;
    rdfs:domain ind:ComplianceProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Reporting Required Flag' ;
    rdfs:comment 'Indicates whether this compliance program requires formal reporting to external regulatory bodies or oversight agencies (true) or is internally managed only (false).' ;
    rdfs:domain ind:ComplianceProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentObligationId rdf:type rdf:Property ;
    rdfs:label 'Parent Obligation Id' ;
    rdfs:comment 'Self-referencing FK on obligation (parent_obligation_id)' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Obligation .

ind:assignedRole rdf:type rdf:Property ;
    rdfs:label 'Assigned Role' ;
    rdfs:comment 'Job role or position title responsible for managing and completing this obligation (e.g., Compliance Officer, Privacy Officer, Quality Director).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestationFrequency rdf:type rdf:Property ;
    rdfs:label 'Attestation Frequency' ;
    rdfs:comment 'Frequency at which attestation must be provided for this obligation.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compliancePercentage rdf:type rdf:Property ;
    rdfs:label 'Compliance Percentage' ;
    rdfs:comment 'Percentage of completion or compliance achievement for this obligation, ranging from 0.00 to 100.00.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:controlActivity rdf:type rdf:Property ;
    rdfs:label 'Control Activity' ;
    rdfs:comment 'Specific control or action that must be performed to satisfy this obligation (e.g., conduct annual HIPAA training, perform quarterly access reviews, submit monthly quality reports).' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationRequired rdf:type rdf:Property ;
    rdfs:label 'Escalation Required' ;
    rdfs:comment 'Indicates whether this obligation requires escalation to senior management or board-level oversight when overdue or at risk.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evidenceRequired rdf:type rdf:Property ;
    rdfs:label 'Evidence Required' ;
    rdfs:comment 'Indicates whether documented evidence of compliance must be collected and retained for this obligation.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evidenceRetentionYears rdf:type rdf:Property ;
    rdfs:label 'Evidence Retention Years' ;
    rdfs:comment 'Number of years that compliance evidence must be retained to meet regulatory and legal requirements.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evidenceType rdf:type rdf:Property ;
    rdfs:label 'Evidence Type' ;
    rdfs:comment 'Description of the type of evidence required to demonstrate compliance (e.g., policy document, training completion records, audit report, attestation form, system logs).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalAuditScope rdf:type rdf:Property ;
    rdfs:label 'External Audit Scope' ;
    rdfs:comment 'Indicates whether this obligation is included in the scope of external regulatory audits or accreditation surveys.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:obligationDescription rdf:type rdf:Property ;
    rdfs:label 'Obligation Description' ;
    rdfs:comment 'Detailed description of what the obligation entails, including specific actions required to achieve compliance.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationName rdf:type rdf:Property ;
    rdfs:label 'Obligation Name' ;
    rdfs:comment 'Short descriptive name of the compliance obligation for easy identification and reference.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationNumber rdf:type rdf:Property ;
    rdfs:label 'Obligation Number' ;
    rdfs:comment 'Human-readable unique business identifier for the obligation, used for tracking and reporting purposes.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationStatus rdf:type rdf:Property ;
    rdfs:label 'Obligation Status' ;
    rdfs:comment 'Current lifecycle status of the obligation indicating its state in the compliance workflow. [ENUM-REF-CANDIDATE: draft|active|in_progress|completed|overdue|waived|cancelled — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationType rdf:type rdf:Property ;
    rdfs:label 'Obligation Type' ;
    rdfs:comment 'Classification of the obligation by the type of compliance activity required: policy development, procedure implementation, training delivery, regulatory reporting, audit execution, or attestation submission.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureReference rdf:type rdf:Property ;
    rdfs:label 'Procedure Reference' ;
    rdfs:comment 'Reference to the internal procedure document number or identifier that provides step-by-step instructions for fulfilling this obligation.' ;
    rdfs:domain ind:Obligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrencePattern rdf:type rdf:Property ;
    rdfs:label 'Recurrence Pattern' ;
    rdfs:comment 'Frequency at which this obligation must be repeated or renewed to maintain ongoing compliance. [ENUM-REF-CANDIDATE: one_time|daily|weekly|monthly|quarterly|semi_annual|annual|biennial|as_needed — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededCompliancePolicyId rdf:type rdf:Property ;
    rdfs:label 'Superseded Compliance Policy Id' ;
    rdfs:comment 'Self-referencing FK on compliance_policy (superseded_compliance_policy_id)' ;
    rdfs:domain ind:CompliancePolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompliancePolicy .

ind:authorContactEmail rdf:type rdf:Property ;
    rdfs:label 'Author Contact Email' ;
    rdfs:comment 'Email address of the policy author for questions or clarifications regarding the policy content.' ;
    rdfs:domain ind:CompliancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorName rdf:type rdf:Property ;
    rdfs:label 'Author Name' ;
    rdfs:comment 'Name of the individual or team who authored or drafted the policy.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionList rdf:type rdf:Property ;
    rdfs:label 'Distribution List' ;
    rdfs:comment 'Comma-separated list of departments, roles, or distribution groups to whom the policy must be communicated upon approval or revision.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerDepartment rdf:type rdf:Property ;
    rdfs:label 'Owner Department' ;
    rdfs:comment 'Department or organizational unit responsible for maintaining, updating, and enforcing the policy (e.g., Health Information Management (HIM), Compliance, Clinical Quality, Human Resources).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerRole rdf:type rdf:Property ;
    rdfs:label 'Owner Role' ;
    rdfs:comment 'Job title or role of the individual accountable for the policy (e.g., Chief Compliance Officer, Chief Nursing Officer (CNO), Director of Health Information Management (HIM), Chief Privacy Officer).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyCategory rdf:type rdf:Property ;
    rdfs:label 'Policy Category' ;
    rdfs:comment 'Primary classification of the policy indicating the functional area it governs. Clinical policies govern patient care delivery; administrative policies govern operational processes; HR policies govern workforce management; privacy/security policies govern Protected Health Information (PHI) and data security; safety policies govern workplace and patient safety; billing/revenue policies govern Revenue Cycle Management (RCM) and financial operations; compliance/regulatory policies govern adherence to external mandates. [ENUM-REF-CANDIDATE: clinical|administrative|human_resources|privacy_security|safety|billing_revenue|compliance_regulatory — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CompliancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicFacingFlag rdf:type rdf:Property ;
    rdfs:label 'Public Facing Flag' ;
    rdfs:comment 'Indicates whether the policy is intended for public disclosure (e.g., patient rights policies, privacy notices). True if the policy is public-facing; False if internal only.' ;
    rdfs:domain ind:CompliancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relatedStandardReferences rdf:type rdf:Property ;
    rdfs:label 'Related Standard References' ;
    rdfs:comment 'Comma-separated list of organizational standards or technical specifications that support or complement this policy.' ;
    rdfs:domain ind:CompliancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeOfApplication rdf:type rdf:Property ;
    rdfs:label 'Scope Of Application' ;
    rdfs:comment 'Description of the organizational units, roles, or locations to which the policy applies (e.g., All Clinical Staff, All Facilities, Emergency Department (ED) Only, Revenue Cycle Management (RCM) Department).' ;
    rdfs:domain ind:CompliancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:summary rdf:type rdf:Property ;
    rdfs:label 'Summary' ;
    rdfs:comment 'Brief executive summary of the policy purpose, key requirements, and intended outcomes. Typically 2-3 sentences.' ;
    rdfs:domain ind:CompliancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersedesPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Supersedes Policy Number' ;
    rdfs:comment 'Policy number of the previous version or policy that this policy replaces. Nullable if this is the first version.' ;
    rdfs:domain ind:CompliancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyVersionId rdf:type rdf:Property ;
    rdfs:label 'Policy Version Id' ;
    rdfs:comment 'Unique identifier for each policy version record. Primary key for the policy version history table.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Policy Employee Id' ;
    rdfs:comment 'Reference to the executive or governance body that formally approved this policy version. Critical for demonstrating authorized policy adoption.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primarySupersededVersionPolicyVersionId rdf:type rdf:Property ;
    rdfs:label 'Primary Superseded Version Policy Version Id' ;
    rdfs:comment 'Reference to the prior policy version that this version replaces. Null for the initial version. Enables version lineage tracking and audit trail reconstruction.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyVersion .

ind:commentLog rdf:type rdf:Property ;
    rdfs:label 'Comment Log' ;
    rdfs:comment 'Aggregated comments and feedback collected during the review and approval process. Provides context for decisions made during policy development.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentChecksum rdf:type rdf:Property ;
    rdfs:label 'Document Checksum' ;
    rdfs:comment 'Cryptographic hash of the policy document file to ensure integrity and detect unauthorized modifications. Supports tamper-evidence requirements for regulatory compliance.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextReviewDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Due Date' ;
    rdfs:comment 'Calculated date by which the next policy review must be completed. Drives proactive policy maintenance and compliance with periodic review requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryDriver rdf:type rdf:Property ;
    rdfs:label 'Regulatory Driver' ;
    rdfs:comment 'Specific regulatory requirement, standard update, or compliance mandate that triggered this policy revision. Examples include new CMS Conditions of Participation, updated Joint Commission standards, or state health department rule changes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementReason rdf:type rdf:Property ;
    rdfs:label 'Retirement Reason' ;
    rdfs:comment 'Explanation for why this policy version was retired or superseded. Documents the business or regulatory rationale for discontinuing the version.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingDueDays rdf:type rdf:Property ;
    rdfs:label 'Training Due Days' ;
    rdfs:comment 'Number of days from policy effective date by which staff must complete required training. Null if training is not required. Used to calculate training compliance deadlines.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:versionCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Version Created Timestamp' ;
    rdfs:comment 'Timestamp when this policy version record was first created in the system. Part of the audit trail for policy lifecycle management.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:versionModifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Version Modified Timestamp' ;
    rdfs:comment 'Timestamp when this policy version record was last modified. Tracks updates to version metadata throughout the approval workflow.' ;
    rdfs:domain ind:PolicyVersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:versionTitle rdf:type rdf:Property ;
    rdfs:label 'Version Title' ;
    rdfs:comment 'Full descriptive title of the policy as it appears in this version. May change across versions to reflect scope or regulatory alignment updates.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditedCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Audited Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Compliance audits consume resources from specific cost centers. Audit costs (internal labor, external auditor fees, remediation) must be tracked against departmental budgets for financial management, ' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:followUpAuditId rdf:type rdf:Property ;
    rdfs:label 'Follow Up Audit Id' ;
    rdfs:comment 'Self-referencing FK on audit (follow_up_audit_id)' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Audit .

ind:accreditationDecision rdf:type rdf:Property ;
    rdfs:label 'Accreditation Decision' ;
    rdfs:comment 'The formal accreditation decision rendered by the auditing body for accreditation audits. Accredited indicates full accreditation granted; accredited_with_conditions indicates accreditation contingent on corrective actions; preliminary_denial indicates initial denial subject to appeal; denial indicates accreditation not granted; not_applicable for non-accreditation audits.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditName rdf:type rdf:Property ;
    rdfs:label 'Audit Name' ;
    rdfs:comment 'The official name or title of the compliance audit (e.g., Q2 2024 HIPAA Privacy Audit, Joint Commission Triennial Survey).' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditScope rdf:type rdf:Property ;
    rdfs:label 'Audit Scope' ;
    rdfs:comment 'Detailed description of the areas, processes, departments, or compliance domains covered by the audit (e.g., HIPAA Privacy Rule compliance across all outpatient clinics, Emergency Department EMTALA compliance, Medication management and pharmacy operations).' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditStatus rdf:type rdf:Property ;
    rdfs:label 'Audit Status' ;
    rdfs:comment 'Current lifecycle status of the audit. Scheduled indicates the audit is planned but not yet started; in_progress means fieldwork is underway; completed means the audit is finished and report issued; cancelled means the audit was terminated before completion; deferred means the audit has been postponed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditType rdf:type rdf:Property ;
    rdfs:label 'Audit Type' ;
    rdfs:comment 'Classification of the audit based on its origin and purpose. Internal audits are conducted by the organizations compliance team; external audits are performed by third parties; regulatory audits are mandated by government agencies; accreditation audits are for maintaining certifications.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditingBody rdf:type rdf:Property ;
    rdfs:label 'Auditing Body' ;
    rdfs:comment 'The name of the organization or entity conducting the audit (e.g., Office of Inspector General (OIG), The Joint Commission, Internal Compliance Department, State Department of Health).' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionPlanDueDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Due Date' ;
    rdfs:comment 'The deadline by which the organization must submit its Corrective Action Plan (CAP) to the auditing body. Null if no CAP is required.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionPlanRequired rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Required' ;
    rdfs:comment 'Indicates whether the audit outcome requires the organization to submit a formal Corrective Action Plan (CAP) to address identified deficiencies. True if CAP is required; False if no CAP is needed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveActionPlanSubmittedDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Submitted Date' ;
    rdfs:comment 'The actual date when the organization submitted its Corrective Action Plan (CAP) to the auditing body. Null if not yet submitted or not required.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cost rdf:type rdf:Property ;
    rdfs:label 'Cost' ;
    rdfs:comment 'The total cost incurred by the organization for the audit, including auditor fees, staff time, travel expenses, and administrative costs. Expressed in US dollars (USD).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:departmentAudited rdf:type rdf:Property ;
    rdfs:label 'Department Audited' ;
    rdfs:comment 'The specific department, unit, or service line that was the focus of the audit (e.g., Emergency Department (ED), Intensive Care Unit (ICU), Pharmacy, Health Information Management (HIM), Revenue Cycle Management (RCM)).' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpStatus rdf:type rdf:Property ;
    rdfs:label 'Follow Up Status' ;
    rdfs:comment 'The current status of follow-up activities to verify implementation of corrective actions. Not_required indicates no follow-up needed; pending indicates follow-up is scheduled but not started; in_progress indicates follow-up verification is underway; completed indicates all corrective actions have been verified; overdue indicates follow-up deadlines have passed without completion.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isUnannounced rdf:type rdf:Property ;
    rdfs:label 'Is Unannounced' ;
    rdfs:comment 'Indicates whether the audit was conducted without prior notice to the organization. True for unannounced or surprise audits; False for scheduled audits with advance notification.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leadAuditorEmail rdf:type rdf:Property ;
    rdfs:label 'Lead Auditor Email' ;
    rdfs:comment 'The primary email address of the lead auditor for audit-related communications and coordination.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadAuditorName rdf:type rdf:Property ;
    rdfs:label 'Lead Auditor Name' ;
    rdfs:comment 'The full name of the individual serving as the lead or principal auditor responsible for conducting and overseeing the audit.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monetaryPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Monetary Penalty Amount' ;
    rdfs:comment 'The total dollar amount of fines, penalties, or financial sanctions imposed as a result of the audit findings. Zero if no penalties were assessed. Expressed in US dollars (USD).' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notificationDate rdf:type rdf:Property ;
    rdfs:label 'Notification Date' ;
    rdfs:comment 'The date when the organization was officially notified of the upcoming audit. For unannounced audits, this may be the same as the actual start date.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overallOutcome rdf:type rdf:Property ;
    rdfs:label 'Overall Outcome' ;
    rdfs:comment 'The final determination or result of the audit. Compliant indicates no significant issues found; non_compliant indicates material deficiencies; partially_compliant indicates some areas of concern; conditional indicates compliance contingent on corrective actions; accredited/not_accredited applies to accreditation audits; findings_issued indicates specific deficiencies were documented. [ENUM-REF-CANDIDATE: compliant|non_compliant|partially_compliant|conditional|accredited|not_accredited|findings_issued — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledEndDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Date' ;
    rdfs:comment 'The planned date when the audit fieldwork and activities are scheduled to be completed.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:teamSize rdf:type rdf:Property ;
    rdfs:label 'Team Size' ;
    rdfs:comment 'The total number of auditors and support staff assigned to conduct the audit.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trigger rdf:type rdf:Property ;
    rdfs:label 'Trigger' ;
    rdfs:comment 'The event, complaint, or circumstance that initiated the audit (e.g., Routine scheduled audit, Patient complaint, Adverse event investigation, CMS validation survey, OIG work plan selection, Whistleblower report).' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceAuditId rdf:type rdf:Property ;
    rdfs:label 'Compliance Audit Id' ;
    rdfs:comment 'Reference to the parent compliance audit during which this finding was identified. Links to the compliance_audit product.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Audit .

ind:parentAuditFindingId rdf:type rdf:Property ;
    rdfs:label 'Parent Audit Finding Id' ;
    rdfs:comment 'Self-referencing FK on audit_finding (related_audit_finding_id)' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditFinding .

ind:primaryPreviousAuditFindingId rdf:type rdf:Property ;
    rdfs:label 'Primary Previous Audit Finding Id' ;
    rdfs:comment 'Reference to the prior audit finding record if this is a recurrence. Links to another audit_finding record. Null if this is not a repeat finding.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditFinding .

ind:accreditationImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Accreditation Impact Flag' ;
    rdfs:comment 'Indicates whether the finding could affect the organizations accreditation status with Joint Commission, DNV, HFAP, or other accrediting bodies. True if accreditation is at risk; false otherwise.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:actualResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Resolution Date' ;
    rdfs:comment 'The date on which the finding was actually resolved, corrective actions were completed, and the finding was closed. Null if still open or in remediation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:affectedDepartment rdf:type rdf:Property ;
    rdfs:label 'Affected Department' ;
    rdfs:comment 'The department, unit, or service line where the finding was identified (e.g., Emergency Department, Pharmacy, Health Information Management, Infection Control). May reference multiple departments if the finding spans areas.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditorName rdf:type rdf:Property ;
    rdfs:label 'Auditor Name' ;
    rdfs:comment 'The name of the auditor, surveyor, or inspector who identified and documented the finding. May be internal compliance staff or external regulatory surveyor.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditorOrganization rdf:type rdf:Property ;
    rdfs:label 'Auditor Organization' ;
    rdfs:comment 'The organization or agency the auditor represents (e.g., Joint Commission, CMS Regional Office, State Department of Health, Internal Audit Department).' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysToResolution rdf:type rdf:Property ;
    rdfs:label 'Days To Resolution' ;
    rdfs:comment 'The number of calendar days between the identified date and the actual resolution date. Used for performance measurement and trend analysis of remediation effectiveness.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disputeSubmittedDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Submitted Date' ;
    rdfs:comment 'The date on which a formal dispute or appeal of the finding was submitted to the regulatory authority. Null if not disputed.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evidenceLocation rdf:type rdf:Property ;
    rdfs:label 'Evidence Location' ;
    rdfs:comment 'The file path, document management system location, or reference to where supporting evidence and documentation for the finding is stored (e.g., audit work papers, photographs, medical records reviewed).' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialPenaltyRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Financial Penalty Risk Flag' ;
    rdfs:comment 'Indicates whether the finding carries risk of financial penalties, fines, or reimbursement recoupment from CMS, state agencies, or other payers. True if monetary sanctions are possible; false otherwise.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:findingDescription rdf:type rdf:Property ;
    rdfs:label 'Finding Description' ;
    rdfs:comment 'Detailed narrative description of the deficiency, observation, or non-compliance issue identified. Includes what was observed, why it constitutes a finding, and the specific circumstances or evidence supporting the citation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingNumber rdf:type rdf:Property ;
    rdfs:label 'Finding Number' ;
    rdfs:comment 'The externally-known unique identifier or tracking number assigned to this finding within the audit (e.g., F-2024-001, CMS-CoP-123). Used for audit documentation and regulatory correspondence.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingStatus rdf:type rdf:Property ;
    rdfs:label 'Finding Status' ;
    rdfs:comment 'Current lifecycle status of the finding. Open indicates newly identified; in remediation indicates corrective action plan is being executed; pending verification indicates awaiting auditor review; closed indicates resolved and accepted; disputed indicates organization contests the finding; deferred indicates resolution postponed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingType rdf:type rdf:Property ;
    rdfs:label 'Finding Type' ;
    rdfs:comment 'Classification of the finding severity and nature. Deficiency indicates non-compliance requiring corrective action; observation is a noted concern without formal citation; opportunity for improvement is a recommendation; immediate jeopardy indicates serious threat to patient safety; condition-level deficiency is a systemic CMS compliance failure; best practice gap is advisory.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpAuditRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Audit Required Flag' ;
    rdfs:comment 'Indicates whether a follow-up audit or validation survey is required to verify that corrective actions have been effectively implemented. True if follow-up is mandated; false otherwise.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpAuditScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Audit Scheduled Date' ;
    rdfs:comment 'The scheduled date for the follow-up audit or validation survey to verify corrective action effectiveness. Null if no follow-up is required or not yet scheduled.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mandatoryReportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Mandatory Reporting Required Flag' ;
    rdfs:comment 'Indicates whether the finding triggers mandatory external reporting obligations to CMS, state health departments, Joint Commission, or other regulatory bodies. True if external reporting is required; false otherwise.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurrenceFlag rdf:type rdf:Property ;
    rdfs:label 'Recurrence Flag' ;
    rdfs:comment 'Indicates whether this finding is a repeat or recurrence of a previously identified and supposedly corrected issue. True if this is a repeat finding; false if this is the first occurrence.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryStandardCited rdf:type rdf:Property ;
    rdfs:label 'Regulatory Standard Cited' ;
    rdfs:comment 'The specific regulatory standard, rule, or requirement that was violated or not met (e.g., 42 CFR 482.13, Joint Commission LD.04.03.11, OSHA 29 CFR 1910.1030). May include multiple citations separated by semicolons.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedToAuthorityDate rdf:type rdf:Property ;
    rdfs:label 'Reported To Authority Date' ;
    rdfs:comment 'The date on which the finding was reported to the applicable regulatory authority, if mandatory reporting was required. Null if not reported or not required.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsiblePartyEmail rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Email' ;
    rdfs:comment 'The email address of the responsible party for follow-up communication and status updates regarding the finding remediation.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeOfImpact rdf:type rdf:Property ;
    rdfs:label 'Scope Of Impact' ;
    rdfs:comment 'The breadth of the finding across the organization. Isolated indicates a single incident; pattern indicates multiple occurrences in one area; widespread indicates multiple areas affected; systemic indicates organization-wide process failure.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagsKeywords rdf:type rdf:Property ;
    rdfs:label 'Tags Keywords' ;
    rdfs:comment 'Comma-separated list of tags or keywords for categorization, search, and reporting (e.g., infection_control, medication_safety, documentation, privacy, emergency_preparedness). Supports analytics and trend identification.' ;
    rdfs:domain ind:AuditFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Target Resolution Date' ;
    rdfs:comment 'The date by which the finding must be resolved and corrective actions completed. May be mandated by regulatory authority or set internally based on risk assessment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:securityRiskHipaaSecurityRiskId rdf:type rdf:Property ;
    rdfs:label 'Security Risk Hipaa Security Risk Id' ;
    rdfs:comment 'Foreign key linking to compliance.hipaa_security_risk. Business justification: Corrective action plans can be created to mitigate HIPAA security risks identified during risk assessments. This FK allows tracking CAPs created to address security risks. N:1 relationship (many CAPs ' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HipaaSecurityRisk .

ind:supersededCorrectiveActionPlanId rdf:type rdf:Property ;
    rdfs:label 'Superseded Corrective Action Plan Id' ;
    rdfs:comment 'Self-referencing FK on corrective_action_plan (superseded_corrective_action_plan_id)' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorrectiveActionPlan .

ind:capNumber rdf:type rdf:Property ;
    rdfs:label 'Cap Number' ;
    rdfs:comment 'Business identifier for the corrective action plan, externally visible and used in regulatory submissions and audit correspondence.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capStatus rdf:type rdf:Property ;
    rdfs:label 'Cap Status' ;
    rdfs:comment 'Current lifecycle status of the corrective action plan in the regulatory response and implementation workflow. [ENUM-REF-CANDIDATE: draft|submitted|approved|in_progress|completed|verified|closed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capType rdf:type rdf:Property ;
    rdfs:label 'Cap Type' ;
    rdfs:comment 'Classification of the corrective action plan based on regulatory requirement and scope of response.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureNotes rdf:type rdf:Property ;
    rdfs:label 'Closure Notes' ;
    rdfs:comment 'Final notes documenting the closure of the corrective action plan, including lessons learned and recommendations for future compliance improvement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentVerificationNotes rdf:type rdf:Property ;
    rdfs:label 'Consent Verification Notes' ;
    rdfs:comment 'Detailed notes from the verification process documenting findings, evidence reviewed, and any remaining concerns or recommendations.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentVerificationOutcome rdf:type rdf:Property ;
    rdfs:label 'Consent Verification Outcome' ;
    rdfs:comment 'Result of the verification process indicating whether the corrective actions were found to be effective and sustainable.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionsDefined rdf:type rdf:Property ;
    rdfs:label 'Corrective Actions Defined' ;
    rdfs:comment 'Detailed description of the specific corrective actions, process changes, policy updates, training programs, or system enhancements that will be implemented to address the deficiency.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalConsultantEngagedFlag rdf:type rdf:Property ;
    rdfs:label 'External Consultant Engaged Flag' ;
    rdfs:comment 'Indicates whether external consultants, subject matter experts, or legal counsel were engaged to support corrective action plan development or implementation.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:implementationMilestones rdf:type rdf:Property ;
    rdfs:label 'Implementation Milestones' ;
    rdfs:comment 'Key milestones, checkpoints, and deliverables defined in the corrective action plan implementation timeline.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringFrequency rdf:type rdf:Property ;
    rdfs:label 'Monitoring Frequency' ;
    rdfs:comment 'Frequency at which ongoing monitoring and auditing will be conducted to ensure sustained compliance after corrective action plan implementation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrencePreventionMeasures rdf:type rdf:Property ;
    rdfs:label 'Recurrence Prevention Measures' ;
    rdfs:comment 'Specific measures, controls, monitoring mechanisms, or system changes implemented to prevent recurrence of the compliance violation.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatorApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Regulator Approval Date' ;
    rdfs:comment 'Date when the regulatory body or accreditation agency formally approved the corrective action plan.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatorFeedback rdf:type rdf:Property ;
    rdfs:label 'Regulator Feedback' ;
    rdfs:comment 'Feedback, comments, or additional requirements provided by the regulatory body or accreditation agency in response to the submitted corrective action plan.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleOwnerDepartment rdf:type rdf:Property ;
    rdfs:label 'Responsible Owner Department' ;
    rdfs:comment 'Department or organizational unit responsible for executing the corrective action plan.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleOwnerEmail rdf:type rdf:Property ;
    rdfs:label 'Responsible Owner Email' ;
    rdfs:comment 'Email contact for the individual responsible for the corrective action plan implementation.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleOwnerName rdf:type rdf:Property ;
    rdfs:label 'Responsible Owner Name' ;
    rdfs:comment 'Name of the individual or role accountable for implementing and completing the corrective action plan.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCauseAnalysisSummary rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis Summary' ;
    rdfs:comment 'Summary of the root cause analysis conducted to identify the underlying factors that led to the compliance violation or audit finding.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:staffAffectedCount rdf:type rdf:Property ;
    rdfs:label 'Staff Affected Count' ;
    rdfs:comment 'Number of staff members, departments, or organizational units affected by or involved in the corrective action plan implementation.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:submittedToRegulatorDate rdf:type rdf:Property ;
    rdfs:label 'Submitted To Regulator Date' ;
    rdfs:comment 'Date when the corrective action plan was formally submitted to the regulatory body or accreditation agency.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Target Completion Date' ;
    rdfs:comment 'Planned date by which all corrective actions must be fully implemented and verified, as committed to the regulatory body or accreditation agency.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trainingCompletionTargetDate rdf:type rdf:Property ;
    rdfs:label 'Training Completion Target Date' ;
    rdfs:comment 'Target date by which all required staff training must be completed as part of the corrective action plan.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deviceId rdf:type rdf:Property ;
    rdfs:label 'Device Id' ;
    rdfs:comment 'Foreign key linking to digital_health.device. Business justification: HIPAA breach investigations must identify the specific connected device involved in PHI exposure. When RPM devices transmit data insecurely or are compromised, the incident record must reference the d' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Device .

ind:hipaaMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Hipaa Mpi Record Id' ;
    rdfs:comment 'description' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:parentHipaaPrivacyIncidentId rdf:type rdf:Property ;
    rdfs:label 'Parent Hipaa Privacy Incident Id' ;
    rdfs:comment 'Self-referencing FK on hipaa_privacy_incident (related_hipaa_privacy_incident_id)' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HipaaPrivacyIncident .

ind:affectedIndividualsCount rdf:type rdf:Property ;
    rdfs:label 'Affected Individuals Count' ;
    rdfs:comment 'The number of unique individuals whose PHI was potentially or actually compromised in the incident.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breachDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Breach Determination Date' ;
    rdfs:comment 'The date when the formal breach determination was completed.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:breachDeterminationOutcome rdf:type rdf:Property ;
    rdfs:label 'Breach Determination Outcome' ;
    rdfs:comment 'The formal determination of whether the incident constitutes a breach under HIPAA Breach Notification Rule based on the four-factor risk assessment.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedDate rdf:type rdf:Property ;
    rdfs:label 'Closed Date' ;
    rdfs:comment 'The date when the incident investigation and all required actions were completed and the case was formally closed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incidentCategory rdf:type rdf:Property ;
    rdfs:label 'Incident Category' ;
    rdfs:comment 'High-level categorization of the root cause or mechanism of the incident.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentDescription rdf:type rdf:Property ;
    rdfs:label 'Incident Description' ;
    rdfs:comment 'Detailed narrative description of the privacy incident including circumstances, individuals involved, and sequence of events.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentType rdf:type rdf:Property ;
    rdfs:label 'Incident Type' ;
    rdfs:comment 'Classification of the nature of the privacy incident describing how the unauthorized use or disclosure occurred. [ENUM-REF-CANDIDATE: unauthorized access|improper disclosure|lost device|stolen device|misdirected communication|insider threat|hacking|ransomware|phishing — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:individualNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Individual Notification Date' ;
    rdfs:comment 'The date when notification letters were sent to affected individuals (must be within 60 days of discovery).' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:individualNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Individual Notification Required Flag' ;
    rdfs:comment 'Indicates whether notification to affected individuals is required under HIPAA Breach Notification Rule.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investigationSummary rdf:type rdf:Property ;
    rdfs:label 'Investigation Summary' ;
    rdfs:comment 'Detailed summary of the investigation findings including root cause analysis and contributing factors.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Case Number' ;
    rdfs:comment 'Case or reference number assigned by law enforcement if the incident was reported to police or other authorities.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementNotifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Notified Flag' ;
    rdfs:comment 'Indicates whether law enforcement agencies were notified of the incident.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lessonsLearned rdf:type rdf:Property ;
    rdfs:label 'Lessons Learned' ;
    rdfs:comment 'Key lessons learned from the incident and recommendations for organizational improvement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationOfIncident rdf:type rdf:Property ;
    rdfs:label 'Location Of Incident' ;
    rdfs:comment 'Physical or system location where the privacy incident occurred (e.g., facility name, department, system name).' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Media Notification Date' ;
    rdfs:comment 'The date when media notification was issued for breaches affecting 500 or more individuals.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mediaNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Media Notification Required Flag' ;
    rdfs:comment 'Indicates whether media notification is required (for breaches affecting 500 or more individuals in a jurisdiction).' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mitigationMeasures rdf:type rdf:Property ;
    rdfs:label 'Mitigation Measures' ;
    rdfs:comment 'Description of immediate mitigation measures taken to limit harm and prevent further unauthorized access or disclosure.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Required Flag' ;
    rdfs:comment 'Indicates whether breach notification to affected individuals, HHS Office for Civil Rights (OCR), and/or media is required.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ocrCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Ocr Case Number' ;
    rdfs:comment 'The case or reference number assigned by HHS Office for Civil Rights upon receipt of the breach report.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ocrReportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Ocr Reporting Required Flag' ;
    rdfs:comment 'Indicates whether reporting to HHS Office for Civil Rights is required.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ocrReportingStatus rdf:type rdf:Property ;
    rdfs:label 'Ocr Reporting Status' ;
    rdfs:comment 'Current status of the breach report submission to HHS Office for Civil Rights.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ocrSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Ocr Submission Date' ;
    rdfs:comment 'The date when the breach report was submitted to HHS Office for Civil Rights (within 60 days for 500+ individuals, or annually for fewer than 500).' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:phiInvolvedFlag rdf:type rdf:Property ;
    rdfs:label 'Phi Involved Flag' ;
    rdfs:comment 'Indicates whether Protected Health Information was involved in the incident.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phiType rdf:type rdf:Property ;
    rdfs:label 'Phi Type' ;
    rdfs:comment 'Description of the type or category of PHI that was accessed, used, or disclosed (e.g., medical records, billing information, lab results, demographic data).' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiVolumeRecords rdf:type rdf:Property ;
    rdfs:label 'Phi Volume Records' ;
    rdfs:comment 'The number of patient records or PHI records involved in the incident.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyViolationFlag rdf:type rdf:Property ;
    rdfs:label 'Policy Violation Flag' ;
    rdfs:comment 'Indicates whether the incident involved a violation of organizational privacy policies or procedures.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:privacyOfficerAssigned rdf:type rdf:Property ;
    rdfs:label 'Privacy Officer Assigned' ;
    rdfs:comment 'Name of the privacy officer or compliance officer assigned to investigate and manage the incident.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationActionsTaken rdf:type rdf:Property ;
    rdfs:label 'Remediation Actions Taken' ;
    rdfs:comment 'Description of corrective and remediation actions taken to address the incident and prevent recurrence.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Completion Date' ;
    rdfs:comment 'The date when all remediation actions were completed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportedByDepartment rdf:type rdf:Property ;
    rdfs:label 'Reported By Department' ;
    rdfs:comment 'Department or organizational unit of the individual who reported the incident.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedByName rdf:type rdf:Property ;
    rdfs:label 'Reported By Name' ;
    rdfs:comment 'Name of the individual who initially reported or discovered the privacy incident.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedByRole rdf:type rdf:Property ;
    rdfs:label 'Reported By Role' ;
    rdfs:comment 'Job title or role of the individual who reported the incident.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAssessmentCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Completed Flag' ;
    rdfs:comment 'Indicates whether the required four-factor risk assessment has been completed to determine breach status.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskAssessmentSummary rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Summary' ;
    rdfs:comment 'Summary of the four-factor risk assessment findings including nature and extent of PHI, unauthorized person, actual acquisition or viewing, and extent of mitigation.' ;
    rdfs:domain ind:HipaaPrivacyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCause rdf:type rdf:Property ;
    rdfs:label 'Root Cause' ;
    rdfs:comment 'Identified root cause of the privacy incident based on investigation findings.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surgicalBomId rdf:type rdf:Property ;
    rdfs:label 'Surgical Bom Id' ;
    rdfs:comment 'Unique system-generated identifier for the surgical Bill of Materials (BOM) record. Primary key for this entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SurgicalBom .

ind:facilityServiceId rdf:type rdf:Property ;
    rdfs:label 'Facility Service Id' ;
    rdfs:comment 'Identifier of the clinical service line (e.g., Orthopedics, Cardiovascular, General Surgery) to which this BOM belongs. Drives OR supply planning by specialty.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FacilityService .

ind:preferenceCardId rdf:type rdf:Property ;
    rdfs:label 'Preference Card Id' ;
    rdfs:comment 'Reference to the surgeon or procedure preference card from which this BOM was derived or linked. Preference cards in Epic OpTime or Cerner SurgiNet define surgeon-specific supply preferences.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PreferenceCard .

ind:standardizedOrderSetId rdf:type rdf:Property ;
    rdfs:label 'Standardized Order Set Id' ;
    rdfs:comment 'Foreign key linking to order.order_set. Business justification: Surgical preference cards (BOMs) often standardized as clinical order sets for procedure protocols. Links supply planning to clinical ordering workflow for efficiency and compliance. Real in periopera' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrderSet .

ind:surgicalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Surgical Employee Id' ;
    rdfs:comment 'Identifier of the employee (typically a clinical director, OR manager, or supply chain director) who approved this BOM for active use. Supports audit trail and accountability.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:anesthesiaType rdf:type rdf:Property ;
    rdfs:label 'Anesthesia Type' ;
    rdfs:comment 'Standard anesthesia type associated with this procedure BOM. Drives anesthesia supply requirements and may influence BOM item composition for anesthesia-specific consumables.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bomName rdf:type rdf:Property ;
    rdfs:label 'Bom Name' ;
    rdfs:comment 'Descriptive name of the surgical BOM, typically reflecting the procedure type and service line (e.g., Total Knee Arthroplasty — Orthopedics). Used for display and search in OR management systems.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bomNumber rdf:type rdf:Property ;
    rdfs:label 'Bom Number' ;
    rdfs:comment 'Externally-known, human-readable unique identifier for this surgical BOM. Used in OR scheduling, case cart building, and supply requisitions. Sourced from Infor Lawson or SAP MM.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bomStatus rdf:type rdf:Property ;
    rdfs:label 'Bom Status' ;
    rdfs:comment 'Current lifecycle status of the surgical BOM. draft indicates in development; active is approved for use; under_review is pending clinical or supply chain review; superseded has been replaced by a newer version; retired is no longer in use.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bomVersion rdf:type rdf:Property ;
    rdfs:label 'Bom Version' ;
    rdfs:comment 'Version identifier of the BOM (e.g., v1.0, v2.3). Supports versioning when supply lists are updated due to clinical preference changes, product substitutions, or cost reviews.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseCartTemplateFlag rdf:type rdf:Property ;
    rdfs:label 'Case Cart Template Flag' ;
    rdfs:comment 'Indicates whether this BOM is designated as the standard case cart template for the associated procedure type. Case cart templates drive automated pick lists in materials management systems.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedCaseDurationMin rdf:type rdf:Property ;
    rdfs:label 'Estimated Case Duration Min' ;
    rdfs:comment 'Standard estimated duration of the surgical procedure in minutes. Used for OR scheduling, staffing planning, and supply consumption rate estimation.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedImplantCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Implant Cost' ;
    rdfs:comment 'Estimated cost attributable specifically to implantable devices within this BOM. Separated from general supply cost to support implant cost tracking, vendor negotiations, and UDI compliance reporting.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedSupplyCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Supply Cost' ;
    rdfs:comment 'Total estimated cost of all supplies, implants, and consumables listed in this BOM at standard unit costs. Used for procedure-level cost analysis, budgeting, and value-based purchasing (VBP) initiatives.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:implantRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Implant Required Flag' ;
    rdfs:comment 'Indicates whether this BOM includes one or more implantable devices requiring UDI tracking and implant log documentation per FDA regulations. Triggers implant-specific workflows in the OR.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itemCount rdf:type rdf:Property ;
    rdfs:label 'Item Count' ;
    rdfs:comment 'Total number of distinct line items (supplies, implants, instruments, consumables) included in this BOM. Provides a quick summary metric for BOM complexity and case cart preparation effort.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:orRoomType rdf:type rdf:Property ;
    rdfs:label 'Or Room Type' ;
    rdfs:comment 'Type of operating room or procedural suite required for this procedure. Determines room-specific supply requirements and equipment availability for BOM fulfillment.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientPosition rdf:type rdf:Property ;
    rdfs:label 'Patient Position' ;
    rdfs:comment 'Standard patient positioning required for this procedure (e.g., supine, prone, lateral decubitus, lithotomy). Determines positioning equipment and padding supplies included in the BOM. [ENUM-REF-CANDIDATE: supine|prone|lateral_decubitus|lithotomy|trendelenburg|reverse_trendelenburg|sitting|jackknife — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureCategory rdf:type rdf:Property ;
    rdfs:label 'Procedure Category' ;
    rdfs:comment 'Clinical category grouping for the procedure (e.g., Orthopedic, Cardiovascular, Neurosurgery, General Surgery, Gynecology). Used for OR supply planning and service line reporting. [ENUM-REF-CANDIDATE: orthopedic|cardiovascular|neurosurgery|general_surgery|gynecology|urology|ophthalmology|plastics|thoracic|vascular — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureName rdf:type rdf:Property ;
    rdfs:label 'Procedure Name' ;
    rdfs:comment 'Internal clinical name of the surgical procedure as used within the facilitys OR scheduling and EHR systems (e.g., Laparoscopic Cholecystectomy). May differ slightly from the CPT description.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recallReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Recall Review Required Flag' ;
    rdfs:comment 'Indicates whether any item in this BOM is currently subject to an active FDA recall or safety alert, requiring review before case cart preparation proceeds.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Review Frequency Days' ;
    rdfs:comment 'Scheduled frequency in days at which this BOM must be reviewed and validated (e.g., 180 for semi-annual, 365 for annual). Drives compliance review scheduling.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceSystemBomCode rdf:type rdf:Property ;
    rdfs:label 'Source System Bom Code' ;
    rdfs:comment 'The native identifier of this BOM record in the originating operational system (e.g., Epic OpTime BOM ID, Infor Lawson BOM number). Enables cross-system reconciliation and ETL traceability.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sterileProcessingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Sterile Processing Required Flag' ;
    rdfs:comment 'Indicates whether instruments or reusable items in this BOM require sterile processing (decontamination, sterilization) prior to case use. Triggers sterile processing department (SPD) workflows.' ;
    rdfs:domain ind:SurgicalBom ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:substitutionAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Substitution Allowed Flag' ;
    rdfs:comment 'Indicates whether item-level substitutions are permitted when a listed supply is unavailable. When true, substitution rules defined at the BOM line level may be applied during case cart building.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseCartId rdf:type rdf:Property ;
    rdfs:label 'Case Cart Id' ;
    rdfs:comment 'Unique surrogate identifier for each surgical case cart record in the supply chain system. Primary key for the case_cart data product.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CaseCart .

ind:caseEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Case Employee Id' ;
    rdfs:comment 'Identifier of the sterile processing technician or supply chain staff member who assembled and picked the case cart items.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:orSuiteId rdf:type rdf:Property ;
    rdfs:label 'Or Suite Id' ;
    rdfs:comment 'Identifier of the Operating Room (OR) to which this case cart is assigned for the scheduled surgical procedure.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrSuite .

ind:recallNoticeId rdf:type rdf:Property ;
    rdfs:label 'Recall Notice Id' ;
    rdfs:comment 'Foreign key linking to supply.recall_notice. Business justification: case_cart has recall_flag. If a case cart is flagged for recall (item in cart is subject to active recall), it should link to the specific recall_notice for traceability and to enable notification wor' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecallNotice .

ind:surgicalCaseId rdf:type rdf:Property ;
    rdfs:label 'Surgical Case Id' ;
    rdfs:comment 'Reference to the scheduled surgical case for which this case cart was assembled. Links supply chain to surgical scheduling (OpTime/SurgiNet).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SurgicalCase .

ind:assemblyCompleteTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assembly Complete Timestamp' ;
    rdfs:comment 'Date and time when the case cart assembly was completed and verified by sterile processing staff.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assemblyLocation rdf:type rdf:Property ;
    rdfs:label 'Assembly Location' ;
    rdfs:comment 'Name or code of the sterile processing department (SPD) or supply room where the case cart was assembled (e.g., Central Sterile Processing, Satellite SPD-North).' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assemblyStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assembly Start Timestamp' ;
    rdfs:comment 'Date and time when sterile processing staff began physically assembling and picking items for this case cart.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assemblyStatus rdf:type rdf:Property ;
    rdfs:label 'Assembly Status' ;
    rdfs:comment 'Granular status of the physical picking and assembly process within sterile processing, distinct from the overall cart lifecycle status.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cartNumber rdf:type rdf:Property ;
    rdfs:label 'Cart Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned to the physical case cart by sterile processing or supply chain. Used for barcode scanning and physical tracking.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cartStatus rdf:type rdf:Property ;
    rdfs:label 'Cart Status' ;
    rdfs:comment 'Current lifecycle state of the case cart from initial request through assembly, delivery, use, and return. [ENUM-REF-CANDIDATE: requested|in_assembly|assembled|delivered|in_use|returned|cancelled — promote to reference product]' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseCartType rdf:type rdf:Property ;
    rdfs:label 'Case Cart Type' ;
    rdfs:comment 'Classification of the case cart indicating whether it was assembled from a standard preference card, customized for a specific patient, added on during a procedure, or assembled for an emergency case.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryConfirmationFlag rdf:type rdf:Property ;
    rdfs:label 'Delivery Confirmation Flag' ;
    rdfs:comment 'Indicates whether delivery of the case cart to the Operating Room (OR) has been formally confirmed by OR staff, completing the chain of custody.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expirationCheckFlag rdf:type rdf:Property ;
    rdfs:label 'Expiration Check Flag' ;
    rdfs:comment 'Indicates whether all items on the case cart have been verified for expiration date compliance prior to delivery. False indicates expiration verification is incomplete.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:implantFlag rdf:type rdf:Property ;
    rdfs:label 'Implant Flag' ;
    rdfs:comment 'Indicates whether this case cart contains one or more implantable devices subject to Unique Device Identifier (UDI) tracking requirements under FDA regulations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itemsPickedCount rdf:type rdf:Property ;
    rdfs:label 'Items Picked Count' ;
    rdfs:comment 'Total number of distinct line items actually picked and placed on the case cart during assembly. Compared against items_requested_count to identify shortages.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:itemsRequestedCount rdf:type rdf:Property ;
    rdfs:label 'Items Requested Count' ;
    rdfs:comment 'Total number of distinct line items requested on the case cart pick list per the surgeon preference card or BOM (Bill of Materials).' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:itemsReturnedCount rdf:type rdf:Property ;
    rdfs:label 'Items Returned Count' ;
    rdfs:comment 'Number of distinct item lines returned to supply chain or sterile processing after the surgical procedure, used for post-case reconciliation and restocking.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:itemsWastedCount rdf:type rdf:Property ;
    rdfs:label 'Items Wasted Count' ;
    rdfs:comment 'Number of distinct item lines disposed of as waste post-procedure (opened but unused, contaminated, or expired during the case), used for waste tracking and cost analysis.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:missingItemCount rdf:type rdf:Property ;
    rdfs:label 'Missing Item Count' ;
    rdfs:comment 'Number of distinct line items that were requested but could not be fulfilled during case cart assembly, providing granularity beyond the binary missing_item_flag.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:missingItemFlag rdf:type rdf:Property ;
    rdfs:label 'Missing Item Flag' ;
    rdfs:comment 'Indicates whether one or more requested items could not be picked and are missing from the assembled case cart. True signals a potential patient safety or surgical delay risk.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orRoomName rdf:type rdf:Property ;
    rdfs:label 'Or Room Name' ;
    rdfs:comment 'Human-readable name or designation of the Operating Room (OR) assigned to this case cart (e.g., OR-7, Main OR Suite 3).' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureType rdf:type rdf:Property ;
    rdfs:label 'Procedure Type' ;
    rdfs:comment 'Classification of the surgical procedure for which this case cart is assembled (e.g., orthopedic, cardiac, general surgery, neurosurgery). Drives item selection and BOM (Bill of Materials) requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recallFlag rdf:type rdf:Property ;
    rdfs:label 'Recall Flag' ;
    rdfs:comment 'Indicates whether any item on this case cart is subject to an active product recall. Triggers immediate hold and substitution workflows per recall management protocols.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnTimestamp rdf:type rdf:Property ;
    rdfs:label 'Return Timestamp' ;
    rdfs:comment 'Date and time the case cart was returned to sterile processing or supply chain after the surgical procedure concluded, initiating post-case reconciliation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledProcedureTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Procedure Time' ;
    rdfs:comment 'Precise date and time the surgical procedure is scheduled to begin, used for delivery timing and sterile processing workflow sequencing.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sterilityVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Sterility Verified Flag' ;
    rdfs:comment 'Indicates whether the sterility of all applicable items on the case cart has been confirmed by sterile processing staff prior to delivery to the OR.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:substitutionCount rdf:type rdf:Property ;
    rdfs:label 'Substitution Count' ;
    rdfs:comment 'Number of distinct item substitutions made during case cart assembly, used for supply chain performance analysis and preference card accuracy tracking.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:substitutionFlag rdf:type rdf:Property ;
    rdfs:label 'Substitution Flag' ;
    rdfs:comment 'Indicates whether one or more items on the case cart were substituted with an equivalent alternative due to stockout, recall, or expiration of the originally requested item.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalSupplyCost rdf:type rdf:Property ;
    rdfs:label 'Total Supply Cost' ;
    rdfs:comment 'Total cost of all supplies included in the case cart based on item unit costs at time of assembly. Used for surgical case costing, DRG (Diagnosis-Related Group) profitability analysis, and RCM (Revenue Cycle Management).' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:udiRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Udi Required Flag' ;
    rdfs:comment 'Indicates whether Unique Device Identifier (UDI) documentation is required for one or more items on this case cart, triggering mandatory UDI capture workflows per FDA regulations.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wasteCost rdf:type rdf:Property ;
    rdfs:label 'Waste Cost' ;
    rdfs:comment 'Total supply cost of items wasted or disposed of post-procedure, calculated from item unit costs. Used for supply chain cost management and surgical service line analytics.' ;
    rdfs:domain ind:CaseCart ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sterileProcessingRecordId rdf:type rdf:Property ;
    rdfs:label 'Sterile Processing Record Id' ;
    rdfs:comment 'Unique system-generated identifier for each sterile processing and reprocessing record within the Sterile Processing Department (SPD). Primary key for this entity.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supplyMaterialMasterId rdf:type rdf:Property ;
    rdfs:label 'Supply Material Master Id' ;
    rdfs:comment 'FK to supply.material_master.material_master_id' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:assemblyTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assembly Timestamp' ;
    rdfs:comment 'Date and time when the instrument set was assembled and inspected prior to packaging and sterilization. Supports full lifecycle tracking from decontamination through sterilization.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:biologicalIndicatorLot rdf:type rdf:Property ;
    rdfs:label 'Biological Indicator Lot' ;
    rdfs:comment 'Lot number of the biological indicator product used in this sterilization cycle. Required for traceability and documentation per AAMI and Joint Commission standards.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biologicalIndicatorResult rdf:type rdf:Property ;
    rdfs:label 'Biological Indicator Result' ;
    rdfs:comment 'Result of the biological indicator (BI) spore test used to verify sterilization efficacy. A pass (negative growth) confirms sterilization; fail (positive growth) triggers load recall. not_required applies to cycles exempt from BI testing per protocol.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bowieDickResult rdf:type rdf:Property ;
    rdfs:label 'Bowie Dick Result' ;
    rdfs:comment 'Result of the Bowie-Dick (air removal) test performed on pre-vacuum steam sterilizers to verify adequate air removal and steam penetration. Required daily before first processed load on pre-vacuum sterilizers.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chemicalIndicatorResult rdf:type rdf:Property ;
    rdfs:label 'Chemical Indicator Result' ;
    rdfs:comment 'Result of the chemical indicator (CI) used to monitor sterilization process parameters. Chemical indicators provide immediate visual confirmation that sterilization conditions were met, complementing biological indicator testing.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cycleNumber rdf:type rdf:Property ;
    rdfs:label 'Cycle Number' ;
    rdfs:comment 'Sequential cycle number assigned by the sterilizer unit for the specific run. Combined with sterilizer_id and sterilization_date, provides a unique reference for the physical sterilization event.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cycleType rdf:type rdf:Property ;
    rdfs:label 'Cycle Type' ;
    rdfs:comment 'The specific cycle program used within the sterilization method (e.g., gravity displacement, pre-vacuum/dynamic air removal, flash/immediate-use steam sterilization (IUSS), low-temperature). Determines exposure time and temperature parameters.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decontaminationMethod rdf:type rdf:Property ;
    rdfs:label 'Decontamination Method' ;
    rdfs:comment 'The decontamination protocol applied to the instrument set prior to sterilization (e.g., manual wash, automated washer-disinfector, ultrasonic cleaner). Documents the cleaning phase of the reprocessing cycle.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decontaminationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Decontamination Timestamp' ;
    rdfs:comment 'Date and time when the decontamination (cleaning) phase was completed for the instrument set. Establishes the start of the clean/sterile processing workflow.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:exposureTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Exposure Temperature C' ;
    rdfs:comment 'The sterilization chamber temperature in degrees Celsius recorded during the exposure phase of the cycle. Validated against cycle type parameters to confirm sterilization efficacy.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Exposure Time Minutes' ;
    rdfs:comment 'Duration in minutes of the sterilization exposure phase for this cycle. Must meet minimum exposure time requirements per sterilization method and cycle type.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityInspectionNotes rdf:type rdf:Property ;
    rdfs:label 'Facility Inspection Notes' ;
    rdfs:comment 'Free-text notes documenting findings from the instrument set inspection, including specific instruments flagged for damage, missing items, or functional defects identified during assembly.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityInspectionResult rdf:type rdf:Property ;
    rdfs:label 'Facility Inspection Result' ;
    rdfs:comment 'Result of the visual and functional inspection performed during assembly to verify instrument cleanliness, integrity, and functionality. fail or conditional results require instrument removal or repair before sterilization.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:immediateUseFlag rdf:type rdf:Property ;
    rdfs:label 'Immediate Use Flag' ;
    rdfs:comment 'Indicates whether this sterilization cycle was performed as Immediate Use Steam Sterilization (IUSS / flash sterilization) for an urgent clinical need. IUSS is subject to additional documentation and justification requirements per Joint Commission and AAMI standards.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:instrumentCount rdf:type rdf:Property ;
    rdfs:label 'Instrument Count' ;
    rdfs:comment 'Total number of individual instruments included in the set or tray at the time of assembly and sterilization. Used to verify completeness against the Bill of Materials (BOM) for the set.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:iussJustification rdf:type rdf:Property ;
    rdfs:label 'Iuss Justification' ;
    rdfs:comment 'Clinical justification documented for performing Immediate Use Steam Sterilization (IUSS). Required by The Joint Commission when IUSS is used; must document the reason the set could not be processed through standard sterilization workflow.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lifecycleStatus rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Status' ;
    rdfs:comment 'Current stage of the instrument set in its full reprocessing lifecycle: OR use → decontamination → assembly → sterilization → storage → dispatched. Enables real-time tracking of set location and readiness. [ENUM-REF-CANDIDATE: in_use|decontamination|assembly|sterilization|storage|dispatched|expired|recalled — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadNumber rdf:type rdf:Property ;
    rdfs:label 'Load Number' ;
    rdfs:comment 'Unique alphanumeric identifier assigned to a specific sterilizer load or batch. Used to trace all items processed together in a single sterilization cycle. Critical for recall management and lot traceability.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderSetCode rdf:type rdf:Property ;
    rdfs:label 'Order Set Code' ;
    rdfs:comment 'Facility-assigned alphanumeric code uniquely identifying the instrument set type within the CDM (Charge Description Master) or supply catalog. Used for inventory and billing alignment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderSetName rdf:type rdf:Property ;
    rdfs:label 'Order Set Name' ;
    rdfs:comment 'Human-readable name of the surgical instrument set or tray (e.g., Basic Laparoscopy Set, Orthopedic Hip Tray). Used for identification and workflow routing in the SPD.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packagingType rdf:type rdf:Property ;
    rdfs:label 'Packaging Type' ;
    rdfs:comment 'Type of packaging used to wrap or contain the instrument set for sterilization and sterile storage. Packaging type affects sterility maintenance duration and event-related sterility shelf life.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pressurePsi rdf:type rdf:Property ;
    rdfs:label 'Pressure Psi' ;
    rdfs:comment 'Chamber pressure in pounds per square inch (PSI) recorded during the sterilization cycle. Applicable primarily to steam sterilization; used to validate cycle parameters.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityAssuranceReviewedFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Assurance Reviewed Flag' ;
    rdfs:comment 'Indicates whether this sterilization record has been reviewed and approved by a quality assurance supervisor or SPD lead as part of the facilitys quality management program.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:releaseStatus rdf:type rdf:Property ;
    rdfs:label 'Release Status' ;
    rdfs:comment 'Current release status of the instrument set following sterilization. released indicates the set is cleared for clinical use; quarantined holds the set pending biological indicator results; recalled indicates a load recall event; rejected indicates failed cycle parameters.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reprocessingCycleCount rdf:type rdf:Property ;
    rdfs:label 'Reprocessing Cycle Count' ;
    rdfs:comment 'Cumulative number of times this instrument set has been reprocessed (sterilized) over its lifetime. Used to monitor instrument set wear, compliance with manufacturer reprocessing limits, and maintenance scheduling.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sterilizationMethod rdf:type rdf:Property ;
    rdfs:label 'Sterilization Method' ;
    rdfs:comment 'The sterilization modality applied to the instrument set. Common methods include steam (autoclave), ethylene oxide (ETO), hydrogen peroxide (plasma), dry heat, peracetic acid (Steris), and radiation. Governs cycle parameters and biological indicator requirements. [ENUM-REF-CANDIDATE: steam|ethylene_oxide|hydrogen_peroxide|dry_heat|peracetic_acid|radiation|formaldehyde — promote to reference product]' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sterilizationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sterilization Timestamp' ;
    rdfs:comment 'Date and time when the sterilization cycle was initiated or completed for this load. The principal business event timestamp for this record. Used for expiration date calculation and traceability.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:storageLocation rdf:type rdf:Property ;
    rdfs:label 'Storage Location' ;
    rdfs:comment 'Physical location where the sterilized instrument set is stored after release (e.g., sterile core room, OR storage cabinet, SPD shelf designation). Used for inventory management and retrieval.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trayWeightKg rdf:type rdf:Property ;
    rdfs:label 'Tray Weight Kg' ;
    rdfs:comment 'Total weight of the assembled instrument tray in kilograms at the time of sterilization. Used to verify compliance with maximum tray weight limits per AAMI guidelines (typically ≤ 25 lbs / 11.3 kg) to ensure steam penetration.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:washerLotNumber rdf:type rdf:Property ;
    rdfs:label 'Washer Lot Number' ;
    rdfs:comment 'Lot or cycle number assigned by the automated washer-disinfector used during the decontamination phase. Enables traceability of the cleaning cycle for quality and compliance audits.' ;
    rdfs:domain ind:SterileProcessingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialMasterId rdf:type rdf:Property ;
    rdfs:label 'Material Master Id' ;
    rdfs:comment 'Reference to the supply chain item master record for the recalled product, medical device, or implant. Links to the item catalog for inventory impact assessment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:notifiedPayerId rdf:type rdf:Property ;
    rdfs:label 'Notified Payer Id' ;
    rdfs:comment 'Foreign key linking to insurance.payer. Business justification: Payers require notification of recalls affecting their members for risk management and potential claims review. Real business process: regulatory reporting to payers for implantable device recalls, co' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:affectedLotNumberRange rdf:type rdf:Property ;
    rdfs:label 'Affected Lot Number Range' ;
    rdfs:comment 'Lot number or range of lot numbers affected by the recall as specified in the recall notice. Used to identify specific inventory batches and patient implant records that require assessment. May be a single lot, a range (e.g., LOT001-LOT050), or a pattern.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedSerialNumberRange rdf:type rdf:Property ;
    rdfs:label 'Affected Serial Number Range' ;
    rdfs:comment 'Serial number or range of serial numbers affected by the recall as specified in the recall notice. Applicable for serialized devices and implants. Complements lot number range for precise device identification.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expirationDateRangeEnd rdf:type rdf:Property ;
    rdfs:label 'Expiration Date Range End' ;
    rdfs:comment 'End of the expiration date range for products affected by the recall. Used with expiration_date_range_start to bound the affected expiration window for inventory identification.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expirationDateRangeStart rdf:type rdf:Property ;
    rdfs:label 'Expiration Date Range Start' ;
    rdfs:comment 'Start of the expiration date range for products affected by the recall. Supports identification of recalled items in inventory by expiration date when lot numbers are not available.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fdaNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Fda Notice Date' ;
    rdfs:comment 'Date the FDA publicly issued or posted the recall notice in the FDA Enforcement Report or MedWatch system. Used to track regulatory publication timelines and ensure timely organizational response.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financialCreditExpected rdf:type rdf:Property ;
    rdfs:label 'Financial Credit Expected' ;
    rdfs:comment 'Indicates whether the healthcare organization expects a financial credit or replacement from the vendor for returned or destroyed recalled products. Triggers accounts payable and procurement follow-up workflows.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:healthHazardAssessment rdf:type rdf:Property ;
    rdfs:label 'Health Hazard Assessment' ;
    rdfs:comment 'FDA or manufacturer health hazard evaluation narrative describing the potential clinical consequences of using the recalled product. Informs clinical decision-making and patient notification priority. Sourced from the official recall notice.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implantableDeviceFlag rdf:type rdf:Property ;
    rdfs:label 'Implantable Device Flag' ;
    rdfs:comment 'Indicates whether the recalled product is an implantable medical device subject to UDI tracking and mandatory patient implant registry requirements. Triggers enhanced patient impact assessment and long-term follow-up workflows.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalNotes rdf:type rdf:Property ;
    rdfs:label 'Internal Notes' ;
    rdfs:comment 'Free-text field for supply chain staff to document internal observations, escalation notes, communication logs, or special handling instructions related to the recall response. Not transmitted externally.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalReceiptDate rdf:type rdf:Property ;
    rdfs:label 'Internal Receipt Date' ;
    rdfs:comment 'Date the healthcare organizations supply chain or materials management team internally received and logged the recall notice. Marks the start of the internal response workflow and is distinct from the vendor notification date.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:manufactureDateRangeEnd rdf:type rdf:Property ;
    rdfs:label 'Manufacture Date Range End' ;
    rdfs:comment 'End of the manufacture date range for products affected by the recall. Used with manufacture_date_range_start to bound the affected production window for inventory and implant identification.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:manufactureDateRangeStart rdf:type rdf:Property ;
    rdfs:label 'Manufacture Date Range Start' ;
    rdfs:comment 'Start of the manufacture date range for products affected by the recall. Used in conjunction with manufacture_date_range_end to identify inventory and implanted devices by production date when lot/serial numbers are unavailable.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:patientImpactAssessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Patient Impact Assessment Status' ;
    rdfs:comment 'Current status of the clinical review to determine whether any patients received or were implanted with the recalled product. Drives patient notification workflows and adverse event reporting. Required for Class I and Class II recalls.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientsAffectedCount rdf:type rdf:Property ;
    rdfs:label 'Patients Affected Count' ;
    rdfs:comment 'Number of patients identified as having received, been implanted with, or otherwise exposed to the recalled product. Populated upon completion of the patient impact assessment. Drives patient notification and clinical follow-up workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:productCode rdf:type rdf:Property ;
    rdfs:label 'Product Code' ;
    rdfs:comment 'Manufacturer or FDA product code identifying the specific product line or model subject to recall. Used for cross-referencing with the item master and FDA product classification database.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityDestroyed rdf:type rdf:Property ;
    rdfs:label 'Quantity Destroyed' ;
    rdfs:comment 'Number of units of the recalled product that have been destroyed or disposed of on-site per recall instructions. Required for regulatory documentation when return to vendor is not feasible.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quantityOnHandAffected rdf:type rdf:Property ;
    rdfs:label 'Quantity On Hand Affected' ;
    rdfs:comment 'Total quantity of the recalled product currently held in the facilitys inventory that falls within the affected lot, serial, or date range. Used to assess inventory exposure and plan quarantine and return logistics.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quantityQuarantined rdf:type rdf:Property ;
    rdfs:label 'Quantity Quarantined' ;
    rdfs:comment 'Number of units of the recalled product that have been physically quarantined or placed on hold in inventory pending disposition. Tracks remediation progress against the total affected quantity on hand.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityReturnedToVendor rdf:type rdf:Property ;
    rdfs:label 'Quantity Returned To Vendor' ;
    rdfs:comment 'Number of units of the recalled product that have been returned to the vendor or manufacturer as part of the recall remediation process. Supports return merchandise authorization (RMA) tracking and financial credit reconciliation.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recallClass rdf:type rdf:Property ;
    rdfs:label 'Recall Class' ;
    rdfs:comment 'FDA-defined classification indicating the severity of health risk posed by the recalled product. Class I: serious adverse health consequences or death; Class II: temporary or medically reversible adverse health consequences; Class III: unlikely to cause adverse health consequences.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recallInitiationSource rdf:type rdf:Property ;
    rdfs:label 'Recall Initiation Source' ;
    rdfs:comment 'Identifies who initiated the recall action. Distinguishes between FDA-mandated recalls, voluntary manufacturer recalls, distributor-initiated recalls, Group Purchasing Organization (GPO) alerts, and state health department notifications.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recallNumber rdf:type rdf:Property ;
    rdfs:label 'Recall Number' ;
    rdfs:comment 'Official FDA-assigned or manufacturer-assigned recall identification number. Used as the primary external reference for cross-referencing with FDA MedWatch, regulatory databases, and vendor communications. Example: Z-1234-2024.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recallReasonCode rdf:type rdf:Property ;
    rdfs:label 'Recall Reason Code' ;
    rdfs:comment 'Standardized code categorizing the root cause or reason for the recall (e.g., sterility failure, labeling error, device malfunction, contamination, software defect). Aligns with FDA recall reason classification codes for regulatory reporting. [ENUM-REF-CANDIDATE: Sterility Failure|Labeling Error|Device Malfunction|Contamination|Software Defect|Packaging Defect|Material Defect|Design Defect|Manufacturing Defect|Other — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recallReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Recall Reason Description' ;
    rdfs:comment 'Detailed narrative description of the reason for the recall as stated in the official recall notice. Provides clinical and supply chain staff with the full context of the safety concern, defect, or hazard identified.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recallStatus rdf:type rdf:Property ;
    rdfs:label 'Recall Status' ;
    rdfs:comment 'Current lifecycle status of the recall notice within the healthcare organization. Tracks progression from initial receipt through assessment, remediation, and closure. Supports regulatory reporting and patient safety workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recallType rdf:type rdf:Property ;
    rdfs:label 'Recall Type' ;
    rdfs:comment 'Category of the recall action. Distinguishes between mandatory FDA recalls, voluntary market withdrawals, safety alerts, field corrections (in-place remediation), and hazard alerts issued by the manufacturer or FDA.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Date' ;
    rdfs:comment 'Date on which the regulatory report was submitted to the FDA, CMS, or other applicable governing body. Null if not yet submitted. Required for compliance audit trails.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReportSubmitted rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Submitted' ;
    rdfs:comment 'Indicates whether the required regulatory report (e.g., FDA MedWatch 3500A, CMS adverse event report) has been submitted to the applicable governing body. Required for Class I and Class II recalls and adverse event reporting compliance.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediationAction rdf:type rdf:Property ;
    rdfs:label 'Remediation Action' ;
    rdfs:comment 'Prescribed or completed remediation action for the recalled product as directed by the FDA or manufacturer recall notice. Determines the disposition workflow for affected inventory and guides supply chain response. [ENUM-REF-CANDIDATE: Return to Vendor|Destroy On-Site|Relabel|Repair|Replace|Quarantine Pending|No Action Required — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDueDate rdf:type rdf:Property ;
    rdfs:label 'Response Due Date' ;
    rdfs:comment 'Deadline by which the healthcare organization must complete its recall response, including inventory quarantine, patient impact assessment, and remediation actions. Typically defined by FDA guidance or internal policy based on recall class.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceDocument rdf:type rdf:Property ;
    rdfs:label 'Source Document' ;
    rdfs:comment 'Reference to the original recall notice document, such as an FDA Enforcement Report URL, manufacturer letter reference number, or document management system identifier. Provides traceability to the authoritative source of the recall.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:udiDeviceIdentifier rdf:type rdf:Property ;
    rdfs:label 'Udi Device Identifier' ;
    rdfs:comment 'The fixed portion of the Unique Device Identifier (UDI) that identifies the specific version or model of the recalled medical device. Conforms to FDA UDI system requirements for implantable and high-risk device tracking.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Vendor Notification Date' ;
    rdfs:comment 'Date on which the vendor or manufacturer formally notified the healthcare organization of the recall. Establishes the start of the organizations response timeline and is required for regulatory compliance documentation.' ;
    rdfs:domain ind:RecallNotice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vendorContractId rdf:type rdf:Property ;
    rdfs:label 'Vendor Contract Id' ;
    rdfs:comment 'Unique surrogate identifier for the vendor contract record in the supply chain data lakehouse. Primary key for the vendor_contract data product.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VendorContract .

ind:defaultChartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Default Chart Of Accounts Id' ;
    rdfs:comment 'Foreign key linking to finance.chart_of_accounts. Business justification: Contracts specify default GL accounts for automated invoice coding and accrual processing. Streamlines AP workflow and ensures consistent expense classification for contracted purchases.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:administrativeFeePct rdf:type rdf:Property ;
    rdfs:label 'Administrative Fee Pct' ;
    rdfs:comment 'Percentage of purchases under this GPO contract that the vendor remits to the GPO as an administrative fee (typically 2-3%). Relevant for GPO umbrella contracts; null for direct vendor contracts. Used for GPO fee reconciliation and OIG disclosure compliance.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualCommitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Commitment Amount' ;
    rdfs:comment 'The minimum annual spend or purchase volume (in contract currency) committed by the healthcare organization to maintain contracted pricing and GPO compliance tier. Failure to meet this threshold may result in pricing tier downgrade or contract non-compliance.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseUnitPrice rdf:type rdf:Property ;
    rdfs:label 'Base Unit Price' ;
    rdfs:comment 'The contracted base price per unit of measure for the primary item or item category covered by this contract. For tiered contracts, this represents the first-tier or floor price. Expressed in the contract currency.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Compliance Threshold Pct' ;
    rdfs:comment 'The minimum percentage of eligible purchases that must be made through this contract to maintain compliance status and contracted pricing (e.g., 80% of med-surg spend must route through the GPO contract). Monitored quarterly for GPO administrative fee reporting.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diversityClassification rdf:type rdf:Property ;
    rdfs:label 'Diversity Classification' ;
    rdfs:comment 'Specific diversity certification category of the vendor under this contract. MBE=Minority Business Enterprise, WBE=Women Business Enterprise, VOSB=Veteran-Owned Small Business, SDVOSB=Service-Disabled Veteran-Owned Small Business, SBE=Small Business Enterprise, HUBZone=Historically Underutilized Business Zone. Null or none if not diversity-certified. [ENUM-REF-CANDIDATE: MBE|WBE|VOSB|SDVOSB|SBE|HUBZone|none — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityContractDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Document Url' ;
    rdfs:comment 'Secure URL or document management system path to the executed contract document, amendments, and supporting exhibits. Enables direct access to the legal instrument from the supply chain data product for audit and compliance review.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityContractValue rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Value' ;
    rdfs:comment 'Total estimated or committed monetary value of the contract over its full term. Used for capital planning, budget allocation, and financial reporting. May be null for open-ended or indefinite-quantity contracts.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:freightTermsCode rdf:type rdf:Property ;
    rdfs:label 'Freight Terms Code' ;
    rdfs:comment 'Freight and shipping terms governing delivery cost responsibility under this contract. Determines whether freight is included in unit price, prepaid by vendor, or charged to the healthcare organization.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpoAffiliation rdf:type rdf:Property ;
    rdfs:label 'Gpo Affiliation' ;
    rdfs:comment 'Identifies the Group Purchasing Organization (GPO) umbrella under which this contract was awarded, if applicable. GPO-affiliated contracts carry member pricing and compliance commitment thresholds. Set to none for direct vendor or local contracts.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpoContractNumber rdf:type rdf:Property ;
    rdfs:label 'Gpo Contract Number' ;
    rdfs:comment 'The GPO-assigned contract number for umbrella agreements (e.g., Vizient contract ID, Premier contract reference). Used for GPO compliance reporting, member pricing validation, and administrative fee reconciliation. Null for non-GPO contracts.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDiversitySpend rdf:type rdf:Property ;
    rdfs:label 'Is Diversity Spend' ;
    rdfs:comment 'Indicates whether purchases under this contract qualify for diversity spend credit reporting (Minority-Owned, Women-Owned, Veteran-Owned, or Small Business Enterprise). Supports organizational diversity procurement reporting and regulatory compliance.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMemberPricing rdf:type rdf:Property ;
    rdfs:label 'Is Member Pricing' ;
    rdfs:comment 'Indicates whether this contract provides GPO member pricing, which is typically lower than list price and contingent on the organizations active GPO membership status. True for GPO umbrella contracts with member-specific pricing tiers.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSoleSourceJustified rdf:type rdf:Property ;
    rdfs:label 'Is Sole Source Justified' ;
    rdfs:comment 'Indicates whether this contract was awarded as a sole-source agreement with documented justification on file (e.g., proprietary technology, clinical preference, emergency procurement). Required for OIG compliance and audit trail for non-competitive awards.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentTermsCode rdf:type rdf:Property ;
    rdfs:label 'Payment Terms Code' ;
    rdfs:comment 'Standard payment terms code governing invoice settlement for purchases under this contract (e.g., NET30, NET60, 2/10NET30 for 2% early payment discount). Aligns with SAP S/4HANA FI payment terms configuration.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceEscalationCapPct rdf:type rdf:Property ;
    rdfs:label 'Price Escalation Cap Pct' ;
    rdfs:comment 'Maximum allowable annual price increase percentage negotiated in the contract (e.g., 0.0300 = 3.00% cap). Protects the healthcare organization from uncapped vendor price increases during the contract term. Null if no escalation clause exists.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pricingTierStructure rdf:type rdf:Property ;
    rdfs:label 'Pricing Tier Structure' ;
    rdfs:comment 'Describes the pricing model applied under this contract. Fixed pricing applies a single unit price; tiered volume pricing adjusts price based on purchase volume thresholds; market basket pricing ties to a defined product mix; cost-plus adds a margin to vendor cost; fee schedule uses a published rate table; index-linked ties to a commodity or inflation index.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productCategory rdf:type rdf:Property ;
    rdfs:label 'Product Category' ;
    rdfs:comment 'Primary supply category covered by this contract (e.g., Medical-Surgical Consumables, Implantable Devices, Pharmaceuticals, Capital Equipment, Laboratory Reagents, Sterile Processing Supplies). Aligns with the organizations supply chain taxonomy and GPO category codes.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebatePct rdf:type rdf:Property ;
    rdfs:label 'Rebate Pct' ;
    rdfs:comment 'Percentage of eligible purchases returned to the healthcare organization as a rebate from the vendor or GPO upon meeting volume or compliance thresholds. Expressed as a decimal (e.g., 0.0250 = 2.50%). Used for rebate accrual and cash flow forecasting.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebateTerms rdf:type rdf:Property ;
    rdfs:label 'Rebate Terms' ;
    rdfs:comment 'Narrative description of rebate eligibility conditions, payment schedule, and calculation methodology (e.g., Quarterly rebate paid within 45 days of quarter-end upon achieving $500K spend threshold). Supplements the numeric rebate_pct field.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalTermMonths rdf:type rdf:Property ;
    rdfs:label 'Renewal Term Months' ;
    rdfs:comment 'Duration in months of each renewal period for auto-renew or manual-renew contracts. Used to project the next expiration date upon renewal execution.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalType rdf:type rdf:Property ;
    rdfs:label 'Renewal Type' ;
    rdfs:comment 'Specifies how the contract renews at expiration. Auto-renew contracts extend automatically unless cancelled; manual renewal requires affirmative action; evergreen contracts have no fixed end date; one-time contracts do not renew.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapContractNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Contract Number' ;
    rdfs:comment 'Source system contract number from SAP S/4HANA MM (Materials Management) outline agreement or scheduling agreement. Used for cross-system reconciliation between Infor Lawson and SAP environments.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soleSourceJustification rdf:type rdf:Property ;
    rdfs:label 'Sole Source Justification' ;
    rdfs:comment 'Narrative justification for sole-source contract award, documenting the clinical, operational, or regulatory basis for non-competitive procurement (e.g., Only FDA-approved device for this indication, Physician preference item with clinical outcome data). Required when is_sole_source_justified is True.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Account Number' ;
    rdfs:comment 'The healthcare organizations account number assigned by the vendor or distributor. Used for order placement, EDI transactions, and vendor portal access. Distinct from the internal vendor_id.' ;
    rdfs:domain ind:VendorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationAuditId rdf:type rdf:Property ;
    rdfs:label 'Location Audit Id' ;
    rdfs:comment 'Unique identifier for this location-audit event record. Primary key.' ;
    rdfs:domain ind:LocationAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inventoryLocationId rdf:type rdf:Property ;
    rdfs:label 'Inventory Location Id' ;
    rdfs:comment 'Foreign key linking to the inventory location being audited' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InventoryLocation .

ind:auditorNotes rdf:type rdf:Property ;
    rdfs:label 'Auditor Notes' ;
    rdfs:comment 'Free-text notes recorded by the auditor specific to this location during this audit, capturing observations, context, or specific deficiencies.' ;
    rdfs:domain ind:LocationAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceScore rdf:type rdf:Property ;
    rdfs:label 'Compliance Score' ;
    rdfs:comment 'The compliance score or rating assigned to this location for this audit, typically a percentage or numeric rating. Explicitly identified in detection reasoning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:correctiveActionCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Completed Date' ;
    rdfs:comment 'The date when corrective actions for findings at this location were verified as completed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpRequired rdf:type rdf:Property ;
    rdfs:label 'Follow Up Required' ;
    rdfs:comment 'Indicates whether corrective action or follow-up is required for this location based on this audits findings. Explicitly identified in detection reasoning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:locationStatusAtAudit rdf:type rdf:Property ;
    rdfs:label 'Location Status At Audit' ;
    rdfs:comment 'The operational status of the inventory location at the time of the audit, captured for historical accuracy and trend analysis.' ;
    rdfs:domain ind:LocationAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialPolicyGovernanceId rdf:type rdf:Property ;
    rdfs:label 'Material Policy Governance Id' ;
    rdfs:comment 'Primary key for the material_policy_governance association' ;
    rdfs:domain ind:MaterialPolicyGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentExceptionJustification rdf:type rdf:Property ;
    rdfs:label 'Consent Exception Justification' ;
    rdfs:comment 'Business justification for granting a policy exception to this material. Required when exception_flag is true. Documents clinical necessity, cost considerations, or other rationale.' ;
    rdfs:domain ind:MaterialPolicyGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governanceNotes rdf:type rdf:Property ;
    rdfs:label 'Governance Notes' ;
    rdfs:comment 'Free-text notes documenting special considerations, historical context, or ongoing issues related to this materials governance under this policy.' ;
    rdfs:domain ind:MaterialPolicyGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerRole rdf:type rdf:Property ;
    rdfs:label 'Reviewer Role' ;
    rdfs:comment 'Role or department responsible for reviewing this materials compliance with this policy (e.g., Pharmacy Director, Value Analysis Committee, Clinical Engineering).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentVendorSiteId rdf:type rdf:Property ;
    rdfs:label 'Parent Vendor Site Id' ;
    rdfs:comment 'Self-referencing FK on vendor_site (parent_vendor_site_id)' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VendorSite .

ind:erpSiteCode rdf:type rdf:Property ;
    rdfs:label 'Erp Site Code' ;
    rdfs:comment 'Vendor site identifier in the integrated ERP system (Infor Lawson or SAP MM).' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glnNumber rdf:type rdf:Property ;
    rdfs:label 'Gln Number' ;
    rdfs:comment 'Thirteen-digit GS1 Global Location Number uniquely identifying the vendor site location.' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incoterms rdf:type rdf:Property ;
    rdfs:label 'Incoterms' ;
    rdfs:comment 'Standard Incoterms code defining delivery and risk transfer terms for this vendor site.' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isApprovedForMedicalDevices rdf:type rdf:Property ;
    rdfs:label 'Is Approved For Medical Devices' ;
    rdfs:comment 'Indicates whether this vendor site is approved to supply medical devices and implantable products.' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isApprovedForPharmaceuticals rdf:type rdf:Property ;
    rdfs:label 'Is Approved For Pharmaceuticals' ;
    rdfs:comment 'Indicates whether this vendor site is approved to supply pharmaceutical products.' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPreferredSite rdf:type rdf:Property ;
    rdfs:label 'Is Preferred Site' ;
    rdfs:comment 'Indicates whether this vendor site is designated as a preferred sourcing location.' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Lead Time Days' ;
    rdfs:comment 'Standard lead time in days for order fulfillment from this vendor site.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumOrderAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Order Amount' ;
    rdfs:comment 'Minimum order value required for purchases from this vendor site.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextAuditDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Audit Due Date' ;
    rdfs:comment 'Scheduled date for the next quality or compliance audit at the vendor site.' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:onTimeDeliveryPercentage rdf:type rdf:Property ;
    rdfs:label 'On Time Delivery Percentage' ;
    rdfs:comment 'Percentage of orders delivered on time by this vendor site, calculated over a rolling period.' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceRating rdf:type rdf:Property ;
    rdfs:label 'Performance Rating' ;
    rdfs:comment 'Overall performance rating of the vendor site based on quality, delivery, and service metrics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactTitle rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Title' ;
    rdfs:comment 'Job title or role of the primary contact person at the vendor site.' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityCertification rdf:type rdf:Property ;
    rdfs:label 'Quality Certification' ;
    rdfs:comment 'Quality management system certifications held by the vendor site (e.g., ISO 9001, ISO 13485).' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityDefectRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Quality Defect Rate Percentage' ;
    rdfs:comment 'Percentage of received items from this vendor site that failed quality inspection.' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shippingMethod rdf:type rdf:Property ;
    rdfs:label 'Shipping Method' ;
    rdfs:comment 'Primary shipping method used by this vendor site for order delivery.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteCode rdf:type rdf:Property ;
    rdfs:label 'Site Code' ;
    rdfs:comment 'Unique business identifier code for the vendor site, used in procurement and inventory systems.' ;
    rdfs:domain ind:VendorSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteName rdf:type rdf:Property ;
    rdfs:label 'Site Name' ;
    rdfs:comment 'The business name or designation of the vendor site location.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteStatus rdf:type rdf:Property ;
    rdfs:label 'Site Status' ;
    rdfs:comment 'Current operational status of the vendor site in the procurement system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteType rdf:type rdf:Property ;
    rdfs:label 'Site Type' ;
    rdfs:comment 'Classification of the vendor site based on its primary business function.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Parent Care Site Id' ;
    rdfs:comment 'Reference to the parent care site in the organizational hierarchy, enabling health system→region→market→campus→site relationships. Null for top-level health system entities.' ;
    rdfs:domain ind:CareSite ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:ccn rdf:type rdf:Property ;
    rdfs:label 'Ccn' ;
    rdfs:comment 'Six-character CMS Certification Number (formerly Provider Number) assigned to Medicare-certified facilities. First two digits indicate state, third-fourth indicate facility type.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:county rdf:type rdf:Property ;
    rdfs:label 'County' ;
    rdfs:comment 'County or parish where the care site is located. Used for public health reporting, certificate of need (CON) analysis, and regional health planning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalAccessHospital rdf:type rdf:Property ;
    rdfs:label 'Critical Access Hospital' ;
    rdfs:comment 'Indicates whether the facility is designated as a Critical Access Hospital under the Medicare Rural Hospital Flexibility Program. CAH status provides cost-based reimbursement and reduced regulatory requirements.' ;
    rdfs:domain ind:CareSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disproportionateShareHospital rdf:type rdf:Property ;
    rdfs:label 'Disproportionate Share Hospital' ;
    rdfs:comment 'Indicates whether the facility qualifies for Medicare DSH payments due to serving a disproportionate share of low-income patients. Affects Medicare reimbursement rates.' ;
    rdfs:domain ind:CareSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyServicesAvailable rdf:type rdf:Property ;
    rdfs:label 'Emergency Services Available' ;
    rdfs:comment 'Indicates whether the care site operates a 24/7 emergency department. Determines EMTALA obligations, EMS transport protocols, and trauma network participation.' ;
    rdfs:domain ind:CareSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hierarchyEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Effective Date' ;
    rdfs:comment 'Date the current organizational hierarchy relationship became effective. Supports time-variant hierarchy reporting for mergers, acquisitions, and reorganizations.' ;
    rdfs:domain ind:CareSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licensedBedCapacity rdf:type rdf:Property ;
    rdfs:label 'Licensed Bed Capacity' ;
    rdfs:comment 'Total number of inpatient beds the facility is licensed to operate by the state health department. Determines staffing requirements, certificate of need compliance, and CMS cost report bed counts.' ;
    rdfs:domain ind:CareSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:licensureStatus rdf:type rdf:Property ;
    rdfs:label 'Licensure Status' ;
    rdfs:comment 'Current state of the facility license issued by the state health department. Active status is required for legal operation and Medicare/Medicaid participation.' ;
    rdfs:domain ind:CareSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidProviderNumber rdf:type rdf:Property ;
    rdfs:label 'Medicaid Provider Number' ;
    rdfs:comment 'State-specific Medicaid provider identification number. Required for Medicaid claims submission and varies by state Medicaid program.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicareProviderNumber rdf:type rdf:Property ;
    rdfs:label 'Medicare Provider Number' ;
    rdfs:comment 'Legacy Medicare provider identification number, now replaced by CCN but still used in some legacy systems and historical reporting.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipType rdf:type rdf:Property ;
    rdfs:label 'Ownership Type' ;
    rdfs:comment 'Legal ownership structure of the care site. Determines tax status, regulatory oversight, and eligibility for certain federal programs and grants.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:siteNpi rdf:type rdf:Property ;
    rdfs:label 'Site Npi' ;
    rdfs:comment 'Type 2 NPI assigned to the organizational care site by CMS for billing and identification purposes. Required for Medicare/Medicaid claims submission.' ;
    rdfs:domain ind:CareSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soleCommunityHospital rdf:type rdf:Property ;
    rdfs:label 'Sole Community Hospital' ;
    rdfs:comment 'Indicates whether the facility is designated as a Sole Community Hospital, providing enhanced Medicare reimbursement for rural hospitals that are the sole source of care in their area.' ;
    rdfs:domain ind:CareSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:staffedBedCapacity rdf:type rdf:Property ;
    rdfs:label 'Staffed Bed Capacity' ;
    rdfs:comment 'Number of beds currently staffed and available for patient occupancy. May be less than licensed capacity due to staffing constraints or seasonal demand patterns.' ;
    rdfs:domain ind:CareSite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:teachingStatus rdf:type rdf:Property ;
    rdfs:label 'Teaching Status' ;
    rdfs:comment 'Indicates whether the facility is a teaching hospital with approved residency programs. Teaching status affects CMS reimbursement through Graduate Medical Education (GME) payments and indirect medical education (IME) adjustments.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:traumaLevel rdf:type rdf:Property ;
    rdfs:label 'Trauma Level' ;
    rdfs:comment 'American College of Surgeons trauma center verification level. Indicates capability to provide comprehensive trauma care and determines EMS transport protocols.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buildingId rdf:type rdf:Property ;
    rdfs:label 'Building Id' ;
    rdfs:comment 'Unique identifier for the building. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Building .

ind:propertyTaxParcelGeographicRegionId rdf:type rdf:Property ;
    rdfs:label 'Property Tax Parcel Geographic Region Id' ;
    rdfs:comment 'Foreign key linking to reference.geographic_region. Business justification: Property parcels must be classified by geographic region for HSA/HRR assignment, regional health planning, certificate of need applications, and CMS geographic adjustment factors. Essential for facili' ;
    rdfs:domain ind:Building ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeographicRegion .

ind:adaCompliant rdf:type rdf:Property ;
    rdfs:label 'Ada Compliant' ;
    rdfs:comment 'Indicates whether the building meets Americans with Disabilities Act accessibility requirements including ramps, elevators, restrooms, and signage.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualPropertyTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Property Tax Amount' ;
    rdfs:comment 'Annual property tax liability for the building in US dollars. Used for budgeting and financial planning.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:buildingCode rdf:type rdf:Property ;
    rdfs:label 'Building Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the building for internal identification and facility management systems. Used in SAP PM and facility operations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buildingName rdf:type rdf:Property ;
    rdfs:label 'Building Name' ;
    rdfs:comment 'Official name of the building as recognized by the organization and used in signage, wayfinding, and facility documentation.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buildingType rdf:type rdf:Property ;
    rdfs:label 'Building Type' ;
    rdfs:comment 'Primary functional classification of the building indicating its predominant use within the healthcare delivery network.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionYear rdf:type rdf:Property ;
    rdfs:label 'Construction Year' ;
    rdfs:comment 'Year the building was originally constructed. Used for capital planning, depreciation calculations, and facility lifecycle management.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:electricalServiceCapacityKva rdf:type rdf:Property ;
    rdfs:label 'Electrical Service Capacity Kva' ;
    rdfs:comment 'Total electrical service capacity of the building measured in kilovolt-amperes. Used for load planning, equipment installation approval, and utility management.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emergencyGeneratorCapacityKw rdf:type rdf:Property ;
    rdfs:label 'Emergency Generator Capacity Kw' ;
    rdfs:comment 'Total capacity of emergency backup generator systems in kilowatts. Critical for life safety systems, operating rooms, intensive care units, and emergency departments.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emergencyGeneratorCoverageType rdf:type rdf:Property ;
    rdfs:label 'Emergency Generator Coverage Type' ;
    rdfs:comment 'Scope of building systems and areas covered by emergency generator backup power. Determines operational resilience during utility outages.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityLicenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Facility License Expiration Date' ;
    rdfs:comment 'Expiration date of the state facility license. Tracked for renewal planning and regulatory compliance monitoring.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilityLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Facility License Number' ;
    rdfs:comment 'State-issued license number authorizing operation of healthcare services within the building. Required for regulatory compliance and reimbursement.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireSafetyClassification rdf:type rdf:Property ;
    rdfs:label 'Fire Safety Classification' ;
    rdfs:comment 'Building construction type classification based on fire resistance ratings and combustibility of structural elements per International Building Code.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossSquareFootage rdf:type rdf:Property ;
    rdfs:label 'Gross Square Footage' ;
    rdfs:comment 'Total interior floor area of the building measured in square feet, including all floors and spaces. Used for space utilization analysis and facility cost allocation.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:helipadAvailable rdf:type rdf:Property ;
    rdfs:label 'Helipad Available' ;
    rdfs:comment 'Indicates whether the building has a rooftop or ground-level helipad for emergency medical transport. Critical for trauma centers and tertiary care facilities.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hvacSystemType rdf:type rdf:Property ;
    rdfs:label 'Hvac System Type' ;
    rdfs:comment 'Primary type of heating, ventilation, and air conditioning system serving the building. Critical for infection control, environmental services, and energy management.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jointCommissionAccreditationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Joint Commission Accreditation Expiration Date' ;
    rdfs:comment 'Expiration date of The Joint Commission accreditation. Tracked for survey preparation and continuous compliance.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:jointCommissionAccreditationStatus rdf:type rdf:Property ;
    rdfs:label 'Joint Commission Accreditation Status' ;
    rdfs:comment 'Current accreditation status from The Joint Commission indicating compliance with national healthcare quality and safety standards.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastMajorRenovationYear rdf:type rdf:Property ;
    rdfs:label 'Last Major Renovation Year' ;
    rdfs:comment 'Year of the most recent major renovation or significant capital improvement project affecting the building structure or systems.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leedCertificationLevel rdf:type rdf:Property ;
    rdfs:label 'Leed Certification Level' ;
    rdfs:comment 'Level of LEED green building certification achieved by the building. Indicates sustainability performance and environmental design standards.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalGasSystemInstalled rdf:type rdf:Property ;
    rdfs:label 'Medical Gas System Installed' ;
    rdfs:comment 'Indicates whether the building has a medical gas distribution system for oxygen, medical air, nitrous oxide, and vacuum services. Required for clinical buildings.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netUsableSquareFootage rdf:type rdf:Property ;
    rdfs:label 'Net Usable Square Footage' ;
    rdfs:comment 'Usable interior floor area excluding mechanical spaces, circulation, and structural elements. Used for space planning and departmental allocation.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfElevators rdf:type rdf:Property ;
    rdfs:label 'Number Of Elevators' ;
    rdfs:comment 'Total count of passenger and service elevators installed in the building. Used for vertical transportation capacity planning and maintenance scheduling.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfFloors rdf:type rdf:Property ;
    rdfs:label 'Number Of Floors' ;
    rdfs:comment 'Total count of floors in the building including basement and sub-basement levels. Used for elevator planning, emergency evacuation, and vertical transportation analysis.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parkingSpacesCount rdf:type rdf:Property ;
    rdfs:label 'Parking Spaces Count' ;
    rdfs:comment 'Total number of parking spaces associated with or adjacent to the building. Used for access planning, patient experience, and workforce management.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:propertyTaxParcelNumber rdf:type rdf:Property ;
    rdfs:label 'Property Tax Parcel Number' ;
    rdfs:comment 'Local government assessor parcel number used for property tax assessment and real estate records.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementValueAmount rdf:type rdf:Property ;
    rdfs:label 'Replacement Value Amount' ;
    rdfs:comment 'Estimated cost to replace the building at current construction prices. Used for insurance coverage determination and capital planning.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:seismicZone rdf:type rdf:Property ;
    rdfs:label 'Seismic Zone' ;
    rdfs:comment 'Seismic design category or zone classification indicating the level of earthquake risk and required structural design standards for the building location.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sprinklerSystemType rdf:type rdf:Property ;
    rdfs:label 'Sprinkler System Type' ;
    rdfs:comment 'Type of automatic fire sprinkler system installed in the building. Critical for fire safety compliance and insurance underwriting.' ;
    rdfs:domain ind:Building ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitId rdf:type rdf:Property ;
    rdfs:label 'Unit Id' ;
    rdfs:comment 'Unique identifier for the clinical or administrative unit within the healthcare facility. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Unit .

ind:managerClinicianId rdf:type rdf:Property ;
    rdfs:label 'Manager Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Unit management accountability requires linking the manager to their clinician record for credentialing verification, privileging status, and regulatory reporting. Hospitals must track which credentia' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:acceptsAdmissions rdf:type rdf:Property ;
    rdfs:label 'Accepts Admissions' ;
    rdfs:comment 'Boolean flag indicating whether the unit is currently accepting new patient admissions. False when the unit is at capacity, under diversion, or temporarily closed to new admissions.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acceptsTransfers rdf:type rdf:Property ;
    rdfs:label 'Accepts Transfers' ;
    rdfs:comment 'Boolean flag indicating whether the unit is currently accepting patient transfers from other units or facilities. Used in bed management and patient flow coordination.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acuityLevel rdf:type rdf:Property ;
    rdfs:label 'Acuity Level' ;
    rdfs:comment 'Typical patient acuity level served by the unit. Critical (ICU, CCU), acute (step-down, telemetry), intermediate (med-surg), general (rehab, skilled nursing), ambulatory (outpatient clinics).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:airChangesPerHour rdf:type rdf:Property ;
    rdfs:label 'Air Changes Per Hour' ;
    rdfs:comment 'Number of complete air changes per hour in the unit. Minimum 6 ACH for general patient rooms, 12+ ACH for isolation rooms, 15+ ACH for operating rooms per ASHRAE and CDC guidelines.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:chestPainCenterAccreditation rdf:type rdf:Property ;
    rdfs:label 'Chest Pain Center Accreditation' ;
    rdfs:comment 'Boolean flag indicating whether the unit (typically ED or cardiac unit) holds accreditation as a Chest Pain Center from the American College of Cardiology or Society of Cardiovascular Patient Care.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electronicHealthRecordSystem rdf:type rdf:Property ;
    rdfs:label 'Electronic Health Record System' ;
    rdfs:comment 'Name and version of the Electronic Health Record (EHR) system used in the unit, such as Epic Hyperspace 2023, Cerner Millennium PowerChart, or MEDITECH Expanse. Used for interoperability and training planning.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyPowerBackup rdf:type rdf:Property ;
    rdfs:label 'Emergency Power Backup' ;
    rdfs:comment 'Boolean flag indicating whether the unit has emergency generator backup power. Required for critical care units (ICU, OR, ED, NICU) per NFPA 99 and Joint Commission Life Safety Standards.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:floorNumber rdf:type rdf:Property ;
    rdfs:label 'Floor Number' ;
    rdfs:comment 'Physical floor or level within the building where the unit is located. May be numeric (1, 2, 3) or alphanumeric (G for ground, B1 for basement 1, M for mezzanine).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infectionControlZone rdf:type rdf:Property ;
    rdfs:label 'Infection Control Zone' ;
    rdfs:comment 'Infection control risk classification for the unit. Standard (general units), enhanced (oncology, transplant), high-risk (ICU, burn unit), isolation (dedicated infectious disease units). Drives environmental services protocols.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isTwentyFourSeven rdf:type rdf:Property ;
    rdfs:label 'Is Twenty Four Seven' ;
    rdfs:comment 'Boolean flag indicating whether the unit operates 24 hours a day, 7 days a week. True for ICU, ED, inpatient floors. False for outpatient clinics, procedural units with scheduled hours.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isolationRoomCount rdf:type rdf:Property ;
    rdfs:label 'Isolation Room Count' ;
    rdfs:comment 'Number of isolation rooms within the unit designed for patients requiring infection control precautions (contact, droplet, or airborne isolation). Critical for infection prevention and Healthcare-Associated Infection (HAI) management.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:licensedBedCount rdf:type rdf:Property ;
    rdfs:label 'Licensed Bed Count' ;
    rdfs:comment 'Total number of beds the unit is licensed to operate by state or federal regulatory authorities. This is the maximum legal capacity and is reported to CMS and state health departments.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:magnetRecognition rdf:type rdf:Property ;
    rdfs:label 'Magnet Recognition' ;
    rdfs:comment 'Boolean flag indicating whether the unit is part of a Magnet-recognized nursing program by the American Nurses Credentialing Center (ANCC). Magnet recognition signifies excellence in nursing care and patient outcomes.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalGasSystem rdf:type rdf:Property ;
    rdfs:label 'Medical Gas System' ;
    rdfs:comment 'Type of medical gas system installed in the unit, such as Oxygen, Medical Air, Vacuum, Full Surgical Suite Gases (O2, N2O, Medical Air, Vacuum), or None. Critical for clinical operations and safety inspections.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:negativePressureRoomCount rdf:type rdf:Property ;
    rdfs:label 'Negative Pressure Room Count' ;
    rdfs:comment 'Number of negative pressure (airborne infection isolation) rooms within the unit, used for patients with airborne infectious diseases such as tuberculosis, measles, or COVID-19. Subset of isolation rooms.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nurseCallSystemType rdf:type rdf:Property ;
    rdfs:label 'Nurse Call System Type' ;
    rdfs:comment 'Type of nurse call system installed in the unit, such as Wired Pillow Speaker, Wireless Badge System, Integrated EMR Alert System, or Mobile App-Based. Used for patient safety and response time monitoring.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nurseToPatientRatio rdf:type rdf:Property ;
    rdfs:label 'Nurse To Patient Ratio' ;
    rdfs:comment 'Target nurse-to-patient staffing ratio for the unit, expressed as 1:X (e.g., 1:2 for ICU, 1:4 for step-down, 1:6 for med-surg). Used for staffing planning and quality benchmarking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalHoursEnd rdf:type rdf:Property ;
    rdfs:label 'Operational Hours End' ;
    rdfs:comment 'Daily end time for unit operations in HH:MM 24-hour format. For 24/7 units, this is typically 23:59. For outpatient or procedural units, this reflects scheduled closing time.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalHoursStart rdf:type rdf:Property ;
    rdfs:label 'Operational Hours Start' ;
    rdfs:comment 'Daily start time for unit operations in HH:MM 24-hour format. For 24/7 units (ICU, ED), this is typically 00:00. For outpatient or procedural units, this reflects scheduled opening time.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueCenterCode rdf:type rdf:Property ;
    rdfs:label 'Revenue Center Code' ;
    rdfs:comment 'Four-digit revenue center code used on UB-04 claims for billing and reimbursement. Maps to CMS revenue code standards (e.g., 0100-0219 for room and board, 0300-0329 for laboratory).' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyServiceLine rdf:type rdf:Property ;
    rdfs:label 'Specialty Service Line' ;
    rdfs:comment 'Clinical specialty or service line associated with the unit, such as Cardiology, Oncology, Pediatrics, Orthopedics, Neurology, General Surgery, Obstetrics, or Behavioral Health. Supports clinical analytics and resource planning.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:squareFootage rdf:type rdf:Property ;
    rdfs:label 'Square Footage' ;
    rdfs:comment 'Total square footage of the units physical space. Used for facility planning, space utilization analysis, and environmental services scheduling.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:staffedBedCount rdf:type rdf:Property ;
    rdfs:label 'Staffed Bed Count' ;
    rdfs:comment 'Number of beds currently staffed and available for patient occupancy. Staffed bed count is typically less than or equal to licensed bed count and reflects actual operational capacity based on workforce availability.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:strokeCenterDesignation rdf:type rdf:Property ;
    rdfs:label 'Stroke Center Designation' ;
    rdfs:comment 'Stroke center certification level for units providing acute stroke care. Comprehensive (highest), primary, acute stroke ready, or not designated. Impacts patient routing and quality reporting.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teachingUnitFlag rdf:type rdf:Property ;
    rdfs:label 'Teaching Unit Flag' ;
    rdfs:comment 'Boolean flag indicating whether the unit is designated as a teaching unit where medical residents, fellows, nursing students, or other trainees receive clinical education. Impacts staffing models and documentation requirements.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telemetryMonitoringCapability rdf:type rdf:Property ;
    rdfs:label 'Telemetry Monitoring Capability' ;
    rdfs:comment 'Boolean flag indicating whether the unit has continuous cardiac telemetry monitoring capability. True for ICU, CCU, step-down, and telemetry units. False for general med-surg and outpatient units.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unitCode rdf:type rdf:Property ;
    rdfs:label 'Unit Code' ;
    rdfs:comment 'Short alphanumeric code used to identify the unit in operational systems, scheduling, and Admit Discharge Transfer (ADT) workflows. Typically 2-10 characters.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitName rdf:type rdf:Property ;
    rdfs:label 'Unit Name' ;
    rdfs:comment 'Full descriptive name of the unit, such as Medical Surgical Floor 3 West, Intensive Care Unit (ICU) North, Emergency Department (ED) Main, or Operating Room (OR) Suite B.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitStatus rdf:type rdf:Property ;
    rdfs:label 'Unit Status' ;
    rdfs:comment 'Current operational status of the unit. Active units are open and accepting patients. Inactive or temporarily closed units are not operational. Under construction units are being built or renovated. Decommissioned units are permanently closed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitType rdf:type rdf:Property ;
    rdfs:label 'Unit Type' ;
    rdfs:comment 'High-level classification of the units operational purpose: inpatient (patient stays overnight), outpatient (same-day care), procedural (OR, cath lab), diagnostic (radiology, lab), administrative (offices), or support (pharmacy, supply).' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wingOrSection rdf:type rdf:Property ;
    rdfs:label 'Wing Or Section' ;
    rdfs:comment 'Wing, section, or zone designation within the floor, such as North, South, East, West, Tower A, Pavilion B. Used for wayfinding and spatial organization.' ;
    rdfs:domain ind:Unit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roomId rdf:type rdf:Property ;
    rdfs:label 'Room Id' ;
    rdfs:comment 'Unique identifier for the room. Primary key for the room entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Room .

ind:workforceOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Workforce Org Unit Id' ;
    rdfs:comment 'Reference to the clinical department or service line that has primary operational responsibility for this room. Used for scheduling, cost allocation, and resource management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:adaCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Ada Compliant Flag' ;
    rdfs:comment 'Indicates whether the room meets ADA accessibility requirements for patients and staff with disabilities. Required for regulatory compliance and patient access.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bariatricCapableFlag rdf:type rdf:Property ;
    rdfs:label 'Bariatric Capable Flag' ;
    rdfs:comment 'Indicates whether the room is equipped and structurally reinforced to accommodate bariatric patients (typically over 350 lbs). Includes specialized beds, lifts, and wider doorways.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bedCount rdf:type rdf:Property ;
    rdfs:label 'Bed Count' ;
    rdfs:comment 'Number of patient beds or stretchers that can be accommodated in the room. Used for bed management, capacity planning, and CMS reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:boomConfiguration rdf:type rdf:Property ;
    rdfs:label 'Boom Configuration' ;
    rdfs:comment 'Description of ceiling-mounted equipment boom configuration in the room (e.g., single boom, dual boom, articulating arm). Relevant for OR and ICU rooms with suspended equipment.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveFromDate rdf:type rdf:Property ;
    rdfs:label 'Effective From Date' ;
    rdfs:comment 'Date from which the current room configuration, assignment, or status became effective. Supports temporal tracking and historical analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveToDate rdf:type rdf:Property ;
    rdfs:label 'Effective To Date' ;
    rdfs:comment 'Date until which the current room configuration, assignment, or status is valid. Null indicates current/active record. Supports temporal tracking and historical analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:emergencyPowerFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Power Flag' ;
    rdfs:comment 'Indicates whether the room is connected to emergency backup power systems. Critical for life-safety equipment in ORs, ICUs, and emergency departments.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:handHygieneStationCount rdf:type rdf:Property ;
    rdfs:label 'Hand Hygiene Station Count' ;
    rdfs:comment 'Number of hand hygiene stations (sinks or alcohol-based hand rub dispensers) in the room. Critical for infection prevention compliance and Joint Commission accreditation.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hvacAirExchangeRate rdf:type rdf:Property ;
    rdfs:label 'Hvac Air Exchange Rate' ;
    rdfs:comment 'Number of complete air changes per hour (ACH) provided by the HVAC system. Critical for infection control, OR sterility, and regulatory compliance per ASHRAE 170.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:imagingIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Imaging Integration Flag' ;
    rdfs:comment 'Indicates whether the room has integrated imaging equipment (e.g., C-arm, fluoroscopy, intraoperative CT/MRI). Common in hybrid ORs and interventional procedure rooms.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isolationCapableFlag rdf:type rdf:Property ;
    rdfs:label 'Isolation Capable Flag' ;
    rdfs:comment 'Indicates whether the room is equipped and certified for isolation of infectious patients. Critical for infection prevention and control workflows.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastDeepCleanDate rdf:type rdf:Property ;
    rdfs:label 'Last Deep Clean Date' ;
    rdfs:comment 'Date of the most recent terminal or deep cleaning of the room. Used for infection prevention tracking, environmental services scheduling, and outbreak investigation.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Inspection Date' ;
    rdfs:comment 'Date of the most recent regulatory or safety inspection of the room. Used for compliance tracking and accreditation readiness.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leaseOwnershipIndicator rdf:type rdf:Property ;
    rdfs:label 'Lease Ownership Indicator' ;
    rdfs:comment 'Indicates whether the room space is owned by the organization, leased from a third party, shared with another entity, or contracted. Impacts financial reporting and cost allocation.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalAirOutletCount rdf:type rdf:Property ;
    rdfs:label 'Medical Air Outlet Count' ;
    rdfs:comment 'Number of medical air outlets for compressed air delivery. Used for respiratory therapy and surgical equipment.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:monthlySpaceCost rdf:type rdf:Property ;
    rdfs:label 'Monthly Space Cost' ;
    rdfs:comment 'Allocated monthly cost for the room space, including lease payments, depreciation, utilities, and maintenance. Used for cost center chargebacks and financial analysis.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:negativePressureFlag rdf:type rdf:Property ;
    rdfs:label 'Negative Pressure Flag' ;
    rdfs:comment 'Indicates whether the room has negative pressure ventilation to prevent airborne pathogen spread. Required for airborne isolation (e.g., tuberculosis, COVID-19).' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nitrousOxideOutletCount rdf:type rdf:Property ;
    rdfs:label 'Nitrous Oxide Outlet Count' ;
    rdfs:comment 'Number of nitrous oxide gas outlets. Typically present in operating rooms and dental procedure rooms for anesthesia delivery.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nurseCallSystemFlag rdf:type rdf:Property ;
    rdfs:label 'Nurse Call System Flag' ;
    rdfs:comment 'Indicates whether the room is equipped with a nurse call system for patient-to-staff communication. Standard for patient rooms and required for CMS compliance.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:occupancyPercentage rdf:type rdf:Property ;
    rdfs:label 'Occupancy Percentage' ;
    rdfs:comment 'Calculated percentage of time the room is occupied over a reporting period. Key performance indicator for space utilization and capacity management.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:orAirflowClass rdf:type rdf:Property ;
    rdfs:label 'Or Airflow Class' ;
    rdfs:comment 'ISO cleanroom classification for operating room air quality and particulate control. Defines laminar airflow requirements for surgical sterility. Applicable only to OR rooms.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oxygenOutletCount rdf:type rdf:Property ;
    rdfs:label 'Oxygen Outlet Count' ;
    rdfs:comment 'Number of medical gas outlets for oxygen delivery. Essential for patient care capacity planning and emergency preparedness.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:roomClass rdf:type rdf:Property ;
    rdfs:label 'Room Class' ;
    rdfs:comment 'Classification of the room based on occupancy and privacy level. Impacts billing, patient preference, and infection control protocols.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roomName rdf:type rdf:Property ;
    rdfs:label 'Room Name' ;
    rdfs:comment 'Human-readable name or description of the room, often used for scheduling and communication (e.g., Cardiac Cath Lab 1, Pediatric Exam Room B).' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roomNumber rdf:type rdf:Property ;
    rdfs:label 'Room Number' ;
    rdfs:comment 'The official room number or identifier used for wayfinding, signage, and operational reference. May include alphanumeric codes (e.g., 3A-201, OR-5, ICU-12).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roomStatus rdf:type rdf:Property ;
    rdfs:label 'Room Status' ;
    rdfs:comment 'Current operational status of the room. Drives bed management, ADT workflows, and scheduling availability.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roomType rdf:type rdf:Property ;
    rdfs:label 'Room Type' ;
    rdfs:comment 'Classification of the room based on its primary clinical or operational function. Determines equipment requirements, staffing, and scheduling rules. [ENUM-REF-CANDIDATE: patient|operating_room|procedure_room|exam_room|consultation_room|support_room|isolation_room|negative_pressure_room — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telemetryCapableFlag rdf:type rdf:Property ;
    rdfs:label 'Telemetry Capable Flag' ;
    rdfs:comment 'Indicates whether the room is equipped with telemetry monitoring infrastructure for continuous cardiac and vital sign monitoring.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vacuumOutletCount rdf:type rdf:Property ;
    rdfs:label 'Vacuum Outlet Count' ;
    rdfs:comment 'Number of medical vacuum outlets for suctioning. Required for surgical, procedural, and critical care rooms.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ventilatorOutletCount rdf:type rdf:Property ;
    rdfs:label 'Ventilator Outlet Count' ;
    rdfs:comment 'Number of electrical outlets dedicated to ventilator equipment. Critical for ICU and critical care room planning and patient placement.' ;
    rdfs:domain ind:Room ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bedId rdf:type rdf:Property ;
    rdfs:label 'Bed Id' ;
    rdfs:comment 'Unique identifier for the individual patient bed. Primary key for the bed entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bed .

ind:bedMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Bed Mpi Record Id' ;
    rdfs:comment 'Reference to the patient currently assigned to this bed. Null when bed status is available, dirty, blocked, or out_of_service. Links to Master Patient Index (MPI) for ADT event tracking.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:assetTag rdf:type rdf:Property ;
    rdfs:label 'Asset Tag' ;
    rdfs:comment 'Physical asset tag or serial number affixed to the bed frame for equipment tracking, preventive maintenance scheduling, and biomedical engineering inventory management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bedCategory rdf:type rdf:Property ;
    rdfs:label 'Bed Category' ;
    rdfs:comment 'Clinical service line or specialty category of the bed. Used for capacity planning by service line, regulatory reporting, and patient placement algorithms. Values: medical, surgical, pediatric, maternity, psychiatric, rehabilitation.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bedStatus rdf:type rdf:Property ;
    rdfs:label 'Bed Status' ;
    rdfs:comment 'Current operational status of the bed. Core field for real-time bed management and ADT (Admit, Discharge, Transfer) operations. Values: available (ready for patient assignment), occupied (patient currently assigned), dirty (patient discharged, awaiting environmental services cleaning), blocked (administratively held), out_of_service (maintenance or repair required), housekeeping (cleaning in progress).' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bedType rdf:type rdf:Property ;
    rdfs:label 'Bed Type' ;
    rdfs:comment 'Classification of the bed based on clinical care level and purpose. Determines staffing ratios, reimbursement categories, and capacity reporting. Values: acute (general medical-surgical), icu (intensive care unit), observation (short-stay monitoring), ed (emergency department), or_table (operating room table), procedure (procedure room bed), bariatric (high weight capacity), low_bed (fall prevention), bassinet (neonatal/pediatric). [ENUM-REF-CANDIDATE: acute|icu|observation|ed|or_table|procedure|bariatric|low_bed|bassinet — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockedReason rdf:type rdf:Property ;
    rdfs:label 'Blocked Reason' ;
    rdfs:comment 'Free-text explanation for why the bed is administratively blocked from patient assignment (e.g., construction, equipment failure, infection control hold, staffing shortage). Populated only when bed_status is blocked.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeReadyTimestamp rdf:type rdf:Property ;
    rdfs:label 'Discharge Ready Timestamp' ;
    rdfs:comment 'Date and time when the clinical team marked the patient as medically ready for discharge. Used to calculate discharge delays, bed turnover bottlenecks, and length of stay (LOS) optimization metrics.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:expectedAvailableTimestamp rdf:type rdf:Property ;
    rdfs:label 'Expected Available Timestamp' ;
    rdfs:comment 'Estimated date and time when a currently unavailable bed (dirty, blocked, out_of_service, housekeeping) is expected to become available for patient assignment. Used for bed demand forecasting and patient placement planning.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isAirFluidized rdf:type rdf:Property ;
    rdfs:label 'Is Air Fluidized' ;
    rdfs:comment 'Indicates whether the bed is an air-fluidized therapy bed used for severe pressure ulcer treatment and prevention. Specialized equipment requiring clinical justification and authorization.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isBariatricCapable rdf:type rdf:Property ;
    rdfs:label 'Is Bariatric Capable' ;
    rdfs:comment 'Indicates whether the bed is equipped to safely accommodate bariatric patients (typically weight capacity 350+ lbs). Impacts patient placement decisions and equipment requirements.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isIsolationCapable rdf:type rdf:Property ;
    rdfs:label 'Is Isolation Capable' ;
    rdfs:comment 'Indicates whether the bed is in a room suitable for isolation precautions (contact, droplet, or airborne). Supports infection control protocols and patient placement decisions.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLicensed rdf:type rdf:Property ;
    rdfs:label 'Is Licensed' ;
    rdfs:comment 'Indicates whether the bed is included in the facilitys licensed bed count as approved by state health department. Impacts regulatory reporting, reimbursement, and capacity planning.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLowBed rdf:type rdf:Property ;
    rdfs:label 'Is Low Bed' ;
    rdfs:comment 'Indicates whether the bed is a low-height bed designed for fall prevention, typically used for high-risk patients (elderly, confused, post-operative). Supports patient safety protocols.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNegativePressureRoom rdf:type rdf:Property ;
    rdfs:label 'Is Negative Pressure Room' ;
    rdfs:comment 'Indicates whether the bed is located in a negative pressure isolation room designed for airborne infection control (e.g., tuberculosis, COVID-19, measles). Critical for infection prevention and control.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrivateRoom rdf:type rdf:Property ;
    rdfs:label 'Is Private Room' ;
    rdfs:comment 'Indicates whether the bed is in a private (single-occupancy) room. Impacts patient satisfaction, infection control, and room charge billing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStaffed rdf:type rdf:Property ;
    rdfs:label 'Is Staffed' ;
    rdfs:comment 'Indicates whether the bed is currently staffed and operationally available for patient assignment. A bed may be licensed but not staffed due to nursing shortages or seasonal demand fluctuations.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTelemetryCapable rdf:type rdf:Property ;
    rdfs:label 'Is Telemetry Capable' ;
    rdfs:comment 'Indicates whether the bed location is equipped with continuous cardiac telemetry monitoring capability. Determines appropriate placement for patients requiring cardiac monitoring.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:label rdf:type rdf:Property ;
    rdfs:label 'Label' ;
    rdfs:comment 'Human-readable identifier for the bed, typically including unit, room, and bed position (e.g., 4-West-201-A, ICU-12-B, ED-Bay-3). Used for operational communication and bed board displays.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCleanedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Cleaned Timestamp' ;
    rdfs:comment 'Date and time when environmental services completed cleaning and disinfection of the bed and room. Critical for infection control, bed turnover tracking, and housekeeping performance metrics.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:outOfServiceReason rdf:type rdf:Property ;
    rdfs:label 'Out Of Service Reason' ;
    rdfs:comment 'Free-text explanation for why the bed is out of service (e.g., biomedical equipment repair, structural maintenance, permanent closure). Populated only when bed_status is out_of_service.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:position rdf:type rdf:Property ;
    rdfs:label 'Position' ;
    rdfs:comment 'Position identifier within a multi-bed room (e.g., A, B, C, 1, 2, Window, Door). Used for precise bed identification and patient placement communication.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerAssignmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Provider Assignment Timestamp' ;
    rdfs:comment 'Date and time when the current patient was assigned to this bed. Used for calculating patient length of stay in specific bed/unit and bed utilization analytics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:statusTimestamp rdf:type rdf:Property ;
    rdfs:label 'Status Timestamp' ;
    rdfs:comment 'Date and time when the bed last changed status. Critical for calculating discharge-to-clean cycle time, bed turnover metrics, and hospital command center operations.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:weightCapacityLbs rdf:type rdf:Property ;
    rdfs:label 'Weight Capacity Lbs' ;
    rdfs:comment 'Maximum safe patient weight capacity of the bed in pounds. Used for patient placement decisions and equipment safety compliance. Standard beds typically 350-500 lbs, bariatric beds 500-1000+ lbs.' ;
    rdfs:domain ind:Bed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bedStatusEventId rdf:type rdf:Property ;
    rdfs:label 'Bed Status Event Id' ;
    rdfs:comment 'Unique identifier for each bed status change event. Primary key for the bed status event transactional record.' ;
    rdfs:domain ind:BedStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:environmentalServiceRequestId rdf:type rdf:Property ;
    rdfs:label 'Environmental Service Request Id' ;
    rdfs:comment 'Reference to the environmental services work order created for bed cleaning. Enables discharge-to-clean cycle time tracking.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnvironmentalServiceRequest .

ind:maintenanceOrderId rdf:type rdf:Property ;
    rdfs:label 'Maintenance Order Id' ;
    rdfs:comment 'Reference to the biomedical engineering or facilities maintenance work order if the bed requires repair or preventive maintenance.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaintenanceOrder .

ind:primaryBedUnitId rdf:type rdf:Property ;
    rdfs:label 'Primary Bed Unit Id' ;
    rdfs:comment 'Reference to the nursing unit or department where the bed resides (e.g., ICU, ED, Medical-Surgical).' ;
    rdfs:domain ind:BedStatusEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Unit .

ind:actualAvailabilityTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Availability Timestamp' ;
    rdfs:comment 'Actual date and time when the bed became available after cleaning or maintenance. Enables cycle time variance analysis.' ;
    rdfs:domain ind:BedStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:adtEventType rdf:type rdf:Property ;
    rdfs:label 'Adt Event Type' ;
    rdfs:comment 'Type of ADT event that triggered this bed status change. Aligns with HL7 ADT message types for interoperability.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bedAssignmentMethod rdf:type rdf:Property ;
    rdfs:label 'Bed Assignment Method' ;
    rdfs:comment 'Method used to assign or change the bed status (manual by staff, automated by system algorithm, or hybrid). Supports workflow optimization analysis.' ;
    rdfs:domain ind:BedStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockedReasonCategory rdf:type rdf:Property ;
    rdfs:label 'Blocked Reason Category' ;
    rdfs:comment 'High-level category for why a bed is blocked or unavailable. Supports root cause analysis of capacity constraints.' ;
    rdfs:domain ind:BedStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentEventSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Consent Event Sequence Number' ;
    rdfs:comment 'Sequential number indicating the order of status changes for this bed. Supports chronological event reconstruction and audit trails.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentEventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Consent Event Timestamp' ;
    rdfs:comment 'Precise date and time when the bed status change occurred. Critical for discharge-to-clean cycle time analysis and real-time bed board operations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:expectedAvailabilityTimestamp rdf:type rdf:Property ;
    rdfs:label 'Expected Availability Timestamp' ;
    rdfs:comment 'Projected date and time when the bed will become available for the next patient. Used for bed turnover forecasting and transfer planning.' ;
    rdfs:domain ind:BedStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:initiatingUserRole rdf:type rdf:Property ;
    rdfs:label 'Initiating User Role' ;
    rdfs:comment 'Role or job function of the user who initiated the status change (e.g., Registered Nurse, Environmental Services Technician, Bed Coordinator).' ;
    rdfs:domain ind:BedStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isElectiveFlag rdf:type rdf:Property ;
    rdfs:label 'Is Elective Flag' ;
    rdfs:comment 'Indicates whether this bed status change is related to a scheduled or elective admission (e.g., planned surgery).' ;
    rdfs:domain ind:BedStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEmergencyFlag rdf:type rdf:Property ;
    rdfs:label 'Is Emergency Flag' ;
    rdfs:comment 'Indicates whether this bed status change is related to an emergency department admission or urgent care scenario.' ;
    rdfs:domain ind:BedStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isolationType rdf:type rdf:Property ;
    rdfs:label 'Isolation Type' ;
    rdfs:comment 'Type of infection control isolation precaution applied to the bed (e.g., contact, droplet, airborne, protective). Critical for infection prevention and bed assignment logic.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newStatusCode rdf:type rdf:Property ;
    rdfs:label 'New Status Code' ;
    rdfs:comment 'The bed status after this event. Core field for real-time bed availability tracking and capacity management. [ENUM-REF-CANDIDATE: occupied|available|cleaning|maintenance|blocked|reserved|isolation — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:BedStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorStatusCode rdf:type rdf:Property ;
    rdfs:label 'Prior Status Code' ;
    rdfs:comment 'The bed status immediately before this event. Enables state transition analysis and workflow tracking. [ENUM-REF-CANDIDATE: occupied|available|cleaning|maintenance|blocked|reserved|isolation — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityFlag rdf:type rdf:Property ;
    rdfs:label 'Priority Flag' ;
    rdfs:comment 'Indicates whether this bed status change is high-priority (e.g., emergency department hold, urgent transfer). Supports command center escalation workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:anesthesiaMachineModel rdf:type rdf:Property ;
    rdfs:label 'Anesthesia Machine Model' ;
    rdfs:comment 'Manufacturer and model of the anesthesia delivery system installed in the OR. Critical for anesthesia provider training, maintenance scheduling, and gas scavenging system compatibility.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyPowerBackupFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Power Backup Flag' ;
    rdfs:comment 'Indicates whether the OR is connected to the emergency power system (generator or UPS) to maintain critical functions during power outages. Required for life safety and continuation of surgical procedures.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyUseFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Use Flag' ;
    rdfs:comment 'Indicates whether this OR is designated for emergency and trauma cases. Emergency ORs are held open or have priority access rules in surgical scheduling systems to ensure rapid availability for urgent cases.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equipmentInventoryList rdf:type rdf:Property ;
    rdfs:label 'Equipment Inventory List' ;
    rdfs:comment 'Comma-separated or structured list of major fixed and mobile equipment assigned to this OR suite (e.g., surgical table model, anesthesia machine, electrosurgical unit, video tower, microscope). Used for preventive maintenance scheduling and equipment tracking.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireSuppressionSystemType rdf:type rdf:Property ;
    rdfs:label 'Fire Suppression System Type' ;
    rdfs:comment 'Type of fire suppression system installed in the OR suite. Clean agent systems (e.g., FM-200, Novec 1230) are preferred for ORs to avoid water damage to sensitive equipment. Sprinkler systems are common but may require equipment protection. Critical for life safety and regulatory compliance.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hvacAirExchangeRatePerHour rdf:type rdf:Property ;
    rdfs:label 'Hvac Air Exchange Rate Per Hour' ;
    rdfs:comment 'Number of complete air changes per hour in the operating room. Minimum 15 air changes per hour is required for ORs per FGI guidelines; higher rates (20-25) are used in ultra-clean environments. Critical for infection control and regulatory compliance.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:imagingIntegrationType rdf:type rdf:Property ;
    rdfs:label 'Imaging Integration Type' ;
    rdfs:comment 'Type of intraoperative imaging equipment integrated into the OR suite. Hybrid ORs combine surgical and interventional radiology capabilities. C-arm fluoroscopy is common in orthopedic and spine procedures. Intraoperative MRI/CT enable real-time image-guided neurosurgery.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laminarAirflowClass rdf:type rdf:Property ;
    rdfs:label 'Laminar Airflow Class' ;
    rdfs:comment 'ISO 14644-1 cleanroom classification for the operating room air quality. ISO Class 5 (Class 100) is the highest standard for ultra-clean orthopedic and implant surgeries. ISO Class 7 (Class 10,000) is typical for general surgery. Laminar airflow reduces surgical site infection (SSI) risk.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAccreditationSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Last Accreditation Survey Date' ;
    rdfs:comment 'Date of the most recent accreditation survey or inspection for the surgical services program. Used to track compliance cycles and prepare for upcoming surveys.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicalGasOutletsCount rdf:type rdf:Property ;
    rdfs:label 'Medical Gas Outlets Count' ;
    rdfs:comment 'Total number of medical gas outlets (oxygen, nitrous oxide, medical air, vacuum, WAGD) installed in the OR suite. Minimum outlet counts are specified by FGI guidelines based on OR type and size.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nextAccreditationSurveyDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Accreditation Survey Due Date' ;
    rdfs:comment 'Scheduled or estimated date for the next accreditation survey. Alerts quality and compliance teams to prepare documentation and conduct internal readiness assessments.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orName rdf:type rdf:Property ;
    rdfs:label 'Or Name' ;
    rdfs:comment 'Descriptive name for the operating room suite, may include location or specialty designation (e.g., Main OR 5, Cardiac Surgery Suite A, Hybrid OR West Wing).' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orNumber rdf:type rdf:Property ;
    rdfs:label 'Or Number' ;
    rdfs:comment 'Business identifier for the operating room suite, typically displayed as OR1, OR2, OR10, etc. Used in surgical scheduling systems like Epic OpTime and Cerner SurgiNet.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orType rdf:type rdf:Property ;
    rdfs:label 'Or Type' ;
    rdfs:comment 'Classification of the operating room by surgical specialty or capability. Determines equipment requirements, staffing models, and scheduling rules. General ORs support multiple specialties; specialized ORs are configured for specific procedures.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pediatricCapableFlag rdf:type rdf:Property ;
    rdfs:label 'Pediatric Capable Flag' ;
    rdfs:comment 'Indicates whether the OR is equipped and staffed to support pediatric surgical cases. Requires specialized equipment (pediatric anesthesia circuits, warming devices, smaller instruments) and trained perioperative staff.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:positivePressureMaintainedFlag rdf:type rdf:Property ;
    rdfs:label 'Positive Pressure Maintained Flag' ;
    rdfs:comment 'Indicates whether the OR maintains positive air pressure relative to adjacent corridors and support spaces. Positive pressure prevents contaminated air from entering the sterile field. Required for most ORs; negative pressure is used only for airborne isolation procedures.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roboticSurgeryCompatibleFlag rdf:type rdf:Property ;
    rdfs:label 'Robotic Surgery Compatible Flag' ;
    rdfs:comment 'Indicates whether the OR suite is configured and equipped to support robotic-assisted surgical systems (e.g., da Vinci Surgical System). Requires additional space, power, and structural support.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roomHeightFeet rdf:type rdf:Property ;
    rdfs:label 'Room Height Feet' ;
    rdfs:comment 'Ceiling height of the operating room in feet. Critical for surgical light placement, boom configuration, and laminar airflow system design.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roomLengthFeet rdf:type rdf:Property ;
    rdfs:label 'Room Length Feet' ;
    rdfs:comment 'Physical length dimension of the operating room in feet. Used for space planning, equipment placement, and compliance with facility design standards.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roomWidthFeet rdf:type rdf:Property ;
    rdfs:label 'Room Width Feet' ;
    rdfs:comment 'Physical width dimension of the operating room in feet. Minimum dimensions are regulated for different OR types to ensure safe equipment access and staff movement.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduledMaintenanceWindow rdf:type rdf:Property ;
    rdfs:label 'Scheduled Maintenance Window' ;
    rdfs:comment 'Recurring time block reserved for preventive maintenance, deep cleaning, and equipment calibration (e.g., Every Sunday 6:00 AM - 12:00 PM, First Monday of month). OR is unavailable for surgical scheduling during this window.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusEffectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Status Effective Timestamp' ;
    rdfs:comment 'Date and time when the current operational status became effective. Used to track OR availability history and calculate downtime metrics for capacity management.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:statusReasonCode rdf:type rdf:Property ;
    rdfs:label 'Status Reason Code' ;
    rdfs:comment 'Coded reason for the current operational status (e.g., EQUIP_FAIL for equipment failure, STAFF_SHORT for staffing shortage, SCHED_MAINT for scheduled maintenance, RENO for renovation). Supports root cause analysis of OR unavailability.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surgicalTableType rdf:type rdf:Property ;
    rdfs:label 'Surgical Table Type' ;
    rdfs:comment 'Model or type of the primary surgical table installed in the OR (e.g., general surgery table, orthopedic fracture table, neurosurgery head frame table, robotic surgery table). Table type determines compatible procedures and patient positioning capabilities.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:videoIntegrationCapabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Video Integration Capability Flag' ;
    rdfs:comment 'Indicates whether the OR has integrated video capture, recording, and display systems for endoscopic, laparoscopic, or robotic surgery. Supports surgical education, quality review, and telemedicine consultation.' ;
    rdfs:domain ind:OrSuite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:currentLocationCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Current Location Care Site Id' ;
    rdfs:comment 'Identifier of the care site (hospital, clinic, facility) where the equipment is currently located.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:primaryEquipmentCurrentLocationRoomId rdf:type rdf:Property ;
    rdfs:label 'Primary Equipment Current Location Room Id' ;
    rdfs:comment 'FK to facility.room.room_id' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Room .

ind:calibrationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Calibration Required Flag' ;
    rdfs:comment 'Indicates whether the equipment requires periodic calibration to maintain measurement accuracy and regulatory compliance.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:currentLocationFloor rdf:type rdf:Property ;
    rdfs:label 'Current Location Floor' ;
    rdfs:comment 'Floor level within the building where the equipment is located.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalRequirements rdf:type rdf:Property ;
    rdfs:label 'Environmental Requirements' ;
    rdfs:comment 'Special environmental conditions required for equipment operation (temperature range, humidity, ventilation). Important for facility infrastructure planning.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentCategory rdf:type rdf:Property ;
    rdfs:label 'Equipment Category' ;
    rdfs:comment 'High-level classification of equipment type for portfolio management and reporting. [ENUM-REF-CANDIDATE: biomedical|imaging|surgical|patient_monitoring|life_support|laboratory|facility_infrastructure|sterilization|therapeutic — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentName rdf:type rdf:Property ;
    rdfs:label 'Equipment Name' ;
    rdfs:comment 'Common business name or description of the equipment asset (e.g., Ventilator, MRI Scanner, Infusion Pump).' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentType rdf:type rdf:Property ;
    rdfs:label 'Equipment Type' ;
    rdfs:comment 'Detailed equipment type or subclass within the category (e.g., CT Scanner, Infusion Pump, Defibrillator).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityServiceContractExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Facility Service Contract Expiration Date' ;
    rdfs:comment 'Date when the current service contract expires. Used for contract renewal planning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilityServiceContractNumber rdf:type rdf:Property ;
    rdfs:label 'Facility Service Contract Number' ;
    rdfs:comment 'Reference number for the active service or maintenance contract covering this equipment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityServiceContractVendor rdf:type rdf:Property ;
    rdfs:label 'Facility Service Contract Vendor' ;
    rdfs:comment 'Name of the vendor or service provider responsible for maintenance under the service contract.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infectionControlCategory rdf:type rdf:Property ;
    rdfs:label 'Infection Control Category' ;
    rdfs:comment 'Spaulding classification for infection control and sterilization requirements. Critical items enter sterile tissue, semi-critical contact mucous membranes, non-critical contact intact skin.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCalibrationDate rdf:type rdf:Property ;
    rdfs:label 'Last Calibration Date' ;
    rdfs:comment 'Date when the most recent calibration was performed on this equipment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPmDate rdf:type rdf:Property ;
    rdfs:label 'Last Pm Date' ;
    rdfs:comment 'Date when the most recent preventive maintenance was completed on this equipment.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:manufacturer rdf:type rdf:Property ;
    rdfs:label 'Manufacturer' ;
    rdfs:comment 'Name of the equipment manufacturer or original equipment manufacturer (OEM).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Mobility Indicator' ;
    rdfs:comment 'Indicates whether the equipment is permanently installed (fixed), can be moved by staff (portable), or is mounted on wheels/cart (mobile). Impacts tracking and location management requirements.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextCalibrationDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Calibration Due Date' ;
    rdfs:comment 'Scheduled date for the next calibration activity. Overdue calibration may result in equipment being taken out of service.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextPmDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Pm Due Date' ;
    rdfs:comment 'Scheduled date for the next preventive maintenance activity. Critical for compliance with TJC equipment management standards.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pmComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Pm Compliance Status' ;
    rdfs:comment 'Current compliance status of preventive maintenance schedule. Overdue status triggers escalation and may impact accreditation.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Pm Frequency Days' ;
    rdfs:comment 'Number of days between scheduled preventive maintenance activities. Determined by manufacturer recommendations and risk category.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:powerRequirements rdf:type rdf:Property ;
    rdfs:label 'Power Requirements' ;
    rdfs:comment 'Electrical power specifications for the equipment (voltage, amperage, phase). Critical for facility planning and electrical safety.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recallDate rdf:type rdf:Property ;
    rdfs:label 'Recall Date' ;
    rdfs:comment 'Date when the FDA recall was issued for this equipment model.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recallRemediationDate rdf:type rdf:Property ;
    rdfs:label 'Recall Remediation Date' ;
    rdfs:comment 'Date when recall remediation actions (repair, replacement, software update) were completed for this equipment unit.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sapEquipmentNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Equipment Number' ;
    rdfs:comment 'Equipment master record number in SAP PM (Plant Maintenance) module. Primary integration key for work orders, maintenance plans, and cost tracking.' ;
    rdfs:domain ind:EquipmentAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:udi rdf:type rdf:Property ;
    rdfs:label 'Udi' ;
    rdfs:comment 'FDA-mandated Unique Device Identifier for medical devices. Enables traceability throughout the device lifecycle and supports recall management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Maintenance Employee Id' ;
    rdfs:comment 'Reference to the facilities or biomedical engineering technician assigned to execute this maintenance work order. Links to workforce/employee master data.' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:pmScheduleId rdf:type rdf:Property ;
    rdfs:label 'Pm Schedule Id' ;
    rdfs:comment 'Reference to the preventive maintenance schedule definition that generated this work order. Null for corrective, emergency, or ad-hoc work orders. Links to the PM schedule template for compliance tracking.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PmSchedule .

ind:actualCompletionDatetime rdf:type rdf:Property ;
    rdfs:label 'Actual Completion Datetime' ;
    rdfs:comment 'Actual date and time when the maintenance work was completed and the asset or location was returned to service. Used for calculating actual labor duration and PM compliance rates.' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Actual Start Datetime' ;
    rdfs:comment 'Actual date and time when the technician began work on the maintenance order. Captured by technician check-in or mobile work order system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:approvalDatetime rdf:type rdf:Property ;
    rdfs:label 'Approval Datetime' ;
    rdfs:comment 'Date and time when the maintenance work order was approved. Used for tracking approval cycle time and work order lifecycle metrics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:completionNotes rdf:type rdf:Property ;
    rdfs:label 'Completion Notes' ;
    rdfs:comment 'Detailed narrative notes entered by the technician upon work order completion, documenting work performed, parts replaced, findings, and any follow-up recommendations.' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:downtimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Downtime Minutes' ;
    rdfs:comment 'Total duration in minutes that the asset or location was out of service due to this maintenance activity. Used for calculating equipment availability and operational impact metrics.' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:failureCode rdf:type rdf:Property ;
    rdfs:label 'Failure Code' ;
    rdfs:comment 'Standardized code classifying the type of equipment failure or maintenance issue. Used for failure mode analysis, trend reporting, and root cause analysis. Follows facility-specific or manufacturer failure taxonomy.' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laborCost rdf:type rdf:Property ;
    rdfs:label 'Labor Cost' ;
    rdfs:comment 'Total labor cost for the maintenance work order, calculated from labor hours and technician hourly rates. Used for total cost of ownership analysis and budget tracking.' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:orderStatus rdf:type rdf:Property ;
    rdfs:label 'Order Status' ;
    rdfs:comment 'Current lifecycle status of the maintenance work order. Tracks progression from creation through assignment, execution, completion, and closure. On-hold indicates temporary suspension pending parts or access. [ENUM-REF-CANDIDATE: created|assigned|in_progress|on_hold|completed|cancelled|closed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderType rdf:type rdf:Property ;
    rdfs:label 'Order Type' ;
    rdfs:comment 'Classification of the maintenance work order by its purpose: preventive (scheduled routine maintenance), corrective (repair of identified failure), emergency (urgent unplanned repair), inspection (regulatory or safety inspection), or recall (manufacturer-driven equipment recall).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partsCost rdf:type rdf:Property ;
    rdfs:label 'Parts Cost' ;
    rdfs:comment 'Total cost of parts, materials, and consumables used in the maintenance work order. Aggregated from parts consumption records linked to this work order.' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:problemDescription rdf:type rdf:Property ;
    rdfs:label 'Problem Description' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestDatetime rdf:type rdf:Property ;
    rdfs:label 'Request Datetime' ;
    rdfs:comment 'Date and time when the maintenance work order was originally requested or created in the system. Used for calculating response time and work order aging metrics.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:riskAssessmentScore rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Score' ;
    rdfs:comment 'Quantitative risk score assigned to the asset or maintenance activity based on risk-based assessment methodology such as Alternative Equipment Maintenance (AEM) or Authority Having Jurisdiction (AHJ) criteria. Higher scores indicate greater patient safety or operational risk.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Flag' ;
    rdfs:comment 'Indicates whether this maintenance work order was triggered by or resulted in a safety incident, patient safety event, or environmental hazard. Used for safety reporting and root cause analysis.' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Datetime' ;
    rdfs:comment 'Planned date and time when the maintenance work is scheduled to be completed. Used for resource planning and downtime coordination with clinical operations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Datetime' ;
    rdfs:comment 'Planned date and time when the maintenance work is scheduled to begin. For preventive maintenance, this is calculated from the PM schedule frequency and last completion date.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:totalCost rdf:type rdf:Property ;
    rdfs:label 'Total Cost' ;
    rdfs:comment 'Total cost of the maintenance work order, including labor cost, parts cost, and any additional charges (contractor fees, disposal fees). Used for asset lifecycle cost analysis and facilities management KPIs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradeType rdf:type rdf:Property ;
    rdfs:label 'Trade Type' ;
    rdfs:comment 'Classification of the skilled trade or technical specialty required to perform the maintenance work. Biomedical covers medical equipment; other trades cover facility infrastructure systems.' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Vendor Service Flag' ;
    rdfs:comment 'Indicates whether this maintenance work order was performed by an external vendor or contractor rather than internal facilities staff. Used for cost allocation and vendor performance tracking.' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:warrantyClaimFlag rdf:type rdf:Property ;
    rdfs:label 'Warranty Claim Flag' ;
    rdfs:comment 'Indicates whether this maintenance work order is eligible for warranty claim or manufacturer reimbursement. Used for tracking warranty utilization and cost recovery.' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Work Order Number' ;
    rdfs:comment 'Externally-known unique business identifier for the maintenance work order, used for tracking and reference across systems and by technicians.' ;
    rdfs:domain ind:MaintenanceOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoGenerateWorkOrder rdf:type rdf:Property ;
    rdfs:label 'Auto Generate Work Order' ;
    rdfs:comment 'Boolean flag indicating whether work orders should be automatically generated in SAP PM when the next due date is reached.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:downtimeRequired rdf:type rdf:Property ;
    rdfs:label 'Downtime Required' ;
    rdfs:comment 'Boolean flag indicating whether the equipment or facility system must be taken offline or out of service to perform the maintenance task.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedDowntimeHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Downtime Hours' ;
    rdfs:comment 'Estimated number of hours the equipment or system will be unavailable during maintenance, used for operational planning and patient care continuity.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedLaborHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Labor Hours' ;
    rdfs:comment 'Estimated number of labor hours required to complete the preventive maintenance task, used for resource planning and scheduling.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:frequencyInterval rdf:type rdf:Property ;
    rdfs:label 'Frequency Interval' ;
    rdfs:comment 'Numeric value representing the interval count for the maintenance frequency (e.g., every 3 months, every 6 weeks).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyUnit rdf:type rdf:Property ;
    rdfs:label 'Frequency Unit' ;
    rdfs:comment 'Unit of measure for the frequency interval (time-based or usage-based).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Last Completed Date' ;
    rdfs:comment 'Date when the preventive maintenance task was last successfully completed, used to calculate the next due date.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maintenanceTaskDescription rdf:type rdf:Property ;
    rdfs:label 'Maintenance Task Description' ;
    rdfs:comment 'Detailed description of the preventive maintenance tasks to be performed, including inspection points, calibration steps, cleaning procedures, and safety checks.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceType rdf:type rdf:Property ;
    rdfs:label 'Maintenance Type' ;
    rdfs:comment 'Category of preventive maintenance activity to be performed on the equipment or facility system.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufacturerRecommendation rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Recommendation' ;
    rdfs:comment 'Manufacturer-recommended maintenance schedule or service bulletin reference that informs this preventive maintenance plan.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Due Date' ;
    rdfs:comment 'Calculated date when the next preventive maintenance task is due, based on frequency and last completed date. Drives automated work order generation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationRequired rdf:type rdf:Property ;
    rdfs:label 'Notification Required' ;
    rdfs:comment 'Boolean flag indicating whether stakeholder notification is required when work orders are generated or when maintenance is due.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partsRequired rdf:type rdf:Property ;
    rdfs:label 'Parts Required' ;
    rdfs:comment 'List or description of spare parts, consumables, or materials required to complete the preventive maintenance task.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannerGroup rdf:type rdf:Property ;
    rdfs:label 'Planner Group' ;
    rdfs:comment 'Maintenance planning group responsible for scheduling and coordinating this preventive maintenance activity.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priority rdf:type rdf:Property ;
    rdfs:label 'Priority' ;
    rdfs:comment 'Priority level of the preventive maintenance schedule, indicating urgency and impact on patient safety and facility operations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredTrade rdf:type rdf:Property ;
    rdfs:label 'Required Trade' ;
    rdfs:comment 'Specific trade, skill, or certification required to perform the maintenance task (e.g., biomedical engineer, HVAC technician, electrician, plumber).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyPrecautions rdf:type rdf:Property ;
    rdfs:label 'Safety Precautions' ;
    rdfs:comment 'Required safety precautions, personal protective equipment (PPE), lockout/tagout procedures, or infection control measures that must be followed during maintenance.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleEndDate rdf:type rdf:Property ;
    rdfs:label 'Schedule End Date' ;
    rdfs:comment 'Date when this preventive maintenance schedule expires or is no longer active. Null indicates an ongoing schedule.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduleStartDate rdf:type rdf:Property ;
    rdfs:label 'Schedule Start Date' ;
    rdfs:comment 'Date when this preventive maintenance schedule becomes active and begins generating work orders.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:workOrderType rdf:type rdf:Property ;
    rdfs:label 'Work Order Type' ;
    rdfs:comment 'Type of work order to be generated for this preventive maintenance schedule in SAP PM (e.g., PM01 for preventive maintenance, PM02 for inspection).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityInspectionId rdf:type rdf:Property ;
    rdfs:label 'Facility Inspection Id' ;
    rdfs:comment 'Unique identifier for the facility inspection record. Primary key.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FacilityInspection .

ind:accreditationCycleYear rdf:type rdf:Property ;
    rdfs:label 'Accreditation Cycle Year' ;
    rdfs:comment 'Year within the accreditation cycle when this inspection occurred (typically 1, 2, or 3 for TJC triennial cycle).' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificationDecision rdf:type rdf:Property ;
    rdfs:label 'Certification Decision' ;
    rdfs:comment 'Specific certification decision issued by CMS or state authority following the inspection.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complaintBasedFlag rdf:type rdf:Property ;
    rdfs:label 'Complaint Based Flag' ;
    rdfs:comment 'Indicates whether the inspection was triggered by a complaint or allegation rather than a routine scheduled survey.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionLevelCount rdf:type rdf:Property ;
    rdfs:label 'Condition Level Count' ;
    rdfs:comment 'Number of findings classified as condition-level deficiencies, representing non-compliance with a CMS Condition of Participation.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coordinatorName rdf:type rdf:Property ;
    rdfs:label 'Coordinator Name' ;
    rdfs:comment 'Name of the facility staff member serving as the primary coordinator for the inspection and follow-up activities.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deemedStatusApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Deemed Status Applicable Flag' ;
    rdfs:comment 'Indicates whether the inspection is related to deemed status, where TJC accreditation is accepted by CMS in lieu of a separate CMS certification survey.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentOfCareChapter rdf:type rdf:Property ;
    rdfs:label 'Environment Of Care Chapter' ;
    rdfs:comment 'Specific TJC Environment of Care chapter or section that was the focus of the inspection (e.g., EC.02.01.01 for Safety Management).' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Facility Inspection Date' ;
    rdfs:comment 'Date on which the inspection was conducted or initiated.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilityInspectionNumber rdf:type rdf:Property ;
    rdfs:label 'Facility Inspection Number' ;
    rdfs:comment 'Business identifier for the inspection, often assigned by the inspecting organization or internal tracking system.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityInspectionScope rdf:type rdf:Property ;
    rdfs:label 'Facility Inspection Scope' ;
    rdfs:comment 'Breadth of the inspection coverage. Indicates whether the inspection was facility-wide, focused on a specific department, system, unit, or service line.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityInspectionStatus rdf:type rdf:Property ;
    rdfs:label 'Facility Inspection Status' ;
    rdfs:comment 'Current lifecycle status of the inspection. Tracks progression from scheduled through completion, report issuance, Plan of Correction (PoC) submission and acceptance, to closure. [ENUM-REF-CANDIDATE: scheduled|in_progress|completed|report_pending|report_issued|poc_submitted|poc_accepted|closed — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityInspectionType rdf:type rdf:Property ;
    rdfs:label 'Facility Inspection Type' ;
    rdfs:comment 'Category of inspection conducted. Includes TJC (The Joint Commission) triennial survey, CMS (Centers for Medicare and Medicaid Services) certification survey, state DOH (Department of Health) survey, fire marshal inspection, OSHA (Occupational Safety and Health Administration) inspection, internal safety round, life safety code inspection, CMS validation survey, CMS complaint survey, and deemed status survey. [ENUM-REF-CANDIDATE: tjc_triennial_survey|cms_certification_survey|state_doh_survey|fire_marshal_inspection|osha_inspection|internal_safety_round|life_safety_code_inspection|cms_validation_survey|cms_complaint_survey|deemed_status_survey — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Survey Date' ;
    rdfs:comment 'Date on which the follow-up survey was conducted or is scheduled to verify correction of deficiencies.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpSurveyRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Survey Required Flag' ;
    rdfs:comment 'Indicates whether a follow-up survey is required to verify correction of deficiencies.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:immediateJeopardyCount rdf:type rdf:Property ;
    rdfs:label 'Immediate Jeopardy Count' ;
    rdfs:comment 'Number of findings classified as immediate jeopardy, indicating situations where serious injury, harm, impairment, or death has occurred or is likely to occur.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inspectorCredentials rdf:type rdf:Property ;
    rdfs:label 'Inspector Credentials' ;
    rdfs:comment 'Professional credentials or certifications held by the inspector (e.g., RN, MD, CIH, PE).' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorName rdf:type rdf:Property ;
    rdfs:label 'Inspector Name' ;
    rdfs:comment 'Full name of the lead inspector or surveyor who conducted the inspection.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorOrganization rdf:type rdf:Property ;
    rdfs:label 'Inspector Organization' ;
    rdfs:comment 'Name of the organization or agency that the inspector represents (e.g., The Joint Commission, CMS, State Department of Health, Fire Marshal Office, OSHA).' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lifeSafetyCodeEdition rdf:type rdf:Property ;
    rdfs:label 'Life Safety Code Edition' ;
    rdfs:comment 'Edition of the NFPA (National Fire Protection Association) 101 Life Safety Code used as the standard for this inspection.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextScheduledFacilityInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Facility Inspection Date' ;
    rdfs:comment 'Date on which the next routine inspection is scheduled or anticipated.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:observationCount rdf:type rdf:Property ;
    rdfs:label 'Observation Count' ;
    rdfs:comment 'Number of findings classified as observations, representing areas for improvement that do not constitute formal deficiencies.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overallDisposition rdf:type rdf:Property ;
    rdfs:label 'Overall Disposition' ;
    rdfs:comment 'Final outcome or decision rendered by the inspecting body. Includes passed, conditional, failed, preliminary denial of accreditation, accreditation with follow-up, accreditation denied, certification granted, or certification denied. [ENUM-REF-CANDIDATE: passed|conditional|failed|preliminary_denial_of_accreditation|accreditation_with_follow_up|accreditation_denied|certification_granted|certification_denied — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pocAcceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Poc Acceptance Date' ;
    rdfs:comment 'Date on which the inspecting body formally accepted the facilitys Plan of Correction.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pocCompletionVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Poc Completion Verification Date' ;
    rdfs:comment 'Date on which the inspecting body verified that all corrective actions in the Plan of Correction have been completed.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pocDueDate rdf:type rdf:Property ;
    rdfs:label 'Poc Due Date' ;
    rdfs:comment 'Date by which the facility must submit its Plan of Correction to the inspecting body.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pocStatus rdf:type rdf:Property ;
    rdfs:label 'Poc Status' ;
    rdfs:comment 'Current status of the Plan of Correction submission and review process. [ENUM-REF-CANDIDATE: not_required|pending_submission|submitted|under_review|accepted|rejected|revision_requested — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pocSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Poc Submission Date' ;
    rdfs:comment 'Date on which the facility submitted its Plan of Correction to the inspecting body.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:standardLevelCount rdf:type rdf:Property ;
    rdfs:label 'Standard Level Count' ;
    rdfs:comment 'Number of findings classified as standard-level deficiencies, representing non-compliance with a specific standard but not rising to condition-level.' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tjcSurveyType rdf:type rdf:Property ;
    rdfs:label 'Tjc Survey Type' ;
    rdfs:comment 'Specific type of TJC survey conducted (triennial, mid-cycle, for-cause, follow-up, unannounced).' ;
    rdfs:domain ind:FacilityInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionFindingId rdf:type rdf:Property ;
    rdfs:label 'Inspection Finding Id' ;
    rdfs:comment 'Unique identifier for the inspection finding record. Primary key.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorFindingInspectionFindingId rdf:type rdf:Property ;
    rdfs:label 'Prior Finding Inspection Finding Id' ;
    rdfs:comment 'Reference to the earlier inspection finding record if this is a recurrent deficiency. Null if first occurrence.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InspectionFinding .

ind:affectedLocation rdf:type rdf:Property ;
    rdfs:label 'Affected Location' ;
    rdfs:comment 'Specific physical location, unit, department, or area within the facility where the deficiency was observed. May include building, floor, room, or unit identifiers.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedPatientCount rdf:type rdf:Property ;
    rdfs:label 'Affected Patient Count' ;
    rdfs:comment 'Estimated or actual number of patients potentially impacted by this deficiency. Null if not applicable or not determinable.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:citationReference rdf:type rdf:Property ;
    rdfs:label 'Citation Reference' ;
    rdfs:comment 'Official citation number or reference code assigned by the regulatory body in their inspection report or enforcement action.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionOwnerName rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Owner Name' ;
    rdfs:comment 'Full name of the individual responsible for executing and completing the corrective action plan.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionPlan rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan' ;
    rdfs:comment 'Detailed description of the planned actions, interventions, and process changes to remediate the finding and prevent recurrence. May include immediate actions, systemic improvements, and monitoring plans.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extendedDueDate rdf:type rdf:Property ;
    rdfs:label 'Extended Due Date' ;
    rdfs:comment 'Revised deadline if an extension was granted by the regulatory authority or internal compliance leadership. Null if no extension was requested or approved.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financialPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Financial Penalty Amount' ;
    rdfs:comment 'Monetary fine or penalty assessed by the regulatory authority for this finding. Null if no financial penalty was imposed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:findingCategory rdf:type rdf:Property ;
    rdfs:label 'Finding Category' ;
    rdfs:comment 'High-level classification of the finding area. Groups findings by operational domain for analysis and remediation planning. [ENUM-REF-CANDIDATE: environment_of_care|life_safety|infection_control|medication_management|patient_rights|quality_improvement|emergency_management|medical_staff|nursing|documentation — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingDate rdf:type rdf:Property ;
    rdfs:label 'Finding Date' ;
    rdfs:comment 'The date on which the deficiency or non-compliance was identified during the inspection.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicareCertificationImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Medicare Certification Impact Flag' ;
    rdfs:comment 'Indicates whether this finding threatens the facilitys Medicare/Medicaid certification status. True if certification is at risk, false otherwise.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rootCauseAnalysisCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis Completion Date' ;
    rdfs:comment 'The date on which the root cause analysis was completed and documented. Null if RCA was not required or not yet completed.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rootCauseAnalysisRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis Required Flag' ;
    rdfs:comment 'Indicates whether a formal root cause analysis is required for this finding based on severity and organizational policy. True if RCA is mandated, false otherwise.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:standardDescription rdf:type rdf:Property ;
    rdfs:label 'Standard Description' ;
    rdfs:comment 'Full text description of the regulatory standard or requirement that was cited in this finding.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedByName rdf:type rdf:Property ;
    rdfs:label 'Verified By Name' ;
    rdfs:comment 'Full name of the individual who verified that the corrective action was successfully implemented.' ;
    rdfs:domain ind:InspectionFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseAccreditationId rdf:type rdf:Property ;
    rdfs:label 'License Accreditation Id' ;
    rdfs:comment 'Unique identifier for the facility license or accreditation credential record.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attestationBy rdf:type rdf:Property ;
    rdfs:label 'Attestation By' ;
    rdfs:comment 'The name or identifier of the authorized individual who attested to the credential information.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bedCapacityAuthorized rdf:type rdf:Property ;
    rdfs:label 'Bed Capacity Authorized' ;
    rdfs:comment 'The number of licensed beds authorized under this credential, if applicable. Critical for hospital and inpatient facility licenses.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deemingOrganization rdf:type rdf:Property ;
    rdfs:label 'Deeming Organization' ;
    rdfs:comment 'The name of the accreditation organization that provides deemed status for CMS certification, if applicable. Examples include The Joint Commission, DNV Healthcare, HFAP.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyCount rdf:type rdf:Property ;
    rdfs:label 'Deficiency Count' ;
    rdfs:comment 'The number of deficiencies or non-compliance findings identified during the most recent survey or inspection.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:issueDate rdf:type rdf:Property ;
    rdfs:label 'Issue Date' ;
    rdfs:comment 'The date on which the license or accreditation credential was originally issued or granted by the authority.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:issuingAuthority rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority' ;
    rdfs:comment 'The name of the regulatory body, accreditation organization, or government agency that issued the credential. Examples include state departments of health, CMS, The Joint Commission, DNV, CLIA.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingAuthorityCode rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority Code' ;
    rdfs:comment 'Standardized code representing the issuing authority for system integration and reporting purposes.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseAccreditationStatus rdf:type rdf:Property ;
    rdfs:label 'License Accreditation Status' ;
    rdfs:comment 'Current lifecycle status of the license or accreditation credential. Indicates whether the credential is active, pending renewal, expired, suspended, revoked, or inactive.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Next Survey Date' ;
    rdfs:comment 'The scheduled or anticipated date for the next on-site survey, inspection, or audit by the issuing authority.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payerContractRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Payer Contract Requirement Flag' ;
    rdfs:comment 'Indicates whether this credential is required for payer contracting or network participation agreements.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planOfCorrectionApprovedDate rdf:type rdf:Property ;
    rdfs:label 'Plan Of Correction Approved Date' ;
    rdfs:comment 'The date on which the issuing authority approved the facilitys plan of correction.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planOfCorrectionSubmittedDate rdf:type rdf:Property ;
    rdfs:label 'Plan Of Correction Submitted Date' ;
    rdfs:comment 'The date on which the facility submitted its plan of correction to the issuing authority.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:providerCredentialName rdf:type rdf:Property ;
    rdfs:label 'Provider Credential Name' ;
    rdfs:comment 'The full name or title of the license or accreditation credential as issued by the authority.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerCredentialNumber rdf:type rdf:Property ;
    rdfs:label 'Provider Credential Number' ;
    rdfs:comment 'The unique license, certificate, or accreditation number issued by the governing authority. This is the externally-known identifier for the credential.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerCredentialType rdf:type rdf:Property ;
    rdfs:label 'Provider Credential Type' ;
    rdfs:comment 'Type of license or accreditation credential. Examples include state hospital license, CMS Medicare certification, TJC accreditation, DNV accreditation, CLIA laboratory certificate, state pharmacy license, trauma center designation, stroke center certification. [ENUM-REF-CANDIDATE: state_hospital_license|cms_medicare_certification|tjc_accreditation|dnv_accreditation|clia_laboratory_certificate|state_pharmacy_license|trauma_center_designation|stroke_center_certification|ambulatory_surgery_center_license|behavioral_health_license|home_health_license|hospice_license|imaging_center_license|dialysis_facility_certification — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalApplicationDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Application Date' ;
    rdfs:comment 'The date on which the renewal application for the license or accreditation was submitted to the issuing authority.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalDueDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Due Date' ;
    rdfs:comment 'The date by which the renewal application must be submitted to avoid lapse in credential status.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scopeOfCredential rdf:type rdf:Property ;
    rdfs:label 'Scope Of Credential' ;
    rdfs:comment 'Description of the services, procedures, or operational scope covered by the license or accreditation. May include bed capacity limits, service line restrictions, or specific procedural authorizations.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Status Effective Date' ;
    rdfs:comment 'The date on which the current status became effective.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statusReason rdf:type rdf:Property ;
    rdfs:label 'Status Reason' ;
    rdfs:comment 'Explanation or reason for the current status, particularly for suspended, revoked, or inactive credentials. May include regulatory findings, compliance failures, or voluntary surrender.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyDate rdf:type rdf:Property ;
    rdfs:label 'Survey Date' ;
    rdfs:comment 'The date of the most recent on-site survey, inspection, or audit conducted by the issuing authority to assess compliance with standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyOutcome rdf:type rdf:Property ;
    rdfs:label 'Survey Outcome' ;
    rdfs:comment 'The result or outcome of the most recent survey or inspection. May include findings such as full compliance, deficiencies identified, conditional status, or immediate jeopardy.' ;
    rdfs:domain ind:LicenseAccreditation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spaceAllocationId rdf:type rdf:Property ;
    rdfs:label 'Space Allocation Id' ;
    rdfs:comment 'Unique identifier for the space allocation record. Primary key.' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocatedSquareFootage rdf:type rdf:Property ;
    rdfs:label 'Allocated Square Footage' ;
    rdfs:comment 'Total square footage of the space allocated to the department or cost center, measured in square feet.' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationEndDate rdf:type rdf:Property ;
    rdfs:label 'Allocation End Date' ;
    rdfs:comment 'Date when the space allocation ends or is scheduled to end. Null indicates an open-ended allocation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationNumber rdf:type rdf:Property ;
    rdfs:label 'Allocation Number' ;
    rdfs:comment 'Business identifier for the space allocation record, used for tracking and reporting purposes.' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationPriority rdf:type rdf:Property ;
    rdfs:label 'Allocation Priority' ;
    rdfs:comment 'Priority level of the space allocation, used for space planning and reallocation decisions during capacity constraints.' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationStartDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Start Date' ;
    rdfs:comment 'Date when the space allocation becomes effective and the department or cost center assumes responsibility.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationStatus rdf:type rdf:Property ;
    rdfs:label 'Allocation Status' ;
    rdfs:comment 'Current lifecycle status of the space allocation record, indicating whether it is currently in effect or has been terminated.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualSpaceCost rdf:type rdf:Property ;
    rdfs:label 'Annual Space Cost' ;
    rdfs:comment 'Annualized cost of the space allocation, calculated for budgeting and long-term financial planning purposes.' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costPerSquareFoot rdf:type rdf:Property ;
    rdfs:label 'Cost Per Square Foot' ;
    rdfs:comment 'Unit cost per square foot of the allocated space, used for comparative analysis and benchmarking across facilities.' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveFromTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective From Timestamp' ;
    rdfs:comment 'Timestamp when this allocation record version became effective, supporting temporal tracking and historical analysis.' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:effectiveToTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective To Timestamp' ;
    rdfs:comment 'Timestamp when this allocation record version ceased to be effective. Null indicates the current active version.' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:primaryUseFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Use Flag' ;
    rdfs:comment 'Indicates whether this allocation represents the primary use of the space (true) or a secondary/shared use (false).' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sharedSpaceFlag rdf:type rdf:Property ;
    rdfs:label 'Shared Space Flag' ;
    rdfs:comment 'Indicates whether the space is shared among multiple departments or cost centers (true) or exclusively allocated to one entity (false).' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:spaceSubtype rdf:type rdf:Property ;
    rdfs:label 'Space Subtype' ;
    rdfs:comment 'Detailed classification of the space within the primary type (e.g., patient room, exam room, office, conference room, supply closet).' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spaceType rdf:type rdf:Property ;
    rdfs:label 'Space Type' ;
    rdfs:comment 'Classification of the allocated space by functional use category.' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wingSection rdf:type rdf:Property ;
    rdfs:label 'Wing Section' ;
    rdfs:comment 'Wing, section, or zone designation within the building for the allocated space, used for wayfinding and operational organization.' ;
    rdfs:domain ind:SpaceAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Environmental Employee Id' ;
    rdfs:comment 'Identifier of the staff member who performed the quality inspection, typically environmental services supervisor or infection preventionist.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assignedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assigned Timestamp' ;
    rdfs:comment 'Date and time when the request was assigned to an environmental services staff member.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:bedBoardIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Bed Board Integration Flag' ;
    rdfs:comment 'Indicates whether this request is integrated with the real-time bed management system for automated bed status updates.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bedStatusUpdatedFlag rdf:type rdf:Property ;
    rdfs:label 'Bed Status Updated Flag' ;
    rdfs:comment 'Indicates whether the bed status was automatically updated to available upon completion of cleaning.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cancellationReason rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason' ;
    rdfs:comment 'Reason for cancelling the environmental service request, such as patient readmission, room change, or duplicate request.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cancellation Timestamp' ;
    rdfs:comment 'Date and time when the environmental service request was cancelled.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cleaningProtocolUsed rdf:type rdf:Property ;
    rdfs:label 'Cleaning Protocol Used' ;
    rdfs:comment 'Specific cleaning and disinfection protocol applied based on infection control requirements. Contact precaution for resistant organisms; C. diff protocol uses sporicidal agents; COVID protocol follows CDC guidance; MRSA protocol for methicillin-resistant Staphylococcus aureus; standard for routine cleaning; enhanced for high-touch surfaces.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeToCleanCycleTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Discharge To Clean Cycle Time Minutes' ;
    rdfs:comment 'Total elapsed time in minutes from patient discharge to room ready for next admission. Critical metric for bed throughput optimization and Emergency Department (ED) boarding reduction.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disinfectantProductUsed rdf:type rdf:Property ;
    rdfs:label 'Disinfectant Product Used' ;
    rdfs:comment 'Name or identifier of the EPA-registered disinfectant product used for cleaning and disinfection.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityInspectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Facility Inspection Timestamp' ;
    rdfs:comment 'Date and time when the quality inspection was performed.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:infectionPreventionAlertFlag rdf:type rdf:Property ;
    rdfs:label 'Infection Prevention Alert Flag' ;
    rdfs:comment 'Indicates whether this request was flagged for infection prevention review due to Healthcare-Associated Infection (HAI) risk or outbreak investigation.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isolationPrecautionType rdf:type rdf:Property ;
    rdfs:label 'Isolation Precaution Type' ;
    rdfs:comment 'Type of isolation precaution in effect for the location, such as contact, droplet, airborne, or protective environment. Determines cleaning protocol requirements. [ENUM-REF-CANDIDATE: contact|droplet|airborne|protective environment|standard|contact plus|neutropenic|reverse isolation — promote to reference product]' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientDischargeTimestamp rdf:type rdf:Property ;
    rdfs:label 'Patient Discharge Timestamp' ;
    rdfs:comment 'Date and time when the patient was discharged from the bed or room, triggering the need for terminal or discharge cleaning. Used to calculate discharge-to-clean cycle time.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:qualityInspectionPerformedFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Inspection Performed Flag' ;
    rdfs:comment 'Indicates whether a quality inspection was conducted after cleaning completion.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityInspectionResult rdf:type rdf:Property ;
    rdfs:label 'Quality Inspection Result' ;
    rdfs:comment 'Outcome of the quality inspection. Passed indicates the space meets cleanliness standards; failed requires rework; not inspected when inspection was not performed.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestToStartTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Request To Start Time Minutes' ;
    rdfs:comment 'Elapsed time in minutes from request creation to work start. Measures environmental services responsiveness.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requestType rdf:type rdf:Property ;
    rdfs:label 'Request Type' ;
    rdfs:comment 'Type of environmental service requested. Terminal clean is comprehensive end-of-stay cleaning; discharge clean is post-patient departure; isolation clean follows contact precaution protocols; routine clean is scheduled maintenance; spill response addresses immediate contamination; biohazard cleanup handles infectious or hazardous materials.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialEquipmentRequired rdf:type rdf:Property ;
    rdfs:label 'Special Equipment Required' ;
    rdfs:comment 'Description of any special equipment needed for the cleaning task, such as ultraviolet (UV) disinfection devices, electrostatic sprayers, or HEPA vacuums.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Work Duration Minutes' ;
    rdfs:comment 'Actual time in minutes spent performing the cleaning or disinfection work, from start to completion.' ;
    rdfs:domain ind:EnvironmentalServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacitySnapshotId rdf:type rdf:Property ;
    rdfs:label 'Capacity Snapshot Id' ;
    rdfs:comment 'Unique identifier for the capacity snapshot record. Primary key.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alternateCareSiteActivationStatus rdf:type rdf:Property ;
    rdfs:label 'Alternate Care Site Activation Status' ;
    rdfs:comment 'Indicates whether alternate care sites (field hospitals, temporary facilities) have been activated to handle overflow capacity during emergencies.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ambulanceDiversionStatus rdf:type rdf:Property ;
    rdfs:label 'Ambulance Diversion Status' ;
    rdfs:comment 'Indicates whether the facility is currently on ambulance diversion, meaning incoming ambulances are being redirected to other facilities due to capacity constraints.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:availableBeds rdf:type rdf:Property ;
    rdfs:label 'Available Beds' ;
    rdfs:comment 'Number of staffed beds that are immediately available for patient assignment (not occupied, not in cleaning, not out of service).' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bariatricBedsAvailable rdf:type rdf:Property ;
    rdfs:label 'Bariatric Beds Available' ;
    rdfs:comment 'Number of bariatric-capable beds (designed for patients with high body mass index) currently available.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bedsInCleaning rdf:type rdf:Property ;
    rdfs:label 'Beds In Cleaning' ;
    rdfs:comment 'Number of beds currently undergoing environmental services cleaning or terminal cleaning after patient discharge. These beds are temporarily unavailable.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bedsOutOfService rdf:type rdf:Property ;
    rdfs:label 'Beds Out Of Service' ;
    rdfs:comment 'Number of beds that are out of service due to maintenance, equipment failure, isolation requirements, or other operational reasons.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disasterCensus rdf:type rdf:Property ;
    rdfs:label 'Disaster Census' ;
    rdfs:comment 'Total number of patients being treated as a result of a declared disaster or mass casualty event at the time of the snapshot.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:edBoardingCount rdf:type rdf:Property ;
    rdfs:label 'Ed Boarding Count' ;
    rdfs:comment 'Number of admitted patients currently boarding in the Emergency Department awaiting an inpatient bed. ED boarding is a key capacity constraint metric.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:edBypassStatus rdf:type rdf:Property ;
    rdfs:label 'Ed Bypass Status' ;
    rdfs:comment 'Indicates whether the Emergency Department is on bypass status, temporarily not accepting new patients due to capacity or operational constraints.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:edCensus rdf:type rdf:Property ;
    rdfs:label 'Ed Census' ;
    rdfs:comment 'Total number of patients currently in the Emergency Department at the time of the snapshot, including those awaiting admission.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eocActivationStatus rdf:type rdf:Property ;
    rdfs:label 'Eoc Activation Status' ;
    rdfs:comment 'Indicates whether the hospital Emergency Operations Center has been activated to coordinate emergency response and capacity management.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icuBypassStatus rdf:type rdf:Property ;
    rdfs:label 'Icu Bypass Status' ;
    rdfs:comment 'Indicates whether the ICU is on bypass status, temporarily not accepting new admissions due to capacity constraints.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icuCensus rdf:type rdf:Property ;
    rdfs:label 'Icu Census' ;
    rdfs:comment 'Total number of patients currently in the Intensive Care Unit at the time of the snapshot.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isolationBedsAvailable rdf:type rdf:Property ;
    rdfs:label 'Isolation Beds Available' ;
    rdfs:comment 'Number of isolation-capable beds (negative pressure or airborne infection isolation rooms) currently available for patients requiring isolation precautions.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nicuCensus rdf:type rdf:Property ;
    rdfs:label 'Nicu Census' ;
    rdfs:comment 'Total number of neonatal patients currently in the Neonatal Intensive Care Unit at the time of the snapshot.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:observationBedsAvailable rdf:type rdf:Property ;
    rdfs:label 'Observation Beds Available' ;
    rdfs:comment 'Number of observation beds currently available for patients under observation status (not formally admitted).' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occupiedBeds rdf:type rdf:Property ;
    rdfs:label 'Occupied Beds' ;
    rdfs:comment 'Number of beds currently occupied by patients at the time of the snapshot.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:orUtilizationPercentage rdf:type rdf:Property ;
    rdfs:label 'Or Utilization Percentage' ;
    rdfs:comment 'Percentage of Operating Room capacity currently in use at the time of the snapshot. Calculated as (active OR cases / total OR capacity) * 100.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pediatricBedsAvailable rdf:type rdf:Property ;
    rdfs:label 'Pediatric Beds Available' ;
    rdfs:comment 'Number of pediatric beds currently available for patients under 18 years of age.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:snapshotSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Snapshot Source System' ;
    rdfs:comment 'The system or application that generated this capacity snapshot (e.g., Epic ADT, Hospital Command Center Dashboard, Bed Management System).' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snapshotTimestamp rdf:type rdf:Property ;
    rdfs:label 'Snapshot Timestamp' ;
    rdfs:comment 'The exact date and time when this capacity snapshot was captured. This is the principal business event timestamp for real-time capacity tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:snapshotType rdf:type rdf:Property ;
    rdfs:label 'Snapshot Type' ;
    rdfs:comment 'Indicates whether this snapshot was captured as part of a scheduled interval, on-demand request, emergency response, or automated system trigger.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surgeBedsAvailable rdf:type rdf:Property ;
    rdfs:label 'Surge Beds Available' ;
    rdfs:comment 'Number of surge beds that can be activated in an emergency or disaster scenario. Surge beds are additional capacity beyond normal staffed beds.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:telemetryBedsAvailable rdf:type rdf:Property ;
    rdfs:label 'Telemetry Beds Available' ;
    rdfs:comment 'Number of telemetry-capable beds currently available for patients requiring continuous cardiac monitoring.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalLicensedBeds rdf:type rdf:Property ;
    rdfs:label 'Total Licensed Beds' ;
    rdfs:comment 'Total number of beds the facility is licensed to operate by state health department. This is the regulatory maximum capacity.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalStaffedBeds rdf:type rdf:Property ;
    rdfs:label 'Total Staffed Beds' ;
    rdfs:comment 'Total number of beds that are currently staffed and available for patient assignment. Staffed beds are a subset of licensed beds and reflect operational capacity.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ventilatorAvailabilityCount rdf:type rdf:Property ;
    rdfs:label 'Ventilator Availability Count' ;
    rdfs:comment 'Number of mechanical ventilators currently available and ready for patient use. Critical for respiratory emergency preparedness and pandemic response.' ;
    rdfs:domain ind:CapacitySnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medicalDirectorClinicianId rdf:type rdf:Property ;
    rdfs:label 'Medical Director Clinician Id' ;
    rdfs:comment 'Foreign key linking to provider.clinician. Business justification: Service line governance and accreditation requirements mandate a named medical director for each clinical service. Links to clinician record for credentialing verification, privileging confirmation, a' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:accreditationDate rdf:type rdf:Property ;
    rdfs:label 'Accreditation Date' ;
    rdfs:comment 'Date on which the service received its current accreditation or certification from the accrediting body.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accreditationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Accreditation Required Flag' ;
    rdfs:comment 'Boolean indicator of whether the service requires specific accreditation or certification from an external body such as The Joint Commission, American College of Surgeons, or specialty-specific accrediting organizations.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bariatricSurgeryAccreditation rdf:type rdf:Property ;
    rdfs:label 'Bariatric Surgery Accreditation' ;
    rdfs:comment 'Metabolic and Bariatric Surgery Accreditation and Quality Improvement Program (MBSAQIP) accreditation status for bariatric surgery services.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancerProgramAccreditation rdf:type rdf:Property ;
    rdfs:label 'Cancer Program Accreditation' ;
    rdfs:comment 'Commission on Cancer accreditation status or designation for oncology services, such as Comprehensive Community Cancer Program, Academic Comprehensive Cancer Program, or Community Cancer Program.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalSpecialty rdf:type rdf:Property ;
    rdfs:label 'Clinical Specialty' ;
    rdfs:comment 'Specific clinical specialty or subspecialty associated with the service, such as Cardiothoracic Surgery, Interventional Cardiology, Neonatology, Radiation Oncology, or Psychiatry.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsFacilityServiceTypeCode rdf:type rdf:Property ;
    rdfs:label 'Cms Facility Service Type Code' ;
    rdfs:comment 'CMS-defined service type code used for billing, claims processing, and regulatory reporting to identify the nature of the service provided.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyFacilityServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Facility Service Flag' ;
    rdfs:comment 'Boolean indicator of whether the service is classified as an emergency service subject to Emergency Medical Treatment and Labor Act (EMTALA) requirements.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:facilityServiceCode rdf:type rdf:Property ;
    rdfs:label 'Facility Service Code' ;
    rdfs:comment 'Unique alphanumeric code identifying the clinical service or program within the organizations service catalog.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityServiceName rdf:type rdf:Property ;
    rdfs:label 'Facility Service Name' ;
    rdfs:comment 'Full descriptive name of the clinical service or program offered at the care site, such as Cardiac Surgery, Level I Trauma Center, Comprehensive Stroke Center, NICU Level III, Radiation Oncology, Behavioral Health, or Telehealth.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityServiceStatus rdf:type rdf:Property ;
    rdfs:label 'Facility Service Status' ;
    rdfs:comment 'Current operational status of the service indicating whether it is actively offered, temporarily suspended, planned for future launch, or discontinued.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'License Required Flag' ;
    rdfs:comment 'Boolean indicator of whether the service requires a specific state or federal license to operate legally, such as a radiation therapy license or behavioral health program license.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:line rdf:type rdf:Property ;
    rdfs:label 'Line' ;
    rdfs:comment 'High-level service line grouping such as Cardiovascular, Neurosciences, Oncology, Womens Health, Pediatrics, Behavioral Health, Emergency Services, or Surgical Services.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nicuLevel rdf:type rdf:Property ;
    rdfs:label 'Nicu Level' ;
    rdfs:comment 'American Academy of Pediatrics NICU level designation (Level I through Level IV) indicating the complexity of neonatal care capabilities. Not applicable for non-neonatal services.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientAccessPhone rdf:type rdf:Property ;
    rdfs:label 'Patient Access Phone' ;
    rdfs:comment 'Primary phone number for patients or referring providers to contact for scheduling, inquiries, or referrals to this service.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerContractedFlag rdf:type rdf:Property ;
    rdfs:label 'Payer Contracted Flag' ;
    rdfs:comment 'Boolean indicator of whether the service is included in payer contracts and eligible for reimbursement under managed care agreements.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:url rdf:type rdf:Property ;
    rdfs:label 'Url' ;
    rdfs:comment 'Web address or URL providing public-facing information about the service, used for patient education, referral routing, and marketing purposes.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volumeAnnual rdf:type rdf:Property ;
    rdfs:label 'Volume Annual' ;
    rdfs:comment 'Estimated or actual annual volume of patients or procedures served by this service, used for capacity planning, quality benchmarking, and payer contracting negotiations.' ;
    rdfs:domain ind:FacilityService ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:facilityContractId rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Id' ;
    rdfs:comment 'Unique identifier for the facility contract record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FacilityContract .

ind:annualSpendAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Spend Amount' ;
    rdfs:comment 'Estimated or actual annual spend under this contract. Used for budgeting and variance analysis.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityServiceType rdf:type rdf:Property ;
    rdfs:label 'Facility Service Type' ;
    rdfs:comment 'Category of service provided under this contract. Includes janitorial, biomedical equipment service (OEM and third-party), elevator maintenance, HVAC service, security, waste management (regulated medical waste, hazardous waste), food services, landscaping, and pest control. [ENUM-REF-CANDIDATE: janitorial|biomedical_equipment_service|elevator_maintenance|hvac_service|security_services|waste_management|food_services|landscaping|pest_control|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCertificateExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Insurance Certificate Expiration Date' ;
    rdfs:comment 'Expiration date of the vendors current insurance certificate on file. Used to track compliance with insurance requirements. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insuranceRequirementDescription rdf:type rdf:Property ;
    rdfs:label 'Insurance Requirement Description' ;
    rdfs:comment 'Description of insurance coverage requirements the vendor must maintain (e.g., general liability, professional liability, workers compensation, minimum coverage amounts).' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPerformanceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Performance Review Date' ;
    rdfs:comment 'Date of the most recent vendor performance review or evaluation. Used to track vendor management activities. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextPerformanceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Performance Review Date' ;
    rdfs:comment 'Scheduled date for the next vendor performance review or evaluation. Supports proactive vendor management. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noticePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Notice Period Days' ;
    rdfs:comment 'Number of days advance notice required to terminate or opt out of renewal. Critical for contract management and planning.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ownerEmail rdf:type rdf:Property ;
    rdfs:label 'Owner Email' ;
    rdfs:comment 'Email address of the contract owner for communication and escalation purposes.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerName rdf:type rdf:Property ;
    rdfs:label 'Owner Name' ;
    rdfs:comment 'Name of the internal staff member or department responsible for managing and overseeing this contract.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerPhone rdf:type rdf:Property ;
    rdfs:label 'Owner Phone' ;
    rdfs:comment 'Phone number of the contract owner for direct contact.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceMetricDescription rdf:type rdf:Property ;
    rdfs:label 'Performance Metric Description' ;
    rdfs:comment 'Description of key performance indicators (KPIs) and metrics used to evaluate vendor performance under the contract.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceNotes rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Notes' ;
    rdfs:comment 'Notes on regulatory compliance requirements applicable to this contract, such as OSHA workplace safety, EPA environmental standards, Joint Commission requirements, or state health department regulations for contracted services.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalOptionFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Option Flag' ;
    rdfs:comment 'Indicates whether the contract includes an option to renew at the end of the term. True if renewal option exists, False otherwise.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signedDate rdf:type rdf:Property ;
    rdfs:label 'Signed Date' ;
    rdfs:comment 'Date on which the contract was signed by both parties. Used for audit trail and contract lifecycle tracking. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:slaTerms rdf:type rdf:Property ;
    rdfs:label 'Sla Terms' ;
    rdfs:comment 'Summary of the Service Level Agreement terms, including response times, uptime guarantees, and performance metrics defined in the contract.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaUptimePercentage rdf:type rdf:Property ;
    rdfs:label 'Sla Uptime Percentage' ;
    rdfs:comment 'Minimum uptime or availability percentage guaranteed by the vendor (e.g., 99.5% for critical systems).' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminationClauseDescription rdf:type rdf:Property ;
    rdfs:label 'Termination Clause Description' ;
    rdfs:comment 'Summary of the termination clause, including conditions under which either party may terminate the contract (e.g., for cause, for convenience, breach of terms).' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueAmount rdf:type rdf:Property ;
    rdfs:label 'Value Amount' ;
    rdfs:comment 'Total monetary value of the contract over its full term. Used for budget planning and vendor spend analysis.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Value Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the contract value amount (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorContactEmail rdf:type rdf:Property ;
    rdfs:label 'Vendor Contact Email' ;
    rdfs:comment 'Email address of the primary vendor contact for service requests and communication.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorContactName rdf:type rdf:Property ;
    rdfs:label 'Vendor Contact Name' ;
    rdfs:comment 'Name of the primary vendor contact or account manager for this contract.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorContactPhone rdf:type rdf:Property ;
    rdfs:label 'Vendor Contact Phone' ;
    rdfs:comment 'Phone number of the primary vendor contact for escalations and urgent service needs.' ;
    rdfs:domain ind:FacilityContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardousMaterialId rdf:type rdf:Property ;
    rdfs:label 'Hazardous Material Id' ;
    rdfs:comment 'Unique identifier for the hazardous material record. Primary key.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activityLevel rdf:type rdf:Property ;
    rdfs:label 'Activity Level' ;
    rdfs:comment 'Radioactivity level of the material measured in curies (Ci) or becquerels (Bq), if applicable.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:biohazardLevel rdf:type rdf:Property ;
    rdfs:label 'Biohazard Level' ;
    rdfs:comment 'Biosafety level classification (BSL-1 through BSL-4) for biohazardous materials per CDC/NIH guidelines.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:casNumber rdf:type rdf:Property ;
    rdfs:label 'Cas Number' ;
    rdfs:comment 'Unique numerical identifier assigned by the Chemical Abstracts Service to chemical substances.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chemicalName rdf:type rdf:Property ;
    rdfs:label 'Chemical Name' ;
    rdfs:comment 'Scientific or IUPAC chemical name of the hazardous substance.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:containerSize rdf:type rdf:Property ;
    rdfs:label 'Container Size' ;
    rdfs:comment 'Size or capacity of the storage container with unit (e.g., 500 mL, 55 gallon, 150 lb cylinder).' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:containerType rdf:type rdf:Property ;
    rdfs:label 'Container Type' ;
    rdfs:comment 'Type of container in which the hazardous material is stored (e.g., bottle, drum, compressed gas cylinder). [ENUM-REF-CANDIDATE: bottle|drum|cylinder|tank|vial|ampule|bag|carboy — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentQuantityOnHand rdf:type rdf:Property ;
    rdfs:label 'Current Quantity On Hand' ;
    rdfs:comment 'Current quantity of the hazardous material physically present in inventory at this location.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:epaReportableQuantityFlag rdf:type rdf:Property ;
    rdfs:label 'Epa Reportable Quantity Flag' ;
    rdfs:comment 'Indicates whether the quantity on hand meets or exceeds EPA reportable quantity thresholds requiring notification.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ghsPictogramCodes rdf:type rdf:Property ;
    rdfs:label 'Ghs Pictogram Codes' ;
    rdfs:comment 'Comma-separated list of GHS pictogram codes (e.g., GHS02, GHS07) indicating hazard symbols required on labels.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardClass rdf:type rdf:Property ;
    rdfs:label 'Hazard Class' ;
    rdfs:comment 'Primary hazard classification according to OSHA Globally Harmonized System (GHS) of Classification and Labeling of Chemicals. [ENUM-REF-CANDIDATE: flammable|corrosive|toxic|oxidizer|compressed_gas|explosive|radioactive|biohazard|reactive|carcinogen — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardousMaterialStatus rdf:type rdf:Property ;
    rdfs:label 'Hazardous Material Status' ;
    rdfs:comment 'Current lifecycle status of the hazardous material inventory record.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incompatibleMaterials rdf:type rdf:Property ;
    rdfs:label 'Incompatible Materials' ;
    rdfs:comment 'List of chemical classes or specific materials that are incompatible and must not be stored or used near this material.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infectiousAgentName rdf:type rdf:Property ;
    rdfs:label 'Infectious Agent Name' ;
    rdfs:comment 'Name of the infectious agent or pathogen if the material is biohazardous.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lotNumber rdf:type rdf:Property ;
    rdfs:label 'Lot Number' ;
    rdfs:comment 'Manufacturers lot or batch number for traceability and quality control.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufacturerProductCode rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Product Code' ;
    rdfs:comment 'Manufacturers catalog or product code for the hazardous material.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialName rdf:type rdf:Property ;
    rdfs:label 'Material Name' ;
    rdfs:comment 'Common or trade name of the hazardous material as used in facility operations.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumAllowableQuantity rdf:type rdf:Property ;
    rdfs:label 'Maximum Allowable Quantity' ;
    rdfs:comment 'Maximum quantity of the hazardous material permitted to be stored at this location per regulatory or facility policy limits.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextInspectionDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Inspection Due Date' ;
    rdfs:comment 'Date when the next scheduled safety inspection is due for this hazardous material.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nfpaRating rdf:type rdf:Property ;
    rdfs:label 'Nfpa Rating' ;
    rdfs:comment 'NFPA 704 diamond rating in format Health-Flammability-Instability-Special (e.g., 2-3-1-OX).' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Permit Expiration Date' ;
    rdfs:comment 'Expiration date of the regulatory permit or license, if applicable.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:permitNumber rdf:type rdf:Property ;
    rdfs:label 'Permit Number' ;
    rdfs:comment 'Regulatory permit or license number authorizing storage or use of this hazardous material, if applicable.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:personalProtectiveEquipmentRequired rdf:type rdf:Property ;
    rdfs:label 'Personal Protective Equipment Required' ;
    rdfs:comment 'Description of personal protective equipment required when handling this material (e.g., gloves, goggles, respirator, lab coat).' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:radioactiveIsotope rdf:type rdf:Property ;
    rdfs:label 'Radioactive Isotope' ;
    rdfs:comment 'Specific radioactive isotope designation (e.g., I-131, Tc-99m, Co-60) if the material is radioactive.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:radioactiveMaterialFlag rdf:type rdf:Property ;
    rdfs:label 'Radioactive Material Flag' ;
    rdfs:comment 'Indicates whether the material is radioactive and subject to Nuclear Regulatory Commission (NRC) or state radiation control regulations.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:receiptDate rdf:type rdf:Property ;
    rdfs:label 'Receipt Date' ;
    rdfs:comment 'Date the hazardous material was received into facility inventory.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryPermitRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Permit Required Flag' ;
    rdfs:comment 'Indicates whether a regulatory permit or license is required to store or use this hazardous material.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responsiblePersonContact rdf:type rdf:Property ;
    rdfs:label 'Responsible Person Contact' ;
    rdfs:comment 'Contact phone number or email for the responsible person.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsiblePersonName rdf:type rdf:Property ;
    rdfs:label 'Responsible Person Name' ;
    rdfs:comment 'Name of the individual designated as responsible for this hazardous material inventory item.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saraTitleIiiReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Sara Title Iii Reportable Flag' ;
    rdfs:comment 'Indicates whether this material is subject to SARA Title III (EPCRA) reporting requirements for emergency planning and community right-to-know.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sdsDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Sds Document Number' ;
    rdfs:comment 'Reference identifier or document management system ID for the Safety Data Sheet associated with this material.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdsRevisionDate rdf:type rdf:Property ;
    rdfs:label 'Sds Revision Date' ;
    rdfs:comment 'Date of the most recent revision of the Safety Data Sheet for this material.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:specialHandlingInstructions rdf:type rdf:Property ;
    rdfs:label 'Special Handling Instructions' ;
    rdfs:comment 'Additional handling, storage, or usage instructions specific to this hazardous material.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageCabinetType rdf:type rdf:Property ;
    rdfs:label 'Storage Cabinet Type' ;
    rdfs:comment 'Type of specialized storage cabinet or container used for the hazardous material. [ENUM-REF-CANDIDATE: flammable_cabinet|corrosive_cabinet|general_chemical|refrigerated|ventilated|explosive_magazine|radioactive_shielded|biohazard_containment — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Storage Location Description' ;
    rdfs:comment 'Detailed description of the physical storage location within the facility (e.g., cabinet number, shelf, zone).' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ventilationRequirement rdf:type rdf:Property ;
    rdfs:label 'Ventilation Requirement' ;
    rdfs:comment 'Type of ventilation control required when using this hazardous material.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wasteStreamCode rdf:type rdf:Property ;
    rdfs:label 'Waste Stream Code' ;
    rdfs:comment 'EPA hazardous waste code (e.g., D001, P-listed, U-listed) or facility-specific waste stream identifier for disposal tracking.' ;
    rdfs:domain ind:HazardousMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyIncidentId rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Id' ;
    rdfs:comment 'Unique identifier for the safety incident or hazardous material inventory record. Primary key.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cmsImmediateJeopardyFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Immediate Jeopardy Flag' ;
    rdfs:comment 'Indicator of whether the incident constitutes an immediate jeopardy situation requiring notification to CMS. Applicable when record_type is incident.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveActions rdf:type rdf:Property ;
    rdfs:label 'Corrective Actions' ;
    rdfs:comment 'Description of corrective and preventive actions implemented or planned to prevent recurrence of similar incidents. Applicable when record_type is incident.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:immediateActionsTaken rdf:type rdf:Property ;
    rdfs:label 'Immediate Actions Taken' ;
    rdfs:comment 'Description of the immediate response actions taken at the time of the incident to mitigate harm, secure the area, or address the hazard. Applicable when record_type is incident.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Incident Timestamp' ;
    rdfs:comment 'The precise date and time when the safety incident occurred. Principal business event timestamp. Applicable when record_type is incident.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:injuriesSustainedFlag rdf:type rdf:Property ;
    rdfs:label 'Injuries Sustained Flag' ;
    rdfs:comment 'Indicator of whether any injuries to staff, patients, or visitors resulted from the incident. Applicable when record_type is incident.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:injuryCount rdf:type rdf:Property ;
    rdfs:label 'Injury Count' ;
    rdfs:comment 'Number of individuals who sustained injuries as a result of the incident. Applicable when record_type is incident.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:injurySeverity rdf:type rdf:Property ;
    rdfs:label 'Injury Severity' ;
    rdfs:comment 'Classification of the most severe injury sustained in the incident. Applicable when record_type is incident.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:osha300LogRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Osha 300 Log Required Flag' ;
    rdfs:comment 'Indicator of whether the incident must be recorded on the OSHA 300 Log of Work-Related Injuries and Illnesses. Applicable when record_type is incident.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:osha301ReportRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Osha 301 Report Required Flag' ;
    rdfs:comment 'Indicator of whether an OSHA 301 Injury and Illness Incident Report must be filed for the incident. Applicable when record_type is incident.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:propertyDamageAmount rdf:type rdf:Property ;
    rdfs:label 'Property Damage Amount' ;
    rdfs:comment 'Estimated monetary value of property damage resulting from the incident, in US dollars. Applicable when record_type is incident.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyDamageFlag rdf:type rdf:Property ;
    rdfs:label 'Property Damage Flag' ;
    rdfs:comment 'Indicator of whether property damage occurred as a result of the incident. Applicable when record_type is incident.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quantityUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Quantity Unit Of Measure' ;
    rdfs:comment 'Unit of measure for the hazardous material quantity (e.g., gallons, liters, pounds, kilograms). Applicable when record_type is hazmat_inventory.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCauseSummary rdf:type rdf:Property ;
    rdfs:label 'Root Cause Summary' ;
    rdfs:comment 'Summary of the identified root cause(s) of the incident based on investigation and analysis. Applicable when record_type is incident.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdsReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sds Reference Number' ;
    rdfs:comment 'Reference number or identifier for the Safety Data Sheet document associated with this hazardous material. Applicable when record_type is hazmat_inventory.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateDohNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'State Doh Notification Required Flag' ;
    rdfs:comment 'Indicator of whether the incident requires notification to the state Department of Health. Applicable when record_type is incident.' ;
    rdfs:domain ind:SafetyIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:siteHierarchyId rdf:type rdf:Property ;
    rdfs:label 'Site Hierarchy Id' ;
    rdfs:comment 'Unique identifier for the site hierarchy node within the integrated delivery network (IDN). Primary key.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentSiteHierarchyId rdf:type rdf:Property ;
    rdfs:label 'Parent Site Hierarchy Id' ;
    rdfs:comment 'Reference to the parent node in the organizational hierarchy. Null for root-level health system node. Enables recursive parent-child relationships for multi-level IDN structures.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SiteHierarchy .

ind:acoParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Aco Participation Flag' ;
    rdfs:comment 'Indicates whether this hierarchy node participates in an Accountable Care Organization (ACO) model. Relevant for value-based care reporting and MSSP attribution.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:activeStatus rdf:type rdf:Property ;
    rdfs:label 'Active Status' ;
    rdfs:comment 'Current operational status of the hierarchy node. Tracks lifecycle including mergers, acquisitions, divestitures, and organizational restructuring within the IDN.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chestPainCenterAccreditationFlag rdf:type rdf:Property ;
    rdfs:label 'Chest Pain Center Accreditation Flag' ;
    rdfs:comment 'Indicates whether facilities in this hierarchy node hold Chest Pain Center accreditation from the American College of Cardiology (ACC) or Society of Cardiovascular Patient Care (SCPC).' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsStarRating rdf:type rdf:Property ;
    rdfs:label 'Cms Star Rating' ;
    rdfs:comment 'CMS Overall Hospital Quality Star Rating (1-5 stars) for facilities within this hierarchy node. Publicly reported quality measure impacting patient choice and value-based purchasing.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:criticalAccessHospitalFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Access Hospital Flag' ;
    rdfs:comment 'Indicates whether facilities in this hierarchy node are designated as Critical Access Hospitals (CAH) under the Medicare Rural Hospital Flexibility Program.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disproportionateShareHospitalFlag rdf:type rdf:Property ;
    rdfs:label 'Disproportionate Share Hospital Flag' ;
    rdfs:comment 'Indicates whether facilities in this hierarchy node qualify for Disproportionate Share Hospital (DSH) payments due to serving a high percentage of low-income patients.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:epicOrganizationCode rdf:type rdf:Property ;
    rdfs:label 'Epic Organization Code' ;
    rdfs:comment 'Epic EHR system organization identifier for this hierarchy node. Used for cross-system data integration and operational reporting from Epic Healthy Planet and Caboodle.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leapfrogGrade rdf:type rdf:Property ;
    rdfs:label 'Leapfrog Grade' ;
    rdfs:comment 'Leapfrog Group Hospital Safety Grade (A-F) for facilities within this hierarchy node. Independent quality and safety rating used by employers and consumers.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:magnetRecognitionFlag rdf:type rdf:Property ;
    rdfs:label 'Magnet Recognition Flag' ;
    rdfs:comment 'Indicates whether facilities in this hierarchy node have achieved Magnet Recognition from the American Nurses Credentialing Center (ANCC) for nursing excellence.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketDesignation rdf:type rdf:Property ;
    rdfs:label 'Market Designation' ;
    rdfs:comment 'Market or service area designation for the hierarchy node. Aligns with payer contracting territories and population health management catchment areas.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nodeCode rdf:type rdf:Property ;
    rdfs:label 'Node Code' ;
    rdfs:comment 'Business identifier code for the hierarchy node. Used for reporting, payer contracting, and network planning. May align with Epic EHR organization codes or SAP organizational unit codes.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nodeLevel rdf:type rdf:Property ;
    rdfs:label 'Node Level' ;
    rdfs:comment 'Numeric depth of the node in the hierarchy tree. Root health system = 1, immediate children = 2, etc. Enables level-based queries and rollup aggregations.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nodeName rdf:type rdf:Property ;
    rdfs:label 'Node Name' ;
    rdfs:comment 'Full business name of the hierarchy node (e.g., Northeast Region, Metro Market, Downtown Campus, Main Hospital). Human-readable label for organizational rollup reporting.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nodePath rdf:type rdf:Property ;
    rdfs:label 'Node Path' ;
    rdfs:comment 'Materialized path from root to current node, typically slash-delimited hierarchy IDs (e.g., /1/5/12/45). Optimizes ancestor and descendant queries for reporting.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nodeType rdf:type rdf:Property ;
    rdfs:label 'Node Type' ;
    rdfs:comment 'Classification of the hierarchy node level within the IDN structure. Defines the organizational tier for multi-site rollup reporting and network planning. [ENUM-REF-CANDIDATE: health_system|region|market|campus|site|division|service_line — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenterCode rdf:type rdf:Property ;
    rdfs:label 'Profit Center Code' ;
    rdfs:comment 'Profit center code for this hierarchy node used in internal profitability analysis and segment reporting. Supports IDN-level financial consolidation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapOrganizationalUnit rdf:type rdf:Property ;
    rdfs:label 'Sap Organizational Unit' ;
    rdfs:comment 'SAP S/4HANA organizational unit code for this hierarchy node. Links to SAP FI/CO cost centers, profit centers, and business areas for financial consolidation.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soleCommunityHospitalFlag rdf:type rdf:Property ;
    rdfs:label 'Sole Community Hospital Flag' ;
    rdfs:comment 'Indicates whether facilities in this hierarchy node are designated as Sole Community Hospitals (SCH), qualifying for special Medicare payment adjustments.' ;
    rdfs:domain ind:SiteHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sortOrder rdf:type rdf:Property ;
    rdfs:label 'Sort Order' ;
    rdfs:comment 'Numeric sort order for displaying this hierarchy node among siblings in reports and user interfaces. Enables custom organizational display sequences.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:networkContractId rdf:type rdf:Property ;
    rdfs:label 'Network Contract Id' ;
    rdfs:comment 'Primary key for the network_contract association' ;
    rdfs:domain ind:NetworkContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:credentialingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Credentialing Required Flag' ;
    rdfs:comment 'Indicates whether individual provider credentialing is required for this facility to participate in the network under this contract. True for most commercial payers, may be false for government programs.' ;
    rdfs:domain ind:NetworkContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:networkContractStatus rdf:type rdf:Property ;
    rdfs:label 'Network Contract Status' ;
    rdfs:comment 'Current operational status of the network participation agreement. Active indicates the contract is in force and claims can be submitted. Suspended indicates temporary hold on network participation.' ;
    rdfs:domain ind:NetworkContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerCountAtFacility rdf:type rdf:Property ;
    rdfs:label 'Provider Count At Facility' ;
    rdfs:comment 'Number of individual providers at this facility who are credentialed and contracted under this network agreement. Used for network directory accuracy and adequacy reporting.' ;
    rdfs:domain ind:NetworkContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:facilityProgramParticipationId rdf:type rdf:Property ;
    rdfs:label 'Facility Program Participation Id' ;
    rdfs:comment 'Primary key for facility_program_participation' ;
    rdfs:domain ind:FacilityProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exemptionStatus rdf:type rdf:Property ;
    rdfs:label 'Exemption Status' ;
    rdfs:comment 'Indicates whether this care site has been granted an exemption from reporting or payment adjustment for this program and performance year. Captures CMS low-volume, extreme hardship, and other exemption categories.' ;
    rdfs:domain ind:FacilityProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationEndDate rdf:type rdf:Property ;
    rdfs:label 'Participation End Date' ;
    rdfs:comment 'Date the care site ceased participating in this quality program. Null for active participations. Used to track historical program participation and determine reporting obligations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:participationStartDate rdf:type rdf:Property ;
    rdfs:label 'Participation Start Date' ;
    rdfs:comment 'Date the care site began participating in this quality program. Determines when performance measurement and reporting obligations begin for this site-program combination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Adjustment Amount' ;
    rdfs:comment 'Dollar amount of payment adjustment (positive for incentive, negative for penalty) applied to this care sites Medicare reimbursement as a result of performance in this quality program for this performance year.' ;
    rdfs:domain ind:FacilityProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programParticipationCode rdf:type rdf:Property ;
    rdfs:label 'Program Participation Code' ;
    rdfs:comment 'Unique surrogate identifier for the care site quality program participation record. Primary key for the association.' ;
    rdfs:domain ind:FacilityProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalPerformanceScore rdf:type rdf:Property ;
    rdfs:label 'Total Performance Score' ;
    rdfs:comment 'Composite performance score achieved by this care site for this quality program in this performance year. Calculated per program-specific methodology. Determines payment adjustments and public reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:blockAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Block Assignment Id' ;
    rdfs:comment 'Unique identifier for each OR block assignment record. Primary key for the association.' ;
    rdfs:domain ind:BlockAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blockStartTime rdf:type rdf:Property ;
    rdfs:label 'Block Start Time' ;
    rdfs:comment 'Start time of the OR block assignment, stored as TIMESTAMP for Databricks/Spark SQL compatibility' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:blockTimeEnd rdf:type rdf:Property ;
    rdfs:label 'Block Time End' ;
    rdfs:comment 'End time of the recurring OR block window (e.g., 15:00:00 for afternoon end). Defines when the surgeons allocated OR time ends.' ;
    rdfs:domain ind:BlockAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:blockTimeStart rdf:type rdf:Property ;
    rdfs:label 'Block Time Start' ;
    rdfs:comment 'Start time of the recurring OR block window (e.g., 07:00:00 for a morning block). Defines when the surgeons allocated OR time begins.' ;
    rdfs:domain ind:BlockAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:blockType rdf:type rdf:Property ;
    rdfs:label 'Block Type' ;
    rdfs:comment 'Classification of the OR block assignment. Dedicated = surgeon has exclusive use; Shared = multiple surgeons share the block; Flex = can be released if unused; Release = must be released if not booked by deadline; On-Call = reserved for emergency cases.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseDeadlineHours rdf:type rdf:Property ;
    rdfs:label 'Release Deadline Hours' ;
    rdfs:comment 'Number of hours before the block start time by which the surgeon must release unused block time (e.g., 72 hours). Allows facility to reallocate unused OR capacity.' ;
    rdfs:domain ind:BlockAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:utilizationThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Utilization Threshold Pct' ;
    rdfs:comment 'Minimum utilization percentage required for the surgeon to retain this block assignment (e.g., 80.00 means surgeon must use at least 80% of allocated block time). Used for block release policies and utilization management.' ;
    rdfs:domain ind:BlockAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equipmentAuthorizationId rdf:type rdf:Property ;
    rdfs:label 'Equipment Authorization Id' ;
    rdfs:comment 'Unique identifier for each equipment authorization record. Primary key.' ;
    rdfs:domain ind:EquipmentAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:equipmentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Equipment Employee Id' ;
    rdfs:comment 'Employee ID of the clinical educator, biomedical engineer, or supervisor who verified the employees competency to operate this equipment. Supports audit trail and accountability.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:authorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Authorization Status' ;
    rdfs:comment 'Current status of the equipment authorization. ACTIVE indicates valid authorization; EXPIRED indicates recertification needed; SUSPENDED indicates temporary hold; REVOKED indicates authorization withdrawn; PENDING indicates awaiting competency verification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competencyVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Competency Verified Date' ;
    rdfs:comment 'Date when the employees competency to operate this specific equipment was verified through testing, observation, or certification. Required for TJC HR.01.06.01 compliance and clinical engineering safety protocols.' ;
    rdfs:domain ind:EquipmentAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primaryUserFlag rdf:type rdf:Property ;
    rdfs:label 'Primary User Flag' ;
    rdfs:comment 'Indicates whether this employee is designated as the primary user responsible for this equipment asset. Used for maintenance coordination, recall notifications, and equipment assignment tracking.' ;
    rdfs:domain ind:EquipmentAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerAssignmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Provider Assignment End Date' ;
    rdfs:comment 'Date when the equipment authorization expires or was terminated. Null indicates active authorization. Used for recertification scheduling and access control.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:providerAssignmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Provider Assignment Start Date' ;
    rdfs:comment 'Date when the equipment authorization became effective. Used for compliance tracking and audit trails.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:providerAssignmentType rdf:type rdf:Property ;
    rdfs:label 'Provider Assignment Type' ;
    rdfs:comment 'Classification of the authorization relationship. PRIMARY indicates the employee is the primary designated operator; BACKUP indicates backup/secondary operator; SHARED indicates shared equipment pool; TRAINING indicates trainee status with supervised use only.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Training Completion Date' ;
    rdfs:comment 'Date when the employee completed formal training on this equipment type. May precede competency verification date. Used for training program tracking and compliance reporting.' ;
    rdfs:domain ind:EquipmentAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:parentOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Parent Organization Id' ;
    rdfs:comment 'foreign_key_to' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:primaryCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Primary Care Site Id' ;
    rdfs:comment 'FK to the primary care_site that anchors this organization in the physical facility hierarchy. Links the legal/administrative organization entity to its main operational care delivery site. Required for mapping organizational P&L to physical locations, credentialing scope, and CMS Conditions of Participation reporting.' ;
    rdfs:domain ind:FacilityOrganization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:accreditationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Accreditation Effective Date' ;
    rdfs:comment 'Date when current accreditation status became effective.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accreditingBody rdf:type rdf:Property ;
    rdfs:label 'Accrediting Body' ;
    rdfs:comment 'Name of the primary accreditation organization (e.g., Joint Commission, DNV, HFAP).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalAccessHospitalIndicator rdf:type rdf:Property ;
    rdfs:label 'Critical Access Hospital Indicator' ;
    rdfs:comment 'Indicates whether the facility is designated as a Critical Access Hospital under Medicare.' ;
    rdfs:domain ind:FacilityOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyServicesIndicator rdf:type rdf:Property ;
    rdfs:label 'Emergency Services Indicator' ;
    rdfs:comment 'Indicates whether the facility provides emergency department services.' ;
    rdfs:domain ind:FacilityOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:establishedDate rdf:type rdf:Property ;
    rdfs:label 'Established Date' ;
    rdfs:comment 'Date when the organization was originally established or founded.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:healthSystemName rdf:type rdf:Property ;
    rdfs:label 'Health System Name' ;
    rdfs:comment 'Name of the integrated delivery network or health system to which this organization belongs.' ;
    rdfs:domain ind:FacilityOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseStatus rdf:type rdf:Property ;
    rdfs:label 'License Status' ;
    rdfs:comment 'Current status of the facility operating license.' ;
    rdfs:domain ind:FacilityOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalStartDate rdf:type rdf:Property ;
    rdfs:label 'Operational Start Date' ;
    rdfs:comment 'Date when the facility began active operations and patient care delivery.' ;
    rdfs:domain ind:FacilityOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:teachingHospitalIndicator rdf:type rdf:Property ;
    rdfs:label 'Teaching Hospital Indicator' ;
    rdfs:comment 'Indicates whether the facility is affiliated with a medical school and provides graduate medical education.' ;
    rdfs:domain ind:FacilityOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalBedCount rdf:type rdf:Property ;
    rdfs:label 'Total Bed Count' ;
    rdfs:comment 'Total number of licensed beds available across all units in the facility.' ;
    rdfs:domain ind:FacilityOrganization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:employeeCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Employee Care Site Id' ;
    rdfs:comment 'Identifier of the primary facility (hospital, clinic, outpatient center) where the workforce member is assigned. For contingent workers, this is the contracted facility assignment.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:primaryCredentialingCoordinatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Credentialing Coordinator Employee Id' ;
    rdfs:comment 'foreign_key_to' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryWorkLocationCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Primary Work Location Care Site Id' ;
    rdfs:comment 'FK to facility.care_site.care_site_id' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:providerSpecialtyId rdf:type rdf:Property ;
    rdfs:label 'Provider Specialty Id' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specialty .

ind:tertiaryPreceptorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Preceptor Employee Id' ;
    rdfs:comment 'Renamed to reflect business role: employee_id -> clinician_employee_id.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:billRate rdf:type rdf:Property ;
    rdfs:label 'Bill Rate' ;
    rdfs:comment 'Hourly bill rate charged by the staffing agency for a contingent workforce member. Used for contract cost management and budget variance analysis. Null for direct employees.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clinicalRoleType rdf:type rdf:Property ;
    rdfs:label 'Clinical Role Type' ;
    rdfs:comment 'Specific clinical role classification for clinical workforce members (e.g., Registered Nurse, Physician, Pharmacist, Radiologic Technologist, Medical Assistant). Null for non-clinical staff. Used for staffing ratio compliance and scope-of-practice enforcement. [ENUM-REF-CANDIDATE: physician|registered_nurse|licensed_practical_nurse|pharmacist|radiologic_technologist|medical_assistant|respiratory_therapist|physical_therapist|occupational_therapist|social_worker — promote to reference product]' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmeHoursCompleted rdf:type rdf:Property ;
    rdfs:label 'Cme Hours Completed' ;
    rdfs:comment 'Total Continuing Medical Education (CME) hours completed by the workforce member in the current compliance cycle. Tracked in Workday HCM Learning and Symplr.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cmeHoursRequired rdf:type rdf:Property ;
    rdfs:label 'Cme Hours Required' ;
    rdfs:comment 'Total Continuing Medical Education (CME) hours required per compliance cycle for this workforce member based on their role, specialty, and state licensing requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employmentStatus rdf:type rdf:Property ;
    rdfs:label 'Employment Status' ;
    rdfs:comment 'Current lifecycle status of the workforce members employment relationship with the organization. Drives access provisioning, payroll processing, and scheduling eligibility.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentType rdf:type rdf:Property ;
    rdfs:label 'Employment Type' ;
    rdfs:comment 'Classification of the workforce members employment arrangement. Full-time and part-time are direct employees; PRN (pro re nata/as needed) are on-call staff; contract includes locum tenens and travel nurses; contingent includes agency and per diem staff.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityContractEndDate rdf:type rdf:Property ;
    rdfs:label 'Facility Contract End Date' ;
    rdfs:comment 'End date of the staffing contract for contingent workers. Triggers renewal workflow or offboarding. Null for direct employees.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilityContractStartDate rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Start Date' ;
    rdfs:comment 'Start date of the staffing contract for contingent workers (travel nurses, locum tenens, agency staff). Null for direct employees. Used for contract lifecycle management and scheduling.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:flsaClassification rdf:type rdf:Property ;
    rdfs:label 'Flsa Classification' ;
    rdfs:comment 'Indicates whether the workforce member is classified as exempt or non-exempt under the Fair Labor Standards Act (FLSA). Determines overtime eligibility and payroll processing rules.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fteValue rdf:type rdf:Property ;
    rdfs:label 'Fte Value' ;
    rdfs:comment 'The Full-Time Equivalent (FTE) value representing the proportion of a full-time schedule this workforce member is budgeted for (e.g., 1.0 = full-time, 0.5 = half-time, 0.2 = PRN). Critical for workforce planning, staffing ratios, and budget management.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hireDate rdf:type rdf:Property ;
    rdfs:label 'Hire Date' ;
    rdfs:comment 'The official date on which the workforce member was hired or onboarded by the organization. Used for tenure calculations, benefits eligibility, and regulatory reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:oigExclusionCheckDate rdf:type rdf:Property ;
    rdfs:label 'Oig Exclusion Check Date' ;
    rdfs:comment 'Date of the most recent OIG List of Excluded Individuals and Entities (LEIE) screening for this workforce member. Supports monthly compliance verification required by CMS.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:oigExclusionChecked rdf:type rdf:Property ;
    rdfs:label 'Oig Exclusion Checked' ;
    rdfs:comment 'Indicates whether the workforce member has been screened against the OIG List of Excluded Individuals and Entities (LEIE). Required for all employees involved in federally funded healthcare programs (Medicare, Medicaid). Must be checked at hire and monthly thereafter.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalHireDate rdf:type rdf:Property ;
    rdfs:label 'Original Hire Date' ;
    rdfs:comment 'The original hire date for rehired employees, preserving continuous service credit for benefits, seniority, and retirement vesting calculations. Distinct from hire_date for rehires.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:oshaTrainingCurrent rdf:type rdf:Property ;
    rdfs:label 'Osha Training Current' ;
    rdfs:comment 'Indicates whether the workforce member has completed all required OSHA workplace safety training (bloodborne pathogens, hazard communication, fire safety) within the required compliance period.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payRate rdf:type rdf:Property ;
    rdfs:label 'Pay Rate' ;
    rdfs:comment 'Hourly pay rate paid directly to the contingent workforce member or to the staffing agency. Used for labor cost accounting and contract compliance. Null for salaried direct employees.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:personalEmail rdf:type rdf:Property ;
    rdfs:label 'Personal Email' ;
    rdfs:comment 'Personal (non-institutional) email address for the workforce member. Used for benefit enrollment communications, emergency contact, and off-boarding notifications.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredName rdf:type rdf:Property ;
    rdfs:label 'Preferred Name' ;
    rdfs:comment 'The name the workforce member prefers to be called in day-to-day operations, displayed on badges and scheduling systems. May differ from legal name.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySpecialty rdf:type rdf:Property ;
    rdfs:label 'Primary Specialty' ;
    rdfs:comment 'Primary clinical specialty of the workforce member (e.g., Emergency Medicine, Cardiology, Oncology). Applicable to physicians and advanced practice providers. Used for scheduling, credentialing, and network adequacy reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerCredentialVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Provider Credential Verification Status' ;
    rdfs:comment 'Current status of primary credential verification through Symplr or primary source verification. Drives privileging decisions and scheduling eligibility for clinical staff.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rehireEligible rdf:type rdf:Property ;
    rdfs:label 'Rehire Eligible' ;
    rdfs:comment 'Indicates whether a terminated workforce member is eligible for rehire. Set during offboarding based on performance history, termination reason, and compliance review.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:staffingAgencyName rdf:type rdf:Property ;
    rdfs:label 'Staffing Agency Name' ;
    rdfs:comment 'Name of the external staffing agency supplying the contingent workforce member (travel nurse, locum tenens, per diem, agency staff). Null for direct employees.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workEmail rdf:type rdf:Property ;
    rdfs:label 'Work Email' ;
    rdfs:comment 'Primary institutional email address assigned to the workforce member. Used for system access, scheduling notifications, and HR communications.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workPhone rdf:type rdf:Property ;
    rdfs:label 'Work Phone' ;
    rdfs:comment 'Primary work telephone number for the workforce member, including direct lines and extensions. Used for scheduling, on-call coordination, and HR communications.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workdayWorkerCode rdf:type rdf:Property ;
    rdfs:label 'Workday Worker Code' ;
    rdfs:comment 'The native worker identifier assigned by Workday HCM Core HR module. Used for system-of-record integration and cross-system reconciliation between the lakehouse and Workday.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workerCategory rdf:type rdf:Property ;
    rdfs:label 'Worker Category' ;
    rdfs:comment 'Broad categorization of the workforce members role type. Clinical includes physicians, nurses, and allied health; administrative includes billing and coding staff; support includes environmental services and food services; research includes clinical trial staff; contingent includes travel nurses, locum tenens, and agency staff.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobProfileId rdf:type rdf:Property ;
    rdfs:label 'Job Profile Id' ;
    rdfs:comment 'FK to workforce.job_profile' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JobProfile .

ind:primaryPositionDepartmentWorkforceOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Primary Position Department Workforce Org Unit Id' ;
    rdfs:comment 'FK to workforce.org_unit' ;
    rdfs:domain ind:Position ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:reportsToPositionId rdf:type rdf:Property ;
    rdfs:label 'Reports To Position Id' ;
    rdfs:comment 'Self-referencing identifier of the parent position to which this position reports in the organizational hierarchy. Enables construction of the position reporting chain for org chart and span-of-control analytics.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Position .

ind:tertiaryPositionWorkforceOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Position Workforce Org Unit Id' ;
    rdfs:comment 'Identifier of the organizational department to which this position is assigned (e.g., ICU Nursing, Emergency Medicine, Pharmacy, Radiology). Used for departmental headcount reporting and workforce planning.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:budgetedFte rdf:type rdf:Property ;
    rdfs:label 'Budgeted Fte' ;
    rdfs:comment 'Approved budgeted FTE value for this position as authorized in the annual workforce budget. May differ from fte_allocation when positions are partially funded or shared across cost centers. Used for variance analysis between budgeted and actual FTE.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employmentCategory rdf:type rdf:Property ;
    rdfs:label 'Employment Category' ;
    rdfs:comment 'Standard employment category indicating the scheduled hours commitment for this position. PRN (Pro Re Nata) indicates as-needed staffing common in healthcare. Used for benefits eligibility determination and staffing ratio calculations.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headcountCount rdf:type rdf:Property ;
    rdfs:label 'Headcount Count' ;
    rdfs:comment 'Number of authorized headcount slots represented by this position record. Typically 1, but may be greater for pooled or shared positions. Used for total headcount budget reconciliation.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isClinical rdf:type rdf:Property ;
    rdfs:label 'Is Clinical' ;
    rdfs:comment 'Indicates whether this position is classified as a clinical role requiring licensure, credentialing, or privileging (e.g., RN, MD, PA, RT). Drives integration with Symplr credentialing workflows and The Joint Commission staffing compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCriticalRole rdf:type rdf:Property ;
    rdfs:label 'Is Critical Role' ;
    rdfs:comment 'Indicates whether this position is designated as a critical or hard-to-fill role requiring succession planning, accelerated recruitment, or retention incentives. Used for talent management and workforce risk reporting.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isManagement rdf:type rdf:Property ;
    rdfs:label 'Is Management' ;
    rdfs:comment 'Indicates whether this position carries managerial or supervisory responsibility over other positions or staff. Used for leadership reporting, succession planning, and FLSA exemption validation.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isProvider rdf:type rdf:Property ;
    rdfs:label 'Is Provider' ;
    rdfs:comment 'Indicates whether this position is designated as a licensed independent practitioner or mid-level provider requiring an NPI (National Provider Identifier) and payer enrollment. Drives integration with provider credentialing and payer enrollment workflows.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isUnionEligible rdf:type rdf:Property ;
    rdfs:label 'Is Union Eligible' ;
    rdfs:comment 'Indicates whether this position is eligible for union membership or covered under a collective bargaining agreement. Used for labor relations management and contract compliance tracking.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jobFamily rdf:type rdf:Property ;
    rdfs:label 'Job Family' ;
    rdfs:comment 'Broad occupational grouping to which this position belongs within the healthcare enterprise (e.g., Nursing, Physician, Allied Health, Administrative, Support Services, Information Technology). Used for workforce analytics and compensation benchmarking.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationType rdf:type rdf:Property ;
    rdfs:label 'Location Type' ;
    rdfs:comment 'Designates the expected work location arrangement for this position. Travel applies to travel nurse or locum tenens positions. Used for workforce planning, real estate management, and telehealth staffing.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaJobHazardCategory rdf:type rdf:Property ;
    rdfs:label 'Osha Job Hazard Category' ;
    rdfs:comment 'OSHA bloodborne pathogen exposure risk category for this position. Category 1: routine exposure to blood/body fluids; Category 2: possible but not routine exposure; Category 3: no exposure expected. Drives PPE requirements, hepatitis B vaccination offers, and OSHA 29 CFR 1910.1030 compliance.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payGrade rdf:type rdf:Property ;
    rdfs:label 'Pay Grade' ;
    rdfs:comment 'Compensation pay grade or band assigned to this position, defining the salary range and step structure (e.g., G7, N3, P5, M2). Confidential business data used for compensation equity analysis and budget planning.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payRangeMax rdf:type rdf:Property ;
    rdfs:label 'Pay Range Max' ;
    rdfs:comment 'Maximum annual base salary (in USD) authorized for this position based on its pay grade. Used for compensation equity analysis, offer management, and budget planning. Confidential business data.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payRangeMin rdf:type rdf:Property ;
    rdfs:label 'Pay Range Min' ;
    rdfs:comment 'Minimum annual base salary (in USD) authorized for this position based on its pay grade. Used for compensation equity analysis, offer management, and budget planning. Confidential business data.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionCode rdf:type rdf:Property ;
    rdfs:label 'Position Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying the position within Workday HCM and downstream systems (e.g., RN-ICU-001, MD-CARD-003). Used for cross-system integration and workforce reporting. Serves as the BUSINESS_IDENTIFIER for this MASTER_RESOURCE entity.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionStatus rdf:type rdf:Property ;
    rdfs:label 'Position Status' ;
    rdfs:comment 'Current lifecycle state of the authorized position. Open indicates a vacancy available for recruitment; filled indicates an active incumbent; frozen indicates a budgetary hold; eliminated indicates the position has been removed from the headcount plan; pending_approval indicates awaiting authorization. Serves as the LIFECYCLE_STATUS for this MASTER_RESOURCE entity.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionType rdf:type rdf:Property ;
    rdfs:label 'Position Type' ;
    rdfs:comment 'Classification of the position by employment arrangement. Distinguishes regular permanent headcount from temporary, contract, per diem, travel nurse, or seasonal positions. Serves as the primary CLASSIFICATION_OR_TYPE for this MASTER_RESOURCE entity.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredCertification rdf:type rdf:Property ;
    rdfs:label 'Required Certification' ;
    rdfs:comment 'Specific professional certification required for this position beyond basic licensure (e.g., BLS, ACLS, PALS, CCRN, CEN, CNOR). Used for competency tracking, onboarding checklists, and Joint Commission compliance.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredEducationLevel rdf:type rdf:Property ;
    rdfs:label 'Required Education Level' ;
    rdfs:comment 'Minimum educational attainment required to qualify for this position (e.g., bachelors degree for BSN-required RN positions, doctoral for physician roles). Used for recruitment screening and regulatory compliance.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredLicenseType rdf:type rdf:Property ;
    rdfs:label 'Required License Type' ;
    rdfs:comment 'Type of professional license required to fill this position (e.g., RN, LPN, MD, DO, PA-C, PharmD, RT, LCSW). Used for credentialing validation, vacancy posting requirements, and regulatory compliance reporting. [ENUM-REF-CANDIDATE: RN|LPN|MD|DO|PA-C|PharmD|RT|LCSW|CNA|NP|CRNA|DDS|OT|PT|SLP — promote to reference product]' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftType rdf:type rdf:Property ;
    rdfs:label 'Shift Type' ;
    rdfs:comment 'Standard shift schedule associated with this position (e.g., day, evening, night, rotating). Used for scheduling, differential pay calculations, and staffing coverage analysis.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemPositionCode rdf:type rdf:Property ;
    rdfs:label 'Source System Position Code' ;
    rdfs:comment 'Native position identifier from the originating system of record (e.g., Workday position ID such as P-00012345). Used for cross-system reconciliation, ETL deduplication, and audit traceability in the Silver layer.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardHoursPerWeek rdf:type rdf:Property ;
    rdfs:label 'Standard Hours Per Week' ;
    rdfs:comment 'Authorized standard scheduled hours per week for this position (e.g., 40.0 for full-time, 24.0 for 0.6 FTE, 36.0 for three 12-hour shifts). Used for FTE calculation validation and payroll processing.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unionCode rdf:type rdf:Property ;
    rdfs:label 'Union Code' ;
    rdfs:comment 'Code identifying the labor union or collective bargaining unit associated with this position, if applicable (e.g., SEIU, CNA, AFSCME). Null for non-union positions. Used for labor relations reporting and contract compliance.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vacancyReason rdf:type rdf:Property ;
    rdfs:label 'Vacancy Reason' ;
    rdfs:comment 'Reason code explaining why the position is currently open or vacant. Used for turnover analysis, workforce planning, and recruitment prioritization. Populated only when position_status is open. [ENUM-REF-CANDIDATE: new_position|resignation|retirement|termination|leave_of_absence|transfer|promotion — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckRequired rdf:type rdf:Property ;
    rdfs:label 'Background Check Required' ;
    rdfs:comment 'Indicates whether a pre-employment and/or periodic background check is required for this job profile. Driven by OIG exclusion list screening requirements and state health department regulations.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificationRequired rdf:type rdf:Property ;
    rdfs:label 'Certification Required' ;
    rdfs:comment 'Indicates whether one or more professional certifications (e.g., BLS, ACLS, CEN, CCRN) are mandatory requirements for this job profile. When True, triggers certification tracking and renewal workflows.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalRoleIndicator rdf:type rdf:Property ;
    rdfs:label 'Clinical Role Indicator' ;
    rdfs:comment 'Flag indicating whether this job profile is classified as a clinical role (True) or a non-clinical/administrative role (False). Drives credentialing, privileging, and licensure verification requirements via Symplr and The Joint Commission standards.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmeCompliancePeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Cme Compliance Period Months' ;
    rdfs:comment 'Duration in months of the CME (Continuing Medical Education) compliance cycle for this job profile (e.g., 12 for annual, 24 for biennial). Defines the window within which required CME hours must be completed.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:competencyFrameworkCode rdf:type rdf:Property ;
    rdfs:label 'Competency Framework Code' ;
    rdfs:comment 'Reference code linking this job profile to the applicable competency framework or assessment model in Workday HCM Learning (e.g., clinical competency sets, leadership competency models). Drives annual competency assessment assignments.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deaRegistrationRequired rdf:type rdf:Property ;
    rdfs:label 'Dea Registration Required' ;
    rdfs:comment 'Indicates whether a DEA (Drug Enforcement Administration) registration number is required for this job profile to prescribe or administer controlled substances. Applicable to physicians, advanced practice nurses, and pharmacists.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drugScreenRequired rdf:type rdf:Property ;
    rdfs:label 'Drug Screen Required' ;
    rdfs:comment 'Indicates whether pre-employment and/or random drug screening is required for this job profile. Particularly relevant for roles with access to controlled substances. Aligns with DEA and OSHA requirements.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:flsaStatus rdf:type rdf:Property ;
    rdfs:label 'Flsa Status' ;
    rdfs:comment 'Indicates whether the job profile is classified as Exempt or Non-Exempt under the Fair Labor Standards Act (FLSA). Non-Exempt employees are entitled to overtime pay. Critical for payroll compliance and labor law adherence.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fteEquivalent rdf:type rdf:Property ;
    rdfs:label 'Fte Equivalent' ;
    rdfs:comment 'Standard FTE (Full-Time Equivalent) value associated with this job profile, representing the proportion of a full-time workload (e.g., 1.0 for full-time, 0.5 for half-time). Used in workforce capacity planning and CMS staffing ratio reporting.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hipaaAccessLevel rdf:type rdf:Property ;
    rdfs:label 'Hipaa Access Level' ;
    rdfs:comment 'Defines the level of access to PHI (Protected Health Information) authorized for this job profile under HIPAA minimum necessary standards. Drives role-based access control (RBAC) provisioning in EHR systems such as Epic and Cerner.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobCategory rdf:type rdf:Property ;
    rdfs:label 'Job Category' ;
    rdfs:comment 'EEO-1 (Equal Employment Opportunity) job category classification required for federal workforce reporting (e.g., Officials and Managers, Professionals, Technicians, Service Workers). Supports EEOC compliance reporting. [ENUM-REF-CANDIDATE: Officials and Managers|Professionals|Technicians|Sales Workers|Administrative Support|Craft Workers|Operatives|Laborers|Service Workers — promote to reference product]' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobCode rdf:type rdf:Property ;
    rdfs:label 'Job Code' ;
    rdfs:comment 'Externally-known alphanumeric code that uniquely identifies the job profile across the organization. Used in payroll, scheduling, and HR reporting systems. Sourced from Workday HCM.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobDescription rdf:type rdf:Property ;
    rdfs:label 'Job Description' ;
    rdfs:comment 'Full narrative description of the job profile including primary responsibilities, scope of practice, reporting relationships, and essential functions. Used in recruitment, performance management, ADA (Americans with Disabilities Act) compliance, and regulatory filings.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobFamilyGroup rdf:type rdf:Property ;
    rdfs:label 'Job Family Group' ;
    rdfs:comment 'Broader organizational grouping above job family that clusters related job families (e.g., Clinical, Non-Clinical, Administrative, Technical). Enables enterprise-level workforce analytics and reporting.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobLevel rdf:type rdf:Property ;
    rdfs:label 'Job Level' ;
    rdfs:comment 'Hierarchical level designation within the job family indicating seniority and scope of responsibility (e.g., Entry, Intermediate, Senior, Lead, Principal, Expert). Drives compensation grade assignment and career progression. [ENUM-REF-CANDIDATE: Entry|Intermediate|Senior|Lead|Principal|Expert|Director|Executive — promote to reference product]' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobTitle rdf:type rdf:Property ;
    rdfs:label 'Job Title' ;
    rdfs:comment 'Official human-readable title of the job profile as defined in Workday HCM (e.g., Registered Nurse, Clinical Pharmacist, Radiologic Technologist). Used on offer letters, org charts, and regulatory filings.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licensureRequired rdf:type rdf:Property ;
    rdfs:label 'Licensure Required' ;
    rdfs:comment 'Indicates whether active professional licensure (e.g., RN, MD, PharmD, RT) is a mandatory requirement for this job profile. When True, triggers licensure verification workflows in Symplr and compliance tracking.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managementLevel rdf:type rdf:Property ;
    rdfs:label 'Management Level' ;
    rdfs:comment 'Indicates whether the job profile is an individual contributor or a people-management role, and at what tier of management. Used for span-of-control analysis, leadership development, and FTE (Full-Time Equivalent) reporting.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumEducationLevel rdf:type rdf:Property ;
    rdfs:label 'Minimum Education Level' ;
    rdfs:comment 'Minimum educational attainment required for this job profile (e.g., Bachelors Degree in Nursing, Doctor of Medicine). Used in applicant screening, credentialing verification, and regulatory compliance.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumExperienceYears rdf:type rdf:Property ;
    rdfs:label 'Minimum Experience Years' ;
    rdfs:comment 'Minimum number of years of relevant professional experience required for this job profile. Used in applicant screening, internal mobility decisions, and workforce planning.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:npiRequired rdf:type rdf:Property ;
    rdfs:label 'Npi Required' ;
    rdfs:comment 'Indicates whether employees in this job profile are required to hold an individual NPI (National Provider Identifier) for billing and claims submission purposes. Applicable to licensed independent practitioners and certain allied health professionals.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onCallRequired rdf:type rdf:Property ;
    rdfs:label 'On Call Required' ;
    rdfs:comment 'Indicates whether employees in this job profile are required to participate in on-call scheduling rotations. Relevant for clinical roles in ED (Emergency Department), OR (Operating Room), ICU (Intensive Care Unit), and other 24/7 care settings.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oshaExposureCategory rdf:type rdf:Property ;
    rdfs:label 'Osha Exposure Category' ;
    rdfs:comment 'OSHA bloodborne pathogen exposure risk category for this job profile per 29 CFR 1910.1030. Category I: routine exposure tasks; Category II: incidental exposure possible; Category III: no exposure expected. Drives PPE requirements and hepatitis B vaccination mandates.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payRangeMidpoint rdf:type rdf:Property ;
    rdfs:label 'Pay Range Midpoint' ;
    rdfs:comment 'Midpoint of the base salary or hourly rate range for this job profile. Represents the market reference point used in compensation benchmarking and compa-ratio calculations.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payRateType rdf:type rdf:Property ;
    rdfs:label 'Pay Rate Type' ;
    rdfs:comment 'Indicates whether compensation for this job profile is expressed as an annual salary, an hourly rate, or a daily rate. Drives payroll calculation logic and FLSA overtime applicability.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privilegingRequired rdf:type rdf:Property ;
    rdfs:label 'Privileging Required' ;
    rdfs:comment 'Indicates whether clinical privileging through the medical staff office is required for this job profile. Applicable to physicians, advanced practice providers, and other credentialed clinical staff. Integrates with Symplr privileging workflows.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:profileStatus rdf:type rdf:Property ;
    rdfs:label 'Profile Status' ;
    rdfs:comment 'Current lifecycle state of the job profile. Active profiles are available for position and employee assignment. Inactive or Deprecated profiles are retained for historical reference but cannot be assigned to new positions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remoteEligible rdf:type rdf:Property ;
    rdfs:label 'Remote Eligible' ;
    rdfs:comment 'Indicates whether this job profile is eligible for remote or telehealth work arrangements. Drives telehealth credentialing requirements and state licensure compact applicability for clinical roles.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiredCertifications rdf:type rdf:Property ;
    rdfs:label 'Required Certifications' ;
    rdfs:comment 'Comma-delimited list of required professional certifications for this job profile (e.g., BLS, ACLS, PALS, CCRN, CEN, CNOR). Used to configure certification compliance tracking and renewal reminders in Symplr.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredLicenseTypes rdf:type rdf:Property ;
    rdfs:label 'Required License Types' ;
    rdfs:comment 'Comma-delimited list of professional license types required for this job profile (e.g., RN, LPN, MD, DO, PharmD, RT, LCSW). Used to configure automated license verification and expiration alerts in Symplr.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rvuEligible rdf:type rdf:Property ;
    rdfs:label 'Rvu Eligible' ;
    rdfs:comment 'Indicates whether employees in this job profile are eligible for RVU (Relative Value Unit)-based productivity compensation or incentive programs. Applicable to physicians and advanced practice providers billing under CMS fee schedules.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:travelRequired rdf:type rdf:Property ;
    rdfs:label 'Travel Required' ;
    rdfs:comment 'Indicates whether the job profile requires travel between facilities, patient homes, or other locations as part of standard job duties. Relevant for home health, mobile care, and multi-site roles.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unionEligible rdf:type rdf:Property ;
    rdfs:label 'Union Eligible' ;
    rdfs:comment 'Indicates whether this job profile is eligible for union membership or is covered under a collective bargaining agreement (CBA). Drives labor relations workflows and CBA-specific pay and scheduling rules.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workdayJobProfileCode rdf:type rdf:Property ;
    rdfs:label 'Workday Job Profile Code' ;
    rdfs:comment 'Source system identifier for this job profile record in Workday HCM. Used for data lineage, ETL (Extract Transform Load) reconciliation, and bi-directional integration between the lakehouse and Workday.' ;
    rdfs:domain ind:JobProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentCompetencyId rdf:type rdf:Property ;
    rdfs:label 'Employment Competency Id' ;
    rdfs:comment 'Unique surrogate identifier for each employment competency record, covering credentials, privileges, and credentialing application lifecycle entries for healthcare workforce members.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:privilegeCptCodeId rdf:type rdf:Property ;
    rdfs:label 'Privilege Cpt Code Id' ;
    rdfs:comment 'Foreign key linking to reference.cpt_code. Business justification: Clinical privileges granted for specific procedures identified by CPT codes. Real-world: privilege cards list CPT ranges (e.g., 33510-33536 for CABG), credentialing applications require procedure-spec' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CptCode .

ind:privilegeHcpcsCodeId rdf:type rdf:Property ;
    rdfs:label 'Privilege Hcpcs Code Id' ;
    rdfs:comment 'Foreign key linking to reference.hcpcs_code. Business justification: Privileges for device/drug administration procedures using HCPCS (e.g., J-codes for chemotherapy, E-codes for DME ordering authority). Real-world: oncology nurse privileges for specific chemotherapy a' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HcpcsCode .

ind:privilegeIcdCodeId rdf:type rdf:Property ;
    rdfs:label 'Privilege Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: Medical staff privilege delineation links procedures to diagnosis codes (e.g., cardiac surgeon privileges for ICD-10 I21.* acute MI). Real-world: privilege dictionaries in medical staff bylaws, creden' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:applicationCompleteDate rdf:type rdf:Property ;
    rdfs:label 'Application Complete Date' ;
    rdfs:comment 'The date on which the credentialing application was deemed complete with all required documentation and verifications received by the Medical Staff Office.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicationDecision rdf:type rdf:Property ;
    rdfs:label 'Application Decision' ;
    rdfs:comment 'Final decision rendered by the Medical Staff committee on the credentialing or reappointment application.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Application Decision Date' ;
    rdfs:comment 'The date on which the formal credentialing decision (approval, denial, deferral) was rendered by the Medical Staff committee.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicationSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Application Submission Date' ;
    rdfs:comment 'The date on which the credentialing or reappointment application was formally submitted by the practitioner to the Medical Staff Office.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicationType rdf:type rdf:Property ;
    rdfs:label 'Application Type' ;
    rdfs:comment 'Type of credentialing or privileging application submitted by the practitioner. Initial applications are for new Medical Staff members; reappointment applications occur on the standard cycle (typically every 2 years).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Effective Date' ;
    rdfs:comment 'The date from which the Medical Staff appointment or reappointment becomes effective, authorizing the practitioner to practice at the facility.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Expiration Date' ;
    rdfs:comment 'The date on which the Medical Staff appointment expires, triggering the reappointment process. Typically every 24 months per TJC standards.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cmeCreditHours rdf:type rdf:Property ;
    rdfs:label 'Cme Credit Hours' ;
    rdfs:comment 'Number of Continuing Medical Education (CME) credit hours earned by the workforce member relevant to this credential or privilege cycle. Used to verify CME requirements for license renewal and reappointment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cmeRequirementHours rdf:type rdf:Property ;
    rdfs:label 'Cme Requirement Hours' ;
    rdfs:comment 'Total number of CME credit hours required for the current credentialing or license renewal cycle as mandated by the issuing authority or Medical Staff bylaws.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:competencyAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Competency Assessment Date' ;
    rdfs:comment 'The date on which the formal competency assessment or skills validation was conducted for the workforce member.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:competencyAssessmentScore rdf:type rdf:Property ;
    rdfs:label 'Competency Assessment Score' ;
    rdfs:comment 'Numeric score from a formal competency assessment, skills validation, or simulation evaluation conducted to verify the practitioners proficiency for a specific privilege or clinical activity.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:competencyType rdf:type rdf:Property ;
    rdfs:label 'Competency Type' ;
    rdfs:comment 'Discriminator indicating whether this record represents a professional credential, a clinical privilege, or a credentialing/re-credentialing application.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingCountry rdf:type rdf:Property ;
    rdfs:label 'Issuing Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction that issued the credential. Supports international medical graduates and foreign-trained clinicians.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingState rdf:type rdf:Property ;
    rdfs:label 'Issuing State' ;
    rdfs:comment 'Two-letter US state code of the jurisdiction that issued the credential. Applicable for state-issued licenses (medical, nursing, pharmacy). Null for federal or national credentials.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:malpracticeCoverageVerified rdf:type rdf:Property ;
    rdfs:label 'Malpractice Coverage Verified' ;
    rdfs:comment 'Indicates whether the practitioners professional liability (malpractice) insurance coverage has been verified as meeting the facilitys minimum coverage requirements during the credentialing process.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalStaffCategory rdf:type rdf:Property ;
    rdfs:label 'Medical Staff Category' ;
    rdfs:comment 'The Medical Staff membership category assigned to the practitioner, defining their rights, responsibilities, and voting privileges within the Medical Staff organization. [ENUM-REF-CANDIDATE: active|associate|courtesy|consulting|honorary|provisional|affiliate — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalStaffCommittee rdf:type rdf:Property ;
    rdfs:label 'Medical Staff Committee' ;
    rdfs:comment 'Name of the Medical Staff committee responsible for reviewing and approving the clinical privilege (e.g., Credentials Committee, Executive Committee of the Medical Staff, Department of Surgery Peer Review Committee).' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npdbQueryDate rdf:type rdf:Property ;
    rdfs:label 'Npdb Query Date' ;
    rdfs:comment 'The date on which the National Practitioner Data Bank (NPDB) was queried for adverse action reports, malpractice payments, and licensure actions related to this practitioner as part of the credentialing process.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:npdbQueryResult rdf:type rdf:Property ;
    rdfs:label 'Npdb Query Result' ;
    rdfs:comment 'Result of the NPDB query indicating whether adverse action reports or malpractice payment reports were found for the practitioner. Classified as confidential per NPDB disclosure restrictions.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySourceVerified rdf:type rdf:Property ;
    rdfs:label 'Primary Source Verified' ;
    rdfs:comment 'Indicates whether the credential has been verified directly with the issuing authority (primary source verification) as required by NCQA and The Joint Commission credentialing standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:privilegeCategory rdf:type rdf:Property ;
    rdfs:label 'Privilege Category' ;
    rdfs:comment 'Classification of the clinical privilege granted by the Medical Staff (e.g., core privileges, special privileges, temporary privileges, telemedicine privileges, surgical privileges). [ENUM-REF-CANDIDATE: core|special|temporary|provisional|telemedicine|surgical|procedural|admitting|consulting — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privilegeEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Privilege Effective Date' ;
    rdfs:comment 'The date from which the clinical privilege becomes operationally effective and the practitioner is authorized to perform the privileged activity at the facility.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:privilegeExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Privilege Expiration Date' ;
    rdfs:comment 'The date on which the clinical privilege expires and must be reappointed through the Medical Staff reappointment process. Typically aligned with the Medical Staff appointment cycle (every 2 years per TJC).' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:privilegeGrantDate rdf:type rdf:Property ;
    rdfs:label 'Privilege Grant Date' ;
    rdfs:comment 'The date on which the Medical Staff committee formally approved and granted the clinical privilege to the practitioner.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:privilegeProcedureCode rdf:type rdf:Property ;
    rdfs:label 'Privilege Procedure Code' ;
    rdfs:comment 'Standardized code identifying the specific procedure, service, or clinical activity for which the privilege is granted. May reference CPT, HCPCS, or facility-defined procedure codes from the Delineation of Privileges form.' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privilegeProcedureName rdf:type rdf:Property ;
    rdfs:label 'Privilege Procedure Name' ;
    rdfs:comment 'Human-readable name of the specific procedure, service, or clinical activity for which the privilege is granted (e.g., laparoscopic cholecystectomy, cardiac catheterization, endotracheal intubation).' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privilegeStatus rdf:type rdf:Property ;
    rdfs:label 'Privilege Status' ;
    rdfs:comment 'Current status of the clinical privilege as granted by the Medical Staff committee. Tracks the full privilege lifecycle from provisional grant through active, suspension, or revocation. [ENUM-REF-CANDIDATE: active|provisional|suspended|revoked|expired|pending|voluntary_relinquishment — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerCommitteeReviewDate rdf:type rdf:Property ;
    rdfs:label 'Provider Committee Review Date' ;
    rdfs:comment 'The date on which the Credentials Committee or Medical Staff Executive Committee formally reviewed the credentialing application.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:providerCredentialCategory rdf:type rdf:Property ;
    rdfs:label 'Provider Credential Category' ;
    rdfs:comment 'Classification of the professional credential type held by the workforce member. Examples include medical license, DEA registration, board certification, nursing license, allied health certification, advanced practice credential. [ENUM-REF-CANDIDATE: medical_license|dea_registration|board_certification|nursing_license|allied_health_certification|advanced_practice_credential|cme_certificate|other — promote to reference product]' ;
    rdfs:domain ind:EmploymentCompetency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerCredentialStatus rdf:type rdf:Property ;
    rdfs:label 'Provider Credential Status' ;
    rdfs:comment 'Current lifecycle status of the professional credential as reported by the issuing authority or verified through primary source verification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:psvDate rdf:type rdf:Property ;
    rdfs:label 'Psv Date' ;
    rdfs:comment 'The date on which primary source verification of the credential was completed. Required for NCQA and TJC credentialing compliance tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:psvMethod rdf:type rdf:Property ;
    rdfs:label 'Psv Method' ;
    rdfs:comment 'Method used to perform primary source verification of the credential (e.g., online portal query, written confirmation from issuing authority, third-party verification service such as CAQH ProView).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samExclusionChecked rdf:type rdf:Property ;
    rdfs:label 'Sam Exclusion Checked' ;
    rdfs:comment 'Indicates whether the practitioner has been screened against the federal SAM.gov exclusions database, required for federally funded programs and research activities.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:competencyAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Competency Assessment Id' ;
    rdfs:comment 'Unique system-generated identifier for each competency assessment, immunization, or occupational health screening record. Primary key for this data product.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:competencySnomedConceptId rdf:type rdf:Property ;
    rdfs:label 'Competency Snomed Concept Id' ;
    rdfs:comment 'Foreign key linking to reference.snomed_concept. Business justification: Clinical competency assessments use SNOMED for standardized skill/knowledge representation in EHR-integrated competency management systems. Real-world: nursing competency frameworks, clinical document' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SnomedConcept .

ind:educationProgramId rdf:type rdf:Property ;
    rdfs:label 'Education Program Id' ;
    rdfs:comment 'Reference to the formal education or training program in Workday HCM Learning that is associated with this competency assessment (e.g., annual competency curriculum, new hire orientation program).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EducationProgram .

ind:administrationRoute rdf:type rdf:Property ;
    rdfs:label 'Administration Route' ;
    rdfs:comment 'Route by which the vaccine was administered (e.g., intramuscular, subcutaneous, intradermal, oral, intranasal). Required for immunization documentation and adverse event reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administrationSite rdf:type rdf:Property ;
    rdfs:label 'Administration Site' ;
    rdfs:comment 'Anatomical site on the body where the vaccine was injected (e.g., left deltoid, right deltoid). Required for immunization documentation per CDC and ACIP standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentCategory rdf:type rdf:Property ;
    rdfs:label 'Assessment Category' ;
    rdfs:comment 'Top-level category distinguishing whether this record represents a clinical or non-clinical competency evaluation, an occupational immunization, or an occupational health screening (e.g., TB test, N95 fit test).' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentMethod rdf:type rdf:Property ;
    rdfs:label 'Assessment Method' ;
    rdfs:comment 'Method used to evaluate or document the competency or health record. For competency: observation, written_exam, simulation, return_demonstration, peer_review. For immunization: administration. For screening: record_review. [ENUM-REF-CANDIDATE: observation|written_exam|simulation|return_demonstration|administration|record_review|peer_review — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentType rdf:type rdf:Property ;
    rdfs:label 'Assessment Type' ;
    rdfs:comment 'Specific type of assessment within the category. For competency: orientation, annual, role-specific, post-incident. For immunization: influenza, hepatitis_B, MMR, varicella, Tdap, COVID-19. For health screening: PPD, IGRA, N95_fit_test, blood_borne_pathogen. [ENUM-REF-CANDIDATE: orientation|annual|role_specific|post_incident|influenza|hepatitis_B|MMR|varicella|Tdap|COVID_19|PPD|IGRA|N95_fit_test — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competencyDomain rdf:type rdf:Property ;
    rdfs:label 'Competency Domain' ;
    rdfs:comment 'Clinical or operational domain to which this competency belongs (e.g., medication administration, infection control, patient safety, critical care, age-specific care, equipment operation). Null for immunization and health screening records.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competencyName rdf:type rdf:Property ;
    rdfs:label 'Competency Name' ;
    rdfs:comment 'Descriptive name of the specific competency, skill, vaccine, or screening test being assessed or administered (e.g., IV Catheter Insertion, Influenza Vaccine 2024-2025, Annual TB Screening).' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declinationReason rdf:type rdf:Property ;
    rdfs:label 'Declination Reason' ;
    rdfs:comment 'Documented reason provided by the worker for declining an immunization or health screening (e.g., religious exemption, medical contraindication, prior immunity documented). Required for OSHA and TJC compliance when immunization is declined.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fitTestProtocol rdf:type rdf:Property ;
    rdfs:label 'Fit Test Protocol' ;
    rdfs:comment 'Protocol used for N95 respirator fit testing: qualitative (pass/fail based on taste/smell detection) or quantitative (numerical fit factor measurement). Required for OSHA 29 CFR 1910.134 compliance.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobRoleApplicability rdf:type rdf:Property ;
    rdfs:label 'Job Role Applicability' ;
    rdfs:comment 'Job role, position, or worker classification for which this competency or health requirement applies (e.g., RN, LPN, Surgical Tech, Environmental Services). Supports role-based compliance tracking.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalContraindication rdf:type rdf:Property ;
    rdfs:label 'Medical Contraindication' ;
    rdfs:comment 'Indicates whether a documented medical contraindication exists that exempts the worker from a required immunization or health screening. True when a physician-documented contraindication is on file.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:n95RespiratorModel rdf:type rdf:Property ;
    rdfs:label 'N95 Respirator Model' ;
    rdfs:comment 'Make and model of the N95 respirator for which the worker was fit-tested. Required for OSHA respiratory protection program documentation.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcome rdf:type rdf:Property ;
    rdfs:label 'Outcome' ;
    rdfs:comment 'Final result of the assessment or immunization event. For competency: pass or fail. For observation-based: satisfactory or unsatisfactory. For immunization: administered or declined. [ENUM-REF-CANDIDATE: pass|fail|satisfactory|unsatisfactory|administered|declined|deferred — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:passingScore rdf:type rdf:Property ;
    rdfs:label 'Passing Score' ;
    rdfs:comment 'Minimum score required to pass this competency assessment. Used to determine pass/fail outcome and trigger remediation workflows when the workers score falls below this threshold.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorImmunityDocumented rdf:type rdf:Property ;
    rdfs:label 'Prior Immunity Documented' ;
    rdfs:comment 'Indicates whether the worker has documented evidence of prior immunity (e.g., positive titer for MMR or varicella), exempting them from the corresponding immunization requirement.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reassessmentDate rdf:type rdf:Property ;
    rdfs:label 'Reassessment Date' ;
    rdfs:comment 'Date on which the worker was re-evaluated following completion of a remediation plan after an initial competency assessment failure.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remediationRequired rdf:type rdf:Property ;
    rdfs:label 'Remediation Required' ;
    rdfs:comment 'Indicates whether the worker failed this competency assessment and requires a remediation plan before re-assessment. Drives remediation workflow in Workday HCM Learning.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultInterpretation rdf:type rdf:Property ;
    rdfs:label 'Result Interpretation' ;
    rdfs:comment 'Clinical interpretation of the health screening result (e.g., positive, negative, indeterminate for TB tests; reactive/non-reactive for hepatitis B serology). Null for competency assessments.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resultValue rdf:type rdf:Property ;
    rdfs:label 'Result Value' ;
    rdfs:comment 'Qualitative or quantitative result for health screening tests. For PPD: induration measurement in mm (e.g., 10mm). For IGRA: positive/negative/indeterminate. For N95 fit test: pass/fail with fit factor. Null for competency and immunization records.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:score rdf:type rdf:Property ;
    rdfs:label 'Score' ;
    rdfs:comment 'Numeric score achieved by the worker on a written exam or simulation-based competency assessment (e.g., 85.00 out of 100). Null for immunization and health screening records.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceRecordReference rdf:type rdf:Property ;
    rdfs:label 'Source Record Reference' ;
    rdfs:comment 'Native identifier of this record in the originating source system (e.g., Workday learning activity ID, Symplr compliance record ID). Supports reconciliation and ETL audit.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titerResult rdf:type rdf:Property ;
    rdfs:label 'Titer Result' ;
    rdfs:comment 'Result of a serological titer test confirming immunity status for vaccines such as MMR, varicella, or hepatitis B (immune, non_immune, indeterminate). Used to determine whether immunization is required.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vaccineDoseNumber rdf:type rdf:Property ;
    rdfs:label 'Vaccine Dose Number' ;
    rdfs:comment 'Sequence number of the vaccine dose in a multi-dose series (e.g., dose 1, 2, or 3 of hepatitis B series; primary or booster for COVID-19). Null for single-dose vaccines.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vaccineLotNumber rdf:type rdf:Property ;
    rdfs:label 'Vaccine Lot Number' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vaccineManufacturer rdf:type rdf:Property ;
    rdfs:label 'Vaccine Manufacturer' ;
    rdfs:comment 'Name of the pharmaceutical manufacturer of the vaccine administered (e.g., Pfizer, Moderna, Sanofi Pasteur). Required for adverse event reporting and immunization registry submissions.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vaccineNdc rdf:type rdf:Property ;
    rdfs:label 'Vaccine Ndc' ;
    rdfs:comment 'National Drug Code (NDC) identifying the specific vaccine product administered. Used for immunization registry reporting, billing, and adverse event tracking.' ;
    rdfs:domain ind:CompetencyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workforceShiftScheduleId rdf:type rdf:Property ;
    rdfs:label 'Workforce Shift Schedule Id' ;
    rdfs:comment 'shift_schedule_id' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryWorkforceShiftScheduleId rdf:type rdf:Property ;
    rdfs:label 'Primary Workforce Shift Schedule Id' ;
    rdfs:comment 'description' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkforceShiftSchedule .

ind:swapSourceScheduleId rdf:type rdf:Property ;
    rdfs:label 'Swap Source Schedule Id' ;
    rdfs:comment 'Reference to the original shift_schedule record from which this shift was swapped. Populated when assignment_status is swapped to maintain the audit trail of shift exchanges.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkforceShiftSchedule .

ind:workforceEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Workforce Employee Id' ;
    rdfs:comment 'Identifier of the employee assigned to this shift. References the workforce employee master record.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Actual End Datetime' ;
    rdfs:comment 'The actual date and time the employee clocked out or ended the shift. Used for actual hours worked calculation and overtime determination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualHoursWorked rdf:type rdf:Property ;
    rdfs:label 'Actual Hours Worked' ;
    rdfs:comment 'Total number of hours the employee actually worked during this shift, based on actual clock-in and clock-out times. Used for payroll processing and overtime variance analysis.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agencyName rdf:type rdf:Property ;
    rdfs:label 'Agency Name' ;
    rdfs:comment 'Name of the staffing agency or contract labor vendor supplying the worker for this shift, when is_agency_staff is true. Used for vendor performance tracking and agency spend management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakMinutes rdf:type rdf:Property ;
    rdfs:label 'Break Minutes' ;
    rdfs:comment 'Total scheduled break time in minutes for this shift (meal and rest breaks). Used for net hours worked calculation and OSHA (Occupational Safety and Health Administration) compliance.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:careSetting rdf:type rdf:Property ;
    rdfs:label 'Care Setting' ;
    rdfs:comment 'Classification of the care environment where the shift takes place (e.g., inpatient, ED (Emergency Department), ICU (Intensive Care Unit), OR (Operating Room), outpatient, ambulatory, telehealth). Drives staffing ratio requirements and regulatory reporting. [ENUM-REF-CANDIDATE: inpatient|ed|icu|or|outpatient|ambulatory|telehealth — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAgencyStaff rdf:type rdf:Property ;
    rdfs:label 'Is Agency Staff' ;
    rdfs:comment 'Indicates whether the shift is filled by agency or contract (traveler) staff rather than direct-hire employees. Used for labor cost analysis, agency spend tracking, and staffing mix reporting.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isChargeRole rdf:type rdf:Property ;
    rdfs:label 'Is Charge Role' ;
    rdfs:comment 'Indicates whether the employee is serving in a charge nurse or charge clinician capacity during this shift, carrying supervisory and unit management responsibilities.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFloatAssignment rdf:type rdf:Property ;
    rdfs:label 'Is Float Assignment' ;
    rdfs:comment 'Indicates whether the employee is assigned as a float pool staff member, meaning they are not permanently assigned to this unit and may be deployed across multiple departments as needed.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onCallResponseMinutes rdf:type rdf:Property ;
    rdfs:label 'On Call Response Minutes' ;
    rdfs:comment 'Required response time in minutes for on-call staff to report to the facility when called in. Applicable when shift_type is on_call. Used for operational readiness and SLA (Service Level Agreement) compliance.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overtimeHours rdf:type rdf:Property ;
    rdfs:label 'Overtime Hours' ;
    rdfs:comment 'Number of hours worked beyond the standard shift threshold (typically 8 hours/day or 40 hours/week) that qualify as overtime under FLSA. Used for payroll and labor cost management.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:patientCensus rdf:type rdf:Property ;
    rdfs:label 'Patient Census' ;
    rdfs:comment 'Number of patients in the unit/department at the time of the shift. Used to validate nurse-to-patient ratio compliance and assess staffing adequacy relative to patient volume.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:payCode rdf:type rdf:Property ;
    rdfs:label 'Pay Code' ;
    rdfs:comment 'Payroll pay code associated with this shift assignment (e.g., REG for regular, OT for overtime, HOL for holiday, DIFF for differential). Drives payroll processing in Workday HCM.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publishedDatetime rdf:type rdf:Property ;
    rdfs:label 'Published Datetime' ;
    rdfs:comment 'Date and time when the schedule was published and made visible to staff. Marks the transition from draft to published schedule status.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:requiredFteCoverage rdf:type rdf:Property ;
    rdfs:label 'Required Fte Coverage' ;
    rdfs:comment 'The minimum FTE (Full-Time Equivalent) staffing level required for the unit/department during this shift period, as defined by staffing plans and nurse-to-patient ratio standards.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleNotes rdf:type rdf:Property ;
    rdfs:label 'Schedule Notes' ;
    rdfs:comment 'Free-text notes or comments associated with this shift schedule assignment, capturing special instructions, accommodation requests, or operational context from the scheduler.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule Number' ;
    rdfs:comment 'Externally-known business identifier for the shift schedule record, used for cross-system reference and operational communication (e.g., SCH-202401150001).' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Schedule Period End Date' ;
    rdfs:comment 'The last date of the scheduling period to which this shift belongs. Defines the boundary of the scheduling block.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:schedulePeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Schedule Period Start Date' ;
    rdfs:comment 'The first date of the scheduling period (e.g., start of a two-week or four-week scheduling block) to which this shift belongs.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledHours rdf:type rdf:Property ;
    rdfs:label 'Scheduled Hours' ;
    rdfs:comment 'Total number of hours the employee is planned to work during this shift, derived from scheduled start and end times. Used for FTE (Full-Time Equivalent) coverage planning.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shiftCategory rdf:type rdf:Property ;
    rdfs:label 'Shift Category' ;
    rdfs:comment 'Operational category of the shift assignment indicating the nature of the work arrangement (e.g., regular scheduled, overtime, on-call, callback, charge nurse, float pool). Affects pay rate and staffing classification.' ;
    rdfs:domain ind:WorkforceShiftSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftDate rdf:type rdf:Property ;
    rdfs:label 'Shift Date' ;
    rdfs:comment 'The calendar date on which the shift is scheduled to occur. Used for day-level staffing planning and nurse-to-patient ratio compliance reporting.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:timeAttendanceId rdf:type rdf:Property ;
    rdfs:label 'Time Attendance Id' ;
    rdfs:comment 'Unique surrogate identifier for each time and attendance / payroll record in the Workday HCM Time Tracking and Payroll system. Primary key for the time_attendance data product.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:payrollRunId rdf:type rdf:Property ;
    rdfs:label 'Payroll Run Id' ;
    rdfs:comment 'The identifier of the Workday HCM payroll run batch in which this record was processed. Used for payroll reconciliation, audit, and reprocessing of failed payroll runs.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PayrollRun .

ind:basePayRate rdf:type rdf:Property ;
    rdfs:label 'Base Pay Rate' ;
    rdfs:comment 'The employees base hourly rate or annualized salary rate used for payroll calculation. For hourly employees, expressed as dollars per hour; for salaried employees, expressed as annual salary divided by pay periods.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benefitsDeduction rdf:type rdf:Property ;
    rdfs:label 'Benefits Deduction' ;
    rdfs:comment 'Total amount deducted for employee benefits including health insurance premiums, dental, vision, life insurance, and retirement plan contributions (e.g., 401k) during this pay period.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusAmount rdf:type rdf:Property ;
    rdfs:label 'Bonus Amount' ;
    rdfs:comment 'Any bonus, incentive, or supplemental pay included in this payroll record, such as retention bonuses, sign-on bonuses, or performance incentives. Zero if no bonus applies.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clockInTimestamp rdf:type rdf:Property ;
    rdfs:label 'Clock In Timestamp' ;
    rdfs:comment 'The date and time the worker clocked in to begin their shift, as recorded by Workday HCM Time Tracking. Represents the principal real-world business event time for shift start.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:clockOutTimestamp rdf:type rdf:Property ;
    rdfs:label 'Clock Out Timestamp' ;
    rdfs:comment 'The date and time the worker clocked out to end their shift. Null if the worker has not yet clocked out or if a missed punch was recorded.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:correctionReason rdf:type rdf:Property ;
    rdfs:label 'Correction Reason' ;
    rdfs:comment 'Reason code explaining why a timekeeper correction was applied to this record. Required when timekeeper_corrected is True for audit and compliance purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flsaComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Flsa Compliance Flag' ;
    rdfs:comment 'System-generated flag indicating whether this time record is compliant with FLSA requirements (e.g., overtime thresholds met, minimum wage satisfied). False triggers a compliance review workflow.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:flsaExempt rdf:type rdf:Property ;
    rdfs:label 'Flsa Exempt' ;
    rdfs:comment 'Indicates whether the employee is classified as exempt from FLSA overtime requirements (True = exempt salaried; False = non-exempt hourly). Critical for overtime eligibility determination and FLSA compliance audits.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ftePercentage rdf:type rdf:Property ;
    rdfs:label 'Fte Percentage' ;
    rdfs:comment 'The Full-Time Equivalent (FTE) percentage associated with this workers position for this pay period, expressed as a decimal (e.g., 1.00 = full-time, 0.50 = half-time). Used for workforce FTE tracking and labor cost allocation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:garnishmentDeduction rdf:type rdf:Property ;
    rdfs:label 'Garnishment Deduction' ;
    rdfs:comment 'Total amount withheld for court-ordered wage garnishments (child support, creditor garnishments, tax levies) during this pay period. Zero if no garnishment applies.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossPayAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Pay Amount' ;
    rdfs:comment 'Total gross compensation earned by the employee for the pay period before any deductions, including base pay, shift differentials, overtime pay, and bonuses. Expressed in USD.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leaveType rdf:type rdf:Property ;
    rdfs:label 'Leave Type' ;
    rdfs:comment 'Identifies the type of leave applied to this time record if the worker was absent. None indicates no leave; FMLA indicates Family and Medical Leave Act protected leave. [ENUM-REF-CANDIDATE: none|pto|fmla|sick|bereavement|jury_duty|military|unpaid — promote to reference product if additional values needed]' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mealBreakMinutes rdf:type rdf:Property ;
    rdfs:label 'Meal Break Minutes' ;
    rdfs:comment 'Total minutes deducted for meal breaks during the shift or pay period. Applied per facility meal break policy and state labor law requirements to compute compensable hours.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:missedPunchCount rdf:type rdf:Property ;
    rdfs:label 'Missed Punch Count' ;
    rdfs:comment 'Number of missed clock-in or clock-out punch events recorded for this worker during the pay period. Used for attendance compliance monitoring and timekeeper correction workflows.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:netPayAmount rdf:type rdf:Property ;
    rdfs:label 'Net Pay Amount' ;
    rdfs:comment 'Total net compensation paid to the employee after all deductions (taxes, benefits, garnishments) have been subtracted from gross pay. Represents the actual take-home amount.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:onCallHours rdf:type rdf:Property ;
    rdfs:label 'On Call Hours' ;
    rdfs:comment 'Total hours the employee was designated as on-call during the pay period. Tracked separately for on-call differential pay calculations and staffing analytics.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oshaIncidentRelated rdf:type rdf:Property ;
    rdfs:label 'Osha Incident Related' ;
    rdfs:comment 'Indicates whether this time record is associated with an OSHA-reportable workplace incident (e.g., injury, illness resulting in lost time). True triggers linkage to OSHA incident reporting workflows.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overtimePayAmount rdf:type rdf:Property ;
    rdfs:label 'Overtime Pay Amount' ;
    rdfs:comment 'Total overtime compensation earned during the pay period, calculated at the applicable overtime rate (typically 1.5x base rate per FLSA) applied to overtime_hours.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Pay Period End Date' ;
    rdfs:comment 'The last calendar date of the pay period covered by this time and attendance record. Together with pay_period_start_date defines the payroll processing window.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Pay Period Start Date' ;
    rdfs:comment 'The first calendar date of the pay period covered by this time and attendance record. Used to group time entries into payroll processing cycles.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payType rdf:type rdf:Property ;
    rdfs:label 'Pay Type' ;
    rdfs:comment 'Indicates whether the employee is compensated on an hourly, salaried, per diem, or contract basis. Drives payroll calculation logic and FLSA exemption status determination.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payrollRunDate rdf:type rdf:Property ;
    rdfs:label 'Payroll Run Date' ;
    rdfs:comment 'The date on which the payroll run that processed this record was executed. Distinct from pay_period_end_date; used for payroll processing SLA monitoring.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payrollRunStatus rdf:type rdf:Property ;
    rdfs:label 'Payroll Run Status' ;
    rdfs:comment 'Indicates the current payroll processing state for this time record. Processed means the record has been included in a completed payroll run; reversed indicates a payroll correction was applied.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regularHoursWorked rdf:type rdf:Property ;
    rdfs:label 'Regular Hours Worked' ;
    rdfs:comment 'Total number of regular (non-overtime) hours worked by the employee during the pay period or shift, as calculated by Workday HCM Time Tracking after meal break deductions.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shiftDifferentialAmount rdf:type rdf:Property ;
    rdfs:label 'Shift Differential Amount' ;
    rdfs:comment 'Additional compensation earned for working evening, night, weekend, or holiday shifts. Calculated based on shift_type and applicable differential rate per the collective bargaining agreement or HR policy.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timeEntryType rdf:type rdf:Property ;
    rdfs:label 'Time Entry Type' ;
    rdfs:comment 'Categorizes the nature of the time entry for payroll calculation and labor cost reporting. [ENUM-REF-CANDIDATE: regular|overtime|on_call|callback|charge|training|orientation|meeting — promote to reference product if additional values needed]' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timekeeperCorrected rdf:type rdf:Property ;
    rdfs:label 'Timekeeper Corrected' ;
    rdfs:comment 'Indicates whether a timekeeper or payroll administrator applied a manual correction to this time record. True when a correction has been made; supports audit trail and compliance review.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalTaxDeduction rdf:type rdf:Property ;
    rdfs:label 'Total Tax Deduction' ;
    rdfs:comment 'Total amount withheld for all applicable taxes (federal income tax, state income tax, FICA/Social Security, Medicare) during this pay period. Supports W-2 preparation and tax compliance reporting.' ;
    rdfs:domain ind:TimeAttendance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benefitEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Benefit Enrollment Id' ;
    rdfs:comment 'Unique surrogate identifier for each benefit enrollment record in the workforce domain. Primary key for the benefit_enrollment data product.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benefitPlanId rdf:type rdf:Property ;
    rdfs:label 'Benefit Plan Id' ;
    rdfs:comment 'Reference to the specific benefit plan elected by the worker (e.g., medical plan, dental plan, 403(b) retirement plan). Links to the benefit plan master record.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BenefitPlan .

ind:acaAffordabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Aca Affordability Flag' ;
    rdfs:comment 'Indicates whether the employees required contribution for the lowest-cost self-only coverage does not exceed the ACA affordability threshold (percentage of household income or safe harbor). Used for ACA employer mandate compliance and IRS Form 1095-C reporting.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acaMinimumEssentialCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Aca Minimum Essential Coverage Flag' ;
    rdfs:comment 'Indicates whether this medical benefit enrollment satisfies the Affordable Care Act (ACA) Minimum Essential Coverage (MEC) requirement. True for qualifying employer-sponsored health plans. Used for ACA employer mandate compliance reporting on IRS Forms 1094-C and 1095-C.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acaMinimumValueFlag rdf:type rdf:Property ;
    rdfs:label 'Aca Minimum Value Flag' ;
    rdfs:comment 'Indicates whether the elected medical plan meets the ACA Minimum Value (MV) standard, meaning the plan pays at least 60% of the total allowed cost of benefits. Required for ACA employer mandate compliance and IRS Form 1095-C Line 14 reporting.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualElectionAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Election Amount' ;
    rdfs:comment 'The total annual dollar amount elected by the employee for spending accounts (FSA, HSA, dependent care FSA) or retirement plan contributions (403(b)/401(k)). Applicable primarily to FSA, HSA, and retirement benefit types. Null for insurance plan types.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beneficiaryName rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Name' ;
    rdfs:comment 'Add pii_phi, pii_pii, pii_sensitive tags' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryRelationship rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Relationship' ;
    rdfs:comment 'Add pii_phi, pii_pii, pii_sensitive tags' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitType rdf:type rdf:Property ;
    rdfs:label 'Benefit Type' ;
    rdfs:comment 'Category of benefit plan elected by the worker. Classifies the enrollment into major benefit program types: medical, dental, vision, life insurance, disability (short-term or long-term), Flexible Spending Account (FSA), Health Savings Account (HSA), or retirement (403(b)/401(k)). [ENUM-REF-CANDIDATE: medical|dental|vision|life_insurance|disability|fsa|hsa|retirement — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierConfirmationDate rdf:type rdf:Property ;
    rdfs:label 'Carrier Confirmation Date' ;
    rdfs:comment 'The date on which the insurance carrier confirmed receipt and processing of the enrollment eligibility record. Used to reconcile Workday enrollment records against carrier enrollment files and resolve discrepancies.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:carrierEligibilitySentDate rdf:type rdf:Property ;
    rdfs:label 'Carrier Eligibility Sent Date' ;
    rdfs:comment 'The date on which the eligibility file for this enrollment was transmitted to the insurance carrier or benefit administrator. Used to track carrier file transmission status and resolve eligibility discrepancies between Workday and the carrier.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:carrierGroupNumber rdf:type rdf:Property ;
    rdfs:label 'Carrier Group Number' ;
    rdfs:comment 'The group policy number assigned by the insurance carrier to the healthcare organizations benefit plan. Used on insurance cards, claims submissions, and eligibility verification. Shared across all employees enrolled in the same plan.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierMemberNumber rdf:type rdf:Property ;
    rdfs:label 'Carrier Member Number' ;
    rdfs:comment 'The unique member identification number assigned by the insurance carrier to the enrolled employee. Used for claims processing, eligibility verification, and member services. This is a PHI-adjacent identifier that can be used to access health information.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierName rdf:type rdf:Property ;
    rdfs:label 'Carrier Name' ;
    rdfs:comment 'Name of the insurance carrier or benefit administrator providing the elected benefit plan (e.g., Blue Cross Blue Shield, Aetna, Delta Dental, Fidelity Investments). Used for carrier billing, eligibility file transmission, and member ID card generation.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobraNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Cobra Notification Date' ;
    rdfs:comment 'The date on which the COBRA election notice was sent to the employee following a qualifying event. The employer must provide notice within 14 days of being notified of the qualifying event. Required for COBRA compliance documentation.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deductionFrequency rdf:type rdf:Property ;
    rdfs:label 'Deduction Frequency' ;
    rdfs:comment 'The payroll deduction frequency for the employees benefit premium contribution. Determines how often the employee_premium_amount is deducted from the employees paycheck. Must align with the employees pay frequency in Workday Payroll.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentCount rdf:type rdf:Property ;
    rdfs:label 'Dependent Count' ;
    rdfs:comment 'The number of dependents (spouse, children, domestic partner) enrolled under this benefit plan election. Used to validate coverage tier selection and for carrier eligibility file reconciliation.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disabilityBenefitType rdf:type rdf:Property ;
    rdfs:label 'Disability Benefit Type' ;
    rdfs:comment 'Specifies whether the disability benefit enrollment is for Short-Term Disability (STD) or Long-Term Disability (LTD) coverage. Applicable only when benefit_type is disability. Drives different elimination periods, benefit durations, and premium rates.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeePremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Employee Premium Amount' ;
    rdfs:comment 'The employees share of the benefit plan premium per pay period, expressed in USD. This is the amount deducted from the employees paycheck via pre-tax or post-tax payroll deduction. Drives payroll deduction configuration in Workday Payroll.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerMatchRate rdf:type rdf:Property ;
    rdfs:label 'Employer Match Rate' ;
    rdfs:comment 'The employers matching contribution rate as a percentage of the employees retirement contribution, expressed as a decimal (e.g., 0.5000 = 50% match up to a cap). Applicable only when benefit_type is retirement. Used for total compensation reporting and retirement plan compliance.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Employer Premium Amount' ;
    rdfs:comment 'The employers contribution toward the benefit plan premium per pay period, expressed in USD. Represents the healthcare organizations cost of providing the benefit. Used in total compensation reporting and benefits cost analysis.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enrollmentConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Enrollment Confirmation Number' ;
    rdfs:comment 'The confirmation number generated by Workday HCM or the carriers enrollment portal upon successful submission of the benefit election. Provided to the employee as proof of enrollment. Used for audit and dispute resolution.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentSubmittedDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Submitted Date' ;
    rdfs:comment 'The date on which the employee submitted their benefit election in Workday HCM. Distinct from the effective_date (when coverage begins). Used to verify timely enrollment within the election window and for audit trail purposes.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fsaPlanType rdf:type rdf:Property ;
    rdfs:label 'Fsa Plan Type' ;
    rdfs:comment 'Specifies the type of Flexible Spending Account (FSA) elected: healthcare FSA (for medical expenses), dependent care FSA (DCFSA for childcare/eldercare), or limited-purpose FSA (for dental/vision only, compatible with HSA). Applicable only when benefit_type is fsa.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hsaContributionLimit rdf:type rdf:Property ;
    rdfs:label 'Hsa Contribution Limit' ;
    rdfs:comment 'The IRS-mandated annual contribution limit applicable to this HSA enrollment based on coverage tier (individual vs. family) and the employees age (catch-up contributions for age 55+). Used to validate that annual_election_amount does not exceed IRS limits. Applicable only when benefit_type is hsa.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lifeInsuranceCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Life Insurance Coverage Amount' ;
    rdfs:comment 'The face value (death benefit) of the life insurance policy elected by the employee, expressed in USD. Applicable only when benefit_type is life_insurance. May be a flat amount or a multiple of annual salary (e.g., 1x, 2x base salary).' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openEnrollmentPeriod rdf:type rdf:Property ;
    rdfs:label 'Open Enrollment Period' ;
    rdfs:comment 'Identifier for the annual open enrollment window during which this election was made (e.g., OE-2024). Null for mid-year qualifying life event enrollments. Used to group and audit all elections made during a specific open enrollment campaign.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otherCoverageCarrier rdf:type rdf:Property ;
    rdfs:label 'Other Coverage Carrier' ;
    rdfs:comment 'Name of the insurance carrier providing the employees other coverage when the employee has waived the employers plan due to having coverage elsewhere. Used for coordination of benefits (COB) and ACA compliance documentation.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planYear rdf:type rdf:Property ;
    rdfs:label 'Plan Year' ;
    rdfs:comment 'The calendar or fiscal plan year to which this enrollment applies (e.g., 2024). Used to associate elections with the correct annual benefit period for reporting, compliance, and ACA employer mandate tracking.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pretaxFlag rdf:type rdf:Property ;
    rdfs:label 'Pretax Flag' ;
    rdfs:comment 'Indicates whether the employees premium contribution is deducted on a pre-tax basis under a Section 125 Cafeteria Plan (True) or on a post-tax basis (False). Affects the employees taxable income and W-2 reporting. Most medical, dental, and vision premiums are pre-tax.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualifyingLifeEventType rdf:type rdf:Property ;
    rdfs:label 'Qualifying Life Event Type' ;
    rdfs:comment 'Specifies the type of qualifying life event (QLE) that triggered a mid-year benefit change, when enrollment_source is qualifying_life_event. Examples include marriage, divorce, birth, adoption, death of dependent, loss of other coverage, change in employment status. Null when enrollment_source is open_enrollment or new_hire. [ENUM-REF-CANDIDATE: marriage|divorce|birth|adoption|death_of_dependent|loss_of_coverage|employment_change|other — promote to reference product]' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementContributionRate rdf:type rdf:Property ;
    rdfs:label 'Retirement Contribution Rate' ;
    rdfs:comment 'The employees elected contribution rate as a percentage of gross pay for retirement plans (403(b)/401(k)), expressed as a decimal (e.g., 0.0600 = 6%). Used to calculate per-period retirement deductions in Workday Payroll. Applicable only when benefit_type is retirement.' ;
    rdfs:domain ind:BenefitEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leaveRequestId rdf:type rdf:Property ;
    rdfs:label 'Leave Request Id' ;
    rdfs:comment 'Unique system-generated identifier for each employee leave of absence request record in the Workday HCM Absence Management module.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedEndDate rdf:type rdf:Property ;
    rdfs:label 'Approved End Date' ;
    rdfs:comment 'The HR-approved last calendar date of the leave of absence. Used for return-to-work planning, benefits administration, and FMLA entitlement tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedStartDate rdf:type rdf:Property ;
    rdfs:label 'Approved Start Date' ;
    rdfs:comment 'The HR-approved first calendar date of the leave of absence, which may differ from the requested start date. Drives payroll processing, benefits continuation, and FTE (Full-Time Equivalent) reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:benefitsContinuation rdf:type rdf:Property ;
    rdfs:label 'Benefits Continuation' ;
    rdfs:comment 'Indicates whether the employees group health benefits are being continued during the leave period. FMLA requires employers to maintain group health coverage under the same terms as if the employee had continued working.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraNotificationSent rdf:type rdf:Property ;
    rdfs:label 'Cobra Notification Sent' ;
    rdfs:comment 'Indicates whether a COBRA (Consolidated Omnibus Budget Reconciliation Act) continuation coverage notification was sent to the employee, applicable when benefits are not continued during the leave or upon separation.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fitnessForDutyReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Fitness For Duty Received Date' ;
    rdfs:comment 'Date on which the employer received the completed fitness-for-duty medical certification from the employees healthcare provider, clearing the employee to return to work.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fitnessForDutyRequired rdf:type rdf:Property ;
    rdfs:label 'Fitness For Duty Required' ;
    rdfs:comment 'Indicates whether the employer requires a fitness-for-duty medical certification before the employee may return to work. Applicable for FMLA leave taken for the employees own serious health condition.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fmlaEligibilityDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Fmla Eligibility Determination Date' ;
    rdfs:comment 'Date on which HR formally determined and communicated the employees FMLA (Family and Medical Leave Act) eligibility status. FMLA regulations require notification within 5 business days of the leave request.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fmlaEligible rdf:type rdf:Property ;
    rdfs:label 'Fmla Eligible' ;
    rdfs:comment 'Indicates whether the employee meets the FMLA (Family and Medical Leave Act) eligibility criteria at the time of the leave request: employed for at least 12 months, worked at least 1,250 hours in the prior 12 months, and works at a location with 50+ employees within 75 miles.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fmlaHoursRemaining rdf:type rdf:Property ;
    rdfs:label 'Fmla Hours Remaining' ;
    rdfs:comment 'Remaining FMLA (Family and Medical Leave Act) entitlement hours available to the employee in the current FMLA leave year after accounting for hours used. Supports HR compliance monitoring and employee communication.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fmlaHoursUsed rdf:type rdf:Property ;
    rdfs:label 'Fmla Hours Used' ;
    rdfs:comment 'Cumulative FMLA (Family and Medical Leave Act) hours consumed by the employee in the current FMLA leave year for this request. FMLA entitlement is capped at 480 hours (12 weeks) per year for most qualifying reasons.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hrNotes rdf:type rdf:Property ;
    rdfs:label 'Hr Notes' ;
    rdfs:comment 'Free-text notes entered by the HR leave administrator documenting case-specific details, communications with the employee, or special circumstances. May contain PHI (Protected Health Information) and is subject to HIPAA confidentiality requirements.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intermittentDurationHours rdf:type rdf:Property ;
    rdfs:label 'Intermittent Duration Hours' ;
    rdfs:comment 'Expected duration in hours of each intermittent leave episode as certified by the healthcare provider. Used to calculate FTE (Full-Time Equivalent) impact and schedule coverage needs.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intermittentFrequency rdf:type rdf:Property ;
    rdfs:label 'Intermittent Frequency' ;
    rdfs:comment 'Expected frequency of intermittent leave episodes as certified by the healthcare provider (e.g., Daily, Weekly, Monthly, As Needed). Used for scheduling and absence pattern monitoring.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isIntermittent rdf:type rdf:Property ;
    rdfs:label 'Is Intermittent' ;
    rdfs:comment 'Indicates whether the leave is taken intermittently (in separate blocks of time or by reducing the normal weekly or daily work schedule) rather than as a single continuous period. Intermittent FMLA requires separate tracking of each absence episode.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leaveDurationDays rdf:type rdf:Property ;
    rdfs:label 'Leave Duration Days' ;
    rdfs:comment 'Total approved duration of the leave in calendar days, calculated from approved start and end dates. Used for ALOS (Average Length of Stay) benchmarking, workforce planning, and payroll impact analysis.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leaveReason rdf:type rdf:Property ;
    rdfs:label 'Leave Reason' ;
    rdfs:comment 'Specific reason or qualifying condition for the leave request (e.g., serious health condition of employee, care for family member, military deployment, birth/adoption of child). Constitutes PHI (Protected Health Information) when related to a medical condition and is subject to HIPAA and FMLA confidentiality requirements.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaveYearStartDate rdf:type rdf:Property ;
    rdfs:label 'Leave Year Start Date' ;
    rdfs:comment 'Start date of the 12-month FMLA leave year applicable to this request. Employers may use a calendar year, fixed year, or rolling 12-month period. Determines the entitlement window for FMLA hour calculations.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicalCertificationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Medical Certification Expiration Date' ;
    rdfs:comment 'Date on which the medical certification supporting the leave request expires. HR must request recertification before this date for ongoing or intermittent leave.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicalCertificationReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Medical Certification Received Date' ;
    rdfs:comment 'Date on which the employer received the completed medical certification form (e.g., WH-380-E or WH-380-F) from the employee or their healthcare provider.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicalCertificationRequired rdf:type rdf:Property ;
    rdfs:label 'Medical Certification Required' ;
    rdfs:comment 'Indicates whether a medical certification from a healthcare provider is required to support the leave request. Required for FMLA leave related to a serious health condition.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:militaryOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Military Order Number' ;
    rdfs:comment 'Official military order number from the deployment or activation orders provided by the employee for USERRA military leave verification. Supports compliance documentation.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:militaryServiceBranch rdf:type rdf:Property ;
    rdfs:label 'Military Service Branch' ;
    rdfs:comment 'Branch of the U.S. Armed Forces for which the employee is taking military leave under USERRA (Uniformed Services Employment and Reemployment Rights Act). Populated only for military leave type requests. [ENUM-REF-CANDIDATE: Army|Navy|Air_Force|Marine_Corps|Coast_Guard|Space_Force|National_Guard — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeProvidedDate rdf:type rdf:Property ;
    rdfs:label 'Notice Provided Date' ;
    rdfs:comment 'Date on which the employer provided the required FMLA designation notice to the employee, informing them whether the leave qualifies as FMLA and the amount of leave counted against their entitlement.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payStatus rdf:type rdf:Property ;
    rdfs:label 'Pay Status' ;
    rdfs:comment 'Compensation status during the leave period. Indicates whether the employee receives full pay, partial pay, short-term disability (STD) benefits, long-term disability (LTD) benefits, or is on unpaid leave. Drives payroll processing in Workday HCM Payroll.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ptoHoursApplied rdf:type rdf:Property ;
    rdfs:label 'Pto Hours Applied' ;
    rdfs:comment 'Number of accrued PTO (Paid Time Off) hours the employee has elected or is required to use concurrently with the leave period. FMLA regulations permit employers to require concurrent use of accrued paid leave.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requestedEndDate rdf:type rdf:Property ;
    rdfs:label 'Requested End Date' ;
    rdfs:comment 'The employee-requested last calendar date of the leave of absence period. May differ from the approved end date if HR modifies the duration during the approval process.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestedStartDate rdf:type rdf:Property ;
    rdfs:label 'Requested Start Date' ;
    rdfs:comment 'The employee-requested first calendar date of the leave of absence period. Used for scheduling, coverage planning, and FMLA eligibility period calculations.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:returnToWorkDate rdf:type rdf:Property ;
    rdfs:label 'Return To Work Date' ;
    rdfs:comment 'Actual date the employee returned to active employment following the leave of absence. May differ from the approved end date due to early return, extended leave, or AMA (Against Medical Advice) situations.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:returnToWorkStatus rdf:type rdf:Property ;
    rdfs:label 'Return To Work Status' ;
    rdfs:comment 'Outcome status of the employees return to work following the leave. Indicates whether the employee returned as scheduled, extended the leave, separated from employment, or has not yet returned.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workdayAbsenceCode rdf:type rdf:Property ;
    rdfs:label 'Workday Absence Code' ;
    rdfs:comment 'Native identifier of the leave request record in the Workday HCM Absence Management source system. Used for cross-system reconciliation and ETL (Extract Transform Load) deduplication.' ;
    rdfs:domain ind:LeaveRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceReviewId rdf:type rdf:Property ;
    rdfs:label 'Performance Review Id' ;
    rdfs:comment 'Unique surrogate identifier for each performance review record in the workforce performance management system. Primary key for the performance_review data product.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:performanceEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Performance Employee Id' ;
    rdfs:comment 'Reference to the employee or contingent worker who is the subject of this performance review. Links to the workforce worker master record.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:reviewTemplateId rdf:type rdf:Property ;
    rdfs:label 'Review Template Id' ;
    rdfs:comment 'Reference to the performance review template or form used for this evaluation cycle, defining the rating scales, competency sections, and goal sections applied.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReviewTemplate .

ind:calibrationDate rdf:type rdf:Property ;
    rdfs:label 'Calibration Date' ;
    rdfs:comment 'The date on which the performance rating for this review was finalized through the HR calibration process. Populated when calibration_status is calibrated or approved.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calibrationStatus rdf:type rdf:Property ;
    rdfs:label 'Calibration Status' ;
    rdfs:comment 'Status of the performance rating calibration process for this review, indicating whether the rating has been reviewed and validated through the HR calibration session.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careerInterestNarrative rdf:type rdf:Property ;
    rdfs:label 'Career Interest Narrative' ;
    rdfs:comment 'Free-text description of the employees stated career interests, desired roles, and long-term professional aspirations as captured during the performance review discussion.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimAppealResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Claim Appeal Resolution Date' ;
    rdfs:comment 'The date on which the formal appeal was resolved and a final determination was communicated to the employee. Used for HR compliance and legal documentation.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:claimAppealStatus rdf:type rdf:Property ;
    rdfs:label 'Claim Appeal Status' ;
    rdfs:comment 'Current status of the employees formal appeal against the performance rating or disciplinary action. Populated only when appeal_filed is true.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competencyRating rdf:type rdf:Property ;
    rdfs:label 'Competency Rating' ;
    rdfs:comment 'Composite rating reflecting the employees demonstration of required competencies (clinical, behavioral, leadership) as defined in the review template for the position.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:developmentGoalsNarrative rdf:type rdf:Property ;
    rdfs:label 'Development Goals Narrative' ;
    rdfs:comment 'Free-text description of agreed-upon professional development goals, training plans, and career growth objectives established during the performance review discussion.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disciplineType rdf:type rdf:Property ;
    rdfs:label 'Discipline Type' ;
    rdfs:comment 'Type of progressive disciplinary action associated with this review record, if applicable. Captures the formal discipline step per HR policy. [ENUM-REF-CANDIDATE: none|verbal_warning|written_warning|pip|suspension|termination_for_cause — promote to reference product]' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeAcknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Employee Acknowledgment Date' ;
    rdfs:comment 'The date on which the employee acknowledged receipt and review of their completed performance evaluation. Required for HR compliance documentation.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:goalAchievementRating rdf:type rdf:Property ;
    rdfs:label 'Goal Achievement Rating' ;
    rdfs:comment 'Composite rating reflecting the employees achievement of defined performance goals and objectives for the review period. Distinct from competency ratings.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isHighPotential rdf:type rdf:Property ;
    rdfs:label 'Is High Potential' ;
    rdfs:comment 'Indicates whether the employee has been formally designated as high-potential (HiPo) during this review cycle, qualifying them for accelerated development programs and succession consideration.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managerFeedback rdf:type rdf:Property ;
    rdfs:label 'Manager Feedback' ;
    rdfs:comment 'Free-text narrative provided by the reviewing manager summarizing the employees performance, strengths, areas for development, and behavioral observations during the review period.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Manager Submission Date' ;
    rdfs:comment 'The date on which the manager formally submitted the completed performance review in Workday HCM. Used to measure review completion timeliness against the due date.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mentorshipParticipant rdf:type rdf:Property ;
    rdfs:label 'Mentorship Participant' ;
    rdfs:comment 'Indicates whether the employee is currently participating in a formal mentorship program (as mentor or mentee) as documented in the talent profile associated with this review.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meritIncreaseEligible rdf:type rdf:Property ;
    rdfs:label 'Merit Increase Eligible' ;
    rdfs:comment 'Indicates whether the employee is eligible for a merit-based compensation increase based on their overall performance rating and HR policy criteria for the review cycle.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meritIncreasePercent rdf:type rdf:Property ;
    rdfs:label 'Merit Increase Percent' ;
    rdfs:comment 'The recommended or approved merit salary increase percentage associated with this performance review outcome. Expressed as a percentage of base salary (e.g., 3.50 = 3.5%).' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mobilityPreference rdf:type rdf:Property ;
    rdfs:label 'Mobility Preference' ;
    rdfs:comment 'Employees stated preference regarding geographic relocation or mobility for career advancement opportunities, as captured in the talent profile during the review cycle.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallRating rdf:type rdf:Property ;
    rdfs:label 'Overall Rating' ;
    rdfs:comment 'The final overall performance rating assigned by the manager for the review period. Drives merit increase eligibility, promotion decisions, and succession planning. [ENUM-REF-CANDIDATE: exceeds_expectations|meets_expectations|partially_meets|does_not_meet|outstanding — promote to reference product]' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallRatingScore rdf:type rdf:Property ;
    rdfs:label 'Overall Rating Score' ;
    rdfs:comment 'Numeric score corresponding to the overall performance rating on the defined rating scale (e.g., 1.00–5.00). Enables quantitative comparison and ranking across the workforce for merit and succession analytics.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pipEndDate rdf:type rdf:Property ;
    rdfs:label 'Pip End Date' ;
    rdfs:comment 'The date on which the Performance Improvement Plan (PIP) period concludes. Used to track PIP duration and schedule follow-up evaluations.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pipOutcome rdf:type rdf:Property ;
    rdfs:label 'Pip Outcome' ;
    rdfs:comment 'The final outcome of a Performance Improvement Plan (PIP) upon conclusion of the PIP period. Drives subsequent HR actions such as continued employment, further discipline, or termination.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipStartDate rdf:type rdf:Property ;
    rdfs:label 'Pip Start Date' ;
    rdfs:comment 'The date on which a Performance Improvement Plan (PIP) was formally initiated for the employee. Populated only when discipline_type is pip.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyViolationCode rdf:type rdf:Property ;
    rdfs:label 'Policy Violation Code' ;
    rdfs:comment 'Standardized code identifying the specific HR or organizational policy that was violated, if this review is associated with a disciplinary action. Aligns with the HR policy code library.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promotionEligible rdf:type rdf:Property ;
    rdfs:label 'Promotion Eligible' ;
    rdfs:comment 'Indicates whether the employee has been identified as eligible for promotion to a higher-level position based on performance review outcomes and manager recommendation.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewMeetingDate rdf:type rdf:Property ;
    rdfs:label 'Review Meeting Date' ;
    rdfs:comment 'The date on which the formal performance review discussion meeting was held between the employee and their manager. Distinct from the manager submission date.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Review Period End Date' ;
    rdfs:comment 'The last date of the performance evaluation period covered by this review. Defines the end of the measurement window for goals, competencies, and conduct.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Review Period Start Date' ;
    rdfs:comment 'The first date of the performance evaluation period covered by this review. Defines the beginning of the measurement window for goals, competencies, and conduct.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:selfAssessmentNarrative rdf:type rdf:Property ;
    rdfs:label 'Self Assessment Narrative' ;
    rdfs:comment 'Free-text self-evaluation submitted by the employee describing their own performance, accomplishments, challenges, and development needs for the review period.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemReviewCode rdf:type rdf:Property ;
    rdfs:label 'Source System Review Code' ;
    rdfs:comment 'The native identifier of this performance review record in the originating Workday HCM Talent Management system. Used for data lineage, reconciliation, and ETL traceability.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:successionPlanIncluded rdf:type rdf:Property ;
    rdfs:label 'Succession Plan Included' ;
    rdfs:comment 'Indicates whether the employee has been included in a formal succession plan for a critical role as a result of or in conjunction with this performance review.' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:talentSegment rdf:type rdf:Property ;
    rdfs:label 'Talent Segment' ;
    rdfs:comment 'Talent segmentation category assigned to the employee based on performance and potential assessment. Used for succession planning, retention strategy, and workforce planning. [ENUM-REF-CANDIDATE: high_potential|key_contributor|solid_performer|needs_development|at_risk — promote to reference product]' ;
    rdfs:domain ind:PerformanceReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recruitmentId rdf:type rdf:Property ;
    rdfs:label 'Recruitment Id' ;
    rdfs:comment 'Unique surrogate identifier for each recruitment record in the Healthcare workforce recruitment lifecycle. Primary key for the recruitment data product. Entity role: TRANSACTION_HEADER — represents a discrete end-to-end hiring event from job requisition through productive employee onboarding.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicantId rdf:type rdf:Property ;
    rdfs:label 'Applicant Id' ;
    rdfs:comment 'Reference to the applicant/candidate record in the workforce applicant master. Serves as the PARTY_REFERENCE linking this recruitment transaction to the individual being hired.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Applicant .

ind:applicantEmail rdf:type rdf:Property ;
    rdfs:label 'Applicant Email' ;
    rdfs:comment 'Primary email address of the applicant used for all recruitment communications, interview scheduling, offer delivery, and onboarding portal access provisioning.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicantPhone rdf:type rdf:Property ;
    rdfs:label 'Applicant Phone' ;
    rdfs:comment 'Primary contact phone number for the applicant used by recruiters for interview scheduling and offer negotiation communications.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:badgeIssued rdf:type rdf:Property ;
    rdfs:label 'Badge Issued' ;
    rdfs:comment 'Indicates whether a physical access control badge has been issued to the new hire. Required for facility access and patient safety compliance. Tracked as part of onboarding task completion.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costPerHire rdf:type rdf:Property ;
    rdfs:label 'Cost Per Hire' ;
    rdfs:comment 'Total recruitment cost associated with filling this position, including advertising, agency fees, recruiter time, and pre-employment screening costs in USD. Key Key Performance Indicator (KPI) for recruitment efficiency benchmarking.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drugScreenStatus rdf:type rdf:Property ;
    rdfs:label 'Drug Screen Status' ;
    rdfs:comment 'Status of the pre-employment drug screening test for the candidate. Required for clinical and safety-sensitive positions per OSHA and facility policy. Blocks onboarding for positive results.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireSafetyTrainingCompleted rdf:type rdf:Property ;
    rdfs:label 'Fire Safety Training Completed' ;
    rdfs:comment 'Indicates whether the new hire has completed mandatory fire safety and life safety training as required by The Joint Commission (TJC) Environment of Care standards and OSHA regulations.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaTrainingCompleted rdf:type rdf:Property ;
    rdfs:label 'Hipaa Training Completed' ;
    rdfs:comment 'Indicates whether the new hire has completed mandatory Health Insurance Portability and Accountability Act (HIPAA) privacy and security training as required for all healthcare workforce members with access to Protected Health Information (PHI).' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hireDecision rdf:type rdf:Property ;
    rdfs:label 'Hire Decision' ;
    rdfs:comment 'The final hiring decision outcome for this recruitment record. Used for EEOC applicant flow log reporting, source-of-hire analytics, and requisition closure.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:i9CompletionDate rdf:type rdf:Property ;
    rdfs:label 'I9 Completion Date' ;
    rdfs:comment 'The date the Form I-9 Employment Eligibility Verification was completed and verified for the new hire. Used for USCIS compliance audits and onboarding task closure.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:i9VerificationStatus rdf:type rdf:Property ;
    rdfs:label 'I9 Verification Status' ;
    rdfs:comment 'Status of the Form I-9 Employment Eligibility Verification for the new hire. Mandatory for all U.S. employees per USCIS requirements. Must be completed within 3 business days of hire date.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infectionControlTrainingCompleted rdf:type rdf:Property ;
    rdfs:label 'Infection Control Training Completed' ;
    rdfs:comment 'Indicates whether the new hire has completed mandatory infection control training as required by The Joint Commission (TJC), CMS Conditions of Participation, and OSHA bloodborne pathogen standards.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interviewDate rdf:type rdf:Property ;
    rdfs:label 'Interview Date' ;
    rdfs:comment 'Date of the most recent or primary interview conducted with the applicant. Used for scheduling coordination and time-to-hire milestone tracking.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:interviewStage rdf:type rdf:Property ;
    rdfs:label 'Interview Stage' ;
    rdfs:comment 'The most recent interview stage completed by the applicant. Used to track interview progression, panel scheduling, and candidate experience metrics.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isClinicalPosition rdf:type rdf:Property ;
    rdfs:label 'Is Clinical Position' ;
    rdfs:comment 'Indicates whether the recruited position is a clinical role requiring licensure verification, credentialing, or privileging through Symplr or the medical staff office. Triggers additional pre-employment screening workflows.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseVerified rdf:type rdf:Property ;
    rdfs:label 'License Verified' ;
    rdfs:comment 'Indicates whether the required professional license for the recruited position has been primary source verified prior to the hire date. Mandatory for licensed clinical positions per The Joint Commission (TJC) and CMS standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:offerAcceptedDate rdf:type rdf:Property ;
    rdfs:label 'Offer Accepted Date' ;
    rdfs:comment 'The date the candidate formally accepted the employment offer. Used to calculate offer-to-start cycle time and trigger pre-employment screening and onboarding workflows.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:offerDate rdf:type rdf:Property ;
    rdfs:label 'Offer Date' ;
    rdfs:comment 'The date a formal employment offer was extended to the candidate. Used to calculate offer-to-acceptance cycle time and recruiter performance metrics.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:offerStatus rdf:type rdf:Property ;
    rdfs:label 'Offer Status' ;
    rdfs:comment 'Current status of the employment offer extended to the candidate. Drives offer acceptance rate reporting and compensation negotiation tracking.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offeredSalary rdf:type rdf:Property ;
    rdfs:label 'Offered Salary' ;
    rdfs:comment 'The base annual salary amount offered to the candidate in the employment offer letter, in USD. Used for compensation equity analysis, pay range compliance, and budget variance reporting.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:onboardingCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Onboarding Completion Date' ;
    rdfs:comment 'The actual date all required onboarding tasks were completed and the new hire was deemed fully productive. Used to calculate onboarding cycle time and close the recruitment record.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:onboardingTargetCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Onboarding Target Completion Date' ;
    rdfs:comment 'The target date by which all onboarding tasks (I-9, orientation, required training, badge, system access, policy acknowledgments) must be completed for the new hire. Used for onboarding compliance tracking and manager accountability.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orientationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Orientation Completion Date' ;
    rdfs:comment 'The date the new hire completed all required new employee orientation sessions. Used as a milestone for onboarding completion tracking and The Joint Commission (TJC) accreditation documentation.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orientationStatus rdf:type rdf:Property ;
    rdfs:label 'Orientation Status' ;
    rdfs:comment 'Status of the new employee orientation attendance for the onboarding new hire. Includes general hospital orientation and department-specific orientation sessions required by The Joint Commission (TJC).' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineStage rdf:type rdf:Property ;
    rdfs:label 'Pipeline Stage' ;
    rdfs:comment 'Current stage of the applicant within the recruitment pipeline funnel. Drives workflow automation, recruiter task assignment, and applicant pipeline conversion analytics. [ENUM-REF-CANDIDATE: applied|screening|interview|offer|background_check|hired|rejected|withdrawn — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyAcknowledgmentCompleted rdf:type rdf:Property ;
    rdfs:label 'Policy Acknowledgment Completed' ;
    rdfs:comment 'Indicates whether the new hire has completed all required policy acknowledgments (Code of Conduct, HIPAA, Social Media, Workplace Violence, etc.) as part of onboarding. Required for compliance and accreditation.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requisitionNumber rdf:type rdf:Property ;
    rdfs:label 'Requisition Number' ;
    rdfs:comment 'Externally-known business identifier for the job requisition as assigned by Workday HCM Recruiting. Used across HR, Finance, and hiring manager communications to track the open position request. Serves as the BUSINESS_IDENTIFIER for this TRANSACTION_HEADER entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requisitionOpenDate rdf:type rdf:Property ;
    rdfs:label 'Requisition Open Date' ;
    rdfs:comment 'The date the job requisition was officially opened and approved for active recruiting. Serves as the BUSINESS_EVENT_TIMESTAMP anchor for time-to-fill calculations and recruiter performance metrics.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requisitionStatus rdf:type rdf:Property ;
    rdfs:label 'Requisition Status' ;
    rdfs:comment 'Current lifecycle state of the job requisition within the recruitment workflow. Drives workflow routing, headcount reporting, and recruiter workload management. Serves as the LIFECYCLE_STATUS for this TRANSACTION_HEADER entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceOfHire rdf:type rdf:Property ;
    rdfs:label 'Source Of Hire' ;
    rdfs:comment 'The recruitment channel or source through which the successful candidate was identified (e.g., Indeed, LinkedIn, employee referral, internal transfer, agency, career fair, Workday career site). Key metric for recruitment marketing ROI analysis. [ENUM-REF-CANDIDATE: indeed|linkedin|employee_referral|internal_transfer|agency|career_fair|workday_career_site|direct_application|university|other — promote to reference product]' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemAccessProvisioned rdf:type rdf:Property ;
    rdfs:label 'System Access Provisioned' ;
    rdfs:comment 'Indicates whether Electronic Health Record (EHR) and required clinical/administrative system access has been provisioned for the new hire. Includes Epic EHR, Workday, and role-specific application access per HIPAA minimum necessary standard.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetStartDate rdf:type rdf:Property ;
    rdfs:label 'Target Start Date' ;
    rdfs:comment 'The planned first day of work for the new hire as agreed in the offer letter. Used for onboarding scheduling, system access provisioning timelines, and department readiness planning.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:timeToFillDays rdf:type rdf:Property ;
    rdfs:label 'Time To Fill Days' ;
    rdfs:comment 'Number of calendar days from requisition open date to offer accepted date. Primary recruitment efficiency Key Performance Indicator (KPI) used for recruiter performance management and workforce planning benchmarking.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:workdayCandidateCode rdf:type rdf:Property ;
    rdfs:label 'Workday Candidate Code' ;
    rdfs:comment 'The source system candidate identifier assigned by Workday HCM Recruiting. Used for system-of-record traceability, ETL reconciliation, and integration with Workday HCM Core HR upon hire.' ;
    rdfs:domain ind:Recruitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaIncidentId rdf:type rdf:Property ;
    rdfs:label 'Osha Incident Id' ;
    rdfs:comment 'Unique system-generated identifier for each OSHA-recordable workplace injury, illness, or near-miss incident record. Primary key for the osha_incident data product.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:improvementInitiativeId rdf:type rdf:Property ;
    rdfs:label 'Improvement Initiative Id' ;
    rdfs:comment 'Foreign key linking to quality.improvement_initiative. Business justification: Healthcare organizations track employee safety incidents (OSHA) alongside patient safety for accreditation and organizational safety culture improvement. When workplace injuries reveal systemic issues' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ImprovementInitiative .

ind:injuryIcdCodeId rdf:type rdf:Property ;
    rdfs:label 'Injury Icd Code Id' ;
    rdfs:comment 'Foreign key linking to reference.icd_code. Business justification: OSHA recordable injuries/illnesses coded with ICD-10-CM for workers compensation claims, OSHA 300 log, and BLS injury/illness survey reporting. Real-world: workers comp first reports of injury, OSHA' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcdCode .

ind:injurySnomedConceptId rdf:type rdf:Property ;
    rdfs:label 'Injury Snomed Concept Id' ;
    rdfs:comment 'Foreign key linking to reference.snomed_concept. Business justification: Detailed injury/illness documentation using SNOMED for occupational health EHR integration and injury surveillance analytics. Real-world: employee health records, sharps injury tracking, bloodborne pa' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SnomedConcept .

ind:workersCompPayerId rdf:type rdf:Property ;
    rdfs:label 'Workers Comp Payer Id' ;
    rdfs:comment 'Foreign key linking to insurance.payer. Business justification: OSHA incidents with workers compensation claims require tracking the workers comp insurance payer for claim submission, payment reconciliation, subrogation, and regulatory reporting. Healthcare orga' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:bloodbornePathogenExposure rdf:type rdf:Property ;
    rdfs:label 'Bloodborne Pathogen Exposure' ;
    rdfs:comment 'Indicates whether the incident involved potential exposure to bloodborne pathogens (e.g., HIV, HBV, HCV) through needlestick, sharps injury, or mucous membrane contact. Triggers post-exposure prophylaxis (PEP) protocol.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bodyPartAffected rdf:type rdf:Property ;
    rdfs:label 'Body Part Affected' ;
    rdfs:comment 'The specific body part injured or affected by the illness (e.g., lower back, right hand, eye, finger). Captured per OSHA Form 301 requirements and used for ergonomic and safety trend analysis.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bodySide rdf:type rdf:Property ;
    rdfs:label 'Body Side' ;
    rdfs:comment 'Laterality of the body part affected (left, right, bilateral, or not applicable). Supports clinical follow-up and workers compensation documentation.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentEventSource rdf:type rdf:Property ;
    rdfs:label 'Consent Event Source' ;
    rdfs:comment 'The object, substance, or exposure that directly produced or inflicted the injury or illness (e.g., needle/syringe, patient handling, floor surface, chemical agent). Coded per BLS OIICS source codes.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysRestrictedDuty rdf:type rdf:Property ;
    rdfs:label 'Days Restricted Duty' ;
    rdfs:comment 'Number of calendar days the employee was on restricted work activity or job transfer due to the injury or illness, as recorded on the OSHA 300 log. Capped at 180 days per OSHA reporting rules.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:incidentDatetime rdf:type rdf:Property ;
    rdfs:label 'Incident Datetime' ;
    rdfs:comment 'The precise date and time the workplace injury, illness, or near-miss event occurred. This is the principal real-world event timestamp for the incident.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:injuryIllnessType rdf:type rdf:Property ;
    rdfs:label 'Injury Illness Type' ;
    rdfs:comment 'OSHA Form 300 column classification indicating whether the event resulted in an injury or one of the five illness categories as defined by OSHA recordkeeping rules.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Completed Date' ;
    rdfs:comment 'Date the formal incident investigation was completed and findings were documented. Used to measure investigation timeliness and compliance with internal safety program SLAs.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isFatality rdf:type rdf:Property ;
    rdfs:label 'Is Fatality' ;
    rdfs:comment 'Indicates whether the incident resulted in the death of the employee. Fatalities must be reported to OSHA within 8 hours under 29 CFR Part 1904.39.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHospitalized rdf:type rdf:Property ;
    rdfs:label 'Is Hospitalized' ;
    rdfs:comment 'Indicates whether the employee was admitted as an inpatient to a hospital as a result of the incident. Inpatient hospitalizations must be reported to OSHA within 24 hours.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOshaRecordable rdf:type rdf:Property ;
    rdfs:label 'Is Osha Recordable' ;
    rdfs:comment 'Indicates whether the incident meets OSHA recordability criteria under 29 CFR Part 1904.7 (general recording criteria). True if the incident resulted in days away from work, restricted duty, medical treatment beyond first aid, loss of consciousness, or diagnosis of a significant injury/illness.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrivacyCase rdf:type rdf:Property ;
    rdfs:label 'Is Privacy Case' ;
    rdfs:comment 'Indicates whether the incident qualifies as a privacy case under OSHA 29 CFR Part 1904.29(b)(7), where the employees name is withheld from the OSHA 300 log to protect confidentiality (e.g., sexual assault, mental illness, HIV/AIDS, needlestick).' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isWorkRelated rdf:type rdf:Property ;
    rdfs:label 'Is Work Related' ;
    rdfs:comment 'Indicates whether the injury or illness is determined to be work-related per OSHA 29 CFR Part 1904.5. Work-relatedness is a prerequisite for OSHA recordability.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:natureOfInjury rdf:type rdf:Property ;
    rdfs:label 'Nature Of Injury' ;
    rdfs:comment 'Describes the physical characteristics of the injury or illness (e.g., laceration, sprain/strain, contusion, puncture wound, burn, fracture). Coded per BLS OIICS nature codes.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:osha300LogEntryDate rdf:type rdf:Property ;
    rdfs:label 'Osha 300 Log Entry Date' ;
    rdfs:comment 'Date the incident was entered onto the OSHA Form 300 Log of Work-Related Injuries and Illnesses. OSHA requires entry within 7 calendar days of receiving information that a recordable case occurred.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:osha300aIncluded rdf:type rdf:Property ;
    rdfs:label 'Osha 300a Included' ;
    rdfs:comment 'Indicates whether this incident has been included in the OSHA Form 300A Annual Summary of Work-Related Injuries and Illnesses for the applicable calendar year.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:osha301Completed rdf:type rdf:Property ;
    rdfs:label 'Osha 301 Completed' ;
    rdfs:comment 'Indicates whether the OSHA Form 301 Injury and Illness Incident Report (or equivalent workers compensation first report of injury) has been completed for this incident.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oshaEstablishmentNumber rdf:type rdf:Property ;
    rdfs:label 'Osha Establishment Number' ;
    rdfs:comment 'The OSHA establishment identifier for the specific business location/facility as registered with OSHA. Required for OSHA 300 log maintenance and electronic submission via OSHAs Injury Tracking Application (ITA).' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postExposureFollowupCompleted rdf:type rdf:Property ;
    rdfs:label 'Post Exposure Followup Completed' ;
    rdfs:comment 'Indicates whether the required post-exposure medical evaluation and follow-up was completed for bloodborne pathogen or chemical exposure incidents, per OSHA and CDC protocols.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ppeInUse rdf:type rdf:Property ;
    rdfs:label 'Ppe In Use' ;
    rdfs:comment 'Indicates whether the employee was using required personal protective equipment (PPE) at the time of the incident. Used to assess PPE compliance and effectiveness.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ppeType rdf:type rdf:Property ;
    rdfs:label 'Ppe Type' ;
    rdfs:comment 'Type of PPE in use or required at the time of the incident (e.g., gloves, N95 respirator, safety goggles, gown, face shield). Supports PPE adequacy assessment.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedDatetime rdf:type rdf:Property ;
    rdfs:label 'Reported Datetime' ;
    rdfs:comment 'Date and time the incident was formally reported by the employee or supervisor to the safety/HR department. Used to measure reporting timeliness compliance.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rootCauseDescription rdf:type rdf:Property ;
    rdfs:label 'Root Cause Description' ;
    rdfs:comment 'Detailed narrative of the root cause analysis (RCA) findings, including contributing factors, system failures, and causal chain. Supports corrective action planning and regulatory reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supervisorName rdf:type rdf:Property ;
    rdfs:label 'Supervisor Name' ;
    rdfs:comment 'Name of the employees direct supervisor at the time of the incident, as required on OSHA Form 301. Used for accountability tracking and investigation coordination.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatingProviderName rdf:type rdf:Property ;
    rdfs:label 'Treating Provider Name' ;
    rdfs:comment 'Name of the physician or healthcare provider who treated the injured or ill employee. Required on OSHA Form 301 Section 17.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentFacilityName rdf:type rdf:Property ;
    rdfs:label 'Treatment Facility Name' ;
    rdfs:comment 'Name of the medical facility where the employee received treatment (e.g., occupational health clinic, emergency department, urgent care). Required on OSHA Form 301.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessNames rdf:type rdf:Property ;
    rdfs:label 'Witness Names' ;
    rdfs:comment 'Names of any witnesses to the incident. Stored as a delimited string. Classified confidential to protect witness privacy during investigation.' ;
    rdfs:domain ind:OshaIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualFte rdf:type rdf:Property ;
    rdfs:label 'Actual Fte' ;
    rdfs:comment 'The actual FTE count consumed during the fiscal period, sourced from Workday HCM time and attendance data. Used for variance analysis against budgeted FTE.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualHours rdf:type rdf:Property ;
    rdfs:label 'Actual Hours' ;
    rdfs:comment 'Actual hours worked recorded in Workday HCM time and attendance for this budget line during the fiscal period. Used for FTE conversion and productivity benchmarking.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualLaborCost rdf:type rdf:Property ;
    rdfs:label 'Actual Labor Cost' ;
    rdfs:comment 'Actual labor cost incurred in USD for this budget line during the fiscal period, sourced from SAP S/4HANA payroll postings. Compared against budgeted_labor_cost for variance analysis.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agencyFte rdf:type rdf:Property ;
    rdfs:label 'Agency Fte' ;
    rdfs:comment 'The FTE equivalent of agency or contract labor utilized within this budget line during the fiscal period. Tracked separately from employed FTE for labor cost benchmarking and workforce mix analysis.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benefitsBurdenPct rdf:type rdf:Property ;
    rdfs:label 'Benefits Burden Pct' ;
    rdfs:comment 'The percentage applied to base wages to account for employer-paid benefits costs (health insurance, retirement, FICA, workers compensation) for this FTE budget line. Used to calculate total labor cost including benefits.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetCode rdf:type rdf:Property ;
    rdfs:label 'Budget Code' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetVersion rdf:type rdf:Property ;
    rdfs:label 'Budget Version' ;
    rdfs:comment 'Identifies the version of the FTE budget record: original (initial approved budget), revised (mid-year amendment), final (year-end actuals reconciliation), or forecast (rolling forecast update). Supports budget cycle management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetedAvgHourlyRate rdf:type rdf:Property ;
    rdfs:label 'Budgeted Avg Hourly Rate' ;
    rdfs:comment 'The budgeted average hourly wage rate in USD for positions covered by this FTE budget line, inclusive of base pay and applicable differentials. Used for labor cost projection and variance analysis.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetedHours rdf:type rdf:Property ;
    rdfs:label 'Budgeted Hours' ;
    rdfs:comment 'Total authorized worked hours budgeted for this FTE line in the fiscal period. Derived from budgeted FTE and standard hours per period; stored for direct comparison with actual hours from time and attendance.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetedLaborCost rdf:type rdf:Property ;
    rdfs:label 'Budgeted Labor Cost' ;
    rdfs:comment 'Total authorized labor cost in USD for this FTE budget line for the fiscal period, including base wages, differentials, and benefits burden. Used for workforce financial planning and labor cost management.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetedNonproductiveFte rdf:type rdf:Property ;
    rdfs:label 'Budgeted Nonproductive Fte' ;
    rdfs:comment 'The portion of the total budgeted FTE allocated to non-productive hours including paid time off (PTO), orientation, education, and leave. Supports total labor cost planning.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetedOvertimeFte rdf:type rdf:Property ;
    rdfs:label 'Budgeted Overtime Fte' ;
    rdfs:comment 'The FTE equivalent of overtime hours budgeted for this department and fiscal period. Supports overtime cost management and FLSA compliance monitoring.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetedProductiveFte rdf:type rdf:Property ;
    rdfs:label 'Budgeted Productive Fte' ;
    rdfs:comment 'The portion of the total budgeted FTE allocated specifically to productive (direct patient care) hours. Used to calculate staffing ratios and productivity benchmarks per adjusted patient day.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fteVariance rdf:type rdf:Property ;
    rdfs:label 'Fte Variance' ;
    rdfs:comment 'The difference between budgeted FTE and actual FTE (budgeted_fte minus actual_fte) for the fiscal period. Positive value indicates under-utilization; negative value indicates over-budget staffing. Supports labor cost variance reporting.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isUnionPosition rdf:type rdf:Property ;
    rdfs:label 'Is Union Position' ;
    rdfs:comment 'Indicates whether this FTE budget line covers union-represented positions (True) or non-union positions (False). Affects labor cost modeling, scheduling constraints, and collective bargaining agreement compliance.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:laborCostPerApd rdf:type rdf:Property ;
    rdfs:label 'Labor Cost Per Apd' ;
    rdfs:comment 'Budgeted labor cost divided by adjusted patient days (APD) for the fiscal period. A key productivity benchmark metric used in healthcare workforce financial planning and CMS value-based purchasing (VBP) reporting.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:laborCostVariance rdf:type rdf:Property ;
    rdfs:label 'Labor Cost Variance' ;
    rdfs:comment 'The difference between budgeted and actual labor cost (budgeted_labor_cost minus actual_labor_cost) in USD. Positive value indicates favorable variance (under budget); negative indicates unfavorable (over budget).' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:productivityTargetPct rdf:type rdf:Property ;
    rdfs:label 'Productivity Target Pct' ;
    rdfs:comment 'The target productive hours as a percentage of total paid hours for this department and job family (e.g., 85.00%). Used for productivity benchmarking and workforce efficiency reporting.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:staffingRatioTarget rdf:type rdf:Property ;
    rdfs:label 'Staffing Ratio Target' ;
    rdfs:comment 'The target nurse-to-patient or staff-to-patient ratio for this department and job family as defined by regulatory or organizational standards (e.g., 1:4 for ICU nursing). Supports staffing ratio compliance monitoring.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:standardHoursPerFte rdf:type rdf:Property ;
    rdfs:label 'Standard Hours Per Fte' ;
    rdfs:comment 'The number of hours per fiscal period that constitutes one FTE for this job family and employment type (e.g., 2080 hours annually, 173.33 hours monthly). Used as the FTE conversion denominator.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vacancyFte rdf:type rdf:Property ;
    rdfs:label 'Vacancy Fte' ;
    rdfs:comment 'The number of FTE positions that are budgeted but currently unfilled (budgeted_fte minus filled FTE). Supports vacancy rate reporting, recruitment planning, and agency/contract labor justification.' ;
    rdfs:domain ind:FteBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parentOrgUnitId rdf:type rdf:Property ;
    rdfs:label 'Parent Org Unit Id' ;
    rdfs:comment 'Reference to the immediate parent organizational unit in the workforce hierarchy, enabling recursive traversal of the org tree (e.g., a department rolls up to a division).' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgUnit .

ind:primaryOrgCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Primary Org Care Site Id' ;
    rdfs:comment 'Reference to the physical facility (hospital, clinic, outpatient center) with which this organizational unit is primarily associated. Links workforce org structure to the facility domain.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:accreditationProgram rdf:type rdf:Property ;
    rdfs:label 'Accreditation Program' ;
    rdfs:comment 'Name of the accreditation program or body applicable to this organizational unit (e.g., TJC, DNV, CARF). Supports compliance tracking and survey readiness reporting.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedHeadcount rdf:type rdf:Property ;
    rdfs:label 'Authorized Headcount' ;
    rdfs:comment 'The total number of approved positions (headcount) authorized for this organizational unit, regardless of FTE value. Distinct from budgeted FTE as it counts positions, not effort.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:companyCode rdf:type rdf:Property ;
    rdfs:label 'Company Code' ;
    rdfs:comment 'SAP S/4HANA company code representing the legal entity or subsidiary to which this organizational unit belongs. Required for multi-entity financial consolidation and intercompany reporting.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divisionName rdf:type rdf:Property ;
    rdfs:label 'Division Name' ;
    rdfs:comment 'Name of the division to which this organizational unit belongs within the enterprise workforce hierarchy. Supports divisional rollup reporting in Workday HCM.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyPath rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Path' ;
    rdfs:comment 'Delimited string representing the full ancestry path from the root org unit to this unit (e.g., Health System > Surgical Division > Cardiothoracic Department). Supports hierarchy-aware reporting without recursive queries.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSupervisoryOrg rdf:type rdf:Property ;
    rdfs:label 'Is Supervisory Org' ;
    rdfs:comment 'Indicates whether this org unit is designated as a Workday HCM supervisory organization, which governs worker assignments, position management, and approval chains.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orgUnitCode rdf:type rdf:Property ;
    rdfs:label 'Org Unit Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the organizational unit within the enterprise. Used in reporting, payroll, and HR system integrations (e.g., DEPT-CARDIO, DIV-SURG).' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orgUnitName rdf:type rdf:Property ;
    rdfs:label 'Org Unit Name' ;
    rdfs:comment 'Full human-readable name of the organizational unit as displayed in Workday HCM and workforce reporting (e.g., Cardiology Department, Surgical Services Division).' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orgUnitStatus rdf:type rdf:Property ;
    rdfs:label 'Org Unit Status' ;
    rdfs:comment 'Current lifecycle status of the organizational unit. Inactive or dissolved units are retained for historical reporting and audit purposes.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orgUnitType rdf:type rdf:Property ;
    rdfs:label 'Org Unit Type' ;
    rdfs:comment 'Classification of the organizational unit within the workforce hierarchy. Determines how the unit is used in headcount, budgeting, and reporting contexts. [ENUM-REF-CANDIDATE: department|division|service_line|cost_center|supervisory_org|team|program|section — promote to reference product if additional types are needed]' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subtype rdf:type rdf:Property ;
    rdfs:label 'Subtype' ;
    rdfs:comment 'Further classification within the org unit type, providing granular segmentation (e.g., Clinical, Administrative, Support, Research, Ancillary). Supports workforce analytics by care delivery category.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionAffiliation rdf:type rdf:Property ;
    rdfs:label 'Union Affiliation' ;
    rdfs:comment 'Name or code of the labor union or collective bargaining unit associated with this organizational unit, if applicable. Drives union-specific pay rules, scheduling constraints, and grievance tracking.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workdayIntegrationCode rdf:type rdf:Property ;
    rdfs:label 'Workday Integration Code' ;
    rdfs:comment 'External integration identifier used by Workday HCM for API-based data exchange with downstream systems such as payroll processors, benefits administrators, and scheduling platforms.' ;
    rdfs:domain ind:OrgUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workforceProviderNetworkParticipationId rdf:type rdf:Property ;
    rdfs:label 'Workforce Provider Network Participation Id' ;
    rdfs:comment 'Primary key for the provider_network_participation association' ;
    rdfs:domain ind:WorkforceProviderNetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:credentialingExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Credentialing Expiration Date' ;
    rdfs:comment 'The date on which the providers credentialing with this payer expires and must be renewed. Payers typically require re-credentialing every 2-3 years. Used for proactive renewal tracking.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:networkParticipationStatus rdf:type rdf:Property ;
    rdfs:label 'Network Participation Status' ;
    rdfs:comment 'Current status of the providers active participation in this payers network. Values: active, inactive, terminated, pending_activation. Distinct from credentialing_status which tracks approval; this tracks operational participation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerProviderNumber rdf:type rdf:Property ;
    rdfs:label 'Payer Provider Number' ;
    rdfs:comment 'The unique provider identifier assigned by this specific payer to this provider for claims submission. Distinct from NPI, this is the payers internal provider ID used in claim transactions and remittance advice.' ;
    rdfs:domain ind:WorkforceProviderNetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reimbursementRateSchedule rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Rate Schedule' ;
    rdfs:comment 'Identifier or code for the fee schedule or reimbursement rate table that applies to this provider-payer participation. Different providers may have different negotiated rates with the same payer based on contract terms.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalPrivilegeId rdf:type rdf:Property ;
    rdfs:label 'Clinical Privilege Id' ;
    rdfs:comment 'Unique surrogate identifier for each clinical privilege record. Primary key.' ;
    rdfs:domain ind:ClinicalPrivilege ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:competencyLevel rdf:type rdf:Property ;
    rdfs:label 'Competency Level' ;
    rdfs:comment 'Level of clinical competency and autonomy granted for this specific procedure. Unrestricted = full independent practice. Supervised = requires attending physician oversight. Proctored = requires observation by peer for quality assurance. Provisional = temporary privilege pending completion of competency assessment.' ;
    rdfs:domain ind:ClinicalPrivilege ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantingCommittee rdf:type rdf:Property ;
    rdfs:label 'Granting Committee' ;
    rdfs:comment 'Name of the medical staff committee or delegated authority that granted this privilege (e.g., Credentials Committee, Surgery Department, Emergency Medicine Section). Used for governance tracking and appeals process.' ;
    rdfs:domain ind:ClinicalPrivilege ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastProctoringDate rdf:type rdf:Property ;
    rdfs:label 'Last Proctoring Date' ;
    rdfs:comment 'Date of the most recent proctored case for this privilege. Used for competency assessment and progression from proctored to unrestricted status. Null if no proctoring has occurred or is not required.' ;
    rdfs:domain ind:ClinicalPrivilege ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proctoringCasesCompleted rdf:type rdf:Property ;
    rdfs:label 'Proctoring Cases Completed' ;
    rdfs:comment 'Number of proctored cases completed for this privilege. Used to track progress toward unrestricted privilege status. Null if proctoring is not required.' ;
    rdfs:domain ind:ClinicalPrivilege ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:proctoringCasesRequired rdf:type rdf:Property ;
    rdfs:label 'Proctoring Cases Required' ;
    rdfs:comment 'Total number of proctored cases required before privilege can be upgraded to unrestricted status. Set by credentialing committee based on procedure complexity and clinician experience. Null if proctoring is not required.' ;
    rdfs:domain ind:ClinicalPrivilege ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:restrictionNotes rdf:type rdf:Property ;
    rdfs:label 'Restriction Notes' ;
    rdfs:comment 'Free-text description of any specific restrictions, conditions, or limitations placed on this privilege by the credentialing committee. Examples: age restrictions, anatomical site restrictions, technology restrictions. Null if no restrictions apply.' ;
    rdfs:domain ind:ClinicalPrivilege ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supervisionRequired rdf:type rdf:Property ;
    rdfs:label 'Supervision Required' ;
    rdfs:comment 'Indicates whether this specific privilege requires direct supervision by an attending physician or senior clinician. True for residents, fellows, and clinicians with provisional or supervised competency levels. False for unrestricted privileges.' ;
    rdfs:domain ind:ClinicalPrivilege ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:volumeRequirement rdf:type rdf:Property ;
    rdfs:label 'Volume Requirement' ;
    rdfs:comment 'Minimum number of procedures the clinician must perform annually to maintain competency and privilege renewal eligibility. Used by medical staff services for ongoing professional practice evaluation (OPPE). Null if no volume requirement applies.' ;
    rdfs:domain ind:ClinicalPrivilege ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:channelSupportAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Channel Support Assignment Id' ;
    rdfs:comment 'Unique surrogate identifier for each support assignment record. Primary key for the association.' ;
    rdfs:domain ind:ChannelSupportAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationTier rdf:type rdf:Property ;
    rdfs:label 'Escalation Tier' ;
    rdfs:comment 'Numeric tier level (1-3) indicating the escalation hierarchy for incident management. Tier 1 is first responder, Tier 2 is technical specialist, Tier 3 is senior architect or vendor escalation.' ;
    rdfs:domain ind:ChannelSupportAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationPreference rdf:type rdf:Property ;
    rdfs:label 'Notification Preference' ;
    rdfs:comment 'The preferred communication channel for notifying this workforce member about incidents or alerts related to this interface channel. Used by incident management and alerting systems.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onCallRotation rdf:type rdf:Property ;
    rdfs:label 'On Call Rotation' ;
    rdfs:comment 'The on-call rotation schedule identifier or pattern assigned to this support assignment (e.g., Week 1-2, Weekday Primary, Weekend Backup). Used for workforce scheduling and incident routing.' ;
    rdfs:domain ind:ChannelSupportAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportRole rdf:type rdf:Property ;
    rdfs:label 'Support Role' ;
    rdfs:comment 'The tiered support role assigned to this workforce member for this specific interface channel. Primary indicates first-line support, Backup indicates secondary coverage, Escalation indicates senior technical escalation point, On-Call indicates rotation-based availability.' ;
    rdfs:domain ind:ChannelSupportAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionProcedureAuthorizationId rdf:type rdf:Property ;
    rdfs:label 'Position Procedure Authorization Id' ;
    rdfs:comment 'Unique surrogate identifier for this position-procedure authorization record. Primary key.' ;
    rdfs:domain ind:PositionProcedureAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authorizationLevel rdf:type rdf:Property ;
    rdfs:label 'Authorization Level' ;
    rdfs:comment 'Level of authorization granted to this position for performing this procedure. INDEPENDENT = can perform without supervision; SUPERVISED = requires attending oversight; ASSIST_ONLY = can assist but not perform as primary; RESTRICTED = special conditions apply.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competencyValidationFrequency rdf:type rdf:Property ;
    rdfs:label 'Competency Validation Frequency' ;
    rdfs:comment 'How often competency must be revalidated for this position-procedure authorization (e.g., ANNUAL, BIENNIAL, ONE_TIME). Drives credentialing and privileging cycles.' ;
    rdfs:domain ind:PositionProcedureAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingCommitteeApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Credentialing Committee Approval Date' ;
    rdfs:comment 'Date on which the medical staff credentialing committee approved this position-procedure authorization. Null if committee approval not required. Supports regulatory compliance and audit trails.' ;
    rdfs:domain ind:PositionProcedureAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumCasesRequired rdf:type rdf:Property ;
    rdfs:label 'Minimum Cases Required' ;
    rdfs:comment 'Minimum number of observed or supervised cases required before independent authorization is granted for this position-procedure combination. Null if not applicable. Used in fellowship and residency competency tracking.' ;
    rdfs:domain ind:PositionProcedureAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supervisionRequirement rdf:type rdf:Property ;
    rdfs:label 'Supervision Requirement' ;
    rdfs:comment 'Specific supervision requirements for this position when performing this procedure (e.g., Attending physician must be present, Indirect supervision acceptable, No supervision required). Drives scheduling and staffing rules.' ;
    rdfs:domain ind:PositionProcedureAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedDate rdf:type rdf:Property ;
    rdfs:label 'Updated Date' ;
    rdfs:comment 'Timestamp when this authorization record was last updated.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:volumeExpectation rdf:type rdf:Property ;
    rdfs:label 'Volume Expectation' ;
    rdfs:comment 'Expected annual or monthly volume of this procedure for this position type (e.g., 50-100 per year, Core competency - frequent, Rare - maintain competency only). Used for competency maintenance planning and workload forecasting.' ;
    rdfs:domain ind:PositionProcedureAuthorization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededBenefitPlanId rdf:type rdf:Property ;
    rdfs:label 'Superseded Benefit Plan Id' ;
    rdfs:comment 'Self-referencing FK on benefit_plan (superseded_benefit_plan_id)' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BenefitPlan .

ind:benefitPlanStatus rdf:type rdf:Property ;
    rdfs:label 'Benefit Plan Status' ;
    rdfs:comment 'Current lifecycle status of the benefit plan indicating availability for enrollment and administration.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Carrier Policy Number' ;
    rdfs:comment 'Unique policy or contract number assigned by the insurance carrier for this benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributionFrequency rdf:type rdf:Property ;
    rdfs:label 'Contribution Frequency' ;
    rdfs:comment 'Frequency at which employee and employer contributions are collected for this benefit plan.' ;
    rdfs:domain ind:BenefitPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copayEmergencyRoom rdf:type rdf:Property ;
    rdfs:label 'Copay Emergency Room' ;
