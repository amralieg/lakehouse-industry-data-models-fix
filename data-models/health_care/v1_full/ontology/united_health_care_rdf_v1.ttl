    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Min Premium Amount' ;
    rdfs:comment 'Minimum premium amount required for discount eligibility.' ;
    rdfs:domain ind:Discount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Max Premium Amount' ;
    rdfs:comment 'Maximum premium amount for which discount applies.' ;
    rdfs:domain ind:Discount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isStackable rdf:type rdf:Property ;
    rdfs:label 'Is Stackable' ;
    rdfs:comment 'Indicates whether the discount can be combined with other discounts.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stackableWith rdf:type rdf:Property ;
    rdfs:label 'Stackable With' ;
    rdfs:comment 'List of discount codes that can be stacked with this discount.' ;
    rdfs:domain ind:Discount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationMethod rdf:type rdf:Property ;
    rdfs:label 'Application Method' ;
    rdfs:comment 'Method by which discount is applied to the premium.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountingCode rdf:type rdf:Property ;
    rdfs:label 'Accounting Code' ;
    rdfs:comment 'General ledger accounting code associated with discount expense.' ;
    rdfs:domain ind:Discount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retroactiveAdjustmentDays rdf:type rdf:Property ;
    rdfs:label 'Retroactive Adjustment Days' ;
    rdfs:comment 'Number of days prior to effective date that retroactive discount can be applied.' ;
    rdfs:domain ind:Discount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lateFeeId rdf:type rdf:Property ;
    rdfs:label 'Late Fee Id' ;
    rdfs:comment 'System-generated unique identifier for the late fee record.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LateFee .

ind:feeType rdf:type rdf:Property ;
    rdfs:label 'Fee Type' ;
    rdfs:comment 'Category of the fee applied after the grace period.' ;
    rdfs:domain ind:LateFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeReasonCode rdf:type rdf:Property ;
    rdfs:label 'Fee Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for the late fee assessment.' ;
    rdfs:domain ind:LateFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeDescription rdf:type rdf:Property ;
    rdfs:label 'Fee Description' ;
    rdfs:comment 'Narrative description of the late fee.' ;
    rdfs:domain ind:LateFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxCurrency rdf:type rdf:Property ;
    rdfs:label 'Tax Currency' ;
    rdfs:comment 'Currency code for the tax amount.' ;
    rdfs:domain ind:LateFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCurrency rdf:type rdf:Property ;
    rdfs:label 'Total Currency' ;
    rdfs:comment 'Currency code for the total amount due.' ;
    rdfs:domain ind:LateFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overdueAmount rdf:type rdf:Property ;
    rdfs:label 'Overdue Amount' ;
    rdfs:comment 'Outstanding principal amount that triggered the late fee.' ;
    rdfs:domain ind:LateFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeAppliedDate rdf:type rdf:Property ;
    rdfs:label 'Fee Applied Date' ;
    rdfs:comment 'Date on which the late fee was applied to the account.' ;
    rdfs:domain ind:LateFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feePostedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Fee Posted Timestamp' ;
    rdfs:comment 'Exact timestamp when the late fee was posted to the ledger.' ;
    rdfs:domain ind:LateFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:feeStatus rdf:type rdf:Property ;
    rdfs:label 'Fee Status' ;
    rdfs:comment 'Current processing status of the late fee.' ;
    rdfs:domain ind:LateFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Applied Flag' ;
    rdfs:comment 'Indicates whether a waiver has been applied to the late fee.' ;
    rdfs:domain ind:LateFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverReason rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason' ;
    rdfs:comment 'Reason for waiving the late fee, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Payment Adjustment Id' ;
    rdfs:comment 'Unique identifier for the payment adjustment transaction resulting from fraud, waste, or abuse findings.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adjustmentDate rdf:type rdf:Property ;
    rdfs:label 'Adjustment Date' ;
    rdfs:comment 'Date when the payment adjustment was processed and recorded in the system.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjustmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Adjustment Timestamp' ;
    rdfs:comment 'Precise timestamp when the payment adjustment transaction was executed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:adjustmentType rdf:type rdf:Property ;
    rdfs:label 'Adjustment Type' ;
    rdfs:comment 'Classification of the payment adjustment action taken (e.g., recoupment, refund, offset, write-off).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudCaseId rdf:type rdf:Property ;
    rdfs:label 'Fraud Case Id' ;
    rdfs:comment 'Unique identifier of the FWA investigation case that resulted in this payment adjustment.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Case .

ind:recoveryStatus rdf:type rdf:Property ;
    rdfs:label 'Recovery Status' ;
    rdfs:comment 'Current status of the overpayment recovery process.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryStartDate rdf:type rdf:Property ;
    rdfs:label 'Recovery Start Date' ;
    rdfs:comment 'Date when the overpayment recovery process was initiated.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoveryCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Recovery Completion Date' ;
    rdfs:comment 'Date when the overpayment recovery was fully completed or closed.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amountRecovered rdf:type rdf:Property ;
    rdfs:label 'Amount Recovered' ;
    rdfs:comment 'Total monetary amount successfully recovered from the provider or member to date.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amountOutstanding rdf:type rdf:Property ;
    rdfs:label 'Amount Outstanding' ;
    rdfs:comment 'Remaining monetary amount still owed and not yet recovered.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditId rdf:type rdf:Property ;
    rdfs:label 'Audit Id' ;
    rdfs:comment 'Unique identifier of the provider audit or claims review that identified the payment discrepancy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Audit .

ind:investigationStartDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Start Date' ;
    rdfs:comment 'Date when the fraud, waste, or abuse investigation was initiated.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investigationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Completion Date' ;
    rdfs:comment 'Date when the fraud, waste, or abuse investigation was completed and findings were finalized.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lawEnforcementReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Referral Flag' ;
    rdfs:comment 'Indicates whether the fraud case was referred to law enforcement agencies for criminal prosecution.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeStatus rdf:type rdf:Property ;
    rdfs:label 'Dispute Status' ;
    rdfs:comment 'Current status of the dispute or appeal process for the payment adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overpaymentNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Overpayment Notification Date' ;
    rdfs:comment 'Date when the provider or member was formally notified of the overpayment and adjustment.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:repaymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Repayment Due Date' ;
    rdfs:comment 'Date by which the provider or member must repay the overpayment to avoid penalties.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Total Recovery Amount' ;
    rdfs:comment 'Total amount to be recovered including adjusted amount, interest, and penalties.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentIntegrityScore rdf:type rdf:Property ;
    rdfs:label 'Payment Integrity Score' ;
    rdfs:comment 'Risk score or confidence level assigned by payment integrity system indicating likelihood of fraud or error.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:detectionSystem rdf:type rdf:Property ;
    rdfs:label 'Detection System' ;
    rdfs:comment 'Name of the payment integrity or fraud detection system that identified the issue (e.g., Cotiviti, Optum, proprietary system).' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentSource rdf:type rdf:Property ;
    rdfs:label 'Adjustment Source' ;
    rdfs:comment 'Source or origin of the payment adjustment determination (internal audit, external audit, SIU investigation, CMS audit).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Adjustment Approval Date' ;
    rdfs:comment 'Date when the payment adjustment was approved by authorized personnel or management.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjustmentNotes rdf:type rdf:Property ;
    rdfs:label 'Adjustment Notes' ;
    rdfs:comment 'Free-text notes or comments providing additional context about the payment adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentationFlag rdf:type rdf:Property ;
    rdfs:label 'Supporting Documentation Flag' ;
    rdfs:comment 'Indicates whether supporting documentation (medical records, audit reports) is attached to the adjustment.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentationLocation rdf:type rdf:Property ;
    rdfs:label 'Documentation Location' ;
    rdfs:comment 'File path or document management system location where supporting documentation is stored.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsReportingDate rdf:type rdf:Property ;
    rdfs:label 'Cms Reporting Date' ;
    rdfs:comment 'Date when the payment adjustment was reported to CMS or other regulatory agencies.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateReportingFlag rdf:type rdf:Property ;
    rdfs:label 'State Reporting Flag' ;
    rdfs:comment 'Indicates whether this payment adjustment must be reported to state insurance departments or Medicaid agencies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerSanctionFlag rdf:type rdf:Property ;
    rdfs:label 'Provider Sanction Flag' ;
    rdfs:comment 'Indicates whether the provider was sanctioned or terminated from the network as a result of this fraud finding.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionType rdf:type rdf:Property ;
    rdfs:label 'Sanction Type' ;
    rdfs:comment 'Type of sanction or corrective action taken against the provider (warning, suspension, termination, exclusion).' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Sanction Effective Date' ;
    rdfs:comment 'Date when the provider sanction or corrective action became effective.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusionListFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusion List Flag' ;
    rdfs:comment 'Indicates whether the provider was added to federal or state exclusion lists (OIG LEIE, SAM.gov).' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adjustmentCheckNumber rdf:type rdf:Property ;
    rdfs:label 'Adjustment Check Number' ;
    rdfs:comment 'Check number or payment reference number for the adjustment transaction if processed as a separate payment.' ;
    rdfs:domain ind:PaymentAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gracePeriodId rdf:type rdf:Property ;
    rdfs:label 'Grace Period Id' ;
    rdfs:comment 'Unique identifier for the grace period configuration record.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GracePeriod .

ind:marketplaceDurationDays rdf:type rdf:Property ;
    rdfs:label 'Marketplace Duration Days' ;
    rdfs:comment 'Specific grace period duration for Qualified Health Plans (QHP) sold through federally facilitated or state-based marketplaces, typically 90 days per ACA requirements for members receiving advance premium tax credits.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appliesToNewEnrollments rdf:type rdf:Property ;
    rdfs:label 'Applies To New Enrollments' ;
    rdfs:comment 'Indicates whether this grace period applies to newly enrolled members or only to existing members with established payment history.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToRenewals rdf:type rdf:Property ;
    rdfs:label 'Applies To Renewals' ;
    rdfs:comment 'Indicates whether this grace period applies to policy renewals or only to initial enrollment periods.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageContinuesDuringGrace rdf:type rdf:Property ;
    rdfs:label 'Coverage Continues During Grace' ;
    rdfs:comment 'Indicates whether health coverage remains active and claims are paid during the grace period, or if coverage is suspended pending payment.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimsPendedDuringGrace rdf:type rdf:Property ;
    rdfs:label 'Claims Pended During Grace' ;
    rdfs:comment 'Indicates whether claims incurred during the grace period are pended (held) pending premium payment resolution, or processed normally.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retroactiveTerminationAllowed rdf:type rdf:Property ;
    rdfs:label 'Retroactive Termination Allowed' ;
    rdfs:comment 'Indicates whether coverage can be retroactively terminated to the end of the last paid period if premium is not received by the end of the grace period.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationTimingDays rdf:type rdf:Property ;
    rdfs:label 'Notification Timing Days' ;
    rdfs:comment 'Number of days before or after the grace period begins that the member must be notified of their grace period status.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinstatementAllowed rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Allowed' ;
    rdfs:comment 'Indicates whether a member whose coverage was terminated due to non-payment can have their coverage reinstated if they pay outstanding premiums within a specified timeframe.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Period Days' ;
    rdfs:comment 'Number of days after termination during which a member can reinstate coverage by paying outstanding premiums and any applicable fees.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumPaymentRequired rdf:type rdf:Property ;
    rdfs:label 'Minimum Payment Required' ;
    rdfs:comment 'Minimum payment amount that must be received during the grace period to avoid termination, which may be less than the full premium due.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:partialPaymentAccepted rdf:type rdf:Property ;
    rdfs:label 'Partial Payment Accepted' ;
    rdfs:comment 'Indicates whether partial premium payments are accepted during the grace period to extend coverage or prevent termination.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentPlanEligible rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Eligible' ;
    rdfs:comment 'Indicates whether members in grace period status are eligible to establish a payment plan to bring their account current.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aptcRecipientFlag rdf:type rdf:Property ;
    rdfs:label 'Aptc Recipient Flag' ;
    rdfs:comment 'Indicates whether this grace period configuration applies specifically to members receiving Advance Premium Tax Credits through the health insurance marketplace, who are subject to special 90-day grace period rules.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aptcLiabilityMonth1 rdf:type rdf:Property ;
    rdfs:label 'Aptc Liability Month 1' ;
    rdfs:comment 'For marketplace plans with APTC, indicates whether the insurer is liable for claims incurred during the first month of the 90-day grace period.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aptcLiabilityMonth23 rdf:type rdf:Property ;
    rdfs:label 'Aptc Liability Month 2 3' ;
    rdfs:comment 'For marketplace plans with APTC, indicates whether the insurer is liable for claims incurred during the second and third months of the 90-day grace period, or if providers are responsible for collection.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoTerminationEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Termination Enabled' ;
    rdfs:comment 'Indicates whether coverage is automatically terminated by the system at the end of the grace period if payment is not received, or if manual review is required.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:extensionMaxDays rdf:type rdf:Property ;
    rdfs:label 'Extension Max Days' ;
    rdfs:comment 'Maximum number of additional days that the grace period can be extended under approved circumstances.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hardshipExemptionEligible rdf:type rdf:Property ;
    rdfs:label 'Hardship Exemption Eligible' ;
    rdfs:comment 'Indicates whether members in this plan type are eligible for hardship exemptions that may affect grace period terms or termination procedures.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialEnrollmentPeriodImpact rdf:type rdf:Property ;
    rdfs:label 'Special Enrollment Period Impact' ;
    rdfs:comment 'Indicates whether grace period rules are modified for members who enrolled during a Special Enrollment Period rather than open enrollment.' ;
    rdfs:domain ind:GracePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lawEnforcementReferralId rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Referral Id' ;
    rdfs:comment 'Unique identifier for the law enforcement referral record. Primary key for the law enforcement referral entity.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agencyName rdf:type rdf:Property ;
    rdfs:label 'Agency Name' ;
    rdfs:comment 'Full legal name of the law enforcement agency receiving the referral (e.g., Federal Bureau of Investigation, State Attorney General Office, Local Police Department).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyType rdf:type rdf:Property ;
    rdfs:label 'Agency Type' ;
    rdfs:comment 'Classification of the law enforcement agency by jurisdictional level.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Agency Jurisdiction' ;
    rdfs:comment 'Geographic or functional jurisdiction of the law enforcement agency (e.g., state name, federal nationwide, county name).' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyContactName rdf:type rdf:Property ;
    rdfs:label 'Agency Contact Name' ;
    rdfs:comment 'Name of the primary contact person at the law enforcement agency handling this referral.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyContactTitle rdf:type rdf:Property ;
    rdfs:label 'Agency Contact Title' ;
    rdfs:comment 'Job title or role of the primary contact person at the law enforcement agency (e.g., Special Agent, Detective, Assistant District Attorney).' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyContactPhone rdf:type rdf:Property ;
    rdfs:label 'Agency Contact Phone' ;
    rdfs:comment 'Primary phone number for the law enforcement agency contact person.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyContactEmail rdf:type rdf:Property ;
    rdfs:label 'Agency Contact Email' ;
    rdfs:comment 'Primary email address for the law enforcement agency contact person.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agencyCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Agency Case Number' ;
    rdfs:comment 'Case number or reference identifier assigned by the law enforcement agency upon acceptance of the referral.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralDescription rdf:type rdf:Property ;
    rdfs:label 'Referral Description' ;
    rdfs:comment 'Detailed narrative description of the fraud case, allegations, evidence summary, and rationale for law enforcement referral.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedClaimCount rdf:type rdf:Property ;
    rdfs:label 'Affected Claim Count' ;
    rdfs:comment 'Number of claims identified as fraudulent or suspicious in the investigation.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:suspectedProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Suspected Provider Npi' ;
    rdfs:comment 'National Provider Identifier (NPI) of the healthcare provider suspected of fraudulent activity.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspectedProviderName rdf:type rdf:Property ;
    rdfs:label 'Suspected Provider Name' ;
    rdfs:comment 'Legal name of the healthcare provider or entity suspected of fraudulent activity.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspectedProviderTin rdf:type rdf:Property ;
    rdfs:label 'Suspected Provider Tin' ;
    rdfs:comment 'Tax Identification Number (TIN) of the healthcare provider or entity suspected of fraudulent activity.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspectedMemberName rdf:type rdf:Property ;
    rdfs:label 'Suspected Member Name' ;
    rdfs:comment 'Full name of the health plan member suspected of fraudulent activity (if member fraud case).' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralMethod rdf:type rdf:Property ;
    rdfs:label 'Referral Method' ;
    rdfs:comment 'Method used to submit the referral to the law enforcement agency.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidencePackageIncluded rdf:type rdf:Property ;
    rdfs:label 'Evidence Package Included' ;
    rdfs:comment 'Indicates whether a formal evidence package (documents, data extracts, audit reports) was included with the referral submission.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evidenceDescription rdf:type rdf:Property ;
    rdfs:label 'Evidence Description' ;
    rdfs:comment 'Summary description of the evidence provided to law enforcement, including types of documents, data files, witness statements, and audit findings.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subpoenaReceived rdf:type rdf:Property ;
    rdfs:label 'Subpoena Received' ;
    rdfs:comment 'Indicates whether a subpoena or formal legal request for additional information was received from the law enforcement agency.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subpoenaDate rdf:type rdf:Property ;
    rdfs:label 'Subpoena Date' ;
    rdfs:comment 'Date when a subpoena or formal legal request was received from the law enforcement agency.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subpoenaResponseDate rdf:type rdf:Property ;
    rdfs:label 'Subpoena Response Date' ;
    rdfs:comment 'Date when the organization responded to the subpoena or legal request with requested information.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:prosecutionInitiated rdf:type rdf:Property ;
    rdfs:label 'Prosecution Initiated' ;
    rdfs:comment 'Indicates whether formal criminal or civil prosecution was initiated by the law enforcement agency based on this referral.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prosecutionDate rdf:type rdf:Property ;
    rdfs:label 'Prosecution Date' ;
    rdfs:comment 'Date when formal prosecution (criminal charges filed or civil lawsuit initiated) was commenced.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:caseOutcome rdf:type rdf:Property ;
    rdfs:label 'Case Outcome' ;
    rdfs:comment 'Final outcome of the law enforcement case if prosecution was initiated.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseOutcomeDate rdf:type rdf:Property ;
    rdfs:label 'Case Outcome Date' ;
    rdfs:comment 'Date when the final case outcome was determined (verdict date, settlement date, dismissal date).' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:restitutionAmount rdf:type rdf:Property ;
    rdfs:label 'Restitution Amount' ;
    rdfs:comment 'Court-ordered restitution amount to be paid to the organization by the perpetrator, expressed in US dollars.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referredByName rdf:type rdf:Property ;
    rdfs:label 'Referred By Name' ;
    rdfs:comment 'Name of the Special Investigations Unit (SIU) investigator or compliance officer who submitted the referral.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referredByTitle rdf:type rdf:Property ;
    rdfs:label 'Referred By Title' ;
    rdfs:comment 'Job title of the person who submitted the referral (e.g., Senior SIU Investigator, Compliance Manager, Fraud Analyst).' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referredByDepartment rdf:type rdf:Property ;
    rdfs:label 'Referred By Department' ;
    rdfs:comment 'Department or business unit that submitted the referral (e.g., Special Investigations Unit, Compliance, Payment Integrity).' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaAttention rdf:type rdf:Property ;
    rdfs:label 'Media Attention' ;
    rdfs:comment 'Indicates whether the case received public media attention or press coverage.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relatedCivilAction rdf:type rdf:Property ;
    rdfs:label 'Related Civil Action' ;
    rdfs:comment 'Indicates whether a related civil lawsuit or administrative action was filed by the organization in parallel with the law enforcement referral.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:civilCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Civil Case Number' ;
    rdfs:comment 'Court case number for any related civil lawsuit filed by the organization.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerExclusionRecommended rdf:type rdf:Property ;
    rdfs:label 'Provider Exclusion Recommended' ;
    rdfs:comment 'Indicates whether the referral included a recommendation to exclude the provider from federal healthcare programs (Medicare/Medicaid).' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerExclusionDate rdf:type rdf:Property ;
    rdfs:label 'Provider Exclusion Date' ;
    rdfs:comment 'Date when the provider was officially excluded from federal healthcare programs by the Office of Inspector General (OIG) or state Medicaid agency.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cmsReported rdf:type rdf:Property ;
    rdfs:label 'Cms Reported' ;
    rdfs:comment 'Indicates whether the case was reported to the Centers for Medicare and Medicaid Services (CMS) as required for Medicare Advantage or Part D fraud cases.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateInsuranceDepartmentNotified rdf:type rdf:Property ;
    rdfs:label 'State Insurance Department Notified' ;
    rdfs:comment 'Indicates whether the state insurance department or regulatory authority was notified of the fraud case.' ;
    rdfs:domain ind:LawEnforcementReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateNotificationDate rdf:type rdf:Property ;
    rdfs:label 'State Notification Date' ;
    rdfs:comment 'Date when the state insurance department or regulatory authority was notified.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextFollowUpDate rdf:type rdf:Property ;
    rdfs:label 'Next Follow Up Date' ;
    rdfs:comment 'Scheduled date for the next follow-up action or status check with the law enforcement agency.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closureDate rdf:type rdf:Property ;
    rdfs:label 'Closure Date' ;
    rdfs:comment 'Date when the law enforcement referral was officially closed in the organization\'s case management system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fraudRuleId rdf:type rdf:Property ;
    rdfs:label 'Fraud Rule Id' ;
    rdfs:comment 'Unique identifier for the fraud detection rule within the Special Investigations Unit (SIU) system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FraudRule .

ind:thresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Threshold Unit' ;
    rdfs:comment 'The unit of measurement for the threshold value (e.g., dollars, percentage, count of occurrences).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Threshold Period Days' ;
    rdfs:comment 'The time window in days over which the threshold is evaluated for rule triggering.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicableProviderTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Provider Types' ;
    rdfs:comment 'Comma-separated list of provider specialty types or categories subject to this fraud detection rule.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cptCodeFilter rdf:type rdf:Property ;
    rdfs:label 'Cpt Code Filter' ;
    rdfs:comment 'Comma-separated list or range of CPT codes that this rule monitors for fraud detection purposes.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icd10CodeFilter rdf:type rdf:Property ;
    rdfs:label 'Icd10 Code Filter' ;
    rdfs:comment 'Comma-separated list or range of ICD-10 diagnosis codes that this rule monitors for fraud detection.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgCodeFilter rdf:type rdf:Property ;
    rdfs:label 'Drg Code Filter' ;
    rdfs:comment 'Comma-separated list of DRG codes that this rule monitors for potential upcoding or billing fraud.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndcCodeFilter rdf:type rdf:Property ;
    rdfs:label 'Ndc Code Filter' ;
    rdfs:comment 'Comma-separated list of NDC codes for pharmaceutical products that this rule monitors for pharmacy fraud.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Referral Flag' ;
    rdfs:comment 'Indicates whether violations of this rule automatically generate a referral to the Special Investigations Unit (SIU) for investigation.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoSuspendPaymentFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Suspend Payment Flag' ;
    rdfs:comment 'Indicates whether this rule automatically suspends payment on claims that trigger the fraud detection criteria.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresManualReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Requires Manual Review Flag' ;
    rdfs:comment 'Indicates whether rule violations require manual review by fraud analysts before action is taken.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ownerContactName rdf:type rdf:Property ;
    rdfs:label 'Owner Contact Name' ;
    rdfs:comment 'Name of the individual or role responsible for this fraud detection rule within the organization.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionFrequency rdf:type rdf:Property ;
    rdfs:label 'Execution Frequency' ;
    rdfs:comment 'The frequency at which this fraud detection rule is executed against claims or payment data.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumSampleSize rdf:type rdf:Property ;
    rdfs:label 'Minimum Sample Size' ;
    rdfs:comment 'The minimum number of claims or transactions required before the rule logic is applied, ensuring statistical validity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peerComparisonFlag rdf:type rdf:Property ;
    rdfs:label 'Peer Comparison Flag' ;
    rdfs:comment 'Indicates whether this rule uses peer comparison methodology to identify outlier provider behavior.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerGroupDefinition rdf:type rdf:Property ;
    rdfs:label 'Peer Group Definition' ;
    rdfs:comment 'Description of how peer groups are defined for comparison purposes (e.g., by specialty, geography, practice size).' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statisticalMethod rdf:type rdf:Property ;
    rdfs:label 'Statistical Method' ;
    rdfs:comment 'The statistical technique used by the rule to identify anomalies or outliers in claims data.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceThreshold rdf:type rdf:Property ;
    rdfs:label 'Confidence Threshold' ;
    rdfs:comment 'The minimum confidence level required for the rule to trigger an alert, expressed as a decimal (e.g., 0.9500 for 95%).' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastTunedDate rdf:type rdf:Property ;
    rdfs:label 'Last Tuned Date' ;
    rdfs:comment 'The date when the rule parameters or thresholds were last calibrated or optimized based on performance data.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lawEnforcementReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Reportable Flag' ;
    rdfs:comment 'Indicates whether violations of this rule may require reporting to law enforcement agencies or regulatory bodies.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overpaymentRecoveryFlag rdf:type rdf:Property ;
    rdfs:label 'Overpayment Recovery Flag' ;
    rdfs:comment 'Indicates whether this rule is used to identify and recover overpayments from providers or members.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerEducationFlag rdf:type rdf:Property ;
    rdfs:label 'Provider Education Flag' ;
    rdfs:comment 'Indicates whether rule violations trigger provider education or corrective action plans rather than punitive measures.' ;
    rdfs:domain ind:FraudRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:siuAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Siu Assignment Id' ;
    rdfs:comment 'Unique identifier for the SIU assignment record.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SiuAssignment .

ind:analystId rdf:type rdf:Property ;
    rdfs:label 'Analyst Id' ;
    rdfs:comment 'Identifier of the SIU analyst handling the case.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Analyst .

ind:analystName rdf:type rdf:Property ;
    rdfs:label 'Analyst Name' ;
    rdfs:comment 'Full name of the analyst.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analystRole rdf:type rdf:Property ;
    rdfs:label 'Analyst Role' ;
    rdfs:comment 'Job role of the analyst (e.g., Investigator, Senior Investigator).' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamName rdf:type rdf:Property ;
    rdfs:label 'Team Name' ;
    rdfs:comment 'Name of the SIU team.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pendingRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Pending Recovery Amount' ;
    rdfs:comment 'Amount pending recovery.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referralLawEnforcementFlag rdf:type rdf:Property ;
    rdfs:label 'Referral Law Enforcement Flag' ;
    rdfs:comment 'Indicates if case was referred to law enforcement.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evidenceAttachedFlag rdf:type rdf:Property ;
    rdfs:label 'Evidence Attached Flag' ;
    rdfs:comment 'Indicates whether supporting evidence is attached to the case.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evidenceCount rdf:type rdf:Property ;
    rdfs:label 'Evidence Count' ;
    rdfs:comment 'Number of evidence items attached.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditFindingDescription rdf:type rdf:Property ;
    rdfs:label 'Audit Finding Description' ;
    rdfs:comment 'Findings from the audit.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditResolution rdf:type rdf:Property ;
    rdfs:label 'Audit Resolution' ;
    rdfs:comment 'Resolution actions taken from audit findings.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDuplicate rdf:type rdf:Property ;
    rdfs:label 'Is Duplicate' ;
    rdfs:comment 'Indicates if the case is a duplicate of another case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:duplicateOfCaseId rdf:type rdf:Property ;
    rdfs:label 'Duplicate Of Case Id' ;
    rdfs:comment 'Identifier of the original case if this is a duplicate.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Case .

ind:alertId rdf:type rdf:Property ;
    rdfs:label 'Alert Id' ;
    rdfs:comment 'Identifier of the alert that triggered the case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Alert .

ind:alertSource rdf:type rdf:Property ;
    rdfs:label 'Alert Source' ;
    rdfs:comment 'Source system of the alert.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertTimestamp rdf:type rdf:Property ;
    rdfs:label 'Alert Timestamp' ;
    rdfs:comment 'Timestamp when the alert was generated.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recoveryAction rdf:type rdf:Property ;
    rdfs:label 'Recovery Action' ;
    rdfs:comment 'Action taken to recover funds (e.g., recoup, settlement).' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryType rdf:type rdf:Property ;
    rdfs:label 'Recovery Type' ;
    rdfs:comment 'Type of recovery.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Reporting Flag' ;
    rdfs:comment 'Indicates if the case requires regulatory reporting.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Date' ;
    rdfs:comment 'Date the case was reported to regulator.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingStatus rdf:type rdf:Property ;
    rdfs:label 'Reporting Status' ;
    rdfs:comment 'Regulatory reporting status.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseOrigin rdf:type rdf:Property ;
    rdfs:label 'Case Origin' ;
    rdfs:comment 'Origin of the case.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseCategory rdf:type rdf:Property ;
    rdfs:label 'Case Category' ;
    rdfs:comment 'High-level category of the case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseSubcategory rdf:type rdf:Property ;
    rdfs:label 'Case Subcategory' ;
    rdfs:comment 'More specific subcategory within the case category.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseOpenTimestamp rdf:type rdf:Property ;
    rdfs:label 'Case Open Timestamp' ;
    rdfs:comment 'Timestamp when case was opened.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:caseCloseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Case Close Timestamp' ;
    rdfs:comment 'Timestamp when case was closed.' ;
    rdfs:domain ind:SiuAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:discountApplicationId rdf:type rdf:Property ;
    rdfs:label 'Discount Application Id' ;
    rdfs:comment 'Unique identifier for the discount application record. Primary key for the discount application entity.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DiscountApplication .

ind:premiumCalculationId rdf:type rdf:Property ;
    rdfs:label 'Premium Calculation Id' ;
    rdfs:comment 'Reference to the premium calculation to which this discount is applied. Links discount to the specific premium computation instance.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumCalculation .

ind:groupPolicyId rdf:type rdf:Property ;
    rdfs:label 'Group Policy Id' ;
    rdfs:comment 'Reference to the group policy associated with this discount application. Identifies the employer or group receiving the discount.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:discountTypeCode rdf:type rdf:Property ;
    rdfs:label 'Discount Type Code' ;
    rdfs:comment 'Code representing the category or type of discount being applied. Classifies the discount by its business purpose and eligibility criteria.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Discount Reason Description' ;
    rdfs:comment 'Detailed textual description of the reason for applying the discount. Provides human-readable explanation for business users and members.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Discounted Premium Amount' ;
    rdfs:comment 'The final premium amount after the discount has been applied. Represents the actual amount billed to the customer.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Approval Required Flag' ;
    rdfs:comment 'Indicates whether the discount requires managerial or system approval before being applied. Used for governance and control purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:applicationDate rdf:type rdf:Property ;
    rdfs:label 'Application Date' ;
    rdfs:comment 'The date on which the discount was applied to the premium calculation or invoice. Records when the discount transaction occurred.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Application Timestamp' ;
    rdfs:comment 'The precise date and time when the discount was applied to the premium calculation or invoice. Provides detailed temporal audit trail.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:promoCode rdf:type rdf:Property ;
    rdfs:label 'Promo Code' ;
    rdfs:comment 'The promotional or coupon code entered by the member or group to trigger the discount. Used for marketing campaign tracking.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:campaignId rdf:type rdf:Property ;
    rdfs:label 'Campaign Id' ;
    rdfs:comment 'Identifier of the marketing campaign associated with this discount. Links discount to promotional initiatives for ROI analysis.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Campaign .

ind:campaignName rdf:type rdf:Property ;
    rdfs:label 'Campaign Name' ;
    rdfs:comment 'Name of the marketing campaign associated with this discount. Provides human-readable campaign reference.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountTier rdf:type rdf:Property ;
    rdfs:label 'Discount Tier' ;
    rdfs:comment 'Tiered level of the discount based on volume, loyalty, or other criteria. Used for graduated discount structures.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verified Flag' ;
    rdfs:comment 'Indicates whether the eligibility criteria for the discount have been verified. Used for compliance and audit purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eligibilityVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verification Date' ;
    rdfs:comment 'Date on which the eligibility for the discount was verified. Provides audit trail for compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maxDiscountAmount rdf:type rdf:Property ;
    rdfs:label 'Max Discount Amount' ;
    rdfs:comment 'The maximum monetary value that can be applied as a discount. Used to cap discount amounts based on business rules.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minDiscountAmount rdf:type rdf:Property ;
    rdfs:label 'Min Discount Amount' ;
    rdfs:comment 'The minimum monetary value that must be applied as a discount. Used to enforce minimum discount thresholds.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountCapAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Discount Cap Applied Flag' ;
    rdfs:comment 'Indicates whether the discount amount was capped at the maximum allowed value. Used for reporting and analysis of discount limitations.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurringFlag rdf:type rdf:Property ;
    rdfs:label 'Recurring Flag' ;
    rdfs:comment 'Indicates whether the discount is recurring across multiple billing periods or is a one-time application. Used for ongoing discount management.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurrenceFrequency rdf:type rdf:Property ;
    rdfs:label 'Recurrence Frequency' ;
    rdfs:comment 'Frequency at which the discount recurs if it is a recurring discount. Defines the periodicity of discount application.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemTransactionId rdf:type rdf:Property ;
    rdfs:label 'Source System Transaction Id' ;
    rdfs:comment 'Unique transaction identifier from the source system. Enables traceability back to the originating system record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Transaction .

ind:taxTreatmentCode rdf:type rdf:Property ;
    rdfs:label 'Tax Treatment Code' ;
    rdfs:comment 'Code indicating the tax treatment of the discount. Defines whether the discount affects taxable premium amounts.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Commission Impact Flag' ;
    rdfs:comment 'Indicates whether the discount affects agent or broker commission calculations. Used for commission processing.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acaReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Aca Reportable Flag' ;
    rdfs:comment 'Indicates whether the discount must be reported for ACA compliance purposes. Used for regulatory reporting.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliedByUserId rdf:type rdf:Property ;
    rdfs:label 'Applied By User Id' ;
    rdfs:comment 'Identifier of the user who applied the discount. Provides audit trail for manual discount applications.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:appliedByUserName rdf:type rdf:Property ;
    rdfs:label 'Applied By User Name' ;
    rdfs:comment 'Full name of the user who applied the discount. Human-readable identifier for audit and reporting purposes.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversedDiscountApplicationId rdf:type rdf:Property ;
    rdfs:label 'Reversed Discount Application Id' ;
    rdfs:comment 'Reference to the original discount application record that is being reversed by this record. Creates audit trail for reversals.' ;
    rdfs:domain ind:DiscountApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Application .

ind:reversalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reversal Timestamp' ;
    rdfs:comment 'Date and time when the discount application was reversed. Provides temporal audit trail for reversal transactions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:statusEffectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Status Effective Timestamp' ;
    rdfs:comment 'Date and time when the current status became effective. Tracks status change history.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:claimReviewId rdf:type rdf:Property ;
    rdfs:label 'Claim Review Id' ;
    rdfs:comment 'Unique identifier for the claim review record. Primary key for the claim review entity.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewOutcome rdf:type rdf:Property ;
    rdfs:label 'Review Outcome' ;
    rdfs:comment 'Final disposition or finding of the claim review after investigation is completed.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wasteIndicator rdf:type rdf:Property ;
    rdfs:label 'Waste Indicator' ;
    rdfs:comment 'Flag indicating whether wasteful practices (overutilization, unnecessary services) were identified during the review.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:abuseIndicator rdf:type rdf:Property ;
    rdfs:label 'Abuse Indicator' ;
    rdfs:comment 'Flag indicating whether abusive billing practices were identified during the review.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:detectionDate rdf:type rdf:Property ;
    rdfs:label 'Detection Date' ;
    rdfs:comment 'Date when the claim was initially flagged or identified for potential fraud, waste, or abuse review.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewStartDate rdf:type rdf:Property ;
    rdfs:label 'Review Start Date' ;
    rdfs:comment 'Date when the formal review or investigation of the claim was initiated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewEndDate rdf:type rdf:Property ;
    rdfs:label 'Review End Date' ;
    rdfs:comment 'Date when the claim review was completed or closed.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewDurationDays rdf:type rdf:Property ;
    rdfs:label 'Review Duration Days' ;
    rdfs:comment 'Total number of calendar days from review start to review completion.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewerId rdf:type rdf:Property ;
    rdfs:label 'Reviewer Id' ;
    rdfs:comment 'Unique identifier of the Special Investigations Unit (SIU) analyst or investigator assigned to review the claim.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Reviewer .

ind:claimAmountBilled rdf:type rdf:Property ;
    rdfs:label 'Claim Amount Billed' ;
    rdfs:comment 'Total amount billed by the provider on the claim under review.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimAmountAllowed rdf:type rdf:Property ;
    rdfs:label 'Claim Amount Allowed' ;
    rdfs:comment 'Total allowed amount determined by the health plan for the claim under review, based on contracted rates.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimAmountPaid rdf:type rdf:Property ;
    rdfs:label 'Claim Amount Paid' ;
    rdfs:comment 'Total amount paid by the health plan to the provider for the claim under review.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewFindings rdf:type rdf:Property ;
    rdfs:label 'Review Findings' ;
    rdfs:comment 'Detailed narrative description of the findings from the claim review investigation, including evidence and rationale.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewNotes rdf:type rdf:Property ;
    rdfs:label 'Review Notes' ;
    rdfs:comment 'Additional notes or comments recorded by the reviewer during the investigation process.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralSource rdf:type rdf:Property ;
    rdfs:label 'Referral Source' ;
    rdfs:comment 'Source from which the claim review case was referred or originated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lawEnforcementReferralIndicator rdf:type rdf:Property ;
    rdfs:label 'Law Enforcement Referral Indicator' ;
    rdfs:comment 'Flag indicating whether the case was referred to law enforcement agencies for criminal investigation.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReportingDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Date' ;
    rdfs:comment 'Date when the case was reported to regulatory agencies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:providerSanctionIndicator rdf:type rdf:Property ;
    rdfs:label 'Provider Sanction Indicator' ;
    rdfs:comment 'Flag indicating whether sanctions or corrective actions were imposed on the provider as a result of the review findings.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerSanctionType rdf:type rdf:Property ;
    rdfs:label 'Provider Sanction Type' ;
    rdfs:comment 'Type of sanction or corrective action imposed on the provider following the fraud review.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costAvoidanceAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Avoidance Amount' ;
    rdfs:comment 'Amount of future costs avoided by identifying and preventing fraudulent or abusive billing patterns.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investigationHours rdf:type rdf:Property ;
    rdfs:label 'Investigation Hours' ;
    rdfs:comment 'Total number of hours spent by investigators and analysts on the claim review case.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:caseComplexity rdf:type rdf:Property ;
    rdfs:label 'Case Complexity' ;
    rdfs:comment 'Complexity level of the fraud investigation case based on factors such as evidence volume, number of parties involved, and legal considerations.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedCaseCount rdf:type rdf:Property ;
    rdfs:label 'Related Case Count' ;
    rdfs:comment 'Number of related or linked fraud investigation cases involving the same provider, member, or billing pattern.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:patternIndicator rdf:type rdf:Property ;
    rdfs:label 'Pattern Indicator' ;
    rdfs:comment 'Flag indicating whether the claim is part of a broader pattern of fraudulent or abusive billing behavior.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:patternDescription rdf:type rdf:Property ;
    rdfs:label 'Pattern Description' ;
    rdfs:comment 'Description of the identified billing pattern or scheme associated with the claim review.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewClosedBy rdf:type rdf:Property ;
    rdfs:label 'Review Closed By' ;
    rdfs:comment 'Name or identifier of the individual who officially closed the claim review case.' ;
    rdfs:domain ind:ClaimReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleViolationId rdf:type rdf:Property ;
    rdfs:label 'Rule Violation Id' ;
    rdfs:comment 'Unique identifier for each rule violation record that triggered a fraud alert.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RuleViolation .

ind:violationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Violation Timestamp' ;
    rdfs:comment 'Date and time when the rule violation was detected by the fraud detection system.' ;
    rdfs:domain ind:RuleViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:violationDate rdf:type rdf:Property ;
    rdfs:label 'Violation Date' ;
    rdfs:comment 'Date when the rule violation was detected, used for daily reporting and aggregation.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:violationStatus rdf:type rdf:Property ;
    rdfs:label 'Violation Status' ;
    rdfs:comment 'Current status of the rule violation in the investigation workflow.' ;
    rdfs:domain ind:RuleViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationDescription rdf:type rdf:Property ;
    rdfs:label 'Violation Description' ;
    rdfs:comment 'Detailed description of the rule violation including specific conditions that were breached.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationAmount rdf:type rdf:Property ;
    rdfs:label 'Violation Amount' ;
    rdfs:comment 'Monetary amount associated with the rule violation, representing potential overpayment or fraudulent charge.' ;
    rdfs:domain ind:RuleViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variancePercentage rdf:type rdf:Property ;
    rdfs:label 'Variance Percentage' ;
    rdfs:comment 'Percentage variance between actual value and threshold value.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diagnosisCodeType rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Code Type' ;
    rdfs:comment 'Type of diagnosis code used (ICD-10-CM, ICD-9-CM).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifierCode rdf:type rdf:Property ;
    rdfs:label 'Modifier Code' ;
    rdfs:comment 'CPT or HCPCS modifier code that may have contributed to the rule violation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceScore rdf:type rdf:Property ;
    rdfs:label 'Confidence Score' ;
    rdfs:comment 'Confidence score (0-100) indicating the likelihood that the violation represents actual fraud.' ;
    rdfs:domain ind:RuleViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:falsePositiveFlag rdf:type rdf:Property ;
    rdfs:label 'False Positive Flag' ;
    rdfs:comment 'Indicates whether the rule violation was determined to be a false positive after review.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:validatedFraudFlag rdf:type rdf:Property ;
    rdfs:label 'Validated Fraud Flag' ;
    rdfs:comment 'Indicates whether the rule violation was confirmed as actual fraud after investigation.' ;
    rdfs:domain ind:RuleViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investigatorId rdf:type rdf:Property ;
    rdfs:label 'Investigator Id' ;
    rdfs:comment 'Identifier of the SIU investigator assigned to review the rule violation.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investigator .

ind:resolutionCode rdf:type rdf:Property ;
    rdfs:label 'Resolution Code' ;
    rdfs:comment 'Code indicating the outcome of the rule violation investigation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralFlag rdf:type rdf:Property ;
    rdfs:label 'Referral Flag' ;
    rdfs:comment 'Indicates whether the rule violation was referred to law enforcement or regulatory agencies.' ;
    rdfs:domain ind:RuleViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referralAgency rdf:type rdf:Property ;
    rdfs:label 'Referral Agency' ;
    rdfs:comment 'Name of the law enforcement or regulatory agency to which the violation was referred.' ;
    rdfs:domain ind:Fraud ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateClaimFlag rdf:type rdf:Property ;
    rdfs:label 'Duplicate Claim Flag' ;
    rdfs:comment 'Indicates whether the rule violation was triggered by a duplicate claim submission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:duplicateClaimId rdf:type rdf:Property ;
    rdfs:label 'Duplicate Claim Id' ;
    rdfs:comment 'Identifier of the original claim that this claim duplicates, if applicable.' ;
    rdfs:domain ind:RuleViolation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claim .

ind:authorizationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Authorization Required Flag' ;
    rdfs:comment 'Indicates whether prior authorization was required for the service that violated the rule.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyNdc rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Ndc' ;
    rdfs:comment 'National Drug Code for pharmacy claims that violated the rule.' ;
    rdfs:domain ind:RuleViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacyDawCode rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Daw Code' ;
    rdfs:comment 'Dispense As Written code indicating whether brand or generic drug was dispensed.' ;
    rdfs:domain ind:RuleViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacyDaysSupply rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Days Supply' ;
    rdfs:comment 'Number of days supply for the prescription that violated the rule.' ;
