Table content.content_provenance {
  content_provenance_id varchar [pk, note: 'Primary key for content provenance record']
  human_reviewer_employee_id varchar [note: 'Employee who reviewed and approved the AI-generated content']
  media_asset_id varchar [note: 'Foreign key to the media asset this provenance record applies to']
  title_id varchar [note: 'Foreign key to the content title this provenance record applies to']
  ai_generated_flag boolean [note: 'Indicates whether the content was generated by artificial intelligence']
  ai_generation_prompt_hash varchar [note: 'Hash of the prompt used for AI generation (for audit without exposing prompt)']
  ai_modified_flag boolean [note: 'Indicates whether the content was modified or enhanced using AI tools']
  ai_tool_name varchar [note: 'Name of the AI tool or model used to generate or modify the content']
  ai_tool_vendor varchar [note: 'Vendor or provider of the AI tool used']
  ai_tool_version varchar [note: 'Version of the AI tool or model used']
  ai_training_data_disclosure varchar [note: 'Disclosure statement about training data used for the AI model']
  c2pa_claim_generator varchar [note: 'Software or tool that generated the C2PA claim']
  c2pa_manifest_hash varchar [note: 'Cryptographic hash of the C2PA manifest for integrity verification']
  c2pa_manifest_uri varchar [note: 'URI reference to the C2PA (Coalition for Content Provenance and Authenticity) manifest']
  c2pa_signature_issuer varchar [note: 'Certificate authority or issuer of the C2PA digital signature']
  c2pa_signature_timestamp timestamp [note: 'Timestamp when the C2PA manifest was digitally signed']
  created_timestamp timestamp [note: 'Timestamp when the provenance record was created']
  dummy_flag boolean [note: 'Generated flag to ensure model change']
  eu_ai_act_compliance_status varchar [note: 'Compliance status with EU AI Act requirements']
  eu_ai_act_risk_category varchar [note: 'Risk classification under EU AI Act (minimal, limited, high, unacceptable)']
  fcc_ai_disclosure_required_flag boolean [note: 'Indicates whether FCC AI ad disclosure is required for this content']
  fcc_ai_disclosure_text varchar [note: 'Text of the FCC-required AI disclosure statement']
  fcc_ai_disclosure_timestamp timestamp [note: 'Timestamp when FCC AI disclosure was filed or broadcast']
  human_oversight_flag boolean [note: 'Indicates whether human oversight was applied to AI-generated content']
  original_source_uri varchar [note: 'URI of the original source content before any AI modification']
  provenance_chain_json varchar [note: 'JSON representation of the full provenance chain including all transformations']
  source_code varchar [note: 'Identifier of this record in the source system']
  synthetic_media_type varchar [note: 'Type of synthetic media (deepfake, voice clone, image synthesis, video synthesis, text generation)']
  updated_timestamp timestamp [note: 'Timestamp when the provenance record was last updated']
  verification_status varchar [note: 'Status of provenance verification (verified, unverified, failed, pending)']
  verification_timestamp timestamp [note: 'Timestamp of the last provenance verification check']
  watermark_embedded_flag boolean [note: 'Indicates whether a digital watermark identifying AI origin is embedded']
  watermark_type varchar [note: 'Type of watermark embedded (visible, invisible, audio, metadata)']

  Note: 'Content provenance records capturing C2PA manifests and generative-AI flags for compliance with EU AI Act and FCC AI ad disclosure requirements'
}

