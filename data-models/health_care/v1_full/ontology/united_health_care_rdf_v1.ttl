    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telemedicineCoordination rdf:type rdf:Property ;
    rdfs:label 'Telemedicine Coordination' ;
    rdfs:comment 'Method for coordinating telemedicine and virtual care benefits between parent and child products in the hierarchy.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:behavioralHealthCoordination rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Coordination' ;
