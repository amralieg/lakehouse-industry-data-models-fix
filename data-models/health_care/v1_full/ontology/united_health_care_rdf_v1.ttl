ind:serviceCategoryCode rdf:type rdf:Property ;
    rdfs:label 'Service Category Code' ;
    rdfs:comment 'Code representing the specific service category within the benefit type (e.g., emergency room, specialist visit, generic drug, brand drug).' ;
