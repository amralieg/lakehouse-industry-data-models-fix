    rdfs:comment 'Unique identifier for the psychiatric assessment record.' ;
    rdfs:domain ind:BehavioralHealth ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PsychiatricAssessment .

ind:assessmentFindings rdf:type rdf:Property ;
    rdfs:label 'Assessment Findings' ;
    rdfs:comment 'Narrative findings and observations recorded by the clinician.' ;
    rdfs:domain ind:BehavioralHealthPsychiatricAssessment ;
    rdf:type owl:DatatypeProperty ;
