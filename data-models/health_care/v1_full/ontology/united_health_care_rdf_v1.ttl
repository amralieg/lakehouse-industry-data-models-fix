ind:payerResponsibilityCode rdf:type rdf:Property ;
    rdfs:label 'Payer Responsibility Code' ;
    rdfs:comment 'Code indicating the payer\'s responsibility level: P=Primary, S=Secondary, T=Tertiary, A=Additional, C=Conditional, U=Unknown.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerName rdf:type rdf:Property ;
    rdfs:label 'Payer Name' ;
    rdfs:comment 'Name of the insurance payer responsible for this coordination of benefits level.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerId rdf:type rdf:Property ;
    rdfs:label 'Payer Id' ;
    rdfs:comment 'Unique identifier for the payer organization in the coordination of benefits sequence.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:payerType rdf:type rdf:Property ;
    rdfs:label 'Payer Type' ;
    rdfs:comment 'Type or category of the payer in the coordination of benefits sequence.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriberName rdf:type rdf:Property ;
    rdfs:label 'Subscriber Name' ;
    rdfs:comment 'Full name of the subscriber under the other payer\'s plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobType rdf:type rdf:Property ;
    rdfs:label 'Cob Type' ;
    rdfs:comment 'Type of coordination of benefits arrangement applied to this claim.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobMethod rdf:type rdf:Property ;
    rdfs:label 'Cob Method' ;
    rdfs:comment 'Method used to coordinate benefits between multiple payers.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otherPayerPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Other Payer Paid Amount' ;
    rdfs:comment 'Amount paid by the other payer for this claim or claim line.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherPayerAllowedAmount rdf:type rdf:Property ;
    rdfs:label 'Other Payer Allowed Amount' ;
    rdfs:comment 'Allowed or approved amount determined by the other payer for this claim or claim line.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherPayerDeductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Other Payer Deductible Amount' ;
    rdfs:comment 'Deductible amount applied by the other payer for this claim or claim line.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherPayerCoinsuranceAmount rdf:type rdf:Property ;
    rdfs:label 'Other Payer Coinsurance Amount' ;
    rdfs:comment 'Coinsurance amount applied by the other payer for this claim or claim line.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherPayerCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Other Payer Copay Amount' ;
    rdfs:comment 'Copayment amount applied by the other payer for this claim or claim line.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherPayerPatientResponsibilityAmount rdf:type rdf:Property ;
    rdfs:label 'Other Payer Patient Responsibility Amount' ;
    rdfs:comment 'Total patient responsibility amount determined by the other payer.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherPayerDenialAmount rdf:type rdf:Property ;
    rdfs:label 'Other Payer Denial Amount' ;
    rdfs:comment 'Amount denied by the other payer for this claim or claim line.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherPayerDenialReasonCode rdf:type rdf:Property ;
    rdfs:label 'Other Payer Denial Reason Code' ;
    rdfs:comment 'Code indicating the reason for denial by the other payer.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otherPayerDenialReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Other Payer Denial Reason Description' ;
    rdfs:comment 'Description of the reason for denial by the other payer.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otherPayerAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Other Payer Adjustment Amount' ;
    rdfs:comment 'Total adjustment amount applied by the other payer.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherPayerAdjustmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Other Payer Adjustment Reason Code' ;
    rdfs:comment 'Code indicating the reason for adjustment by the other payer.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otherPayerAdjustmentReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Other Payer Adjustment Reason Description' ;
    rdfs:comment 'Description of the reason for adjustment by the other payer.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otherPayerPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Other Payer Payment Date' ;
    rdfs:comment 'Date when the other payer processed or paid the claim.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:otherPayerClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Other Payer Claim Number' ;
    rdfs:comment 'Claim number assigned by the other payer for this claim.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otherPayerClaimStatus rdf:type rdf:Property ;
    rdfs:label 'Other Payer Claim Status' ;
    rdfs:comment 'Status of the claim as reported by the other payer.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibilityPercentage rdf:type rdf:Property ;
    rdfs:label 'Responsibility Percentage' ;
    rdfs:comment 'Percentage of financial responsibility assigned to this payer in the coordination of benefits sequence.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coordinationFlag rdf:type rdf:Property ;
    rdfs:label 'Coordination Flag' ;
    rdfs:comment 'Indicates whether coordination of benefits applies to this claim or claim line.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareSecondaryPayerType rdf:type rdf:Property ;
    rdfs:label 'Medicare Secondary Payer Type' ;
    rdfs:comment 'Type of Medicare Secondary Payer situation applicable to this claim.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationFlag rdf:type rdf:Property ;
    rdfs:label 'Subrogation Flag' ;
    rdfs:comment 'Indicates whether subrogation applies to this coordination of benefits detail.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subrogationAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Amount' ;
    rdfs:comment 'Amount subject to subrogation recovery from the other payer or responsible party.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eobReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Eob Received Flag' ;
    rdfs:comment 'Indicates whether an Explanation of Benefits was received from the other payer.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eobReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Eob Received Date' ;
    rdfs:comment 'Date when the Explanation of Benefits was received from the other payer.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remittanceAdviceNumber rdf:type rdf:Property ;
    rdfs:label 'Remittance Advice Number' ;
    rdfs:comment 'Remittance advice or payment voucher number from the other payer.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinationStatus rdf:type rdf:Property ;
    rdfs:label 'Coordination Status' ;
    rdfs:comment 'Current status of the coordination of benefits process for this detail.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Coordination Completion Date' ;
    rdfs:comment 'Date when the coordination of benefits process was completed for this detail.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coordinationInitiatedDate rdf:type rdf:Property ;
    rdfs:label 'Coordination Initiated Date' ;
    rdfs:comment 'Date when the coordination of benefits process was initiated for this detail.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coordinationMethod rdf:type rdf:Property ;
    rdfs:label 'Coordination Method' ;
    rdfs:comment 'Method used to coordinate benefits with the other payer.' ;
    rdfs:domain ind:CobDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryDate rdf:type rdf:Property ;
    rdfs:label 'Recovery Date' ;
    rdfs:comment 'Date when the recovery amount was received from the other payer.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialSummaryId rdf:type rdf:Property ;
    rdfs:label 'Credential Summary Id' ;
    rdfs:comment 'Unique identifier for the credential summary record, serving as the primary key for tracking aggregated credentialing status and verification data for a provider.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:initialCredentialingDate rdf:type rdf:Property ;
    rdfs:label 'Initial Credentialing Date' ;
    rdfs:comment 'The date when the provider was first credentialed with the organization, establishing the baseline for tracking credentialing history and tenure.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Next Verification Date' ;
    rdfs:comment 'The scheduled date for the next primary source verification cycle to ensure ongoing compliance with credentialing requirements.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primaryLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Primary License Number' ;
    rdfs:comment 'The license number for the provider\'s primary professional license in their main state of practice, verified through primary source verification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryLicenseState rdf:type rdf:Property ;
    rdfs:label 'Primary License State' ;
    rdfs:comment 'The two-letter state code where the provider holds their primary professional license to practice medicine or provide healthcare services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryLicenseType rdf:type rdf:Property ;
    rdfs:label 'Primary License Type' ;
    rdfs:comment 'The type or category of the provider\'s primary professional license, such as MD, DO, RN, DDS, indicating their scope of practice.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryLicenseStatus rdf:type rdf:Property ;
    rdfs:label 'Primary License Status' ;
    rdfs:comment 'The current status of the provider\'s primary professional license as verified through primary source verification with the state licensing board.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryLicenseIssueDate rdf:type rdf:Property ;
    rdfs:label 'Primary License Issue Date' ;
    rdfs:comment 'The date on which the provider\'s primary professional license was originally issued by the state licensing authority.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primaryLicenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Primary License Expiration Date' ;
    rdfs:comment 'The date on which the provider\'s primary professional license expires and requires renewal to maintain active status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:additionalLicenseCount rdf:type rdf:Property ;
    rdfs:label 'Additional License Count' ;
    rdfs:comment 'The total number of additional professional licenses held by the provider in states other than their primary license state, supporting multi-state practice.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryBoardCertification rdf:type rdf:Property ;
    rdfs:label 'Primary Board Certification' ;
    rdfs:comment 'The name of the provider\'s primary board certification specialty, such as Internal Medicine, Family Medicine, or Cardiology.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryBoardName rdf:type rdf:Property ;
    rdfs:label 'Primary Board Name' ;
    rdfs:comment 'The name of the certifying board that issued the provider\'s primary board certification, such as American Board of Internal Medicine.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryBoardCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Primary Board Certification Date' ;
    rdfs:comment 'The date on which the provider achieved their primary board certification, demonstrating specialized training and competency.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primaryBoardExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Primary Board Expiration Date' ;
    rdfs:comment 'The date on which the provider\'s primary board certification expires and requires recertification through examination or maintenance of certification.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:additionalCertificationCount rdf:type rdf:Property ;
    rdfs:label 'Additional Certification Count' ;
    rdfs:comment 'The total number of additional board certifications or subspecialty certifications held by the provider beyond their primary certification.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deaRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Dea Registration Number' ;
    rdfs:comment 'The DEA registration number assigned to the provider authorizing them to prescribe controlled substances, verified through primary source verification.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdsRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Cds Registration Number' ;
    rdfs:comment 'The state-level controlled substance registration number for providers in states that require separate state CDS registration beyond DEA.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdsStatus rdf:type rdf:Property ;
    rdfs:label 'Cds Status' ;
    rdfs:comment 'The current status of the provider\'s state-level controlled substance registration.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdsExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Cds Expiration Date' ;
    rdfs:comment 'The date on which the provider\'s state CDS registration expires and requires renewal.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:malpracticeInsuranceStatus rdf:type rdf:Property ;
    rdfs:label 'Malpractice Insurance Status' ;
    rdfs:comment 'Indicates whether the provider currently maintains active professional liability (malpractice) insurance coverage meeting network requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:malpracticeCarrierName rdf:type rdf:Property ;
    rdfs:label 'Malpractice Carrier Name' ;
    rdfs:comment 'The name of the insurance company providing the provider\'s professional liability (malpractice) insurance coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:malpracticePolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Malpractice Policy Number' ;
    rdfs:comment 'The policy number for the provider\'s professional liability insurance, used for verification and claims coordination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:malpracticeEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Malpractice Effective Date' ;
    rdfs:comment 'The date on which the provider\'s current malpractice insurance policy became effective and coverage began.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:malpracticeCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Malpractice Coverage Amount' ;
    rdfs:comment 'The total coverage amount (per occurrence and aggregate) of the provider\'s professional liability insurance policy, typically expressed in millions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:malpracticePerOccurrenceLimit rdf:type rdf:Property ;
    rdfs:label 'Malpractice Per Occurrence Limit' ;
    rdfs:comment 'The maximum amount the malpractice insurance policy will pay for a single claim or occurrence.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:malpracticeAggregateLimit rdf:type rdf:Property ;
    rdfs:label 'Malpractice Aggregate Limit' ;
    rdfs:comment 'The maximum total amount the malpractice insurance policy will pay for all claims during the policy period.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:malpracticeTailCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Malpractice Tail Coverage Indicator' ;
    rdfs:comment 'Indicates whether the provider has tail coverage (extended reporting endorsement) for claims-made malpractice policies to cover incidents after policy termination.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalPrivilegesStatus rdf:type rdf:Property ;
    rdfs:label 'Hospital Privileges Status' ;
    rdfs:comment 'Indicates whether the provider currently holds active hospital admitting or clinical privileges at one or more facilities.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hospitalAffiliationCount rdf:type rdf:Property ;
    rdfs:label 'Hospital Affiliation Count' ;
    rdfs:comment 'The total number of hospitals where the provider holds active clinical privileges or admitting rights.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryHospitalName rdf:type rdf:Property ;
    rdfs:label 'Primary Hospital Name' ;
    rdfs:comment 'The name of the primary hospital where the provider holds admitting privileges and most frequently admits patients.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:educationVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Education Verification Status' ;
    rdfs:comment 'Indicates whether the provider\'s medical school or professional education has been verified through primary source verification with the educational institution.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalSchoolName rdf:type rdf:Property ;
    rdfs:label 'Medical School Name' ;
    rdfs:comment 'The name of the medical school or professional school where the provider completed their primary professional degree.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:graduationDate rdf:type rdf:Property ;
    rdfs:label 'Graduation Date' ;
    rdfs:comment 'The date on which the provider graduated from medical school or professional school with their primary degree.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trainingVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Training Verification Status' ;
    rdfs:comment 'Indicates whether the provider\'s residency, fellowship, and other post-graduate training has been verified through primary source verification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residencyProgramName rdf:type rdf:Property ;
    rdfs:label 'Residency Program Name' ;
    rdfs:comment 'The name of the residency program where the provider completed their primary post-graduate medical training.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residencyCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Residency Completion Date' ;
    rdfs:comment 'The date on which the provider completed their residency training program.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:workHistoryVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Work History Verification Status' ;
    rdfs:comment 'Indicates whether the provider\'s work history for the required lookback period (typically 5 years) has been verified through primary source verification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workHistoryGapIndicator rdf:type rdf:Property ;
    rdfs:label 'Work History Gap Indicator' ;
    rdfs:comment 'Indicates whether there are unexplained gaps in the provider\'s work history that require additional documentation or explanation.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:npdbQueryDate rdf:type rdf:Property ;
    rdfs:label 'Npdb Query Date' ;
    rdfs:comment 'The date on which the most recent query was performed against the National Practitioner Data Bank to check for adverse actions, malpractice payments, and disciplinary actions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:npdbQueryStatus rdf:type rdf:Property ;
    rdfs:label 'Npdb Query Status' ;
    rdfs:comment 'The result status of the most recent NPDB query indicating whether any reportable adverse actions or malpractice payments were found.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npdbReportableActionCount rdf:type rdf:Property ;
    rdfs:label 'Npdb Reportable Action Count' ;
    rdfs:comment 'The total number of reportable actions found in the NPDB query, including malpractice payments, license actions, and clinical privilege restrictions.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:oigExclusionStatus rdf:type rdf:Property ;
    rdfs:label 'Oig Exclusion Status' ;
    rdfs:comment 'Indicates whether the provider appears on the OIG List of Excluded Individuals and Entities (LEIE), which would prohibit participation in federal healthcare programs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oigCheckDate rdf:type rdf:Property ;
    rdfs:label 'Oig Check Date' ;
    rdfs:comment 'The date on which the most recent check was performed against the OIG exclusion list to verify the provider is not excluded from federal programs.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:samExclusionStatus rdf:type rdf:Property ;
    rdfs:label 'Sam Exclusion Status' ;
    rdfs:comment 'Indicates whether the provider appears on the SAM exclusion list, which identifies entities excluded from receiving federal contracts or assistance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samCheckDate rdf:type rdf:Property ;
    rdfs:label 'Sam Check Date' ;
    rdfs:comment 'The date on which the most recent check was performed against the SAM exclusion database.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateExclusionStatus rdf:type rdf:Property ;
    rdfs:label 'State Exclusion Status' ;
    rdfs:comment 'Indicates whether the provider appears on any state Medicaid exclusion lists, which would prohibit participation in state Medicaid programs.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateExclusionCheckDate rdf:type rdf:Property ;
    rdfs:label 'State Exclusion Check Date' ;
    rdfs:comment 'The date on which the most recent check was performed against state Medicaid exclusion lists.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sanctionsIndicator rdf:type rdf:Property ;
    rdfs:label 'Sanctions Indicator' ;
    rdfs:comment 'Indicates whether any sanctions, disciplinary actions, or adverse actions have been identified against the provider during the credentialing process.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionsCount rdf:type rdf:Property ;
    rdfs:label 'Sanctions Count' ;
    rdfs:comment 'The total number of sanctions, disciplinary actions, or adverse actions identified against the provider across all verification sources.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peerReferenceStatus rdf:type rdf:Property ;
    rdfs:label 'Peer Reference Status' ;
    rdfs:comment 'Indicates whether the required peer references have been obtained and reviewed as part of the credentialing process.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerReferenceCount rdf:type rdf:Property ;
    rdfs:label 'Peer Reference Count' ;
    rdfs:comment 'The total number of peer references obtained for the provider during the credentialing process, typically requiring 2-3 references.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attestationStatus rdf:type rdf:Property ;
    rdfs:label 'Attestation Status' ;
    rdfs:comment 'Indicates whether a current, valid attestation statement has been received from the provider.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caqhProviderId rdf:type rdf:Property ;
    rdfs:label 'Caqh Provider Id' ;
    rdfs:comment 'The unique identifier assigned to the provider in the CAQH ProView system, used for standardized credentialing data exchange.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Provider .

ind:caqhProfileStatus rdf:type rdf:Property ;
    rdfs:label 'Caqh Profile Status' ;
    rdfs:comment 'The current status of the provider\'s CAQH ProView profile, indicating whether their credentialing data is current and accessible.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caqhLastUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Caqh Last Update Date' ;
    rdfs:comment 'The date on which the provider last updated their CAQH ProView profile with current credentialing information.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialingCommitteeReviewDate rdf:type rdf:Property ;
    rdfs:label 'Credentialing Committee Review Date' ;
    rdfs:comment 'The date on which the credentialing committee reviewed and made a determination on the provider\'s credentialing application.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialingCommitteeDecision rdf:type rdf:Property ;
    rdfs:label 'Credentialing Committee Decision' ;
    rdfs:comment 'The final decision made by the credentialing committee regarding the provider\'s application for network participation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingDecisionRationale rdf:type rdf:Property ;
    rdfs:label 'Credentialing Decision Rationale' ;
    rdfs:comment 'The documented rationale or reason for the credentialing committee\'s decision, particularly important for denials or conditional approvals.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicareParticipationStatus rdf:type rdf:Property ;
    rdfs:label 'Medicare Participation Status' ;
    rdfs:comment 'Indicates the provider\'s participation status in the Medicare program, affecting reimbursement rates and assignment of benefits.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidParticipationStatus rdf:type rdf:Property ;
    rdfs:label 'Medicaid Participation Status' ;
    rdfs:comment 'Indicates the provider\'s participation status in state Medicaid programs, affecting eligibility to serve Medicaid beneficiaries.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:culturalCompetencyTrainingStatus rdf:type rdf:Property ;
    rdfs:label 'Cultural Competency Training Status' ;
    rdfs:comment 'Indicates whether the provider has completed required cultural competency training to serve diverse patient populations.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaTrainingStatus rdf:type rdf:Property ;
    rdfs:label 'Hipaa Training Status' ;
    rdfs:comment 'Indicates whether the provider has completed required HIPAA privacy and security training.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaTrainingCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Hipaa Training Completion Date' ;
    rdfs:comment 'The date on which the provider completed their most recent HIPAA training.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fraudWasteAbuseTrainingStatus rdf:type rdf:Property ;
    rdfs:label 'Fraud Waste Abuse Training Status' ;
    rdfs:comment 'Indicates whether the provider has completed required fraud, waste, and abuse prevention training, mandatory for Medicare and Medicaid participation.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fwaTrainingCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Fwa Training Completion Date' ;
    rdfs:comment 'The date on which the provider completed their most recent fraud, waste, and abuse prevention training.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialingApplicationSource rdf:type rdf:Property ;
    rdfs:label 'Credentialing Application Source' ;
    rdfs:comment 'The source or method through which the provider\'s credentialing application and supporting documentation were received.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingCycleType rdf:type rdf:Property ;
    rdfs:label 'Credentialing Cycle Type' ;
    rdfs:comment 'Indicates the type of credentialing cycle this summary represents, such as initial credentialing, routine recredentialing, or interim review.' ;
    rdfs:domain ind:CredentialSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringFrequency rdf:type rdf:Property ;
    rdfs:label 'Monitoring Frequency' ;
    rdfs:comment 'The frequency at which the provider\'s credentials and compliance status are monitored between full recredentialing cycles.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastMonitoringDate rdf:type rdf:Property ;
    rdfs:label 'Last Monitoring Date' ;
    rdfs:comment 'The date on which the most recent ongoing monitoring check was performed for the provider\'s credentials and compliance status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextMonitoringDate rdf:type rdf:Property ;
    rdfs:label 'Next Monitoring Date' ;
    rdfs:comment 'The scheduled date for the next ongoing monitoring check of the provider\'s credentials and compliance status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialingSpecialistName rdf:type rdf:Property ;
    rdfs:label 'Credentialing Specialist Name' ;
    rdfs:comment 'The name of the credentialing specialist or coordinator responsible for managing this provider\'s credentialing file.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingNotes rdf:type rdf:Property ;
    rdfs:label 'Credentialing Notes' ;
    rdfs:comment 'Free-text notes documenting important information, exceptions, or special circumstances related to the provider\'s credentialing status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerId rdf:type rdf:Property ;
    rdfs:label 'Provider Id' ;
    rdfs:comment 'Unique identifier for the rendering or servicing provider who delivered the care.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Provider .

ind:renderingNpi rdf:type rdf:Property ;
    rdfs:label 'Rendering Npi' ;
    rdfs:comment 'The 10-digit National Provider Identifier of the individual provider who rendered the service.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingNpi rdf:type rdf:Property ;
    rdfs:label 'Billing Npi' ;
    rdfs:comment 'The 10-digit National Provider Identifier of the organization or provider submitting the claim for payment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingTin rdf:type rdf:Property ;
    rdfs:label 'Billing Tin' ;
    rdfs:comment 'The Tax Identification Number of the billing provider used for payment and tax reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityNpi rdf:type rdf:Property ;
    rdfs:label 'Facility Npi' ;
    rdfs:comment 'The 10-digit National Provider Identifier of the facility where services were rendered (e.g., hospital, clinic).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referringNpi rdf:type rdf:Property ;
    rdfs:label 'Referring Npi' ;
    rdfs:comment 'The 10-digit National Provider Identifier of the provider who referred the member for services.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formType rdf:type rdf:Property ;
    rdfs:label 'Form Type' ;
    rdfs:comment 'The standard claim form type used for submission (e.g., CMS-1500 for professional, UB-04 for institutional).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyCode rdf:type rdf:Property ;
    rdfs:label 'Frequency Code' ;
    rdfs:comment 'Code indicating whether the claim is an original submission, replacement, or void (1=Original, 7=Replacement, 8=Void).' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionMethod rdf:type rdf:Property ;
    rdfs:label 'Submission Method' ;
    rdfs:comment 'The method by which the claim was submitted to the payer (e.g., EDI, paper, provider portal).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivedDate rdf:type rdf:Property ;
    rdfs:label 'Received Date' ;
    rdfs:comment 'The date the claim was received by the payer for processing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:receivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Received Timestamp' ;
    rdfs:comment 'The precise timestamp when the claim was received by the payer system.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:serviceFromDate rdf:type rdf:Property ;
    rdfs:label 'Service From Date' ;
    rdfs:comment 'The start date of the service period for which the claim is submitted.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceToDate rdf:type rdf:Property ;
    rdfs:label 'Service To Date' ;
    rdfs:comment 'The end date of the service period for which the claim is submitted.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:admissionDate rdf:type rdf:Property ;
    rdfs:label 'Admission Date' ;
    rdfs:comment 'The date the member was admitted to a facility for inpatient or institutional care.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dischargeDate rdf:type rdf:Property ;
    rdfs:label 'Discharge Date' ;
    rdfs:comment 'The date the member was discharged from a facility after inpatient or institutional care.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statementFromDate rdf:type rdf:Property ;
    rdfs:label 'Statement From Date' ;
    rdfs:comment 'The beginning date of the billing statement period for institutional claims.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statementToDate rdf:type rdf:Property ;
    rdfs:label 'Statement To Date' ;
    rdfs:comment 'The ending date of the billing statement period for institutional claims.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalBilledAmount rdf:type rdf:Property ;
    rdfs:label 'Total Billed Amount' ;
    rdfs:comment 'The total amount billed by the provider for all services on the claim before any adjustments or payments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAllowedAmount rdf:type rdf:Property ;
    rdfs:label 'Total Allowed Amount' ;
    rdfs:comment 'The total amount approved by the payer as eligible for payment based on contracted rates and benefit plan rules.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Total Paid Amount' ;
    rdfs:comment 'The total amount paid by the payer to the provider or member for the claim.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalMemberResponsibility rdf:type rdf:Property ;
    rdfs:label 'Total Member Responsibility' ;
    rdfs:comment 'The total amount the member is responsible for paying, including deductible, coinsurance, and copayment.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coinsuranceAmount rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Amount' ;
    rdfs:comment 'The portion of the allowed amount the member is responsible for paying as a percentage of covered services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Copayment Amount' ;
    rdfs:comment 'The fixed dollar amount the member is responsible for paying for a covered service.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cobPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Cob Paid Amount' ;
    rdfs:comment 'The amount paid by other insurance carriers when the member has multiple coverage sources.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountAmount rdf:type rdf:Property ;
    rdfs:label 'Discount Amount' ;
    rdfs:comment 'The amount reduced from the billed charges due to provider contract discounts or negotiated rates.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Amount' ;
    rdfs:comment 'The total amount of adjustments applied to the claim, including denials, reductions, or other modifications.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statusDate rdf:type rdf:Property ;
    rdfs:label 'Status Date' ;
    rdfs:comment 'The date the claim reached its current status.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjudicationDate rdf:type rdf:Property ;
    rdfs:label 'Adjudication Date' ;
    rdfs:comment 'The date the claim was adjudicated and a payment decision was made.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paidDate rdf:type rdf:Property ;
    rdfs:label 'Paid Date' ;
    rdfs:comment 'The date payment was issued to the provider or member for the claim.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:checkNumber rdf:type rdf:Property ;
    rdfs:label 'Check Number' ;
    rdfs:comment 'The check or electronic payment reference number associated with the claim payment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryDiagnosisCodes rdf:type rdf:Property ;
    rdfs:label 'Secondary Diagnosis Codes' ;
    rdfs:comment 'Comma-separated list of secondary diagnosis codes (ICD-10) representing additional conditions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:admittingDiagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Admitting Diagnosis Code' ;
    rdfs:comment 'The diagnosis code (ICD-10) documented at the time of admission for institutional claims.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgCode rdf:type rdf:Property ;
    rdfs:label 'Drg Code' ;
    rdfs:comment 'The DRG code assigned to the claim for inpatient hospital services, used for payment grouping.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drgWeight rdf:type rdf:Property ;
    rdfs:label 'Drg Weight' ;
    rdfs:comment 'The relative weight assigned to the DRG code, used to calculate payment amounts.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueCode rdf:type rdf:Property ;
    rdfs:label 'Revenue Code' ;
    rdfs:comment 'The 4-digit code identifying the type of service or accommodation provided in institutional claims.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:placeOfServiceCode rdf:type rdf:Property ;
    rdfs:label 'Place Of Service Code' ;
    rdfs:comment 'The 2-digit code identifying the location where services were rendered (e.g., office, hospital, home).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typeOfBillCode rdf:type rdf:Property ;
    rdfs:label 'Type Of Bill Code' ;
    rdfs:comment 'The 3-digit code on institutional claims indicating the facility type, care type, and billing sequence.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:admissionTypeCode rdf:type rdf:Property ;
    rdfs:label 'Admission Type Code' ;
    rdfs:comment 'Code indicating the priority of the admission (e.g., emergency, urgent, elective).' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:admissionSourceCode rdf:type rdf:Property ;
    rdfs:label 'Admission Source Code' ;
    rdfs:comment 'Code indicating where the patient was located prior to admission (e.g., physician referral, emergency room).' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeStatusCode rdf:type rdf:Property ;
    rdfs:label 'Discharge Status Code' ;
    rdfs:comment 'Code indicating the patient\'s status at discharge (e.g., home, transferred, expired).' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceLineCount rdf:type rdf:Property ;
    rdfs:label 'Service Line Count' ;
    rdfs:comment 'The total number of service lines or detail records included in the claim.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unitsOfService rdf:type rdf:Property ;
    rdfs:label 'Units Of Service' ;
    rdfs:comment 'The total number of units of service provided across all service lines on the claim.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthorizationNumber rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Number' ;
    rdfs:comment 'The authorization number issued by the payer approving the service prior to delivery.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralNumber rdf:type rdf:Property ;
    rdfs:label 'Referral Number' ;
    rdfs:comment 'The referral authorization number issued for services requiring a referral from a primary care physician.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalRecordNumber rdf:type rdf:Property ;
    rdfs:label 'Medical Record Number' ;
    rdfs:comment 'The patient\'s medical record number assigned by the provider or facility.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:patientAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Patient Account Number' ;
    rdfs:comment 'The provider\'s internal account number for the patient associated with the claim.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Original Claim Number' ;
    rdfs:comment 'The claim number of the original claim when this claim is a replacement, void, or adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resubmissionCode rdf:type rdf:Property ;
    rdfs:label 'Resubmission Code' ;
    rdfs:comment 'Code indicating the reason for claim resubmission (e.g., corrected claim, additional information).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:note rdf:type rdf:Property ;
    rdfs:label 'Note' ;
    rdfs:comment 'Free-text notes or comments related to the claim, such as special circumstances or additional information.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accidentIndicator rdf:type rdf:Property ;
    rdfs:label 'Accident Indicator' ;
    rdfs:comment 'Indicates whether the services were related to an accident (auto, employment, or other).' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accidentDate rdf:type rdf:Property ;
    rdfs:label 'Accident Date' ;
    rdfs:comment 'The date of the accident if the claim is accident-related.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accidentState rdf:type rdf:Property ;
    rdfs:label 'Accident State' ;
    rdfs:comment 'The two-letter state code where the accident occurred.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyIndicator rdf:type rdf:Property ;
    rdfs:label 'Emergency Indicator' ;
    rdfs:comment 'Indicates whether the services were provided as emergency care.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobPayerResponsibility rdf:type rdf:Property ;
    rdfs:label 'Cob Payer Responsibility' ;
    rdfs:comment 'Indicates whether this payer is primary, secondary, or tertiary in the coordination of benefits sequence.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationIndicator rdf:type rdf:Property ;
    rdfs:label 'Subrogation Indicator' ;
    rdfs:comment 'Indicates whether the claim is subject to subrogation recovery from a third party.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareSecondaryPayerIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicare Secondary Payer Indicator' ;
    rdfs:comment 'Indicates whether Medicare is the secondary payer for this claim due to other primary coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:filingIndicatorCode rdf:type rdf:Property ;
    rdfs:label 'Filing Indicator Code' ;
    rdfs:comment 'Code identifying the type of insurance plan or payer (e.g., Medicare Part A, Commercial, Medicaid).' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerClaimControlNumber rdf:type rdf:Property ;
    rdfs:label 'Payer Claim Control Number' ;
    rdfs:comment 'The unique control number assigned by the payer to track the claim internally.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearinghouseTraceNumber rdf:type rdf:Property ;
    rdfs:label 'Clearinghouse Trace Number' ;
    rdfs:comment 'The trace number assigned by the clearinghouse for tracking the claim submission.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingPriority rdf:type rdf:Property ;
    rdfs:label 'Processing Priority' ;
    rdfs:comment 'The priority level assigned to the claim for processing (e.g., standard, expedited, urgent).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fraudScore rdf:type rdf:Property ;
    rdfs:label 'Fraud Score' ;
    rdfs:comment 'The fraud risk score assigned to the claim by fraud detection algorithms.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentAccuracyFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Accuracy Flag' ;
    rdfs:comment 'Indicates whether the claim has been flagged for payment accuracy review or audit.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealIndicator rdf:type rdf:Property ;
    rdfs:label 'Appeal Indicator' ;
    rdfs:comment 'Indicates whether the claim has been appealed by the provider or member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealLevel rdf:type rdf:Property ;
    rdfs:label 'Appeal Level' ;
    rdfs:comment 'The level of appeal if the claim has been appealed (e.g., first level, second level, external review).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Received Date' ;
    rdfs:comment 'The date the appeal was received by the payer.' ;
