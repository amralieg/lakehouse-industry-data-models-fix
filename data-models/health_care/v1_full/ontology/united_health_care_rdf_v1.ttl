ind:samSanctionsScreeningStatus rdf:type rdf:Property ;
    rdfs:label 'Sam Sanctions Screening Status' ;
    rdfs:comment 'The status of SAM exclusion list screening for this re-credentialing event.' ;
    rdfs:domain ind:RecredentialingEvent ;
