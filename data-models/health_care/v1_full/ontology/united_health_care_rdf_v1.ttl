    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingStatus rdf:type rdf:Property ;
    rdfs:label 'Billing Status' ;
    rdfs:comment 'Current lifecycle status of this billing event (e.g., generated, posted, sent, paid, cancelled).' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalBillingEventId rdf:type rdf:Property ;
    rdfs:label 'Original Billing Event Id' ;
    rdfs:comment 'Reference to the original billing event identifier if this event is a reversal, adjustment, or correction of a prior event.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillingEvent .

ind:billingCycleNumber rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Number' ;
    rdfs:comment 'Sequential number identifying the billing cycle within the policy or contract period.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:invoiceSentDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Sent Date' ;
    rdfs:comment 'The date when the invoice was sent or delivered to the responsible party.' ;
