    rdfs:comment 'Unique identifier for the billing statement that contains this billing event.' ;
    rdfs:domain ind:BillingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Member Premium Amount' ;
    rdfs:comment 'The portion of the premium amount paid by the member (employee contribution).' ;
