    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planNetworkId rdf:type rdf:Property ;
    rdfs:label 'Plan Network Id' ;
    rdfs:comment 'Identifier for the provider network to which the member has access under their benefit plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PlanNetwork .

ind:serviceAreaCode rdf:type rdf:Property ;
    rdfs:label 'Service Area Code' ;
    rdfs:comment 'Geographic service area code indicating where the member can access in-network benefits, typically defined by county or ZIP code.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingArea rdf:type rdf:Property ;
