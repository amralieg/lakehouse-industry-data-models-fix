    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PlanSponsor .

ind:additionalInformation rdf:type rdf:Property ;
    rdfs:label 'Additional Information' ;
    rdfs:comment 'Additional information or notes provided in the eligibility verification response' ;
