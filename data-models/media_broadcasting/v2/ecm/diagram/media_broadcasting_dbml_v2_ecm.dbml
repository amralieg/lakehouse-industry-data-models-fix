  metadata_tags varchar [note: 'Additional metadata tags or keywords associated with this taxonomy entry for search and discovery, stored as comma-separated values. | Column metadata_tags (STRING) in content.taxonomy']
  notes varchar [note: 'Additional notes, comments, or usage guidelines for this taxonomy entry. | Column notes (STRING) in content.taxonomy']
  owner_department varchar [note: 'Business department or team responsible for maintaining and governing this taxonomy entry. | Column owner_department (STRING) in content.taxonomy']
  region_code varchar [note: 'ISO 3166 three-letter country or region code indicating geographic applicability of this taxonomy entry. | Column region_code (STRING) in content.taxonomy']
  source_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in content.taxonomy']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in content.taxonomy']
  standard_reference varchar [note: 'Reference to the industry standard or classification system this taxonomy entry aligns with (e.g., EIDR Genre, ISO 639 Language Code). | Column standard_reference (STRING) in content.taxonomy']
  taxonomy_code varchar [note: 'Unique business code for the taxonomy entry used for external reference and integration. | Column taxonomy_code (STRING) in content.taxonomy']
  taxonomy_description varchar [note: 'Detailed description of the taxonomy entry explaining its meaning, scope, and usage guidelines. | Column description (STRING) in content.taxonomy']
  taxonomy_name varchar [note: 'Human-readable name of the taxonomy entry. | Column taxonomy_name (STRING) in content.taxonomy']
  taxonomy_type varchar [note: 'Classification type of the taxonomy entry indicating the categorization dimension (e.g., genre, theme, mood, audience segment, format, language). | Column taxonomy_type (STRING) in content.taxonomy']
