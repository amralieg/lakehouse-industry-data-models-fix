ind:qualityCommitteeId rdf:type rdf:Property ;
    rdfs:label 'Quality Committee Id' ;
    rdfs:comment 'Foreign key linking to quality.quality_committee. Business justification: Mortality reviews are conducted by quality/peer review committees (e.g., Mortality & Morbidity Committee). Linking to quality_committee identifies which committee owns the review process.' ;
    rdfs:domain ind:Quality ;
