    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseManagerEmail rdf:type rdf:Property ;
    rdfs:label 'Case Manager Email' ;
    rdfs:comment 'Email address for the case manager included in the notification.' ;
