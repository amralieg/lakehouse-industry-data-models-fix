    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionDescription rdf:type rdf:Property ;
    rdfs:label 'Disposition Description' ;
    rdfs:comment 'Detailed description of the investigation outcome or disposition documented in the case note.' ;
