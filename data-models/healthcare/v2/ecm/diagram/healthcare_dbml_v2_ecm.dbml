  net_usable_square_footage decimal(12,2) [note: 'Net usable square footage excluding common areas.']
  number_of_elevators varchar [note: 'Total number of elevators in the building.']
  number_of_floors varchar [note: 'Total number of floors in the building.']
  operational_status decimal(9,4) [note: 'Current operational status of the building.']
  ownership_type varchar [note: 'Ownership type (Owned, Leased, Shared).']
  parking_spaces_count varchar [note: 'Number of parking spaces associated with the building.']
  postal_code varchar [note: 'ZIP or postal code.']
  property_tax_parcel_number varchar [note: 'Property tax parcel identification number.']
  replacement_value_amount decimal(15,2) [note: 'Estimated replacement value of the building.']
  seismic_zone varchar [note: 'Seismic zone classification for the building location.']
  sprinkler_system_type varchar [note: 'Type of fire sprinkler system installed.']
  state_province varchar [note: 'State or province where the building is located.']
  termination_date date [note: 'Date the building was decommissioned or terminated.']
  vibe_canonical_facility_marker boolean [note: 'Marker confirming this facility product is part of the canonical 26-product set.']
  vibe_mutation_timestamp timestamp [note: 'Timestamp indicating VIBE mutation application']
  vibe_placeholder varchar [note: 'Added by VIBE mutator to ensure target entity is touched.']

  Note: 'Represents a physical building structure within a care site, tracking construction details, compliance certifications, and infrastructure capabilities.'
}

