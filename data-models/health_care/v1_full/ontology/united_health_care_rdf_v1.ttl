ind:capitalLossCarryforwardAmount rdf:type rdf:Property ;
    rdfs:label 'Capital Loss Carryforward Amount' ;
    rdfs:comment 'Amount of capital loss carried forward from prior years.' ;
    rdfs:domain ind:TaxReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alternativeMinimumTaxAmount rdf:type rdf:Property ;
