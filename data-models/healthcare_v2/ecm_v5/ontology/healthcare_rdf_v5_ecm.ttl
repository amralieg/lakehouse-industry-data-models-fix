ind:measureValue rdf:type rdf:Property ;
    rdfs:label 'Measure Value' ;
    rdfs:comment 'Numeric result of the outcome measurement (e.g., score, level, or reading).' ;
    rdfs:domain ind:OutcomeMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordedBy rdf:type rdf:Property ;
    rdfs:label 'Recorded By' ;
    rdfs:comment 'Identifier of the user or system that entered the outcome measurement.' ;
    rdfs:domain ind:OutcomeMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portalEngagementEventId rdf:type rdf:Property ;
    rdfs:label 'Portal Engagement Event Id' ;
    rdfs:comment 'System-generated unique identifier for each portal engagement event record.' ;
    rdfs:domain ind:PortalEngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventOutcome rdf:type rdf:Property ;
    rdfs:label 'Event Outcome' ;
    rdfs:comment 'Result of the interaction – whether it completed successfully or failed.' ;
    rdfs:domain ind:PortalEngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventPayload rdf:type rdf:Property ;
    rdfs:label 'Event Payload' ;
    rdfs:comment 'Free-form details or JSON payload associated with the event (e.g., message content, document ID).' ;
    rdfs:domain ind:PortalEngagementEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ingestionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ingestion Timestamp' ;
    rdfs:comment 'Date and time when the event record was loaded into the lakehouse.' ;
