    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcomeMeasureId rdf:type rdf:Property ;
    rdfs:label 'Outcome Measure Id' ;
    rdfs:comment 'Unique surrogate key for each outcome measurement record.' ;
    rdfs:domain ind:OutcomeMeasure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postAcuteServiceId rdf:type rdf:Property ;
    rdfs:label 'Post Acute Service Id' ;
    rdfs:comment 'Foreign key linking to post_acute_care.post_acute_service. Business justification: An outcome measure can be tied to a specific service type from the catalog, enabling service-level outcome analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PostAcuteService .

ind:achievedFlag rdf:type rdf:Property ;
    rdfs:label 'Achieved Flag' ;
    rdfs:comment 'Indicates whether the measured value met or exceeded the target.' ;
    rdfs:domain ind:OutcomeMeasure ;
    rdf:type owl:DatatypeProperty ;
