ind:hivAidsRecordsFlag rdf:type rdf:Property ;
    rdfs:label 'Hiv Aids Records Flag' ;
    rdfs:comment 'Indicates whether this consent covers Human Immunodeficiency Virus/Acquired Immunodeficiency Syndrome (HIV/AIDS) related records, which may be subject to additional state-specific protections.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geneticInformationFlag rdf:type rdf:Property ;
    rdfs:label 'Genetic Information Flag' ;
    rdfs:comment 'Indicates whether this consent covers genetic information, which is subject to additional protections under the Genetic Information Nondiscrimination Act (GINA).' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mentalHealthRecordsFlag rdf:type rdf:Property ;
    rdfs:label 'Mental Health Records Flag' ;
    rdfs:comment 'Indicates whether this consent covers mental health treatment records, which may be subject to additional state-specific protections.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:electronicSignatureIpAddress rdf:type rdf:Property ;
    rdfs:label 'Electronic Signature Ip Address' ;
    rdfs:comment 'The Internet Protocol (IP) address from which the electronic signature was submitted. Used for audit and verification purposes.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electronicSignatureDeviceId rdf:type rdf:Property ;
    rdfs:label 'Electronic Signature Device Id' ;
    rdfs:comment 'The unique identifier of the device used to provide the electronic signature.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electronicSignatureUserAgent rdf:type rdf:Property ;
    rdfs:label 'Electronic Signature User Agent' ;
    rdfs:comment 'The browser or application user agent string from which the electronic signature was submitted.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentObtainedByName rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained By Name' ;
    rdfs:comment 'The name of the staff member or representative who obtained the consent from the member.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentObtainedByRole rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained By Role' ;
    rdfs:comment 'The role or title of the staff member who obtained the consent (e.g., nurse, physician, enrollment specialist, customer service representative).' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentObtainedByNpi rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained By Npi' ;
    rdfs:comment 'The National Provider Identifier (NPI) of the healthcare provider who obtained the consent, if applicable.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByConsentFormId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Consent Form Id' ;
    rdfs:comment 'The identifier of the newer consent form that supersedes this consent form. Used to track consent form version history.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentForm .

ind:supersedesConsentFormId rdf:type rdf:Property ;
    rdfs:label 'Supersedes Consent Form Id' ;
    rdfs:comment 'The identifier of the older consent form that this consent form supersedes. Used to track consent form version history.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentForm .

ind:memberCopyProvidedFlag rdf:type rdf:Property ;
    rdfs:label 'Member Copy Provided Flag' ;
    rdfs:comment 'Indicates whether a copy of the signed consent form was provided to the member. Required under HIPAA for authorizations.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberCopyProvidedDate rdf:type rdf:Property ;
    rdfs:label 'Member Copy Provided Date' ;
    rdfs:comment 'The date on which a copy of the signed consent form was provided to the member.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastAccessedDate rdf:type rdf:Property ;
    rdfs:label 'Last Accessed Date' ;
    rdfs:comment 'The date on which the consent form record was last accessed or viewed. Used for audit and compliance monitoring.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastAccessedByUserId rdf:type rdf:Property ;
    rdfs:label 'Last Accessed By User Id' ;
    rdfs:comment 'The user identifier of the person who last accessed or viewed the consent form record.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:accessCount rdf:type rdf:Property ;
    rdfs:label 'Access Count' ;
    rdfs:comment 'The total number of times the consent form record has been accessed or viewed. Used for audit and compliance monitoring.' ;
    rdfs:domain ind:ConsentForm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enrollmentId rdf:type rdf:Property ;
    rdfs:label 'Enrollment Id' ;
    rdfs:comment 'Unique identifier for each member enrollment record. Primary key for the enrollment entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Enrollment .

ind:qleEventDate rdf:type rdf:Property ;
    rdfs:label 'Qle Event Date' ;
    rdfs:comment 'Date on which the qualifying life event occurred that triggered the special enrollment.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sepIndicator rdf:type rdf:Property ;
    rdfs:label 'Sep Indicator' ;
    rdfs:comment 'Indicates whether this enrollment was processed during a special enrollment period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aepIndicator rdf:type rdf:Property ;
    rdfs:label 'Aep Indicator' ;
    rdfs:comment 'Indicates whether this enrollment was processed during the Medicare Annual Enrollment Period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exchangeEnrollmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Exchange Enrollment Indicator' ;
    rdfs:comment 'Indicates whether this enrollment was submitted through a health insurance exchange (FFM or SBM).' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hsaContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Hsa Contribution Amount' ;
    rdfs:comment 'Employer or member contribution amount to the Health Savings Account.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hraContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Hra Contribution Amount' ;
    rdfs:comment 'Employer contribution amount to the Health Reimbursement Arrangement.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fsaElectionAmount rdf:type rdf:Property ;
    rdfs:label 'Fsa Election Amount' ;
    rdfs:comment 'Annual amount elected by the member for Flexible Spending Account contributions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ageRatedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Age Rated Premium Amount' ;
    rdfs:comment 'Premium amount calculated based on the member\'s age for age-rated plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicareBeneficiaryIdentifier rdf:type rdf:Property ;
    rdfs:label 'Medicare Beneficiary Identifier' ;
    rdfs:comment 'Medicare Beneficiary Identifier (MBI) for Medicare enrollments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidBeneficiaryIdentifier rdf:type rdf:Property ;
    rdfs:label 'Medicaid Beneficiary Identifier' ;
    rdfs:comment 'State-assigned Medicaid identification number for Medicaid enrollments.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chronicConditionCode rdf:type rdf:Property ;
    rdfs:label 'Chronic Condition Code' ;
    rdfs:comment 'Code representing the chronic condition for Chronic Condition Special Needs Plan (C-SNP) enrollments.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:institutionalLevelOfCare rdf:type rdf:Property ;
    rdfs:label 'Institutional Level Of Care' ;
    rdfs:comment 'Level of institutional care for Institutional Special Needs Plan (I-SNP) enrollments.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disabilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Disability Indicator' ;
    rdfs:comment 'Indicates whether the member qualifies for Medicare due to disability (under age 65).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:passiveEnrollmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Passive Enrollment Indicator' ;
    rdfs:comment 'Indicates whether the member was passively enrolled (automatically re-enrolled without active selection).' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:agentCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Agent Commission Rate' ;
    rdfs:comment 'Commission rate paid to the broker or agent for this enrollment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ediTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Edi Transaction Reference' ;
    rdfs:comment 'Unique identifier for the EDI 834 transaction that created or updated this enrollment.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openEnrollmentWindowId rdf:type rdf:Property ;
    rdfs:label 'Open Enrollment Window Id' ;
    rdfs:comment 'Unique identifier for the open enrollment window configuration record.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OpenEnrollmentWindow .

ind:qualifyingLifeEventRequired rdf:type rdf:Property ;
    rdfs:label 'Qualifying Life Event Required' ;
    rdfs:comment 'Indicates whether a qualifying life event is required to enroll during this window (true for SEP, false for standard OEP).' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:productPortfolio rdf:type rdf:Property ;
    rdfs:label 'Product Portfolio' ;
    rdfs:comment 'List or description of product types available during this enrollment window (e.g., \'HMO, PPO, EPO, HDHP\').' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planTypesAllowed rdf:type rdf:Property ;
    rdfs:label 'Plan Types Allowed' ;
    rdfs:comment 'Specific plan types that members can select during this enrollment window.' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumEnrollmentAge rdf:type rdf:Property ;
    rdfs:label 'Minimum Enrollment Age' ;
    rdfs:comment 'Minimum age requirement for members to enroll during this window.' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumEnrollmentAge rdf:type rdf:Property ;
    rdfs:label 'Maximum Enrollment Age' ;
    rdfs:comment 'Maximum age limit for members to enroll during this window (if applicable).' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dependentCoverageAllowed rdf:type rdf:Property ;
    rdfs:label 'Dependent Coverage Allowed' ;
    rdfs:comment 'Indicates whether dependents can be enrolled during this window.' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maximumDependentAge rdf:type rdf:Property ;
    rdfs:label 'Maximum Dependent Age' ;
    rdfs:comment 'Maximum age for dependents to be eligible for coverage under this enrollment window.' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoRenewalEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Enabled' ;
    rdfs:comment 'Indicates whether existing members are automatically renewed if they do not make changes during this window.' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:passiveEnrollmentAllowed rdf:type rdf:Property ;
    rdfs:label 'Passive Enrollment Allowed' ;
    rdfs:comment 'Indicates whether passive enrollment (automatic assignment to a plan) is permitted during this window.' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retroactiveEnrollmentAllowed rdf:type rdf:Property ;
    rdfs:label 'Retroactive Enrollment Allowed' ;
    rdfs:comment 'Indicates whether retroactive enrollment (coverage effective before enrollment date) is permitted.' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retroactiveCoverageDays rdf:type rdf:Property ;
    rdfs:label 'Retroactive Coverage Days' ;
    rdfs:comment 'Number of days retroactive coverage is allowed if retroactive enrollment is permitted.' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Approval Date' ;
    rdfs:comment 'Date when the enrollment window configuration was approved by compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cmsSubmissionRequired rdf:type rdf:Property ;
    rdfs:label 'Cms Submission Required' ;
    rdfs:comment 'Indicates whether this enrollment window configuration must be submitted to CMS for approval.' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Cms Submission Date' ;
    rdfs:comment 'Date when the enrollment window configuration was submitted to CMS.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentTargetCount rdf:type rdf:Property ;
    rdfs:label 'Enrollment Target Count' ;
    rdfs:comment 'Target number of enrollments expected during this window for planning purposes.' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:marketingCampaignCode rdf:type rdf:Property ;
    rdfs:label 'Marketing Campaign Code' ;
    rdfs:comment 'Code identifying the marketing campaign associated with this enrollment window.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemConfigurationCode rdf:type rdf:Property ;
    rdfs:label 'System Configuration Code' ;
    rdfs:comment 'Identifier linking this enrollment window to system configuration settings in the enrollment platform.' ;
    rdfs:domain ind:OpenEnrollmentWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverId rdf:type rdf:Property ;
    rdfs:label 'Waiver Id' ;
    rdfs:comment 'Unique identifier for the coverage waiver record.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alternateCoverageCarrierName rdf:type rdf:Property ;
    rdfs:label 'Alternate Coverage Carrier Name' ;
    rdfs:comment 'Name of the insurance carrier providing alternate coverage if applicable.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternateCoveragePolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Alternate Coverage Policy Number' ;
    rdfs:comment 'Policy or certificate number for the alternate coverage.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverUserAgentId rdf:type rdf:Property ;
    rdfs:label 'Approver User Agent Id' ;
    rdfs:comment 'Identifier of the user who approved the waiver.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:documentationReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Documentation Received Flag' ;
    rdfs:comment 'Indicates whether required documentation for the waiver was received.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentationVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Documentation Verification Date' ;
    rdfs:comment 'Date when the waiver documentation was verified.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:annualVerificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Annual Verification Required Flag' ;
    rdfs:comment 'Indicates whether the waiver requires annual verification.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optOutIncentiveAmount rdf:type rdf:Property ;
    rdfs:label 'Opt Out Incentive Amount' ;
    rdfs:comment 'Monetary incentive amount offered to the member for waiving coverage.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:optOutIncentiveFrequency rdf:type rdf:Property ;
    rdfs:label 'Opt Out Incentive Frequency' ;
    rdfs:comment 'Frequency at which the opt-out incentive is paid.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optOutIncentivePaymentMethod rdf:type rdf:Property ;
    rdfs:label 'Opt Out Incentive Payment Method' ;
    rdfs:comment 'Method by which the opt-out incentive is paid to the member.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerContributionWaivedAmount rdf:type rdf:Property ;
    rdfs:label 'Employer Contribution Waived Amount' ;
    rdfs:comment 'Amount of employer contribution that is waived due to the coverage waiver.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employeeContributionWaivedAmount rdf:type rdf:Property ;
    rdfs:label 'Employee Contribution Waived Amount' ;
    rdfs:comment 'Amount of employee contribution that is waived due to the coverage waiver.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exchangeEnrollmentFlag rdf:type rdf:Property ;
    rdfs:label 'Exchange Enrollment Flag' ;
    rdfs:comment 'Indicates whether the waiver was submitted through a health insurance exchange.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attestationSignatureDate rdf:type rdf:Property ;
    rdfs:label 'Attestation Signature Date' ;
    rdfs:comment 'Date when the member signed the waiver attestation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attestationMethod rdf:type rdf:Property ;
    rdfs:label 'Attestation Method' ;
    rdfs:comment 'Method by which the member attested to the waiver.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentCoverageWaivedFlag rdf:type rdf:Property ;
    rdfs:label 'Dependent Coverage Waived Flag' ;
    rdfs:comment 'Indicates whether dependent coverage is also being waived.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:spouseCoverageWaivedFlag rdf:type rdf:Property ;
    rdfs:label 'Spouse Coverage Waived Flag' ;
    rdfs:comment 'Indicates whether spouse coverage is being waived.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surchargeApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Surcharge Applicable Flag' ;
    rdfs:comment 'Indicates whether a surcharge applies if the waiver is not properly documented.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:surchargeAmount rdf:type rdf:Property ;
    rdfs:label 'Surcharge Amount' ;
    rdfs:comment 'Amount of surcharge applied if waiver documentation is not provided.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystemRecordReference rdf:type rdf:Property ;
    rdfs:label 'Source System Record Reference' ;
    rdfs:comment 'Unique identifier of the waiver record in the source system.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sepWindowId rdf:type rdf:Property ;
    rdfs:label 'Sep Window Id' ;
    rdfs:comment 'Unique identifier for the special enrollment period window configuration.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:windowDurationDays rdf:type rdf:Property ;
    rdfs:label 'Window Duration Days' ;
    rdfs:comment 'Number of days the special enrollment period window remains open from the qualifying life event date or notification date.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:windowStartTrigger rdf:type rdf:Property ;
    rdfs:label 'Window Start Trigger' ;
    rdfs:comment 'Event that triggers the start of the special enrollment period window (qualifying life event date, notification date, application date, approval date).' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windowStartOffsetDays rdf:type rdf:Property ;
    rdfs:label 'Window Start Offset Days' ;
    rdfs:comment 'Number of days before (negative) or after (positive) the trigger event that the special enrollment period window begins. Zero indicates the window starts on the trigger date.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageEffectiveDateRule rdf:type rdf:Property ;
    rdfs:label 'Coverage Effective Date Rule' ;
    rdfs:comment 'Business rule describing how the coverage effective date is calculated based on the enrollment date within the special enrollment period window (e.g., first of month following enrollment, retroactive to QLE date).' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retroactiveCoverageMaxDays rdf:type rdf:Property ;
    rdfs:label 'Retroactive Coverage Max Days' ;
    rdfs:comment 'Maximum number of days coverage can be backdated from the enrollment date if retroactive coverage is allowed.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentationSubmissionDeadlineDays rdf:type rdf:Property ;
    rdfs:label 'Documentation Submission Deadline Days' ;
    rdfs:comment 'Number of days from enrollment within which required documentation must be submitted to maintain coverage.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:preEnrollmentVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'Pre Enrollment Verification Required' ;
    rdfs:comment 'Indicates whether the qualifying life event must be verified before enrollment can be processed (versus post-enrollment verification).' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dependentEnrollmentScope rdf:type rdf:Property ;
    rdfs:label 'Dependent Enrollment Scope' ;
    rdfs:comment 'Defines which dependents are eligible for enrollment during this special enrollment period (all dependents, only those affected by the QLE, only new dependents, or none).' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Cms Reporting Required' ;
    rdfs:comment 'Indicates whether enrollments using this special enrollment period must be reported to CMS for regulatory compliance.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsSepCode rdf:type rdf:Property ;
    rdfs:label 'Cms Sep Code' ;
    rdfs:comment 'Official CMS code for this special enrollment period type used in regulatory reporting and EDI transactions.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulationReference rdf:type rdf:Property ;
    rdfs:label 'Regulation Reference' ;
    rdfs:comment 'Specific regulation, statute, or guidance document that defines the requirements for this special enrollment period (e.g., 45 CFR 155.420, CMS guidance memo).' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyYear rdf:type rdf:Property ;
    rdfs:label 'Policy Year' ;
    rdfs:comment 'Calendar year for which this special enrollment period window configuration applies, used for annual policy updates.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planYearAlignmentRequired rdf:type rdf:Property ;
    rdfs:label 'Plan Year Alignment Required' ;
    rdfs:comment 'Indicates whether coverage effective dates must align with the employer or plan year boundaries for this special enrollment period.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumPaymentDeadlineDays rdf:type rdf:Property ;
    rdfs:label 'Premium Payment Deadline Days' ;
    rdfs:comment 'Number of days from enrollment within which the first premium payment must be received to activate coverage.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aptcEligible rdf:type rdf:Property ;
    rdfs:label 'Aptc Eligible' ;
    rdfs:comment 'Indicates whether enrollments during this special enrollment period are eligible for advance premium tax credits in marketplace plans.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:csrEligible rdf:type rdf:Property ;
    rdfs:label 'Csr Eligible' ;
    rdfs:comment 'Indicates whether enrollments during this special enrollment period are eligible for cost-sharing reductions in marketplace plans.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attestationText rdf:type rdf:Property ;
    rdfs:label 'Attestation Text' ;
    rdfs:comment 'Standard attestation language that must be presented to and acknowledged by the member when enrolling under this special enrollment period.' ;
    rdfs:domain ind:SepWindow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceId rdf:type rdf:Property ;
    rdfs:label 'Source Id' ;
    rdfs:comment 'Unique identifier for the enrollment source record. Primary key for the source entity.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Source .

ind:exchangeStateCode rdf:type rdf:Property ;
    rdfs:label 'Exchange State Code' ;
    rdfs:comment 'Two-letter state code for state-based marketplace exchanges. Null for FFM or non-exchange sources.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerChannelFlag rdf:type rdf:Property ;
    rdfs:label 'Broker Channel Flag' ;
    rdfs:comment 'Indicates whether this enrollment source involves a licensed insurance broker or agent as an intermediary.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employerGroupFlag rdf:type rdf:Property ;
    rdfs:label 'Employer Group Flag' ;
    rdfs:comment 'Indicates whether this enrollment source is associated with employer-sponsored group coverage.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:governmentProgramFlag rdf:type rdf:Property ;
    rdfs:label 'Government Program Flag' ;
    rdfs:comment 'Indicates whether this enrollment source is associated with government programs such as Medicare, Medicaid, or CHIP.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:digitalChannelFlag rdf:type rdf:Property ;
    rdfs:label 'Digital Channel Flag' ;
    rdfs:comment 'Indicates whether this enrollment source is a digital channel (web portal, mobile app) versus traditional channels (mail, phone, in-person).' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:selfServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Self Service Flag' ;
    rdfs:comment 'Indicates whether this enrollment source allows members to complete enrollment without human assistance.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:productPortfolioScope rdf:type rdf:Property ;
    rdfs:label 'Product Portfolio Scope' ;
    rdfs:comment 'Indicates whether this enrollment source provides access to all available products, a limited portfolio, or specific designated products only.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qleSupportFlag rdf:type rdf:Property ;
    rdfs:label 'Qle Support Flag' ;
    rdfs:comment 'Indicates whether this enrollment source supports special enrollment periods triggered by qualifying life events such as marriage, birth, loss of coverage, or relocation.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraSupportFlag rdf:type rdf:Property ;
    rdfs:label 'Cobra Support Flag' ;
    rdfs:comment 'Indicates whether this enrollment source supports COBRA continuation coverage enrollments for qualified beneficiaries.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subsidyEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Subsidy Eligibility Flag' ;
    rdfs:comment 'Indicates whether enrollments through this source are eligible for premium subsidies, tax credits, or cost-sharing reductions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aptcSupportFlag rdf:type rdf:Property ;
    rdfs:label 'Aptc Support Flag' ;
    rdfs:comment 'Indicates whether this enrollment source supports Advanced Premium Tax Credit processing for marketplace enrollments.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:apiIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Api Integration Flag' ;
    rdfs:comment 'Indicates whether this enrollment source uses API-based integration for real-time enrollment processing.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:realTimeEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Real Time Eligibility Flag' ;
    rdfs:comment 'Indicates whether this enrollment source provides real-time eligibility verification during the enrollment process.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Commission Eligible Flag' ;
    rdfs:comment 'Indicates whether enrollments through this source are eligible for broker or agent commission payments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partnerOrganizationName rdf:type rdf:Property ;
    rdfs:label 'Partner Organization Name' ;
    rdfs:comment 'Name of the external partner organization operating this enrollment source (e.g., broker firm, exchange operator, employer).' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partnerTin rdf:type rdf:Property ;
    rdfs:label 'Partner Tin' ;
    rdfs:comment 'Tax Identification Number of the partner organization for commission payments and tax reporting.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partnerNpi rdf:type rdf:Property ;
    rdfs:label 'Partner Npi' ;
    rdfs:comment 'National Provider Identifier for partner organizations that are healthcare providers or entities.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeZone rdf:type rdf:Property ;
    rdfs:label 'Time Zone' ;
    rdfs:comment 'Time zone identifier for the enrollment source location for scheduling and processing coordination.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityCertification rdf:type rdf:Property ;
    rdfs:label 'Security Certification' ;
    rdfs:comment 'Security certifications held by this enrollment source (e.g., SOC 2, ISO 27001, HITRUST).' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRetentionDays rdf:type rdf:Property ;
    rdfs:label 'Data Retention Days' ;
    rdfs:comment 'Number of days enrollment data from this source is retained before archival or deletion per data governance policies.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enhancedVerificationFlag rdf:type rdf:Property ;
    rdfs:label 'Enhanced Verification Flag' ;
    rdfs:comment 'Indicates whether enrollments from this source require enhanced identity verification or fraud screening.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enrollmentVolumeYtd rdf:type rdf:Property ;
    rdfs:label 'Enrollment Volume Ytd' ;
    rdfs:comment 'Total number of enrollments processed through this source in the current calendar year.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enrollmentVolumePriorYear rdf:type rdf:Property ;
    rdfs:label 'Enrollment Volume Prior Year' ;
    rdfs:comment 'Total number of enrollments processed through this source in the prior calendar year for trend analysis.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:errorRatePercent rdf:type rdf:Property ;
    rdfs:label 'Error Rate Percent' ;
    rdfs:comment 'Percentage of enrollments from this source that encounter errors or require rework, used for quality monitoring.' ;
    rdfs:domain ind:Source ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminationReasonId rdf:type rdf:Property ;
    rdfs:label 'Termination Reason Id' ;
    rdfs:comment 'Unique identifier for the enrollment termination reason record.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TerminationReason .

ind:isMemberInitiated rdf:type rdf:Property ;
    rdfs:label 'Is Member Initiated' ;
    rdfs:comment 'Indicates whether the termination was initiated by the member versus the employer or carrier.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEmployerInitiated rdf:type rdf:Property ;
    rdfs:label 'Is Employer Initiated' ;
    rdfs:comment 'Indicates whether the termination was initiated by the employer group.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCarrierInitiated rdf:type rdf:Property ;
    rdfs:label 'Is Carrier Initiated' ;
    rdfs:comment 'Indicates whether the termination was initiated by the insurance carrier.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresNotice rdf:type rdf:Property ;
    rdfs:label 'Requires Notice' ;
    rdfs:comment 'Indicates whether this termination reason requires advance notice to the member per regulatory or contractual requirements.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noticeDaysRequired rdf:type rdf:Property ;
    rdfs:label 'Notice Days Required' ;
    rdfs:comment 'Number of days advance notice required before termination becomes effective for this reason.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allowsCobraContinuation rdf:type rdf:Property ;
    rdfs:label 'Allows Cobra Continuation' ;
    rdfs:comment 'Indicates whether members terminated for this reason are eligible for COBRA continuation coverage.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:allowsSpecialEnrollment rdf:type rdf:Property ;
    rdfs:label 'Allows Special Enrollment' ;
    rdfs:comment 'Indicates whether this termination reason qualifies the member for a special enrollment period in another plan.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresRefund rdf:type rdf:Property ;
    rdfs:label 'Requires Refund' ;
    rdfs:comment 'Indicates whether this termination reason requires refund of unearned premium to the member or employer.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refundCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Refund Calculation Method' ;
    rdfs:comment 'Method used to calculate premium refund amount when termination occurs mid-period.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactsMlr rdf:type rdf:Property ;
    rdfs:label 'Impacts Mlr' ;
    rdfs:comment 'Indicates whether terminations for this reason impact Medical Loss Ratio calculations and rebate requirements.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isQualifyingLifeEvent rdf:type rdf:Property ;
    rdfs:label 'Is Qualifying Life Event' ;
    rdfs:comment 'Indicates whether this termination reason constitutes a qualifying life event for enrollment purposes.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qleType rdf:type rdf:Property ;
    rdfs:label 'Qle Type' ;
    rdfs:comment 'Classification of the qualifying life event type if this termination reason constitutes a QLE.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresAttestation rdf:type rdf:Property ;
    rdfs:label 'Requires Attestation' ;
    rdfs:comment 'Indicates whether member attestation or documentation is required to process termination for this reason.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:attestationType rdf:type rdf:Property ;
    rdfs:label 'Attestation Type' ;
    rdfs:comment 'Type of attestation or documentation required from the member to support the termination reason.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowsReinstatement rdf:type rdf:Property ;
    rdfs:label 'Allows Reinstatement' ;
    rdfs:comment 'Indicates whether members terminated for this reason can be reinstated without re-enrollment.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresClaimsRunout rdf:type rdf:Property ;
    rdfs:label 'Requires Claims Runout' ;
    rdfs:comment 'Indicates whether claims incurred before termination can be submitted during a runout period.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimsRunoutDays rdf:type rdf:Property ;
    rdfs:label 'Claims Runout Days' ;
    rdfs:comment 'Number of days after termination during which claims for services rendered before termination can be submitted.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:impactsRiskAdjustment rdf:type rdf:Property ;
    rdfs:label 'Impacts Risk Adjustment' ;
    rdfs:comment 'Indicates whether terminations for this reason impact risk adjustment calculations and Hierarchical Condition Category (HCC) reporting.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsReportingCode rdf:type rdf:Property ;
    rdfs:label 'Cms Reporting Code' ;
    rdfs:comment 'Standard code used for reporting this termination reason to CMS for Medicare Advantage and Part D plans.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliesToIndividual rdf:type rdf:Property ;
    rdfs:label 'Applies To Individual' ;
    rdfs:comment 'Indicates whether this termination reason applies to individual market plans.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToSmallGroup rdf:type rdf:Property ;
    rdfs:label 'Applies To Small Group' ;
    rdfs:comment 'Indicates whether this termination reason applies to small group employer plans.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToLargeGroup rdf:type rdf:Property ;
    rdfs:label 'Applies To Large Group' ;
    rdfs:comment 'Indicates whether this termination reason applies to large group employer plans.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToMarketplace rdf:type rdf:Property ;
    rdfs:label 'Applies To Marketplace' ;
    rdfs:comment 'Indicates whether this termination reason applies to Qualified Health Plans (QHP) sold through federal or state marketplaces.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresSubsidyReconciliation rdf:type rdf:Property ;
    rdfs:label 'Requires Subsidy Reconciliation' ;
    rdfs:comment 'Indicates whether terminations for this reason require reconciliation of Advanced Premium Tax Credits (APTC) with the marketplace.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triggersDisenrollmentNotice rdf:type rdf:Property ;
    rdfs:label 'Triggers Disenrollment Notice' ;
    rdfs:comment 'Indicates whether this termination reason automatically triggers generation of a disenrollment notice to the member.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresAppealRightsNotice rdf:type rdf:Property ;
    rdfs:label 'Requires Appeal Rights Notice' ;
    rdfs:comment 'Indicates whether members must be notified of their appeal rights when terminated for this reason.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealDeadlineDays rdf:type rdf:Property ;
    rdfs:label 'Appeal Deadline Days' ;
    rdfs:comment 'Number of days the member has to file an appeal of the termination decision.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isReportableToExchange rdf:type rdf:Property ;
    rdfs:label 'Is Reportable To Exchange' ;
    rdfs:comment 'Indicates whether this termination must be reported to the health insurance exchange (FFM or SBM).' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impactsCommission rdf:type rdf:Property ;
    rdfs:label 'Impacts Commission' ;
    rdfs:comment 'Indicates whether terminations for this reason impact agent or broker commission calculations.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionAdjustmentRule rdf:type rdf:Property ;
    rdfs:label 'Commission Adjustment Rule' ;
    rdfs:comment 'Rule determining how agent commissions are adjusted when a member is terminated for this reason.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFraudRelated rdf:type rdf:Property ;
    rdfs:label 'Is Fraud Related' ;
    rdfs:comment 'Indicates whether this termination reason is related to suspected or confirmed fraud, waste, or abuse.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresSiuReview rdf:type rdf:Property ;
    rdfs:label 'Requires Siu Review' ;
    rdfs:comment 'Indicates whether terminations for this reason require review by the Special Investigations Unit.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isVoluntaryDisenrollment rdf:type rdf:Property ;
    rdfs:label 'Is Voluntary Disenrollment' ;
    rdfs:comment 'Indicates whether this termination represents a voluntary disenrollment by the member.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isInvoluntaryDisenrollment rdf:type rdf:Property ;
    rdfs:label 'Is Involuntary Disenrollment' ;
    rdfs:comment 'Indicates whether this termination represents an involuntary disenrollment not initiated by the member.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresGoodCauseDetermination rdf:type rdf:Property ;
    rdfs:label 'Requires Good Cause Determination' ;
    rdfs:comment 'Indicates whether a good cause determination is required before processing termination for this reason (primarily for Medicaid).' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDeathRelated rdf:type rdf:Property ;
    rdfs:label 'Is Death Related' ;
    rdfs:comment 'Indicates whether this termination reason is due to the death of the member.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresDeathCertificate rdf:type rdf:Property ;
    rdfs:label 'Requires Death Certificate' ;
    rdfs:comment 'Indicates whether a death certificate must be obtained to process termination for this reason.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triggersBeneficiaryNotification rdf:type rdf:Property ;
    rdfs:label 'Triggers Beneficiary Notification' ;
    rdfs:comment 'Indicates whether this termination reason triggers notification to designated beneficiaries or estate representatives.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legacyCode rdf:type rdf:Property ;
    rdfs:label 'Legacy Code' ;
    rdfs:comment 'Termination reason code from legacy systems maintained for historical data reconciliation.' ;
    rdfs:domain ind:TerminationReason ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planOptionId rdf:type rdf:Property ;
    rdfs:label 'Plan Option Id' ;
    rdfs:comment 'Unique identifier for the plan option. Primary key for the plan option entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PlanOption .

ind:individualDeductibleInNetwork rdf:type rdf:Property ;
    rdfs:label 'Individual Deductible In Network' ;
    rdfs:comment 'Annual deductible amount that an individual member must pay for in-network covered services before the plan begins cost-sharing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:individualDeductibleOutOfNetwork rdf:type rdf:Property ;
    rdfs:label 'Individual Deductible Out Of Network' ;
    rdfs:comment 'Annual deductible amount that an individual member must pay for out-of-network covered services before the plan begins cost-sharing.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:familyDeductibleInNetwork rdf:type rdf:Property ;
    rdfs:label 'Family Deductible In Network' ;
    rdfs:comment 'Annual deductible amount that a family must collectively pay for in-network covered services before the plan begins cost-sharing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:familyDeductibleOutOfNetwork rdf:type rdf:Property ;
    rdfs:label 'Family Deductible Out Of Network' ;
    rdfs:comment 'Annual deductible amount that a family must collectively pay for out-of-network covered services before the plan begins cost-sharing.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:individualOopMaxInNetwork rdf:type rdf:Property ;
    rdfs:label 'Individual Oop Max In Network' ;
    rdfs:comment 'Maximum annual amount an individual member will pay for in-network covered services. OOP (Out of Pocket).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:individualOopMaxOutOfNetwork rdf:type rdf:Property ;
    rdfs:label 'Individual Oop Max Out Of Network' ;
    rdfs:comment 'Maximum annual amount an individual member will pay for out-of-network covered services. OOP (Out of Pocket).' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:familyOopMaxInNetwork rdf:type rdf:Property ;
    rdfs:label 'Family Oop Max In Network' ;
    rdfs:comment 'Maximum annual amount a family will collectively pay for in-network covered services. OOP (Out of Pocket).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:familyOopMaxOutOfNetwork rdf:type rdf:Property ;
    rdfs:label 'Family Oop Max Out Of Network' ;
    rdfs:comment 'Maximum annual amount a family will collectively pay for out-of-network covered services. OOP (Out of Pocket).' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coinsuranceInNetwork rdf:type rdf:Property ;
    rdfs:label 'Coinsurance In Network' ;
    rdfs:comment 'Percentage of covered service costs that the member pays after meeting the deductible for in-network services (e.g., 20.00 for 20%).' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coinsuranceOutOfNetwork rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Out Of Network' ;
    rdfs:comment 'Percentage of covered service costs that the member pays after meeting the deductible for out-of-network services (e.g., 40.00 for 40%).' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pcpCopay rdf:type rdf:Property ;
    rdfs:label 'Pcp Copay' ;
    rdfs:comment 'Fixed dollar amount the member pays for a Primary Care Physician (PCP) office visit.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prescriptionGenericCopay rdf:type rdf:Property ;
    rdfs:label 'Prescription Generic Copay' ;
    rdfs:comment 'Fixed dollar amount the member pays for generic prescription drugs.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prescriptionPreferredBrandCopay rdf:type rdf:Property ;
    rdfs:label 'Prescription Preferred Brand Copay' ;
    rdfs:comment 'Fixed dollar amount the member pays for preferred brand-name prescription drugs.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prescriptionNonPreferredBrandCopay rdf:type rdf:Property ;
    rdfs:label 'Prescription Non Preferred Brand Copay' ;
    rdfs:comment 'Fixed dollar amount the member pays for non-preferred brand-name prescription drugs.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prescriptionSpecialtyCopay rdf:type rdf:Property ;
    rdfs:label 'Prescription Specialty Copay' ;
    rdfs:comment 'Fixed dollar amount or coinsurance the member pays for specialty prescription drugs.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preventiveCareCovered rdf:type rdf:Property ;
    rdfs:label 'Preventive Care Covered' ;
    rdfs:comment 'Indicates whether preventive care services are covered at 100% with no cost-sharing as required by ACA (Affordable Care Act).' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mentalHealthCoverageIncluded rdf:type rdf:Property ;
    rdfs:label 'Mental Health Coverage Included' ;
    rdfs:comment 'Indicates whether mental health and substance use disorder services are covered under the plan. MH (Mental Health).' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maternityCoverageIncluded rdf:type rdf:Property ;
    rdfs:label 'Maternity Coverage Included' ;
    rdfs:comment 'Indicates whether maternity and newborn care services are covered under the plan.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prescriptionDrugCoverageIncluded rdf:type rdf:Property ;
    rdfs:label 'Prescription Drug Coverage Included' ;
    rdfs:comment 'Indicates whether prescription drug benefits are included in the plan option.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:telehealthCoverageIncluded rdf:type rdf:Property ;
    rdfs:label 'Telehealth Coverage Included' ;
    rdfs:comment 'Indicates whether telehealth or telemedicine services are covered under the plan option.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pcpReferralRequired rdf:type rdf:Property ;
    rdfs:label 'Pcp Referral Required' ;
    rdfs:comment 'Indicates whether the plan requires a Primary Care Physician (PCP) referral to see specialists.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lifetimeMaximum rdf:type rdf:Property ;
    rdfs:label 'Lifetime Maximum' ;
    rdfs:comment 'Maximum dollar amount the plan will pay over the member\'s lifetime. ACA (Affordable Care Act) prohibits lifetime limits on essential health benefits.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualMaximum rdf:type rdf:Property ;
    rdfs:label 'Annual Maximum' ;
    rdfs:comment 'Maximum dollar amount the plan will pay in a plan year. ACA (Affordable Care Act) prohibits annual limits on essential health benefits.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicareContractNumber rdf:type rdf:Property ;
    rdfs:label 'Medicare Contract Number' ;
    rdfs:comment 'CMS (Centers for Medicare and Medicaid Services) assigned contract number for Medicare Advantage or Part D plans.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicarePlanBenefitPackage rdf:type rdf:Property ;
    rdfs:label 'Medicare Plan Benefit Package' ;
    rdfs:comment 'Three-digit Plan Benefit Package (PBP) identifier assigned by CMS (Centers for Medicare and Medicaid Services) for Medicare plans.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicareSegmentNumber rdf:type rdf:Property ;
    rdfs:label 'Medicare Segment Number' ;
    rdfs:comment 'Three-digit segment identifier for Medicare plans indicating geographic or benefit variations.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qhpIdentifier rdf:type rdf:Property ;
    rdfs:label 'Qhp Identifier' ;
    rdfs:comment '14-digit unique identifier assigned to Qualified Health Plans (QHP) sold on ACA (Affordable Care Act) exchanges.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuerState rdf:type rdf:Property ;
    rdfs:label 'Issuer State' ;
    rdfs:comment 'Two-letter state code where the plan is issued and regulated.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractServiceAreaId rdf:type rdf:Property ;
    rdfs:label 'Contract Service Area Id' ;
    rdfs:comment 'Identifier for the geographic service area where the plan option is available.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContractServiceArea .

ind:employerContributionEligible rdf:type rdf:Property ;
    rdfs:label 'Employer Contribution Eligible' ;
    rdfs:comment 'Indicates whether the plan option is eligible for employer premium contributions.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumEssentialCoverage rdf:type rdf:Property ;
    rdfs:label 'Minimum Essential Coverage' ;
    rdfs:comment 'Indicates whether the plan meets ACA (Affordable Care Act) Minimum Essential Coverage (MEC) requirements.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:affordabilitySafeHarborMet rdf:type rdf:Property ;
    rdfs:label 'Affordability Safe Harbor Met' ;
    rdfs:comment 'Indicates whether the plan meets ACA (Affordable Care Act) employer affordability safe harbor requirements.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grandfatheredPlan rdf:type rdf:Property ;
    rdfs:label 'Grandfathered Plan' ;
    rdfs:comment 'Indicates whether the plan is grandfathered under ACA (Affordable Care Act) and exempt from certain requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planBrochureUrl rdf:type rdf:Property ;
    rdfs:label 'Plan Brochure Url' ;
    rdfs:comment 'Web address where the plan brochure or Summary of Benefits and Coverage (SBC) document can be accessed.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Plan Document Url' ;
    rdfs:comment 'Web address where the full plan document or Evidence of Coverage (EOC) can be accessed.' ;
    rdfs:domain ind:PlanOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobraContinuationId rdf:type rdf:Property ;
    rdfs:label 'Cobra Continuation Id' ;
    rdfs:comment 'Unique identifier for the COBRA continuation enrollment record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CobraContinuation .

ind:electionPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Election Period Start Date' ;
    rdfs:comment 'The start date of the 60-day election period during which the member can elect COBRA coverage.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electionPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Election Period End Date' ;
    rdfs:comment 'The end date of the 60-day election period during which the member can elect COBRA coverage.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maximumCoverageDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Maximum Coverage Duration Months' ;
    rdfs:comment 'The maximum number of months the member is eligible for COBRA continuation coverage (typically 18, 29, or 36 months depending on qualifying event).' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disabilityExtensionIndicator rdf:type rdf:Property ;
    rdfs:label 'Disability Extension Indicator' ;
    rdfs:comment 'Indicates whether the member qualifies for the 11-month disability extension of COBRA coverage (total 29 months).' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondQualifyingEventIndicator rdf:type rdf:Property ;
    rdfs:label 'Second Qualifying Event Indicator' ;
    rdfs:comment 'Indicates whether a second qualifying event occurred during the initial COBRA period, extending coverage to 36 months.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondQualifyingEventDate rdf:type rdf:Property ;
    rdfs:label 'Second Qualifying Event Date' ;
    rdfs:comment 'The date on which the second qualifying event occurred.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:monthlyPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Monthly Premium Amount' ;
    rdfs:comment 'The monthly premium amount the member must pay for COBRA continuation coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalMonthlyCost rdf:type rdf:Property ;
    rdfs:label 'Total Monthly Cost' ;
    rdfs:comment 'The total monthly cost including premium and administrative fee for COBRA continuation coverage.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tpaName rdf:type rdf:Property ;
    rdfs:label 'Tpa Name' ;
    rdfs:comment 'The name of the third-party administrator managing COBRA administration, if applicable.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initialNoticeSentDate rdf:type rdf:Property ;
    rdfs:label 'Initial Notice Sent Date' ;
    rdfs:comment 'The date on which the initial COBRA rights notice was sent to the member.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electionNoticeSentDate rdf:type rdf:Property ;
    rdfs:label 'Election Notice Sent Date' ;
    rdfs:comment 'The date on which the COBRA election notice was sent to the member following the qualifying event.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:delinquentIndicator rdf:type rdf:Property ;
    rdfs:label 'Delinquent Indicator' ;
    rdfs:comment 'Indicates whether the member has delinquent premium payments.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:delinquencyDate rdf:type rdf:Property ;
    rdfs:label 'Delinquency Date' ;
    rdfs:comment 'The date on which the member became delinquent on premium payments.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationNoticeSentDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Notice Sent Date' ;
    rdfs:comment 'The date on which a cancellation notice was sent to the member for non-payment or other termination reason.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reinstatementEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Eligible Indicator' ;
    rdfs:comment 'Indicates whether the member is eligible to reinstate COBRA coverage after termination.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalCoverageEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Original Coverage Effective Date' ;
    rdfs:comment 'The original effective date of coverage under the employer group plan before COBRA continuation.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalCoverageTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Original Coverage Termination Date' ;
    rdfs:comment 'The date on which the original employer group coverage terminated, triggering COBRA eligibility.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicareEntitledIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicare Entitled Indicator' ;
    rdfs:comment 'Indicates whether the member became entitled to Medicare, which may affect COBRA eligibility or duration.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareEntitlementDate rdf:type rdf:Property ;
    rdfs:label 'Medicare Entitlement Date' ;
    rdfs:comment 'The date on which the member became entitled to Medicare benefits.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:otherGroupCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Other Group Coverage Indicator' ;
    rdfs:comment 'Indicates whether the member obtained other group health coverage, which may terminate COBRA eligibility.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:otherGroupCoverageEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Other Group Coverage Effective Date' ;
    rdfs:comment 'The effective date of other group health coverage obtained by the member.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:specialEnrollmentPeriodIndicator rdf:type rdf:Property ;
    rdfs:label 'Special Enrollment Period Indicator' ;
    rdfs:comment 'Indicates whether the member is eligible for a special enrollment period in the marketplace due to loss of COBRA coverage.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketplaceNotificationSentIndicator rdf:type rdf:Property ;
    rdfs:label 'Marketplace Notification Sent Indicator' ;
    rdfs:comment 'Indicates whether the member was notified of marketplace coverage options as required by ACA.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketplaceNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Marketplace Notification Date' ;
    rdfs:comment 'The date on which the member was notified of marketplace coverage options.' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectivePeriodId rdf:type rdf:Property ;
    rdfs:label 'Effective Period Id' ;
    rdfs:comment 'Unique identifier for each effective period instance within an enrollment record. Serves as the primary key for tracking distinct coverage periods.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalStartDate rdf:type rdf:Property ;
    rdfs:label 'Original Start Date' ;
    rdfs:comment 'The original start date of the enrollment period before any mid-term changes or adjustments. Used for tracking enrollment history and retroactive adjustments.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodType rdf:type rdf:Property ;
    rdfs:label 'Period Type' ;
    rdfs:comment 'Classification of the enrollment period indicating how it was initiated (initial enrollment, annual renewal, qualifying life event change, COBRA continuation, special enrollment period, etc.).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentPeriodCategory rdf:type rdf:Property ;
    rdfs:label 'Enrollment Period Category' ;
    rdfs:comment 'The regulatory enrollment period category under which this effective period was established (Annual Enrollment Period, Open Enrollment Period, Special Enrollment Period, Initial Coverage Election Period, Open Enrollment Initial Period, Continuous Enrollment).' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aepYear rdf:type rdf:Property ;
    rdfs:label 'Aep Year' ;
    rdfs:comment 'The calendar year of the Annual Enrollment Period during which this enrollment was processed, if applicable to Medicare Advantage or Part D plans.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sepEligibilityVerified rdf:type rdf:Property ;
    rdfs:label 'Sep Eligibility Verified' ;
    rdfs:comment 'Indicates whether the member\'s eligibility for a Special Enrollment Period was verified and approved by the carrier or exchange.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraMaximumPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Cobra Maximum Period Months' ;
    rdfs:comment 'The maximum number of months of COBRA continuation coverage available based on the qualifying event type (typically 18, 29, or 36 months).' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retroactiveReason rdf:type rdf:Property ;
    rdfs:label 'Retroactive Reason' ;
    rdfs:comment 'Explanation for why retroactive coverage was granted, including regulatory or contractual justification.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waitingPeriodWaived rdf:type rdf:Property ;
    rdfs:label 'Waiting Period Waived' ;
    rdfs:comment 'Indicates whether the standard waiting period was waived for this enrollment (e.g., due to prior creditable coverage or special circumstances).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorCoverageCreditApplied rdf:type rdf:Property ;
    rdfs:label 'Prior Coverage Credit Applied' ;
    rdfs:comment 'Indicates whether credit for prior creditable coverage was applied to reduce or eliminate waiting periods or pre-existing condition exclusions.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorCoverageMonths rdf:type rdf:Property ;
    rdfs:label 'Prior Coverage Months' ;
    rdfs:comment 'The number of months of prior creditable coverage documented and applied to this enrollment period.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageLevelCode rdf:type rdf:Property ;
    rdfs:label 'Coverage Level Code' ;
    rdfs:comment 'Standardized three-character code representing the coverage level (e.g., EMP for employee only, ESP for employee and spouse, FAM for family).' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitStatus rdf:type rdf:Property ;
    rdfs:label 'Benefit Status' ;
    rdfs:comment 'The current status of benefits for this effective period (active coverage, suspended due to non-payment, terminated, pending activation, cancelled, lapsed).' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voluntaryTerminationIndicator rdf:type rdf:Property ;
    rdfs:label 'Voluntary Termination Indicator' ;
    rdfs:comment 'Indicates whether the coverage termination was initiated voluntarily by the member or involuntarily by the carrier or employer.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastExtensionDate rdf:type rdf:Property ;
    rdfs:label 'Last Extension Date' ;
    rdfs:comment 'The date when the most recent extension to this effective period was processed.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:autoRenewalIndicator rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Indicator' ;
    rdfs:comment 'Indicates whether this enrollment period was automatically renewed without explicit member action (passive renewal).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:passiveRenewalIndicator rdf:type rdf:Property ;
    rdfs:label 'Passive Renewal Indicator' ;
    rdfs:comment 'Indicates whether the member was passively renewed into the same or similar plan without taking action during open enrollment.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benefitEndDate rdf:type rdf:Property ;
    rdfs:label 'Benefit End Date' ;
    rdfs:comment 'The date when benefits cease to be available, which may differ from the effective end date due to run-out periods or grace periods.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:premiumPaymentResponsibility rdf:type rdf:Property ;
    rdfs:label 'Premium Payment Responsibility' ;
    rdfs:comment 'Indicates who is responsible for premium payment during this effective period (member, employer, government subsidy, shared responsibility, third-party payer).' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aptcAppliedIndicator rdf:type rdf:Property ;
    rdfs:label 'Aptc Applied Indicator' ;
    rdfs:comment 'Indicates whether Advanced Premium Tax Credits are being applied to reduce member premium payments during this effective period.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:csrAppliedIndicator rdf:type rdf:Property ;
    rdfs:label 'Csr Applied Indicator' ;
    rdfs:comment 'Indicates whether Cost Sharing Reductions are applied to this enrollment, reducing out-of-pocket costs for eligible members.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subsidyEligibilityVerified rdf:type rdf:Property ;
    rdfs:label 'Subsidy Eligibility Verified' ;
    rdfs:comment 'Indicates whether the member\'s eligibility for premium subsidies or cost-sharing reductions has been verified by the exchange or CMS.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuerAssignedPolicyId rdf:type rdf:Property ;
    rdfs:label 'Issuer Assigned Policy Id' ;
    rdfs:comment 'The unique policy identifier assigned by the insurance carrier (issuer) for this enrollment period, distinct from exchange-assigned identifiers.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Policy .

ind:issuerAssignedMemberNumber rdf:type rdf:Property ;
    rdfs:label 'Issuer Assigned Member Number' ;
    rdfs:comment 'The unique member identifier assigned by the insurance carrier for this enrollment period.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Group Policy Number' ;
    rdfs:comment 'The policy number for the employer group or association under which this enrollment is covered, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stopLossCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Stop Loss Coverage Indicator' ;
    rdfs:comment 'Indicates whether stop-loss insurance coverage is in place for this enrollment period, typically applicable to self-funded arrangements.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:edi834TransactionReference rdf:type rdf:Property ;
    rdfs:label 'Edi 834 Transaction Reference' ;
    rdfs:comment 'The unique identifier for the HIPAA 834 Benefit Enrollment and Maintenance transaction that established or modified this effective period.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Received Date' ;
    rdfs:comment 'The date when the enrollment application or change request was received by the carrier or exchange.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentProcessedDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Processed Date' ;
    rdfs:comment 'The date when the enrollment was fully processed and the effective period was established in the system.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentConfirmedDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Confirmed Date' ;
    rdfs:comment 'The date when enrollment confirmation was sent to the member, employer, or exchange.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstPremiumPaymentDueDate rdf:type rdf:Property ;
    rdfs:label 'First Premium Payment Due Date' ;
    rdfs:comment 'The date by which the first premium payment must be received to activate coverage for this effective period.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstPremiumPaymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'First Premium Payment Received Date' ;
    rdfs:comment 'The date when the first premium payment (binder payment) was received, confirming activation of coverage.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:binderPaymentRequired rdf:type rdf:Property ;
    rdfs:label 'Binder Payment Required' ;
    rdfs:comment 'Indicates whether a binder payment (first premium payment) is required before coverage can become effective for this enrollment period.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lateEnrollmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Late Enrollment Indicator' ;
    rdfs:comment 'Indicates whether this enrollment was submitted after the standard enrollment deadline, potentially subject to late enrollment penalties or restrictions.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lateEnrollmentPenaltyMonths rdf:type rdf:Property ;
    rdfs:label 'Late Enrollment Penalty Months' ;
    rdfs:comment 'The number of months of late enrollment penalty applied to this enrollment, typically for Medicare Part D late enrollment.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:underwritingRequired rdf:type rdf:Property ;
    rdfs:label 'Underwriting Required' ;
    rdfs:comment 'Indicates whether medical underwriting was required for this enrollment period (typically not allowed for ACA-compliant plans but may apply to grandfathered or excepted benefit plans).' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:underwritingDecision rdf:type rdf:Property ;
    rdfs:label 'Underwriting Decision' ;
    rdfs:comment 'The underwriting decision for this enrollment (approved, declined, modified with exclusions, pending review, not applicable).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Underwriting Decision Date' ;
    rdfs:comment 'The date when the underwriting decision was made for this enrollment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:preExistingConditionExclusionEndDate rdf:type rdf:Property ;
    rdfs:label 'Pre Existing Condition Exclusion End Date' ;
    rdfs:comment 'The date when any pre-existing condition exclusion period ends and full coverage becomes effective.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tobaccoSurchargeApplied rdf:type rdf:Property ;
    rdfs:label 'Tobacco Surcharge Applied' ;
    rdfs:comment 'Indicates whether a tobacco use surcharge is applied to premiums for this enrollment period.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wellnessProgramParticipation rdf:type rdf:Property ;
    rdfs:label 'Wellness Program Participation' ;
    rdfs:comment 'Indicates whether the member is participating in employer or plan-sponsored wellness programs that may affect premium rates or benefits.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wellnessIncentiveApplied rdf:type rdf:Property ;
    rdfs:label 'Wellness Incentive Applied' ;
    rdfs:comment 'Indicates whether wellness program incentives (premium discounts, reduced cost-sharing) are applied to this enrollment period.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaSpecialEnrollmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Hipaa Special Enrollment Indicator' ;
    rdfs:comment 'Indicates whether this enrollment qualifies as a HIPAA special enrollment event, allowing enrollment outside normal enrollment periods.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:chipEligibilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Chip Eligibility Indicator' ;
    rdfs:comment 'Indicates whether the member is eligible for CHIP coverage during this enrollment period.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lisCopayCategory rdf:type rdf:Property ;
    rdfs:label 'Lis Copay Category' ;
    rdfs:comment 'The two-digit copay category code for Low Income Subsidy members, determining cost-sharing levels for Part D drugs.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hospiceElectionIndicator rdf:type rdf:Property ;
    rdfs:label 'Hospice Election Indicator' ;
    rdfs:comment 'Indicates whether the member has elected hospice care, which affects Medicare coverage and enrollment status.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ltssEligibilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Ltss Eligibility Indicator' ;
    rdfs:comment 'Indicates whether the member is eligible for Long Term Services and Supports under Medicaid managed care.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mltssEnrollmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Mltss Enrollment Indicator' ;
    rdfs:comment 'Indicates whether the member is enrolled in a Managed Long Term Services and Supports program.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paceEnrollmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Pace Enrollment Indicator' ;
    rdfs:comment 'Indicates whether the member is enrolled in a PACE program providing comprehensive medical and social services.' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSourceIndicator rdf:type rdf:Property ;
    rdfs:label 'Data Source Indicator' ;
    rdfs:comment 'Indicates the original source of the enrollment data for this effective period (employer file, exchange 834 transaction, direct application, broker, etc.).' ;
    rdfs:domain ind:EffectivePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressId rdf:type rdf:Property ;
    rdfs:label 'Address Id' ;
    rdfs:comment 'Unique identifier for the address record. Primary key for the address entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Address .

ind:line1 rdf:type rdf:Property ;
    rdfs:label 'Line 1' ;
    rdfs:comment 'Primary street address line containing street number, street name, and unit/apartment number if applicable.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:line2 rdf:type rdf:Property ;
    rdfs:label 'Line 2' ;
    rdfs:comment 'Secondary address line for additional location information such as suite, building, floor, or department.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:line3 rdf:type rdf:Property ;
    rdfs:label 'Line 3' ;
    rdfs:comment 'Tertiary address line for additional location details if needed for complex addresses.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateName rdf:type rdf:Property ;
    rdfs:label 'State Name' ;
    rdfs:comment 'Full name of the state or province where the address is located.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zipCodeExtension rdf:type rdf:Property ;
    rdfs:label 'Zip Code Extension' ;
    rdfs:comment 'Four-digit extension to the five-digit ZIP code providing more precise geographic location (ZIP+4).' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geocodeAccuracy rdf:type rdf:Property ;
    rdfs:label 'Geocode Accuracy' ;
    rdfs:comment 'Indicates the precision level of the geocoded coordinates (e.g., rooftop, range interpolated, geometric center).' ;
    rdfs:domain ind:Member ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geocodeSource rdf:type rdf:Property ;
    rdfs:label 'Geocode Source' ;
    rdfs:comment 'Name of the geocoding service or system that provided the latitude and longitude coordinates.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geocodeDate rdf:type rdf:Property ;
    rdfs:label 'Geocode Date' ;
    rdfs:comment 'Date when the address was geocoded to obtain latitude and longitude coordinates.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:standardizedFlag rdf:type rdf:Property ;
    rdfs:label 'Standardized Flag' ;
    rdfs:comment 'Indicates whether the address has been validated and standardized against USPS or other postal authority standards.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:standardizationDate rdf:type rdf:Property ;
    rdfs:label 'Standardization Date' ;
    rdfs:comment 'Date when the address was last validated and standardized against postal authority standards.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deliveryPointBarcode rdf:type rdf:Property ;
    rdfs:label 'Delivery Point Barcode' ;
    rdfs:comment 'Two-digit code assigned by USPS that identifies a specific delivery point within a ZIP+4 code.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierRoute rdf:type rdf:Property ;
    rdfs:label 'Carrier Route' ;
    rdfs:comment 'Four-character code identifying the USPS carrier route for mail delivery to this address.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:congressionalDistrict rdf:type rdf:Property ;
    rdfs:label 'Congressional District' ;
    rdfs:comment 'Two-digit code identifying the U.S. Congressional district where the address is located.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:censusTract rdf:type rdf:Property ;
    rdfs:label 'Census Tract' ;
    rdfs:comment 'Census tract identifier for the address location used for demographic and socioeconomic analysis.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:censusBlockGroup rdf:type rdf:Property ;
    rdfs:label 'Census Block Group' ;
    rdfs:comment 'Census block group identifier providing finer geographic granularity than census tract.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Flag' ;
    rdfs:comment 'Indicates whether this is the primary or default address for the member.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seasonalFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Flag' ;
    rdfs:comment 'Indicates whether this is a seasonal address used only during specific times of the year.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seasonalStartMonth rdf:type rdf:Property ;
    rdfs:label 'Seasonal Start Month' ;
    rdfs:comment 'Month number (1-12) when seasonal address becomes active each year.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonalEndMonth rdf:type rdf:Property ;
    rdfs:label 'Seasonal End Month' ;
    rdfs:comment 'Month number (1-12) when seasonal address becomes inactive each year.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:verificationSource rdf:type rdf:Property ;
    rdfs:label 'Verification Source' ;
    rdfs:comment 'Name of the service or system used to verify the address (e.g., USPS, Melissa Data, SmartyStreets).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliverabilityScore rdf:type rdf:Property ;
    rdfs:label 'Deliverability Score' ;
    rdfs:comment 'Numeric score (0-100) indicating the likelihood that mail can be successfully delivered to this address.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:residentialCommercialIndicator rdf:type rdf:Property ;
    rdfs:label 'Residential Commercial Indicator' ;
    rdfs:comment 'Classification indicating whether the address is a residential or commercial location.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poBoxFlag rdf:type rdf:Property ;
    rdfs:label 'Po Box Flag' ;
    rdfs:comment 'Indicates whether the address is a post office box rather than a physical street address.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:militaryAddressFlag rdf:type rdf:Property ;
    rdfs:label 'Military Address Flag' ;
    rdfs:comment 'Indicates whether the address is a military address (APO, FPO, DPO).' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:foreignAddressFlag rdf:type rdf:Property ;
    rdfs:label 'Foreign Address Flag' ;
    rdfs:comment 'Indicates whether the address is located outside the United States.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ncoaProcessedFlag rdf:type rdf:Property ;
    rdfs:label 'Ncoa Processed Flag' ;
    rdfs:comment 'Indicates whether the address has been processed through USPS National Change of Address database.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ncoaProcessedDate rdf:type rdf:Property ;
    rdfs:label 'Ncoa Processed Date' ;
    rdfs:comment 'Date when the address was last processed through USPS National Change of Address database.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ncoaMoveType rdf:type rdf:Property ;
    rdfs:label 'Ncoa Move Type' ;
    rdfs:comment 'Type of move identified by NCOA processing (individual, family, or business move).' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncoaMoveDate rdf:type rdf:Property ;
    rdfs:label 'Ncoa Move Date' ;
    rdfs:comment 'Date when the member moved from this address according to USPS NCOA records.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:badAddressFlag rdf:type rdf:Property ;
    rdfs:label 'Bad Address Flag' ;
    rdfs:comment 'Indicates whether the address has been marked as bad or undeliverable based on returned mail or validation failures.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:badAddressReason rdf:type rdf:Property ;
    rdfs:label 'Bad Address Reason' ;
    rdfs:comment 'Reason why the address was marked as bad or undeliverable (e.g., returned mail, invalid format, does not exist).' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:badAddressDate rdf:type rdf:Property ;
    rdfs:label 'Bad Address Date' ;
    rdfs:comment 'Date when the address was marked as bad or undeliverable.' ;
    rdfs:domain ind:Address ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:relationshipId rdf:type rdf:Property ;
    rdfs:label 'Relationship Id' ;
    rdfs:comment 'Unique identifier for the member relationship record. Primary key for the relationship entity.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dependentMemberMemberProfileId rdf:type rdf:Property ;
    rdfs:label 'Dependent Member Member Profile Id' ;
    rdfs:comment 'Identifier of the dependent member in the relationship. Links to the member who is covered under the primary member\'s plan.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberProfile .

ind:typeDescription rdf:type rdf:Property ;
    rdfs:label 'Type Description' ;
    rdfs:comment 'Human-readable description of the relationship type (e.g., Spouse, Child, Domestic Partner, Parent, Sibling).' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryDependent rdf:type rdf:Property ;
    rdfs:label 'Is Primary Dependent' ;
    rdfs:comment 'Flag indicating whether this dependent is the primary dependent for the subscriber (typically used when multiple dependents exist and one needs to be designated as primary for certain benefits or communications).' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFinanciallyResponsible rdf:type rdf:Property ;
    rdfs:label 'Is Financially Responsible' ;
    rdfs:comment 'Flag indicating whether the primary member has financial responsibility for the dependent\'s healthcare costs and premiums.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCustodialParent rdf:type rdf:Property ;
    rdfs:label 'Is Custodial Parent' ;
    rdfs:comment 'Flag indicating whether the primary member is the custodial parent of the dependent child (relevant for divorced or separated parents).' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStudent rdf:type rdf:Property ;
    rdfs:label 'Is Student' ;
    rdfs:comment 'Flag indicating whether the dependent is a full-time student (relevant for extending coverage beyond standard dependent age limits).' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:studentStatusEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Student Status Effective Date' ;
    rdfs:comment 'Date when the dependent\'s student status became effective.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:studentStatusEndDate rdf:type rdf:Property ;
    rdfs:label 'Student Status End Date' ;
    rdfs:comment 'Date when the dependent\'s student status ended or is expected to end.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isDisabled rdf:type rdf:Property ;
    rdfs:label 'Is Disabled' ;
    rdfs:comment 'Flag indicating whether the dependent has a disability that qualifies them for extended coverage beyond standard age limits.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disabilityEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Disability Effective Date' ;
    rdfs:comment 'Date when the dependent\'s disability status became effective for coverage purposes.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:courtOrderIndicator rdf:type rdf:Property ;
    rdfs:label 'Court Order Indicator' ;
    rdfs:comment 'Flag indicating whether the dependent\'s coverage is mandated by a court order (e.g., Qualified Medical Child Support Order - QMCSO).' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:courtOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Court Order Number' ;
    rdfs:comment 'Reference number of the court order mandating coverage for the dependent.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtOrderDate rdf:type rdf:Property ;
    rdfs:label 'Court Order Date' ;
    rdfs:comment 'Date when the court order mandating coverage was issued.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adoptionDate rdf:type rdf:Property ;
    rdfs:label 'Adoption Date' ;
    rdfs:comment 'Date when the dependent was legally adopted by the primary member (relevant for establishing relationship and coverage eligibility).' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:guardianshipDate rdf:type rdf:Property ;
    rdfs:label 'Guardianship Date' ;
    rdfs:comment 'Date when the primary member became the legal guardian of the dependent.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marriageDate rdf:type rdf:Property ;
    rdfs:label 'Marriage Date' ;
    rdfs:comment 'Date when the primary member and dependent spouse were married (relevant for spouse relationships).' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:divorceDate rdf:type rdf:Property ;
    rdfs:label 'Divorce Date' ;
    rdfs:comment 'Date when the primary member and dependent spouse were divorced (relevant for terminating spouse relationships).' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:domesticPartnershipDate rdf:type rdf:Property ;
    rdfs:label 'Domestic Partnership Date' ;
    rdfs:comment 'Date when the domestic partnership between the primary member and dependent was established.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobraQualifyingEventIndicator rdf:type rdf:Property ;
    rdfs:label 'Cobra Qualifying Event Indicator' ;
    rdfs:comment 'Flag indicating whether the relationship termination constitutes a COBRA qualifying event that entitles the dependent to continuation coverage.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraQualifyingEventType rdf:type rdf:Property ;
    rdfs:label 'Cobra Qualifying Event Type' ;
    rdfs:comment 'Type of COBRA qualifying event (e.g., termination of employment, reduction in hours, divorce, legal separation, death of covered employee, Medicare entitlement, dependent child losing eligibility).' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageLimitOverrideIndicator rdf:type rdf:Property ;
    rdfs:label 'Age Limit Override Indicator' ;
    rdfs:comment 'Flag indicating whether the standard dependent age limit has been overridden for this relationship (e.g., due to disability or student status).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ageLimitOverrideReason rdf:type rdf:Property ;
    rdfs:label 'Age Limit Override Reason' ;
    rdfs:comment 'Reason for overriding the standard dependent age limit (e.g., disability, full-time student status, court order, state mandate).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationDocumentType rdf:type rdf:Property ;
    rdfs:label 'Verification Document Type' ;
    rdfs:comment 'Type of document submitted to verify the dependent relationship.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRelationshipId rdf:type rdf:Property ;
    rdfs:label 'Source System Relationship Id' ;
    rdfs:comment 'Original relationship identifier from the source system of record.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentTransactionDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Transaction Date' ;
    rdfs:comment 'Date when the enrollment transaction that created or modified this relationship was processed.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maintenanceTypeCode rdf:type rdf:Property ;
    rdfs:label 'Maintenance Type Code' ;
    rdfs:comment 'Code indicating the type of maintenance action for the relationship record (001=Change, 002=Delete, 021=Addition, 024=Cancellation or Termination, 025=Reinstatement, 026=Correction, 030=Audit or Compare, 032=Employee Information Not Applicable). Uses ANSI X12 1069 Maintenance Type Code.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceReasonCode rdf:type rdf:Property ;
    rdfs:label 'Maintenance Reason Code' ;
    rdfs:comment 'Code indicating the reason for the maintenance action on the relationship record. Uses ANSI X12 1203 Maintenance Reason Code.' ;
    rdfs:domain ind:Relationship ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCurrentRecord rdf:type rdf:Property ;
    rdfs:label 'Is Current Record' ;
    rdfs:comment 'Flag indicating whether this is the current active version of the relationship record in the data warehouse.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactId rdf:type rdf:Property ;
    rdfs:label 'Contact Id' ;
    rdfs:comment 'Unique identifier for the member contact record. Primary key for the contact data product.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contact .

ind:phoneType rdf:type rdf:Property ;
    rdfs:label 'Phone Type' ;
    rdfs:comment 'The classification of the phone number (mobile, home, work, fax, other).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phoneExtension rdf:type rdf:Property ;
    rdfs:label 'Phone Extension' ;
    rdfs:comment 'The extension number for the phone contact, typically used for work numbers.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emailType rdf:type rdf:Property ;
    rdfs:label 'Email Type' ;
    rdfs:comment 'The classification of the email address (personal, work, other).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressType rdf:type rdf:Property ;
    rdfs:label 'Address Type' ;
    rdfs:comment 'The classification of the address (residential, mailing, billing, work, temporary, other).' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryContact rdf:type rdf:Property ;
    rdfs:label 'Is Primary Contact' ;
    rdfs:comment 'Indicates whether this is the primary or default contact method for the member. Used to determine which contact to use when multiple exist.' ;
    rdfs:domain ind:Member ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPreferredContact rdf:type rdf:Property ;
    rdfs:label 'Is Preferred Contact' ;
    rdfs:comment 'Indicates whether the member has explicitly designated this as their preferred contact method for communications.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferenceRank rdf:type rdf:Property ;
    rdfs:label 'Preference Rank' ;
    rdfs:comment 'The priority ranking of this contact method relative to other contact methods for the member (1 = highest priority).' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:optInMarketing rdf:type rdf:Property ;
    rdfs:label 'Opt In Marketing' ;
    rdfs:comment 'Indicates whether the member has opted in to receive marketing communications via this contact method.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optInSurveys rdf:type rdf:Property ;
    rdfs:label 'Opt In Surveys' ;
    rdfs:comment 'Indicates whether the member has opted in to receive survey requests (e.g., CAHPS surveys) via this contact method.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optInCareReminders rdf:type rdf:Property ;
    rdfs:label 'Opt In Care Reminders' ;
    rdfs:comment 'Indicates whether the member has opted in to receive care reminders and preventive care notifications via this contact method.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optInClaimsNotifications rdf:type rdf:Property ;
    rdfs:label 'Opt In Claims Notifications' ;
    rdfs:comment 'Indicates whether the member has opted in to receive claims processing and EOB notifications via this contact method.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doNotContact rdf:type rdf:Property ;
    rdfs:label 'Do Not Contact' ;
    rdfs:comment 'Indicates whether the member has requested not to be contacted via this method. Overrides other preferences.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:validationSource rdf:type rdf:Property ;
    rdfs:label 'Validation Source' ;
    rdfs:comment 'The system or entity that performed the validation of this contact information (e.g., USPS CASS, email verification service, member portal).' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isVerifiedUsps rdf:type rdf:Property ;
    rdfs:label 'Is Verified Usps' ;
    rdfs:comment 'Indicates whether the address has been verified against USPS CASS (Coding Accuracy Support System) standards.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryPointValidation rdf:type rdf:Property ;
    rdfs:label 'Delivery Point Validation' ;
    rdfs:comment 'The USPS delivery point validation status for the address (valid, invalid, vacant, not checked).' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ncoaStatus rdf:type rdf:Property ;
    rdfs:label 'Ncoa Status' ;
    rdfs:comment 'The National Change of Address status indicating whether the member has filed a change of address with USPS.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emailBounceCount rdf:type rdf:Property ;
    rdfs:label 'Email Bounce Count' ;
    rdfs:comment 'The number of times email communications to this address have bounced or failed delivery.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastBounceDate rdf:type rdf:Property ;
    rdfs:label 'Last Bounce Date' ;
    rdfs:comment 'The date of the most recent email bounce or delivery failure for this contact.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bounceType rdf:type rdf:Property ;
    rdfs:label 'Bounce Type' ;
    rdfs:comment 'The type of the most recent email bounce (hard bounce for permanent failures, soft bounce for temporary issues, block, complaint, none).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:undeliverableMailCount rdf:type rdf:Property ;
    rdfs:label 'Undeliverable Mail Count' ;
    rdfs:comment 'The number of times physical mail to this address has been returned as undeliverable.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastUndeliverableDate rdf:type rdf:Property ;
    rdfs:label 'Last Undeliverable Date' ;
    rdfs:comment 'The date when physical mail was most recently returned as undeliverable for this address.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bestTimeToContact rdf:type rdf:Property ;
    rdfs:label 'Best Time To Contact' ;
    rdfs:comment 'The member\'s preferred time of day to be contacted via this method (morning, afternoon, evening, anytime).' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionStartTime rdf:type rdf:Property ;
    rdfs:label 'Restriction Start Time' ;
    rdfs:comment 'The start time of the daily window when the member should NOT be contacted via this method (24-hour format HH:mm).' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionEndTime rdf:type rdf:Property ;
    rdfs:label 'Restriction End Time' ;
    rdfs:comment 'The end time of the daily window when the member should NOT be contacted via this method (24-hour format HH:mm).' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastContactType rdf:type rdf:Property ;
    rdfs:label 'Last Contact Type' ;
    rdfs:comment 'The type of the most recent contact interaction via this method (outbound call, inbound call, email, mail, SMS, portal message).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Last Update Date' ;
    rdfs:comment 'The date when this contact record was last modified or updated.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastUpdateSource rdf:type rdf:Property ;
    rdfs:label 'Last Update Source' ;
    rdfs:comment 'The system or channel that last updated this contact information (e.g., member portal, customer service, 834 transaction, broker feed).' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceTransactionType rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Type' ;
    rdfs:comment 'The type of transaction or process that created or updated this contact record (834 EDI transaction, member portal, customer service, broker feed, employer file, manual entry, data migration).' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Consent Expiration Date' ;
    rdfs:comment 'The date when the member\'s consent to be contacted via this method expires and must be renewed.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:privacyRestrictionCode rdf:type rdf:Property ;
    rdfs:label 'Privacy Restriction Code' ;
    rdfs:comment 'Code indicating any special privacy restrictions or confidentiality requirements for this contact method (e.g., confidential address for domestic violence victims).' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isConfidentialAddress rdf:type rdf:Property ;
    rdfs:label 'Is Confidential Address' ;
    rdfs:comment 'Indicates whether this address is marked as confidential and should have restricted access (e.g., for members in witness protection or domestic violence situations).' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyContactName rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Name' ;
    rdfs:comment 'The full name of the emergency contact person associated with this contact record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyContactRelationship rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Relationship' ;
    rdfs:comment 'The relationship of the emergency contact to the member (spouse, parent, child, sibling, friend, other).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardizedAddressFlag rdf:type rdf:Property ;
    rdfs:label 'Standardized Address Flag' ;
    rdfs:comment 'Indicates whether the address has been standardized according to USPS or other postal authority standards.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geocodeLatitude rdf:type rdf:Property ;
    rdfs:label 'Geocode Latitude' ;
    rdfs:comment 'The latitude coordinate of the address location, used for geographic analysis and provider network proximity calculations.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geocodeLongitude rdf:type rdf:Property ;
    rdfs:label 'Geocode Longitude' ;
    rdfs:comment 'The longitude coordinate of the address location, used for geographic analysis and provider network proximity calculations.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:languagePreferenceId rdf:type rdf:Property ;
    rdfs:label 'Language Preference Id' ;
    rdfs:comment 'Unique identifier for the member\'s language preference record. Serves as the primary key for tracking language communication preferences across all member touchpoints.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Primary Language Code' ;
    rdfs:comment 'ISO 639 language code representing the member\'s primary preferred language for all communications (e.g., \'en\' for English, \'es\' for Spanish, \'zh\' for Chinese). This is the default language for all member-facing materials.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryLanguageName rdf:type rdf:Property ;
    rdfs:label 'Primary Language Name' ;
    rdfs:comment 'Full descriptive name of the member\'s primary preferred language (e.g., \'English\', \'Spanish\', \'Mandarin Chinese\'). Used for display and reporting purposes.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Secondary Language Code' ;
    rdfs:comment 'ISO 639 language code for the member\'s secondary preferred language, if applicable. Used when primary language materials are unavailable or member requests alternate language support.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryLanguageName rdf:type rdf:Property ;
    rdfs:label 'Secondary Language Name' ;
    rdfs:comment 'Full descriptive name of the member\'s secondary preferred language. Provides additional language support option for member communications.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writtenLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Written Language Code' ;
    rdfs:comment 'ISO 639 language code for written communications specifically (EOB, letters, policy documents). May differ from spoken language preference for members with different literacy preferences.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spokenLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Spoken Language Code' ;
    rdfs:comment 'ISO 639 language code for verbal communications (phone calls, interpreter services, video consultations). May differ from written language preference.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interpreterRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Interpreter Required Flag' ;
    rdfs:comment 'Indicates whether the member requires professional interpreter services for healthcare interactions. Critical for care coordination and compliance with language access requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signLanguageType rdf:type rdf:Property ;
    rdfs:label 'Sign Language Type' ;
    rdfs:comment 'Specific sign language system preferred by the member (ASL for American Sign Language, BSL for British Sign Language, etc.). Critical for deaf and hard-of-hearing member support.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brailleRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Braille Required Flag' ;
    rdfs:comment 'Indicates whether the member requires written materials in Braille format. Supports accessibility compliance for visually impaired members.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:largePrintRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Large Print Required Flag' ;
    rdfs:comment 'Indicates whether the member requires written materials in large print format for visual accessibility. Typically 16-point font or larger.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:audioFormatRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Audio Format Required Flag' ;
    rdfs:comment 'Indicates whether the member requires materials in audio format (CD, MP3, phone-based audio). Supports accessibility for visually impaired or reading-challenged members.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:digitalAccessibleFormatFlag rdf:type rdf:Property ;
    rdfs:label 'Digital Accessible Format Flag' ;
    rdfs:comment 'Indicates whether the member requires digital materials in accessible formats (screen reader compatible, WCAG compliant). Supports web and mobile accessibility requirements.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:communicationChannelPreference rdf:type rdf:Property ;
    rdfs:label 'Communication Channel Preference' ;
    rdfs:comment 'Member\'s preferred channel for receiving communications in their preferred language. Supports omnichannel member engagement strategy.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eobLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Eob Language Code' ;
    rdfs:comment 'Specific language code for Explanation of Benefits documents. May differ from general communication preference due to regulatory or member-specific requirements.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sbcLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Sbc Language Code' ;
    rdfs:comment 'Language code for Summary of Benefits and Coverage documents. Must comply with ACA requirements for language access in plan documents.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spdLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Spd Language Code' ;
    rdfs:comment 'Language code for Summary Plan Description documents. Must comply with ERISA requirements for plan disclosure in member\'s preferred language.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketingLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Marketing Language Code' ;
    rdfs:comment 'Language code for marketing materials and promotional communications. Supports targeted marketing campaigns and CMS marketing compliance.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerServiceLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Customer Service Language Code' ;
    rdfs:comment 'Language code for customer service interactions. Routes member calls to appropriate language-capable representatives or interpreter services.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careManagementLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Care Management Language Code' ;
    rdfs:comment 'Language code for care management and disease management program communications. Ensures culturally and linguistically appropriate care coordination.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthorizationLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Language Code' ;
    rdfs:comment 'Language code for prior authorization communications and decisions. Ensures members understand utilization management decisions in their preferred language.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealsGrievancesLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Appeals Grievances Language Code' ;
    rdfs:comment 'Language code for appeals and grievances communications. Critical for member rights and regulatory compliance with appeal notification requirements.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageProficiencyLevel rdf:type rdf:Property ;
    rdfs:label 'Language Proficiency Level' ;
    rdfs:comment 'Member\'s self-reported or assessed proficiency level in their primary language. Helps determine appropriate communication complexity and support needs.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:englishProficiencyLevel rdf:type rdf:Property ;
    rdfs:label 'English Proficiency Level' ;
    rdfs:comment 'Member\'s proficiency level in English, regardless of primary language preference. Used to determine language access service requirements and compliance with LEP (Limited English Proficiency) standards.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitedEnglishProficiencyFlag rdf:type rdf:Property ;
    rdfs:label 'Limited English Proficiency Flag' ;
    rdfs:comment 'Indicates whether the member has Limited English Proficiency, triggering mandatory language access services and protections under federal civil rights law.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:culturalPreference rdf:type rdf:Property ;
    rdfs:label 'Cultural Preference' ;
    rdfs:comment 'Member\'s cultural background or preference that may influence communication style, health beliefs, or care preferences. Supports culturally competent care delivery.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dialectVariant rdf:type rdf:Property ;
    rdfs:label 'Dialect Variant' ;
    rdfs:comment 'Specific dialect or regional variant of the preferred language (e.g., Castilian Spanish vs. Latin American Spanish, Mandarin vs. Cantonese). Ensures accurate and culturally appropriate communication.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readingLevelPreference rdf:type rdf:Property ;
    rdfs:label 'Reading Level Preference' ;
    rdfs:comment 'Preferred reading complexity level for written materials. Supports health literacy initiatives and plain language requirements.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthLiteracyLevel rdf:type rdf:Property ;
    rdfs:label 'Health Literacy Level' ;
    rdfs:comment 'Member\'s assessed or self-reported ability to understand health information and navigate the healthcare system. Influences communication strategy and care management approach.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:translationServiceVendor rdf:type rdf:Property ;
    rdfs:label 'Translation Service Vendor' ;
    rdfs:comment 'Name of the contracted translation or interpreter service vendor assigned to support this member\'s language needs. Used for vendor management and quality tracking.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageLineAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Language Line Account Number' ;
    rdfs:comment 'Account or reference number for telephonic interpreter services (e.g., LanguageLine Solutions). Used for billing and service tracking.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferenceVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Preference Verification Date' ;
    rdfs:comment 'Date when the language preference was last verified or confirmed with the member. Supports data quality and compliance with periodic verification requirements.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:preferenceVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Preference Verification Method' ;
    rdfs:comment 'Method used to verify the language preference with the member. Supports audit trail and data quality documentation.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentForLanguageServicesFlag rdf:type rdf:Property ;
    rdfs:label 'Consent For Language Services Flag' ;
    rdfs:comment 'Indicates whether member has provided explicit consent for language assistance services. May be required for certain interpreter services or third-party language vendors.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:familyLanguagePreferenceFlag rdf:type rdf:Property ;
    rdfs:label 'Family Language Preference Flag' ;
    rdfs:comment 'Indicates whether this language preference applies to the entire family unit or subscriber group. Supports family-level communication preferences.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastUpdatedSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Last Updated Source System' ;
    rdfs:comment 'Source system that provided the most recent update to this language preference record (e.g., Facets, QNXT, Salesforce, Member Portal). Supports data lineage and integration tracking.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordCreatedBy rdf:type rdf:Property ;
    rdfs:label 'Record Created By' ;
    rdfs:comment 'User ID or system identifier that created this language preference record. Supports audit trail and data provenance.' ;
    rdfs:domain ind:LanguagePreference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:householdId rdf:type rdf:Property ;
    rdfs:label 'Household Id' ;
    rdfs:comment 'Unique identifier for the household or family unit. Primary key for the household entity.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Household .

ind:primarySubscriberFirstName rdf:type rdf:Property ;
    rdfs:label 'Primary Subscriber First Name' ;
    rdfs:comment 'First name of the primary subscriber who is the policyholder or contract holder for the household.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySubscriberLastName rdf:type rdf:Property ;
    rdfs:label 'Primary Subscriber Last Name' ;
    rdfs:comment 'Last name of the primary subscriber who is the policyholder or contract holder for the household.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySubscriberMiddleName rdf:type rdf:Property ;
    rdfs:label 'Primary Subscriber Middle Name' ;
    rdfs:comment 'Middle name or initial of the primary subscriber.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySubscriberSsn rdf:type rdf:Property ;
    rdfs:label 'Primary Subscriber Ssn' ;
    rdfs:comment 'Social Security Number of the primary subscriber used for identification and tax reporting purposes.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primarySubscriberDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Primary Subscriber Date Of Birth' ;
    rdfs:comment 'Date of birth of the primary subscriber used for age-based rating and eligibility determination.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primarySubscriberGender rdf:type rdf:Property ;
    rdfs:label 'Primary Subscriber Gender' ;
    rdfs:comment 'Gender of the primary subscriber as reported for demographic and regulatory reporting purposes.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Primary Phone Number' ;
    rdfs:comment 'Primary contact phone number for the household used for member communication and outreach.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryPhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Secondary Phone Number' ;
    rdfs:comment 'Alternate contact phone number for the household.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredLanguage rdf:type rdf:Property ;
    rdfs:label 'Preferred Language' ;
    rdfs:comment 'Preferred language for household communication to ensure culturally and linguistically appropriate services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredCommunicationMethod rdf:type rdf:Property ;
    rdfs:label 'Preferred Communication Method' ;
    rdfs:comment 'Preferred method for receiving communications from the health plan.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incomeAmount rdf:type rdf:Property ;
    rdfs:label 'Income Amount' ;
    rdfs:comment 'Annual household income used for subsidy eligibility determination and cost-sharing reduction calculations.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:federalPovertyLevelPercentage rdf:type rdf:Property ;
    rdfs:label 'Federal Poverty Level Percentage' ;
    rdfs:comment 'Household income expressed as a percentage of the Federal Poverty Level used for subsidy and Medicaid eligibility.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerGroupName rdf:type rdf:Property ;
    rdfs:label 'Employer Group Name' ;
    rdfs:comment 'Name of the employer or group sponsor for employer-sponsored coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeAssignedHouseholdCode rdf:type rdf:Property ;
    rdfs:label 'Exchange Assigned Household Code' ;
    rdfs:comment 'Unique household identifier assigned by the health insurance exchange (FFM or SBM) for marketplace enrollments.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subsidyEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Subsidy Eligible Flag' ;
    rdfs:comment 'Indicates whether the household is eligible for premium tax credits or cost-sharing reductions under the ACA.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statusEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Status Effective Date' ;
    rdfs:comment 'Date when the current household status became effective.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalEnrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Original Enrollment Date' ;
    rdfs:comment 'Date when the household first enrolled with the health plan, used for continuous coverage tracking.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:currentCoverageEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Current Coverage Effective Date' ;
    rdfs:comment 'Date when the household\'s current coverage period began.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:currentCoverageTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Current Coverage Termination Date' ;
    rdfs:comment 'Date when the household\'s current coverage period ends or ended.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qleFlag rdf:type rdf:Property ;
    rdfs:label 'Qle Flag' ;
    rdfs:comment 'Indicates whether the household has experienced a qualifying life event allowing special enrollment outside open enrollment.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sepStartDate rdf:type rdf:Property ;
    rdfs:label 'Sep Start Date' ;
    rdfs:comment 'Start date of the special enrollment period triggered by a qualifying life event.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:premiumBillingFrequency rdf:type rdf:Property ;
    rdfs:label 'Premium Billing Frequency' ;
    rdfs:comment 'Frequency at which the household is billed for insurance premiums.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoPayEnrolledFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Enrolled Flag' ;
    rdfs:comment 'Indicates whether the household is enrolled in automatic premium payment.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberPortalRegisteredFlag rdf:type rdf:Property ;
    rdfs:label 'Member Portal Registered Flag' ;
    rdfs:comment 'Indicates whether the household has registered for the online member portal.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaAuthorizationOnFileFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization On File Flag' ;
    rdfs:comment 'Indicates whether a signed HIPAA authorization form is on file for the household.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noticeOfPrivacyPracticesAcknowledgedDate rdf:type rdf:Property ;
    rdfs:label 'Notice Of Privacy Practices Acknowledged Date' ;
    rdfs:comment 'Date when the household acknowledged receipt of the Notice of Privacy Practices.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:careManagementEnrolledFlag rdf:type rdf:Property ;
    rdfs:label 'Care Management Enrolled Flag' ;
    rdfs:comment 'Indicates whether any member of the household is enrolled in a care management or disease management program.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vipFlag rdf:type rdf:Property ;
    rdfs:label 'Vip Flag' ;
    rdfs:comment 'Indicates whether the household is designated as VIP requiring special handling or service.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customerServiceNotes rdf:type rdf:Property ;
    rdfs:label 'Customer Service Notes' ;
    rdfs:comment 'Free-text notes from customer service interactions regarding household-specific issues or preferences.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:satisfactionSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Survey Date' ;
    rdfs:comment 'Date when the household last completed a satisfaction survey.' ;
    rdfs:domain ind:Household ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentId rdf:type rdf:Property ;
    rdfs:label 'Consent Id' ;
    rdfs:comment 'Unique identifier for the member consent record. Primary key for the consent data product.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:formId rdf:type rdf:Property ;
    rdfs:label 'Form Id' ;
    rdfs:comment 'Unique identifier of the specific consent form or template used to obtain the consent.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentForm .

ind:grantedDate rdf:type rdf:Property ;
    rdfs:label 'Granted Date' ;
    rdfs:comment 'The date on which the member granted or provided the consent.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grantedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Granted Timestamp' ;
    rdfs:comment 'The precise date and time when the member granted consent. Provides audit trail for consent capture.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:revokedDate rdf:type rdf:Property ;
    rdfs:label 'Revoked Date' ;
    rdfs:comment 'The date on which the member revoked or withdrew their consent. Null if consent has not been revoked.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revokedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Revoked Timestamp' ;
    rdfs:comment 'The precise date and time when the member revoked their consent. Null if consent has not been revoked.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:revocationMethod rdf:type rdf:Property ;
    rdfs:label 'Revocation Method' ;
    rdfs:comment 'The method through which the member revoked their consent.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRevocable rdf:type rdf:Property ;
    rdfs:label 'Is Revocable' ;
    rdfs:comment 'Indicates whether the member has the right to revoke this consent. True if revocable, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signatureCaptured rdf:type rdf:Property ;
    rdfs:label 'Signature Captured' ;
    rdfs:comment 'Indicates whether a member signature was captured for this consent. True if signature obtained, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signatureType rdf:type rdf:Property ;
    rdfs:label 'Signature Type' ;
    rdfs:comment 'The type of signature captured for the consent authorization.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessRequired rdf:type rdf:Property ;
    rdfs:label 'Witness Required' ;
    rdfs:comment 'Indicates whether a witness signature is required for this consent. True if witness required, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorizedRecipient rdf:type rdf:Property ;
    rdfs:label 'Authorized Recipient' ;
    rdfs:comment 'Name or identifier of the person, organization, or entity authorized to receive the member\'s information under this consent.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedRecipientType rdf:type rdf:Property ;
    rdfs:label 'Authorized Recipient Type' ;
    rdfs:comment 'The type or category of the authorized recipient who may receive the member\'s information.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedRecipientNpi rdf:type rdf:Property ;
    rdfs:label 'Authorized Recipient Npi' ;
    rdfs:comment 'The National Provider Identifier of the healthcare provider authorized to receive information. Applicable when recipient is a provider.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosurePurpose rdf:type rdf:Property ;
    rdfs:label 'Disclosure Purpose' ;
    rdfs:comment 'Specific purpose for which the member\'s Protected Health Information (PHI) may be disclosed under this consent.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:informationDisclosed rdf:type rdf:Property ;
    rdfs:label 'Information Disclosed' ;
    rdfs:comment 'Description of the specific information or categories of information that may be disclosed under this consent.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phiCategory rdf:type rdf:Property ;
    rdfs:label 'Phi Category' ;
    rdfs:comment 'Category of Protected Health Information covered by this consent. Certain categories require special authorization.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialCategoryFlag rdf:type rdf:Property ;
    rdfs:label 'Special Category Flag' ;
    rdfs:comment 'Indicates whether this consent involves specially protected health information such as mental health, substance abuse, or HIV/AIDS records. True if special category, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketingConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Marketing Consent Flag' ;
    rdfs:comment 'Indicates whether the member has consented to receive marketing communications. True if consented, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:researchConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Research Consent Flag' ;
    rdfs:comment 'Indicates whether the member has consented to use of their information for research purposes. True if consented, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundraisingConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Fundraising Consent Flag' ;
    rdfs:comment 'Indicates whether the member has consented to be contacted for fundraising purposes. True if consented, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:saleOfPhiFlag rdf:type rdf:Property ;
    rdfs:label 'Sale Of Phi Flag' ;
    rdfs:comment 'Indicates whether this consent authorizes the sale of the member\'s Protected Health Information. Requires specific authorization under HIPAA. True if authorized, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:userAgent rdf:type rdf:Property ;
    rdfs:label 'User Agent' ;
    rdfs:comment 'Browser or application user agent string captured when consent was provided electronically. Used for audit purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geolocation rdf:type rdf:Property ;
    rdfs:label 'Geolocation' ;
    rdfs:comment 'Geographic location coordinates where consent was provided. Used for audit and compliance verification.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgementText rdf:type rdf:Property ;
    rdfs:label 'Acknowledgement Text' ;
    rdfs:comment 'The full text of the consent acknowledgement or authorization that was presented to the member.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightToRevokeNotice rdf:type rdf:Property ;
    rdfs:label 'Right To Revoke Notice' ;
    rdfs:comment 'Text of the notice provided to the member regarding their right to revoke consent and the process for doing so.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consequencesOfRefusal rdf:type rdf:Property ;
    rdfs:label 'Consequences Of Refusal' ;
    rdfs:comment 'Description of any consequences to the member if they refuse to provide consent, as disclosed in the authorization.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatmentConditioningFlag rdf:type rdf:Property ;
    rdfs:label 'Treatment Conditioning Flag' ;
    rdfs:comment 'Indicates whether treatment, payment, enrollment, or eligibility is conditioned on providing this consent. True if conditioned, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:redisclosureNotice rdf:type rdf:Property ;
    rdfs:label 'Redisclosure Notice' ;
    rdfs:comment 'Notice provided to the member that information disclosed under this consent may be subject to redisclosure and may no longer be protected.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentConsentId rdf:type rdf:Property ;
    rdfs:label 'Parent Consent Id' ;
    rdfs:comment 'Identifier of the parent or previous consent record if this consent supersedes or amends a prior consent. Null if this is an original consent.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Consent .

ind:supersededByConsentId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Consent Id' ;
    rdfs:comment 'Identifier of the consent record that supersedes this consent. Null if this consent is still current or has not been superseded.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Consent .

ind:verificationFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Verification Frequency Months' ;
    rdfs:comment 'The frequency in months at which this consent should be re-verified with the member. Null if no periodic verification required.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Compliance Jurisdiction' ;
    rdfs:comment 'The legal jurisdiction or state whose regulations govern this consent. Uses standard state or country codes.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateSpecificRequirements rdf:type rdf:Property ;
    rdfs:label 'State Specific Requirements' ;
    rdfs:comment 'Description of any state-specific consent requirements that apply to this consent record.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minorConsentFlag rdf:type rdf:Property ;
    rdfs:label 'Minor Consent Flag' ;
    rdfs:comment 'Indicates whether this consent was provided on behalf of a minor. True if minor consent, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalRepresentativeFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Representative Flag' ;
    rdfs:comment 'Indicates whether consent was provided by a legal representative rather than the member directly. True if legal representative, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:powerOfAttorneyFlag rdf:type rdf:Property ;
    rdfs:label 'Power Of Attorney Flag' ;
    rdfs:comment 'Indicates whether the person providing consent holds power of attorney for the member. True if power of attorney, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:advanceDirectiveFlag rdf:type rdf:Property ;
    rdfs:label 'Advance Directive Flag' ;
    rdfs:comment 'Indicates whether this consent is associated with an advance directive or living will. True if associated, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noticeOfPrivacyPracticesProvided rdf:type rdf:Property ;
    rdfs:label 'Notice Of Privacy Practices Provided' ;
    rdfs:comment 'Indicates whether the member was provided with the Notice of Privacy Practices at the time of consent. True if provided, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noticeOfPrivacyPracticesVersion rdf:type rdf:Property ;
    rdfs:label 'Notice Of Privacy Practices Version' ;
    rdfs:comment 'Version identifier of the Notice of Privacy Practices that was provided to the member.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optOutInstructions rdf:type rdf:Property ;
    rdfs:label 'Opt Out Instructions' ;
    rdfs:comment 'Instructions provided to the member on how to opt out or revoke this consent.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPreferenceEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Preference Email' ;
    rdfs:comment 'Indicates whether the member has consented to be contacted via email. True if consented, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactPreferencePhone rdf:type rdf:Property ;
    rdfs:label 'Contact Preference Phone' ;
    rdfs:comment 'Indicates whether the member has consented to be contacted via phone. True if consented, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactPreferenceSms rdf:type rdf:Property ;
    rdfs:label 'Contact Preference Sms' ;
    rdfs:comment 'Indicates whether the member has consented to receive SMS text messages. True if consented, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactPreferenceMail rdf:type rdf:Property ;
    rdfs:label 'Contact Preference Mail' ;
    rdfs:comment 'Indicates whether the member has consented to be contacted via postal mail. True if consented, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactPreferenceAutomatedCall rdf:type rdf:Property ;
    rdfs:label 'Contact Preference Automated Call' ;
    rdfs:comment 'Indicates whether the member has consented to receive automated or pre-recorded phone calls. True if consented, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thirdPartyDisclosureAllowed rdf:type rdf:Property ;
    rdfs:label 'Third Party Disclosure Allowed' ;
    rdfs:comment 'Indicates whether the member has consented to disclosure of their information to third parties. True if allowed, false otherwise.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataRetentionPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Data Retention Period Months' ;
    rdfs:comment 'The number of months for which the consent record must be retained per regulatory requirements.' ;
    rdfs:domain ind:Consent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditTrailAvailable rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Available' ;
    rdfs:comment 'Indicates whether a complete audit trail is available for this consent record. True if available, false otherwise.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastModifiedByUserId rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User Id' ;
    rdfs:comment 'Identifier of the system user or agent who last modified the consent record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:memberIdentifierId rdf:type rdf:Property ;
    rdfs:label 'Member Identifier Id' ;
    rdfs:comment 'Unique system-generated identifier for each member identifier record. Serves as the primary key for the member identifier entity.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ssn rdf:type rdf:Property ;
    rdfs:label 'Ssn' ;
    rdfs:comment 'Member\'s Social Security Number used for identity verification, tax reporting, and coordination of benefits. Must comply with HIPAA privacy and security requirements.' ;
    rdfs:domain ind:Member ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidId rdf:type rdf:Property ;
    rdfs:label 'Medicaid Id' ;
    rdfs:comment 'State-issued Medicaid identification number for members enrolled in Medicaid managed care programs. Format varies by state.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicareId rdf:type rdf:Property ;
    rdfs:label 'Medicare Id' ;
    rdfs:comment 'Medicare Beneficiary Identifier (MBI) assigned by CMS for members enrolled in Medicare Advantage or Part D plans. Replaced SSN-based HICNs in 2019.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mrn rdf:type rdf:Property ;
    rdfs:label 'Mrn' ;
    rdfs:comment 'Medical Record Number assigned by healthcare providers or health systems. Used for care coordination and medical record linkage.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalSystemId rdf:type rdf:Property ;
    rdfs:label 'External System Id' ;
    rdfs:comment 'Identifier assigned by external systems such as employer HR systems, third-party administrators, or partner organizations. Enables cross-system member matching.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalSystemName rdf:type rdf:Property ;
    rdfs:label 'External System Name' ;
    rdfs:comment 'Name of the external system that assigned the external system identifier. Examples include employer HRIS, TPA systems, or state exchange platforms.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternateId rdf:type rdf:Property ;
    rdfs:label 'Alternate Id' ;
    rdfs:comment 'Alternative member identifier used for specific purposes such as pharmacy benefits, behavioral health carve-outs, or specialty programs.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legacySystemId rdf:type rdf:Property ;
    rdfs:label 'Legacy System Id' ;
    rdfs:comment 'Member identifier from legacy or acquired systems retained for historical data linkage and migration tracking.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateId rdf:type rdf:Property ;
    rdfs:label 'State Id' ;
    rdfs:comment 'State-issued identification number such as driver\'s license or state ID card number used for identity verification and fraud prevention.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacyCardId rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Card Id' ;
    rdfs:comment 'Pharmacy benefit card identifier used at point of sale for prescription drug claims. May differ from medical member ID.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:binNumber rdf:type rdf:Property ;
    rdfs:label 'Bin Number' ;
    rdfs:comment 'Six-digit Bank Identification Number used in pharmacy claims processing to route transactions to the correct PBM processor.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcn rdf:type rdf:Property ;
    rdfs:label 'Pcn' ;
    rdfs:comment 'Processor Control Number used in pharmacy claims to identify the specific benefit plan or processing rules to apply.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardId rdf:type rdf:Property ;
    rdfs:label 'Card Id' ;
    rdfs:comment 'Identifier printed on the physical or digital member ID card. May be the same as subscriber ID or a separate card-specific identifier.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:biometricId rdf:type rdf:Property ;
    rdfs:label 'Biometric Id' ;
    rdfs:comment 'Biometric identifier such as fingerprint hash or facial recognition token used for secure member authentication in digital channels.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceId rdf:type rdf:Property ;
    rdfs:label 'Device Id' ;
    rdfs:comment 'Unique identifier for member\'s registered device used for mobile app access, telehealth, or remote monitoring programs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimary rdf:type rdf:Property ;
    rdfs:label 'Is Primary' ;
    rdfs:comment 'Flag indicating whether this is the primary identifier for the member. Each member should have one primary identifier per identifier type.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issueDate rdf:type rdf:Property ;
    rdfs:label 'Issue Date' ;
    rdfs:comment 'Date when the identifier was originally issued or assigned to the member.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:issuingAuthority rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority' ;
    rdfs:comment 'Organization or entity that issued the identifier. Examples include CMS for Medicare IDs, state agencies for Medicaid IDs, or UnitedHealthcare for subscriber IDs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingState rdf:type rdf:Property ;
    rdfs:label 'Issuing State' ;
    rdfs:comment 'Two-letter state code indicating the state that issued the identifier. Applicable for state-specific identifiers such as Medicaid IDs or state exchange IDs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingCountry rdf:type rdf:Property ;
    rdfs:label 'Issuing Country' ;
    rdfs:comment 'Three-letter ISO country code indicating the country that issued the identifier. Supports international member identification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:format rdf:type rdf:Property ;
    rdfs:label 'Format' ;
    rdfs:comment 'Description of the identifier format or pattern. Helps with validation and data quality checks.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSubscriber rdf:type rdf:Property ;
    rdfs:label 'Is Subscriber' ;
    rdfs:comment 'Flag indicating whether this member is the primary subscriber (policyholder) or a dependent. Subscriber is the primary contract holder.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maskingRequired rdf:type rdf:Property ;
    rdfs:label 'Masking Required' ;
    rdfs:comment 'Flag indicating whether this identifier must be masked or partially hidden in user interfaces and reports to protect member privacy.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maskingPattern rdf:type rdf:Property ;
    rdfs:label 'Masking Pattern' ;
    rdfs:comment 'Pattern used to mask the identifier for display purposes. Example: XXX-XX-1234 for SSN masking.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tokenizationEnabled rdf:type rdf:Property ;
    rdfs:label 'Tokenization Enabled' ;
    rdfs:comment 'Flag indicating whether this identifier has been tokenized for use in non-production environments or external integrations.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tokenValue rdf:type rdf:Property ;
    rdfs:label 'Token Value' ;
    rdfs:comment 'Tokenized representation of the identifier used in place of the actual value for security purposes.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duplicateCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Duplicate Check Status' ;
    rdfs:comment 'Status of duplicate detection processes for this identifier. Helps identify and resolve duplicate member records.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crossReferenceId rdf:type rdf:Property ;
    rdfs:label 'Cross Reference Id' ;
    rdfs:comment 'Identifier used to cross-reference this member identifier with other systems or data sources. Supports data integration and master data management.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changedBy rdf:type rdf:Property ;
    rdfs:label 'Changed By' ;
    rdfs:comment 'User ID or system name that made the most recent change to the identifier record.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Changed Timestamp' ;
    rdfs:comment 'Timestamp when the identifier record was last modified. Supports audit trail and change tracking.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:purgeEligibleDate rdf:type rdf:Property ;
    rdfs:label 'Purge Eligible Date' ;
    rdfs:comment 'Date when this identifier becomes eligible for purging or archival based on retention policies.' ;
    rdfs:domain ind:MemberIdentifier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:emergencyContactId rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Id' ;
    rdfs:comment 'Unique identifier for the emergency contact record. Primary key for the emergency contact entity.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryPhoneType rdf:type rdf:Property ;
    rdfs:label 'Primary Phone Type' ;
    rdfs:comment 'The type of the primary phone number (e.g., mobile, home, work).' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryPhoneType rdf:type rdf:Property ;
    rdfs:label 'Secondary Phone Type' ;
    rdfs:comment 'The type of the secondary phone number (e.g., mobile, home, work).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:canMakeMedicalDecisions rdf:type rdf:Property ;
    rdfs:label 'Can Make Medical Decisions' ;
    rdfs:comment 'Indicates whether this emergency contact is authorized to make medical decisions on behalf of the member.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasPowerOfAttorney rdf:type rdf:Property ;
    rdfs:label 'Has Power Of Attorney' ;
    rdfs:comment 'Indicates whether this emergency contact has legal power of attorney for the member.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLegalGuardian rdf:type rdf:Property ;
    rdfs:label 'Is Legal Guardian' ;
    rdfs:comment 'Indicates whether this emergency contact is the legal guardian of the member (typically for minor or dependent members).' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bestTimeToCall rdf:type rdf:Property ;
    rdfs:label 'Best Time To Call' ;
    rdfs:comment 'The preferred time of day to contact the emergency contact person.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentToContact rdf:type rdf:Property ;
    rdfs:label 'Consent To Contact' ;
    rdfs:comment 'Indicates whether the emergency contact has provided consent to be contacted regarding the member\'s health information.' ;
    rdfs:domain ind:EmergencyContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaAuthorizationOnFile rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization On File' ;
    rdfs:comment 'Indicates whether a signed HIPAA authorization form is on file allowing disclosure of Protected Health Information (PHI) to this emergency contact.' ;
    rdfs:domain ind:Member ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorizationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Authorization Expiration Date' ;
    rdfs:comment 'The date when the HIPAA authorization to disclose PHI to this emergency contact expires.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:benefitElectionId rdf:type rdf:Property ;
    rdfs:label 'Benefit Election Id' ;
    rdfs:comment 'Unique identifier for each benefit election record. Primary key for the benefit election entity.' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benefitPlanCode rdf:type rdf:Property ;
    rdfs:label 'Benefit Plan Code' ;
    rdfs:comment 'The standardized code representing the specific benefit plan elected (e.g., dental, vision, HSA, FSA).' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Election Effective Date' ;
    rdfs:comment 'The date on which the elected benefit coverage becomes active and enforceable.' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electionEndDate rdf:type rdf:Property ;
    rdfs:label 'Election End Date' ;
    rdfs:comment 'The date on which the elected benefit coverage terminates or expires.' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electionMethod rdf:type rdf:Property ;
    rdfs:label 'Election Method' ;
    rdfs:comment 'The method or channel through which the member submitted their benefit election (e.g., online portal, phone, paper form).' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electionReason rdf:type rdf:Property ;
    rdfs:label 'Election Reason' ;
    rdfs:comment 'The reason or qualifying event that allowed the member to make this benefit election (e.g., new hire, open enrollment, qualifying life event).' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributionFrequency rdf:type rdf:Property ;
    rdfs:label 'Contribution Frequency' ;
    rdfs:comment 'The frequency at which premium contributions are collected (e.g., monthly, biweekly, annual).' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualElectionAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Election Amount' ;
    rdfs:comment 'The total annual amount elected by the member for contribution-based benefits such as Health Savings Account (HSA) or Flexible Spending Account (FSA).' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perPayPeriodAmount rdf:type rdf:Property ;
    rdfs:label 'Per Pay Period Amount' ;
    rdfs:comment 'The amount deducted from the member\'s paycheck each pay period for the elected benefit.' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageAmount rdf:type rdf:Property ;
    rdfs:label 'Coverage Amount' ;
    rdfs:comment 'The total coverage or benefit amount provided under the elected benefit (e.g., life insurance coverage amount, disability benefit amount).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waiverIndicator rdf:type rdf:Property ;
    rdfs:label 'Waiver Indicator' ;
    rdfs:comment 'Indicates whether the member has waived or declined the benefit coverage. True if waived, false if elected.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Date' ;
    rdfs:comment 'The date on which the member waived or declined the benefit coverage.' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:beneficiaryName rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Name' ;
    rdfs:comment 'The name of the primary beneficiary designated by the member for benefits such as life insurance or death benefits.' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryRelationship rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Relationship' ;
    rdfs:comment 'The relationship of the beneficiary to the member (e.g., spouse, child, parent).' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preExistingConditionIndicator rdf:type rdf:Property ;
    rdfs:label 'Pre Existing Condition Indicator' ;
    rdfs:comment 'Indicates whether the member has disclosed a pre-existing medical condition that may affect benefit eligibility or coverage terms.' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evidenceOfInsurabilityRequired rdf:type rdf:Property ;
    rdfs:label 'Evidence Of Insurability Required' ;
    rdfs:comment 'Indicates whether the member is required to provide evidence of insurability (medical underwriting) for the elected benefit.' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evidenceOfInsurabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Evidence Of Insurability Status' ;
    rdfs:comment 'The status of the evidence of insurability review process (e.g., pending, approved, denied).' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobraEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Cobra Eligible Indicator' ;
    rdfs:comment 'Indicates whether the member is eligible for COBRA continuation coverage upon termination of the benefit.' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certificateNumber rdf:type rdf:Property ;
    rdfs:label 'Certificate Number' ;
    rdfs:comment 'The certificate number issued to the member for the elected benefit coverage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electionNotes rdf:type rdf:Property ;
    rdfs:label 'Election Notes' ;
    rdfs:comment 'Free-text notes or comments related to the benefit election, such as special instructions or member requests.' ;
    rdfs:domain ind:BenefitElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divisionName rdf:type rdf:Property ;
    rdfs:label 'Division Name' ;
    rdfs:comment 'Name of the division or business unit within the employer group.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classDescription rdf:type rdf:Property ;
    rdfs:label 'Class Description' ;
    rdfs:comment 'Description of the employee classification (e.g., Full-Time Salaried, Part-Time Hourly).' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateGroup rdf:type rdf:Property ;
    rdfs:label 'Rate Group' ;
    rdfs:comment 'Classification used for premium rating purposes, grouping members with similar risk or demographic characteristics.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcpAssignmentRequired rdf:type rdf:Property ;
    rdfs:label 'Pcp Assignment Required' ;
    rdfs:comment 'Indicates whether the member is required to select a Primary Care Physician under the plan design.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rehireIndicator rdf:type rdf:Property ;
    rdfs:label 'Rehire Indicator' ;
    rdfs:comment 'Flag indicating whether the member is a rehired employee returning to the group.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rehireDate rdf:type rdf:Property ;
    rdfs:label 'Rehire Date' ;
    rdfs:comment 'Date when the member was rehired by the employer group.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leaveOfAbsenceIndicator rdf:type rdf:Property ;
    rdfs:label 'Leave Of Absence Indicator' ;
    rdfs:comment 'Flag indicating whether the member is currently on an approved leave of absence.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leaveOfAbsenceStartDate rdf:type rdf:Property ;
    rdfs:label 'Leave Of Absence Start Date' ;
    rdfs:comment 'Date when the member\'s leave of absence began.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leaveOfAbsenceEndDate rdf:type rdf:Property ;
    rdfs:label 'Leave Of Absence End Date' ;
    rdfs:comment 'Expected or actual date when the member\'s leave of absence ends.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:smallGroupIndicator rdf:type rdf:Property ;
    rdfs:label 'Small Group Indicator' ;
    rdfs:comment 'Flag indicating whether the employer qualifies as a small group (typically 1-50 employees) under state or federal regulations.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:largeGroupIndicator rdf:type rdf:Property ;
    rdfs:label 'Large Group Indicator' ;
    rdfs:comment 'Flag indicating whether the employer qualifies as a large group (typically 51+ employees) under state or federal regulations.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sbcDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Sbc Delivery Date' ;
    rdfs:comment 'Date when the Summary of Benefits and Coverage was delivered to the member.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:spdVersion rdf:type rdf:Property ;
    rdfs:label 'Spd Version' ;
    rdfs:comment 'Version identifier of the Summary Plan Description document provided to the member under ERISA requirements.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spdDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Spd Delivery Date' ;
    rdfs:comment 'Date when the Summary Plan Description was delivered to the member.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hipaaNoticeDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Hipaa Notice Delivery Date' ;
    rdfs:comment 'Date when the HIPAA Notice of Privacy Practices was delivered to the member.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Enrollment Confirmation Number' ;
    rdfs:comment 'Confirmation number or reference code generated when the member\'s enrollment was processed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:last834TransactionDate rdf:type rdf:Property ;
    rdfs:label 'Last 834 Transaction Date' ;
    rdfs:comment 'Date of the most recent HIPAA 834 enrollment transaction received for this member-group association.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:last834TransactionType rdf:type rdf:Property ;
    rdfs:label 'Last 834 Transaction Type' ;
    rdfs:comment 'Type of the most recent HIPAA 834 enrollment transaction (e.g., enrollment, change, termination).' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activeCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Active Coverage Indicator' ;
    rdfs:comment 'Flag indicating whether the member currently has active coverage under this group association.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageContinuationIndicator rdf:type rdf:Property ;
    rdfs:label 'Coverage Continuation Indicator' ;
    rdfs:comment 'Flag indicating whether the member is eligible for or enrolled in coverage continuation (e.g., COBRA, state continuation).' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retireeIndicator rdf:type rdf:Property ;
    rdfs:label 'Retiree Indicator' ;
    rdfs:comment 'Flag indicating whether the member is a retiree receiving employer-sponsored retiree health benefits.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retireeEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Retiree Effective Date' ;
    rdfs:comment 'Date when the member\'s retiree coverage became effective.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:wellnessProgramParticipant rdf:type rdf:Property ;
    rdfs:label 'Wellness Program Participant' ;
    rdfs:comment 'Flag indicating whether the member is enrolled in employer-sponsored wellness programs.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dependentCareFsaEligible rdf:type rdf:Property ;
    rdfs:label 'Dependent Care Fsa Eligible' ;
    rdfs:comment 'Flag indicating whether the member is eligible for a Dependent Care FSA.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commuterBenefitsEligible rdf:type rdf:Property ;
    rdfs:label 'Commuter Benefits Eligible' ;
    rdfs:comment 'Flag indicating whether the member is eligible for pre-tax commuter benefits.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dentalCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Dental Coverage Indicator' ;
    rdfs:comment 'Flag indicating whether the member has dental coverage as part of their group benefits.' ;
    rdfs:domain ind:Member ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:visionCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Vision Coverage Indicator' ;
    rdfs:comment 'Flag indicating whether the member has vision coverage as part of their group benefits.' ;
    rdfs:domain ind:Member ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lifeInsuranceCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Life Insurance Coverage Indicator' ;
    rdfs:comment 'Flag indicating whether the member has life insurance coverage through the employer group.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stdCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Std Coverage Indicator' ;
    rdfs:comment 'Flag indicating whether the member has Short Term Disability coverage through the employer group.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ltdCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Ltd Coverage Indicator' ;
    rdfs:comment 'Flag indicating whether the member has Long Term Disability coverage through the employer group.' ;
    rdfs:domain ind:Group ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalId rdf:type rdf:Property ;
    rdfs:label 'Renewal Id' ;
    rdfs:comment 'Unique identifier for the enrollment renewal transaction record.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reason rdf:type rdf:Property ;
    rdfs:label 'Reason' ;
    rdfs:comment 'Business reason or trigger for the enrollment renewal action.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewedPlanProductPlanId rdf:type rdf:Property ;
    rdfs:label 'Renewed Plan Product Plan Id' ;
    rdfs:comment 'Identifier for the health plan the member is enrolled in after renewal.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProductPlan .

ind:priorPlanCode rdf:type rdf:Property ;
    rdfs:label 'Prior Plan Code' ;
    rdfs:comment 'Business code for the health plan the member was enrolled in before renewal.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewedPlanCode rdf:type rdf:Property ;
    rdfs:label 'Renewed Plan Code' ;
    rdfs:comment 'Business code for the health plan the member is enrolled in after renewal.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPlanName rdf:type rdf:Property ;
    rdfs:label 'Prior Plan Name' ;
    rdfs:comment 'Name of the health plan the member was enrolled in before renewal.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewedPlanName rdf:type rdf:Property ;
    rdfs:label 'Renewed Plan Name' ;
    rdfs:comment 'Name of the health plan the member is enrolled in after renewal.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Premium Amount' ;
    rdfs:comment 'Monthly premium amount charged before the renewal.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Renewed Premium Amount' ;
    rdfs:comment 'Monthly premium amount charged after the renewal.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Change Amount' ;
    rdfs:comment 'Difference between renewed premium and prior premium amounts.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumChangePercentage rdf:type rdf:Property ;
    rdfs:label 'Premium Change Percentage' ;
    rdfs:comment 'Percentage change in premium amount from prior to renewed enrollment.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:periodMonths rdf:type rdf:Property ;
    rdfs:label 'Period Months' ;
    rdfs:comment 'Number of months for which the enrollment is renewed.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberActionRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Member Action Required Indicator' ;
    rdfs:comment 'Flag indicating whether member action was required to complete the renewal.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberConsentIndicator rdf:type rdf:Property ;
    rdfs:label 'Member Consent Indicator' ;
    rdfs:comment 'Flag indicating whether the member provided explicit consent for the renewal.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exchangeCode rdf:type rdf:Property ;
    rdfs:label 'Exchange Code' ;
    rdfs:comment 'Identifier for the health insurance exchange (Federally Facilitated Marketplace or State Based Marketplace) through which the renewal was processed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualifyingLifeEventDate rdf:type rdf:Property ;
    rdfs:label 'Qualifying Life Event Date' ;
    rdfs:comment 'Date on which the qualifying life event occurred.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pcpRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Pcp Required Indicator' ;
    rdfs:comment 'Flag indicating whether the renewed plan requires selection of a primary care physician.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referralRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Referral Required Indicator' ;
    rdfs:comment 'Flag indicating whether the renewed plan requires referrals for specialist care.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyBenefitIndicator rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Benefit Indicator' ;
    rdfs:comment 'Flag indicating whether the renewed plan includes pharmacy benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dentalBenefitIndicator rdf:type rdf:Property ;
    rdfs:label 'Dental Benefit Indicator' ;
    rdfs:comment 'Flag indicating whether the renewed plan includes dental benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:visionBenefitIndicator rdf:type rdf:Property ;
    rdfs:label 'Vision Benefit Indicator' ;
    rdfs:comment 'Flag indicating whether the renewed plan includes vision benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:processingDate rdf:type rdf:Property ;
    rdfs:label 'Processing Date' ;
    rdfs:comment 'Date on which the renewal transaction was processed by the system.' ;
    rdfs:domain ind:Renewal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastRetryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Retry Timestamp' ;
    rdfs:comment 'Timestamp of the most recent retry attempt for the renewal transaction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:taxInfoId rdf:type rdf:Property ;
    rdfs:label 'Tax Info Id' ;
    rdfs:comment 'Unique identifier for the member tax information record.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taxHouseholdSize rdf:type rdf:Property ;
    rdfs:label 'Tax Household Size' ;
    rdfs:comment 'The number of individuals in the member\'s tax household, used to determine Modified Adjusted Gross Income (MAGI) thresholds for subsidy eligibility and premium tax credit calculations.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimedDependentsCount rdf:type rdf:Property ;
    rdfs:label 'Claimed Dependents Count' ;
    rdfs:comment 'The number of dependents the member claims on their tax return, affecting premium tax credit eligibility and household income calculations.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taxExemptFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Flag' ;
    rdfs:comment 'Indicates whether the member is exempt from the individual mandate penalty or premium tax obligations due to religious exemptions, hardship exemptions, or other qualifying circumstances.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exemptionType rdf:type rdf:Property ;
    rdfs:label 'Exemption Type' ;
    rdfs:comment 'The specific type of exemption from the individual mandate or tax obligations, such as religious conscience exemption, hardship exemption, income below filing threshold, short coverage gap, incarceration, or membership in a federally recognized tribe.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exemptionCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Exemption Certificate Number' ;
    rdfs:comment 'The unique certificate number issued by the Health Insurance Marketplace for members who received an exemption from the individual mandate requirement.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aptcMonthlyAmount rdf:type rdf:Property ;
    rdfs:label 'Aptc Monthly Amount' ;
    rdfs:comment 'The monthly dollar amount of Advanced Premium Tax Credit applied to reduce the member\'s premium payment, calculated based on household income and the second lowest cost Silver plan benchmark.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:csrEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Csr Eligible Flag' ;
    rdfs:comment 'Indicates whether the member is eligible for Cost Sharing Reductions that lower out-of-pocket costs for deductibles, copayments, and coinsurance based on household income and enrollment in a Silver-level Qualified Health Plan.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:householdIncomeAmount rdf:type rdf:Property ;
    rdfs:label 'Household Income Amount' ;
    rdfs:comment 'The member\'s reported annual household income used to determine subsidy eligibility, premium tax credit amounts, and Cost Sharing Reduction qualification. This is typically Modified Adjusted Gross Income (MAGI).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incomeVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Income Verification Status' ;
    rdfs:comment 'The status of income verification through the Federal Data Services Hub or manual documentation review, indicating whether reported household income has been confirmed for subsidy eligibility.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incomeVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Income Verification Date' ;
    rdfs:comment 'The date when the member\'s household income was last verified through the Federal Data Services Hub, IRS data matching, or manual documentation review.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fplPercentage rdf:type rdf:Property ;
    rdfs:label 'Fpl Percentage' ;
    rdfs:comment 'The member\'s household income expressed as a percentage of the Federal Poverty Level, used to determine eligibility for premium tax credits, Cost Sharing Reductions, and Medicaid expansion.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chipEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Chip Eligible Flag' ;
    rdfs:comment 'Indicates whether dependent children in the household are eligible for the Children\'s Health Insurance Program based on household income and state-specific CHIP guidelines.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:form1095aIssuedFlag rdf:type rdf:Property ;
    rdfs:label 'Form 1095a Issued Flag' ;
    rdfs:comment 'Indicates whether IRS Form 1095-A (Health Insurance Marketplace Statement) has been issued to the member for the tax year, required for premium tax credit reconciliation on Form 8962.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:form1095aIssueDate rdf:type rdf:Property ;
    rdfs:label 'Form 1095a Issue Date' ;
    rdfs:comment 'The date when IRS Form 1095-A was issued to the member, typically by January 31st following the coverage year.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:form1095bIssuedFlag rdf:type rdf:Property ;
    rdfs:label 'Form 1095b Issued Flag' ;
    rdfs:comment 'Indicates whether IRS Form 1095-B (Health Coverage) has been issued to the member for minimum essential coverage reporting to satisfy individual mandate requirements.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:form1095bIssueDate rdf:type rdf:Property ;
    rdfs:label 'Form 1095b Issue Date' ;
    rdfs:comment 'The date when IRS Form 1095-B was issued to the member for health coverage reporting.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:form1095cIssuedFlag rdf:type rdf:Property ;
    rdfs:label 'Form 1095c Issued Flag' ;
    rdfs:comment 'Indicates whether IRS Form 1095-C (Employer-Provided Health Insurance Offer and Coverage) has been issued for members with employer-sponsored coverage, used for employer mandate compliance.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:form1095cIssueDate rdf:type rdf:Property ;
    rdfs:label 'Form 1095c Issue Date' ;
    rdfs:comment 'The date when IRS Form 1095-C was issued to the member for employer-sponsored coverage reporting.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reconciliationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Required Flag' ;
    rdfs:comment 'Indicates whether the member must reconcile Advanced Premium Tax Credits received during the year with actual premium tax credits calculated on their tax return using Form 8962.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:excessAptcRepaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Excess Aptc Repayment Amount' ;
    rdfs:comment 'The dollar amount the member must repay to the IRS if actual household income exceeded estimated income and resulted in excess Advanced Premium Tax Credits being paid on their behalf.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:additionalPtcRefundAmount rdf:type rdf:Property ;
    rdfs:label 'Additional Ptc Refund Amount' ;
    rdfs:comment 'The dollar amount the member is entitled to receive as an additional premium tax credit refund if actual household income was lower than estimated and they received less APTC than eligible for.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slcspPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Slcsp Premium Amount' ;
    rdfs:comment 'The monthly premium amount for the Second Lowest Cost Silver Plan available in the member\'s rating area, used as the benchmark for calculating premium tax credit amounts.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enrollmentPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Enrollment Premium Amount' ;
    rdfs:comment 'The monthly premium amount for the member\'s actual enrolled Qualified Health Plan before application of Advanced Premium Tax Credits.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:citizenshipStatus rdf:type rdf:Property ;
    rdfs:label 'Citizenship Status' ;
    rdfs:comment 'The member\'s citizenship or immigration status, which affects eligibility for premium tax credits, Cost Sharing Reductions, and Medicaid coverage under the Affordable Care Act.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:citizenshipVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Citizenship Verification Status' ;
    rdfs:comment 'The status of citizenship or immigration status verification through the Department of Homeland Security SAVE system or Social Security Administration data matching.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:citizenshipVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Citizenship Verification Date' ;
    rdfs:comment 'The date when the member\'s citizenship or lawful presence status was last verified through federal data matching systems.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incarcerationStatus rdf:type rdf:Property ;
    rdfs:label 'Incarceration Status' ;
    rdfs:comment 'Indicates whether the member is currently incarcerated, which affects eligibility for premium tax credits and Marketplace coverage but not Medicaid eligibility.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nativeAmericanStatus rdf:type rdf:Property ;
    rdfs:label 'Native American Status' ;
    rdfs:comment 'Indicates whether the member is a member of a federally recognized Indian tribe, Alaska Native, or Native Hawaiian, which provides special exemptions and limited Cost Sharing Reductions.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tribalExemptionFlag rdf:type rdf:Property ;
    rdfs:label 'Tribal Exemption Flag' ;
    rdfs:comment 'Indicates whether the member qualifies for exemption from the individual mandate and special Cost Sharing Reductions as a member of a federally recognized Indian tribe or Alaska Native.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hardshipExemptionReason rdf:type rdf:Property ;
    rdfs:label 'Hardship Exemption Reason' ;
    rdfs:comment 'The specific hardship circumstance that qualifies the member for exemption from the individual mandate, such as homelessness, eviction, domestic violence, death of family member, or natural disaster.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affordabilityExemptionFlag rdf:type rdf:Property ;
    rdfs:label 'Affordability Exemption Flag' ;
    rdfs:comment 'Indicates whether the member is exempt from the individual mandate because the lowest cost Bronze plan premium exceeds 8% of household income, making coverage unaffordable.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:religiousExemptionFlag rdf:type rdf:Property ;
    rdfs:label 'Religious Exemption Flag' ;
    rdfs:comment 'Indicates whether the member is exempt from the individual mandate due to membership in a recognized religious sect with objections to health insurance.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageGapMonths rdf:type rdf:Property ;
    rdfs:label 'Coverage Gap Months' ;
    rdfs:comment 'The number of consecutive months the member was without minimum essential coverage during the tax year. Gaps of less than 3 months qualify for short coverage gap exemption.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:employerCoverageOfferedFlag rdf:type rdf:Property ;
    rdfs:label 'Employer Coverage Offered Flag' ;
    rdfs:comment 'Indicates whether the member was offered employer-sponsored health coverage that meets minimum value and affordability standards, which affects Marketplace subsidy eligibility.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employerCoverageAffordableFlag rdf:type rdf:Property ;
    rdfs:label 'Employer Coverage Affordable Flag' ;
    rdfs:comment 'Indicates whether employer-sponsored coverage offered to the member meets the affordability standard (employee contribution for self-only coverage does not exceed 9.5% of household income), affecting premium tax credit eligibility.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employerCoverageMinimumValueFlag rdf:type rdf:Property ;
    rdfs:label 'Employer Coverage Minimum Value Flag' ;
    rdfs:comment 'Indicates whether employer-sponsored coverage offered to the member provides minimum value (covers at least 60% of total allowed costs), affecting premium tax credit eligibility.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketplaceApplicationId rdf:type rdf:Property ;
    rdfs:label 'Marketplace Application Id' ;
    rdfs:comment 'The unique identifier for the member\'s Health Insurance Marketplace application used for eligibility determination and subsidy calculations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Application .

ind:eligibilityDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Determination Date' ;
    rdfs:comment 'The date when the member\'s eligibility for premium tax credits, Cost Sharing Reductions, and Marketplace coverage was determined by the Health Insurance Marketplace.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:annualRedeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Annual Redetermination Date' ;
    rdfs:comment 'The date when the member\'s eligibility for subsidies and coverage must be redetermined annually, typically during open enrollment or at the coverage anniversary.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incomeChangeReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Income Change Reported Flag' ;
    rdfs:comment 'Indicates whether the member reported a change in household income during the coverage year that may affect subsidy amounts and require mid-year eligibility redetermination.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incomeChangeReportedDate rdf:type rdf:Property ;
    rdfs:label 'Income Change Reported Date' ;
    rdfs:comment 'The date when the member reported a change in household income that triggered a mid-year eligibility redetermination and potential subsidy adjustment.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:householdCompositionChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Household Composition Change Flag' ;
    rdfs:comment 'Indicates whether the member reported a change in household composition (marriage, divorce, birth, adoption, death) that affects tax household size and subsidy eligibility.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:householdCompositionChangeDate rdf:type rdf:Property ;
    rdfs:label 'Household Composition Change Date' ;
    rdfs:comment 'The date when a qualifying life event changed the member\'s household composition, triggering eligibility redetermination and potential special enrollment period.' ;
    rdfs:domain ind:TaxInfo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:memberNoteId rdf:type rdf:Property ;
    rdfs:label 'Member Note Id' ;
    rdfs:comment 'Unique identifier for the member note record. Primary key for the member note entity.' ;
    rdfs:domain ind:MemberNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sensitivityLevel rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Level' ;
    rdfs:comment 'Classification indicating the sensitivity of the note content for access control and privacy purposes.' ;
    rdfs:domain ind:MemberNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByName rdf:type rdf:Property ;
    rdfs:label 'Created By Name' ;
    rdfs:comment 'Full name of the user who created the note for audit and reference purposes.' ;
    rdfs:domain ind:MemberNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByRole rdf:type rdf:Property ;
    rdfs:label 'Created By Role' ;
    rdfs:comment 'Role or job function of the user who created the note (e.g., care manager, service agent, nurse, claims specialist).' ;
    rdfs:domain ind:MemberNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewedByUserAgentId rdf:type rdf:Property ;
    rdfs:label 'Reviewed By User Agent Id' ;
    rdfs:comment 'Unique identifier of the supervisor or reviewer who reviewed the note.' ;
    rdfs:domain ind:MemberNote ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:contactDate rdf:type rdf:Property ;
    rdfs:label 'Contact Date' ;
    rdfs:comment 'Date of the actual member interaction or event that prompted the note (may differ from note creation date).' ;
    rdfs:domain ind:MemberNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contactDirection rdf:type rdf:Property ;
    rdfs:label 'Contact Direction' ;
    rdfs:comment 'Direction of the contact indicating whether it was initiated by the member (inbound) or by the organization (outbound).' ;
    rdfs:domain ind:MemberNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Call Reference Number' ;
    rdfs:comment 'Reference number or identifier from the telephony or contact center system linking the note to a specific call record.' ;
    rdfs:domain ind:MemberNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programCode rdf:type rdf:Property ;
    rdfs:label 'Program Code' ;
    rdfs:comment 'Code or identifier for the care management or disease management program.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpAssignedTo rdf:type rdf:Property ;
    rdfs:label 'Follow Up Assigned To' ;
    rdfs:comment 'User ID or name of the person assigned to complete the follow-up action.' ;
    rdfs:domain ind:MemberNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionDescription rdf:type rdf:Property ;
    rdfs:label 'Resolution Description' ;
    rdfs:comment 'Description of how the issue was resolved or the outcome of the member interaction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialFlag rdf:type rdf:Property ;
    rdfs:label 'Confidential Flag' ;
    rdfs:comment 'Boolean flag indicating whether the note contains highly confidential or sensitive information requiring restricted access.' ;
    rdfs:domain ind:MemberNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phiFlag rdf:type rdf:Property ;
    rdfs:label 'Phi Flag' ;
    rdfs:comment 'Boolean flag indicating whether the note contains Protected Health Information subject to HIPAA privacy regulations.' ;
    rdfs:domain ind:MemberNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sentimentScore rdf:type rdf:Property ;
    rdfs:label 'Sentiment Score' ;
    rdfs:comment 'Numerical score representing the sentiment or tone of the note content (e.g., positive, negative, neutral), typically derived from text analytics.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sentimentCategory rdf:type rdf:Property ;
    rdfs:label 'Sentiment Category' ;
    rdfs:comment 'Categorical classification of the sentiment or tone of the note content.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deletionDate rdf:type rdf:Property ;
    rdfs:label 'Deletion Date' ;
    rdfs:comment 'Date when the note is scheduled for deletion or purging from the system based on retention policies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalHoldFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Hold Flag' ;
    rdfs:comment 'Boolean flag indicating whether the note is subject to a legal hold and must be preserved for litigation or regulatory investigation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentNoteId rdf:type rdf:Property ;
    rdfs:label 'Parent Note Id' ;
    rdfs:comment 'Identifier of the parent note if this note is a follow-up or addendum to a previous note.' ;
    rdfs:domain ind:MemberNote ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberNote .

ind:isAmendment rdf:type rdf:Property ;
    rdfs:label 'Is Amendment' ;
    rdfs:comment 'Boolean flag indicating whether this note is an amendment or correction to a previous note.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dependentEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Dependent Enrollment Id' ;
    rdfs:comment 'Unique system-generated identifier for the dependent enrollment record linking a dependent to a parent subscriber\'s coverage.' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dependentMiddleName rdf:type rdf:Property ;
    rdfs:label 'Dependent Middle Name' ;
    rdfs:comment 'Middle name or initial of the dependent.' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentSuffix rdf:type rdf:Property ;
    rdfs:label 'Dependent Suffix' ;
    rdfs:comment 'Name suffix of the dependent (e.g., Jr, Sr, II, III).' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentSsn rdf:type rdf:Property ;
    rdfs:label 'Dependent Ssn' ;
    rdfs:comment 'Social Security Number of the dependent used for tax reporting and identification purposes.' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentMaritalStatus rdf:type rdf:Property ;
    rdfs:label 'Dependent Marital Status' ;
    rdfs:comment 'Marital status of the dependent (S=Single, M=Married, D=Divorced, W=Widowed, P=Domestic Partner, U=Unknown).' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentStudentStatus rdf:type rdf:Property ;
    rdfs:label 'Dependent Student Status' ;
    rdfs:comment 'Indicates whether the dependent is a full-time student (F), part-time student (P), or not a student (N). Used for extended coverage eligibility determination.' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentDisabledIndicator rdf:type rdf:Property ;
    rdfs:label 'Dependent Disabled Indicator' ;
    rdfs:comment 'Indicates whether the dependent has a qualifying disability that extends coverage eligibility beyond standard age limits.' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dependentTobaccoUserIndicator rdf:type rdf:Property ;
    rdfs:label 'Dependent Tobacco User Indicator' ;
    rdfs:comment 'Indicates whether the dependent uses tobacco products, which may affect premium calculations under ACA provisions.' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enrollmentType rdf:type rdf:Property ;
    rdfs:label 'Enrollment Type' ;
    rdfs:comment 'Type of enrollment transaction being processed (new enrollment, plan change, termination, reinstatement, audit correction).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sepEndDate rdf:type rdf:Property ;
    rdfs:label 'Sep End Date' ;
    rdfs:comment 'End date of the Special Enrollment Period during which the dependent could be enrolled.' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobraMaxCoverageMonths rdf:type rdf:Property ;
    rdfs:label 'Cobra Max Coverage Months' ;
    rdfs:comment 'Maximum number of months the dependent is eligible for COBRA continuation coverage based on the qualifying event type (typically 18, 29, or 36 months).' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:otherInsuranceIndicator rdf:type rdf:Property ;
    rdfs:label 'Other Insurance Indicator' ;
    rdfs:comment 'Indicates whether the dependent has other health insurance coverage that requires coordination of benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pcpAssignmentRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Pcp Assignment Required Indicator' ;
    rdfs:comment 'Indicates whether the dependent is required to select a Primary Care Physician under the plan design (typically required for HMO plans).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumPaymentMethod rdf:type rdf:Property ;
    rdfs:label 'Premium Payment Method' ;
    rdfs:comment 'Method by which premiums are collected for the dependent\'s coverage (payroll deduction, direct bill, ACH, credit card, check).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeSubscriberMemberProfileId rdf:type rdf:Property ;
    rdfs:label 'Exchange Subscriber Member Profile Id' ;
    rdfs:comment 'Subscriber identifier assigned by the health insurance exchange for marketplace enrollments.' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberProfile .

ind:enrollmentApplicationId rdf:type rdf:Property ;
    rdfs:label 'Enrollment Application Id' ;
    rdfs:comment 'Unique identifier of the enrollment application or transaction that created this dependent enrollment record.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnrollmentApplication .

ind:eligibilityVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verification Status' ;
    rdfs:comment 'Status of eligibility verification for the dependent (verified, pending verification, verification failed, not required).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationPreference rdf:type rdf:Property ;
    rdfs:label 'Communication Preference' ;
    rdfs:comment 'Preferred method of communication for the dependent (mail, email, phone, text message, member portal, no preference).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hipaaAuthorizationIndicator rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization Indicator' ;
    rdfs:comment 'Indicates whether the dependent (or parent/guardian) has provided HIPAA authorization for disclosure of protected health information.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaAuthorizationDate rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization Date' ;
    rdfs:comment 'Date when HIPAA authorization was provided by the dependent or their legal representative.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noticeOfPrivacyPracticesProvidedDate rdf:type rdf:Property ;
    rdfs:label 'Notice Of Privacy Practices Provided Date' ;
    rdfs:comment 'Date when the Notice of Privacy Practices was provided to the dependent or their legal representative.' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:providerAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Provider Assignment Id' ;
    rdfs:comment 'Unique identifier for the provider assignment record. Primary key for the provider assignment entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProviderAssignment .

ind:practiceLocationId rdf:type rdf:Property ;
    rdfs:label 'Practice Location Id' ;
    rdfs:comment 'Identifier for the specific practice location or service location where the provider sees the member. A provider may have multiple practice locations.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:isAcceptingNewPatients rdf:type rdf:Property ;
    rdfs:label 'Is Accepting New Patients' ;
    rdfs:comment 'Indicates whether the assigned provider is currently accepting new patients at the time of assignment. True if accepting, false otherwise.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPcpRequired rdf:type rdf:Property ;
    rdfs:label 'Is Pcp Required' ;
    rdfs:comment 'Indicates whether the member\'s plan requires a Primary Care Physician assignment. True for HMO and some POS plans, false for PPO and EPO plans.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReferralRequired rdf:type rdf:Property ;
    rdfs:label 'Is Referral Required' ;
    rdfs:comment 'Indicates whether the member requires a referral from this assigned provider to see specialists. Typically true for HMO plans with PCP gatekeeping.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignmentSourceTransactionId rdf:type rdf:Property ;
    rdfs:label 'Assignment Source Transaction Id' ;
    rdfs:comment 'The unique transaction identifier from the source system that created or updated the provider assignment. Used for traceability and reconciliation.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentRequestDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Request Date' ;
    rdfs:comment 'The date on which the provider assignment was requested by the member or initiated by the system. May differ from the effective date.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Approval Date' ;
    rdfs:comment 'The date on which the provider assignment was approved or confirmed by the system or administrator. Null if no approval process is required.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentProcessedDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Processed Date' ;
    rdfs:comment 'The date on which the provider assignment was fully processed and recorded in the system of record.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:previousProviderProviderProfileId rdf:type rdf:Property ;
    rdfs:label 'Previous Provider Provider Profile Id' ;
    rdfs:comment 'The identifier of the provider who was previously assigned to the member before this assignment. Null if this is the first assignment.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Profile .

ind:isContinuityOfCareApplicable rdf:type rdf:Property ;
    rdfs:label 'Is Continuity Of Care Applicable' ;
    rdfs:comment 'Indicates whether continuity of care provisions apply to this provider assignment, allowing the member to continue seeing a previous provider for a transition period. True if applicable, false otherwise.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignmentPriority rdf:type rdf:Property ;
    rdfs:label 'Assignment Priority' ;
    rdfs:comment 'A numeric priority or ranking of this provider assignment when a member has multiple concurrent provider assignments. Lower numbers indicate higher priority. Used for claims routing and care coordination.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isPrimaryAssignment rdf:type rdf:Property ;
    rdfs:label 'Is Primary Assignment' ;
    rdfs:comment 'Indicates whether this is the primary provider assignment for the member. True if this is the primary assignment, false if secondary or supplemental.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careTeamRole rdf:type rdf:Property ;
    rdfs:label 'Care Team Role' ;
    rdfs:comment 'The specific role this provider plays in the member\'s care team. Examples include primary care physician, care coordinator, case manager, specialist consultant, etc.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Attribution Effective Date' ;
    rdfs:comment 'The date on which the member attribution to this provider becomes effective for quality measurement and value-based care programs. May differ from the assignment effective date.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attributionEndDate rdf:type rdf:Property ;
    rdfs:label 'Attribution End Date' ;
    rdfs:comment 'The date on which the member attribution to this provider ends for quality measurement and value-based care programs. Null if attribution is currently active.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vbcProgramId rdf:type rdf:Property ;
    rdfs:label 'Vbc Program Id' ;
    rdfs:comment 'Identifier for the value-based care program or alternative payment model under which this provider assignment is managed. Examples include ACO, PCMH, bundled payment programs.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Program .

ind:acoId rdf:type rdf:Property ;
    rdfs:label 'Aco Id' ;
    rdfs:comment 'Identifier for the Accountable Care Organization to which the assigned provider belongs, if applicable. Used for ACO attribution and shared savings programs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcmhRecognitionLevel rdf:type rdf:Property ;
    rdfs:label 'Pcmh Recognition Level' ;
    rdfs:comment 'The NCQA Patient Centered Medical Home recognition level of the assigned provider\'s practice. Levels include Level 1, Level 2, Level 3, or not recognized.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costEfficiencyTier rdf:type rdf:Property ;
    rdfs:label 'Cost Efficiency Tier' ;
    rdfs:comment 'The cost efficiency tier or rating of the assigned provider based on cost and utilization metrics. Used for tiered network designs and value-based contracting.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderPreferenceMatch rdf:type rdf:Property ;
    rdfs:label 'Gender Preference Match' ;
    rdfs:comment 'Indicates whether the assigned provider\'s gender matches the member\'s stated provider gender preference. True if matched, false otherwise.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:distanceFromMemberMiles rdf:type rdf:Property ;
    rdfs:label 'Distance From Member Miles' ;
    rdfs:comment 'The calculated distance in miles between the member\'s primary address and the assigned provider\'s practice location. Used for network adequacy and access monitoring.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assignmentComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Assignment Compliance Status' ;
    rdfs:comment 'Indicates whether the provider assignment meets regulatory and contractual compliance requirements. Statuses include compliant, non-compliant, pending review, or exempt.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentAuditFlag rdf:type rdf:Property ;
    rdfs:label 'Assignment Audit Flag' ;
    rdfs:comment 'Indicates whether this provider assignment has been flagged for audit or review due to unusual patterns, compliance concerns, or quality issues. True if flagged, false otherwise.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHighRiskMember rdf:type rdf:Property ;
    rdfs:label 'Is High Risk Member' ;
    rdfs:comment 'Indicates whether the member is classified as high-risk at the time of provider assignment, requiring enhanced care coordination. True if high-risk, false otherwise.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assignmentVersion rdf:type rdf:Property ;
    rdfs:label 'Assignment Version' ;
    rdfs:comment 'Version number for this provider assignment record, incremented with each update or change. Used for change tracking and audit trail.' ;
    rdfs:domain ind:ProviderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberEventId rdf:type rdf:Property ;
    rdfs:label 'Member Event Id' ;
    rdfs:comment 'Unique identifier for each member event record. Primary key for the member event data product.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qualifyingEventIndicator rdf:type rdf:Property ;
    rdfs:label 'Qualifying Event Indicator' ;
    rdfs:comment 'Flag indicating whether this event qualifies as a Special Enrollment Period (SEP) qualifying life event under ACA regulations.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:newPlanProductPlanId rdf:type rdf:Property ;
    rdfs:label 'New Plan Product Plan Id' ;
    rdfs:comment 'Identifier of the health plan the member is enrolled in after this event. Used for plan change tracking and enrollment reporting.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProductPlan .

ind:priorCoverageLevel rdf:type rdf:Property ;
    rdfs:label 'Prior Coverage Level' ;
    rdfs:comment 'The coverage tier level before the event occurred. Indicates how many individuals were covered under the policy.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newCoverageLevel rdf:type rdf:Property ;
    rdfs:label 'New Coverage Level' ;
    rdfs:comment 'The coverage tier level after the event occurred. Used to track changes in family composition and premium calculations.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPcpNpi rdf:type rdf:Property ;
    rdfs:label 'Prior Pcp Npi' ;
    rdfs:comment 'The 10-digit National Provider Identifier of the member\'s primary care physician before the event. Used for PCP change tracking.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumChangeReason rdf:type rdf:Property ;
    rdfs:label 'Premium Change Reason' ;
    rdfs:comment 'Explanation for any change in premium amount associated with this event. Examples include age rating, plan change, or coverage tier change.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobraEndDate rdf:type rdf:Property ;
    rdfs:label 'Cobra End Date' ;
    rdfs:comment 'The date when COBRA continuation coverage ends. Used for eligibility termination and compliance reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicareEntitlementIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicare Entitlement Indicator' ;
    rdfs:comment 'Flag indicating whether the member has Medicare entitlement. Critical for coordination of benefits and dual eligibility determination.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidEligibilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicaid Eligibility Indicator' ;
    rdfs:comment 'Flag indicating whether the member is eligible for Medicaid benefits. Used for dual eligibility determination and COB.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialEnrollmentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Special Enrollment Period Start Date' ;
    rdfs:comment 'The start date of the Special Enrollment Period triggered by a qualifying life event. Used for enrollment window validation.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:specialEnrollmentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Special Enrollment Period End Date' ;
    rdfs:comment 'The end date of the Special Enrollment Period. Used to validate timely enrollment and compliance with ACA regulations.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorCarrierName rdf:type rdf:Property ;
    rdfs:label 'Prior Carrier Name' ;
    rdfs:comment 'Name of the previous health insurance carrier if the member transferred from another insurer. Used for market share analysis and transition tracking.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorCoverageTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Prior Coverage Termination Date' ;
    rdfs:comment 'The date when the member\'s previous health insurance coverage ended. Used for gap analysis and continuous coverage verification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageGapDays rdf:type rdf:Property ;
    rdfs:label 'Coverage Gap Days' ;
    rdfs:comment 'Number of days between prior coverage termination and new coverage effective date. Used for underwriting and risk assessment.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dependentRelationship rdf:type rdf:Property ;
    rdfs:label 'Dependent Relationship' ;
    rdfs:comment 'The relationship of the member to the primary subscriber if this is a dependent event. Used for eligibility verification and family coverage tracking.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentAgeOutDate rdf:type rdf:Property ;
    rdfs:label 'Dependent Age Out Date' ;
    rdfs:comment 'The date when a dependent member will age out of eligibility under the plan. Used for proactive notification and coverage transition planning.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:studentStatusIndicator rdf:type rdf:Property ;
    rdfs:label 'Student Status Indicator' ;
    rdfs:comment 'Flag indicating whether the dependent member is a full-time student. May extend eligibility beyond standard age limits.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wellnessProgramParticipationIndicator rdf:type rdf:Property ;
    rdfs:label 'Wellness Program Participation Indicator' ;
    rdfs:comment 'Flag indicating whether the member is participating in employer-sponsored wellness programs. May affect premium discounts.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outOfAreaIndicator rdf:type rdf:Property ;
    rdfs:label 'Out Of Area Indicator' ;
    rdfs:comment 'Flag indicating whether the member resides outside the plan\'s primary service area. May affect network access and benefits.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:careManagementProgramEnrollmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Care Management Program Enrollment Indicator' ;
    rdfs:comment 'Flag indicating whether the member is enrolled in a care management or disease management program. Used for care coordination.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paperlessIndicator rdf:type rdf:Property ;
    rdfs:label 'Paperless Indicator' ;
    rdfs:comment 'Flag indicating whether the member has elected to receive communications electronically rather than by mail. Used for document delivery.' ;
    rdfs:domain ind:Member ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketingOptInIndicator rdf:type rdf:Property ;
    rdfs:label 'Marketing Opt In Indicator' ;
    rdfs:comment 'Flag indicating whether the member has consented to receive marketing communications. Used for compliance with CAN-SPAM and TCPA.' ;
    rdfs:domain ind:Member ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noticeOfPrivacyPracticesAcknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Notice Of Privacy Practices Acknowledgment Date' ;
    rdfs:comment 'The date when the member acknowledged receipt of the Notice of Privacy Practices. Required for HIPAA compliance.' ;
    rdfs:domain ind:MemberEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submittedByUserId rdf:type rdf:Property ;
    rdfs:label 'Submitted By User Id' ;
    rdfs:comment 'Identifier of the user or system account that submitted or recorded the member event. Used for audit trails and accountability.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

