ind:averageHandleTimeTargetSeconds rdf:type rdf:Property ;
    rdfs:label 'Average Handle Time Target Seconds' ;
    rdfs:comment 'Target average handle time in seconds for interactions in this queue, including talk time, hold time, and after-call work.' ;
    rdfs:domain ind:Queue ;
