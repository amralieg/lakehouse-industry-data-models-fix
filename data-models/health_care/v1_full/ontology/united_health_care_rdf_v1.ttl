    rdfs:range ind:IncentiveProgram .

ind:programDescription rdf:type rdf:Property ;
    rdfs:label 'Program Description' ;
    rdfs:comment 'Detailed description of the incentive program including objectives, target behaviors, and expected outcomes.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participantRole rdf:type rdf:Property ;
    rdfs:label 'Participant Role' ;
    rdfs:comment 'The sales role or position eligible to participate in this incentive program.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payoutFrequency rdf:type rdf:Property ;
    rdfs:label 'Payout Frequency' ;
    rdfs:comment 'The frequency at which incentive payments are disbursed to participants (monthly, quarterly, semi-annual, annual, upon achievement, deferred).' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payoutTimingDays rdf:type rdf:Property ;
    rdfs:label 'Payout Timing Days' ;
    rdfs:comment 'Number of days after the performance period ends when incentive payments are processed and disbursed.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capType rdf:type rdf:Property ;
    rdfs:label 'Cap Type' ;
    rdfs:comment 'The type of cap applied to incentive payouts (per performance period, per enrollment, annual, lifetime, or no cap).' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acceleratorEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Accelerator Enabled Flag' ;
    rdfs:comment 'Indicates whether the incentive program includes accelerator provisions that increase payout rates when performance exceeds defined thresholds.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acceleratorThreshold rdf:type rdf:Property ;
    rdfs:label 'Accelerator Threshold' ;
    rdfs:comment 'The performance level at which accelerated commission rates begin to apply.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acceleratorMultiplier rdf:type rdf:Property ;
    rdfs:label 'Accelerator Multiplier' ;
    rdfs:comment 'The multiplier applied to the base commission rate when performance exceeds the accelerator threshold.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Clawback Enabled Flag' ;
    rdfs:comment 'Indicates whether the incentive program includes clawback provisions that allow recovery of incentive payments under specified conditions (e.g., member cancellation, policy lapse).' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clawbackPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Clawback Period Months' ;
    rdfs:comment 'The number of months after initial payout during which clawback provisions may be applied if triggering conditions occur.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clawbackTriggerCondition rdf:type rdf:Property ;
    rdfs:label 'Clawback Trigger Condition' ;
    rdfs:comment 'Detailed description of the conditions that trigger clawback of incentive payments (e.g., member cancellation within 90 days, policy non-payment, fraud detection).' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualPaymentEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Residual Payment Enabled Flag' ;
    rdfs:comment 'Indicates whether the incentive program includes ongoing residual payments for retained members or renewed policies beyond the initial sale period.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:residualPaymentDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Residual Payment Duration Months' ;
    rdfs:comment 'The number of months for which residual payments continue after the initial sale, if applicable.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:residualPaymentRate rdf:type rdf:Property ;
    rdfs:label 'Residual Payment Rate' ;
    rdfs:comment 'The commission rate or percentage applied to residual payments for retained members or renewed policies.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitCommissionAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Split Commission Allowed Flag' ;
    rdfs:comment 'Indicates whether commission splitting among multiple sales participants is permitted under this incentive program.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideCommissionEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Override Commission Enabled Flag' ;
    rdfs:comment 'Indicates whether sales managers or supervisors are eligible for override commissions on their team\'s sales under this program.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateRestrictionList rdf:type rdf:Property ;
    rdfs:label 'State Restriction List' ;
    rdfs:comment 'Comma-separated list of state codes where this incentive program is restricted or not applicable due to regulatory or business constraints.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentSeasonType rdf:type rdf:Property ;
    rdfs:label 'Enrollment Season Type' ;
    rdfs:comment 'The enrollment period type this incentive program targets (Annual Enrollment Period, Open Enrollment Period, Special Enrollment Period, year-round, campaign-specific).' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingSource rdf:type rdf:Property ;
    rdfs:label 'Funding Source' ;
    rdfs:comment 'The organizational department or cost center providing funding for this incentive program.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programOwnerName rdf:type rdf:Property ;
    rdfs:label 'Program Owner Name' ;
    rdfs:comment 'The name of the sales operations or compensation manager responsible for administering this incentive program.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programOwnerEmail rdf:type rdf:Property ;
    rdfs:label 'Program Owner Email' ;
    rdfs:comment 'The email address of the program owner for inquiries and administration.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryConstraintNotes rdf:type rdf:Property ;
    rdfs:label 'Regulatory Constraint Notes' ;
    rdfs:comment 'Free-text notes documenting any regulatory constraints, limitations, or special considerations applicable to this incentive program (e.g., CMS marketing guidelines, state insurance regulations, Anti-Kickback Statute considerations).' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationPlanDescription rdf:type rdf:Property ;
    rdfs:label 'Communication Plan Description' ;
    rdfs:comment 'Description of the communication strategy and channels used to inform eligible participants about the incentive program details and requirements.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityAssuranceCriteria rdf:type rdf:Property ;
