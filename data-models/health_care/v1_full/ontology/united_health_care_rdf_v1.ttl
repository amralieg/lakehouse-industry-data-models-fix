    rdfs:range xsd:boolean .

ind:selfFundedFlag rdf:type rdf:Property ;
    rdfs:label 'Self Funded Flag' ;
    rdfs:comment 'Indicates whether this AR line item is associated with a self-funded health plan.' ;
