ind:reinstatementDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Date' ;
    rdfs:comment 'The date when the coverage was reinstated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waitingPeriodWaivedIndicator rdf:type rdf:Property ;
    rdfs:label 'Waiting Period Waived Indicator' ;
    rdfs:comment 'Indicates whether the waiting period for coverage was waived.' ;
