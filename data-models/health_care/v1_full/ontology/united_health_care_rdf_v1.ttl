ind:dependentRemovalAllowed rdf:type rdf:Property ;
    rdfs:label 'Dependent Removal Allowed' ;
    rdfs:comment 'Indicates whether dependents can be removed from coverage during the special enrollment period triggered by this QLE.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:effectiveDateRule rdf:type rdf:Property ;
    rdfs:label 'Effective Date Rule' ;
    rdfs:comment 'Rule determining when coverage becomes effective following enrollment during the special enrollment period.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveDateOffsetDays rdf:type rdf:Property ;
    rdfs:label 'Effective Date Offset Days' ;
    rdfs:comment 'Number of days to offset the coverage effective date from the event date or enrollment date based on the effective date rule.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
