    rdfs:comment 'Comma-separated list of direct competitor brand names that must be excluded from partnerships due to category exclusivity. Used for conflict checking and sales pipeline management.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPartnershipDate rdf:type rdf:Property ;
    rdfs:label 'Last Partnership Date' ;
    rdfs:comment 'Date of the most recent active or completed sponsorship partnership with the brand. Used for recency analysis and reactivation targeting.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalEntityType rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Type' ;
    rdfs:comment 'Legal structure of the brand\'s parent organization (e.g., corporation, LLC, partnership). Used for contract structuring and compliance requirements.' ;
