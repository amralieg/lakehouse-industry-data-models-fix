    rdfs:comment 'Citation of the federal regulation or statute that establishes this qualifying life event and special enrollment rights.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateVariationAllowed rdf:type rdf:Property ;
