    rdfs:comment 'The primary objective of the campaign that generated this response.' ;
    rdfs:domain ind:Marketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offerName rdf:type rdf:Property ;
    rdfs:label 'Offer Name' ;
    rdfs:comment 'Descriptive name of the offer.' ;
    rdfs:domain ind:CampaignOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offerType rdf:type rdf:Property ;
    rdfs:label 'Offer Type' ;
    rdfs:comment 'Category of the offer (e.g., discount, rebate).' ;
    rdfs:domain ind:CampaignOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offerDescription rdf:type rdf:Property ;
    rdfs:label 'Offer Description' ;
    rdfs:comment 'Full textual description of the offer, including benefits and conditions.' ;
    rdfs:domain ind:CampaignOffer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:campaignStartDate rdf:type rdf:Property ;
    rdfs:label 'Campaign Start Date' ;
    rdfs:comment 'Start date of the marketing campaign.' ;
    rdfs:domain ind:Marketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:campaignEndDate rdf:type rdf:Property ;
    rdfs:label 'Campaign End Date' ;
    rdfs:comment 'End date of the marketing campaign.' ;
    rdfs:domain ind:Marketing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:campaignStatus rdf:type rdf:Property ;
    rdfs:label 'Campaign Status' ;
    rdfs:comment 'Current status of the campaign.' ;
    rdfs:domain ind:TargetMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pcmhPracticeId rdf:type rdf:Property ;
    rdfs:label 'Pcmh Practice Id' ;
    rdfs:comment 'Identifier for the NCQA-recognized Patient Centered Medical Home practice the member is assigned to.' ;
    rdfs:domain ind:MemberProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardholderId rdf:type rdf:Property ;
    rdfs:label 'Cardholder Id' ;
    rdfs:comment 'Identifier printed on the member\'s pharmacy benefit card used at point of sale.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:campaignOwnerName rdf:type rdf:Property ;
    rdfs:label 'Campaign Owner Name' ;
    rdfs:comment 'Name of the internal business owner or manager responsible for this campaign within the program.' ;
    rdfs:domain ind:ProgramCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacyTaxId rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Tax Id' ;
    rdfs:comment 'Federal Tax Identification Number (EIN) of the pharmacy organization for payment and tax reporting.' ;
    rdfs:domain ind:ContractPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacyClaimId rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Claim Id' ;
    rdfs:comment 'Identifier linking this line to the parent pharmacy claim header.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claim .

ind:manufacturerId rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Id' ;
    rdfs:comment 'Unique identifier for the pharmaceutical manufacturer in the system.' ;
    rdfs:domain ind:Pharmacy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Manufacturer .

ind:pbmPartnerId rdf:type rdf:Property ;
    rdfs:label 'Pbm Partner Id' ;
    rdfs:comment 'Identifier for the PBM partner involved in the rebate transaction, if applicable.' ;
    rdfs:domain ind:RebateTxn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pharmacyId rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Id' ;
    rdfs:comment 'Unique identifier for the pharmacy where the refill is requested.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Pharmacy .

ind:vendorTaxNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Tax Number' ;
    rdfs:comment 'Tax identification number of the vendor for reporting and compliance.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetCategory rdf:type rdf:Property ;
    rdfs:label 'Budget Category' ;
    rdfs:comment 'The high-level category classification of the budget line (e.g., operating, capital, medical, administrative).' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetSubcategory rdf:type rdf:Property ;
    rdfs:label 'Budget Subcategory' ;
    rdfs:comment 'The detailed subcategory classification within the budget category for more granular tracking.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrailAuditLogId rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Audit Log Id' ;
    rdfs:comment 'The unique identifier linking this budget line to the audit trail for compliance and tracking purposes.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditLog .

ind:auditorId rdf:type rdf:Property ;
    rdfs:label 'Auditor Id' ;
    rdfs:comment 'Unique identifier of the auditor.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Auditor .

ind:parentContractId rdf:type rdf:Property ;
    rdfs:label 'Parent Contract Id' ;
    rdfs:comment 'Identifier of the parent contract in the hierarchy (e.g., master agreement, umbrella contract).' ;
    rdfs:domain ind:ContractHierarchy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contract .

ind:childContractId rdf:type rdf:Property ;
    rdfs:label 'Child Contract Id' ;
    rdfs:comment 'Identifier of the child contract in the hierarchy (e.g., sub-agreement, amendment, rider).' ;
    rdfs:domain ind:ContractHierarchy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contract .

ind:knowledgeArticleId rdf:type rdf:Property ;
    rdfs:label 'Knowledge Article Id' ;
    rdfs:comment 'Identifier of the primary knowledge base article providing guidance for resolving issues in this category.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:KnowledgeArticle .

ind:advocateId rdf:type rdf:Property ;
    rdfs:label 'Advocate Id' ;
    rdfs:comment 'Unique identifier for the member advocate assigned to handle the request.' ;
    rdfs:domain ind:Advocacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:advocateTeam rdf:type rdf:Property ;
    rdfs:label 'Advocate Team' ;
    rdfs:comment 'Team or department to which the assigned advocate belongs.' ;
    rdfs:domain ind:Advocacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignerId rdf:type rdf:Property ;
    rdfs:label 'Assigner Id' ;
    rdfs:comment 'Unique identifier of the user, supervisor, or system that performed the assignment action.' ;
    rdfs:domain ind:ServiceCaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assigneeId rdf:type rdf:Property ;
    rdfs:label 'Assignee Id' ;
    rdfs:comment 'Unique identifier of the agent or queue to whom the case is assigned.' ;
    rdfs:domain ind:ServiceCaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:previousAssigneeAgentId rdf:type rdf:Property ;
    rdfs:label 'Previous Assignee Agent Id' ;
    rdfs:comment 'Unique identifier of the previous agent or queue who held the case before this assignment. Null for initial assignments.' ;
    rdfs:domain ind:ServiceCaseAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:queueType rdf:type rdf:Property ;
    rdfs:label 'Queue Type' ;
    rdfs:comment 'Classification of the queue indicating its purpose and priority level within the service organization.' ;
    rdfs:domain ind:ServiceCaseAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalatedFromUserId rdf:type rdf:Property ;
    rdfs:label 'Escalated From User Id' ;
    rdfs:comment 'System identifier of the customer service representative or agent who initiated the escalation from the original tier.' ;
    rdfs:domain ind:CaseEscalation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:grievanceId rdf:type rdf:Property ;
    rdfs:label 'Grievance Id' ;
    rdfs:comment 'Unique identifier of the formal member grievance associated with the escalation, if the case involves a regulatory grievance process.' ;
    rdfs:domain ind:Service ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Grievance .

ind:clinicalReviewerId rdf:type rdf:Property ;
    rdfs:label 'Clinical Reviewer Id' ;
    rdfs:comment 'Identifier for the clinical professional who performed the medical necessity review.' ;
    rdfs:domain ind:ProgramClaim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Reviewer .

ind:caqhId rdf:type rdf:Property ;
    rdfs:label 'Caqh Id' ;
    rdfs:comment 'Unique identifier from CAQH ProView system used for centralized provider credentialing data.' ;
    rdfs:domain ind:Credential ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credentialingSpecialistId rdf:type rdf:Property ;
    rdfs:label 'Credentialing Specialist Id' ;
    rdfs:comment 'Identifier for the credentialing specialist assigned to process this application.' ;
    rdfs:domain ind:Credentialing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CredentialingSpecialist .

ind:agentEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Agent Employee Id' ;
    rdfs:comment 'Human Resources employee identifier for the service agent. Used for payroll and HR system integration.' ;
    rdfs:domain ind:ServiceSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:verifierAgentId rdf:type rdf:Property ;
    rdfs:label 'Verifier Agent Id' ;
    rdfs:comment 'Unique identifier for the credentialing specialist or staff member who performed the verification.' ;
    rdfs:domain ind:VerificationEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agent .

ind:underwriterId rdf:type rdf:Property ;
    rdfs:label 'Underwriter Id' ;
    rdfs:comment 'Unique identifier for the underwriter who made the decision.' ;
    rdfs:domain ind:Sales ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Underwriter .

ind:medicalDirectorId rdf:type rdf:Property ;
    rdfs:label 'Medical Director Id' ;
    rdfs:comment 'Unique identifier for the medical director who reviewed the case.' ;
    rdfs:domain ind:Sales ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MedicalDirector .

ind:complianceReviewerId rdf:type rdf:Property ;
    rdfs:label 'Compliance Reviewer Id' ;
    rdfs:comment 'Unique identifier for the compliance officer who reviewed the decision.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceReviewer .

ind:convertedMemberId rdf:type rdf:Property ;
    rdfs:label 'Converted Member Id' ;
    rdfs:comment 'The unique identifier of the member record created when this lead successfully enrolled in coverage.' ;
    rdfs:domain ind:Lead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:facilityId rdf:type rdf:Property ;
    rdfs:label 'Facility Id' ;
    rdfs:comment 'Internal unique identifier for the healthcare facility where services were rendered or where the member is receiving care related to this case.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:initiatedByUserId rdf:type rdf:Property ;
    rdfs:label 'Initiated By User Id' ;
    rdfs:comment 'Identifier of the user or system account that initiated the status change.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:performedByUserId rdf:type rdf:Property ;
    rdfs:label 'Performed By User Id' ;
    rdfs:comment 'System identifier of the user or service that performed the operation.' ;
    rdfs:domain ind:AuditLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:surveyStatus rdf:type rdf:Property ;
    rdfs:label 'Survey Status' ;
    rdfs:comment 'Overall completion status of the entire survey for this member. Indicates whether the full survey was completed or abandoned.' ;
    rdfs:domain ind:SurveyResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prefix rdf:type rdf:Property ;
    rdfs:label 'Prefix' ;
    rdfs:comment 'Title or prefix preceding the provider\'s name (e.g., Dr., Mr., Mrs.).' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryTaxonomyCode rdf:type rdf:Property ;
    rdfs:label 'Primary Taxonomy Code' ;
    rdfs:comment 'Primary Healthcare Provider Taxonomy Code representing the provider\'s main specialty or service classification.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceCounty rdf:type rdf:Property ;
    rdfs:label 'Practice County' ;
    rdfs:comment 'County name for the provider\'s main practice location. Used for network adequacy and geographic access analysis.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:practiceCountryCode rdf:type rdf:Property ;
    rdfs:label 'Practice Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the provider\'s practice location.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hospitalBasedFlag rdf:type rdf:Property ;
    rdfs:label 'Hospital Based Flag' ;
    rdfs:comment 'Indicates whether the provider practices primarily in a hospital setting.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hospitalAffiliationNpi rdf:type rdf:Property ;
    rdfs:label 'Hospital Affiliation Npi' ;
    rdfs:comment 'NPI of the primary hospital where the provider has admitting privileges.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalGroupNpi rdf:type rdf:Property ;
    rdfs:label 'Medical Group Npi' ;
    rdfs:comment 'Type 2 NPI of the medical group or practice organization.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalGroupTin rdf:type rdf:Property ;
    rdfs:label 'Medical Group Tin' ;
    rdfs:comment 'Tax identification number of the medical group for billing and payment purposes.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wheelchairAccessibleFlag rdf:type rdf:Property ;
    rdfs:label 'Wheelchair Accessible Flag' ;
    rdfs:comment 'Indicates whether the provider\'s practice location is wheelchair accessible.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:afterHoursAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'After Hours Available Flag' ;
    rdfs:comment 'Indicates whether the provider offers after-hours or extended-hours services.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parkingAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Parking Available Flag' ;
    rdfs:comment 'Indicates whether parking is available at the provider\'s practice location.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicTransportationAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Public Transportation Access Flag' ;
    rdfs:comment 'Indicates whether the provider\'s practice location is accessible by public transportation.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:directoryLastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Directory Last Verified Date' ;
    rdfs:comment 'Date when the provider\'s directory information was last verified for accuracy.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:npdbReportableActionFlag rdf:type rdf:Property ;
    rdfs:label 'Npdb Reportable Action Flag' ;
    rdfs:comment 'Indicates whether any reportable actions were found in the NPDB query.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionsExclusionsFlag rdf:type rdf:Property ;
    rdfs:label 'Sanctions Exclusions Flag' ;
    rdfs:comment 'Indicates whether the provider appears on federal or state exclusion or sanction lists.' ;
    rdfs:domain ind:Provider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enrollmentSourceId rdf:type rdf:Property ;
    rdfs:label 'Enrollment Source Id' ;
    rdfs:comment 'Foreign key linking to enrollment.source. Business justification: Dependent_enrollment enrollment source should reference the source table. The enrollment_source STRING column will be replaced by enrollment_source_id FK to source.source_id.' ;
    rdfs:domain ind:DependentEnrollment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Source .

ind:sourceProviderProfileId rdf:type rdf:Property ;
    rdfs:label 'Source Provider Profile Id' ;
    rdfs:comment 'Foreign key linking to provider.provider_profile. Business justification: Links referral source provider to provider_profile master. Currently referral_network has source_provider_npi but no direct FK to provider_profile. Enables joining to get authoritative source provider' ;
    rdfs:domain ind:ReferralNetwork ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Profile .

ind:destinationProviderProfileId rdf:type rdf:Property ;
    rdfs:label 'Destination Provider Profile Id' ;
    rdfs:comment 'Foreign key linking to provider.provider_profile. Business justification: Links referral destination provider to provider_profile master. Currently referral_network has destination_provider_npi but no direct FK to provider_profile. Enables joining to get authoritative desti' ;
    rdfs:domain ind:ReferralNetwork ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Profile .

ind:sourceFinanceAccountId rdf:type rdf:Property ;
    rdfs:label 'Source Finance Account Id' ;
    rdfs:comment 'Foreign key linking to finance.finance_account. Business justification: intercompany_transaction references a source account. The source_account_code is used for lookup, but adding FK to finance_account provides referential integrity and allows joining to get full account' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceAccount .

ind:destinationFinanceAccountId rdf:type rdf:Property ;
    rdfs:label 'Destination Finance Account Id' ;
    rdfs:comment 'Foreign key linking to finance.finance_account. Business justification: intercompany_transaction references a destination account. The destination_account_code is used for lookup, but adding FK to finance_account provides referential integrity and allows joining to get fu' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceAccount .

ind:sourceCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Source Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: allocation_detail references a source cost center. The source_cost_center_code is used for lookup, but adding FK provides referential integrity and allows joining to get full cost center details.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:targetCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Target Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: allocation_detail references a target cost center. The target_cost_center_code is used for lookup, but adding FK provides referential integrity and allows joining to get full cost center details.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:targetFinanceAccountId rdf:type rdf:Property ;
    rdfs:label 'Target Finance Account Id' ;
    rdfs:comment 'Foreign key linking to finance.finance_account. Business justification: allocation_detail references a target GL account. The target_gl_account_code is used for lookup, but adding FK to finance_account provides referential integrity and allows joining to get full account ' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceAccount .

ind:stageId rdf:type rdf:Property ;
    rdfs:label 'Stage Id' ;
    rdfs:comment 'Foreign key linking to sales.opportunity_stage. Business justification: Opportunity has stage (STRING) but needs FK to opportunity_stage reference table for standardized stage definitions and probability mapping.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OpportunityStage .

ind:productCatalogId rdf:type rdf:Property ;
    rdfs:label 'Product Catalog Id' ;
    rdfs:comment 'Foreign key linking to sales.product_catalog. Business justification: Opportunity references product offerings. FK to product_catalog enables product-specific opportunity tracking and plan details.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProductPlan .

ind:rateId rdf:type rdf:Property ;
    rdfs:label 'Rate Id' ;
    rdfs:comment 'Foreign key linking to billing.premium_rate. Business justification: Premiums are calculated using premium rates from rate schedules. Need to link to the specific rate used for audit and rate change tracking. Cannot remove rate_basis or base_premium_amount as they are ' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumRate .

ind:verificationId rdf:type rdf:Property ;
    rdfs:label 'Verification Id' ;
    rdfs:comment 'Foreign key linking to eligibility.verification. Business justification: Claims reference the eligibility verification performed at service time. Pre-service verification determines coverage status and prevents claim denials due to ineligibility.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Verification .

ind:reasonId rdf:type rdf:Property ;
    rdfs:label 'Reason Id' ;
    rdfs:comment 'Foreign key linking to claim.claim_denial_reason. Business justification: Pharmacy claim denials reference enterprise-wide standardized denial reason codes. Pharmacy benefits managers use common denial taxonomies (non-covered drug, refill too soon, plan limitations) for con' ;
    rdfs:domain ind:ClaimDenial ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DenialReason .

ind:originalEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Original Enrollment Id' ;
    rdfs:comment 'Foreign key linking to enrollment.enrollment. Business justification: COBRA continuation must reference original group enrollment to maintain benefit continuity, apply qualifying event rules, and track 18/36-month continuation periods. Federal compliance requirement for' ;
    rdfs:domain ind:CobraContinuation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Enrollment .

ind:primaryCareProviderId rdf:type rdf:Property ;
    rdfs:label 'Primary Care Provider Id' ;
    rdfs:comment 'Foreign key linking to provider.provider. Business justification: Member profiles store assigned PCP for care coordination and referral management. Used in eligibility verification, claims processing, and member ID card generation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Provider .

ind:eligibilityId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Id' ;
    rdfs:comment 'Foreign key linking to member.eligibility. Business justification: Claims adjudication validates against specific eligibility record to confirm active coverage on service date, preventing payment for ineligible members.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Verification .

ind:providerSpecialtyId rdf:type rdf:Property ;
    rdfs:label 'Provider Specialty Id' ;
    rdfs:comment 'Foreign key linking to provider.specialty. Business justification: Benefits are often specialty-specific (e.g., mental health visits, chiropractic care limits). Claims adjudication matches provider specialty to benefit rules to determine coverage limits and cost-shar' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specialty .

ind:orderingProviderId rdf:type rdf:Property ;
    rdfs:label 'Ordering Provider Id' ;
    rdfs:comment 'Foreign key linking to provider.provider. Business justification: Care plans must identify the ordering provider who authorized the plan. Required for clinical accountability, authorization workflows, and regulatory compliance tracking.' ;
    rdfs:domain ind:Plan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Provider .

ind:performingProviderId rdf:type rdf:Property ;
    rdfs:label 'Performing Provider Id' ;
    rdfs:comment 'Foreign key linking to provider.provider. Business justification: Health risk assessments must document which provider performed the evaluation. Critical for clinical credibility, quality reporting, and audit trails in care management programs.' ;
    rdfs:domain ind:Assessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Provider .

ind:documentedByProviderId rdf:type rdf:Property ;
    rdfs:label 'Documented By Provider Id' ;
    rdfs:comment 'Foreign key linking to provider.provider. Business justification: Clinical notes must identify the documenting provider for legal, compliance, and clinical communication purposes. Essential for care coordination and medical record integrity.' ;
    rdfs:domain ind:Note ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Provider .

ind:designId rdf:type rdf:Property ;
    rdfs:label 'Design Id' ;
    rdfs:comment 'Foreign key linking to government.benefit_design. Business justification: Individual benefits within government plans must map to approved benefit designs from CMS. Benefits administration validates coverage against government specifications during claims processing.' ;
    rdfs:domain ind:Benefit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BenefitDesign .

ind:authRequestId rdf:type rdf:Property ;
    rdfs:label 'Auth Request Id' ;
    rdfs:comment 'Foreign key linking to authorization.request. Business justification: Claims flagged for fraud review must reference the authorization request to verify services rendered matched approved services. Discrepancies between authorized and billed services are primary fraud i' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Request .

ind:authDecisionId rdf:type rdf:Property ;
    rdfs:label 'Auth Decision Id' ;
    rdfs:comment 'Foreign key linking to authorization.decision. Business justification: Pharmacy prior authorization decisions are rendered through the central authorization decision system. Links pharmacy-specific decisions to master authorization decisions for appeals, audits, and regu' ;
    rdfs:domain ind:PriorAuthDec ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Decision .

ind:reviewerCredentialId rdf:type rdf:Property ;
    rdfs:label 'Reviewer Credential Id' ;
    rdfs:comment 'Foreign key linking to credentialing.credential. Business justification: Medical directors and nurse reviewers conducting utilization reviews must have verified credentials. Quality assurance and regulatory audits require tracking which credentialed reviewer made each clin' ;
    rdfs:domain ind:Authorization ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Credential .

ind:approverCredentialId rdf:type rdf:Property ;
    rdfs:label 'Approver Credential Id' ;
    rdfs:comment 'Foreign key linking to credentialing.credential. Business justification: Authorization overrides require medical director approval with verified credentials and appropriate clinical authority. Audit trails must link override decisions to credentialed approvers for complian' ;
    rdfs:domain ind:AuthOverride ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Credential .

ind:prescriberCredentialId rdf:type rdf:Property ;
    rdfs:label 'Prescriber Credential Id' ;
    rdfs:comment 'Foreign key linking to credentialing.credential. Business justification: Every pharmacy claim validates prescriber credentials during adjudication. Claims are denied if prescriber lacks valid license, DEA, or network credentialing. This is a real-time validation in claims ' ;
    rdfs:domain ind:ClaimTxn ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Credential .

ind:commissionPaymentId rdf:type rdf:Property ;
    rdfs:label 'Commission Payment Id' ;
    rdfs:comment 'Foreign key linking to sales.commission_payment. Business justification: Fraud department places holds on specific commission payments pending investigation. Payment processing system checks for active holds before releasing broker commissions - standard fraud prevention c' ;
    rdfs:domain ind:PaymentHold ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Commission .

ind:cohortMembershipId rdf:type rdf:Property ;
    rdfs:label 'Cohort Membership Id' ;
    rdfs:comment 'Primary key for the cohort_membership association' ;
    rdfs:domain ind:CohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exitDate rdf:type rdf:Property ;
    rdfs:label 'Exit Date' ;
    rdfs:comment 'Date when the member exited or was removed from this cohort, either by no longer meeting criteria or through program completion. Null if membership is currently active.' ;
    rdfs:domain ind:CohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentReason rdf:type rdf:Property ;
    rdfs:label 'Enrollment Reason' ;
    rdfs:comment 'Reason code or description explaining why the member was assigned to this cohort. Examples: criteria_met, manual_assignment, program_referral, risk_score_threshold, clinical_trigger.' ;
    rdfs:domain ind:CohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScoreAtEntry rdf:type rdf:Property ;
    rdfs:label 'Risk Score At Entry' ;
    rdfs:comment 'The member\'s calculated risk score at the time they were enrolled in this cohort. This score is frozen at enrollment and used for baseline comparison and program effectiveness measurement.' ;
    rdfs:domain ind:CohortMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:groupAgreementId rdf:type rdf:Property ;
    rdfs:label 'Group Agreement Id' ;
    rdfs:comment 'Primary key for the group_agreement association' ;
    rdfs:domain ind:GroupAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberGroupId rdf:type rdf:Property ;
    rdfs:label 'Member Group Id' ;
    rdfs:comment 'Foreign key to member.member_group' ;
    rdfs:domain ind:GroupAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Group .

ind:groupRateTier rdf:type rdf:Property ;
    rdfs:label 'Group Rate Tier' ;
    rdfs:comment 'Rate tier classification assigned to this specific group under this agreement, determining pricing and reimbursement levels' ;
    rdfs:domain ind:GroupAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributionAmount rdf:type rdf:Property ;
    rdfs:label 'Contribution Amount' ;
    rdfs:comment 'Specific contribution amount or premium applicable to this group under this agreement' ;
    rdfs:domain ind:GroupAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:networkParticipationId rdf:type rdf:Property ;
    rdfs:label 'Network Participation Id' ;
    rdfs:comment 'Primary key for the provider_network_participation association' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:providerProfileId rdf:type rdf:Property ;
    rdfs:label 'Provider Profile Id' ;
    rdfs:comment 'Foreign key to provider_profile' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Profile .

ind:acceptanceStatus rdf:type rdf:Property ;
    rdfs:label 'Acceptance Status' ;
    rdfs:comment 'Current status of whether the provider is accepting new patients under this specific plan' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reimbursementRateSchedule rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Rate Schedule' ;
    rdfs:comment 'Identifier or reference to the fee schedule or reimbursement methodology applied to this provider for services rendered under this plan' ;
    rdfs:domain ind:NetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careTeamId rdf:type rdf:Property ;
    rdfs:label 'Care Team Id' ;
    rdfs:comment 'Foreign key to care.care_team.care_team_id' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Team .

ind:teamRole rdf:type rdf:Property ;
    rdfs:label 'Team Role' ;
    rdfs:comment 'The specific role this provider plays on the care team (e.g., PCP, Specialist, Care Manager). This attribute was explicitly identified in the detection phase relationship data.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyRole rdf:type rdf:Property ;
    rdfs:label 'Specialty Role' ;
    rdfs:comment 'The specific clinical specialty or functional role this provider contributes to the care team (e.g., Cardiology, Endocrinology, Care Coordination). This attribute was explicitly identified in the detection phase relationship data.' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadClinicianName rdf:type rdf:Property ;
    rdfs:label 'Lead Clinician Name' ;
    rdfs:comment 'Full name of the lead clinician. [Moved from care_team: This is denormalized data that can be derived from the provider table via the care_team_member association. It should not be stored redundantly on care_team.]' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadClinicianNpi rdf:type rdf:Property ;
    rdfs:label 'Lead Clinician Npi' ;
    rdfs:comment 'NPI number for the lead clinician. [Moved from care_team: This is denormalized data that can be derived from the provider table via the care_team_member association. It should not be stored redundantly on care_team.]' ;
    rdfs:domain ind:TeamMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedCareManager rdf:type rdf:Property ;
    rdfs:label 'Assigned Care Manager' ;
    rdfs:comment 'Name or identifier of the care manager assigned to coordinate this member\'s participation in this specific program. Explicitly identified in detection phase as relationship data.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcomeScore rdf:type rdf:Property ;
    rdfs:label 'Outcome Score' ;
    rdfs:comment 'Quantitative score measuring the member\'s health outcomes or program effectiveness for this specific enrollment. Explicitly identified in detection phase as relationship data. Used for quality reporting and program effectiveness analysis.' ;
    rdfs:domain ind:ProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measureRiskStratificationId rdf:type rdf:Property ;
    rdfs:label 'Measure Risk Stratification Id' ;
    rdfs:comment 'Primary key for the measure_risk_stratification association' ;
    rdfs:domain ind:MeasureRiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measureWeight rdf:type rdf:Property ;
    rdfs:label 'Measure Weight' ;
    rdfs:comment 'The weighting factor for this measure-HCC combination used in aggregate quality score calculations' ;
    rdfs:domain ind:MeasureRiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stratificationLevel rdf:type rdf:Property ;
    rdfs:label 'Stratification Level' ;
    rdfs:comment 'The risk stratification tier assigned to this measure-HCC pairing (e.g., LOW, MEDIUM, HIGH, VERY_HIGH) used for reporting and benchmarking' ;
    rdfs:domain ind:MeasureRiskStratification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedDate rdf:type rdf:Property ;
    rdfs:label 'Updated Date' ;
    rdfs:comment 'Timestamp when this stratification configuration record was last modified' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:memberImprovementEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Member Improvement Enrollment Id' ;
    rdfs:comment 'Primary key for the member_improvement_enrollment association' ;
    rdfs:domain ind:MemberImprovementEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sanctionRemediationId rdf:type rdf:Property ;
    rdfs:label 'Sanction Remediation Id' ;
    rdfs:comment 'Primary key for the sanction_remediation association' ;
    rdfs:domain ind:SanctionRemediation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:remediationRequirement rdf:type rdf:Property ;
    rdfs:label 'Remediation Requirement' ;
    rdfs:comment 'Detailed description of the specific remediation requirement that this improvement plan must address for this sanction. Identified in detection phase.' ;
    rdfs:domain ind:SanctionRemediation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceDeadline rdf:type rdf:Property ;
    rdfs:label 'Compliance Deadline' ;
    rdfs:comment 'The date by which the provider must complete this improvement plan to satisfy sanction remediation requirements. Identified in detection phase.' ;
    rdfs:domain ind:SanctionRemediation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:monitoringStatus rdf:type rdf:Property ;
    rdfs:label 'Monitoring Status' ;
    rdfs:comment 'Current status of compliance monitoring for this specific sanction-plan remediation pairing. Identified in detection phase.' ;
    rdfs:domain ind:SanctionRemediation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceVerifiedBy rdf:type rdf:Property ;
    rdfs:label 'Compliance Verified By' ;
    rdfs:comment 'Name of the compliance officer or auditor who verified completion of this remediation requirement.' ;
    rdfs:domain ind:SanctionRemediation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Verification Date' ;
    rdfs:comment 'Date when compliance with this remediation requirement was formally verified.' ;
    rdfs:domain ind:SanctionRemediation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planAgentAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Plan Agent Assignment Id' ;
    rdfs:comment 'Primary key for the plan_agent_assignment association' ;
    rdfs:domain ind:PlanAgentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingHours rdf:type rdf:Property ;
    rdfs:label 'Training Hours' ;
    rdfs:comment 'Number of training hours the agent has completed for this specific improvement plan. Explicitly identified in detection phase relationship data.' ;
    rdfs:domain ind:PlanAgentAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:providerMeasurePerformanceId rdf:type rdf:Property ;
    rdfs:label 'Provider Measure Performance Id' ;
    rdfs:comment 'Primary key for the provider_measure_performance association' ;
    rdfs:domain ind:ProviderMeasurePerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measurementPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Start' ;
    rdfs:comment 'Beginning date of the period during which this specific provider\'s performance against this measure was evaluated' ;
    rdfs:domain ind:ProviderMeasurePerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Measurement Period End' ;
    rdfs:comment 'Ending date of the period during which this specific provider\'s performance against this measure was evaluated' ;
    rdfs:domain ind:ProviderMeasurePerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measureResultValue rdf:type rdf:Property ;
    rdfs:label 'Measure Result Value' ;
    rdfs:comment 'Calculated performance rate for this provider on this measure (numerator/denominator), typically expressed as a percentage or ratio' ;
    rdfs:domain ind:ProviderMeasurePerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataCompletenessRate rdf:type rdf:Property ;
    rdfs:label 'Data Completeness Rate' ;
    rdfs:comment 'Percentage of required data elements available for calculating this provider\'s performance on this measure' ;
    rdfs:domain ind:ProviderMeasurePerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measureProgramTargetId rdf:type rdf:Property ;
    rdfs:label 'Measure Program Target Id' ;
    rdfs:comment 'Primary key for the measure_program_target association' ;
    rdfs:domain ind:MeasureProgramTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measurementPeriod rdf:type rdf:Property ;
    rdfs:label 'Measurement Period' ;
    rdfs:comment 'The specific measurement period for this measure within this program context (e.g., \'2024\', \'2024-2025\'). Programs may track measures on different cycles than the standard HEDIS measurement period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentValue rdf:type rdf:Property ;
    rdfs:label 'Current Value' ;
    rdfs:comment 'The most recent calculated performance rate for this measure within this program. Updated based on the reporting frequency.' ;
    rdfs:domain ind:MeasureProgramTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:starRatingWeight rdf:type rdf:Property ;
    rdfs:label 'Star Rating Weight' ;
    rdfs:comment 'The weight or multiplier applied to this measure\'s performance in CMS Star Rating calculations for this program. Only applicable to Medicare Advantage programs. Higher weights indicate greater impact on overall Star Rating.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractQualityMetricId rdf:type rdf:Property ;
    rdfs:label 'Contract Quality Metric Id' ;
    rdfs:comment 'Primary key for the contract_quality_metric association' ;
    rdfs:domain ind:ContractQualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:performanceThreshold rdf:type rdf:Property ;
    rdfs:label 'Performance Threshold' ;
    rdfs:comment 'The contract-specific performance threshold or target value that must be achieved for this metric to trigger incentive payments (e.g., 85.00 for 85% compliance rate). This is specific to each contract-metric combination as different contracts negotiate different performance expectations.' ;
    rdfs:domain ind:ContractQualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTier rdf:type rdf:Property ;
    rdfs:label 'Payment Tier' ;
    rdfs:comment 'The tiered payment level or category for this metric within the contract\'s quality incentive structure (e.g., Tier 1, Tier 2, Bronze/Silver/Gold). Indicates relative importance and payment priority.' ;
    rdfs:domain ind:ContractQualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricWeight rdf:type rdf:Property ;
    rdfs:label 'Metric Weight' ;
    rdfs:comment 'The weighting factor applied to this metric within the overall quality incentive calculation for this contract. Represents the relative importance of this metric in the contract\'s total quality score.' ;
    rdfs:domain ind:ContractQualityMetric ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planCostAllocationId rdf:type rdf:Property ;
    rdfs:label 'Plan Cost Allocation Id' ;
    rdfs:comment 'Primary key for the plan_cost_allocation association' ;
    rdfs:domain ind:PlanCostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:remainingAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Amount' ;
    rdfs:comment 'Remaining unspent amount from this specific cost center allocation to this improvement plan.' ;
    rdfs:domain ind:PlanCostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurePolicyMandateId rdf:type rdf:Property ;
    rdfs:label 'Measure Policy Mandate Id' ;
    rdfs:comment 'Primary key for the measure_policy_mandate association' ;
    rdfs:domain ind:MeasurePolicyMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiredThreshold rdf:type rdf:Property ;
    rdfs:label 'Required Threshold' ;
    rdfs:comment 'The minimum performance threshold (as a percentage or rate) that must be achieved for this measure to satisfy this specific compliance policy requirement' ;
    rdfs:domain ind:MeasurePolicyMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mandateStatus rdf:type rdf:Property ;
    rdfs:label 'Mandate Status' ;
    rdfs:comment 'Current operational status of this mandate relationship' ;
    rdfs:domain ind:MeasurePolicyMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerScoreAuditCitationId rdf:type rdf:Property ;
    rdfs:label 'Provider Score Audit Citation Id' ;
    rdfs:comment 'Primary key for the provider_score_audit_citation association' ;
    rdfs:domain ind:ProviderScoreAuditCitation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingSeverity rdf:type rdf:Property ;
    rdfs:label 'Finding Severity' ;
    rdfs:comment 'The severity level assigned to this specific citation of the provider score within the audit finding context' ;
    rdfs:domain ind:ProviderScoreAuditCitation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scoreAtAuditDate rdf:type rdf:Property ;
    rdfs:label 'Score At Audit Date' ;
    rdfs:comment 'The specific composite score value or metric value captured at the time of the audit, preserving the point-in-time evidence' ;
    rdfs:domain ind:ProviderScoreAuditCitation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remediationDeadline rdf:type rdf:Property ;
    rdfs:label 'Remediation Deadline' ;
    rdfs:comment 'The target date by which the provider performance issue identified through this score must be remediated' ;
    rdfs:domain ind:ProviderScoreAuditCitation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:citationDate rdf:type rdf:Property ;
    rdfs:label 'Citation Date' ;
    rdfs:comment 'The date on which the auditor cited or documented this provider score as evidence for the finding' ;
    rdfs:domain ind:ProviderScoreAuditCitation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:citationNotes rdf:type rdf:Property ;
    rdfs:label 'Citation Notes' ;
    rdfs:comment 'Auditor notes or commentary specific to this citation of the provider score within the finding context' ;
    rdfs:domain ind:ProviderScoreAuditCitation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measureRequirementId rdf:type rdf:Property ;
    rdfs:label 'Measure Requirement Id' ;
    rdfs:comment 'Primary key for the measure_requirement association' ;
    rdfs:domain ind:MeasureRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceThreshold rdf:type rdf:Property ;
    rdfs:label 'Compliance Threshold' ;
    rdfs:comment 'Minimum performance threshold percentage required for this measure under this benefit design to meet regulatory compliance or achieve star rating targets' ;
    rdfs:domain ind:MeasureRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mandatoryFlag rdf:type rdf:Property ;
    rdfs:label 'Mandatory Flag' ;
    rdfs:comment 'Boolean indicator of whether this measure is absolutely mandatory for regulatory compliance for this benefit design versus optional for quality improvement' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingDeadlineOffsetDays rdf:type rdf:Property ;
    rdfs:label 'Reporting Deadline Offset Days' ;
    rdfs:comment 'Number of days after measurement period end by which this measure must be reported for this benefit design to regulatory bodies' ;
    rdfs:domain ind:MeasureRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sharedProgramEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Shared Program Enrollment Id' ;
    rdfs:comment 'Primary key for the program_enrollment association' ;
    rdfs:domain ind:SharedProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programStatus rdf:type rdf:Property ;
    rdfs:label 'Program Status' ;
    rdfs:comment 'Current status of the member\'s participation in the program (active, completed, withdrawn, suspended, pending). This is relationship-specific data identified in the detection phase.' ;
    rdfs:domain ind:SharedProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationLevel rdf:type rdf:Property ;
    rdfs:label 'Participation Level' ;
    rdfs:comment 'Level of member engagement and participation in the program activities. This is relationship-specific data identified in the detection phase.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditHccFindingId rdf:type rdf:Property ;
    rdfs:label 'Audit Hcc Finding Id' ;
    rdfs:comment 'Primary key for the audit_hcc_finding association' ;
    rdfs:domain ind:AuditHccFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:errorType rdf:type rdf:Property ;
    rdfs:label 'Error Type' ;
    rdfs:comment 'The specific type of error identified in this HCC assignment during audit, if any' ;
    rdfs:domain ind:AuditHccFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewedByCms rdf:type rdf:Property ;
    rdfs:label 'Reviewed By Cms' ;
    rdfs:comment 'Indicates whether this HCC assignment was specifically selected for CMS RADV audit review' ;
    rdfs:domain ind:AuditHccFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsReviewResult rdf:type rdf:Property ;
    rdfs:label 'Cms Review Result' ;
    rdfs:comment 'The result of CMS RADV audit review for this HCC assignment, if applicable' ;
    rdfs:domain ind:AuditHccFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditInteractionId rdf:type rdf:Property ;
    rdfs:label 'Audit Interaction Id' ;
    rdfs:comment 'Primary key for the audit_interaction association' ;
    rdfs:domain ind:AuditInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditPhase rdf:type rdf:Property ;
    rdfs:label 'Audit Phase' ;
    rdfs:comment 'The phase of the audit lifecycle during which this interaction occurred, identified in detection phase relationship data' ;
    rdfs:domain ind:AuditInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationProvided rdf:type rdf:Property ;
    rdfs:label 'Documentation Provided' ;
    rdfs:comment 'Boolean indicator of whether the provider submitted requested documentation during this interaction, identified in detection phase' ;
    rdfs:domain ind:AuditInteraction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyViolationId rdf:type rdf:Property ;
    rdfs:label 'Policy Violation Id' ;
    rdfs:comment 'Primary key for the policy_violation association' ;
    rdfs:domain ind:PolicyViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policySectionViolated rdf:type rdf:Property ;
    rdfs:label 'Policy Section Violated' ;
    rdfs:comment 'Specific section, clause, or provision of the compliance policy that was violated (corresponds to policy_section_violated from detection data)' ;
    rdfs:domain ind:PolicyViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finding rdf:type rdf:Property ;
    rdfs:label 'Finding' ;
    rdfs:comment 'Detailed finding from the investigation documenting how this specific policy was violated, including evidence and impact (corresponds to investigation_finding from detection data)' ;
    rdfs:domain ind:PolicyViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Identified Timestamp' ;
    rdfs:comment 'Precise timestamp when this policy violation was identified and recorded during the investigation' ;
    rdfs:domain ind:PolicyViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reportedToRegulatorFlag rdf:type rdf:Property ;
    rdfs:label 'Reported To Regulator Flag' ;
    rdfs:comment 'Indicator of whether this policy violation was reported to external regulatory authorities' ;
    rdfs:domain ind:PolicyViolation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investigationProgramScopeId rdf:type rdf:Property ;
    rdfs:label 'Investigation Program Scope Id' ;
    rdfs:comment 'Primary key for the investigation_program_scope association' ;
    rdfs:domain ind:InvestigationProgramScope ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programSpecificViolations rdf:type rdf:Property ;
    rdfs:label 'Program Specific Violations' ;
    rdfs:comment 'Documented violations specific to this program participation such as billing irregularities, quality issues, or compliance failures (from detection phase: program_specific_violations)' ;
    rdfs:domain ind:InvestigationProgramScope ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedInvestigator rdf:type rdf:Property ;
    rdfs:label 'Assigned Investigator' ;
    rdfs:comment 'Name or identifier of the investigator assigned to investigate this specific program participation (from detection phase: assigned_investigator)' ;
    rdfs:domain ind:InvestigationProgramScope ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedProgramLossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Program Loss Amount' ;
    rdfs:comment 'Estimated financial loss specific to this program participation' ;
    rdfs:domain ind:InvestigationProgramScope ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confirmedProgramLossAmount rdf:type rdf:Property ;
    rdfs:label 'Confirmed Program Loss Amount' ;
    rdfs:comment 'Confirmed financial loss specific to this program participation' ;
    rdfs:domain ind:InvestigationProgramScope ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investigationAuditId rdf:type rdf:Property ;
    rdfs:label 'Investigation Audit Id' ;
    rdfs:comment 'Primary key for the investigation_audit association' ;
    rdfs:domain ind:InvestigationAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findings rdf:type rdf:Property ;
    rdfs:label 'Findings' ;
    rdfs:comment 'The specific audit findings, observations, or exceptions identified for this investigation during the audit. Documents what issues, deficiencies, or areas of concern were noted by the auditor for this particular case.' ;
    rdfs:domain ind:InvestigationAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditorAssigned rdf:type rdf:Property ;
    rdfs:label 'Auditor Assigned' ;
    rdfs:comment 'The name or identifier of the specific auditor who was assigned to review this investigation as part of the audit engagement. May differ from the lead auditor of the overall audit if work is distributed among audit team members.' ;
    rdfs:domain ind:InvestigationAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sampleSelectionReason rdf:type rdf:Property ;
    rdfs:label 'Sample Selection Reason' ;
    rdfs:comment 'The reason why this investigation was selected for inclusion in the audit sample (e.g., \'High dollar amount\', \'Random statistical sample\', \'Risk-based selection\', \'Prior audit finding follow-up\').' ;
    rdfs:domain ind:InvestigationAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceRating rdf:type rdf:Property ;
    rdfs:label 'Compliance Rating' ;
    rdfs:comment 'The compliance rating assigned to this investigation based on the audit review. Indicates whether the investigation was conducted in accordance with applicable policies, procedures, and regulatory requirements.' ;
    rdfs:domain ind:InvestigationAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractAuditId rdf:type rdf:Property ;
    rdfs:label 'Contract Audit Id' ;
    rdfs:comment 'Primary key for the contract_audit association' ;
    rdfs:domain ind:ContractAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractClauseReviewed rdf:type rdf:Property ;
    rdfs:label 'Contract Clause Reviewed' ;
    rdfs:comment 'The specific contract clause(s) or section(s) that were reviewed during this audit for this contract. This attribute was explicitly identified in the detection phase relationship data.' ;
    rdfs:domain ind:ContractAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Audit Period Start' ;
    rdfs:comment 'The beginning date of the audit period for this specific contract review. May differ from the overall audit period if different contracts are reviewed for different time windows. This attribute was explicitly identified in the detection phase relationship data.' ;
    rdfs:domain ind:ContractAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Audit Period End' ;
    rdfs:comment 'The ending date of the audit period for this specific contract review. May differ from the overall audit period if different contracts are reviewed for different time windows. This attribute was explicitly identified in the detection phase relationship data.' ;
    rdfs:domain ind:ContractAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Review Completed Date' ;
    rdfs:comment 'The date when the audit review of this specific contract was completed. Allows tracking of audit progress at the contract level.' ;
    rdfs:domain ind:ContractAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:brokerProgramAppointmentId rdf:type rdf:Property ;
    rdfs:label 'Broker Program Appointment Id' ;
    rdfs:comment 'Primary key for the broker_program_appointment association' ;
    rdfs:domain ind:BrokerProgramAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:territoryAssignment rdf:type rdf:Property ;
    rdfs:label 'Territory Assignment' ;
    rdfs:comment 'Geographic territory or service area assigned to the broker for selling this specific government program. A broker may have different territories for different programs. This is relationship-specific data identified in the detection phase.' ;
    rdfs:domain ind:BrokerProgramAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionTier rdf:type rdf:Property ;
    rdfs:label 'Commission Tier' ;
    rdfs:comment 'Commission tier level assigned to the broker for this specific government program, determining the commission rate structure. This is relationship-specific data identified in the detection phase.' ;
    rdfs:domain ind:BrokerProgramAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Appointment End Date' ;
    rdfs:comment 'The date when the broker appointment for this specific government program ended or will end' ;
    rdfs:domain ind:BrokerProgramAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:annualEnrollmentQuota rdf:type rdf:Property ;
    rdfs:label 'Annual Enrollment Quota' ;
    rdfs:comment 'Target number of member enrollments expected from the broker for this specific government program during the annual enrollment period' ;
    rdfs:domain ind:BrokerProgramAppointment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:campaignEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Campaign Enrollment Id' ;
    rdfs:comment 'Primary key for the campaign_enrollment association' ;
    rdfs:domain ind:CampaignEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outreachPriorityScore rdf:type rdf:Property ;
    rdfs:label 'Outreach Priority Score' ;
    rdfs:comment 'Calculated priority score for outreach sequencing, determining the order in which enrolled members should be contacted, explicitly identified in detection phase as relationship data' ;
    rdfs:domain ind:CampaignEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:campaignEligibilityReason rdf:type rdf:Property ;
    rdfs:label 'Campaign Eligibility Reason' ;
    rdfs:comment 'Business justification for why this member risk profile was deemed eligible and enrolled in this specific campaign, explicitly identified in detection phase as relationship data' ;
    rdfs:domain ind:CampaignEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Enrollment Created Timestamp' ;
    rdfs:comment 'System timestamp when this enrollment record was created in the system' ;
    rdfs:domain ind:CampaignEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:enrollmentUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Enrollment Updated Timestamp' ;
    rdfs:comment 'System timestamp when this enrollment record was last updated' ;
    rdfs:domain ind:CampaignEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignmentId rdf:type rdf:Property ;
    rdfs:label 'Assignment Id' ;
    rdfs:comment 'Primary key for the broker_campaign_assignment association' ;
    rdfs:domain ind:BrokerCampaignAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:territoryCoverage rdf:type rdf:Property ;
    rdfs:label 'Territory Coverage' ;
    rdfs:comment 'Geographic territory or market segment the broker is responsible for within this campaign (e.g., specific states, ZIP codes, or employer groups). Explicitly identified in detection phase relationship data.' ;
    rdfs:domain ind:BrokerCampaignAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualEnrollmentCount rdf:type rdf:Property ;
    rdfs:label 'Actual Enrollment Count' ;
    rdfs:comment 'Actual number of member enrollments achieved by this broker through this campaign. Tracked for performance evaluation and commission calculation.' ;
    rdfs:domain ind:BrokerCampaignAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:channelCampaignExecutionId rdf:type rdf:Property ;
    rdfs:label 'Channel Campaign Execution Id' ;
    rdfs:comment 'Primary key for the channel_campaign_execution association' ;
    rdfs:domain ind:ChannelCampaignExecution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:channelBudgetAllocation rdf:type rdf:Property ;
    rdfs:label 'Channel Budget Allocation' ;
    rdfs:comment 'The portion of the campaign budget allocated specifically to this sales channel. This amount is a subset of the total campaign budget and represents the investment in executing the campaign through this particular channel.' ;
    rdfs:domain ind:ChannelCampaignExecution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedLeadVolume rdf:type rdf:Property ;
    rdfs:label 'Expected Lead Volume' ;
    rdfs:comment 'The target number of leads expected to be generated through this sales channel for this campaign. This channel-specific target rolls up to the overall campaign lead generation goal.' ;
    rdfs:domain ind:ChannelCampaignExecution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualLeadVolume rdf:type rdf:Property ;
    rdfs:label 'Actual Lead Volume' ;
    rdfs:comment 'The actual number of leads generated through this sales channel for this campaign. Used to measure channel performance against expected_lead_volume.' ;
    rdfs:domain ind:ChannelCampaignExecution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:executionStatus rdf:type rdf:Property ;
    rdfs:label 'Execution Status' ;
    rdfs:comment 'Current operational status of the campaign execution through this channel. Tracks whether this channel is actively running the campaign, paused, or completed.' ;
    rdfs:domain ind:ChannelCampaignExecution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programDiagnosisMappingId rdf:type rdf:Property ;
    rdfs:label 'Program Diagnosis Mapping Id' ;
    rdfs:comment 'Primary key for the program_diagnosis_mapping association' ;
    rdfs:domain ind:ProgramDiagnosisMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programWeight rdf:type rdf:Property ;
    rdfs:label 'Program Weight' ;
    rdfs:comment 'The weight or scoring value assigned to this diagnosis code within the context of this specific program (may differ from HCC weight based on program-specific rules)' ;
    rdfs:domain ind:ProgramDiagnosisMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:campaignContentId rdf:type rdf:Property ;
    rdfs:label 'Campaign Content Id' ;
    rdfs:comment 'Primary key for the campaign_content association' ;
    rdfs:domain ind:CampaignContent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agentFeedback rdf:type rdf:Property ;
    rdfs:label 'Agent Feedback' ;
    rdfs:comment 'Qualitative feedback from agents regarding the usefulness and relevance of this article for handling campaign-related inquiries' ;
    rdfs:domain ind:CampaignContent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerProgramParticipationId rdf:type rdf:Property ;
    rdfs:label 'Broker Program Participation Id' ;
    rdfs:comment 'Primary key for the broker_program_participation association' ;
    rdfs:domain ind:BrokerProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Program Effective Date' ;
    rdfs:comment 'The date when the broker\'s participation in the program became effective or active. May differ from enrollment_date if there is a waiting period or approval process.' ;
    rdfs:domain ind:BrokerProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:programEndDate rdf:type rdf:Property ;
    rdfs:label 'Program End Date' ;
    rdfs:comment 'The date when the broker\'s participation in the program ended or is scheduled to end. Used to track historical participation and program expiration dates.' ;
    rdfs:domain ind:BrokerProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:credentialingNetworkParticipationId rdf:type rdf:Property ;
    rdfs:label 'Credentialing Network Participation Id' ;
    rdfs:comment 'Primary key for the network_participation association' ;
    rdfs:domain ind:CredentialingNetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:participationTier rdf:type rdf:Property ;
    rdfs:label 'Participation Tier' ;
    rdfs:comment 'Tiering classification for this provider within this specific benefit design network, affecting member cost-sharing and access. A provider may be Tier 1 in one plan and Tier 2 in another based on contract negotiations and quality metrics.' ;
    rdfs:domain ind:CredentialingNetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reimbursementRateModifier rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Rate Modifier' ;
    rdfs:comment 'Percentage modifier applied to standard reimbursement rates for this provider-benefit design combination. Represents negotiated rate adjustments specific to this participation agreement (e.g., 1.05 for 5% above standard, 0.95 for 5% below).' ;
    rdfs:domain ind:CredentialingNetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Contract Reference Number' ;
    rdfs:comment 'Reference number to the legal contract document governing this provider\'s participation in this benefit design network.' ;
    rdfs:domain ind:CredentialingNetworkParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedByUserId rdf:type rdf:Property ;
    rdfs:label 'Updated By User Id' ;
    rdfs:comment 'Identifier of the user or system that last updated this participation record.' ;
    rdfs:domain ind:CredentialingNetworkParticipation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:policyAcknowledgmentId rdf:type rdf:Property ;
    rdfs:label 'Policy Acknowledgment Id' ;
    rdfs:comment 'Primary key for the policy_acknowledgment association' ;
    rdfs:domain ind:PolicyAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acknowledgmentStatus rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Status' ;
    rdfs:comment 'Current status of the acknowledgment indicating whether the agent has completed the acknowledgment, is pending, overdue, or if the acknowledgment has expired requiring re-acknowledgment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionAcknowledged rdf:type rdf:Property ;
    rdfs:label 'Version Acknowledged' ;
    rdfs:comment 'The specific version number of the compliance policy that was acknowledged by the agent. Critical for tracking when policy updates require new acknowledgments.' ;
    rdfs:domain ind:PolicyAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgmentNotes rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Notes' ;
    rdfs:comment 'Optional notes or comments recorded at the time of acknowledgment, such as questions raised or clarifications provided.' ;
    rdfs:domain ind:PolicyAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerTrainingCompletionId rdf:type rdf:Property ;
    rdfs:label 'Provider Training Completion Id' ;
    rdfs:comment 'Primary key for the provider_training_completion association' ;
    rdfs:domain ind:ProviderTrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attestationSigned rdf:type rdf:Property ;
    rdfs:label 'Attestation Signed' ;
    rdfs:comment 'Indicates whether the provider has signed the attestation acknowledging completion of this training for credentialing purposes' ;
    rdfs:domain ind:ProviderTrainingCompletion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:credentialPolicyAcknowledgmentId rdf:type rdf:Property ;
    rdfs:label 'Credential Policy Acknowledgment Id' ;
    rdfs:comment 'Primary key for the credential_policy_acknowledgment association' ;
    rdfs:domain ind:CredentialPolicyAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyVersionAcknowledged rdf:type rdf:Property ;
    rdfs:label 'Policy Version Acknowledged' ;
    rdfs:comment 'Specific version number of the compliance policy that was acknowledged by the provider. Critical for tracking which version was attested to. Explicitly identified in detection phase.' ;
    rdfs:domain ind:CredentialPolicyAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgedByName rdf:type rdf:Property ;
    rdfs:label 'Acknowledged By Name' ;
    rdfs:comment 'Name of the individual who provided the acknowledgment on behalf of the provider (may be the provider themselves or authorized representative).' ;
    rdfs:domain ind:CredentialPolicyAcknowledgment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committeePolicyGovernanceId rdf:type rdf:Property ;
    rdfs:label 'Committee Policy Governance Id' ;
    rdfs:comment 'Primary key for the committee_policy_governance association' ;
    rdfs:domain ind:CommitteePolicyGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyAdoptionDate rdf:type rdf:Property ;
    rdfs:label 'Policy Adoption Date' ;
    rdfs:comment 'Date when the credentialing committee formally adopted this compliance policy into their governance scope. Explicitly identified in detection reasoning.' ;
    rdfs:domain ind:CommitteePolicyGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:committeeVoteResult rdf:type rdf:Property ;
    rdfs:label 'Committee Vote Result' ;
    rdfs:comment 'Outcome of the committee vote on policy adoption (e.g., APPROVED, REJECTED, UNANIMOUS). Explicitly identified in detection reasoning.' ;
    rdfs:domain ind:CommitteePolicyGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governanceStatus rdf:type rdf:Property ;
    rdfs:label 'Governance Status' ;
    rdfs:comment 'Current status of this committee\'s governance relationship with the policy (e.g., ACTIVE, SUSPENDED, TRANSFERRED to another committee).' ;
    rdfs:domain ind:CommitteePolicyGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governanceScopeNotes rdf:type rdf:Property ;
    rdfs:label 'Governance Scope Notes' ;
    rdfs:comment 'Free-text notes describing the specific scope or limitations of this committee\'s governance authority over this policy.' ;
    rdfs:domain ind:CommitteePolicyGovernance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationId rdf:type rdf:Property ;
    rdfs:label 'Certification Id' ;
    rdfs:comment 'Primary key for the certification association' ;
    rdfs:domain ind:Certification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specializationLevel rdf:type rdf:Property ;
    rdfs:label 'Specialization Level' ;
    rdfs:comment 'The level of specialization or expertise the agent has achieved for this program (Basic, Intermediate, Advanced, Expert). Explicitly identified in detection phase as relationship data.' ;
    rdfs:domain ind:Certification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activeStatus rdf:type rdf:Property ;
    rdfs:label 'Active Status' ;
    rdfs:comment 'Current status of this agent-program certification indicating whether the agent is currently authorized to service this program. Explicitly identified in detection phase as relationship data.' ;
    rdfs:domain ind:Certification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRenewalDate rdf:type rdf:Property ;
    rdfs:label 'Last Renewal Date' ;
    rdfs:comment 'Date when the agent last renewed their certification for this program.' ;
    rdfs:domain ind:Certification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:articleProgramApplicabilityId rdf:type rdf:Property ;
    rdfs:label 'Article Program Applicability Id' ;
    rdfs:comment 'Primary key for the article_program_applicability association' ;
    rdfs:domain ind:ArticleProgramApplicability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:participationId rdf:type rdf:Property ;
    rdfs:label 'Participation Id' ;
    rdfs:comment 'Primary key for the provider_program_participation association' ;
    rdfs:domain ind:CredentialingProviderProgramParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programCredentialingPolicyId rdf:type rdf:Property ;
    rdfs:label 'Program Credentialing Policy Id' ;
    rdfs:comment 'Primary key for the program_credentialing_policy association' ;
    rdfs:domain ind:ProgramCredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Policy Effective Date' ;
    rdfs:comment 'Date on which this credentialing policy becomes effective for the specified program, as identified in the detection phase relationship data' ;
    rdfs:domain ind:ProgramCredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyEndDate rdf:type rdf:Property ;
    rdfs:label 'Policy End Date' ;
    rdfs:comment 'Date on which this credentialing policy ceases to be effective for the specified program, supporting temporal tracking of policy assignments' ;
    rdfs:domain ind:ProgramCredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:programSpecificRequirements rdf:type rdf:Property ;
    rdfs:label 'Program Specific Requirements' ;
    rdfs:comment 'Text description of additional or modified credentialing requirements specific to this program-policy combination, as identified in the detection phase relationship data' ;
    rdfs:domain ind:ProgramCredentialingPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workflowStepSlaId rdf:type rdf:Property ;
    rdfs:label 'Workflow Step Sla Id' ;
    rdfs:comment 'Primary key for the workflow_step_sla association' ;
    rdfs:domain ind:WorkflowStepSla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationThreshold rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold' ;
    rdfs:comment 'Percentage of SLA target time at which this workflow step should be escalated (e.g., 80% means escalate when 80% of allowed time has elapsed)' ;
    rdfs:domain ind:WorkflowStepSla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:businessPriority rdf:type rdf:Property ;
    rdfs:label 'Business Priority' ;
    rdfs:comment 'Business priority classification for this workflow step-SLA combination, determining escalation paths and resource allocation' ;
    rdfs:domain ind:WorkflowStepSla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliesToProviderTypes rdf:type rdf:Property ;
    rdfs:label 'Applies To Provider Types' ;
    rdfs:comment 'Comma-separated list of provider types for which this specific SLA assignment applies (may be a subset of the workflow step\'s general applicability)' ;
    rdfs:domain ind:WorkflowStepSla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationContactRole rdf:type rdf:Property ;
    rdfs:label 'Escalation Contact Role' ;
    rdfs:comment 'Role or position to be notified when escalation threshold is breached for this workflow step-SLA combination' ;
    rdfs:domain ind:WorkflowStepSla ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationId rdf:type rdf:Property ;
    rdfs:label 'Allocation Id' ;
    rdfs:comment 'Primary key for the cost_center_contract_allocation association' ;
    rdfs:domain ind:CostCenterContractAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationAmount rdf:type rdf:Property ;
    rdfs:label 'Allocation Amount' ;
    rdfs:comment 'Calculated dollar amount of contract costs allocated to this cost center based on allocation percentage and total contract value' ;
    rdfs:domain ind:CostCenterContractAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationNotes rdf:type rdf:Property ;
    rdfs:label 'Allocation Notes' ;
    rdfs:comment 'Free-text notes explaining the business rationale for this specific allocation percentage or method' ;
    rdfs:domain ind:CostCenterContractAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetAllocationId rdf:type rdf:Property ;
    rdfs:label 'Budget Allocation Id' ;
    rdfs:comment 'Primary key for the budget_allocation association' ;
    rdfs:domain ind:BudgetAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractJournalAllocationId rdf:type rdf:Property ;
