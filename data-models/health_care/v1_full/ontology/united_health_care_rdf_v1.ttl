ind:complianceApprovalId rdf:type rdf:Property ;
    rdfs:label 'Compliance Approval Id' ;
    rdfs:comment 'Unique identifier for the compliance approval record. Primary key for tracking individual approval instances across all marketing campaigns.' ;
    rdfs:domain ind:Marketing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceApproval .

ind:contentType rdf:type rdf:Property ;
    rdfs:label 'Content Type' ;
    rdfs:comment 'Type of marketing content being reviewed for compliance approval. Indicates the medium and format of the campaign materials.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contentDescription rdf:type rdf:Property ;
    rdfs:label 'Content Description' ;
    rdfs:comment 'Detailed description of the marketing content submitted for compliance approval. Provides context about messaging, creative elements, and intended audience.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterDepartment rdf:type rdf:Property ;
    rdfs:label 'Submitter Department' ;
    rdfs:comment 'Department or business unit of the submitter. Provides organizational context for the submission.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalType rdf:type rdf:Property ;
    rdfs:label 'Approval Type' ;
    rdfs:comment 'Category of approval required for the marketing content. Different content types require different approval authorities.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverDepartment rdf:type rdf:Property ;
    rdfs:label 'Approver Department' ;
    rdfs:comment 'Department or functional area of the approver. Indicates which organizational unit provided the approval decision.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDurationHours rdf:type rdf:Property ;
    rdfs:label 'Review Duration Hours' ;
    rdfs:comment 'Total time in hours from submission to approval decision. Used for process efficiency analysis and SLA monitoring.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rejectionCategory rdf:type rdf:Property ;
    rdfs:label 'Rejection Category' ;
    rdfs:comment 'Categorization of the rejection reason. Used for trend analysis and process improvement in compliance reviews.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionsOfApproval rdf:type rdf:Property ;
    rdfs:label 'Conditions Of Approval' ;
    rdfs:comment 'Specific conditions or requirements that must be met for the approval to remain valid. May include usage restrictions or required modifications.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Cms Approval Required' ;
    rdfs:comment 'Indicates whether the marketing content requires approval from CMS before use. Mandatory for Medicare Advantage and Part D marketing materials.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsFileNumber rdf:type rdf:Property ;
    rdfs:label 'Cms File Number' ;
    rdfs:comment 'Unique file number assigned by CMS to the approved marketing material. Required identifier for all CMS-approved content.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'State Approval Required' ;
    rdfs:comment 'Indicates whether the marketing content requires approval from state insurance regulators before use. Requirements vary by state and product type.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateApprovalDate rdf:type rdf:Property ;
    rdfs:label 'State Approval Date' ;
    rdfs:comment 'Date when the state insurance department approved the marketing content. Required before materials can be used in that state.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stateFileNumber rdf:type rdf:Property ;
    rdfs:label 'State File Number' ;
    rdfs:comment 'Unique file number assigned by the state insurance department to the approved marketing material. Required identifier for state-approved content.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalValid rdf:type rdf:Property ;
    rdfs:label 'Approval Valid' ;
    rdfs:comment 'Indicates whether the approval is currently valid and the content can be used. Considers effective date, expiration date, and any withdrawal or revocation.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:previousApprovalComplianceApprovalId rdf:type rdf:Property ;
    rdfs:label 'Previous Approval Compliance Approval Id' ;
    rdfs:comment 'Identifier of the previous approval record if this is a resubmission or revision. Links to approval history for the content.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceApproval .

ind:resubmissionCount rdf:type rdf:Property ;
    rdfs:label 'Resubmission Count' ;
    rdfs:comment 'Number of times the content has been resubmitted for approval. Used for process quality analysis and training needs identification.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:legalApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Legal Approval Date' ;
    rdfs:comment 'Date when legal department approved the marketing content. Required before final compliance approval can be granted.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicalReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Medical Review Required' ;
    rdfs:comment 'Indicates whether medical affairs review is required for the marketing content. Required for content containing clinical claims or health information.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalReviewerName rdf:type rdf:Property ;
    rdfs:label 'Medical Reviewer Name' ;
    rdfs:comment 'Name of the medical affairs reviewer who assessed the clinical accuracy of the marketing content. Ensures medical claims are evidence-based.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Medical Approval Date' ;
    rdfs:comment 'Date when medical affairs approved the marketing content. Required before final compliance approval for content with clinical claims.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pharmacyReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Review Required' ;
    rdfs:comment 'Indicates whether pharmacy department review is required. Mandatory for Part D and Pharmacy Benefit Manager (PBM) marketing materials.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyReviewerName rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Reviewer Name' ;
    rdfs:comment 'Name of the pharmacy reviewer who assessed the pharmacy benefit content. Ensures accuracy of drug coverage and formulary information.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pharmacyApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Approval Date' ;
    rdfs:comment 'Date when pharmacy department approved the marketing content. Required for Part D and PBM marketing materials.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:brandReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Brand Review Required' ;
    rdfs:comment 'Indicates whether brand management review is required to ensure consistency with brand guidelines and corporate identity standards.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brandReviewerName rdf:type rdf:Property ;
    rdfs:label 'Brand Reviewer Name' ;
    rdfs:comment 'Name of the brand management reviewer who assessed the marketing content for brand compliance. Ensures consistent brand representation.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brandApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Brand Approval Date' ;
    rdfs:comment 'Date when brand management approved the marketing content. Ensures materials meet corporate brand standards.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disclosureRequirementsMet rdf:type rdf:Property ;
    rdfs:label 'Disclosure Requirements Met' ;
    rdfs:comment 'Indicates whether all required disclosures are present in the marketing content. Critical for regulatory compliance with CMS and state requirements.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disclaimerTextApproved rdf:type rdf:Property ;
    rdfs:label 'Disclaimer Text Approved' ;
    rdfs:comment 'Indicates whether the disclaimer text in the marketing content has been approved. Ensures legal protection and regulatory compliance.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languageVersion rdf:type rdf:Property ;
    rdfs:label 'Language Version' ;
    rdfs:comment 'Language in which the marketing content is written. Important for multilingual compliance requirements and culturally appropriate marketing.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentHash rdf:type rdf:Property ;
    rdfs:label 'Document Hash' ;
    rdfs:comment 'Cryptographic hash of the approved marketing content. Ensures the integrity of the approved version and detects unauthorized modifications.' ;
    rdfs:domain ind:ComplianceApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimTxnId rdf:type rdf:Property ;
