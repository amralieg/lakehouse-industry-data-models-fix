    rdfs:comment 'Foreign key linking to uc_tags.delta_tblproperties. Business justification: Delta table properties (optimize, auto-compact) govern AI model backing tables. Centralizes Databricks lakehouse configuration per VREQ-011 governance patterns.' ;
    rdfs:domain ind:ClinicalAiModelCard ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inferenceLogTable rdf:type rdf:Property ;
