ind:callbackThresholdSeconds rdf:type rdf:Property ;
    rdfs:label 'Callback Threshold Seconds' ;
    rdfs:comment 'Wait time threshold in seconds after which members are automatically offered a callback option.' ;
    rdfs:domain ind:Queue ;
