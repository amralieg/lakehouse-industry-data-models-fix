    rdfs:range xsd:string .

ind:lastModifiedByName rdf:type rdf:Property ;
    rdfs:label 'Last Modified By Name' ;
    rdfs:comment 'The name of the user or administrator who last modified the incentive program record.' ;
    rdfs:domain ind:IncentiveProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderId rdf:type rdf:Property ;
    rdfs:label 'Order Id' ;
    rdfs:comment 'Unique identifier for the sales order that initiates enrollment processing.' ;
