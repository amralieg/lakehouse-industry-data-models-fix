ind:copayAppliesFlag rdf:type rdf:Property ;
    rdfs:label 'Copay Applies Flag' ;
    rdfs:comment 'Indicates whether a copayment applies to this specific benefit type and service category.' ;
    rdfs:domain ind:CostSharing ;
