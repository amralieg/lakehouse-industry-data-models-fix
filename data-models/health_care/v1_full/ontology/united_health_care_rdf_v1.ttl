    rdfs:comment 'Description of any regulatory restrictions or limitations on the use of this channel (e.g., TCPA restrictions on automated calls, CAN-SPAM requirements for email).' ;
    rdfs:domain ind:OutreachChannel ;
    rdf:type owl:DatatypeProperty ;
