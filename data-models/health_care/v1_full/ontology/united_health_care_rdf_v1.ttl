    rdfs:comment 'The clinical criteria and documentation requirements that must be met for prior authorization approval of the specialty drug.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepTherapySequence rdf:type rdf:Property ;
    rdfs:label 'Step Therapy Sequence' ;
    rdfs:comment 'The ordered sequence of medications that must be tried before the specialty drug can be approved under step therapy protocols.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
    rdf:type owl:DatatypeProperty ;
