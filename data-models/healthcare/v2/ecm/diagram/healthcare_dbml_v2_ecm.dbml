Ref: patient.insurance_coverage.insurance_mpi_record_id > patient.mpi_record.mpi_record_id
Ref: patient.insurance_coverage.payer_id > insurance.payer.payer_id
Ref: patient.insurance_coverage.sdoh_referral_id > patient.sdoh_referral.sdoh_referral_id
Ref: patient.insurance_coverage.subscriber_id > insurance.subscriber.subscriber_id
Ref: patient.guarantor.cost_center_id > finance.cost_center.cost_center_id
Ref: patient.guarantor.mpi_record_id > patient.mpi_record.mpi_record_id
Ref: patient.guarantor.sdoh_referral_id > patient.sdoh_referral.sdoh_referral_id
Ref: patient.emergency_contact.mpi_record_id > patient.mpi_record.mpi_record_id
Ref: patient.emergency_contact.sdoh_referral_id > patient.sdoh_referral.sdoh_referral_id
Ref: patient.sdoh_assessment.assessment_care_site_id > facility.care_site.care_site_id
Ref: patient.sdoh_assessment.assessment_loinc_code_id > reference.loinc_code.loinc_code_id
Ref: patient.sdoh_assessment.community_resource_directory_community_resource_id > patient.community_resource.community_resource_id
Ref: patient.sdoh_assessment.community_resource_id > patient.community_resource.community_resource_id
Ref: patient.sdoh_assessment.demographics_id > patient.demographics.demographics_id
Ref: patient.sdoh_assessment.fhir_observation_id > clinical.observation.observation_id
Ref: patient.sdoh_assessment.risk_stratification_id > patient.sdoh_risk_stratification.sdoh_risk_stratification_id
Ref: patient.sdoh_assessment.sdoh_risk_stratification_id > patient.sdoh_risk_stratification.sdoh_risk_stratification_id
Ref: patient.sdoh_assessment.sdoh_zcode_mapping_id > patient.sdoh_zcode_mapping.sdoh_zcode_mapping_id
Ref: patient.sdoh_assessment.visit_id > encounter.visit.visit_id
Ref: patient.preference.care_site_id > facility.care_site.care_site_id
Ref: patient.preference.clinician_id > provider.clinician.clinician_id
Ref: patient.preference.demographics_id > patient.demographics.demographics_id
Ref: patient.preference.primary_preference_pharmacy_location_id > pharmacy.pharmacy_location.pharmacy_location_id
Ref: patient.preference.sdoh_referral_id > patient.sdoh_referral.sdoh_referral_id
