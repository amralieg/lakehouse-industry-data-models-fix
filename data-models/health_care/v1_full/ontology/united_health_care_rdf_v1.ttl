    rdfs:comment 'Indicates whether this measure incorporates or is influenced by social determinants of health factors.' ;
    rdfs:domain ind:Measure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:historyId rdf:type rdf:Property ;
    rdfs:label 'History Id' ;
    rdfs:comment 'Unique identifier for each eligibility history record, serving as the primary key for tracking individual eligibility status change events.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:History .

ind:productType rdf:type rdf:Property ;
    rdfs:label 'Product Type' ;
    rdfs:comment 'The specific health plan product type that defines the network structure and coverage model for the member\'s benefits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planCode rdf:type rdf:Property ;
    rdfs:label 'Plan Code' ;
    rdfs:comment 'The internal code identifying the specific benefit plan configuration, including coverage levels, cost-sharing, and network access rules.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitPackageId rdf:type rdf:Property ;
