    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:copaySpecialist rdf:type rdf:Property ;
    rdfs:label 'Copay Specialist' ;
    rdfs:comment 'The fixed copayment amount the member pays for specialist physician office visits.' ;
