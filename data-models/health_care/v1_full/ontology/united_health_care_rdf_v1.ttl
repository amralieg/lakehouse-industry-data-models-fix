    rdfs:range xsd:string .

ind:queueAssignmentRule rdf:type rdf:Property ;
    rdfs:label 'Queue Assignment Rule' ;
    rdfs:comment 'Rule for assigning cases of this priority to contact center queues, determining whether dedicated resources or standard queues are used.' ;
    rdfs:domain ind:Priority ;
