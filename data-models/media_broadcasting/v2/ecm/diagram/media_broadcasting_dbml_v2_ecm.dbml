  integration_status varchar [note: 'Integration status with our systems']
  is_active boolean [note: 'Whether the DSP integration is currently active']
  platform_type varchar [note: 'Type of DSP platform (self-serve, managed, hybrid)']
  programmatic_enabled boolean [note: 'Flag indicating this entity is enabled for programmatic advertising']
  supported_deal_types varchar [note: 'Supported deal types (PMP, PG, open auction)']
  supported_formats varchar [note: 'Supported ad formats (video, display, audio, CTV)']
  updated_at timestamp [note: 'Record last update timestamp']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Demand-side platform master for programmatic ad buying'
}

Table sales.ssp {
  ssp_id varchar [pk, note: 'Primary key for supply-side platform']
  active_flag boolean [note: 'Whether SSP is currently active']
  api_endpoint_url varchar [note: 'API endpoint for programmatic integration']
  bid_protocol varchar [note: 'Bid protocol supported (OpenRTB 2.5, 2.6, etc.)']
  contract_end_date date [note: 'Contract end date with SSP']
  contract_start_date date [note: 'Contract start date with SSP']
  created_at timestamp [note: 'Record creation timestamp']
  created_timestamp timestamp [note: 'Record creation timestamp']
  floor_price_default decimal(18,2) [note: 'Default floor price for inventory']
  header_bidding_enabled boolean [note: 'Whether header bidding is supported']
  header_bidding_enabled_flag boolean [note: 'Whether header bidding is enabled']
  integration_status varchar [note: 'Integration status with our systems']
  is_active boolean [note: 'Whether the SSP integration is currently active']
  platform_type varchar [note: 'Type of SSP platform']
  programmatic_enabled boolean [note: 'Flag indicating this entity is enabled for programmatic advertising']
  revenue_share_percentage decimal(5,2) [note: 'Revenue share percentage']
  ssp_code varchar [note: 'Unique code identifier for the SSP']
  ssp_name varchar [note: 'Name of the SSP (e.g., FreeWheel, SpotX, Magnite)']
  supported_inventory_types varchar [note: 'Supported inventory types (linear, VOD, CTV, OTT)']
  updated_at timestamp [note: 'Record last update timestamp']
  updated_timestamp timestamp [note: 'Record last update timestamp']

  Note: 'Supply-side platform master for programmatic ad selling'
}

Table sales.advertiser_commitments {
