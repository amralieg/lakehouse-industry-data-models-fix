  credit_obligation varchar [note: 'Contractual requirements for on-screen and promotional credits for each co-production partner. | Column credit_obligation (STRING) in partner.coproduction_agreement']
  delivery_date date [note: 'Contractual date by which the completed content must be delivered to all co-production partners. | Column delivery_date (DATE) in partner.coproduction_agreement']
  dispute_resolution_method varchar [note: 'Agreed-upon mechanism for resolving disputes between co-production partners. | Column dispute_resolution_method (STRING) in partner.coproduction_agreement']
