    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalPlayers rdf:type rdf:Property ;
    rdfs:label 'Total Players' ;
    rdfs:comment 'Total number of players included in this lineup.' ;
    rdfs:domain ind:Lineup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:verifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Verified Timestamp' ;
    rdfs:comment 'Date and time when this lineup was verified for accuracy and approved for use in wagering markets.' ;
    rdfs:domain ind:Lineup ;
