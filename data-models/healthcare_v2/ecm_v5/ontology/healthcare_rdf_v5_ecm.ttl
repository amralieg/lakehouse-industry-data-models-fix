ind:GenomicSequence rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Genomics ;
    rdfs:label 'Genomic Sequence' ;
    rdfs:comment 'Table storing genomic sequencing results.' .

ind:VariantAnnotation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Genomics ;
    rdfs:label 'Variant Annotation' ;
    rdfs:comment 'Table storing variant annotations and interpretations.' .

ind:HomeHealthService rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PostAcuteCare ;
    rdfs:label 'Home Health Service' ;
    rdfs:comment 'Table storing Home Health service records.' .

ind:PopulationHealthCohortDefinition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:ClinicalAi ;
    rdfs:label 'Population Health Cohort Definition' ;
    rdfs:comment 'Table defining dynamic population health cohorts.' .

ind:ClinicalAiPopulationHealthCohortMembership rdf:type rdfs:Class ;
    rdfs:subClassOf ind:ClinicalAi ;
    rdfs:label 'Clinical Ai Population Health Cohort Membership' ;
    rdfs:comment 'Table tracking membership of patients in dynamic cohorts.' .

ind:ClinicalAiModelCard rdf:type rdfs:Class ;
    rdfs:subClassOf ind:ClinicalAi ;
    rdfs:label 'Clinical Ai Model Card' ;
    rdfs:comment 'Table storing model cards for AI models.' .

ind:ClinicalAiBiasMonitoring rdf:type rdfs:Class ;
    rdfs:subClassOf ind:ClinicalAi ;
    rdfs:label 'Clinical Ai Bias Monitoring' ;
    rdfs:comment 'Table tracking bias monitoring metrics for AI models.' .

ind:ClinicalAiFdaSamd rdf:type rdfs:Class ;
