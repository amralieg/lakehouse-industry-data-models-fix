ind:radvAuditStatus rdf:type rdf:Property ;
    rdfs:label 'Radv Audit Status' ;
    rdfs:comment 'Current status of the CMS RADV audit process for this member\'s risk adjustment data.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:radvErrorRate rdf:type rdf:Property ;
    rdfs:label 'Radv Error Rate' ;
    rdfs:comment 'Percentage of HCC codes that failed validation during RADV audit due to insufficient documentation.' ;
