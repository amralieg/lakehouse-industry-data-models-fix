ind:referralEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Referral Effective Date' ;
    rdfs:comment 'Date when the referral becomes effective for member care coordination.' ;
    rdfs:domain ind:ReferralNetwork ;
