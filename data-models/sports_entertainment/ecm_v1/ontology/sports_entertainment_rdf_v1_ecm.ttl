    rdfs:range xsd:integer .

ind:sponsorshipBudgetUsd rdf:type rdf:Property ;
    rdfs:label 'Sponsorship Budget Usd' ;
    rdfs:comment 'Estimated annual budget allocated specifically for sponsorship investments in USD. Used for deal qualification and portfolio planning.' ;
    rdfs:domain ind:Brand ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stockTickerSymbol rdf:type rdf:Property ;
    rdfs:label 'Stock Ticker Symbol' ;
    rdfs:comment 'Public stock exchange ticker symbol for publicly traded parent companies. Used for financial monitoring and market performance tracking.' ;
