    rdfs:range xsd:integer .

ind:drugClassification rdf:type rdf:Property ;
    rdfs:label 'Drug Classification' ;
    rdfs:comment 'Classification category of the drug indicating whether it is a specialty medication requiring special handling, distribution, or administration.' ;
