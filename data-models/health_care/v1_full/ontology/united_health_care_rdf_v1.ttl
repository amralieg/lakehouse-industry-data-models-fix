    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalTrackingNumber rdf:type rdf:Property ;
    rdfs:label 'Internal Tracking Number' ;
    rdfs:comment 'Internal tracking or reference number used by the submitting organization for filing management.' ;
    rdfs:domain ind:RegulatoryFiling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salutation rdf:type rdf:Property ;
    rdfs:label 'Salutation' ;
    rdfs:comment 'The formal title or salutation used to address the lead contact.' ;
    rdfs:domain ind:Lead ;
