ind:ageRated rdf:type rdf:Property ;
    rdfs:label 'Age Rated' ;
    rdfs:comment 'The member\'s age used for premium rating calculations.' ;
    rdfs:domain ind:Coverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:metalLevel rdf:type rdf:Property ;
    rdfs:label 'Metal Level' ;
    rdfs:comment 'The metal level tier of the plan (Bronze, Silver, Gold, Platinum, Catastrophic) indicating actuarial value.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialValue rdf:type rdf:Property ;
    rdfs:label 'Actuarial Value' ;
    rdfs:comment 'The percentage of total average costs for covered benefits that the plan will cover, expressed as a decimal.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qhpIndicator rdf:type rdf:Property ;
    rdfs:label 'Qhp Indicator' ;
    rdfs:comment 'Indicates whether this coverage is a Qualified Health Plan (QHP) offered through a health insurance marketplace.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
