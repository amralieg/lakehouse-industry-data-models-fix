ind:centerOfExcellenceDesignation rdf:type rdf:Property ;
    rdfs:label 'Center Of Excellence Designation' ;
    rdfs:comment 'Indicates whether this specialty coverage is limited to designated Centers of Excellence for high-quality, specialized care.' ;
    rdfs:domain ind:SpecialtyCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valueBasedContractIndicator rdf:type rdf:Property ;
