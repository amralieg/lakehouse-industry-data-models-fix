  primary_contact_name varchar [note: 'The full name of the primary contact person at the vendor organization. | Column primary_contact_name (STRING) in partner.vendor']
  primary_contact_phone varchar [note: 'The primary telephone number for reaching the vendor for business communications. | Column primary_contact_phone (STRING) in partner.vendor']
  risk_rating varchar [note: 'The assessed risk level associated with doing business with this vendor based on financial stability, compliance history, and operational reliability. | Column risk_rating (STRING) in partner.vendor']
  small_business_flag boolean [note: 'Boolean indicator of whether the vendor qualifies as a small business under applicable regulatory definitions. | Column small_business_flag (BOOLEAN) in partner.vendor']
  source_record_id varchar [note: 'Medallion lineage column for _source_id | Column _source_id (STRING) in partner.vendor']
  source_system_code varchar [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column source_id (STRING) in partner.vendor']
