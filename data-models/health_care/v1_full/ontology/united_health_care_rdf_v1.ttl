    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:industryRiskCategory rdf:type rdf:Property ;
    rdfs:label 'Industry Risk Category' ;
    rdfs:comment 'Risk category assigned to the employer\'s industry based on occupational hazards and claims experience.' ;
    rdfs:domain ind:UnderwritingDecision ;
