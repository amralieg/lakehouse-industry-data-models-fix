ind:remediationPlanDueDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Plan Due Date' ;
    rdfs:comment 'Date by which the vendor must submit a remediation plan to address compliance deficiencies.' ;
    rdfs:domain ind:VendorCompliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:controlTestId rdf:type rdf:Property ;
    rdfs:label 'Control Test Id' ;
    rdfs:comment 'Unique identifier for each control test execution record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ControlTest .

ind:testId rdf:type rdf:Property ;
    rdfs:label 'Test Id' ;
    rdfs:comment 'Unique identifier for the specific test procedure executed against the control.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Test .

ind:testName rdf:type rdf:Property ;
    rdfs:label 'Test Name' ;
    rdfs:comment 'Descriptive name of the test procedure performed.' ;
    rdfs:domain ind:Compliance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testType rdf:type rdf:Property ;
    rdfs:label 'Test Type' ;
    rdfs:comment 'Classification of the testing methodology applied to evaluate the control.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testDate rdf:type rdf:Property ;
    rdfs:label 'Test Date' ;
    rdfs:comment 'Date when the control test was performed.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Test Period Start Date' ;
    rdfs:comment 'Beginning date of the period covered by the control test.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Test Period End Date' ;
    rdfs:comment 'Ending date of the period covered by the control test.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testOutcome rdf:type rdf:Property ;
    rdfs:label 'Test Outcome' ;
    rdfs:comment 'Result of the control test indicating whether the control operated effectively.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencySeverity rdf:type rdf:Property ;
    rdfs:label 'Deficiency Severity' ;
    rdfs:comment 'Classification of the severity of any control deficiency identified during testing, aligned with SOX (Sarbanes-Oxley Act) Section 404 requirements.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionsIdentified rdf:type rdf:Property ;
    rdfs:label 'Exceptions Identified' ;
    rdfs:comment 'Number of exceptions or deviations from expected control performance identified during testing.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exceptionRate rdf:type rdf:Property ;
    rdfs:label 'Exception Rate' ;
    rdfs:comment 'Percentage of exceptions relative to the sample size, calculated as (exceptions_identified / sample_size) * 100.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testStatus rdf:type rdf:Property ;
    rdfs:label 'Test Status' ;
    rdfs:comment 'Current status of the control test in the testing lifecycle.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testerName rdf:type rdf:Property ;
    rdfs:label 'Tester Name' ;
    rdfs:comment 'Name of the individual who performed the control test.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testerRole rdf:type rdf:Property ;
    rdfs:label 'Tester Role' ;
    rdfs:comment 'Functional role of the individual who performed the control test.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workpaperReference rdf:type rdf:Property ;
    rdfs:label 'Workpaper Reference' ;
    rdfs:comment 'Reference to the audit workpaper or documentation file containing detailed test procedures and results.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFramework rdf:type rdf:Property ;
    rdfs:label 'Regulatory Framework' ;
    rdfs:comment 'Primary regulatory framework or compliance requirement that the control addresses.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testFrequency rdf:type rdf:Property ;
    rdfs:label 'Test Frequency' ;
    rdfs:comment 'Planned frequency for testing the control based on risk assessment and regulatory requirements.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testObjective rdf:type rdf:Property ;
    rdfs:label 'Test Objective' ;
    rdfs:comment 'Stated objective or purpose of the control test, describing what the test aims to validate.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testProcedureDescription rdf:type rdf:Property ;
    rdfs:label 'Test Procedure Description' ;
    rdfs:comment 'Detailed description of the procedures performed during the control test.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testConclusion rdf:type rdf:Property ;
    rdfs:label 'Test Conclusion' ;
    rdfs:comment 'Summary conclusion statement regarding the effectiveness of the control based on test results.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationPlanReference rdf:type rdf:Property ;
    rdfs:label 'Remediation Plan Reference' ;
    rdfs:comment 'Reference identifier for the remediation or corrective action plan associated with identified deficiencies.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationOwner rdf:type rdf:Property ;
    rdfs:label 'Remediation Owner' ;
    rdfs:comment 'Name or identifier of the individual or team responsible for implementing remediation actions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditProgramReference rdf:type rdf:Property ;
    rdfs:label 'Audit Program Reference' ;
    rdfs:comment 'Reference to the audit program or testing plan under which this control test was conducted.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditCycle rdf:type rdf:Property ;
    rdfs:label 'Audit Cycle' ;
    rdfs:comment 'Identifier for the audit cycle or period during which the control test was performed.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalAuditorReviewed rdf:type rdf:Property ;
    rdfs:label 'External Auditor Reviewed' ;
    rdfs:comment 'Indicator of whether the control test results were reviewed by external auditors.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managementAssertion rdf:type rdf:Property ;
    rdfs:label 'Management Assertion' ;
    rdfs:comment 'Financial statement assertion that the control is designed to address, per SOX (Sarbanes-Oxley Act) Section 404 requirements.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soxControlFlag rdf:type rdf:Property ;
    rdfs:label 'Sox Control Flag' ;
    rdfs:comment 'Indicator of whether the control is designated as a SOX (Sarbanes-Oxley Act) Section 404 key control for financial reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaControlFlag rdf:type rdf:Property ;
    rdfs:label 'Hipaa Control Flag' ;
    rdfs:comment 'Indicator of whether the control is designated as a HIPAA (Health Insurance Portability and Accountability Act) privacy or security control.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsAuditFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Audit Flag' ;
    rdfs:comment 'Indicator of whether the control test is relevant to CMS (Centers for Medicare and Medicaid Services) program audits or examinations.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateDoiExamFlag rdf:type rdf:Property ;
    rdfs:label 'State Doi Exam Flag' ;
    rdfs:comment 'Indicator of whether the control test is relevant to state DOI (Department of Insurance) regulatory examinations.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:testAutomationFlag rdf:type rdf:Property ;
    rdfs:label 'Test Automation Flag' ;
    rdfs:comment 'Indicator of whether the control test was performed using automated testing tools or scripts.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:automationToolName rdf:type rdf:Property ;
    rdfs:label 'Automation Tool Name' ;
    rdfs:comment 'Name of the automated testing tool or software used to perform the control test, if applicable.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:samplingMethod rdf:type rdf:Property ;
    rdfs:label 'Sampling Method' ;
    rdfs:comment 'Statistical or non-statistical sampling methodology used to select items for testing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Confidence Level' ;
    rdfs:comment 'Statistical confidence level used in sample selection and evaluation, expressed as a percentage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tolerableErrorRate rdf:type rdf:Property ;
    rdfs:label 'Tolerable Error Rate' ;
    rdfs:comment 'Maximum error rate that the auditor is willing to accept and still conclude that the control is operating effectively.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedErrorRate rdf:type rdf:Property ;
    rdfs:label 'Expected Error Rate' ;
    rdfs:comment 'Error rate anticipated by the auditor when designing the sample, based on prior experience or preliminary assessment.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testNotes rdf:type rdf:Property ;
    rdfs:label 'Test Notes' ;
    rdfs:comment 'Additional notes, observations, or comments recorded by the tester during the control test execution.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorTestOutcome rdf:type rdf:Property ;
    rdfs:label 'Prior Test Outcome' ;
    rdfs:comment 'Outcome of the most recent prior test of the same control, providing historical context.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorTestDate rdf:type rdf:Property ;
    rdfs:label 'Prior Test Date' ;
    rdfs:comment 'Date of the most recent prior test of the same control.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testHours rdf:type rdf:Property ;
    rdfs:label 'Test Hours' ;
    rdfs:comment 'Total number of hours spent performing the control test, including planning, execution, and documentation.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:processOwner rdf:type rdf:Property ;
    rdfs:label 'Process Owner' ;
    rdfs:comment 'Name or identifier of the individual or team responsible for the business process to which the control applies.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Test Completion Date' ;
    rdfs:comment 'Date when the control test was completed and results were finalized.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportDate rdf:type rdf:Property ;
    rdfs:label 'Report Date' ;
    rdfs:comment 'Date when the control test results were formally reported to management or audit committee.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testEnvironment rdf:type rdf:Property ;
    rdfs:label 'Test Environment' ;
    rdfs:comment 'System environment in which the control test was performed.' ;
    rdfs:domain ind:ControlTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentEventId rdf:type rdf:Property ;
    rdfs:label 'Enrollment Event Id' ;
    rdfs:comment 'Unique identifier for each enrollment event transaction. Primary key for the enrollment event record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnrollmentEvent .

ind:qleDate rdf:type rdf:Property ;
    rdfs:label 'Qle Date' ;
    rdfs:comment 'Date when the qualifying life event occurred. Used to determine eligibility for special enrollment period and calculate effective date of coverage.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Period Start Date' ;
    rdfs:comment 'Start date of the enrollment period during which this event was submitted.' ;
    rdfs:domain ind:EnrollmentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Period End Date' ;
    rdfs:comment 'End date of the enrollment period during which this event was submitted.' ;
    rdfs:domain ind:EnrollmentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:initiatedByUserType rdf:type rdf:Property ;
    rdfs:label 'Initiated By User Type' ;
    rdfs:comment 'Type or role of the user who initiated the enrollment event. Indicates whether the initiator was a member, employer, broker, agent, customer service representative, system process, or administrator.' ;
    rdfs:domain ind:EnrollmentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorEventId rdf:type rdf:Property ;
    rdfs:label 'Prior Event Id' ;
    rdfs:comment 'Reference to the previous enrollment event identifier if this event is a modification, correction, or reversal of a prior event.' ;
    rdfs:domain ind:EnrollmentEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnrollmentEvent .

ind:isCorrection rdf:type rdf:Property ;
    rdfs:label 'Is Correction' ;
    rdfs:comment 'Flag indicating whether this enrollment event is a correction to a previously processed event.' ;
    rdfs:domain ind:EnrollmentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReversal rdf:type rdf:Property ;
    rdfs:label 'Is Reversal' ;
    rdfs:comment 'Flag indicating whether this enrollment event reverses a previously processed event.' ;
    rdfs:domain ind:EnrollmentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Cobra Notification Date' ;
    rdfs:comment 'Date when the member was notified of their COBRA continuation rights.' ;
    rdfs:domain ind:EnrollmentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exchangeSubscriberCode rdf:type rdf:Property ;
    rdfs:label 'Exchange Subscriber Code' ;
    rdfs:comment 'Subscriber identifier assigned by the health insurance exchange for marketplace enrollments.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:csrLevel rdf:type rdf:Property ;
    rdfs:label 'Csr Level' ;
    rdfs:comment 'Level of cost sharing reduction applied to the member\'s plan for marketplace enrollments. Values represent the actuarial value percentage (73%, 87%, 94%) or none.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attestationIndicator rdf:type rdf:Property ;
    rdfs:label 'Attestation Indicator' ;
    rdfs:comment 'Flag indicating whether the member provided attestation or certification as part of the enrollment event, such as attestation of eligibility or lawful presence.' ;
    rdfs:domain ind:EnrollmentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentationStatus rdf:type rdf:Property ;
    rdfs:label 'Documentation Status' ;
    rdfs:comment 'Status of required documentation for the enrollment event. Indicates whether all required documents have been received and are complete, incomplete, pending, not required, or under review.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signatureDate rdf:type rdf:Property ;
    rdfs:label 'Signature Date' ;
    rdfs:comment 'Date when the member signed the enrollment application or authorization.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:signatureMethod rdf:type rdf:Property ;
    rdfs:label 'Signature Method' ;
    rdfs:comment 'Method by which the member provided their signature for the enrollment event. Values include electronic signature, wet signature (physical), voice recorded, or none.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaTargetDate rdf:type rdf:Property ;
    rdfs:label 'Sla Target Date' ;
    rdfs:comment 'Target date by which the enrollment event should be processed according to service level agreement commitments.' ;
    rdfs:domain ind:EnrollmentEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemName rdf:type rdf:Property ;
    rdfs:label 'Source System Name' ;
    rdfs:comment 'Name of the source system that originated or processed the enrollment event. Examples include Facets, QNXT, HealthRules, or exchange systems.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ediSenderCode rdf:type rdf:Property ;
    rdfs:label 'Edi Sender Code' ;
    rdfs:comment 'Identifier of the sender in the EDI transaction. Used for EDI-based enrollment events.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ediReceiverCode rdf:type rdf:Property ;
    rdfs:label 'Edi Receiver Code' ;
    rdfs:comment 'Identifier of the receiver in the EDI transaction. Used for EDI-based enrollment events.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ediControlNumber rdf:type rdf:Property ;
    rdfs:label 'Edi Control Number' ;
    rdfs:comment 'Control number from the EDI transaction for tracking and reconciliation purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sessionId rdf:type rdf:Property ;
    rdfs:label 'Session Id' ;
    rdfs:comment 'Session identifier for the user session during which the enrollment event was submitted. Used for security and troubleshooting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnitedHealthCare .

ind:accessibilityAccommodation rdf:type rdf:Property ;
    rdfs:label 'Accessibility Accommodation' ;
    rdfs:comment 'Description of any accessibility accommodations provided or requested during the enrollment event process, such as screen reader compatibility, large print, or interpreter services.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeDetailId rdf:type rdf:Property ;
    rdfs:label 'Change Detail Id' ;
    rdfs:comment 'Unique identifier for each enrollment change detail line item. Primary key for the change detail entity.' ;
    rdfs:domain ind:ChangeDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:changeType rdf:type rdf:Property ;
    rdfs:label 'Change Type' ;
    rdfs:comment 'Type of enrollment change being recorded in this detail line. Indicates the specific modification made to the member\'s enrollment record.' ;
    rdfs:domain ind:ChangeDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qleIndicator rdf:type rdf:Property ;
    rdfs:label 'Qle Indicator' ;
    rdfs:comment 'Flag indicating whether this change was triggered by a qualifying life event that permits enrollment modification outside standard enrollment periods.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fieldName rdf:type rdf:Property ;
    rdfs:label 'Field Name' ;
    rdfs:comment 'Name of the specific enrollment field or attribute that was modified in this change detail record.' ;
    rdfs:domain ind:ChangeDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldLabel rdf:type rdf:Property ;
    rdfs:label 'Field Label' ;
    rdfs:comment 'Business-friendly label for the field that was changed, used for display and reporting purposes.' ;
    rdfs:domain ind:ChangeDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousValue rdf:type rdf:Property ;
    rdfs:label 'Previous Value' ;
    rdfs:comment 'Value of the field before the change was applied. Stored as string to accommodate various data types.' ;
    rdfs:domain ind:ChangeDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousPlanCode rdf:type rdf:Property ;
    rdfs:label 'Previous Plan Code' ;
    rdfs:comment 'Plan identifier before the change, applicable for plan change transactions.' ;
    rdfs:domain ind:ChangeDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newPlanCode rdf:type rdf:Property ;
    rdfs:label 'New Plan Code' ;
    rdfs:comment 'Plan identifier after the change, applicable for plan change transactions.' ;
    rdfs:domain ind:ChangeDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousCoverageTier rdf:type rdf:Property ;
    rdfs:label 'Previous Coverage Tier' ;
    rdfs:comment 'Coverage tier classification before the change, indicating the scope of covered individuals.' ;
    rdfs:domain ind:ChangeDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newCoverageTier rdf:type rdf:Property ;
    rdfs:label 'New Coverage Tier' ;
    rdfs:comment 'Coverage tier classification after the change, indicating the scope of covered individuals.' ;
    rdfs:domain ind:ChangeDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Previous Premium Amount' ;
    rdfs:comment 'Monthly premium amount before the change was applied, in US dollars.' ;
    rdfs:domain ind:ChangeDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'New Premium Amount' ;
    rdfs:comment 'Monthly premium amount after the change was applied, in US dollars.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumDifferenceAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Difference Amount' ;
    rdfs:comment 'Calculated difference between new and previous premium amounts, indicating the financial impact of the change.' ;
    rdfs:domain ind:ChangeDetail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dependentSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Dependent Sequence Number' ;
    rdfs:comment 'Sequence number identifying the specific dependent involved in add or remove transactions.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dependentFirstName rdf:type rdf:Property ;
    rdfs:label 'Dependent First Name' ;
    rdfs:comment 'First name of the dependent being added or removed in this change detail.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentLastName rdf:type rdf:Property ;
    rdfs:label 'Dependent Last Name' ;
    rdfs:comment 'Last name of the dependent being added or removed in this change detail.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Dependent Date Of Birth' ;
    rdfs:comment 'Date of birth of the dependent being added or removed, used for eligibility verification.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dependentGender rdf:type rdf:Property ;
    rdfs:label 'Dependent Gender' ;
    rdfs:comment 'Gender of the dependent being added or removed. M=Male, F=Female, U=Unknown, X=Non-binary.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousPcpNpi rdf:type rdf:Property ;
    rdfs:label 'Previous Pcp Npi' ;
    rdfs:comment 'National Provider Identifier of the primary care physician before the change.' ;
    rdfs:domain ind:ChangeDetail ;
    rdf:type owl:DatatypeProperty ;
