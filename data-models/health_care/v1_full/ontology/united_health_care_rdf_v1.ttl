    rdfs:range xsd:decimal .

ind:userRoleVisibility rdf:type rdf:Property ;
    rdfs:label 'User Role Visibility' ;
    rdfs:comment 'Comma-separated list of user roles that have visibility to invoices or accounts with this billing status (e.g., billing_admin, collections_agent, finance_analyst).' ;
    rdfs:domain ind:Status ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalRequired rdf:type rdf:Property ;
    rdfs:label 'Approval Required' ;
    rdfs:comment 'Indicates whether assigning this billing status requires managerial or supervisory approval.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:helpText rdf:type rdf:Property ;
    rdfs:label 'Help Text' ;
    rdfs:comment 'User-facing help text or tooltip content explaining this billing status to members, groups, or customer service representatives.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalHoldIndicator rdf:type rdf:Property ;
    rdfs:label 'Legal Hold Indicator' ;
    rdfs:comment 'Indicates whether this billing status places accounts under legal hold, preventing collection activities due to litigation or regulatory investigation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalReportingRequired rdf:type rdf:Property ;
    rdfs:label 'External Reporting Required' ;
    rdfs:comment 'Indicates whether accounts with this billing status must be reported to external parties (e.g., credit bureaus, regulatory agencies).' ;
    rdfs:domain ind:Status ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accountsReceivableId rdf:type rdf:Property ;
    rdfs:label 'Accounts Receivable Id' ;
    rdfs:comment 'Unique identifier for the accounts receivable record. Primary key for tracking outstanding balances owed by members or groups.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AccountsReceivable .

ind:receivableType rdf:type rdf:Property ;
    rdfs:label 'Receivable Type' ;
    rdfs:comment 'The category or type of amount owed. Classifies the nature of the receivable.' ;
    rdfs:domain ind:AccountsReceivable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysOutstanding rdf:type rdf:Property ;
    rdfs:label 'Days Outstanding' ;
    rdfs:comment 'The number of days since the receivable was created or became due. Used to calculate aging.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:collectionStatus rdf:type rdf:Property ;
    rdfs:label 'Collection Status' ;
    rdfs:comment 'The status of collection efforts for this receivable. Tracks the collection process stage.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPlanIndicator rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Indicator' ;
    rdfs:comment 'Indicates whether this receivable is part of a payment plan arrangement. True if member is on a structured payment schedule.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Payment Date' ;
    rdfs:comment 'The date of the most recent payment received toward this receivable. Used for collection tracking.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Last Payment Amount' ;
    rdfs:comment 'The amount of the most recent payment received toward this receivable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastStatementDate rdf:type rdf:Property ;
    rdfs:label 'Last Statement Date' ;
    rdfs:comment 'The date of the most recent statement sent to the member or group for this receivable.' ;
    rdfs:domain ind:AccountsReceivable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextStatementDate rdf:type rdf:Property ;
    rdfs:label 'Next Statement Date' ;
    rdfs:comment 'The scheduled date for the next statement to be sent for this receivable.' ;
    rdfs:domain ind:AccountsReceivable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closedDate rdf:type rdf:Property ;
    rdfs:label 'Closed Date' ;
    rdfs:comment 'The date when this receivable was closed or fully resolved. Indicates completion of the receivable lifecycle.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disputeIndicator rdf:type rdf:Property ;
    rdfs:label 'Dispute Indicator' ;
    rdfs:comment 'Indicates whether this receivable is currently under dispute by the member or group. True if disputed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeReason rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason' ;
    rdfs:comment 'The reason provided by the member or group for disputing this receivable. Free-text description of the dispute.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retroactiveIndicator rdf:type rdf:Property ;
    rdfs:label 'Retroactive Indicator' ;
    rdfs:comment 'Indicates whether this receivable resulted from a retroactive adjustment to prior period billing. True if retroactive.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoPayIndicator rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Indicator' ;
    rdfs:comment 'Indicates whether this receivable is enrolled in automatic payment. True if auto-pay is enabled.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collectionAgencyIndicator rdf:type rdf:Property ;
    rdfs:label 'Collection Agency Indicator' ;
    rdfs:comment 'Indicates whether this receivable has been sent to a third-party collection agency. True if in external collections.' ;
    rdfs:domain ind:AccountsReceivable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collectionAgencyName rdf:type rdf:Property ;
    rdfs:label 'Collection Agency Name' ;
    rdfs:comment 'The name of the third-party collection agency handling this receivable, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionAgencyReferralDate rdf:type rdf:Property ;
    rdfs:label 'Collection Agency Referral Date' ;
    rdfs:comment 'The date when this receivable was referred to a collection agency, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalActionDate rdf:type rdf:Property ;
    rdfs:label 'Legal Action Date' ;
    rdfs:comment 'The date when legal action was initiated for this receivable, if applicable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bankruptcyIndicator rdf:type rdf:Property ;
    rdfs:label 'Bankruptcy Indicator' ;
    rdfs:comment 'Indicates whether the member or group has filed for bankruptcy affecting this receivable. True if bankruptcy filed.' ;
    rdfs:domain ind:AccountsReceivable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Billing Address Line 1' ;
    rdfs:comment 'The first line of the billing address for this receivable. Street address or PO Box.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Billing Address Line 2' ;
    rdfs:comment 'The second line of the billing address for this receivable. Apartment, suite, or unit number.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Contact Phone Number' ;
    rdfs:comment 'The primary phone number for contacting the member or group about this receivable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactEmailAddress rdf:type rdf:Property ;
    rdfs:label 'Contact Email Address' ;
    rdfs:comment 'The primary email address for contacting the member or group about this receivable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Statement Delivery Method' ;
    rdfs:comment 'The method by which billing statements are delivered for this receivable. Indicates member\'s communication preference.' ;
    rdfs:domain ind:AccountsReceivable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextDunningDate rdf:type rdf:Property ;
    rdfs:label 'Next Dunning Date' ;
    rdfs:comment 'The scheduled date for the next dunning or collection notice for this receivable.' ;
    rdfs:domain ind:AccountsReceivable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retroactiveAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Retroactive Adjustment Id' ;
    rdfs:comment 'Unique identifier for the retroactive adjustment transaction applied to a prior billing period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RetroactiveAdjustment .

ind:originalBillingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Original Billing Period Start Date' ;
    rdfs:comment 'Start date of the original billing period being adjusted retroactively.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalBillingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Original Billing Period End Date' ;
    rdfs:comment 'End date of the original billing period being adjusted retroactively.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjustmentProcessedDate rdf:type rdf:Property ;
    rdfs:label 'Adjustment Processed Date' ;
    rdfs:comment 'Date when the retroactive adjustment was processed and applied to the billing system.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjustmentApprovedDate rdf:type rdf:Property ;
    rdfs:label 'Adjustment Approved Date' ;
    rdfs:comment 'Date when the retroactive adjustment was approved by authorized personnel or automated workflow.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjustmentRequestedDate rdf:type rdf:Property ;
    rdfs:label 'Adjustment Requested Date' ;
    rdfs:comment 'Date when the retroactive adjustment was initially requested or identified for processing.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Original Premium Amount' ;
    rdfs:comment 'The original premium amount that was billed for the affected billing period before the retroactive adjustment.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustedPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Adjusted Premium Amount' ;
    rdfs:comment 'The corrected premium amount after applying the retroactive adjustment to the billing period.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentDirection rdf:type rdf:Property ;
    rdfs:label 'Adjustment Direction' ;
    rdfs:comment 'Indicates whether the retroactive adjustment results in an increase, decrease, or no change to the premium amount.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalRate rdf:type rdf:Property ;
    rdfs:label 'Original Rate' ;
    rdfs:comment 'The original premium rate applied during the billing period before the retroactive adjustment.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustedRate rdf:type rdf:Property ;
    rdfs:label 'Adjusted Rate' ;
    rdfs:comment 'The corrected premium rate applied retroactively to the billing period.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateChangePercentage rdf:type rdf:Property ;
    rdfs:label 'Rate Change Percentage' ;
    rdfs:comment 'Percentage change in the premium rate from the original to the adjusted rate, expressed as a decimal (e.g., 0.0500 for 5% increase).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pmpmOriginal rdf:type rdf:Property ;
    rdfs:label 'Pmpm Original' ;
    rdfs:comment 'Original per member per month premium rate before the retroactive adjustment, commonly used in capitation and group billing.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pmpmAdjusted rdf:type rdf:Property ;
    rdfs:label 'Pmpm Adjusted' ;
    rdfs:comment 'Adjusted per member per month premium rate after applying the retroactive correction.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pepmOriginal rdf:type rdf:Property ;
    rdfs:label 'Pepm Original' ;
    rdfs:comment 'Original per employee per month premium rate before the retroactive adjustment, used in employer group billing.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pepmAdjusted rdf:type rdf:Property ;
    rdfs:label 'Pepm Adjusted' ;
    rdfs:comment 'Adjusted per employee per month premium rate after applying the retroactive correction.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberCountOriginal rdf:type rdf:Property ;
    rdfs:label 'Member Count Original' ;
    rdfs:comment 'Number of covered members during the original billing period before the retroactive adjustment.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberCountAdjusted rdf:type rdf:Property ;
    rdfs:label 'Member Count Adjusted' ;
    rdfs:comment 'Corrected number of covered members after applying the retroactive adjustment, reflecting enrollment changes.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enrollmentChangeIndicator rdf:type rdf:Property ;
    rdfs:label 'Enrollment Change Indicator' ;
    rdfs:comment 'Flag indicating whether the retroactive adjustment involves a change in member enrollment or coverage status.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageEndDate rdf:type rdf:Property ;
    rdfs:label 'Coverage End Date' ;
    rdfs:comment 'Effective end date of coverage for the member or policy being adjusted retroactively.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Reference Number' ;
    rdfs:comment 'Unique reference number for the payment transaction related to the retroactive adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalInvoiceDate rdf:type rdf:Property ;
    rdfs:label 'Original Invoice Date' ;
    rdfs:comment 'Date when the original invoice was issued for the billing period being adjusted.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjustedInvoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Adjusted Invoice Number' ;
    rdfs:comment 'Reference number of the corrected or replacement invoice issued after the retroactive adjustment.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustedInvoiceDate rdf:type rdf:Property ;
    rdfs:label 'Adjusted Invoice Date' ;
    rdfs:comment 'Date when the adjusted invoice was issued reflecting the retroactive correction.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Billing Account Number' ;
    rdfs:comment 'Unique identifier for the billing account to which the retroactive adjustment is applied.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountsReceivableImpact rdf:type rdf:Property ;
    rdfs:label 'Accounts Receivable Impact' ;
    rdfs:comment 'Financial impact of the retroactive adjustment on accounts receivable balance. Positive values increase AR; negative values decrease AR.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueImpact rdf:type rdf:Property ;
    rdfs:label 'Revenue Impact' ;
    rdfs:comment 'Financial impact of the retroactive adjustment on recognized premium revenue for the affected period.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:asoIndicator rdf:type rdf:Property ;
    rdfs:label 'Aso Indicator' ;
    rdfs:comment 'Flag indicating whether the policy is an Administrative Services Only arrangement where the employer assumes financial risk.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employerId rdf:type rdf:Property ;
    rdfs:label 'Employer Id' ;
    rdfs:comment 'Unique identifier for the employer or group sponsor associated with the policy being adjusted.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employer .

ind:policyAmendmentNumber rdf:type rdf:Property ;
    rdfs:label 'Policy Amendment Number' ;
    rdfs:comment 'Reference number for the policy amendment that triggered the retroactive adjustment.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateFilingEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Rate Filing Effective Date' ;
    rdfs:comment 'Effective date of the approved rate filing that triggered the retroactive rate change adjustment.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionId rdf:type rdf:Property ;
    rdfs:label 'Transaction Id' ;
    rdfs:comment 'Unique transaction identifier for the retroactive adjustment in the billing system, used for audit trail and reconciliation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnitedHealthCare .

ind:approverId rdf:type rdf:Property ;
    rdfs:label 'Approver Id' ;
    rdfs:comment 'Unique identifier for the user or role that approved the retroactive adjustment transaction.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorId rdf:type rdf:Property ;
    rdfs:label 'Requestor Id' ;
    rdfs:comment 'Unique identifier for the user who initiated or requested the retroactive adjustment.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestorName rdf:type rdf:Property ;
    rdfs:label 'Requestor Name' ;
    rdfs:comment 'Full name of the individual who requested the retroactive adjustment.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrailNotes rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Notes' ;
    rdfs:comment 'Free-text notes documenting the audit trail, decision rationale, or additional context for the retroactive adjustment.' ;
    rdfs:domain ind:RetroactiveAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentMethodId rdf:type rdf:Property ;
    rdfs:label 'Payment Method Id' ;
    rdfs:comment 'Unique identifier for the payment method record. Primary key for the payment method entity.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentMethod .

ind:isElectronic rdf:type rdf:Property ;
    rdfs:label 'Is Electronic' ;
    rdfs:comment 'Flag indicating whether the payment method is processed electronically (true) or requires manual/paper processing (false).' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresBankAccount rdf:type rdf:Property ;
    rdfs:label 'Requires Bank Account' ;
    rdfs:comment 'Flag indicating whether the payment method requires bank account information (routing number and account number) for processing.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresCardDetails rdf:type rdf:Property ;
    rdfs:label 'Requires Card Details' ;
    rdfs:comment 'Flag indicating whether the payment method requires credit or debit card information (card number, expiration, CVV) for processing.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsRecurring rdf:type rdf:Property ;
    rdfs:label 'Supports Recurring' ;
    rdfs:comment 'Flag indicating whether the payment method supports automated recurring payments for premium billing cycles.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsOneTime rdf:type rdf:Property ;
    rdfs:label 'Supports One Time' ;
    rdfs:comment 'Flag indicating whether the payment method supports single one-time payment transactions.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsRefunds rdf:type rdf:Property ;
    rdfs:label 'Supports Refunds' ;
    rdfs:comment 'Flag indicating whether the payment method supports refund transactions for overpayments or policy cancellations.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:processingTimeDays rdf:type rdf:Property ;
    rdfs:label 'Processing Time Days' ;
    rdfs:comment 'Typical number of business days required for payment to clear and be applied to member accounts.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:settlementTimeDays rdf:type rdf:Property ;
    rdfs:label 'Settlement Time Days' ;
    rdfs:comment 'Number of business days required for funds to settle in UnitedHealthcare bank accounts after payment initiation.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transactionFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Transaction Fee Amount' ;
    rdfs:comment 'Fixed dollar amount charged per transaction for processing payments through this method. Used for cost analysis and fee recovery calculations.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionFeePercentage rdf:type rdf:Property ;
    rdfs:label 'Transaction Fee Percentage' ;
    rdfs:comment 'Percentage of transaction amount charged as a processing fee (e.g., 0.0250 represents 2.5%). Used for variable fee calculations.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentProcessor rdf:type rdf:Property ;
    rdfs:label 'Payment Processor' ;
    rdfs:comment 'Name of the third-party payment processor or financial institution that handles transactions for this payment method.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processorCode rdf:type rdf:Property ;
    rdfs:label 'Processor Code' ;
    rdfs:comment 'Internal or external code identifying the payment processor in system integrations and transaction routing.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gatewayName rdf:type rdf:Property ;
    rdfs:label 'Gateway Name' ;
    rdfs:comment 'Name of the payment gateway service used to facilitate secure transmission of payment information between systems.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:merchantAccountId rdf:type rdf:Property ;
    rdfs:label 'Merchant Account Id' ;
    rdfs:comment 'Unique identifier for the UnitedHealthcare merchant account associated with this payment method at the payment processor.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:achCompanyId rdf:type rdf:Property ;
    rdfs:label 'Ach Company Id' ;
    rdfs:comment 'Ten-digit company identification number assigned by NACHA for ACH transactions. Required for ACH payment methods.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:achStandardEntryClass rdf:type rdf:Property ;
    rdfs:label 'Ach Standard Entry Class' ;
    rdfs:comment 'Three-letter code indicating the ACH transaction type and authorization method (e.g., PPD for Prearranged Payment and Deposit, WEB for Internet-Initiated Entry).' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardNetwork rdf:type rdf:Property ;
    rdfs:label 'Card Network' ;
    rdfs:comment 'Name of the credit or debit card network that processes card-based payments (e.g., Visa, Mastercard). Applicable only to card payment methods.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cardType rdf:type rdf:Property ;
    rdfs:label 'Card Type' ;
    rdfs:comment 'Classification of the card payment instrument indicating whether it is a credit card, debit card, prepaid card, or charge card.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresSignature rdf:type rdf:Property ;
    rdfs:label 'Requires Signature' ;
    rdfs:comment 'Flag indicating whether the payment method requires a physical or electronic signature for authorization and compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorizationFormRequired rdf:type rdf:Property ;
    rdfs:label 'Authorization Form Required' ;
    rdfs:comment 'Flag indicating whether a formal authorization form must be completed and retained for compliance and audit purposes.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pciComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Pci Compliance Required' ;
    rdfs:comment 'Flag indicating whether the payment method requires PCI DSS compliance for secure handling of cardholder data.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tokenizationSupported rdf:type rdf:Property ;
    rdfs:label 'Tokenization Supported' ;
    rdfs:comment 'Flag indicating whether the payment method supports tokenization to replace sensitive payment data with non-sensitive tokens for enhanced security.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:availableForIndividual rdf:type rdf:Property ;
    rdfs:label 'Available For Individual' ;
    rdfs:comment 'Flag indicating whether the payment method is available for individual members purchasing direct or marketplace plans.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:availableForGroup rdf:type rdf:Property ;
    rdfs:label 'Available For Group' ;
    rdfs:comment 'Flag indicating whether the payment method is available for employer group billing and premium collection.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:availableForMedicare rdf:type rdf:Property ;
    rdfs:label 'Available For Medicare' ;
    rdfs:comment 'Flag indicating whether the payment method is available for Medicare Advantage and Part D premium payments.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:availableForMedicaid rdf:type rdf:Property ;
    rdfs:label 'Available For Medicaid' ;
    rdfs:comment 'Flag indicating whether the payment method is available for Medicaid managed care premium payments where applicable.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:availableForMarketplace rdf:type rdf:Property ;
    rdfs:label 'Available For Marketplace' ;
    rdfs:comment 'Flag indicating whether the payment method is available for Affordable Care Act marketplace plan premium payments.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lobRestrictions rdf:type rdf:Property ;
    rdfs:label 'Lob Restrictions' ;
    rdfs:comment 'Comma-separated list of line of business codes where this payment method is restricted or not available. Null indicates no restrictions.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargebackEligible rdf:type rdf:Property ;
    rdfs:label 'Chargeback Eligible' ;
    rdfs:comment 'Flag indicating whether payments made through this method can be disputed and charged back by the payer (typically true for credit cards).' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalWindowDays rdf:type rdf:Property ;
    rdfs:label 'Reversal Window Days' ;
    rdfs:comment 'Number of days after payment processing during which the payment can be reversed or returned (e.g., ACH return window).' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gracePeriodEligible rdf:type rdf:Property ;
    rdfs:label 'Grace Period Eligible' ;
    rdfs:comment 'Flag indicating whether payments made through this method are eligible for premium grace period provisions under policy terms.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoPayEligible rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Eligible' ;
    rdfs:comment 'Flag indicating whether the payment method can be enrolled in automatic payment programs for recurring premium billing.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vendorContractId rdf:type rdf:Property ;
    rdfs:label 'Vendor Contract Id' ;
    rdfs:comment 'Reference identifier for the vendor contract governing the terms and conditions of payment processing services for this method.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VendorContract .

ind:slaProcessingTimeHours rdf:type rdf:Property ;
    rdfs:label 'Sla Processing Time Hours' ;
    rdfs:comment 'Maximum number of hours guaranteed by the payment processor to complete transaction processing per service level agreement.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:failureRetryAttempts rdf:type rdf:Property ;
    rdfs:label 'Failure Retry Attempts' ;
    rdfs:comment 'Number of automatic retry attempts the system will make if a payment transaction fails initially.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:confirmationMethod rdf:type rdf:Property ;
    rdfs:label 'Confirmation Method' ;
    rdfs:comment 'Method used to send payment confirmation to members after successful transaction processing.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptGenerationRequired rdf:type rdf:Property ;
    rdfs:label 'Receipt Generation Required' ;
    rdfs:comment 'Flag indicating whether a formal payment receipt must be generated and made available to the member for this payment method.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Tax Reporting Required' ;
    rdfs:comment 'Flag indicating whether payments made through this method must be included in tax reporting documents (e.g., 1095 forms for premium tax credits).' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationFrequency rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Frequency' ;
    rdfs:comment 'Frequency at which payments processed through this method are reconciled with bank deposits and financial records.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:popularityRank rdf:type rdf:Property ;
    rdfs:label 'Popularity Rank' ;
    rdfs:comment 'Numeric ranking of payment method usage frequency based on transaction volume, used for analytics and interface optimization.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:successRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Success Rate Percentage' ;
    rdfs:comment 'Historical percentage of successful transactions for this payment method, calculated as successful transactions divided by total attempts.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageTransactionAmount rdf:type rdf:Property ;
    rdfs:label 'Average Transaction Amount' ;
    rdfs:comment 'Average dollar amount of transactions processed through this payment method, used for financial planning and analysis.' ;
    rdfs:domain ind:PaymentMethod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingMethod rdf:type rdf:Property ;
    rdfs:label 'Billing Method' ;
    rdfs:comment 'The mechanism by which premium billing is executed (e.g., list bill where carrier invoices employer, self-bill where employer calculates and remits, direct bill to individual members).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentBalance rdf:type rdf:Property ;
    rdfs:label 'Current Balance' ;
    rdfs:comment 'The net outstanding balance on the billing account representing total charges minus payments and adjustments. Positive values indicate amounts owed; negative values indicate credit balances.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pastDueBalance rdf:type rdf:Property ;
    rdfs:label 'Past Due Balance' ;
    rdfs:comment 'The portion of the outstanding balance that is overdue beyond the payment terms and grace period.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditBalance rdf:type rdf:Property ;
    rdfs:label 'Credit Balance' ;
    rdfs:comment 'The amount of overpayment or credit available on the billing account that can be applied to future premium charges.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Identification Number' ;
    rdfs:comment 'The Employer Identification Number (EIN) or Social Security Number (SSN) used for tax reporting and IRS Form 1095 generation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPostalCode rdf:type rdf:Property ;
    rdfs:label 'Billing Postal Code' ;
    rdfs:comment 'The ZIP or postal code for the billing address.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactName rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Name' ;
    rdfs:comment 'The name of the primary contact person responsible for billing and payment matters for this account.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactPhone rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Phone' ;
    rdfs:comment 'The primary phone number for the billing contact person.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactEmail rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Email' ;
    rdfs:comment 'The email address for the billing contact person where electronic invoices and payment notifications are sent.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electronicInvoiceIndicator rdf:type rdf:Property ;
    rdfs:label 'Electronic Invoice Indicator' ;
    rdfs:comment 'Flag indicating whether the account holder has opted to receive invoices electronically rather than via postal mail.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paperlessBillingIndicator rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing Indicator' ;
    rdfs:comment 'Flag indicating whether the account holder has enrolled in paperless billing to receive all billing communications electronically.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextInvoiceDate rdf:type rdf:Property ;
    rdfs:label 'Next Invoice Date' ;
    rdfs:comment 'The scheduled date on which the next premium invoice will be generated for this billing account.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextPaymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Payment Due Date' ;
    rdfs:comment 'The date by which the next premium payment must be received to avoid late fees or grace period activation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:premiumCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Premium Calculation Method' ;
    rdfs:comment 'The methodology used to calculate premium amounts for this billing account (Per Member Per Month, Per Employee Per Month, composite rates, age-banded rates, etc.).' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateRenewalDate rdf:type rdf:Property ;
    rdfs:label 'Rate Renewal Date' ;
    rdfs:comment 'The date on which premium rates are scheduled for renewal or renegotiation.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employerContributionPercentage rdf:type rdf:Property ;
    rdfs:label 'Employer Contribution Percentage' ;
    rdfs:comment 'The percentage of premium costs that the employer contributes on behalf of employees for group billing accounts.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employeeContributionPercentage rdf:type rdf:Property ;
    rdfs:label 'Employee Contribution Percentage' ;
    rdfs:comment 'The percentage of premium costs that employees are responsible for paying through payroll deduction or direct payment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cobraPremiumPercentage rdf:type rdf:Property ;
    rdfs:label 'Cobra Premium Percentage' ;
    rdfs:comment 'The percentage of the full premium amount (typically 102%) that COBRA continuation coverage participants must pay.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subsidyEligibilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Subsidy Eligibility Indicator' ;
    rdfs:comment 'Flag indicating whether the billing account is eligible for premium subsidies or tax credits.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentPlanInstallmentAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Installment Amount' ;
    rdfs:comment 'The fixed amount due for each installment payment under an active payment plan arrangement.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:latePaymentFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Payment Fee Amount' ;
    rdfs:comment 'The standard fee assessed when premium payment is received after the due date and grace period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnedPaymentFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Returned Payment Fee Amount' ;
    rdfs:comment 'The fee assessed when a payment is returned due to insufficient funds or other payment processing failures.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retroactiveAdjustmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Retroactive Adjustment Indicator' ;
    rdfs:comment 'Flag indicating whether the billing account has pending or recent retroactive premium adjustments due to enrollment changes, rate corrections, or other backdated modifications.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastReconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Last Reconciliation Date' ;
    rdfs:comment 'The date on which the most recent premium reconciliation process was completed for this billing account.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingCycleDay rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Day' ;
    rdfs:comment 'The day of the month on which recurring premium invoices are generated for this billing account.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statementFrequency rdf:type rdf:Property ;
    rdfs:label 'Statement Frequency' ;
    rdfs:comment 'The frequency at which detailed account statements summarizing charges, payments, and balances are provided to the account holder.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Parent Account Number' ;
    rdfs:comment 'The account number of the parent billing account for hierarchical account structures (e.g., subsidiary companies under a master corporate account).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Level' ;
    rdfs:comment 'The level in the account hierarchy structure where this billing account resides (0=master, 1=subsidiary, 2=division, etc.).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consolidatedBillingIndicator rdf:type rdf:Property ;
    rdfs:label 'Consolidated Billing Indicator' ;
    rdfs:comment 'Flag indicating whether this account receives consolidated invoices that combine charges from multiple subsidiary accounts or divisions.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brokerNpi rdf:type rdf:Property ;
    rdfs:label 'Broker Npi' ;
    rdfs:comment 'The National Provider Identifier assigned to the insurance broker or agency servicing this billing account.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerCommissionEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Broker Commission Eligible Indicator' ;
    rdfs:comment 'Flag indicating whether broker commissions are payable on premiums collected for this billing account.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:naicsCode rdf:type rdf:Property ;
    rdfs:label 'Naics Code' ;
    rdfs:comment 'The six-digit NAICS code representing the primary industry classification of the employer group for underwriting and risk assessment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mlrRebateEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Mlr Rebate Eligible Indicator' ;
    rdfs:comment 'Flag indicating whether this billing account is eligible to receive MLR rebates if the carrier\'s MLR falls below regulatory thresholds.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalStatus rdf:type rdf:Property ;
    rdfs:label 'Renewal Status' ;
    rdfs:comment 'The current status of the contract renewal process for this billing account.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialBillingInstructions rdf:type rdf:Property ;
    rdfs:label 'Special Billing Instructions' ;
    rdfs:comment 'Free-text field containing any special instructions or notes regarding billing, invoicing, or payment processing for this account.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingExceptionId rdf:type rdf:Property ;
    rdfs:label 'Billing Exception Id' ;
    rdfs:comment 'Unique identifier for the billing exception record.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillingException .

ind:detectedDate rdf:type rdf:Property ;
    rdfs:label 'Detected Date' ;
    rdfs:comment 'Date when the billing exception was first detected by the system or billing operations team.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:detectedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detected Timestamp' ;
    rdfs:comment 'Precise timestamp when the billing exception was first detected, including time zone information.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:detectionSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Detection Source System' ;
    rdfs:comment 'Name of the system or application that detected the billing exception (e.g., Facets, QNXT, Oracle Health Insurance).' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCycleCode rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Code' ;
    rdfs:comment 'Code identifying the billing cycle during which the exception occurred.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Amount' ;
    rdfs:comment 'Expected or correct billing amount based on policy terms and rating rules.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Amount' ;
    rdfs:comment 'Actual amount that was billed or processed, which differs from the expected amount.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceAmount rdf:type rdf:Property ;
    rdfs:label 'Variance Amount' ;
    rdfs:comment 'Calculated difference between expected and actual amounts (variance = actual - expected).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateCode rdf:type rdf:Property ;
    rdfs:label 'Rate Code' ;
    rdfs:comment 'Rate code that was applied or should have been applied in the billing calculation.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityStatusAtBilling rdf:type rdf:Property ;
    rdfs:label 'Eligibility Status At Billing' ;
    rdfs:comment 'Member eligibility status at the time the billing was processed.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Effective Date' ;
    rdfs:comment 'Date when member eligibility became effective for the coverage period.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eligibilityTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Termination Date' ;
    rdfs:comment 'Date when member eligibility was terminated, if applicable to the exception.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primaryPayerName rdf:type rdf:Property ;
    rdfs:label 'Primary Payer Name' ;
    rdfs:comment 'Name of the primary insurance payer in Coordination of Benefits (COB) scenarios.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryPayerName rdf:type rdf:Property ;
    rdfs:label 'Secondary Payer Name' ;
    rdfs:comment 'Name of the secondary insurance payer in Coordination of Benefits (COB) scenarios.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReversalIndicator rdf:type rdf:Property ;
    rdfs:label 'Payment Reversal Indicator' ;
    rdfs:comment 'Indicates whether the exception involves a payment reversal or chargeback.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subsidyEligibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Subsidy Eligibility Status' ;
    rdfs:comment 'Status of member eligibility for premium subsidies at the time of billing.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tobaccoRatingFactor rdf:type rdf:Property ;
    rdfs:label 'Tobacco Rating Factor' ;
    rdfs:comment 'Tobacco use rating factor applied in premium calculation.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicRatingArea rdf:type rdf:Property ;
    rdfs:label 'Geographic Rating Area' ;
    rdfs:comment 'Geographic rating area code used for premium calculation.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentEligibilityIssueIndicator rdf:type rdf:Property ;
    rdfs:label 'Dependent Eligibility Issue Indicator' ;
    rdfs:comment 'Indicates whether the exception involves a dependent eligibility issue (e.g., age-out, loss of student status).' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capitationPaymentIndicator rdf:type rdf:Property ;
    rdfs:label 'Capitation Payment Indicator' ;
    rdfs:comment 'Indicates whether the exception involves capitation payments to providers.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capitationRatePmpm rdf:type rdf:Property ;
    rdfs:label 'Capitation Rate Pmpm' ;
    rdfs:comment 'Per Member Per Month (PMPM) capitation rate associated with the exception.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:asoFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Aso Fee Amount' ;
    rdfs:comment 'Administrative Services Only (ASO) fee amount associated with the exception.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:duplicateBillingIndicator rdf:type rdf:Property ;
    rdfs:label 'Duplicate Billing Indicator' ;
    rdfs:comment 'Indicates whether the exception involves duplicate billing for the same coverage period.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalInvoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Original Invoice Number' ;
    rdfs:comment 'Invoice number of the original billing if this exception involves a duplicate or adjustment.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCauseCode rdf:type rdf:Property ;
    rdfs:label 'Root Cause Code' ;
    rdfs:comment 'Code identifying the root cause of the billing exception.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedDate rdf:type rdf:Property ;
    rdfs:label 'Assigned Date' ;
    rdfs:comment 'Date when the exception was assigned to a user or team for resolution.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionDate rdf:type rdf:Property ;
    rdfs:label 'Resolution Date' ;
    rdfs:comment 'Date when the billing exception was resolved.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionActionCode rdf:type rdf:Property ;
    rdfs:label 'Resolution Action Code' ;
    rdfs:comment 'Code representing the action taken to resolve the exception (e.g., corrected billing, refund issued, credit applied, rate adjusted, eligibility corrected, manual override, escalated to supervisor, no action required, cancelled).' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctedAmount rdf:type rdf:Property ;
    rdfs:label 'Corrected Amount' ;
    rdfs:comment 'Corrected billing amount after resolution of the exception.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaTargetResolutionHours rdf:type rdf:Property ;
    rdfs:label 'Sla Target Resolution Hours' ;
    rdfs:comment 'Target number of hours for exception resolution per Service Level Agreement (SLA) standards.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaActualResolutionHours rdf:type rdf:Property ;
    rdfs:label 'Sla Actual Resolution Hours' ;
    rdfs:comment 'Actual number of hours taken to resolve the exception.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaComplianceIndicator rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Indicator' ;
    rdfs:comment 'Indicates whether the exception was resolved within Service Level Agreement (SLA) targets.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationIndicator rdf:type rdf:Property ;
    rdfs:label 'Escalation Indicator' ;
    rdfs:comment 'Indicates whether the exception was escalated to higher-level management or specialized teams.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceRiskIndicator rdf:type rdf:Property ;
    rdfs:label 'Compliance Risk Indicator' ;
    rdfs:comment 'Indicates whether the exception poses a regulatory compliance risk.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReportingRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required Indicator' ;
    rdfs:comment 'Indicates whether the exception must be reported to regulatory authorities.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditTrailReference rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Reference' ;
    rdfs:comment 'Reference identifier linking to detailed audit trail records for the exception.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedTransactionId rdf:type rdf:Property ;
    rdfs:label 'Related Transaction Id' ;
    rdfs:comment 'Identifier of the related billing or payment transaction that triggered the exception.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Transaction .

ind:systemErrorCode rdf:type rdf:Property ;
    rdfs:label 'System Error Code' ;
    rdfs:comment 'System-generated error code associated with the exception, if applicable.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemErrorMessage rdf:type rdf:Property ;
    rdfs:label 'System Error Message' ;
    rdfs:comment 'System-generated error message providing details about the exception.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberNotificationSentIndicator rdf:type rdf:Property ;
    rdfs:label 'Member Notification Sent Indicator' ;
    rdfs:comment 'Indicates whether the member was notified about the billing exception.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employerNotificationSentIndicator rdf:type rdf:Property ;
    rdfs:label 'Employer Notification Sent Indicator' ;
    rdfs:comment 'Indicates whether the employer or group administrator was notified about the billing exception.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:employerNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Employer Notification Date' ;
    rdfs:comment 'Date when the employer or group administrator was notified about the billing exception.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reopenedIndicator rdf:type rdf:Property ;
    rdfs:label 'Reopened Indicator' ;
    rdfs:comment 'Indicates whether the exception was reopened after initial closure.' ;
    rdfs:domain ind:BillingException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reopenedDate rdf:type rdf:Property ;
    rdfs:label 'Reopened Date' ;
    rdfs:comment 'Date when the exception was reopened.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reopenedReason rdf:type rdf:Property ;
    rdfs:label 'Reopened Reason' ;
    rdfs:comment 'Reason for reopening the billing exception after initial closure.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arLineId rdf:type rdf:Property ;
    rdfs:label 'Ar Line Id' ;
    rdfs:comment 'Unique identifier for the accounts receivable line item. Primary key for the AR line entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ArLine .

ind:lineNumber rdf:type rdf:Property ;
    rdfs:label 'Line Number' ;
    rdfs:comment 'Sequential line number within the parent invoice for ordering and reference.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineType rdf:type rdf:Property ;
    rdfs:label 'Line Type' ;
    rdfs:comment 'Classification of the AR line item indicating the nature of the charge or credit.' ;
    rdfs:domain ind:ArLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineDescription rdf:type rdf:Property ;
    rdfs:label 'Line Description' ;
    rdfs:comment 'Detailed textual description of the AR line item explaining the charge or credit.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outstandingAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Amount' ;
    rdfs:comment 'Remaining unpaid balance for this AR line item after applying payments and adjustments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratePerMember rdf:type rdf:Property ;
    rdfs:label 'Rate Per Member' ;
    rdfs:comment 'Premium rate charged per member for this AR line item in PMPM or similar calculations.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glAccountName rdf:type rdf:Property ;
    rdfs:label 'Gl Account Name' ;
    rdfs:comment 'Name of the general ledger account to which this AR line item is posted.' ;
    rdfs:domain ind:ArLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueCategory rdf:type rdf:Property ;
    rdfs:label 'Revenue Category' ;
    rdfs:comment 'Classification of the revenue type represented by this AR line item for financial reporting.' ;
    rdfs:domain ind:ArLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountReasonCode rdf:type rdf:Property ;
    rdfs:label 'Discount Reason Code' ;
    rdfs:comment 'Code indicating the reason for any discount applied to this AR line item.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffFlag rdf:type rdf:Property ;
    rdfs:label 'Write Off Flag' ;
    rdfs:comment 'Indicates whether this AR line item has been written off as uncollectible.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collectionAgencyId rdf:type rdf:Property ;
    rdfs:label 'Collection Agency Id' ;
    rdfs:comment 'Identifier of the third-party collection agency assigned to collect this AR line item.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
