ind:UcTagDefinition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DatabricksGovernance ;
    rdfs:label 'Uc Tag Definition' ;
    rdfs:comment 'Unity Catalog column-level tag definitions for PHI/PII classification. Maps pii_phi, pii_pii, and pii_sensitive tags to columns enabling dynamic data masking and row-level security policies for HIPAA compliance.' .

ind:RlsPredicate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DatabricksGovernance ;
    rdfs:label 'Rls Predicate' ;
    rdfs:comment 'Row-Level Security predicate definitions for Unity Catalog. Defines filter conditions applied per user group/role to restrict PHI access based on care site, department, or patient consent status.' .

ind:DatabricksGovernanceDeltaTblproperties4 rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DatabricksGovernance ;
    rdfs:label 'Databricks Governance Delta Tblproperties4' ;
    rdfs:comment 'Delta Lake table properties configuration for healthcare tables. Defines TBLPROPERTIES including liquid clustering keys, optimize write settings, SCD Type 2 merge patterns, and Z-ordering columns for query performance.' .

ind:HipaaRetentionAnnotation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DatabricksGovernance ;
    rdfs:label 'Hipaa Retention Annotation' ;
    rdfs:comment 'HIPAA data retention policy annotations per table. Defines minimum and maximum retention periods, destruction methods, legal hold applicability, and regulatory basis for healthcare data lifecycle management.' .

ind:ScdType2Config rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DatabricksGovernance ;
    rdfs:label 'Scd Type2 Config' ;
    rdfs:comment 'SCD Type 2 slowly changing dimension configuration for healthcare dimension tables. Defines which columns trigger new versions, effective date columns, and merge key specifications for Delta Lake MERGE operations.' .

ind:LiquidClusteringConfig rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DatabricksGovernance ;
    rdfs:label 'Liquid Clustering Config' ;
    rdfs:comment 'Liquid clustering configuration for Delta Lake tables. Specifies clustering columns optimized for healthcare query patterns such as patient_id, encounter_date, care_site_id for automatic data layout optimization.' .

ind:IndustryOutcomePluginRegistry rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UcTags ;
    rdfs:label 'Industry Outcome Plugin Registry' ;
    rdfs:comment 'Registry of industry outcome plugins that attach to the base healthcare model without modifying base tables. Tracks plugin models like readmission_forecast, sepsis_score, and their FK attachment points to base model surrogate keys.' .

ind:ScdConfiguration rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DatabricksGovernance ;
    rdfs:label 'Scd Configuration' ;
    rdfs:comment 'Defines SCD Type 2 slowly changing dimension configurations for healthcare dimension tables, specifying business key columns, tracking columns, effective date columns, and merge strategies for maintaining full history of patient, provider, and organizational changes.' .

ind:DeltaTblpropertiesLiquidClusteringConfig rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DeltaTblproperties ;
    rdfs:label 'Delta Tblproperties Liquid Clustering Config' ;
    rdfs:comment 'Defines liquid clustering configurations for Delta tables in the healthcare lakehouse, specifying clustering columns optimized for common healthcare query patterns such as patient_id + encounter_date, provider_id + service_date, or claim_id + payer_id combinations.' .

ind:MipsClinicianMeasureReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Mips Clinician Measure Report' ;
    rdfs:comment 'Stores MIPS clinician-level quality measure reporting data including performance rates, benchmarks, and scoring for individual clinicians under the Merit-based Incentive Payment System' .

ind:MipsReporting rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Mips Reporting' ;
    rdfs:comment 'MIPS clinician-level measure reporting for quality domain expansion per VREQ-010' .

ind:ModelFeatureMapping rdf:type rdfs:Class ;
    rdfs:subClassOf ind:ClinicalAi ;
    rdfs:label 'Model Feature Mapping' ;
    rdfs:comment 'This association product represents the contractual relationship between a feature_store_entity and a model_card in clinical AI governance. It captures which features are consumed by which AI/ML models, with importance scores, version tracking, and required/optional status. Each record links one feature definition to one model card with attributes that exist only in the context of this specific feature-model relationship. This supports FDA SaMD documentation, model card governance, and MLOps feature lineage requirements.. Existence Justification: In MLOps and healthcare AI governance, the relationship between features and models is a well-established operational M:N. A single feature (e.g., patient_age, lab_value_trend) is consumed by multiple AI models simultaneously, and each model consumes multiple features as inputs. Healthcare AI governance frameworks (FDA SaMD, model cards per the user-king directive) require explicit documentation of which features each model uses, with importance scores, version tracking, and required/optional status. This is an actively managed operational relationship - data scientists and ML engineers create, update, and retire feature-model mappings as models are retrained.' .

ind:ProgramAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Provider ;
    rdfs:label 'Program Assignment' ;
    rdfs:comment 'This association product represents the operational assignment of a clinician to a Remote Patient Monitoring program. It captures the role each clinician plays within the program, their authorization period, and the maximum patient panel they can manage under that specific program. Each record links one clinician to one RPM program with attributes that exist only in the context of this assignment relationship.. Existence Justification: In healthcare RPM programs, multiple clinicians participate in a single program (medical director, monitoring nurses, consulting specialists) and a single clinician can participate in multiple RPM programs simultaneously. The business actively manages these assignments with role types, authorization periods, and panel capacity limits per program-clinician combination. This is an operational assignment that care delivery managers create, update, and terminate as part of RPM program administration.' .

ind:ProgramMonitoringRequirement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DigitalHealth ;
    rdfs:label 'Program Monitoring Requirement' ;
    rdfs:comment 'This association product represents the contractual requirement between an RPM program and a laboratory test catalog entry. It captures which lab tests are required or recommended for each remote patient monitoring program, along with the frequency, interval, and mandatory/optional status of each test within the program. Each record links one RPM program to one test catalog entry with attributes that exist only in the context of this monitoring protocol relationship.. Existence Justification: RPM programs define required laboratory monitoring protocols where one diabetes RPM program requires multiple lab tests (HbA1c, BMP, lipid panel) and one lab test like HbA1c serves multiple RPM programs (diabetes management, cardiovascular risk, pre-surgical optimization). Healthcare organizations actively manage these program-test associations with specific frequency requirements, mandatory/optional designations, and effective date ranges that belong to neither the program nor the test alone.' .

ind:DrugMonitoringProtocol rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Pharmacy ;
    rdfs:label 'Drug Monitoring Protocol' ;
    rdfs:comment 'This association product represents the clinical monitoring protocol between a drug_master and an rpm_program. It captures the specific monitoring parameters, target ranges, and frequencies that define how a particular medication is monitored within a particular RPM program. Each record links one drug to one RPM program with attributes that exist only in the context of this drug-program monitoring relationship. Clinical pharmacists and care managers actively create and maintain these protocols as part of RPM program design.. Existence Justification: In healthcare, RPM programs monitor patients on specific medications — one RPM program (e.g., cardiac monitoring) covers multiple drugs (anticoagulants, antiarrhythmics, beta-blockers), and one drug (e.g., metformin) may be monitored across multiple RPM programs (diabetes management, renal function monitoring, weight management). Clinical pharmacists and care managers actively create and maintain drug-program monitoring protocols that define specific parameters, target ranges, and monitoring frequencies unique to each drug-program combination.' .

ind:FeatureContribution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Laboratory ;
    rdfs:label 'Feature Contribution' ;
    rdfs:comment 'This association product represents the Feature Contribution between a laboratory test_result and a clinical_ai patient_risk_score. It captures which specific lab results were used as input features for each AI/ML risk score computation, along with their relative importance and the value snapshot at scoring time. Each record links one test_result to one patient_risk_score with explainability attributes required by FDA SaMD regulations, clinical trust frameworks, and model audit trails. Supports SHAP-value lineage, clinical decision support transparency, and regulatory compliance for AI-driven clinical predictions.. Existence Justification: In healthcare AI/ML workflows, a single patient risk score (e.g., sepsis risk, readmission risk) is computed from multiple laboratory test results (HbA1c, creatinine, BNP, etc.), and a single lab result contributes to multiple risk scores over time (the same HbA1c result feeds into diabetes risk, cardiovascular risk, and readmission risk models). FDA SaMD regulations and clinical explainability requirements mandate tracking which specific lab results contributed to each score and their relative importance (feature contribution weight, rank). This is an operationally managed relationship that clinicians, data scientists, and compliance officers actively create, query, and audit.' .

ind:CarePlanMedication rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Pharmacy ;
    rdfs:label 'Care Plan Medication' ;
    rdfs:comment 'This association product represents the prescribed medication regimen within a post-acute care plan. Each record links one drug from the pharmacy drug master to one post-acute care plan, capturing the dosage instructions, effective dates, clinical indication, and monitoring requirements specific to that plan-drug pairing. This is the structured normalization of the free-text medication_plan attribute, enabling discrete medication reconciliation, drug interaction checking, and formulary compliance reporting across post-acute episodes.. Existence Justification: Post-acute care plans prescribe multiple medications for patients transitioning from acute care (e.g., pain management, anticoagulants, antibiotics), and the same drug from the drug master appears across many different care plans. Each plan-medication pairing carries its own dosage instructions, start/end dates, clinical indication, and monitoring requirements — data that belongs to neither the drug nor the care plan alone. This is the structured, normalized representation of what is currently stored as a free-text \'medication_plan\' attribute on post_acute_care_plan.' .

ind:PharmacogenomicInteraction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Pharmacy ;
    rdfs:label 'Pharmacogenomic Interaction' ;
    rdfs:comment 'This association product represents the clinically actionable pharmacogenomic interaction between a drug in the pharmacy drug master and a genomic test result. It captures the evidence-based relationship between specific genetic findings and drug therapy implications, enabling clinical decision support for precision medicine dosing and drug selection. Each record links one drug_master to one genomic_test_result with attributes describing the nature, strength, and clinical recommendation of the gene-drug interaction.. Existence Justification: In pharmacogenomics, one drug (e.g., warfarin) is affected by multiple genomic variants/test results (CYP2C9, VKORC1, CYP4F2), and one genomic test result (e.g., a pharmacogenomic panel) reports actionable findings for multiple drugs simultaneously. Clinical decision support systems actively manage these gene-drug interaction mappings with evidence levels, clinical significance classifications, and dosing recommendations that belong to neither the drug nor the genomic result alone.' .

ind:StaffingAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Staffing Assignment' ;
    rdfs:comment 'This association product represents the operational Staffing Assignment between a workforce employee and a post-acute care location. It captures the active management of which employees are assigned to work at which post-acute locations, including their role, FTE allocation, effective dates, and credentialing status at each location. Each record links one employee to one post-acute location with attributes that exist only in the context of this specific assignment relationship. Used by staffing coordinators, compliance officers, and workforce management systems to track multi-site staffing across SNFs, home health agencies, and outpatient rehab centers.. Existence Justification: In healthcare, employees (nurses, therapists, aides, travel nurses, locum tenens) are actively assigned to work at multiple post-acute care locations simultaneously or sequentially. Multi-site post-acute organizations and staffing agencies operationally manage these assignments with specific roles, FTE allocations, effective dates, and credentialing status per location. This is a core workforce management process that humans actively create, update, and terminate.' .

ind:ServiceSupplyRequirement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Service Supply Requirement' ;
    rdfs:comment 'This association product represents the supply requirement relationship between a post-acute care service and a material master item. It captures the specific quantity, optionality, and substitution rules for each supply item needed to deliver a given post-acute service. Each record links one material_master to one post_acute_service with attributes that define kit assembly, cost estimation, and formulary compliance for home health and post-acute care operations.. Existence Justification: In healthcare post-acute care operations, home health agencies and skilled nursing facilities maintain explicit service-to-supply mappings (kit lists) that define which materials are needed for each service type. A wound care service requires multiple supplies (gauze, antiseptic, tape, wound vac supplies), and a single supply item like gauze is used across multiple service types (wound care, post-surgical dressing changes, burn care). These mappings are actively managed by clinical operations teams to assemble supply kits, estimate service costs, and ensure formulary compliance.' .

ind:ProgramMeasureAlignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Program Measure Alignment' ;
    rdfs:comment 'This association product represents the contractual alignment between a quality measure and an RPM program. It captures the program-specific configuration for each measure including weighting for VBP scoring, reporting cadence, effectiveness period, and program-level target thresholds. Each record links one quality measure to one RPM program with attributes that define how that measure is tracked, weighted, and reported within the context of that specific program.. Existence Justification: In healthcare quality and digital health strategy, one quality measure (e.g., blood pressure control, HbA1c management) is tracked by multiple RPM programs (hypertension monitoring, CHF management, diabetes management), and one RPM program simultaneously monitors multiple quality measures for VBP scoring and program effectiveness. Health systems actively manage this \'program measure alignment\' as part of their value-based care strategy, assigning measure-specific weights, thresholds, and reporting frequencies to each program-measure combination.' .

ind:MeasureModelValidation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Measure Model Validation' ;
    rdfs:comment 'This association product represents the validated linkage between a quality measure and an AI model card in the clinical_ai governance framework. It captures which AI models are approved to support which quality measures, with validation status, effective dating, role classification, and performance contribution weighting. Each record links one quality measure to one model card with attributes that exist only in the context of this governance relationship. Required for FDA SaMD regulatory compliance and CMS AI transparency reporting.. Existence Justification: In healthcare AI governance, quality measures are supported by multiple AI models (e.g., a readmission risk model and an NLP extraction model both feed the same HEDIS measure), and a single AI model can serve multiple quality measures (e.g., a readmission prediction model feeds both HEDIS readmission measures and CMS VBP penalty measures). Healthcare organizations actively manage which AI models support which quality measures, tracking validation status, effective dates, and performance contribution for regulatory compliance and FDA SaMD governance.' .

ind:MeasureApplicability rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Measure Applicability' ;
    rdfs:comment 'This association product represents the regulatory applicability mapping between quality measures and post-acute care services. It captures which quality measures apply to which PAC service types, including the specific measurement methodology, reporting frequency, and temporal validity of each applicability determination. Each record links one quality measure to one post-acute service with attributes that define how and when that measure is reported for that service type. Healthcare quality teams actively maintain these mappings as CMS and other stewards update measure specifications annually.. Existence Justification: In healthcare quality reporting, CMS and other regulatory bodies require organizations to track which quality measures apply to which post-acute care services. A single quality measure (e.g., OASIS-based functional improvement) applies across multiple PAC service types (physical therapy, occupational therapy, home health nursing), and each PAC service is subject to multiple quality measures (patient experience, outcome measures, process measures). Healthcare organizations actively manage this applicability mapping as part of their compliance and reporting workflows, updating it as CMS changes measure specifications annually.' .

ind:ProgramMetric rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DigitalHealth ;
    rdfs:label 'Program Metric' ;
    rdfs:comment 'This association product represents the contractual configuration between an RPM program and a LOINC-coded metric it monitors. It captures the program-specific target ranges, measurement frequency requirements, and primary/secondary designation for each metric within each program. Each record links one RPM program to one LOINC code with clinical parameters that exist only in the context of this specific program-metric relationship.. Existence Justification: An RPM program monitors multiple vital signs/metrics (each identified by a LOINC code), and a single LOINC code (e.g., systolic blood pressure, blood glucose) can be monitored across multiple RPM programs. Clinical operations teams actively configure which LOINC-coded metrics each program tracks, with program-specific target ranges, measurement frequencies, and primary/secondary designations that vary per program-metric combination.' .

ind:StudyGenomicEligibility rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Study Genomic Eligibility' ;
    rdfs:comment 'This association product represents the eligibility mapping between a research_study and a genomic_test_result. It captures which specific genomic findings satisfy (or disqualify) a study\'s biomarker-based inclusion/exclusion criteria. Each record links one research study to one genomic test result with attributes describing the biomarker requirement type, required variant, inclusion/exclusion determination, and effective dating. This is the operational record that clinical trial matching coordinators create and manage during patient screening.. Existence Justification: In clinical research, a single research study defines biomarker eligibility criteria (e.g., EGFR mutation, BRCA1/2 variants) that multiple genomic test results can satisfy, and a single genomic test result (e.g., a panel showing EGFR L858R mutation) can qualify a patient for multiple concurrent studies. Research coordinators actively manage these study-biomarker-result mappings as part of the clinical trial matching and screening workflow, determining which specific genomic findings meet which study\'s inclusion/exclusion criteria.' .

ind:ServiceIndication rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Reference ;
    rdfs:label 'Service Indication' ;
    rdfs:comment 'This association product represents the clinical and coverage indication linking an ICD-10 diagnosis code to a post-acute care service. It captures which diagnosis codes qualify patients for which post-acute services, with temporal validity and coverage classification. Each record links one ICD code to one post-acute service with attributes governing when the indication is active and what type of coverage applies. Used by utilization review, care coordination, and payer coverage determination workflows.. Existence Justification: In healthcare, a single ICD-10 diagnosis code (e.g., S72.001A - hip fracture) qualifies a patient for MANY post-acute services (physical therapy, occupational therapy, home health nursing, wound care), and a single post-acute service (e.g., physical therapy) is indicated for MANY diagnosis codes (hip fracture, knee replacement, stroke, spinal injury). Medicare and payer coverage determination requires explicitly managing which diagnosis-service combinations are approved, with effective dates and coverage types. This is an actively managed operational relationship that payers, utilization review teams, and post-acute coordinators create, update, and retire.' .

ind:PlanServiceCoverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Insurance ;
    rdfs:label 'Plan Service Coverage' ;
    rdfs:comment 'This association product represents the contractual coverage relationship between a health plan and a post-acute care service. It captures the specific benefit terms, authorization requirements, and coverage parameters that apply when a member of a given health plan utilizes a specific post-acute service. Each record links one health_plan to one post_acute_service with attributes defining copay amounts, prior authorization requirements, benefit day limits, and coverage effective periods that exist only in the context of this plan-service combination.. Existence Justification: Health plans actively maintain coverage matrices defining which post-acute care services they cover, with plan-specific benefit terms (copay amounts, prior authorization requirements, benefit limit days, coverage status, effective/termination dates). A single health plan covers many post-acute services, and a single post-acute service (e.g., physical therapy) is covered by many different health plans, each with distinct benefit terms. This is an operationally managed relationship that payer contract administrators create, update, and terminate as part of benefit design.' .

ind:CriteriaMatchEvaluation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:ClinicalAi ;
    rdfs:label 'Criteria Match Evaluation' ;
    rdfs:comment 'This association product represents the evaluation event between a clinical NLP extraction result and a trial eligibility criterion. It captures whether a specific NLP-extracted clinical concept satisfies a specific trial eligibility requirement, with match confidence scoring and evaluation status tracking. Each record links one clinical_nlp_result to one eligibility_criteria with attributes that exist only in the context of this matching relationship. Trial coordinators actively manage these evaluations as part of the clinical trial screening and patient matching workflow.. Existence Justification: In clinical trial matching workflows, trial coordinators actively evaluate NLP-extracted clinical concepts (e.g., HbA1c=8.2, diabetes diagnosis) against trial eligibility criteria. One NLP extraction can satisfy criteria across multiple trials simultaneously, and one eligibility criterion (e.g., \'must have Type 2 diabetes\') can be evidenced by multiple NLP extractions from different patient notes. This is an operational process where coordinators actively create, review, and update match evaluations as part of the clinical trial screening workflow.' .

ind:CohortProgramAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:DigitalHealth ;
    rdfs:label 'Cohort Program Assignment' ;
    rdfs:comment 'This association product represents the contractual assignment between an RPM program and a population health cohort definition. It captures which cohorts are targeted by which remote monitoring programs, with effective dating, priority ranking, and auto-enrollment configuration. Each record links one RPM program to one cohort definition with attributes that exist only in the context of this assignment relationship.. Existence Justification: In population health management, RPM programs target specific patient cohorts for enrollment, and a single cohort (e.g., elderly diabetics) may qualify for multiple RPM programs (glucose monitoring, hypertension monitoring) simultaneously. Care managers actively configure and manage these program-cohort assignments with effective dates, priority rankings, and auto-enrollment rules. This is an operational relationship that humans create, update, and retire as programs evolve.' .

ind:ModelTagAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:ClinicalAi ;
    rdfs:label 'Model Tag Assignment' ;
    rdfs:comment 'This association product represents the governance assignment of Unity Catalog tag definitions to AI model cards. It captures which tags are applied to which models, the specific tag values, who applied them, and when — supporting HIPAA compliance audits, dynamic data masking policy enforcement, and clinical AI governance workflows. Each record links one model_card to one uc_tag_definition with attributes that exist only in the context of this tagging relationship.. Existence Justification: In healthcare AI governance, one AI model (model_card) requires multiple Unity Catalog tag definitions (PHI, PII, risk_tier, department, sensitivity level) to properly classify its inputs and outputs for HIPAA compliance. Conversely, one tag definition (e.g., pii_phi) applies to many AI models across the organization. Healthcare data governance teams actively manage these tag assignments as part of model deployment workflows, tracking who applied each tag, when, and what value was assigned.' .

ind:FeatureTagApplication rdf:type rdfs:Class ;
    rdfs:subClassOf ind:ClinicalAi ;
    rdfs:label 'Feature Tag Application' ;
    rdfs:comment 'This association product represents the application of Unity Catalog tag definitions to feature store entities for PHI/PII classification and governance. Each record links one feature_store_entity to one uc_tag_definition with the specific tag value assigned, who applied it, and when. This enables dynamic data masking, row-level security policies, and HIPAA compliance auditing across the clinical AI feature store.. Existence Justification: In a Databricks healthcare lakehouse, feature store entities (ML features derived from clinical data) require multiple Unity Catalog tag classifications (pii_phi, pii_pii, pii_sensitive, data_domain, sensitivity_level) simultaneously, and each tag definition applies to hundreds or thousands of features across the catalog. This is an operational governance relationship that data stewards actively manage - they apply, modify, and revoke tag assignments as features change sensitivity classification. The relationship itself carries data (tag_value, applied_timestamp, applied_by, is_sensitive_override) that belongs to neither the feature nor the tag definition alone.' .

ind:GenomicCohortQualification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Genomics ;
    rdfs:label 'Genomic Cohort Qualification' ;
    rdfs:comment 'This association product represents the Qualification event between patient_genomic_profile and cohort_definition. It captures the operational record of a patient\'s genomic profile meeting the inclusion criteria for a population health cohort. Each record links one patient_genomic_profile to one cohort_definition with attributes that exist only in the context of this qualification relationship, including when the qualification occurred, which criteria were met, the genomic risk score in context, and the confidence of inclusion.. Existence Justification: In precision medicine and population health management, a single patient\'s genomic profile qualifies them for multiple cohorts simultaneously (e.g., BRCA1+ cohort, high pharmacogenomic risk cohort, hereditary cancer cohort), and each cohort definition includes many patients with different genomic profiles. Healthcare organizations actively manage these qualifications as part of clinical trial matching, targeted intervention programs, and population health stratification. The relationship \'Genomic Cohort Qualification\' is an operational entity that clinicians and research coordinators create, review, and update.' .

ind:GenomicCohortInclusion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Genomics ;
    rdfs:label 'Genomic Cohort Inclusion' ;
    rdfs:comment 'This association product represents the Inclusion event between patient_genomic_profile and cohort_definition. It captures which specific genomic findings drove a patient\'s genomic profile to be included in a population health cohort, along with the risk score at time of inclusion and ongoing eligibility status. Each record links one patient_genomic_profile to one cohort_definition with attributes that exist only in the context of this relationship.. Existence Justification: In healthcare population health management, a single patient\'s genomic profile can qualify them for multiple cohorts simultaneously (e.g., BRCA mutation cohort, pharmacogenomics cohort, hereditary cancer cohort, Lynch syndrome cohort). Conversely, each cohort definition includes many genomic profiles that meet its criteria. Health systems actively manage these cohort memberships as operational entities — population health teams review which genomic profiles triggered inclusion, track when criteria were met, and monitor eligibility status changes over time.' .

ind:GenomicsTrialEligibilityMatch rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Genomics ;
    rdfs:label 'Genomics Trial Eligibility Match' ;
    rdfs:comment 'This association product represents the evaluated match between a genomic test result and a clinical trial eligibility criterion. It captures the precision medicine trial matching workflow where genomic findings are systematically evaluated against trial inclusion/exclusion criteria. Each record links one genomic test result to one eligibility criterion with match scoring, evaluation status, and temporal tracking that exist only in the context of this matching relationship.. Existence Justification: In precision medicine and clinical trial matching, a single genomic test result (e.g., BRCA1 mutation detected) can satisfy eligibility criteria for multiple clinical trials simultaneously, and a single set of eligibility criteria (e.g., \'must have HER2+ status\') can be matched by genomic results from many different patients. Healthcare organizations like Academic Medical Centers actively manage this matching process as an operational workflow — clinical trial coordinators evaluate genomic results against trial criteria, record match scores, and track evaluation status. This is a core operational process in precision oncology programs.' .

ind:ClinicalTrialMatchingTrialEligibilityMatch rdf:type rdfs:Class ;
    rdfs:subClassOf ind:ClinicalTrialMatching ;
    rdfs:label 'Clinical Trial Matching Trial Eligibility Match' ;
    rdfs:comment 'This association product represents the eligibility matching event between a genomic test result and a clinical trial. It captures the precision medicine trial matching workflow where genomic findings are evaluated against trial biomarker criteria. Each record links one genomic test result to one trial with match scoring, eligibility determination, and biomarker classification attributes that exist only in the context of this matching relationship.. Existence Justification: In precision medicine, a single genomic test result (e.g., EGFR L858R mutation detected) can qualify a patient for multiple clinical trials simultaneously, and a single clinical trial accepts patients with many different genomic test results as eligibility biomarkers. Clinical trial matching is an actively managed operational process where coordinators evaluate, score, and track eligibility matches between genomic findings and trial criteria. The relationship itself carries match_score, match_date, eligibility_status, and biomarker_match_type — data that belongs to neither the test result nor the trial alone.' .

ind:PostAcuteCareCohortMembership rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PostAcuteCare ;
    rdfs:label 'Post Acute Care Cohort Membership' ;
    rdfs:comment 'This association product represents the membership of a post-acute care episode in a population health cohort. It captures the enrollment, risk stratification, program status, and target outcomes for each episode-cohort pair. Each record links one post_acute_episode to one cohort_definition with attributes that exist only in the context of this membership relationship.. Existence Justification: In population health management, a single post-acute care episode can simultaneously qualify for multiple cohort definitions (e.g., CHF readmission risk cohort AND Medicare bundled payment cohort AND high-cost utilizer cohort). Conversely, a single cohort definition governs membership of many post-acute episodes. Health systems actively manage these episode-cohort memberships with enrollment dates, risk tiers, program statuses, and target outcomes as part of value-based care and care management programs.' .

ind:CommunityResource rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Patient ;
    rdfs:label 'Community Resource' ;
    rdfs:comment 'Master reference table for community_resource. Referenced by community_resource_id.' .

ind:CohortRefreshLog rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PopulationHealth ;
    rdfs:label 'Cohort Refresh Log' ;
    rdfs:comment 'Master reference table for cohort_refresh_log. Referenced by cohort_refresh_log_id.' .

ind:CohortOutcomeTracking rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PopulationHealth ;
    rdfs:label 'Cohort Outcome Tracking' ;
    rdfs:comment 'Master reference table for cohort_outcome_tracking. Referenced by cohort_outcome_tracking_id.' .

ind:ServiceBundle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:PostAcuteCare ;
    rdfs:label 'Service Bundle' ;
    rdfs:comment 'Master reference table for service_bundle. Referenced by bundle_id.' .

ind:SurveyorTeam rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Surveyor Team' ;
    rdfs:comment 'Master reference table for surveyor_team. Referenced by surveyor_team_id.' .

ind:RootCauseAnalysis rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Root Cause Analysis' ;
    rdfs:comment 'Master reference table for root_cause_analysis. Referenced by root_cause_id.' .

ind:InstitutionalReviewBoard rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Institutional Review Board' ;
    rdfs:comment 'Master reference table for institutional_review_board. Referenced by irb_id.' .

ind:MeasureSet rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Quality ;
    rdfs:label 'Measure Set' ;
    rdfs:comment 'Master reference table for measure_set. Referenced by measure_set_id.' .

ind:ProtocolVersion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Protocol Version' ;
    rdfs:comment 'Master reference table for protocol_version. Referenced by protocol_version_id.' .

ind:WorkflowTemplate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Consent ;
    rdfs:label 'Workflow Template' ;
    rdfs:comment 'Master reference table for workflow_template. Referenced by workflow_template_id.' .

ind:EducationMaterial rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Consent ;
    rdfs:label 'Education Material' ;
    rdfs:comment 'Master reference table for education_material. Referenced by education_material_id.' .

# --- Attribute Properties ---
ind:payerContractId rdf:type rdf:Property ;
    rdfs:label 'Payer Contract Id' ;
    rdfs:comment 'Unique identifier for the payer contract record. Primary key for the payer contract entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PayerContract .

ind:facilityCareSiteId rdf:type rdf:Property ;
    rdfs:label 'Facility Care Site Id' ;
    rdfs:comment 'FK to facility.care_site.care_site_id' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:groupId rdf:type rdf:Property ;
    rdfs:label 'Group Id' ;
    rdfs:comment 'Foreign key linking to provider.provider_group. Business justification: Contracts executed with provider groups for network participation, VBC arrangements, and group-level reimbursement. Essential for contract management, payment reconciliation, and network operations. C' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Group .

ind:orgProviderId rdf:type rdf:Property ;
    rdfs:label 'Org Provider Id' ;
    rdfs:comment 'Foreign key linking to provider.org_provider. Business justification: Contracts executed with organizational providers for facility network participation and hospital reimbursement. Critical for facility contract management, claims pricing, and network adequacy. Creatin' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgProvider .

ind:payerContactId rdf:type rdf:Property ;
    rdfs:label 'Payer Contact Id' ;
    rdfs:comment 'FK to insurance.payer_contact' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PayerContact .

ind:primaryPayerId rdf:type rdf:Property ;
    rdfs:label 'Primary Payer Id' ;
    rdfs:comment 'Reference to the insurance payer organization that is party to this contract.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:renewedPayerContractId rdf:type rdf:Property ;
    rdfs:label 'Renewed Payer Contract Id' ;
    rdfs:comment 'Self-referencing FK on payer_contract (renewed_payer_contract_id)' ;
    rdfs:domain ind:PayerContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PayerContract .

ind:specialtyId rdf:type rdf:Property ;
    rdfs:label 'Specialty Id' ;
    rdfs:comment 'Foreign key linking to provider.specialty. Business justification: Contracts specify covered specialties and carve-outs (e.g., behavioral health carved out, oncology specialty contract). Critical for network adequacy planning, specialty-specific rate negotiations, an' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Specialty .

ind:amendmentCount rdf:type rdf:Property ;
    rdfs:label 'Amendment Count' ;
    rdfs:comment 'Number of amendments or modifications made to this contract since its original execution.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoRenewalFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Flag' ;
    rdfs:comment 'Indicates whether this contract automatically renews at the end of its term unless either party provides notice of termination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baseReimbursementPercentage rdf:type rdf:Property ;
    rdfs:label 'Base Reimbursement Percentage' ;
    rdfs:comment 'The baseline percentage rate applied to charges or fee schedules for reimbursement calculation (e.g., 110% of Medicare rates). Null if reimbursement method is not percentage-based.' ;
    rdfs:domain ind:PayerContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carveOutServices rdf:type rdf:Property ;
    rdfs:label 'Carve Out Services' ;
    rdfs:comment 'Description or list of services explicitly excluded from this contract and reimbursed under separate arrangements (e.g., behavioral health, pharmacy, transplant services).' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsSubmissionMethod rdf:type rdf:Property ;
    rdfs:label 'Claims Submission Method' ;
    rdfs:comment 'The method by which claims under this contract must be submitted to the payer for adjudication.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdTimestamp rdf:type rdf:Property ;
    rdfs:label 'Created Timestamp' ;
    rdfs:comment 'Timestamp when this payer contract record was first created in the system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:credentialingRequired rdf:type rdf:Property ;
    rdfs:label 'Credentialing Required' ;
    rdfs:comment 'Indicates whether individual providers must be credentialed and enrolled with the payer to bill under this contract.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:effectiveDate rdf:type rdf:Property ;
    rdfs:label 'Effective Date' ;
    rdfs:comment 'The date on which this payer contract becomes binding and reimbursement terms take effect.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilityContractAdministratorEmail rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Administrator Email' ;
    rdfs:comment 'Email address of the internal contract administrator for operational communication regarding this contract.' ;
    rdfs:domain ind:PayerContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityContractAdministratorName rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Administrator Name' ;
    rdfs:comment 'Name of the internal staff member or department responsible for managing and administering this payer contract.' ;
    rdfs:domain ind:PayerContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityContractDocumentLocation rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Document Location' ;
    rdfs:comment 'File path, URL, or document management system reference to the signed contract document for audit and reference purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityContractName rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Name' ;
    rdfs:comment 'Human-readable name or title of the payer contract for identification and reporting purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityContractNumber rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Number' ;
    rdfs:comment 'The externally-known unique business identifier for this payer contract, used in communications with the payer and internal revenue cycle operations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityContractStatus rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Status' ;
    rdfs:comment 'Current lifecycle status of the payer contract. Draft indicates contract under negotiation; pending approval awaiting internal or payer sign-off; active means contract is in force; suspended indicates temporary hold; terminated means contract ended before expiration; expired means contract reached its end date.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityContractType rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Type' ;
    rdfs:comment 'Classification of the reimbursement model governing this contract. Fee-for-service pays per service rendered; capitation pays a fixed amount per member per month; bundled payment covers an episode of care; shared savings rewards cost reduction; pay-for-performance (P4P) ties payment to quality metrics; value-based combines quality and cost outcomes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeScheduleReference rdf:type rdf:Property ;
    rdfs:label 'Fee Schedule Reference' ;
    rdfs:comment 'Reference identifier to the base fee schedule or rate table that governs reimbursement rates for services under this contract (e.g., Medicare Fee Schedule, custom negotiated rates).' ;
    rdfs:domain ind:PayerContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicCoverage rdf:type rdf:Property ;
    rdfs:label 'Geographic Coverage' ;
    rdfs:comment 'Description of the geographic region or service area covered by this contract (e.g., statewide, multi-state, specific counties).' ;
    rdfs:domain ind:PayerContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAmendmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Amendment Date' ;
    rdfs:comment 'Date of the most recent amendment or modification to this contract.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:networkTier rdf:type rdf:Property ;
    rdfs:label 'Network Tier' ;
    rdfs:comment 'The tier or level of this provider within the payers network, affecting member cost-sharing and reimbursement rates. Tier 1 typically offers lowest member cost-sharing; out-of-network highest.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notes rdf:type rdf:Property ;
    rdfs:label 'Notes' ;
    rdfs:comment 'Free-text field for additional notes, special provisions, or operational guidance related to this payer contract.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTermsDays rdf:type rdf:Property ;
    rdfs:label 'Payment Terms Days' ;
    rdfs:comment 'Number of days within which the payer is contractually obligated to remit payment after claim adjudication.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorAuthorizationRequired rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Required' ;
    rdfs:comment 'Indicates whether prior authorization is required for certain services under this contract before services are rendered.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityBonusEligible rdf:type rdf:Property ;
    rdfs:label 'Quality Bonus Eligible' ;
    rdfs:comment 'Indicates whether this contract includes provisions for quality-based bonus payments tied to performance metrics such as Healthcare Effectiveness Data and Information Set (HEDIS) scores or Merit-based Incentive Payment System (MIPS) performance.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityMeasureSet rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Set' ;
    rdfs:comment 'Identifier or name of the quality measure set or program used to evaluate performance under this contract (e.g., HEDIS, MIPS, hospital-acquired infection rates).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityPenaltyEligible rdf:type rdf:Property ;
    rdfs:label 'Quality Penalty Eligible' ;
    rdfs:comment 'Indicates whether this contract includes provisions for quality-based penalties or payment reductions for failure to meet performance thresholds.' ;
    rdfs:domain ind:PayerContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationFrequency rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Frequency' ;
    rdfs:comment 'The frequency at which financial reconciliation and settlement occurs between provider and payer for shared savings, risk adjustments, or quality bonuses.' ;
    rdfs:domain ind:PayerContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Reference' ;
    rdfs:comment 'Reference number or identifier assigned by the regulatory body for this contracts filing or approval.' ;
    rdfs:domain ind:PayerContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Required' ;
    rdfs:comment 'Indicates whether this contract must be filed with state insurance departments or other regulatory bodies for approval or compliance purposes.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reimbursementMethod rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Method' ;
    rdfs:comment 'The calculation method used to determine payment amounts. Percent of charges pays a percentage of billed charges; percent of Medicare pays a percentage of Medicare rates; flat rate is a fixed amount per service; per diem is a daily rate; case rate is a fixed amount per case; DRG-based uses Diagnosis-Related Group rates; capitation is a fixed per-member-per-month amount. [ENUM-REF-CANDIDATE: percent_of_charges|percent_of_medicare|flat_rate|per_diem|case_rate|drg_based|capitation — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Renewal Notice Days' ;
    rdfs:comment 'Number of days advance notice required to terminate or renegotiate the contract before auto-renewal occurs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskArrangementType rdf:type rdf:Property ;
    rdfs:label 'Risk Arrangement Type' ;
    rdfs:comment 'Defines the financial risk-sharing model between provider and payer. No risk means traditional fee-for-service; upside only allows provider to share in savings; downside only exposes provider to penalties; two-sided risk includes both savings and penalties; full risk transfers all financial risk to provider.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystem rdf:type rdf:Property ;
    rdfs:label 'Source System' ;
    rdfs:comment 'Identifier of the source system from which this payer contract record originated (e.g., Epic Resolute, Cerner Revenue Cycle, contract management system).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateCode rdf:type rdf:Property ;
    rdfs:label 'State Code' ;
    rdfs:comment 'Two-letter state code indicating the primary state jurisdiction for this contract.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stopLossThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Stop Loss Threshold Amount' ;
    rdfs:comment 'The dollar amount threshold above which stop-loss or reinsurance provisions apply, protecting the provider or payer from catastrophic claims costs. Null if no stop-loss provision exists.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminationDate rdf:type rdf:Property ;
    rdfs:label 'Termination Date' ;
    rdfs:comment 'The date on which this payer contract ends or is scheduled to end. Null for open-ended contracts or contracts with auto-renewal.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:timelyFilingLimitDays rdf:type rdf:Property ;
    rdfs:label 'Timely Filing Limit Days' ;
    rdfs:comment 'Number of days from date of service within which claims must be submitted to the payer to be considered timely filed and eligible for reimbursement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:updatedBy rdf:type rdf:Property ;
    rdfs:label 'Updated By' ;
    rdfs:comment 'User identifier or name of the person who last updated this payer contract record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Updated Timestamp' ;
    rdfs:comment 'Timestamp when this payer contract record was last modified in the system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:insuranceFeeScheduleId rdf:type rdf:Property ;
    rdfs:label 'Insurance Fee Schedule Id' ;
    rdfs:comment 'Add pii_phi, pii_pii, pii_sensitive tags for PHI compliance' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuranceFeeSchedule .

ind:payerId rdf:type rdf:Property ;
    rdfs:label 'Payer Id' ;
    rdfs:comment 'Reference to the insurance payer or health plan that owns this fee schedule. Links to the payer master entity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:predecessorFeeScheduleInsuranceFeeScheduleId rdf:type rdf:Property ;
    rdfs:label 'Predecessor Fee Schedule Insurance Fee Schedule Id' ;
    rdfs:comment 'Reference to the previous version of this fee schedule, enabling version history tracking and audit trails.' ;
    rdfs:domain ind:InsuranceFeeSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuranceFeeSchedule .

ind:taxonomyId rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Id' ;
    rdfs:comment 'Foreign key linking to provider.provider_taxonomy. Business justification: Fee schedules reference taxonomy codes for provider type-specific rates (e.g., different rates for MD vs NP, different facility rates by type). Critical for accurate claims pricing and contract compli' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Taxonomy .

ind:annualInflationRate rdf:type rdf:Property ;
    rdfs:label 'Annual Inflation Rate' ;
    rdfs:comment 'The annual percentage rate applied for inflation adjustments, if applicable. Expressed as a decimal (e.g., 3.50 for 3.5%).' ;
    rdfs:domain ind:InsuranceFeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalDate rdf:type rdf:Property ;
    rdfs:label 'Approval Date' ;
    rdfs:comment 'The date on which this fee schedule was formally approved for implementation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedBy rdf:type rdf:Property ;
    rdfs:label 'Approved By' ;
    rdfs:comment 'Name or identifier of the individual or authority who approved this fee schedule for use.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationRequired rdf:type rdf:Property ;
    rdfs:label 'Authorization Required' ;
    rdfs:comment 'Indicates whether services under this fee schedule require prior authorization before rendering care.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billedChargesPercentage rdf:type rdf:Property ;
    rdfs:label 'Billed Charges Percentage' ;
    rdfs:comment 'The percentage of billed charges used as the basis for reimbursement when rate_basis is percent_of_billed_charges. Expressed as a decimal (e.g., 80.00 for 80% of billed charges).' ;
    rdfs:domain ind:InsuranceFeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityServiceCategory rdf:type rdf:Property ;
    rdfs:label 'Facility Service Category' ;
    rdfs:comment 'Broad classification of services covered by this fee schedule (e.g., surgical, medical, diagnostic, preventive, behavioral health).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityType rdf:type rdf:Property ;
    rdfs:label 'Facility Type' ;
    rdfs:comment 'The type of healthcare facility to which this fee schedule applies: inpatient, outpatient, ambulatory surgery center (ASC), skilled nursing facility (SNF), home health, or hospice.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Filing Reference Number' ;
    rdfs:comment 'The reference number assigned by the regulatory authority when this fee schedule was filed for approval.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Geographic Adjustment Factor' ;
    rdfs:comment 'Geographic adjustment factor applied to base rates to account for regional cost variations. Based on CMS Geographic Practice Cost Index (GPCI) methodology.' ;
    rdfs:domain ind:InsuranceFeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicScope rdf:type rdf:Property ;
    rdfs:label 'Geographic Scope' ;
    rdfs:comment 'The geographic applicability of the fee schedule: national, regional, state-level, county-level, zip code-level, or facility-specific.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inflationAdjustmentMethod rdf:type rdf:Property ;
    rdfs:label 'Inflation Adjustment Method' ;
    rdfs:comment 'The method used for annual inflation adjustments to fee schedule rates: Consumer Price Index (CPI), Medical CPI, fixed percentage, none, or custom methodology.' ;
    rdfs:domain ind:InsuranceFeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceFeeScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Insurance Fee Schedule Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the fee schedule for system identification and cross-referencing.' ;
    rdfs:domain ind:InsuranceFeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestPenaltyRate rdf:type rdf:Property ;
    rdfs:label 'Interest Penalty Rate' ;
    rdfs:comment 'The annual interest rate applied to late payments as a penalty for exceeding payment terms. Expressed as a decimal (e.g., 10.00 for 10%).' ;
    rdfs:domain ind:InsuranceFeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:localityCode rdf:type rdf:Property ;
    rdfs:label 'Locality Code' ;
    rdfs:comment 'CMS locality code used for Medicare geographic adjustment purposes, defining the specific payment locality.' ;
    rdfs:domain ind:InsuranceFeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicarePercentage rdf:type rdf:Property ;
    rdfs:label 'Medicare Percentage' ;
    rdfs:comment 'The percentage of Medicare allowable rates used as the basis for reimbursement when rate_basis is percent_of_medicare. Expressed as a decimal (e.g., 110.00 for 110% of Medicare).' ;
    rdfs:domain ind:InsuranceFeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outlierPaymentThreshold rdf:type rdf:Property ;
    rdfs:label 'Outlier Payment Threshold' ;
    rdfs:comment 'The cost threshold above which outlier payments are triggered for exceptionally high-cost cases, typically in DRG-based reimbursement.' ;
    rdfs:domain ind:InsuranceFeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityAdjustmentPercentage rdf:type rdf:Property ;
    rdfs:label 'Quality Adjustment Percentage' ;
    rdfs:comment 'The maximum percentage adjustment (positive or negative) that can be applied to base rates based on quality performance metrics.' ;
    rdfs:domain ind:InsuranceFeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityIncentiveEligible rdf:type rdf:Property ;
    rdfs:label 'Quality Incentive Eligible' ;
    rdfs:comment 'Indicates whether this fee schedule is eligible for quality-based incentive payments under value-based purchasing or pay-for-performance programs.' ;
    rdfs:domain ind:InsuranceFeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateBasis rdf:type rdf:Property ;
    rdfs:label 'Rate Basis' ;
    rdfs:comment 'The methodology used to determine reimbursement rates: percentage of Medicare rates, percentage of billed charges, case rate, per diem, fee-for-service, or capitation.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reimbursementModel rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Model' ;
    rdfs:comment 'The payment model under which this fee schedule operates: fee-for-service, bundled payment, value-based, shared savings, capitation, or per diem.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleName rdf:type rdf:Property ;
    rdfs:label 'Schedule Name' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the fee schedule: draft (under development), active (in use), suspended (temporarily inactive), terminated (ended by agreement), expired (past termination date), or pending approval (awaiting authorization).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleType rdf:type rdf:Property ;
    rdfs:label 'Schedule Type' ;
    rdfs:comment 'Classification of the fee schedule by service category: professional services, facility services, durable medical equipment (DME), laboratory, pharmacy, or radiology.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stopLossThreshold rdf:type rdf:Property ;
    rdfs:label 'Stop Loss Threshold' ;
    rdfs:comment 'The dollar amount threshold above which stop-loss provisions apply, limiting payer liability for high-cost cases.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:versionNumber rdf:type rdf:Property ;
    rdfs:label 'Version Number' ;
    rdfs:comment 'Version identifier for the fee schedule, used to track revisions and amendments over time.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceFeeScheduleLineId rdf:type rdf:Property ;
    rdfs:label 'Insurance Fee Schedule Line Id' ;
    rdfs:comment 'Unique identifier for the fee schedule line item record. Primary key for this entity.' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drgId rdf:type rdf:Property ;
    rdfs:label 'Drg Id' ;
    rdfs:comment 'Foreign key linking to reference.drg. Business justification: Fee schedules include DRG-based case rates for inpatient hospital reimbursement. Essential for hospital claims pricing, bundled payment calculation, and value-based contract administration in payer sy' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Drg .

ind:hcpcsCodeId rdf:type rdf:Property ;
    rdfs:label 'Hcpcs Code Id' ;
    rdfs:comment 'Foreign key linking to reference.hcpcs_code. Business justification: Fee schedules include HCPCS rates for DME, supplies, and ancillary services. Essential for claims auto-pricing, provider reimbursement calculation, and contract rate validation in payer financial syst' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HcpcsCode .

ind:supersededByFeeScheduleLineInsuranceFeeScheduleLineId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Fee Schedule Line Insurance Fee Schedule Line Id' ;
    rdfs:comment 'Reference to the fee_schedule_line_id that replaces this line when status is superseded. Enables tracking of rate history and lineage.' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuranceFeeScheduleLine .

ind:allowedAmount rdf:type rdf:Property ;
    rdfs:label 'Allowed Amount' ;
    rdfs:comment 'The contracted fee amount for this procedure/service line item on the fee schedule.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:anesthesiaBaseUnits rdf:type rdf:Property ;
    rdfs:label 'Anesthesia Base Units' ;
    rdfs:comment 'For anesthesia services, the base unit value assigned to the procedure used in calculating anesthesia reimbursement (base units + time units + modifying units) × conversion factor.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assistantSurgeonAllowed rdf:type rdf:Property ;
    rdfs:label 'Assistant Surgeon Allowed' ;
    rdfs:comment 'Indicates whether an assistant surgeon is allowed for this procedure and will be separately reimbursed according to the fee schedule.' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bilateralIndicator rdf:type rdf:Property ;
    rdfs:label 'Bilateral Indicator' ;
    rdfs:comment 'Indicates whether the procedure can be performed bilaterally (on both sides of the body) and how it affects reimbursement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bundledIndicator rdf:type rdf:Property ;
    rdfs:label 'Bundled Indicator' ;
    rdfs:comment 'Indicates whether this procedure code is part of a bundled payment arrangement where multiple services are reimbursed as a single package. True means this is bundled.' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseRateAmount rdf:type rdf:Property ;
    rdfs:label 'Case Rate Amount' ;
    rdfs:comment 'When rate_basis is case_rate, this field contains the bundled payment amount for an entire episode of care or procedure (e.g., DRG-based payment, bundled surgical package).' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimLineNumber rdf:type rdf:Property ;
    rdfs:label 'Claim Line Number' ;
    rdfs:comment 'Sequential line number within the parent fee schedule, used for ordering and reference purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractedRateAmount rdf:type rdf:Property ;
    rdfs:label 'Contracted Rate Amount' ;
    rdfs:comment 'The negotiated reimbursement amount for this specific procedure code and modifier combination. Represents the dollar amount the payer will reimburse for the service.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:conversionFactor rdf:type rdf:Property ;
    rdfs:label 'Conversion Factor' ;
    rdfs:comment 'The dollar multiplier applied to total RVUs to calculate the contracted rate amount. For example, if total RVU is 2.5 and conversion factor is $40.00, the rate is $100.00.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityContractReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Reference Number' ;
    rdfs:comment 'External reference number or identifier linking this fee schedule line to the source contract document or agreement section.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geoModifier rdf:type rdf:Property ;
    rdfs:label 'Geo Modifier' ;
    rdfs:comment 'Two-digit code representing the geographic locality for Medicare GPCI adjustments. Used to adjust RVU-based payments for regional cost variations.' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:globalPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Global Period Days' ;
    rdfs:comment 'Number of days in the global surgical period during which follow-up care is included in the procedure payment and not separately reimbursable. Common values are 0, 10, or 90 days.' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineStatus rdf:type rdf:Property ;
    rdfs:label 'Line Status' ;
    rdfs:comment 'Current lifecycle status of the fee schedule line item: active (in use), inactive (not in use), pending (approved but not yet effective), superseded (replaced by newer version), expired (past termination date), or suspended (temporarily disabled).' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumReimbursement rdf:type rdf:Property ;
    rdfs:label 'Maximum Reimbursement' ;
    rdfs:comment 'The ceiling amount for reimbursement regardless of calculation method. Caps the payment level for the service.' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumReimbursement rdf:type rdf:Property ;
    rdfs:label 'Minimum Reimbursement' ;
    rdfs:comment 'The floor amount for reimbursement regardless of calculation method. Ensures a minimum payment level for the service.' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifier1 rdf:type rdf:Property ;
    rdfs:label 'Modifier 1' ;
    rdfs:comment 'Primary two-character CPT or HCPCS modifier that provides additional information about the service performed, affecting reimbursement calculation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifier2 rdf:type rdf:Property ;
    rdfs:label 'Modifier 2' ;
    rdfs:comment 'Secondary two-character CPT or HCPCS modifier providing additional service context.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifier3 rdf:type rdf:Property ;
    rdfs:label 'Modifier 3' ;
    rdfs:comment 'Tertiary two-character CPT or HCPCS modifier providing additional service context.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifier4 rdf:type rdf:Property ;
    rdfs:label 'Modifier 4' ;
    rdfs:comment 'Quaternary two-character CPT or HCPCS modifier providing additional service context.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:multipleProcedureReduction rdf:type rdf:Property ;
    rdfs:label 'Multiple Procedure Reduction' ;
    rdfs:comment 'Percentage reduction applied when multiple procedures are performed in the same session (e.g., 50.00 means second procedure is reimbursed at 50% of the fee schedule rate).' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perDiemRate rdf:type rdf:Property ;
    rdfs:label 'Per Diem Rate' ;
    rdfs:comment 'When rate_basis is per_diem, this field contains the daily rate amount for inpatient or long-term care services.' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentOfCharges rdf:type rdf:Property ;
    rdfs:label 'Percent Of Charges' ;
    rdfs:comment 'When rate_basis is percent_of_charges, this field contains the percentage multiplier applied to the providers billed charges (e.g., 65.00 means 65% of charges).' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentOfMedicare rdf:type rdf:Property ;
    rdfs:label 'Percent Of Medicare' ;
    rdfs:comment 'When rate_basis is percent_of_medicare, this field contains the percentage multiplier applied to the Medicare allowable amount (e.g., 110.00 means 110% of Medicare rates).' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:placeOfServiceCode rdf:type rdf:Property ;
    rdfs:label 'Place Of Service Code' ;
    rdfs:comment 'Two-digit code identifying the physical location where the service was rendered (e.g., 11=Office, 21=Inpatient Hospital, 22=Outpatient Hospital, 23=Emergency Department). Affects reimbursement rates.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureCode rdf:type rdf:Property ;
    rdfs:label 'Procedure Code' ;
    rdfs:comment 'The Current Procedural Terminology (CPT) or Healthcare Common Procedure Coding System (HCPCS) code identifying the specific service, procedure, or supply item being priced. Five-character alphanumeric code.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:procedureCodeType rdf:type rdf:Property ;
    rdfs:label 'Procedure Code Type' ;
    rdfs:comment 'Classification of the procedure code system used: CPT (Current Procedural Terminology), HCPCS (Healthcare Common Procedure Coding System), CDT (Current Dental Terminology), or NDC (National Drug Code).' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Quality Reporting Required' ;
    rdfs:comment 'Indicates whether quality measure reporting is required for this service as part of value-based payment programs (e.g., MIPS, APM).' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateVersion rdf:type rdf:Property ;
    rdfs:label 'Rate Version' ;
    rdfs:comment 'Version number tracking changes to this specific fee schedule line over time. Increments with each rate update or modification.' ;
    rdfs:domain ind:InsuranceFeeScheduleLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revenueCode rdf:type rdf:Property ;
    rdfs:label 'Revenue Code' ;
    rdfs:comment 'Four-digit revenue code used primarily for facility billing (UB-04 claims) to classify the type of service or accommodation provided. Used in conjunction with procedure codes for hospital outpatient and inpatient services.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rvuMalpractice rdf:type rdf:Property ;
    rdfs:label 'Rvu Malpractice' ;
    rdfs:comment 'The malpractice component of the RVU representing professional liability insurance costs associated with the service.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rvuPracticeExpense rdf:type rdf:Property ;
    rdfs:label 'Rvu Practice Expense' ;
    rdfs:comment 'The practice expense component of the RVU representing overhead costs (staff, supplies, equipment) associated with providing the service.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rvuTotal rdf:type rdf:Property ;
    rdfs:label 'Rvu Total' ;
    rdfs:comment 'The total RVU value calculated as the sum of work, practice expense, and malpractice components. Used with conversion factor to determine reimbursement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rvuWork rdf:type rdf:Property ;
    rdfs:label 'Rvu Work' ;
    rdfs:comment 'The work component of the Relative Value Unit (RVU) representing physician time, skill, and intensity required to perform the service. Used in RVU-based reimbursement calculations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specialtyCode rdf:type rdf:Property ;
    rdfs:label 'Specialty Code' ;
    rdfs:comment 'Code identifying the provider specialty for which this rate applies (e.g., cardiology, orthopedics, primary care). Some contracts have specialty-specific rates.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthRuleId rdf:type rdf:Property ;
    rdfs:label 'Prior Auth Rule Id' ;
    rdfs:comment 'Unique identifier for the prior authorization rule record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PriorAuthRule .

ind:compliancePolicyId rdf:type rdf:Property ;
    rdfs:label 'Compliance Policy Id' ;
    rdfs:comment 'Foreign key linking to compliance.policy. Business justification: Prior authorization rules must reference organizational clinical policies that define medical necessity criteria, coverage determination frameworks, and appeals processes. This linkage ensures PA rule' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CompliancePolicy .

ind:healthPlanId rdf:type rdf:Property ;
    rdfs:label 'Health Plan Id' ;
    rdfs:comment 'Reference to the specific health plan product under which this prior authorization rule applies.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HealthPlan .

ind:qualityMeasureId rdf:type rdf:Property ;
    rdfs:label 'Quality Measure Id' ;
    rdfs:comment 'Foreign key linking to quality.measure. Business justification: PA rules often reference quality measures (e.g., require PA for procedures not meeting HEDIS/NQF criteria). Payers align PA requirements with evidence-based quality measure specifications.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Measure .

ind:requiredConsentFormTemplateId rdf:type rdf:Property ;
    rdfs:label 'Required Consent Form Template Id' ;
    rdfs:comment 'Foreign key linking to consent.consent_form_template. Business justification: PA rules specify which consent forms must be completed before authorization (e.g., experimental treatment consent, genetic testing consent). Policy enforcement mechanism linking authorization requirem' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentFormTemplate .

ind:supersededPriorAuthRuleId rdf:type rdf:Property ;
    rdfs:label 'Superseded Prior Auth Rule Id' ;
    rdfs:comment 'Self-referencing FK on prior_auth_rule (superseded_prior_auth_rule_id)' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PriorAuthRule .

ind:ageMaximum rdf:type rdf:Property ;
    rdfs:label 'Age Maximum' ;
    rdfs:comment 'Maximum patient age in years for which this prior authorization rule applies. Null if no age restriction.' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageMinimum rdf:type rdf:Property ;
    rdfs:label 'Age Minimum' ;
    rdfs:comment 'Minimum patient age in years for which this prior authorization rule applies. Null if no age restriction.' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoApprovalCriteria rdf:type rdf:Property ;
    rdfs:label 'Auto Approval Criteria' ;
    rdfs:comment 'Description of the criteria that must be met for automated approval of the prior authorization request.' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoApprovalEligible rdf:type rdf:Property ;
    rdfs:label 'Auto Approval Eligible' ;
    rdfs:comment 'Indicates whether this prior authorization rule supports automated approval based on predefined criteria without manual review.' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimAppealProcessDescription rdf:type rdf:Property ;
    rdfs:label 'Claim Appeal Process Description' ;
    rdfs:comment 'Description of the process for appealing a prior authorization denial under this rule, including timelines and contact information.' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalCriteriaReference rdf:type rdf:Property ;
    rdfs:label 'Clinical Criteria Reference' ;
    rdfs:comment 'Reference to the clinical guideline, medical policy, or evidence-based criteria document that defines the medical necessity standards for this prior authorization rule.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentExceptionCriteria rdf:type rdf:Property ;
    rdfs:label 'Consent Exception Criteria' ;
    rdfs:comment 'Description of circumstances under which exceptions to the prior authorization requirement may be granted (e.g., emergency situations, continuity of care).' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactFax rdf:type rdf:Property ;
    rdfs:label 'Contact Fax' ;
    rdfs:comment 'Payer fax number for prior authorization document submission related to this rule.' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Phone' ;
    rdfs:comment 'Payer contact phone number for prior authorization inquiries and submissions related to this rule.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCode rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Code' ;
    rdfs:comment 'International Classification of Diseases 10th Revision (ICD-10) diagnosis code that qualifies or triggers the prior authorization requirement. May be null if rule applies regardless of diagnosis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationRequired rdf:type rdf:Property ;
    rdfs:label 'Documentation Required' ;
    rdfs:comment 'List or description of clinical documentation that must be submitted with the prior authorization request (e.g., chart notes, lab results, imaging reports).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyLimit rdf:type rdf:Property ;
    rdfs:label 'Frequency Limit' ;
    rdfs:comment 'Maximum number of times the service can be performed within the frequency period without prior authorization. Null if no frequency limit applies.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyLimitPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Frequency Limit Period Days' ;
    rdfs:comment 'Time period in days over which the frequency limit is measured. Null if no period applies.' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:genderRestriction rdf:type rdf:Property ;
    rdfs:label 'Gender Restriction' ;
    rdfs:comment 'Gender-specific applicability of the prior authorization rule. Values: male, female, all (no restriction), or other.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicalPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Medical Policy Number' ;
    rdfs:comment 'Payer-specific medical policy document number or identifier that governs this prior authorization rule.' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paRequirementType rdf:type rdf:Property ;
    rdfs:label 'Pa Requirement Type' ;
    rdfs:comment 'Classification of the prior authorization requirement level: required (mandatory PA), not required, clinical review (medical necessity review), peer-to-peer (physician discussion), notification only, or retrospective review.' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portalUrl rdf:type rdf:Property ;
    rdfs:label 'Portal Url' ;
    rdfs:comment 'Web address of the payer portal for electronic prior authorization submission, if applicable.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthRuleStatus rdf:type rdf:Property ;
    rdfs:label 'Prior Auth Rule Status' ;
    rdfs:comment 'Current lifecycle status of the prior authorization rule: active (in effect), inactive (not enforced), pending (scheduled for activation), suspended (temporarily paused), or retired (permanently discontinued).' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityLimit rdf:type rdf:Property ;
    rdfs:label 'Quantity Limit' ;
    rdfs:comment 'Maximum quantity or units of service allowed without prior authorization under this rule. Null if no quantity limit applies.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityLimitPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Quantity Limit Period Days' ;
    rdfs:comment 'Time period in days over which the quantity limit is measured (e.g., 30 days, 90 days). Null if no period applies.' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryBasis rdf:type rdf:Property ;
    rdfs:label 'Regulatory Basis' ;
    rdfs:comment 'Citation of the regulatory or statutory authority that permits or requires this prior authorization rule (e.g., CMS National Coverage Determination, state insurance law).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleCode rdf:type rdf:Property ;
    rdfs:label 'Rule Code' ;
    rdfs:comment 'Unique business identifier code for this prior authorization rule, used for external reference and reporting.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleName rdf:type rdf:Property ;
    rdfs:label 'Rule Name' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepTherapyCriteria rdf:type rdf:Property ;
    rdfs:label 'Step Therapy Criteria' ;
    rdfs:comment 'Description of the step therapy requirements, including which alternative treatments must be tried first and failure criteria.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepTherapyRequired rdf:type rdf:Property ;
    rdfs:label 'Step Therapy Required' ;
    rdfs:comment 'Indicates whether step therapy (trial of alternative treatments before approval) is required as part of the prior authorization criteria.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:submissionMethod rdf:type rdf:Property ;
    rdfs:label 'Submission Method' ;
    rdfs:comment 'Allowed method(s) for submitting the prior authorization request: payer portal, fax, phone, EDI 278 transaction, email, or postal mail.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:turnaroundTimeHours rdf:type rdf:Property ;
    rdfs:label 'Turnaround Time Hours' ;
    rdfs:comment 'Standard turnaround time in hours for the payer to respond to a prior authorization request under this rule.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:urgentTurnaroundTimeHours rdf:type rdf:Property ;
    rdfs:label 'Urgent Turnaround Time Hours' ;
    rdfs:comment 'Expedited turnaround time in hours for urgent or emergent prior authorization requests under this rule.' ;
    rdfs:domain ind:PriorAuthRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:utilizationReviewId rdf:type rdf:Property ;
    rdfs:label 'Utilization Review Id' ;
    rdfs:comment 'Unique identifier for the utilization review record. Primary key.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UtilizationReview .

ind:appealedUtilizationReviewId rdf:type rdf:Property ;
    rdfs:label 'Appealed Utilization Review Id' ;
    rdfs:comment 'Self-referencing FK on utilization_review (appealed_utilization_review_id)' ;
    rdfs:domain ind:UtilizationReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UtilizationReview .

ind:careSiteId rdf:type rdf:Property ;
    rdfs:label 'Care Site Id' ;
    rdfs:comment 'Identifier of the healthcare facility where the service or admission occurred.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareSite .

ind:clinicianId rdf:type rdf:Property ;
    rdfs:label 'Clinician Id' ;
    rdfs:comment 'Identifier of the physician or provider who rendered the service being reviewed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:complianceProgramId rdf:type rdf:Property ;
    rdfs:label 'Compliance Program Id' ;
    rdfs:comment 'Foreign key linking to compliance.compliance_program. Business justification: Utilization review activities must comply with specific compliance programs: UM compliance program, clinical criteria adherence program, regulatory timeframe compliance. Linking UR to governing compli' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceProgram .

ind:consentRecordId rdf:type rdf:Property ;
    rdfs:label 'Consent Record Id' ;
    rdfs:comment 'Foreign key linking to consent.consent_record. Business justification: UR reviewers must verify appropriate consent exists for the service under review (especially for experimental treatments, research procedures, genetic testing). Regulatory requirement for authorizatio' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Consent .

ind:employeeId rdf:type rdf:Property ;
    rdfs:label 'Employee Id' ;
    rdfs:comment 'Identifier of the clinical reviewer (nurse, physician advisor, or UM specialist) who conducted the utilization review.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:encounterAuthorizationId rdf:type rdf:Property ;
    rdfs:label 'Encounter Authorization Id' ;
    rdfs:comment 'Identifier of the associated prior authorization request, if this review is linked to a pre-certification or authorization workflow.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EncounterAuthorization .

ind:mpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Mpi Record Id' ;
    rdfs:comment 'Identifier of the health plan member (patient) whose care is being reviewed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:postAcuteEpisodeId rdf:type rdf:Property ;
    rdfs:label 'Post Acute Episode Id' ;
    rdfs:comment 'Foreign key linking to post_acute_care.post_acute_episode. Business justification: Concurrent/retrospective utilization review of PAC episodes (SNF stays, home health) is a core payer operation for medical necessity determination and length-of-stay authorization per CMS/commercial p' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PostAcuteEpisode .

ind:reviewCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Review Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Utilization review denials and approvals directly impact cost center financial performance. Finance teams reconcile UR decisions to departmental budgets and variance reports. Real-world healthcare CFO' ;
    rdfs:domain ind:UtilizationReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:visitId rdf:type rdf:Property ;
    rdfs:label 'Visit Id' ;
    rdfs:comment 'Identifier of the clinical encounter (admission, visit, or service episode) subject to utilization review.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Visit .

ind:admissionDate rdf:type rdf:Property ;
    rdfs:label 'Admission Date' ;
    rdfs:comment 'Date the patient was admitted to the facility, applicable for inpatient utilization reviews.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedLengthOfStay rdf:type rdf:Property ;
    rdfs:label 'Approved Length Of Stay' ;
    rdfs:comment 'Number of inpatient days approved by the utilization review, which may differ from the requested length of stay.' ;
    rdfs:domain ind:UtilizationReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimAppealFiled rdf:type rdf:Property ;
    rdfs:label 'Claim Appeal Filed' ;
    rdfs:comment 'Indicates whether an appeal was filed by the member or provider in response to the utilization review decision.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimAppealRightsNotified rdf:type rdf:Property ;
    rdfs:label 'Claim Appeal Rights Notified' ;
    rdfs:comment 'Indicates whether the member and provider were notified of their rights to appeal the utilization review decision, as required by ERISA and state regulations.' ;
    rdfs:domain ind:UtilizationReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimDenialReasonCode rdf:type rdf:Property ;
    rdfs:label 'Claim Denial Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for denial or modification of the service request (e.g., not medically necessary, experimental treatment, lack of documentation).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimDenialReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Claim Denial Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of the reason for denial or modification, provided to the member and provider.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalCriteriaApplied rdf:type rdf:Property ;
    rdfs:label 'Clinical Criteria Applied' ;
    rdfs:comment 'Name of the clinical guideline or criteria set used to evaluate medical necessity (e.g., InterQual, MCG, Milliman Care Guidelines).' ;
    rdfs:domain ind:UtilizationReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clinicalDocumentationReviewed rdf:type rdf:Property ;
    rdfs:label 'Clinical Documentation Reviewed' ;
    rdfs:comment 'Summary or list of clinical documentation reviewed during the UM process (e.g., H&P, progress notes, lab results, imaging reports).' ;
    rdfs:domain ind:UtilizationReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criteriaVersion rdf:type rdf:Property ;
    rdfs:label 'Criteria Version' ;
    rdfs:comment 'Version number or edition of the clinical criteria applied during the review.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dischargeDate rdf:type rdf:Property ;
    rdfs:label 'Discharge Date' ;
    rdfs:comment 'Date the patient was discharged from the facility, applicable for inpatient utilization reviews.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilityServiceDate rdf:type rdf:Property ;
    rdfs:label 'Facility Service Date' ;
    rdfs:comment 'Date of the service, procedure, or admission being reviewed for medical necessity.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicalRecordNumber rdf:type rdf:Property ;
    rdfs:label 'Medical Record Number' ;
    rdfs:comment 'Patients medical record number at the facility where the service was provided.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationMethod rdf:type rdf:Property ;
    rdfs:label 'Notification Method' ;
    rdfs:comment 'Method used to notify the member and provider of the review decision (mail, fax, email, patient portal, phone).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationSentDate rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Date' ;
    rdfs:comment 'Date the review decision notification was sent to the member and provider.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerToPeerDate rdf:type rdf:Property ;
    rdfs:label 'Peer To Peer Date' ;
    rdfs:comment 'Date the peer-to-peer review discussion occurred between the treating provider and the payers medical reviewer.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:peerToPeerRequested rdf:type rdf:Property ;
    rdfs:label 'Peer To Peer Requested' ;
    rdfs:comment 'Indicates whether the treating provider requested a peer-to-peer discussion with the medical director or physician reviewer to appeal or discuss the initial review decision.' ;
    rdfs:domain ind:UtilizationReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryTimeframeMet rdf:type rdf:Property ;
    rdfs:label 'Regulatory Timeframe Met' ;
    rdfs:comment 'Indicates whether the utilization review was completed within the regulatory timeframe mandated by state or federal law (e.g., 72 hours for urgent pre-service, 30 days for retrospective).' ;
    rdfs:domain ind:UtilizationReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renderingProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Rendering Provider Npi' ;
    rdfs:comment 'Ten-digit National Provider Identifier (NPI) of the rendering provider.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedLengthOfStay rdf:type rdf:Property ;
    rdfs:label 'Requested Length Of Stay' ;
    rdfs:comment 'Number of inpatient days requested or initially authorized for the admission.' ;
    rdfs:domain ind:UtilizationReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Review Completion Date' ;
    rdfs:comment 'Date the utilization review was completed and a final decision was rendered.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewDecision rdf:type rdf:Property ;
    rdfs:label 'Review Decision' ;
    rdfs:comment 'Final determination of the utilization review: approved (medical necessity met), denied (not medically necessary), modified (approved with changes), pended (additional information required), or partially approved.' ;
    rdfs:domain ind:UtilizationReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewInitiationDate rdf:type rdf:Property ;
    rdfs:label 'Review Initiation Date' ;
    rdfs:comment 'Date the utilization review process was initiated or the review request was received.' ;
    rdfs:domain ind:UtilizationReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewNumber rdf:type rdf:Property ;
    rdfs:label 'Review Number' ;
    rdfs:comment 'Business identifier or case number assigned to this utilization review for tracking and reference by payers, providers, and UM teams.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewStatus rdf:type rdf:Property ;
    rdfs:label 'Review Status' ;
    rdfs:comment 'Current lifecycle status of the utilization review process.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewType rdf:type rdf:Property ;
    rdfs:label 'Review Type' ;
    rdfs:comment 'Type of utilization management review conducted: pre-certification (prospective), concurrent review (during stay), retrospective review (post-service), discharge planning, or continued stay review.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerCredentials rdf:type rdf:Property ;
    rdfs:label 'Reviewer Credentials' ;
    rdfs:comment 'Professional credentials of the reviewer (e.g., RN, MD, DO, NP) to demonstrate clinical qualifications for conducting the review.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerNotes rdf:type rdf:Property ;
    rdfs:label 'Reviewer Notes' ;
    rdfs:comment 'Free-text notes or comments entered by the clinical reviewer documenting the rationale for the review decision.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilitySpanId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Span Id' ;
    rdfs:comment 'Unique identifier for the eligibility span record. Primary key for the eligibility span entity.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eligibilityId rdf:type rdf:Property ;
    rdfs:label 'Eligibility Id' ;
    rdfs:comment 'Reference to the X12 270/271 eligibility verification transaction that confirmed or established this eligibility span. Links to real-time eligibility verification events.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Eligibility .

ind:priorEligibilitySpanId rdf:type rdf:Property ;
    rdfs:label 'Prior Eligibility Span Id' ;
    rdfs:comment 'Self-referencing FK on eligibility_span (prior_eligibility_span_id)' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EligibilitySpan .

ind:providerNetworkId rdf:type rdf:Property ;
    rdfs:label 'Provider Network Id' ;
    rdfs:comment 'Unique identifier for the provider network associated with this eligibility span. Defines which providers are in-network for this coverage.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProviderNetwork .

ind:subscriberId rdf:type rdf:Property ;
    rdfs:label 'Subscriber Id' ;
    rdfs:comment 'Unique identifier for the primary subscriber (policyholder) of the insurance plan. May be the same as member_id if the member is the subscriber, or different if the member is a dependent.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Subscriber .

ind:benefitPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Benefit Period End Date' ;
    rdfs:comment 'The end date of the benefit period for deductible and out-of-pocket maximum accumulation. Deductibles and accumulators reset after this date.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:benefitPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Benefit Period Start Date' ;
    rdfs:comment 'The start date of the benefit period for deductible and out-of-pocket maximum accumulation. Typically aligns with plan year or calendar year.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobraIndicator rdf:type rdf:Property ;
    rdfs:label 'Cobra Indicator' ;
    rdfs:comment 'Indicates whether this eligibility span represents COBRA continuation coverage. True if the member is continuing coverage under COBRA provisions after a qualifying event.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraQualifyingEvent rdf:type rdf:Property ;
    rdfs:label 'Cobra Qualifying Event' ;
    rdfs:comment 'The qualifying event that triggered COBRA continuation coverage eligibility. Populated only when cobra_indicator is true.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobraQualifyingEventDate rdf:type rdf:Property ;
    rdfs:label 'Cobra Qualifying Event Date' ;
    rdfs:comment 'The date on which the COBRA qualifying event occurred. Used to determine COBRA continuation period limits.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coordinationOfBenefitsIndicator rdf:type rdf:Property ;
    rdfs:label 'Coordination Of Benefits Indicator' ;
    rdfs:comment 'Indicates whether coordination of benefits rules apply because the member has multiple insurance coverages. True if this is a secondary or tertiary payer.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageLevel rdf:type rdf:Property ;
    rdfs:label 'Coverage Level' ;
    rdfs:comment 'The tier of coverage indicating whether the plan covers only the subscriber or includes dependents.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageOrder rdf:type rdf:Property ;
    rdfs:label 'Coverage Order' ;
    rdfs:comment 'Indicates the order of liability when multiple coverages exist. Primary coverage pays first; secondary and tertiary coverages pay after primary according to COB rules.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageType rdf:type rdf:Property ;
    rdfs:label 'Coverage Type' ;
    rdfs:comment 'The type of healthcare services covered under this eligibility span. Defines the scope of benefits available to the member.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dualEligibilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Dual Eligibility Indicator' ;
    rdfs:comment 'Indicates whether the member is dually eligible for both Medicare and Medicaid. True if the member qualifies for both programs simultaneously.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dualEligibilityType rdf:type rdf:Property ;
    rdfs:label 'Dual Eligibility Type' ;
    rdfs:comment 'Specifies the type of dual eligibility status. QMB (Qualified Medicare Beneficiary), SLMB (Specified Low-Income Medicare Beneficiary), QI (Qualifying Individual), QDWI (Qualified Disabled and Working Individual). Populated only when dual_eligibility_indicator is true.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityEndDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility End Date' ;
    rdfs:comment 'The date on which the members insurance coverage terminates under this eligibility span. Null indicates open-ended active coverage.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eligibilityStartDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Start Date' ;
    rdfs:comment 'The date on which the members insurance coverage becomes effective under this eligibility span. Represents the beginning of the continuous eligibility period.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eligibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Eligibility Status' ;
    rdfs:comment 'Current lifecycle status of the eligibility span. Active indicates coverage is in force; terminated indicates coverage has ended; suspended indicates temporary hold; COBRA indicates continuation coverage under COBRA provisions; pending indicates coverage not yet effective.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verification Date' ;
    rdfs:comment 'The date on which eligibility was last verified with the payer through a 270/271 transaction or other verification method.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eligibilityVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verification Status' ;
    rdfs:comment 'The status of the most recent eligibility verification attempt. Verified indicates successful confirmation; unverified indicates no recent verification; failed indicates verification was attempted but unsuccessful.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentMethod rdf:type rdf:Property ;
    rdfs:label 'Enrollment Method' ;
    rdfs:comment 'The method by which the enrollment was submitted. Distinguishes between online enrollment, paper application, phone enrollment, in-person enrollment, or automatic enrollment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentSource rdf:type rdf:Property ;
    rdfs:label 'Enrollment Source' ;
    rdfs:comment 'The source or channel through which the member enrolled in this coverage. Indicates whether enrollment was through an employer, exchange, direct purchase, broker, or government program.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeIndicator rdf:type rdf:Property ;
    rdfs:label 'Exchange Indicator' ;
    rdfs:comment 'Indicates whether this coverage was purchased through a health insurance exchange (marketplace) established under the Affordable Care Act.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:groupNumber rdf:type rdf:Property ;
    rdfs:label 'Group Number' ;
    rdfs:comment 'Employer or sponsor group number under which the member is covered. Used to identify the employer or organization sponsoring the coverage.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicaid Indicator' ;
    rdfs:comment 'Indicates whether the member has Medicaid coverage. True if the member is enrolled in a state Medicaid program.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicare Indicator' ;
    rdfs:comment 'Indicates whether the member has Medicare coverage. True if the member is enrolled in Medicare Part A, B, C, or D.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pcpAssignmentDate rdf:type rdf:Property ;
    rdfs:label 'Pcp Assignment Date' ;
    rdfs:comment 'The date on which the current primary care physician was assigned to or selected by the member.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pcpRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Pcp Required Indicator' ;
    rdfs:comment 'Indicates whether the member is required to select and maintain a primary care physician under this plan. True for HMO and POS plans that require PCP designation.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Amount' ;
    rdfs:comment 'The premium amount charged for this coverage, typically per billing period. Represents the member or employer contribution for maintaining coverage.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumPaymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Premium Payment Frequency' ;
    rdfs:comment 'The frequency at which premium payments are due for this coverage.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorAuthorizationRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Prior Authorization Required Indicator' ;
    rdfs:comment 'Indicates whether certain services under this plan require prior authorization from the payer before services are rendered.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referralRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Referral Required Indicator' ;
    rdfs:comment 'Indicates whether the member must obtain a referral from their PCP before seeing a specialist. True for HMO plans with referral requirements.' ;
    rdfs:domain ind:EligibilitySpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relationshipToSubscriber rdf:type rdf:Property ;
    rdfs:label 'Relationship To Subscriber' ;
    rdfs:comment 'Defines the relationship of the member to the primary subscriber. Determines dependent status and eligibility rules. [ENUM-REF-CANDIDATE: self|spouse|child|other_dependent|life_partner|domestic_partner|parent|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subsidyAmount rdf:type rdf:Property ;
    rdfs:label 'Subsidy Amount' ;
    rdfs:comment 'The amount of premium subsidy or tax credit applied to reduce the members premium cost. Applicable for exchange plans with Advanced Premium Tax Credits (APTC).' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subsidyType rdf:type rdf:Property ;
    rdfs:label 'Subsidy Type' ;
    rdfs:comment 'The type of subsidy applied to this coverage. APTC (Advanced Premium Tax Credit), CSR (Cost-Sharing Reduction), employer subsidy, state subsidy, or none.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationReason rdf:type rdf:Property ;
    rdfs:label 'Termination Reason' ;
    rdfs:comment 'The reason for termination of the eligibility span, if applicable. Populated only when eligibility_status is terminated. [ENUM-REF-CANDIDATE: voluntary|involuntary|employment_ended|non_payment|death|divorce|age_limit|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accumulatorId rdf:type rdf:Property ;
    rdfs:label 'Accumulator Id' ;
    rdfs:comment 'Unique identifier for the accumulator record. Primary key for tracking member benefit accumulation.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimId rdf:type rdf:Property ;
    rdfs:label 'Claim Id' ;
    rdfs:comment 'Identifier of the most recent claim transaction that contributed to this accumulator. Provides audit trail for accumulation calculations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Claim .

ind:insuranceHealthPlanBenefitId rdf:type rdf:Property ;
    rdfs:label 'Insurance Health Plan Benefit Id' ;
    rdfs:comment 'FK to insurance.benefit.benefit_id' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Benefit .

ind:priorAccumulatorId rdf:type rdf:Property ;
    rdfs:label 'Prior Accumulator Id' ;
    rdfs:comment 'Self-referencing FK on accumulator (prior_accumulator_id)' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Accumulator .

ind:accumulatedAmount rdf:type rdf:Property ;
    rdfs:label 'Accumulated Amount' ;
    rdfs:comment 'The year-to-date dollar amount or count that has been accumulated toward the benefit threshold. Represents member cost-sharing contributions or service utilization.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accumulatorStatus rdf:type rdf:Property ;
    rdfs:label 'Accumulator Status' ;
    rdfs:comment 'Current operational status of the accumulator: active (accumulating), suspended (temporarily paused), closed (benefit period ended), or pending reset (awaiting new benefit year initialization).' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accumulatorType rdf:type rdf:Property ;
    rdfs:label 'Accumulator Type' ;
    rdfs:comment 'The category of benefit accumulation being tracked: individual deductible, family deductible, individual out-of-pocket (OOP) maximum, family OOP maximum, visit limit, or service-specific dollar limit.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Amount' ;
    rdfs:comment 'Total dollar amount of manual adjustments applied to this accumulator due to claim reversals, appeals, or administrative corrections. May be positive or negative.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentCount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Count' ;
    rdfs:comment 'The number of adjustment transactions applied to this accumulator. Used for audit trail and data quality monitoring.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benefitYear rdf:type rdf:Property ;
    rdfs:label 'Benefit Year' ;
    rdfs:comment 'Calendar year for which the accumulator is tracking benefit utilization. Accumulators typically reset annually on the plan renewal date.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:carryoverAmount rdf:type rdf:Property ;
    rdfs:label 'Carryover Amount' ;
    rdfs:comment 'Dollar amount carried over from the previous benefit period, if the plan allows deductible or OOP carryover for services rendered near year-end.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carryoverIndicator rdf:type rdf:Property ;
    rdfs:label 'Carryover Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this accumulator includes carryover amounts from a prior benefit period. True if carryover_amount is greater than zero.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crossAccumulationIndicator rdf:type rdf:Property ;
    rdfs:label 'Cross Accumulation Indicator' ;
    rdfs:comment 'Boolean flag indicating whether amounts in this accumulator also count toward other accumulator types. For example, deductible amounts may also count toward OOP max.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:currencyCode rdf:type rdf:Property ;
    rdfs:label 'Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for all monetary amounts in this accumulator. Typically USD for US-based healthcare plans.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:embeddedDeductibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Embedded Deductible Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this family-level accumulator uses embedded individual deductibles. True means each family member has an individual deductible within the family deductible.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastAdjustmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Adjustment Date' ;
    rdfs:comment 'The date of the most recent adjustment transaction applied to this accumulator. Null if no adjustments have been made.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastClaimDate rdf:type rdf:Property ;
    rdfs:label 'Last Claim Date' ;
    rdfs:comment 'Service date of the most recent claim that updated this accumulator. Used for recency tracking and accumulator aging analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'The date and time when this accumulator record was last modified. Critical for real-time benefit calculation and member portal display.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:networkType rdf:type rdf:Property ;
    rdfs:label 'Network Type' ;
    rdfs:comment 'Indicates whether the accumulator tracks in-network services, out-of-network services, or a combined bucket for both network types.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planYearSequence rdf:type rdf:Property ;
    rdfs:label 'Plan Year Sequence' ;
    rdfs:comment 'Sequential counter indicating which plan year this accumulator represents for the member. Value of 1 for first year, 2 for second year, etc. Used for multi-year trend analysis.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:remainingAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Amount' ;
    rdfs:comment 'The remaining balance before the threshold is met. Calculated as threshold_amount minus accumulated_amount. Critical for member cost-sharing estimates.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resetDate rdf:type rdf:Property ;
    rdfs:label 'Reset Date' ;
    rdfs:comment 'The date when this accumulator was last reset to zero, typically at the start of a new benefit period or upon plan change.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:thresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Threshold Amount' ;
    rdfs:comment 'The plan-defined maximum amount or limit for this accumulator type. Once reached, benefit rules change (e.g., deductible met, OOP max reached).' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdMetDate rdf:type rdf:Property ;
    rdfs:label 'Threshold Met Date' ;
    rdfs:comment 'The date on which the member first met the benefit threshold. Null if threshold has not been met. Used for benefit transition tracking and member communication.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:thresholdMetIndicator rdf:type rdf:Property ;
    rdfs:label 'Threshold Met Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the member has met or exceeded the benefit threshold for this accumulator type. True when accumulated_amount >= threshold_amount.' ;
    rdfs:domain ind:Accumulator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transactionCount rdf:type rdf:Property ;
    rdfs:label 'Transaction Count' ;
    rdfs:comment 'The total number of claim transactions that have contributed to this accumulator balance. Used for utilization pattern analysis.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capitationContractId rdf:type rdf:Property ;
    rdfs:label 'Capitation Contract Id' ;
    rdfs:comment 'Unique identifier for the capitation contract record. Primary key for the capitation contract entity.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitationContract .

ind:renewedCapitationContractId rdf:type rdf:Property ;
    rdfs:label 'Renewed Capitation Contract Id' ;
    rdfs:comment 'Self-referencing FK on capitation_contract (renewed_capitation_contract_id)' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitationContract .

ind:attributedMemberCount rdf:type rdf:Property ;
    rdfs:label 'Attributed Member Count' ;
    rdfs:comment 'The current number of members attributed to this capitation contract for payment calculation purposes.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attributedPopulationDefinition rdf:type rdf:Property ;
    rdfs:label 'Attributed Population Definition' ;
    rdfs:comment 'Textual description of the criteria and methodology used to define which members are attributed to this capitation contract for payment and performance measurement purposes.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoAssignmentEligible rdf:type rdf:Property ;
    rdfs:label 'Auto Assignment Eligible' ;
    rdfs:comment 'Indicates whether members can be automatically assigned or attributed to this capitation contract based on utilization patterns and attribution logic.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benchmarkMethodology rdf:type rdf:Property ;
    rdfs:label 'Benchmark Methodology' ;
    rdfs:comment 'Description of the methodology used to establish the cost and quality benchmarks against which performance is measured for shared savings and risk calculations.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coveredServicesDescription rdf:type rdf:Property ;
    rdfs:label 'Covered Services Description' ;
    rdfs:comment 'Comprehensive textual description of the scope of clinical services and care management activities covered under the capitation payment arrangement.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excludedServicesDescription rdf:type rdf:Property ;
    rdfs:label 'Excluded Services Description' ;
    rdfs:comment 'Textual description of services explicitly excluded from the capitation arrangement and subject to separate fee-for-service or other payment mechanisms.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityContractOwner rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Owner' ;
    rdfs:comment 'Name or identifier of the individual or department within the healthcare organization responsible for managing this capitation contract.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityContractSignedDate rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Signed Date' ;
    rdfs:comment 'The date on which the capitation contract was executed and signed by authorized representatives of both parties.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:geographicServiceArea rdf:type rdf:Property ;
    rdfs:label 'Geographic Service Area' ;
    rdfs:comment 'Description of the geographic region, counties, or zip codes covered by this capitation contract for member attribution and service delivery.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumSharedLossCap rdf:type rdf:Property ;
    rdfs:label 'Maximum Shared Loss Cap' ;
    rdfs:comment 'The maximum dollar amount of shared losses that the healthcare organization is responsible for in a performance period, expressed in USD.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumSharedSavingsCap rdf:type rdf:Property ;
    rdfs:label 'Maximum Shared Savings Cap' ;
    rdfs:comment 'The maximum dollar amount of shared savings that the healthcare organization can earn in a performance period, expressed in USD.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumSavingsRate rdf:type rdf:Property ;
    rdfs:label 'Minimum Savings Rate' ;
    rdfs:comment 'The minimum percentage of cost savings below the benchmark that must be achieved before shared savings payments are triggered, expressed as a percentage.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceYear rdf:type rdf:Property ;
    rdfs:label 'Performance Year' ;
    rdfs:comment 'The calendar year during which performance is measured for quality metrics and financial reconciliation under this capitation contract.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pmpmCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Pmpm Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the PMPM rate. Typically USD for US healthcare organizations.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmpmRate rdf:type rdf:Property ;
    rdfs:label 'Pmpm Rate' ;
    rdfs:comment 'The fixed monthly payment amount per attributed member that the payer pays to the healthcare organization under the capitation arrangement, expressed in USD.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityWithholdAmount rdf:type rdf:Property ;
    rdfs:label 'Quality Withhold Amount' ;
    rdfs:comment 'The total dollar amount withheld from capitation payments for quality performance measurement, expressed in USD.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityWithholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Quality Withhold Percentage' ;
    rdfs:comment 'The percentage of capitation payments withheld by the payer pending achievement of quality performance targets, to be returned upon meeting quality benchmarks.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewalDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Date' ;
    rdfs:comment 'The date on which the contract is eligible for or scheduled for renewal negotiation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskAdjustmentMethodology rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Methodology' ;
    rdfs:comment 'The clinical risk stratification model used to adjust capitation payments based on member acuity and complexity. HCC (Hierarchical Condition Category) is the most common model in Medicare and commercial populations.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskCorridorLowerThreshold rdf:type rdf:Property ;
    rdfs:label 'Risk Corridor Lower Threshold' ;
    rdfs:comment 'The lower percentage threshold defining the risk corridor below which the healthcare organization is protected from losses. Expressed as a percentage of target costs.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskCorridorUpperThreshold rdf:type rdf:Property ;
    rdfs:label 'Risk Corridor Upper Threshold' ;
    rdfs:comment 'The upper percentage threshold defining the risk corridor above which the healthcare organization shares in savings. Expressed as a percentage of target costs.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementFrequency rdf:type rdf:Property ;
    rdfs:label 'Settlement Frequency' ;
    rdfs:comment 'The frequency at which financial reconciliation and settlement of capitation payments, shared savings, and quality withholds occurs between the payer and healthcare organization.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sharedLossPercentage rdf:type rdf:Property ;
    rdfs:label 'Shared Loss Percentage' ;
    rdfs:comment 'The percentage of cost overruns above the target benchmark that the healthcare organization is responsible for under the risk-sharing arrangement.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sharedSavingsPercentage rdf:type rdf:Property ;
    rdfs:label 'Shared Savings Percentage' ;
    rdfs:comment 'The percentage of cost savings below the target benchmark that the healthcare organization retains as shared savings under the value-based care arrangement.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminationNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Termination Notice Days' ;
    rdfs:comment 'The number of days advance notice required by either party to terminate the capitation contract.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vbcModel rdf:type rdf:Property ;
    rdfs:label 'Vbc Model' ;
    rdfs:comment 'The value-based care payment model framework governing financial risk and reward sharing between the healthcare organization and payer.' ;
    rdfs:domain ind:CapitationContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitationPaymentId rdf:type rdf:Property ;
    rdfs:label 'Capitation Payment Id' ;
    rdfs:comment 'Unique identifier for the capitation payment transaction record. Primary key for the capitation payment entity.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bankAccountId rdf:type rdf:Property ;
    rdfs:label 'Bank Account Id' ;
    rdfs:comment 'FK to finance.bank_account.bank_account_id' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankAccount .

ind:financeArTransactionId rdf:type rdf:Property ;
    rdfs:label 'Finance Ar Transaction Id' ;
    rdfs:comment 'The unique transaction identifier from the payment processing system or bank for the electronic funds transfer or check deposit.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceArTransaction .

ind:adjustmentReason rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason' ;
    rdfs:comment 'Detailed explanation for any adjustment amount applied to the capitation payment, including retroactive attribution changes or contract modifications.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenter rdf:type rdf:Property ;
    rdfs:label 'Cost Center' ;
    rdfs:comment 'The organizational cost center or department to which the capitation payment revenue is allocated for internal financial management.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysToPayment rdf:type rdf:Property ;
    rdfs:label 'Days To Payment' ;
    rdfs:comment 'The number of days between the payment due date and the actual payment received date, used to track payer payment timeliness performance.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:facilityContractYear rdf:type rdf:Property ;
    rdfs:label 'Facility Contract Year' ;
    rdfs:comment 'The contract year of the capitation agreement to which this payment applies, used for multi-year contract tracking and performance measurement.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:generalLedgerAccount rdf:type rdf:Property ;
    rdfs:label 'General Ledger Account' ;
    rdfs:comment 'The general ledger account code to which the capitation payment revenue is posted for financial reporting and accounting purposes.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossCapitationAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Capitation Amount' ;
    rdfs:comment 'The total gross capitation payment amount calculated as attributed member count multiplied by PMPM rate, before any adjustments or withholds.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payment Amount' ;
    rdfs:comment 'The final net capitation payment amount received after all adjustments, risk factors, and quality withholds have been applied.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Payment Due Date' ;
    rdfs:comment 'The contractually agreed date by which the payer is required to remit the capitation payment to the provider organization.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentMethod rdf:type rdf:Property ;
    rdfs:label 'Payment Method' ;
    rdfs:comment 'The payment instrument or mechanism used by the payer to remit the capitation payment.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPeriodMonth rdf:type rdf:Property ;
    rdfs:label 'Payment Period Month' ;
    rdfs:comment 'The month (1-12) for which this capitation payment applies, representing the coverage period for attributed members.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentPeriodYear rdf:type rdf:Property ;
    rdfs:label 'Payment Period Year' ;
    rdfs:comment 'The calendar year for which this capitation payment applies, representing the coverage period for attributed members.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Payment Received Date' ;
    rdfs:comment 'The date on which the capitation payment was actually received by the provider organization, used for cash flow tracking and revenue recognition.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Reference Number' ;
    rdfs:comment 'External payment reference number or remittance identifier provided by the payer for reconciliation and tracking purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Status' ;
    rdfs:comment 'Current lifecycle status of the capitation payment transaction indicating processing state and reconciliation progress.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Date' ;
    rdfs:comment 'The date on which the capitation payment was successfully reconciled against expected amounts and attributed member rosters.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Status' ;
    rdfs:comment 'Current status of the reconciliation process comparing the received capitation payment against expected amounts based on attributed member counts and contract terms.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceAdviceDate rdf:type rdf:Property ;
    rdfs:label 'Remittance Advice Date' ;
    rdfs:comment 'The date on which the remittance advice document was received from the payer, used for payment reconciliation and audit trail purposes.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remittanceAdviceReceived rdf:type rdf:Property ;
    rdfs:label 'Remittance Advice Received' ;
    rdfs:comment 'Indicates whether a formal remittance advice document (835 ERA or paper EOB) was received from the payer with the capitation payment.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revenueRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Date' ;
    rdfs:comment 'The accounting date on which the capitation payment revenue is recognized in the general ledger according to GAAP revenue recognition principles.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revenueRecognitionPeriod rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Period' ;
    rdfs:comment 'The accounting period (month and year) in which the capitation payment revenue is recognized for financial reporting purposes.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAdjustedAmount rdf:type rdf:Property ;
    rdfs:label 'Risk Adjusted Amount' ;
    rdfs:comment 'The capitation payment amount after applying the risk adjustment factor to account for population health complexity.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Factor' ;
    rdfs:comment 'The risk adjustment multiplier applied to the capitation payment based on the attributed populations health acuity and complexity. Values typically range from 0.5 to 3.0.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceAmount rdf:type rdf:Property ;
    rdfs:label 'Variance Amount' ;
    rdfs:comment 'The dollar difference between the expected capitation payment and the actual payment received, used to identify discrepancies requiring investigation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceReason rdf:type rdf:Property ;
    rdfs:label 'Variance Reason' ;
    rdfs:comment 'Explanation for any variance between expected and actual capitation payment amounts, including attribution differences or rate discrepancies.' ;
    rdfs:domain ind:CapitationPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Id' ;
    rdfs:comment 'Unique identifier for the risk adjustment submission record.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctedRiskAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Corrected Risk Adjustment Id' ;
    rdfs:comment 'Self-referencing FK on risk_adjustment (corrected_risk_adjustment_id)' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiskAdjustment .

ind:diagnosisId rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Id' ;
    rdfs:comment 'Foreign key linking to clinical.clinical_diagnosis. Business justification: Risk adjustment submissions must reference source clinical diagnoses for RADV audits and medical record validation. CMS requires linking HCC codes back to documented diagnoses. Essential for Medicare ' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Diagnosis .

ind:acceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Acceptance Date' ;
    rdfs:comment 'The date on which CMS or the payer accepted this risk adjustment submission as valid and included it in payment calculations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:chartReviewDate rdf:type rdf:Property ;
    rdfs:label 'Chart Review Date' ;
    rdfs:comment 'The date on which the medical chart supporting this diagnosis was reviewed for risk adjustment coding accuracy and completeness.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataCollectionPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Data Collection Period End' ;
    rdfs:comment 'The end date of the period during which diagnosis data was collected for this risk adjustment submission, typically December 31 of the service year.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataCollectionPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Data Collection Period Start' ;
    rdfs:comment 'The start date of the period during which diagnosis data was collected for this risk adjustment submission, typically January 1 of the service year.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deletedFlag rdf:type rdf:Property ;
    rdfs:label 'Deleted Flag' ;
    rdfs:comment 'Boolean flag indicating whether this risk adjustment submission has been deleted or voided, typically due to coding errors or medical record review findings.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deletionDate rdf:type rdf:Property ;
    rdfs:label 'Deletion Date' ;
    rdfs:comment 'The date on which this risk adjustment submission was deleted or voided from the payment calculation.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deletionReason rdf:type rdf:Property ;
    rdfs:label 'Deletion Reason' ;
    rdfs:comment 'The explanation for why this risk adjustment submission was deleted, such as coding error, insufficient documentation, or duplicate submission.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demographicScore rdf:type rdf:Property ;
    rdfs:label 'Demographic Score' ;
    rdfs:comment 'The portion of the total risk score attributable to demographic factors such as age, gender, Medicaid eligibility, and disability status.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diagnosisPresentOnAdmission rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Present On Admission' ;
    rdfs:comment 'Boolean flag indicating whether the diagnosis was present at the time of inpatient admission, required for certain risk adjustment and quality reporting programs.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diagnosisType rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Type' ;
    rdfs:comment 'The classification of the diagnosis within the encounter documentation, indicating whether it was the principal reason for the encounter or a secondary condition.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diseaseScore rdf:type rdf:Property ;
    rdfs:label 'Disease Score' ;
    rdfs:comment 'The portion of the total risk score attributable to the submitted HCC categories representing chronic and acute conditions.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hccCode rdf:type rdf:Property ;
    rdfs:label 'Hcc Code' ;
    rdfs:comment 'The HCC category code to which the submitted diagnosis maps, representing a clinically and financially homogeneous group of conditions used in risk score calculation.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccDescription rdf:type rdf:Property ;
    rdfs:label 'Hcc Description' ;
    rdfs:comment 'The descriptive label for the HCC category, providing clinical context for the condition group (e.g., Diabetes with Chronic Complications, Congestive Heart Failure).' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionScore rdf:type rdf:Property ;
    rdfs:label 'Interaction Score' ;
    rdfs:comment 'The portion of the total risk score attributable to disease interaction factors, where the presence of multiple conditions results in higher expected costs than the sum of individual conditions.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicalRecordReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Medical Record Review Status' ;
    rdfs:comment 'The status of medical record documentation review supporting this diagnosis submission, critical for RADV audit compliance and internal quality assurance.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:model rdf:type rdf:Property ;
    rdfs:label 'Model' ;
    rdfs:comment 'The specific risk adjustment methodology applied to calculate the risk score. CMS-HCC (Hierarchical Condition Category) for Medicare Advantage, RxHCC for Part D, HHS-HCC for ACA marketplace plans, ESRD for end-stage renal disease, PACE for Program of All-Inclusive Care for the Elderly, CDPS for Chronic Illness and Disability Payment System. [ENUM-REF-CANDIDATE: CMS-HCC|RxHCC|HHS-HCC|ESRD|PACE|CDPS|Other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelVersion rdf:type rdf:Property ;
    rdfs:label 'Model Version' ;
    rdfs:comment 'The version year or release identifier of the risk adjustment model used for this submission (e.g., V24, V28 for CMS-HCC models).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Amount' ;
    rdfs:comment 'The dollar amount of risk adjustment payment associated with this submission, calculated by multiplying the risk score by the base payment rate for the plan and geographic area.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Impact Amount' ;
    rdfs:comment 'The incremental payment impact of this specific HCC submission compared to baseline, representing the marginal revenue contribution of capturing this diagnosis.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentYear rdf:type rdf:Property ;
    rdfs:label 'Payment Year' ;
    rdfs:comment 'The calendar year for which the risk adjustment payment applies, typically the year following the data collection year.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planBenefitPackage rdf:type rdf:Property ;
    rdfs:label 'Plan Benefit Package' ;
    rdfs:comment 'The specific benefit package identifier within the contract that applies to this member and risk adjustment submission.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:radvAuditDate rdf:type rdf:Property ;
    rdfs:label 'Radv Audit Date' ;
    rdfs:comment 'The date on which this submission was selected for or completed a RADV audit by CMS.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:radvAuditStatus rdf:type rdf:Property ;
    rdfs:label 'Radv Audit Status' ;
    rdfs:comment 'The status of this submission in the CMS Risk Adjustment Data Validation audit process, which validates the accuracy of submitted diagnosis codes through medical record review.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recaptureFlag rdf:type rdf:Property ;
    rdfs:label 'Recapture Flag' ;
    rdfs:comment 'Boolean flag indicating whether this diagnosis represents a recapture of a chronic condition that was documented in a prior year but not yet documented in the current payment year.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rejectionDate rdf:type rdf:Property ;
    rdfs:label 'Rejection Date' ;
    rdfs:comment 'The date on which CMS or the payer rejected this risk adjustment submission due to validation errors or policy violations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rejectionReason rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason' ;
    rdfs:comment 'The detailed explanation provided by CMS or the payer for why this risk adjustment submission was rejected, including error codes and corrective action guidance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScore rdf:type rdf:Property ;
    rdfs:label 'Risk Score' ;
    rdfs:comment 'The calculated risk score (also known as RAF - Risk Adjustment Factor) for the member based on demographic factors and submitted HCC categories. A score of 1.0 represents average risk; higher scores indicate higher expected costs.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDate rdf:type rdf:Property ;
    rdfs:label 'Submission Date' ;
    rdfs:comment 'The date on which this risk adjustment submission was transmitted to CMS EDGE server or payer risk adjustment system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionNumber rdf:type rdf:Property ;
    rdfs:label 'Submission Number' ;
    rdfs:comment 'Externally-known unique business identifier for this risk adjustment submission, used for tracking and reconciliation with CMS or payer systems.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionStatus rdf:type rdf:Property ;
    rdfs:label 'Submission Status' ;
    rdfs:comment 'The current processing status of the risk adjustment submission in the workflow from creation through final reconciliation with CMS or payer systems.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Submission Timestamp' ;
    rdfs:comment 'The precise date and time when this risk adjustment submission was transmitted, used for audit trail and reconciliation purposes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:submissionType rdf:type rdf:Property ;
    rdfs:label 'Submission Type' ;
    rdfs:comment 'The type of risk adjustment submission. Initial for first-time submission, Supplemental for additional diagnoses, Deletion for removing previously submitted diagnoses, Correction for fixing errors, RAPS for Risk Adjustment Processing System (legacy), EDPS for Encounter Data Processing System (current).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspectFlag rdf:type rdf:Property ;
    rdfs:label 'Suspect Flag' ;
    rdfs:comment 'Boolean flag indicating whether this diagnosis has been identified as a suspect condition that should be documented and submitted for risk adjustment but has not yet been confirmed in the current year.' ;
    rdfs:domain ind:RiskAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coordinationOfBenefitsId rdf:type rdf:Property ;
    rdfs:label 'Coordination Of Benefits Id' ;
    rdfs:comment 'Unique identifier for the coordination of benefits record. Primary key.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coordinationMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Coordination Mpi Record Id' ;
    rdfs:comment 'Unique identifier for the member with multiple insurance coverages. Links to the patient/member master record.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:primaryCoordinationHealthPlanId rdf:type rdf:Property ;
    rdfs:label 'Primary Coordination Health Plan Id' ;
    rdfs:comment 'Unique identifier for the health plan designated as primary coverage.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HealthPlan .

ind:primaryMpiRecordId rdf:type rdf:Property ;
    rdfs:label 'Primary Mpi Record Id' ;
    rdfs:comment 'Foreign key linking to patient.mpi_record. Business justification: COB determination for claims adjudication with multiple payers requires patient identity linkage. Business process: primary/secondary payer sequencing depends on patient-specific coverage relationship' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MpiRecord .

ind:supersededCoordinationOfBenefitsId rdf:type rdf:Property ;
    rdfs:label 'Superseded Coordination Of Benefits Id' ;
    rdfs:comment 'Self-referencing FK on coordination_of_benefits (superseded_coordination_of_benefits_id)' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoordinationOfBenefits .

ind:tertiaryPayerId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Payer Id' ;
    rdfs:comment 'Unique identifier for the insurance payer designated as tertiary in the coordination of benefits hierarchy, if applicable.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:tertiaryPlanHealthPlanId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Plan Health Plan Id' ;
    rdfs:comment 'Unique identifier for the health plan designated as tertiary coverage, if applicable.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HealthPlan .

ind:autoCobUpdateEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Cob Update Enabled' ;
    rdfs:comment 'Boolean flag indicating whether automatic updates to COB information are enabled through eligibility feeds or third-party vendors. True when automated updates are active.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobAgreementType rdf:type rdf:Property ;
    rdfs:label 'Cob Agreement Type' ;
    rdfs:comment 'The type of coordination agreement between payers. Standard COB allows combined benefits up to 100% of charges; non-duplication pays only what primary did not cover; carve-out excludes certain services; maintenance of benefits pays as if primary regardless of other coverage.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobDeterminationMethod rdf:type rdf:Property ;
    rdfs:label 'Cob Determination Method' ;
    rdfs:comment 'The method or rule used to determine the order of benefit responsibility among multiple coverages. Common methods include birthday rule (parent with earlier birthday is primary for dependent children), gender rule (deprecated method using father as primary), NAIC COB rules, court order, separation agreement, or active/inactive employment status.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Cob Effective Date' ;
    rdfs:comment 'The date when the coordination of benefits arrangement becomes effective and the payer order applies for claim adjudication.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobNotes rdf:type rdf:Property ;
    rdfs:label 'Cob Notes' ;
    rdfs:comment 'Free-text notes documenting special circumstances, exceptions, or additional context regarding the coordination of benefits arrangement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobPrioritySequence rdf:type rdf:Property ;
    rdfs:label 'Cob Priority Sequence' ;
    rdfs:comment 'Numeric sequence indicating the order of benefit responsibility. 1 = primary, 2 = secondary, 3 = tertiary. Used for claim adjudication sequencing.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cobQuestionnaireResponseDate rdf:type rdf:Property ;
    rdfs:label 'Cob Questionnaire Response Date' ;
    rdfs:comment 'The date when the member returned the completed COB questionnaire with updated coverage information.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobQuestionnaireSentDate rdf:type rdf:Property ;
    rdfs:label 'Cob Questionnaire Sent Date' ;
    rdfs:comment 'The date when a COB questionnaire was sent to the member to verify or update other insurance coverage information.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobStatus rdf:type rdf:Property ;
    rdfs:label 'Cob Status' ;
    rdfs:comment 'Current lifecycle status of the coordination of benefits arrangement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Cob Termination Date' ;
    rdfs:comment 'The date when the coordination of benefits arrangement ends, typically due to loss of one coverage or change in member circumstances.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Cob Verification Date' ;
    rdfs:comment 'The date when the coordination of benefits information was last verified with the member or through external sources.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cobVerificationSource rdf:type rdf:Property ;
    rdfs:label 'Cob Verification Source' ;
    rdfs:comment 'The source or method used to verify the coordination of benefits information, such as member attestation, employer report, eligibility file feed, claims data analysis, third-party COB vendor, or manual research.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtOrderDate rdf:type rdf:Property ;
    rdfs:label 'Court Order Date' ;
    rdfs:comment 'The date of the court order that specifies the coordination of benefits arrangement, if applicable.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:courtOrderIndicator rdf:type rdf:Property ;
    rdfs:label 'Court Order Indicator' ;
    rdfs:comment 'Boolean flag indicating whether a court order specifies the coordination of benefits order, overriding standard COB rules. True when court order exists.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crossoverClaimIndicator rdf:type rdf:Property ;
    rdfs:label 'Crossover Claim Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this COB arrangement involves automatic crossover claims between Medicare and Medicaid or other secondary payers. True indicates crossover claims are processed automatically.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:custodyArrangement rdf:type rdf:Property ;
    rdfs:label 'Custody Arrangement' ;
    rdfs:comment 'The custody arrangement for dependent children when parents are separated or divorced, which may override standard birthday rule COB determination per court order or separation agreement.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependentRelationshipCode rdf:type rdf:Property ;
    rdfs:label 'Dependent Relationship Code' ;
    rdfs:comment 'The relationship of the member to the subscriber, used in determining COB order under birthday rule or other dependent coverage rules.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCobInquiryDate rdf:type rdf:Property ;
    rdfs:label 'Last Cob Inquiry Date' ;
    rdfs:comment 'The date when the most recent COB inquiry or verification was performed with external sources or the member.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicarePrimaryIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicare Primary Indicator' ;
    rdfs:comment 'Boolean flag indicating whether Medicare is the primary payer in this coordination of benefits arrangement. True when Medicare pays first.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mspType rdf:type rdf:Property ;
    rdfs:label 'Msp Type' ;
    rdfs:comment 'The type of Medicare Secondary Payer situation, if applicable. Identifies the reason Medicare is secondary: working aged (group health plan coverage), ESRD (end-stage renal disease coordination period), disability (large group health plan), no-fault insurance, workers compensation, or liability insurance. [ENUM-REF-CANDIDATE: working_aged|esrd|disability|no_fault|workers_comp|liability|not_applicable — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextCobVerificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Cob Verification Due Date' ;
    rdfs:comment 'The date when the next periodic COB verification is scheduled to ensure accuracy of payer order information.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:otherSubscriberBirthDate rdf:type rdf:Property ;
    rdfs:label 'Other Subscriber Birth Date' ;
    rdfs:comment 'Date of birth of the other parent or subscriber on the secondary coverage, used in birthday rule calculations for dependent COB determination.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primaryCoverageType rdf:type rdf:Property ;
    rdfs:label 'Primary Coverage Type' ;
    rdfs:comment 'The type of insurance coverage designated as primary in the COB hierarchy. [ENUM-REF-CANDIDATE: group|individual|medicare|medicaid|tricare|va|workers_comp|auto_insurance|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryCoverageType rdf:type rdf:Property ;
    rdfs:label 'Secondary Coverage Type' ;
    rdfs:comment 'The type of insurance coverage designated as secondary in the COB hierarchy. [ENUM-REF-CANDIDATE: group|individual|medicare|medicaid|tricare|va|workers_comp|auto_insurance|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriberBirthDate rdf:type rdf:Property ;
    rdfs:label 'Subscriber Birth Date' ;
    rdfs:comment 'Date of birth of the primary subscriber, used in birthday rule calculations for dependent COB determination.' ;
    rdfs:domain ind:CoordinationOfBenefits ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:networkAdequacyId rdf:type rdf:Property ;
    rdfs:label 'Network Adequacy Id' ;
    rdfs:comment 'Unique identifier for the network adequacy assessment record. Primary key for this transactional record of regulatory compliance assessment.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorNetworkAdequacyId rdf:type rdf:Property ;
    rdfs:label 'Prior Network Adequacy Id' ;
    rdfs:comment 'Self-referencing FK on network_adequacy (prior_network_adequacy_id)' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NetworkAdequacy .

ind:actualAverageAppointmentWaitTimeDays rdf:type rdf:Property ;
    rdfs:label 'Actual Average Appointment Wait Time Days' ;
    rdfs:comment 'Measured average number of days members wait for an appointment with providers in this specialty.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualAverageDistanceMiles rdf:type rdf:Property ;
    rdfs:label 'Actual Average Distance Miles' ;
    rdfs:comment 'Measured average distance in miles that members must travel to reach the nearest contracted provider in this specialty.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualAverageTravelTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Actual Average Travel Time Minutes' ;
    rdfs:comment 'Measured average travel time in minutes that members must travel to reach the nearest contracted provider in this specialty.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualProviderToMemberRatio rdf:type rdf:Property ;
    rdfs:label 'Actual Provider To Member Ratio' ;
    rdfs:comment 'Measured ratio of contracted providers to enrolled members for this specialty and service area at the time of assessment.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adequacyDetermination rdf:type rdf:Property ;
    rdfs:label 'Adequacy Determination' ;
    rdfs:comment 'Final determination of whether the provider network meets regulatory adequacy standards for this specialty and service area.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Date' ;
    rdfs:comment 'Date and time when the network adequacy assessment was performed or completed. Principal business event timestamp for this transaction.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentMethodology rdf:type rdf:Property ;
    rdfs:label 'Assessment Methodology' ;
    rdfs:comment 'Description of the methodology used to conduct the network adequacy assessment, including data sources, calculation methods, and geographic analysis techniques.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentNumber rdf:type rdf:Property ;
    rdfs:label 'Assessment Number' ;
    rdfs:comment 'Business identifier for this network adequacy assessment, used for tracking and regulatory filing reference.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Period End Date' ;
    rdfs:comment 'Ending date of the time period covered by this network adequacy assessment.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Period Start Date' ;
    rdfs:comment 'Beginning date of the time period covered by this network adequacy assessment.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assessment Status' ;
    rdfs:comment 'Current lifecycle status of the network adequacy assessment in the regulatory review and approval workflow. [ENUM-REF-CANDIDATE: draft|in_progress|completed|submitted|approved|deficient|remediation_required — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessorName rdf:type rdf:Property ;
    rdfs:label 'Assessor Name' ;
    rdfs:comment 'Name of the individual or team responsible for conducting the network adequacy assessment.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countyCode rdf:type rdf:Property ;
    rdfs:label 'County Code' ;
    rdfs:comment 'County FIPS code or county name for the geographic area being assessed. Used for county-level adequacy standards.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyDescription rdf:type rdf:Property ;
    rdfs:label 'Deficiency Description' ;
    rdfs:comment 'Detailed description of any network adequacy deficiencies identified during the assessment, including specific gaps and affected populations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:essentialCommunityProviderFlag rdf:type rdf:Property ;
    rdfs:label 'Essential Community Provider Flag' ;
    rdfs:comment 'Indicates whether this assessment includes evaluation of Essential Community Provider participation, required for marketplace plans to serve vulnerable populations.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maximumAppointmentWaitTimeDays rdf:type rdf:Property ;
    rdfs:label 'Maximum Appointment Wait Time Days' ;
    rdfs:comment 'Regulatory standard for maximum number of days members must wait for an appointment with this specialty.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumDistanceMiles rdf:type rdf:Property ;
    rdfs:label 'Maximum Distance Miles' ;
    rdfs:comment 'Regulatory standard for maximum distance in miles that members must travel to access this specialty.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumTimeDistanceStandard rdf:type rdf:Property ;
    rdfs:label 'Maximum Time Distance Standard' ;
    rdfs:comment 'Regulatory standard for maximum travel time or distance members must travel to access this specialty (e.g., 30 minutes or 30 miles for primary care).' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumTravelTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Maximum Travel Time Minutes' ;
    rdfs:comment 'Regulatory standard for maximum travel time in minutes that members must travel to access this specialty.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberCount rdf:type rdf:Property ;
    rdfs:label 'Member Count' ;
    rdfs:comment 'Total number of enrolled members in the health plan within the assessed geographic service area.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:percentageMembersWithinStandard rdf:type rdf:Property ;
    rdfs:label 'Percentage Members Within Standard' ;
    rdfs:comment 'Percentage of enrolled members who have access to a contracted provider within the time-and-distance standard for this specialty.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:providerCount rdf:type rdf:Property ;
    rdfs:label 'Provider Count' ;
    rdfs:comment 'Total number of contracted providers in this specialty category within the assessed geographic service area.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Date' ;
    rdfs:comment 'Date when the regulatory authority approved the network adequacy assessment and certified compliance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryBody rdf:type rdf:Property ;
    rdfs:label 'Regulatory Body' ;
    rdfs:comment 'Regulatory authority to which this network adequacy assessment is submitted (CMS for Medicare Advantage, state Department of Insurance for commercial plans, exchange for marketplace plans).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatorySubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Submission Date' ;
    rdfs:comment 'Date when the network adequacy assessment was submitted to the regulatory authority for review and approval.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remediationDueDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Due Date' ;
    rdfs:comment 'Target date by which network adequacy deficiencies must be corrected to meet regulatory requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remediationPlan rdf:type rdf:Property ;
    rdfs:label 'Remediation Plan' ;
    rdfs:comment 'Corrective action plan to address identified network adequacy deficiencies, including recruitment targets and timelines.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredProviderToMemberRatio rdf:type rdf:Property ;
    rdfs:label 'Required Provider To Member Ratio' ;
    rdfs:comment 'Regulatory standard for the minimum ratio of providers to enrolled members for this specialty and service area (e.g., 1 PCP per 2000 members).' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewerName rdf:type rdf:Property ;
    rdfs:label 'Reviewer Name' ;
    rdfs:comment 'Name of the individual or team responsible for reviewing and approving the network adequacy assessment before regulatory submission.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialtyCategory rdf:type rdf:Property ;
    rdfs:label 'Specialty Category' ;
    rdfs:comment 'Provider specialty or service category being assessed for adequacy (e.g., primary care, cardiology, behavioral health, pediatrics). May reference specialty taxonomy codes.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telehealthIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Telehealth Included Flag' ;
    rdfs:comment 'Indicates whether telehealth providers were included in the adequacy assessment calculations. True if telehealth access was counted toward meeting adequacy standards.' ;
    rdfs:domain ind:NetworkAdequacy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceFormularyTierId rdf:type rdf:Property ;
    rdfs:label 'Insurance Formulary Tier Id' ;
    rdfs:comment 'Unique identifier for the formulary tier record. Primary key for the formulary tier entity.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:formularyId rdf:type rdf:Property ;
    rdfs:label 'Formulary Id' ;
    rdfs:comment 'Reference to the parent formulary that contains this tier structure. Links to the pharmacy formulary master data.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Formulary .

ind:ndcDrugId rdf:type rdf:Property ;
    rdfs:label 'Ndc Drug Id' ;
    rdfs:comment 'Foreign key linking to reference.ndc_drug. Business justification: Formulary tiers assign specific NDC drugs to cost-sharing levels (tier 1-4). Essential for pharmacy benefit administration, member cost calculation, and formulary management in payer pharmacy operatio' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NdcDrug .

ind:supersededByFormularyTierInsuranceFormularyTierId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Formulary Tier Insurance Formulary Tier Id' ;
    rdfs:comment 'Reference to the formulary tier record that replaces this tier structure. Used for tracking tier evolution and managing transitions during formulary updates. Null if this is the current active tier.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InsuranceFormularyTier .

ind:cmsTierCategory rdf:type rdf:Property ;
    rdfs:label 'Cms Tier Category' ;
    rdfs:comment 'CMS-defined tier category classification for Medicare Part D reporting and compliance. Maps internal tier structure to CMS standard tier definitions for regulatory submissions.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysSupplyMailOrder rdf:type rdf:Property ;
    rdfs:label 'Days Supply Mail Order' ;
    rdfs:comment 'Standard number of days supply allowed per prescription fill for medications in this tier through mail order pharmacies. Typically 90 days to encourage mail order utilization.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysSupplyStandard rdf:type rdf:Property ;
    rdfs:label 'Days Supply Standard' ;
    rdfs:comment 'Standard number of days supply allowed per prescription fill for medications in this tier at retail pharmacies. Common values are 30, 60, or 90 days.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deductibleApplies rdf:type rdf:Property ;
    rdfs:label 'Deductible Applies' ;
    rdfs:comment 'Indicates whether the plan deductible must be met before cost-sharing for this tier takes effect. True if deductible applies; False if tier cost-sharing is immediate.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mailOrderEligible rdf:type rdf:Property ;
    rdfs:label 'Mail Order Eligible' ;
    rdfs:comment 'Indicates whether medications in this tier are eligible for mail order pharmacy fulfillment, typically with extended days supply and potentially different cost-sharing. True if mail order is available; False otherwise.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberCoinsurancePercentage rdf:type rdf:Property ;
    rdfs:label 'Member Coinsurance Percentage' ;
    rdfs:comment 'Percentage of the drug cost the member pays for medications in this tier. Represents percentage-based cost-sharing structure. Null if flat copay applies instead.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberCommunicationText rdf:type rdf:Property ;
    rdfs:label 'Member Communication Text' ;
    rdfs:comment 'Standardized text used in member-facing communications to explain this tier, including Summary of Benefits and Coverage (SBC) documents, formulary guides, and member portals.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberCopayAmount rdf:type rdf:Property ;
    rdfs:label 'Member Copay Amount' ;
    rdfs:comment 'Fixed dollar amount the member pays per prescription fill for medications in this tier. Represents flat copayment cost-sharing structure. Null if coinsurance applies instead.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outOfPocketApplies rdf:type rdf:Property ;
    rdfs:label 'Out Of Pocket Applies' ;
    rdfs:comment 'Indicates whether member cost-sharing for this tier counts toward the annual out-of-pocket maximum. True if costs accumulate toward OOP max; False otherwise.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferredTierFlag rdf:type rdf:Property ;
    rdfs:label 'Preferred Tier Flag' ;
    rdfs:comment 'Indicates whether this tier represents a preferred cost-sharing level, typically associated with lower member costs and plan-preferred medications. True for preferred tiers; False otherwise.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preventiveTierFlag rdf:type rdf:Property ;
    rdfs:label 'Preventive Tier Flag' ;
    rdfs:comment 'Indicates whether this tier is designated for preventive medications covered at zero or minimal cost-sharing under Affordable Care Act (ACA) preventive care requirements. True for preventive tiers; False otherwise.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:providerCommunicationText rdf:type rdf:Property ;
    rdfs:label 'Provider Communication Text' ;
    rdfs:comment 'Standardized text used in provider-facing communications to explain this tier structure, cost-sharing rules, and utilization management requirements for prescribing decisions.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityLimitApplies rdf:type rdf:Property ;
    rdfs:label 'Quantity Limit Applies' ;
    rdfs:comment 'Indicates whether medications in this tier are subject to quantity limits per fill or per time period. True if quantity limits apply; False otherwise. Specific limits are defined at the drug level.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retailNetworkEligible rdf:type rdf:Property ;
    rdfs:label 'Retail Network Eligible' ;
    rdfs:comment 'Indicates whether medications in this tier can be filled at retail network pharmacies. True if retail network access is available; False if restricted to specialty or mail order only.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialtyTierFlag rdf:type rdf:Property ;
    rdfs:label 'Specialty Tier Flag' ;
    rdfs:comment 'Indicates whether this tier is designated for specialty medications, which typically have higher costs and may require special handling, distribution, or clinical management. True for specialty tiers; False otherwise.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tierCode rdf:type rdf:Property ;
    rdfs:label 'Tier Code' ;
    rdfs:comment 'Standardized code representing the formulary tier, used for system integration and claims processing. May align with NCPDP or internal coding standards.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierDescription rdf:type rdf:Property ;
    rdfs:label 'Tier Description' ;
    rdfs:comment 'Clean boilerplate phrase from description' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierDisplayOrder rdf:type rdf:Property ;
    rdfs:label 'Tier Display Order' ;
    rdfs:comment 'Numeric value controlling the display sequence of tiers in member-facing materials, formulary documents, and system interfaces. Lower values appear first.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tierName rdf:type rdf:Property ;
    rdfs:label 'Tier Name' ;
    rdfs:comment 'Display name for this formulary tier level used in member-facing communications and plan documents.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierNumber rdf:type rdf:Property ;
    rdfs:label 'Tier Number' ;
    rdfs:comment 'Numeric sequence of the tier within the formulary structure, typically ranging from 1 (lowest cost-sharing) to 5 or 6 (highest cost-sharing). Used for ordering and display purposes.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tierStatus rdf:type rdf:Property ;
    rdfs:label 'Tier Status' ;
    rdfs:comment 'Current lifecycle status of the formulary tier. Active tiers are in use for member cost-sharing; Inactive or Retired tiers are no longer applicable; Pending tiers are awaiting regulatory approval.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierVersion rdf:type rdf:Property ;
    rdfs:label 'Tier Version' ;
    rdfs:comment 'Version identifier for this tier structure configuration, used to track changes over time and manage mid-year formulary updates. Follows internal versioning conventions.' ;
    rdfs:domain ind:InsuranceFormularyTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumBillingId rdf:type rdf:Property ;
    rdfs:label 'Premium Billing Id' ;
    rdfs:comment 'Unique identifier for the premium billing invoice record. Primary key for the premium billing transaction.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adjustedPremiumBillingId rdf:type rdf:Property ;
    rdfs:label 'Adjusted Premium Billing Id' ;
    rdfs:comment 'Self-referencing FK on premium_billing (adjusted_premium_billing_id)' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumBilling .

ind:employerGroupId rdf:type rdf:Property ;
    rdfs:label 'Employer Group Id' ;
    rdfs:comment 'Reference to the employer group being billed for group health plan coverage. Null for individual or COBRA billing.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmployerGroup .

ind:administrativeFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Administrative Fee Amount' ;
    rdfs:comment 'Additional administrative fee charged for premium processing, billing, or plan administration services. Expressed in USD.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Billing Address Line1' ;
    rdfs:comment 'First line of the mailing address to which premium billing invoices and statements are sent.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Billing Address Line2' ;
    rdfs:comment 'Second line of the billing mailing address for suite, apartment, or additional address details.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCity rdf:type rdf:Property ;
    rdfs:label 'Billing City' ;
    rdfs:comment 'City component of the billing mailing address.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactEmail rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Email' ;
    rdfs:comment 'Email address of the billing contact for electronic invoice delivery and payment correspondence.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactName rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Name' ;
    rdfs:comment 'Name of the individual or organization contact responsible for premium payment and billing inquiries.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingContactPhone rdf:type rdf:Property ;
    rdfs:label 'Billing Contact Phone' ;
    rdfs:comment 'Phone number of the billing contact for premium payment inquiries and collection activities.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCountryCode rdf:type rdf:Property ;
    rdfs:label 'Billing Country Code' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code for the billing address (e.g., USA, CAN, MEX).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingDueDate rdf:type rdf:Property ;
    rdfs:label 'Billing Due Date' ;
    rdfs:comment 'Date by which premium payment must be received to maintain active coverage and avoid grace period or lapse.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingFrequency rdf:type rdf:Property ;
    rdfs:label 'Billing Frequency' ;
    rdfs:comment 'Frequency at which premium is billed to the responsible party: monthly, quarterly, semi-annually, or annually.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period End Date' ;
    rdfs:comment 'Last date of the coverage period for which premium is being billed.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period Start Date' ;
    rdfs:comment 'First date of the coverage period for which premium is being billed.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPostalCode rdf:type rdf:Property ;
    rdfs:label 'Billing Postal Code' ;
    rdfs:comment 'Postal code or ZIP code component of the billing mailing address.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingState rdf:type rdf:Property ;
    rdfs:label 'Billing State' ;
    rdfs:comment 'State or province component of the billing mailing address. Two-letter state code for US addresses.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingStatus rdf:type rdf:Property ;
    rdfs:label 'Billing Status' ;
    rdfs:comment 'Current status of the premium billing invoice in its payment lifecycle: billed (invoice issued, payment pending), paid (fully paid), partially paid (partial payment received), delinquent (past due), lapsed (coverage terminated due to non-payment), cancelled (invoice voided), or refunded (payment returned). [ENUM-REF-CANDIDATE: billed|paid|partially_paid|delinquent|lapsed|cancelled|refunded — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingType rdf:type rdf:Property ;
    rdfs:label 'Billing Type' ;
    rdfs:comment 'Classification of the premium billing arrangement indicating whether this is employer group, individual subscriber, COBRA continuation, Medicare Advantage, or Medicaid managed care billing.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cobraPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Cobra Premium Amount' ;
    rdfs:comment 'Premium amount charged to COBRA participants, typically 102% of the group rate to cover administrative costs. Null for non-COBRA billing. Expressed in USD.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:delinquencyDate rdf:type rdf:Property ;
    rdfs:label 'Delinquency Date' ;
    rdfs:comment 'Date on which this premium billing became delinquent due to non-payment past the due date. Null if payment is current or received.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employeeContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Employee Contribution Amount' ;
    rdfs:comment 'Portion of the total premium paid by the employee or subscriber through payroll deduction or direct payment. Expressed in USD.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Employer Contribution Amount' ;
    rdfs:comment 'Portion of the total premium paid by the employer group on behalf of enrolled members. Zero for individual and COBRA billing. Expressed in USD.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enrolledMemberCount rdf:type rdf:Property ;
    rdfs:label 'Enrolled Member Count' ;
    rdfs:comment 'Total number of covered members (subscriber plus dependents) enrolled under this billing arrangement during the billing period.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gracePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Grace Period End Date' ;
    rdfs:comment 'Last date of the grace period during which coverage remains active despite non-payment. After this date, coverage may lapse. Typically 30-90 days per plan terms.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceGeneratedDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Generated Date' ;
    rdfs:comment 'Date on which this premium billing invoice was generated and issued to the responsible party.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Invoice Number' ;
    rdfs:comment 'Externally visible unique invoice number assigned to this premium billing statement for tracking and payment reconciliation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceSentDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Sent Date' ;
    rdfs:comment 'Date on which the premium billing invoice was transmitted or mailed to the responsible party.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lapseDate rdf:type rdf:Property ;
    rdfs:label 'Lapse Date' ;
    rdfs:comment 'Date on which health plan coverage lapsed or was terminated due to non-payment of premium. Null if coverage remains active or payment was received.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:netPremiumDue rdf:type rdf:Property ;
    rdfs:label 'Net Premium Due' ;
    rdfs:comment 'Net premium amount due after applying all contributions, subsidies, and adjustments. This is the amount the responsible party must remit. Expressed in USD.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingBalance rdf:type rdf:Property ;
    rdfs:label 'Outstanding Balance' ;
    rdfs:comment 'Remaining unpaid balance on this premium invoice after applying all payments. Zero indicates invoice is paid in full. Expressed in USD.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumRatePerMember rdf:type rdf:Property ;
    rdfs:label 'Premium Rate Per Member' ;
    rdfs:comment 'The per-member-per-month premium rate applied to calculate total premium for this billing period. Expressed in USD.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinstatementEligible rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Eligible' ;
    rdfs:comment 'Indicates whether the lapsed coverage is eligible for reinstatement upon payment of outstanding premium and any applicable fees. True if reinstatement is allowed per plan terms.' ;
    rdfs:domain ind:PremiumBilling ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Total Premium Amount' ;
    rdfs:comment 'Total premium amount billed for the coverage period before applying employer or subscriber contributions. Expressed in USD.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryReplacementContactPayerContactId rdf:type rdf:Property ;
    rdfs:label 'Primary Replacement Contact Payer Contact Id' ;
    rdfs:comment 'Reference to the payer contact record that supersedes this contact. Used to maintain continuity when contacts are replaced or reorganized.' ;
    rdfs:domain ind:PayerContact ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PayerContact .

ind:acceptsElectronicSubmission rdf:type rdf:Property ;
    rdfs:label 'Accepts Electronic Submission' ;
    rdfs:comment 'Indicates whether this contact accepts electronic document submission via portal, EDI, or email. True when electronic methods are supported.' ;
    rdfs:domain ind:PayerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:city rdf:type rdf:Property ;
    rdfs:label 'City' ;
    rdfs:comment 'City name for the payer contacts mailing address.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearinghouseName rdf:type rdf:Property ;
    rdfs:label 'Clearinghouse Name' ;
    rdfs:comment 'Name of the clearinghouse intermediary used for electronic transactions with this payer contact. Applicable for EDI submission workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Consent Verification Method' ;
    rdfs:comment 'Method used to verify the accuracy of this contact information during the last verification cycle. Documents the validation approach.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactName rdf:type rdf:Property ;
    rdfs:label 'Contact Name' ;
    rdfs:comment 'pii_phi,pii_pii,pii_sensitive' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactStatus rdf:type rdf:Property ;
    rdfs:label 'Contact Status' ;
    rdfs:comment 'Current operational status of this payer contact. Indicates whether the contact is currently available and should be used for outreach.' ;
    rdfs:domain ind:PayerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactType rdf:type rdf:Property ;
    rdfs:label 'Contact Type' ;
    rdfs:comment 'Functional area or department this contact serves. Categorizes the contact by their operational responsibility within the payer organization. [ENUM-REF-CANDIDATE: claims_submission|prior_authorization|provider_relations|credentialing|network_contracting|edi_clearinghouse|appeals|member_services|utilization_management|quality_reporting|billing_inquiries|technical_support — promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryCode rdf:type rdf:Property ;
    rdfs:label 'Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the payer contacts mailing address. Primarily USA for domestic payers.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emailAddress rdf:type rdf:Property ;
    rdfs:label 'Email Address' ;
    rdfs:comment 'Email address for electronic communication with this payer contact. Used for non-urgent inquiries, document exchange, and operational correspondence.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationContactFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Contact Flag' ;
    rdfs:comment 'Indicates whether this contact should be used for escalated issues or urgent matters. True for supervisory or management contacts designated for escalation workflows.' ;
    rdfs:domain ind:PayerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:facilityServiceLevelAgreementDays rdf:type rdf:Property ;
    rdfs:label 'Facility Service Level Agreement Days' ;
    rdfs:comment 'Number of business days within which this contact commits to respond to inquiries or requests. Defines expected turnaround time for operational workflows.' ;
    rdfs:domain ind:PayerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:faxNumber rdf:type rdf:Property ;
    rdfs:label 'Fax Number' ;
    rdfs:comment 'Fax number for document transmission to this payer contact. Commonly used for prior authorization submissions and medical records transmission.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hoursOfOperation rdf:type rdf:Property ;
    rdfs:label 'Hours Of Operation' ;
    rdfs:comment 'Business hours during which this payer contact is available for communication. Typically includes days of week and time ranges with time zone.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languagePreference rdf:type rdf:Property ;
    rdfs:label 'Language Preference' ;
    rdfs:comment 'Primary language for communication with this payer contact. Supports multilingual provider relations and operational workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastContactDate rdf:type rdf:Property ;
    rdfs:label 'Last Contact Date' ;
    rdfs:comment 'Date of the most recent communication or interaction with this payer contact. Used to track contact currency and relationship maintenance.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Last Verified Date' ;
    rdfs:comment 'Date when the contact information was last verified as accurate and current. Supports data quality and contact maintenance workflows.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mailingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line1' ;
    rdfs:comment 'First line of the mailing address for this payer contact. Used for physical mail correspondence and document submission.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line2' ;
    rdfs:comment 'Second line of the mailing address including suite, department, or unit information for the payer contact.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npi rdf:type rdf:Property ;
    rdfs:label 'Npi' ;
    rdfs:comment 'National Provider Identifier for the payer organization or contact entity. Used for identification in HIPAA-compliant transactions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phoneExtension rdf:type rdf:Property ;
    rdfs:label 'Phone Extension' ;
    rdfs:comment 'Telephone extension number for direct routing to the contact within the payer organizations phone system.' ;
    rdfs:domain ind:PayerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phoneNumber rdf:type rdf:Property ;
    rdfs:label 'Phone Number' ;
    rdfs:comment 'Primary telephone number to reach this payer contact. Used for operational outreach including claims inquiries, prior authorization submissions, and provider relations.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portalLoginInstructions rdf:type rdf:Property ;
    rdfs:label 'Portal Login Instructions' ;
    rdfs:comment 'Special instructions or notes for accessing the payer portal associated with this contact. May include registration requirements or access procedures.' ;
    rdfs:domain ind:PayerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postalCode rdf:type rdf:Property ;
    rdfs:label 'Postal Code' ;
    rdfs:comment 'ZIP code or postal code for the payer contacts mailing address. May include ZIP+4 format.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredContactMethod rdf:type rdf:Property ;
    rdfs:label 'Preferred Contact Method' ;
    rdfs:comment 'The payer contacts preferred communication channel for routine inquiries and operational workflows. Guides provider staff on optimal outreach method.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Flag' ;
    rdfs:comment 'Indicates whether this is the primary or default contact for the specified contact type at this payer. True when this contact should be used first for the given function.' ;
    rdfs:domain ind:PayerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresAppointment rdf:type rdf:Property ;
    rdfs:label 'Requires Appointment' ;
    rdfs:comment 'Indicates whether this contact requires scheduled appointments for meetings or calls. True when advance scheduling is necessary.' ;
    rdfs:domain ind:PayerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:state rdf:type rdf:Property ;
    rdfs:label 'State' ;
    rdfs:comment 'Two-letter state or territory code for the payer contacts mailing address. Follows USPS state abbreviation standards.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeZone rdf:type rdf:Property ;
    rdfs:label 'Time Zone' ;
    rdfs:comment 'Time zone for the payer contacts business hours. Used to coordinate communication timing across geographic regions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:title rdf:type rdf:Property ;
    rdfs:label 'Title' ;
    rdfs:comment 'Job title or role designation of the contact person within the payer organization. Provides context for the contacts authority and scope.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vbcPerformanceId rdf:type rdf:Property ;
    rdfs:label 'Vbc Performance Id' ;
    rdfs:comment 'Unique identifier for the value-based care performance measurement record.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorVbcPerformanceId rdf:type rdf:Property ;
    rdfs:label 'Prior Vbc Performance Id' ;
    rdfs:comment 'Self-referencing FK on vbc_performance (prior_vbc_performance_id)' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VbcPerformance .

ind:qualityProgramId rdf:type rdf:Property ;
    rdfs:label 'Quality Program Id' ;
    rdfs:comment 'Foreign key linking to quality.quality_program. Business justification: VBC performance is measured against quality programs (MIPS, MSSP, Hospital VBP). Quality program defines the measure set, scoring methodology, and payment adjustment formula for VBC contracts.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:QualityProgram .

ind:settlementCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Settlement Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Value-based care shared savings and losses are allocated to specific cost centers for performance reporting, budget variance analysis, and departmental accountability. Finance teams track VBC settleme' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:benchmarkTcocAmount rdf:type rdf:Property ;
    rdfs:label 'Benchmark Tcoc Amount' ;
    rdfs:comment 'The target or benchmark total cost of care established by the payer for the attributed population, used to calculate savings or losses.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculationMethodology rdf:type rdf:Property ;
    rdfs:label 'Calculation Methodology' ;
    rdfs:comment 'Description of the methodology used to calculate performance metrics, savings, and quality scores for this measurement period.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataCompletenessScore rdf:type rdf:Property ;
    rdfs:label 'Data Completeness Score' ;
    rdfs:comment 'A score representing the completeness and quality of data submitted for performance measurement, expressed as a percentage.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Date' ;
    rdfs:comment 'The date on which the provider organization formally disputed the performance settlement.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disputeFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Flag' ;
    rdfs:comment 'Indicates whether the provider organization has disputed the performance calculation or settlement amounts.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Date' ;
    rdfs:comment 'The date on which the dispute was resolved between the payer and provider organization.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementYear rdf:type rdf:Property ;
    rdfs:label 'Measurement Year' ;
    rdfs:comment 'The calendar year in which the performance measurement period falls, used for reporting and trending.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:performancePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Performance Period End Date' ;
    rdfs:comment 'The ending date of the measurement period for this VBC performance evaluation.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performancePeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Performance Period Start Date' ;
    rdfs:comment 'The beginning date of the measurement period for this VBC performance evaluation.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceYearType rdf:type rdf:Property ;
    rdfs:label 'Performance Year Type' ;
    rdfs:comment 'The type of year used for performance measurement: calendar year, contract year, or benefit year.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityScore rdf:type rdf:Property ;
    rdfs:label 'Quality Score' ;
    rdfs:comment 'The composite quality performance score achieved during the measurement period, typically expressed as a percentage or points out of 100.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityWithholdEarnedAmount rdf:type rdf:Property ;
    rdfs:label 'Quality Withhold Earned Amount' ;
    rdfs:comment 'The portion of the quality withhold amount earned back by the provider organization based on achieved quality performance.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityWithholdForfeitedAmount rdf:type rdf:Property ;
    rdfs:label 'Quality Withhold Forfeited Amount' ;
    rdfs:comment 'The portion of the quality withhold amount forfeited due to failure to meet quality performance thresholds.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciliationPeriod rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Period' ;
    rdfs:comment 'The frequency at which performance is measured and reconciled under the VBC contract: quarterly, semi-annual, or annual.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingEntity rdf:type rdf:Property ;
    rdfs:label 'Reporting Entity' ;
    rdfs:comment 'The name or identifier of the entity responsible for reporting this VBC performance data (e.g., ACO, medical group, hospital system).' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskCorridorAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Risk Corridor Applied Flag' ;
    rdfs:comment 'Indicates whether risk corridor provisions were applied to limit the provider organizations financial exposure to savings or losses.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskCorridorLowerThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Risk Corridor Lower Threshold Amount' ;
    rdfs:comment 'The minimum savings or loss amount that must be achieved before shared savings or losses are triggered, as defined in the contract.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskCorridorUpperThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Risk Corridor Upper Threshold Amount' ;
    rdfs:comment 'The maximum savings or loss amount beyond which additional savings or losses are capped or shared at a different rate.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:savingsLossAmount rdf:type rdf:Property ;
    rdfs:label 'Savings Loss Amount' ;
    rdfs:comment 'The calculated difference between benchmark TCOC and actual TCOC. Positive values indicate savings; negative values indicate losses.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Approval Date' ;
    rdfs:comment 'The date on which the settlement calculation was approved by both the payer and provider organization for payment processing.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementCalculationDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Calculation Date' ;
    rdfs:comment 'The date on which the performance settlement amounts were calculated by the payer or third-party administrator.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Payment Date' ;
    rdfs:comment 'The date on which the shared savings distribution or loss payment was processed and funds were transferred.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementPaymentMethod rdf:type rdf:Property ;
    rdfs:label 'Settlement Payment Method' ;
    rdfs:comment 'The method used to transfer settlement funds: electronic funds transfer (EFT), check, wire transfer, or offset against other payments.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementStatus rdf:type rdf:Property ;
    rdfs:label 'Settlement Status' ;
    rdfs:comment 'The current status of the performance settlement process: pending calculation, calculated, approved for payment, paid, disputed, or adjusted.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sharedLossAmount rdf:type rdf:Property ;
    rdfs:label 'Shared Loss Amount' ;
    rdfs:comment 'The dollar amount of losses for which the provider organization is financially responsible under a two-sided risk arrangement.' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sharedSavingsDistributionAmount rdf:type rdf:Property ;
    rdfs:label 'Shared Savings Distribution Amount' ;
    rdfs:comment 'The final dollar amount of shared savings distributed to the provider organization after applying quality adjustments and risk corridor rules.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stopLossAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Stop Loss Applied Flag' ;
    rdfs:comment 'Indicates whether stop-loss provisions were triggered to limit the provider organizations financial exposure to catastrophic losses.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalCostOfCareAmount rdf:type rdf:Property ;
    rdfs:label 'Total Cost Of Care Amount' ;
    rdfs:comment 'The actual total cost of care incurred for attributed members during the performance period, including all medical and pharmacy claims.' ;
    rdfs:domain ind:VbcPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberAttributionId rdf:type rdf:Property ;
    rdfs:label 'Member Attribution Id' ;
    rdfs:comment 'Unique identifier for the member attribution record. Primary key for this transactional entity tracking value-based care and ACO attribution assignments.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attributedOrgProviderId rdf:type rdf:Property ;
    rdfs:label 'Attributed Org Provider Id' ;
    rdfs:comment 'FK to provider.org_provider.org_provider_id' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrgProvider .

ind:attributionCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Attribution Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Attributed member panels drive cost center revenue forecasting and budget planning in capitated and value-based arrangements. Finance teams use attribution data to allocate capitation revenue, forecas' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:careTeamId rdf:type rdf:Property ;
    rdfs:label 'Care Team Id' ;
    rdfs:comment 'Identifier for the care team to which the member is attributed, if attribution is at the team level rather than individual provider level.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CareTeam .

ind:clinicalAiPatientRiskScoreId rdf:type rdf:Property ;
    rdfs:label 'Clinical Ai Patient Risk Score Id' ;
    rdfs:comment 'Foreign key linking to clinical_ai.patient_risk_score. Business justification: VBC attribution uses AI risk scores to set capitation rates and attribution confidence. Payers/ACOs trace which risk score drove member assignment for audit and reconciliation.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalAiPatientRiskScore .

ind:clinicalOrderId rdf:type rdf:Property ;
    rdfs:label 'Clinical Order Id' ;
    rdfs:comment 'foreign_key_to' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClinicalOrder .

ind:primaryMemberClinicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Member Clinician Id' ;
    rdfs:comment 'Identifier for the primary care provider or care team to whom the member is attributed for performance measurement and capitation purposes.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Clinician .

ind:priorMemberAttributionId rdf:type rdf:Property ;
    rdfs:label 'Prior Member Attribution Id' ;
    rdfs:comment 'Self-referencing FK on member_attribution (prior_member_attribution_id)' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberAttribution .

ind:attributedProviderNpi rdf:type rdf:Property ;
    rdfs:label 'Attributed Provider Npi' ;
    rdfs:comment 'National Provider Identifier of the attributed primary care provider. Ten-digit unique identifier assigned by CMS.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionAlgorithmVersion rdf:type rdf:Property ;
    rdfs:label 'Attribution Algorithm Version' ;
    rdfs:comment 'Version identifier of the attribution algorithm or business rules used to calculate this attribution assignment. Used for audit trail and reproducibility.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionChangeReason rdf:type rdf:Property ;
    rdfs:label 'Attribution Change Reason' ;
    rdfs:comment 'Reason for change in attribution from previous provider to current provider. Examples include member request, provider termination, change in utilization pattern, or annual re-attribution.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Attribution Confidence Score' ;
    rdfs:comment 'Numeric score representing the confidence level or strength of the attribution assignment, typically ranging from 0.00 to 100.00. Higher scores indicate stronger attribution based on visit frequency, continuity of care, or other factors.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributionEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Attribution Effective Date' ;
    rdfs:comment 'Date when the member attribution assignment becomes effective and the attributed provider assumes responsibility for care coordination and performance measurement.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attributionEndDate rdf:type rdf:Property ;
    rdfs:label 'Attribution End Date' ;
    rdfs:comment 'Date when the member attribution assignment ends. Null for open-ended attributions. May be populated due to member disenrollment, provider termination, or contract end.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attributionLockDate rdf:type rdf:Property ;
    rdfs:label 'Attribution Lock Date' ;
    rdfs:comment 'Date when the attribution assignment was locked for the performance year and can no longer be changed. Used to ensure stable attribution for performance measurement.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attributionMethod rdf:type rdf:Property ;
    rdfs:label 'Attribution Method' ;
    rdfs:comment 'Method used to assign the member to the attributed provider. Prospective attribution occurs before the performance period; retrospective attribution occurs after using claims data; voluntary attribution is patient-selected; claims-based uses utilization patterns; enrollment-based uses plan enrollment data; patient-designated is explicit patient choice; hybrid combines multiple methods. [ENUM-REF-CANDIDATE: prospective|retrospective|voluntary|claims_based|enrollment_based|patient_designated|hybrid — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Attribution Period End Date' ;
    rdfs:comment 'End date of the measurement period used to calculate the attribution assignment. Typically the end of the performance year or lookback period.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attributionPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Attribution Period Start Date' ;
    rdfs:comment 'Start date of the measurement period used to calculate the attribution assignment. Typically the beginning of the performance year or lookback period.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:attributionSource rdf:type rdf:Property ;
    rdfs:label 'Attribution Source' ;
    rdfs:comment 'Source system or method that generated the attribution assignment. Claims-based uses historical utilization; enrollment-based uses plan enrollment data; patient-designated is explicit patient selection; provider-roster uses provider panel lists; ACO-assignment is CMS ACO attribution; manual-override is administrative assignment; system-calculated is algorithmic. [ENUM-REF-CANDIDATE: claims_based|enrollment_based|patient_designated|provider_roster|aco_assignment|manual_override|system_calculated — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionStatus rdf:type rdf:Property ;
    rdfs:label 'Attribution Status' ;
    rdfs:comment 'Current lifecycle status of the attribution assignment. Active indicates the attribution is currently in effect; inactive indicates it is no longer valid; pending indicates it is awaiting approval or effective date; terminated indicates it was ended; suspended indicates temporary hold.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionType rdf:type rdf:Property ;
    rdfs:label 'Attribution Type' ;
    rdfs:comment 'Type of value-based care or managed care program under which the attribution is made. ACO is Accountable Care Organization; MSSP is Medicare Shared Savings Program; NextGen ACO is Next Generation ACO Model; managed care is HMO/PPO attribution; capitation is capitated payment model; VBC is value-based care contract; PCMH is Patient-Centered Medical Home; bundled payment is episode-based attribution. [ENUM-REF-CANDIDATE: aco|mssp|nextgen_aco|managed_care|capitation|vbc|pcmh|bundled_payment — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bigintSurrogateKeyForCleanKeying rdf:type rdf:Property ;
    rdfs:label 'Bigint Surrogate Key For Clean Keying' ;
    rdfs:comment 'Foreign key linking to patient.mpi_record. Business justification: Value-based care attribution assigns patients to providers for ACO/MSSP quality and cost accountability. Business process: attribution rosters for shared savings programs require patient identity link' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capitationAmount rdf:type rdf:Property ;
    rdfs:label 'Capitation Amount' ;
    rdfs:comment 'Per-member per-month (PMPM) or per-member per-year (PMPY) capitation payment amount for this attributed member under the contract. Null if the contract is not capitated.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitationFrequency rdf:type rdf:Property ;
    rdfs:label 'Capitation Frequency' ;
    rdfs:comment 'Frequency at which capitation payments are made for this attributed member. Monthly is per-member per-month; quarterly is per-member per-quarter; annually is per-member per-year.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optOutDate rdf:type rdf:Property ;
    rdfs:label 'Opt Out Date' ;
    rdfs:comment 'Date when the member opted out of attribution or data sharing. Null if opt-out indicator is false.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:optOutIndicator rdf:type rdf:Property ;
    rdfs:label 'Opt Out Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the member has opted out of attribution or data sharing for performance measurement. True indicates opt-out; false indicates consent.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pluralityOfCareIndicator rdf:type rdf:Property ;
    rdfs:label 'Plurality Of Care Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the attributed provider delivered a plurality (most) of the members primary care services during the measurement period. True indicates plurality was met; false indicates it was not.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryCareVisitCount rdf:type rdf:Property ;
    rdfs:label 'Primary Care Visit Count' ;
    rdfs:comment 'Number of primary care visits the member had with the attributed provider during the attribution measurement period. Used to calculate plurality and attribution strength.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:providerAssignmentReason rdf:type rdf:Property ;
    rdfs:label 'Provider Assignment Reason' ;
    rdfs:comment 'Free-text or coded reason explaining why the member was attributed to this provider. Examples include highest visit count, patient selection, geographic proximity, or continuity of care.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sharedSavingsEligible rdf:type rdf:Property ;
    rdfs:label 'Shared Savings Eligible' ;
    rdfs:comment 'Boolean flag indicating whether this attributed member is eligible for inclusion in shared savings calculations. True indicates eligible; false indicates excluded (e.g., due to insufficient claims history or enrollment duration).' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tin rdf:type rdf:Property ;
    rdfs:label 'Tin' ;
    rdfs:comment 'Tax Identification Number of the provider organization or practice to which the member is attributed. Used for payment and performance reporting at the TIN level.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalVisitCount rdf:type rdf:Property ;
    rdfs:label 'Total Visit Count' ;
    rdfs:comment 'Total number of primary care visits the member had with all providers during the attribution measurement period. Used to calculate plurality percentage.' ;
    rdfs:domain ind:MemberAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:insurancePayerEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Insurance Payer Enrollment Id' ;
    rdfs:comment 'Primary key for the payer_enrollment association' ;
    rdfs:domain ind:InsurancePayerEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:credentialingStatus rdf:type rdf:Property ;
    rdfs:label 'Credentialing Status' ;
    rdfs:comment 'Status of the payer-specific credentialing review for this clinician. Distinct from the clinicians internal credentialing_status - this reflects the payers own credentialing decision.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentNumber rdf:type rdf:Property ;
    rdfs:label 'Enrollment Number' ;
    rdfs:comment 'Unique identifier assigned by the payer to this specific clinician enrollment. Used in claim submissions and eligibility verification.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentStatus rdf:type rdf:Property ;
    rdfs:label 'Enrollment Status' ;
    rdfs:comment 'Current lifecycle status of this clinicians enrollment with this specific payer. Determines billing eligibility and claim submission rights.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ptan rdf:type rdf:Property ;
    rdfs:label 'Ptan' ;
    rdfs:comment 'CMS-issued PTAN (Provider Transaction Access Number) for Medicare billing. Specific to this clinician-payer enrollment relationship.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerComplianceRequirementId rdf:type rdf:Property ;
    rdfs:label 'Payer Compliance Requirement Id' ;
    rdfs:comment 'Unique identifier for this payer-program compliance requirement record. Primary key.' ;
    rdfs:domain ind:PayerComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditFrequency rdf:type rdf:Property ;
    rdfs:label 'Audit Frequency' ;
    rdfs:comment 'Frequency at which compliance audits specific to this payer-program combination must be conducted. May be driven by payer contract terms or regulatory requirements specific to the payer type (e.g., Medicare requires annual HIPAA audits).' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceStatus rdf:type rdf:Property ;
    rdfs:label 'Compliance Status' ;
    rdfs:comment 'Current compliance status for this payer under this program. Tracks whether the organization is meeting all requirements for this specific payer-program combination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingsCount rdf:type rdf:Property ;
    rdfs:label 'Findings Count' ;
    rdfs:comment 'Number of open compliance findings or deficiencies identified for this payer under this program. Used to track remediation progress.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Audit Date' ;
    rdfs:comment 'Date of the most recent compliance audit conducted for this specific payer-program combination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastReportDate rdf:type rdf:Property ;
    rdfs:label 'Last Report Date' ;
    rdfs:comment 'Date when the most recent compliance report was submitted for this payer-program combination.' ;
    rdfs:domain ind:PayerComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastStatusChangeDate rdf:type rdf:Property ;
    rdfs:label 'Last Status Change Date' ;
    rdfs:comment 'Date when the compliance_status was last updated for this payer-program combination.' ;
    rdfs:domain ind:PayerComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextAuditDate rdf:type rdf:Property ;
    rdfs:label 'Next Audit Date' ;
    rdfs:comment 'Scheduled date for the next compliance audit for this payer-program combination, calculated based on audit_frequency and last_audit_date.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextReportDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Report Due Date' ;
    rdfs:comment 'Date by which the next compliance report must be submitted for this payer-program combination.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payerProgramScope rdf:type rdf:Property ;
    rdfs:label 'Payer Program Scope' ;
    rdfs:comment 'Detailed description of how this compliance program applies specifically to this payer relationship. May include specific service lines, facilities, or transaction types covered (e.g., Applies to all Medicare Advantage claims submitted through EDI; excludes paper claims).' ;
    rdfs:domain ind:PayerComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payerSpecificRequirements rdf:type rdf:Property ;
    rdfs:label 'Payer Specific Requirements' ;
    rdfs:comment 'Free-text field capturing any additional compliance requirements, attestations, certifications, or documentation that this specific payer requires beyond the standard program requirements. Examples: Payer requires quarterly attestation from Chief Compliance Officer, Annual HIPAA certification required for provider portal access.' ;
    rdfs:domain ind:PayerComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Program Effective Date' ;
    rdfs:comment 'Date when this compliance program became applicable to this specific payer relationship. May differ from the general program effective date if the payer contract was signed later or requirements phased in.' ;
    rdfs:domain ind:PayerComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:programExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Program Expiration Date' ;
    rdfs:comment 'Date when this compliance program ceases to apply to this payer, typically aligned with contract termination or regulatory sunset provisions.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingFrequency rdf:type rdf:Property ;
    rdfs:label 'Reporting Frequency' ;
    rdfs:comment 'Frequency at which compliance reports must be submitted to this payer or regulatory body overseeing this payer relationship.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingRequirements rdf:type rdf:Property ;
    rdfs:label 'Reporting Requirements' ;
    rdfs:comment 'Detailed description of compliance reporting obligations specific to this payer under this program. Includes report types, submission frequency, recipient (payer, CMS, state agency), and format requirements.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleParty rdf:type rdf:Property ;
    rdfs:label 'Responsible Party' ;
    rdfs:comment 'Name or identifier of the individual or department responsible for ensuring compliance with this program for this specific payer relationship. May be a payer relationship manager, compliance officer, or department head.' ;
    rdfs:domain ind:PayerComplianceRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planConsentRequirementId rdf:type rdf:Property ;
    rdfs:label 'Plan Consent Requirement Id' ;
    rdfs:comment 'Unique identifier for this plan consent requirement record. Primary key.' ;
    rdfs:domain ind:PlanConsentRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consentFormTemplateId rdf:type rdf:Property ;
    rdfs:label 'Consent Form Template Id' ;
    rdfs:comment 'Foreign key linking to the consent form template required by this health plan' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConsentFormTemplate .

ind:createdDate rdf:type rdf:Property ;
    rdfs:label 'Created Date' ;
    rdfs:comment 'Timestamp when this plan consent requirement record was created in the system.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:enrollmentTriggerFlag rdf:type rdf:Property ;
    rdfs:label 'Enrollment Trigger Flag' ;
    rdfs:comment 'Indicates whether this consent form must be presented and completed during the initial enrollment process for this health plan. True means the form is part of the enrollment workflow.' ;
    rdfs:domain ind:PlanConsentRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastUpdatedBy rdf:type rdf:Property ;
    rdfs:label 'Last Updated By' ;
    rdfs:comment 'User ID or system identifier of the person or process that last modified this plan consent requirement record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Last Updated Date' ;
    rdfs:comment 'Timestamp when this plan consent requirement record was last modified.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandatoryFlag rdf:type rdf:Property ;
    rdfs:label 'Mandatory Flag' ;
    rdfs:comment 'Indicates whether this consent form is mandatory (true) or optional (false) for members of this health plan. Mandatory forms must be completed before enrollment can be finalized or services accessed.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalTriggerFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Trigger Flag' ;
    rdfs:comment 'Indicates whether this consent form must be re-presented and re-signed during annual plan renewal. True means members must re-consent each benefit year.' ;
    rdfs:domain ind:PlanConsentRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requirementBasis rdf:type rdf:Property ;
    rdfs:label 'Requirement Basis' ;
    rdfs:comment 'The legal or business basis for why this consent form is required for this plan. Values: federal_regulation (HIPAA, ACA mandate), state_law (state-specific consent requirements), plan_policy (payer business rule), payer_requirement (employer group requirement), accreditation_standard (NCQA, URAC requirement).' ;
    rdfs:domain ind:PlanConsentRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementNotes rdf:type rdf:Property ;
    rdfs:label 'Requirement Notes' ;
    rdfs:comment 'Free-text notes explaining special circumstances, exceptions, or additional context about why this consent form is required for this plan or how the requirement should be applied.' ;
    rdfs:domain ind:PlanConsentRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdBy rdf:type rdf:Property ;
    rdfs:label 'Created By' ;
    rdfs:comment 'User ID or system identifier of the person or process that created this plan consent requirement record.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerId rdf:type rdf:Property ;
    rdfs:label 'Broker Id' ;
    rdfs:comment 'Primary key for broker' ;
    rdfs:domain ind:Insurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Broker .

ind:insurancePayerId rdf:type rdf:Property ;
    rdfs:label 'Insurance Payer Id' ;
    rdfs:comment 'FK to insurance.payer.payer_id' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payer .

ind:parentBrokerId rdf:type rdf:Property ;
    rdfs:label 'Parent Broker Id' ;
    rdfs:comment 'Self-referencing FK on broker (parent_broker_id)' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Broker .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line 1' ;
    rdfs:comment 'Primary street address line for the brokers business location.' ;
    rdfs:domain ind:Healthcare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line 2' ;
    rdfs:comment 'Secondary address line for suite, unit, or building information.' ;
