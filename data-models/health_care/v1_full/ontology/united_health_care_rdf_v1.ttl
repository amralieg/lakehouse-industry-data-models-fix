    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evidenceIndicator rdf:type rdf:Property ;
    rdfs:label 'Evidence Indicator' ;
    rdfs:comment 'Flag indicating whether the case note contains or references evidence material to the fraud investigation.' ;
