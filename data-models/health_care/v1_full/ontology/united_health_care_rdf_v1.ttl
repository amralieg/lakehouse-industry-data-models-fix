    rdfs:range xsd:integer .

ind:abandonThresholdSeconds rdf:type rdf:Property ;
    rdfs:label 'Abandon Threshold Seconds' ;
    rdfs:comment 'Minimum time in seconds an interaction must wait in queue before being counted as an abandoned call if the caller disconnects.' ;
    rdfs:domain ind:Queue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:callbackEnabled rdf:type rdf:Property ;
    rdfs:label 'Callback Enabled' ;
    rdfs:comment 'Indicates whether members are offered the option to receive a callback instead of waiting in queue.' ;
