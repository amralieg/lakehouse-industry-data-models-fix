  cme_compliance_period_months varchar [note: 'CME compliance period in months.']
  cme_hours_required decimal(6,2) [note: 'CME hours required per compliance period.']
  competency_framework_code varchar [note: 'Code for the competency framework applicable to this profile.']
  created_timestamp timestamp [note: 'Timestamp when the profile was created.']
  dea_registration_required decimal(9,4) [note: 'Whether DEA registration is required.']
  drug_screen_required boolean [note: 'Whether drug screening is required.']
  effective_date date [note: 'Date the profile becomes effective.']
  employment_type varchar [note: 'Employment type for this profile.']
  end_date date [note: 'End date if the profile is retired.']
  flsa_status varchar [note: 'FLSA status (exempt/non-exempt).']
  fte_equivalent decimal(5,2) [note: 'FTE equivalent for the profile.']
  hipaa_access_level varchar [note: 'HIPAA access level required.']
  job_category varchar [note: 'Job category classification.']
  job_code varchar [note: 'Unique job code.']
  job_description varchar [note: 'Full job description text.']
  job_family varchar [note: 'Job family grouping.']
  job_family_group varchar [note: 'Higher-level job family group.']
  job_level varchar [note: 'Job level within the hierarchy.']
  job_title varchar [note: 'Standard job title.']
  last_reviewed_date date [note: 'Date the profile was last reviewed.']
  licensure_required boolean [note: 'Whether licensure is required.']
  management_level varchar [note: 'Management level designation.']
  minimum_education_level varchar [note: 'Minimum education level required.']
  minimum_experience_years decimal(4,1) [note: 'Minimum years of experience required.']
  npi_required boolean [note: 'Whether NPI is required.']
  on_call_required boolean [note: 'Whether on-call duty is required.']
  osha_exposure_category varchar [note: 'OSHA exposure category for safety compliance.']
  pay_grade varchar [note: 'Pay grade for the profile.']
  pay_range_max decimal(12,2) [note: 'Maximum pay range.']
  pay_range_midpoint decimal(12,2) [note: 'Midpoint of pay range.']
  pay_range_min decimal(12,2) [note: 'Minimum pay range.']
  pay_rate_type varchar [note: 'Type of pay rate (hourly, salary, per diem).']
  privileging_required boolean [note: 'Whether privileging is required.']
  profile_status varchar [note: 'Status of the job profile (active, inactive, draft).']
  remote_eligible boolean [note: 'Whether the role is eligible for remote work.']
  required_certifications varchar [note: 'List of required certifications.']
  required_license_types varchar [note: 'List of required license types.']
  rvu_eligible boolean [note: 'Whether the role is RVU-eligible for productivity tracking.']
  shift_type varchar [note: 'Shift type for the profile.']
  standard_hours_per_week decimal(5,2) [note: 'Standard hours per week.']
  travel_required boolean [note: 'Whether travel is required.']
  union_code varchar [note: 'Union code if applicable.']
  union_eligible boolean [note: 'Whether the role is union eligible.']
  updated_timestamp timestamp [note: 'Timestamp of last update.']
  vibe_added_flag boolean [note: 'Added by VIBE mutator']
  workday_job_profile_code varchar [note: 'Workday job profile code for integration.']

  Note: 'Defines job profiles with requirements, qualifications, and compensation parameters for healthcare workforce positions.'
}

Table workforce.employment_competency {
