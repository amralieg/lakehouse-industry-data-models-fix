    rdfs:comment 'The prospective member\'s current health insurance coverage status, used for needs assessment and conversion strategy.' ;
    rdfs:domain ind:Lead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentCarrierName rdf:type rdf:Property ;
    rdfs:label 'Current Carrier Name' ;
    rdfs:comment 'The name of the prospective member\'s current health insurance carrier, if applicable.' ;
    rdfs:domain ind:Lead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentPlanType rdf:type rdf:Property ;
    rdfs:label 'Current Plan Type' ;
    rdfs:comment 'The type of health plan the prospective member currently has, such as Health Maintenance Organization (HMO), Preferred Provider Organization (PPO), or High Deductible Health Plan (HDHP).' ;
    rdfs:domain ind:Lead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestedProducts rdf:type rdf:Property ;
    rdfs:label 'Interested Products' ;
    rdfs:comment 'A comma-separated list of specific insurance products or plan types the lead has expressed interest in.' ;
    rdfs:domain ind:Lead ;
