  primary_artist_name varchar [note: 'Name of the primary artist']
  record_label varchar [note: 'Record label']
  release_date date [note: 'Official release date']
  release_title varchar [note: 'Title of the release (album/EP/single name)']
  release_type varchar [note: 'Type of release: album, EP, single, compilation']
  remaster_flag boolean [note: 'Indicates if this is a remastered release']
  source_code varchar [note: 'Source system record ID']
  source_record_id varchar [note: 'Source record identifier']
  sub_genre varchar [note: 'Secondary genre classification']
  subgenre varchar [note: 'Secondary genre classification']
  territory varchar [note: 'ISO territory code for release availability']
  territory_code varchar [note: 'Territory restrictions for the release']
  territory_of_origin varchar [note: 'Country/territory of original release']
  territory_rights varchar [note: 'Territory codes where release is available']
  title varchar [note: 'Release title']
  total_duration_seconds varchar [note: 'Total duration of all tracks in seconds']
  total_tracks bigint [note: 'Number of tracks on the release']
  track_count varchar [note: 'Number of tracks on the release']
  upc varchar [note: 'Universal Product Code for the release']
  upc_code varchar [note: 'Universal Product Code for the release']
  updated_at timestamp [note: 'Record last update timestamp']
