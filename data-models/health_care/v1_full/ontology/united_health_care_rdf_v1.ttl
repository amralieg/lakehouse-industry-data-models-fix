    rdfs:range xsd:string .

ind:targetDepartmentCode rdf:type rdf:Property ;
    rdfs:label 'Target Department Code' ;
    rdfs:comment 'The department code to which the amount is being allocated.' ;
    rdfs:domain ind:AllocationDetail ;
    rdf:type owl:DatatypeProperty ;
