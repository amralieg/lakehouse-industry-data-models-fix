    rdfs:comment 'Indicates whether states can modify the rules or eligibility criteria for this qualifying life event in state-based marketplaces.' ;
    rdfs:domain ind:QualifyingLifeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsGuidanceReference rdf:type rdf:Property ;
    rdfs:label 'Cms Guidance Reference' ;
