    rdfs:comment 'Indicates whether authorization requests for this service type require review by a medical director or specialist in the relevant clinical area.' ;
    rdfs:domain ind:ServiceType ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewerSpecialtyRequired rdf:type rdf:Property ;
