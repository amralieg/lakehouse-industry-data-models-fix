    rdfs:comment 'Narrative description of the measure set(s) included in the program.' ;
    rdfs:domain ind:Quality ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentAdjustmentFactor rdf:type rdf:Property ;
