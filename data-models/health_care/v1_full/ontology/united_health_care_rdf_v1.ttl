ind:homeInfusionEligible rdf:type rdf:Property ;
    rdfs:label 'Home Infusion Eligible' ;
    rdfs:comment 'Indicates whether the specialty drug can be administered via home infusion services rather than requiring facility-based administration.' ;
    rdfs:domain ind:SpecialtyPharmacy ;
