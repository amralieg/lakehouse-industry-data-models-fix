  _updated_at timestamp [note: 'Medallion lineage column for _updated_at | Column _updated_at (TIMESTAMP) in rights.rights_audit_session']
  actual_end_timestamp timestamp [note: 'Precise timestamp when the audit session was actually completed or closed. | Column actual_end_timestamp (TIMESTAMP) in rights.rights_audit_session']
  actual_start_timestamp timestamp [note: 'Precise timestamp when the audit session actually commenced, capturing the real-world event time of audit initiation. | Column actual_start_timestamp (TIMESTAMP) in rights.rights_audit_session']
  approval_status varchar [note: 'Management approval status for the audit session and its findings: pending approval, approved and accepted, rejected, or revision requested before approval. | Column approval_status (STRING) in rights.rights_audit_session']
  approval_timestamp timestamp [note: 'Timestamp when the audit session was formally approved by management. | Column approval_timestamp (TIMESTAMP) in rights.rights_audit_session']
  audit_methodology varchar [note: 'Approach used to conduct the audit: manual review by auditors, automated system-driven analysis, hybrid combination of manual and automated, or statistical sampling methodology. | Column audit_methodology (STRING) in rights.rights_audit_session']
  audit_period_end_date date [note: 'Ending date of the time period covered by this audit session (the data/transactions being audited). | Column audit_period_end_date (DATE) in rights.rights_audit_session']
  audit_period_start_date date [note: 'Beginning date of the time period covered by this audit session (the data/transactions being audited). | Column audit_period_start_date (DATE) in rights.rights_audit_session']
  audit_report_url varchar [note: 'URL or file path to the detailed audit report document generated for this session. | Column audit_report_url (STRING) in rights.rights_audit_session']
  audit_scope varchar [note: 'Defines the breadth of the audit session: full comprehensive review, partial subset review, targeted specific-issue investigation, or sample-based statistical audit. | Column audit_scope (STRING) in rights.rights_audit_session']
  audit_team_size varchar [note: 'Number of auditors and support personnel assigned to this audit session. | Column audit_team_size (INT) in rights.rights_audit_session']
  audit_type varchar [note: 'Classification of the audit session by its primary focus area: compliance verification, financial reconciliation, operational review, contractual adherence, territory restriction validation, windowing strategy verification, or royalty calculation audit. | Column audit_type (STRING) in rights.rights_audit_session']
  compliance_score decimal(5,2) [note: 'Overall compliance score for this audit session, expressed as a percentage (0.00 to 100.00) representing the degree of adherence to rights management policies and contractual obligations. | Column compliance_score (DECIMAL(5,2)) in rights.rights_audit_session']
  created_at timestamp [note: 'Medallion lineage tracking column for bronze->silver->gold tracing | Column created_at (TIMESTAMP) in rights.rights_audit_session']
  created_timestamp timestamp [note: 'Timestamp when this audit session record was first created in the system. | Column created_timestamp (TIMESTAMP) in rights.rights_audit_session']
  critical_findings_count varchar [note: 'Number of critical-severity findings that require immediate remediation or represent significant compliance risks. | Column critical_findings_count (INT) in rights.rights_audit_session']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for financial amounts reported in this audit session. | Column currency_code (STRING) in rights.rights_audit_session']
  distribution_channel_scope varchar [note: 'Distribution channels included in the audit scope (e.g., theatrical, SVOD, AVOD, TVOD, linear television, home video). | Column distribution_channel_scope (STRING) in rights.rights_audit_session']
  financial_discrepancy_amount decimal(18,2) [note: 'Total monetary value of financial discrepancies identified during the audit, representing under-payments, over-payments, or unreconciled amounts. Expressed in the reporting currency. | Column financial_discrepancy_amount (DECIMAL(18,2)) in rights.rights_audit_session']
  findings_count varchar [note: 'Total number of audit findings, discrepancies, or issues identified during this audit session. | Column findings_count (INT) in rights.rights_audit_session']
