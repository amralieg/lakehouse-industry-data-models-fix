    rdfs:label 'Refund Method' ;
    rdfs:comment 'Method by which a refund will be issued if the adjustment results in an overpayment.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundDate rdf:type rdf:Property ;
    rdfs:label 'Refund Date' ;
    rdfs:comment 'Date when the refund was or will be issued.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:externalReferenceId rdf:type rdf:Property ;
    rdfs:label 'External Reference Id' ;
    rdfs:comment 'External reference number or identifier from a third-party system or document related to the adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditedBy rdf:type rdf:Property ;
    rdfs:label 'Audited By' ;
    rdfs:comment 'User identifier or name of the person who audited the adjustment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Flag' ;
    rdfs:comment 'Indicates whether the adjustment has been disputed by the member or group.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Date' ;
    rdfs:comment 'Date when the adjustment was disputed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disputeResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Date' ;
    rdfs:comment 'Date when the dispute was resolved.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:voidFlag rdf:type rdf:Property ;
    rdfs:label 'Void Flag' ;
    rdfs:comment 'Indicates whether the adjustment has been voided and is no longer valid.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationId rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Id' ;
    rdfs:comment 'Unique identifier for each risk reconciliation transaction record.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adjustedRafScore rdf:type rdf:Property ;
    rdfs:label 'Adjusted Raf Score' ;
    rdfs:comment 'Revised RAF score after reconciliation adjustments have been applied.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Original Payment Amount' ;
    rdfs:comment 'Initial CMS payment amount calculated based on the original RAF score.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustedPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Adjusted Payment Amount' ;
    rdfs:comment 'Revised CMS payment amount after reconciliation adjustments.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Variance Amount' ;
    rdfs:comment 'Dollar difference between original and adjusted payment amounts (adjusted minus original).' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentAdjustmentDirection rdf:type rdf:Property ;
    rdfs:label 'Payment Adjustment Direction' ;
    rdfs:comment 'Indicates whether the reconciliation resulted in a payment increase, decrease, or no change.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccCodesAdded rdf:type rdf:Property ;
    rdfs:label 'Hcc Codes Added' ;
    rdfs:comment 'Comma-separated list of HCC codes added during reconciliation that were not in the original risk score calculation.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccCodesRemoved rdf:type rdf:Property ;
    rdfs:label 'Hcc Codes Removed' ;
    rdfs:comment 'Comma-separated list of HCC codes removed during reconciliation that were in the original risk score calculation.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hccCountOriginal rdf:type rdf:Property ;
    rdfs:label 'Hcc Count Original' ;
    rdfs:comment 'Number of HCC codes included in the original RAF score calculation.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hccCountAdjusted rdf:type rdf:Property ;
    rdfs:label 'Hcc Count Adjusted' ;
    rdfs:comment 'Number of HCC codes included in the adjusted RAF score calculation after reconciliation.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:diagnosisCodesAdded rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Codes Added' ;
    rdfs:comment 'Comma-separated list of ICD-10 diagnosis codes added during reconciliation.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisCodesRemoved rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Codes Removed' ;
    rdfs:comment 'Comma-separated list of ICD-10 diagnosis codes removed during reconciliation.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceThroughDate rdf:type rdf:Property ;
    rdfs:label 'Service Through Date' ;
    rdfs:comment 'End date of the service period for the encounter or claim that triggered the reconciliation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:demographicFactorOriginal rdf:type rdf:Property ;
    rdfs:label 'Demographic Factor Original' ;
    rdfs:comment 'Demographic component of the original RAF score based on age, gender, and eligibility status.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demographicFactorAdjusted rdf:type rdf:Property ;
    rdfs:label 'Demographic Factor Adjusted' ;
    rdfs:comment 'Demographic component of the adjusted RAF score after reconciliation.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diseaseFactorOriginal rdf:type rdf:Property ;
    rdfs:label 'Disease Factor Original' ;
    rdfs:comment 'Disease component of the original RAF score based on HCC codes.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diseaseFactorAdjusted rdf:type rdf:Property ;
    rdfs:label 'Disease Factor Adjusted' ;
    rdfs:comment 'Disease component of the adjusted RAF score after reconciliation.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interactionFactorOriginal rdf:type rdf:Property ;
    rdfs:label 'Interaction Factor Original' ;
    rdfs:comment 'Interaction component of the original RAF score based on disease-disease or disease-demographic interactions.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interactionFactorAdjusted rdf:type rdf:Property ;
    rdfs:label 'Interaction Factor Adjusted' ;
    rdfs:comment 'Interaction component of the adjusted RAF score after reconciliation.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibilityCategory rdf:type rdf:Property ;
    rdfs:label 'Eligibility Category' ;
    rdfs:comment 'CMS eligibility category for the member affecting risk adjustment calculations.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partDEnrollmentFlag rdf:type rdf:Property ;
    rdfs:label 'Part D Enrollment Flag' ;
    rdfs:comment 'Indicates whether the member is enrolled in Medicare Part D prescription drug coverage.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reprocessingFlag rdf:type rdf:Property ;
    rdfs:label 'Reprocessing Flag' ;
    rdfs:comment 'Indicates whether this reconciliation record is a reprocessed version of a previous submission.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalReconciliationId rdf:type rdf:Property ;
    rdfs:label 'Original Reconciliation Id' ;
    rdfs:comment 'Reference to the original reconciliation record if this is a reprocessed version.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Reconciliation .

ind:runDate rdf:type rdf:Property ;
    rdfs:label 'Run Date' ;
    rdfs:comment 'Date when the reconciliation batch process was executed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversedReconciliationId rdf:type rdf:Property ;
    rdfs:label 'Reversed Reconciliation Id' ;
    rdfs:comment 'Reference to the reconciliation record being reversed by this transaction.' ;
    rdfs:domain ind:Reconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cycleId rdf:type rdf:Property ;
    rdfs:label 'Cycle Id' ;
    rdfs:comment 'Unique identifier for the billing cycle record. Primary key for the billing cycle entity.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Cycle .

ind:frequency rdf:type rdf:Property ;
    rdfs:label 'Frequency' ;
    rdfs:comment 'The recurrence pattern of the billing cycle indicating how often billing occurs (monthly, quarterly, annual, etc.).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyInterval rdf:type rdf:Property ;
    rdfs:label 'Frequency Interval' ;
    rdfs:comment 'Numeric value representing the interval count for the billing frequency (e.g., 1 for monthly, 3 for quarterly).' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:billingDate rdf:type rdf:Property ;
    rdfs:label 'Billing Date' ;
    rdfs:comment 'The date when invoices or premium statements are generated and issued to members or groups for this billing cycle.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingType rdf:type rdf:Property ;
    rdfs:label 'Billing Type' ;
    rdfs:comment 'Classification of the billing arrangement indicating whether this is group billing, individual billing, ASO billing, capitation payment, or commission processing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pepmRate rdf:type rdf:Property ;
    rdfs:label 'Pepm Rate' ;
    rdfs:comment 'The premium rate charged per employee per month for this billing cycle. Used in group billing calculations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Total Premium Amount' ;
    rdfs:comment 'The total premium amount calculated for this billing cycle before adjustments, representing the gross revenue expected.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Net Premium Amount' ;
    rdfs:comment 'The net premium amount for this billing cycle after all adjustments, representing the actual amount billed to the customer.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employeeCount rdf:type rdf:Property ;
    rdfs:label 'Employee Count' ;
    rdfs:comment 'Total number of employees covered during this billing cycle, used for PEPM calculations in group billing.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:subscriberCount rdf:type rdf:Property ;
    rdfs:label 'Subscriber Count' ;
    rdfs:comment 'Total number of primary subscribers (policyholders) in this billing cycle, excluding dependents.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:retroactivePeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Retroactive Period Start Date' ;
    rdfs:comment 'The start date of the period for which retroactive adjustments are being applied in this billing cycle.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retroactivePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Retroactive Period End Date' ;
    rdfs:comment 'The end date of the period for which retroactive adjustments are being applied in this billing cycle.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentChannel rdf:type rdf:Property ;
    rdfs:label 'Payment Channel' ;
    rdfs:comment 'The channel or interface through which payment is received for this billing cycle (web portal, mobile app, phone, mail, in-person, automated).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoPayFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Flag' ;
    rdfs:comment 'Indicates whether automatic payment processing is enabled for this billing cycle, allowing for automated premium collection.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:invoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Invoice Number' ;
    rdfs:comment 'Unique invoice or statement number generated for this billing cycle, used for payment reconciliation and customer reference.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceGenerationDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Generation Date' ;
    rdfs:comment 'The date when the invoice or premium statement was generated for this billing cycle.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Invoice Delivery Method' ;
    rdfs:comment 'The method by which the invoice or premium statement is delivered to the customer (email, mail, portal, electronic, paper).' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Payment Received Date' ;
    rdfs:comment 'The date when payment for this billing cycle was received and posted to the account.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Amount' ;
    rdfs:comment 'The actual amount of payment received for this billing cycle, which may differ from the billed amount due to partial payments or overpayments.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingBalance rdf:type rdf:Property ;
    rdfs:label 'Outstanding Balance' ;
    rdfs:comment 'The remaining unpaid balance for this billing cycle after applying received payments, representing accounts receivable.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Fee Amount' ;
    rdfs:comment 'Amount of late payment fees assessed for this billing cycle when payment is not received by the due date.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lateFeeAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Late Fee Applied Flag' ;
    rdfs:comment 'Indicates whether late payment fees have been applied to this billing cycle due to payment received after the due date.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionRate rdf:type rdf:Property ;
    rdfs:label 'Commission Rate' ;
    rdfs:comment 'The percentage rate applied to premium amounts to calculate broker or agent commissions for this billing cycle.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:asoAdminFee rdf:type rdf:Property ;
    rdfs:label 'Aso Admin Fee' ;
    rdfs:comment 'Administrative fee charged for ASO arrangements in this billing cycle, where the employer self-funds the plan and the insurer provides administrative services only.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costSharingReductionAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Reduction Amount' ;
    rdfs:comment 'Cost sharing reduction subsidy amount applied to this billing cycle for eligible marketplace members to reduce out-of-pocket costs.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsuranceAmount rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Amount' ;
    rdfs:comment 'Reinsurance payment or recovery amount associated with this billing cycle, used to offset high-cost claims.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mlrApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Mlr Applicable Flag' ;
    rdfs:comment 'Indicates whether this billing cycle is subject to Medical Loss Ratio requirements, which mandate minimum percentages of premium spent on medical care and quality improvement.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mlrRebateAmount rdf:type rdf:Property ;
    rdfs:label 'Mlr Rebate Amount' ;
    rdfs:comment 'MLR rebate amount owed to members for this billing cycle if the insurer fails to meet minimum MLR thresholds.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fiscalQuarter rdf:type rdf:Property ;
    rdfs:label 'Fiscal Quarter' ;
    rdfs:comment 'The fiscal quarter (Q1, Q2, Q3, Q4) to which this billing cycle belongs for quarterly financial reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Date' ;
    rdfs:comment 'The date when premium revenue for this billing cycle is recognized in financial statements according to GAAP revenue recognition principles.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deferredRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Deferred Revenue Amount' ;
    rdfs:comment 'Amount of premium revenue deferred to future periods for this billing cycle, representing unearned revenue for coverage not yet provided.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earnedRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Earned Revenue Amount' ;
    rdfs:comment 'Amount of premium revenue earned and recognized in the current period for this billing cycle, representing revenue for coverage already provided.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingSystemCode rdf:type rdf:Property ;
    rdfs:label 'Billing System Code' ;
    rdfs:comment 'Code identifying the source billing system that generated this billing cycle (e.g., Facets, QNXT, HealthRules).' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingRunId rdf:type rdf:Property ;
    rdfs:label 'Billing Run Id' ;
    rdfs:comment 'Unique identifier for the batch billing run that generated this billing cycle, used for audit and troubleshooting purposes.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingRunTimestamp rdf:type rdf:Property ;
    rdfs:label 'Billing Run Timestamp' ;
    rdfs:comment 'The date and time when the billing run was executed to generate this billing cycle.' ;
    rdfs:domain ind:Cycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:writeOffId rdf:type rdf:Property ;
    rdfs:label 'Write Off Id' ;
    rdfs:comment 'Unique identifier for the write-off entry. Primary key for the write-off data product.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WriteOff .

ind:requestedBy rdf:type rdf:Property ;
    rdfs:label 'Requested By' ;
    rdfs:comment 'The user ID or name of the person who initiated the write-off request. Establishes accountability for the write-off initiation.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysPastDue rdf:type rdf:Property ;
    rdfs:label 'Days Past Due' ;
    rdfs:comment 'The number of days the payment was overdue at the time of write-off. Used for aging analysis and bad debt reserve calculations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agingBucket rdf:type rdf:Property ;
    rdfs:label 'Aging Bucket' ;
    rdfs:comment 'The accounts receivable aging category at the time of write-off. Classifies receivables by how long they have been outstanding.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionAttempts rdf:type rdf:Property ;
    rdfs:label 'Collection Attempts' ;
    rdfs:comment 'The number of collection attempts made before the write-off. Documents collection efforts for regulatory compliance and internal policy adherence.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastCollectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Collection Date' ;
    rdfs:comment 'The date of the most recent collection attempt before write-off. Demonstrates due diligence in collection efforts.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectionAgency rdf:type rdf:Property ;
    rdfs:label 'Collection Agency' ;
    rdfs:comment 'The name of the third-party collection agency used, if applicable. Tracks external collection efforts before write-off determination.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sentToCollectionsDate rdf:type rdf:Property ;
    rdfs:label 'Sent To Collections Date' ;
    rdfs:comment 'The date when the account was sent to a collection agency. Part of the collection timeline documentation.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bankruptcyFlag rdf:type rdf:Property ;
    rdfs:label 'Bankruptcy Flag' ;
    rdfs:comment 'Indicates whether the write-off is due to member or group bankruptcy filing. Bankruptcy write-offs have specific legal and accounting treatment.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bankruptcyCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Bankruptcy Case Number' ;
    rdfs:comment 'The court case number for the bankruptcy filing, if applicable. Required for legal documentation and potential recovery tracking.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankruptcyFilingDate rdf:type rdf:Property ;
    rdfs:label 'Bankruptcy Filing Date' ;
    rdfs:comment 'The date when the bankruptcy was filed. Establishes the legal timeline for write-off and potential recovery.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deceasedMemberFlag rdf:type rdf:Property ;
    rdfs:label 'Deceased Member Flag' ;
    rdfs:comment 'Indicates whether the write-off is due to member death. Deceased member write-offs follow specific policy and regulatory guidelines.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Policy Termination Date' ;
    rdfs:comment 'The date when the insurance policy was terminated. Relevant for write-offs related to policy cancellations and coverage lapses.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:glAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Gl Account Number' ;
    rdfs:comment 'The general ledger account number to which the write-off is posted. Links the write-off to the chart of accounts for financial reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Impact Flag' ;
    rdfs:comment 'Indicates whether the write-off has tax implications. Bad debt write-offs may be tax-deductible under certain conditions.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxYear rdf:type rdf:Property ;
    rdfs:label 'Tax Year' ;
    rdfs:comment 'The tax year in which the write-off is claimed for tax purposes. May differ from the accounting period due to tax timing rules.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acaReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Aca Reporting Flag' ;
    rdfs:comment 'Indicates whether the write-off must be included in ACA regulatory reporting. Marketplace and individual market write-offs have specific reporting requirements.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cmsReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Cms Reporting Flag' ;
    rdfs:comment 'Indicates whether the write-off must be reported to CMS. Medicare Advantage and Part D write-offs have specific CMS reporting requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskAdjustmentImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Risk Adjustment Impact Flag' ;
    rdfs:comment 'Indicates whether the write-off affects risk adjustment calculations. Premium write-offs for Medicare Advantage or ACA marketplace plans may impact risk adjustment payments.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postingDate rdf:type rdf:Property ;
    rdfs:label 'Posting Date' ;
    rdfs:comment 'The date when the write-off was posted to the general ledger. May differ from write-off date due to period-end closing processes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:journalEntryNumber rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Number' ;
    rdfs:comment 'The journal entry number in the general ledger system for the write-off transaction. Links the write-off to the financial accounting entry.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subsidyReconciliationFlag rdf:type rdf:Property ;
    rdfs:label 'Subsidy Reconciliation Flag' ;
    rdfs:comment 'Indicates whether the write-off affects premium subsidy reconciliation. Marketplace write-offs may trigger subsidy recapture or adjustment processes.' ;
    rdfs:domain ind:WriteOff ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiumId rdf:type rdf:Property ;
    rdfs:label 'Premium Id' ;
    rdfs:comment 'Unique identifier for the premium record. Primary key for the premium data product.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Premium .

ind:ratingMethod rdf:type rdf:Property ;
    rdfs:label 'Rating Method' ;
    rdfs:comment 'The methodology used to calculate premium rates (Community Rated, Experience Rated, Age Banded, etc.).' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateBasis rdf:type rdf:Property ;
    rdfs:label 'Rate Basis' ;
    rdfs:comment 'The unit basis for premium calculation (PMPM - Per Member Per Month, PEPM - Per Employee Per Month, etc.).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:basePremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Base Premium Amount' ;
    rdfs:comment 'The base premium amount before adjustments, surcharges, or discounts.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ageRatingFactor rdf:type rdf:Property ;
    rdfs:label 'Age Rating Factor' ;
    rdfs:comment 'The age-based rating factor applied to the base premium for individual or small group plans.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tobaccoSurchargeAmount rdf:type rdf:Property ;
    rdfs:label 'Tobacco Surcharge Amount' ;
    rdfs:comment 'Additional premium charged for tobacco use, where permitted by state law.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicRatingFactor rdf:type rdf:Property ;
    rdfs:label 'Geographic Rating Factor' ;
    rdfs:comment 'The geographic area rating factor applied based on member location.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:familyTier rdf:type rdf:Property ;
    rdfs:label 'Family Tier' ;
    rdfs:comment 'The coverage tier indicating who is covered under the policy (Employee Only, Family, etc.).' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:familyTierFactor rdf:type rdf:Property ;
    rdfs:label 'Family Tier Factor' ;
    rdfs:comment 'The multiplier applied to base premium based on family tier coverage.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wellnessDiscountAmount rdf:type rdf:Property ;
    rdfs:label 'Wellness Discount Amount' ;
    rdfs:comment 'Premium discount applied for participation in wellness programs.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:groupDiscountAmount rdf:type rdf:Property ;
    rdfs:label 'Group Discount Amount' ;
    rdfs:comment 'Premium discount applied based on group size or favorable claims experience.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Employer Contribution Amount' ;
    rdfs:comment 'The portion of premium paid by the employer on behalf of the employee.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retroactiveAdjustmentReason rdf:type rdf:Property ;
    rdfs:label 'Retroactive Adjustment Reason' ;
    rdfs:comment 'The reason for the retroactive premium adjustment.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingFrequency rdf:type rdf:Property ;
    rdfs:label 'Billing Frequency' ;
    rdfs:comment 'The frequency at which premiums are billed (Monthly, Quarterly, Annual, etc.).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Date' ;
    rdfs:comment 'The date the premium invoice was generated.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:brokerId rdf:type rdf:Property ;
    rdfs:label 'Broker Id' ;
    rdfs:comment 'Unique identifier for the broker or agent associated with this premium.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Broker .

ind:administrativeFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Administrative Fee Amount' ;
    rdfs:comment 'Administrative fee charged for plan management, typically in ASO arrangements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stopLossPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Stop Loss Premium Amount' ;
    rdfs:comment 'Premium amount for stop-loss insurance coverage in self-funded arrangements.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinsurancePremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Premium Amount' ;
    rdfs:comment 'Premium amount ceded to reinsurance carriers for risk transfer.' ;
    rdfs:domain ind:Premium ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicalLossRatio rdf:type rdf:Property ;
    rdfs:label 'Medical Loss Ratio' ;
    rdfs:comment 'The ratio of claims and quality improvement expenses to premium revenue, used for ACA rebate calculations.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxRate rdf:type rdf:Property ;
    rdfs:label 'Tax Rate' ;
    rdfs:comment 'The tax rate percentage applied to calculate premium taxes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketplaceIndicator rdf:type rdf:Property ;
    rdfs:label 'Marketplace Indicator' ;
    rdfs:comment 'Indicates whether the plan was purchased through a federal or state health insurance marketplace.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costSharingReductionIndicator rdf:type rdf:Property ;
    rdfs:label 'Cost Sharing Reduction Indicator' ;
    rdfs:comment 'Indicates whether the member is eligible for cost-sharing reductions under ACA.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Rate Effective Date' ;
    rdfs:comment 'The effective date of the rate table used for this premium calculation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:refundAmount rdf:type rdf:Property ;
    rdfs:label 'Refund Amount' ;
    rdfs:comment 'The amount refunded to the member or group due to overpayment or cancellation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffAmount rdf:type rdf:Property ;
    rdfs:label 'Write Off Amount' ;
    rdfs:comment 'The premium amount written off as uncollectible.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffDate rdf:type rdf:Property ;
    rdfs:label 'Write Off Date' ;
    rdfs:comment 'The date when the premium amount was written off.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calculationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Calculation Timestamp' ;
    rdfs:comment 'The timestamp when the premium calculation was performed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:exceptionId rdf:type rdf:Property ;
    rdfs:label 'Exception Id' ;
    rdfs:comment 'Unique identifier for the risk exception record. Primary key for tracking exceptions that affect risk score calculations in Medicare Advantage risk adjustment processing.' ;
    rdfs:domain ind:Exception ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:severity rdf:type rdf:Property ;
    rdfs:label 'Severity' ;
    rdfs:comment 'Severity classification indicating the impact of the exception on risk score accuracy and financial implications. Critical exceptions require immediate attention.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rafScoreImpact rdf:type rdf:Property ;
    rdfs:label 'Raf Score Impact' ;
    rdfs:comment 'The net change in RAF score resulting from this exception. Calculated as adjusted RAF score minus original RAF score. Positive values indicate score increases.' ;
    rdfs:domain ind:Exception ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chartReviewType rdf:type rdf:Property ;
    rdfs:label 'Chart Review Type' ;
    rdfs:comment 'Classification of the chart review activity that identified or validated this exception. Indicates the timing and purpose of the medical record review.' ;
    rdfs:domain ind:Exception ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chartReviewOutcome rdf:type rdf:Property ;
    rdfs:label 'Chart Review Outcome' ;
    rdfs:comment 'Result of the chart review validation process. Indicates whether the diagnosis was supported by medical record documentation.' ;
    rdfs:domain ind:Exception ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationRuleDescription rdf:type rdf:Property ;
    rdfs:label 'Validation Rule Description' ;
    rdfs:comment 'Description of the validation rule that identified this exception. Explains the business logic or compliance requirement that was violated.' ;
    rdfs:domain ind:Exception ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorMessage rdf:type rdf:Property ;
    rdfs:label 'Error Message' ;
    rdfs:comment 'Detailed error message describing the exception condition. Provides technical details for resolution and root cause analysis.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionAction rdf:type rdf:Property ;
    rdfs:label 'Resolution Action' ;
    rdfs:comment 'The action taken to resolve the exception. Documents how the exception was addressed in the risk adjustment workflow.' ;
    rdfs:domain ind:Exception ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedToUserId rdf:type rdf:Property ;
    rdfs:label 'Assigned To User Id' ;
    rdfs:comment 'Identifier for the user or team member assigned to review and resolve this exception. Used for workload management and accountability.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:assignedToTeam rdf:type rdf:Property ;
    rdfs:label 'Assigned To Team' ;
    rdfs:comment 'Name of the team or department responsible for resolving this exception. Used for organizational workload distribution and reporting.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditFinding rdf:type rdf:Property ;
    rdfs:label 'Audit Finding' ;
    rdfs:comment 'Summary of the audit finding related to this exception. Documents compliance issues or validation results from audit review.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Compliance Risk Level' ;
    rdfs:comment 'Assessment of the compliance risk associated with this exception. Indicates potential regulatory or audit exposure.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrenceFlag rdf:type rdf:Property ;
    rdfs:label 'Recurrence Flag' ;
    rdfs:comment 'Indicator that this exception is a recurring issue for the same member or provider. True when similar exceptions have occurred previously.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurrenceCount rdf:type rdf:Property ;
    rdfs:label 'Recurrence Count' ;
    rdfs:comment 'Number of times a similar exception has occurred for the same member, provider, or diagnosis. Used to identify systemic issues.' ;
    rdfs:domain ind:Exception ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rootCauseCategory rdf:type rdf:Property ;
    rdfs:label 'Root Cause Category' ;
    rdfs:comment 'High-level classification of the underlying cause of the exception. Used for trend analysis and process improvement initiatives.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCauseDescription rdf:type rdf:Property ;
    rdfs:label 'Root Cause Description' ;
    rdfs:comment 'Detailed explanation of the root cause identified through exception analysis. Documents the underlying reason for the exception occurrence.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveAction rdf:type rdf:Property ;
    rdfs:label 'Corrective Action' ;
    rdfs:comment 'Description of the corrective action taken to prevent recurrence of similar exceptions. Documents process improvements or system changes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preventiveAction rdf:type rdf:Property ;
    rdfs:label 'Preventive Action' ;
    rdfs:comment 'Description of preventive measures implemented to avoid similar exceptions in the future. Documents proactive quality improvement initiatives.' ;
    rdfs:domain ind:Exception ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationLink rdf:type rdf:Property ;
    rdfs:label 'Documentation Link' ;
    rdfs:comment 'URL or file path to supporting documentation for this exception. Links to medical records, audit reports, or other reference materials.' ;
    rdfs:domain ind:Exception ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByUserId rdf:type rdf:Property ;
    rdfs:label 'Created By User Id' ;
    rdfs:comment 'Identifier of the user or system process that created the exception record. Used for audit trail and accountability.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:modifiedByUserId rdf:type rdf:Property ;
    rdfs:label 'Modified By User Id' ;
    rdfs:comment 'Identifier of the user who last modified the exception record. Used for audit trail and change tracking.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:reviewedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reviewed Timestamp' ;
    rdfs:comment 'Date and time when the exception was reviewed by an analyst or supervisor. Marks when the exception entered active review status.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reviewedByUserId rdf:type rdf:Property ;
    rdfs:label 'Reviewed By User Id' ;
    rdfs:comment 'Identifier of the user who reviewed the exception. Used for quality assurance and accountability tracking.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:approvedByUserId rdf:type rdf:Property ;
    rdfs:label 'Approved By User Id' ;
    rdfs:comment 'Identifier of the user who approved the exception resolution. Used for authorization tracking and compliance audit trail.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnitedHealthCare .

ind:resolvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolved Timestamp' ;
    rdfs:comment 'Date and time when the exception was fully resolved and closed. Marks the completion of the exception lifecycle.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resolvedByUserId rdf:type rdf:Property ;
    rdfs:label 'Resolved By User Id' ;
    rdfs:comment 'Identifier of the user who resolved and closed the exception. Used for productivity tracking and quality metrics.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:closedByUserId rdf:type rdf:Property ;
    rdfs:label 'Closed By User Id' ;
    rdfs:comment 'Identifier of the user who closed the exception record. Used for workflow completion tracking.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:slaMetFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Met Flag' ;
    rdfs:comment 'Indicator whether the exception was resolved within the defined service level agreement timeframe. True when SLA was met.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingLevel rdf:type rdf:Property ;
    rdfs:label 'Billing Level' ;
    rdfs:comment 'Indicates whether the invoice is issued at the group (employer), individual (direct member), subscriber (primary member), or dependent level.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupName rdf:type rdf:Property ;
    rdfs:label 'Group Name' ;
    rdfs:comment 'Legal or business name of the employer group or organization being billed.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Billing Address Line1' ;
    rdfs:comment 'Primary street address line for invoice delivery and payment correspondence.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Billing Address Line2' ;
    rdfs:comment 'Secondary address line for apartment, suite, or unit number.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCity rdf:type rdf:Property ;
    rdfs:label 'Billing City' ;
    rdfs:comment 'City name for the billing address.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingState rdf:type rdf:Property ;
    rdfs:label 'Billing State' ;
    rdfs:comment 'Two-letter state or territory code for the billing address.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingZipCode rdf:type rdf:Property ;
    rdfs:label 'Billing Zip Code' ;
    rdfs:comment 'Five or nine-digit postal code for the billing address.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCountryCode rdf:type rdf:Property ;
    rdfs:label 'Billing Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the billing address.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAmountDue rdf:type rdf:Property ;
    rdfs:label 'Total Amount Due' ;
    rdfs:comment 'Total invoice amount including all charges, taxes, fees, and adjustments. This is the final amount the member or group must pay.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Amount' ;
    rdfs:comment 'Credits applied from previous overpayments, refunds, or account balances that reduce the current invoice amount due.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Previous Balance Amount' ;
    rdfs:comment 'Outstanding balance carried forward from previous billing periods that remains unpaid.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Balance Amount' ;
    rdfs:comment 'Remaining unpaid balance on the invoice after applying all payments and credits.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enrolledMemberCount rdf:type rdf:Property ;
    rdfs:label 'Enrolled Member Count' ;
    rdfs:comment 'Total number of members (subscribers and dependents) enrolled and covered during the billing period. Used for PMPM premium calculations.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brokerAgentName rdf:type rdf:Property ;
    rdfs:label 'Broker Agent Name' ;
    rdfs:comment 'Full name of the insurance broker or agent of record for this policy.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionRatePercent rdf:type rdf:Property ;
    rdfs:label 'Commission Rate Percent' ;
    rdfs:comment 'Percentage rate applied to premium to calculate broker or agent commission.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autoPayEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Enabled Flag' ;
    rdfs:comment 'Indicates whether automatic recurring payment is enabled for this invoice. True if auto-pay is active, false otherwise.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paperlessBillingFlag rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing Flag' ;
    rdfs:comment 'Indicates whether the member or group has opted for electronic invoice delivery only (no paper statements). True if paperless, false if paper delivery is required.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:writeOffReasonCode rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for writing off the invoice balance: bankruptcy, deceased member, unable to locate, small balance waiver, settlement agreement, or other.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dunningLevel rdf:type rdf:Property ;
    rdfs:label 'Dunning Level' ;
    rdfs:comment 'The current collection notice level or stage in the dunning process for overdue invoices. Higher numbers indicate escalated collection efforts (e.g., 1=first reminder, 2=second notice, 3=final notice, 4=collections referral).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastDunningDate rdf:type rdf:Property ;
    rdfs:label 'Last Dunning Date' ;
    rdfs:comment 'The date the most recent collection notice or payment reminder was sent for this overdue invoice.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectionsAgencyReferralDate rdf:type rdf:Property ;
    rdfs:label 'Collections Agency Referral Date' ;
    rdfs:comment 'The date the invoice was referred to an external collections agency for recovery of unpaid balance. Null if not referred to collections.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxIdNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Id Number' ;
    rdfs:comment 'Federal Employer Identification Number (EIN) or Tax Identification Number for the group or organization being billed. Used for tax reporting and IRS Form 1095 compliance.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:form1095ReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Form 1095 Reporting Flag' ;
    rdfs:comment 'Indicates whether this invoice is associated with coverage that requires IRS Form 1095-B or 1095-C reporting for ACA compliance. True if reporting is required, false otherwise.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:csrAmount rdf:type rdf:Property ;
    rdfs:label 'Csr Amount' ;
    rdfs:comment 'The amount of cost-sharing reduction subsidy applied to reduce out-of-pocket costs for eligible marketplace members. Reimbursed to the insurer by the federal government.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sentDate rdf:type rdf:Property ;
    rdfs:label 'Sent Date' ;
    rdfs:comment 'The date the invoice was delivered or made available to the member or group through the specified delivery method.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:viewedDate rdf:type rdf:Property ;
    rdfs:label 'Viewed Date' ;
    rdfs:comment 'The date the member or group first accessed and viewed the invoice through electronic channels (web portal or mobile app). Null if not viewed electronically.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Flag' ;
    rdfs:comment 'Indicates whether the member or group is enrolled in an installment payment plan for this invoice. True if payment plan is active, false otherwise.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentPlanId rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Id' ;
    rdfs:comment 'Unique identifier for the payment plan or installment agreement associated with this invoice. Null if no payment plan exists.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plan .

ind:installmentNumber rdf:type rdf:Property ;
    rdfs:label 'Installment Number' ;
    rdfs:comment 'The sequential installment number for invoices that are part of a payment plan (e.g., 1 of 4, 2 of 4). Null if not part of a payment plan.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:externalInvoiceId rdf:type rdf:Property ;
    rdfs:label 'External Invoice Id' ;
    rdfs:comment 'Invoice identifier from the source billing system, used for cross-system reconciliation and audit trails.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumRateId rdf:type rdf:Property ;
    rdfs:label 'Premium Rate Id' ;
    rdfs:comment 'Unique identifier for the premium rate record. Primary key for the premium rate master table.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumRate .

ind:rateScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Code' ;
    rdfs:comment 'Unique code identifying the rate schedule. Used for rate lookup and premium calculation processes.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingAreaCode rdf:type rdf:Property ;
    rdfs:label 'Rating Area Code' ;
    rdfs:comment 'Geographic rating area code used for location-based premium rating as defined by state insurance regulations and ACA requirements.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ageBand rdf:type rdf:Property ;
    rdfs:label 'Age Band' ;
    rdfs:comment 'Age range bracket used for age-based premium rating, typically expressed as ranges such as 18-24, 25-29, 30-34, or 65+.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateFilingNumber rdf:type rdf:Property ;
    rdfs:label 'Rate Filing Number' ;
    rdfs:comment 'The regulatory filing number assigned by the state insurance department or CMS for this rate schedule, used for compliance tracking and audit purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateFilingDate rdf:type rdf:Property ;
    rdfs:label 'Rate Filing Date' ;
    rdfs:comment 'The date on which the rate filing was submitted to the regulatory authority for approval.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Rate Approval Date' ;
    rdfs:comment 'The date on which the rate filing was approved by the regulatory authority, allowing the rates to be used.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Rate Approval Status' ;
    rdfs:comment 'Current regulatory approval status of the rate filing, indicating whether rates are pending, approved, rejected, withdrawn, or under review.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitDesignCode rdf:type rdf:Property ;
    rdfs:label 'Benefit Design Code' ;
    rdfs:comment 'Code identifying the specific benefit design configuration associated with this rate, linking rates to benefit structures.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumGroupSize rdf:type rdf:Property ;
    rdfs:label 'Minimum Group Size' ;
    rdfs:comment 'The minimum number of eligible employees or members required for this rate to apply, used in group rating methodologies.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:participationRequirementPercentage rdf:type rdf:Property ;
    rdfs:label 'Participation Requirement Percentage' ;
    rdfs:comment 'The minimum percentage of eligible employees that must enroll for the group to qualify for this rate, expressed as a decimal (e.g., 0.75 for 75%).' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contributionRequirementPercentage rdf:type rdf:Property ;
    rdfs:label 'Contribution Requirement Percentage' ;
    rdfs:comment 'The minimum percentage of premium that the employer must contribute for the group to qualify for this rate, expressed as a decimal (e.g., 0.50 for 50%).' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:industryCode rdf:type rdf:Property ;
    rdfs:label 'Industry Code' ;
    rdfs:comment 'NAICS or SIC industry classification code used for industry-based rating adjustments in experience-rated or composite-rated groups.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sicCode rdf:type rdf:Property ;
    rdfs:label 'Sic Code' ;
    rdfs:comment 'Four-digit SIC code for industry classification, used in legacy systems for industry-based rating.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderRatingFactor rdf:type rdf:Property ;
    rdfs:label 'Gender Rating Factor' ;
    rdfs:comment 'Rating factor based on gender, where permitted by state law. Note: ACA prohibits gender rating in individual and small group markets.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:familySizeFactor rdf:type rdf:Property ;
    rdfs:label 'Family Size Factor' ;
    rdfs:comment 'Rating factor based on family size for family coverage tiers, used to adjust rates based on the number of covered dependents.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Geographic Adjustment Factor' ;
    rdfs:comment 'Factor applied to adjust rates based on geographic cost variations, reflecting differences in healthcare costs across regions.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wellnessProgramDiscountPercentage rdf:type rdf:Property ;
    rdfs:label 'Wellness Program Discount Percentage' ;
    rdfs:comment 'Percentage discount applied to the premium rate for participation in wellness programs, expressed as a decimal (e.g., 0.10 for 10% discount).' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateIncreasePercentage rdf:type rdf:Property ;
    rdfs:label 'Rate Increase Percentage' ;
    rdfs:comment 'Percentage increase from the previous rate version, used for rate change tracking and regulatory reporting, expressed as a decimal (e.g., 0.05 for 5% increase).' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medicalTrendFactor rdf:type rdf:Property ;
    rdfs:label 'Medical Trend Factor' ;
    rdfs:comment 'Factor representing expected medical cost trend used in rate development, reflecting anticipated increases in healthcare costs.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pharmacyTrendFactor rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Trend Factor' ;
    rdfs:comment 'Factor representing expected pharmacy cost trend used in rate development, reflecting anticipated increases in prescription drug costs.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:administrativeCostPercentage rdf:type rdf:Property ;
    rdfs:label 'Administrative Cost Percentage' ;
    rdfs:comment 'Percentage of premium allocated to administrative costs, used in rate development and Medical Loss Ratio (MLR) calculations, expressed as a decimal.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:profitMarginPercentage rdf:type rdf:Property ;
    rdfs:label 'Profit Margin Percentage' ;
    rdfs:comment 'Target profit margin percentage included in the premium rate, expressed as a decimal (e.g., 0.03 for 3% margin).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateManualReference rdf:type rdf:Property ;
    rdfs:label 'Rate Manual Reference' ;
    rdfs:comment 'Reference to the rate manual document or section that contains the detailed rating methodology and rules for this rate.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCellIdentifier rdf:type rdf:Property ;
    rdfs:label 'Rate Cell Identifier' ;
    rdfs:comment 'Unique identifier for the specific rate cell combining all rating factors, used for precise rate lookup in premium calculation systems.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeRateIndicator rdf:type rdf:Property ;
    rdfs:label 'Composite Rate Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this is a composite rate (true) or an age-banded rate (false). Composite rates are single rates regardless of age.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Rate Source System' ;
    rdfs:comment 'Name of the source system from which this rate originated, such as Facets, QNXT, or HealthRules, used for data lineage and reconciliation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Rate Calculation Method' ;
    rdfs:comment 'Method used to calculate or derive this rate, such as Manual Rating, Actuarial Model, Experience-Rated, Community-Rated, Benchmark, or Competitive pricing.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credibilityFactor rdf:type rdf:Property ;
    rdfs:label 'Credibility Factor' ;
    rdfs:comment 'Statistical credibility factor applied in experience rating to weight group-specific experience versus manual rates, ranging from 0 to 1.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateStatus rdf:type rdf:Property ;
    rdfs:label 'Rate Status' ;
    rdfs:comment 'Current operational status of the rate record, indicating whether the rate is Active, Inactive, Pending approval, Expired, Superseded by a newer version, or Withdrawn.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCategory rdf:type rdf:Property ;
    rdfs:label 'Rate Category' ;
    rdfs:comment 'Category indicating the type of enrollment or business scenario for which this rate applies, such as New Business, Renewal, COBRA, Retiree, Conversion, or Special Enrollment.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateTierSequence rdf:type rdf:Property ;
    rdfs:label 'Rate Tier Sequence' ;
    rdfs:comment 'Sequence number for ordering rate tiers within a rate schedule, used for display and processing logic.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Premium Amount' ;
    rdfs:comment 'Maximum premium amount cap for this rate, used in rate capping scenarios or regulatory maximum premium requirements.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateLoadFactor rdf:type rdf:Property ;
    rdfs:label 'Rate Load Factor' ;
    rdfs:comment 'Additional loading factor applied to the base rate for specific risk characteristics, administrative costs, or profit margins.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateDiscountFactor rdf:type rdf:Property ;
    rdfs:label 'Rate Discount Factor' ;
    rdfs:comment 'Discount factor applied to reduce the base rate for favorable risk characteristics, volume discounts, or promotional pricing.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateEffectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Rate Effective Timestamp' ;
    rdfs:comment 'Precise timestamp when this rate becomes effective, including time zone, used for intraday rate changes and system processing.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rateExpirationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Rate Expiration Timestamp' ;
    rdfs:comment 'Precise timestamp when this rate expires, including time zone, used for intraday rate changes and system processing.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rateCreatedDate rdf:type rdf:Property ;
    rdfs:label 'Rate Created Date' ;
    rdfs:comment 'Date when this rate record was initially created in the system, used for audit and data lineage purposes.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateModifiedDate rdf:type rdf:Property ;
    rdfs:label 'Rate Modified Date' ;
    rdfs:comment 'Date when this rate record was last modified, used for change tracking and audit purposes.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Rate Approved By' ;
    rdfs:comment 'Name or identifier of the individual or role who approved this rate for use, supporting audit and compliance requirements.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateNotes rdf:type rdf:Property ;
    rdfs:label 'Rate Notes' ;
    rdfs:comment 'Free-text notes or comments about this rate, including special conditions, exceptions, or clarifications for business users.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Regulatory Jurisdiction' ;
    rdfs:comment 'The regulatory jurisdiction governing this rate, such as State insurance department, Federal (CMS for Medicare/Medicaid), or Department of Insurance (DOI).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grandfatheredPlanIndicator rdf:type rdf:Property ;
    rdfs:label 'Grandfathered Plan Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this rate applies to a grandfathered plan under ACA, which is exempt from certain ACA requirements.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateReviewThresholdIndicator rdf:type rdf:Property ;
    rdfs:label 'Rate Review Threshold Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this rate increase meets or exceeds the threshold requiring federal or state rate review under ACA.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateDevelopmentDate rdf:type rdf:Property ;
    rdfs:label 'Rate Development Date' ;
    rdfs:comment 'Date when the actuarial rate development and analysis was completed for this rate schedule.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actuaryName rdf:type rdf:Property ;
    rdfs:label 'Actuary Name' ;
    rdfs:comment 'Name of the credentialed actuary responsible for developing and certifying this rate, used for regulatory filings and audit purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuaryCredential rdf:type rdf:Property ;
    rdfs:label 'Actuary Credential' ;
    rdfs:comment 'Professional actuarial credential of the certifying actuary, such as Fellow of the Society of Actuaries (FSA), Fellow of the Casualty Actuarial Society (FCAS), or Member of the American Academy of Actuaries (MAAA).' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateBasisYear rdf:type rdf:Property ;
    rdfs:label 'Rate Basis Year' ;
    rdfs:comment 'Calendar year on which the rate development experience data and assumptions are based, used for rate development documentation.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:projectionPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Projection Period Months' ;
    rdfs:comment 'Number of months from the basis period to the effective period for which trend and other adjustments are projected in rate development.' ;
    rdfs:domain ind:PremiumRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commissionPlanId rdf:type rdf:Property ;
    rdfs:label 'Commission Plan Id' ;
    rdfs:comment 'Unique identifier for the commission plan. Primary key for the commission plan entity.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionPlan .

ind:commissionBasis rdf:type rdf:Property ;
    rdfs:label 'Commission Basis' ;
    rdfs:comment 'The basis on which commissions are calculated, such as Per Member Per Month (PMPM), Per Employee Per Month (PEPM), premium percentage, or flat fee.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Base Commission Rate' ;
    rdfs:comment 'The base commission rate or percentage applied to the commission basis for standard performance levels.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionRateUnit rdf:type rdf:Property ;
    rdfs:label 'Commission Rate Unit' ;
    rdfs:comment 'Unit of measure for the commission rate, indicating whether it is expressed as a percentage, dollar amount, or basis points.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Commission Amount' ;
    rdfs:comment 'Minimum commission amount payable per transaction or period, ensuring a floor for commission payments.' ;
    rdfs:domain ind:CommissionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumCommissionAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Commission Amount' ;
    rdfs:comment 'Maximum commission amount payable per transaction or period, establishing a cap on commission payments.' ;
    rdfs:domain ind:CommissionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierStructureIndicator rdf:type rdf:Property ;
    rdfs:label 'Tier Structure Indicator' ;
    rdfs:comment 'Indicates whether the commission plan uses a tiered structure with different rates based on performance thresholds.' ;
    rdfs:domain ind:CommissionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tierCount rdf:type rdf:Property ;
    rdfs:label 'Tier Count' ;
    rdfs:comment 'Total number of commission tiers defined in the plan structure for tiered commission plans.' ;
    rdfs:domain ind:CommissionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:performanceMetric rdf:type rdf:Property ;
    rdfs:label 'Performance Metric' ;
    rdfs:comment 'Primary performance metric used to determine commission eligibility and tier placement, such as enrollment volume, retention rate, or quality scores.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstYearCommissionRate rdf:type rdf:Property ;
    rdfs:label 'First Year Commission Rate' ;
    rdfs:comment 'Commission rate applicable to the first year of a new policy or enrollment, typically higher than renewal rates.' ;
    rdfs:domain ind:CommissionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewalCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Renewal Commission Rate' ;
    rdfs:comment 'Commission rate applicable to policy renewals after the first year, typically lower than first year rates.' ;
    rdfs:domain ind:CommissionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideCommissionRate rdf:type rdf:Property ;
    rdfs:label 'Override Commission Rate' ;
    rdfs:comment 'Additional commission rate paid to managers or supervisors based on the performance of their team members.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusEligibilityIndicator rdf:type rdf:Property ;
    rdfs:label 'Bonus Eligibility Indicator' ;
    rdfs:comment 'Indicates whether this commission plan includes eligibility for performance bonuses beyond base commissions.' ;
    rdfs:domain ind:CommissionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bonusStructureDescription rdf:type rdf:Property ;
    rdfs:label 'Bonus Structure Description' ;
    rdfs:comment 'Description of the bonus structure including thresholds, amounts, and conditions for earning performance bonuses.' ;
    rdfs:domain ind:CommissionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargebackPolicy rdf:type rdf:Property ;
    rdfs:label 'Chargeback Policy' ;
    rdfs:comment 'Policy governing when and how commissions are charged back if a policy is cancelled or member disenrolls within a specified period.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargebackPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Chargeback Period Months' ;
    rdfs:comment 'Number of months from policy effective date during which cancellations or disenrollments trigger commission chargebacks.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentTiming rdf:type rdf:Property ;
    rdfs:label 'Payment Timing' ;
    rdfs:comment 'Timing of commission payments relative to premium collection, such as in advance, in arrears, or upon premium collection.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentDelayDays rdf:type rdf:Property ;
    rdfs:label 'Payment Delay Days' ;
    rdfs:comment 'Number of days after the calculation period end before commissions are paid, allowing for reconciliation and adjustments.' ;
    rdfs:domain ind:CommissionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:advancePaymentIndicator rdf:type rdf:Property ;
    rdfs:label 'Advance Payment Indicator' ;
    rdfs:comment 'Indicates whether commissions under this plan can be paid in advance before premium collection is confirmed.' ;
    rdfs:domain ind:CommissionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:advancePaymentPercentage rdf:type rdf:Property ;
    rdfs:label 'Advance Payment Percentage' ;
    rdfs:comment 'Percentage of total commission that can be paid in advance if advance payments are allowed.' ;
    rdfs:domain ind:CommissionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitCommissionAllowed rdf:type rdf:Property ;
    rdfs:label 'Split Commission Allowed' ;
    rdfs:comment 'Indicates whether commissions under this plan can be split among multiple agents or brokers for a single policy.' ;
    rdfs:domain ind:CommissionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:splitCommissionRules rdf:type rdf:Property ;
    rdfs:label 'Split Commission Rules' ;
    rdfs:comment 'Rules and guidelines governing how commissions are split when multiple agents or brokers are involved in a sale.' ;
    rdfs:domain ind:CommissionPlan ;
