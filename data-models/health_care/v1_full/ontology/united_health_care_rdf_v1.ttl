ind:behavioralHealthApplicableIndicator rdf:type rdf:Property ;
    rdfs:label 'Behavioral Health Applicable Indicator' ;
    rdfs:comment 'Indicates whether this cost sharing type applies to mental health and substance use disorder services with parity requirements.' ;
    rdfs:domain ind:CostSharingType ;
    rdf:type owl:DatatypeProperty ;
