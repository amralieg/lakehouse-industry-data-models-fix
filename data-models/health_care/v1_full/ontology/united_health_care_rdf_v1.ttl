    rdfs:comment 'Master reference table for session. Referenced by session_id.' .

ind:Department rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Service ;
    rdfs:label 'Department' ;
    rdfs:comment 'Master reference table for department. Referenced by department_id.' .

ind:ContactCenter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Service ;
    rdfs:label 'Contact Center' ;
    rdfs:comment 'Master reference table for contact_center. Referenced by contact_center_id.' .

ind:CommunicationTemplate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Service ;
