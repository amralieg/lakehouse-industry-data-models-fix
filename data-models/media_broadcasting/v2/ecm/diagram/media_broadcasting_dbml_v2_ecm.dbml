Table sales.bid_request {
  bid_request_id varchar [pk, note: 'Primary key for bid request']
  deal_id varchar [note: 'PMP deal ID if applicable']
  exchange_id varchar [note: 'FK to ad exchange']
  private_marketplace_deal_id varchar [note: 'FK to PMP deal if applicable']
  ssp_id varchar [note: 'FK to supply-side platform']
  app_bundle varchar [note: 'App bundle identifier']
  auction_type varchar [note: 'Auction type (first-price, second-price)']
  bid_count bigint [note: 'Number of bids received']
  bid_count_received varchar [note: 'Number of bids received']
  content_genre varchar [note: 'Content genre for contextual targeting']
  created_at timestamp [note: 'Record creation timestamp']
  created_timestamp timestamp [note: 'Record creation timestamp']
  device_type varchar [note: 'Device type (CTV, mobile, desktop, tablet)']
  floor_currency varchar [note: 'Currency of floor price']
  floor_price decimal(18,4) [note: 'Floor price CPM in the request']
  floor_price_cpm decimal(18,2) [note: 'Floor price CPM in request']
  geo_country varchar [note: 'Geographic country code']
  geo_dma varchar [note: 'DMA code for US markets']
  geo_region varchar [note: 'Geographic region/state']
  inventory_type varchar [note: 'Inventory type (video, display, audio)']
  openrtb_request_code varchar [note: 'Original OpenRTB request ID']
  openrtb_version varchar [note: 'OpenRTB protocol version']
  programmatic_enabled boolean [note: 'Flag indicating this entity is enabled for programmatic advertising']
  request_id_external varchar [note: 'External OpenRTB request ID']
  request_timestamp timestamp [note: 'Timestamp of bid request']
  sample_weight decimal(10,4) [note: 'Sampling weight for extrapolation']
  site_domain varchar [note: 'Site domain for web inventory']

  Note: 'Sampled OpenRTB bid request telemetry entity capturing inbound programmatic bid requests for win-rate and clearing-price analytics.'
}

Table sales.bid_response {
  bid_response_id varchar [pk, note: 'Primary key for bid response']
  advertiser_id varchar [note: 'FK to advertiser']
  bid_request_id varchar [note: 'FK to bid request']
  campaign_id varchar [note: 'FK to campaign']
  creative_id varchar [note: 'Creative ID in response']
  dsp_id varchar [note: 'FK to demand-side platform']
  advertiser_domain varchar [note: 'Advertiser domain from bid']
  bid_currency varchar [note: 'Currency of bid price']
  bid_price decimal(18,4) [note: 'Bid price CPM']
  bid_price_cpm decimal(18,2) [note: 'Bid price CPM submitted']
  clearing_price decimal(18,4) [note: 'Actual clearing price if won']
  clearing_price_cpm decimal(18,2) [note: 'Clearing price CPM if won']
  created_at timestamp [note: 'Record creation timestamp']
  created_timestamp timestamp [note: 'Record creation timestamp']
  currency_code varchar [note: 'Currency code for bid']
  deal_id_matched varchar [note: 'Deal ID matched if PMP']
  is_winner boolean [note: 'Whether this bid won the auction']
  latency_ms varchar [note: 'Response latency in milliseconds']
  loss_reason varchar [note: 'Reason for loss if applicable']
  no_bid_reason varchar [note: 'Reason for no-bid if applicable']
  openrtb_response_code varchar [note: 'Original OpenRTB response ID']
  programmatic_enabled boolean [note: 'Flag indicating this entity is enabled for programmatic advertising']
  response_id_external varchar [note: 'External OpenRTB response ID']
  response_timestamp timestamp [note: 'Timestamp of bid response']
  sample_weight decimal(10,4) [note: 'Sampling weight for extrapolation']
  win_flag boolean [note: 'Whether bid won the auction']
  win_reason varchar [note: 'Reason for win (highest_bid, deal_priority)']

  Note: 'Sampled OpenRTB bid response telemetry entity capturing programmatic bid responses for win-rate and clearing-price analytics.'
}

Table sales.exchange {
  exchange_id varchar [pk, note: 'Primary key for ad exchange']
  active_flag boolean [note: 'Whether exchange is currently active']
  api_endpoint_url varchar [note: 'API endpoint for integration']
  auction_type varchar [note: 'Auction type (first-price, second-price)']
  bid_protocol varchar [note: 'Bid protocol supported']
