ind:rafScoreContribution rdf:type rdf:Property ;
    rdfs:label 'Raf Score Contribution' ;
    rdfs:comment 'The contribution of this service line to the member\'s overall RAF score for risk adjustment purposes.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
