ind:suspectedHccList rdf:type rdf:Property ;
    rdfs:label 'Suspected Hcc List' ;
    rdfs:comment 'Comma-separated list of HCC codes suspected based on claims patterns but not yet documented in medical records.' ;
    rdfs:domain ind:MemberRiskProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapClosurePriority rdf:type rdf:Property ;
    rdfs:label 'Gap Closure Priority' ;
    rdfs:comment 'Priority level assigned for care gap closure activities to capture undocumented chronic conditions.' ;
