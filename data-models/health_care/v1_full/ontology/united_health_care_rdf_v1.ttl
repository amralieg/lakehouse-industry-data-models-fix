    rdfs:comment 'Indicates whether explicit consent for contact has been obtained from leads originating from this source. Critical for Telephone Consumer Protection Act (TCPA) compliance.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketingMaterialCode rdf:type rdf:Property ;
    rdfs:label 'Marketing Material Code' ;
    rdfs:comment 'Reference code for the approved marketing materials or creative assets associated with this lead source. Used for CMS File and Use compliance.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadVolumeMonthlyTarget rdf:type rdf:Property ;
    rdfs:label 'Lead Volume Monthly Target' ;
    rdfs:comment 'Target number of leads expected to be generated from this source per month. Used for capacity planning and performance monitoring.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leadVolumeAnnualTarget rdf:type rdf:Property ;
    rdfs:label 'Lead Volume Annual Target' ;
    rdfs:comment 'Target number of leads expected to be generated from this source annually. Used for strategic planning and budget allocation.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataQualityThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Data Quality Threshold Percent' ;
    rdfs:comment 'Minimum acceptable data quality score for leads from this source, expressed as a percentage. Leads below this threshold may be rejected or flagged for review.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:duplicateCheckEnabled rdf:type rdf:Property ;
    rdfs:label 'Duplicate Check Enabled' ;
    rdfs:comment 'Indicates whether automated duplicate detection is enabled for leads from this source to prevent multiple contacts with the same prospect.' ;
    rdfs:domain ind:LeadSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sepReasonCode rdf:type rdf:Property ;
    rdfs:label 'Sep Reason Code' ;
    rdfs:comment 'Code indicating the qualifying life event or reason for special enrollment period eligibility.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sepReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Sep Reason Description' ;
    rdfs:comment 'Detailed description of the qualifying life event justifying special enrollment period eligibility.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriberMiddleName rdf:type rdf:Property ;
    rdfs:label 'Subscriber Middle Name' ;
    rdfs:comment 'Middle name or initial of the primary subscriber enrolling in the health plan.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriberSuffix rdf:type rdf:Property ;
    rdfs:label 'Subscriber Suffix' ;
    rdfs:comment 'Name suffix of the primary subscriber such as Junior, Senior, or generational numbers.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriberGender rdf:type rdf:Property ;
    rdfs:label 'Subscriber Gender' ;
    rdfs:comment 'Gender of the primary subscriber using standard codes Male (M), Female (F), Unknown (U), or Non-binary (X).' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriberCountryCode rdf:type rdf:Property ;
    rdfs:label 'Subscriber Country Code' ;
    rdfs:comment 'Three-letter ISO country code of the subscriber residential address.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriberTobaccoUseIndicator rdf:type rdf:Property ;
    rdfs:label 'Subscriber Tobacco Use Indicator' ;
    rdfs:comment 'Indicator of whether the subscriber uses tobacco products affecting premium rating under ACA regulations.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dependentPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Dependent Premium Amount' ;
    rdfs:comment 'Total monthly premium amount for all dependents covered under the enrollment.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firstPaymentDate rdf:type rdf:Property ;
    rdfs:label 'First Payment Date' ;
    rdfs:comment 'Date when the first premium payment is due or was received.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstPaymentReceivedIndicator rdf:type rdf:Property ;
    rdfs:label 'First Payment Received Indicator' ;
    rdfs:comment 'Indicator of whether the first premium payment has been received to activate coverage.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pcpSelectionRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Pcp Selection Required Indicator' ;
    rdfs:comment 'Indicator of whether the plan requires selection of a Primary Care Physician at enrollment.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:selectedPcpNpi rdf:type rdf:Property ;
    rdfs:label 'Selected Pcp Npi' ;
    rdfs:comment 'National Provider Identifier of the Primary Care Physician selected by the subscriber if required.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selectedPcpName rdf:type rdf:Property ;
    rdfs:label 'Selected Pcp Name' ;
    rdfs:comment 'Full name of the Primary Care Physician selected by the subscriber.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorCoverageIndicator rdf:type rdf:Property ;
    rdfs:label 'Prior Coverage Indicator' ;
    rdfs:comment 'Indicator of whether the subscriber had prior health insurance coverage before this enrollment.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cobraContinuationIndicator rdf:type rdf:Property ;
    rdfs:label 'Cobra Continuation Indicator' ;
    rdfs:comment 'Indicator of whether this enrollment is a Consolidated Omnibus Budget Reconciliation Act (COBRA) continuation coverage request.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicare Eligible Indicator' ;
    rdfs:comment 'Indicator of whether the subscriber is eligible for Medicare coverage.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareNumber rdf:type rdf:Property ;
    rdfs:label 'Medicare Number' ;
    rdfs:comment 'Medicare Beneficiary Identifier number for subscribers enrolling in Medicare Advantage or Part D plans.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicaidEligibleIndicator rdf:type rdf:Property ;
    rdfs:label 'Medicaid Eligible Indicator' ;
    rdfs:comment 'Indicator of whether the subscriber is eligible for Medicaid coverage.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paperlessEnrollmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Paperless Enrollment Indicator' ;
    rdfs:comment 'Indicator of whether the subscriber opted for paperless electronic communications and documents.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hipaaAuthorizationSignedIndicator rdf:type rdf:Property ;
    rdfs:label 'Hipaa Authorization Signed Indicator' ;
    rdfs:comment 'Indicator of whether the subscriber signed the Health Insurance Portability and Accountability Act (HIPAA) authorization form.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consentToContactIndicator rdf:type rdf:Property ;
    rdfs:label 'Consent To Contact Indicator' ;
    rdfs:comment 'Indicator of whether the subscriber provided consent to be contacted for marketing and outreach purposes.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:electronicSignatureIndicator rdf:type rdf:Property ;
    rdfs:label 'Electronic Signature Indicator' ;
    rdfs:comment 'Indicator of whether the enrollment application was signed electronically.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:underwritingRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Underwriting Required Indicator' ;
    rdfs:comment 'Indicator of whether medical underwriting is required for this enrollment request.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qhpId rdf:type rdf:Property ;
    rdfs:label 'Qhp Id' ;
    rdfs:comment 'Fourteen-digit Qualified Health Plan identifier assigned by the Centers for Medicare and Medicaid Services (CMS) for marketplace plans.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:householdSize rdf:type rdf:Property ;
    rdfs:label 'Household Size' ;
    rdfs:comment 'Number of individuals in the household for subsidy eligibility calculation.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberIdAssigned rdf:type rdf:Property ;
    rdfs:label 'Member Id Assigned' ;
    rdfs:comment 'Unique member identifier assigned to the subscriber upon successful enrollment completion.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyNumberAssigned rdf:type rdf:Property ;
    rdfs:label 'Policy Number Assigned' ;
    rdfs:comment 'Policy number assigned to the enrollment upon successful completion.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:edi834TransactionId rdf:type rdf:Property ;
    rdfs:label 'Edi 834 Transaction Id' ;
    rdfs:comment 'Unique transaction identifier for the Electronic Data Interchange (EDI) 834 benefit enrollment transaction sent to the carrier system.' ;
    rdfs:domain ind:EnrollmentRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compensationPlanId rdf:type rdf:Property ;
    rdfs:label 'Compensation Plan Id' ;
    rdfs:comment 'Unique identifier for the sales compensation plan record. Primary key for the entity.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commissionFrequency rdf:type rdf:Property ;
    rdfs:label 'Commission Frequency' ;
    rdfs:comment 'The frequency at which commission payments are calculated and disbursed to agents.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstYearCommissionRatePercent rdf:type rdf:Property ;
    rdfs:label 'First Year Commission Rate Percent' ;
    rdfs:comment 'Commission rate applied to new business sales in the first policy year, typically higher than renewal rates.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewalCommissionRatePercent rdf:type rdf:Property ;
    rdfs:label 'Renewal Commission Rate Percent' ;
    rdfs:comment 'Commission rate applied to policy renewals in subsequent years after the first year.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Bonus Eligible Flag' ;
    rdfs:comment 'Indicates whether this compensation plan includes eligibility for performance-based bonuses.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bonusType rdf:type rdf:Property ;
    rdfs:label 'Bonus Type' ;
    rdfs:comment 'Classification of the bonus structure defining the performance criteria for bonus eligibility.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bonusAmount rdf:type rdf:Property ;
    rdfs:label 'Bonus Amount' ;
    rdfs:comment 'Fixed dollar amount awarded as bonus when performance criteria are met, if applicable.' ;
    rdfs:domain ind:Sales ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusRatePercent rdf:type rdf:Property ;
    rdfs:label 'Bonus Rate Percent' ;
    rdfs:comment 'Percentage rate applied to calculate variable bonus amounts based on performance metrics.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Performance Threshold Value' ;
    rdfs:comment 'Minimum performance metric value that must be achieved to qualify for bonus or tiered commission rates.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceThresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Performance Threshold Unit' ;
    rdfs:comment 'The unit of measure for the performance threshold defining how achievement is quantified.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumProductionRequirement rdf:type rdf:Property ;
    rdfs:label 'Minimum Production Requirement' ;
    rdfs:comment 'Minimum sales volume or production level required to maintain eligibility for the compensation plan.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Override Eligible Flag' ;
    rdfs:comment 'Indicates whether this plan allows for override commissions to be paid to managing agents or agency owners.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideRatePercent rdf:type rdf:Property ;
    rdfs:label 'Override Rate Percent' ;
    rdfs:comment 'The percentage rate applied for override commissions paid to managing agents or agency owners.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:residualEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Residual Eligible Flag' ;
    rdfs:comment 'Indicates whether this plan includes ongoing residual commissions for the lifetime of the policy.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:residualDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Residual Duration Months' ;
    rdfs:comment 'Number of months for which residual commissions continue to be paid after the initial sale.' ;
    rdfs:domain ind:CompensationPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:opportunityStageId rdf:type rdf:Property ;
    rdfs:label 'Opportunity Stage Id' ;
    rdfs:comment 'Unique identifier for the opportunity stage reference record.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stageCode rdf:type rdf:Property ;
    rdfs:label 'Stage Code' ;
    rdfs:comment 'Short alphanumeric code representing the opportunity stage for system integration and reporting purposes.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageName rdf:type rdf:Property ;
    rdfs:label 'Stage Name' ;
    rdfs:comment 'Full descriptive name of the opportunity stage as displayed to sales users and in reports.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageCategory rdf:type rdf:Property ;
    rdfs:label 'Stage Category' ;
    rdfs:comment 'High-level categorization of the stage indicating whether the opportunity is still open, successfully closed, or lost.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageType rdf:type rdf:Property ;
    rdfs:label 'Stage Type' ;
    rdfs:comment 'Specific type of opportunity stage representing the detailed sales process phase.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probabilityPercentage rdf:type rdf:Property ;
    rdfs:label 'Probability Percentage' ;
    rdfs:comment 'Default probability percentage (0-100) that an opportunity in this stage will close successfully, used for pipeline forecasting.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salesChannel rdf:type rdf:Property ;
    rdfs:label 'Sales Channel' ;
    rdfs:comment 'Distribution channel for which this opportunity stage is applicable, supporting channel-specific sales workflows.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresQuote rdf:type rdf:Property ;
    rdfs:label 'Requires Quote' ;
    rdfs:comment 'Indicates whether a formal premium quote must be generated for opportunities in this stage.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresProposal rdf:type rdf:Property ;
    rdfs:label 'Requires Proposal' ;
    rdfs:comment 'Indicates whether a detailed benefit proposal document must be prepared for opportunities in this stage.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresContract rdf:type rdf:Property ;
    rdfs:label 'Requires Contract' ;
    rdfs:comment 'Indicates whether a formal contract or group agreement must be executed for opportunities in this stage.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresEnrollmentForms rdf:type rdf:Property ;
    rdfs:label 'Requires Enrollment Forms' ;
    rdfs:comment 'Indicates whether member enrollment applications must be collected for opportunities in this stage.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:averageDurationDays rdf:type rdf:Property ;
    rdfs:label 'Average Duration Days' ;
    rdfs:comment 'Historical average number of days opportunities typically remain in this stage before progressing or closing.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumDurationDays rdf:type rdf:Property ;
    rdfs:label 'Minimum Duration Days' ;
    rdfs:comment 'Minimum number of days an opportunity should remain in this stage to ensure proper sales process compliance.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumDurationDays rdf:type rdf:Property ;
    rdfs:label 'Maximum Duration Days' ;
    rdfs:comment 'Maximum number of days an opportunity should remain in this stage before escalation or review is triggered.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stageDescription rdf:type rdf:Property ;
    rdfs:label 'Stage Description' ;
    rdfs:comment 'Detailed description of the opportunity stage including key activities, milestones, and exit criteria.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryCriteria rdf:type rdf:Property ;
    rdfs:label 'Entry Criteria' ;
    rdfs:comment 'Specific conditions and requirements that must be met for an opportunity to enter this stage.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exitCriteria rdf:type rdf:Property ;
    rdfs:label 'Exit Criteria' ;
    rdfs:comment 'Specific conditions and requirements that must be met for an opportunity to exit this stage and progress to the next.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyActivities rdf:type rdf:Property ;
    rdfs:label 'Key Activities' ;
    rdfs:comment 'Primary sales activities and tasks that should be completed while an opportunity is in this stage.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueRecognitionEligible rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Eligible' ;
    rdfs:comment 'Indicates whether opportunities in this stage are eligible for revenue recognition under accounting standards.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pipelineInclusion rdf:type rdf:Property ;
    rdfs:label 'Pipeline Inclusion' ;
    rdfs:comment 'Indicates whether opportunities in this stage should be included in sales pipeline reports and forecasts.' ;
    rdfs:domain ind:OpportunityStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskScoreId rdf:type rdf:Property ;
    rdfs:label 'Risk Score Id' ;
    rdfs:comment 'Unique identifier for the risk score record.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiskScore .

ind:demographicScore rdf:type rdf:Property ;
    rdfs:label 'Demographic Score' ;
    rdfs:comment 'The portion of the risk score attributable to demographic factors such as age, gender, and Medicaid eligibility.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diseaseScore rdf:type rdf:Property ;
    rdfs:label 'Disease Score' ;
    rdfs:comment 'The portion of the risk score attributable to diagnosed chronic conditions and HCC categories.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interactionScore rdf:type rdf:Property ;
    rdfs:label 'Interaction Score' ;
    rdfs:comment 'The portion of the risk score attributable to interactions between multiple chronic conditions or demographic factors.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esrdStatus rdf:type rdf:Property ;
    rdfs:label 'Esrd Status' ;
    rdfs:comment 'Indicates whether the member has End Stage Renal Disease, which requires a specialized risk adjustment model.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hccList rdf:type rdf:Property ;
    rdfs:label 'Hcc List' ;
    rdfs:comment 'A comma-separated list of HCC codes assigned to the member (e.g., HCC18, HCC85, HCC111).' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encounterCount rdf:type rdf:Property ;
    rdfs:label 'Encounter Count' ;
    rdfs:comment 'The total number of healthcare encounters (claims or encounter records) that contributed diagnoses to the risk score.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prospectiveFlag rdf:type rdf:Property ;
    rdfs:label 'Prospective Flag' ;
    rdfs:comment 'Indicates whether this is a prospective risk score used for payment in the current year based on prior year data.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retrospectiveFlag rdf:type rdf:Property ;
    rdfs:label 'Retrospective Flag' ;
    rdfs:comment 'Indicates whether this is a retrospective risk score calculated after the payment year for reconciliation purposes.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationAmount rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Amount' ;
    rdfs:comment 'The amount of payment adjustment resulting from reconciliation between prospective and retrospective risk scores.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hospiceFlag rdf:type rdf:Property ;
    rdfs:label 'Hospice Flag' ;
    rdfs:comment 'Indicates whether the member was enrolled in hospice care during the risk score calculation period.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partDFlag rdf:type rdf:Property ;
    rdfs:label 'Part D Flag' ;
    rdfs:comment 'Indicates whether the member has Medicare Part D prescription drug coverage, which may affect risk adjustment.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rxhccScore rdf:type rdf:Property ;
    rdfs:label 'Rxhcc Score' ;
    rdfs:comment 'The risk score calculated using the RxHCC model for Part D prescription drug payment adjustment.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rxhccCount rdf:type rdf:Property ;
    rdfs:label 'Rxhcc Count' ;
    rdfs:comment 'The total number of distinct RxHCC categories assigned to the member for Part D risk adjustment.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:predictedCost rdf:type rdf:Property ;
    rdfs:label 'Predicted Cost' ;
    rdfs:comment 'The predicted annual healthcare cost for the member based on the risk score and historical cost data.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousScore rdf:type rdf:Property ;
    rdfs:label 'Previous Score' ;
    rdfs:comment 'The risk score from the immediately preceding calculation period for trend analysis.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scorePercentile rdf:type rdf:Property ;
    rdfs:label 'Score Percentile' ;
    rdfs:comment 'The percentile ranking of the member\'s risk score within the plan population (1-100).' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gapClosureOpportunity rdf:type rdf:Property ;
    rdfs:label 'Gap Closure Opportunity' ;
    rdfs:comment 'Indicates whether there are potential diagnosis gaps or documentation opportunities that could affect the risk score.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suspectConditionFlag rdf:type rdf:Property ;
    rdfs:label 'Suspect Condition Flag' ;
    rdfs:comment 'Indicates whether there are suspected conditions based on historical data that have not been documented in the current period.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastChartReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Chart Review Date' ;
    rdfs:comment 'The date of the most recent medical chart review conducted for this member\'s risk score validation.' ;
    rdfs:domain ind:RiskScore ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regionId rdf:type rdf:Property ;
    rdfs:label 'Region Id' ;
    rdfs:comment 'Unique identifier for the sales region. Primary key for the sales region entity.' ;
    rdfs:domain ind:Sales ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Region .

ind:parentRegionCode rdf:type rdf:Property ;
    rdfs:label 'Parent Region Code' ;
    rdfs:comment 'Code of the parent region in the hierarchy. Null for top-level regions.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateCodes rdf:type rdf:Property ;
    rdfs:label 'State Codes' ;
    rdfs:comment 'Comma-separated list of US state codes (two-letter abbreviations) included in this sales region.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lobCoverage rdf:type rdf:Property ;
    rdfs:label 'Lob Coverage' ;
    rdfs:comment 'Comma-separated list of Lines of Business (LOB) that this region supports (e.g., Commercial, Medicare, Medicaid, Marketplace).' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelCoverage rdf:type rdf:Property ;
    rdfs:label 'Channel Coverage' ;
    rdfs:comment 'Comma-separated list of sales channels active in this region (e.g., Broker, Direct, Online, Employer Group).' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualQuotaAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Quota Amount' ;
    rdfs:comment 'Total annual sales quota assigned to this region in USD.' ;
    rdfs:domain ind:Sales ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quotaCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Quota Currency Code' ;
    rdfs:comment 'Three-letter ISO currency code for the quota amount (typically USD).' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quotaMeasurementType rdf:type rdf:Property ;
    rdfs:label 'Quota Measurement Type' ;
    rdfs:comment 'The metric used to measure quota attainment (revenue, member count, policy count, premium volume, new sales).' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regionalManagerName rdf:type rdf:Property ;
    rdfs:label 'Regional Manager Name' ;
    rdfs:comment 'Full name of the sales manager responsible for this region.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regionalManagerEmail rdf:type rdf:Property ;
    rdfs:label 'Regional Manager Email' ;
    rdfs:comment 'Primary email address of the regional sales manager.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regionalManagerPhone rdf:type rdf:Property ;
    rdfs:label 'Regional Manager Phone' ;
    rdfs:comment 'Primary contact phone number for the regional sales manager.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeStateCode rdf:type rdf:Property ;
    rdfs:label 'Office State Code' ;
    rdfs:comment 'Two-letter state code for the regional office location.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officePostalCode rdf:type rdf:Property ;
    rdfs:label 'Office Postal Code' ;
    rdfs:comment 'ZIP code for the regional office location.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeCountryCode rdf:type rdf:Property ;
    rdfs:label 'Office Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the regional office location.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activationDate rdf:type rdf:Property ;
    rdfs:label 'Activation Date' ;
    rdfs:comment 'Date when the sales region was first activated for sales operations.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deactivationDate rdf:type rdf:Property ;
    rdfs:label 'Deactivation Date' ;
    rdfs:comment 'Date when the sales region was deactivated or closed. Null if currently active.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetMemberCount rdf:type rdf:Property ;
    rdfs:label 'Target Member Count' ;
    rdfs:comment 'Target number of members to be enrolled in this sales region for the current planning period.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:currentMemberCount rdf:type rdf:Property ;
    rdfs:label 'Current Member Count' ;
    rdfs:comment 'Current number of active members enrolled through this sales region.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brokerCount rdf:type rdf:Property ;
    rdfs:label 'Broker Count' ;
    rdfs:comment 'Number of active brokers or agents assigned to this sales region.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:salesRepCount rdf:type rdf:Property ;
    rdfs:label 'Sales Rep Count' ;
    rdfs:comment 'Number of direct sales representatives assigned to this region.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:marketMaturity rdf:type rdf:Property ;
    rdfs:label 'Market Maturity' ;
    rdfs:comment 'Classification of the market maturity stage for this region (mature, growth, emerging, declining, new).' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitiveIntensity rdf:type rdf:Property ;
    rdfs:label 'Competitive Intensity' ;
    rdfs:comment 'Assessment of competitive pressure in this sales region (high, medium, low).' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplexity rdf:type rdf:Property ;
    rdfs:label 'Regulatory Complexity' ;
    rdfs:comment 'Assessment of regulatory complexity for health insurance sales in this region (high, medium, low).' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionStructureCode rdf:type rdf:Property ;
    rdfs:label 'Commission Structure Code' ;
    rdfs:comment 'Code identifying the commission structure applicable to sales in this region.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salesModelType rdf:type rdf:Property ;
    rdfs:label 'Sales Model Type' ;
    rdfs:comment 'Primary sales model used in this region (direct, broker, hybrid, digital, partner, employer direct).' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aepParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Aep Participation Flag' ;
    rdfs:comment 'Indicates whether this region actively participates in Medicare Annual Enrollment Period (AEP) sales campaigns.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oepParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Oep Participation Flag' ;
    rdfs:comment 'Indicates whether this region actively participates in Open Enrollment Period (OEP) sales campaigns for individual and marketplace products.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketplaceParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Marketplace Participation Flag' ;
    rdfs:comment 'Indicates whether this region participates in state or federal health insurance marketplace sales.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareCertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Medicare Certified Flag' ;
    rdfs:comment 'Indicates whether this region is certified for Medicare Advantage and Part D sales.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidAuthorizedFlag rdf:type rdf:Property ;
    rdfs:label 'Medicaid Authorized Flag' ;
    rdfs:comment 'Indicates whether this region is authorized for Medicaid managed care sales.' ;
    rdfs:domain ind:Region ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetId rdf:type rdf:Property ;
    rdfs:label 'Target Id' ;
    rdfs:comment 'Unique identifier for the sales target record.' ;
    rdfs:domain ind:Target ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brokerPhone rdf:type rdf:Property ;
    rdfs:label 'Broker Phone' ;
    rdfs:comment 'Contact phone number for the broker.' ;
    rdfs:domain ind:Target ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByEmail rdf:type rdf:Property ;
    rdfs:label 'Approved By Email' ;
    rdfs:comment 'Email address of the approver.' ;
    rdfs:domain ind:Target ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionType rdf:type rdf:Property ;
    rdfs:label 'Commission Type' ;
    rdfs:comment 'Method used to calculate broker commission for the target.' ;
    rdfs:domain ind:Sales ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionNumber rdf:type rdf:Property ;
    rdfs:label 'Revision Number' ;
    rdfs:comment 'Version of the target record after modifications.' ;
    rdfs:domain ind:Target ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quotaReviewCycle rdf:type rdf:Property ;
    rdfs:label 'Quota Review Cycle' ;
    rdfs:comment 'Frequency at which the target is reviewed and potentially adjusted.' ;
    rdfs:domain ind:Target ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderLineId rdf:type rdf:Property ;
    rdfs:label 'Order Line Id' ;
    rdfs:comment 'Unique system-generated identifier for each order line record.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planProductPlanId rdf:type rdf:Property ;
    rdfs:label 'Plan Product Plan Id' ;
    rdfs:comment 'Identifier of the health insurance plan associated with the line.' ;
    rdfs:domain ind:UnitedHealthCare ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProductPlan .

ind:coverageCode rdf:type rdf:Property ;
    rdfs:label 'Coverage Code' ;
    rdfs:comment 'Internal code representing the specific coverage tier or option.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netPrice rdf:type rdf:Property ;
    rdfs:label 'Net Price' ;
    rdfs:comment 'Final line amount after discounts but before tax.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fulfillmentMethod rdf:type rdf:Property ;
    rdfs:label 'Fulfillment Method' ;
    rdfs:comment 'Method used to deliver the product or service.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shippingAddress rdf:type rdf:Property ;
    rdfs:label 'Shipping Address' ;
    rdfs:comment 'Address where the product is to be shipped or delivered.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fulfilledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Fulfilled Timestamp' ;
    rdfs:comment 'Date-time when the product or service was actually delivered.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isCancellation rdf:type rdf:Property ;
    rdfs:label 'Is Cancellation' ;
    rdfs:comment 'True if the line was cancelled before fulfillment.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRefund rdf:type rdf:Property ;
    rdfs:label 'Is Refund' ;
    rdfs:comment 'True if the line resulted in a refund to the member or broker.' ;
    rdfs:domain ind:OrderLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:auditorOrganization rdf:type rdf:Property ;
    rdfs:label 'Auditor Organization' ;
    rdfs:comment 'Name of the organization or entity conducting the audit. For internal audits, this may be the internal audit department. For external audits, this is the external auditing firm or regulatory body.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditorType rdf:type rdf:Property ;
    rdfs:label 'Auditor Type' ;
    rdfs:comment 'Classification of the auditor based on their relationship to the organization. Indicates whether the audit is conducted by internal staff, external consultants, regulatory agencies, or independent third parties.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldworkStartDate rdf:type rdf:Property ;
    rdfs:label 'Fieldwork Start Date' ;
    rdfs:comment 'The date when on-site or detailed audit fieldwork began. Represents the commencement of evidence gathering and testing activities.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fieldworkEndDate rdf:type rdf:Property ;
    rdfs:label 'Fieldwork End Date' ;
    rdfs:comment 'The date when on-site or detailed audit fieldwork concluded. Represents the completion of evidence gathering and testing activities.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportIssueDate rdf:type rdf:Property ;
    rdfs:label 'Report Issue Date' ;
    rdfs:comment 'The date when the final audit report was issued or published. Represents the official completion and communication of audit findings.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportDueDate rdf:type rdf:Property ;
    rdfs:label 'Report Due Date' ;
    rdfs:comment 'The date by which the audit report is required to be completed and submitted. Represents regulatory or contractual deadlines for audit reporting.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:errorRate rdf:type rdf:Property ;
    rdfs:label 'Error Rate' ;
    rdfs:comment 'The percentage of errors or exceptions identified in the audit sample. Calculated as the number of errors divided by the sample size.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedErrorRate rdf:type rdf:Property ;
    rdfs:label 'Projected Error Rate' ;
    rdfs:comment 'The estimated error rate for the entire population based on the audit sample results. Represents the extrapolated error rate from sample to population.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:majorFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Major Findings Count' ;
    rdfs:comment 'The number of major or significant findings identified during the audit. Represents issues of moderate severity requiring remediation.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minorFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Minor Findings Count' ;
    rdfs:comment 'The number of minor or low-severity findings identified during the audit. Represents issues of lesser significance or opportunities for improvement.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overallRating rdf:type rdf:Property ;
    rdfs:label 'Overall Rating' ;
    rdfs:comment 'The overall rating or conclusion assigned to the audit. Represents the auditor\'s assessment of compliance, quality, or performance.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceScore rdf:type rdf:Property ;
    rdfs:label 'Compliance Score' ;
    rdfs:comment 'A numerical score representing the level of compliance or conformance identified during the audit, expressed as a percentage or score. Higher scores indicate better compliance.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:followUpAuditRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Follow Up Audit Required Flag' ;
    rdfs:comment 'Indicates whether a follow-up audit is required to verify remediation of findings. True if a subsequent audit is mandated.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpAuditDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Audit Date' ;
    rdfs:comment 'The scheduled or actual date of the follow-up audit to verify remediation. Represents when re-audit activities will occur.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:methodology rdf:type rdf:Property ;
    rdfs:label 'Methodology' ;
    rdfs:comment 'Description of the methodology, framework, or approach used to conduct the audit. May reference specific audit standards, protocols, or procedures.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criteria rdf:type rdf:Property ;
    rdfs:label 'Criteria' ;
    rdfs:comment 'The standards, regulations, policies, or benchmarks against which the audit subject was evaluated. Defines the basis for audit assessment.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportNumber rdf:type rdf:Property ;
    rdfs:label 'Report Number' ;
    rdfs:comment 'The unique identifier or reference number assigned to the audit report. Used for tracking and referencing audit documentation.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportTitle rdf:type rdf:Property ;
    rdfs:label 'Report Title' ;
    rdfs:comment 'The title of the audit report. Provides a descriptive name for the audit documentation.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opinion rdf:type rdf:Property ;
    rdfs:label 'Opinion' ;
    rdfs:comment 'The formal opinion or conclusion issued by the auditor regarding the subject matter. Represents the auditor\'s professional judgment.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementResponseDate rdf:type rdf:Property ;
    rdfs:label 'Management Response Date' ;
    rdfs:comment 'The date when management\'s formal response to the audit was received or submitted.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatorySubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Submission Date' ;
    rdfs:comment 'The date when the audit report or results were submitted to the regulatory body, if required. Relevant for regulatory audits.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryResponseDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Response Date' ;
    rdfs:comment 'The date when the regulatory body provided a response or decision regarding the audit. Represents regulatory feedback or action.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tool rdf:type rdf:Property ;
    rdfs:label 'Tool' ;
    rdfs:comment 'The software tool, platform, or application used to conduct the audit or analyze audit data. Examples include audit management systems, data analytics tools, or specialized audit software.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadContactName rdf:type rdf:Property ;
    rdfs:label 'Lead Contact Name' ;
    rdfs:comment 'The name of the primary contact person or audit lead within the organization for this audit. Identifies the internal point of contact for audit coordination.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadContactEmail rdf:type rdf:Property ;
    rdfs:label 'Lead Contact Email' ;
    rdfs:comment 'The email address of the primary contact person or audit lead within the organization for this audit.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadContactPhone rdf:type rdf:Property ;
    rdfs:label 'Lead Contact Phone' ;
    rdfs:comment 'The phone number of the primary contact person or audit lead within the organization for this audit.' ;
    rdfs:domain ind:Audit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleVersion rdf:type rdf:Property ;
    rdfs:label 'Rule Version' ;
    rdfs:comment 'Version identifier used to track changes to the rule over time.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityEngine rdf:type rdf:Property ;
    rdfs:label 'Eligibility Engine' ;
    rdfs:comment 'Name of the engine or module that evaluates the rule.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationOrder rdf:type rdf:Property ;
    rdfs:label 'Evaluation Order' ;
    rdfs:comment 'Explicit order number for rule execution within the engine.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:residencyState rdf:type rdf:Property ;
    rdfs:label 'Residency State' ;
    rdfs:comment 'Two-letter US state code indicating required member residency.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residencyCountry rdf:type rdf:Property ;
    rdfs:label 'Residency Country' ;
    rdfs:comment 'Three-letter ISO country code for required member residency.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxDependents rdf:type rdf:Property ;
    rdfs:label 'Max Dependents' ;
    rdfs:comment 'Maximum count of dependents permitted by the rule.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cobApplicable rdf:type rdf:Property ;
    rdfs:label 'Cob Applicable' ;
    rdfs:comment 'Indicates whether the rule participates in coordination of benefits processing.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ruleExpression rdf:type rdf:Property ;
    rdfs:label 'Rule Expression' ;
    rdfs:comment 'Technical expression or script that implements the rule logic.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliesToNewMembers rdf:type rdf:Property ;
    rdfs:label 'Applies To New Members' ;
    rdfs:comment 'True if the rule is evaluated for newly enrolled members.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appliesToExistingMembers rdf:type rdf:Property ;
    rdfs:label 'Applies To Existing Members' ;
    rdfs:comment 'True if the rule is evaluated during member status changes for existing members.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ruleScope rdf:type rdf:Property ;
    rdfs:label 'Rule Scope' ;
    rdfs:comment 'Business domain(s) where the rule is enforced.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleStatusReason rdf:type rdf:Property ;
    rdfs:label 'Rule Status Reason' ;
    rdfs:comment 'Free-text explanation for the current status of the rule.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceReference rdf:type rdf:Property ;
    rdfs:label 'Compliance Reference' ;
    rdfs:comment 'Reference to the external regulation or guideline that mandates the rule.' ;
    rdfs:domain ind:EligibilityRule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseFeeScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Base Fee Schedule Code' ;
    rdfs:comment 'Reference code to a base or parent fee schedule from which this schedule may derive or inherit pricing rules.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Adjustment Factor' ;
    rdfs:comment 'Multiplier or percentage adjustment applied to base rates in this fee schedule for geographic or other variations.' ;
    rdfs:domain ind:Shared ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rvuBasedFlag rdf:type rdf:Property ;
    rdfs:label 'Rvu Based Flag' ;
    rdfs:comment 'Indicator whether this fee schedule uses Relative Value Units as the basis for pricing calculations.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modifierRulesApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Modifier Rules Applicable Flag' ;
    rdfs:comment 'Indicator whether CPT or HCPCS modifiers affect pricing under this fee schedule.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bundlingRulesApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Bundling Rules Applicable Flag' ;
    rdfs:comment 'Indicator whether procedure bundling or unbundling rules apply to this fee schedule.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outlierThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Outlier Threshold Amount' ;
    rdfs:comment 'Dollar threshold above which claims are considered outliers and may receive additional payment adjustments.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stopLossAmount rdf:type rdf:Property ;
    rdfs:label 'Stop Loss Amount' ;
    rdfs:comment 'Maximum payment amount or cap applied to individual claims under this fee schedule.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentageOfMedicare rdf:type rdf:Property ;
    rdfs:label 'Percentage Of Medicare' ;
    rdfs:comment 'Percentage of Medicare allowable amounts used as the basis for pricing in this fee schedule.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentageOfCharges rdf:type rdf:Property ;
    rdfs:label 'Percentage Of Charges' ;
    rdfs:comment 'Percentage of provider billed charges used to calculate payment amounts in this fee schedule.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autoUpdateFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Update Flag' ;
    rdfs:comment 'Indicator whether this fee schedule automatically updates based on external rate changes such as CMS updates.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicareBasedFlag rdf:type rdf:Property ;
    rdfs:label 'Medicare Based Flag' ;
    rdfs:comment 'Indicator whether this fee schedule is derived from or references Medicare fee schedules.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicaidBasedFlag rdf:type rdf:Property ;
    rdfs:label 'Medicaid Based Flag' ;
    rdfs:comment 'Indicator whether this fee schedule is derived from or references state Medicaid fee schedules.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cptVersion rdf:type rdf:Property ;
    rdfs:label 'Cpt Version' ;
    rdfs:comment 'Version year of CPT code set applicable to this fee schedule for procedure-based pricing.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hcpcsVersion rdf:type rdf:Property ;
    rdfs:label 'Hcpcs Version' ;
    rdfs:comment 'Version year of HCPCS code set applicable to this fee schedule for supplies and services pricing.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderRestrictions rdf:type rdf:Property ;
    rdfs:label 'Gender Restrictions' ;
    rdfs:comment 'Gender-based restrictions or applicability for this fee schedule.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diagnosisRestrictions rdf:type rdf:Property ;
    rdfs:label 'Diagnosis Restrictions' ;
    rdfs:comment 'List of diagnosis codes or categories for which this fee schedule is applicable or restricted.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:copayApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Copay Applicable Flag' ;
    rdfs:comment 'Indicator whether member copayments apply to services priced under this fee schedule.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coinsuranceApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Applicable Flag' ;
    rdfs:comment 'Indicator whether member coinsurance applies to services priced under this fee schedule.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deductibleApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Deductible Applicable Flag' ;
    rdfs:comment 'Indicator whether member deductibles apply to services priced under this fee schedule.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oopApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Oop Applicable Flag' ;
    rdfs:comment 'Indicator whether out-of-pocket maximums apply to services priced under this fee schedule.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:balanceBillingAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Balance Billing Allowed Flag' ;
    rdfs:comment 'Indicator whether providers can balance bill members for amounts exceeding fee schedule rates.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:claimsRepricingFlag rdf:type rdf:Property ;
    rdfs:label 'Claims Repricing Flag' ;
    rdfs:comment 'Indicator whether claims should be automatically repriced using this fee schedule during adjudication.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transparencyReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Transparency Reporting Flag' ;
    rdfs:comment 'Indicator whether this fee schedule must be included in public transparency reporting requirements.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legacyFeeScheduleId rdf:type rdf:Property ;
    rdfs:label 'Legacy Fee Schedule Id' ;
    rdfs:comment 'Identifier from legacy or predecessor systems for historical tracking and data migration purposes.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentType rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Type' ;
    rdfs:comment 'Category of supporting documentation attached to the appeal.' ;
    rdfs:domain ind:Appeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedAmount rdf:type rdf:Property ;
    rdfs:label 'Requested Amount' ;
    rdfs:comment 'Monetary amount the member or provider is requesting to be reimbursed or adjusted.' ;
    rdfs:domain ind:Appeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assignedUserId rdf:type rdf:Property ;
    rdfs:label 'Assigned User Id' ;
    rdfs:comment 'Identifier of the user (analyst) responsible for reviewing the appeal.' ;
    rdfs:domain ind:Appeal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:assignedGroup rdf:type rdf:Property ;
    rdfs:label 'Assigned Group' ;
    rdfs:comment 'Business group or department handling the appeal.' ;
    rdfs:domain ind:Appeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaActualDays rdf:type rdf:Property ;
    rdfs:label 'Sla Actual Days' ;
    rdfs:comment 'Actual number of days taken to complete the appeal.' ;
    rdfs:domain ind:Appeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fraudReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Fraud Review Status' ;
    rdfs:comment 'Current status of the fraud review process for the appeal.' ;
    rdfs:domain ind:Appeal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastActionUserId rdf:type rdf:Property ;
    rdfs:label 'Last Action User Id' ;
    rdfs:comment 'Identifier of the user who performed the most recent action on the appeal.' ;
    rdfs:domain ind:Appeal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:User .

ind:brandName rdf:type rdf:Property ;
    rdfs:label 'Brand Name' ;
    rdfs:comment 'The proprietary or brand name under which the drug is marketed by the manufacturer.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierDescription rdf:type rdf:Property ;
    rdfs:label 'Tier Description' ;
    rdfs:comment 'Descriptive label for the formulary tier indicating the cost-sharing category (e.g., Preferred Generic, Specialty).' ;
    rdfs:domain ind:Shared ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredDrugIndicator rdf:type rdf:Property ;
    rdfs:label 'Preferred Drug Indicator' ;
    rdfs:comment 'Flag indicating whether the drug is on the preferred drug list with lower cost-sharing for members.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gpiCode rdf:type rdf:Property ;
    rdfs:label 'Gpi Code' ;
    rdfs:comment '14-digit hierarchical classification code that groups drugs by therapeutic class and chemical structure.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interchangeableBiosimilar rdf:type rdf:Property ;
    rdfs:label 'Interchangeable Biosimilar' ;
    rdfs:comment 'Flag indicating whether the biosimilar is designated as interchangeable with the reference product.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referenceProductNdc rdf:type rdf:Property ;
    rdfs:label 'Reference Product Ndc' ;
    rdfs:comment 'NDC of the reference or brand-name product for which this drug is a generic or biosimilar equivalent.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionAllowed rdf:type rdf:Property ;
    rdfs:label 'Exception Allowed' ;
    rdfs:comment 'Flag indicating whether members can request a formulary exception for coverage of this drug.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clinicalCriteriaRequired rdf:type rdf:Property ;
    rdfs:label 'Clinical Criteria Required' ;
    rdfs:comment 'Flag indicating whether specific clinical criteria must be met for the drug to be covered.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pharmacyNetworkRestriction rdf:type rdf:Property ;
    rdfs:label 'Pharmacy Network Restriction' ;
    rdfs:comment 'Type of pharmacy network where the drug must be obtained for coverage (e.g., specialty pharmacy only).' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pbmFormularyId rdf:type rdf:Property ;
    rdfs:label 'Pbm Formulary Id' ;
    rdfs:comment 'External identifier used by the PBM system to reference this formulary entry.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cmsFormularyId rdf:type rdf:Property ;
    rdfs:label 'Cms Formulary Id' ;
    rdfs:comment 'CMS-assigned identifier for Medicare Part D formulary submissions.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drugUtilizationReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Drug Utilization Review Required' ;
    rdfs:comment 'Flag indicating whether drug utilization review is required at the point of dispensing.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:compoundDrugIndicator rdf:type rdf:Property ;
    rdfs:label 'Compound Drug Indicator' ;
    rdfs:comment 'Flag indicating whether the drug is a compounded medication prepared by a pharmacy.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preventiveDrugIndicator rdf:type rdf:Property ;
    rdfs:label 'Preventive Drug Indicator' ;
    rdfs:comment 'Flag indicating whether the drug is classified as preventive care under ACA requirements with zero cost-sharing.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orphanDrugIndicator rdf:type rdf:Property ;
    rdfs:label 'Orphan Drug Indicator' ;
    rdfs:comment 'Flag indicating whether the drug is designated as an orphan drug for rare diseases.' ;
    rdfs:domain ind:Formulary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lactationRisk rdf:type rdf:Property ;
    rdfs:label 'Lactation Risk' ;
    rdfs:comment 'Assessment of risk when the drug is used during breastfeeding.' ;
